table(column=(type=char(5) updatewhereclause=yes name=groupname dbname="groupname"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="invtotal"  )
column=(type=decimal(6) updatewhereclause=yes name=refusedtotal dbname="refusedtotal"  )
column=(type=char(88) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
