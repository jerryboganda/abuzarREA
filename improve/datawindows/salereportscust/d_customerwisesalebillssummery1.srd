table(column=(type=char(60) updatewhereclause=yes name=custname dbname="Custname"  )
column=(type=datetime updatewhereclause=yes name=saledate dbname="saledate"  )
column=(type=long updatewhereclause=yes name=invcount dbname="InvCount"  )
column=(type=decimal(6) updatewhereclause=yes name=invvalue dbname="InvValue"  )
 retrieve="SELECT Custname = accounts.name,
		 saledate = max(saleledger.date),
		 InvCount= count(distinct saleledger.saleinvcode) , 
 		 InvValue=  Case when Round(Sum ( (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc)) *  (1 - dbo.saledetail.discperc /100) * (1 - dbo.saleledger.discperc /100) - flatdisc   +   misccharges), 2) IS NULL Then 0  Else Round(Sum ( (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc)) *  (1 - dbo.saledetail.discperc /100) * (1 - dbo.saleledger.discperc /100) ) - flatdisc   +   misccharges, 0) End 

    FROM saleledger,
		 saledetail,   
         accounts  
   WHERE /*( saleledger.date >= :ad_StartDate ) AND  
         ( saleledger.date <= :ad_EndDate ) AND*/
			( saleledger.custcode IN (:al_custcode) ) and
			(dbo.saleledger.date between :ad_StartDate and :ad_EndDate) and   
			/*(dbo.saleledger.saleinvcode NOT IN (select distinct srledger.saleinvcode from srledger where srledger.date between :ad_StartDate and :ad_EndDate and srledger.saleinvcode IS NOT NULL)) and*/
         ( saleledger.saleinvcode = saledetail.saleinvcode )AND
         ( saleledger.custcode = accounts.acccode ) 
         

GROUP BY 
		 accounts.name,
		 datepart(dy,saleledger.date),
		 flatdisc,
		 misccharges,
       saleledger.discperc
UNION ALL
  SELECT Custname = accounts.name,
		 saledate = max(saleledger.date),
		 InvCount= count(distinct saleledger.saleinvcode) , 
 		 InvValue=  Case when Round(Sum ( (saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) *  (1 - saledetail.discperc /100) * (1 - dbo.saleledger.discperc /100) - flatdisc   +   misccharges), 2) IS NULL Then 0  Else Round(Sum ( (saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) *  (1 - saledetail.discperc /100) * (1 - dbo.saleledger.discperc /100) ) - flatdisc   +   misccharges, 0) End 

    FROM saleledger,
		 saleinvdetail saledetail,   
         accounts  
   WHERE DBO.SaleLedger.impactinventory = 'N' AND
			/*( saleledger.date >= :ad_StartDate ) AND  
         ( saleledger.date <= :ad_EndDate ) AND*/
			( saleledger.custcode IN(:al_custcode)) and
			(dbo.saleledger.date between :ad_StartDate and :ad_EndDate) and   
			/*(dbo.saleledger.saleinvcode NOT IN (select distinct srledger.saleinvcode from srledger where srledger.date between :ad_StartDate and :ad_EndDate and srledger.saleinvcode IS NOT NULL)) and*/
         ( saleledger.saleinvcode = saledetail.saleinvcode )AND
         ( saleledger.custcode = accounts.acccode ) 
         

GROUP BY 
		 accounts.name,
		 datepart(dy,saleledger.date),
		 flatdisc,
		 misccharges,
		 saleledger.discperc"
  arguments=(("al_custcode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime))
 sort="custname A, saledate A"
)
