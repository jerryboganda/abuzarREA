column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=balance dbname="balance"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(50) updatewhereclause=yes name=custtaxregno dbname="custTaxRegno"  )
column=(type=char(100) updatewhereclause=yes name=saleledger_custrefno dbname="custrefno"  )
column=(type=char(100) updatewhereclause=yes name=custref2 dbname="custref2"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SaleLedger.remarks"  )
column=(type=char(1) updatewhereclause=yes name=printwaranty dbname="printwaranty"  )
column=(type=char(1) updatewhereclause=yes name=printbatch dbname="printbatch"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CUSTALIAS"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
column=(type=char(100) updatewhereclause=yes name=patientaddress dbname="patientaddress"  )
column=(type=decimal(2) updatewhereclause=yes name=cashreceived dbname="cashreceived"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="godown"  )
 retrieve="   SELECT itemname= item.name,
		saleitemdesc= max(saledetail.saleitemdescription) ,
		salecatcode=max(saleledger.salecatcode),   
         aliasname=item.customicode,   
         packingdesc=max(item.packingdesc), 
         accname =max(dbo.accounts.name),   
         address = max(dbo.customer.address1),
         address2=max( dbo.customer.address2),   
         city=max( dbo.customer.city),   
         licenceno= max(dbo.customer.licenceno),   
         username= dbo.users.username,   
         saleinvcode = dbo.saleledger.saleinvcode,   
         headerno = dbo.saleledger.headerno, 
			headerinvno=max(saleledger.headerinvno),  
         date = dbo.saleledger.date,   
         invdiscperc = dbo.saleledger.discperc,   
         misccharges = dbo.saleledger.misccharges,   
         flatdisc = dbo.saleledger.flatdisc,   
         invsalestax = dbo.saleledger.salestax,   
         gcode = saledetail.gcode,   
         icode = saledetail.icode,   
         batch = max(saledetail.batch),   
         expiry = min(saledetail.expiry),   
         looseqty =sum( saledetail.looseqty),   
         bonusqty = sum(saledetail.bonusqty),   
         packqty = sum(saledetail.packqty),   
         packunits= max(saledetail.packunits),   
         saleprice= saledetail.saleprice,   
         discperc = saledetail.discperc,   
         salestax = max(saledetail.salestax),  
			itemflatdisc=saledetail.itemflatdisc,   
         Id = max(dbo.saledetail.IDENTITYCOL),   
         posted=max(saleledger.posted),   
         balance=0,   
         unitsalestax = saledetail.unitsalestax,   
         gstperc = saledetail.gstperc,   
         invgstperc = max(saleledger.invgstperc1),   
         custTaxRegno=max(customer.salestaxregno)  ,
			custrefno=max(dbo.saleledger.custrefno),	
		custref2=max(saleledger.custrefno2),
			dbo.saleledger.remarks,
			printwaranty=max(dbo.saleledger.printwaranty),
			printbatch=max(dbo.saleledger.printbatch),
			salesman=max(ltrim(rtrim(dbo.salesman.name))),
			
			manufacturer=(select name from manufacturer where manfcode=max(item.manfcode)),
			CUSTALIAS=max(ACCOUNTS.ALIASNAME),
			patientname=(select name from patient where patientcode=max(saleledger.patientcode)),
			patientaddress=(select address1 from patient where patientcode=max(saleledger.patientcode)),
			cashreceived=max(saleledger.cashcharged) +(select isnull(sum(amount),0) from cashierwindow where cashierwindow.saleinvcode=saleledger.saleinvcode),
			godown=(select name from godown where godown.gcode=saledetail.gcode)
    FROM 
		saleledger
		LEFT OUTER JOIN salesman ON (dbo.saleledger.smancode = dbo.salesman.salesmancode),
		saledetail,   
		accounts,   
		customer,   
		users,   
		item 
   WHERE 
			( dbo.saleledger.saleinvcode=:ar_InvCode) AND
			( dbo.saleledger.saleinvcode=saledetail.saleinvcode) AND
			( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  
         ( dbo.customer.custcode = dbo.accounts.acccode ) AND  
         ( dbo.saleledger.salesmancode = dbo.users.usercode ) AND 
          ( dbo.saledetail.icode = dbo.item.icode)    

GROUP BY 
	saleledger.saleinvcode, 
	saleledger.date, 
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	saleledger.headerno,
	saleledger.salestax, 
	saleledger.remarks, 
	saledetail.icode, 
	/*			saledetail.rowgroup,*/
	saledetail.saleprice,
	saledetail.itemflatdisc,
	saledetail.discperc,
	saledetail.gstperc,
	saledetail.unitsalestax,
	saledetail.gcode, 
	item.name,
	item.icode,
	item.printable,
	item.customicode,
	users.username

ORDER BY dbo.saleledger.saleinvcode,
			godown,
			id
"
  arguments=(("ar_InvCode", number), ("al_groupcode", number))
)
