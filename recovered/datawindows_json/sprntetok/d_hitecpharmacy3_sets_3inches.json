  "retrieve": "SELECT \titemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end,  \n\t\t\tusers.username,  \n\t\t\tPOSTED=max(saleledger.posted), \n\t\t\treprintcounter=max(saleledger.reprintingcounter), \n\t\t\tsalecat=max(saleledger.salecatcode), \n\t\t\tsaleledger.custcode,\n\t\t\theaderno = dbo.saleledger.headerno,\n\t\t\tcustomer=(select name from accounts where acccode=saleledger.custcode),\n\t\t\tdbo.saleledger.saleinvcode,   \n\t\t\tdbo.saleledger.date,   \n\t\t\tdbo.saleledger.discperc,   \n\t\t\tmisccharges = 0/*dbo.saleledger.misccharges */,   \n\t\t\tinvflatdisc = 0/*dbo.saleledger.flatdisc*/ ,   \n\t\t\tdbo.saleledger.salestax,   \n\t\t\tdbo.saleledger.custcode,   \n\t\t\tdbo.saleledger.remarks,   \n\t\t\tdbo.saledetail.icode,   \n\t\t\tcashreceived=max(dbo.saleledger.cashreceived),\n\t\t\tId        = Max(SaleDetail.RowGroup) ,  \n\t\t\tlooseqty  = sum(saledetail.looseqty), \n\t\t\tpackqty   = sum(saledetail.packqty), \n\t\t\tpackunits = max(saledetail.packunits), \n\t\t\tsaleprice = max(saledetail.saleprice), \n\t\t\trate      = max(saledetail.rate),\n\t\t\tsalestax  = max(saledetail.salestax),   \n\t\t\tdiscperc  = max(saledetail.discperc), \n\t\t\tcustomername='                                  '  ,\n\t\t\titemflatdisc  = max(saledetail.itemflatdisc),\n\t\t\taliasname=item.customicode,\n\t\t\tmachinename=',' +  max(saleledger.machinename),\n\t\t\tgetserverdate=getdate()\n\nFROM \t\n\t\t\tdbo.saleledger, dbo.saledetail, item, Users \n\nWHERE\n\t\t\tdbo.saleledger.saleinvcode = :ra_InvCode AND\n\t\t\tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND \n\t\t\tsaleLedger.SalesManCode = users.userCode AND\n\t\t\tsaledetail.icode = item.icode AND\n\t\t\tsaledetail.RowGroup Not In \t(\n\t\t\t\t\t\t\t\tSelect RowGroup \n\t\t\t\t\t\t\t\tFrom   salesetsheader ssh, salesetsdetail ssd\n\t\t\t\t\t\t\t\tWhere  \tssh.saleinvcode = :ra_InvCode AND\n\t\t\t\t\t\t\t\t\t\t\t\tssh.setcode = ssd.setcode AND\n\t\t\t\t\t\t\t\t\t\t\t\tssd.RowGroup = dbo.SaleDetail.RowGroup)\n\nGROUP BY \n\t\t\tsaleledger.saleinvcode, \n\t\t\tsaleledger.date, \n\t\t\tsaleledger.custcode, \n\t\t\tsaleledger.discperc, \n\t\t\tsaleledger.flatdisc, \n\t\t\tsaleledger.misccharges, \n\t\t\tsaleledger.headerno,\n\t\t\tsaleledger.salestax, \n\t\t\tsaleledger.remarks, \n\t\t\tsaledetail.icode,\n\t\t\tsaledetail.rowgroup,  \n\t\t\tsaledetail.gcode, \n\t\t\titem.name,\n\t\t\titem.icode,\n\t\t\titem.printable,\n\t\t\titem.customicode,\n\t\t\tusers.username\n\nUnion All\n\nSELECT \titemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, \n\t\t\tusers.username, \n\t\t\tPOSTED=saleledger.posted,\n\t\t\tprintounter=0,\n\t\t\tsalecat= saleledger.salecatcode,\n\t\t\tsaleledger.custcode,\n\t\t\theaderno = dbo.saleledger.headerno,\n\t\t\tcustomer=(select name from accounts where acccode=saleledger.custcode),\n\t\t\tdbo.saleledger.saleinvcode,   \n\t\t\t\tdbo.saleledger.date,   \n\t\t\tdbo.saleledger.discperc,   \n\t\t\t/*dbo.saleledger.misccharges,   \n\t\t\tdbo.saleledger.flatdisc,   */\n\t\t\tmisccharges = 0/*dbo.saleledger.misccharges */,   \n\t\t\tinvflatdisc = 0/*dbo.saleledger.flatdisc*/ ,   \n\t\t\tdbo.saleledger.salestax,   \n\t\t\tdbo.saleledger.custcode,   \n\t\t\tdbo.saleledger.remarks,   \n\t\t\tsaledetail.icode,   \n\t\t\tcashreceived = dbo.saleledger.cashreceived,\n\t\t\tId        = SaleDetail.RowGroup,  \n\t\t\tlooseqty  = saledetail.looseqty, \n\t\t\tpackqty   = 0, \n\t\t\tpackunits = item.packunits, \n\t\t\tsaleprice = saledetail.saleprice, \n\t\t\trate      = saledetail.saleprice,\n\t\t\t\tsalestax  = 0,   \n\t\t\tdiscperc  = saledetail.discperc, \n\t\t\tcustomername='                                  '  ,\n\t\t\titemflatdisc  = 0,\n\t\t\taliasname=item.customicode,\n\t\t\tmachinename=',' + saleledger.machinename,\n\t\t\tgetserverdate=getdate()\n\n FROM \tdbo.saleledger,   \n\t\t\tUsers,\n\t\t\t(Select \t\tssh.saleinvcode,\n\t\t\t\t\t\t\tRowGroup = Max(ssd.RowGroup),\t\n\t\t\t\t\t\t\ticode = ssh.seticode,\n\t\t\t\t\t\t\tlooseqty = Max(ssh.qty),\n\t\t\t\t\t\t\tsaleprice = Max(ssh.SalePrice),\n\t\t\t\t\t\t\tdiscperc = 0\n\t\t\tFrom  \t\tSaleDetail sd,\n\t\t\t\t\t\t\tsalesetsheader ssh,\n\t\t\t\t\t\t\tsalesetsdetail ssd\n\t\t\tWhere  \t\tssh.saleinvcode = :ra_InvCode And\n\t\t\t\t\t\t\tsd.saleinvcode = ssh.saleinvcode And\n\t\t\t\t\t\t\tssh.setcode = ssd.setcode And\n\t\t\t\t\t\t\tsd.icode = ssd.icode And\n\t\t\t\t\t\t\tsd.RowGroup = ssd.RowGroup \n\t\t  Group By \t\tssh.saleinvcode,\n\t\t\t\t\t\t\tssh.setcode,\n\t\t\t\t\t\t\tssh.seticode) saledetail, item\n\nWHERE \tdbo.saleledger.saleinvcode = :ra_InvCode AND\n\t\t\tdbo.saleledger.saleinvcode = saledetail.saleinvcode AND \n\t\t\tsaleLedger.SalesManCode = users.userCode And\n\t\t\tsaledetail.icode = item.icode\n\nORDER BY ID",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  },
  "sort": "id A"
 },
