  "retrieve": "SELECT \n\titemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, \n\taliasname=max(item.customicode),\n\tusers.username, \n\treprintdate=getdate(),\n\theaderno = dbo.saleledger.headerno,\n\tposted=max(saleledger.posted),\n\tbalance=isnull(max(balance),0),\n\tdbo.saleledger.saleinvcode,\n\tdbo.saleledger.date,  \n\tmessagedesc=max(message.description) ,\n\tdbo.saleledger.discperc,   \n\tdbo.saleledger.misccharges,   \n\tdbo.saleledger.flatdisc,   \n\tdbo.saleledger.salestax,   \n\tdbo.saleledger.custcode,   \n\tdbo.saleledger.remarks,   \n\tdbo.saledetail.icode,   \n\tdbo.saledetail.gcode, \n\tId        = MAX(dbo.saledetail.IDENTITYCOL),  \n\tlooseqty  = sum(saledetail.looseqty), \n\tpackqty   = sum(saledetail.packqty), \n\tpackunits = max(saledetail.packunits), \n\tsaleprice = max(saledetail.saleprice), \n\trate      = max(saledetail.rate),\n\tsalestax  = max(saledetail.salestax),   \n\tdiscperc  = max(saledetail.discperc), \n\tcustomername='                                  '  ,\n\titemflatdisc  = max(saledetail.itemflatdisc),\n\tunitsalestax  = max(saledetail.unitsalestax),\n\tgstperc       = max(saledetail.gstperc),\n\tinvgstperc    = max(saleledger.invgstperc1),\n\treprintcounter=max(saleledger.reprintingcounter),\n\tdoctor=max(doctors.name),\n\tpatient=max(patient.name)\nFROM \n\tdbo.saleledger\n\tLEFT OUTER JOIN DBO.Message ON (dbo.saleledger.MessageCode = dbo.Message.MessageCode)\n\tLEFT OUTER JOIN DBO.Doctors ON (dbo.saleledger.doctcode = dbo.Doctors.doctcode)\n\tLEFT OUTER JOIN DBO.Patient ON (dbo.saleledger.Patientcode = dbo.Patient.Patientcode),\n\tdbo.saledetail,  \n\titem,\n\tUsers\n\t\nWHERE \n\t( dbo.saleledger.saleinvcode = :ra_InvCode ) AND\n\t( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND \n\t( saleLedger.SalesManCode = users.userCode ) and\n\t( saledetail.icode = item.icode )\nGROUP BY \n\tsaleledger.saleinvcode, \n\tsaleledger.date, \n\tsaleledger.custcode, \n\tsaleledger.discperc, \n\tsaleledger.flatdisc, \n\tsaleledger.misccharges, \n\tsaleledger.headerno,\n\tsaleledger.salestax, \n\tsaleledger.remarks, \n\tsaledetail.icode,\n\tsaledetail.rowgroup,  \n\tsaledetail.gcode, \n\titem.name,\n\titem.icode,\n\titem.printable,\n\tusers.username\nORDER BY \n\tMAX(dbo.saledetail.IDENTITYCOL)",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  },
