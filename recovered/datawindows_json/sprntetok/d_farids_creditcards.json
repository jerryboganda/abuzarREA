  "retrieve": " SELECT \n\tSaleInvCode=CashierWindow.SaleInvCode,   \n\tAccCode=CashierWindow.AccCode,   \n\tAccoutnName=Accounts.Name,   \n\tAmount=CashierWindow.Amount  \nFROM  \n\tCashierWindow, \n\tAccounts  \nWHERE \n\tAccounts.AccCode = CashierWindow.AccCode and  \n\tCashierWindow.SaleInvCode = :ai_code\nUNION ALL\nSELECT \n\tSaleInvCode=:ai_code,   \n\tAccCode=NULL,   \n\tAccoutnName=Null,   \n\tAmount=0.00\nFROM\n\t(SELECT a=1) A\nWHERE \n\t:ai_code NOT IN \n\t\t(SELECT DISTINCT CashierWindow.SaleInvCode FROM CashierWindow WHERE CashierWindow.SaleInvCode = :ai_code)\n\t\n",
