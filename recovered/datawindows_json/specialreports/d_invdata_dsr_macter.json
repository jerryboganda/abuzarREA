  "retrieve": "SELECT \n\tInvoiceLEN=10,\n\tInvoice = STR(SL.SaleInvCode, 10),\n\tDateLEN=10,\n\tDate=Convert(varchar(10), SL.DATE, 103),\n\tCustCodeLEN=10,\n\tCustCode = LTRIM(RTRIM(SUBSTRING(A.AliasName, 1, 10))) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(A.AliasName, 1, 10))))),\n\tProdCodeLEN=9,\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.Remarks)), 1, 9),\n\tBatchLEN=10,\n\tBatch=SUBSTRING(SD.Batch, 1, 10),\n\tUnitsLEN=12,\n\tUnits=STR(SD.LooseQty, 12),\n\tBonusLEN=12,\n\tBonus=STR(SD.BonusQty, 12),\n\tDiscountLEN=12,\n\tDiscount=STR(\n\t\t\tRound((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) + \n\t\t\t(SD.LooseQty * SD.ItemFlatDisc), 12, 2),\n\tNetValueLEN=12,\n\tNetValue=STR(\n\t\t\tRound((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2),\n\tFlagLen=1,\n\tFlag='S',\n\tDSCodeEN=6,\n\tDSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode))/*,\n\tPANameLEN = 60,\n\tPAName = ISNULL((SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = SL.SManCode), '') + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(ISNULL((SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = SL.SManCode), ''), 1, 60)))))*/\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tCustomer C,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate\nUNION ALL\nSELECT \n\tInvoiceLEN=10,\n\tInvoice = STR(SL.SRInvCode, 10),\n\tDateLEN=10,\n\tDate=Convert(varchar(10), SL.DATE, 103),\n\tCustCodeLEN=10,\n\tCustCode = LTRIM(RTRIM(SUBSTRING(A.AliasName, 1, 10))) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(A.AliasName, 1, 10))))),\n\tProdCodeLEN=9,\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.Remarks)), 1, 9),\n\tBatchLEN=10,\n\tBatch=SUBSTRING(SD.Batch, 1, 10),\n\tUnitsLEN=12,\n\tUnits=STR(SD.LooseQty, 12),\n\tBonusLEN=12,\n\tBonus=STR(SD.BonusQty, 12),\n\tDiscountLEN=12,\n\tDiscount=STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2),\n\tNetValueLEN=12,\n\tNetValue=STR(\n\t\t\tRound((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2),\n\tFlagLen=1,\n\tFlag='R',\n\tDSCodeEN=6,\n\tDSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode))/*,\n\tPANameLEN = 60,\n\tPAName = ISNULL((SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = SL.SManCode), '') + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(ISNULL((SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = SL.SManCode), ''), 1, 60)))))*/\nFROM\n\tSRLedger SL,\n\tSRDetail SD,\n\tCustomer C,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate\n",
