    "dbname": "Expiry"
   }
  ],
  "retrieve": "SELECT\n\tDSTBIDLEN=6,\n\tDSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),\n\tPRDIDLEN=9,\n\tPRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(I.CustomICode, 1, 9))))),\n\tBatchNoLen=10,\n\tBatchNo=GD.Batch,\n\tClosingStockLen=12,\n\tClosingStock=STR(SUM(ISNULL(GD.CurrQty, 0)), 12),\n\tExpiryLEN=11,\n\tExpiry=REPLACE(Convert(varchar(11), GD.Expiry, 106), ' ', '-')\nFROM\n\tItem I,\n\tGodownDetail GD\nWHERE\n\tI.ManfCode IN (:ai_manfcode) AND\n\tI.ICode = GD.ICode\nGROUP BY\n\tI.ICode,\n\tI.Name,\n\tI.CustomICode,\n\tGD.Batch,\n\tGD.Expiry\nHAVING SUM(ISNULL(GD.CurrQty, 0)) <> 0\nORDER BY\n\tPRDID,\n\tBatch,\n\tExpiry",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_manfcode",
      "number"
     ]
    },
    {
     "_items": [
      "as_distcode",
      "string"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
