  "retrieve": "SELECT\n\tS.SaleInvCode, \n\tS.Date, \n\tCustomer = A.Name ,\n\tItemPacking = IP.name,\n\tIPackCode = IP.PackCode,\n\tSaleTaxAmt = SUM(SaleTaxAmt),\n\tSalesValue = ROUND(SUM(S.itemvalue), 2),\n\ttotaldisc = (Select sum(sl.flatdisc) From saleledger sl Where sl.date between :ar_startdate and :ar_enddate),\n   \tmisccharg = (Select sum(sl.misccharges) From saleledger sl Where sl.date between :ar_startdate and :ar_enddate),\n\ttotalinvdiscperc= \n\t\t(select sum(ISNULL(B.invdiscperc,0))\n\t\tfrom\n\t\t\t(select invdiscperc = IsNull( sum(Round(((sd.looseqty + sd.packqty * sd.packunits) * (sd.saleprice - sd.itemflatdisc)) * (1 - (.01 * sd.discperc)),2)) * 0.01 * sl.discperc, 0)\n\t\t\tfrom  saleledger sl, saledetail sd\n\t\t\twhere sl.date between :ar_startdate and :ar_enddate AND sl.saleinvcode = sd.saleinvcode\n\t\t\tgroup by sl.saleinvcode, sl.discperc) as  B),\n\tdiff=(select sum ( ISNULL(A.rounddifference,0)) \n\t\t\tfrom\n\t\t\t\t(SELECT \n\t\t\t\t\trounddifference= \n\t\t\t\t\t\tRound(\n\t\t\t\t\t\t\tSum( sd.looseqty * sd.saleprice) - \n\t\t\t\t\t\t\tRound(Sum(\n\t\t\t\t\t\t\t\tRound(( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * sd.discperc * .01) + \n\t\t\t\t\t\t\t\t\t(sd.looseqty * sd.itemflatdisc), 2)), 2) - \n\t\t\t\t\t\t\tSum ( Round(sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01)),2)) * sl.discperc * 0.01 + \n\t\t\t\t\t\t\tsl.misccharges - sl.flatdisc,0)  -\n\t\t\t\t\t\t(Sum ( sd.looseqty * sd.saleprice) - \n\t\t\t\t\t\t\tRound(Sum (Round((sd.looseqty * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + \n\t\t\t\t\t\t\t\t(sd.looseqty  * sd.itemflatdisc),2)), 2) - \n\t\t\t\t\t\t\tSum (Round(sd.looseqty * (sd.saleprice - sd.itemflatdisc) * (1 - (sd.discperc * .01)),2)) * (sl.discperc * 0.01) + \n\t\t\t\t\t\t\tsl.misccharges - sl.flatdisc),\n\t\t\t\t\tnetammount= \n\t\t\t\t\t\t(Sum ( sd.looseqty * sd.saleprice) - Round(Sum (Round(( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * \n\t\t\t\t\t\t\t(sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc),2)), 2) + \n\t\t\t\t\t\tRound(Sum ( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * \n\t\t\t\t\t\t\t(1 - (sd.discperc * .01))) * sl.discperc * 0.01, 2) + \n\t\t\t\t\t\tsl.flatdisc + sl.misccharges)\n\t\t\t\tFROM saleledger sl, saledetail sd\n\t\t\t\tWHERE sl.saleinvcode = sd.saleinvcode and \n\t\t\t\t\tsl.date between :ar_startdate and :ar_enddate\n\t\t\t\tGROUP BY \n\t\t\t\t\tsl.misccharges, sl.flatdisc, sl.date, sl.saleinvcode, \n\t\t\t\t\tsl.discperc, sl.salestax, sl.salecatcode) as A),\n\ttotaltax=\n\t\t(SELECT ISNULL( SUM(Round(INV.itemsalestax + invtax,0) ),0)\n\t\tFROM\n\t\t\t(SELECT\n\t\t\t\titemsalestax = Sum (Round (sd.looseqty * sd.unitsalestax + Round ( Round (sd.looseqty * (sd.saleprice - sd.itemflatdisc ) * (1 - sd.discperc * 0.01 ), 2 ) * sd.gstperc * 0.01 , 2 ) , 2 ) ),\n\t\t\t\tinvtax=\tRound ( (Sum ( sd.looseqty * sd.saleprice) \n\t\t\t\t\t -   Round(Sum (Round(( sd.looseqty * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc),2)), 2) \n\t\t\t\t\t -  Sum (Round( sd.looseqty * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01)), 2)) * (sl.discperc * 0.01) \n\t\t\t\t\t - sl.flatdisc) * sl.invgstperc1 * 0.01 , 2)\n\t\t\tFROM saleledger sl, saledetail sd\n\t\t\tWHERE sl.saleinvcode = sd.saleinvcode and sl.date between :ar_startdate and :ar_enddate\n\t\t\tGROUP BY sl.misccharges, sl.flatdisc, sl.date, sl.saleinvcode,\n\t\t\t\tsl.discperc, sl.salestax, sl.invgstperc1) as INV)\nFROM\t\n\t(SELECT\n\t\tSL.saleinvcode,\n\t\tSL.Date,\n\t\tSL.CustCode,\n\t\tSD.icode,\n\t\tItemValue=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*\n\t\t\t(1 - (.01 * SD.discperc))),\n\t\tSaleTaxAmt = SUM((SD.looseqty + SD.packqty + SD.bonusqty) * SD.unitsalestax) +\n\t\t\t\tSUM(ROUND((SD.looseqty + SD.packqty) * (SD.SalePrice - SD.ItemFlatDisc) * (1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2))\n\tFROM\n\t\tsaleledger SL Inner Join saledetail SD On\n\t\tSL.SaleInvCode = SD.SaleInvcode \n\tWhere SL.Date Between :ar_startdate And :ar_enddate\n\tGROUP BY \n\t\t SL.saleinvcode,\n\t\t SL.Date,\n\t\t SL.CustCode,\n\t\t SL.salesmancode,\n\t\t SD.icode,\n\t\t SL.salecatcode,\n\t\t SL.salecatcode) S,\n\tItem I, \n\tItemPacking IP,\n\tCustomer C,\n\tAccounts A\nWhere   \n\tS.Icode \t= I.Icode And\n\tI.PackCode \t= IP.PackCode And\n\tIP.PackCode\tIN (:ar_packcode) And\n\tS.CustCode\t= C.CustCode And\n\tC.CustCode\t= A.AccCode\nGroup By \n\tS.SaleInvCode,\n\tS.Date,\n\tA.Name ,\n\tIP.PackCode,\n\tIP.name\n",
  "arguments": {
