  "retrieve": "SELECT \n\tInvoice = LTRIM(RTRIM(STR(SL.SaleInvCode, 20))),\n\tDate=Convert(varchar(10), SL.DATE, 103),\n\tFlag='S',\n\tCustCode  = LTRIM(RTRIM(A.AliasName)),\n\tBrickCode=LTRIM(RTRIM(STR(SA.SubAreaCode, 6))),\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),\n\tBatch=SUBSTRING(SD.Batch, 1, 10),\n\tExpiry=Convert(varchar(10), SD.Expiry, 103),\n\tBonus='FALSE',\n\tUnits=LTRIM(RTRIM(STR(SD.LooseQty, 12))),\n\tTradePrice = LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))),\n\tDiscount=LTRIM(RTRIM(STR(SD.DiscPerc, 6, 2))),\n\tDiscountAmount=LTRIM(RTRIM(STR(\n\t\t\tRound((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + \n\t\t\t(SD.LooseQty * SD.ItemFlatDisc), 12, 2))),\n\tDsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),\n\tMSMRegionID=''\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tCustomer C,\n\tSubArea SA,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tSD.LooseQty > 0 AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.SubAreaCode=SA.SubAreaCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\nUNION ALL\nSELECT \n\tInvoice = LTRIM(RTRIM(STR(SL.SaleInvCode, 20))),\n\tDate=Convert(varchar(10), SL.DATE, 103),\n\tFlag='S',\n\tCustCode  = LTRIM(RTRIM(A.AliasName)),\n\tBrickCode=LTRIM(RTRIM(STR(SA.SubAreaCode, 6))),\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),\n\tBatch=SUBSTRING(SD.Batch, 1, 10),\n\tExpiry=Convert(varchar(10), SD.Expiry, 103),\n\tBonus= 'TRUE ',\n\tUnits=LTRIM(RTRIM(STR(SD.BonusQty, 12))),\n\tTradePrice = LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))),\n\tDiscount=LTRIM(RTRIM(STR(SD.DiscPerc, 6, 2))),\n\tDiscountAmount=LTRIM(RTRIM(STR(\n\t\t\tRound((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + \n\t\t\t(SD.LooseQty * SD.ItemFlatDisc), 12, 2))),\n\tDsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),\n\tMSMRegionID=''\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tCustomer C,\n\tSubArea SA,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tSD.BonusQty > 0 AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.SubAreaCode=SA.SubAreaCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\nUNION ALL\nSELECT \n\tInvoice = LTRIM(RTRIM(STR(SL.SRInvCode, 20))),\n\tDate=Convert(varchar(10), SL.DATE, 103),\n\tFlag='R',\n\tCustCode  = LTRIM(RTRIM(A.AliasName)),\n\tBrickCode=LTRIM(RTRIM(STR(SA.SubAreaCode, 6))),\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),\n\tBatch=SUBSTRING(SD.Batch, 1, 10),\n\tExpiry=Convert(varchar(10), SD.Expiry, 103),\n\tBonus='FALSE',\n\tUnits=LTRIM(RTRIM(STR(-1 * (SD.LooseQty), 12))),\n\tTradePrice = LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))),\n\tDiscount=LTRIM(RTRIM(STR(SD.DiscPerc, 6, 2))),\n\tDiscountAmount= LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),\n\tDsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),\n\tMSMRegionID=''\nFROM\n\tSRLedger SL,\n\tSRDetail SD,\n\tCustomer C,\n\tSubArea SA,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tSD.LooseQty > 0 AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.SubAreaCode=SA.SubAreaCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\nUNION ALL\nSELECT \n\tInvoice = LTRIM(RTRIM(STR(SL.SRInvCode, 20))),\n\tDate=Convert(varchar(10), SL.DATE, 103),\n\tFlag='R',\n\tCustCode  = LTRIM(RTRIM(A.AliasName)),\n\tBrickCode=LTRIM(RTRIM(STR(SA.SubAreaCode, 6))),\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),\n\tBatch=SUBSTRING(SD.Batch, 1, 10),\n\tExpiry=Convert(varchar(10), SD.Expiry, 103),\n\tBonus='True',\n\tUnits=LTRIM(RTRIM(STR(-1 * (SD.BonusQty), 12))),\n\tTradePrice = LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))),\n\tDiscount=LTRIM(RTRIM(STR(SD.DiscPerc, 6, 2))),\n\tDiscountAmount= LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),\n\tDsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),\n\tMSMRegionID=''\nFROM\n\tSRLedger SL,\n\tSRDetail SD,\n\tCustomer C,\n\tSubArea SA,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tSD.BonusQty > 0 AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.SubAreaCode=SA.SubAreaCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\nUNION ALL\nSELECT \n\tInvoice = LTRIM(RTRIM(STR(SL.PurInvCode, 20))),\n\tDate=Convert(varchar(10), SL.DATE, 103),\n\tFlag='P',\n\tCustCode  = '',\n\tBrickCode='',\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),\n\tBatch=SUBSTRING(SD.Batch, 1, 10),\n\tExpiry=Convert(varchar(10), SD.Expiry, 103),\n\tBonus=CASE WHEN SD.BonusQty >  0 THEN 'TRUE ' ELSE 'FALSE' END,\n\tUnits=LTRIM(RTRIM(STR(SD.PackQty + SD.LooseQty + SD.BonusQty, 12))),\n\tTradePrice = LTRIM(RTRIM(STR(SD.PurPrice, 12, 2))),\n\tDiscount=LTRIM(RTRIM(LTRIM(RTRIM(STR(SD.DiscPerc, 6, 2))))),\n\tDiscountAmount= LTRIM(RTRIM(STR(Round(((SD.PackQty + SD.LooseQty) * SD.PurPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),\n\tDsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),\n\tMSMRegionID=''\nFROM\n\tPurLedger SL,\n\tPurDetail SD,\n\tSupplier C,\n\tAccounts A,\n\tItem I\nWHERE\n\tSL.PurInvCode = SD.PurInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.SuppCode = C.SuppCode AND\n\tC.SuppCode = A.AccCode AND \n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\nUNION ALL\nSELECT \n\tInvoice = LTRIM(RTRIM(STR(SL.PrInvCode, 20))),\n\tDate=Convert(varchar(10), SL.DATE, 103),\n\tFlag='O',\n\tCustCode  = '',\n\tBrickCode='',\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),\n\tBatch=SUBSTRING(SD.Batch, 1, 10),\n\tExpiry=Convert(varchar(10), SD.Expiry, 103),\n\tBonus=CASE WHEN SD.BonusQty >  0 THEN 'TRUE ' ELSE 'FALSE' END,\n\tUnits=LTRIM(RTRIM(STR(SD.PackQty + SD.LooseQty + SD.BonusQty, 12))),\n\tTradePrice = LTRIM(RTRIM(STR(SD.PrPrice, 12, 2))),\n\tDiscount=LTRIM(RTRIM(STR(SD.DiscPerc, 6, 2))),\n\tDiscountAmount= LTRIM(RTRIM(STR(Round(((SD.PackQty + SD.LooseQty) * SD.PrPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),\n\tDsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),\n\tMSMRegionID=''\nFROM\n\tPrLedger SL,\n\tPrDetail SD,\n\tSupplier C,\n\tAccounts A,\n\tItem I\nWHERE\n\tSL.PrInvCode = SD.PrInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.SuppCode = C.SuppCode AND\n\tC.SuppCode = A.AccCode AND \n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate",
