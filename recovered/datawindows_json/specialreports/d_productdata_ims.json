  "retrieve": "SELECT \n\tPRODCODELEN=10,\n\tPRODCODE=STR(I.ICode, 10),\n\tProdNameLen=100,\n\tProdName=I.Name,\n\tPackingLen=60,\n\tPacking=I.PackingDesc,\n\tTPLEN=12,\n\tTP=STR(ISNULL(I.SalePrice, 0), 12, 2),\n\tManufacturerLen=100,\n\tManufacturer=M.Name\nFROM\n\tItem I, Manufacturer M\nWHERE\n\tI.ManfCode = M.ManfCode AND M.ManfCode IN (:ai_manfcode)\nORDER BY\n\tPRODCODE",
