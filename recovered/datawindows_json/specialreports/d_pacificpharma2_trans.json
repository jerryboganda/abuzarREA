  "retrieve": "SELECT\n\tTransactionDate=CONVERT(VARCHAR(10), H.Date, 120),\n\tInvoiceNumber=H.SaleInvCode, \n\tChemistCode = A.AliasName,\n\tProductCode=I.CustomICode, \n\tBatchNumber=D.Batch, \n\tPackSize=I.PackingDesc, \n\tTradePrice=D.SalePrice,\n\tUnits = D.LooseQty,\n\tBonusUnits = D.BonusQty,\n\tDiscountAmount = (D.LooseQty * D.ItemFlatDisc) + (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (D.DiscPerc * 0.01)),\n\tNetValue = (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)),\n\tType = 'S',\n\tDistCode=LTRIM(RTRIM(:as_distcode + SPACE(10)))\nFROM \n\tSaleLedger H, SaleDetail D, Item I, Customer C, Accounts A\nWHERE \n\tH.Date BETWEEN :adt_StartDate AND :adt_EndDate AND\n\tH.Posted = 'Y' AND\n\tH.SaleInvCode = D.SaleInvCode AND\n\tD.ICode = I.ICode AND\n\tI.ManfCode = :ai_manfcode AND\n\tH.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode\nUNION ALL\nSELECT\n\tTransactionDate=CONVERT(VARCHAR(10), H.Date, 120),\n\tInvoiceNumber=H.SRInvCode, \n\tChemistCode = A.AliasName,\n\tProductCode=I.CustomICode, \n\tBatchNumber=D.Batch, \n\tPackSize=I.PackingDesc, \n\tTradePrice=D.SalePrice,\n\tUnits = D.LooseQty,\n\tBonusUnits = D.BonusQty,\n\tDiscountAmount = (D.LooseQty * D.SRPrice * (D.DiscPerc * 0.01)),\n\tNetValue = (D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01)),\n\tType = 'R',\n\tDistCode=LTRIM(RTRIM(:as_distcode + SPACE(10)))\nFROM \n\tSRLedger H, SRDetail D, Item I, Customer C, Accounts A\nWHERE \n\tH.Date BETWEEN :adt_StartDate AND :adt_EndDate AND\n\tH.Posted = 'Y' AND\n\tH.SRInvCode = D.SRInvCode AND\n\tD.ICode = I.ICode AND\n\tI.ManfCode = :ai_manfcode AND\n\tH.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode\nORDER BY\n\tType, InvoiceNumber, ProductCode, BatchNumber",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_distcode",
      "string"
     ]
