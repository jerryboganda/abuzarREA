  "retrieve": "SELECT\n\tInvoiceCode = SL.SaleInvCode,\n\tDate=SL.DATE,\n\tCustCode = A.AccCode,\n\tProdCode=SD.ICode,\n\tBatch=SD.Batch,\n\tUnits=SD.LooseQty,\n\tBonus=SD.BonusQty,\n\tPrice = SD.SalePrice,\n\tDiscount = Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) + \t(SD.LooseQty * SD.ItemFlatDisc),\n\tNetValue = Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), \n\tReason='S'\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tCustomer C,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate\nUNION ALL\nSELECT \n\tInvoiceCode = SL.SRInvCode,\n\tDate=SL.DATE,\n\tCustCode = A.AccCode,\n\tProdCode=SD.ICode,\n\tBatch=SD.Batch,\n\tUnits = - SD.LooseQty, \n\tBonus = - SD.BonusQty,\n\tPrice = SD.SRPrice,\n\tDiscount= - Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), \n\tNetValue= - Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), \n\tReason='R'\nFROM\n\tSRLedger SL,\n\tSRDetail SD,\n\tCustomer C,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate\nORDER BY\n\tProdCode,\n\tReason,\n\tDate,\n\tInvoiceCode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "manfcode",
      "number"
     ]
    },
    {
     "_items": [
      "ar_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
