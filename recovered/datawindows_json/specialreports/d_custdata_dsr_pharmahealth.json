  "retrieve": "SELECT\n\tCodeLEN=12,\n\tCode = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),\n\tNameLEN=60,\n\tName = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))))),\n\tADDRESS1LEN=60,\n\tADDRESS1 = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))))),\n\tADDRESS2LEN=60,\n\tADDRESS2 = LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 60))))),\n\tPhoneLen=100,\n\tPhone = LTRIM(RTRIM(SUBSTRING(C.Phone, 1, 100))) + REPLICATE(' ', 100 - LEN(LTRIM(RTRIM(SUBSTRING(C.Phone, 1, 100))))),\n\tLicenseLen=30,\n\tLicense = LTRIM(RTRIM(SUBSTRING(C.LicenceNo, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(C.LicenceNo, 1, 30))))),\n\tAreaCodeLEN=3,\n\tAreaCode=STR(AR.AREACODE, 3),\n\tAreaNameLEN=60,\n\tAreaName = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 60))))),\n\tCustTypeLEN=2,\n\tCustType=CASE \n\t\tWHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN '01'\n\t\tWHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN '02'\n\t\tWHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN '03'\n\t\tWHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN '04'\n\t\tELSE '02' END,\n\tDsCodeLEN=6,\n\tDsCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode))\nFROM Customer C, Accounts A, Area AR\nWHERE C.CustCode = A.AccCode AND C.AreaCode = AR.AreaCode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_distcode",
      "string"
     ]
    }
   ]
  }
 },
