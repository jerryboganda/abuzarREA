    "name": "dscode",
    "dbname": "DsCode"
   }
  ],
  "retrieve": "SELECT\n\tUnitsLen=10,\n\tUnits=STR(SUM(Units), 10),\n\tDsCodeLen=100,\n\tDsCode=CONVERT(VARCHAR(100), :as_dscode)\nFROM\n\t(SELECT \n\t\tUnits=SUM(SD.LooseQty)\n\tFROM\n\t\tSaleLedger S, SaleDetail SD, Item I\n\tWHERE\n\t\tS.Date >= :ar_startdate AND S.Date <= :ar_enddate AND\n\t\tSD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode) AND\n\t\tS.SaleInvCode = SD.SaleInvCode\n\tUNION ALL\n\tSELECT \n\t\tUnits=- SUM(SD.LooseQty)\n\tFROM\n\t\tSRLedger S, SRDetail SD, Item I\n\tWHERE\n\t\tS.Date >= :ar_startdate AND S.Date <= :ar_enddate AND\n\t\tSD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode) AND\n\t\tS.SRInvCode = SD.SRInvCode) S",
  "arguments": {
   "_items": [
