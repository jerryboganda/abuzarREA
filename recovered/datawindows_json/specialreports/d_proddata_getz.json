  "retrieve": "SELECT \n\tDSTBIDLEN=6,\n\tDSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),\n\tPRDIDLEN=9,\n\tPRDID=SUBSTRING(LTRIM(RTRIM(I.Remarks)), 1, 9) + REPLICATE(' ', 9 - LEN(LTRIM(RTRIM(SUBSTRING(I.REMARKS, 1, 9))))),\n\tPRDLEN=50,\n\tPRD = LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50)))))\nFROM\n\tItem I\nWHERE\n\tI.ManfCode=:manfcode\nORDER BY\n\tPRD",
