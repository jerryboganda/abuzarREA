  "retrieve": "SELECT\n\tDistributorID=LTRIM(RTRIM(:as_distcode+SPACE(100))),\n\tCustID = LTRIM(RTRIM(A.AliasName)),\n\tFullName = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))),\n\tADDRESS = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))),\n\tBrickID=LTRIM(RTRIM(STR(SAR.SubAreaCode, 6))),\n\tBrick = LTRIM(RTRIM(SUBSTRING(SAR.Name, 1, 60))),\n\tCustType=LTRIM(RTRIM(CT.NAME)),\n\tTownID=LTRIM(RTRIM(STR(C.AreaCode, 6))),\n\tTownName=(SELECT Area.Name FROM Area WHERE Area.AreaCode = C.AreaCode)\nFROM Customer C, Accounts A, SubArea SAR, CUSTOMERCATEGORY CT\nWHERE C.CustCode = A.AccCode AND C.SubAreaCode = SAR.SubAreaCode AND C.CUSTCATCODE = CT.CUSTCATCODE\n",
  "arguments": {
   "_items": [
