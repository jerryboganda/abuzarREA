  "retrieve": "SELECT \n\tDistributor_ID=:as_distcode + REPLICATE(' ', 10 - LEN(:as_distcode)),\n\tCountry_ID = 'CEN',\n\tCustomer_ID=LTRIM(RTRIM(A.AliasName)),\n\tCustomer_Desc=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(A.Name)), 1, 60))),\n\tChannel_ID=(SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE),\n\tArea_ID = NULL,\n\tKey_Account_ID=NULL\nFROM\n\tCustomer C, Accounts A\nWHERE\n\tC.CustCode = A.AccCode\nORDER BY\n\tA.AccCode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_distcode",
      "string"
     ]
    }
   ]
  }
 },
