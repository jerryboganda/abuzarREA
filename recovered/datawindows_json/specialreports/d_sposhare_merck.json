  "retrieve": "SELECT \n\tDSTBIDLEN=6,\n\tDSTBID=:as_distid + REPLICATE(' ', 6 - LEN(:as_distid)),\n\tSPOIDLEN=20,\n\tSPOID=STR(S.SPOCode, 20),\n\tSPONameLEN=50,\n\tSPOName=LTRIM(RTRIM(SUBSTRING(S.Name, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(S.Name, 1, 50))))),\n\tTeamLen=30,\n\tTeam = LTRIM(RTRIM(SUBSTRING(T.Name, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(T.Name, 1, 30))))),\n\tTownIDLen=16,\n\tTownID = STR(SA.SubAreaCode, 16),\n\tTownLen=50,\n\tTown = LTRIM(RTRIM(SUBSTRING(SA.Name, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(SA.Name, 1, 50))))),\n\tShareLen=12,\n\tShare=STR(M.SharePerc, 12, 2)\nFROM SPO S, SPOTeam T, SPOTeamMember M, SPOTeamSubArea TSA, SubArea SA\nWHERE\n\tT.SPOTeamCode IN (:ai_spoteamcode) AND\n\tT.SPOTeamCode = M.SPOTeamCode AND\n\tM.SPOCode = S.SPOCode AND\n\tT.SPOTeamCode = TSA.SPOTeamCode AND\n\tTSA.SubAreaCode = SA.SubAreaCode\n\t",
