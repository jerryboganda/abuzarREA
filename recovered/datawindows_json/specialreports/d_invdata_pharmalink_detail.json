  "retrieve": "SELECT \n\tDocumentCode = LTRIM(RTRIM(STR(SL.SaleInvCode, 15))),\n\tDocumentType= 'SI',\n\tDocumentDate=Convert(varchar(10), SL.DATE, 103),\n\tItemCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9))),\n\tBatch=SD.Batch, \n\tSalePrice = LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))),\n\tExpiry=Convert(varchar(10), SD.Expiry, 103),\n\tBonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),\n\tUnits=LTRIM(RTRIM(STR(SD.LooseQty, 12))),\n\tGrossAmount=LTRIM(RTRIM(STR(Round(SD.LooseQty * SD.SalePrice, 2), 12, 2))),\n\tDiscPerc=LTRIM(RTRIM(STR(SD.DiscPerc, 5, 2))),\n\tDiscount=LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) + (SD.LooseQty * SD.ItemFlatDisc), 12, 2))),\n\tSaleTaxType = CASE WHEN SD.GSTPerc > 0 THEN 'P' WHEN SD.UnitSalesTax > 0 THEN 'V' ELSE 'N' END,\n\tSaleTax = LTRIM(RTRIM(STR(CASE WHEN SD.GSTPerc > 0 THEN SD.GSTPerc WHEN SD.UnitSalesTax > 0 THEN SD.UnitSalesTax ELSE 0.00 END, 12, 2))),\n\tSaleTaxAmount=LTRIM(RTRIM(STR(Round(((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) * SD.GSTPerc * 0.01), 2) + ROUND(((SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax), 2), 12, 2))),\n\tNetAmount=LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2)))\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tCustomer C,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode IN (:manfcode) AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\nUNION ALL\nSELECT \n\tDocumentCode = LTRIM(RTRIM(STR(SL.SRInvCode, 15))),\n\tDocumentType= 'SR',\n\tDocumentDate=Convert(varchar(10), SL.DATE, 103),\n\tItemCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9))),\n\tBatch=SD.Batch,\n\tSalePrice = LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))),\n\tExpiry=Convert(varchar(10), SD.Expiry, 103),\n\tBonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),\n\tUnits=LTRIM(RTRIM(STR(SD.LooseQty, 12))),\n\tGrossAmount=LTRIM(RTRIM(STR(Round(SD.LooseQty * SD.SRPrice, 2), 12, 2))),\n\tDiscPerc=LTRIM(RTRIM(STR(SD.DiscPerc, 5, 2))),\n\tDiscount=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),\n\tSaleTaxType = CASE WHEN SD.GSTPerc > 0 THEN 'P' WHEN SD.UnitSalesTax > 0 THEN 'V' ELSE 'N' END,\n\tSaleTax = LTRIM(RTRIM(STR(CASE WHEN SD.GSTPerc > 0 THEN SD.GSTPerc WHEN SD.UnitSalesTax > 0 THEN SD.UnitSalesTax ELSE 0.00 END, 12, 2))),\n\tSaleTaxAmount=LTRIM(RTRIM(STR(Round(((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)) * SD.GSTPerc * 0.01), 2) + ROUND(((SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax), 2), 12, 2))),\n\tNetAmount=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2)))\nFROM\n\tSRLedger SL,\n\tSRDetail SD,\n\tCustomer C,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode IN (:manfcode) AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\nUNION ALL\nSELECT\n\tDocumentCode = LTRIM(RTRIM(STR(SL.PurInvCode, 15))),\n\tDocumentType= 'PI',\n\tDocumentDate=Convert(varchar(10), SL.DATE, 103),\n\tItemCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9))),\n\tBatch=SD.Batch, \n\tSalePrice = LTRIM(RTRIM(STR(SD.PurPrice, 12, 2))),\n\tExpiry=Convert(varchar(10), SD.Expiry, 103),\n\tBonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),\n\tUnits=LTRIM(RTRIM(STR(SD.PackQty + SD.LooseQty, 12))),\n\tGrossAmount=LTRIM(RTRIM(STR(Round((SD.PackQty + SD.LooseQty) * SD.PurPrice, 2), 12, 2))),\n\tDiscPerc=LTRIM(RTRIM(STR(SD.DiscPerc, 5, 2))),\n\tDiscount=LTRIM(RTRIM(STR(Round(((SD.PackQty + SD.LooseQty) * SD.PurPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),\n\tSaleTaxType = CASE WHEN SD.GSTPerc > 0 THEN 'P' WHEN SD.UnitSalesTax > 0 THEN 'V' ELSE 'N' END,\n\tSaleTax = LTRIM(RTRIM(LTRIM(RTRIM(STR(CASE WHEN SD.GSTPerc > 0 THEN SD.GSTPerc WHEN SD.UnitSalesTax > 0 THEN SD.UnitSalesTax ELSE 0.00 END, 12, 2))))),\n\tSaleTaxAmount=LTRIM(RTRIM(STR(Round((((SD.PackQty + SD.LooseQty) * SD.PurPrice * (1 - SD.DiscPerc * 0.01)) * SD.GSTPerc * 0.01), 2) + ROUND(((SD.PackQty + SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax), 2), 12, 2))),\n\tNetAmount=LTRIM(RTRIM(STR(Round(((SD.PackQty + SD.LooseQty) * SD.PurPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2)))\nFROM\n\tPurLedger SL,\n\tPurDetail SD,\n\tSupplier S,\n\tAccounts A,\n\tItem I\nWHERE\n\tSL.PurInvCode = SD.PurInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode IN (:manfcode) AND\n\tSL.SuppCode = S.SuppCode AND\n\tS.SuppCode = A.AccCode AND \n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\nUNION ALL\nSELECT\n\tDocumentCode = LTRIM(RTRIM(STR(SL.PrInvCode, 15))),\n\tDocumentType= 'PR',\n\tDocumentDate=Convert(varchar(10), SL.DATE, 103),\n\tItemCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9))),\n\tBatch=SD.Batch,\n\tSalePrice = LTRIM(RTRIM(STR(SD.PrPrice, 12, 2))),\n\tExpiry=Convert(varchar(10), SD.Expiry, 103),\n\tBonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),\n\tUnits=LTRIM(RTRIM(STR(SD.PackQty + SD.LooseQty, 12))),\n\tGrossAmount=LTRIM(RTRIM(STR(Round((SD.PackQty + SD.LooseQty) * SD.PrPrice, 2), 12, 2))),\n\tDiscPerc=LTRIM(RTRIM(STR(SD.DiscPerc, 5, 2))),\n\tDiscount=LTRIM(RTRIM(STR(Round(((SD.PackQty + SD.LooseQty) * SD.PrPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),\n\tSaleTaxType = CASE WHEN SD.GSTPerc > 0 THEN 'P' WHEN SD.UnitSalesTax > 0 THEN 'V' ELSE 'N' END,\n\tSaleTax = LTRIM(RTRIM(STR(CASE WHEN SD.GSTPerc > 0 THEN SD.GSTPerc WHEN SD.UnitSalesTax > 0 THEN SD.UnitSalesTax ELSE 0.00 END, 12, 2))),\n\tSaleTaxAmount=LTRIM(RTRIM(STR(Round((((SD.PackQty + SD.LooseQty) * SD.PrPrice * (1 - SD.DiscPerc * 0.01)) * SD.GSTPerc * 0.01), 2) + ROUND(((SD.PackQty + SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax), 2), 12, 2))),\n\tNetAmount=LTRIM(RTRIM(STR(Round(((SD.PackQty + SD.LooseQty) * SD.PrPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2)))\nFROM\n\tPrLedger SL,\n\tPrDetail SD,\n\tSupplier S,\n\tAccounts A,\n\tItem I\nWHERE\n\tSL.PrInvCode = SD.PrInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode IN (:manfcode) AND\n\tSL.SuppCode = S.SuppCode AND\n\tS.SuppCode = A.AccCode AND \n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\nUNION ALL\nSELECT\n\tDocumentCode = LTRIM(RTRIM(STR(SL.AdjCode, 15))),\n\tDocumentType= CASE WHEN SL.AdjCatCode = 1 THEN 'TI' ELSE 'TO' END,\n\tDocumentDate=Convert(varchar(10), SL.DATE, 103),\n\tItemCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9))),\n\tBatch=SD.Batch, \n\tSalePrice = LTRIM(RTRIM(STR(SD.Price, 12, 2))),\n\tExpiry=Convert(varchar(10), SD.Expiry, 103),\n\tBonus='0',\n\tUnits=LTRIM(RTRIM(STR(SD.LooseQty, 12))),\n\tGrossAmount=LTRIM(RTRIM(STR(Round(SD.LooseQty * SD.Price, 2), 12, 2))),\n\tDiscPerc='0.00',\n\tDiscount='0.00',\n\tSaleTaxType = 'N',\n\tSaleTax = '0.00',\n\tSaleTaxAmount='0.00',\n\tNetAmount=LTRIM(RTRIM(STR(Round(SD.LooseQty * SD.Price, 2), 12, 2)))\nFROM\n\tAdjHeader SL,\n\tAdjDetail SD,\n\tItem I\nWHERE\n\tSL.AdjCode = SD.AdjCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode IN (:manfcode) AND\n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\n",
