  "retrieve": "SELECT \n\tDSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),\n\tDate=LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(100), SL.Date, 106), ' ', '-')))),\n\tSaleType=CASE SL.SaleCatCode WHEN 3 THEN 'C' ELSE 'I' END,\n\tInvoice = LTRIM(RTRIM(STR(SL.SaleInvCode, 10))),\n\tSalesManCode  = LTRIM(RTRIM(ISNULL(STR(SL.SManCode, 6), ''))),\n\tCustCode  = LTRIM(RTRIM(ISNULL(STR(SL.CustCode, 6), ''))),\n\tRegionCode=LTRIM(RTRIM(STR(R.RegionCode, 6))),\n\tTerritoryCode=LTRIM(RTRIM(STR(AR.AreaCode, 6))),\n\tMedicalRep=LTRIM(RTRIM(STR(C.SalesManCode, 6))),\n\tZoneCode  = LTRIM(RTRIM(ISNULL(STR(R.RegionCode, 6), ''))),\n\tItemCode=LTRIM(RTRIM(I.CustomICode)),\n\tBatch=LTRIM(RTRIM(SD.Batch)),\n\tTradePrice=LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))),\n\tDiscountTradePrice=LTRIM(RTRIM(STR(Round((SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01), 2), 12, 2))),\n\tDiscountPerc=LTRIM(RTRIM(STR(SD.DiscPerc, 5, 2))),\n\tDiscountAmt=LTRIM(RTRIM(STR(Round((LooseQty * SD.ItemFlatDisc) + (LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * SD.DiscPerc * 0.01), 2), 12, 2))),\n\tGSTPerc=LTRIM(RTRIM(STR(SD.GSTPerc, 5, 2))),\n\tGSTAmt=LTRIM(RTRIM(STR(Round((LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2), 12, 2))), \n\tSaleQty=LTRIM(RTRIM(STR(SD.LooseQty, 12))),\n\tBonusQty=LTRIM(RTRIM(STR(SD.BonusQty, 12))),\n\tReturnQty=LTRIM(RTRIM(STR(0, 12))),\n\tReturnAmt=LTRIM(RTRIM(STR(0, 12))),\n\tGrossAmt=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SalePrice), 2), 12, 2))),\n\tNetAmt=LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2))),\n\tAreaCode = LTRIM(RTRIM(ISNULL(STR(AR.AreaCode, 6), '')))\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tCustomer C,\n\tAccounts A,\n\tArea AR,\n\tRegion R,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode IN (:ai_manfcode) AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.CustCatCode = CC.CustCatCode AND\n\tC.AreaCode = AR.AreaCode AND\n\tAR.RegionCode = R.RegionCode AND\n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\nUNION ALL\nSELECT \n\tDSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),\n\tDate=LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(100), SL.Date, 106), ' ', '-')))),\n\tSaleType=CASE SL.SRCatCode WHEN 7 THEN 'C' ELSE 'I' END,\n\tInvoice = LTRIM(RTRIM(STR(SL.SRInvCode, 10))),\n\tSalesManCode  = LTRIM(RTRIM(ISNULL(STR(SL.SManCode, 6), ''))),\n\tCustCode  = LTRIM(RTRIM(ISNULL(STR(SL.CustCode, 6), ''))),\n\tRegionCode=LTRIM(RTRIM(STR(R.RegionCode, 6))),\n\tTerritoryCode=LTRIM(RTRIM(STR(AR.AreaCode, 6))),\n\tMedicalRep=LTRIM(RTRIM(STR(C.SalesManCode, 6))),\n\tZoneCode  = LTRIM(RTRIM(ISNULL(STR(R.RegionCode, 6), ''))),\n\tItemCode=LTRIM(RTRIM(I.CustomICode)),\n\tBatch=LTRIM(RTRIM(SD.Batch)),\n\tTradePrice=LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))),\n\tDiscountTradePrice=LTRIM(RTRIM(STR(Round(SD.SRPrice * (1 - SD.DiscPerc * 0.01), 2), 12, 2))),\n\tDiscountPerc=LTRIM(RTRIM(STR(SD.DiscPerc, 5, 2))),\n\tDiscountAmt=LTRIM(RTRIM(STR(Round((LooseQty * SD.SRPrice * SD.DiscPerc * 0.01), 2), 12, 2))),\n\tGSTPerc=LTRIM(RTRIM(STR(SD.GSTPerc, 5, 2))),\n\tGSTAmt=LTRIM(RTRIM(STR(Round((LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2), 12, 2))), \n\tSaleQty=LTRIM(RTRIM(STR(0, 12))),\n\tBonusQty=LTRIM(RTRIM(STR(SD.BonusQty, 12))),\n\tReturnQty=LTRIM(RTRIM(STR(SD.LooseQty, 12))),\n\tReturnAmt=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2))),\n\tGrossAmt=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice), 2), 12, 2))),\n\tNetAmt=LTRIM(RTRIM(STR(0, 12, 2))),\n\tAreaCode = LTRIM(RTRIM(ISNULL(STR(AR.AreaCode, 6), '')))\nFROM\n\tSRLedger SL,\n\tSRDetail SD,\n\tCustomer C,\n\tAccounts A,\n\tArea AR,\n\tRegion R,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode IN (:ai_manfcode) AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.CustCatCode = CC.CustCatCode AND\n\tC.AreaCode = AR.AreaCode AND\n\tAR.RegionCode = R.RegionCode AND\n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_distcode",
      "string"
     ]
    },
    {
     "_items": [
      "ai_manfcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ar_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
