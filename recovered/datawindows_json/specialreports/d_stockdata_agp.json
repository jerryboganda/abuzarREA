  "retrieve": "SELECT\n\tProdCodeLen=10,\n\tProdCode=STR(ST.ICode, 10),\n\tBatchNoLen=10,\n\tBatchNo=SUBSTRING(St.Batch,1,10),\n\tOpeningStockLen=13,\n\tOpeningStock=STR(SUM(CASE WHEN type='OP' THEN st.qty ELSE 0 END), 13),\n\tOpeningBonusLen=13,\n\tOpeningBonus=STR(SUM(CASE WHEN type='OP' THEN st.bonus ELSE 0 END), 13),\n\tPurchaseQtyLen=13,\n\tPurchaseQty=STR(SUM(CASE TYPE WHEN 'PV' THEN st.qty ELSE 0 END), 13),\n\tPurchaseBonusLen=13,\n\tPurchaseBonus=STR(SUM(CASE TYPE WHEN 'PV' THEN st.bonus ELSE 0 END), 13),\n\tSaleLen=13,\n\tSale=STR(SUM(CASE TYPE WHEN 'SV' THEN st.qty WHEN 'SR' THEN -(st.qty) ELSE 0 END), 13),\n\tSaleBonusLen=13,\n\tSaleBonus=STR(SUM(CASE TYPE WHEN 'SV' THEN st.bonus WHEN 'SR' THEN -(st.Bonus) ELSE 0 END), 13),\n\tBreakageLen=13,\n\tBreakage=STR(SUM(CASE TYPE  WHEN 'PR' THEN  CASE WHEN st.Expiry <= GETDATE() THEN 0 ELSE (st.qty + st.bonus) END ELSE 0 END), 13),\n\tExpiredQtyLen=13,\n\tExpiredQty=STR(SUM(CASE TYPE  WHEN 'PR' THEN  CASE WHEN st.Expiry <= GETDATE() THEN (st.qty + st.bonus) ELSE 0 END ELSE 0 END), 13),\n\tAdjustmentINLen=13,\n\tAdjustmentIN=STR(SUM(CASE TYPE  WHEN 'AI' THEN  (st.qty + st.bonus) ELSE 0 END), 13),\n\tAdjustmentOutLen=13,\n\tAdjustmentOut=STR(SUM(CASE TYPE  WHEN 'AD' THEN  (st.qty + st.bonus) ELSE 0 END), 13),\n\tClosingStockLen=13,\n\tClosingStock=STR(SUM(\n\t\tCASE WHEN TYPE = 'OP' OR TYPE = 'PV' OR TYPE = 'SR' OR TYPE = 'RV' OR TYPE = 'AI' THEN +1 \n\t\tELSE -1 END * (st.qty + st.Bonus) ), 13),\n\tDateLen=9,\n\tDate=UPPER(REPLACE( SUBSTRING(CONVERT(VARCHAR(100), GetDate(), 106), 1, 7), ' ', '-')) + STR(RIGHT(YEAR(GetDate()), 2), 2),\n\tDsCodeLen=100,\n\tDsCode=CONVERT(VARCHAR(100), :as_dscode)\nFROM\n\t(SELECT type='OP', icode, batch,expiry, qty = sum(qty), bonus = sum(bonus)\n\tFROM\t\n\t\t(select pd.icode, pd.batch, pd.expiry,\n\t\t\tqty = sum(isnull(\n\t\t\t\tcase pl.purcatcode \n\t\t\t\twhen 1 THEN (pd.packqty * pd.packunits)\n\t\t\t\twhen 2 THEN (pd.packqty * pd.packunits)\n\t\t\t\telse pd.looseqty end, 0)), \n\t\t\tbonus = sum(isnull(\n\t\t\t\tcase pl.purcatcode \n\t\t\t\twhen 1 THEN (pd.bonusqty * pd.packunits)\n\t\t\t\twhen 2 THEN (pd.bonusqty * pd.packunits)\n\t\t\t\telse pd.bonusqty end, 0))\n\t\tFROM purledger pl, purdetail pd, item i\n\t\tWHERE pl.posted = 'Y' AND \n\t\t\tpl.purinvcode = pd.purinvcode AND\n\t\t\tpl.postdate < :ar_startdate AND\n\t\t\tpd.icode=i.icode and i.manfcode in (:manfcode)\n\t\tGroup By pd.icode, pd.batch,pd.expiry\n\t\tUNION ALL\n\t\tselect\tpd.icode, pd.batch,pd.expiry,\n\t\t\tqty  = - sum(pd.looseqty),\n\t\t\tbonus = - sum(pd.bonusqty)\n\t\tFROM prledger pl, prdetail pd, item i\n\t\tWHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND\n\t\t\tpl.date < :ar_startdate AND\n\t\t\tpd.icode=i.icode and i.manfcode in (:manfcode)\n\t\tGroup By pd.icode, pd.batch,pd.expiry\n\t\tUNION ALL\n\t\tselect\tsd.icode, sd.batch,sd.expiry,\n\t\t\tqty  = -sum(sd.looseqty),\n\t\t\tbonus  = -sum(sd.bonusqty)\n\t\tFROM saleledger sl, saledetail sd, item i\n\t\tWHERE sl.saleinvcode = sd.saleinvcode AND\n\t\t\t  sl.posted = 'Y' AND \n\t\t      sl.date < :ar_startdate AND sd.Due IS NULL AND\n\t\t\tsd.icode=i.icode and i.manfcode in (:manfcode)\n\t\tGroup By sd.icode, sd.batch,sd.expiry\n\t\tUNION ALL\n\t\tselect\tsd.icode, sd.batch,sd.expiry,\n\t\t\tqty  = sum(sd.looseqty),\n\t\t\tbonus = sum(sd.bonusqty)\n\t\tFROM srledger sl, srdetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND\n\t\t\t  sl.posted = 'Y' AND \n\t\t      sl.postdate < :ar_startdate AND\n\t\t\tsd.icode=i.icode and i.manfcode in (:manfcode)\n\t\tGroup By sd.icode, sd.batch,sd.expiry\n\t\tUNION ALL\n\t\tselect\tsd.icode, sd.batch, sd.expiry,qty  = -sum(sd.qty), bonus = 0\n\t\tFROM issueheader sl, issuedetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND\n\t\t      sl.date < :ar_startdate AND\n\t\t\tsd.icode=i.icode and i.manfcode in (:manfcode)\n\t\tGroup By sd.icode, sd.batch,sd.expiry\n\t\tUNION ALL\n\t\tselect\tsd.icode, sd.batch, sd.expiry,qty  = sum(sd.qty), bonus=0\n\t\tFROM receiptheader sl, receiptdetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND\n\t\t      sl.postdate < :ar_startdate AND\n\t\t\tsd.icode=i.icode and i.manfcode in (:manfcode)\n\t\tGroup By sd.icode, sd.batch,sd.expiry\n\t\tUNION ALL\n\t\tselect\tsd.icode, sd.batch,sd.expiry, qty = sum(sd.looseqty), bonus=0\n\t\tFROM Adjheader sl, Adjdetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND\n\t\t      sl.posteddate < :ar_startdate AND\n\t\t\tsd.icode=i.icode and i.manfcode in (:manfcode)\n\t\tGroup By sd.icode, sd.batch,sd.expiry\n\t\tUNION ALL\n\t\tselect\tsd.icode, sd.batch,sd.expiry, qty = -sum(sd.looseqty), bonus=0\n\t\tFROM Adjheader sl, Adjdetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND\n\t\t      sl.posteddate < :ar_startdate AND\n\t\t\tsd.icode=i.icode and i.manfcode in (:manfcode)\n\t\tGroup By sd.icode, sd.batch,sd.expiry\n\t\tUNION ALL\n\t\tselect\td.icode, d.batch, d.expiry, qty = -sum(d.duesatisfyqty), bonus=0\n\t\tFROM duesatisfyheader h, duesatisfydetail d, item i\n\t\tWHERE h.duesatisfycode=d.duesatisfycode AND\n\t\t      h.duesatisfydate < :ar_startdate AND\n\t\t\td.icode=i.icode and i.manfcode in (:manfcode)\n\t\tGroup By d.icode, d.batch,d.expiry) A\n\tGROUP BY icode, batch,expiry\n\tUNION ALL\n\tselect\ttype='PV',\n\t\tpd.icode, pd.batch,pd.expiry,\n\t\tqty = sum(pd.looseqty + pd.packqty * pd.packunits),\n\t\tbonus = sum(isnull(case pl.purcatcode \n\t\t\twhen 1 THEN pd.bonusqty * pd.packunits\n\t\t\twhen 2 THEN pd.bonusqty * pd.packunits\n\t\t\telse pd.bonusqty\n\t\t\tend, 0))\n\tFROM purledger pl, purdetail pd, item i\n\tWHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND\n\t\tpl.postdate BETWEEN :ar_startdate and :ar_enddate AND\n\t\tpd.icode=i.icode and i.manfcode in (:manfcode)\n\tGroup By pd.icode, pd.batch,pd.expiry\n\tUNION ALL\n\tselect\ttype='PR',\n\t\tpd.icode,\n\t\tpd.batch,pd.expiry,\n\t\tqty = sum(pd.looseqty),\n\t\tbonus = sum(pd.bonusqty)\n\tFROM prledger pl, prdetail pd, item i\n\tWHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND\n\t      pl.date BETWEEN :ar_startdate and :ar_enddate AND\n\t\tpd.icode=i.icode and i.manfcode in (:manfcode)\n\tGroup By pd.icode, pd.batch,pd.expiry\n\tUNION ALL\n\tselect\ttype='SV',\n\t\tsd.icode, sd.batch,sd.expiry,\n\t\tqty = sum(sd.looseqty),\n\t\tbonus = sum(sd.bonusqty)\n\tFROM saleledger sl, saledetail sd, item i\n\tWHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND\n\t\tsl.date BETWEEN :ar_startdate and :ar_enddate AND\n\t\tsd.icode=i.icode and i.manfcode in (:manfcode)\n\tGroup By sd.icode, sd.batch,sd.expiry\n\tUNION ALL\n\tselect\ttype='SR',\n\t\tsd.icode, sd.batch,sd.expiry,\n\t\tqty = sum(sd.looseqty),\n\t\tbonus = sum(sd.bonusqty)\n\tFROM srledger sl, srdetail sd, item i\n\tWHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND\n\t      sl.postdate BETWEEN :ar_startdate and :ar_enddate AND\n\t\tsd.icode=i.icode and i.manfcode in (:manfcode)\n\tGroup By sd.icode, sd.batch,sd.expiry\n\tUNION ALL\n\tselect\ttype='IV',\n\t\tsd.icode, sd.batch,sd.expiry,\n\t\tqty = sum(sd.qty),\n\t\tbonus = 0\n\tFROM issueheader sl, issuedetail sd, item i\n\tWHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND\n\t      sl.date BETWEEN :ar_startdate and :ar_enddate AND\n\t\tsd.icode=i.icode and i.manfcode in (:manfcode)\n\tGroup By sd.icode, sd.batch,sd.expiry\n\tUNION ALL\n\tselect\ttype='DS',\n\t\td.icode, d.batch,d.expiry,\n\t\tqty = sum(d.duesatisfyqty),\n\t\tbonus = 0\n\tFROM duesatisfyheader h, duesatisfydetail d, item i\n\tWHERE h.duesatisfycode = d.duesatisfycode AND\n\t      h.duesatisfydate BETWEEN :ar_startdate and :ar_enddate AND\n\t\td.icode=i.icode and i.manfcode in (:manfcode)\n\tGroup By d.icode, d.batch,d.expiry\n\tUNION ALL\n\tselect\ttype='RV',\n\t\tsd.icode, sd.batch, sd.expiry, \n\t\tqty = sum(sd.qty),\n\t\tbonus = 0\n\tFROM receiptheader sl, receiptdetail sd, item i\n\tWHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND\n\t      sl.postdate BETWEEN :ar_startdate and :ar_enddate AND\n\t\tsd.icode=i.icode and i.manfcode in (:manfcode)\n\tGroup By sd.icode, sd.batch,sd.expiry\n\tUNION ALL\n\tselect\ttype='AI',\n\t\tsd.icode, sd.batch,sd.expiry,\n\t\tqty = sum(sd.looseqty),\n\t\tbonus = 0\n\tFROM Adjheader sl, Adjdetail sd, item i\n\tWHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND\n\t\tsl.posteddate BETWEEN :ar_startdate and :ar_enddate AND\n\t\tsd.icode=i.icode and i.manfcode in (:manfcode)\n\tGroup By sd.icode, sd.batch,sd.expiry\n\tUNION ALL\n\tselect\ttype='AD',\n\t\tsd.icode, sd.batch,sd.expiry,\n\t\tqty = sum(sd.looseqty),\n\t\tbonus = 0\n\tFROM Adjheader sl, Adjdetail sd, item i\n\tWHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND\n\t\tsl.date BETWEEN :ar_startdate and :ar_enddate AND\n\t\tsd.icode=i.icode and i.manfcode in (:manfcode)\n\tGroup By sd.icode, sd.batch,sd.expiry) St, \n\tItem i\nWHERE st.icode = i.icode\nGROUP BY st.icode, i.name, st.batch\nORDER BY st.icode\n",
