  "retrieve": "SELECT \n\tDEPOTIDLEN=2,\n\tDEPOTID=:as_distcode+ REPLICATE(' ', 2 - LEN(:as_distcode)),\n\tBRICKIDLEN=8,\n\tBRICKID=ltrim(STR(C.areacode,8)),\n\tCHEMISTIDLEN=8,\n\tCHEMISTID=SUBSTRING(C.Membershipid,1,8),\n\tInvoiceNOLEN=10,\n\tInvoiceNO = Ltrim(STR(SL.SaleInvCode, 10)),\n\t/*DateLEN=8,\n\tDate=Convert(varchar(8), SL.DATE, 3),*/\n\tDateLEN=9,\n\tDate= UPPER(REPLACE( SUBSTRING(CONVERT(VARCHAR(100), SL.DATE, 106), 1, 7), ' ', '-')) + STR(RIGHT(YEAR(SL.DATE), 2), 2),\n\tPRODUCTIONIDLEN=9,\n\tPRODUCTIONID=SUBSTRING(I.packingdesc,1,9),\n\tBatchLEN=10, \n\tBatch=SUBSTRING(SD.Batch, 1, 10),\n\tSALEQTYLEN=13,\n\tSALEQTY=LTrim(STR(SD.LooseQty, 13)),\n\tBONUSQTYLEN=13,\n\tBONUSQTY=LTrim(STR(SD.BonusQty, 13)),\n\tSALEVALUELEN=15,\n\tSALEVALUE=LTrim(STR(SD.Looseqty*SD.saleprice, 15,2)),\n\tDiscountLEN=15, \n\tDiscount=LTrim(STR(\n\t\t\tRound((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + \n\t\t\t(SD.LooseQty * SD.ItemFlatDisc), 15, 2)),\n\tGENNOLEN=6,\n\tGENNO='FIND',\n\tDOWNLOADDTLEN=9,\n\tDOWNLOADDT= UPPER(REPLACE( SUBSTRING(CONVERT(VARCHAR(100), GETDATE(), 106), 1, 7), ' ', '-')) + STR(RIGHT(YEAR(GETDATE()), 2), 2)\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tCustomer C,\n\tCustomerCategory CC,\n\tItem I,\n\tAREA A,\n\tAccounts AC\nWHERE\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tC.Areacode=A.areacode AND\n\tAC.acccode=C.custcode AND\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate\nUNION ALL\nSELECT \n\tDEPOTIDLEN=2,\n\tDEPOTID=:as_distcode+ REPLICATE(' ', 2 - LEN(:as_distcode)),\n\tBRICKIDLEN=8,\n\tBRICKID=ltrim(STR(C.areacode,8)),\n\tCHEMISTIDLEN=8,\n\tCHEMISTID=SUBSTRING(C.Membershipid,1,8),\n\tInvoiceNOLEN=10,\n\tInvoiceNO = Ltrim(STR(SL.srInvCode, 10)),\n\t/*DateLEN=8,\n\tDate=Convert(varchar(8), SL.DATE, 3),*/\n\tDateLEN=9,\n\tDate= UPPER(REPLACE( SUBSTRING(CONVERT(VARCHAR(100), SL.PostDATE, 106), 1, 7), ' ', '-')) + STR(RIGHT(YEAR(SL.PostDATE), 2), 2),\n\tPRODUCTIONIDLEN=9,\n\tPRODUCTIONID=SUBSTRING(I.packingdesc,1,9),\n\tBatchLEN=10, \n\tBatch=SUBSTRING(SD.Batch, 1, 10),\n\tSALEQTYLEN=13,\n\tSALEQTY=LTrim(STR(SD.LooseQty* (-1), 13)),\n\tBONUSQTYLEN=13,\n\tBONUSQTY=LTrim(STR(SD.BonusQty*(-1), 13)),\n\tSALEVALUELEN=15,\n\tSALEVALUE=LTrim(STR((SD.Looseqty*SD.srprice) * (-1), 15,2)),\n\tDiscountLEN=15, \n\tDiscount=LTrim(STR(\n\t\t\tRound((SD.LooseQty * SD.srPrice * (SD.DiscPerc * 0.01)), 2) , 15, 2)),\n\tGENNOLEN=6,\n\tGENNO='FIND',\n\tDOWNLOADDTLEN=9,\n\tDOWNLOADDT= UPPER(REPLACE( SUBSTRING(CONVERT(VARCHAR(100), GETDATE(), 106), 1, 7), ' ', '-')) + STR(RIGHT(YEAR(GETDATE()), 2), 2)\nFROM\n\tSrLedger SL,\n\tSrDetail SD,\n\tCustomer C,\n\tCustomerCategory CC,\n\tItem I,\n\tAREA A,\n\tAccounts AC\nWHERE\n\tSL.srInvCode = SD.srInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tC.Areacode=A.areacode AND\n\tAC.acccode=C.custcode AND\n\tSL.PostDATE >= :ar_startdate AND SL.DATE <= :ar_enddate\nORDER by  Date,\n\tInvoiceNO,\n\tPRODUCTIONID",
  "arguments": {
