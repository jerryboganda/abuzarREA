  "retrieve": "SELECT\n\tDSTBIDLEN=6,\n\tDSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),\n\tCUSTIDLEN=10,\n\tCUSTID = STR(C.CustCode, 10),\n\tCTLEN=2,\n\tCT=CASE \n\t\tWHEN SOUNDEX((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)) = SOUNDEX('WHOLE SALE') THEN '01'\n\t\tWHEN SOUNDEX((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)) = SOUNDEX('RETAIL') THEN '02'\n\t\tWHEN SOUNDEX((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)) = SOUNDEX('INSTITUTION') THEN '03'\n\t\tWHEN SOUNDEX((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)) = SOUNDEX('DOCTOR') THEN '04'\n\t\tELSE '05' END,\n\tCUSTNAMELEN=50,\n\tCUSTNAME = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))))),\n\tADDRESSLEN=50,\n\tADDRESS = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 50))))),\n\tADDRESS2LEN=30,\n\tADDRESS2 = LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 30))))),\n\tCITYLEN=30,\n\tCITY = LTRIM(RTRIM(SUBSTRING(C.CITY, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(C.CITY, 1, 30))))),\n\tDSTB_AREAIDLEN=16,\n\tDSTB_AEARID=STR(AR.AREACODE, 16),\n\tDSTB_AREALEN=100,\n\tDSTB_AREA = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 100))) + REPLICATE(' ', 16 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 100)))))\nFROM Customer C, Accounts A, Area AR\nWHERE C.CustCode = A.AccCode AND C.AreaCode = AR.AreaCode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_distcode",
      "string"
     ]
    }
   ]
  }
 },
