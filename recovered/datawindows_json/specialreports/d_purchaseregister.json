  "retrieve": "SELECT \n\tType = 'Purchase',\n\tpurinvcode = dbo.purledger.purinvcode,    \n\tdate = dbo.purledger.date,   \n\tinvdiscperc = dbo.purledger.discperc,    \n\tinvgstperc1 = dbo.purledger.invgstperc1,\n\tflatdisc = dbo.purledger.flatdisc,    \n\tmisccharges = dbo.purledger.misccharges, \n\tinvsalestax = dbo.purledger.salestax,\n\tinvtype =(select name from purchasetype where purtypecode=purledger.purtypecode)\n\t/* Case dbo.purledger.purcatcode\n\t\t\tWhen 1 Then 'Cash Purchase' \t\n\t\t\tWhen 2 Then 'Credit Purchase' \n\t\t\tWhen 7 Then 'Loose Purchase Cash'\n\t\t\tWhen 8 Then 'Loose Purchase Credit'\n\t\t\tElse 'Opening Purchase' \n\tEnd*/,  \t   \n\tlooseqty = dbo.purdetail.looseqty, \n\tpackqty  = purdetail.packqty, \n\tquantity = dbo.purdetail.looseqty + purdetail.packqty, \n\tbonusqty  = purdetail.bonusqty, \t  \n\tunitsalestax  = purdetail.unitsalestax, \n\tgstperc = purdetail.gstperc,\t\n\tprice = dbo.purdetail.purprice,    \n\titemdiscperc = dbo.purdetail.discperc,    \n\tpackunits = dbo.purdetail.packunits,    \n\tpacking=  case when (dbo.item.packcode is null) then space(30)\n\telse  dbo.itempacking.name\n\tend,\n\tbatch = dbo.purdetail.batch, \n\texpiry = dbo.purdetail.expiry,  \n\trowid = dbo.purdetail.purrowid,  \n\titemname = item.name,\n\tdatestring = Rtrim(LTrim(Str(DatePart(dd, purledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, purledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, purledger.date)))), \n\tPerson = dbo.accounts.name,\n\tPosted=dbo.purledger.posted,\n\t/* invnettotalexctax=\n\t(select \n\t\tRound( sum(Round((PD.purprice * (PD.packqty + PD.looseqty) * (1 - PD.discperc * 0.01)),2) * (1 - PL.discperc * 0.01)) + PL.misccharges - PL.flatdisc,0)\n\tfrom purledger PL, purdetail PD\n\twhere PL.purinvcode=purledger.purinvcode and \n\t\tPD.purinvcode=PL.purinvcode\n\tgroup by\n\t\tPL.purinvcode,\n\t\tPL.flatdisc,\n\t\tPL.misccharges\n\t\t),*/\n\ttotalsalestax = \n\t\t(SELECT invtotalsalestax= Round (\n\t\t\t/*invoice level salestax*/\n\t\t\tRound ( ( Round ( Sum ( Round ( ( PD.looseqty + PD.packqty ) * PD.purprice * (1 - PD.discperc * 0.01 ) , 2 ) )\n\t\t\t\t* ( 1 - PL.discperc * 0.01 ) , 2 ) - PL.flatdisc ) * PL.invgstperc1 * 0.01  , 2 )\n\t\t\t/*items salestax*/\t + \n\t\t\tSum (Round ( (PD.looseqty + PD.packqty + PD.bonusqty) * PD.unitsalestax + \n\t\t\t\tRound ( Round ( (PD.looseqty + PD.packqty) * PD.purprice * (1 - PD.discperc * 0.01 ), 2 ) * PD.gstperc * 0.01 , 2 ) , 2 ) ), 0 )\n\t\tFROM \n\t\t\tdbo.Purledger PL , \n\t\t\tdbo.Purdetail PD\n\t\tWHERE  \n\t\t\tPL.purinvcode = dbo.purledger.purinvcode and\n\t\t\tPL.purinvcode = PD.purinvcode\n\t\tGROUP BY \n\t\t\tPL.purinvcode, \n\t\t\tPL.invgstperc1, \n\t\t\tPL.misccharges,   \n\t\t\tPL.flatdisc,\n\t\t\tPL.discperc)\nFROM\n\tdbo.purledger, \n\tdbo.purdetail,    \n\tdbo.item LEFT OUTER JOIN itempacking ON (dbo.item.packcode = dbo.itempacking.packcode),\n\tdbo.accounts\n\t\nWHERE  \n\tdbo.purledger.date >= :ad_StartDate and\n\tdbo.purledger.date <= :ad_EndDate  and\n\tdbo.purledger.purinvcode = dbo.purdetail.purinvcode and  \n\tdbo.purdetail.icode = item.icode and \n\tdbo.purledger.suppcode = dbo.accounts.acccode\nUNION ALL\nSELECT \n\tType = 'Purchase Return',\n\tpurinvcode = dbo.prledger.prinvcode,    \n\tdate = dbo.prledger.date,   \n\tinvdiscperc = dbo.prledger.discperc,    \n\tinvgstperc1 = dbo.prledger.invgstperc1,\n\tflatdisc = dbo.prledger.flatdisc,    \n\tmisccharges = dbo.prledger.misccharges, \n\tinvsalestax = dbo.prledger.salestax,\n\tinvtype =(select purchasetype.name from purchasetype where purchasetype.purtypecode=prledger.prtypecode)\n\t\t/* Case dbo.purledger.purcatcode \tWhen 1 Then 'Cash Purchase' \t\n\t\tWhen 2 Then 'Credit Purchase' \n\t\tWhen 7 Then 'Loose Purchase Cash'\n\t\tWhen 8 Then 'Loose Purchase Credit'\n\t\tElse 'Opening Purchase' End*/,  \t   \n\tlooseqty = dbo.prdetail.looseqty, \n\tpackqty  = prdetail.packqty, \n\tquantity = dbo.prdetail.looseqty + prdetail.packqty, \n\tbonusqty  = prdetail.bonusqty, \t  \n\tunitsalestax  = prdetail.unitsalestax, \n\tgstperc = prdetail.gstperc,\t\n\tprice = dbo.prdetail.prprice,    \n\titemdiscperc = dbo.prdetail.discperc,    \n\tpackunits = dbo.prdetail.packunits,    \n\tpacking=  case when (dbo.item.packcode is null) then space(30) else  dbo.itempacking.name end,\n\tbatch = dbo.prdetail.batch,    \n\texpiry = dbo.prdetail.expiry,  \n\trowid = dbo.prdetail.prutn,  \n\titemname = item.name,\n\tdatestring = Rtrim(LTrim(Str(DatePart(dd, prledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, prledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, prledger.date)))), \n\tPerson = dbo.accounts.name,\n\tPosted=dbo.prledger.posted,\n\ttotalsalestax = \n\t\t(SELECT invtotalsalestax= Round (\n\t\t\t/*invoice level salestax*/\n\t\t\tRound ( ( Round ( Sum ( Round ( ( PD.looseqty + PD.packqty ) * PD.prprice * (1 - PD.discperc * 0.01 ) , 2 ) )\n\t\t\t\t* ( 1 - PL.discperc * 0.01 ) , 2 ) - PL.flatdisc ) * PL.invgstperc1 * 0.01  , 2 )\n\t\t\t/*items salestax*/\t + \n\t\t\tSum (Round ( (PD.looseqty + PD.packqty + PD.bonusqty) * PD.unitsalestax + \n\t\t\t\tRound ( Round ( (PD.looseqty + PD.packqty) * PD.prprice * (1 - PD.discperc * 0.01 ), 2 ) * PD.gstperc * 0.01 , 2 ) , 2 ) ), 0 )\n\t\tFROM \n\t\t\tdbo.Prledger PL , \n\t\t\tdbo.Prdetail PD\n\t\tWHERE  \n\t\t\tPL.prinvcode = dbo.prledger.prinvcode and\n\t\t\tPL.prinvcode = PD.prinvcode\n\t\tGROUP BY \n\t\t\tPL.prinvcode, \n\t\t\tPL.invgstperc1, \n\t\t\tPL.misccharges,   \n\t\t\tPL.flatdisc,\n\t\t\tPL.discperc)\nFROM\n\tdbo.prledger, \n\tdbo.prdetail,    \n\tdbo.item LEFT OUTER JOIN itempacking ON (dbo.item.packcode = dbo.itempacking.packcode),\n\tdbo.accounts\nWHERE  \n\tdbo.prledger.date >= :ad_StartDate and\n\tdbo.prledger.date <= :ad_EndDate  and\n\tdbo.prledger.prinvcode = dbo.prdetail.prinvcode and  \n\tdbo.prdetail.icode = item.icode and \n\tdbo.prledger.suppcode = dbo.accounts.acccode\nORDER BY\n\tType,\n\tpurinvcode,\n\tDate,\n\titemname",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_EndDate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "type A, date A, purinvcode A, itemname A"
 },
