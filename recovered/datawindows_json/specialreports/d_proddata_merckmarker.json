  "retrieve": "SELECT \n\tDSTBIDLEN=6,\n\tDSTBID= LTRIM(RTRIM(LEFT(LTRIM(RTRIM(Z.Remarks)), 6))) + REPLICATE(' ', 6 - LEN(LTRIM(RTRIM(LEFT(LTRIM(RTRIM(Z.Remarks)), 6))))),\n\tPrdIDLEN=9,\n\tPrdID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),\n\tPRDLEN=50,\n\tPRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50)\nFROM\n\tItem I, Zone Z\nWHERE\n\tZ.ZoneCode = :ai_zonecode AND\n\tI.ManfCode = Z.Manfcode",
