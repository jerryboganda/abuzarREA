iscPerc * 0.01)), 2) + SD.ItemFlatDisc, 12, 2))),1, 12),\n\tNetAmtLEN=12,\n\tNetAmt=SUBSTRING(LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2))), 1, 12),\n\tReasonLen=1,\n\tReason = 'S'\nFROM\n\tCRS_SaleLedger SL,\n\tCRS_SaleDetail SD,\n\tCustomer C,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\t:ai_scope=2 AND\n\tSL.ClientInstanceID = SD.ClientInstanceID AND\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode IN (:manfcode) AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\nUNION ALL\nSELECT \n\tDSTBIDLEN=6,\n\tDSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),\n\tDOCUMENTNOLEN=12,\n\tDOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SRInvCode, 12))), 1, 12), \n\tDOCDATELEN=10,\n\tDOCDATE=Convert(varchar(10), SL.DATE, 103),\n\tCUSTIDLEN=10,\n\tCUSTID = ISNULL((SELECT SUBSTRING(LTRIM(RTRIM(A.AliasName)), 1, 10) +  REPLICATE(' ', 10 - LEN(SUBSTRING(LTRIM(RTRIM(A.AliasName)), 1, 10))) FROM Accounts A WHERE A.AccCode = SL.CustCode), SPACE(10)),\n\tCTLEN=2,\n\tCT=CASE \n\t\tWHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN '01'\n\t\tWHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN '02'\n\t\tWHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN '03'\n\t\tWHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN '04'\n\t\tELSE '02' END,\n\tTownIDLEN=16,\n\tTownID=SUBSTRING(LTRIM(RTRIM(STR(C.AREACODE, 16))), 1, 16), \n\tPRDIDLEN=9,\n\tPRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),\n\tPRDLEN=50,\n\tPRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),\n\tBatchNoLEN=10,\n\tBatchNo=SUBSTRING(SD.Batch, 1, 10),\n\tPRICELEN=12,\n\tPRICE=SUBSTRING(LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))), 1, 12), \n\tQuantity