    "type": "char(10)",
    "updatewhereclause": "yes",
    "name": "salesmancode",
    "dbname": "SalesManCode"
   }
  ],
  "retrieve": "SELECT \n\tManufacturerLen = 60,\n\tManufacturer = LTRIM(RTRIM(SUBSTRING((SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = :ai_manfcode), 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING((SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = :ai_manfcode), 1, 60))))),\n\tCustCodeLen=12,\n\tCustCode = LTRIM(RTRIM(SUBSTRING(A.AliasName, 1, 12))) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(SUBSTRING(A.AliasName, 1, 12))))),\n\tCustomerNameLen=60,\n\tCustomerName = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))))),\n\tSalePersonLen=60,\n\tSalePerson = LTRIM(RTRIM(SUBSTRING((SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = C.SalesManCode), 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING((SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = C.SalesManCode), 1, 60))))),\n\tPercShareLen=12,\n\tPercShare = STR(0.00, 12, 2),\n\tSalesManCodeLen = 10,\n\tSalesManCode= STR(C.SalesManCode, 10)\nFROM Customer C, CustomerCategory CC, Accounts A\nWHERE CC.CustCatCode IN (:ai_custcatcode) AND\n\tCC.CustCatCode = C.CustCatCode AND\n\tC.CustCode = A.AccCode\nORDER BY\n\tA.AliasName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_manfcode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_custcatcode",
      "numberlist"
     ]
    }
   ]
  }
 },
