  "retrieve": "SELECT \n\tPRODCODELEN=10,\n\tPRODCODE=STR(I.ICode, 10),\n\tProdNameLen=100,\n\tProdName=I.Name,\n\tPackSizeLen=50,\n\tPackSize=I.PackingDesc,\n\tPriceLEN=12,\n\tPrice=STR(ISNULL(I.SalePrice, 0), 12, 2),\n\tAGPCodeLen=5,\n\tAGPCode=M.ALIASNAME,\n\tDsCodeLen=100,\n\tDsCode=CONVERT(VARCHAR(100), :as_dscode)\nFROM\n\tItem I, Manufacturer M\nWHERE\n\tI.ManfCode = M.ManfCode AND M.ManfCode IN (:ai_manfcode)\nORDER BY\n\tPRODCODE",
