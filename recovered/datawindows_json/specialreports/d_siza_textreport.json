  "retrieve": "SELECT  \n\tMainArea= LEFT(AR.Name, 60),\n\tSubareacode = STR(SA.SubAreaCode, 13),\n\tSUBAREA = LEFT(SA.Name, 60), \n\tchemistcode = STR(C.CustCode, 12),\n\tchemistname = LEFT(A.Name, 60),\n\tproductcode = STR(I.ICODE, 12),\n\tproductname = LEFT(I.Name, 60),\n\tinvcode = STR(SL.SaleInvCode, 14),\n\tDATE = CONVERT(VARCHAR(12), SL.Date, 103),\n\tSaleUnits = STR(SD.LooseQty, 10, 0),\n\tBonusUnits=STR(SD.BonusQty, 11, 0),\n\tBonusValue=STR(SD.BonusQty * (SD.SalePrice - SD.ItemFlatDisc), 11, 2),\n\tDiscPerc = STR(SD.DiscPerc, 13, 2),\n\tDiscountValue = STR((SD.LooseQty * SD.ItemFlatDisc) + (SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * SD.DiscPerc * 0.01), 14, 2),\n\tPrice = STR((SD.SalePrice - SD.ItemFlatDisc), 15, 2),\n\tSales = STR((SD.SalePrice - SD.ItemFlatDisc) * SD.LooseQty, 15, 2)\nFROM\n\tSaleLedger SL, \n\tSaleDetail SD,\n\tItem I,\n\tManufacturer M,\n\tCustomer C,\n\tAccounts A,\n\tArea AR,\n\tSubArea SA\nWHERE\n\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND \n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = M.ManfCode AND\n\tM.ManfCode = :ai_manfcode AND \n\tSL.CustCode = C.CustCode AND \n\tC.CustCode = A.AccCode AND\n\tC.AreaCode = AR.AreaCode AND\n\tC.SubAreaCode = SA.SubAreaCode\nUNION ALL\nSELECT \n\tMainArea= LEFT(AR.Name, 60),\n\tSubareacode = STR(SA.SubAreaCode, 13),\n\tSUBAREA = LEFT(SA.Name, 60),\n\tchemistcode = STR(C.CustCode, 12),\n\tchemistname = LEFT(A.Name, 60),\n\tproductcode = STR(I.ICODE, 12),\n\tproductname = LEFT(I.Name, 60),\n\tinvcode = STR(SL.SRInvCode, 14),\n\tDATE = CONVERT(VARCHAR(12), SL.Date, 103),\n\tSaleUnits = STR(-SD.LooseQty, 10, 0),\n\tBonusUnits=STR(-SD.BonusQty, 11, 0),\n\tBonusValue=STR(-(SD.BonusQty * SD.SRPrice), 11, 2),\n\tDiscPerc = STR(SD.DiscPerc, 13, 2),\n\tDiscountValue = STR(-(SD.LooseQty * SD.SRPrice * SD.DiscPerc * 0.01), 14, 2),\n\tPrice = STR(SD.SRPrice, 15, 2),\n\tSales = STR(-(SD.SRPrice * SD.LooseQty), 15, 2)\nFROM\n\tSRLedger SL, \n\tSRDetail SD,\n\tItem I,\n\tManufacturer M,\n\tCustomer C,\n\tAccounts A,\n\tArea AR,\n\tSubArea SA\nWHERE\n\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = M.ManfCode AND\n\tM.ManfCode = :ai_manfcode AND \n\tSL.CustCode = C.CustCode AND \n\tC.CustCode = A.AccCode AND\n\tC.AreaCode = AR.AreaCode AND\n\tC.SubAreaCode = SA.SubAreaCode\nORDER BY\n\tMAINAREA,\n\tSUBAREA,\n\tchemistname,\n\tDATE",
  "arguments": {
