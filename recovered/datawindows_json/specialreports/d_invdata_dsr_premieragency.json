  "retrieve": "SELECT \n\tInvoicenoLEN=10,\n\tInvoiceNo = STR(SL.SaleInvCode, 10),\n\tDSRNoLen = 10,\n\tDSRNo = SPACE(10),\n\tInvDateLEN=10,\n\tInvDate=Convert(varchar(10), SL.DATE, 103),\n\tCustCodeLEN=10,\n\tCustCode = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(A.AliasName)))),\n\tProdCodeLEN=10,\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 10),\n\tBatchLEN=20,\n\tBatch=SUBSTRING(SD.Batch, 1, 20),\n\tSaleQtyLEN=10,\n\tSaleQty=STR(SD.LooseQty, 10),\n\tBonusQtyLEN=10,\n\tBonusQty=STR(SD.BonusQty, 10),\n\tDisValueLEN=10,\n\tDisValue=STR(\n\t\t\tRound((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + \n\t\t\t(SD.LooseQty * SD.ItemFlatDisc), 10, 2),\n\tNetValueLEN=10,\n\tNetValue=STR(\n\t\t\tRound((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2) + \n\t\t\t(SD.LooseQty * SD.ItemFlatDisc), 10, 2),\n\tTranTypeLen=10,\n\tTranType='S'+SPACE(9),\n\tIMiscodeLEN=10,\n\tIMiscode=:as_distcode + REPLICATE(' ', 10 - LEN(:as_distcode))\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tCustomer C,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate\nUNION ALL\nSELECT \n\tInvoicenoLEN=10,\n\tInvoiceNo = STR(SL.SRInvCode, 10),\n\tDSRNoLen = 10,\n\tDSRNo = SPACE(10),\n\tInvDateLEN=10,\n\tInvDate=Convert(varchar(10), SL.DATE, 103),\n\tCustCodeLEN=10,\n\tCustCode = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(A.AliasName)))),\n\tProdCodeLEN=10,\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 10),\n\tBatchLEN=20,\n\tBatch=SUBSTRING(SD.Batch, 1, 20),\n\tSaleQtyLEN=10,\n\tSaleQty=STR(SD.LooseQty, 10),\n\tBonusQtyLEN=10,\n\tBonusQty=STR(SD.BonusQty, 10),\n\tDisValueLEN=10,\n\tDisValue=STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 10, 2),\n\tNetValueLEN=10,\n\tNetValue=STR(Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 10, 2),\n\tTranTypeLen=10,\n\tTranType='R'+SPACE(9),\n\tIMiscodeLEN=10,\n\tIMiscode=:as_distcode + REPLICATE(' ', 10 - LEN(:as_distcode))\nFROM\n\tSRLedger SL,\n\tSRDetail SD,\n\tCustomer C,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate\n/*\nUNION ALL\nSELECT \n\tInvoiceLEN=10,\n\tInvoice = STR(PL.PurInvCode, 10),\n\tDateLEN=10,\n\tDate=Convert(varchar(10), PL.DATE, 103),\n\tCustCodeLEN=12,\n\tCustCode  = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),\n\tProdCodeLEN=9,\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),\n\tBatchLEN=10,\n\tBatch=SUBSTRING(PD.Batch, 1, 10),\n\tUnitsLEN=12,\n\tUnits=STR(PD.PackQty + PD.LooseQty, 12),\n\tBonusLEN=12,\n\tBonus=STR(PD.BonusQty, 12),\n\tDiscountLEN=12,\n\tDiscount=STR(\n\t\t\tRound(((PD.PackQty + PD.LooseQty) * PD.PurPrice * (PD.DiscPerc * 0.01)), 2), 12, 2),\n\tNetValueLEN=12,\n\tNetValue=STR(\n\t\t\tRound(((PD.PackQty + PD.LooseQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01)), 2), 12, 2),\n\tFlagLen=1,\n\tFlag='P',\n\tIMiscodeLEN=10,\n\tIMiscode=:as_distcode + REPLICATE(' ', 10 - LEN(:as_distcode))\nFROM\n\tPurLedger PL,\n\tPurDetail PD,\n\tSupplier S,\n\tAccounts A,\n\tItem I\nWHERE\n\tPL.PurInvCode = PD.PurInvCode AND\n\tPL.POSTED = 'Y' AND\n\tPD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tPL.SuppCode = S.SuppCode AND\n\tS.SuppCode = A.AccCode AND \n\tPL.DATE >= :ar_startdate AND PL.DATE <= :ar_enddate\nUNION ALL\nSELECT \n\tInvoiceLEN=10,\n\tInvoice = STR(PL.PrInvCode, 10),\n\tDateLEN=10,\n\tDate=Convert(varchar(10), PL.DATE, 103),\n\tCustCodeLEN=12,\n\tCustCode  = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),\n\tProdCodeLEN=9,\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),\n\tBatchLEN=10,\n\tBatch=SUBSTRING(PD.Batch, 1, 10),\n\tUnitsLEN=12,\n\tUnits=STR(PD.PackQty + PD.LooseQty, 12),\n\tBonusLEN=12,\n\tBonus=STR(PD.BonusQty, 12),\n\tDiscountLEN=12,\n\tDiscount=STR(\n\t\t\tRound(((PD.PackQty + PD.LooseQty) * PD.PrPrice * (PD.DiscPerc * 0.01)), 2), 12, 2),\n\tNetValueLEN=12,\n\tNetValue=STR(\n\t\t\tRound(((PD.PackQty + PD.LooseQty) * PD.PrPrice * (1 - PD.DiscPerc * 0.01)), 2), 12, 2),\n\tFlagLen=1,\n\tFlag= CASE LEFT(LTRIM(RTRIM(PT.Name)), 1) WHEN 'E' THEN 'E' WHEN 'D' THEN 'D' ELSE 'G' END,\n\tIMiscodeLEN=10,\n\tIMiscode=:as_distcode + REPLICATE(' ', 10 - LEN(:as_distcode))\nFROM\n\tPrLedger PL\n\tLEFT OUTER JOIN \n\tPurchaseType AS PT ON(PL.PrTypeCode = PT.PurTypeCode) ,\n\tPrDetail PD,\n\tSupplier S,\n\tAccounts A,\n\tItem I\nWHERE\n\tPL.PrInvCode = PD.PrInvCode AND\n\tPL.POSTED = 'Y' AND\n\tPD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tPL.SuppCode = S.SuppCode AND\n\tS.SuppCode = A.AccCode AND \n\tPL.DATE >= :ar_startdate AND PL.DATE <= :ar_enddate\n*/",
