    "dbname": "PackSize"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "todaysaleunits",
    "dbname": "TodaySaleUnits"
   },
   {
    "type": "decimal(9)",
    "updatewhereclause": "yes",
    "name": "todaysalevaluers",
    "dbname": "TodaySaleValueRs"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "closingquantityunits",
    "dbname": "ClosingQuantityUnits"
   }
  ],
  "retrieve": "SELECT \n\tproductcode = T.productcode,\n\tproductname = T.productname,\n\tPackSize = T.PackSize,\n\tTodaySaleUnits = SUM(T.TodaySaleUnits), \n\tTodaySaleValueRs=SUM(T.TodaySaleValueRs), \n\tClosingQuantityUnits=SUM(T.ClosingQuantityUnits)\nFROM\n\t(SELECT \n\t\tproductcode = I.ICODE,\n\t\tproductname = I.Name,\n\t\tPackSize = I.PackingDesc,\n\t\tTodaySaleUnits = SUM(SD.LooseQty), \n\t\tTodaySaleValueRs=SUM((SD.SalePrice - SD.ItemFlatDisc) * SD.LooseQty * (1 - SD.DiscPerc * 0.01)), \n\t\tClosingQuantityUnits=0.0000\n\tFROM\n\t\tSaleLedger SL, \n\t\tSaleDetail SD,\n\t\tItem I,\n\t\tManufacturer M\n\tWHERE\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND \n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = M.ManfCode AND\n\t\tM.ManfCode = :ai_manfcode\n\tGROUP BY\n\t\tI.ICODE,\n\t\tI.Name,\n\t\tI.PackingDesc\n\tUNION ALL\n\tSELECT \n\t\tproductcode = I.ICODE,\n\t\tproductname = I.Name,\n\t\tPackSize = I.PackingDesc,\n\t\tTodaySaleUnits = -SUM(SD.LooseQty), \n\t\tTodaySaleValueRs= - SUM(SD.SRPrice * SD.LooseQty * (1 - SD.DiscPerc * 0.01)), \n\t\tClosingQuantityUnits=0.0000\n\tFROM\n\t\tSRLedger SL, \n\t\tSRDetail SD,\n\t\tItem I,\n\t\tManufacturer M\n\tWHERE\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND \n\t\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = M.ManfCode AND\n\t\tM.ManfCode = :ai_manfcode\n\tGROUP BY\n\t\tI.ICODE,\n\t\tI.Name,\n\t\tI.PackingDesc\n\tUNION ALL\n\tSELECT \n\t\tproductcode = I.ICODE,\n\t\tproductname = I.Name,\n\t\tPackSize = I.PackingDesc,\n\t\tTodaySaleUnits = 0.0000, \n\t\tTodaySaleValueRs=0.0000, \n\t\tClosingQuantityUnits=0.0000\n\tFROM\n\t\tItem I,\n\t\tManufacturer M\n\tWHERE\n\t\tI.ManfCode = M.ManfCode AND\n\t\tM.ManfCode = :ai_manfcode\n\tUNION ALL\n\tSELECT \n\t\tproductcode = I.ICODE,\n\t\tproductname = I.Name,\n\t\tPackSize = I.PackingDesc,\n\t\tTodaySaleUnits = 0.0000, \n\t\tTodaySaleValueRs=0.0000, \n\t\tClosingQuantityUnits=SUM(A.Qty)\n\tFROM\t\n\t\t(SELECT \n\t\t\tpd.icode, \n\t\t\tqty = sum(isnull(case pl.purcatcode \n\t\t\t\t\twhen 1 THEN (pd.packqty + pd.bonusqty) * pd.packunits\n\t\t\t\t\twhen 2 THEN (pd.packqty + pd.bonusqty) * pd.packunits\n\t\t\t\t\telse pd.looseqty + pd.bonusqty end, 0))\n\t\tFROM purledger pl, purdetail pd, item i\n\t\tWHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND\n\t\t\tpl.date <= :adt_enddate and\n\t\t\tpd.icode = i.icode and i.manfcode = :ai_manfcode\n\t\tGroup By pd.icode\n\t\tUNION ALL\n\t\tselect\tpd.icode,\n\t\t\tqty  = - sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits)\n\t\tFROM prledger pl, prdetail pd, item i\n\t\tWHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND\n\t\t\tpl.date <= :adt_enddate and\n\t\t\tpd.icode = i.icode and i.manfcode = :ai_manfcode\n\t\tGroup By pd.icode\n\t\tUNION ALL\n\t\tselect\tsd.icode,\n\t\t\tqty  = -sum(sd.looseqty + sd.bonusqty)\n\t\tFROM saleledger sl, saledetail sd, item i\n\t\tWHERE /*sl.posted = 'Y' AND*/ sl.saleinvcode = sd.saleinvcode AND\n\t\t\tsl.date <= :adt_enddate AND sd.Due IS NULL and\n\t\t\tsd.icode = i.icode and i.manfcode = :ai_manfcode\n\t\tGroup By sd.icode\n\t\tUNION ALL\n\t\tselect\tsd.icode,\n\t\t\tqty  = sum(sd.looseqty + sd.bonusqty)\n\t\tFROM srledger sl, srdetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND\n\t\t\tsl.date <= :adt_enddate and\n\t\t\tsd.icode = i.icode and i.manfcode = :ai_manfcode\n\t\tGroup By sd.icode\n\t\tUNION ALL\n\t\tselect\tsd.icode,\n\t\t\tqty  = -sum(sd.qty)\n\t\tFROM issueheader sl, issuedetail sd, item i\n\t\tWHERE /*sl.posted = 'Y' AND*/ sl.issueinvcode = sd.issueinvcode AND\n\t\t\tsl.date <= :adt_enddate and\n\t\t\tsd.icode = i.icode and i.manfcode = :ai_manfcode\n\t\tGroup By sd.icode\n\t\tUNION ALL\n\t\tselect\tsd.icode,\n\t\t\tqty  = sum(sd.qty)\n\t\tFROM receiptheader sl, receiptdetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND\n\t\t\tsl.date <= :adt_enddate and\n\t\t\tsd.icode = i.icode and i.manfcode = :ai_manfcode\n\t\tGroup By sd.icode\n\t\tUNION ALL\n\t\tselect\tsd.icode,\n\t\t\tqty = sum(sd.looseqty)\n\t\tFROM Adjheader sl, Adjdetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND\n\t\t\tsl.date <= :adt_enddate and\n\t\t\tsd.icode = i.icode and i.manfcode = :ai_manfcode\n\t\tGroup By sd.icode\n\t\tUNION ALL\n\t\tselect\tsd.icode,\n\t\t\tqty = -sum(sd.looseqty)\n\t\tFROM Adjheader sl, Adjdetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND\n\t\t\tsl.date <= :adt_enddate and\n\t\t\tsd.icode = i.icode and i.manfcode = :ai_manfcode\n\t\tGroup By sd.icode\n\t\tUNION ALL\n\t\tselect\td.icode,\n\t\t\tqty = -sum(d.duesatisfyqty)\n\t\tFROM duesatisfyheader h, duesatisfydetail d, item i\n\t\tWHERE h.duesatisfycode=d.duesatisfycode AND\n\t\t\th.duesatisfydate <= :adt_enddate and\n\t\t\td.icode = i.icode and i.manfcode = :ai_manfcode\n\t\tGroup By d.icode) A, Item I\n\tWHERE A.ICode = I.ICode\n\tGROUP BY\n\t\tI.ICODE,\n\t\tI.Name,\n\t\tI.PackingDesc) T\nGROUP BY\n\tT.productcode,\n\tT.productname,\n\tT.PackSize\nORDER BY\n\tProductName\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_manfcode",
      "number"
     ]
    },
