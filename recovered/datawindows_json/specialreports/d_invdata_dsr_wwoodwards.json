  "retrieve": "SELECT \n\tInvoiceNo = LTRIM(RTRIM(STR(SL.SaleInvCode, 10))),\n\tInvoiceDate=Convert(varchar(10), SL.DATE, 103),\n\tShopName = A.Name,\n\tAddress = C.Address1,\n\tProductName=I.Name,\n\tTerritoryCode=LTRIM(RTRIM(STR(C.AREACODE,10))),\n\tQuantitySale = LTRIM(RTRIM(STR(SD.LooseQty, 12))),\n\tBonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),\n\tBatchNo=SD.Batch,\n\tExtraDiscount=LTRIM(RTRIM(STR(\n\t\t\tRound((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) + \n\t\t\t(SD.LooseQty * SD.ItemFlatDisc), 12, 2))),\n\tSPO=(SELECT SM.NAME FROM SALESMAN SM WHERE SM.SALESMANCODE = C.SALESMANCODE),\n\tType='S'\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tCustomer C,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate\nUNION ALL\nSELECT \n\tInvoiceNo = LTRIM(RTRIM(STR(SL.SRInvCode, 10))),\n\tInvoiceDate=Convert(varchar(10), SL.DATE, 103),\n\tShopName = A.Name,\n\tAddress = C.Address1,\n\tProductName=I.Name,\n\tTerritoryCode=LTRIM(RTRIM(STR(C.AREACODE,10))),\n\tQuantitySale = LTRIM(RTRIM(STR(SD.LooseQty, 12))),\n\tBonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),\n\tBatchNo=SD.Batch,\n\tExtraDiscount=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),\n\tSPO=(SELECT SM.NAME FROM SALESMAN SM WHERE SM.SALESMANCODE = C.SALESMANCODE),\n\tType='R'\nFROM\n\tSRLedger SL,\n\tSRDetail SD,\n\tCustomer C,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate\n",
