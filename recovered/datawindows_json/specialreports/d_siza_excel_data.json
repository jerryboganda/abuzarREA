  "retrieve": "SELECT \n\tMainArea= AR.Name,\n\tSubareacode = SA.SubAreaCode,\n\tSUBAREA = SA.Name,\n\tchemistcode = C.CustCode,\n\tchemistname = A.Name,\n\tproductcode = I.ICODE,\n\tproductname = I.Name,\n\tinvcode = SL.SaleInvCode,\n\tDATE = CONVERT(VARCHAR(12), SL.Date, 103),\n\tSaleUnits = SD.LooseQty, \n\tBonusUnits=SD.BonusQty,\n\tBonusValue=SD.BonusQty * (SD.SalePrice - SD.ItemFlatDisc),\n\tDiscPerc = SD.DiscPerc, \n\tDiscountValue = (SD.LooseQty * SD.ItemFlatDisc) + (SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * SD.DiscPerc * 0.01), \n\tPrice = (SD.SalePrice - SD.ItemFlatDisc), \n\tSales = (SD.SalePrice - SD.ItemFlatDisc) * SD.LooseQty\nFROM\n\tSaleLedger SL, \n\tSaleDetail SD,\n\tItem I,\n\tManufacturer M,\n\tCustomer C,\n\tAccounts A,\n\tArea AR,\n\tSubArea SA\nWHERE\n\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND \n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = M.ManfCode AND\n\tM.ManfCode = :ai_manfcode AND \n\tSL.CustCode = C.CustCode AND \n\tC.CustCode = A.AccCode AND\n\tC.AreaCode = AR.AreaCode AND\n\tC.SubAreaCode = SA.SubAreaCode\nUNION ALL\nSELECT \n\tMainArea= AR.Name,\n\tSubareacode = SA.SubAreaCode,\n\tSUBAREA = SA.Name,\n\tchemistcode = C.CustCode,\n\tchemistname = A.Name,\n\tproductcode = I.ICODE,\n\tproductname = I.Name,\n\tinvcode = SL.SRInvCode,\n\tDATE = CONVERT(VARCHAR(12), SL.Date, 103),\n\tSaleUnits = -SD.LooseQty, \n\tBonusUnits= -SD.BonusQty,\n\tBonusValue= -(SD.BonusQty * SD.SRPrice),\n\tDiscPerc = SD.DiscPerc, \n\tDiscountValue = -(SD.LooseQty * SD.SRPrice * SD.DiscPerc * 0.01), \n\tPrice = SD.SRPrice, \n\tSales = -(SD.SRPrice * SD.LooseQty)\nFROM\n\tSRLedger SL, \n\tSRDetail SD,\n\tItem I,\n\tManufacturer M,\n\tCustomer C,\n\tAccounts A,\n\tArea AR,\n\tSubArea SA\nWHERE\n\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = M.ManfCode AND\n\tM.ManfCode = :ai_manfcode AND \n\tSL.CustCode = C.CustCode AND \n\tC.CustCode = A.AccCode AND\n\tC.AreaCode = AR.AreaCode AND\n\tC.SubAreaCode = SA.SubAreaCode\nORDER BY\n\tMAINAREA,\n\tSUBAREA,\n\tchemistname,\n\tDATE",
  "arguments": {
