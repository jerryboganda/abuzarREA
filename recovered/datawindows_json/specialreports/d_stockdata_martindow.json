  "retrieve": "SELECT\n\tDistributorCode=RTRIM(LTRIM(:as_distcode+SPACE(100))),\n\tDistributerName=SPACE(100),\n\tProductCode=I.CustomICode,\n\tProductTitle=I.Name,\n\tGrossQty = SUM(CASE TYPE WHEN 'SV' THEN qty ELSE 0 END),\n\tGrossAmount = SUM(CASE TYPE WHEN 'SV' THEN Amount ELSE 0 END),\n\tReturnQty = SUM(CASE TYPE WHEN 'SR' THEN qty ELSE 0 END),\n\tReturnAmount = SUM(CASE TYPE WHEN 'SR' THEN Amount ELSE 0 END),\n\tNetQty = SUM(CASE TYPE WHEN 'SV' THEN (qty) WHEN 'SR' THEN -(qty) ELSE 0 END),\n\tNetAmount = SUM(CASE TYPE WHEN 'SV' THEN Amount WHEN 'SR' THEN -(Amount) ELSE 0 END),\n\tBonus = SUM(CASE TYPE WHEN 'SV' THEN bonus WHEN 'SR' THEN -(bonus) ELSE 0 END),\n\tDiscount = SUM(CASE TYPE WHEN 'SV' THEN Discount WHEN 'SR' THEN -(Discount) ELSE 0 END),\n\tTransitQty= ISNULL(SUM(I.TransitStock), 0),\n\tTransitAmount= ISNULL(SUM(I.TransitStock * I.SalePrice), 0),\n\tClosingQty=SUM(CASE WHEN TYPE = 'OP' OR TYPE = 'PV' OR TYPE = 'SR' OR TYPE = 'RV' OR TYPE = 'AI' THEN +1 ELSE -1 END * (qty + bonus)),\n\tClosingAmount=SUM((CASE WHEN TYPE = 'OP' OR TYPE = 'PV' OR TYPE = 'SR' OR TYPE = 'RV' OR TYPE = 'AI' THEN +1 ELSE -1 END * (qty + bonus)) * I.SalePrice)\nFROM\n\t(SELECT type='OP', icode, qty = sum(qty), bonus = 0, Amount=0.00, Discount=0.00\n\tFROM\t\n\t\t(select\tpd.icode,\n\t\t\tqty = sum(isnull(case pl.purcatcode \n\t\t\t\twhen 1 THEN (pd.packqty + pd.bonusqty) * pd.packunits\n\t\t\t\twhen 2 THEN (pd.packqty + pd.bonusqty) * pd.packunits\n\t\t\t\telse pd.looseqty + pd.bonusqty end, 0))\n\t\tFROM purledger pl, purdetail pd, item i\n\t\tWHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND\n\t\t\tpl.postdate < :adt_startdate AND\n\t\t\tpd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\t\tGroup By pd.icode\n\t\tUNION ALL\n\t\tselect\tpd.icode,\n\t\t\tqty  = - sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits)\n\t\tFROM prledger pl, prdetail pd, item i\n\t\tWHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND\n\t\t\tpl.date < :adt_startdate AND\n\t\t\tpd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\t\tGroup By pd.icode\n\t\tUNION ALL\n\t\tselect\tsd.icode,\n\t\t\tqty  = -sum(sd.looseqty + sd.bonusqty)\n\t\tFROM saleledger sl, saledetail sd, item i\n\t\tWHERE sl.saleinvcode = sd.saleinvcode AND\n\t\t\t  sl.posted = 'Y' AND \n\t\t      sl.date < :adt_startdate AND sd.Due IS NULL AND\n\t\t\tsd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\t\tGroup By sd.icode\n\t\tUNION ALL\n\t\tselect\tsd.icode,\n\t\t\tqty  = sum(sd.looseqty + sd.bonusqty)\n\t\tFROM srledger sl, srdetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND\n\t\t\t  sl.posted = 'Y' AND \n\t\t      sl.postdate < :adt_startdate AND\n\t\t\tsd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\t\tGroup By sd.icode\n\t\tUNION ALL\n\t\tselect\tsd.icode,\n\t\t\tqty  = -sum(sd.qty)\n\t\tFROM issueheader sl, issuedetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND\n\t\t      sl.date < :adt_startdate AND\n\t\t\tsd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\t\tGroup By sd.icode\n\t\tUNION ALL\n\t\tselect\tsd.icode,\n\t\t\tqty  = sum(sd.qty)\n\t\tFROM receiptheader sl, receiptdetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND\n\t\t      sl.postdate < :adt_startdate AND\n\t\t\tsd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\t\tGroup By sd.icode\n\t\tUNION ALL\n\t\tselect\tsd.icode,\n\t\t\tqty = sum(sd.looseqty)\n\t\tFROM Adjheader sl, Adjdetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND\n\t\t      sl.posteddate < :adt_startdate AND\n\t\t\tsd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\t\tGroup By sd.icode\n\t\tUNION ALL\n\t\tselect\tsd.icode,\n\t\t\tqty = -sum(sd.looseqty)\n\t\tFROM Adjheader sl, Adjdetail sd, item i\n\t\tWHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND\n\t\t      sl.posteddate < :adt_startdate AND\n\t\t\tsd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\t\tGroup By sd.icode\n\t\tUNION ALL\n\t\tselect\td.icode,\n\t\t\tqty = -sum(d.duesatisfyqty)\n\t\tFROM duesatisfyheader h, duesatisfydetail d, item i\n\t\tWHERE h.duesatisfycode=d.duesatisfycode AND\n\t\t      h.duesatisfydate < :adt_startdate AND\n\t\t\td.icode=i.icode and i.manfcode in (:ai_manfcode)\n\t\tGroup By d.icode) A\n\tGROUP BY icode\n\tUNION ALL\n\tselect\ttype='PV',\n\t\tpd.icode,\n\t\tqty = sum(pd.looseqty + pd.packqty * pd.packunits),\n\t\tbonus = sum(isnull(case pl.purcatcode \n\t\t\twhen 1 THEN pd.bonusqty * pd.packunits\n\t\t\twhen 2 THEN pd.bonusqty * pd.packunits\n\t\t\telse pd.bonusqty\n\t\t\tend, 0)),\n\t\tAmount=0.00, Discount=0.00\n\tFROM purledger pl, purdetail pd, item i\n\tWHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND\n\t\tpl.postdate >= :adt_startdate and pl.date <= :adt_enddate AND\n\t\tpd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\tGroup By pd.icode\n\tUNION ALL\n\tselect\ttype='PR',\n\t\tpd.icode,\n\t\tqty = sum(pd.looseqty + pd.packqty * pd.packunits),\n\t\tbonus = sum(pd.bonusqty),\n\t\tAmount=0.00, Discount=0.00\n\tFROM prledger pl, prdetail pd, item i\n\tWHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND\n\t      pl.date >= :adt_startdate and pl.date <= :adt_enddate AND\n\t\tpd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\tGroup By pd.icode\n\tUNION ALL\n\tselect\ttype='SV',\n\t\tsd.icode,\n\t\tqty = sum(sd.looseqty + sd.packqty * sd.packunits),\n\t\tbonus = sum(sd.bonusqty), \n\t\tAmount=sum(sd.looseqty * (sd.saleprice - sd.itemflatdisc) * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)), \n\t\tDiscount=sum(\n\t\t\t(sd.looseqty * sd.itemflatdisc) + \n\t\t\t(sd.looseqty * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * 0.01)) + \n\t\t\t(sd.looseqty * (sd.saleprice - sd.itemflatdisc) * (1 - sd.discperc * 0.01) * (sl.discperc * 0.01)))\n\tFROM saleledger sl, saledetail sd, item i\n\tWHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND\n\t      sl.date >= :adt_startdate and sl.date <= :adt_enddate AND\n\t\tsd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\tGroup By sd.icode\n\tUNION ALL\n\tselect\ttype='SR',\n\t\tsd.icode,\n\t\tqty = sum(sd.looseqty + sd.packqty * sd.packunits),\n\t\tbonus = sum(sd.bonusqty),\n\t\tAmount=sum(sd.looseqty * sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)), \n\t\tDiscount=sum(\n\t\t\t(sd.looseqty * sd.srprice * (sd.discperc * 0.01)) + \n\t\t\t(sd.looseqty * sd.srprice * (1 - sd.discperc * 0.01) * (sl.discperc * 0.01)))\n\tFROM srledger sl, srdetail sd, item i\n\tWHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND\n\t      sl.postdate >= :adt_startdate and sl.date <= :adt_enddate AND\n\t\tsd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\tGroup By sd.icode\n\tUNION ALL\n\tselect\ttype='IV',\n\t\tsd.icode,\n\t\tqty = sum(sd.qty),\n\t\tbonus = 0,\n\t\tAmount=0.00, Discount=0.00\n\tFROM issueheader sl, issuedetail sd, item i\n\tWHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND\n\t      sl.date >= :adt_startdate and sl.date <= :adt_enddate AND\n\t\tsd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\tGroup By sd.icode\n\tUNION ALL\n\tselect\ttype='DS',\n\t\td.icode,\n\t\tqty = sum(d.duesatisfyqty),\n\t\tbonus = 0,\n\t\tAmount=0.00, Discount=0.00\n\tFROM duesatisfyheader h, duesatisfydetail d, item i\n\tWHERE h.duesatisfycode = d.duesatisfycode AND\n\t      h.duesatisfydate >= :adt_startdate and h.duesatisfydate <= :adt_enddate AND\n\t\td.icode=i.icode and i.manfcode in (:ai_manfcode)\n\tGroup By d.icode\n\tUNION ALL\n\tselect\ttype='RV',\n\t\tsd.icode,\n\t\tqty = sum(sd.qty),\n\t\tbonus = 0,\n\t\tAmount=0.00, Discount=0.00\n\tFROM receiptheader sl, receiptdetail sd, item i\n\tWHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND\n\t      sl.postdate >= :adt_startdate and sl.date <= :adt_enddate AND\n\t\tsd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\tGroup By sd.icode\n\tUNION ALL\n\tselect\ttype='AI',\n\t\tsd.icode,\n\t\tqty = sum(sd.looseqty),\n\t\tbonus = 0,\n\t\tAmount=0.00, Discount=0.00\n\tFROM Adjheader sl, Adjdetail sd, item i\n\tWHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND\n\t      sl.posteddate >= :adt_startdate and sl.date <= :adt_enddate AND\n\t\tsd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\tGroup By sd.icode\n\tUNION ALL\n\tselect\ttype='AD',\n\t\tsd.icode,\n\t\tqty = sum(sd.looseqty),\n\t\tbonus = 0,\n\t\tAmount=0.00, Discount=0.00\n\tFROM Adjheader sl, Adjdetail sd, item i\n\tWHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND\n\t      sl.posteddate >= :adt_startdate and sl.date <= :adt_enddate AND\n\t\tsd.icode=i.icode and i.manfcode in (:ai_manfcode)\n\tGroup By sd.icode\n\tUNION ALL\n\tSELECT type='OP', icode, qty = 0, bonus = 0, Amount=0.00, Discount=0.00\n\tFROM ITEM \n\tWHERE ManfCode IN (:ai_manfcode)) St, \n\tItem i\nWHERE st.icode = i.icode\nGROUP BY \tI.CustomICode, I.Name\nORDER BY I.CustomICode\n",
  "arguments": {
