   }
  ],
  "retrieve": "SELECT\n\tProdCodeLEN=9,\n\tProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),\n\tDateLen=10,\n\tDate=CONVERT(VARCHAR(10), GETDATE(), 103),\n\tUnitsLEN=12,\n\tUnits=STR(SUM(ISNULL(GD.CurrQty, 0)), 12, 2),\n\tDSCodeLEN=6,\n\tDSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode))\nFROM\n\tItem I LEFT OUTER JOIN GodownDetail AS GD ON (I.ICode = GD.ICode)\nWHERE\n\tI.ManfCode = :manfcode\nGROUP BY\n\tI.ICode, I.Name, I.CustomICode",
  "arguments": {
   "_items": [
