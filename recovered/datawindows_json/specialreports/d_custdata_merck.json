  "retrieve": "SELECT \n\tDSTBIDLEN=6,\n\tDSTBID=LEFT(LTRIM(RTRIM(Ar.TAG)), 6),\n\tCUSTIDLEN=6,\n\tCUSTID = STR(C.CustCode, 6),\n\tCTLEN=2,\n/*\tCUSTTYPE=REPLICATE('0', 2 - LEN(LTRIM(RTRIM(STR(C.CustCatCode))))) + LTRIM(RTRIM(STR(C.CustCatCode))),*/\n\tCT='03',\n\tCUSTLEN=50,\n\tCUST = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))))),\n\tADDRESSLEN=50,\n\tADDRESS = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 50))))),\n\tAREALEN=30,\n\tAREA = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 30))))),\n\tCITYLEN=30,\n\tCITY = LTRIM(RTRIM(SUBSTRING(C.CITY, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(C.CITY, 1, 30))))),\n\tSTATIONIDLEN=9,\n\tSTATIONID=REPLICATE('0', 4 - LEN(LTRIM(RTRIM(STR(SAR.SUBAREACODE))))) + LTRIM(RTRIM(STR(SAR.SUBAREACODE))) + SPACE(5),\n\tSTATIONLEN=30,\n\tSTATION = LTRIM(RTRIM(SUBSTRING(SAR.NAME, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(SAR.NAME, 1, 30)))))\nFROM Customer C, Accounts A, Area AR, SubArea SAR\nWHERE C.CustCode = A.AccCode AND C.AreaCode = AR.AreaCode AND C.SubAreaCode = SAR.SubAreaCode"
 },
