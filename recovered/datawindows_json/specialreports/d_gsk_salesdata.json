  "retrieve": "SELECT\n\tDistIDLen = 5,\n\tDistID = LEFT(ISNULL(:as_distcode, (SELECT DBO.Fn_GetPreference('MerckDistCode'))) + SPACE(20), 5),\n\tCustCodeLen = 6,\n\tCustCode = LEFT(A.AliasName, 6),\n\tTypeLen=1,\n\tType=LEFT(CC.Name, 1),\n\tProdCodeLen=6, \n\tProdCode=LEFT(LTRIM(RTRIM(I.CustomICode)), 6),\n\tSaleQtyLen=6,\n\tSaleQty=STR(SUM(D.LooseQty), 6, 0),\n\tFromDateLen=10,\n\tFromDate=  \n\t\tCASE WHEN DatePart(dd, :ad_startdate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(dd, :ad_startdate), 2))) + '-' +\n\t\tCASE WHEN DatePart(mm, :ad_startdate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(mm, :ad_startdate), 2))) + '-' +\n\t\tLTRIM(RTRIM(STR(DatePart(yyyy, :ad_startdate), 4))),\n\tToDateLen=10,\n\tToDate= \n\t\tCASE WHEN DatePart(dd, :ad_enddate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(dd, :ad_enddate)))) + '-' +\n\t\tCASE WHEN DatePart(mm, :ad_enddate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(mm, :ad_enddate)))) + '-' +\n\t\tLTRIM(RTRIM(STR(DatePart(yyyy, :ad_enddate), 4)))\nFROM\n\tSaleLedger S,\n\tSaleDetail D,\n\tItem I,\n\tCustomer C,\n\tAccounts A,\n\tCustomerCategory CC\nWHERE\n\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\tS.SaleInvCode = D.SaleInvCode AND \n\tD.ICode = I.ICode AND\n\tI.ManfCode IN (:ai_manfcode) AND\n\tS.CustCode = C.CustCode AND \n\tC.CustCode = A.AccCode AND\n\tC.CustCatCode = CC.CustCatCode\nGROUP BY\n\tA.AliasName, CC.Name, I.CustomICode\nUNION ALL\nSELECT \n\tDistIDLen = 5,\n\tDistID = LEFT(ISNULL(:as_distcode, (SELECT DBO.Fn_GetPreference('MerckDistCode'))) + SPACE(20), 5),\n\tCustCodeLen = 6,\n\tCustCode = LEFT(A.AliasName, 6),\n\tTypeLen=1,\n\tType=LEFT(CC.Name, 1),\n\tProdCodeLen=6,\n\tProdCode=LEFT(LTRIM(RTRIM(I.CustomICode)), 6),\n\tSaleQtyLen=6,\n\tSaleQty=STR(-SUM(D.LooseQty), 6, 0),\n\tFromDateLen=10,\n\tFromDate=  \n\t\tCASE WHEN DatePart(dd, :ad_startdate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(dd, :ad_startdate), 2))) + '-' +\n\t\tCASE WHEN DatePart(mm, :ad_startdate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(mm, :ad_startdate), 2))) + '-' +\n\t\tLTRIM(RTRIM(STR(DatePart(yyyy, :ad_startdate), 4))),\n\tToDateLen=10,\n\tToDate= \n\t\tCASE WHEN DatePart(dd, :ad_enddate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(dd, :ad_enddate)))) + '-' +\n\t\tCASE WHEN DatePart(mm, :ad_enddate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(mm, :ad_enddate)))) + '-' +\n\t\tLTRIM(RTRIM(STR(DatePart(yyyy, :ad_enddate), 4)))\nFROM\n\tSRLedger S,\n\tSRDetail D,\n\tItem I,\n\tCustomer C,\n\tAccounts A,\n\tCustomerCategory CC\nWHERE\n\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\tS.SRInvCode = D.SRInvCode AND \n\tD.ICode = I.ICode AND\n\tI.ManfCode IN (:ai_manfcode) AND\n\tS.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND\n\tC.CustCatCode = CC.CustCatCode\nGROUP BY\n\tA.AliasName, CC.Name, I.CustomICode\nORDER BY\n\tCustCode, Type, ProdCode\n",
