  "retrieve": "SELECT \n\tAREACODE=A.AREACODE, \n\tAREANAME=A.NAME, \n\tCUSTCODE=C.CUSTCODE, \n\tCUSTNAME=AC.NAME,\n\tITEMCODE=S.ITEMCODE, \n\tITEMNAME=I.NAME, \n\tPACKING=I.PACKINGDESC, \n\tINVCODE=S.INVCODE, \n\tDATE, \n\tQUANTITY=SUM(CASE TYPE WHEN 'S' THEN S.QUANTITY ELSE 0 END), \n\tBONUSQTY=SUM(CASE TYPE WHEN 'S' THEN S.BONUSQTY ELSE 0 END),\n\tDISCOUNT=MAX(S.DISCOUNT), \n\tRATE=MAX(S.RATE),\n\tRETQTY=\tSUM(CASE TYPE WHEN 'R' THEN S.RETQTY ELSE 0 END), \n\tRETBONUS=SUM(CASE TYPE WHEN 'R' THEN S.RETBONUS ELSE 0 END)\n\nFROM\n\t(SELECT \n\t\tTYPE='S',\n\t\tDATE=CONVERT(VARCHAR(12), SL.DATE,103), \n\t\tINVCODE=SL.SALEINVCODE, \n\t\tCUSTCODE=SL.CUSTCODE, \n\t\tITEMCODE=SD.ICODE, \n\t\tQUANTITY=SUM(SD.LOOSEQTY), \n\t\tBONUSQTY=SUM(SD.BONUSQTY),\n\t\tDISCOUNT=MAX(SD.DISCPERC), \n\t\tRATE=MAX(SD.SALEPRICE),\n\t\tRETQTY=0,\n\t\tRETBONUS=0\n\tFROM \n\t\tITEM I, \n\t\tSALELEDGER SL, \n\t\tSALEDETAIL SD\n\tWHERE\n\t\tSL.SALEINVCODE = SD.SALEINVCODE AND \n\t\tSL.DATE BETWEEN :ad_startdate AND :ad_enddate AND\n\t\tSL.POSTED='Y' AND\n\t\tI.MANFCODE = :ai_manfcode AND \n\t\tI.ICODE = SD.ICODE\n\tGROUP BY \n\t\tSL.SALEINVCODE, \n\t\tSL.CUSTCODE, \n\t\tCONVERT(VARCHAR(12), SL.DATE,103),\n\t\tSD.ICODE\n\tUNION ALL\n\tSELECT \n\t\tTYPE='R',\n\t\tDATE=CONVERT(VARCHAR(12), SL.DATE,103), \n\t\tINVCODE=SL.SRINVCODE, \n\t\tCUSTCODE=SL.CUSTCODE, \n\t\tITEMCODE=SD.ICODE, \n\t\tQUANTITY=0, \n\t\tBONUSQTY=0,\n\t\tDISCOUNT=MAX(SD.DISCPERC), \n\t\tRATE=MAX(SD.SRPRICE),\n\t\tRETQTY=SUM(SD.LOOSEQTY),\n\t\tRETBONUS=SUM(SD.BONUSQTY)\n\tFROM \n\t\tITEM I, \n\t\tSRLEDGER SL, \n\t\tSRDETAIL SD\n\tWHERE\n\t\tSL.SRINVCODE = SD.SRINVCODE AND \n\t\tSL.DATE BETWEEN :ad_startdate AND :ad_enddate AND\n\t\tSL.POSTED='Y' AND\n\t\tI.MANFCODE = :ai_manfcode AND \n\t\tI.ICODE = SD.ICODE\n\tGROUP BY \n\t\tSL.SRINVCODE, \n\t\tSL.CUSTCODE, \n\t\tCONVERT(VARCHAR(12), SL.DATE,103),\n\t\tSD.ICODE) S,\n\tITEM I,\n\tCUSTOMER C,\n\tAREA A,\n\tACCOUNTS AC\n\nWHERE\n\tS.ITEMCODE = I.ICODE AND\n\tS.CUSTCODE = C.CUSTCODE AND\n\tC.CUSTCODE = AC.ACCCODE AND\n\tC.AREACODE = A.AREACODE\nGROUP BY \n\tS.TYPE,\n\tS.INVCODE, \n\tS.ITEMCODE, \n\tS.DATE,\n\tC.CUSTCODE, \n\tAC.NAME, \n\tA.AREACODE, \n\tA.NAME, \n\tI.NAME, \n\tI.PACKINGDESC\nORDER BY DATE, TYPE, INVCODE, ITEMCODE\n\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_manfcode",
      "number"
     ]
    },
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
