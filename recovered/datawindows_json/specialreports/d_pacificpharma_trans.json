  "retrieve": "SELECT\n\tDistCode=LTRIM(RTRIM(:as_distcode + SPACE(10))), \n\tCity = LTRIM(RTRIM(:as_city  + SPACE(60))), \n\tDocDate=CONVERT(VARCHAR(12), H.Date, 103),\n\tDocNo=H.SaleInvCode, \n\tDocType='SA',\n\tItemCode=I.Remarks, \n\tItemName=I.Name, \n\tPackSize=I.PackingDesc, \n\tTeam=IC.Name, \n\tTradePrice=D.SalePrice,\n\tBatchNo=D.Batch, \n\tQty = D.LooseQty,\n\tTerritory=C.AreaCode, \n\tBrick=C.SubAreaCode, \n\tChemist = A.AliasName\nFROM \n\tSaleLedger H, SaleDetail D, Item I, ItemCategory IC, Customer C, Accounts A\nWHERE \n\tH.Date BETWEEN :adt_StartDate AND :adt_EndDate AND\n\tH.Posted = 'Y' AND\n\tH.SaleInvCode = D.SaleInvCode AND\n\tD.ICode = I.ICode AND\n\tI.ManfCode = :ai_manfcode AND \n\tI.ICatCode=IC.ICatCode AND \n\tH.CustCode = C.CustCode AND\n\tC.CustCode = A.Acccode\nUNION ALL\nSELECT \n\tDistCode=LTRIM(RTRIM(:as_distcode + SPACE(10))), \n\tCity = LTRIM(RTRIM(:as_city  + SPACE(60))), \n\tDocDate=CONVERT(VARCHAR(12), H.Date, 103),\n\tDocNo=H.SRInvCode, \n\tDocType='SR',\n\tItemCode=I.Remarks, \n\tItemName=I.Name, \n\tPackSize=I.PackingDesc, \n\tTeam=IC.Name, \n\tTradePrice=D.SRPrice,\n\tBatchNo=D.Batch, \n\tQty = D.LooseQty, Territory=C.AreaCode, Brick=C.SubAreaCode, Chemist = A.AliasName\nFROM \n\tSRLedger H, SRDetail D, Item I, ItemCategory IC, Customer C, Accounts A\nWHERE \n\tH.Date BETWEEN :adt_StartDate AND :adt_EndDate AND\n\tH.Posted = 'Y' AND\n\tH.SRInvCode = D.SRInvCode AND\n\tD.ICode = I.ICode AND\n\tI.ManfCode = :ai_manfcode AND \n\tI.ICatCode=IC.ICatCode AND \n\tH.CustCode = C.CustCode AND\n\tC.CustCode = A.Acccode\nUNION ALL\nSELECT \n\tDistCode=LTRIM(RTRIM(:as_distcode + SPACE(10))), \n\tCity = LTRIM(RTRIM(:as_city  + SPACE(60))), \n\tDocDate=CONVERT(VARCHAR(12), H.Date, 103),\n\tDocNo=H.PurInvCode, \n\tDocType='PU',\n\tItemCode=I.Remarks, \n\tItemName=I.Name, \n\tPackSize=I.PackingDesc, \n\tTeam=IC.Name, \n\tTradePrice=D.PurPrice,\n\tBatchNo=D.Batch, \n\tQty = D.LooseQty + (D.PackQty * D.PackUnits), \n\tTerritory=NULL, \n\tBrick=NULL, \n\tChemist = NULL\nFROM \n\tPurLedger H, PurDetail D, Item I, ItemCategory IC, Supplier S, Accounts A\nWHERE \n\tH.Date BETWEEN :adt_StartDate AND :adt_EndDate AND\n\tH.Posted = 'Y' AND\n\tH.PurInvCode = D.PurInvCode AND\n\tD.ICode = I.ICode AND\n\tI.ManfCode = :ai_manfcode AND \n\tI.ICatCode=IC.ICatCode AND\n\tH.SuppCode = S.SuppCode AND\n\tS.SuppCode = A.AccCode\nUNION ALL\nSELECT \n\tDistCode=LTRIM(RTRIM(:as_distcode + SPACE(10))), \n\tCity = LTRIM(RTRIM(:as_city  + SPACE(60))), \n\tDocDate=CONVERT(VARCHAR(12), H.Date, 103),\n\tDocNo=H.PrInvCode, \n\tDocType='PR',\n\tItemCode=I.Remarks, \n\tItemName=I.Name, \n\tPackSize=I.PackingDesc, \n\tTeam=IC.Name, \n\tTradePrice=D.PrPrice,\n\tBatchNo=D.Batch, \n\tQty = D.LooseQty, \n\tTerritory=NULL, \n\tBrick=NULL, \n\tChemist = NULL\nFROM \n\tPrLedger H, PrDetail D, Item I, ItemCategory IC, Supplier S, Accounts A\nWHERE \n\tH.Date BETWEEN :adt_StartDate AND :adt_EndDate AND\n\tH.Posted = 'Y' AND\n\tH.PrInvCode = D.PrInvCode AND\n\tD.ICode = I.ICode AND\n\tI.ManfCode = :ai_manfcode AND \n\tI.ICatCode=IC.ICatCode AND\n\tH.SuppCode = S.SuppCode AND\n\tS.SuppCode = A.AccCode\nORDER BY\n\tDocDate, DocType, DocNo, ItemName, BatchNo",
