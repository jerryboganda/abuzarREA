  "retrieve": "SELECT\n\tDSTBIDLEN=6, \n\tDSTBID= ZAR.DistCode + REPLICATE(' ', 6 - LEN(ZAR.DistCode)), \n\tDOCUMENTNOLEN=12, \n\tDOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SaleInvCode, 12))), 1, 12),  \n\tDOCDATELEN=10, \n\tDOCDATE=Convert(varchar(10), SL.DATE, 103), \n\tCUSTIDLEN=10,\n\tCUSTID = SUBSTRING(LTRIM(RTRIM(STR(SL.CustCode, 10))), 1, 10), \n\tPRDIDLEN=9,\n\tPRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),\n\tBatchNoLEN=10,\n\tBatchNo=SUBSTRING(SD.Batch, 1, 10),\n\tExpDateLEN=10,\n\tExpDate=Convert(varchar(10), SD.Expiry, 103),\n\tActualLEN=12,\n\tActual=SUBSTRING(LTRIM(RTRIM(STR(SD.LooseQty, 12, 2))), 1, 12),\n\tRateLEN=12,\n\tRate=SUBSTRING(LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))), 1, 12), \n\tDISCOUNTLEN=12,\n\tDISCOUNT=SUBSTRING(LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + SD.ItemFlatDisc, 12, 2))),1, 12),\n\tBonusLEN=12,\n\tBonus=SUBSTRING(LTRIM(RTRIM(STR(SD.BonusQty, 12, 2))), 1, 12), \n\tReturnsLEN=12,\n\tReturns=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))),1, 12),\n\tExpiredLEN=12,\n\tExpired=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))),1, 12)\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tCustomer C,\n\tCustomerCategory CC,\n\tItem I,\n\t(SELECT DistCode = LEFT(LTRIM(RTRIM(Z.Remarks)), 6), ZA.AreaCode, Z.ManfCode\n\tFROM Zone Z, ZoneAreas ZA\n\tWHERE Z.ZoneCode = :ai_zonecode AND \n\t\tZ.ZoneCode = ZA.ZoneCode) ZAR\nWHERE\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate AND\n\tSL.POSTED = 'Y' AND\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.CustCode = C.CustCode AND\n\tC.AreaCode = ZAR.AreaCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = ZAR.ManfCode\nUNION ALL\nSELECT \n\tDSTBIDLEN=6,\n\tDSTBID= ZAR.DistCode + REPLICATE(' ', 6 - LEN(ZAR.DistCode)),\n\tDOCUMENTNOLEN=12,\n\tDOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SRInvCode, 12))), 1, 12), \n\tDOCDATELEN=10,\n\tDOCDATE=Convert(varchar(10), SL.DATE, 103),\n\tCUSTIDLEN=10,\n\tCUSTID = SUBSTRING(LTRIM(RTRIM(STR(SL.CustCode, 10))), 1, 10), \n\tPRDIDLEN=9,\n\tPRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),\n\tBatchNoLEN=10,\n\tBatchNo=SUBSTRING(SD.Batch, 1, 10),\n\tExpDateLEN=10,\n\tExpDate=Convert(varchar(10), SD.Expiry, 103),\n\tActualLEN=12,\n\tActual=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),\n\tRateLEN=12,\n\tRate=SUBSTRING(LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))), 1, 12), \n\tDISCOUNTLEN=12,\n\tDISCOUNT=SUBSTRING(LTRIM(RTRIM(STR(- Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),1, 12),\n\tBonusLEN=12,\n\tBonus=SUBSTRING(LTRIM(RTRIM(STR(SD.BonusQty, 12, 2))), 1, 12), \n\tReturnsLEN=12,\n\tReturns=SUBSTRING(LTRIM(RTRIM(STR(SD.LooseQty, 12, 2))),1, 12),\n\tExpiredLEN=12,\n\tExpired=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))),1, 12)\nFROM\n\tSRLedger SL,\n\tSRDetail SD,\n\tCustomer C,\n\tCustomerCategory CC,\n\tItem I,\n\t(SELECT DistCode = LEFT(LTRIM(RTRIM(Z.Remarks)), 6), ZA.AreaCode, Z.ManfCode\n\tFROM Zone Z, ZoneAreas ZA\n\tWHERE Z.ZoneCode = :ai_zonecode AND \n\t\tZ.ZoneCode = ZA.ZoneCode) ZAR\nWHERE\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate AND\n\tSL.POSTED = 'Y' AND\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSL.CustCode = C.CustCode AND\n\tC.AreaCode = ZAR.AreaCode AND \n\tC.CustCatCode = CC.CustCatCode AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = ZAR.ManfCode\n",
