  "retrieve": "SELECT  \n\tDSTBIDLEN=6,\n\tDSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),\n\tPRDIDLEN=9, \n\tPRDID=SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9),\n\tPRDLEN=50,\n\tPRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),\n\tCLDATELEN=10,\n\tCLDATE=Convert(varchar(10), :adt_enddate, 103), \n\tBATCHNOLEN=10,\n\tBATCHNO=GD.Batch, \n\tCLOSINGLEN=12,\n\tCLOSING=STR(ISNULL(GD.CurrQty, 0), 12),\n\tEBatchLEN=10,\n\tEBatch=Convert(varchar(10), GD.Expiry, 103)\nFROM\n\tItem I LEFT OUTER JOIN GodownDetail AS GD ON (I.ICode = GD.ICode)\nWHERE\n\t:ai_scope = 1 AND\n\tI.ManfCode = :manfcode\nUNION ALL\nSELECT  \n\tDSTBIDLEN=6,\n\tDSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),\n\tPRDIDLEN=9, \n\tPRDID=SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9),\n\tPRDLEN=50,\n\tPRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),\n\tCLDATELEN=10,\n\tCLDATE=Convert(varchar(10), :adt_enddate, 103), \n\tBATCHNOLEN=10,\n\tBATCHNO=GD.Batch, \n\tCLOSINGLEN=12,\n\tCLOSING=STR(ISNULL(GD.CurrQty, 0), 12),\n\tEBatchLEN=10,\n\tEBatch=Convert(varchar(10), GD.Expiry, 103)\nFROM\n\tItem I LEFT OUTER JOIN CRS_GodownDetail AS GD ON (I.ICode = GD.ICode)\nWHERE\n\t:ai_scope = 2 AND\n\tI.ManfCode = :manfcode\n",
