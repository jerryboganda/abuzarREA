  "retrieve": "SELECT  \n\tDSTBID=AR.TAG,\n\tDOCUMENTNO = SL.SaleInvCode,\n\tDOCDATE=Convert(varchar(10), SL.DATE, 103), \n\tCUSTID = SL.CustCode,\n\tTOWNID=AR.AREACODE,\n\tPRDID=SD.ICode, \n\tPRD=I.Name,\n\tBatchNo=SD.Batch, \n\tPrice=SD.SalePrice, \n\tQty=SD.LooseQty, \n\tBonus=SD.BonusQty, \n\tDISCOUNT=Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2),\n\tNETAMOUNT=Round((SD.LooseQty * SD.SalePrice * (1 - SD.DiscPerc * 0.01)), 2),\n\tREASON='S'\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tCustomer C,\n\tCustomerCategory CC,\n\tItem I,\n\tArea Ar\nWHERE\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tC.AreaCode = Ar.AreaCode\nUNION ALL\nSELECT \n\tDSTBID=AR.TAG,\n\tDOCUMENTNO = SL.SRInvCode,\n\tDOCDATE=Convert(varchar(10), SL.DATE, 103), \n\tCUSTID = SL.CustCode,\n\tTOWNID=AR.AREACODE,\n\tPRDID=SD.ICode,\n\tPRD=I.Name, \n\tBatchNo=SD.Batch, \n\tPrice=SD.SRPrice,\n\tQty=SD.LooseQty, \n\tBonus=SD.BonusQty, \n\tDISCOUNT=Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), \n\tNETAMOUNT=Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), \n\tREASON='R'\nFROM\n\tSRLedger SL,\n\tSRDetail SD,\n\tCustomer C,\n\tCustomerCategory CC,\n\tItem I,\n\tArea AR\n\nWHERE\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tC.AreaCode = AR.AreaCode",
  "arguments": {
   "_items": [
