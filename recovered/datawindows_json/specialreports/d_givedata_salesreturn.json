    "dbname": "SALEPRICE"
   }
  ],
  "retrieve": "SELECT \n\tINV_NO=S.SRINVCODE, \n\tINV_DATE=S.DATE, \n\tCUSTCODE=A.ACCCODE,\n\tCUSTNAME=A.NAME, \n\tPROD_CODE=I.CUSTOMICODE, \n\tITEMNAME=I.NAME, \n\tPACK_SIZE=I.PACKINGDESC, \n\tSL.BATCH, \n\tSL.EXPIRY,\n\tSL.LOOSEQTY, \n\tSL.BONUSQTY, \n\tSL.DISCPERC, \n\tSALEPRICE=SL.SRPRICE \nFROM \n\tSRLEDGER S, \n\tSRDETAIL SL, \n\tITEM I, \n\tACCOUNTS A\nWHERE \n\tS.SRINVCODE = SL.SRINVCODE AND \n\tS.CUSTCODE = A.ACCCODE AND \n\tSL.ICODE = I.ICODE AND\n\tI.MANFCODE = :ai_manfcode AND \n\tS.DATE BETWEEN :ad_StartDATE AND :ad_EndDATE\nORDER BY \n\tS.DATE,\n\tS.SRINVCODE,\n\tI.NAME,\n\tSL.BATCH, \n\tSL.EXPIRY",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_manfcode",
      "number"
     ]
    },
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "inv_date A, inv_no A, itemname A, prod_code A, batch A, expiry A"
 },
