  "retrieve": "SELECT \n\tTransNoLen=10,\n\tTransNo=STR(S.SaleInvCode, 10),\n\tDateLen = 10,\n\tDate = CONVERT(VARCHAR(10), S.Date, 103),\n\tCustCodeLen=10,\n\tCustCode=STR(S.CustCode, 10),\n\tProdCodeLen=10,\n\tProdCode=STR(SD.ICode, 10),\n\tBatchNoLen=10,\n\tBatchNo=SD.Batch,\n\tQtyLen=10,\n\tQty=STR(SD.LooseQty, 10), \n\tBonusUnitLen=10,\n\tBonusUnit=STR(SD.BonusQty, 10), \n\tDiscountLen=12,\n\tDiscount=STR( \n\t\t(SD.LooseQty * SD.ItemFlatDisc) + \n\t\t(SD.LooseQty * SD.SalePrice * SD.DiscPerc * 0.01) + \n\t\t(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * S.DiscPerc * 0.01), 12, 2), \n\tAmountLen=12,\n\tAmount=STR( \n\t\t(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)), 12, 2), \n\tTypeLen=1,\n\tType='S',\n\tDsCodeLen=100,\n\tDsCode=CONVERT(VARCHAR(100), :as_dscode)\nFROM\n\tSaleLedger S, SaleDetail SD, Item I\nWHERE\n\tS.Date >= :ar_startdate AND S.Date <= :ar_enddate AND\n\tSD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode) AND\n\tS.SaleInvCode = SD.SaleInvCode\nUNION ALL\nSELECT \n\tTransNoLen=10,\n\tTransNo=STR(S.SRInvCode, 10),\n\tDateLen = 10,\n\tDate = CONVERT(VARCHAR(10), S.Date, 103),\n\tCustCodeLen=10,\n\tCustCode=STR(S.CustCode, 10),\n\tProdCodeLen=10,\n\tProdCode=STR(SD.ICode, 10),\n\tBatchNoLen=10,\n\tBatchNo=SD.Batch,\n\tQtyLen=10,\n\tQty=STR(SD.LooseQty, 10), \n\tBonusUnitLen=10,\n\tBonusUnit=STR(SD.BonusQty, 10), \n\tDiscountLen=12,\n\tDiscount=STR( \n\t\t(SD.LooseQty * SD.SRPrice * SD.DiscPerc * 0.01) + \n\t\t(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * S.DiscPerc * 0.01), 12, 2), \n\tAmountLen=12,\n\tAmount=STR( \n\t\t(SD.LooseQty * SD.SalePrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)), 12, 2), \n\tTypeLen=1,\n\tType='R',\n\tDsCodeLen=100,\n\tDsCode=CONVERT(VARCHAR(100), :as_dscode)\nFROM\n\tSRLedger S, SRDetail SD, Item I\nWHERE\n\tS.Date >= :ar_startdate AND S.Date <= :ar_enddate AND\n\tSD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode) AND\n\tS.SRInvCode = SD.SRInvCode\nORDER BY\n\tCustCode,\n\tProdCode,\n\tType\n",
  "arguments": {
   "_items": [
