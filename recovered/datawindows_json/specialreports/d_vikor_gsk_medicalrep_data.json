  ],
  "retrieve": "SELECT \n\tDISTINCT\n\tDSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),\n\tPrincipalCode=LTRIM(RTRIM(STR(Z.ManfCode, 6))), \n\tRegionCode=LTRIM(RTRIM(STR(Z.ZoneCode, 6))), \n\tMedicalRepCode=LTRIM(RTRIM(STR(C.SalesManCode, 6))), \n\tName=S.Name\nFROM\n\tZone Z, ZoneAreas ZA, Area A, Customer C, Salesman S\nWHERE \n\tZ.ManfCode IN (:ai_manfcode) AND\n\tZ.ZoneCode=ZA.ZoneCode AND\n\tZA.AreaCode = A.AreaCode AND\n\tA.AreaCode = C.AreaCode AND\n\tC.SalesManCode = S.SalesManCode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_distcode",
      "string"
     ]
    },
    {
     "_items": [
      "ai_manfcode",
      "numberlist"
     ]
    }
   ]
  }
 },
