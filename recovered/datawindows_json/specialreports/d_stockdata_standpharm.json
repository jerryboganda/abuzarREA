  "retrieve": "SELECT\n\tDSTBIDLEN=6,\n\tDSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),\n\tCLDATELEN=10,\n\tCLDATE=Convert(varchar(10), :ar_enddate, 103),\n\tPRDIDLEN=9,\n\tPRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9) + REPLICATE(' ', 9 - LEN(LTRIM(RTRIM(SUBSTRING(I.CustomICode, 1, 9))))),\n\tPRDLEN=50,\n\tPRD = LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))))),\n\tBatchNoLEN=10,\n\tBatchNo= ISNULL(GD.Batch, '.') + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(ISNULL(GD.Batch, '.'), 1, 10))))),\n\tEXPDATELEN=10,\n\tEXPDATE= Convert(varchar(10), GD.Expiry, 103),\n\tCLBalanceLEN=14,\n\tCLBalance=STR(SUM(ISNULL(GD.CurrQty, 0)), 14),\n\tINTRANSITLEN=14,\n\tINTRANSIT=STR(0, 14),\n\tSHORTAGELEN=14,\n\tSHORTAGE=STR(0, 14),\n\tEXPIREDLEN=14,\n\tEXPIRED=STR(0, 14)\nFROM\n\tItem I LEFT OUTER JOIN GodownDetail AS GD ON (I.ICode = GD.ICode)\nWHERE\n\t:ai_scope=1 AND\n\tI.ManfCode = :manfcode\nGROUP BY\n\tI.ICode,\n\tI.Name,\n\tI.CustomICode,\n\tGD.Batch,\n\tGD.Expiry\nUNION ALL\nSELECT\n\tDSTBIDLEN=6,\n\tDSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),\n\tCLDATELEN=10,\n\tCLDATE=Convert(varchar(10), :ar_enddate, 103),\n\tPRDIDLEN=9,\n\tPRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9) + REPLICATE(' ', 9 - LEN(LTRIM(RTRIM(SUBSTRING(I.CustomICode, 1, 9))))),\n\tPRDLEN=50,\n\tPRD = LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))))),\n\tBatchNoLEN=10,\n\tBatchNo= ISNULL(GD.Batch, '.') + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(ISNULL(GD.Batch, '.'), 1, 10))))),\n\tEXPDATELEN=10,\n\tEXPDATE= Convert(varchar(10), GD.Expiry, 103),\n\tCLBalanceLEN=14,\n\tCLBalance=STR(SUM(ISNULL(GD.CurrQty, 0)), 14),\n\tINTRANSITLEN=14,\n\tINTRANSIT=STR(0, 14),\n\tSHORTAGELEN=14,\n\tSHORTAGE=STR(0, 14),\n\tEXPIREDLEN=14,\n\tEXPIRED=STR(0, 14)\nFROM\n\tItem I LEFT OUTER JOIN CRS_GodownDetail AS GD ON (I.ICode = GD.ICode)\nWHERE\n\t:ai_scope=2 AND\n\tI.ManfCode = :manfcode\nGROUP BY\n\tI.ICode,\n\tI.Name,\n\tI.CustomICode,\n\tGD.Batch,\n\tGD.Expiry\nORDER BY\n\tPRDID",
  "arguments": {
   "_items": [
