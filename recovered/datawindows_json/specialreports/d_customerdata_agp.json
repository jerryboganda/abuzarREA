  "retrieve": "SELECT \n\tCodeLen=10,\n\tCode=STR(C.CustCode, 10),\n\tNameLen=100,\n\tName=A.Name,\n\tAddress1Len=100,\n\tAddress1=C.Address1,\n\tAddress2Len=100,\n\tAddress2=C.Address2,\n\tContactNoLen=100,\n\tContactNo=C.Phone,\n\tLicenseNoLen=100,\n\tLicenseNo=C.LicenceNo,\n\tRegionCodeLen=5,\n\tRegionCode=STR(AR.AreaCode, 5),\n\tRegionNameLen=100,\n\tRegionName=AR.Name,\n\tTypeLen=100,\n\tType=CC.Name,\n\tDsCodeLen=100,\n\tDsCode=CONVERT(VARCHAR(100), :as_dscode)\nFROM\n\tAccounts A, Customer C, Area AR, CustomerCategory CC\nWHERE\n\tA.AccCode = C.CustCode AND C.AreaCode = AR.AreaCode AND\n\tC.CustCatCode = CC.CustCatCode\nORDER BY\n\tCustCode\n",
