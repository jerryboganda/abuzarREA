  "retrieve": "SELECT \n\t\tDistributor_ID=:as_distcode + REPLICATE(' ', 10 - LEN(:as_distcode)),\n\t\tCurrency_ID = 'PKR',\n\t\tCustomer_ID=T.Customer_ID,\n\t\tItemCode=T.ItemCode,\n\t\tDate_ID=T.DATE,\n\t\tQuantity=SUM(T.Quantity),\n\t\tValue=SUM(T.Value)\nFROM\n\t(SELECT \n\t\tCustomer_ID=A.AliasName,\n\t\tItemCode=I.CustomICode,\n\t\tDate=Convert(VARCHAR(100), SL.Date, 112),\n\t\tQuantity=SUM(SD.LooseQty),\n\t\tValue=SUM(SD.LooseQty * SD.SalePrice)\n\tFROM\n\t\tSaleLedger SL,\n\t\tSaleDetail SD,\n\t\tCustomer C,\n\t\tAccounts A,\n\t\tItem I\n\tWHERE\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSL.POSTED = 'Y' AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode IN (:ai_manfcode) AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.CustCode = A.AccCode AND \n\t\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\n\tGROUP BY\n\t\tA.AliasName,\n\t\tI.CustomICode,\n\t\tConvert(VARCHAR(100), SL.Date, 112)\n\tUNION ALL\n\tSELECT \n\t\tCustomer_ID=A.AliasName,\n\t\tItemCode=I.CustomICode,\n\t\tDate=Convert(VARCHAR(100), SL.Date, 112),\n\t\tQuantity=SUM(SD.LooseQty),\n\t\tValue=SUM(SD.LooseQty * SD.SRPrice)\n\tFROM\n\t\tSRLedger SL,\n\t\tSRDetail SD,\n\t\tCustomer C,\n\t\tAccounts A,\n\t\tItem I\n\tWHERE\n\t\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSL.POSTED = 'Y' AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode IN (:ai_manfcode) AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.CustCode = A.AccCode AND \n\t\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\n\tGROUP BY\n\t\tA.AliasName,\n\t\tI.CustomICode,\n\t\tConvert(VARCHAR(100), SL.Date, 112)) T\nGROUP BY\n\tT.Customer_ID,\n\tT.ItemCode,\n\tT.DATE\n\t",
  "arguments": {
   "_items": [
    {
     "_items": [
