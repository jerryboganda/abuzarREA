    "dbname": "LastChangedTime"
   }
  ],
  "retrieve": "SELECT\n\tTradeSector='PH',\n\tOutletCode= LTRIM(RTRIM(:as_distcode + A.AliasName + SPACE(100))),\n\tOutletName = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))),\n\tActive = A.Active,\n\tOutletType=LTRIM(RTRIM(CT.NAME)),\n\tAreaType = 'RURAL',\n\tAccountType=LTRIM(RTRIM(CT.NAME)),\n\tCannelProgram=LTRIM(RTRIM(CT.NAME)),\n\tTown = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 60))),\n\tLocality = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))),\n\tSubLocality = LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 60))),\n\tLastChangedDate = CONVERT(VARCHAR(15), GETDATE(), 104),\n\tLastChangedTime = CONVERT(VARCHAR(15), GETDATE(), 108)\nFROM Customer C, Accounts A, Area AR, CUSTOMERCATEGORY CT\nWHERE C.CustCode = A.AccCode AND \n\tC.AreaCode = AR.AreaCode AND \n\tC.CUSTCATCODE = CT.CUSTCATCODE\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_distcode",
      "string"
     ]
    }
   ]
  }
