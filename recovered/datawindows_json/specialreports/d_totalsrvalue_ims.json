    "name": "totalvalue",
    "dbname": "TotalValue"
   }
  ],
  "retrieve": "SELECT\n\tCompanyCodeLEN=6,\n\tCompanyCode=STR(S.CompanyCode, 6),\n\tTotalQtyLen=12, \n\tTotalQty=STR(Sum(S.Qty), 12),\n\tTotalValueLen=15,\n\tTotalValue=STR(Sum(S.Value), 15, 2)\nFROM\n\t(SELECT\n\t\tCustCode=S.CustCode,\n\t\tProdCode=SD.ICode,\n\t\tCompanyCode = I.ManfCode,\n\t\tQty=CAST(Sum(SD.LooseQty) / (CASE WHEN :ai_loosepack = 0 THEN 1 ELSE CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END END) AS INT),\n\t\tTp=CASE WHEN :ai_loosepack = 0 THEN ROUND((I.SalePrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END), 2) ELSE I.SalePrice END,\n\t\tValue=CAST(Sum(SD.LooseQty) / (CASE WHEN :ai_loosepack = 0 THEN 1 ELSE CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END END) AS INT) * (CASE WHEN :ai_loosepack = 0 THEN ROUND((I.SalePrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END), 2) ELSE I.SalePrice END),\n\t\tDATE=Convert(varchar(10), S.DATE, 103)\n\tFROM\n\t\tSRLedger S, SRDetail SD, Item I\n\tWHERE\n\t\tS.Date BETWEEN :ar_startdate AND :ar_enddate AND\n\t\tS.SRInvCode = SD.SRInvCode AND \n\t\tSD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode) AND\n\t\t:ai_scope = 1\n\tGROUP BY\n\t\tS.CustCode, \n\t\tSD.ICode,\n\t\tS.Date,\n\t\tI.ManfCode,\n\t\tI.SalePrice,\n\t\tI.PackUnits\n\tUNION ALL\n\tSELECT\n\t\tCustCode=S.CustCode,\n\t\tProdCode=SD.ICode,\n\t\tCompanyCode = I.ManfCode,\n\t\tQty=CAST(Sum(SD.LooseQty) / (CASE WHEN :ai_loosepack = 0 THEN 1 ELSE CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END END) AS INT),\n\t\tTp=CASE WHEN :ai_loosepack = 0 THEN ROUND((I.SalePrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END), 2) ELSE I.SalePrice END,\n\t\tValue=CAST(Sum(SD.LooseQty) / (CASE WHEN :ai_loosepack = 0 THEN 1 ELSE CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END END) AS INT) * (CASE WHEN :ai_loosepack = 0 THEN ROUND((I.SalePrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END), 2) ELSE I.SalePrice END),\n\t\tDATE=Convert(varchar(10), S.DATE, 103)\n\tFROM\n\t\tCRS_ClientInstance CI, CRS_ClientList CL, CRS_SRLedger S, CRS_SRDetail SD, Item I\n\tWHERE\n\t\tCL.ClientID = CI.ClientID AND CI.ClientInstanceID = S.ClientInstanceID AND\n\t\tS.SRInvCode = SD.SRInvCode AND \n\t\tS.Date BETWEEN :ar_startdate AND :ar_enddate AND\n\t\tSD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode) AND\n\t\t:ai_scope = 2\n\tGROUP BY\n\t\tS.CustCode, \n\t\tSD.ICode,\n\t\tS.Date,\n\t\tI.ManfCode,\n\t\tI.SalePrice,\n\t\tI.PackUnits) S\nGROUP BY\n\tS.CompanyCode\nORDER BY\n\tCompanyCode\n",
