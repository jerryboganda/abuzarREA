  "retrieve": "SELECT \n\tDistributorID=LTRIM(RTRIM(:as_distcode+SPACE(100))),\n\tTransactionID = LTRIM(RTRIM(STR(SL.SaleInvCode, 20))),\n\tTransactionDate=Convert(varchar(10), SL.DATE, 120),\n\tCustID = LTRIM(RTRIM(A.AliasName)),\n\tProductID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),\n\tProductBatchNo=SD.Batch,\n\tProductPrice = LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))),\n\tProductQty=LTRIM(RTRIM(STR(SD.LooseQty, 12))),\n\tBonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),\n\tDiscount=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + (SD.LooseQty * SD.ItemFlatDisc), 12, 2))),\n\tTotalPrice=LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2),12, 2))),\n\tTransactionType='S'\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tCustomer C,\n\tSubArea SA,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.SubAreaCode=SA.SubAreaCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\nUNION ALL\nSELECT \n\tDistributorID=LTRIM(RTRIM(:as_distcode+SPACE(100))),\n\tTransactionID = LTRIM(RTRIM(STR(SL.SRInvCode, 20))),\n\tTransactionDate=Convert(varchar(10), SL.DATE, 120),\n\tCustID = LTRIM(RTRIM(A.AliasName)),\n\tProductID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),\n\tProductBatchNo=SD.Batch,\n\tProductPrice = LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))),\n\tProductQty=LTRIM(RTRIM(STR(SD.LooseQty, 12))),\n\tBonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),\n\tDiscount=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),\n\tTotalPrice=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2),12, 2))),\n\tTransactionType='R'\nFROM\n\tSRLedger SL,\n\tSRDetail SD,\n\tCustomer C,\n\tSubArea SA,\n\tAccounts A,\n\tCustomerCategory CC,\n\tItem I\nWHERE\n\tSL.SRInvCode = SD.SRInvCode AND\n\tSL.POSTED = 'Y' AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = :manfcode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND \n\tC.SubAreaCode=SA.SubAreaCode AND\n\tC.CustCatCode = CC.CustCatCode AND\n\tSL.DATE BETWEEN :ar_startdate AND :ar_enddate\n",
  "arguments": {
   "_items": [
