  "retrieve": "SELECT \n\tV.Code,\n\tV.PatientCode,\n\tRegNo=P.RegNo,\n\tPatientName=P.Name,\n\tPatientFName=P.FName,\n\tMobileNo1=P.MobileNo1,\n\tMobileNo2=P.MobileNo2,\n\tMobileNo3=P.MobileNo3,\n\tV.ICode,\n\taliasname = i.customicode,\n\ti.name,\n\tCurrListRow = 0,\n\tV.DueDate,\n\tV.VaccineStatusCode,\n\tV.LastRemindedOn,\n\tV.LastRemindedBy,\n\tV.LastPendedOn,\n\tV.LastPendedBy,\n\tV.VaccinatedOn,\n\tV.StoppedOn,\n\tV.StoppedBy,\n\tVaccinatedBy,\n\tV.Remarks,\n\tV.Doctcode\nFrom   \n\tvaccineschedule v , Item i, Patient P\nWhere \n\tv.duedate between :adt_startdate AND :adt_enddate AND\n\tv.patientcode = p.patientcode AND\n\tv.icode = i.icode",
  "update": "vaccineschedule",
  "updatewhere": "0",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "duedate A, patientname A, patientfname A, regno A, itemname A"
 },
