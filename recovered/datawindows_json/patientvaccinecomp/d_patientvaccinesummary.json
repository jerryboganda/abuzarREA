  "retrieve": "SELECT \n\tTemplate = SH.Name,\n\tRegNo = P.RegNo,\n\tPatientName = P.Name,\n\tActive=P.Active,\n\tVaccine = I.Name,\n\tScheduled = COUNT(VS.Code),\n\tDone = SUM(CASE WHEN VS.VaccineStatusCode=1 THEN 1 ELSE 0 END),\n/*\tPending = SUM(CASE WHEN VS.VaccineStatusCode=2 OR VS.VaccineStatusCode=3 THEN 1 ELSE 0 END),*/\n\tPending = SUM(CASE WHEN VS.VaccineStatusCode=1 THEN 0 ELSE 1 END),\n\tStartDate=MIN(VS.DueDate),\n\tEndDate=MAX(VS.DueDate),\n\tLastTreatmentOn=MAX(VS.VaccinatedOn)\nFROM \n\tVaccineSchedule VS, Patient P, Item I, SaleTemplateDetail SD, SaleTemplateHeader SH\nWHERE \n\tP.Active = 'Y' AND\n\tP.PatientCode = VS.PatientCode AND \n\tVS.ICode = I.ICode AND \n\tVS.SaleTemplateRowID = SD.RowID AND\n\tSD.SaleTemplateCode = SH.SaleTemplateCode\nGROUP BY\n\tSH.Name,\n\tP.RegNo,\n\tP.Name,\n\tP.Active,\n\tI.Name\n"
 },
