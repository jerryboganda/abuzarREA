  "retrieve": "SELECT \n\t\titemname= case item.printable WHEN 1 THEN left(item.name,25) ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END, \n         aliasname=item.customicode,  \n\t\titemremarks=max(item.remarks), \n\t\titemshortname=max(item.shortname),\n\t\tsize=(select name from itemsize where itemsize.isizecode=max(item.isizecode)),\n\t\tgenericname=(select name from genericitem where max(item.genericcode)=genericitem.genericcode),\n\t\titemcolor=(select name from itemcolour where itemcolour.icolourcode=max(item.icolourcode)),\n\t\titemcategory=(select name from itemcategory where itemcategory.icatcode=max(item.icatcode)),\n\t\titemstyle=(select name from itemstyle where itemstyle.istylecode=max(item.istylecode)),\n         packingdesc=max(item.packingdesc),   \n\t\tpacking=(select name from itempacking where itempacking.packcode=max(item.packcode)),\n         accname = dbo.accounts.name,   \n         address =max( dbo.customer.address1),   \n         address2= max(dbo.customer.address2),    \n         salesman = dbo.users.username,   \n         saleinvcode = dbo.saleledger.saleinvcode,   \n         headerno = max(dbo.saleledger.headerno),   \n         date = dbo.saleledger.date,   \n         invdiscperc = dbo.saleledger.discperc,   \n         misccharges = dbo.saleledger.misccharges,   \n         flatdisc = dbo.saleledger.flatdisc,   \n         invsalestax = dbo.saleledger.salestax,   \n         gcode = saledetail.gcode,   \n         icode = saledetail.icode,   \n         batch = max(saledetail.batch),   \n         expiry = min(saledetail.expiry),   \n         looseqty = sum(saledetail.looseqty),   \n         bonusqty = sum(saledetail.bonusqty),   \n         packqty = sum(saledetail.packqty),   \n         packunits=max( saledetail.packunits),   \n         saleprice= max(saledetail.saleprice),   \n         discperc = max(saledetail.discperc),  \n\t\t\titemflatdisc=max(saledetail.itemflatdisc),   \n         salestax = max(saledetail.salestax),   \n         Id = max(dbo.saledetail.IDENTITYCOL),   \n         posted=max(saleledger.posted),   \n         balance=0,   \n         unitsalestax =max( saledetail.unitsalestax),   \n         gstperc = max(saledetail.gstperc),   \n         invgstperc =max( saleledger.invgstperc1),   \n         custTaxRegno=max(customer.salestaxregno)  ,\n\t\t\tdbo.saleledger.custrefno,\t\n\t\t\tdbo.saleledger.remarks,\n\t\t\tprintwaranty=max(dbo.saleledger.printwaranty),\n\t\t\tprintbatch=max(dbo.saleledger.printbatch),\n\t\t\treprintcount=max(saleledger.Reprintingcounter),\n\t\t\tserverdate=getdate(),\n\t\t\tcustcode=dbo.saleledger.custcode,\n\t\t\tsalesperson=(select name from salesman where salesmancode=max(saleledger.smancode)),\n\t\t\tmessages=(select description from message where messagecode=max(saleledger.messagecode))\n\n    FROM saleledger,   \n         saledetail,   \n         accounts,   \n         customer,   \n         users,   \n         item  \n\n   WHERE ( dbo.saleledger.saleinvcode = :ar_SaleInvCode ) AND  \n         ( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND  \n         ( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  \n         ( dbo.customer.custcode = dbo.accounts.acccode ) AND  \n         ( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  \n         ( dbo.saledetail.icode = dbo.item.icode)    \nGROUP BY saleledger.saleinvcode, \n\t\t\tsaleledger.date, \n\t\t\t/*saleledger.headerno,*/\n\t\t\tsaleledger.custcode, \n\t\t\tsaleledger.discperc, \n\t\t\tsaleledger.flatdisc, \n\t\t\tsaleledger.misccharges, \n\t\t\tsaleledger.salestax, \n\t\t\tsaleledger.remarks,\n\t\t\tsaleledger.custrefno, \n\t\t\tsaledetail.icode,\n\t\t\tsaledetail.rowgroup, \n\t\t\tsaledetail.gcode, \n\t\t\titem.name,\n\t\t\titem.customicode,\n\t\t\titem.icode,\n\t\t\titem.icatcode,\n\t\t\titem.printable, \n\t\t\taccounts.name,\n\t\t\tdbo.users.username\n\nORDER BY \t\n\t\t\tdbo.saledetail.saleinvcode,\n\t\t\tid\n\t\t\t\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_SaleInvCode",
      "number"
     ]
    }
   ]
  }
 },
