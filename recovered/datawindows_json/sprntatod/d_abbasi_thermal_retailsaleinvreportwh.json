  "retrieve": "    SELECT\n\t\t\ttranstype='S', \n\t\t\titemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, \n\t\t\tusers.username, \n\t\t\tsalecat=max(saleledger.salecatcode),\n\t\t\tsaleledger.custcode,\n\t\t\theaderno = dbo.saleledger.headerno,\n\t\t\tcustomer=(select name from accounts where acccode=saleledger.custcode),\n\t\t\tdbo.saleledger.saleinvcode, \n         dbo.saleledger.date,   \n         dbo.saleledger.discperc,   \n         dbo.saleledger.misccharges,   \n         dbo.saleledger.flatdisc,   \n         dbo.saleledger.salestax,   \n         dbo.saleledger.custcode,   \n         dbo.saleledger.remarks,   \n         dbo.saledetail.icode,   \n         dbo.saledetail.gcode, \n         cashreceived=max(dbo.saleledger.cashreceived),\n\t\t\tId        = MAX(dbo.saledetail.IDENTITYCOL),  \n         looseqty  = sum(saledetail.looseqty), \n\t\t\tpackqty   = sum(saledetail.packqty), \n\t\t\tpackunits = max(saledetail.packunits), \n\t \t\tsaleprice = max(saledetail.saleprice), \n\t \t\trate      = max(saledetail.rate),\n         salestax  = max(saledetail.salestax),   \n         discperc  = max(saledetail.discperc), \n\t\t\tcustomername='                                  '  ,\n\t\t\titemflatdisc  = max(saledetail.itemflatdisc),\n\t\t\taliasname=item.customicode,\n\t\t\tmachinename=',' +  max(saleledger.machinename),\n\t\t\tinvtotal = saleledger.invtotal,\n\t\t\tsrinvtotal = 0\n\n    FROM dbo.saleledger,   \n         dbo.saledetail,  \n         item,\n\t\t\tUsers \n\n   WHERE ( dbo.saleledger.saleinvcode = :ra_InvCode ) AND\n\t\t\t( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND \n\t\t\t( saleLedger.SalesManCode = users.userCode ) and\n\t\t\t( saledetail.icode = item.icode )\n\n\nGROUP BY saleledger.saleinvcode, \n\t\t\tsaleledger.date, \n\t\t\tsaleledger.custcode, \n\t\t\tsaleledger.discperc, \n\t\t\tsaleledger.flatdisc, \n\t\t\tsaleledger.misccharges, \n\t\t\tsaleledger.headerno,\n\t\t\tsaleledger.salestax, \n\t\t\tsaleledger.remarks, \n\t\t\tsaledetail.icode, \n\t\t\tsaledetail.rowgroup,\n\t\t\tsaledetail.gcode, \n\t\t\titem.name,\n\t\t\titem.icode,\n\t\t\titem.printable,\n\t\t\titem.customicode,\n\t\t\tusers.username,\n\t\t\tsaleledger.invtotal\nUNION ALL\nSELECT\n\t\t\ttranstype='R',\n\t\t\titemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, \n\t\t\tusers.username, \n\t\t\tsalecat=max(srl.srcatcode),\n\t\t\tsrl.custcode,\n\t\t\theaderno = srl.headerno,\n\t\t\tcustomer=(select name from accounts where acccode=srl.custcode),\n\t\t\tsaleinvcode=srl.srbufferinvcode, \n         srl.date,   \n         srl.discperc,   \n         srl.misccharges,   \n         srl.flatdisc,   \n         srl.salestax,   \n         srl.custcode,   \n         srl.remarks,   \n         srd.icode,   \n         srd.gcode, \n         cashreceived=max(sl.cashreceived),\n\t\t\tId        = MAX(srd.IDENTITYCOL),  \n         looseqty  = sum(srd.looseqty), \n\t\t\tpackqty   = 0, \n\t\t\tpackunits = max(srd.packunits), \n\t \t\tsaleprice = max(srd.srprice), \n\t \t\trate      = max(srd.srprice),\n         salestax  = max(srd.salestax),   \n         discperc  = max(srd.discperc), \n\t\t\tcustomername='                                  '  ,\n\t\t\titemflatdisc  = 0,\n\t\t\taliasname=item.customicode,\n\t\t\tmachinename=',' +  max(srl.machinename),\n\t\t\tinvtotal = 0,\n\t\t\tsrinvtotal = srl.invtotal\n\n    FROM dbo.saleledger sl, \n\t\t\tdbo.srbufferledger srl,   \n         dbo.srbufferdetail srd,  \n         item,\n\t\t\tUsers \n\n   WHERE ( sl.saleinvcode = :ra_InvCode ) AND\n\t\t\t( srl.srbufferinvcode = sl.srbufferinvcode ) AND\n\t\t\t( srl.srbufferinvcode = srd.srbufferinvcode ) AND \n\t\t\t( srl.SalesManCode = users.userCode ) and\n\t\t\t( srd.icode = item.icode )\n\n\nGROUP BY srl.srbufferinvcode, \n\t\t\tsrl.date, \n\t\t\tsrl.custcode, \n\t\t\tsrl.discperc, \n\t\t\tsrl.flatdisc, \n\t\t\tsrl.misccharges, \n\t\t\tsrl.headerno,\n\t\t\tsrl.salestax, \n\t\t\tsrl.remarks, \n\t\t\tsrd.icode, \n\t\t\tsrd.gcode, \n\t\t\titem.name,\n\t\t\titem.icode,\n\t\t\titem.printable,\n\t\t\titem.customicode,\n\t\t\tusers.username,\n\t\t\tsrl.invtotal\nORDER BY transtype, id\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  },
  "sort": "id A"
 },
