  "retrieve": "SELECT \n\tsrledger.srinvcode ,\n\tsrledger.saleinvcode ,\n\tsrledger.date ,\n\tsrledger.srcatcode ,\n\tsrledger.custcode ,\n\tsrledger.salesmancode ,\n\tsrledger.discperc ,\n\tsrledger.flatdisc ,\n\tsrledger.misccharges ,\n\tusers.username ,\n\tsrledger.headerno ,\n\tsrledger.posted ,\n\tsrledger.postdate ,\n\tsrledger.remarks ,\n\taccounts.name ,\n\tcustomer.address1 ,\n\tcustomer.city ,\n\tcustomer.phone,\n\tsrledger.originaldate,\n\tsrledger.modifiedby,\n\tsrledger.postedby,\n\tsrledger.invgstperc1,\n\tsrledger.smancode,\n\tsrledger.custrefno,\n\tsrledger.custrefno2,\n\tsrledger.custrefno3,\n\tsrledger.custrefno4 ,\n\tsrledger.patientcode,\n\tsrledger.machinename,\n\tgcode=0,\n\tsrledger.headerinvno,\n\tregno=patient.regno,\n\taliasname=accounts.aliasname,\n\tsrledger.admissioncode,\n\tsrledger.doctcode,\n\tpatientadmission.locationcode,\n\tsrledger.CashAccCode,\n\tsrledger.CashTendered,\n\tsrledger.CashCharged,\n\tsrledger.CashBack\n\nFROM accounts ,\n  customer ,\n  users ,\n  srledger,\n  patientadmission,\n  patient\nWHERE \n\t( dbo.srledger.srinvcode = :ra_saleretinvcode ) and\n\t( dbo.srledger.admissioncode IS NOT NULL ) and\n\t( dbo.srledger.admissioncode = patientadmission.admissioncode ) and\n\t( patientadmission.patientcode = patient.patientcode ) and\n\t( srledger.custcode = customer.custcode ) and \n\t( customer.custcode = accounts.acccode ) AND\n\t( srledger.salesmancode = users.usercode )\n",
  "update": "srledger",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_saleretinvcode",
      "number"
     ]
    }
   ]
  }
 },
