  "retrieve": "SELECT\n\tsrbufferledger.saleinvcode ,\n\tsrbufferledger.srbufferinvcode ,\n\tsrbufferledger.date ,\n\tsrbufferledger.srcatcode ,\n\taliasname='            ',\n\tsrbufferledger.custcode ,\n\tsrbufferledger.salesmancode ,\n\tsrbufferledger.discperc ,\n\tsrbufferledger.flatdisc ,\n\tsrbufferledger.invgstperc1,\n\tsrbufferledger.misccharges , \n\tusers.username , \n\tsrbufferledger.posted ,\n\tsrbufferledger.originaldate ,\n\tsrbufferledger.postdate ,\n\tsrbufferledger.remarks ,\n\tsrbufferledger.modifiedby ,\n\tsrbufferledger.postedby ,\n\tcustomer.address1 ,\n\tcustomer.city ,\n\tcustomer.phone,\n\tsrbufferledger.smancode,\n\tsrbufferledger.custrefno,\n\tsrbufferledger.custrefno2,\n\tsrbufferledger.custrefno3,\n\tsrbufferledger.custrefno4,\n\tpatientRegno='           ',\n\tsrbufferledger.patientcode,\n\tsrbufferledger.invtotal,\n\tsrbufferledger.machinename,\n\tgcode=0,\n\tsrbufferledger.headerno,\n\tsrbufferledger.headerinvno,\n\tsrbufferledger.admissioncode,\n\tsrbufferledger.AccountFor,\n\tsrbufferledger.PaymentMode,\n\tsrbufferledger.PaymentAccCode,\n\tsrbufferledger.Amt,\n\tsrbufferledger.AmtBy,\n\tsrbufferledger.AmtDate,\n\tsrbufferledger.AmtReference,\n\tsrbufferledger.Outstandingamt,\n\tsrbufferledger.marked,\n\tsrbufferledger.PageSize\nFROM\n\tcustomer ,\n\taccounts,\n\tusers ,\n\tsrbufferledger\n\tLEFT OUTER JOIN SalesMan ON (srbufferledger.smancode = salesman.salesmancode)\nWHERE\n\t( srbufferledger.custcode = customer.custcode ) and       \n\t( srbufferledger.custcode = accounts.acccode ) and    \n\t( srbufferledger.salesmancode = users.usercode ) and\n\t( dbo.srbufferledger.srbufferinvcode = :ra_saleretinvcode )",
  "update": "srbufferledger",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
