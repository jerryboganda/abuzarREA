  "retrieve": "SELECT \n\titem.customicode, \n\tcurrlistrow = 0,\n\tsrdetail.icode, \n\titem.name,\n\tsrdetail.batch, \n\tsrdetail.expiry, \n\tsrdetail.avgprice,   \n\tsrdetail.srinvcode,    \n\tsrdetail.gcode,    \n\tsrdetail.packqty, \n\tsrdetail.packunits, \n\tsrdetail.srprice, \n\tsrdetail.salestax, \n\tstock = 0.0000,\n\ttotalstock = 0.0000, \n\tretableqty = 0.0000, \n\tsaleqty =0.0000, \n\tretablebonusqty = 0.0000, \n\tsalebonusqty =0.0000, \n\tsrdetail.discperc,\n\tsrdetail.SrUtn,\n\tsrdetail.unitsalestax,\n\tsrdetail.gstperc,\n\tsrdetail.saleprice,\n\tbonusqty=srdetail.bonusqty,\n\tsrdetail.looseqty\nFROM \n\tsrdetail,   \n\titem  \nWHERE \n\t(srdetail.icode = item.icode) AND \n\t(dbo.srdetail.srinvcode = :ra_salesretinvno)",
