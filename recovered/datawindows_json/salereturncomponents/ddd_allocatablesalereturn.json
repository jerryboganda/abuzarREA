    "dbname": "InvTotal"
   }
  ],
  "retrieve": "SELECT \n\tSRInvCode,\n\tSaleInvCode,   \n\tDate,   \n\tCustCode,   \n\tCustomer,\n\tAliasName,\n\tOutstandingAmt,\n\tSRCatCode,\n\tInvTotal\nFROM \n\t(SELECT \n\t\tSRLedger.SRInvCode,   \n\t\tSRLedger.SaleInvCode,   \n\t\tSRLedger.Date,   \n\t\tSRLedger.CustCode,   \n\t\tCustomer=Accounts.Name,\n\t\tAliasName=Accounts.AliasName,\n\t\tOutstandingAmt = SRLedger.OutstandingAmt + \n\t\t\tISNULL((SELECT SRAllocationHeader.SRInvCode FROM SRAllocationHeader \n\t\t\t\tWHERE SRAllocationHeader.SRAllocationCode = :Code AND \n\t\t\t\t\tSRAllocationHeader.SRInvCode = SRLedger.SRInvCode), 0),\n\t\tSRLedger.SRCatCode,\n\t\tSRLedger.InvTotal\n\t\n\tFROM \n\t\tSRLedger, Accounts\n\tWHERE\n\t\tSRLedger.AccountFor = 'Y' AND\n\t\tSRLedger.Marked = 'N' AND\n\t\tSRLedger.Posted ='Y' AND\n\t\tSRLedger.SRCatCode IN (7) AND\n\t\tSRLedger.CustCode = Accounts.AccCode) SR\nWHERE \n\tOutstandingAmt > 0\nORDER BY\n\tDate,   \n\tSRInvCode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "code",
      "number"
     ]
    }
   ]
  }
 },
