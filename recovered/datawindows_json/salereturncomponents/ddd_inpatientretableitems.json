  "retrieve": "SELECT \n\tcustomicode, \n\tname, \n\titem,\n\ticode,\n\tpackingdesc,\n\tmanufacturer=(SELECT m.Name FROM Manufacturer M WHERE M.ManfCode = TMP.ManfCode),\n\titemalertcode,\n\titemalerttypecode,\n\tbatch, \n\texpiry, \n\tsaleprice=max(saleprice), \n\tdiscperc=discperc,\n\tLooseQty=SUM(looseqty), \n\tBonusQty=SUM(Bonusqty), \n\tpackunits, \n\tReturnQty=SUM(ReturnQty), \n\tReturnBonusQty=SUM(ReturnBonusQty),\n\tunitsalestax,\n\tgstperc,\n\ttransitstock\nFROM \n\t(SELECT\n\t\ti.name, \n\t\titem=i.name + str(i.icode), \n\t\ti.icode,\n\t\ti.customicode,\n\t\ti.packingdesc,\n\t\ti.manfcode,\n\t\ti.itemalertcode,\n\t\titemalerttypecode = (select ia.itemalerttypecode from itemalert ia where ia.itemalertcode = i.itemalertcode),\n\t\ti.transitstock,\n\t\tsd.gcode,\n\t\tsd.batch,\n\t\tsd.expiry,\n\t\tsd.saleprice,\n\t\tsd.discperc,\n\t\tlooseqty=IsNull(sum(sd.looseqty), 0),\n\t\tbonusqty=IsNull(sum(sd.bonusqty), 0),\n\t\tsd.packunits,\n\t\tunitsalestax=sd.unitsalestax,\n\t\tgstperc=sd.gstperc,\n\t\tReturnQty = 0,\n\t\tReturnBonusQty = 0\n\t\n\tFROM\n\t\tdbo.item i, \n\t\tdbo.saledetail sd,\n\t\tdbo.saleledger sl\n\tWHERE\n\t\t( sl.admissioncode = :ar_AdmissionCode ) and\n\t\t( sl.saleinvcode = sd.saleinvcode ) and\n\t\t( sl.posted = 'Y' ) AND\n\t\t( i.icode = sd.icode ) and\n\t\t( sd.due IS NULL )\n\tGROUP BY\n\t\ti.name, \n\t\ti.icode,\n\t\ti.customicode,\n\t\ti.packingdesc,\n\t\ti.manfcode,\n\t\ti.itemalertcode,\n\t\ti.transitstock,\n\t\tsd.gcode,\n\t\tsd.batch,\n\t\tsd.expiry,\n\t\tsd.saleprice,\n\t\tsd.discperc,\n\t\tsd.packunits,\n\t\tsd.unitsalestax,\n\t\tsd.gstperc\n\tUNION ALL\n\tSELECT\n\t\ti.name, \n\t\titem=i.name + str(i.icode), \n\t\ti.icode,\n\t\ti.customicode,\n\t\ti.packingdesc,\n\t\ti.manfcode,\n\t\ti.itemalertcode,\n\t\titemalerttypecode = (select ia.itemalerttypecode from itemalert ia where ia.itemalertcode = i.itemalertcode),\n\t\ti.transitstock,\n\t\tsd.gcode,\n\t\tsd.batch,\n\t\tsd.expiry,\n\t\tsaleprice=sd.srprice,\n\t\tsd.discperc,\n\t\tlooseqty=0,\n\t\tbonusqty=0,\n\t\tsd.packunits,\n\t\tunitsalestax=sd.unitsalestax,\n\t\tgstperc=sd.gstperc,\n\t\tReturnQty = IsNull(Sum(sd.looseqty), 0),\n\t\tReturnBonusQty = IsNull(Sum(sd.bonusqty), 0)\n\tFROM\n\t\tdbo.item i, \n\t\tdbo.srdetail sd,\n\t\tdbo.srledger sl\n\tWHERE\n\t\t( sl.admissioncode = :ar_AdmissionCode ) and\n\t\t( sl.srinvcode = sd.srinvcode ) and\n\t\t( i.icode = sd.icode )\n\tGROUP BY\n\t\ti.name, \n\t\ti.icode,\n\t\ti.customicode,\n\t\ti.packingdesc,\n\t\ti.manfcode,\n\t\ti.itemalertcode,\n\t\ti.transitstock,\n\t\tsd.gcode,\n\t\tsd.batch,\n\t\tsd.expiry,\n\t\tsd.srprice,\n\t\tsd.discperc,\n\t\tsd.packunits,\n\t\tsd.unitsalestax,\n\t\tsd.gstperc\n\tUNION ALL\n\tSELECT\n\t\ti.name, \n\t\titem=i.name + str(i.icode), \n\t\ti.icode,\n\t\tmax(i.customicode),\n\t\ti.packingdesc,\n\t\ti.manfcode,\n\t\ti.itemalertcode,\n\t\titemalerttypecode = (select ia.itemalerttypecode from itemalert ia where ia.itemalertcode = i.itemalertcode),\n\t\ti.transitstock,\n\t\tdsd.gcode,\n\t\tdsd.batch,\n\t\tdsd.expiry,\n\t\tsd.saleprice,\n\t\tsd.discperc,\n\t\tlooseqty = ISNULL(sum(dsd.duesatisfyqty), 0),\n\t\tBonusqty=0,\n\t\tsd.packunits,\n\t\tunitsalestax=sd.unitsalestax,\n\t\tgstperc=sd.gstperc,\n\t\tReturnQty = 0,\n\t\tReturnBonusQty=0\n\t\n\tFROM \n\t\tdbo.item i,   \n\t\tdbo.saleledger sl,\n\t\tdbo.saledetail sd,\n\t\tdbo.duesatisfydetail dsd,\n\t\tdbo.Duesatisfyheader dsh\n\t\n\tWHERE\n\t\t( sl.admissioncode = :ar_admissioncode ) and\n\t\t( sl.saleinvcode = sd.saleinvcode ) and\n\t\t( sd.due in ('S', 'D', 'X') ) and\n\t\t( dsh.saleinvcode = sd.saleinvcode ) and\n\t\t( dsh.duesatisfycode = dsd.duesatisfycode) and\n\t\t( i.icode = dsd.icode ) and\n\t\t( sd.icode = dsd.icode)\n\t\n\tGROUP BY\n\t\ti.icode,\n\t\ti.name,\n\t\tdsd.icode,\n\t\ti.packingdesc,\n\t\ti.manfcode,\n\t\ti.itemalertcode,\n\t\ti.transitstock,\n\t\tdsd.gcode,\n\t\tdsd.batch,\n\t\tdsd.expiry,\n\t\tdsh.saleinvcode,\n\t\tsd.saleprice,\n\t\tsd.discperc,\n\t\tsd.packunits,\n\t\tsd.unitsalestax,\n\t\tsd.gstperc) AS TMP\n\nGROUP BY \n\ticode, \n\tname, \n\titem,\n\tcustomicode, \n\tpackingdesc,\n\tmanfcode,\n\titemalertcode,\n\titemalerttypecode,\n\tbatch, \n\texpiry, \n\tdiscperc, \n\tpackunits, \n\tunitsalestax,\n\tgstperc,\n\ttransitstock\n\nHAVING \n\tSUM(looseqty) - SUM(ReturnQty) > 0 OR\n\tSUM(Bonusqty) - SUM(ReturnBonusQty) > 0\n\nORDER BY\n\tname, \n\texpiry,\n\tbatch ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_AdmissionCode",
      "number"
     ]
    }
   ]
  }
 },
