    "dbname": "ModifiedBy"
   }
  ],
  "retrieve": "SELECT\n\tsrledger.srinvcode , \n\taccounts.name , \n\tsrledger.date,     \n\tposted = srledger.posted,\n\tregno= patient.regno,\n\tpatient=patient.name,\n\tsrledger.admissioncode,\n\tPostedBy = IsNull((Select username from users \n\t\t\t\t\twhere dbo.srledger.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\t\t\t\twhere dbo.srledger.modifiedby = dbo.users.usercode), '')  \nFROM  srledger, \n\t accounts,\n\t patientadmission,\n\t patient\n\t\t\t\nWHERE ( dbo.srledger.admissioncode IS NOT NULL ) and\n\t( dbo.srledger.srcatcode = 7 ) and\n\t( dbo.srledger.saleinvcode IS NULL) and \n\t( srledger.custcode = accounts.acccode ) and \n\t( srledger.Posted IN (:as_Posted)) AND\n\t( dbo.srledger.HeaderNo IS NULL OR\n\t\t( dbo.srledger.HeaderNo IN \n\t\t\t(SELECT HeaderCode FROM GroupAllowedHeader \n\t\t\tWHERE GroupCode = :ai_GroupCode AND Module=:ai_Module)))  and\n\t( dbo.srledger.admissioncode = dbo.patientadmission.admissioncode ) and\n\t( dbo.patientadmission.patientcode = patient.patientcode )",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_srCatCode",
      "number"
     ]
    },
    {
     "_items": [
      "as_Posted",
      "stringlist"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_module",
      "number"
     ]
    }
   ]
  }
 },
