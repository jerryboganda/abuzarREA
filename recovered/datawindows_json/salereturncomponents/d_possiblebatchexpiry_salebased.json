  ],
  "retrieve": "SELECT DISTINCT  \n\tSD.Batch, SD.Expiry, Qty = SUM(SD.LooseQty), InvCode=S.SaleInvCode, S.Date, RefNo=S.CustRefNo, RefDate=GETDATE()\nFROM  \n\tSaleDetail SD, SaleLedger S\nWHERE\n\tS.CustCode = :ar_custcode AND \n\tSD.ICode = :ar_icode AND \n\tSD.SaleInvCode = S.SaleInvCode AND \n\tS.Posted = 'Y'\nGROUP BY\n\tS.CustCode,\n\tS.SaleInvCode, \n\tS.CustRefNo,\n\tS.Date,\n\tSD.ICode,\t\n\tSD.Batch, \n\tSD.Expiry\nORDER BY\n\tBatch, Expiry",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_custcode",
      "number"
     ]
    },
    {
     "_items": [
      "ar_icode",
      "number"
     ]
    }
   ]
  }
 },
