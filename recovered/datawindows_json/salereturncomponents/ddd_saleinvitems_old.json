  "retrieve": "SELECT \n\tname, compute_0002, icode, customicode, gcode, batch, expiry, saleprice, discperc,\n\tSUM(looseqty) AS LooseQty, packunits, ReturnQty\nFROM\n  (SELECT dbo.item.name, \n\tdbo.item.name + space(70) + str(dbo.item.icode) as compute_0002, \n\tdbo.item.icode,\n\tdbo.item.customicode,\n\tdbo.saledetail.gcode,\n\tdbo.saledetail.batch,\n\tdbo.saledetail.expiry,\n\tdbo.saledetail.saleprice,\n\tdbo.saledetail.discperc,\n\tdbo.saledetail.looseqty,\n\tdbo.saledetail.packunits,\n\tReturnQty = (SELECT IsNull(Sum(srdetail.looseqty), 0)\n\t\t\tFROM   \tsrledger, srdetail\n\t\t\tWHERE  \tsrledger.saleinvcode = saledetail.SaleInvCode    and\n\t\t\t\tsrledger.posted      = 'Y'                and\n\t\t\t\tsrledger.srinvcode   = srdetail.SRInvCode and\n\t\t\t\tsrdetail.gcode       = saledetail.GCode and\n\t\t\t\tsrdetail.icode       = item.ICode and\n\t\t\t\tsrdetail.batch       = saledetail.Batch and\n\t\t\t\tsrdetail.expiry      = saledetail.Expiry) \n\t\n    FROM dbo.item,   \n\t dbo.saledetail\t\n\n    WHERE ( saledetail.saleinvcode = :ar_SaleInvCode )and\n\t\t\t( item.icode = saledetail.icode ) and\n\t\t\t( saledetail.due IN (NULL))\n\nUNION ALL\n\nSELECT dbo.item.name, \n\tdbo.item.name + space(70) + str(dbo.item.icode) as compute_0002, \n\tdbo.item.icode,\n\tmax(dbo.item.customicode),\n\tdbo.Duesatisfydetail.gcode,\n\tdbo.Duesatisfydetail.batch,\n\tdbo.Duesatisfydetail.expiry,\n\tdbo.saledetail.saleprice,\n\tdbo.saledetail.discperc,\n\tlooseqty = sum(dbo.Duesatisfydetail.duesatisfyqty),\n\tdbo.saledetail.packunits,\n\tReturnQty = (SELECT IsNull(Sum(srdetail.looseqty), 0)\n\t\t\tFROM   \tsrledger, srdetail\n\t\t\tWHERE  \tsrledger.saleinvcode = Duesatisfyheader.SaleInvCode    and\n\t\t\t\tsrledger.posted      = 'Y'                and\n\t\t\t\tsrledger.srinvcode   = srdetail.SRInvCode and\n\t\t\t\tsrdetail.gcode       = Duesatisfydetail.GCode and\n\t\t\t\tsrdetail.icode       = Duesatisfydetail.ICode and\n\t\t\t\tsrdetail.batch       = Duesatisfydetail.Batch and\n\t\t\t\tsrdetail.expiry      = Duesatisfydetail.Expiry) \n\n    FROM dbo.item,   \n\tdbo.saledetail,\n\tdbo.duesatisfydetail,\n\tdbo.Duesatisfyheader\n\t\t\t\n\n   WHERE ( saledetail.saleinvcode = :ar_SaleInvCode)and\n\t\t\t( dbo.Duesatisfyheader.saleinvcode = :ar_SaleInvCode) and\n\t\t\t( dbo.Duesatisfyheader.duesatisfycode = dbo.duesatisfydetail.duesatisfycode) and\n\t\t\t( item.icode = dbo.duesatisfydetail.icode ) and\n\t\t\t( saledetail.gcode = dbo.duesatisfydetail.gcode) and\n\t\t\t( saledetail.icode = dbo.duesatisfydetail.icode) and \n\t\t\t( saledetail.due in ('S', 'D', 'X') )\n\nGROUP BY item.icode,\n\t dbo.item.name,\n\tduesatisfydetail.icode,\n\tduesatisfydetail.gcode,\n\tduesatisfydetail.batch,\n\tduesatisfydetail.expiry,\n\tduesatisfyheader.saleinvcode,\n\tdbo.saledetail.saleprice,\n\tdbo.saledetail.discperc,\n\tdbo.saledetail.packunits) AS TMP\n\n  GROUP BY icode, name, compute_0002, customicode, gcode, batch, expiry, saleprice, discperc, packunits, ReturnQty\nORDER BY name, \n\t\t\texpiry,\n\t\t\tbatch ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_SaleInvCode",
      "number"
     ]
    }
   ]
  }
 },
