  "retrieve": "SELECT\n\tdbo.item.name,\n\tdbo.item.name + space(70) + str(dbo.item.icode), \n\tdbo.item.icode, \n\tdbo.item.customicode,\n\tdbo.saledetail.gcode,\n\tdbo.saledetail.batch,\n\tdbo.saledetail.expiry,\n\tdbo.saledetail.saleprice,\n\tdbo.saledetail.discperc,\n\tdbo.saledetail.claimable,\n\tdbo.saledetail.claimablediscperc,\n\tdbo.saledetail.looseqty,\n\tdbo.saledetail.packunits,\n\tReturnQty = (SELECT IsNull(Sum(srdetail.looseqty), 0)\n\t\t\t\t\tFROM   \tsrledger, srdetail\n\t\t\t\t\tWHERE  \tsrledger.saleinvcode = saledetail.SaleInvCode    and\n\t\t\t\t\t\t\t\tsrledger.posted      = 'Y'                and\n\t\t\t\t\t\t\t\tsrledger.srinvcode   = srdetail.SRInvCode and\n\t\t\t\t\t\t\t\tsrdetail.gcode       = saledetail.GCode and\n\t\t\t\t\t\t\t\tsrdetail.icode       = item.ICode and\n\t\t\t\t\t\t\t\tsrdetail.batch       = saledetail.Batch and\n\t\t\t\t\t\t\t\tsrdetail.expiry      = saledetail.Expiry) \n\nFROM \n\tdbo.item,   \n\tdbo.saledetail\t\n\nWHERE \n\t( saledetail.saleinvcode = :ar_SaleInvCode )and\n\t( item.icode = saledetail.icode ) and\n\t( saledetail.due IS NULL OR saledetail.due = 's')\nORDER BY \n\tdbo.item.name, \n\tdbo.saledetail.expiry,\n\tdbo.saledetail.batch\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_SaleInvCode",
      "number"
     ]
    }
   ]
  }
 },
