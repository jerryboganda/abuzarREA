  "retrieve": "SELECT\n\tSRAllocationHeader.SRAllocationCode,   \n\tSRAllocationHeader.Date,   \n\tSRAllocationHeader.SRInvCode,   \n\tReturnType=SRLedger.SRCatCode,\n\tReturnDate=SRLedger.Date, \n\tReturnAmt=SRLedger.InvTotal,\n\tReturnOutstanding=SRLedger.OutStandingAmt,\n\tSRLedger.SaleInvCode, \n\tSRLedger.CustCode,\n\tAccounts.AliasName, \n\tAccounts.Name,\n\tSRAllocationHeader.UserCode,\n\tSRAllocationHeader.Modified, \n\tSRAllocationHeader.ModifiedBy,\n\tSRAllocationHeader.Posted, \n\tSRAllocationHeader.PostedBy,\n\tSRAllocationHeader.PostDate\nFROM \n\tSRAllocationHeader, SRLedger, Accounts, Customer\nWHERE\n\tSRAllocationHeader.SRAllocationCode = :code AND\n\tSRAllocationHeader.SRInvCode = SRLedger.SRInvCode AND\n\tSRLedger.CustCode = Customer.CustCode AND\n\tCustomer.CustCode = Accounts.AccCode\n\n",
  "update": "SRAllocationHeader",
