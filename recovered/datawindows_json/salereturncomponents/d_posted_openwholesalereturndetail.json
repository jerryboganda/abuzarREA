  "retrieve": "SELECT \n\titem.customicode,\n\titem.name, \n\tsrdetail.returnitemdescription,  \n\tcurrlistrow = 0,\n\tstock = 0.0000, \n\tpackingdesc=space(50),\n\ttotalstock=0.0000,\n\tsaleqty = 0.0000, \n\tretableqty = 0.0000, \n\tretablebonusqty = 0.0000, \n\tsalebonusqty = 0.0000, \n\tdbo.srdetail.srinvcode ,\n\tdbo.srdetail.gcode , \n\tdbo.srdetail.icode , \n\tdbo.srdetail.batch , \n\tdbo.srdetail.expiry , \n\tdbo.srdetail.packqty ,\n\tdbo.srdetail.unitsalestax,\n\tdbo.srdetail.gstperc,  \n\tdbo.srdetail.packunits ,  \n\tdbo.srdetail.srprice ,\n\tdbo.srdetail.srutn ,\n\tdbo.srdetail.saleprice,\n\tdbo.srdetail.avgprice ,\n\tdbo.srdetail.salestax ,\n\tdbo.srdetail.discperc ,\n\tdbo.srdetail.TotalPieces,\n\tdbo.srdetail.PiecesInHand,\n\tbonusqty=dbo.srdetail.bonusqty,\n\tdbo.srdetail.looseqty\nFROM\n\tsrdetail,   \n\titem \nWHERE \n\t( srdetail.icode = item.icode ) and  \n\t( dbo.srdetail.srinvcode = :ra_salesretinvno )\n\n\t\n",
  "update": "srdetail",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_salesretinvno",
      "number"
     ]
    }
   ]
  }
