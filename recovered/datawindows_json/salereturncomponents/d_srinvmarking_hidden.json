  "retrieve": "SELECT \n\tSrLedger.SrInvCode,\n\tSrLedger.Date,\n\tSrLedger.CustCode,\n\tAccounts.Name,\n\tAccounts.AliasName,\n\tSrLedger.OutstandingAmt,\n\tSrLedger.InvTotal,\n\tSrLedger.Posted,\n\tOldMarked=SrLedger.Marked,\n\tSrLedger.AccountFor,\n\tSrLedger.Marked\nFROM \n\tSrLedger, Accounts\nWHERE\n\tSrLedger.SrInvCode IN (:ai_invoices) AND\n\tSrLedger.AccountFor = 'Y' AND\n\tSrLedger.Posted ='Y' AND\n\tSrLedger.CustCode = Accounts.AccCode",
