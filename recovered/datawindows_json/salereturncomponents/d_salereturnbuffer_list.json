  "retrieve": "SELECT  \n\tsrbufferledger.srbufferinvcode , \n\tsrbufferledger.saleinvcode , \n\taccounts.name ,  \n\tsrbufferledger.date, \n\tinvtotal=srbufferledger.invtotal,\n\tsalevalue=(select sum(((SRD.looseqty + SRD.bonusqty)*SRD.saleprice))\n\t\t\t\t  from srbufferdetail SRD\n\t\t\t\t  where SRD.srbufferinvcode=srbufferledger.srbufferinvcode),\n\t\n\tposted = srbufferledger.posted,\n\tPostedBy = IsNull((Select username from users \n\t\t\t\t\twhere dbo.srbufferledger.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\t\t\t\twhere dbo.srbufferledger.modifiedby = dbo.users.usercode), ''),\n\tHeaderNo=srbufferledger.HeaderNo,\n\tHeaderInvNo=srbufferledger.HeaderInvNo,\n\tRetViaBillSummary=srbufferledger.RetViaBillSummary\nFROM  \n\tsrbufferledger ,\n\taccounts \nWHERE \n\t( srbufferledger.custcode = accounts.acccode ) and \n\t( srbufferledger.Posted IN (:as_Posted)) AND\n\t( dbo.srbufferledger.HeaderNo IS NULL OR\n\t\t( dbo.srbufferledger.HeaderNo IN \n\t\t\t(SELECT HeaderCode FROM GroupAllowedHeader \n\t\t\tWHERE GroupCode = :ai_GroupCode AND Module=:ai_Module)))\n",
  "arguments": {
   "_items": [
