  "retrieve": "SELECT   itemname= itemclass.name\t+' ' +itemcategory.name+' ' +itempacking.name+' '+manufacturer.name, \n\t\t\tdbo.theader.sgcode,\n\t\t\tdbo.theader.transcode,\n         dbo.theader.dgcode,\n         dbo.theader.date, \n         dbo.tdetail.icode,\n         dbo.tdetail.qty,\n\t\t\tstqty = store.currqty,\n\t\t\tgqty = godown.currqty\n \nFROM \t\tdbo.theader, \n         dbo.tdetail,\n\t\t\tdbo.godowndetail as store,\n\t\t\tdbo.godowndetail as godown,\n         item ,\n\t\t\titemclass,\n\t\t\titemcategory,\n\t\t\titempacking,\n\t\t\tmanufacturer     \n\nWHERE \t( dbo.tdetail.transcode = dbo.theader.transcode ) and \n         ( tdetail.icode = item.icode ) and  \n\t\t\t( store.gcode = 3) and\n\t\t\t( store.icode = item.icode) and\n\t\t\t( godown.gcode = item.gcode) and\n\t\t\t( godown.icode = item.icode) and\n\t\t\t( item.iccode = itemclass.iccode ) and  \n\t\t\t(( item.icatcode = itemcategory.icatcode ) and  \n         ( item.packcode = itempacking.packcode ) and  \n         ( item.manfcode = manufacturer.manfcode )) and\n         ( ( dbo.theader.transcode = :ar_transcode ) )\n\nOrder by item.manfcode,\n\t\t\titem.packcode,\n\t\t   item.icatcode,\n\t\t\titem.iccode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_transcode",
      "number"
     ]
    }
   ]
  }
 },
