  "retrieve": "SELECT\n\tRecipe.RecipeCode,   \n\tRecipe.AliasName,   \n\tRecipe.Name,   \n\tRecipe.Description,   \n\tRecipe.ResultedItem,   \n\tRecipe.UserCode,   \n\tRecipe.OriginalDate,   \n\tRecipe.Date,\n\tRecipe.Qty,\n\tRecipe.Priority,\n\tSalePrice=ISNULL((SELECT Price=ROUND(Item.SalePrice / CASE WHEN item.Packunits > 0 THEN Item.PackUnits ELSE 1 END, 2) FROM Item WHERE Item.ICode = Recipe.ResultedItem), 0),\n\tValue=0.00\nFROM\n\tRecipe   \nWHERE \n\tRecipe.RecipeCode = :ar_Code",
  "update": "Recipe",
  "updatewhere": "1",
