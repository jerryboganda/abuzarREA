    "name": "qty",
    "dbname": "qty"
   }
  ],
  "retrieve": "  SELECT fullcode=stuff('0000', 5 - datalength(ltrim(str(dbo.item.iccode))), datalength(ltrim(str(dbo.item.iccode))), ltrim(str(dbo.item.iccode))) + stuff('00', 3 - datalength(ltrim(str(dbo.item.icatcode))), datalength(ltrim(str(dbo.item.icatcode))), ltrim(str(dbo.item.icatcode)))+ stuff('000', 4 - datalength(ltrim(str(dbo.item.packcode))), datalength(ltrim(str(dbo.item.packcode))), ltrim(str(dbo.item.packcode)))+ stuff('000', 4 - datalength(ltrim(str(dbo.item.manfcode))), datalength(ltrim(str(dbo.item.manfcode))), ltrim(str(dbo.item.manfcode))),\n\t\t\titemname= itemclass.name\t+' ' +itemcategory.name+' ' +itempacking.name+' '+manufacturer.name, \n\t\t\tcurrlistrow = 0,\n\t\t\tgd1.gcode,\n\t\t\tgd1.icode,   \n\t\t\tgd2.currqty,\n\t\t\tqty =\t\tCASE\n\t\t\t\t\t\t\tWHEN gd2.currqty - (gd1.optimumqty - gd1.currqty) >= 0 THEN  gd1.optimumqty - gd1.currqty\n\t\t\t\t\t\t\tELSE gd2.currqty\n\t\t\t\t\t\tEND\n\n    FROM item, \n\t\t\tgodowndetail  gd1, \t\t\n\t\t\tgodowndetail  gd2,\n\t\t\titemclass,\n\t\t\titemcategory,\n\t\t\titempacking,\n\t\t\tmanufacturer\n\n   WHERE ( item.icode = gd1.icode ) AND  \n\t\t\t( gd1.gcode = 3 ) and\n         ( gd1.currqty <= gd1.reorderqty ) and\n\t\t\t( gd1.icode = gd2.icode ) and\n\t\t\t( item.gcode = gd2.gcode) and\n\t\t\t( gd2.currqty > 0) and\n\t\t\t( gd1.optimumqty > 0 ) and\n\t\t\t( item.iccode = itemclass.iccode ) and  \n\t\t\t(( item.icatcode = itemcategory.icatcode ) and  \n         ( item.packcode = itempacking.packcode ) and  \n         ( item.manfcode = manufacturer.manfcode )) and\n\t\t\t( gd2.gcode = :ar_gcode )\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_gcode",
      "number"
     ]
    }
   ]
  }
 },
