  "retrieve": "SELECT\n\tRD.RecipeCode,\n\tRD.ICode,\n\tAliasName = I.customicode,\n\tI.name,\n\tCurrListRow = 0,\n\tRD.RowId,\n\tRD.Remarks,\n\tRD.PackUnits,\n\tRD.PackPrice,\n\tRD.Qty,\n\tRD.ItemFlatDisc,\n\tRD.DiscPerc,\n\titemcode = 0,\n\tRD.ProcessCharge,\n\tRD.ProcessChargePerc,\n\tRD.Price\nFROM\n\tRecipeDetail RD, \n\tItem I\nWHERE\n\tRD.RecipeCode = :ai_code AND\n\tRD.ICode = I.ICode\nORDER BY RD.RowID",
  "update": "RecipeDetail",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
