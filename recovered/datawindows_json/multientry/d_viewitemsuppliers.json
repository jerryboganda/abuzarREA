  "retrieve": "SELECT\n\tItemname=I.Name,\n\tAliasname=I.Customicode,\n\tsupplieraliasname=A.aliasname,\t\t\n\tSupplier=A.name,\t\t\n\tPriority=ISNULL(S.Priority, 0), \n\tRate=ISNULL(S.Rate, 0), \n\tDiscPerc=ISNULL(S.DiscPerc, 0), \n\tSaleQty=ISNULL(S.SaleQty, 0),\n\tBonusQty=ISNULL(S.BonusQty, 0),\n\tDays=ISNULL(S.Days, 0)\n\nFROM\n\tITEMSUPPLIERS S,\n\tITEM I,\n\tAccounts A\n\nWHERE \n\tS.SuppCode = :ai_code AND\n\tI.ICode = S.ICode AND \n\tS.SuppCode = A.AccCode\n\nORDER BY\n\tS.Priority,\n\tA.name",
