  "retrieve": "SELECT \n\tChildServer,\n\tTransmitDate=TransDate,\n\tInvType,\n\tAdvSaleInvCode, \n\tAliasName=(SELECT A.AliasName FROM Accounts A WHERE A.AccCode = Imp_AdvSaleLedger.CustCode),\n\tCustCode,\n\tDate, \n\tInvTotal, \n\tUserName=(SELECT users.username FROM users where users.usercode = Imp_AdvSaleLedger.SalesManCode),\n\tRemarks,\n\tTransmit,\n\tTransmited\nFROM\n\tImp_AdvSaleLedger\nWHERE \n\tChildServer = CASE WHEN LEN(:as_childserver) > 0 THEN :as_childserver ELSE ChildServer END AND\n\tCustCode = CASE WHEN :ai_custcode > 0 THEN :ai_custcode ELSE CustCode END AND\n\tDate BETWEEN :ad_startdate AND :ad_enddate AND\n\tInvType IN (1, 2) AND\n\tTransmited = 'N'\nORDER BY\n\tAdvSaleInvCode",
  "update": "Imp_AdvSaleLedger",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_childserver",
      "string"
     ]
