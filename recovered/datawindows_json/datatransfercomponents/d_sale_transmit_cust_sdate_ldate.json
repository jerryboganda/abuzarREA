  "retrieve": "SELECT \n\tSaleInvCode, \n\tAliasName=(SELECT A.AliasName FROM Accounts A WHERE A.AccCode = SaleLedger.CustCode),\n\tCustCode,\n\tDate, \n\tInvTotal, \n\tUserName=(SELECT users.username FROM users where users.usercode = SaleLedger.SalesManCode),\n\tRemarks,\n\tTransmit,\n\tTransmited\nFROM\n\tSaleLedger\nWHERE \n\tCustCode = CASE WHEN :ai_custcode > 0 THEN :ai_custcode ELSE CustCode END AND\n\tDate >= :ad_startdate AND Date <= :ad_enddate AND\n\tDELETED = 'N'\nORDER BY\n\tSaleInvCode",
