  "retrieve": "SELECT \n\tSD.ServiceInvCode, \n\tSH.Date,\n\tPatientCode=ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode) ),\n\tSH.AdmissionCode,\n\tSD.ServiceCode, \n\tSD.SrvRowID,\n\tServiceName= LTRIM(RTRIM(SV.Name)) + ' (' + LTRIM(RTRIM(CAST(SD.SrvRowID AS VARCHAR(15)))) + ')',\n\tSD.DeliveryDate\nFROM \n\tServiceHeader SH,\n\tServiceDetail SD,\n\tService SV\nWHERE\n\tSH.ServiceInvCode = :ai_serviceinvcode AND\n\tSH.ServiceInvCode = SD.ServiceInvCode AND\n\tSH.Posted = 'Y' AND\n\tSD.ServiceCode = SV.ServiceCode AND\n\tSV.ResultRequired='Y'\nORDER BY\n\tServiceName,\n\tSD.SrvRowID",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_serviceinvcode",
      "number"
     ]
    }
   ]
  }
 },
