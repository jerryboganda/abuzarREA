  "retrieve": "SELECT \n\tSamples.SampleCode,   \n\tSamples.SampleDate,   \n\tServiceInvCode = Samples.ServiceInvCode,\n\tServiceDate = (SELECT SH.Date FROM ServiceHeader SH WHERE SH.ServiceInvCode = Samples.ServiceInvCode),\n\tPatientRegNo= (SELECT P.RegNo FROM ServiceHeader SH, Patient P WHERE SH.ServiceInvCode = Samples.ServiceInvCode AND SH.PatientCode = P.PatientCode),\n\tPatientCode = (SELECT SH.PatientCode FROM ServiceHeader SH WHERE SH.ServiceInvCode = Samples.ServiceInvCode),\n\tAdmissionCode= (SELECT SH.AdmissionCode FROM ServiceHeader SH WHERE SH.ServiceInvCode = Samples.ServiceInvCode),\n\tDOB= (SELECT P.DOB FROM ServiceHeader SH, Patient P WHERE SH.ServiceInvCode = Samples.ServiceInvCode AND SH.PatientCode = P.PatientCode),\n\tAgeYears = 0,\n\tAgeMonths = 0,\n\tAgeDays = 0,\n\tGender= (SELECT P.Gender FROM ServiceHeader SH, Patient P WHERE SH.ServiceInvCode = Samples.ServiceInvCode AND SH.PatientCode = P.PatientCode),\n\tLocationCode= 0,\n\tSamples.UserCode,\n\tSamples.Comments,\n\tSamples.Processed,\n\tSamples.Posted,\n\tSamples.PostDate,\n\tSamples.PostedBY,\n\tSamples.ProcessedDate,\n\tSamples.ProcessedBy,\n\tSamples.Finalized\nFROM \n\tSamples  \nWHERE \n\tSamples.SampleCode = :ai_code    \n",
  "update": "Samples",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
