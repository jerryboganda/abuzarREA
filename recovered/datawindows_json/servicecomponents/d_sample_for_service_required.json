  "retrieve": "SELECT \n\tServiceInvCode=H.ServiceInvCode,\n\tDate=H.Date,\n\tServiceCode=D.ServiceCode,\n\tSrvRowID=D.SrvRowID,\n\tSampleTypeCode=SSR.SampleTypeCode,\n\tColor=SSR.Color,\n\tVolume=SSR.Volume,\n\tRemarks=SSR.Remarks\nFROM\n\tServiceHeader H,\n\tServiceDetail D,\n\tService S,\n\tServiceSampleRequirement SSR\nWHERE\n\tH.ServiceInvCode = D.ServiceInvCode AND\n\tD.ServiceCode = S.ServiceCode AND\n\tD.ServiceCode = SSR.ServiceCode AND\n\tD.SrvRowID IN (:ai_servicerowid) \nORDER BY\n\tD.SrvRowID,\n\tSSR.SampleTypeCode\n",
