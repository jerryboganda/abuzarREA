  ],
  "retrieve": "SELECT \n\tdbo.service.servicecode,\n\tfullcode =dbo.service.aliasname,\n\tdbo.service.name,\n\tsaleprice=\n\t\tCASE \n\t\tWHEN (SELECT PrefValue FROM SoftwarePreferences WHERE Name='FetchServicePriceFromPricePolicy')='N' THEN dbo.service.price\n\t\tELSE\n\t\t\t(SELECT ISNULL(D.Price, dbo.Service.Price)\n\t\t\tFROM ServicePricePolicyDetail D\n\t\t\tWHERE \n\t\t\t\tD.ServicePricePolicyCode IN \n\t\t\t\t\t(SELECT MAX(ServicePricePolicyCode) \n\t\t\t\t\tFROM ServicePricePolicy \n\t\t\t\t\tWHERE GetDate() BETWEEN StartDate AND EndDate AND ServiceCode = Service.ServiceCode) AND\n\t\t\t\tD.WeekDayCode = DatePart(dw, GetDate()))\n\t\tEND,\n\tlocation='',\n\tpackingdesc='',\n\tdbo.service.ServiceCatCode\n\nFROM dbo.service, dbo.servicecategory\nWHERE\n\tdbo.service.active = 'Y' AND \n\tdbo.service.ServiceCatCode = dbo.servicecategory.ServiceCatCode AND\n\tdbo.service.servicecatcode IN \n\t\t(SELECT sc.servicecatcode \n\t\tFROM dbo.GroupAllowedServiceCategory sc\n\t\tWHERE sc.GroupCode = :ai_groupcode)\nORDER BY dbo.service.name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_groupcode",
      "number"
     ]
    }
   ]
  }
 },
