  "retrieve": "SELECT \n\tSampleCode=S.SampleCode,\n\tSampleDate=S.SampleDate,\n\tServiceInvCode = S.ServiceInvCode,\n\tServiceDate = SH.Date,\n\tPatientRegNo= \n\t\t(SELECT P.RegNo \n\t\tFROM Patient P \n\t\tWHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),\n\tPatientCode = \n\t\t(SELECT P.PatientCode \n\t\tFROM Patient P \n\t\tWHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),\n\tAdmissionCode= SH.AdmissionCode,\n\tDOB=(SELECT P.DOB \n\t\tFROM Patient P \n\t\tWHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),\n\tAgeYears = (SELECT DATEDIFF(yyyy, P.DOB, GETDATE()) FROM Patient P WHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),\n\tAgeMonths = (SELECT (DATEDIFF(dd, P.DOB, GETDATE()) % 360) / 30 FROM Patient P WHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),\n\tAgeDays = (SELECT (DATEDIFF(dd, P.DOB, GETDATE()) % 360) % 30 FROM Patient P WHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),\n\tGender= (SELECT P.Gender FROM Patient P WHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),\n\tLocationCode= (SELECT PA.LocationCode\n\t\tFROM PatientAdmission PA \n\t\tWHERE SH.AdmissionCode = PA.AdmissionCode),\n\tUserCode=S.UserCode,\n\tComments=S.Comments,\n\tProcessed=S.Processed,\n\tPosted=S.Posted,\n\tPostDate=S.PostDate,\n\tPostedBY=S.PostedBY,\n\tProcessedDate=S.ProcessedDate,\n\tProcessedBy=S.ProcessedBy,\n\tFinalized=S.Finalized,\n\tServiceName = (SELECT SV.Name FROM Service SV WHERE SV.ServiceCode IN (SELECT SVD.ServiceCode FROM ServiceDetail SVD WHERE SVD.SrvRowID = SD.ServiceRowID) ),\n\tSampleTypeCode=SD.SampleTypeCode,\n\tSampeType = ST.Name,\n\tColor = SD.Color,\n\tVolume = SD.Volume,\n\tRemarks = SD.Remarks\nFROM \n\tSamples S, sampledetail SD, ServiceHeader SH, SampleType ST\nWHERE \n\tS.SampleCode = :ai_code AND\n\tS.SampleCode = SD.SampleCode AND\n\tS.ServiceInvCode = SH.ServiceInvCode AND\n\tST.SampleTypeCode = SD.SampleTypeCode\nORDER BY\n\tS.SampleCode,\n\tST.Name,\n\tSD.RowID\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
