  "retrieve": "SELECT \n\tfullcode=service.aliasname,\n\tservice.name,\n\tSVCD.servicecode,\n\tSVCD.qty,\n\tReturnQty = ( Select IsNull(Sum(d.qty),0 ) \n\t\t\tFrom   ServicePRHeader h ,ServicePRDetail d\n\t\t\tWhere  h.servicepurinvcode = :ai_servicepurinvcode AND \n\t\t\t\t\t h.serviceprinvcode = d.serviceprinvcode AND\n\t\t\t\t\t d.servicecode = SVCD.servicecode AND\n\t\t\t\t\t D.SRVRowID = SVCD.RowID),\n\tSVCD.price,\n\tAllowSaleInDecimal=Service.AllowSaleInDecimal,\n\tSVCD.ServiceFlatDisc,\n\tSVCD.rowid,\n\tSVCD.DiscPerc\nFROM   \n\tServicePurDetail SVCD,\tService\nWHERE  \n\tSVCD.servicecode=service.servicecode AND\n\tSVCD.servicepurinvcode=:ai_servicepurinvcode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_servicepurinvcode",
      "number"
     ]
    }
   ]
  }
 },
