  "retrieve": "SELECT \n\tfullcode=service.aliasname,\n\tservice.name,\n\tSVCD.servicecode,\n\tSVCD.smancode,\n\tsalesman.name,\t\n\tSVCD.qty,\n\tReturnQty = ( Select IsNull(Sum(qty),0 ) \n\t\t\tFrom   ServiceRHeader srh ,ServiceRDetail srd\n\t\t\tWhere  srh.serviceinvcode = :ai_serviceinvcode AND \n\t\t\t\t\t srh.servicerinvcode = srd.servicerinvcode AND\n\t\t\t\t\t srd.servicecode = SVCD.servicecode AND\n\t\t\t\t\t srd.srvrowid = SVCD.srvrowid),\n\tSVCD.price,\n\tAllowSaleInDecimal=Service.AllowSaleInDecimal,\n\tSVCD.ServiceFlatDisc,\n\tSVCD.costprice,\n\tSVCD.srvrowid,\n\tSVCD.Commission,\n\tSVCD.SharePerc,\n\tSVCD.ServiceFlatTax,\n\tSVCD.ServiceGstPerc,\n\tSVCD.DiscPerc\nFROM   \n\tServiceDetail SVCD\n\tLEFT OUTER JOIN salesman ON (SVCD.smancode = salesman.salesmancode),\n\tService\nWHERE  \n\tSVCD.servicecode=service.servicecode AND\n\tSVCD.serviceinvcode=:ai_serviceinvcode\nUNION ALL\nSELECT \n\tfullcode=service.aliasname,\n\tservice.name,\n\tservicecode=Service.servicecode,\n\tSManCode=NULL,\n\tNULL,\t\n\tqty=99999,\n\tReturnQty = 0,\n\tprice=service.price,\n\tAllowSaleInDecimal=Service.AllowSaleInDecimal,\n\tServiceFlatDisc=0,\n\tcostprice=Service.CostPrice,\n\tsrvrowid=NULL,\n\tCommission=Service.Commission,\n\tSharePerc=Service.SharePerc,\n\tServiceFlatTax=Service.ServiceFlatTax,\n\tServiceGstPerc=Service.ServiceGstPerc,\n\tDiscPerc=0.00\nFROM   \n\tService\nWHERE  \n\t:ai_serviceinvcode IS NULL\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_serviceinvcode",
      "number"
     ]
    }
   ]
  }
 },
