  "retrieve": "SELECT \n\tSelected='N',\n\tServiceCode=SD.ServiceCode, \n\tSrvRowID=SD.SrvRowID,\n\tServiceName= LTRIM(RTRIM(SV.Name)) + ' (' + LTRIM(RTRIM(CAST(SD.SrvRowID AS VARCHAR(15)))) + ')',\n\tDeliveryDate=SD.DeliveryDate,\n\tStatus = CASE WHEN (SELECT MAX(ServiceRowId) FROM SampleDetail SMD WHERE SMD.ServiceRowID = SD.SrvRowID) > 0 THEN 'Y' ELSE 'N' END\nFROM \n\tServiceHeader SH,\n\tServiceDetail SD,\n\tService SV\nWHERE\n\tSH.ServiceInvCode = :ai_serviceinvcode AND\n\tSH.ServiceInvCode = SD.ServiceInvCode AND\n\tSH.Posted = 'Y' AND\n\tSD.ServiceCode = SV.ServiceCode AND\n\tSV.ResultRequired='Y'\nORDER BY\n\tServiceName,\n\tSD.SrvRowID",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_serviceinvcode",
      "number"
     ]
    }
   ]
  }
 },
