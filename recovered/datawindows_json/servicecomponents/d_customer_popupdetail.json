  "retrieve": "  SELECT   accounts.acccode,  \n\t\t\t  accounts.subcode , \n           accounts.name ,\n           accounts.aliasname,\n\t\t\t  accounts.openingdate ,\n           customer.custcode ,\n\t\t\t  customer.custcatcode ,\n           customer.areacode ,\n           customer.cp ,\n           customer.address1 ,\n  \t\t\t  customer.address2 ,\n\t        customer.city ,\n           customer.country ,\n           customer.phone ,\n           customer.fax ,\n           customer.email ,\n           customer.crlimit ,\n           customer.dayslimit ,\n\t\t\t  customer.licenceno ,\n\t\t\t  customer.licenceexpiry,\n\t\t\t  accounts.active ,\n\t\t\t  customer.SalesTaxRegNo,\n\t\t\t  Customer.DefaultGST,\n\t\t\t  Customer.MessageCode,\n\t\t\t  Customer.SalesmanCode,\n\t\t\t  Customer.SubAreaCode,\n\t\t\t  Customer.InvDiscperc\n     \n        FROM accounts ,\n           customer     \n        WHERE ( customer.custcode = accounts.acccode ) and \n\t\t         ( ( customer.custcode = :ra_AccCode ) )  ",
  "update": "accounts",
  "updatewhere": "1",
