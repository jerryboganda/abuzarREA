  "retrieve": "SELECT \n\tArea=Ar.name, \n\tCategory=CC.name,\n\tAliasName=A.AliasName,\n\tAccCode=A.AccCode,\n\tCP=C.CP,\n\tName=A.Name,\n\tAddress1=C.Address1,\n\tAddress2=C.Address2,\n\tCity=C.City,\n\tPhone=C.Phone\nFROM\n\tAccounts A, Customer C, Area Ar, CustomerCategory CC\nWHERE\n\tC.CustCode IN (:ai_custcode) AND\n\tA.AccCode = C.CustCode AND\n\tC.AreaCode = Ar.AreaCode and\n\tC.CustCatCode = CC.CustCatCode\nORDER BY\n\tArea, \n\tCategory,\n\tA.Name,\n\tA.AliasName,\n\tA.AccCode\n",
