  "retrieve": "SELECT \n\tType = (SELECT VocherCategory.Name FROM VocherCategory WHERE VocherCategory.VochCatCode = H.VochCatCode),\n\tGLCODE = H.GLVochCode,\n\tHeaderAcccode=H.acccode,\n\tH.VoucherCode,\n\theaderremarks=H.remarks,\n\theaderrefno=H.chkno,\n\toutstandingamt=D.outstandingamt,\n\tDate = H.Date, \n\tAccCode=D.AccCode,\n\tAliasName = A.AliasName,\n\tTitle = A.Name,\n\tAmount = D.Debit - D.Credit,\n\tRemarks = D.Remarks,\n\tChequeNo= D.ChkNo,\n\tPosted=H.Posted,\n\tD.Balance,\n\tInvoiceCode=D.InvoiceCode,\n\tInvoiceBased=(SELECT VocherCategory.InvoiceBased FROM VocherCategory WHERE VocherCategory.VochCatCode = H.VochCatCode),\n\tUserName = (SELECT U.username FROM Users U WHERE U.UserCode = H.SalesManCode),\n\tPrintBalance = :ai_printbalance\nFROM\n\tGLHeader H,\n\tGLDetail D,\n\tAccounts A\nWHERE\n\tH.GLVochCode = :ai_glvochcode AND\n\tH.GLVochCode = D.GLVochCode AND\n\tH.AccCode <> D.AccCode AND\n\tD.AccCode = A.AccCode\nORDER BY\n\tH.GLVochCode,\n\tD.GLRowID",
  "arguments": {
   "_items": [
