  "retrieve": "  SELECT currlistrow = 0,\n\t\t\tstock     = 0.0000, \n\t\t\ttotalstock= 0.0000, \n\t\t\tTD.transcode,\n\t\t\tTD.icode, \n\t\t\tI.customicode, \n\t\t\tTH.posted,\n         TH.dgcode, \n\t\t\tremarks=max(TH.remarks),\n         TH.sgcode,\n          sourcegodown=(SELECT  GC.NAME FROM GODOWN GC WHERE GC.GCODE=TH.sgcode),\n          targetgodown=(SELECT  GD.NAME FROM GODOWN GD WHERE GD.GCODE=TH.dgcode),\n         itemname = I.name, \n\t\t\taliasname = i.customicode,\n         Id   = TD.IDENTITYCOL,\n\t\t\trequiredqty =(SELECT IC.goptimumqty * IC.packunits FROM  item IC WHERE IC.icode=TD.icode )  - ISNULL((SELECT sum(currqty) FROM  godowndetail G WHERE G.icode=TD.icode AND G.gcode=TH.dgcode),0) ,\n\t\t\treorderqty = (SELECT IC.greorderqty * IC.packunits FROM  item IC WHERE IC.icode=TD.icode ) ,\n\t\t\toptimumqty = (SELECT IC.goptimumqty * IC.packunits FROM  item IC WHERE IC.icode=TD.icode ) ,\n\t\t\ttargetstk = ISNULL((SELECT sum(currqty) FROM  godowndetail G WHERE G.icode=TD.icode AND G.gcode=TH.dgcode),0) ,\n\t\t\tsourcestk = ISNULL((SELECT sum(currqty) FROM  godowndetail G WHERE G.icode=TD.icode AND G.gcode=TH.sgcode) ,0),\n\t\t\tqty  = sum(TD.qty),\n\t\t\theaderno=max(headerno)\n\n   FROM tdetail TD, theader TH, \n         item  I\n\n   WHERE (TH.transcode = :ar_tCode) AND\n         ( TD.transcode = TH.transcode )    AND\n\t\t   ( TD.icode = I.icode )\n         \nGROUP BY TD.transcode, \n\t\t\tTH.sgcode,\n         TH.dgcode,\n         TH.posted,\n         TD.icode, \n\t\t\tTD.rowgroup,\n\t\t\tI.customicode, \n\t\t\tI.name,\n         Id\n\t\t\t\nORDER BY Id\n\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_tcode",
      "number"
     ]
    }
   ]
  }
 },
