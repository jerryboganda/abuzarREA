  "retrieve": "SELECT\n\titem.customicode,  \n\titemname= item.name, \n\tlocksaleprice = dbo.item.locksaleprice,\n\tlockdiscperc = dbo.item.lockdiscperc,\n\tcurrlistrow = 0,\n\tstock     = 0.0000, \n\ttotalstock= 0.0000, \n\tpurprice=max(saledetail.purunitrate),\n\trppunitrate=max(saledetail.rppunitrate),\n\tavgprice=max(ROUND(Item.purprice / CASE WHEN item.packunits <= 0 THEN 1 ELSE item.packunits END, 2)),\n\titemtotalval=space(30),\n\tqtysale=item.saleqty,\n\tbonus=item.bonusqty,\n\tassgcode  = 1, \n\tupdatesaleprice = 'N',\n\tsaledetail.saleinvcode,   \n\tsaledetail.icode,   \n\tsaledetail.gcode,\n\tItemflatdisc = max(Saledetail.itemflatdisc),\n\tId        = max(saledetail.IDENTITYCOL),\n\tpackunits = max(saledetail.packunits),\n\tsaleprice = max(saledetail.saleprice),\n\trate      = max(saledetail.rate),\n\tsalestax  = max(saledetail.salestax),  \n\tDue       = max(Due),\n\tSatisfiedDate = max(SatisfiedDate),\n\tDueQty    = 0,\n\tpackqty   = sum(saledetail.packqty),\n\tSaleItemDescription =  max( saledetail.SaleItemDescription),\n\tclaimable= max(saledetail.claimable),\n\tclaimablediscperc= max(saledetail.claimablediscperc),\n\tdiscperc  = max(saledetail.discperc),\n\titemcode = 0,\n\tretailprice=item.retailprice,\n\tpackprice = max(saledetail.packprice),\n\tunitsalestax=max(saledetail.unitsalestax),\n\tgstperc=max(saledetail.gstperc),\n\tpackqtyforsale = Max(saledetail.packqtyforsale) ,\n\tbonuspackqtyforsale = Max(saledetail.bonuspackqtyforsale),\n\tbonusqty  = sum(saledetail.bonusqty),\n\tlooseqty  = sum(saledetail.looseqty),\n\tinvdiscperc= ISNULL( (select dbo.saleledger.discperc from dbo.saleledger where dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode), 0),\n\tviewsaleinvmarginpreviewon = (SELECT DBO.Fn_GetPreference('viewsaleinvmarginpreview'))\nFROM \n\tsaledetail, item\nWHERE \n\t( dbo.saledetail.saleinvcode = :ar_SaleInvCode )    AND\n\t( saledetail.icode = item.icode )\nGROUP BY \n\tsaledetail.saleinvcode, \n\tsaledetail.icode, \n\tsaledetail.rowgroup,\n\tsaledetail.gcode, \n\titem.customicode, \n\titem.saleqty,\n\titem.bonusqty,\n\titem.name,\n\titem.locksaleprice,\n\titem.lockdiscperc,\n\titem.retailprice\nORDER BY \n\tMIN(saledetail.IDENTITYCOL)\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_SaleInvCode",
      "number"
     ]
    }
   ]
  }
 },
