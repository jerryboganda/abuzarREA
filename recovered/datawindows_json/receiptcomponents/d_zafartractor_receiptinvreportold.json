  "columns": [
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "receiptinvcode",
    "dbname": "Receiptinvcode"
   },
   {
    "type": "datetime",
    "updatewhereclause": "yes",
    "name": "date",
    "dbname": "date"
   },
   {
    "type": "decimal(5)",
    "updatewhereclause": "yes",
    "name": "price",
    "dbname": "price"
   },
   {
    "type": "char(100)",
    "updatewhereclause": "yes",
    "name": "batch",
    "dbname": "batch"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "itemname",
    "dbname": "itemname"
   }
  ],
  "retrieve": "SELECT\n\tReceiptinvcode = dbo.Receiptheader.Receiptinvcode, \n\tdate = dbo.Receiptheader.date,   \n\tprice = Case (Select A=DBO.Fn_Get_Int_Preference('ReceiptPriceInPrint') ) When 1 THEN receiptdetail.saleprice When 2 THEN receiptdetail.purchaseprice When 3 THEN receiptdetail.avgprice When 4 THEN receiptdetail.MRPP When 5 THEN receiptdetail.price END,\n\tbatch = Receiptdetail.batch,   \n\titemname=item.name \nFROM \n\tReceiptheader, \n\tReceiptdetail, \n\titem \n\t\nWHERE \n\t( dbo.Receiptheader.Receiptinvcode = :ar_Code ) AND\n\t( dbo.Receiptheader.Receiptinvcode = dbo.Receiptdetail.Receiptinvcode) AND\n\t( dbo.Receiptdetail.icode = dbo.item.icode) \n\t\nORDER BY \n\titem.name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_Code",
      "number"
     ]
    }
   ]
  }
 },
