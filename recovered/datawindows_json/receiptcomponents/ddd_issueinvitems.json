  "retrieve": " SELECT \n\tcustomicode,\n\talternatecustomicode,\n\tname, \n\tcompute_0002, \n\ticode, \n\tgcode, \n\tbatch, \n\texpiry,\n\tsaleprice, \n\tdiscperc=0.00,\n\tIssueQty=SUM(qty),\n\tBonusQty=0.0000,\t \n\tpackunits, \n\tReceivedQty, \n\tTotalPieces = SUM(TotalPieces),\n\tReceivedTotalPieces = SUM(ReceivedTotalPieces),\n\tIssueRowID=IssRowID,\n\tavgprice,\n\titemdesc=max(itemdesc)\nFROM \n\t(SELECT \n\t\tdbo.item.name, \n\t\tdbo.item.name + space(70) + str(Issuedetail.IssRowID) as compute_0002, \n\t\tdbo.item.icode,\n\t\tdbo.item.customicode,\n\t\tdbo.issuedetail.alternatecustomicode,\n\t\tdbo.issuedetail.gcode,\n\t\tdbo.issuedetail.batch,\n\t\tdbo.issuedetail.expiry,\n\t\tsaleprice=dbo.issuedetail.price,\n\t\tdbo.issuedetail.qty,\n\t\tdbo.issuedetail.packunits,\n\t\tdbo.issuedetail.TotalPieces,\n\t\tdbo.issuedetail.PiecesInHand,\n\t\tReceivedTotalPieces = (SELECT IsNull(Sum(receiptdetail.TotalPieces), 0.0000)\n\t\t\t\tFROM   \treceiptheader, receiptdetail\n\t\t\t\tWHERE  \treceiptheader.issueinvcode = issuedetail.IssueInvCode    and\n\t\t\t\t\treceiptheader.receiptinvcode   = receiptdetail.receiptInvCode and\n\t\t\t\t\treceiptdetail.IssueRowID = dbo.Issuedetail.IssRowID),\n\t\tReceivedQty = (SELECT IsNull(Sum(receiptdetail.Qty), 0.0000)\n\t\t\t\tFROM   \treceiptheader, receiptdetail\n\t\t\t\tWHERE  \treceiptheader.issueinvcode = issuedetail.IssueInvCode    and\n\t\t\t\t\treceiptheader.receiptinvcode   = receiptdetail.receiptInvCode and\n\t\t\t\t\treceiptdetail.IssueRowID = dbo.Issuedetail.IssRowID),\n\t\t issuedetail.IssRowID,\n\t\t itemdesc=dbo.issuedetail.itemdescription,\n\t\t AvgPrice=issuedetail.AvgPrice\n\tFROM \n\t\tdbo.item, dbo.issuedetail\n\tWHERE \n\t\t( issuedetail.issueinvcode = :ar_issueInvCode ) and\n\t\t( item.icode = issuedetail.icode )) AS TMP\nGROUP BY \n\ticode, \n\tname, \n\tcompute_0002, \n\tcustomicode, \n\talternatecustomicode,\n\tgcode, \n\tbatch, \n\texpiry, \n\tsaleprice, \n\tpackunits, \n\tReceivedQty,\n\tavgprice,\n\tIssRowID\nORDER BY \n\tname, \n\tbatch,\n\texpiry",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_IssueInvCode",
      "number"
     ]
    }
   ]
  }
 },
