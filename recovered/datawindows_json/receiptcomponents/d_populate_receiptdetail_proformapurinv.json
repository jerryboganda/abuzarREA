  "retrieve": "SELECT \t\n\titem.customicode,\n\titem.name, \n\tcurrlistrow = 0,\n\tstock=0.0000, \n\ttotalstock=0.0000,\n\tdbo.ReceiptDetail.receiptinvcode,\n\tdbo.ReceiptDetail.gcode,\n\tdbo.ReceiptDetail.icode,\n\tdbo.ReceiptDetail.batch,\n\tdbo.ReceiptDetail.expiry,\n\tdbo.ReceiptDetail.price,\n\tdbo.ReceiptDetail.packunits,      \n\tdbo.ReceiptDetail.purchaseprice,   \n\tdbo.ReceiptDetail.priority,\n\tdbo.ReceiptDetail.avgprice,\n\tdbo.ReceiptDetail.mrpp,\n\tdbo.ReceiptDetail.saleprice,\n\tdbo.ReceiptDetail.Sectcode,\n\tdbo.ReceiptDetail.UpdateAvgPrice,\n\tdbo.ReceiptDetail.NewAvgPrice,\n\tdbo.ReceiptDetail.CurrStock,\n\treceiptutn=dbo.ReceiptDetail.receiptutn,\n\tpopulatedqty = \n\t\t(SELECT \n\t\t\tSUM(\n\t\t\t\tCASE WHEN PPD.PackQty = 0 THEN (PPD.LooseQty + PPD.BonusQty) \n\t\t\t\tELSE ((PPD.PackQty + PPD.BonusQty) * PPD.PackUnits) END\n\t\t\t\t) \n\t\tFROM ProformaPurDetail PPD WHERE PPD.ReceiptRowID = ReceiptDetail.ReceiptUTN),\n\tdbo.ReceiptDetail.qty\n\t\nFROM \n\tdbo.ReceiptDetail, \n\tdbo.item\n\nWHERE \n\t( dbo.ReceiptDetail.receiptinvcode IN (:r_InvCode) )   and\n\t( dbo.ReceiptDetail.icode = dbo.item.icode )\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "r_InvCode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "code A, itemname A, gcode A, batch A, expiry A"
