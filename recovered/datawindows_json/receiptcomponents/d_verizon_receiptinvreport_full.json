    "dbname": "itempacking"
   }
  ],
  "retrieve": "SELECT \n\titemname= item.name, \n   \titemalias=(select customicode from item where item.icode=receiptdetail.icode),\n\tsource = Case RecipientCode When 1 Then (Select Name From Department Where DeptCode=Receiptheader.deptcode) When 2 Then (Select Name From Accounts Where AccCode = Receiptheader.AccCode) When 3 Then (Select Name From Accounts Where AccCode = Receiptheader.AccCode) When 4 Then (Select Name From SalesMan Where SalesManCode = Receiptheader.RecipientSalesMan ) End,\n\tmanf=(select name from manufacturer where manufacturer.manfcode=item.manfcode),\n\tsalesman = dbo.users.username, \n\tReceiptinvcode = dbo.Receiptheader.Receiptinvcode, \n\tsmanname=salesman.name,\n\tdate = dbo.Receiptheader.date,   \n\tprice = Case (Select A=DBO.Fn_Get_Int_Preference('ReceiptPriceInPrint') ) When 1 THEN receiptdetail.saleprice When 2 THEN receiptdetail.purchaseprice When 3 THEN receiptdetail.avgprice When 4 THEN receiptdetail.MRPP When 5 THEN receiptdetail.price END,\n\tdbo.Receiptheader.deptcode,\n\tdbo.Receiptheader.remarks,\t\n\tgcode = Receiptdetail.gcode,   \n\ticode = Receiptdetail.icode,   \n\tbatch = Receiptdetail.batch,   \n\texpiry = Receiptdetail.expiry,   \n\tlooseqty = Receiptdetail.qty,\n\treferenceno=dbo.Receiptheader.referenceno,\n\tdbo.Receiptheader.referencedate,\n\tGodown = Godown.name,\n\titempacking = itempacking.name\nFROM \n\tReceiptheader\n\tLEFT OUTER JOIN dbo.department ON (dbo.Receiptheader.deptcode = dbo.department.deptcode)\n\tLEFT OUTER JOIN dbo.salesman ON (dbo.Receiptheader.Smancode = dbo.SalesMan.Salesmancode),\n\tReceiptdetail, \n\tusers, \n\titem\n\tLEFT OUTER JOIN dbo.itempacking ON (dbo.item.packcode = dbo.itempacking.packcode)\n\tLEFT OUTER JOIN dbo.Godown ON (dbo.item.gcode = dbo.Godown.gcode)\nWHERE \n\t( dbo.Receiptheader.Receiptinvcode = :ar_Code ) AND\n\t( dbo.Receiptheader.Receiptinvcode = dbo.Receiptdetail.Receiptinvcode) AND\n\t( dbo.Receiptheader.salesmancode = dbo.users.usercode ) AND \n\t( dbo.Receiptdetail.icode = dbo.item.icode) \nORDER BY \n\titem.name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_Code",
      "number"
     ]
    }
   ]
  }
 },
