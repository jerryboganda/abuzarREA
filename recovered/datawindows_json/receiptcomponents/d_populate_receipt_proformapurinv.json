    "updatewhereclause": "yes",
    "name": "posted",
    "dbname": "Posted",
    "values": "No\tN/Yes\tY/"
   }
  ],
  "retrieve": "SELECT \n\tRH.ReceiptInvCode,\n\tRH.Date, \n\tRecipientTypeCode = RH.RecipientCode,\n\tRecipientCode = \n\t\tCASE RH.RecipientCode \n\t\t\tWHEN 1 THEN RH.DeptCode \n\t\t\tWHEN 4 THEN RH.RecipientSalesMan \n\t\t\tELSE RH.AccCode \n\t\tEND,\n\tRecipientName = \n\t\tCASE RH.RecipientCode \n\t\tWHEN 1 THEN \n\t\t\t(SELECT D.Name FROM Department D WHERE D.DeptCode = RH.DeptCode) \n\t\t\tWHEN 4 THEN (SELECT S.Name FROM SalesMan S WHERE S.SalesManCode = RH.RecipientSalesMan)  \n\t\t\tELSE (SELECT A.Name FROM Accounts A WHERE A.AccCode = RH.AccCode)  END,\n\tRH.HeaderNo, \n\tRH.HeaderInvNo, \n\tUserName=(SELECT users.username FROM users where users.usercode = RH.SalesManCode),\n\tRH.Remarks,\n\tSELECTED='N',\n\tStatus=CASE WHEN (SELECT SUM(rd.qty - CASE WHEN d.packqty = 0 THEN (d.looseqty + d.bonusqty) ELSE ((d.packqty + d.bonusqty) * d.packunits) END) FROM proformapurdetail d, Receiptdetail rd WHERE rd.Receiptinvcode = RH.ReceiptInvcode AND rd.receiptutn = d.Receiptrowid) <= 0 THEN 'Populated' ELSE 'Pending' END,\n\tPosted=RH.Posted\nFROM\n\tReceiptHeader RH\nWHERE \n\tRH.Posted = 'Y' AND \n\tRH.RecipientCode = :ai_recipienttypecode AND\n\tRH.AccCode = :ai_recipientcode\nORDER BY\n\tRH.ReceiptInvCode",
  "update": "ReceiptHeader",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_recipienttypecode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_recipientcode",
      "number"
     ]
    }
   ]
  },
  "sort": "date A"
 },
