 "table": {
  "columns": [
   {
    "type": "char(37)",
    "updatewhereclause": "yes",
    "name": "invcode",
    "dbname": "InvCode"
   }
  ],
  "retrieve": "SELECT\n\tInvCode='Sale Inv. No. = ' + LTRIM(RTRIM(STR(S.SaleInvCode)))\nFROM\t\n\tSaleLedger S \nWHERE S.Posted='N' AND \n\tS.SaleCatCode = 3 AND \n\tS.CashierShiftCode=:ai_code\nUNION ALL\nSELECT\n\tInvCode='S/R No. = ' + LTRIM(RTRIM(STR(S.SRInvCode)))\nFROM\t\n\tSRLedger S \nWHERE S.Posted='N' AND \n\tS.SRCatCode = 8 AND S.CashierShiftCode=:ai_code\nUNION ALL\nSELECT\n\tInvCode='S/R No. = ' + LTRIM(RTRIM(STR(S.SRBufferInvCode)))\nFROM\t\n\tSRBufferLedger S \nWHERE S.Posted='N' AND \n\tS.SRCatCode = 8 AND S.CashierShiftCode=:ai_code\nUNION ALL\nSELECT\n\tInvCode='Service Inv. No. = ' + LTRIM(RTRIM(STR(S.ServiceInvCode)))\nFROM\t\n\tServiceHeader S \nWHERE S.Posted='N' AND \n\tS.ServiceCatCode = 10 AND S.CashierShiftCode=:ai_code\nUNION ALL\nSELECT\n\tInvCode='Service Return Inv. No. = ' + LTRIM(RTRIM(STR(S.ServiceRInvCode)))\nFROM\t\n\tServiceRHeader S \nWHERE S.Posted='N' AND \n\tS.ServiceRCatCode = 13 AND S.CashierShiftCode=:ai_code\nUNION ALL\nSELECT\n\tInvCode='GL Voucher No. (Receipt) = ' + LTRIM(RTRIM(STR(GL.GLVochCode)))\nFROM\n\tGLDetail GD, GLHeader GL, CashierShift \nWHERE GL.Posted = 'N' AND \n\tGL.GLVochCode = GD.GLVochCode AND \n\tCashierShift.CashierShiftCode = :ai_code AND \n\tGL.Date BETWEEN CashierShift.OpenedOn AND ISNULL(CashierShift.ClosedOn,GETDATE()) AND \n\tGD.AccCode = CashierShift.CashAccCode\t AND\n\tGD.Debit > 0\nUNION ALL\nSELECT\n\tInvCode='GL Voucher No. (Payment) = ' + LTRIM(RTRIM(STR(GL.GLVochCode)))\nFROM\n\tGLDetail GD, GLHeader GL, CashierShift \nWHERE GL.Posted = 'N' AND \n\tGL.GLVochCode = GD.GLVochCode AND \n\tCashierShift.CashierShiftCode = :ai_code AND \n\tGL.Date BETWEEN CashierShift.OpenedOn AND ISNULL(CashierShift.ClosedOn,GETDATE()) AND \n\tGD.AccCode = CashierShift.CashAccCode\t AND\n\tGD.Credit > 0\nORDER BY InvCode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
