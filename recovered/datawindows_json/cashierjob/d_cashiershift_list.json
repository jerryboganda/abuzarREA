  ],
  "retrieve": "SELECT \n\tCashierShiftCode,\n\tOpenedOn,\n\tClosedOn,\n\tOpenedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=CashierShift.OpenedBy),\n\tClosedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=CashierShift.ClosedBy),\n\tShiftOwner,\n\tShiftStatus,\n\tCashAccCode,\n\tOpeningBalance\nFROM \n\tCashierShift\nWHERE \n\tShiftOwner IN \n\t\t(SELECT :ai_usercode FROM Users WHERE Users.UserCode=:ai_usercode)\nUNION\nSELECT \n\tCashierShiftCode,\n\tOpenedOn,\n\tClosedOn,\n\tOpenedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=CashierShift.OpenedBy),\n\tClosedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=CashierShift.ClosedBy),\n\tShiftOwner,\n\tShiftStatus,\n\tCashAccCode,\n\tOpeningBalance\nFROM \n\tCashierShift\nWHERE \n\tdbo.fn_GetGroupCode(:ai_usercode) = 2\nUNION\nSELECT \n\tCashierShiftCode,\n\tOpenedOn,\n\tClosedOn,\n\tOpenedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=CashierShift.OpenedBy),\n\tClosedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=CashierShift.ClosedBy),\n\tShiftOwner,\n\tShiftStatus,\n\tCashAccCode,\n\tOpeningBalance\nFROM \n\tCashierShift\nWHERE \n\tShiftOwner IN (SELECT UserCode FROM UserGroups WHERE GroupCode IN\n\t(select allowedgroupcode \n\tfrom groupallowedgroups\n\twhere module=1 and groupcode = dbo.fn_GetGroupCode(:ai_usercode)))\n",
  "update": "CashierShift",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_usercode",
      "number"
     ]
    }
   ]
  },
  "sort": "code D"
 },
