  "retrieve": "SELECT\n\tRowId,\n\tDate,\n\tModuleID,   \n\tDocCode,   \n\tCatCode,\n\tCategory,\n\tAccCode,\n\tUserCode,   \n\tMachineName,\n\tHeaderNo,\n\tHeaderInvNo,\n\tAmount, \n\tCashAccCode,\n\tCashTendered,\n\tCashCharged,\n\tCashBack,\n\tRemarks,   \n\tCashierJobCode,\n\tPosted = \n\t\tCASE ModuleID\n\t\tWHEN 1 THEN (SELECT S.Posted FROM SaleLedger S WHERE S.SaleInvCode=CashierActivity.DocCode)\n\t\tWHEN 2 THEN (SELECT S.Posted FROM SRLedger S WHERE S.SRInvCode=CashierActivity.DocCode)\n\t\tELSE 'Y' END,\n\tPrinted,\n\tSupervised\nFROM \n\tCashierActivity\nWHERE \n\tRowId = :ai_rowid AND Supervised = 'N'\n",
