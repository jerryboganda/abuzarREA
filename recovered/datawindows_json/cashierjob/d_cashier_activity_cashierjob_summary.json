  "retrieve": "SELECT\n\tGroupName = CASE WHEN CashierActivity.ModuleID <= 11 THEN 'SALES' WHEN CashierActivity.ModuleID <= 32 THEN 'SALES RETURN' ELSE 'TRANSACTION VOUCHERS' END,\n\tDate=CashierActivity.Date,   \n\tModuleID=CashierActivity.ModuleID,   \n\tModule = (SELECT M.Name FROM Module M WHERE M.Module = CashierActivity.ModuleID),\n\tDocCode=CashierActivity.DocCode,   \n\tCatCode=CashierActivity.CatCode,   \n\tCategory=CashierActivity.Category,   \n\tAccCode=CashierActivity.AccCode,   \n\tAccountName = Accounts.Name,\n\tMachineName=CashierActivity.MachineName,   \n\tHeaderNo=CashierActivity.HeaderNo,   \n\tHeaderInvNo=LTRIM(RTRIM(CAST(CashierActivity.HeaderNo AS VARCHAR(10)))) + '-' + LTRIM(RTRIM(CAST(CashierActivity.HeaderInvNo AS VARCHAR(10)))),\n\tAmount=CashierActivity.Amount,   \n\tCashAccCode=CashierActivity.CashAccCode,   \n\tCashTendered=CashierActivity.CashTendered,   \n\tCashCharged=CashierActivity.CashCharged,   \n\tCashBack=CashierActivity.CashBack,   \n\tRemarks=CashierActivity.Remarks,   \n\tActive = CashierJob.Active,\n\tInActiveDate = CashierJob.InActiveDate,\n\tCashierJobCode=CashierActivity.CashierJobCode,   \n\tCashierName=Users.UserName,\n\tGLVochCode=CashierActivity.GLVochCode\nFROM \n\tCashierActivity, CashierJob, Users, Accounts\nWHERE \n\tCashierJob.CashierJobCode = :ai_code AND\n\tCashierJob.CashierJobCode = CashierActivity.CashierJobCode AND\n\tCashierActivity.AccCode = Accounts.AccCode AND\n\tCashierJob.JobOwner = Users.UserCode\nORDER BY Date",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  },
  "sort": "groupname A, category A, date A"
 },
