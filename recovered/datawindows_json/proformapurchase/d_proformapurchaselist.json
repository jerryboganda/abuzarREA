  "retrieve": "SELECT  \n\tpurledger.purinvcode,\n\tpurledger.date,\n\tdbo.purledger.suppinvcode, \n\tdbo.purledger.suppinvdate, \n\tdbo.purledger.GRN, \n\tdbo.purledger.invtotal,\n\taccounts.name, \n\tprintcounter=purledger.printcounter,\n\tusername=(select username from users where users.usercode=purledger.salesmancode),\n\tposted = purledger.posted,\n\tPostedBy = IsNull((Select username from users \n\t\twhere dbo.purledger.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\twhere dbo.purledger.modifiedby = dbo.users.usercode), ''),\n\tRemarks = purledger.remarks \nFROM  \n\tpurledger ,  \n\taccounts,\n\tusers\nWHERE  \n\t( purledger.impactinventory = 'N' ) AND\n\t( purledger.suppcode = accounts.acccode ) and \n\t( Posted IN (:as_Posted)) AND\n\t( purledger.salesmancode = users.usercode ) and\n\t( dbo.PurLedger.HeaderNo IS NULL OR\n\t( dbo.PurLedger.HeaderNo IN \n\t\t(SELECT HeaderCode FROM GroupAllowedHeader \n\t\tWHERE GroupCode = :ai_GroupCode AND Module=:ai_Module)))  and\n\tExists (SELECT DBO.Fn_GetPreference('allowedgroupsinpurchaselist') \n\tWHERE DBO.Fn_GetPreference('allowedgroupsinpurchaselist') = 'N')\nUNION ALL\nSELECT  \n\tpurledger.purinvcode,\n\tpurledger.date,\n\tdbo.purledger.suppinvcode, \n\tdbo.purledger.suppinvdate, \n\tdbo.purledger.GRN, \n\tdbo.purledger.invtotal,\n\taccounts.name, \n\tprintcounter=purledger.printcounter,\n\tusername=(select username from users where users.usercode=purledger.salesmancode),\n\tposted = purledger.posted,\n\tPostedBy = IsNull((Select username from users \n\t\twhere dbo.purledger.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\twhere dbo.purledger.modifiedby = dbo.users.usercode), ''),\n\tRemarks = purledger.remarks \nFROM  \n\tpurledger ,  \n\taccounts,\n\tusers\nWHERE  \n\t( purledger.impactinventory = 'N' ) AND\n\t( purledger.suppcode = accounts.acccode ) and \n\t( Posted IN (:as_Posted)) AND\n\t( purledger.salesmancode = users.usercode ) and\n\t( dbo.PurLedger.HeaderNo IS NULL OR\n\t( dbo.PurLedger.HeaderNo IN \n\t\t(SELECT HeaderCode FROM GroupAllowedHeader \n\t\tWHERE GroupCode = :ai_GroupCode AND Module=:ai_Module)))  and\n\t( PurLedger.salesmancode IN \n\t\t(\n\t\t\t\tSelect \tDistinct U.usercode\n\t\t\t\tFrom   \tUsers U, UserGroups UG, GroupAllowedGroups GAG\n\t\t\t\tWhere  \tU.UserCode = UG.UserCode And UG.GroupCode = GAG.AllowedGroupCode And \n\t\t\t\t\t\t\tGAG.GroupCode = :ai_groupcode And GAG.Module = :ai_module\n\t\t\t\tUnion \n\t\t\t\tSelect   U.Usercode\n\t\t\t\tFrom     Users U, UserGroups UG\n\t\t\t\tWhere    U.usercode = UG.usercode And UG.GroupCode = :ai_groupcode\n\t\t  )\n\t) And\n\tExists (SELECT DBO.Fn_GetPreference('allowedgroupsinpurchaselist') \n\tWHERE DBO.Fn_GetPreference('allowedgroupsinpurchaselist') = 'Y')",
  "arguments": {
   "_items": [
