  "retrieve": "SELECT \n\tCode=TransferRequisitionHeader.TransReqCode,   \n\tTransferRequisitionHeader.Date,   \n\tSourceGodown= (SELECT name from Godown WHERE gcode = TransferRequisitionHeader.SGCode),\n\tTargetGodown= (SELECT name from Godown WHERE gcode = TransferRequisitionHeader.DGCode),\n\tTransferRequisitionHeader.Posted,   \n\tTransferRequisitionHeader.PostDate,   \n\tPostedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode = TransferRequisitionHeader.PostedBy),\n\tTransferRequisitionHeader.SalesManCode,   \n\tUsers.UserName,\n\tTransferType = (SELECT T.Name FROM TransferType T WHERE T.TTCode = TransferRequisitionHeader.TTCode)\nFROM\n\tTransferRequisitionHeader, Users\nWHERE \n\tUsers.UserCode = TransferRequisitionHeader.SalesManCode AND \n\tTransferRequisitionHeader.SalesManCode = Users.UserCode\n",
  "sort": "code A"
