  "retrieve": "SELECT \n\tcurrlistrow = 0,\n\tstock     = 0.0000, \n\ttotalstock= 0.0000, \n\tTD.transcode,\n\tTD.icode,  \n\tI.customicode,  \n\tTH.posted,\n\tTH.dgcode,\n\tremarks=max(TH.remarks),\n\tTH.sgcode,\n\tsourcegodown=(SELECT  GC.NAME FROM GODOWN GC WHERE GC.GCODE=TH.sgcode),\n\ttargetgodown=(SELECT  GD.NAME FROM GODOWN GD WHERE GD.GCODE=TH.dgcode),\n\titemname = I.name, \n\tId   = TD.IDENTITYCOL,\n\trequiredqty =MAX(TD.RequiredQty),\n\treorderqty = MAX(TD.ReorderQty) ,\n\toptimumqty = MAX(TD.OptimumQty ),\n\ttargetstk = SUM(TD.targetstock),\n\tsourcestk = SUM(TD.sourcestock),\n\tqty  = sum(TD.qty),\n\theaderno=max(TH.headerno),\n\tsaleprice=(max(TD.saleprice)/ISNULL(max(TD.packunits),1)),\n\tbatch=max(TD.batch),\n\texpiry=min(TD.expiry),\n\tPackCapacity = I.PackCapacity,\n\tAreaVolume = I.AreaVolume,\n\tPCS=ROUND(SUM(TD.qty) / CASE WHEN I.AreaVolume > 0 THEN I.AreaVolume ELSE 1 END, 6),\n\tCartons= LTRIM(RTRIM(STR(CAST(((ROUND(SUM(TD.qty) / CASE WHEN I.AreaVolume > 0 THEN I.AreaVolume ELSE 1 END, 6)) / CASE WHEN I.PackCapacity > 0 THEN I.PackCapacity ELSE 1 END) AS INT), 7, 0))) + ' : ' +\n\t\tLTRIM(RTRIM(STR(((CAST(ROUND(SUM(TD.qty) / CASE WHEN I.AreaVolume > 0 THEN I.AreaVolume ELSE 1 END, 6) AS INT)) % CAST(CASE WHEN I.PackCapacity > 0 THEN I.PackCapacity ELSE 1 END AS INT)), 7, 0))),\n\tsavedate=TH.date,\n\tPostDate=TH.postdate\nFROM \n\ttdetail TD, theader TH, item  I\nWHERE \n\t( TH.transcode = :ar_tCode ) AND\n\t( TD.transcode = TH.transcode ) AND\n\t( TD.icode = I.icode )\nGROUP BY \n\tTD.transcode, \n\tTH.sgcode,\n\tTH.dgcode,\n\tTH.posted,\n\tTH.date,\n\tTH.postdate,\n\tTD.icode, \n\tI.customicode, \n\tI.name,\n\tI.PackCapacity,\n\tI.AreaVolume,\n\tId\nORDER BY \n\tId\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_tcode",
      "number"
     ]
    }
   ]
  }
 },
