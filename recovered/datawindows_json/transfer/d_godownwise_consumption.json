    "dbname": "NetSaleQty"
   }
  ],
  "retrieve": "Select target.icode, itemcategory, itemname, IsNull(source.currqty, 0) As SourceQty, target.NetSaleQty \nFrom ( \n\tSelect godowndetail.icode , IsNull(Sum(godowndetail.currqty) , 0 ) as currqty\n\tFrom godowndetail, Item , ItemCategory\n\twhere godowndetail.gcode = :ai_SGCode AND\n\t\t   godowndetail.icode = item.icode AND\n         item.icatcode = itemcategory.icatcode AND\n         itemcategory.icatcode In (:ai_icatcode) \t\t\n\tGroup By godowndetail.icode\n\t) source Right Outer Join\n\t(\n\tSelect S.icode , S.ItemCategory, S.ItemName, (SaleQty - IsNull(SaleRetQty,0)) As NetSaleQty\n\tFrom (\n\t\tSelect saledetail.icode , ItemCategory.Name As ItemCategory, Item.Name As ItemName, IsNull ( Sum(saledetail.looseqty + saledetail.bonusqty) , 0) As SaleQty\n\t\tFrom Saleledger , Saledetail , Item , ItemCategory\n\t\tWhere Saleledger.saleinvcode = saledetail.saleinvcode AND\n\t\t\t\tsaleledger.date between :ad_startdate and :ad_enddate AND\n\t\t\t\tsaledetail.icode = item.icode AND\n\t\t\t\titem.icatcode = itemcategory.icatcode AND\n            itemcategory.icatcode In (:ai_icatcode) AND\n\t\t\t\tsaledetail.gcode = :ai_TGCode\n\t\tGroup By saledetail.icode, ItemCategory.Name, Item.Name\n\t\t) S Left Outer Join \n\t\t(\n\t\tSelect srdetail.icode , ItemCategory.Name As ItemCategory, Item.Name As ItemName, IsNull ( Sum(srdetail.looseqty + srdetail.bonusqty) , 0) As SaleRetQty\n\t\tFrom Srledger , Srdetail , Item, ItemCategory\n\t\tWhere srledger.srinvcode = srdetail.srinvcode AND\n\t\t\t\tsrledger.date between :ad_startdate and :ad_enddate AND\n\t\t\t\tsrdetail.icode = item.icode AND\n            item.icatcode = ItemCategory.icatcode AND\n\t\t\t\titemCategory.icatcode In (:ai_icatcode) AND\n\t\t\t\tsrdetail.gcode = :ai_TGCode\n\t\tGroup By srdetail.icode, ItemCategory.Name, Item.Name\n\t\t) Sr \n\tOn S.icode = Sr.icode\n\tWhere (SaleQty - IsNull(SaleRetQty,0) ) > 0\n\t) target\nOn target.icode = source.icode\nOrder By ItemCategory, ItemName",
  "arguments": {
