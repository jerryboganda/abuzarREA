  "retrieve": "SELECT \n\tcurrlistrow = 0,\n\tstock     = 0.0000, \n\ttotalstock= 0.0000, \n\tTD.transcode,\n\tTD.icode, \n\tI.customicode,\n\tTH.posted,\n\tTH.dgcode,\n\tremarks=max(TH.remarks),\n\tTH.sgcode,\n\tsourcegodown=(SELECT  GC.NAME FROM GODOWN GC WHERE GC.GCODE=TH.sgcode),\n\ttargetgodown=(SELECT  GD.NAME FROM GODOWN GD WHERE GD.GCODE=TH.dgcode),\n\titemname = I.name, \n\titemlocation=max(I.location),\n\tId   = TD.IDENTITYCOL,\n\trequiredqty =(SELECT IC.goptimumqty * IC.packunits FROM  item IC WHERE IC.icode=TD.icode )  - ISNULL((SELECT sum(currqty) FROM  godowndetail G WHERE G.icode=TD.icode AND G.gcode=TH.dgcode),0) ,\n\treorderqty = (SELECT IC.greorderqty * IC.packunits FROM  item IC WHERE IC.icode=TD.icode ) ,\n\toptimumqty = (SELECT IC.goptimumqty * IC.packunits FROM  item IC WHERE IC.icode=TD.icode ) ,\n\ttargetstk = ISNULL((SELECT sum(currqty) FROM  godowndetail G WHERE G.icode=TD.icode AND G.gcode=TH.dgcode),0) ,\n\tsourcestk = ISNULL((SELECT sum(currqty) FROM  godowndetail G WHERE G.icode=TD.icode AND G.gcode=TH.sgcode) ,0),\n\tqty  = sum(TD.qty),\n\theaderno=max(TH.headerno)\nFROM \n\ttdetail TD, \n\ttheader TH, \n\titem  I\nWHERE \n\t(TH.transcode = :ar_tCode) AND\n\t( TD.transcode = TH.transcode ) AND\n\t( TD.icode = I.icode )\nGROUP BY \n\tTD.transcode, \n\tTH.sgcode,\n\tTH.dgcode,\n\tTH.posted,\n\tTD.icode, \n\tI.customicode, \n\tI.name,\n\tId\nORDER BY \n\tId\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_tcode",
      "number"
     ]
    }
   ]
  }
 },
