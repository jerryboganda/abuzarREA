  "retrieve": "SELECT\n\tdbo.item.icode,\n\tdbo.item.customicode,\n\tdbo.item.name,\n\tdbo.item.manfcode, \n\tdbo.item.packunits,\n\tdbo.item.purprice,\n\tdbo.item.saleprice,\n\tdbo.Manufacturer.name, \n\tstock = (select\tsum(dbo.godowndetail.currqty)\n\t\tfrom\tdbo.godowndetail \n\t\twhere\tdbo.godowndetail.gcode = :ai_sourcegcode AND\n\t\t\t\tdbo.godowndetail.icode = dbo.item.icode),\n\tPacking = dbo.itempacking.name,\n\tdbo.item.itemalertcode,\n\titemalerttypecode = (select ia.itemalerttypecode from itemalert ia where ia.itemalertcode = item.itemalertcode),\n\tdbo.item.restricted,\n\tdbo.item.location,\n\tdbo.item.packingdesc,\n\ttransitstock=dbo.item.transitstock,\n\tBGColor = (SELECT IA.BGColor FROM ItemAlert IA WHERE IA.ItemAlertCode = dbo.item.itemalertcode)\nFROM\t\n\tdbo.item\n\tLEFT OUTER JOIN dbo.itempacking ON (dbo.item.packcode = dbo.itempacking.packcode), \n\tdbo.Manufacturer\nWHERE\t\n\tdbo.item.Active = 1 and\n\tdbo.Manufacturer.manfcode = dbo.item.manfcode \nORDER BY \n\tdbo.item.name\n",
