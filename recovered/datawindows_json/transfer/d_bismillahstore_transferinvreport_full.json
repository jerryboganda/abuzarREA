  "retrieve": "SELECT \n\tcurrlistrow = 0,\n\tstock     = 0.0000, \n\ttotalstock= 0.0000, \n\tTD.transcode,\n\tTD.icode,  \n\tI.customicode,  \n\tTH.posted,\n\tTH.dgcode,\n\tremarks=max(TH.remarks),\n\tTH.sgcode,\n\tsourcegodown=(SELECT  GC.NAME + '-' + GC.Location FROM GODOWN GC WHERE GC.GCODE=TH.sgcode),\n\ttargetgodown=(SELECT  GD.NAME + '-' + GD.Location FROM GODOWN GD WHERE GD.GCODE=TH.dgcode),\n\titemname = I.name, \n\tPacking = (SELECT P.NAME FROM ItemPacking P WHERE P.PackCode = I.PackCode),\n\tId   = TD.IDENTITYCOL,\n\trequiredqty =MAX(TD.RequiredQty),\n\treorderqty = MAX(TD.ReorderQty) ,\n\toptimumqty = MAX(TD.OptimumQty ),\n\ttargetstk = SUM(TD.targetstock),\n\tsourcestk = SUM(TD.sourcestock),\n\tqty  = sum(TD.qty),\n\theaderno=max(TH.headerno),\n\tsaleprice=(max(TD.saleprice)/ISNULL(max(TD.packunits),1)),\n\tbatch=max(TD.batch),\n\texpiry=min(TD.expiry),\n\tsavedate=TH.date,\n\tPostDate=TH.postdate\nFROM \n\ttdetail TD, theader TH, item  I\nWHERE \n\t( TH.transcode = :ar_tCode ) AND\n\t( TD.transcode = TH.transcode ) AND\n\t( TD.icode = I.icode )\nGROUP BY \n\tTD.transcode, \n\tTH.sgcode,\n\tTH.dgcode,\n\tTH.posted,\n\tTH.date,\n\tTH.postdate,\n\tTD.icode, \n\tI.customicode, \n\tI.name,\n\tI.PackCode,\n\tId\nORDER BY \n\tId\n\t\n\t\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_tcode",
      "number"
     ]
    }
   ]
  }
 },
