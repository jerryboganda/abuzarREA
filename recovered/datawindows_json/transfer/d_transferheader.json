  "retrieve": "SELECT  theader.transcode ,\n           theader.dgcode ,\n           theader.sgcode ,\n           theader.remarks ,\n           theader.date ,\n           theader.posted ,\n           theader.postdate ,\n           theader.salesmancode ,\n           salesman.name ,\n           sglocation=godown_a.location ,\n           dglocation=godown_b.location     \n        FROM theader ,\n           salesman ,\n           godown godown_a ,\n           godown godown_b     \n        WHERE ( salesman.salesmancode = theader.salesmancode ) and          ( theader.sgcode = godown_a.gcode ) and          ( theader.dgcode = godown_b.gcode ) and          ( ( dbo.theader.transcode = :ar_transcode ) )  ",
