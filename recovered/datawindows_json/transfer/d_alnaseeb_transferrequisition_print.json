  "retrieve": "SELECT \n\tcurrlistrow = 0,\n\tstock     = 0.0000, \n\ttotalstock= 0.0000, \n\tcode=TD.transreqcode,\n\tTD.icode,  \n\tI.customicode,  \n\tTH.posted,\n\tTH.dgcode,\n\tremarks=max(TH.remarks),\n\tTH.sgcode,\n\tsourcegodown=(SELECT  GC.NAME FROM GODOWN GC WHERE GC.GCODE=TH.sgcode),\n\tLocalsourcegodown=(SELECT  GC.LocalGodownName FROM GODOWN GC WHERE GC.GCODE=TH.sgcode),\n\ttargetgodown=(SELECT  GD.NAME FROM GODOWN GD WHERE GD.GCODE=TH.dgcode),\n\tlocaltargetgodown=(SELECT  GD.LocalGodownName FROM GODOWN GD WHERE GD.GCODE=TH.dgcode),\n\titemname = CASE WHEN I.LocalItemName IS NULL THEN I.name ELSE I.LocalItemName END, \n\titemdescription = TD.itemdescription,\n\trequiredqty =MAX(TD.RequiredQty),\n\treorderqty = MAX(TD.ReorderQty) ,\n\toptimumqty = MAX(TD.OptimumQty ),\n\ttargetstk = SUM(TD.targetstock),\n\tsourcestk = SUM(TD.sourcestock),\n\tqty  = sum(TD.qty),\n\tsaleprice=(max(TD.saleprice)/ISNULL(max(TD.packunits),1)),\n\tsavedate=TH.date,\n\tPostDate=TH.postdate\nFROM \n\tTransferRequisitionDetail TD, \n\tTransferRequisitionHeader TH,\n\tItem  I\nWHERE \n\t(TH.transreqcode = :ar_tCode) AND\n\t( TD.transreqcode = TH.transreqcode ) AND\n\t( TD.icode = I.icode )\nGROUP BY \n\tTD.transreqcode, \n\tTH.sgcode,\n\tTH.dgcode,\n\tTH.Date,\n\tTH.postdate,\n\tTH.posted,\n\tTD.icode, \n\tI.customicode, \n\tI.name,\n\tTD.itemdescription,\n\tI.localitemname\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_tcode",
      "number"
     ]
    }
   ]
  }
 },
