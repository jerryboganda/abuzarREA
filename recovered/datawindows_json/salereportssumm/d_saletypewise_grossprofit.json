 "table": {
  "columns": [
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "saletype",
    "dbname": "SaleType"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "sales",
    "dbname": "Sales"
   },
   {
    "type": "decimal(9)",
    "updatewhereclause": "yes",
    "name": "cost",
    "dbname": "Cost"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "gp",
    "dbname": "GP"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "gprate",
    "dbname": "GPRate"
   }
  ],
  "retrieve": "SELECT \n\tSaleType=S.SaleType, \n\tSales=SUM(S.Sales), \n\tCost=SUM(S.Cost),\n\tGP = SUM(S.Sales) - SUM(S.Cost),\n\tGPRate = ((SUM(S.Sales) - SUM(S.Cost)) / CASE WHEN SUM(S.Sales) <> 0 THEN SUM(S.Sales) ELSE 1 END) * 100\nFROM\n\t(SELECT \n\t\tSaleType=ST.Name, Sales=0.00, Cost=0.00\n\tFROM SaleType ST\n\tUNION ALL\n\tSELECT \n\t\tSaleType=ST.Name, Sales=SUM(S.InvTotal), Cost=ISNULL((SELECT SUM((D.LooseQty + D.BonusQty) * D.AvgPrice) FROM SaleDetail D WHERE S.SaleInvCode=D.SaleInvCode), 0)\n\tFROM \n\t\tSaleType ST, SaleLedger S\n\tWHERE\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.SaleTypeCode = ST.SaleTypeCode AND\n\t\tST.SaleTypeCode IN (:ai_saletypecode)\n\t\t\n\tGROUP BY \n\t\tST.Name,\n\t\tS.SaleInvCode) S\nGROUP BY \n\tSaleType",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_saletypecode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
