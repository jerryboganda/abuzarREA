  "retrieve": "SELECT itemname = dbo.item.name,\n       itemcode = dbo.item.icode,\n\t ReorderLevel = dbo.item.ReorderLevel,\t \n\t Manufacturer= dbo.Manufacturer.name, \n\t saleqty = Sum(dbo.saledetail.looseqty),\t\t \n\tsalevalue = Sum(dbo.saledetail.looseqty) * (Max(dbo.item.saleprice) / Max(dbo.item.packunits)),\t\n\t currqty = IsNull((Select  sum(currqty) \t\n\t\t\tfrom godowndetail \t\n\t\t\twhere dbo.item.icode = godowndetail.icode),0),\n\tstockvalue = IsNull((Select  sum(currqty) \t\n\t\t\tfrom godowndetail \t\n\t\t\twhere dbo.item.icode = godowndetail.icode),0)   * (Max(dbo.item.saleprice) / Max(dbo.item.packunits))\n\t\nFROM dbo.saleledger,\t \n\t dbo.saledetail,\n\t dbo.item,\n\t dbo.Manufacturer\t\n\nWHERE dbo.saleledger.date >= :ad_StartDate and \t\n\tdbo.saleledger.date <= :ad_EndDate and \t\n\tdbo.saleledger.salecatcode IN (1, 2, 3) and\t \n\tdbo.Item.manfcode IN (:ana_manfcode) and\n\tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and\t   \n\tdbo.saledetail.icode = dbo.item.icode and \n\tdbo.item.manfcode = dbo.Manufacturer.manfcode \n\t \t\t \nGROUP BY Manufacturer.Name, item.name, item.icode, dbo.item.ReorderLevel\t \n\nUnion \n\nSELECT itemname = dbo.item.name,\t\t\n       itemcode = dbo.item.icode,\n\tReorderLevel = dbo.item.ReorderLevel,\t \n\tManufacturer= dbo.Manufacturer.name, \n       saleqty = 0, \t \n\tsalevalue = 0,\t\n\tcurrqty = IsNull((Select  sum(currqty) \t\n\t\t\tfrom godowndetail \t\n\t\t\twhere dbo.item.icode = godowndetail.icode),0),\n\tstockvalue = IsNull((Select  sum(currqty) \t\n\t\t\tfrom godowndetail \t\n\t\t\twhere dbo.item.icode = godowndetail.icode),0)   * (Max(dbo.item.saleprice) / Max(dbo.item.packunits))\n\t  \t\nFROM \t dbo.item,\n\t dbo.Manufacturer\t\n\nWHERE   dbo.item.icode Not in  (Select saledetail.icode\n\t\t\t\tFrom Saleledger,saledetail\n\t\t\t\tWhere \tdbo.saleledger.date >= :ad_StartDate and \t\n\t\t\t\t \t   dbo.saleledger.date <= :ad_EndDate and \t\n\t\t\t\t\t   dbo.saleledger.salecatcode IN (1, 2, 3) and\t \n\t\t\t\t\t   dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) and\n\t dbo.Item.manfcode IN (:ana_manfcode) and\n\t Item.manfcode = manufacturer.manfcode\t\t\t \nGROUP BY Manufacturer.Name, item.name, item.icode, dbo.item.ReorderLevel",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ana_manfcode",
      "numberlist"
