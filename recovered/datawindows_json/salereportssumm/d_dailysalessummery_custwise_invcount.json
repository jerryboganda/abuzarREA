  ],
  "retrieve": "SELECT\n\tAliasName,\n\tCustomerName,\n\tSaleCount = SUM(SaleCount),\n\tSales = SUM(Sales),\n\tRerturns = SUM(Rerturns),\n\tReturnCount = SUM(ReturnCount),\n\tNetSale=SUM(Sales) - SUM(Rerturns)\nFROM \n\t(SELECT \n\t\tType = 'S',\n\t\tAliasName=A.AliasName,\n\t\tCustomerName = A.Name,\n\t\tSaleCount = COUNT(S.SaleInvCode),\n\t\tSales = SUM(S.InvTotal),\n\t\tRerturns = 0.00,\n\t\tReturnCount = 0\n\tFROM\n\t\tSaleLedger S, Accounts A\n\tWHERE\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.CustCode = A.AccCode\n\tGROUP BY\n\t\tA.Name, A.AliasName\n\tUNION ALL\n\tSELECT \n\t\tType = 'R',\n\t\tAliasName=A.AliasName,\n\t\tCustomerName = A.Name,\n\t\tSaleCount = 0,\n\t\tSales = 0.00,\n\t\tRerturns = SUM(S.InvTotal),\n\t\tReturnCount = COUNT(S.SRInvCode)\n\tFROM\n\t\tSRLedger S, Accounts A\n\tWHERE\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.CustCode = A.AccCode\n\tGROUP BY\n\t\tA.Name, A.AliasName) SL\nGROUP BY\n\tAliasName,\n\tCustomerName\n",
  "arguments": {
   "_items": [
    {
     "_items": [
