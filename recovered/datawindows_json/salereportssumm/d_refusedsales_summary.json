    "name": "value",
    "dbname": "Value"
   }
  ],
  "retrieve": "SELECT \n\tICode=D.ICode, \n\tItemAliasName = ISNULL((SELECT Item.CustomICode FROM ITEM WHERE ITEM.ICode = D.ICode), NULL),\n\tItemName = ISNULL((SELECT Item.Name FROM ITEM WHERE ITEM.ICode = D.ICode), MAX(D.UnKnownItemName)),\n\tQty=SUM(D.Qty), \n\tPrice=Max(D.SalePrice),\n\tRemarks=MAX(D.Remarks),\n\tTotalStock=MAX(D.TotalStock),\n\tCurrStock = ISNULL((SELECT SUM(G.CurrQty) FROM GodownDetail G WHERE G.ICode = D.ICode), 0),\n\tValue = SUM(D.Qty * D.SalePrice)\nFROM \n\tRefusedSaleHeader S, RefusedSaleDetail D, SaleRefusalReason SRR\nWHERE \n\tS.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\tS.RefusedSaleInvCode = D.RefusedSaleInvCode AND\n\tD.ReasonCode = SRR.ReasonCode\nGROUP BY\n\tD.ICode\nORDER BY\n\tItemName\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
