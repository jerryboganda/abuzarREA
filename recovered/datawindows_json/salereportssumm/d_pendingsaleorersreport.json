    "updatewhereclause": "yes",
    "name": "issueqty",
    "dbname": "IssueQty"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "orderrate",
    "dbname": "OrderRate"
   }
  ],
  "retrieve": "SELECT  \n\tSaleOrderCode=H.SaleOrderCode, \n\tOrderCode=H.OrderCode,\n\tDate = H.Date,\n\tNetAmt = H.InvTotal,\n\tCustomer = A.Name,\n\tOrderDate=H.BillingDate,\n\tDeliveryDeadline=H.DeliveryDeadline,\n\tAliasName = I.CustomICode,\n\tItemName=I.Name,\n\tmanf=(select name from manufacturer where manufacturer.manfcode=I.manfcode),\n\tOrderQty = D.LooseQty + D.BonusQty,\n\tSoldQty = ISNULL((SELECT Qty=SUM(SD.LooseQty + SD.BonusQty) FROM SaleDetail SD WHERE SD.SaleOrderRowID = D.RowID), 0),\n\tIssueQty = ISNULL((SELECT Qty=SUM(SD.Qty) FROM IssueDetail SD WHERE SD.SaleOrderRowID = D.RowID), 0),\n\tOrderRate = D.SalePrice\nFROM \n\tSaleOrderHeader H, \n\tSaleOrderDetail D, \n\tAccounts A,\n\tItem I\nWHERE \n\tH.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tH.Finalized = 'Y' AND\n\tH.CustCode = A.AccCode AND\n\tH.SaleOrderCode = D.SaleOrderCode  AND\n\tD.ICode = I.ICode\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "saleordercode A, itemname A",
  "filter": "(orderqty - (soldqty + issueqty)) > 0"
 },
