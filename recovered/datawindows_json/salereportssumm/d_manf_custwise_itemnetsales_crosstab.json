    "name": "qty",
    "dbname": "qty"
   }
  ],
  "retrieve": "SELECT \n\tArea=A.Name,\n\tCustomerName = AC.Name,\n\tAddress = C.Address1,\n\tPeiod = LTRIM(RTRIM(CONVERT(VARCHAR(100), :adt_startdate, 103))) + ' - ' + LTRIM(RTRIM(CONVERT(VARCHAR(100), :adt_enddate, 103))),\n\tICode=I.ICode,\n\tItemName=I.ShortName,\n\tQty = SUM(T.Qty + CASE WHEN :ai_bonus = 1 THEN T.BonusQty ELSE 0 END)\nFROM\n\t(SELECT II.ICode, II.Name, II.ShortName, II.ManfCode FROM Item II WHERE II.ManfCode = :ai_ManfCode) AS I, \n\tArea A,\n\tAccounts AC,\n\tCustomer C,\n\t(SELECT \n\t\tC.CustCode,\n\t\tI.ICode,\n\t\tQty = SUM(D.LooseQty),\n\t\tBonusQty = SUM(D.BonusQty)\n\tFROM \n\t\tSaleLedger S, SaleDetail D, \n\t\t(SELECT II.ICode FROM Item II WHERE II.ManfCode = :ai_ManfCode) AS I, \n\t\t(SELECT CC.CustCode, CC.AreaCode \n\t\tFROM Area AA, Customer CC\n\t\tWHERE AA.AreaCode IN (:ai_areacode) AND AA.AreaCode = CC.AreaCode) C\n\tWHERE\n\t\tC.CustCode = S.CustCode AND\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.Posted = 'Y' AND S.SaleInvCode = D.SaleInvCode AND\n\t\tD.ICode = I.ICode\n\tGROUP BY\n\t\tC.AreaCode,\n\t\tC.CustCode,\n\t\tI.ICode\n\tUNION ALL\n\tSELECT \n\t\tC.CustCode,\n\t\tI.ICode,\n\t\tQty = SUM(D.LooseQty),\n\t\tBonusQty = SUM(D.BonusQty)\n\tFROM \n\t\tSaleLedger S, SaleInvDetail D, \n\t\t(SELECT II.ICode FROM Item II WHERE II.ManfCode = :ai_ManfCode) AS I, \n\t\t(SELECT CC.CustCode, CC.AreaCode \n\t\tFROM Area AA, Customer CC\n\t\tWHERE AA.AreaCode IN (:ai_areacode) AND AA.AreaCode = CC.AreaCode) C\n\tWHERE\n\t\tC.CustCode = S.CustCode AND\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.Posted = 'Y' AND S.SaleInvCode = D.SaleInvCode AND\n\t\tD.ICode = I.ICode\n\tGROUP BY\n\t\tC.CustCode,\n\t\tI.ICode\n\tUNION ALL\n\tSELECT \n\t\tC.CustCode,\n\t\tI.ICode,\n\t\tQty = -SUM(D.LooseQty),\n\t\tBonusQty = - SUM(D.BonusQty)\n\tFROM \n\t\tSRLedger S, SRDetail D, \n\t\t(SELECT II.ICode FROM Item II WHERE II.ManfCode = :ai_ManfCode) AS I, \n\t\t(SELECT CC.CustCode, CC.AreaCode \n\t\tFROM Area AA, Customer CC\n\t\tWHERE AA.AreaCode IN (:ai_areacode) AND AA.AreaCode = CC.AreaCode) C\n\tWHERE\n\t\tC.CustCode = S.CustCode AND\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.Posted = 'Y' AND S.SRInvCode = D.SRInvCode AND\n\t\tD.ICode = I.ICode\n\tGROUP BY\n\t\tC.CustCode,\n\t\tI.ICode) T\nWHERE \n\tT.ICode = I.ICode AND\n\tT.CustCode = C.CustCode AND\n\tC.AreaCode = A.AreaCode AND\n\tC.CustCode = AC.AccCode\nGROUP BY\n\tA.Name,\n\tAC.Name,\n\tC.Address1,\n\tI.ICode,\n\tI.ShortName\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
