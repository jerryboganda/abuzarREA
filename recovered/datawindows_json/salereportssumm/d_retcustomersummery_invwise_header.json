  "retrieve": "SELECT \n\tinvcode     = h.srinvcode,    \n\tdate        = h.date,    \n\tflatdisc    = h.flatdisc,  \n\tsalestax    = h.salestax,       \n\tmisccharges = h.misccharges, \n\tinvdiscperc = h.discperc, \n\tinvgstperc1 = h.invgstperc1,\n\tdoctype = Case h.srcatcode When 6 Then 'Cash' When 7 Then 'Credit' Else 'Cash' End, \n\tcustname = dbo.accounts.name, \n\tamount =  Round(Sum ( d.looseqty * d.srprice), 2),    \n\titemdiscpercvalue = Round(Sum ( d.looseqty  * d.srprice * (d.discperc * .01)), 2),    \n\tinvdiscpercvalue = Round(Sum ( (d.looseqty  ) * d.srprice * (1 - (d.discperc * .01))) * (h.discperc /100), 2)     ,\n\tsaleinvcode= h.saleinvcode,\n\tremarks=h.remarks,\n\tUsers=max(users.username),\n\titemsalestax = Sum (Round ( (d.looseqty  + d.bonusqty) * d.unitsalestax + Round ( Round ( d.looseqty * d.srprice * (1 - d.discperc * 0.01 ), 2 ) * d.gstperc * 0.01 , 2 ) , 2 ) )\nFROM \n\tdbo.srledger h, \n\tdbo.srdetail d,   \n\tdbo.accounts,\n\tusers  \nWHERE \n\t( h.headerno=:ai_headerno)and\n\t( h.headerinvno between :ar_StartInv and :ar_EndInv) and\n\t( h.srcatcode IN (:ai_retail,:ai_cash,:ai_credit))and  \n\t( h.srinvcode = d.srinvcode ) and  \n\t( h.custcode = dbo.accounts.acccode )and \n\t( h.salesmancode=users.usercode)\nGROUP BY \n\th.misccharges,   \n\th.flatdisc,   \n\th.date,   \n\th.srinvcode,   \n\th.discperc,  \n\th.invgstperc1,\n\th.salestax, \n\th.srcatcode, \n\tdbo.accounts.name ,\n\th.saleinvcode ,   \n\th.remarks\nUNION\nSELECT \n\tinvcode     = h.srbufferinvcode,    \n\tdate        = h.date,    \n\tflatdisc    = h.flatdisc, \n\tsalestax    = h.salestax,       \n\tmisccharges = h.misccharges, \n\tinvdiscperc = h.discperc, \n\tinvgstperc1 = h.invgstperc1,\n\tdoctype = Case h.srcatcode When 6 Then 'Cash' When 7 Then 'Credit' Else 'Cash' End, \n\tcustname = dbo.accounts.name, \n\tamount =  Round(Sum ( d.looseqty * d.srprice), 2),    \n\titemdiscpercvalue = Round(Sum ( d.looseqty  * d.srprice * (d.discperc * .01)), 2),    \n\tinvdiscpercvalue = Round(Sum ( (d.looseqty  ) * d.srprice * (1 - (d.discperc * .01))) * (h.discperc /100), 2)     ,\n\tsaleinvcode= h.saleinvcode,\n\tremarks=h.remarks,\n\tUsers=max(users.username),\n\titemsalestax = Sum (Round ( (d.looseqty  + d.bonusqty) * d.unitsalestax + Round ( Round ( d.looseqty * d.srprice * (1 - d.discperc * 0.01 ), 2 ) * d.gstperc * 0.01 , 2 ) , 2 ) )\nFROM \n\tdbo.srbufferledger h, \n\tdbo.srbufferdetail d,   \n\tdbo.accounts,\n\tusers  \nWHERE \n\t( h.posted = 'N' ) AND\n\t( h.headerno=:ai_headerno)and\n\t( h.headerinvno between :ar_StartInv and :ar_EndInv) and\n\t( h.srcatcode IN (:ai_retail,:ai_cash,:ai_credit))and  \n\t( h.srbufferinvcode = d.srbufferinvcode ) and  \n\t( h.custcode = dbo.accounts.acccode )and \n\t( h.salesmancode=users.usercode)\nGROUP BY \n\th.misccharges,   \n\th.flatdisc,   \n\th.date,   \n\th.srbufferinvcode,   \n\th.discperc,  \n\th.invgstperc1,\n\th.salestax, \n\th.srcatcode, \n\tdbo.accounts.name ,\n\th.saleinvcode ,   \n\th.remarks\nORDER BY \n\tcustname\n\t\n",
