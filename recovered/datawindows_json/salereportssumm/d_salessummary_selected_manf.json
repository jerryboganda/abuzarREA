  "retrieve": "SELECT itemcode=I.icode,\n\t\t\titemname=I.name, \n\t\t\tManf=(select name from manufacturer M where M.manfcode=I.manfcode),\n\t\t\t/*supplier=(select suppcode=min(suppcode) from \titemsuppliers ,\n\t\t\t\t\t\t\t\t\t( select prority=min(priority) from itemsuppliers  Where itemsuppliers.icode=I.icode) as b\n\t\t\t\t\t\t\t\t where itemsuppliers.icode=I.icode and itemsuppliers.priority=b.prority) ,\n\t\t\t*/\n\t\t\tsupplier=(select name from accounts where accounts.acccode=max(S.suppcode)),\n\t\t\tdays=max(S.days),\n\t\t\ttotaldays=DateDiff(d,:ad_startdate,:ad_enddate),\n\t\t\tpackprice=I.purprice,\n\t\t\tpackunits=I.packunits,\n\t\t\tunitprice=I.purprice/(case I.packunits when 0 then 1 else I.packunits end),\n\t\t\tstock=ISNULL((select isnull(sum(currqty),0) from godowndetail GD where GD.icode=I.icode group by GD.icode),0),\n\t\t\tstockval=\t(select isnull(sum(currqty),0) from godowndetail GD where GD.icode=I.icode group by GD.icode)\n\t\t\t\t\t\t\t*\n\t\t\t\t\t\t\t(I.purprice/(case I.packunits when 0 then 1 else I.packunits end)) ,\n\t\t\n\t\t\tnetsale= isnull(sum(A.qty),0),\n\t\t\tperdayconsumption=isnull(sum(A.qty),0)/ (case DateDiff(d,:ad_startdate,:ad_enddate) when 0 then 1 else DateDiff(d,:ad_startdate,:ad_enddate) end)\n\t\n\nFROM \tItem I,\n\t\t\t(select SD.icode,qty=ISNULL(sum(SD.looseqty),0) from saleledger SL, saledetail SD, item where SL.date>=:ad_StartDate and SL.date<=:ad_EndDate and SL.saleinvcode=SD.saleinvcode and item.icode=SD.icode and item.manfcode IN (:aa_manfcode) group by SD.icode\n\t\t\t\tunion All\n\t\t\t\tselect SD.icode,qty= - ISNULL(sum(SD.looseqty),0) from srledger SL, srdetail SD, item where SL.date>=:ad_StartDate and SL.date<=:ad_EndDate and SL.srinvcode=SD.srinvcode and item.icode=SD.icode and item.manfcode IN (:aa_manfcode) group by SD.icode\n\t\t\t) AS A,\n\t\t\n\t\t\t(select P.icode,suppcode,days from  itemsuppliers,\n\t\t\t\t\t(select priority=min(priority),icode from itemsuppliers \n\t\t\t\t\tgroup by icode ) as P\n\t\t\n\t\t\twhere itemsuppliers.icode=P.icode and\n\t\t\t\titemsuppliers.priority=P.priority\n\t\t\t\n\t\t\tunion all\n\t\t\t\n\t\t\tselect icode,null,0 from item where icode not in (select distinct(icode) from itemsuppliers)\n\t\t\t\n\t\t\t)AS S\n\n\nWHERE \tI.manfcode IN (:aa_manfcode) AND\n\t\t\tI.icode=A.icode AND\n\t\t\tI.icode=S.icode\n\t\nGROUP BY \tI.icode,\n\t\t\t\tI.name,\n\t\t\t\tI.purprice,\n\t\t\t\tI.packunits,\n\t\t\t\tI.manfcode\n\t\t\n\t\t\nORDER BY  I.icode",
  "arguments": {
