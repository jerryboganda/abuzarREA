  "retrieve": "SELECT \n\tZoneCode = (SELECT Z.ZoneCode FROM Zone Z WHERE Z.ZoneCode=:ai_zonecode),\n\tZone = (SELECT Z.Name FROM Zone Z WHERE Z.ZoneCode=:ai_zonecode),\n\tManufacturer=M.Name,\n\tItemCategory = IC.Name,\n\tArea = A.Name,\n\tAliasName = I.CustomICode,\n\tItemName = I.Name,\n\tPacking = I.PackingDesc,\n\tSaleQty = SUM(T.SaleQty),\n\tSaleValue = SUM(T.SaleValue),\n\tCustomerCount = COUNT(DISTINCT T.CustCode),\n\tTotalCustCount = ISNULL((SELECT Count(C.CustCode) FROM Customer C WHERE C.AreaCode = T.AreaCode), 0)\nFROM\n\tManufacturer M,\n\tItemCategory IC,\n\tArea A,\n\tItem I,\n\tSalesman S,\n\t(SELECT \n\t\tI.ManfCode,\n\t\tI.ICatCode,\n\t\tI.ICode,\n\t\tZA.AreaCode,\n\t\tSL.CustCode,\n\t\tSaleQty = SUM(SD.LooseQty + SD.BonusQty),\n\t\tSaleValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))\n\tFROM\n\t\tSaleLedger SL,\n\t\tSaleDetail SD,\n\t\tItem I,\n\t\tZone Z,\n\t\tZoneAreas ZA,\n\t\tCustomer C\n\tWHERE\n\t\tZ.ZoneCode = :ai_zonecode AND\n\t\tZ.ZoneCode = ZA.ZoneCode AND\n\t\tZA.AreaCode = C.AreaCode AND\n\t\tC.CustCode = SL.CustCode AND\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.Posted = 'Y' AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = Z.ManfCode AND\n\t\tI.ICatCode = Z.ICatCode\n\tGROUP BY \n\t\tI.ManfCode,\n\t\tI.ICatCode,\n\t\tI.ICode,\n\t\tZA.AreaCode,\n\t\tSL.CustCode\n\tUNION ALL\n\tSELECT \n\t\tI.ManfCode,\n\t\tI.ICatCode,\n\t\tI.ICode,\n\t\tZA.AreaCode,\n\t\tSL.CustCode,\n\t\tSaleQty = SUM(SD.LooseQty + SD.BonusQty),\n\t\tSaleValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))\n\tFROM\n\t\tSaleLedger SL,\n\t\tSaleInvDetail SD,\n\t\tItem I,\n\t\tZone Z,\n\t\tZoneAreas ZA,\n\t\tCustomer C\n\tWHERE\n\t\tZ.ZoneCode = :ai_zonecode AND\n\t\tZ.ZoneCode = ZA.ZoneCode AND\n\t\tZA.AreaCode = C.AreaCode AND\n\t\tC.CustCode = SL.CustCode AND\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.Posted = 'Y' AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = Z.ManfCode AND\n\t\tI.ICatCode = Z.ICatCode\n\tGROUP BY \n\t\tI.ManfCode,\n\t\tI.ICatCode,\n\t\tI.ICode,\n\t\tZA.AreaCode,\n\t\tSL.CustCode\n\tUNION ALL\n\tSELECT \n\t\tI.ManfCode,\n\t\tI.ICatCode,\n\t\tI.ICode,\n\t\tZA.AreaCode,\n\t\tSL.CustCode,\n\t\tSaleQty = - SUM(SD.LooseQty + SD.BonusQty),\n\t\tSaleValue = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))\n\tFROM\n\t\tSRLedger SL,\n\t\tSRDetail SD,\n\t\tItem I,\n\t\tZone Z,\n\t\tZoneAreas ZA,\n\t\tCustomer C\n\tWHERE\n\t\tZ.ZoneCode = :ai_zonecode AND\n\t\tZ.ZoneCode = ZA.ZoneCode AND\n\t\tZA.AreaCode = C.AreaCode AND\n\t\tC.CustCode = SL.CustCode AND\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.Posted = 'Y' AND\n\t\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = Z.ManfCode AND\n\t\tI.ICatCode = Z.ICatCode\n\tGROUP BY \n\t\tI.ManfCode,\n\t\tI.ICatCode,\n\t\tI.ICode,\n\t\tZA.AreaCode,\n\t\tSL.CustCode) T\nWHERE\n\tT.ManfCode = M.ManfCode AND\n\tT.ICatCode = IC.ICatCode AND\n\tT.AreaCode = A.AreaCode AND\n\tT.ICode = I.ICode\nGROUP BY\n\tM.Name,\n\tIC.Name,\n\tT.AreaCode,\n\tA.Name,\n\tI.CustomICode,\n\tI.Name,\n\tI.PackingDesc",
  "arguments": {
   "_items": [
