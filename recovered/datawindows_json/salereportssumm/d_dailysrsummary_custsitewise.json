  "retrieve": "  SELECT invcode     = dbo.srledger.srinvcode,    \n         date        = dbo.srledger.date,    \n         flatdisc    = dbo.srledger.flatdisc,  \n         misccharges = dbo.srledger.misccharges,\n\t\t\tpatient\t\t= (SELECT name FROM patient WHERE patientcode=:ar_patientcode), \n\t\t\tregno       = (SELECT regno FROM patient WHERE patientcode=:ar_patientcode), \n\t\t\tinvdiscperc = dbo.srledger.discperc, \n\t\t\tdoctype = Case dbo.srledger.srcatcode When 8 Then 'Cash' When 7 Then 'Credit' Else 'Credit' End, \n         dbo.accounts.name, \n         amount =  Sum ( dbo.srdetail.looseqty * dbo.srdetail.srprice),    \n\t\t\titemdiscpercvalue = Round(Sum (Round(( (dbo.srdetail.looseqty  * dbo.srdetail.srprice) * (dbo.srdetail.discperc * .01)) , 2) ) , 2),    \n    \t\tinvdiscpercvalue = Sum (Round( (dbo.srdetail.looseqty * dbo.srdetail.srprice) * (1 - (dbo.srdetail.discperc * .01)),2)) * (dbo.srledger.discperc /100) ,\n\t\t\tsalesman = dbo.users.username ,\n    \t\ttotaldiscount= Round(Sum (Round(( (dbo.srdetail.looseqty  * dbo.srdetail.srprice) * (dbo.srdetail.discperc * .01)) ,2)), 2) + Round(Sum ( (dbo.srdetail.looseqty * dbo.srdetail.saleprice) * (1 - (dbo.srdetail.discperc * .01))) * (dbo.srledger.discperc /100), 2) + dbo.srledger.flatdisc,\n\t\t\tdifference= 0, /* Sum ( dbo.srdetail.looseqty * dbo.srdetail.srprice) - sum(Round(srdetail.saleprice/ISNULL(srdetail.packunits ,1),2) * srdetail.looseqty) */\n\t\t\taccountfor=dbo.srledger.accountfor\n\n    FROM dbo.srledger, \n         dbo.srdetail,   \n         dbo.accounts,\n\t\t\tdbo.users  \n\n   WHERE ( dbo.srledger.patientcode = :ar_patientcode ) and\n\t\t\t( dbo.srledger.srinvcode = dbo.srdetail.srinvcode ) and  \n         ( dbo.srledger.custcode = dbo.accounts.acccode )and  \n\t\t\t( dbo.srledger.salesmancode = dbo.users.usercode )and  \n     \t   ( dbo.srledger.date between :ar_StartDate and :ar_EndDate)            \n\nGROUP BY dbo.srledger.misccharges,   \n         dbo.srledger.flatdisc,   \n         dbo.srledger.date,   \n         dbo.srledger.srinvcode,   \n\t\t\tdbo.srledger.discperc,  \n\t\t\tdbo.srledger.srcatcode, \n\t\t\tdbo.srledger.accountfor,\n\t\t\tdbo.accounts.name,\n\t\t\tdbo.users.username \n         \nORDER BY dbo.srledger.srinvcode ASC,   \n         dbo.srledger.date ASC   \n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
