 "table": {
  "columns": [
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "name",
    "dbname": "Manufacturer.NAme"
   },
   {
    "type": "long",
    "key": "yes",
    "updatewhereclause": "yes",
    "name": "manfcode",
    "dbname": "Manufacturer.ManfCode"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "salesperson",
    "dbname": "Salesman"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "sale",
    "dbname": "Sale"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "sreturn",
    "dbname": "SReturn"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "netsale",
    "dbname": "NetSale"
   }
  ],
  "retrieve": "SELECT \n\tM.NAme, \n\tS.ManfCode,\n\tSalesman=(SELECT SM.NAME FROM SALESMAN SM WHERE SM.SALESMANCODE=:ai_SManCode),\n\tSale=SUM(S.SaleAmt),\n\tSReturn=SUM(S.ReturnAmt),\n\tNetSale=SUM(S.SaleAmt - S.ReturnAmt)\nFROM\n\tManufacturer M,\n\t(SELECT\n\t\tI.ManfCode,\n\t\tSaleAmt=SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * \n\t\t\t(1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),\n\t\tReturnAmt=0\n\tFROM\n\t\tSaleLedger SL, SaleDetail SD, Item I, Customer C\n\tWHERE\n\t\tSL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\t\tSL.SManCode = :ai_SManCode AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.AreaCode IN (:ai_AreaCode) AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode = I.ICode \n\tGROUP BY\n\t\tSL.SaleInvCode,\n\t\tSD.ICode,\n\t\tI.ManfCode\n\tUNION ALL\n\tSELECT\n\t\tI.ManfCode,\n\t\tSaleAmt=SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * \n\t\t\t(1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),\n\t\tReturnAmt=0\n\tFROM\n\t\tSaleLedger SL, SaleInvDetail SD, Item I, Customer C\n\tWHERE\n\t\tSL.ImpactInventory = 'N' AND\n\t\tSL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\t\tSL.SManCode = :ai_SManCode AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.AreaCode IN (:ai_AreaCode) AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode = I.ICode \n\tGROUP BY\n\t\tSL.SaleInvCode,\n\t\tSD.ICode,\n\t\tI.ManfCode\n\tUNION ALL\n\tSELECT\n\t\tI.ManfCode,\n\t\tSaleAmt=0,\n\t\tReturnAmt=SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))\n\tFROM\n\t\tSRLedger SL, SRDetail SD, Item I, Customer C\n\tWHERE\n\t\tSL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\t\tSL.SManCode = :ai_SManCode AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.AreaCode IN (:ai_AreaCode) AND\n\t\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSD.ICode = I.ICode \n\tGROUP BY\n\t\tSL.SRInvCode,\n\t\tSD.ICode,\n\t\tI.ManfCode) S\nWHERE\n\tS.ManfCode = M.ManfCode\nGROUP BY\n\tM.Name,\n\tS.ManfCode\nORDER BY\n\tM.Name",
  "update": "Manufacturer",
  "updatewhere": "0",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
