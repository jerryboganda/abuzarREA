  "retrieve": "SELECT  \n\tpatient.name,\n\tregno,\n\tphone,\n\tphone2,\n\tmobileno1,\n\tmobileno2,\n\tmobileno3,\n\tpatientcode,\n\tPatient.city,\n\trelationcode,\n\tdoctcode,\n\twardcode,\n\tpatient.custcode,\n\tcustomer=(select accounts.name from accounts where acccode=patient.custcode),\n\tpatient = LTRIM(RTRIM(Patient.Name)) + ' (' + LTRIM(RTRIM(Patient.RegNo)) + ')',\n\tRecurringPeriod\nFROM Patient\nWHERE Active='Y' AND \n\t(Phone LIKE ('%' + :as_phonehint + '%') OR\n\tPhone2 LIKE ('%' + :as_phonehint + '%') OR\n\tmobileno1 LIKE ('%' + :as_phonehint + '%') OR\n\tmobileno2 LIKE ('%' + :as_phonehint + '%') OR\n\tmobileno3 LIKE ('%' + :as_phonehint + '%'))\nOrder by name",
  "update": "Patient",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
