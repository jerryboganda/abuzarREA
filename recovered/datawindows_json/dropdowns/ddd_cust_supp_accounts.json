  "retrieve": "  SELECT dbo.accounts.acccode,\n\t\t\tdbo.accounts.subcode,\n\t\t\tdbo.accounts.aliasname, \n\t         dbo.accounts.name,   \n\t\t\tcustcatcode = CASE WHEN dbo.accounts.subcode = 3 THEN dbo.customer.custcatcode\n\t\t\t\t\t\t \t  ELSE -1 END,\n\t\t\tCategory = CASE WHEN dbo.accounts.subcode = 3 THEN ( Select Name From CustomerCategory Where dbo.customer.custcatcode = dbo.CustomerCategory.CustCatCode ) \n\t\t\t\t\t\t\t\t WHEN dbo.accounts.subcode = 7 THEN ( Select Name From SupplierCategory Where dbo.supplier.suppcatcode = dbo.SupplierCategory.SuppCatCode ) \t\t\t\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t ELSE Null END\t,\n\t\t\tcity = CASE WHEN dbo.accounts.subcode = 3 THEN dbo.customer.city\n\t\t\t\t\t\t ELSE dbo.supplier.city END,\n\t\t\tdbo.subaccounts.name,\n\t\t\tAddress = CASE WHEN dbo.accounts.subcode = 3 THEN dbo.customer.address1 \n\t\t\t\t\t\t ELSE dbo.Supplier.address1 END,\n\t\t\tdbo.accounts.restricted\nFROM  \n\tdbo.accounts\n\t\tLEFT OUTER JOIN dbo.customer ON (dbo.accounts.acccode = dbo.customer.custcode)\n\t\tLEFT OUTER JOIN dbo.supplier ON (dbo.accounts.acccode = dbo.supplier.suppcode),\n\t\tdbo.subaccounts\n\nWHERE \n\t(dbo.accounts.subcode = dbo.subaccounts.subacccode) AND \n\t(dbo.accounts.active = 'Y')\n\nOrder By \n\tdbo.accounts.name \n",
  "sort": "name A"
 },
