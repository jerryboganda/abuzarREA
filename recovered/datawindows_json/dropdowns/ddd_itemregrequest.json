  "retrieve": "SELECT \n\tCode=ItemRegRequest.ItemRegReqCode,   \n\tStatus = ItemRegRequest.Status,\n\tServerName=ItemRegRequest.ServerName,\n\tItemName=ItemRegRequest.Name + '(' + LTRIM(RTRIM(STR(ItemRegRequest.ItemRegReqCode, 7))) + ')',\n\tCustomICode=ItemRegRequest.CustomICode,   \n\tpurprice=ItemRegRequest.purprice,\n\tsaleprice=ItemRegRequest.saleprice,\n\tpackunits=ItemRegRequest.packunits,\n\tManufacturer=(SELECT Manufacturer.name FROM Manufacturer WHERE Manufacturer.ManfCode = ItemRegRequest.ManfCode),\n\tItemPacking=(SELECT ItemPacking.name FROM ItemPacking WHERE ItemPacking.PackCode = ItemRegRequest.PackCode),\n\titemclass=(SELECT itemclass.name FROM itemclass WHERE itemclass.ICCode = ItemRegRequest.ICCode),\n\titemcategory=(SELECT itemcategory.name FROM itemcategory WHERE itemcategory.ICatCode = ItemRegRequest.ICatCode),\n\tRegdNo = ItemRegRequest.RegdNo,\n\tMachineName=ItemRegRequest.MachineName\nFROM\n\tItemRegRequest\nWHERE\n\tItemRegRequest.ICode IS NULL AND Status <> 'J'\nORDER BY \n\tServerName,\n\tItemName"
 },
