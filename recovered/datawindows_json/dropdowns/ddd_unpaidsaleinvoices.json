    "dbname": "InvTotal"
   }
  ],
  "retrieve": "SELECT  \n\tSaleInvCode,\n\tDate,\n\tCustCode,\n\tCustomer,\n\tAliasName,\n\tOutstandingAmt,\n\tInvTotal\nFROM\n(SELECT \n\tSaleLedger.SaleInvCode,\n\tSaleLedger.Date,\n\tSaleLedger.CustCode,\n\tCustomer=Accounts.Name,\n\tAliasName=Accounts.AliasName,\n\tOutstandingAmt = SaleLedger.OutstandingAmt + \n\t\tCASE :module\n\t\tWHEN 'NR' THEN \n\t\t\tISNULL((SELECT SUM(Amt) FROM NotesDetail \n\t\t\tWhere NoteCode = :Code AND NotesDetail.InvoiceCode = SaleLedger.SaleInvCode), 0)\n\t\tWHEN 'SRA' THEN \n\t\t\tISNULL((SELECT SUM(Amt) FROM SRAllocationDetail \n\t\t\tWhere SRAllocationCode = :Code AND SRAllocationDetail.SaleInvCode = SaleLedger.SaleInvCode), 0)\n\t\tELSE \n\t\t\tISNULL((SELECT SUM(Debit-Credit) FROM GLDetail \n\t\t\tWhere GlVochCode = :Code AND GLDetail.InvoiceCode = SaleLedger.SaleInvCode), 0)\n\t\tEND,\n\tSaleLedger.InvTotal\nFROM \n\tSaleLedger, Accounts\nWHERE\n\tSaleLedger.AccountFor = 'Y' AND\n\tSaleLedger.Marked = 'N' AND\n\tSaleLedger.Posted ='Y' AND\n\tSaleLedger.CustCode = :custcode AND\n\tSaleLedger.SaleCatCode IN (2) AND\n\tSaleLedger.CustCode = Accounts.AccCode) S\nWHERE\n\tOutstandingAmt > 0\nORDER BY\n\tDate,   \n\tSaleInvCode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "custcode",
      "number"
     ]
    },
    {
     "_items": [
      "code",
      "number"
     ]
    },
    {
     "_items": [
      "module",
      "string"
     ]
    }
   ]
  }
 },
