  "retrieve": "SELECT\n\tNotes.NoteCode,   \n\tNotes.VoucherCode,\n\tNotes.AccCode,   \n\tNotes.BankAccCode,   \n\tNotes.IssueDate,   \n\tNotes.DueDate,   \n\tNotes.Amount,   \n\tNotes.BankName,   \n\tNotes.DocumentNumber,   \n\tNotes.Remarks,   \n\tNotes.NoteCatCode,   \n\tNotes.Posted,   \n\tNotes.PostedBy,   \n\tNotes.Modified,   \n\tNotes.ModifiedBy,   \n\tNotes.PostDate,   \n\tNotes.SalesmanCode,\n\tAccounts.AliasName,\n\tUnAppliedAmt= ISNULL(Notes.Amount - ISNULL((SELECT SUM(amt) FROM NotesDetail WHERE NotesDetail.NoteCode = Notes.NoteCode), 0), 0),\n\tNotes.Finalized,\n\tNotes.FinalizedDate,\n\tNotes.FinalizedBy\nFROM\n\tNotes, Accounts  \nWHERE\n\tNotes.NoteCode = :ar_notecode AND\n\tNotes.AccCode = Accounts.AccCode\n",
  "update": "Notes",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
