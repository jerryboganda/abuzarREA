  "retrieve": "SELECT \n\tAccountName=A2.Name,\n\tTransferAccount=Accounts.Name,   \n\tNotes.IssueDate,   \n\tNotes.DueDate,   \n\tNotes.PostDate,   \n\tNotes.DocumentNumber,   \n\tNotes.BankName,   \n\tNotes.Amount,   \n\tNotes.Remarks,   \n\tNotes.NoteCode\nFROM \n\tNotes,   \n\tAccounts, \n\tAccounts A2\nWHERE \n\tNotes.BankAccCode = Accounts.AccCode and  \n\tNotes.AccCode = A2.AccCode and  \n\tNotes.NoteCatCode = 2 AND\n\tNotes.DueDate >= :ad_startdate AND \n\tNotes.DueDate <= :ad_enddate AND \n\tNotes.Posted = 'Y'\n",
