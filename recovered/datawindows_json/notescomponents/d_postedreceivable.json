  "retrieve": "  SELECT Accounts.Name,   \n         Notes.IssueDate,   \n         Notes.DueDate,   \n         Notes.PostDate,\n         Notes.DocumentNumber,   \n         Notes.BankName,   \n         Notes.Amount,   \n         Notes.Remarks,   \n         Notes.NoteCode,\n\t\tTotalAmount=SUM(Notes.Amount ),\n\t\tNotes.PostDate\n    FROM Notes,   \n         Customer,   \n         Accounts  \n   WHERE ( Notes.BankAccCode = Accounts.AccCode ) and  \n         ( Notes.AccCode = Customer.CustCode ) and  \n         ( ( Notes.NoteCatCode = 1 ) ) AND  \n         Notes.Posted = 'Y'    \nGROUP BY Accounts.Name,   \n         Notes.IssueDate,   \n         Notes.DueDate,   \n         Notes.DocumentNumber,   \n         Notes.BankName,   \n         Notes.Amount,   \n         Notes.Remarks,   \n\t\tNotes.PostDate,\n         Notes.NoteCode  "
