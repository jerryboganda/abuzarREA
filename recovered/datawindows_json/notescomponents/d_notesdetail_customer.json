  "retrieve": "SELECT  \n\tNotesDetail.NoteCode,\n\tNotesDetail.InvoiceCode,\n\tSaleLedger.Date,\n\tSaleLedger.InvTotal,\n\tNotesDetail.OutstandingAmt,\n\tNotesDetail.IDENTITYCOL,\n\tNotesDetail.NotesUTN,\n\tNotesDetail.Amt\nFROM\n\tNotesDetail,\n\tNotes,\n\tSaleLedger\nWHERE\n\t( Notes.NoteCode = :Code ) AND\n\t( Notes.NoteCode = NotesDetail.NoteCode ) and  \n\t( NotesDetail.InvoiceCode = SaleLedger.SaleInvCode )\nORDER BY\n\tNotesDetail.NoteCode,   \n\tNotesDetail.IDENTITYCOL,\n\tNotesDetail.InvoiceCode\n",
