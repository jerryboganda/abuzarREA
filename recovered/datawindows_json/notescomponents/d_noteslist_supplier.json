  "retrieve": "SELECT\n\tNotes.NoteCode,   \n\tNotes.VoucherCode,\n\tAccounts.AliasName,\n\tSupplier=Accounts.Name,   \n\tBank=(SELECT A.Name FROM Accounts A WHERE A.AccCode = Notes.BankAccCode),\n\tNotes.IssueDate,   \n\tNotes.DueDate,   \n\tNotes.Amount,   \n\tUnAppliedAmt = ISNULL(Notes.Amount - ISNULL((SELECT SUM(amt) FROM NotesDetail WHERE NotesDetail.NoteCode = Notes.NoteCode), 0), 0),\n\tNotes.BankName,   \n\tNotes.DocumentNumber,   \n\tNotes.Remarks,   \n\tNotes.Posted,   \n\tNotes.PostDate,   \n\tUserName=(SELECT Users.UserName FROM users WHERE Users.UserCode = notes.salesmancode),\n\tNotes.AccCode,\n\tNotes.BankAccCode\nFROM\n\tNotes, Accounts  \nWHERE\n\tNotes.AccCode = Accounts.AccCode AND\n\tNotes.NoteCatCode = 2"
