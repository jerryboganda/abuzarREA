    "dbname": "SalesManCount"
   }
  ],
  "retrieve": "SELECT \n\tManfCode=M.ManfCode,\n\tManufacturer = M.Name,\n\tArea = (SELECT A.Name FROM Area A WHERE A.AreaCode=SA.AreaCode),\n\tSubAreaCode = SS.SubAreaCode,\n\tSubArea = SA.Name,\n\tSalesManCount = COUNT(DISTINCT SS.SalesmanCode)\nFROM \n\tSalesManScope SS, Manufacturer M, SubArea SA, SalesMan SM, WeekDays W\nWHERE\n\tSS.ManfCode IN (:ai_manfCode) AND\n\tSS.ManfCode = M.ManfCode AND\n\tSS.SalesmanCode = SM.SalesManCode AND\n\tSS.SubAreaCode = SA.SubAreaCode AND\n\tSS.WeekDayCode = W.WeekDayCode\nGROUP BY M.ManfCode, M.Name, SA.AreaCode, SA.Name, SS.SubAreaCode\nHAVING COUNT(DISTINCT SS.SalesmanCode) > 1\nORDER BY\n\tManufacturer,\n\tM.ManfCode,\n\tArea,\n\tSubArea\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_manfCode",
      "numberlist"
     ]
    }
   ]
  }
 },
