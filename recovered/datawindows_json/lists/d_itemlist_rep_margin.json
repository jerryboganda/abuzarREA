  "retrieve": "SELECT \n\titem.ICode,\n\titem.CustomICode,\n\titem.Name,\n\titem.ICCode,\n\titemclass.name,\n\tmanufacturer=manufacturer.name,\n\titem.ICatCode,\n\titemcategory.name,\n\titem.Packcode,\n\titempacking.name,\n\titem.SalePrice,\n\titem.PurPrice,\n\tSaleBasedMargin=Round(((item.SalePrice - item.PurPrice) / CASE item.SalePrice WHEN 0 THEN 1 ELSE item.SalePrice END) * 100, 2),\n\tPurchaseBasedMargin=ROUND(((item.SalePrice - item.PurPrice) / CASE item.PurPrice WHEN 0 THEN 1 ELSE item.PurPrice END) * 100, 2),\n\titem.RetailPrice,\n\titem.AvgPrice,\n\titem.SaleDiscPerc,\n\titem.PurDiscPerc,\n\titem.SalesTax,\n\titem.ReorderQty,\n\titem.OptimumQty,\n\titem.PackUnits,\n\titem.Active,\n\titem.Prescribed,\n\titem.Refrigrated,\n\titem.Printable,\n\titem.Location1,\n\titem.Remarks1,\n\titem.Location,\n\titem.Remarks,\n\titem.Gcode,\n\tgodown.name,\n\titem.reorderLevel,\n\titem.OptimumLevel,\n\titem.RecentPurPrice,\n\titem.SalePrice2,\n\titem.SalePrice3,\n\titem.GReorderQty,\n\titem.GOptimumQty,\n\tstock = ISNULL((SELECT SUM(G.CurrQTY) FROM GodownDetail G WHERE G.ICode = item.ICode), 0)\nFROM \n\tItem \n\tLEFT OUTER JOIN ItemPacking ON (Item.PackCode = ItemPacking.Packcode)\n\tLEFT OUTER JOIN itemclass ON (Item.ICCode = itemclass.ICCode),\n\titemcategory, godown, manufacturer\nWHERE item.gcode=godown.gcode AND\n\t(item.icatcode=itemcategory.icatcode)AND\n\t(item.manfcode in (:aa_manfcode) ) and\n\titem.manfcode=manufacturer.manfcode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "aa_manfcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "item_name A, item_customicode A"
 },
