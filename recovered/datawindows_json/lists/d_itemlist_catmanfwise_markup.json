  "retrieve": "SELECT\tItem.CustomICode,   \n\t\t\tNAME=item.name,\n\t\t\tItem.icode,   \n         Item.PurPrice,   \n         Item.RetailPrice,   \n         Manufacturer.Name,   \n         ItemCategory.Name,   \n         Item.PackingDesc,   \n       SalePrice=(case :ar_pricetype when 1 then item.saleprice +(item.saleprice*0.01*:ar_markup)\n\t\t\t\t\t\t\t\t\t\twhen 2 then item.saleprice2 +(item.saleprice2*0.01*:ar_markup)\n\t\t\t\t\t\t\t\t\t\twhen 3 then item.saleprice3+(item.saleprice3*0.01*:ar_markup)\n\t\t\t\t\t\t\t\t\t\twhen 4 then item.purprice+(item.purprice*0.01*:ar_markup)\n\t\t\t\t\t\t\t\t\t\twhen 5 then item.recentpurprice+(item.recentpurprice*0.01*:ar_markup)\n\t\t\t\t\t\t\t\t\t\twhen 6 then item.avgprice +(item.avgprice*0.01*:ar_markup)\n\t\t\t\t\t\t\t\t\t\twhen 7 then item.saleprice4 +(item.saleprice4*0.01*:ar_markup)\n\t\t\t\t\t\t\t\t\t\twhen 8 then item.saleprice5 +(item.saleprice5*0.01*:ar_markup)\n\t\t\n\t\t\t\t\t\tend),\n\t\t\tItem.SaleDiscPerc,\n\t\t\tItem.PurDiscPerc,\n\t\t\titem.gstperc1 \n    FROM Item,   \n         Manufacturer,   \n         ItemCategory\n   WHERE ( Item.ManfCode IN (:ar_ManfCode) ) and\n\t\t\t( Item.ICatCode IN (:ar_ICatCode) ) and\n\t\t\t( Item.ICatCode = ItemCategory.icatcode) and\n\t\t\t(item.manfcode = manufacturer.manfcode) \nORDER BY Manufacturer.Name, ItemCategory.Name, Item.Name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_manfcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ar_icatcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ar_pricetype",
      "number"
     ]
    },
    {
     "_items": [
      "ar_markup",
      "number"
     ]
    }
   ]
  },
  "sort": "manufacturer A, itemcategory A, itemname A"
 },
