  ],
  "retrieve": "SELECT  \n\tdbo.accounts.aliasname,\n\tdbo.accounts.name,\n\tdbo.area.name,\n\tdbo.accounts.Active,\n\tdbo.customer.address1,\n\tdbo.customer.city,\n\tdbo.customer.country,\n\tdbo.customer.phone,\n\tsalesman=dbo.salesman.name,\n\tcategory=dbo.customercategory.name,\n\tsubarea=dbo.subarea.name\nFROM \n\tdbo.salesman, dbo.customer, dbo.customercategory, dbo.subarea, dbo.accounts, dbo.area\nWHERE \n\t( dbo.customer.salesmancode IN (:ai_salesmancode) ) AND\n\t( dbo.salesman.salesmancode = dbo.customer.salesmancode ) AND\n\t( dbo.customer.custcode = dbo.accounts.acccode ) AND\n\t( dbo.accounts.Active = CASE :as_status WHEN 'Y' THEN 'Y' WHEN 'N' THEN 'N' ELSE dbo.accounts.Active END) AND\n\t( dbo.customer.custcatcode = dbo.customercategory.custcatcode ) AND\n\t( dbo.area.areacode = dbo.customer.areacode ) and\n\t( dbo.subarea.subareacode = dbo.customer.subareacode ) \nORDER BY \n\tdbo.salesman.name,\n\tdbo.accounts.name,\n\tdbo.customer.address1,\n\tdbo.customer.city,\n\tdbo.customer.country,\n\tdbo.customer.phone",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_salesmancode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "as_status",
      "string"
     ]
    }
   ]
  }
 },
