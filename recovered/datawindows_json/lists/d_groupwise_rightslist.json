   {
    "type": "char(1)",
    "updatewhereclause": "yes",
    "name": "status",
    "dbname": "Status"
   }
  ],
  "retrieve": "Select \tG.GroupName,\n       \tR.RightName,\n       \tStatus = 'Y'\nFrom   \tGroups G, Rights R, GroupRights GR\nWhere  \tG.GroupCode = GR.GroupCode And\n\t\t\tG.GroupCode IN (:ai_groupcode) And\n\t\t\tR.RightCode = GR.RightCode\nUnion All\nSelect \tG.GroupName,\n       \tR.RightName,\n       \tStatus = 'N'\nFrom   \tGroups G, Rights R\nWhere  \tG.GroupCode IN (:ai_groupcode) And\n\t\t\tR.RightCode NOT IN ( Select RightCode From GroupRights Where GroupCode = G.GroupCode )\n\n\n\n\n\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_groupcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "groupname A, rightname A, status A",
  "filter": "status  IN ( 'Y' ) "
 },
