    "dbname": "Region"
   }
  ],
  "retrieve": "SELECT  \n\tdbo.accounts.aliasname,\n\tdbo.accounts.name,\n\tdbo.area.name,\n\tdbo.customer.address1,\n\tdbo.customer.city,\n\tdbo.customer.country,\n\tdbo.customer.phone,\n\tsalesman=(SELECT dbo.salesman.name FROM dbo.salesman WHERE dbo.salesman.salesmancode = dbo.customer.salesmancode),\n\tcategory=dbo.customercategory.name,\n\tsubarea=dbo.subarea.name,\n\tRegion = dbo.region.name\nFROM \n\tdbo.region, dbo.customer, dbo.customercategory, dbo.subarea, dbo.accounts, dbo.area\nWHERE \n\t( dbo.region.regioncode IN (:ai_regioncode) ) AND\n\t( dbo.region.regioncode = dbo.area.regioncode ) AND\n\t( dbo.customer.custcode = dbo.accounts.acccode ) AND\n\t( dbo.customer.custcatcode = dbo.customercategory.custcatcode ) AND\n\t( dbo.area.areacode = dbo.customer.areacode ) and\n\t( dbo.subarea.subareacode = dbo.customer.subareacode ) \n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_regioncode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "region A, customer A, area A, subarea A"
 },
