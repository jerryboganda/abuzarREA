    "name": "retailprice",
    "dbname": "Item.RetailPrice"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "manufacturer",
    "dbname": "Manufacturer.Name"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "itemcategory",
    "dbname": "ItemCategory.Name"
   },
   {
    "type": "char(50)",
    "updatewhereclause": "yes",
    "name": "packingdesc",
    "dbname": "Item.PackingDesc"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "saleprice",
    "dbname": "Item.SalePrice"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "salediscperc",
    "dbname": "Item.SaleDiscPerc"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "purdiscperc",
    "dbname": "Item.PurDiscPerc"
   }
  ],
  "retrieve": "SELECT\tItem.CustomICode,   \n\t\t\tNAME=RTRIM(LTRIM(Item.Name)) + ' ' + REPLICATE('-',50-LEN(RTRIM(LTRIM(Item.Name)))),\n\t\t\tItem.PackingDesc,\n\t\t\tItem.icode,   \n         Item.PurPrice,   \n         Item.RetailPrice,   \n         Manufacturer.Name,   \n         ItemCategory.Name,   \n         Item.PackingDesc,   \n         Item.SalePrice,\n\t\t\tItem.SaleDiscPerc,\n\t\t\tItem.PurDiscPerc \n    FROM Item LEFT OUTER JOIN ItemCategory ON (Item.ICatCode = ItemCategory.icatcode),   \n         Manufacturer\n   WHERE ( Item.ManfCode = :ar_ManfCode ) and\n\t\t\t(item.manfcode = manufacturer.manfcode) \nORDER BY Manufacturer.Name, ItemCategory.Name, Item.Name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_manfcode",
      "number"
     ]
    }
   ]
  },
  "sort": "manufacturer A, itemcategory A, itemname A"
 },
