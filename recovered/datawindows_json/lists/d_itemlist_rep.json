  "retrieve": "SELECT \n\n\titem.ICode,\n\t  \n\titem.CustomICode,\n\t\n\titem.Name,\n\t\n\titem.ICCode,\n\t\n\titemclass.name,\n\t\n\titem.ICatCode,\n\t\n\titemcategory.name,\n\t\n\titem.Packcode,\n\t\n\titempacking.name,\n\t\n\titem.SalePrice,\n\t\n\titem.PurPrice,\n\t\n\titem.RetailPrice,\n\t\n\titem.AvgPrice,\n\t\n\titem.SaleDiscPerc,\n\t\n\titem.PurDiscPerc,\n\t\n\titem.SalesTax,\n\t\n\titem.ReorderQty,\n\t\n\titem.OptimumQty,\n\t\n\titem.PackUnits,\n\t\n\titem.Active,\n\t\n\titem.Prescribed,\n\t\n\titem.Refrigrated,\n\t\n\titem.Printable,\n\t\n\titem.Location1,\n\t\n\titem.Remarks1,\n\t\n\titem.Location,\n\t\n\titem.Remarks,\n\t\n\titem.Gcode,\n\t\n\tgodown.name,\n\t\n\titem.reorderLevel,\n\t\n\titem.OptimumLevel,\n\t\n\titem.RecentPurPrice,\n\t\n\titem.SalePrice2,\n\t\n\titem.SalePrice3,\n\t\n\titem.GReorderQty,\n\t\n\titem.GOptimumQty\n\nFROM \n\tItem \n\tLEFT OUTER JOIN ItemPacking ON (Item.PackCode = ItemPacking.Packcode)\n\tLEFT OUTER JOIN itemclass ON (Item.ICCode = itemclass.ICCode),\n\titemcategory,\n\tgodown,\n\tmanufacturer\n\nWHERE \n\titem.gcode=godown.gcode AND\n\t(item.icatcode=itemcategory.icatcode)AND\n\t(item.manfcode in (:aa_manfcode) ) and\n\titem.manfcode=manufacturer.manfcode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "aa_manfcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "item_name A, item_customicode A"
 },
