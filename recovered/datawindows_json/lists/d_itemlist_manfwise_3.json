  "retrieve": " SELECT\tItem.CustomICode,   \n\t\t\tNAME=item.name,\n\t\t\tItem.icode,   \n         \tManufacturer.Name,\n\t\t\titempacking=(select name from itempacking where item.packcode=itempacking.packcode),   \n\n         \tprice=(case :ar_pricetype \n\t\t\t\t\t\twhen 1 then item.saleprice \n\t\t\t\t\t\twhen 2 then saleprice2 \n\t\t\t\t\t\twhen 3 then saleprice3 \n\t\t\t\t\telse saleprice end),\n\t\t\tspecialprice= (case :ar_pricetype \n\t\t\t\t\t\t\t\t\twhen 1 then item.saleprice \n\t\t\t\t\t\t\t\t\twhen 2 then saleprice2 \n\t\t\t\t\t\t\t\t\twhen 3 then saleprice3 \n\t\t\t\t\t\t\t\t\telse saleprice end) *( 1 - 0.01*:ar_discperc)\n    FROM Item,   \n         Manufacturer\n        \n   WHERE ( Item.ManfCode IN( :ar_ManfCode )) and\n\t\t\t\t(item.manfcode = manufacturer.manfcode) \nORDER BY Manufacturer.Name, Item.Name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_manfcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ar_pricetype",
      "number"
     ]
    },
    {
     "_items": [
      "ar_discperc",
      "number"
     ]
    }
   ]
  },
  "sort": "manufacturer A, itemname A"
 },
