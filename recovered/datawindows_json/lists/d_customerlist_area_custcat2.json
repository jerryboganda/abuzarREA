  ],
  "retrieve": "  SELECT dbo.accounts.name , \n\t\t\tdbo.accounts.aliasname,\n\t\t\tdbo.area.name,\n\t\t\tdbo.customercategory.name,\n\t\t\tdbo.customer.address1,\n\t\t\tdbo.customer.city,\n\t\t\tdbo.customer.country,\n\t\t\tdbo.customer.phone,\n\t\t\tdbo.customer.cp,\n\t\t\tdbo.customer.licenceno,\n\t\t\tdbo.customer.licenceexpiry    \n    FROM dbo.customer, \n\t\t\tdbo.accounts, \n         dbo.area,\n\t\t\tdbo.customercategory\n\n   WHERE ( dbo.customer.custcode = dbo.accounts.acccode ) and\n\t\t\t( dbo.area.areacode = dbo.customer.areacode ) and\n\t\t\t( dbo.area.areacode IN (:ai_areacode) ) and\n\t\t\t( dbo.customer.custcatcode = dbo.customercategory.custcatcode ) and\n\t\t\t( dbo.customercategory.custcatcode IN (:ai_custcatcode) )\n\t\t\t \nORDER BY\n\t\t\tdbo.area.name, \n\t\t\tdbo.customercategory.name, \n\t\t\tdbo.accounts.name ,\n\t\t\tdbo.accounts.aliasname,\n\t\t\tdbo.customer.address1 ,\n\t\t\tdbo.customer.city ,\n\t\t\tdbo.customer.country ,\n\t\t\tdbo.customer.phone\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_areacode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_custcatcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "area_name A, customercategory A, accounts_name A, aliasname A, customer_city A"
 },
