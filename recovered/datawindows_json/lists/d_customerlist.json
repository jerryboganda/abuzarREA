  "retrieve": "  SELECT dbo.accounts.name , \n\t\t\tdbo.area.name ,\n\t\t\tdbo.customer.address1 ,\n\t\t\tdbo.customer.city ,\n\t\t\tdbo.customer.country ,\n\t\t\tdbo.customer.phone\n\t\t\t\n    \n    FROM dbo.customer , \n\t\t\tdbo.accounts , \n         dbo.area\n\n   WHERE ( dbo.customer.custcode = dbo.accounts.acccode ) and\n\t\t\t( dbo.area.areacode = dbo.customer.areacode )  \n\t\t\t \nGROUP BY dbo.area.name, \n\t\t\tdbo.accounts.name ,\n\t\t\tdbo.customer.address1 ,\n\t\t\tdbo.customer.city ,\n\t\t\tdbo.customer.country ,\n\t\t\tdbo.customer.phone\n\n",
