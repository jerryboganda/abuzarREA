  "retrieve": "SELECT \n\tService.ServiceCode,   \n\tService.Name,   \n\tService.Price,   \n\tService.Description,   \n\tService.ServiceCatCode,   \n\tServiceCategory = (SELECT SC.Name FROM ServiceCategory SC WHERE SC.ServiceCatCode = Service.ServiceCatCode),\n\tService.Commission,   \n\tService.AliasName,   \n\tService.ServiceFlatDisc  \nFROM \n\tService  \nWHERE \n\tService.ServiceCatCode IN (:ai_servicecatcode)\nORDER BY\n\tServiceCategory,\n\tService.Name\n\t\t\n",
