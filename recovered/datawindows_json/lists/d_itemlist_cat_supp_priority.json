    "dbname": "SuppName"
   }
  ],
  "retrieve": "select itemname=I.name,\n\tsaleprice=( CASE :ar_SalePriceNo \n\t\t\t\t\t\tWHEN 2  THEN I.saleprice2\n\t\t\t\t\t \tWHEN 3  THEN I.saleprice3\n\t\t\t\t\t   WHEN 4  THEN I.saleprice4\n\t\t\t\t\t \tWHEN 5  THEN I.saleprice5\n\t\t\t\t\tELSE\n\t\t\t\t\t  I.saleprice\n\t\t\t\t\tEND ),\n\t\t\t\t\n\tpurprice=I.purprice,\n\tSaleDiscPerc=( CASE :ar_SaleDiscNo \n\t\t\t\t\t\tWHEN 2  THEN I.salediscperc2\n\t\t\t\t\t \tWHEN 3  THEN I.salediscperc3\n\t\t\t\t\t   WHEN 4  THEN I.salediscperc4\n\t\t\t\t\t \tWHEN 5  THEN I.salediscperc5\n\t\t\t\t\tELSE\n\t\t\t\t\t  I.salediscperc\n\t\t\t\t\tEND ),\n\tdiscountedprice=round(I.saleprice *(1 - ( CASE :ar_SaleDiscNo \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tWHEN 2  THEN I.salediscperc2\n\t\t\t\t\t \t\t\t\t\t\t\t\t\t\t\t\tWHEN 3  THEN I.salediscperc3\n\t\t\t\t\t   \t\t\t\t\t\t\t\t\t\t\tWHEN 4  THEN I.salediscperc4\n\t\t\t\t\t \t\t\t\t\t\t\t\t\t\t\t\tWHEN 5  THEN I.salediscperc5\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tELSE\n\t\t\t\t\t  \t\t\t\t\t\t\t\t\t\t\t\tI.salediscperc\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tEND) * 0.01),2),\n \tManf=(select name from manufacturer where manfcode=I.manfcode),\n\tcategory=(select name from itemcategory where icatcode=I.icatcode),\n\tSuppName=(select name from accounts where acccode=ISS.suppcode)\n\nfrom Item I\n     LEFT OUTER JOIN\n     (select * from ItemSuppliers \n      where priority=1) AS ISS ON (I.ICode = ISS.ICode)\n\nWhere  I.icatcode IN (:aa_icatcode)\norder by Category,\n\t\t\tI.name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "aa_icatcode",
      "numberlist"
     ]
    },
