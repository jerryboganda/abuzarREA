  "retrieve": "SELECT \n\tPackingJobCode=PackingJobDetail.PackingJobCode,   \n\tDocCode = (SELECT MAX(PJS.DocCode) FROM PackingJobSource PJS WHERE PJS.PackingJobCode = :ai_code),\n\tDate = PackingJob.Date, \n\tUserCode = PackingJob.UserCode, \n\tRemarks = PackingJob.Remarks,\n\tPackingLayoutCode=PackingJobDetail.PackingLayoutCode,   \n\tCaseNo=PackingJobDetail.CaseNo,   \n\tMasterCartonNo=PackingJobDetail.MasterCartonNo,   \n\tCartonNo=PackingJobDetail.CartonNo,   \n\tICode=PackingJobDetail.ICode,   \n\tItemName=Item.Name,   \n\tAliasName=Item.CustomICode,   \n\tICatCode=Item.ICatCode,\n\tItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = Item.ICatCode),\n\tICCode=Item.ICCode,\n\tItemClass = (SELECT IC.Name FROM ItemClass IC WHERE IC.ICCode = Item.ICCode),\n\tPackCode=Item.PackCode,\n\tItemPacking = (SELECT P.Name FROM ItemPacking P WHERE P.PackCode = Item.PackCode),\n\tRowId=PackingJobDetail.RowID,   \n\tBatch = PackingJobDetail.Batch,\n\tExpiry = PackingJobDetail.Expiry,\n\tQty=PackingJobDetail.Qty\nFROM \n\tPackingJob,\n\tPackingJobDetail, \n\tItem  \nWHERE \n\tPackingJob.PackingJobCode = :ai_code AND\n\tPackingJob.PackingJobCode = PackingJobDetail.PackingJobCode AND\n\tPackingJobDetail.ICode = Item.ICode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  },
  "sort": "packingjobcode A, packinglayoutcode A, caseno A, mastercartonno A, cartonno A, rowid A"
 },
