  "retrieve": "SELECT \n\tICode=D.ICode,\n\tAliasName=I.CustomICode,\n\tItemName=I.Name,\n\tICatCode=I.ICatCode,\n\tItemCategory=IC.Name,\n\tICCode=I.ICCode,\n\tBatch=D.Batch,\n\tExpiry=D.Expiry,\n\tItemClass=IL.Name, \n\tPackCode=I.PackCode,\n\tItemPacking=IP.Name,\n\tQty=SUM(D.LooseQty + D.BonusQty)\nFROM\n\tSaleLedger S, \n\tSaleDetail D, \n\tItem I LEFT OUTER JOIN ItemPacking AS IP ON (I.PackCode = IP.PackCode), \n\tItemCategory IC, \n\tItemClass IL\n\t\nWHERE \n\tS.SaleInvCode IN (:ai_invcode) AND\n\tS.SaleInvCode = D.SaleInvCode AND\n\tD.ICode = I.ICode AND\n\tI.ICatCode = IC.ICatCode AND\n\tI.ICCode = IL.ICCode\nGROUP BY\n\tD.ICode,\n\tD.Batch,\n\tD.Expiry,\n\tI.CustomICode,\n\tI.Name,\n\tI.ICatCode,\n\tIC.Name,\n\tI.ICCode,\n\tIL.Name,\n\tI.PackCode,\n\tIP.Name\nORDER BY\n\tIC.Name,\n\tIL.Name,\n\tIP.Name,\n\tI.Name,\n\tBatch,\n\tExpiry\t\n\t\t",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_invcode",
      "numberlist"
     ]
    }
   ]
  }
 },
