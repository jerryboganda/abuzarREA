  ],
  "retrieve": "SELECT\n\tGroupCode = IR.SmanCode,\n\tGroupName = S.Name,\n\tAliasName = I.CustomICode,\n\tItemName = I.Name,\n\tArea = A.Name, \n\tIssueQty = SUM(IR.IssueQty),\n\tIssueValue = SUM(IR.IssueValue),\n\tReceiptQty = SUM(IR.ReceiptQty),\n\tReceiptValue = SUM(IR.ReceiptValue),\n\tNetQty = SUM(IR.IssueQty) - SUM(IR.ReceiptQty),\n\tNetValue = SUM(IR.IssueValue) - SUM(IR.ReceiptValue)\nFROM\n\tArea A,\n\tItem I,\n\tSalesman S,\n\t(SELECT\n\t\tD.ICODE,\n\t\tH.AreaCode,\n\t\tH.SmanCode,\n\t\tIssueQty=Sum(D.Qty),\n\t\tIssueValue=SUM(D.Qty * \n\t\t\t\t(CASE :ai_pricetype\n\t\t\t\tWHEN 1 THEN D.SalePrice \n\t\t\t\tWHEN 2 THEN D.PurchasePrice\n\t\t\t\tELSE D.AvgPrice END / CASE :ai_pricetype WHEN 3 THEN 1 ELSE CASE D.PackUnits WHEN 0 THEN 1 ELSE D.Packunits END END) ),\n\t\tReceiptQty=0,\n\t\tReceiptValue=0\n\tFROM\n\t\tIssueHeader H, \n\t\tIssueDetail D\n\tWHERE\n\t\tH.IssueInvCode = D.IssueInvcode AND\n\t\tH.Date >= :adt_startdate AND H.Date <= :adt_enddate AND\n\t\tH.AreaCode IN (:ai_areacode) AND\n\t\tH.SmanCode IN (:ai_salesmancode) AND\n\t\tH.POSTED IN (:as_posted)\n\tGROUP BY\n\t\tH.SmanCode,\n\t\tH.AreaCode,\n\t\tD.ICode\n\tUNION ALL\n\tSELECT\n\t\tD.ICODE,\n\t\tH.AreaCode,\n\t\tH.SmanCode,\n\t\tIssueQty=0,\n\t\tIssueValue=0,\n\t\tReceiptQty=SUM(D.Qty),\n\t\tReceiptValue=SUM(D.Qty * \n\t\t\t\t(CASE :ai_pricetype\n\t\t\t\tWHEN 1 THEN D.SalePrice \n\t\t\t\tWHEN 2 THEN D.PurchasePrice\n\t\t\t\tELSE D.AvgPrice END / CASE :ai_pricetype WHEN 3 THEN 1 ELSE CASE D.PackUnits WHEN 0 THEN 1 ELSE D.Packunits END END) )\n\tFROM\n\t\tReceiptHeader H, \n\t\tReceiptDetail D\n\tWHERE\n\t\tH.ReceiptInvCode = D.ReceiptInvcode AND\n\t\tH.Date >= :adt_startdate AND H.Date <= :adt_enddate AND\n\t\tH.AreaCode IN (:ai_areacode) AND\n\t\tH.SmanCode IN (:ai_salesmancode) AND\n\t\tH.POSTED IN (:as_posted)\n\tGROUP BY\n\t\tH.SmanCode,\n\t\tH.AreaCode,\n\t\tD.ICode) IR\nWHERE\n\tI.ICode = IR.ICode AND\n\tIR.AreaCode = A.AreaCode AND\n\tIR.SmanCode = S.SalesmanCode AND\n\tI.Active = 1\nGROUP BY\n\tIR.SmanCode,\n\tS.Name,\n\tA.Name,\n\tI.Name,\n\tI.CustomICode\nORDER BY\n\tGroupName,\n\tArea,\n\tItemName,\n\tAliasName",
  "arguments": {
