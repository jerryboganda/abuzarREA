  "retrieve": "SELECT\n\taccounts.acccode ,\n\taccounts.LocalAccountName,\n\taccounts.subcode ,\n\taccounts.name ,\n\tcategoryaccounts.catacccode,\n\tmainaccounts.mainacccode ,\n\taccounts.aliasname,\n\taccounts.openingdate,\n\taccounts.active,\n\taccounts.Restricted,\n\tbalancelimit=accounts.balancelimit,\n\tnewbalancelimit=ABS(accounts.balancelimit),\n\tbalancelimitype=CASE WHEN accounts.balancelimit < 0 THEN 'CR' ELSE 'DR' END,\n\tAccounts.AlertCode,\n\tAccounts.Remarks\nFROM accounts, subaccounts, categoryaccounts, mainaccounts\nWHERE ( accounts.acccode = :ra_AccCode )   AND\n\t\t( accounts.subcode = subaccounts.subacccode ) AND\n\t\t( subaccounts.catacccode = categoryaccounts.catacccode ) AND\n\t\t( categoryaccounts.mainacccode = mainaccounts.mainacccode )",
  "update": "accounts",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_AccCode",
      "number"
     ]
    }
   ]
  }
