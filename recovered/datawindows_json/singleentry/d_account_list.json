  "retrieve": "  SELECT accounts.name ,\n\t\t\taccounts.aliasname ,\n\t\t\tsubaccounts.name, \n\t\t\taccounts.acccode ,\n         accounts.OpeningDate,\n\t\t\taccounts.active,\n\t\t\taccounts.Restricted,\n\t\t\tcategoryaccounts.name,\n\t\t\tmainaccounts.name,\n\t\t\taccounts.alertcode,\n\t\t\talerttypecode = (SELECT alert.AlertTypeCode FROM Alert WHERE Alert.AlertCode=accounts.alertcode)\n    FROM accounts ,\n         subaccounts,\n\t\t\tcategoryaccounts,\n\t\t\tmainaccounts\n\n   WHERE ( subaccounts.subacccode = accounts.subcode )   and\n\t\t\t( subaccounts.catacccode = categoryaccounts.catacccode )   and\n\t\t\t( categoryaccounts.mainacccode = mainaccounts.mainacccode )"
 },
