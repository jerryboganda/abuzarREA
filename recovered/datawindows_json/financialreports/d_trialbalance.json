  "retrieve": "SELECT name1 = Case :ar_tbcontent  \n\t\t\t\t\t\tWhen 'MainAccounts' Then M.Name\n\t\t\t\t\t\tWhen 'SubAccounts' Then S.Name\n\t\t\t\t\t\tWhen 'Accounts' Then A.Name\n\t\t\t\t\t\tElse C.Name\n\t\t\t\t\tEND, \n\t\t name2 = Case :ar_tbcontent \n\t\t\t\t\t\tWhen 'MainAccounts' Then ''\n\t\t\t\t\t\tWhen 'SubAccounts' Then C.Name\n\t\t\t\t\t\tWhen 'Accounts' Then S.Name\n\t\t \t\t\t\tElse M.Name\n\t\t\t\t\tEND,\n\t\t value1 = Case :ar_tbtype \n\t\t\t\t\t\tWhen 'Balance' Then Sum(Debit - Credit)\n\t\t\t\t\t\tElse Sum(Debit)\n\t\t\t\t\tEND,\n\t\t value2 = Case :ar_tbtype \n\t\t\t\t\t\tWhen 'Balance' Then Sum(Debit - Credit)\n\t\t\t\t\t\tElse -Sum(Credit)\n\t\t\t\t\tEND\nFROM VirtualGL V,\n\t  Accounts A,\n\t  SubAccounts S, \n\t  CategoryAccounts C,\n\t  MainAccounts M\nWHERE \n\t\tV.Date >= Case :ar_tbtype \n\t\t\t\t\t When 'Total' Then :ar_startdate\n\t\t\t\t\t Else '01/01/1800 00:00:00' END\n\t\tAND V.Date <= :ar_enddate AND\n\t\tV.AccCode = A.AccCode AND \n\t\tA.SubCode = S.SubAccCode AND\n\t\tS.CatAccCode = C.CatAccCode AND\n\t\tC.MainAccCode = M.MainAccCode\nGROUP BY \n\t\t Case :ar_tbcontent \n\t\t\tWhen 'MainAccounts' Then M.Name\n\t\t\tWhen 'SubAccounts' Then S.Name\n\t\t\tWhen 'Accounts' Then A.Name\n\t\t\tElse C.Name\n\t\t END,\n\t\t Case :ar_tbcontent \n\t\t\tWhen 'MainAccounts' Then ''\n\t\t\tWhen 'SubAccounts' Then C.Name\n\t\t\tWhen 'Accounts' Then S.Name\n\t\t\tElse M.Name\n\t\t END\nORDER BY Name2, Name1\n",
  "arguments": {
   "_items": [
