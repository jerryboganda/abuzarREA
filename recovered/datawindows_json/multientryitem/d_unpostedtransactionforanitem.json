    "dbname": "TransCode"
   }
  ],
  "retrieve": "SELECT TransDate=H.Date, AliasName=I.CustomICode, ItemName = I.Name, TransType = 'Purchase', TransCode = H.PurInvCode\nFROM PurDetail D, PurLedger H, Item I\nWhere H.Posted = 'N' AND H.PurInvCode = D.PurInvCode AND D.ICode = :ai_icode AND D.ICode=I.ICode\nUNION ALL  \nSELECT TransDate=H.Date, AliasName=I.CustomICode, ItemName = I.Name, TransType = 'P/Return', TransCode = H.PrInvCode\nFROM PrDetail D, PrLedger H, Item I\nWhere H.Posted = 'N' AND H.PrInvCode = D.PrInvCode AND D.ICode = :ai_icode AND D.ICode=I.ICode\nUNION ALL  \nSELECT TransDate=H.Date, AliasName=I.CustomICode, ItemName = I.Name, TransType = 'Sale', TransCode = H.SaleInvCode\nFROM SaleDetail D, SaleLedger H, Item I\nWhere H.Posted = 'N' AND H.SaleInvCode = D.SaleInvCode AND D.ICode = :ai_icode AND D.ICode=I.ICode\nUNION ALL  \nSELECT TransDate=H.Date, AliasName=I.CustomICode, ItemName = I.Name, TransType = 'S/Return', TransCode = H.SrInvCode\nFROM SRDetail D, SRLedger H, Item I\nWhere H.Posted = 'N' AND H.SRInvCode = D.SRInvCode AND D.ICode = :ai_icode AND D.ICode=I.ICode\nUNION ALL  \nSELECT TransDate=H.Date, AliasName=I.CustomICode, ItemName = I.Name, TransType = 'S/Return Buffer', TransCode = H.SRBufferInvCode\nFROM SRBufferDetail D, SRBufferLedger H, Item I\nWhere H.Posted = 'N' AND H.SRBufferInvCode = D.SRBufferInvCode AND D.ICode = :ai_icode AND D.ICode=I.ICode\nUNION ALL  \nSELECT TransDate=H.Date, AliasName=I.CustomICode, ItemName = I.Name, TransType = 'Adjustment ' + CASE H.AdjCatCode WHEN 1 THEN 'Increase' ELSE 'Decrease' END, TransCode = H.AdjCode\nFROM AdjDetail D, AdjHeader H, Item I\nWhere H.Posted = 'N' AND H.AdjCode = D.AdjCode AND D.ICode = :ai_icode AND D.ICode=I.ICode\nUNION ALL  \nSELECT TransDate=H.Date, AliasName=I.CustomICode, ItemName = I.Name, TransType = 'Issue', TransCode = H.IssueInvCode\nFROM IssueDetail D, IssueHeader H, Item I\nWhere H.Posted = 'N' AND H.IssueInvCode = D.IssueInvCode AND D.ICode = :ai_icode AND D.ICode=I.ICode\nUNION ALL  \nSELECT TransDate=H.Date, AliasName=I.CustomICode, ItemName = I.Name, TransType = 'Receipt', TransCode = H.ReceiptInvCode\nFROM ReceiptDetail D, ReceiptHeader H, Item I\nWhere H.Posted = 'N' AND H.ReceiptInvCode = D.ReceiptInvCode AND D.ICode = :ai_icode AND D.ICode=I.ICode\nUNION ALL  \nSELECT TransDate=H.Date, AliasName=I.CustomICode, ItemName = I.Name, TransType = 'Transfer', TransCode = H.TransCode\nFROM TDetail D, THeader H, Item I\nWhere H.Posted = 'N' AND H.TransCode = D.TransCode  AND D.ICode = :ai_icode AND D.ICode=I.ICode\nORDER BY TransDate",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_icode",
      "number"
     ]
    }
   ]
  }
 },
