  "retrieve": "SELECT \n\tItem.Name,   \n\ticode = Item.ICode,   \n\tItem.CustomICode,   \n\tManufacturer.Name,\n\tItemPacking.name,\n\titemclass.name,\n\titemcategory.name  \nFROM \n\tManufacturer,\n\titemcategory,\n\tItem\n\tLEFT OUTER JOIN ItemPacking  ON (Item.Packcode = ItemPacking.PackCode)\n\tLEFT OUTER JOIN ItemClass ON (Item.Iccode = itemClass.iccode)\nWHERE \n\t( Item.ManfCode = Manufacturer.ManfCode )    and\n\t( Item.icatcode = itemcategory.Icatcode)\nOrder By \n\tItem.Name"
 },
