  "retrieve": "SELECT \n\tQuotationCode=QuotationHeader.QuotationCode, \n\tCustCode=QuotationHeader.CustCode, \n\tRemarks=QuotationHeader.Remarks, \n\tICode = QuotationDetail.ICode,\n\tRowID=QuotationDetail.RowID,\n\tSalePrice=QuotationDetail.SalePrice, \n\tItemFlatDisc=QuotationDetail.ItemFlatDisc, \n\tDiscPerc=QuotationDetail.DiscPerc\nFROM \n\tQuotationHeader,\n\tQuotationDetail\nWHERE\n\tQuotationHeader.Active ='Y' AND\n\tQuotationHeader.QuotationCode = QuotationDetail.QuotationCode AND\n\tQuotationDetail.ICode = :ai_icode\nORDER BY\n\tQuotationCode",
