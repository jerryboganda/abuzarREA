  "retrieve": "SELECT\n \tItem.Name,\n\tItem.ICode,\n\titem.purprice,\n\titem.saleprice,\n\titem.packunits,\n\tItem.CustomICode, \n\tManufacturer.Name,\n\tItemPacking.name,\n\titemclass.name,\n\titemcategory.name, \n\titempart = (SELECT itempart.name FROM itempart where item.ipartcode = itempart.ipartcode),\n\tActive= case item.active when 1 then 'Y' else 'N' end,\n\tstock=isnull(sum(currqty),0)\nFROM \n\tItem\n\tLEFT OUTER JOIN ItemPacking  ON (Item.Packcode = ItemPacking.PackCode)\n\tLEFT OUTER JOIN GodownDetail  ON (Item.ICode = GodownDetail.ICode) ,\n\tManufacturer,\n\titemcategory,\n\titemclass\nWHERE ( Item.ManfCode = Manufacturer.ManfCode )    and\n\t\t( Item.icatcode = itemcategory.Icatcode) and\n\t\t( Item.Iccode = itemClass.iccode)\nGROUP BY\n\tItem.ICode,   \n\tItem.Name,   \n\titem.purprice,\n\titem.saleprice,\n\titem.packunits,\n\tItem.CustomICode,   \n\tManufacturer.Name,\n\tItemPacking.name,\n\titemclass.name,\n\titemcategory.name,\n\tItem.IPartCode,\n\tItem.Active\nORDER BY ITEM.NAME"
 },
