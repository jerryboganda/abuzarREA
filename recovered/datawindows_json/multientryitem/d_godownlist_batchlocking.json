  ],
  "retrieve": "SELECT\n\tGodownDetail.Batch,\n\tGodownDetail.Expiry,\n\tGodownDetail.ManfDate,    \n\tGodownDetail.Priority,   \n\tGodownDetail.CurrQty,   \n\tGodownDetail.ICode,   \n\tGodownDetail.GCode,\n\tGodownDetail.Locked,\n\tGodownDetail.LockReasonCode\nFROM GodownDetail  \nWHERE GodownDetail.ICode = :code AND\n\tGodownDetail.GCode IN\n\t\t(CASE (SELECT salegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)\n\t\tWHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = GodownDetail.GCode)\n\t\tELSE (SELECT DISTINCT GCode From GroupAllowedGodown\n\t\t\tWHERE\tGroupAllowedGodown.GroupCode = :ai_groupcode AND\n\t\t\t\tGroupAllowedGodown.Module = 1 AND\n\t\t\t\tGroupAllowedGodown.GCode = GodownDetail.GCode) END)\n",
  "update": "GodownDetail",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "code",
      "number"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "number"
     ]
    }
   ]
  }
 },
