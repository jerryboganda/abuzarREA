    "dbname": "Manufacturer"
   }
  ],
  "retrieve": "SELECT \n\tICode=I.ICODE, \n\tSuppCode=:ai_suppcode, \n\tPriority=ISNULL(MAX(S.Priority),0), \n\tRate=ISNULL(MAX(D.PurPRice), 0), \n\tDiscPerc=ISNULL(MAX(D.DiscPerc), 0), \n\tSaleQty=ISNULL(MAX(S.SaleQty),0),\n\tBonusQty=ISNULL(MAX(S.BonusQty),0),\n\tDays=ISNULL(MAX(S.Days),0),\n\tManufacturer = (SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = I.ManfCode)\nFROM \n\tITEM I\n\tLEFT OUTER JOIN ITEMSUPPLIERS AS S ON (I.ICode = S.ICode),\n\tPurDetail D,\n\t(SELECT \n\t\tD.ICode, PurInvCode=MAX(P.PurInvCode)\n\tFROM \n\t\tPurledger P, PurDetail D\n\tWHERE\n\t\tP.SuppCode = :ai_suppcode AND\n\t\tP.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tP.PurInvCode = D.PurInvCode\n\tGROUP BY\n\t\tD.ICode) P\nWHERE \n\tP.PurInvCode = D.PurInvCode AND\n\tP.ICode = D.ICode AND\n\tD.ICode = I.ICode AND\n\tI.ICode = D.ICode AND\n\tS.SuppCode = :ai_suppcode\nGROUP BY I.ICode,I.Name,I.ManfCode\nORDER BY I.Name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_suppcode",
      "number"
     ]
    },
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
