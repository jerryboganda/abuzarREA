  "retrieve": "SELECT \n\tItemCostHistory.Date,\n\tItemCostHistory.icode,\n\tCurrListRow = 0,\n\taliasname = i.customicode,\n\ti.name,\n\tItemCostHistory.AvgPrice\nFROM\n\tItemCostHistory, \n\tItem i\nWHERE \n\tItemCostHistory.ICode = i.ICode AND\n\ti.icode = case WHEN :ai_icode is null then i.icode else :ai_icode end and\n\tItemCostHistory.Date BETWEEN :adt_startdate AND :adt_enddate\nORDER BY\n\tItemCostHistory.Date,\n\tI.Name\n",
