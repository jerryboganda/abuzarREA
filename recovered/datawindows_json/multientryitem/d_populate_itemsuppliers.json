  ],
  "retrieve": "SELECT \n\tICode=I.ICODE, \n\tSuppCode=:ai_suppcode, \n\tPriority=ISNULL(S.Priority, 0), \n\tRate=ISNULL(S.Rate, 0), \n\tDiscPerc=ISNULL(S.DiscPerc, 0), \n\tSaleQty=ISNULL(S.SaleQty, 0),\n\tBonusQty=ISNULL(S.BonusQty, 0),\n\tDays=ISNULL(S.Days, 0),\n\tManufacturer=M.Name\nFROM \n\tManufacturer M,\n\tITEM I\n\tLEFT OUTER JOIN \n\t\t(SELECT * \n\t\tFROM ITEMSUPPLIERS \n\t\tWHERE SuppCode = :ai_suppcode) AS S ON (I.ICode = S.ICode)\nWHERE \n\tI.MANFCODE IN (:ai_manfcode) AND\n\tI.ManfCode = M.ManfCode\nORDER BY M.Name, I.Name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_suppcode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_manfcode",
      "numberlist"
     ]
    }
   ]
  }
 },
