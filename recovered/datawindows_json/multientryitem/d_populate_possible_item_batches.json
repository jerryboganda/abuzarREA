  "retrieve": "SELECT \n\tICode=GD.ICode, \n\tBatch=GD.Batch, \n\tExpiry=GD.Expiry,\n\tSalePrice = (SELECT I.SalePrice FROM Item I WHERE I.ICode=GD.ICode),\n\tStock = ISNULL(SUM(GD.CurrQty), 0),\n\tPriority = ISNULL(MAX(GD.Priority), 10),\n\tArrivedOn = GETDATE()\nFROM GodownDetail GD, Item I\nWHERE GD.ICode = :ai_icode AND GD.ICode = I.ICode AND\n\tSTR(GD.ICode, 10) + GD.Batch + convert(varchar(100), GD.Expiry, 121) NOT IN\n\t\t(SELECT DISTINCT STR(IBP.ICode, 10) + IBP.Batch + convert(varchar(100), IBP.Expiry, 121)\n\t\tFROM ItemBatchPricing IBP\n\t\tWHERE IBP.ICode = :ai_icode) \nGROUP BY\n\tGD.ICode, \n\tGD.Batch, \n\tGD.Expiry\n/*UNION\nSELECT \n\tICode=PD.ICode, \n\tBatch=PD.Batch, \n\tExpiry=PD.Expiry,\n\tSalePrice = MAX(PD.SalePrice),\n\tArrivedOn = MIN(PL.Date)\nFROM PurDetail PD, PurLedger PL\nWHERE PL.PurInvCode=PD.PurInvCode AND PD.ICode = :ai_icode AND\n\tSTR(PD.ICode, 10) + PD.Batch + convert(varchar(100), PD.Expiry, 121) NOT IN\n\t\t(SELECT DISTINCT STR(IBP.ICode, 10) + IBP.Batch + convert(varchar(100), IBP.Expiry, 121)\n\t\tFROM ItemBatchPricing IBP\n\t\tWHERE IBP.ICode = :ai_icode) \nGROUP BY\n\tPD.ICode, \n\tPD.Batch, \n\tPD.Expiry\nUNION\nSELECT \n\tICode=SD.ICode, \n\tBatch=SD.Batch, \n\tExpiry=SD.Expiry,\n\tSalePrice = MAX(SD.SalePrice),\n\tArrivedOn = MIN(SL.Date)\nFROM SRDetail SD, SrLedger SL\nWHERE SL.SRInvCode=SD.SRInvCode AND SD.ICode = :ai_icode AND\n\tSTR(SD.ICode, 10) + SD.Batch + convert(varchar(100), SD.Expiry, 121) NOT IN\n\t\t(SELECT DISTINCT STR(IBP.ICode, 10) + IBP.Batch + convert(varchar(100), IBP.Expiry, 121)\n\t\tFROM ItemBatchPricing IBP\n\t\tWHERE IBP.ICode = :ai_icode) \nGROUP BY\n\tSD.ICode, \n\tSD.Batch, \n\tSD.Expiry\nUNION\nSELECT \n\tICode=SD.ICode, \n\tBatch=SD.Batch, \n\tExpiry=SD.Expiry,\n\tSalePrice = MAX(SD.SalePrice),\n\tArrivedOn = MIN(SL.Date)\nFROM ReceiptDetail SD, ReceiptHeader SL\nWHERE SL.ReceiptInvCode=SD.ReceiptInvCode AND SD.ICode = :ai_icode AND\n\tSTR(SD.ICode, 10) + SD.Batch + convert(varchar(100), SD.Expiry, 121) NOT IN\n\t\t(SELECT DISTINCT STR(IBP.ICode, 10) + IBP.Batch + convert(varchar(100), IBP.Expiry, 121)\n\t\tFROM ItemBatchPricing IBP\n\t\tWHERE IBP.ICode = :ai_icode) \nGROUP BY\n\tSD.ICode, \n\tSD.Batch, \n\tSD.Expiry\nUNION\nSELECT \n\tICode=SD.ICode, \n\tBatch=SD.Batch, \n\tExpiry=SD.Expiry,\n\tSalePrice = MAX(SD.SalePrice),\n\tArrivedOn = MIN(SL.Date)\nFROM AdjDetail SD, AdjHeader SL\nWHERE SL.AdjCatCode = 1 AND SL.AdjCode=SD.AdjCode AND SD.ICode = :ai_icode AND\n\tSTR(SD.ICode, 10) + SD.Batch + convert(varchar(100), SD.Expiry, 121) NOT IN\n\t\t(SELECT DISTINCT STR(IBP.ICode, 10) + IBP.Batch + convert(varchar(100), IBP.Expiry, 121)\n\t\tFROM ItemBatchPricing IBP\n\t\tWHERE IBP.ICode = :ai_icode) \nGROUP BY\n\tSD.ICode, \n\tSD.Batch, \n\tSD.Expiry*/\nORDER BY\n\tICode, \n\tBatch, \n\tExpiry\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_icode",
      "number"
     ]
    }
   ]
  }
 },
