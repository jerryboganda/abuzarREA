  ],
  "retrieve": "SELECT \n\tCode=GodownDetail.ICode,\n\tName=GodownDetail.Batch,\n\tmanfname = (select manufacturer.name from manufacturer, item where item.icode = GodownDetail.ICode and item.manfcode=manufacturer.manfcode),\n\tGodownDetail.Batch,   \n\tGodownDetail.Expiry,   \n\tGodownDetail.ManfDate,\n\tGodownDetail.Priority,   \n\tGodownDetail.CurrQty,   \n\tGodownDetail.ICode,   \n\tGodownDetail.GCode  \nFROM\n\tGodownDetail  \nWHERE\n\tGodownDetail.ICode = :code AND\n\tGodownDetail.GCode IN\n\t\t(CASE (SELECT salegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)\n\t\tWHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = GodownDetail.GCode)\n\t\tELSE (SELECT DISTINCT GCode From GroupAllowedGodown\n\t\t\tWHERE\tGroupAllowedGodown.GroupCode = :ai_groupcode AND\n\t\t\t\tGroupAllowedGodown.Module = :ai_module AND\n\t\t\t\tGroupAllowedGodown.GCode = GodownDetail.GCode) END)",
  "update": "GodownDetail",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "code",
      "number"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_module",
      "number"
     ]
    }
   ]
  }
 },
