  ],
  "retrieve": "Select \n\taliasname = item.customicode,\t\n \titemname = item.name,\n\tgodown = Godown.name, \n\tincreaseqty = IsNull (Sum (CASE AdjHeader.AdjCatCode When 1 Then adjdetail.looseqty ELSE 0 END ) , 0 ),\n\tdecreaseqty = IsNull (Sum (CASE AdjHeader.AdjCatCode When 2 Then adjdetail.looseqty ELSE 0 END ) , 0 ),\n\tincreasevalue = IsNull (Round (Sum (CASE AdjHeader.AdjCatCode When 1 Then adjdetail.looseqty \n\t\t\t\t\t\t\t\t\t*\t\t\n\t\t\t\t\t\t\t\t\tRound(CASE :ai_pricetype WHEN 1 THEN AdjDetail.saleprice / AdjDetail.PackUnits WHEN 2 THEN AdjDetail.purprice / AdjDetail.PackUnits ELSE AdjDetail.avgprice END, 2)\n\t\t\t\t\t\t\t\t\tElse 0\n\t\t\t\t\t\t\t\t\tEND\n\t\t\t\t\t\t\t\t\t\t\t) , 2 ), 0 ),\n\tdecreasevalue = IsNull (Round (Sum (CASE AdjHeader.AdjCatCode When 2 Then adjdetail.looseqty \n\t\t\t\t\t\t\t\t\t*\t\t\n\t\t\t\t\t\t\t\t\tRound(CASE :ai_pricetype WHEN 1 THEN AdjDetail.saleprice / AdjDetail.PackUnits WHEN 2 THEN AdjDetail.purprice / AdjDetail.PackUnits ELSE AdjDetail.avgprice END, 2)\n\t\t\t\t\t\t\t\t\tElse 0\n\t\t\t\t\t\t\t\t\tEND\n\t\t\t\t\t\t\t\t\t\t\t) , 2 ), 0 )\n\nFrom Item , AdjHeader , AdjDetail , Godown\n\nWhere AdjHeader.AdjCode = AdjDetail.AdjCode AND\n      AdjDetail.icode  = Item.Icode AND\n      AdjDetail.gcode = :ai_gcode AND\n\t\tAdjDetail.gcode = Godown.Gcode AND\n\t\tAdjHeader.Date >= :ad_startdate AND AdjHeader.Date <= :ad_enddate\n\nGroup By \n\t\t\tItem.Name , \n\t\t\tItem.customicode,\n\t\t\tGodown.Name\n\nOrder By itemname\n\n\n\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_pricetype",
      "number"
     ]
    },
    {
     "_items": [
      "ai_gcode",
      "number"
     ]
    }
   ]
  },
  "sort": "itemname A, aliasname A"
 },
