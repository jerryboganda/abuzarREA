  "retrieve": "SELECT \t\n\titem.customicode,\n\tdbo.ItemConversionDetail.alternatecustomicode,\n\titem.name, \n\tcurrlistrow = 0,\n\tdbo.ItemConversionDetail.ItemConversionCode,\n\tdbo.ItemConversionDetail.gcode,\n\tdbo.ItemConversionDetail.icode,\n\tdbo.ItemConversionDetail.SalePrice,\n\tdbo.ItemConversionDetail.packunits,      \n\tdbo.ItemConversionDetail.UnitPrice,\n\tdbo.ItemConversionDetail.GodownStock,\n\tdbo.ItemConversionDetail.TotalStock,\n\tdbo.ItemConversionDetail.RowID,\n\tdbo.ItemConversionDetail.qty\nFROM \n\tdbo.ItemConversionDetail, \n\tdbo.item\nWHERE \n\t( dbo.ItemConversionDetail.ItemConversionCode = :r_InvCode )   and\n\t( dbo.ItemConversionDetail.icode = dbo.item.icode )",
