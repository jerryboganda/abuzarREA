  ],
  "retrieve": "SELECT\n\titem.customicode,\n\tdbo.adjbufferdetail.alternatecustomicode,\n\titem.name, \n\tcurrlistrow = 0,\n\tstock=0.0000,\n\ttotalstock=0.0000,\n\tQuickSearch=SPACE(100),\n\tdbo.adjbufferdetail.adjbuffercode,\n\tdbo.AdjbufferDetail.icode,\n\tdbo.Adjbufferdetail.stockinhand,\n\tAdjustmentQty = ISNULL(dbo.Adjbufferdetail.stockonshelf, 0) - ISNULL(dbo.Adjbufferdetail.stockinhand, 0),\n\tdbo.Adjbufferdetail.stockonshelf\n\nFROM \n\tdbo.adjbufferdetail, dbo.item\n\nWHERE \n\t( dbo.adjbufferdetail.adjbuffercode = :ar_InvCode )   and\n\t( dbo.adjbufferdetail.icode = dbo.item.icode ) \n\nOrder by \n\tdbo.adjbufferdetail.rowid",
  "update": "adjbufferdetail",
  "updatewhere": "0",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
