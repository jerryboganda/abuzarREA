  "retrieve": "SELECT\th.adjcode, \n\tType=Case h.adjcatcode WHEN 1 THEN 'INCREASE' ELSE 'DECREASE' END, \n\th.date, \n\th.remarks, \n\td.icode, \n\taliasname=i.customicode,\n\titem=i.name,\n\td.batch,\n\td.expiry,\n\td.looseqty,\n\td.price,\n\td.avgprice,\n\td.saleprice,\n\td.purprice,\n\th.Usercode,\n\tu.username,\n\th.posted\nFROM \tadjheader h, adjdetail d, users u, item i\nWHERE \th.adjcode = d.adjcode and \n\th.date >= :ar_startdate and \n\th.date <= :ar_enddate and\n\th.adjcatcode IN (:aa_adjtype)and\n\th.usercode = u.usercode and\n\td.icode = i.icode\nORDER BY d.adjutn, i.name, i.customicode, d.batch, d.expiry\n",
