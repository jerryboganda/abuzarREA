  ],
  "retrieve": "SELECT \n\tadjheader.adjcode , \n\tadjheader.date , \n\tposted = adjheader.posted,\n\tadjheader.remarks,\n\tPostedBy = IsNull((Select username from users \n\t\t\t\t\twhere dbo.adjheader.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\t\t\t\twhere dbo.adjheader.modifiedby = dbo.users.usercode), ''),\n\tAccount = (SELECT A.Name FROM Accounts A WHERE A.AccCode = adjheader.AccCode)\nFROM \n\tadjheader     \nWHERE  \n\t( adjheader.adjcatcode = 1 ) AND \n\t( Posted IN (:as_Posted)) AND \n\t ( adjheader.headerno IS NULL OR \n\t\tadjheader.headerno in (SELECT headercode FROM GroupAllowedHeader WHERE GroupCode = :ai_groupcode and module = :ai_module))",
  "update": "adjheader",
  "updatewhere": "0",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_Posted",
      "stringlist"
     ]
    },
    {
     "_items": [
      "ai_GroupCode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_Module",
      "number"
     ]
    }
   ]
  }
 },
