  "retrieve": "SELECT \n\t\titemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END, \n      \tmanf=(select name from manufacturer where manufacturer.manfcode=max(item.manfcode)),   \n\t\taliasname=item.customicode,  \n\t\tsaleperson=(select  name from salesman where salesman.salesmancode=max(saleledger.smancode)), \n         packingdesc=max(item.packingdesc), \n         accname = dbo.accounts.name,   \n\t\tcustalias=max(accounts.aliasname),\n         address = max(dbo.customer.address1),   \n         address2= max(dbo.customer.address2),   \n\t\tcustTaxRegno=max(customer.salestaxregno)  ,\n         salesman = dbo.users.username,   \n         saleinvcode = dbo.saleledger.saleinvcode,   \n         headerno = max(dbo.saleledger.headerno),   \n         date = dbo.saleledger.date,\n         invdiscperc = dbo.saleledger.discperc,   \n         misccharges = dbo.saleledger.misccharges,   \n         flatdisc = dbo.saleledger.flatdisc,   \n         invsalestax = dbo.saleledger.salestax,   \n\t\t\tsalecatcode =max( dbo.saleledger.salecatcode),\n         gcode = saledetail.gcode,   \n         icode = saledetail.icode,   \n         batch =max( saledetail.batch),   \n         expiry = min(saledetail.expiry),   \n         looseqty = sum(saledetail.looseqty),   \n         bonusqty =sum( saledetail.bonusqty),   \n         packqty = sum(saledetail.packqty),   \n         packunits= max(saledetail.packunits),   \n         saleprice= saledetail.saleprice,   \n         discperc = saledetail.discperc,  \n\t\t\titemflatdisc=saledetail.itemflatdisc,   \n         salestax = max(saledetail.salestax),   \n         Id = max(dbo.saledetail.IDENTITYCOL),   \n         posted=max(saleledger.posted),   \n         balance=ISNULL(max(saleledger.balance), 0), \n\t\tamt=max(saleledger.amt),  \n\t\tprintbalance=max(saleledger.printbalance),\n         unitsalestax = saledetail.unitsalestax,   \n         gstperc = saledetail.gstperc,   \n         invgstperc = max(saleledger.invgstperc1),   \n         \tdbo.saleledger.custrefno,\t\n\t\t\tdbo.saleledger.remarks,\n\t\t\tprintwaranty=max(dbo.saleledger.printwaranty),\n\t\t\tprintbatch=max(dbo.saleledger.printbatch),\n\t\t\tcustcode=saleledger.custcode,\n\t\t\t\n\t\t\tmessages=(select description from message where messagecode=max(saleledger.messagecode))\n\n    FROM saleledger,   \n         saledetail,   \n         accounts,   \n         customer,   \n         users,   \n         item  \n\n   WHERE ( dbo.saleledger.saleinvcode between :ar_SInvCode and :ar_linvcode ) AND  \n         ( dbo.saleledger.custcode IN (:ar_custcode) )AND \n         ( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND  \n         ( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  \n         ( dbo.customer.custcode = dbo.accounts.acccode ) AND  \n         ( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  \n         ( dbo.saledetail.icode = dbo.item.icode)    \n\nGROUP BY saleledger.saleinvcode, \n\t\t\tsaleledger.date, \n\t\t\t/*saleledger.headerno,*/\n\t\t\tsaleledger.custcode, \n\t\t\tsaleledger.discperc, \n\t\t\tsaleledger.flatdisc, \n\t\t\tsaleledger.misccharges, \n\t\t\tsaleledger.salestax, \n\t\t\tsaleledger.remarks,\n\t\t\tsaleledger.custrefno, \n\t\t\tsaledetail.icode,\n\t\t\tsaledetail.saleprice, \n\t\t\tsaledetail.itemflatdisc,\n\t\t\tsaledetail.gstperc,\n\t\t\tsaledetail.discperc,\n\t\t\tsaledetail.unitsalestax,\n\t\t\tsaledetail.gcode, \n\t\t\titem.name,\n\t\t\titem.customicode,\n\t\t\titem.icode,\n\t\t\titem.printable, \n\t\t\taccounts.name,\n\t\t\tdbo.users.username\nORDER BY /*dbo.item.customicode,*/\n\t\t\tdbo.saledetail.saleinvcode,\n\t\t\tmax(dbo.saledetail.IDENTITYCOL)",
