  "retrieve": "SELECT icode, aliasname = customicode, name, gcode=:ar_godown, rate=purprice, avgprice, packunits, qty=1.0000, \n\tgstperc=gstperc1, packsalestax, discperc=purdiscperc, recentpurprice, saleprice,packingdesc\nfrom item \nwhere (manfcode in (:ar_manfcode) AND icatcode in (:ar_icatcode) AND\n\t\ticcode in (:ar_iccode) and packcode in (:ar_packcode)) AND (Active =1)\norder by name, icode\n",
