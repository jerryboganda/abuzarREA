  "retrieve": "SELECT\n\tPurInvCode=SL.PurInvCode, \n\tSuppCode=SL.SuppCode,\n\tAliasName = (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = SL.SuppCode), \n\tSupplier = (SELECT A.Name FROM Accounts A WHERE A.AccCode = SL.SuppCode), \n\tSL.Date, \n\tUserName=(SELECT users.username FROM users where users.usercode = SL.SalesManCode),\n\tSL.Remarks,\n\tSL.Posted,\n\tSELECTED='Y'\nFROM\n\tPurLedger SL\nWHERE \n\tSL.SuppCode = CASE WHEN :ai_suppcode > 0 THEN :ai_suppcode ELSE SL.SuppCode END AND\n\tSL.Date >= :ad_startdate AND SL.Date <= :ad_enddate AND SL.Posted='Y'\nORDER BY\n\tSL.Date,\n\tSL.PurInvCode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_suppcode",
      "number"
     ]
    },
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "date A"
 },
