  "retrieve": "SELECT \n\tPurLedger.PurInvCode,\n\tPurLedger.HeaderNo,\n\tPurLedger.HeaderInvNo,\n\tPurLedger.Date,\n\tPurLedger.SuppCode,\n\tAccounts.Name,\n\tAccounts.AliasName,\n\tPurLedger.OutstandingAmt,\n\tPurLedger.InvTotal,\n\tPurLedger.Posted,\n\tOldMarked=PurLedger.Marked,\n\tPurLedger.AccountFor,\n\tPurLedger.Marked\nFROM \n\tPurLedger, Accounts\nWHERE\n\tPurLedger.AccountFor = 'Y' AND\n\tPurLedger.Posted ='Y' AND\n\tPurLedger.SuppCode = Accounts.AccCode",
