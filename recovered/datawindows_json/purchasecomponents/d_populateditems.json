  "retrieve": "SELECT item.icode, item.name, gcode=:ar_godown, rate=item.purprice, item.avgprice, item.packunits, \n\titem.recentpurprice, g.batch, g.expiry, qty=g.currqty, \n\tgstperc=item.gstperc1, item.packsalestax, discperc=item.purdiscperc, saleprice, item.packingdesc\nfrom item, godowndetail g\nwhere (item.manfcode in (:ar_manfcode) OR item.icatcode in (:ar_icatcode) OR \n\t\titem.iccode in (:ar_iccode) OR item.packcode in (:ar_packcode) OR \n\t\titem.NAME LIKE (:ar_itemlike)) AND \n\t\tg.icode=item.icode AND g.gcode=case :ar_godown when NULL then -1 else :ar_godown end AND g.currqty <> 0\norder by item.name, item.icode, g.batch, g.expiry, g.currqty\n",
