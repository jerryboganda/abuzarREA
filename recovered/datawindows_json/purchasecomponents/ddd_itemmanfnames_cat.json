  "retrieve": "   SELECT dbo.item.icode,\n\t\t\tdbo.item.customicode,\n\t\t\tdbo.item.name,\n\t\t\tlocalitemname = dbo.item.localitemname,\n\t\t\tdbo.item.manfcode, \n\t\t\tdbo.item.packunits,\n\t\t\tdbo.item.saleprice,\n\t\t\tdbo.Manufacturer.name,\n\t\t\tstock = (select  sum(dbo.godowndetail.currqty) \n\t\t\t\t\t\tfrom dbo.godowndetail \n\t\t\t\t\t\twhere dbo.godowndetail.icode = dbo.item.icode),\n\t\t\tPacking = dbo.itempacking.name,\n\t\t\tdbo.item.restricted,\n\t\t\tdbo.item.location,\n\t\t\ttransitstock=item.transitstock\n    FROM dbo.item LEFT OUTER JOIN dbo.itempacking ON (dbo.item.packcode = dbo.itempacking.packcode), \n\t\t\tdbo.Manufacturer\n\t WHERE dbo.item.Active = 1 \tand\n\t\t\t dbo.Manufacturer.manfcode = dbo.item.manfcode and\n          dbo.item.icatcode in (:ai_catcode) \nORDER BY dbo.item.name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_catcode",
      "numberlist"
     ]
    }
   ]
  }
 },
