    "name": "groupname",
    "dbname": "GroupName"
   }
  ],
  "retrieve": "SELECT\n\tDISTINCT\tA.GroupCode,\n\tGroupName= \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = A.GroupCode)\n\t\tWHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = A.GroupCode)\n\t\tWHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = A.GroupCode)\n\t\tELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = A.GroupCode) END\nFROM\n\t(SELECT\t \n\t\tGroupCode=\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END\n\tFROM \n\t \tItem I\n\tWHERE\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ai_groupcode)) AS A\nORDER BY\n\tGroupName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_reportgrouping",
      "string"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "numberlist"
     ]
    }
   ]
  }
 },
