  "retrieve": "SELECT\n\tdbo.item.icode,\n\tdbo.item.customicode,\n\tdbo.item.name,\n\tlocalitemname = dbo.item.localitemname,\n\tdbo.item.manfcode, \n\tdbo.item.packunits,\n\tdbo.item.purprice,\n\tdbo.item.saleprice,\n\tdbo.Manufacturer.name,\n\tstock = (select\tsum(dbo.godowndetail.currqty)\n\t\tfrom\tdbo.godowndetail \n\t\twhere\tdbo.godowndetail.icode = dbo.item.icode),\n\tsstock = (select\tsum(dbo.godowndetail.currqty)\n\t\tfrom\tdbo.godowndetail \n\t\twhere\tdbo.godowndetail.icode = dbo.item.icode and\n\t\t\tdbo.godowndetail.gcode IN \n\t\t\t(SELECT Godown.GCode\n\t\t\tFROM Godown\n\t\t\tWHERE GCode IN\n\t\t\t\t(CASE (SELECT salegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)\n\t\t\t\tWHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = Godown.GCode)\n\t\t\t\tELSE (SELECT DISTINCT GCode From GroupAllowedGodown\n\t\t\t\t\tWHERE\tGroupAllowedGodown.GroupCode = :ai_groupcode AND\n\t\t\t\t\t\tGroupAllowedGodown.Module = 1 AND\n\t\t\t\t\t\tGroupAllowedGodown.GCode = Godown.GCode) END))),\n\tpstock=\t(select\tsum(dbo.godowndetail.currqty)\n\t\tfrom\tdbo.godowndetail \n\t\twhere\tdbo.godowndetail.icode = dbo.item.icode and\n\t\t\tdbo.godowndetail.gcode IN \n\t\t\t(SELECT Godown.GCode\n\t\t\tFROM Godown\n\t\t\tWHERE GCode IN\n\t\t\t\t(CASE (SELECT purchasegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)\n\t\t\t\tWHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = Godown.GCode)\n\t\t\t\tELSE (SELECT DISTINCT GCode From GroupAllowedGodown\n\t\t\t\t\tWHERE\tGroupAllowedGodown.GroupCode = :ai_groupcode AND\n\t\t\t\t\t\tGroupAllowedGodown.Module = 3 AND\n\t\t\t\t\t\tGroupAllowedGodown.GCode = Godown.GCode) END))),\n\tPacking = dbo.itempacking.name,\n\tpackingdesc=item.packingdesc,\n\tdbo.item.icatcode,\n\tdbo.item.iccode,\n\tdbo.item.packcode,\n\tdbo.item.itemalertcode,\n\titemalerttypecode = (select ia.itemalerttypecode from itemalert ia where ia.itemalertcode = item.itemalertcode),\n\tdbo.item.restricted,\n\tdbo.item.location\nFROM\n\tdbo.item LEFT OUTER JOIN dbo.itempacking ON (dbo.item.packcode = dbo.itempacking.packcode), \n\tdbo.Manufacturer, Recipe R\nWHERE\t\n\tR.ResultedItem = dbo.Item.icode And\n\tdbo.item.itemtypecode <> 2 And\n\tdbo.item.Active = 1 And\n\tdbo.Manufacturer.manfcode = dbo.item.manfcode \n\t\nORDER BY dbo.item.name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_groupcode",
      "number"
     ]
    }
   ]
  }
 },
