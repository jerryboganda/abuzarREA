   }
  ],
  "retrieve": "  SELECT dbo.accounts.name,   \n\t\t\tdbo.accounts.aliasname,   \n         dbo.supplier.suppcode,\n\t\t\tdbo.supplier.address1,\n\t\t\tdbo.supplier.phone,\n\t\t\tdbo.supplier.City,\n\t\t\tdbo.supplier.country,\n\t\t\tdbo.supplier.suppcatcode,\n\t\t\tSummaryAccount = \n\t\t\t\tCASE \n\t\t\t\tWHEN (SELECT Count(SD.AccCode) \n\t\t\t\t\t\tFROM SummaryAccountDetail SD \n\t\t\t\t\t\tWHERE SD.AccCode = dbo.Accounts.AccCode) = 0 THEN NULL \n\t\t\t\tELSE\n\t\t\t\t\t(SELECT MAX(SA.Name) + ' (' + MAX(SA.AliasName) + ')' \n\t\t\t\t\tFROM SummaryAccount SA, SummaryAccountDetail SD \n\t\t\t\t\tWHERE SD.AccCode = dbo.Accounts.AccCode AND \n\t\t\t\t\t\tSD.SummaryAccCode = SA.SummaryAccCode)\n\t\t\t\tEND,\n\t\t\tbalancetype=CASE WHEN V.Balance > 0 THEN 'DR.' ELSE 'CR.' END,\n\t\t\tbalance= case accounts.restricted when 'Y' then 0\n\t\t\t\t\t\telse V.balance\n\t\t\t\t\t\tend\n    FROM \n\t\tdbo.accounts LEFT OUTER JOIN    \n\t\t(SELECT acccode, sum(debit - credit) as balance \n\t\t\t\t\t\tFROM virtualgl \n\t\t\t\t\t\tGROUP BY acccode) AS V ON (dbo.accounts.acccode = v.acccode),\n\t\tdbo.supplier\n   WHERE ( dbo.supplier.suppcode = dbo.accounts.acccode ) and\n\t\t\t( dbo.accounts.active='Y')/*and\n         ( dbo.supplier.suppcode NOT IN (Select dbo.global.code From dbo.global Where dbo.global.name = 'GT_OpeningSupplierACC') )    */\n",
  "sort": "accounts_name A"
 },
