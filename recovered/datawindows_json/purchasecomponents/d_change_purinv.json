  "retrieve": "SELECT \n\tpurinvcode,\n\tdate,\n\tsuppinvcode,\n\tremarks=purledger.remarks, \n\tsuppinvdate,\n\taccounts.name,\n\tporb,\n\tInvTotal,\n\tpurtypecode,\n\tpurledger.icatcode,\n\tpurinvpagesize,\n\tsuppinvamount,\n\tcreditdays\nFROM \t\n\tpurledger, accounts\nWHERE \n\tpurledger.SuppCode IN (:ai_suppcode) AND\n\tpurledger.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tpurledger.suppcode=accounts.acccode\n\t\n\t\n",
  "update": "purledger",
  "updatewhere": "0",
  "updatekeyinplace": "yes",
