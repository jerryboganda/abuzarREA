    "name": "qty",
    "dbname": "Qty"
   }
  ],
  "retrieve": "SELECT \n\tICode = T.icode, \n\tItemName = I.name, \n\tGCode = T.gcode, \n\tQty = ISNULL(SUM(T.looseqty - T.SatisfiedQty), 0)\nFROM\n\t(SELECT \n\t\tSl.SaleInvcode, \n\t\tSd.icode, \n\t\tSd.gcode, \n\t\tSd.RowId, \n\t\tSd.looseqty,\n\t\tSatisfiedQty = IsNull ( (select sum(dsd.duesatisfyqty) from duesatisfyheader dsh, duesatisfydetail dsd where dsh.saleinvcode = sl.saleinvcode And dsh.duesatisfycode = dsd.duesatisfycode And dsd.icode = sd.icode And dsd.salerowid = sd.rowid )  ,  0  )\n\tFROM\n\t\tSaleLedger Sl,\n\t\tSaleDetail Sd\n\tWHERE\n\t\tsl.saleinvcode = sd.saleinvcode And  \n\t\tsl.Posted = 'Y'  And\n\t\tsl.Date Between :ad_startdate And :ad_enddate And\n\t\tsd.Due = 'D') T,\n\tItem I\nWHERE\n\tI.ICode = T.ICode\nGROUP BY\n\tT.icode, \n\tI.name, \n\tT.gcode\nHAVING \n\tISNULL(SUM(T.looseqty - T.SatisfiedQty), 0) > 0\nORDER BY \n\tItemName",
  "update": "Item",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
