  "retrieve": "SELECT\n\tVoucherCode = H.GLVochCode,\n\tDate = H.Date,\n\tAccCode=D.AccCode,\n\tAliasName = A.AliasName,\n\tTitle = A.Name,\n\tAmount = D.Credit,\n\tRemarks = D.Remarks,\n\tChequeNo= D.ChkNo,\n\tSelected = 0,\n\tRowID = GLRowID\nFROM\n\tGLHeader H,\n\tGLDetail D,\n\tAccounts A\nWHERE\n\tH.VochCatCode = :ai_VoucherCatCode AND\n\tH.GLVochCode BETWEEN :ai_startvouchercode AND :ai_lastvouchercode AND\n\tH.GLVochCode = D.GLVochCode AND\n\tH.AccCode <> D.AccCode AND\n\tD.AccCode = A.AccCode\nORDER BY\n\tH.GLVochCode,\n\tD.GLRowID",
  "arguments": {
