   }
  ],
  "retrieve": "SELECT\n\tsaleledger.saleinvcode , \n\tinvselect = 'N',\n\tsaleledger.date , \n\taccounts.name,\n\tusers.username, \n\tcustcode=saleledger.custcode,\n\tNetAmount = saleledger.InvTotal\nFROM  \n\taccounts, saleledger, users\nWHERE \n\tsaleledger.posted = 'N' AND\n\tsaleledger.saleinvcode Between :al_sinvcode AND :al_linvcode AND\n\tsaleledger.custcode = accounts.acccode AND \n\tdbo.saleledger.salesmancode = dbo.users.usercode ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "al_sinvcode",
      "number"
     ]
    },
    {
     "_items": [
      "al_linvcode",
      "number"
     ]
    }
   ]
  },
  "sort": "code A"
 },
