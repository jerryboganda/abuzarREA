  "retrieve": "SELECT\tsaleledgermodified.saleinvcode , \n\t\t\tsaleledgermodified.date , \n\t\t\tsaleledgermodified.custrefno, \n\t\t\tsaleledgermodified.remarks , \n\t\t\taccounts.name,\n\t\t\tusers.username, \n\t\t\tcustcode=saleledgermodified.custcode,\n\t\t\tNetAmount = Round(SUM((saledetailmodified.looseqty*(saledetailmodified.saleprice - saledetailmodified.itemflatdisc)) *\n\t\t\t\t\t\t\t\t(1 - (.01 * saledetailmodified.discperc))) * (1- (.01 * saleledgermodified.discperc)) + \n\t\t\t\t\t\t\t\tsaleledgermodified.misccharges + saleledgermodified.salestax - saleledgermodified.flatdisc, 0)+\n\t\t\t\t\t\t\t\tRound(SUM( (saledetailmodified.looseqty + saledetailmodified.bonusqty) * saledetailmodified.unitsalestax) + \n\t\t\t\t\t\t\t\tSUM(ROUND( (saledetailmodified.looseqty * (saledetailmodified.saleprice - saledetailmodified.itemflatdisc)) *\n\t\t\t\t\t\t\t\t(1 - (.01 * saledetailmodified.discperc)) * saledetailmodified.gstperc * .01, 2)) +\n\t\t\t\t\t\t\t\tROUND( (SUM((saledetailmodified.looseqty * (saledetailmodified.saleprice - saledetailmodified.itemflatdisc)) *\n\t\t\t\t\t\t\t\t(1 - (.01 * saledetailmodified.discperc))) * (1- (.01 * saleledgermodified.discperc)) -\n\t\t\t\t\t\t\t\tsaleledgermodified.flatdisc) * (saleledgermodified.invgstperc1 * .01), 2), 0)\nFROM  accounts, saleledgermodified, saledetailmodified, users\nWHERE  ( saleledgermodified.custcode = accounts.acccode ) and \n          ( dbo.saleledgermodified.saleinvcode = dbo.saledetailmodified.saleinvcode)   and\n          ( dbo.saleledgermodified.salesmancode = dbo.users.usercode) and\n\t\t\t ( Posted = 'N')\nGROUP BY \n\tsaleledgermodified.SALEINVCODE,\n\tsaleledgermodified.CustCode,\n\tsaleledgermodified.DiscPerc,\n\tsaleledgermodified.MiscCharges,\n\tsaleledgermodified.SalesTax,\n\tsaleledgermodified.FlatDisc,\n\tsaleledgermodified.DiscPerc,\n\tsaleledgermodified.FlatDisc,\n\tsaleledgermodified.InvGSTPerc1,\n\tsaleledgermodified.date , \n\tsaleledgermodified.custrefno, \n\taccounts.name,\n\tsaleledgermodified.posted,\n\tsaleledgermodified.postedby,\n\tsaleledgermodified.modifiedby,\n\tusers.username,\n\tdbo.saleledgermodified.ReprintingCounter, \n\tsaleledgermodified.remarks\n",
  "sort": "code D"
 },
