  "retrieve": "SELECT \n\tGuestTransfer.GuestTransferCode,   \n\tGuestTransfer.GuestCheckInCode,   \n\tRegNo = (SELECT G.RegNo FROM Guest G, GuestCheckIN GC WHERE GuestTransfer.GuestCheckInCode = GC.GuestCheckInCode AND G.GuestCode = GC.GuestCode),\n\tGuest = (SELECT G.Name FROM Guest G, GuestCheckIN GC WHERE GuestTransfer.GuestCheckInCode = GC.GuestCheckInCode AND G.GuestCode = GC.GuestCode),\n\tCheckOut = (SELECT GC.CheckOut FROM GuestCheckIN GC WHERE GuestTransfer.GuestCheckInCode = GC.GuestCheckInCode),\n\tGuestTransfer.Date,   \n\tGuestTransfer.UserCode,   \n\tGuestTransfer.LastRoom,   \n\tGuestTransfer.NewRoom,   \n\tGuestTransfer.Remarks  \nFROM \n\tGuestTransfer  \n",
