   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "guestcheckincode",
    "dbname": "GuestCheckInCode"
   }
  ],
  "retrieve": "  SELECT \n\t\tGuest=Guest.Name + ' (' + Guest.RegNo + ')', \n         Guest.RegNo,   \n\t\tGuest.Name,   \n         Guest.GuestCode,   \n\t\tcustomer=(select accounts.name from accounts where acccode=Guest.custcode),\n         Guest.Active,\n\t\tGuestCheckInCode=(SELECT MAX(GC.GuestCheckInCode) FROM GuestCheckIn GC WHERE GC.GuestCode = Guest.GuestCode AND GC.CheckOut='N')\n    FROM Guest   \nWHERE \tGuestcode in\n\t\t(SELECT PP.GuestCode\n\t\tFROM Guest PP\n\t\tWHERE\n\t\t\tdbo.fn_GetPreference('allowedGuestsintransaction') = 'A'\n\t\tUNION \n\t\tSELECT PP.GuestCode\n\t\tFROM Guest PP\n\t\tWHERE\n\t\t\tdbo.fn_GetPreference('allowedGuestsintransaction') = 'C' AND \tPP.Active = 'Y'\n\t\tUNION \n\t\tSELECT PP.GuestCode\n\t\tFROM Guest PP, GuestCheckIn PA\n\t\tWHERE\n\t\t\tdbo.fn_GetPreference('allowedGuestsintransaction') = 'D' AND\n\t\t\tPP.Active = 'Y' AND\n\t\t\tPP.GuestCode = PA.GuestCode AND\n\t\t\tPA.CheckOut = 'N'\t\n\t\tUNION \n\t\tSELECT PP.GuestCode\n\t\tFROM Guest PP\n\t\tWHERE\n\t\t\tdbo.fn_GetPreference('allowedGuestsintransaction') = 'X' AND\n\t\t\tPP.Active = 'Y' AND\n\t\t\tPP.GuestCode NOT IN\n\t\t\t\t(SELECT DISTINCT PA.GuestCode FROM GuestCheckIn PA WHERE PA.CheckOut='Y'))\n\n",
  "update": "Guest",
  "updatewhere": "1",
  "updatekeyinplace": "no"
 },
