   },
   {
    "type": "char(1)",
    "updatewhereclause": "yes",
    "name": "checkout",
    "dbname": "CheckOut"
   }
  ],
  "retrieve": "SELECT \n\tA.RegNo,\n\tA.Name, \n\tA.GuestCode,\n\tA.Customer,\n\tCustomerCategory = (SELECT CustomerCategory.Name FROM CustomerCategory WHERE CustomerCategory.CustCatCode = A.CustCatCode),\n\tDebit= CASE WHEN Balance > 0 THEN Balance ELSE 0 END,\n\tCredit= CASE WHEN Balance < 0 THEN ABS(Balance) ELSE 0 END,\n\tCheckOut=\n\t\t(SELECT PA.CheckOut \n\t\tFROM GuestCheckIn PA\n\t\tWHERE PA.GuestCheckInCode IN \t\n\t\t\t(SELECT GuestCheckInCode=MAX(GuestCheckInCode) \n\t\t\tFROM GuestCheckIn \n\t\t\tWHERE GuestCode = A.GuestCode))\nFROM\n\t(SELECT \n\t\tP.Name, P.RegNo, P.GuestCode, C.CustCode, Customer=A.Name, C.CustCatCode, Balance=SUM(V.Debit - V.Credit)\n\tFROM\n\t\tVirtualGL V,\n\t\tAccounts A,\n\t\tCustomer C,\n\t\tSubAccounts S,\n\t\tGuest P\n\tWHERE \n\t\tV.GuestCode = P.GuestCode AND\n\t\tP.GuestCode IN (:ai_Guestcode) AND\n\t\tV.Date <= :ad_Date AND \n\t\tV.AccCode = A.AccCode AND\n\t\tA.AccCode = C.CustCode AND\n\t\tV.AccCode = C.CustCode AND\n\t\tA.SubCode = S.SubAccCode \n\tGROUP BY \n\t\tP.GuestCode, \n\t\tP.Name, \n\t\tP.RegNo, \n\t\tA.Name, \n\t\tC.CustCode, \n\t\tC.CustCatCode) A\nORDER BY A.RegNo, A.Name, A.GuestCode, A.Customer\n   ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_date",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_guestcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "regno A, name A"
 },
