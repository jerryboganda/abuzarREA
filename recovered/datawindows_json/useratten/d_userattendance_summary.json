    "updatewhereclause": "yes",
    "name": "secondsworked",
    "dbname": "SecondsWorked"
   }
  ],
  "retrieve": "SELECT\n\tU.UserCode,\n\tU.UserName, \n\tUT.AttendenceCount,\n\tHoursWorked = (UT.SecWorked / 3600),\n\tMinutesWorked = (UT.SecWorked % 3600) / 60,\n\tSecondsWorked = ((UT.SecWorked % 3600) % 60)\nFROM\n\tUsers U,\n\t(SELECT \n\t\tUserCode,\n\t\tAttendenceCount=COUNT(UserCode),\n\t\tSecWorked = SUM(DATEDIFF(ss, TimeIn, TimeOut))\n\tFROM DBO.UserAttendance\n\tWHERE UserCode IN (:ai_usercode) AND \n\t\tTimeIn >= :ad_startdate AND \n\t\tTimeIn <= :ad_enddate AND\n\t\tTimeOut >= :ad_startdate AND \n\t\tTimeOut <= :ad_enddate\n\tGROUP BY UserCode) UT\nWHERE \n\tU.UserCode IN (:ai_usercode) AND \n\tU.UserCode = UT.UserCode\nORDER BY\n\tU.UserName\n",
  "update": "Users",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_usercode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
