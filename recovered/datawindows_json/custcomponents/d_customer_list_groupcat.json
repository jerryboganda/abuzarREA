  "retrieve": "SELECT \n\taccounts.Name,   \n\taccounts.AliasName,\n\tAccounts.AlertCode,\n\tAlertTypeCode=(SELECT Alert.AlertTypeCode FROM Alert WHERE Alert.AlertCode = Accounts.AlertCode),\n\tCategory = (SELECT CustomerCategory.Name FROM CustomerCategory WHERE CustomerCategory.CustCatCode = Customer.CustCatCode),\n\tRegion = (SELECT Region.Name FROM Region WHERE Region.RegionCode = Area.RegionCode),\n\tArea.Name,   \n\tsubarea = (SELECT subarea.name FROM subarea WHERE subarea.subareaCode = Customer.subareaCode),\n\tcustomer.Address1,   \n\tcustomer.Address2,   \n\tcustomer.phone,\n\tcustomer.fax,\n\taccounts.AccCode,   \n\tcustomer.CustCode,   \n\tArea.AreaCode ,\n\tcustomer.city ,\n\tcustomer.membershipid,\n\tcustomer.nic,\n\tcustomer.cellno,\n\tsalesperson = (SELECT salesman.name FROM salesman WHERE salesman.salesmanCode = Customer.salesmancode)\n\nFROM \n\taccounts,   \n\tcustomer,   \n\tArea  \nWHERE \n\t( Area.AreaCode = customer.AreaCode ) and  \n\t( accounts.AccCode = customer.CustCode ) and  \n\t( customer.custcode = accounts.acccode )  AND\n\t( customer.custcatcode In ( Select customercategorycode \n\t\t\t\t\t\t\t\t\t From CustomerGroupCategory\n\t\t\t\t\t\t\t\t\t Where groupcode = :ai_groupcode ))\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_groupcode",
      "number"
     ]
    }
   ]
  }
 },
