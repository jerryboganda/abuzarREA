  "retrieve": "SELECT CustCategory=C.NAME, ItemCategory=I.Name, PreDiscPerc=D.PreDiscPerc, DiscPerc=D.DiscPerc, ItemFlatDisc=D.ItemFlatDisc\nFROM \n\t(SELECT \n\t\tCUSTCATCODE, \n\t\tICATCODE, \n\t\tDISCPERC = (SELECT D.DISCPERC \n\t\t\t\t\tFROM CUSTITEMCATWISESALEDISCOUNT D\n\t\t\t\t\tWHERE D.CUSTCATCODE = CC.CUSTCATCODE AND\n\t\t\t\t\t\t\tD.ICATCODE = II.ICATCODE),\n\t\tPREDISCPERC = (SELECT D.PREDISCPERC \n\t\t\t\t\tFROM CUSTITEMCATWISESALEDISCOUNT D\n\t\t\t\t\tWHERE D.CUSTCATCODE = CC.CUSTCATCODE AND\n\t\t\t\t\t\t\tD.ICATCODE = II.ICATCODE),\n\t\tITEMFLATDISC = (SELECT D.ITEMFLATDISC\n\t\t\t\t\tFROM CUSTITEMCATWISESALEDISCOUNT D\n\t\t\t\t\tWHERE D.CUSTCATCODE = CC.CUSTCATCODE AND\n\t\t\t\t\t\t\tD.ICATCODE = II.ICATCODE)\n\tFROM CUSTOMERCATEGORY CC, ITEMCATEGORY II) D,\n\tCUSTOMERCATEGORY C,\n\tITEMCATEGORY I\nWHERE C.CUSTCATCODE = D.CUSTCATCODE AND\n\tI.ICATCODE = D.ICATCODE\nORDER BY C.Name, I.Name",
  "sort": "itemcategory A"
 },
