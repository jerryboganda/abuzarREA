  "retrieve": "SELECT\n\tCustCode=Customer.CustCode,\n\tAliasname = Accounts.AliasName,\n\titemname = Accounts.Name + ' (' + Accounts.AliasName + ')' ,\n\tCurrListRow = 0,\n\tTransportRouteCode=NULL,\n\tRowID=NULL,\n\tRemarks=Accounts.Name + ' (' + Accounts.AliasName + ')' ,\n\tCharges=Customer.Charges,\n\tDiscPerc=0.00,\n\tServiceFlatDisc=0.00,\n\tQty=1\nFROM \n\tCustomer, Accounts, Area, County\nWHERE \n\tCustomer.CustCode = Accounts.AccCode AND\n\tAccounts.Active = 'Y' AND\n\tCustomer.AreaCode IN (:ai_areacode) AND\n\tCustomer.CountyCode IN (:ai_countycode) AND\n\tCustomer.AreaCode = Area.AreaCode AND\n\tCustomer.CountyCode = County.CountyCode \nORDER BY \n\titemname\n",
