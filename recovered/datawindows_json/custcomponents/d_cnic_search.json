  "retrieve": "SELECT \n\tModule='Customer', \n\tPurpose='Customer', \n\tCode=C.CustCode, \n\tDescription=A.Name, \n\tColumnName = 'NIC', \n\tColumnValue=C.NIC\nFROM Customer C, Accounts A \nWHERE C.CustCode=A.AccCode AND C.NIC LIKE :as_nic\nUNION ALL\nSELECT \n\tModule='Supplier', \n\tPurpose='Supplier', \n\tCode=S.SuppCode, \n\tDescription=A.Name, \n\tColumnName = 'CNIC', \n\tColumnValue=S.CNIC\nFROM Supplier S, Accounts A\nWHERE S.SuppCode=A.AccCode AND S.CNIC LIKE :as_nic\nUNION ALL\nSELECT \n\tModule='Sales Person', \n\tPurpose='Sales Person', \n\tCode=S.SalesManCode, \n\tDescription=S.Name, \n\tColumnName = 'NICNo', \n\tColumnValue=S.NICNo\nFROM SalesMan S\nWHERE S.NICNo LIKE :as_nic\nUNION ALL\nSELECT \n\tModule='Guarantee Person', \n\tPurpose='Guarantee Person', \n\tCode=G.GuaranteePersonCode, \n\tDescription=G.Name, \n\tColumnName = 'NIC', \n\tColumnValue=G.NIC\nFROM GuaranteePerson G\nWHERE G.NIC LIKE :as_nic\nUNION ALL\nSELECT \n\tModule='Employee', \n\tPurpose='Employee', \n\tCode=E.EmpCode, \n\tDescription=E.FullName, \n\tColumnName = 'CNICNo', \n\tColumnValue=E.CNICNo\nFROM Emp_Employee E\nWHERE E.CNICNo LIKE :as_nic\nUNION ALL\nSELECT \n\tModule='Employee', \n\tPurpose='Employee Father/Husband', \n\tCode=E.EmpCode, \n\tDescription=E.FHNAme, \n\tColumnName = 'FHNICNo', \n\tColumnValue=E.FHNICNo\nFROM Emp_Employee E\nWHERE E.FHNICNo LIKE :as_nic\nUNION ALL\nSELECT \n\tModule='Employee', \n\tPurpose='Employee Refferer', \n\tCode=E.EmpCode, \n\tDescription=E.RefferedBy, \n\tColumnName = 'RefferedByCNICNO', \n\tColumnValue=E.RefferedByCNICNO\nFROM Emp_Employee E\nWHERE E.RefferedByCNICNO LIKE :as_nic\nUNION ALL\nSELECT \n\tModule='Student', \n\tPurpose='Student Father', \n\tCode=S.StudentCode, \n\tDescription=S.FName, \n\tColumnName = 'FNIC', \n\tColumnValue=S.FNIC\nFROM Student S\nWHERE S.FNIC LIKE :as_nic\nUNION ALL\nSELECT \n\tModule='Student', \n\tPurpose='Student Mother', \n\tCode=S.StudentCode, \n\tDescription=S.MName, \n\tColumnName = 'MNIC', \n\tColumnValue=S.MNIC\nFROM Student S\nWHERE S.MNIC LIKE :as_nic",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_nic",
      "string"
     ]
    }
   ]
  }
 },
