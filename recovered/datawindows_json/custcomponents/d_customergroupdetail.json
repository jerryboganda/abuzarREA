  "retrieve": "SELECT \n\tD.CustomerGroupCode, \n\tD.RowID, \n\tFullCode=A.AliasName, \n\tCurrListRow = 0,\n\tA.SubCode,\n\tD.CustCode,\n\tA.AccCode,\n\tA.Name,\n\tA.OpeningDate,\n\tC.AreaCode,\n\tC.SubAreaCode,\n\tC.Address1,\n\tC.Address2,\n\tC.Block,\n\tC.Charges,\n\tC.CountyCode\nFROM \n\tCustomerGroupDetail D, Accounts A, Customer C\nWHERE\n\tD.CustomerGroupCode = :ai_code AND \n\tD.CustCode = A.AccCode AND\n\tA.Acccode = C.CustCode\nORDER BY\n\tD.CustomerGroupCode, \n\tD.RowID",
