  "retrieve": "  SELECT Area.AreaCode,   \n         Area.Name,\n         Area.Manager,\n\t\t\tArea.RegionCode,\n\t\t\tArea.ShortName,\n\t\t\tshortname1=LEFT(SHORTNAME, CASE WHEN charindex(char(13), shortname) > 0 THEN charindex(char(13), shortname) - 1 ELSE 6 END),\n\t\t\tshortname2=CASE WHEN charindex(char(13), shortname) > 0\n\t\t\t\t\t\t\tTHEN SUBSTRING(SHORTNAME, charindex(char(13), shortname) + 2 , Len(SHORTNAME)) \n\t\t\t\t\t\t\tELSE SPACE(6) END,\n\t\t\tArea.Tag\n    FROM Area  \n   WHERE Area.AreaCode = :ar_areacode    \n",
  "update": "Area",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_areacode",
      "number"
     ]
    }
   ]
  }
