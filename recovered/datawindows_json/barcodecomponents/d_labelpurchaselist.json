  "retrieve": "  SELECT  dbo.purledger.purinvcode , \n          dbo.accounts.name , \n         dbo.purledger.date, \n\t\t\t posted = purledger.posted,\n\t\t\tPostedBy = IsNull((Select username from users \n\t\t\t\t\t\t\twhere dbo.purledger.postedby = dbo.users.usercode), ''),\n\t\t\tModifiedBy = IsNull((Select username from users \n\t\t\t\t\t\t\twhere dbo.purledger.modifiedby = dbo.users.usercode), '')       \n\t FROM  dbo.purledger , \n          dbo.accounts     \n   WHERE  ( dbo.purledger.suppcode = dbo.accounts.acccode ) and \n          ( dbo.purledger.purcatcode <> 6 ) and\n\t\t\t ( Posted IN (:as_Posted)) ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_Posted",
      "stringlist"
     ]
    }
   ]
  }
 },
