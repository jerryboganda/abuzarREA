  "retrieve": "SELECT \t\n\titem.customicode,\n\titem.name, \n\titem.packingdesc,\n\tcurrlistrow = 0,\n\tstock=0.0000, \n\tdbo.purdetail.icode,\n\tdbo.purdetail.batch,\n\tdbo.purdetail.expiry,\n\tdbo.purdetail.gcode,\n\tdbo.purdetail.packqty,\n\tdbo.purdetail.looseqty,\n\tdbo.purdetail.bonusqty,\n\tdbo.purdetail.packunits,      \n\tdbo.purdetail.purinvcode,\n\tdbo.purdetail.avgprice,\n\tdbo.purdetail.IDENTITYCOL,\n\tdbo.purdetail.purprice    ,\n\tdbo.purdetail.discperc ,\n\tsaleprice = Round(dbo.item.saleprice / dbo.purdetail.packunits , 2 ), \n\tqty = CASE \n\t\t\tWhen (dbo.purledger.purcatcode = 1 Or dbo.purledger.purcatcode = 2) Then\n\t\t\t\tdbo.purdetail.packqty * dbo.purdetail.packunits\n\t\t\tElse dbo.purdetail.looseqty End\nFROM \n\tdbo.purdetail ,\n\tdbo.purledger,\n\tdbo.item\nWHERE \n\t( dbo.purledger.purinvcode = :r_InvCode ) and\n\t( dbo.purledger.purinvcode = dbo.purdetail.purinvcode )   and\n\t( dbo.purdetail.icode = dbo.item.icode )  \n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "r_InvCode",
      "number"
     ]
    }
   ]
  },
  "sort": "purrowid A"
 },
