  "retrieve": "SELECT  \n\tdbo.purledger.suppinvcode ,\n\tdbo.purledger.suppinvdate,\n\tdbo.purledger.grn,\n\tdbo.purledger.purinvcode ,\n\tdbo.purledger.purcatcode ,\n\tdbo.purledger.suppcode ,\n\tAliasName = (SELECT Accounts.AliasName FROM Accounts WHERE Accounts.AccCode = dbo.purledger.suppcode),\n\tSupplierName = (SELECT Accounts.Name FROM Accounts WHERE Accounts.AccCode = dbo.purledger.suppcode),\n\tPatientName = SPACE(100),\n\tDoctorName = SPACE(100),\n\tdbo.purledger.salesmancode ,\n\tdbo.purledger.date ,\n\tdbo.purledger.headerno,\n\tdbo.purledger.pocode ,\n\tdbo.purledger.discperc ,\n\tdbo.purledger.flatdisc ,\n\tdbo.purledger.misccharges ,\n\tdbo.purledger.salestax ,\n\tdbo.purledger.posted ,\n\tdbo.purledger.postdate ,\n\tdbo.purledger.remarks ,\n\tdbo.users.username,\n\tpurledger.originaldate,\n\tpurledger.modifiedby,\n\tpurledger.postedby ,\n\tpurledger.porb,\n\tlabelformat = '1',\n\tLoosePack=1,\n\tBarCodePrinter = DBO.fn_GetPreference('')\n\t\n\tFROM dbo.purledger ,\n\t dbo.users     \n\t\n\tWHERE ( dbo.purledger.salesmancode = dbo.users.usercode ) and \n\t\t( ( dbo.purledger.purinvcode = :r_InvCode ) )  ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "r_InvCode",
      "number"
     ]
    }
   ]
  }
 },
