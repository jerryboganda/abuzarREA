  "retrieve": "SELECT \n\tPurInvCode=P.PurInvCode, \n\tSuppCode=P.SuppCode, \n\tPhone=(SELECT S.Phone FROM Supplier S WHERE P.SuppCode = S.SuppCode),\n\tPurRemarks=P.Remarks,\n\tOrderNo=P.NewPurchaseOrderNo,\n\tPurchaseAmt=P.InvTotal, \n\tICode=D.ICode, \n\tCustomICode=I.customicode,\n\tItemName=I.Name, \n\tItemDescription = D.ItemDescription,\n\tGCode=D.GCode,\n\tBatch=D.Batch,\n\tExpiry=D.Expiry,\n\tPackUnits = D.PackUnits,\n\tQty = (CASE WHEN P.PurCatCode >= 3 THEN D.LooseQty + D.BonusQty ELSE (D.PackQty + D.BonusQty) * D.PackUnits END) -  ISNULL((SELECT SUM(PS.Qty) FROM PresaleDetail PS WHERE PS.PurRowID = D.PurRowID), 0),\n\tNetRate = D.NetRate,\n\tSalePrice = Round(CASE WHEN P.PurCatCode >= 3 THEN D.PurPrice ELSE D.PurPrice / CASE WHEN D.PackUnits IS NULL OR D.PackUnits <= 0 THEN 1 ELSE D.PackUnits END END, 2),\n\tDiscPerc = D.DiscPerc,\n\tPurRowID=D.PurRowID\nFROM Purledger P, PurDetail D, Item I\nWHERE P.Posted = 'Y' AND P.PurInvCode IN (:ai_PurInvCode) AND P.PurInvCode = D.PurInvCode AND\n\tD.ICode=I.ICode\nORDER BY \n\tPurInvCode,\n\tPurRowID",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_PurInvCode",
      "numberlist"
     ]
    }
   ]
  }
 },
