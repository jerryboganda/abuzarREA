  "retrieve": "SELECT \n\titem.customicode, \n\titemname= item.name, \n\tcurrlistrow = 0,\n\tstock     = 0.0000, \n\ttotalstock= 0.0000, \n\tassgcode  = 1, \n\tpurquotationdetail.purquotationcode,   \n\tpurquotationdetail.icode,   \n\tpurquotationdetail.IDENTITYCOL,\n\tpurquotationdetail.itemdescription,\n\tpurquotationdetail.gcode,\n\tpurquotationdetail.packunits,\n\tpurquotationdetail.saleprice,\n\tpurquotationdetail.purprice,\n\tunitsalestax=purquotationdetail.unitsalestax,\n\tGSTPerc=purquotationdetail.GSTPErc,\n\tpurquotationdetail.bonusqty,\n\tpurquotationdetail.discperc,\n\tpurquotationdetail.qty\n\t\nFROM \n\tpurquotationdetail,   \n\titem \n\t\nWHERE \n\t( dbo.purquotationdetail.purquotationcode = :ai_Code ) AND\n\t( purquotationdetail.icode = item.icode )\nORDER BY\n\trowid\n\t\n\t\n\t\n",
  "update": "purquotationdetail",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
