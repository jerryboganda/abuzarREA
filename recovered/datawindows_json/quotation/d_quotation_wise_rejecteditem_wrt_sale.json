    "updatewhereclause": "yes",
    "name": "givenqty",
    "dbname": "GivenQty"
   },
   {
    "type": "char(1)",
    "updatewhereclause": "yes",
    "name": "givenloosepack",
    "dbname": "GivenLoosePack"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "balanceqty",
    "dbname": "BalanceQty"
   },
   {
    "type": "char(1)",
    "updatewhereclause": "yes",
    "name": "balanceloosepack",
    "dbname": "BalanceLoosePack"
   }
  ],
  "retrieve": "Select  A.ICode,\n\tI.Name,\n\tSupplier = IsNull(Supplier.Name, 'Supplier Not Available') ,\n\tCASE ( (A.Qty / I.PackUnits) - CAST(A.Qty / I.PackUnits AS INT) ) When 0 Then (A.Qty / I.PackUnits) Else A.Qty End As RequestedQty,\n\tCASE When ( (A.Qty / I.PackUnits) - CAST(A.Qty / I.PackUnits AS INT) ) = 0 Then '' Else 'L' End As RequestedLoosePack,\n\tISNULL(CASE ( (B.Qty / I.PackUnits) - CAST(B.Qty / I.PackUnits AS INT) ) When 0 Then (B.Qty / I.PackUnits) Else B.Qty End, 0 ) As GivenQty,\n\tCASE When ( (B.Qty / I.PackUnits) - CAST(B.Qty / I.PackUnits AS INT) ) = 0 Then '' Else 'L' End As GivenLoosePack,\n\tCASE ( (A.Qty - IsNull(B.Qty,0) / I.PackUnits) - CAST((A.Qty - IsNull(B.Qty,0)) / I.PackUnits AS INT) ) When 0 Then ( (A.Qty - IsNull(B.Qty,0) ) / I.PackUnits) Else (A.Qty - IsNull(B.Qty,0) ) End As BalanceQty,\n\tCASE When ( (A.Qty - IsNull(B.Qty,0) / I.PackUnits) - CAST((A.Qty - IsNull(B.Qty,0)) / I.PackUnits AS INT) ) = 0 Then '' Else 'L' End As BalanceLoosePack\nFrom \n(\nSelect \tQD.icode As ICode, Sum(Case QH.LoosePack When 1 Then QD.qty When 2 Then QD.Qty * QD.PackUnits End) As Qty , 'Q' As Type\nfrom \t\tQuotationHeader QH Inner Join QuotationDetail QD On QH.QuotationCode = QD.QuotationCode Inner Join SaleLedger SL On SL.QuotationNo = QH.QuotationCode\nWhere  \tQH.QuotationCode = :al_quotationcode\ngroup by QD.icode\n) A Left Outer Join \n(\nSelect \t SD.Icode As ICode, Sum(SD.LooseQty) As Qty, 'S' As Type\nFrom   \t QuotationHeader QH Inner Join QuotationDetail QD On QH.QuotationCode = QD.QuotationCode Inner Join SaleLedger SL ON QH.QuotationCode = SL.QuotationNo Inner Join SaleDetail SD On SL.SaleInvCode = SD.SaleInvCode\nWhere  \t QH.QuotationCode = :al_quotationcode And\n\t\t\t QD.Icode = SD.ICode\nGroup By SD.ICode\n) B On A.ICode = B.ICode Left Outer Join\n(\nSelect A.Name, S.SuppCode,S.ICode\nFrom  ItemSuppliers s Inner Join Accounts A ON A.AccCode = s.Suppcode Inner Join\n(\nSelect icode, min(priority) as priority\nFrom itemsuppliers\nGroup By icode ) si \nOn s.icode = si.icode\nWhere s.priority = si.priority\n) Supplier\nOn A.Icode = Supplier.ICode Inner Join Item I ON A.ICode = I.ICode\n\nWhere ( A.Qty - IsNull(B.Qty,0) ) > 0\n",
  "update": "Item",
  "updatewhere": "0",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "al_quotationcode",
      "number"
     ]
    }
   ]
  },
  "sort": "supplier A, name A"
 },
