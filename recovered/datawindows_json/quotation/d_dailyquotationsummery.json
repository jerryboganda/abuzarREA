  "retrieve": "SELECT \n\tinvcode     = dbo.quotationheader.quotationcode,    \n\tdate        = dbo.quotationheader.date,    \n\tflatdisc    = dbo.quotationheader.flatdisc, \n\tsalestax    = dbo.quotationheader.salestax,       \n\tmisccharges = dbo.quotationheader.misccharges, \n\tinvdiscperc = dbo.quotationheader.discperc, \n\tinvgstperc1 = dbo.quotationheader.invgstperc1, \n\tposted = dbo.quotationheader.posted,\n\tdbo.accounts.name, \n\tremarks=max(quotationheader.remarks),\n\tcustrefno=max(quotationheader.custrefno),\n\tamount =  Sum ( dbo.quotationdetail.qty * dbo.quotationdetail.saleprice),   \n\tgross= Sum ( dbo.quotationdetail.qty * dbo.quotationdetail.saleprice), \n\titemdiscpercvalue = Round(Sum (Round(( dbo.quotationdetail.qty  * (dbo.quotationdetail.saleprice - dbo.quotationdetail.itemflatdisc) * (dbo.quotationdetail.discperc * .01)) + (dbo.quotationdetail.qty  * dbo.quotationdetail.itemflatdisc),2)), 2),    \n\tinvdiscpercvalue = Sum (Round( dbo.quotationdetail.qty   * (dbo.quotationdetail.saleprice  - dbo.quotationdetail.itemflatdisc) * (1 - (dbo.quotationdetail.discperc * .01)),2)) * (dbo.quotationheader.discperc /100),\n\tsalesman = dbo.users.username ,\n\ttotaldiscount= Round(Sum (Round(( dbo.quotationdetail.qty  * (dbo.quotationdetail.saleprice - dbo.quotationdetail.itemflatdisc) * (dbo.quotationdetail.discperc * .01)) + (dbo.quotationdetail.qty  * dbo.quotationdetail.itemflatdisc),2)), 2) + Round(Sum ( dbo.quotationdetail.qty   * (dbo.quotationdetail.saleprice  - dbo.quotationdetail.itemflatdisc) * (1 - (dbo.quotationdetail.discperc * .01))) * (dbo.quotationheader.discperc /100), 2) + dbo.quotationheader.flatdisc,\n\tCustomerAlias=max(accounts.aliasname),\n\titemsalestax = Sum (Round (dbo.quotationdetail.qty * dbo.quotationdetail.unitsalestax + Round ( Round (dbo.quotationdetail.qty * (dbo.quotationdetail.saleprice - dbo.quotationdetail.itemflatdisc ) * (1 - dbo.quotationdetail.discperc * 0.01 ), 2 ) * dbo.quotationdetail.gstperc * 0.01 , 2 ) , 2 ) )\nFROM\n\tdbo.quotationheader,\n\tdbo.quotationdetail,   \n\tdbo.accounts,\n\tdbo.users \nWHERE \n\t( dbo.quotationheader.quotationcode = dbo.quotationdetail.quotationcode ) and \n\t( dbo.quotationheader.custcode = dbo.accounts.acccode )and  \n\t( dbo.quotationheader.salesmancode = dbo.users.usercode )and  \n\t( dbo.quotationheader.date between :ar_StartDate and :ar_EndDate)  \nGROUP BY \n\tdbo.quotationheader.misccharges,   \n\tdbo.quotationheader.flatdisc,   \n\tdbo.quotationheader.date,   \n\tdbo.quotationheader.quotationcode,   \n\tdbo.quotationheader.discperc,  \n\tdbo.quotationheader.salestax, \n\tdbo.quotationheader.invgstperc1 ,\n\tdbo.quotationheader.posted, \n\tdbo.accounts.name,\n\tdbo.users.username \nORDER BY \n\tdbo.quotationheader.quotationcode ASC,   \n\tdbo.quotationheader.date ASC \n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_EndDate",
      "datetime"
     ]
    }
   ]
  }
 },
