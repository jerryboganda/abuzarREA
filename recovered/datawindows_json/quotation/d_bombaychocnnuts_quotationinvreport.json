  "retrieve": "SELECT \n\titemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, \n\tusers.username,\n\theaderno = dbo.quotationheader.headerno,\n\tdbo.quotationheader.quotationcode,   \n\tdbo.quotationheader.date,   \n\tinvdiscperc=dbo.quotationheader.discperc,   \n\tinvmischarg=dbo.quotationheader.misccharges,   \n\tinvflatdisc=dbo.quotationheader.flatdisc,   \n\tdbo.quotationheader.salestax,   \n\tdbo.quotationheader.custcode,   \n\tdbo.quotationheader.remarks,   \n\tdbo.quotationdetail.icode,   \n\tId        = MAX(dbo.quotationdetail.IDENTITYCOL),  \n\tqty   = sum(quotationdetail.qty), \n\tpackunits = max(quotationdetail.packunits), \n\tsaleprice = max(quotationdetail.saleprice), \n\tsalestax  = max(quotationdetail.salestax),   \n\tdetaildiscperc  = max(quotationdetail.discperc), \n\tcustomer=(select name from accounts where accounts.acccode=quotationheader.custcode),\n\titemflatdisc  = max(quotationdetail.itemflatdisc)\n\t\nFROM \n\tdbo.quotationheader,   \n\tdbo.quotationdetail,  \n\titem,\n\tUsers \n\t\nWHERE \n\t( dbo.quotationheader.quotationcode = :ra_InvCode ) AND\n\t( dbo.quotationheader.quotationcode = dbo.quotationdetail.quotationcode ) AND \n\t( quotationheader.SalesManCode = users.userCode ) and\n\t( quotationdetail.icode = item.icode )\n\t\nGROUP BY \n\tquotationheader.quotationcode, \n\tquotationheader.date, \n\tquotationheader.custcode, \n\tquotationheader.discperc, \n\tquotationheader.flatdisc, \n\tquotationheader.misccharges, \n\tquotationheader.headerno,\n\tquotationheader.salestax, \n\tquotationheader.remarks, \n\tquotationdetail.icode, \n\titem.name,\n\titem.icode,\n\titem.printable,\n\tusers.username\n\nORDER BY \n\tMAX(dbo.quotationdetail.IDENTITYCOL)\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  },
  "sort": "id A"
 },
