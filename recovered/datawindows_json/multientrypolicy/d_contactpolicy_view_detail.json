  "retrieve": "SELECT \n\tCode = \n\t\t(SELECT C.ContactPolicyCode \n\t\tFROM ContactPolicy C\n\t\tWHERE C.ContactPolicyCode = :ai_Code),\n\tW.WeekDayCode, \n\tWeek1=\n\tISNULL((SELECT 1 FROM ContactPolicyDetail D\n\t\tWHERE D.ContactPolicyCode = :ai_Code AND\n\t\t\tD.WeekDayCode = W.WeekDayCode AND D.WeekOfMonth = 1), 0),\n\tWeek2=\n\tISNULL((SELECT 1 FROM ContactPolicyDetail D\n\t\tWHERE D.ContactPolicyCode = :ai_Code AND\n\t\t\tD.WeekDayCode = W.WeekDayCode AND D.WeekOfMonth = 2), 0),\n\tWeek3=\n\tISNULL((SELECT 1 FROM ContactPolicyDetail D\n\tWHERE D.ContactPolicyCode = :ai_Code AND\n\t\tD.WeekDayCode = W.WeekDayCode AND D.WeekOfMonth = 3), 0),\n\tWeek4=\n\tISNULL((SELECT 1 FROM ContactPolicyDetail D\n\t\tWHERE D.ContactPolicyCode = :ai_Code AND\n\t\t\tD.WeekDayCode = W.WeekDayCode AND D.WeekOfMonth = 4), 0),\n\tWeek5=\n\tISNULL((SELECT 1 FROM ContactPolicyDetail D\n\t\tWHERE D.ContactPolicyCode = :ai_Code AND\n\t\tD.WeekDayCode = W.WeekDayCode AND D.WeekOfMonth = 5), 0)\nFROM\n\tWeekDays W ",
  "arguments": {
   "_items": [
