  "retrieve": "SELECT \n\tPricePolicyDetail.PricePolicyCode, \n\tPricePolicyDetail.QtyLimit, \n\tPricePolicyDetail.Price, \n\tpackunits=ISNULL((SELECT Item.PackUnits FROM Item WHERE Item.ICode IN (SELECT PricePolicy.ICode FROM PricePolicy WHERE PricePolicy.PricePolicyCode = :ai_Code) ), 1),\n\tPricePolicyDetail.ItemFlatDisc, \n\tPricePolicyDetail.DiscPerc, \n\tPricePolicyDetail.ExpiryDate  \nFROM \n\tPricePolicyDetail  \nWHERE \n\tPricePolicyDetail.PricePolicyCode = :ai_code   \nORDER BY \n\tPricePolicyDetail.PricePolicyCode ASC,   \n\tPricePolicyDetail.QtyLimit ASC   \n",
  "update": "PricePolicyDetail",
