  "retrieve": "SELECT\n\t\tallpur=  IsNull( sum(round(((PD.looseqty + PD.packqty ) * PD.purprice ) * (1 - (.01 *  PD.discperc)),2))  ,0),\n\t   \tcategory=IC.name, \n\n\t   \ttotaldisc= ( select sum(flatdisc) \n\t    \t\t          from purledger\n\t      \t\t       where \n\t\t\t\t               purledger.date between :ar_startdate and :ar_enddate ),\n\t   \tmisccharg= ( select sum(misccharges) \n\t    \t\t          from purledger\n\t      \t\t       where purledger.date between :ar_startdate and :ar_enddate ),\n\t      totalinvdiscperc= (select sum(ISNULL(B.invdiscperc,0))\n\t\t     \t\t\t\t\t\t from\n\t\t\t\t  \t\t\t\t\t\t\t (select   invdiscperc = IsNull( sum(Round(((purdetail.looseqty + purdetail.packqty ) * purdetail.purprice) * (1 - (.01 * purdetail.discperc)),2)) * 0.01 * purledger.discperc, 0)\n\t \t\t\t   \t\t\t\t\t\t  from     purledger, purdetail  \n\t\t   \t\t   \t\t\t\t\t  where    \n\t\t\t\t\t \t\t\t\t\t\t\t\t\t(purledger.date between :ar_startdate and :ar_enddate ) AND\n\t\t\t     \t\t\t\t\t\t\t\t\t\t  purledger.purinvcode = purdetail.purinvcode \n\t \t\t     \t   \t\t\t\t\t  group by purledger.purinvcode,\n\t \t\t    \t\t     \t\t\t\t\t\t\t  purledger.discperc\n\t\t\t\t  \t\t\t\t\t\t\t\t) as  B),\n\n\t\t\n\t\t\tdiff=(select sum ( ISNULL(A.rounddifference,0)) \n\t\t\t      from\n\t\t\t\t\t\t(SELECT \n\t\t\t\t   \t\t\t rounddifference= Round(Sum (( dbo.purdetail.looseqty + purdetail.packqty)* dbo.purdetail.purprice)\n\t\t\t\t\t\t           \t\t\t\t\t\t\t- Sum (Round(((( dbo.purdetail.looseqty + purdetail.packqty ) * dbo.purdetail.purprice ) * (dbo.purdetail.discperc * .01)) ,2))\n\t\t\t\t\t\t\t   \t\t\t\t\t\t\t\t- Sum ( Round( dbo.purdetail.purprice * (dbo.purdetail.looseqty + purdetail.packqty )    * (1 - (dbo.purdetail.discperc * .01)),2)) * (dbo.purledger.discperc /100) \n\t\t\t\t\t \t\t   \t\t\t\t\t\t\t\t+ dbo.purledger.misccharges - purledger.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))  \n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t-\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t( Sum ( (dbo.purdetail.looseqty + purdetail.packqty)* dbo.purdetail.purprice)\n\t\t\t\t\t\t          \t\t\t\t\t\t\t - Sum (Round(((( dbo.purdetail.looseqty + purdetail.packqty ) * dbo.purdetail.purprice ) * (dbo.purdetail.discperc * .01)) ,2))\n\t\t\t\t\t\t\t   \t\t\t\t\t\t\t\t - Sum ( Round( dbo.purdetail.purprice * (dbo.purdetail.looseqty + purdetail.packqty )    * (1 - (dbo.purdetail.discperc * .01)),2)) * (dbo.purledger.discperc /100) \n\t\t\t\t\t \t\t   \t\t\t\t\t\t\t\t + dbo.purledger.misccharges - purledger.flatdisc)\n\n\t\n\n,\n\t\t\t\t\t\n\t\t\t\t   \t\t      netammount= (Sum ( dbo.purdetail.looseqty * dbo.purdetail.purprice)\n\t\t\t\t\t        \t\t\t\t     - Round(Sum (Round(( dbo.purdetail.looseqty  * (dbo.purdetail.purprice) * (dbo.purdetail.discperc * .01)) ,2)), 2) + Round(Sum ( dbo.purdetail.looseqty   * (dbo.purdetail.purprice  ) * (1 - (dbo.purdetail.discperc * .01))) * (dbo.purledger.discperc /100), 2) + dbo.purledger.flatdisc + dbo.purledger.misccharges )\n\n\t\t\t\t       FROM     dbo.purledger, \n\t\t\t\t         \t\t dbo.purdetail\n\t\t\t\t\t\t WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and \n\t\t      \t\t      /*( dbo.purledger.purcatcode IN (1,7) ) and  */\n       \t\t\t\t      (purledger.date between :ar_startdate and :ar_enddate )          \n\t\t\t\t\t\t GROUP BY dbo.purledger.misccharges,   \n\t\t \t\t\t\t  \t\t\t dbo.purledger.flatdisc,   \n       \t\t\t\t\t\t\t dbo.purledger.date,   \n         \t\t\t\t\t\t dbo.purledger.purinvcode,   \n\t\t\t\t\t \t\t\t\t dbo.purledger.discperc,  \n\t\t\t\t\t \t\t\t\t dbo.purledger.salestax, \n\t\t\t\t\t \t\tdbo.purledger.purcatcode\n\t\t\t\t\t) as A\n\n\n\t\t\t\t),\n\nprtotal=(select  ISNULL(sum(isnull(c.invsalereturn,0)),0)\n\t \t\tfrom (select\n\t\t\t\t\t\t\tinvsalereturn= IsNull( Round(sum(Round(((prdetail.looseqty + prdetail.packqty * prdetail.packunits) * prdetail.prprice) * (1 - (.01 * prdetail.discperc)),2)) * (1- (.01 * prledger.discperc)) + prledger.misccharges - prledger.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)),0)\n\t\t\t\t\tfrom     prledger, prdetail  \n\t\t\t\t\twhere    prledger.prinvcode = prdetail.prinvcode and\n\t \t\t\t\t\t\t\tprledger.prcatcode = 4     and \n\t\t\t\t\t\t\t\tprledger.date between :ar_startdate and :ar_enddate \n\t\t\t\t\tgroup by prledger.prinvcode,\n\t \t\t\t\t\t\t\tprledger.prcatcode,\n\t \t\t\t\t\t\t\tprledger.date,\n\t \t\t\t\t\t\t\tprledger.discperc,\n\t \t\t\t\t\t\t\tprledger.misccharges,\n\t\t\t\t\t\t\t\tprledger.flatdisc\n\n\t\t\t\t\t) as C\n\n\t\t),\n\n\ncreditpur=  (select ISNULL(sum (isNull(d.creditsale,0)),0)\n\n              from   (select   creditsale = IsNull( Round(sum(Round(((purdetail.looseqty + purdetail.packqty) * purdetail.purprice ) * (1 - (.01 * purdetail.discperc)),2)) * (1- (.01 * purledger.discperc)) + purledger.misccharges + purledger.salestax - purledger.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)),0)\n\t \n\t\t\t\t\t\t\t from     purledger, purdetail  \n\t\t\t\t\t\t\t where \t \n\t\t\t\t\t\t\t\t\t \t purledger.date between :ar_startdate and :ar_enddate  AND\n\t \t\t\t\t\t\t\t\t\t purledger.purinvcode = purdetail.purinvcode and\n\t \t\t\t\t\t\t\t\t\t purledger.purcatcode in ( 2 ,8)  \n\t\t\t\t\t\t\tgroup by purledger.purinvcode,\n\t \t\t\t\t\t\t\t\t\tpurcatcode, \n\t\t\t\t\t\t\t\t\t\tpurledger.date,\n\t \t\t\t\t\t\t\t\t\tpurledger.discperc,\n\t \t\t\t\t\t\t\t\t\tpurledger.misccharges,\n\t \t\t\t\t\t\t\t\t\tpurledger.salestax,\n\t\t\t\t\t\t\t\t\t\tpurledger.flatdisc\n\t \t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t)as D\n\t\t\t\t),\n\t\ttotalsalestax = (select ISNULL(Sum (ISNull(S.invtotalsalestax,0)),0)\n\n              \t\t\t  from  (SELECT invtotalsalestax= \n\t\t\t\t\t\t\t\t\t\t  Round (\n\t\t/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( PD.looseqty + PD.packqty ) * PD.purprice * (1 - PD.discperc * 0.01 ) , 2 ) )\n\t\t\t\t\t\t\t  \t       * ( 1 - PL.discperc * 0.01 ) , 2 ) - PL.flatdisc ) * PL.invgstperc1 * 0.01  , 2 )\n \t\t/*items salestax*/\t\t + Sum (Round ( (PD.looseqty + PD.packqty + PD.bonusqty)* PD.unitsalestax + Round ( Round ( (PD.looseqty + PD.packqty) * PD.purprice * (1 - PD.discperc * 0.01 ), 2 ) * PD.gstperc * 0.01 , 2 ) , 2 ) )\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\t\t , ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))\n\t\t\t\t\t\t\t FROM dbo.Purledger PL , \n\t\t\t\t\t\t\t      dbo.Purdetail PD\n\t\n\t\t\t\t\t\t\t WHERE  (PL.date between :ar_startdate and :ar_enddate)  And\n\t\t\t\t\t\t\t\t\t  (PL.purinvcode = PD.purinvcode )   \n         \n\t\t\t\t\t\t\t GROUP BY PL.purinvcode, \n\t\t\t  \t\t\t\t\t\t\t PL.invgstperc1, \n\t\t\t\t\t\t\t\t\t\t PL.misccharges,   \n\t\t\t\t\t\t\t\t\t\t PL.flatdisc,\n\t\t  \t\t\t\t\t\t\t\t PL.discperc\n\t\t\t\t\t\t\t) AS S\n\t\t\t\t\t\t)\t\n\nFROM purdetail PD,\n     purledger PL,\n     item I, \n     itemcategory IC\n\nWHERE \n       PL.date between :ar_startdate and :ar_enddate  and\n       PL.purinvcode=PD.purinvcode and\n\t\t PD.icode=I.icode AND\n\t\t I.icatcode=IC.icatcode \n\nGROUP BY I.icatcode,\n         IC.name\n\n",
  "arguments": {
