   {
    "type": "char(75)",
    "updatewhereclause": "yes",
    "name": "itemalias",
    "dbname": "itemalias"
   }
  ],
  "retrieve": " SELECT  purqty=ISNULL(sum(looseqty),0)\t, \n\t\t\tpurvalue= ISNULL(sum(((( PD.looseqty+PD.packqty)  *  PD.purprice   )  *  (1 -   ( PD.discperc * .01   ) )) *(1 - PL.discperc*0.01) ),0),\n\t\t\tpurbouns= ISNULL(sum(bonusqty),0)\t\t ,\n\t\t\tsaleqty=ISNULL((SELECT sum(SD.looseqty)\n\t\t \t\t\t\tFROM  saleledger SL, \n\t\t\t\t\t\t\t\tsaledetail SD\n\t\t \t\t\t\tWHERE SL.date>=:ar_StartDate AND\n\t\t\t\t\t\t\t\tSL.date<=:ar_EndDate AND\n\t\t \t\t\t\t\t\tSL.saleinvcode=SD.saleinvcode AND\n\t\t\t\t\t\t\t\tSD.icode=PD.icode)\n\t\t\t\t\t\t\t,0),\n\t\t\tsalevalue=ISNULL((SELECT sum(Round(Round((looseqty*(SD.saleprice - SD.Itemflatdisc)) * (1 - SD.discperc*0.01),2) *(1 - SL.discperc*0.01),2)  )\n\t\t \t\t\t\t\tFROM  saleledger SL,\n\t\t\t\t\t\t\t\t\tsaledetail SD\n\t\t \t\t\t\t\tWHERE SL.date>=:ar_StartDate AND\n\t\t\t\t\t\t\t\t\tSL.date<=:ar_EndDate AND\n\t\t \t\t\t\t\t\t\tSL.saleinvcode=SD.saleinvcode AND\n\t\t\t\t\t\t\t\t\tSD.icode=PD.icode)\n\t\t\t\t\t\t\t\t,0),\n\t\t\tsalebonus=ISNULL((SELECT sum(SD.bonusqty)\n\t\t \t\t\t\t\tFROM  saleledger SL,\n\t\t\t\t\t\t\t\t\tsaledetail SD\n\t\t \t\t\t\t\tWHERE SL.date>=:ar_StartDate AND\n\t\t\t\t\t\t\t\t\tSL.date<=:ar_EndDate AND\n\t\t \t\t\t\t\t\t\tSL.saleinvcode=SD.saleinvcode AND\n\t\t\t\t\t\t\t\t\tSD.icode=PD.icode)\n\t\t\t\t\t\t\t\t,0),\n\titemname=(select name from item where icode=PD.icode),\n\titemalias=(select customicode from item where icode=PD.icode)\nFROM \n\tpurledger PL,\n\tpurdetail PD\n\nWHERE  \n\tPL.date>=:ar_StartDate and PL.date<=:ar_EndDate AND\n\tPL.posted='Y' AND\n\tPL.purcatcode IN (:ar_purcatcode) AND \n\tPL.SuppCode IN (:ar_suppcode) AND \n\tPL.purinvcode=PD.purinvcode\n\nGROUP BY\n\tPD.icode\n\n",
  "arguments": {
   "_items": [
