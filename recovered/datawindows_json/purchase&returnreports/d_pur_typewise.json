    "name": "grossamount",
    "dbname": "grossamount"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "tax",
    "dbname": "tax"
   }
  ],
  "retrieve": "SELECT\n\tpurtype=ISNULL(A.purchasetype,'OTHERS(Empty Purchase Type)'),\n\tgrossamount=sum(A.invamount),\n\ttax=SUM(A.totaltax) \nFROM\n\t(SELECT \n\t\tinvcode = dbo.purledger.purinvcode,    \n\t\tdate = dbo.purledger.date,    \n\t\tflatdisc = dbo.purledger.flatdisc , \n\t\tsalestax= dbo.purledger.salestax ,       \n\t\tmisccharges = dbo.purledger.misccharges , \n\t\tinvdiscperc = dbo.purledger.discperc , \n\t\tinvgstperc1 = dbo.purledger.invgstperc1 , \n\t\tinvtype = Case dbo.purledger.purcatcode \tWhen 1 Then 'Cash' \tWhen 2 Then 'Credit' When 7 Then 'Loose' When 8 Then 'Loose' Else 'Opening' End,  \n\t\tdbo.accounts.name, \n\t\tamount =  Sum ((dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice),    \n\t\titemdiscpercvalue = Sum ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (dbo.purdetail.discperc / 100)),    \n\t\tinvdiscpercvalue = Sum ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (1 - dbo.purdetail.discperc / 100)) * (dbo.purledger.discperc / 100)    ,\n\t\titemsalestax = Sum (Round ( (dbo.purdetail.looseqty + dbo.purdetail.packqty + dbo.purdetail.bonusqty) * dbo.purdetail.unitsalestax + Round ( Round ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (1 - dbo.purdetail.discperc * 0.01 ), 2 ) * dbo.purdetail.gstperc * 0.01 , 2 ) , 2 ) ) ,\n\t\tposted= dbo.purledger.posted,\n\t\tPurchasetype=dbo.purchasetype.name,\n\t\tpostdate=purledger.postdate,\n\t\tdbo.purledger.GRN,\n\t\tinvamount=ISNULL(  Round(Sum ((dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice)\n\t\t\t- Sum ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (dbo.purdetail.discperc / 100))\n\t\t\t- Sum ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (1 - dbo.purdetail.discperc / 100)) * (dbo.purledger.discperc / 100)\n\t\t\t- purledger.flatdisc + purledger.misccharges, 0), ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)),\n\t\ttotaltax=ISNULL(\tRound(Round(Round( Sum ((dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice)\n\t\t\t- Sum ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (dbo.purdetail.discperc / 100))\n\t\t\t-  Sum ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (1 - dbo.purdetail.discperc / 100)) * (dbo.purledger.discperc / 100)   \n\t\t\t- purledger.flatdisc,2) * 0.01 * purledger.invgstperc1,2)\n\t\t\t+\n\t\t\tSum (Round ( (dbo.purdetail.looseqty + dbo.purdetail.packqty + dbo.purdetail.bonusqty) * dbo.purdetail.unitsalestax + Round ( Round ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (1 - dbo.purdetail.discperc * 0.01 ), 2 ) * dbo.purdetail.gstperc * 0.01 , 2 ) , 2 ) ),0), ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))\n\tFROM \n\t\tdbo.purledger\n\t\tLEFT OUTER JOIN dbo.purchasetype ON ( dbo.purledger.purtypecode = dbo.purchasetype.purtypecode),\n\t\tdbo.purdetail,   \n\t\tdbo.accounts\n\tWHERE \n\t\t( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and  \n\t\t( dbo.purledger.suppcode = dbo.accounts.acccode )and  \n\t\t( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            \n\tGROUP BY \n\t\tdbo.accounts.name,   \n\t\tdbo.purledger.misccharges,   \n\t\tdbo.purledger.flatdisc,   \n\t\tdbo.purledger.date,\n\t\tdbo.purledger.postdate,   \n\t\tdbo.purledger.purinvcode, \n\t\tdbo.purchasetype.name,  \n\t\tdbo.purledger.discperc,  \n\t\tdbo.purledger.invgstperc1,\n\t\tdbo.purledger.salestax,\n\t\tdbo.purledger.purcatcode,\n\t\tdbo.purledger.posted,\n\t\tdbo.purledger.GRN) as A\nGROUP BY A.purchasetype\nUNION ALL\nSELECT \n\tpurtype=name,\n\tgrossamount=0,\n\ttax=0\nFROM purchasetype\nWHERE purtypecode not in (select distinct(purtypecode) from purledger where .purledger.date between :ar_StartDate and :ar_EndDate and purtypecode is not null)\nORDER BY purtype\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_EndDate",
      "datetime"
     ]
    }
   ]
  }
 },
