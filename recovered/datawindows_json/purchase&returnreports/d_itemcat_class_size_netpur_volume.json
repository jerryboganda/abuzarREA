  "retrieve": "SELECT\n\tCatCode=IC.ICatCode,\n\tItemCategory=IC.Name,\n\tICCode=ICL.ICCode, \n\tItemClass=ICL.Name,\n\tISizeCode=ISZ.ISizeCode,\n\tItemSize=ISZ.Name,\n\tPurQty = SUM(S.PurQty),\n\tPur=Round(SUM(S.Pur), 2),\n\tPurVolume=SUM(S.PurVolume),\n\tPurReturnQty = SUM(S.PurReturnQty),\n\tPurReturn=Round(SUM(S.PurReturn), 2),\n\tPurReturnVolume=SUM(S.PurReturnVolume),\n\tNetPurQty = SUM(S.PurQty - S.PurReturnQty),\n\tNetPur=Round(SUM(S.Pur), 2) - Round(SUM(S.PurReturn), 2),\n\tNetPurVolume=SUM(S.PurVolume - S.PurReturnVolume)\nFROM\n\tItemClass ICL,\n\tItemSize ISZ,\n\tItemCategory IC, \n\tItem I\n\tLEFT OUTER JOIN\n\t(SELECT\n\t\tPD.ICode,\n\t\tPurQty = SUM(PD.LooseQty+PD.PackQty),\n\t\tPur = SUM((PD.LooseQty+PD.PackQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01) ),\n\t\tPurVolume = SUM((PD.LooseQty+PackQty) * I.PackingFactor),\n\t\tPurReturnQty = 0,\n\t\tPurReturn = 0.00,\n\t\tPurReturnVolume = 0.00\n\tFROM\n\t\tPurLedger P, PurDetail PD, Item I\n\tWHERE \n\t\tP.Date >= :ad_startdate AND P.Date <= :ad_enddate AND\n\t\tP.PurInvCode = PD.PurInvCode AND \n\t\tPD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)\n\tGROUP BY\n\t\tPD.ICode\n\tUNION ALL\n\tSELECT\n\t\tPD.ICode,\n\t\tPurQty = 0,\n\t\tPur = 0.00,\n\t\tPurVolume = 0.00,\n\t\tPurReturnQty = SUM(PD.LooseQty),\n\t\tPurReturn = SUM(PD.LooseQty * PD.PrPrice * (1 - PD.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01) ),\n\t\tPurReturnVolume = SUM(PD.LooseQty * I.PackingFactor)\n\tFROM\n\t\tPRLedger P, PRDetail PD, Item I\n\tWHERE \n\t\tP.Date >= :ad_startdate AND P.Date <= :ad_enddate AND\n\t\tP.PRInvCode = PD.PRInvCode AND \n\t\tPD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)\n\tGROUP BY\n\t\tPD.ICode) AS S ON (I.ICode = S.ICode)\nWHERE\n\tIC.ICatCode IN (:ai_icatcode) AND\n\tIC.ICatCode = I.ICatCode AND\n\tI.ICCode = ICL.ICCode AND\n\tI.ISizeCode = ISZ.ISizeCode\nGROUP BY\n\tIC.ICatCode,\n\tIC.Name,\n\tICL.ICCode,\n\tICL.Name,\n\tISZ.ISizeCode,\n\tISZ.Name\nORDER BY\n\tItemCategory,\n\tItemClass,\n\tItemSize",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_icatcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "itemcategory A, itemclass A, itemsize A"
 },
