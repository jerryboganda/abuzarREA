    "dbname": "qty"
   },
   {
    "type": "decimal(13)",
    "updatewhereclause": "yes",
    "name": "avgpurprice",
    "dbname": "avgpurprice"
   },
   {
    "type": "decimal(13)",
    "updatewhereclause": "yes",
    "name": "avgsaleprice",
    "dbname": "avgSalePrice"
   }
  ],
  "retrieve": "SELECT Supplier=A.name,\n\tManf=M.name,\n\tItem=I.name, \n\tqty=Sum(PD.looseqty+PD.PackQty*PD.packunits),\n\tavgpurprice=avg(CASE  when PL.purcatcode IN (3,7,8)THEN PD.Purprice ELSE PD.purprice/(case PD.packunits when 0 then 1 else PD.packunits end) END),\n\tavgSalePrice=avg(PD.Saleprice/(case PD.packunits when 0 then 1 else PD.packunits end))\nFROM \n\tAccounts A,\n\tPurLedger PL,\n\tPurdetail PD,\n\tManufacturer M,\n\tItem I\n\nWHERE \n\tPL.date>= :ad_StartDate AND PL.date<=:ad_EndDate AND\n\tPL.suppcode IN (:aa_suppcode) AND\n\tPL.purinvcode=PD.purinvcode AND\n\tPL.suppcode=A.acccode AND\n\tPD.icode=I.icode AND\n\tI.manfcode IN (:aa_manfcode) AND\n\tI.manfcode=M.manfcode\nGROUP BY\n\t\n\tA.name,\n\tM.name,\n\tI.name\nORDER BY\n\tSupplier,\n\tManf,\n\tItem\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_EndDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "aa_suppcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "aa_manfcode",
      "numberlist"
     ]
    }
   ]
  }
 },
