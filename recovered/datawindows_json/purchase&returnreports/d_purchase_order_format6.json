  "retrieve": "SELECT \n\tGroupCode = \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END,   \n\tGroupName= \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)\n\t\tWHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)\n\t\tWHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)\n\t\tELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,   \n\tI.name,\n\titemalias=I.customicode,\n\tOH.POCode,  \n\tOH.Date,\n\tAcc.name,\n\tS.address1,\n\tS.address2,\n\tS.city,\n\tS.phone,\n\tS.fax,\n\tOH.remarks,\n\tOH.purorderterms1,\n\tOH.purorderterms2,\n\tOH.purorderterms3,\n\tOH.purorderterms4,\n\tOH.purorderterms5,\n\tOH.purorderterms6,\n\tOH.purorderterms7,\n\tOH.purorderterms8,\n\tOH.Discperc,\n\tI.packingdesc,\n\tOD.rate,\n\tOD.qty,\n\tOD.bonusqty,\n\tOD.discperc,\n\tOD.reorderqty,\n\tOD.OptimumQty,\n\tOD.Stock,\n\tOD.SoldQty,\n\tOD.ReturnQty,\n\tNetSaleQty= OD.SoldQty - OD.ReturnQty,\n\tamount= (OD.qty * OD.rate) * ( 1 - (OD.discperc * 0.01) ) ,\n\tOH.PurOrderCatCode,\n\tPurPrice=OD.PurPrice,\n\tSalePrice=OD.SalePrice,\n\tRPP=OD.RPP,\n\tAvgPrice=OD.PackAvgPrice\nFROM \n\titem I, \n\taccounts Acc, \n\tpurorderheader OH, \n\tpurorderdetail OD , \n\tSupplier S\nWHERE \n\tOH.pocode >= :ai_sPOCode AND\n\tOH.pocode <= :ai_lPOCode AND\n\tOH.pocode=OD.pocode AND\n\tOH.suppCode = S.SuppCode AND\n\tOH.suppcode=Acc.acccode AND\n\tOD.icode=I.icode\nORDER BY\n\toh.pocode, groupname, groupcode, i.name",
  "arguments": {
   "_items": [
