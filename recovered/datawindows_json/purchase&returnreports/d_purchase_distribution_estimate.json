   }
  ],
  "retrieve": "SELECT\n\tPD.ICode, AliasName=I.CustomICode, ItemName=I.Name, \n\tPurQty=PD.LooseQty + PD.PackQty + PD.BonusQty, \n\tQuotedQty=QD.Qty, \n\tCutAlias=(SELECT A.AliasName FROM Accounts A WHERE A.AccCode=QH.CustCode) + ' ' + LTRIM(RTRIM(STR(QH.QuotationCode)))\nFROM \n\tPurDetail PD, PurLedger P, Item I,\n\tPurOrderDetail POD, PurOrderHeader POH, \n\tSaleOrderDetail SOD, \n\tQuotationDetail QD, QuotationHeader QH\nWHERE \n\tP.PurInvCode=:ai_code AND \n\tP.PurInvCode = PD.PurInvCode AND \n\tPD.ICode=I.ICode AND\n\tP.POCode = POH.POCode AND \n\tPOH.POCode = POD.POCode AND\n\tPD.ICode = POD.ICode AND \n\tPOH.SaleOrderCode = SOD.SaleOrderCode AND\n\tSOD.ICode=POD.ICode AND SOD.QuotationRowID = QD.RowID AND\n\tQD.QuotationCode=QH.QuotationCode\nUNION ALL\nSELECT\n\tPD.ICode, AliasName=I.CustomICode, ItemName=I.Name, \n\tPurQty=PD.LooseQty + PD.PackQty + PD.BonusQty, \n\tQuotedQty=0.00, \n\tCutAlias=NULL\nFROM \n\tPurDetail PD, PurLedger P, Item I\nWHERE \n\tP.PurInvCode=:ai_code AND \n\tP.PurInvCode = PD.PurInvCode AND \n\tPD.ICode=I.ICode AND\n\tI.ICode NOT IN \n\t\t(SELECT\n\t\t\tDISTINCT PD.ICode\n\t\tFROM \n\t\t\tPurDetail PD, PurLedger P, Item I,\n\t\t\tPurOrderDetail POD, PurOrderHeader POH, \n\t\t\tSaleOrderDetail SOD, \n\t\t\tQuotationDetail QD, QuotationHeader QH\n\t\tWHERE \n\t\t\tP.PurInvCode=:ai_code AND \n\t\t\tP.PurInvCode = PD.PurInvCode AND \n\t\t\tPD.ICode=I.ICode AND\n\t\t\tP.POCode = POH.POCode AND \n\t\t\tPOH.POCode = POD.POCode AND\n\t\t\tPD.ICode = POD.ICode AND \n\t\t\tPOH.SaleOrderCode = SOD.SaleOrderCode AND\n\t\t\tSOD.ICode=POD.ICode AND SOD.QuotationRowID = QD.RowID AND\n\t\t\tQD.QuotationCode=QH.QuotationCode)\nORDER BY ItemName\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  },
  "sort": "aliasname A, itemname A, purqty A"
 },
