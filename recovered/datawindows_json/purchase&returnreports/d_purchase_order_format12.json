  "retrieve": "  SELECT customername='abcdefghijklmnopqrstuvwxyzabcd'  ,   \n\t\t\tpurtypename=(select name from purchasetype where purchasetype.purtypecode=PurOrderHeader.purtypecode),\n\t\t\titemname= item.name,  \n\t\titemcatname=(select name from itemcategory where itemcategory.icatcode=PurOrderHeader.icatcode),\n\t\titemalias=item.customicode,\n\t\tsaleprice=purorderdetail.saleprice,\n\t\tstock=purorderdetail.stock,\n         PurOrderHeader.POCode,   \n\t\tremarks=PurOrderHeader.remarks,\n         PurOrderHeader.Date,   \n         PurOrderDetail.ICode,   \n         PurOrderDetail.Qty,  \n\t\tbonusqty=PurOrderdetail.bonusqty,\n\t\trate=purorderdetail.rate,\n\t\treorderqty=purorderdetail.reorderqty,\n\t\tnetqty= PurOrderdetail.bonusqty + PurOrderDetail.Qty,\n         Accounts.Name,\n\t\t\tPurOrderDetail.PORowID,\n\t\t\tManufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),\n\t\t\tstartdate=PurOrderHeader.startdate,\n\t\t\tenddate=PurOrderHeader.enddate,\n\t\t\tprojectiondays=PurOrderheader.Projectionperiod,\n\t\t\tpurordercatcode=PurOrderHeader.purordercatcode\n    FROM PurOrderDetail,    \n         PurOrderHeader,   \n         Accounts, \n         item \n   WHERE ( PurOrderHeader.POCode >= :ra_SPOCode )   AND\n\t\t\tPurOrderHeader.POCode <= :ra_EPOCode  AND\n\t\t\t( PurOrderHeader.POCode = PurOrderDetail.POCode ) and  \n\t\t\t( PurOrderDetail.icode = item.icode ) and  \n         ( PurOrderHeader.SuppCode = Accounts.AccCode ) \n      \t\nORDER BY\n\n PurOrderHeader.POCode,\n PurOrderDetail.PORowID\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_SPOCode",
      "number"
     ]
    },
    {
     "_items": [
      "ra_EPOCode",
      "number"
     ]
    }
   ]
  }
 },
