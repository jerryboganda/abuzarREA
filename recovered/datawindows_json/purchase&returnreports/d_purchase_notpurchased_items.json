    "dbname": "purinvdate"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "manufacturer",
    "dbname": "Manufacturer"
   }
  ],
  "retrieve": "SELECT aliasname=I.customicode,\n\t\titemname=I.name,  \n\t\tstock=(select sum(currqty) from godowndetail where icode=I.icode),\n\t\tLastPurInvNo=(\tselect max(purinvcode)\n\t\t      \t\t\tfrom purdetail\n\t\t      \t\t\twhere purdetail.icode=I.icode\n\t\t\t    ),  \n\t\tpurinvdate=(select max(date)\n\t\t      \t\tfrom purdetail,purledger\n\t\t      \t\twhere purdetail.icode=I.icode and\n\t\t\t    \t\t\t\tpurdetail.purinvcode=purledger.purinvcode\n\t\t\t    \t\t),\n\t\tManufacturer=M.name\nFROM  item I,\n\t\tmanufacturer M\n\nWHERE I.manfcode IN (:aa_manfcode) and\n\t\tI.manfcode=M.manfcode and  \n      I.icode NOT IN (\tselect icode from purledger,purdetail\n\t\t      \t\t\t\twhere date between :ar_StartDate and :ar_EndDate and\n\t\t\t    \t\t\t\t\t\tpurledger.purinvcode=purdetail.purinvcode ) \nORDER BY M.name,\n\t\t\tI.name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_EndDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "aa_manfcode",
      "numberlist"
     ]
    }
   ]
  }
