    "dbname": "netamt"
   }
  ],
  "retrieve": "SELECT \tDATE=\tCONVERT(DATETIME, \n\t\tRTRIM(LTRIM(str(datepart(month,P.DATE))))+ '/' +\n\t\tRTRIM(LTRIM(str(datepart(DAY,P.DATE)))) + '/' + \n\t\tRTRIM(LTRIM(str(datepart(year,P.DATE))))),\n\tNETAMT=SUM(P.NETAMT), \n\tTYPE=\tCASE WHEN P.PURTYPECODE is NULL THEN 'OTHERS'\n\t\t\tELSE (SELECT NAME FROM PURCHASETYPE WHERE PURTYPECODE=P.PURTYPECODE) END\nFROM\n(SELECT PURLEDGER.PURINVCODE AS INVNO, \n\t-(ROUND(\n\tSUM((purdetail.looseqty + purdetail.packqty + purdetail.bonusqty) *\n\t\tpurdetail.unitsalestax) +\n\t\tSUM(ROUND((purdetail.looseqty + purdetail.packqty) * purdetail.purprice * \n\t\t(1 - (.01 * purdetail.discperc)) * purdetail.gstperc * .01, 2)) +\n\t\tROUND((SUM(((purdetail.looseqty + purdetail.packqty) * purdetail.purprice) * \n\t\t\t(1 - (.01 * purdetail.discperc))) * \n\t\t\t(1- (.01 * purledger.discperc)) - purledger.flatdisc) * \n\t\t\t(purledger.invgstperc1 * .01), 2), 0) + \n\t\tROUND(SUM((purdetail.looseqty + purdetail.packqty) * purdetail.purprice * \n\t\t\t(1 - (.01 * purdetail.discperc))) * (1- (.01 * purledger.discperc)) + \n\t\t\tpurledger.misccharges + purledger.salestax - purledger.flatdisc, 0)) AS NETAMT,\n\tPURLEDGER.DATE,\n\tPURLEDGER.PURTYPECODE\nFROM PURLEDGER, PURDETAIL\nWHERE PURLEDGER.PURINVCODE = PURDETAIL.PURINVCODE AND \n\t\tPURLEDGER.DATE >= :ar_startdate AND PURLEDGER.DATE <= :ar_enddate\nGROUP BY \nPURLEDGER.PURINVCODE,\nPURLEDGER.SuppCode,\nPURLEDGER.DiscPerc,\nPURLEDGER.MiscCharges,\nPURLEDGER.SalesTax,\nPURLEDGER.FlatDisc,\nPURLEDGER.DiscPerc,\nPURLEDGER.FlatDisc,\nPURLEDGER.DATE,\nPURLEDGER.PURTYPECODE,\nPURLEDGER.InvGSTPerc1) P\nGROUP BY \n\tCONVERT(DATETIME, \n\t\tRTRIM(LTRIM(str(datepart(month,P.DATE))))+ '/' +\n\t\tRTRIM(LTRIM(str(datepart(DAY,P.DATE)))) + '/' + \n\t\tRTRIM(LTRIM(str(datepart(year,P.DATE))))),\n \n\tp.purtypecode\n\nUNION ALL\n\nSELECT  DATE=\tRTRIM(LTRIM(str(datepart(month,:ar_enddate))))+ '/' +\n\t\tRTRIM(LTRIM(str(datepart(DAY,:ar_enddate)))) + '/' + \n\t\tRTRIM(LTRIM(str(datepart(year,:ar_enddate)))),\n\tNETAMT=0,\n\tTYPE=NAME\nFROM Purchasetype \nwhere purtypecode not in \n\t(SELECT DISTINCT ISNULL(PURLEDGER.PURTYPECODE, 0)\n\tFROM PURLEDGER\n\tWHERE PURLEDGER.DATE >= :ar_startdate AND PURLEDGER.DATE <= :ar_enddate)\nORDER BY DATE\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "date A"
 },
