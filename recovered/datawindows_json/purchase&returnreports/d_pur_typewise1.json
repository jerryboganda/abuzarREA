  "retrieve": "SELECT \n\tcashpur= \n\t\t (SELECT Isnull(sum ( A.invamount ) ,0)\n\t\tFROM \n\t\t\t(SELECT invamount=Round(Sum (( dbo.purdetail.looseqty + purdetail.packqty ) * dbo.purdetail.purprice)\n\t\t\t\t\t\t- Sum (Round(((( dbo.purdetail.looseqty + purdetail.packqty ) * dbo.purdetail.purprice ) * (dbo.purdetail.discperc * .01)) ,2))\n\t\t\t\t\t\t- Sum ( Round( dbo.purdetail.purprice * (dbo.purdetail.looseqty + purdetail.packqty )    * (1 - (dbo.purdetail.discperc * .01)),2)) * (dbo.purledger.discperc /100) \n\t\t\t\t\t\t+ dbo.purledger.misccharges - purledger.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))  \n\t\t\tFROM  dbo.purledger, dbo.purdetail, dbo.accounts\n\t\t\tWHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and \n\t\t\t\t( dbo.purledger.purcatcode IN (1,7 ))and\n\t\t\t\t( dbo.purledger.porb='N') and\n\t\t\t\t( dbo.purledger.suppcode = dbo.accounts.acccode )and  \n\t\t\t\t( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            \n\t\t\tGROUP BY \n\t\t\t\tdbo.purledger.purinvcode,            \n\t\t\t\tdbo.purledger.misccharges,   \n\t\t\t\tdbo.purledger.flatdisc,   \n\t\t\t\tdbo.purledger.invgstperc1,\t\n\t\t\t\tdbo.purledger.discperc,  \n\t\t\t\tdbo.purledger.salestax) as A),\n\ncashpursalestax = \n       (select Isnull(sum ( AA.salestax ) ,0)\n\t\t\tfrom \n\n(\n  SELECT salestax= Round (\n\t\t\t/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( Purdetail.looseqty + Purdetail.packqty ) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ) , 2 ) )\n\t\t\t\t\t\t\t\t  \t       * ( 1 - PurLedger.discperc * 0.01 ) , 2 ) - PurLedger.flatdisc ) * PurLedger.invgstperc1 * 0.01  , 2 )\n \t\t\t/*items salestax*/\t\t + Sum (Round ( (PurDetail.looseqty + PurDetail.packqty + PurDetail.bonusqty)* PurDetail.unitsalestax + Round ( Round ( (Purdetail.looseqty + Purdetail.packqty) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ), 2 ) * Purdetail.gstperc * 0.01 , 2 ) , 2 ) )\n\t\t\t\t\t\t\t\t\t\t , ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)) \n\t\n   FROM  dbo.purledger,  \n\t\t\tdbo.purdetail,   \n         dbo.accounts  \n\n   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and \n \t\t\t( dbo.purledger.purcatcode IN (1,7 ))and\n\t\t\t( dbo.purledger.porb='N') and\n         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  \n     \t   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            \n\n\tGROUP BY \n\t\t\tdbo.purledger.purinvcode,            \n\t\t\tdbo.purledger.misccharges,   \n         dbo.purledger.flatdisc,   \n         dbo.purledger.invgstperc1,\t\n\t\t\tdbo.purledger.discperc,  \n\t\t\tdbo.purledger.salestax\n\t\t\t\n ) as AA),\n\nCreditpur=       (select ISNULL(sum(B.invamount),0)\n\t\t\tfrom \n(\n  SELECT invamount=Round(Sum( ( dbo.purdetail.looseqty + purdetail.packqty) * dbo.purdetail.purprice)\n\t\t\t\t\t\t  - Sum (Round(((( dbo.purdetail.looseqty + purdetail.packqty ) * dbo.purdetail.purprice ) * (dbo.purdetail.discperc * .01)) ,2))\n\t\t\t\t\t\t  - Sum ( Round( dbo.purdetail.purprice * (dbo.purdetail.looseqty + purdetail.packqty )    * (1 - (dbo.purdetail.discperc * .01)),2)) * (dbo.purledger.discperc /100) \n\t\t\t\t\t \t  + dbo.purledger.misccharges - purledger.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))  \n\n    FROM dbo.purledger,  \n\t\t\tdbo.purdetail,   \n         dbo.accounts  \n\n   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and \n \t\t\t( dbo.purledger.purcatcode in (2,8 ))and\n\t\t\t( dbo.purledger.porb='N') and\n         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  \n     \t   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            \n\nGROUP BY \n\t\t\tdbo.purledger.purinvcode,   \n\t\t\tdbo.purledger.misccharges,   \n         dbo.purledger.flatdisc,   \n         dbo.purledger.discperc,\n  \t\t\tdbo.purledger.invgstperc1,\n\t\t\tdbo.purledger.salestax\n\n   ) as B),\n\nCreditpursalestax =  (select ISNULL(sum(BB.salestax),0)\n\t\t\tfrom \n(\n  SELECT salestax = Round (\n\t\t\t/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( Purdetail.looseqty + Purdetail.packqty ) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ) , 2 ) )\n\t\t\t\t\t\t\t\t  \t       * ( 1 - PurLedger.discperc * 0.01 ) , 2 ) - PurLedger.flatdisc ) * PurLedger.invgstperc1 * 0.01  , 2 )\n \t\t\t/*items salestax*/\t\t + Sum (Round ( (PurDetail.looseqty + PurDetail.packqty + PurDetail.bonusqty)* PurDetail.unitsalestax + Round ( Round ( (Purdetail.looseqty + Purdetail.packqty) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ), 2 ) * Purdetail.gstperc * 0.01 , 2 ) , 2 ) )\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\t\t , ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)) \n    FROM dbo.purledger,  \n\t\t\tdbo.purdetail,   \n         dbo.accounts  \n\n   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and \n \t\t\t( dbo.purledger.purcatcode in (2,8 ))and\n\t\t\t( dbo.purledger.porb='N') and\n         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  \n     \t   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            \n\nGROUP BY \n\t\t\tdbo.purledger.purinvcode,   \n\t\t\tdbo.purledger.misccharges,   \n         dbo.purledger.flatdisc,   \n         dbo.purledger.discperc,\n  \t\t\tdbo.purledger.invgstperc1,\n\t\t\tdbo.purledger.salestax\n\n   ) as BB),\n\nsalereturn=(select ISNULL(SUM(C.invamount),0)\n\t\t\t from \n              (\n\n\n  SELECT invamount=Round(Sum ( (dbo.purdetail.looseqty + purdetail.packqty)* dbo.purdetail.purprice)\n\t\t\t\t\t\t- Sum (Round(((( dbo.purdetail.looseqty + purdetail.packqty ) * dbo.purdetail.purprice ) * (dbo.purdetail.discperc * .01)) ,2))\n\t\t\t\t\t\t- Sum ( Round( dbo.purdetail.purprice * (dbo.purdetail.looseqty + purdetail.packqty )    * (1 - (dbo.purdetail.discperc * .01)),2)) * (dbo.purledger.discperc /100) \n\t\t\t\t\t\t+ dbo.purledger.misccharges - purledger.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))  \n\n    FROM dbo.purledger,  \n\t\t\tdbo.purdetail,   \n         dbo.accounts  \n\n   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and \n \t\t\t( dbo.purledger.porb='Y') and\n         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  \n     \t   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            \n\nGROUP BY \n         dbo.purledger.purinvcode,   \n\t\t\tdbo.purledger.misccharges,   \n         dbo.purledger.flatdisc,   \n\t\t\tdbo.purledger.discperc,  \n\t\t\tdbo.purledger.invgstperc1,\n\t\t\tdbo.purledger.salestax\t\t\t\n  ) as C),\n\nsalereturnsalestax = (select ISNULL(SUM(CC.salestax),0)\n\t\t\t from \n              (\n\n  SELECT salestax = Round (\n\t\t\t/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( Purdetail.looseqty + Purdetail.packqty ) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ) , 2 ) )\n\t\t\t\t\t\t\t\t  \t       * ( 1 - PurLedger.discperc * 0.01 ) , 2 ) - PurLedger.flatdisc ) * PurLedger.invgstperc1 * 0.01  , 2 )\n \t\t\t/*items salestax*/\t\t + Sum (Round ( (PurDetail.looseqty + PurDetail.packqty + PurDetail.bonusqty)* PurDetail.unitsalestax + Round ( Round ( (Purdetail.looseqty + Purdetail.packqty) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ), 2 ) * Purdetail.gstperc * 0.01 , 2 ) , 2 ) )\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\t\t , ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)) \n    FROM dbo.purledger,  \n\t\t\tdbo.purdetail,   \n         dbo.accounts  \n\n   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and \n \t\t\t( dbo.purledger.porb='Y') and\n         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  \n     \t   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            \n\nGROUP BY \n\t\t\tdbo.purledger.purinvcode,   \n\t\t\tdbo.purledger.misccharges,   \n         dbo.purledger.flatdisc,   \n         dbo.purledger.discperc,  \n\t\t\tdbo.purledger.invgstperc1,\n\t\t\tdbo.purledger.salestax\t\t\t\n  ) as CC ),\n\nopeningpur=(select ISNULL(SUM(D.invamount),0)\n\t\t\t from \n\n              (\n\n  SELECT invamount=Round(Sum ( (dbo.purdetail.looseqty + purdetail.packqty)* dbo.purdetail.purprice)\n\t\t\t\t\t\t- Sum (Round(((( dbo.purdetail.looseqty + purdetail.packqty ) * dbo.purdetail.purprice ) * (dbo.purdetail.discperc * .01)) ,2))\n\t\t\t\t\t\t- Sum ( Round( dbo.purdetail.purprice * (dbo.purdetail.looseqty + purdetail.packqty )    * (1 - (dbo.purdetail.discperc * .01)),2)) * (dbo.purledger.discperc /100) \n\t\t\t\t\t\t+ dbo.purledger.misccharges - purledger.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))  \n\n    FROM dbo.purledger,  \n\t\t\tdbo.purdetail,   \n         dbo.accounts  \n\n   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and \n \t\t\t( dbo.purledger.porb='N') and\n\t\t\t( dbo.purledger.purcatcode in (3 ))and\n         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  \n     \t   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            \n\nGROUP BY \n         dbo.purledger.purinvcode,   \n\t\t\tdbo.purledger.misccharges,   \n         dbo.purledger.flatdisc,   \n\t\t\tdbo.purledger.invgstperc1,\n\t\t\tdbo.purledger.discperc,  \n\t\t\tdbo.purledger.salestax\n  ) as D) ,\n\nopeningpursalestax = (select ISNULL(SUM(DD.salestax),0)\n\t\t\t from \n\n              (\n\n  SELECT salestax = Round (\n\t\t\t/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( Purdetail.looseqty + Purdetail.packqty ) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ) , 2 ) )\n\t\t\t\t\t\t\t\t  \t       * ( 1 - PurLedger.discperc * 0.01 ) , 2 ) - PurLedger.flatdisc ) * PurLedger.invgstperc1 * 0.01  , 2 )\n \t\t\t/*items salestax*/\t\t + Sum (Round ( (PurDetail.looseqty + PurDetail.packqty + PurDetail.bonusqty)* PurDetail.unitsalestax + Round ( Round ( (Purdetail.looseqty + Purdetail.packqty) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ), 2 ) * Purdetail.gstperc * 0.01 , 2 ) , 2 ) )\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\t\t , ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)) \n\n    FROM dbo.purledger,  \n\t\t\tdbo.purdetail,   \n         dbo.accounts  \n\n   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and \n \t\t\t( dbo.purledger.porb='N') and\n\t\t\t( dbo.purledger.purcatcode in (3 ))and\n         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  \n     \t   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            \n\nGROUP BY \n         dbo.purledger.purinvcode, \n\t\t\tdbo.purledger.misccharges,   \n         dbo.purledger.flatdisc,   \n\t\t\tdbo.purledger.invgstperc1,\n\t\t\tdbo.purledger.discperc,  \n\t\t\tdbo.purledger.salestax\n  ) as DD)\n",
