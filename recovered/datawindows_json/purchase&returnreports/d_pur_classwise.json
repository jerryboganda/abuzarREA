  "retrieve": "SELECT\tA.iccode,  \n\tClassname =(SELECT name FROM itemclass WHERE iccode=A.iccode),\n\tpurchase=ROUND((SELECT ISNULL( SUM(((PD.looseqty + PD.packqty ) * PD.purprice ) * \n\t\t\t(1 - (.01 *  PD.discperc))), 0)\n\t\t FROM purdetail PD, purledger PL, item I\n\t\t WHERE \tPL.date between :ar_startdate and :ar_enddate and\n\t\t\tPL.SalesManCode IN (:ar_usercode) AND\n\t\t\tPL.posted='Y' and\n       \tPL.purinvcode=PD.purinvcode and\n\t\t \tPD.icode=I.icode AND\n\t\t \tI.iccode=A.iccode), 2),\n\tpreturn =ROUND((SELECT ISNULL( SUM(((PRD.looseqty + PRD.packqty ) * PRD.prprice ) * \n\t\t\t(1 - (.01 *  PRD.discperc))), 0)\n\t\t FROM prdetail PRD, prledger PRL, item I\n\t\t WHERE PRL.date between :ar_startdate and :ar_enddate and\n\t\t\tPRL.SalesManCode IN (:ar_usercode) AND\n\t\t\tPRL.posted='Y' and\n  \t\t\tPRL.prinvcode=PRD.prinvcode and\n\t\t \tPRD.icode=I.icode AND\n\t\t \tI.iccode=A.iccode), 2),\n\tNetPurchase=ROUND((SELECT ISNULL( SUM(((PD.looseqty + PD.packqty ) * PD.purprice ) * \n\t\t\t(1 - (.01 *  PD.discperc))), 0)\n\t\t FROM purdetail PD, purledger PL, item I\n\t\t WHERE \tPL.date between :ar_startdate and :ar_enddate and\n\t\t\tPL.SalesManCode IN (:ar_usercode) AND\n\t\t\tPL.posted='Y' and\n       \tPL.purinvcode=PD.purinvcode and\n\t\t \tPD.icode=I.icode AND\n\t\t \tI.iccode=A.iccode), 2) -\n\t\t ROUND((SELECT ISNULL( SUM(((PRD.looseqty + PRD.packqty ) * PRD.prprice ) * \n\t\t\t(1 - (.01 *  PRD.discperc))), 0)\n\t\t FROM prdetail PRD, prledger PRL, item I\n\t\t WHERE PRL.date between :ar_startdate and :ar_enddate and\n\t\t\tPRL.SalesManCode IN (:ar_usercode) AND\n\t\t\tPRL.posted='Y' and\n       \tPRL.prinvcode=PRD.prinvcode and\n\t\t \tPRD.icode=I.icode AND\n\t\t \tI.iccode=A.iccode), 2),\n\tpurchaseatsale=ROUND((SELECT ISNULL( SUM((( CASE WHEN PD.PACKQTY > 0 THEN ((PD.packqty + PD.BonusQty) * PD.packunits) ELSE (PD.looseqty + PD.BonusQty) END ) *\n\t\t\t(PD.saleprice / \n\t\t\t\tCASE PD.packunits WHEN 0 THEN 1 ELSE PD.packunits END))), 0)\n\t\t FROM purdetail PD, purledger PL, item I\n\t\t WHERE \tPL.date between :ar_startdate and :ar_enddate and\n\t\t\tPL.SalesManCode IN (:ar_usercode) AND\n\t\t\tPL.posted='Y' and\n   \t\tPL.purinvcode=PD.purinvcode and\n\t\t \tPD.icode=I.icode AND\n\t\t \tI.iccode=A.iccode), 2),\n\tpreturnatsale =ROUND((SELECT ISNULL( SUM((( CASE WHEN PRD.PACKQTY > 0 THEN ((PRD.packqty + PRD.BonusQty) * PRD.packunits) ELSE (PRD.looseqty + PRD.BonusQty) END ) * \n\t\t\t(PRD.packsaleprice / \n\t\t\t\tCASE PRD.packunits WHEN 0 THEN 1 ELSE PRD.packunits END))), 0)\n\t\t FROM prdetail PRD, prledger PRL, item I\n\t\t WHERE \n\t\t\tPRL.date between :ar_startdate and :ar_enddate and\n\t\t\tPRL.SalesManCode IN (:ar_usercode) AND\n\t\t\tPRL.posted='Y' and\n       \t\t\tPRL.prinvcode=PRD.prinvcode and\n\t\t \tPRD.icode=I.icode AND\n\t\t \tI.iccode=A.iccode), 2),\n\tnetpurchaseatsale=ROUND((SELECT ISNULL( SUM((( CASE WHEN PD.PACKQTY > 0 THEN ((PD.packqty + PD.BonusQty) * PD.packunits) ELSE (PD.looseqty + PD.BonusQty) END ) *\n\t\t\t(PD.saleprice / \n\t\t\t\tCASE PD.packunits WHEN 0 THEN 1 ELSE PD.packunits END))), 0)\n\t\t FROM purdetail PD, purledger PL, item I\n\t\t WHERE\n\t\t \tPL.date between :ar_startdate and :ar_enddate and\n\t\t\tPL.SalesManCode IN (:ar_usercode) AND\n\t\t\tPL.posted='Y' and\n       \tPL.purinvcode=PD.purinvcode and\n\t\t \tPD.icode=I.icode AND\n\t\t \tI.iccode=A.iccode), 2) -\n\t\t ROUND((SELECT ISNULL( SUM((( CASE WHEN PRD.PACKQTY > 0 THEN ((PRD.packqty + PRD.BonusQty) * PRD.packunits) ELSE (PRD.looseqty + PRD.BonusQty) END ) * \n\t\t\t(PRD.packsaleprice / \n\t\t\t\tCASE PRD.packunits WHEN 0 THEN 1 ELSE PRD.packunits END))), 0)\n\t\t FROM prdetail PRD, prledger PRL, item I\n\t\t WHERE \n\t\t\tPRL.date between :ar_startdate and :ar_enddate and\n\t\t\tPRL.SalesManCode IN (:ar_usercode) AND\n\t\t\tPRL.posted='Y' and\n       \t\t\tPRL.prinvcode=PRD.prinvcode and\n\t\t \tPRD.icode=I.icode AND\n\t\t \tI.iccode=A.iccode), 2),\n\ttotaldisc = (SELECT SUM(flatdisc) FROM purledger p\n\t\t\t\t    WHERE  p.date between :ar_startdate and :ar_enddate and \n\t\t\t\t\t\tP.SalesManCode IN (:ar_usercode) AND\n\t\t\t\t\t\tp.posted='Y'),\n\tmisccharg= (SELECT SUM(misccharges) FROM  purledger p\n\t\t\t\t   WHERE p.date between :ar_startdate and :ar_enddate and \n\t\t\t\t\t\t\tP.SalesManCode IN (:ar_usercode) AND\n\t\t\t\t\t\t\tp.posted='Y'),\n\ttotalinvdiscperc= (SELECT SUM(ISNULL(B.invdiscperc,0))\n\t\t     \t   FROM\n\t\t\t\t  (SELECT invdiscperc = IsNull(SUM(Round(((d.looseqty + d.packqty ) * \n\t\t\t\t\t\t\td.purprice) * (1 - (.01 * d.discperc)),2)) * 0.01 * p.discperc, 0)\n\t\t \t\t  FROM     purledger p, purdetail d\n\t\t   \t  WHERE\t (p.date between :ar_startdate and :ar_enddate) AND\n\t\t\t\t\t\t\t  P.SalesManCode IN (:ar_usercode) AND\n\t\t\t\t\t\t\t  p.posted='Y' and p.purinvcode = d.purinvcode\n\t\t\t\t  GROUP BY p.purinvcode, p.discperc) AS  B),\n\tdiff=(select Round(sum ( ISNULL(A.diff,0)), 2)\n\t      from\n\t\t(SELECT p.purinvcode, Diff=ROUND(SUM((d.looseqty + d.packqty) * d.purprice * \n\t\t\t\t(1 - (.01 * d.discperc))) * (1- (.01 * p.discperc)) + \n\t\t\t\tp.misccharges + p.salestax - p.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)) - \n\t\t\t\t(SUM((d.looseqty + d.packqty) * d.purprice * \n\t\t\t\t(1 - (.01 * d.discperc))) * (1- (.01 * p.discperc)) + \n\t\t\t\tp.misccharges + p.salestax - p.flatdisc)\n\t\tFROM purledger p, purdetail d\n\t\tWHERE\t(p.purinvcode = d.purinvcode) and p.posted='Y' and \n\t\t\tP.SalesManCode IN (:ar_usercode) AND\n\t\t\t(p.date between :ar_startdate and :ar_enddate)\n\t\tGROUP BY p.purinvcode, p.suppcode, p.purcatcode, p.postdate, p.discperc,\n\t\t\t p.misccharges, p.salestax, p.flatdisc, p.InvGSTPerc1) as A),\n\tSalesTax = \n\t\t(SELECT ISNULL(Sum (ISNull(S.SaleTax,0)),0)\n\t\tFROM  (SELECT\t\n\t\t\tSaleTax=ROUND(SUM((d.looseqty + d.packqty + d.bonusqty) * d.unitsalestax) +\n\t\t\tSUM(ROUND((d.looseqty + d.packqty) * d.purprice * (1 - (.01 * d.discperc)) * \n\t\t\t\td.gstperc * .01, 2)) +\n\t\t\tROUND((SUM(((d.looseqty + d.packqty) * d.purprice) * \n\t\t\t\t(1 - (.01 * d.discperc))) * (1 - (.01 * p.discperc)) - p.flatdisc) * \n\t\t\t\t(p.invgstperc1 * .01), 2), ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))\n\t\tFROM dbo.Purledger P, dbo.Purdetail D\n\t\tWHERE  (P.date between :ar_startdate and :ar_enddate)  And\n\t\t\tP.SalesManCode IN (:ar_usercode) AND\n\t\t\tP.posted='Y' and P.purinvcode = D.purinvcode\n\t\tGROUP BY P.purinvcode, \n\t\t\t P.invgstperc1, \n\t\t\t P.misccharges,   \n\t\t\t P.flatdisc,\n\t\t\t P.discperc) AS S)\t\n\nFROM \t(SELECT DISTINCT (item.iccode) AS iccode \n\tFROM purdetail, purledger, item \n\tWHERE purledger.date between :ar_startdate and :ar_enddate and\n\t\t purledger.SalesManCode IN (:ar_usercode) AND\n\t    purledger.purinvcode=purdetail.purinvcode and\n\t    purdetail.icode=item.icode   \n\tUNION\n\tSELECT DISTINCT (item.iccode) as iccode \n\tFROM prdetail,prledger,item \n   WHERE \n\t\tprledger.date between :ar_startdate and :ar_enddate and\n\t\tprledger.SalesManCode IN (:ar_usercode) AND\n\t   prledger.prinvcode=prdetail.prinvcode and\n\t   prdetail.icode=item.icode) as A\n",
