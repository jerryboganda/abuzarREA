    "dbname": "TotalNetSales"
   }
  ],
  "retrieve": "SELECT  \n\tDate = CONVERT(DATETIME, CONVERT(varchar(10), T.Date, 101)),\n\tSaleAmt = SUM(CASE Type WHEN 'SALE' THEN T.SaleAmt ELSE 0.00 END),\n\tSaleReturnAmt = SUM(CASE Type WHEN 'SALE' THEN T.ReturnAmt ELSE 0.00 END),\n\tNetSale = SUM(CASE Type WHEN 'SALE' THEN T.SaleAmt - T.ReturnAmt ELSE 0.00 END),\n\tServiceAmt = SUM(CASE Type WHEN 'SERVICE' THEN T.SaleAmt ELSE 0.00 END),\n\tServiceReturnAmt = SUM(CASE Type WHEN 'SERVICE' THEN T.ReturnAmt ELSE 0.00 END),\n\tNetService = SUM(CASE Type WHEN 'SERVICE' THEN T.SaleAmt - T.ReturnAmt ELSE 0.00 END),\n\tTotalNetSales = SUM(T.SaleAmt - T.ReturnAmt)\nFROM\n\t(SELECT \n\t\tType = 'SALE',\n\t\tInvCode = H.SaleInvCode,\n\t\tDate = H.Date,\n\t\tSaleAmt = DBO.fn_GetSaleInvTotal(H.SaleInvCode),\n\t\tReturnAmt = 0.00\n\tFROM \n\t\tSaleLedger H\n\tWHERE \n\t\tH.Date BETWEEN :ad_startdate AND :ad_enddate\n\tGROUP BY\n\t\tH.SaleInvCode,\n\t\tH.Date\n\tUNION ALL\n\tSELECT \n\t\tType = 'SALE',\n\t\tInvCode = H.SRInvCode,\n\t\tDate = H.Date,\n\t\tSaleAmt = 0.00,\n\t\tReturnAmt = DBO.fn_GetSRInvTotal(H.SRInvCode)\n\tFROM \n\t\tSRLedger H\n\tWHERE \n\t\tH.Date BETWEEN :ad_startdate AND :ad_enddate\n\tGROUP BY\n\t\tH.SRInvCode,\n\t\tH.Date\n\tUNION ALL\n\tSELECT \n\t\tType = 'SERVICE',\n\t\tInvCode = H.ServiceInvCode,\n\t\tDate = H.Date,\n\t\tSaleAmt = DBO.fn_GetServiceInvTotal(H.ServiceInvCode),\n\t\tReturnAmt = 0.00\n\tFROM \n\t\tServiceHeader H\n\tWHERE \n\t\tH.Date BETWEEN :ad_startdate AND :ad_enddate\n\tGROUP BY\n\t\tH.ServiceInvCode,\n\t\tH.Date\n\tUNION ALL\n\tSELECT \n\t\tType = 'SERVICE',\n\t\tInvCode = H.ServiceRInvCode,\n\t\tDate = H.Date,\n\t\tSaleAmt = 0.00,\n\t\tReturnAmt = DBO.fn_GetServiceReturnInvTotal(H.ServiceRInvCode)\n\tFROM \n\t\tServiceRHeader H, ServiceRDetail D\n\tWHERE \n\t\tH.Date BETWEEN :ad_startdate AND :ad_enddate\n\tGROUP BY\n\t\tH.ServiceRInvCode,\n\t\tH.Date) T\nGROUP BY\n\tCONVERT(DATETIME, CONVERT(varchar(10), T.Date, 101))\nORDER BY\n\tDate\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
