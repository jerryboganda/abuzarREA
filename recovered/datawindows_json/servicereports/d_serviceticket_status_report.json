  ],
  "retrieve": "SELECT \n\tDate = ST.Date,\n\tServiceName = S.Name,\n\tServiceTicketCode = ST.ServiceTicketCode,\n\tTicketUsed = ST.TicketUsed,\n\tTicketUsedOn = ST.TicketUsedOn, \n\tScanned = CASE WHEN TicketUsed = 'Y' THEN ST.ServiceTicketCode ELSE NULL END,\n\tUnScanned = CASE WHEN TicketUsed = 'Y' THEN NULL ELSE ST.ServiceTicketCode END,\n\tExpiresOn = ST.ExpiresOn\nFROM \n\tServiceTicket ST, Service S\nWHERE\n\tST.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tST.ServiceCode = S.ServiceCode\nORDER BY\n\tST.ServiceTicketCode\n",
