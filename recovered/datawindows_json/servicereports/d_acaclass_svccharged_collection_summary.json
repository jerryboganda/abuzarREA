    "name": "balance",
    "dbname": "Balance"
   }
  ],
  "retrieve": "SELECT \n\tClassName=C.Name, \n\tRollNo=SC.RollNo,\n\tRegNo=S.RegNo,\n\tStudentName=S.Name,\n\tFatherName=S.FName,\n\tServiceCharged=(SELECT InvTotal=SUM(SH.InvTotal) FROM ServiceHeader SH WHERE SH.StudentCode = SC.StudentCode AND SH.Date BETWEEN :adt_startdate AND :adt_enddate),\n\tCollected=(SELECT Collected=SUM(SH.InvTotal - SH.OutstandingAmt) FROM ServiceHeader SH WHERE SH.StudentCode = SC.StudentCode AND SH.Date BETWEEN :adt_startdate AND :adt_enddate),\n\tBalance=(SELECT Balance=SUM(SH.OutstandingAmt) FROM ServiceHeader SH WHERE SH.StudentCode = SC.StudentCode AND SH.Date BETWEEN :adt_startdate AND :adt_enddate)\nFROM\n\tClass C, Student S, StudentClass SC\nWHERE\n\tC.Active = 'Y' AND\n\tC.ClassCode IN (:ai_classcode) AND\n\tC.ClassCode = SC.ClassCode AND\n\tSC.StudentCode = S.StudentCode \nORDER BY \n\tClassName,\n\tStudentName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_classcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "classname A, rollno A, studentname A"
 },
