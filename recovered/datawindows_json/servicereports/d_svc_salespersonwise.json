    "dbname": "NetShare"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "invflatdisc",
    "dbname": "invflatdisc"
   }
  ],
  "retrieve": "Select A.SalesPerson,\n       A.Service,\n       A.Qty,\n       A.ReturnQty, \n       A.Amount ,\n\t NetShare= A.commission,\n\t invflatdisc=(select isnull(sum(flatdisc),0)\n\t\t\t\t\tfrom serviceheader \n\t\t\t\t\twhere dbo.ServiceHeader.Date >= :ad_startdate AND\n                     \t\t\tdbo.ServiceHeader.Date <= :ad_enddate AND\n\t\t\t\t\t\t\tserviceinvcode in (select distinct(serviceinvcode) from servicedetail where servicedetail.smancode=A.smancode)\n\t\t\t\t\t)\n\t\t\t\t\t-\n\t\t\t\t\t(select isnull(sum(flatdisc),0)\n\t\t\t\t\tfrom servicerheader \n\t\t\t\t\twhere dbo.servicerheader.Date >= :ad_startdate AND\n                     \t\t\tdbo.servicerheader.Date <= :ad_enddate AND\n\t\t\t\t\t\t\t servicerinvcode in (select distinct(servicerinvcode) from servicerdetail where servicerdetail.smancode=A.smancode)\n\t\t\t\t\t)\n\nFrom (\n\nSelect SalesPerson = S.name,\n\t\tsmancode=S.salesmancode,\n       Service = dbo.Service.Name,\n       Qty = ( Select IsNull( SUM (dbo.ServiceDetail.Qty), 0 )\n               From dbo.ServiceHeader, \n                    dbo.ServiceDetail\n               Where dbo.ServiceHeader.Date >= :ad_startdate AND\n                     dbo.ServiceHeader.Date <= :ad_enddate AND\n                     dbo.ServiceHeader.ServiceInvCode = dbo.ServiceDetail.ServiceInvCode AND\n                     dbo.ServiceDetail.ServiceCode = dbo.Service.ServiceCode AND\n                     dbo.ServiceDetail.SmanCode = S.SalesManCode\n\n             ), \n      ReturnQty = ( Select IsNull( SUM (dbo.ServiceRDetail.QTY), 0 )\n              \t     From dbo.ServiceRHeader, \n                         dbo.ServiceRDetail\n              \t     Where dbo.ServiceRHeader.Date >= :ad_startdate AND\n                          dbo.ServiceRHeader.Date <= :ad_enddate AND\n                          dbo.ServiceRHeader.ServiceRInvCode = dbo.ServiceRDetail.ServiceRInvCode AND\n                          dbo.ServiceRDetail.ServiceCode = dbo.Service.ServiceCode AND\n\t\t                    dbo.ServiceRDetail.SmanCode = S.SalesManCode\n\n\t           ), \n       Amount = ( Select IsNull( Sum ( Round ( Round ( dbo.ServiceDetail.Qty * (dbo.ServiceDetail.price - dbo.ServiceDetail.serviceflatdisc) * ( 1 - (dbo.ServiceDetail.discperc * 0.01) ) , 2 ) * ( 1 - ( dbo.ServiceHeader.DiscPerc * 0.01) ), 2 ) ), 0 )\n                  From dbo.ServiceHeader,\n                       dbo.ServiceDetail\n\t\t            Where dbo.ServiceHeader.Date >= :ad_startdate AND\n                        dbo.ServiceHeader.Date <= :ad_enddate AND\n                        dbo.ServiceHeader.ServiceInvCode = dbo.ServiceDetail.ServiceInvCode AND\n                        dbo.ServiceDetail.ServiceCode = dbo.Service.ServiceCode AND\n\t               \t\tdbo.ServiceDetail.SmanCode = S.SalesManCode\n\t\t\t\t\t)\n\t\t\t\t\t-\n\t\t\t\t\t( Select IsNull( Sum ( Round ( Round ( dbo.ServiceRDetail.Qty * (dbo.ServiceRDetail.ServicePrice - dbo.ServiceRDetail.serviceflatdisc)  * ( 1 - (dbo.ServiceRDetail.discperc * 0.01) ) , 2 ) * ( 1 - ( dbo.ServiceRHeader.DiscPerc * 0.01) ), 2 ) ), 0 )\n                 From dbo.ServiceRHeader,\n                      dbo.ServiceRDetail\n\t      \t\t  Where dbo.ServiceRHeader.Date >= :ad_startdate AND\n                       dbo.ServiceRHeader.Date <= :ad_enddate AND\n                       dbo.ServiceRHeader.ServiceRInvCode = dbo.ServiceRDetail.ServiceRInvCode AND\n                       dbo.ServiceRDetail.ServiceCode = dbo.Service.ServiceCode AND\n\t            \t\t  dbo.ServiceRDetail.SmanCode = S.SalesManCode\n\t\t\t\t\t),\n\n\tcommission= ( Select isnull(sum(d.qty * (d.commission - d.serviceflatdisc) * (1 - d.discperc * 0.01) * (1 * h.discperc * 0.01)),0)\n                  From dbo.ServiceHeader h,\n                       dbo.ServiceDetail d\n\t\t            Where h.Date >= :ad_startdate AND\n                        h.Date <= :ad_enddate AND\n                        h.ServiceInvCode = d.ServiceInvCode AND\n                        d.ServiceCode = dbo.Service.ServiceCode AND\n\t               \t\td.SmanCode = S.SalesManCode\n\t\t\t\t\t)\n\t\t\t\t\t-\n\t\t\t\t\t( Select isnull(sum(d.qty * (d.commission - d.serviceflatdisc) * (1 - d.discperc * 0.01) * (1 - h.discperc * 0.01) ),0)\n                 From dbo.ServiceRHeader h,\n                      dbo.ServiceRDetail d\n\t      \t\t  Where h.Date >= :ad_startdate AND\n                       h.Date <= :ad_enddate AND\n                       h.ServiceRInvCode = d.ServiceRInvCode AND\n                       d.ServiceCode = dbo.Service.ServiceCode AND\n\t            \t\t  d.SmanCode = S.SalesManCode\n\t\t\t\t\t)\n\n\t\n\n\tFrom  (Select salesmancode, name  FROM SalesMan Where salesmancode In ( :ai_salesmancode )) S ,\n   \t    Service\t\n\n) A\n\nWhere A.qty > 0 OR A.ReturnQty > 0\n\nOrder By SalesPerson, Service",
  "arguments": {
