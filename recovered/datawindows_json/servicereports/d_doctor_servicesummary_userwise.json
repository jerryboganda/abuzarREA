    "dbname": "NetShare"
   }
  ],
  "retrieve": "SELECT\n\tS.DoctCode, \n\tDoctor=D.Name,\n\tUserName=(SELECT U.UserName FROM Users U WHERE S.UserCode=U.UserCode),\n\tS.ServiceCatCode, \n\tServiceCategory=SC.Name,\n\tSvcQty = SUM(S.SvcQty), \n\tSvcValue = SUM(S.SvcValue),\n\tSvcRetQty = SUM(S.SvcRetQty), \n\tSvcRetValue = SUM(S.SvcRetValue),\n\tNetQTY = SUM(S.QTY), \n\tNetValue = SUM(S.Value),\n\tNetShare = SUM(S.Commission)\nFROM\n\tDoctors D,\n\tService Sv,\n\tServiceCategory SC,\n\t(SELECT \n\t\tH.DoctCode, \n\t\tS.ServiceCode, \n\t\tUserCode=H.SalesManCode,\n\t\tSC.ServiceCatCode, \n\t\tSvcQTY = SUM(D.QTY), \n\t\tSvcValue = SUM(D.QTY * (D.Price - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01) * (1 - H.Discperc * 0.01)),\n\t\tSvcRetQty = 0,\n\t\tSvcRetValue=0.00,\n\t\tQTY = SUM(D.QTY), \n\t\tValue = SUM(D.QTY * (D.Price - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01) * (1 - H.Discperc * 0.01)),\n\t\tCommission = SUM(D.QTY * (D.Commission - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01) * (1 - H.Discperc * 0.01)) + \n\t\t\tSUM(D.Qty * (D.Price - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01)  * (1 - H.Discperc * 0.01) * D.SharePerc * 0.01)\n\tFROM ServiceHeader H, ServiceDetail D, ServiceCategory SC, Service S\n\tWHERE \n\t\tH.DoctCode IN (:ai_doctcode) AND \n\t\tH.CustCode IN (:ai_custcode) AND \n\t\tH.SalesmanCode IN (:ai_usercode) AND \n\t\tH.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\t\tH.ServiceInvCode = D.ServiceInvCode AND \n\t\tD.ServiceCode = S.ServiceCode AND\n\t\tS.ServiceCatCode = SC.ServiceCatCode AND\n\t\tSC.ServiceCatCode IN (:ai_servicecatcode)\n\tGROUP BY\n\t\tS.ServiceCode, \n\t\tSC.ServiceCatCode, \n\t\tH.SalesManCode,\n\t\tH.DoctCode\n\tUNION ALL\n\tSELECT \n\t\tH.DoctCode, \n\t\tS.ServiceCode, \n\t\tUserCode=H.SalesManCode,\n\t\tSC.ServiceCatCode, \n\t\tSvcQTY = 0, \n\t\tSvcValue = 0.00,\n\t\tSvcRetQty = SUM(D.QTY), \n\t\tSvcRetValue = SUM(D.QTY * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01) * (1 - H.Discperc * 0.01)),\n\t\tQTY = -SUM(D.QTY), \n\t\tValue = -SUM(D.QTY * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01) * (1 - H.Discperc * 0.01)),\n\t\tCommission = - (SUM(D.QTY * (D.Commission - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01) * (1 - H.Discperc * 0.01)) + \n\t\t\t\t\t\t\tSUM(D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01)  * (1 - H.Discperc * 0.01) * D.SharePerc * 0.01))\n\tFROM ServiceRHeader H, ServiceRDetail D, ServiceCategory SC, Service S\n\tWHERE \n\t\tH.DoctCode IN (:ai_doctcode) AND \n\t\tH.CustCode IN (:ai_custcode) AND \n\t\tH.SalesmanCode IN (:ai_usercode) AND \n\t\tH.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\t\tH.ServiceRInvCode = D.ServiceRInvCode AND \n\t\tD.ServiceCode = S.ServiceCode AND\n\t\tS.ServiceCatCode = SC.ServiceCatCode AND\n\t\tSC.ServiceCatCode IN (:ai_servicecatcode)\n\tGROUP BY\n\t\tS.ServiceCode, \n\t\tSC.ServiceCatCode, \n\t\tH.SalesManCode,\n\t\tH.DoctCode) S\nWHERE\n\tS.ServiceCode = SV.ServiceCode AND\n\tS.ServiceCatCode = SC.ServiceCatCode AND\n\tS.DoctCode = D.DoctCode\nGROUP BY\n\tS.UserCode,\n\tS.DoctCode,\n\tD.Name,\n\tS.ServiceCatCode,\n\tSC.Name \n\n",
