    "dbname": "TotalServiceReturn"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "netservice",
    "dbname": "NetService"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "netshare",
    "dbname": "NetShare"
   }
  ],
  "retrieve": "SELECT  \n\tDate = CONVERT(DATETIME, CONVERT(varchar(10), T.Date, 101)),\n\tCashService = SUM(CASE Type WHEN 1 THEN T.SvcAmt ELSE 0.00 END),\n\tCreditService = SUM(CASE Type WHEN 2 THEN T.SvcAmt ELSE 0.00 END),\n\tTotalService = SUM(CASE WHEN Type <= 2 THEN T.SvcAmt ELSE 0.00 END),\n\tCashServiceReturn = SUM(CASE Type WHEN 3 THEN T.SvcRetAmt ELSE 0.00 END),\n\tCreditServiceReturn = SUM(CASE Type WHEN 4 THEN T.SvcRetAmt ELSE 0.00 END),\n\tTotalServiceReturn = SUM(CASE WHEN Type > 2 THEN T.SvcRetAmt ELSE 0.00 END),\n\tNetService = SUM(T.SvcAmt - T.SvcRetAmt) - SUM(T.SvcShare - T.SvcRetShare),\n\tNetShare = SUM(T.SvcShare - T.SvcRetShare)\nFROM\n\t(SELECT \n\t\tInvCode = H.ServiceInvCode,\n\t\tDate = H.Date,\n\t\tType = CASE H.ServiceCatCode WHEN 10 THEN 1 ELSE 2 END,\n\t\tSvcAmt = ISNULL(SUM(D.Qty * (D.price - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01)) + MiscCharges - FlatDisc, 0) +\n\t\t\tRound(Sum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc) +\n\t\t\tSum(D.qty * D.serviceflattax ) +\n\t\t\tRound((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01 * H.serviceinvgstperc,2), 0),\n\t\tSvcShare = ISNULL(SUM(D.Qty * (D.Commission - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01)), 0),\n\t\tSvcRetAmt = 0.00,\n\t\tSvcRetShare = 0.00\n\tFROM \n\t\tServiceHeader H, ServiceDetail D\n\tWHERE \n\t\tH.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\t\tH.ServiceInvCode = D.ServiceInvCode \n\tGROUP BY\n\t\tH.ServiceInvCode,\n\t\tH.Date,\n\t\tH.ServiceCatCode,\n\t\tH.MiscCharges,\n\t\tH.serviceinvgstperc,\n\t\tH.FlatDisc\n\tUNION ALL\n\tSELECT \n\t\tInvCode = H.ServiceRInvCode,\n\t\tDate = H.Date,\n\t\tType = CASE H.ServiceRCatCode WHEN 13 THEN 3 ELSE 4 END,\n\t\tSvcAmt = 0.00,\n\t\tSvcShare = 0.00,\n\t\tSvcRetAmt = ISNULL(SUM(D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01)) + MiscCharges - FlatDisc, 0) + \n\t\t\tRound(Sum((D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc) +\n\t\t\tSum(D.qty * D.serviceflattax) + \n\t\t\tRound((Sum(D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01 * H.serviceinvgstperc, 2), 0),\n\t\tSvcRetShare = ISNULL(SUM(D.Qty * (D.Commission - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01)), 0)\n\tFROM \n\t\tServiceRHeader H, ServiceRDetail D\n\tWHERE \n\t\tH.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\t\tH.ServiceRInvCode = D.ServiceRInvCode \n\tGROUP BY\n\t\tH.ServiceRInvCode,\n\t\tH.Date,\n\t\tH.ServiceRCatCode,\n\t\tH.MiscCharges,\n\t\tH.serviceinvgstperc,\n\t\tH.FlatDisc) T\nGROUP BY\n\tCONVERT(DATETIME, CONVERT(varchar(10), T.Date, 101))\nORDER BY\n\tDate",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
