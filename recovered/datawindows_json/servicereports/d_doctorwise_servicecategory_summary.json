   },
   {
    "type": "number",
    "updatewhereclause": "yes",
    "name": "netvalue",
    "dbname": "netvalue"
   }
  ],
  "retrieve": "SELECT \n\tDoctorName = D.Name,\n\tServiceCategory = SC.Name,\n\tNetQty = SUM(T.Qty),\n\tNetValue = SUM(T.Value)\nFROM\n\t(SELECT \n\t\tH.DoctCode, \n\t\tSD.ServiceCode, \n\t\tS.ServiceCatCode, \n\t\tQty = SUM(SD.Qty), \n\t\tValue = SUM(SD.Qty * (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01))\n\tFROM \n\t\tServiceHeader H, ServiceDetail SD, Service S\n\tWHERE\n\t\tH.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\t\tH.ServiceInvCode = SD.ServiceInvCode AND\n\t\tSD.ServiceCode = S.ServiceCode AND\n\t\tS.ServiceCatCode IN (:ai_servicecatcode)\n\tGROUP BY\n\t\tH.DoctCode, \n\t\tS.ServiceCatCode, \n\t\tSD.ServiceCode\n\tUNION ALL\n\tSELECT \n\t\tH.DoctCode, \n\t\tSD.ServiceCode, \n\t\tS.ServiceCatCode, \n\t\tQty = - SUM(SD.Qty), \n\t\tValue = - SUM(SD.Qty * (SD.ServicePrice - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01))\n\tFROM \n\t\tServiceRHeader H, ServiceRDetail SD, Service S\n\tWHERE\n\t\tH.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\t\tH.ServiceRInvCode = SD.ServiceRInvCode AND\n\t\tSD.ServiceCode = S.ServiceCode AND\n\t\tS.ServiceCatCode IN (:ai_servicecatcode)\n\tGROUP BY\n\t\tH.DoctCode, \n\t\tS.ServiceCatCode, \n\t\tSD.ServiceCode) T, \n\tServiceCategory SC, \n\tDoctors D\nWHERE \n\tT.ServiceCatCode=SC.ServiceCatCode AND\n\tT.DoctCode = D.DoctCode\nGROUP BY\n\tD.Name,\n\tSC.Name\nORDER BY\n\tD.Name,\n\tSC.Name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_servicecatcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "doctorname A"
 },
