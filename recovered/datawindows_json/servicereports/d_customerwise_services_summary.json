   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "servicepurchased",
    "dbname": "ServicePurchased"
   }
  ],
  "retrieve": "SELECT \n\tDate=CONVERT(VARCHAR(100), T.Date, 103),\n\tT.CustomerName,\n\tGrossServices = SUM(T.GrossServices),\n\tDiscountOnSercices = Sum(T.DiscountOnSercices),\n\tTaxOnServices = SUM(T.TaxOnServices),\n\tServiceTotal = SUM(T.ServiceTotal),\n\tServiceReturn = SUM(T.ServiceReturn),\n\tServicePurchased = SUM(T.ServicePurchased)\nFROM\n\t(SELECT \n\t\tH.Date,\n\t\tH.ServiceInvCode,\n\t\tH.CustCode,\n\t\tCustomerName = A.Name,\n\t\tGrossServices = SUM(D.qty * D.price),\n\t\tDiscountOnSercices = Sum(D.qty * D.ServiceFlatDisc) +\n\t\t\tSum(D.qty * (D.price - D.ServiceFlatDisc) * D.discperc * 0.01),\n\t\tTaxOnServices = Round(\n\t\t\tSum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01* D.servicegstPerc) \n\t\t\t+\n\t\t\tSum(D.qty * D.serviceflattax) \n\t\t\t+\n\t\t\tRound((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01 * H.serviceinvgstperc,2), 0),\n\t\tServiceTotal = \n\t\tRound(Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc + H.misccharges, 0)\n\t\t\t+\n\t\tRound(\n\t\t\tSum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01* D.servicegstPerc) \n\t\t\t+\n\t\t\tSum(D.qty * D.serviceflattax) \n\t\t\t+\n\t\t\tRound((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01 * H.serviceinvgstperc,2), 0),\n\t\tServiceReturn = SUM(DBO.fn_GetServiceReturnInvTotal(H.ServiceInvCode)),\n\t\tServicePurchased = ISNULL((SELECT SUM(SP.InvTotal) FROM ServicePurHeader SP WHERE SP.ServiceInvCode = H.ServiceInvCode), 0)\n\tFROM\n\t\tAccounts A,\n\t\tServiceHeader H,\n\t\tServiceDetail D\n\tWHERE\n\t\tH.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tH.CustCode IN (:ai_custcode) AND\n\t\tH.CustCode = A.AccCode AND\n\t\tH.ServiceInvCode = D.ServiceInvCode\n\tGROUP BY\n\t\tH.Date,\n\t\tH.ServiceInvCode,\n\t\tH.CustCode,\n\t\tA.Name,\n\t\tH.flatdisc,\n\t\tH.serviceinvgstperc,\n\t\tH.misccharges,\n\t\tH.discperc) T\nGROUP BY\n\tCONVERT(VARCHAR(100), T.Date, 103),\n\tT.CustomerName\nORDER BY \n\tDate,\n\tCustomerName\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_custcode",
      "numberlist"
     ]
    },
    {
