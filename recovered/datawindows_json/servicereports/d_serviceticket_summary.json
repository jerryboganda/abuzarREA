    "dbname": "Scanned"
   }
  ],
  "retrieve": "SELECT\n\tService = S.Name, \n\tServiceCategory  = SC.Name,\n\tGenerated=Count(T.ServiceTicketCode),\n\tScanned = Sum(CASE WHEN T.TicketUsed='Y' THEN 1 ELSE 0 END)\nFROM \n\tServiceTicket T, ServiceCategory SC, Service S\nWHERE \n\tDATE BETWEEN :adt_startdate AND :adt_enddate AND\n\tS.ServiceCode = T.ServiceCode AND\n\tSC.ServiceCatCode = S.ServiceCatCode\nGROUP BY\n\tSC.Name,\n\tS.Name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
