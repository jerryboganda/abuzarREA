 "table": {
  "columns": [
   {
    "type": "char(100)",
    "updatewhereclause": "yes",
    "name": "serviceinvtype",
    "dbname": "ServiceInvType"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "sales",
    "dbname": "Sales"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "cost",
    "dbname": "Cost"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "gp",
    "dbname": "GP"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "gprate",
    "dbname": "GPRate"
   }
  ],
  "retrieve": "SELECT \n\tServiceInvType=S.ServiceInvType, \n\tSales=SUM(S.Sales), \n\tCost=SUM(S.Cost),\n\tGP = SUM(S.Sales) - SUM(S.Cost),\n\tGPRate = ((SUM(S.Sales) - SUM(S.Cost)) / CASE WHEN SUM(S.Sales) > 0 THEN SUM(S.Sales) ELSE 1 END) * 100\nFROM\n\t(SELECT \n\t\tServiceInvType=ST.Name, Sales=0.00, Cost=0.00\n\tFROM ServiceInvType ST\n\tUNION ALL\n\tSELECT \n\t\tServiceInvType=ST.Name, Sales=SUM(S.InvTotal), Cost=ISNULL((SELECT SUM(P.InvTotal) FROM ServicePurHeader P WHERE P.ServiceInvCode=S.ServiceInvCode), 0)\n\tFROM \n\t\tServiceInvType ST, ServiceHeader S\n\tWHERE\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.ServiceInvTypeCode = ST.ServiceInvTypeCode AND\n\t\tST.ServiceInvTypeCode IN (:ai_ServiceInvTypecode)\n\t\t\n\tGROUP BY \n\t\tST.Name,\n\t\tS.ServiceInvCode) S\nGROUP BY \n\tServiceInvType",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_ServiceInvTypecode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
