  "retrieve": "SELECT \n\ticode=item.icode, \n\taliasname=item.customicode,\n\titemname=item.name,\n\tpackunits=item.packunits,\n\tunitprice=Round(item.saleprice / case item.packunits when 0 then 1 else item.packunits end, 2),\n\tsaleprice=item.saleprice,\n\tPackingdesc=item.packingdesc,\n\tRestricted=item.restricted,\n\tlocation=item.location,\n\ttypedescription=item.typedescription,\n\tmodeldescription=item.modeldescription,\n\tsizedescription=item.sizedescription,\n\tremarksforpurchase=item.remarksforpurchase,\n\tavgprice=item.avgprice,\n\tretailprice=item.retailprice,\n\titemyear=item.itemyear,\n\tmanufacturer=dbo.Manufacturer.name,\n\tItemPart = dbo.itempart.name,\n\tstock = (select\tsum(dbo.godowndetail.currqty)\n\t\t\tfrom\tdbo.godowndetail \n\t\t\twhere\tdbo.godowndetail.icode = item.icode),\n\tsstock = (select\tsum(dbo.godowndetail.currqty)\n\t\tfrom\tdbo.godowndetail \n\t\twhere\tdbo.godowndetail.icode = item.icode and\n\t\t\tdbo.godowndetail.gcode IN \n\t\t\t(SELECT Godown.GCode\n\t\t\tFROM Godown\n\t\t\tWHERE GCode IN\n\t\t\t\t(CASE (SELECT salegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)\n\t\t\t\tWHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = Godown.GCode)\n\t\t\t\tELSE (SELECT DISTINCT GCode From GroupAllowedGodown\n\t\t\t\t\tWHERE\tGroupAllowedGodown.GroupCode = :ai_groupcode AND\n\t\t\t\t\t\tGroupAllowedGodown.Module = 1 AND\n\t\t\t\t\t\tGroupAllowedGodown.GCode = Godown.GCode) END))),\n\tpstock=\t(select\tsum(dbo.godowndetail.currqty)\n\t\tfrom\tdbo.godowndetail \n\t\twhere\tdbo.godowndetail.icode = item.icode and\n\t\t\tdbo.godowndetail.gcode IN \n\t\t\t(SELECT Godown.GCode\n\t\t\tFROM Godown\n\t\t\tWHERE GCode IN\n\t\t\t\t(CASE (SELECT purchasegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)\n\t\t\t\tWHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = Godown.GCode)\n\t\t\t\tELSE (SELECT DISTINCT GCode From GroupAllowedGodown\n\t\t\t\t\tWHERE\tGroupAllowedGodown.GroupCode = :ai_groupcode AND\n\t\t\t\t\t\tGroupAllowedGodown.Module = 3 AND\n\t\t\t\t\t\tGroupAllowedGodown.GCode = Godown.GCode) END))),\n\titem.ipartcode,\n\titem.oldpartcode,\n\titem.manfcode,\n\titem.icatcode,\n\titem.iccode,\n\titem.packcode\nFROM\n\tdbo.Manufacturer,\n\tdbo.itempart,\n\t(SELECT * FROM ITEM\n\tWHERE item.Active = 1 and ((:as_searchon = 'itemname' and name like :as_searchcriteria) OR\n\t\t\t(:as_searchon = 'modeldescription' and modeldescription like :as_searchcriteria) OR\n\t\t\t(:as_searchon = 'sizedescription' and sizedescription like :as_searchcriteria) OR\n\t\t\t(:as_searchon = 'typedescription' and typedescription like :as_searchcriteria) OR\n\t\t\t(:as_searchon = 'manufacturer' and manfcode in (select manfcode from manufacturer where name like :as_searchcriteria)) OR\n\t\t\t(:as_searchon = 'itempart' and ipartcode in (select ipartcode from itempart where name like :as_searchcriteria)) OR\n\t\t\t(:as_searchon = 'oldpartno' and oldpartcode in (select ipartcode from itempart where name like :as_searchcriteria)))) Item\nWHERE\t\n\tdbo.Manufacturer.manfcode = item.manfcode and\n\tdbo.ItemPart.IPartCode = item.ipartcode and\n\t\t(Case (Select Upper(DBO.Fn_GetPreference('GroupCategoryRights')) ) When 'Y' Then item.icatcode Else 0 End in (:ai_catlist))\nORDER BY \n\tItemPart, item.name",
  "arguments": {
