  "retrieve": "SELECT \n\tIncentiveSheet.IncentiveDocCode,   \n\tIncentiveSheet.DrAccCode,\n\tDrAcName = (SELECT AC.Name FROM Accounts AC WHERE AC.AccCode = IncentiveSheet.DrAccCode),\n\tIncentiveSheet.CrAccCode,   \n\tCrAcName = (SELECT AC.Name FROM Accounts AC WHERE AC.AccCode = IncentiveSheet.CrAccCode),\n\tIncentiveSheet.Date,   \n\tIncentiveSheet.UserCode,  \n\tIncentiveAmount = ISNULL((SELECT SUM(D.Qty * D.IncentiveRate) FROM IncentiveSheetDetail D WHERE D.IncentiveDocCode = IncentiveSheet.IncentiveDocCode),0), \n\tIncentiveSheet.Posted,   \n\tIncentiveSheet.PostDate,   \n\tIncentiveSheet.GLVochCode,   \n\tIncentiveSheet.StartDate,   \n\tIncentiveSheet.EndDate,   \n\tIncentiveSheet.Remarks  \nFROM \n\tIncentiveSheet\nORDER BY \n\tIncentiveSheet.IncentiveDocCode\n",
