  "retrieve": "SELECT \n\tDeliveryDate2 = CONVERT(VARCHAR(100), SRD.DeliveryDate, 103) + ' ' + CONVERT(VARCHAR(100), SRD.DeliveryDate, 108),\n\tDeliveryDate = SRD.DeliveryDate,\n\tPatientName=\n\t\t(SELECT P.Name + ' (' + ISNULL(P.RegNo,'') + ') ' + \n\t\t\tCASE WHEN P.AgeYears <= 0 OR P.AgeYears IS NULL THEN '' ELSE STR(ISNULL(P.AgeYears, ''), 5) + ' Years ' END +\n\t\t\tCASE WHEN P.AgeMonths <= 0 OR P.AgeMonths IS NULL THEN '' ELSE STR(ISNULL(P.AgeMonths, ''), 5) + ' Months ' END +\n\t\t\tCASE WHEN P.AgeDays <= 0 OR P.AgeDays IS NULL  THEN '' ELSE STR(ISNULL(P.AgeDays, ''), 5) + ' Days ' END +\n\t\t\tCASE P.Gender WHEN 'M' THEN ' MALE' ELSE ' FEMALE' END\n\t\tFROM Patient P WHERE P.PatientCode IN \n\t\t\t(ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),\n\tRegNo = (SELECT P.RegNo FROM Patient P \n\t\t\t\tWHERE P.PatientCode IN (SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),\n\tServiceName=S.Name,\n\tServiceRowID=SRD.ServiceRowID,\n\tPrintReport='Y',\n\tServiceResultCode = SRH.ServiceResultCode,\n\tServiceInvCode = SRH.ServiceInvCode,\n\tDate = SRH.Date,\n\tUserCode = SRH.UserCode,\n\tPatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)),\n\tAdmissionCode = SH.AdmissionCode,\n\tPosted=SRH.Posted,\n\tPostDate = SRH.PostDate,\n\tPostedBY = SRH.PostedBy\nFROM\n\tServiceResultHeader SRH,\n\tServiceResultDetail SRD,\n\tServiceHeader SH,\n\tServiceDetail SD,\n\tService S\nWHERE\n\tCONVERT(VARCHAR(100), SRD.DeliveryDate, 103) + ' ' + CONVERT(VARCHAR(100), SRD.DeliveryDate, 108) = CASE WHEN :adt_date IS NULL THEN CONVERT(VARCHAR(100), SRD.DeliveryDate, 103) + ' ' + CONVERT(VARCHAR(100), SRD.DeliveryDate, 108) ELSE :adt_date END AND\n\tSRH.ServiceInvCode = SH.ServiceInvCode AND\n\tSRH.ServiceResultCode = SRD.ServiceResultCode AND\n\tSRD.ServiceRowID = SD.SrvRowID AND\n\tSD.ServiceCode = S.ServiceCode AND\n\tSRH.Posted='N' AND\n\tS.ResultRequired='Y'\nGROUP BY\n\tSRD.DeliveryDate,\n\tSRD.ServiceRowID,\n\tSH.PatientCode,\n\tSH.AdmissionCode,\n\tS.Name,\n\tSRH.ServiceInvCode,\n\tSRH.ServiceResultCode,\n\tSRH.Date,\n\tSRH.UserCode,\n\tSRH.Posted,\n\tSRH.PostDate,\n\tSRH.PostedBy\n\t\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_date",
      "string"
     ]
    }
   ]
  },
  "sort": "deliverydate D, serviceinvcode A, servicerowid A, servicename A, patientname A"
 },
