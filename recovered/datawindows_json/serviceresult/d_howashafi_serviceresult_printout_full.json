  "retrieve": "SELECT \n\tServiceResultCode=H.ServiceResultCode,\n\tServiceInvCode = H.ServiceInvCode,\n\tServiceBookingDate = SH.Date,\n\tDeliveryDueOn  = SVD.DeliveryDate,\n\tResultDate=H.Date,\n\tServiceRowID=D.ServiceRowID,\n\tUserName=U.UserName,\n\tDoctorName=(SELECT D.Name FROM Doctors D WHERE D.DoctCode = SH.DoctCode),\n\tPrintOnNewPage = CASE S.PrintOnNewPage WHEN 'N' THEN 0 ELSE 1 END,\n\tSC.PrintRefRange,\n\tSC.RefDescription,\n\tService = S.Name,\n\tPatient=\n\t\t(SELECT P.Name + ' ('  + P.RegNo + ')' \n\t\tFROM Patient P\n\t\tWHERE ISNULL(SH.PatientCode, \n\t\t\t(SELECT PA.PatientCode \n\t\t\tFROM PatientAdmission PA \n\t\t\tWHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), \n\tGender = (SELECT P.Gender\n\t\tFROM Patient P\n\t\tWHERE ISNULL(SH.PatientCode, \n\t\t\t(SELECT PA.PatientCode \n\t\t\tFROM PatientAdmission PA \n\t\t\tWHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), \n\tDOB = (SELECT P.DOB\n\t\tFROM Patient P\n\t\tWHERE ISNULL(SH.PatientCode, \n\t\t\t(SELECT PA.PatientCode \n\t\t\tFROM PatientAdmission PA \n\t\t\tWHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), \n\tAgeYears=\n\t\t(SELECT AY=CAST(DATEDIFF(dd, P.DOB, getdate()) / 360 AS INT)\n\t\tFROM Patient P\n\t\tWHERE ISNULL(SH.PatientCode, \n\t\t\t(SELECT PA.PatientCode \n\t\t\tFROM PatientAdmission PA \n\t\t\tWHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), \n\tAgeMonths=\n\t\t(SELECT AM=CAST(DATEDIFF(dd, P.DOB, getdate()) % 360 / 30 AS INT)\n\t\tFROM Patient P\n\t\tWHERE ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), \n\tAgeDays=\n\t\t(SELECT AD=CAST(DATEDIFF(dd, P.DOB, getdate()) % 360 % 30 AS INT)\n\t\tFROM Patient P\n\t\tWHERE ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), \n\tServiceHead = D.ServiceHead,\n\tServiceComponent = SC.Name,\n\tRowID = D.RowID,\n\tServiceComponentUnitCode = D.ServiceComponentUnitCode,\n\tComponentValue= D.ComponentValue,\n\tLowerReferenceValue = D.LowerReferenceValue,\n\tUpperReferenceValue = D.UpperReferenceValue,\n\tComments = D.Comments,\n\tTestRemarks = D.Remarks,\n\tRemarks = H.Remarks\nFROM\n\tServiceHeader SH,\n\tServiceDetail SVD,\n\tServiceResultHeader H,\n\tServiceResultDetail D,\n\tServiceComponent SC,\n\tService S,\n\tUsers U\nWHERE\n\tH.ServiceResultCode = :ai_code AND \n\tH.ServiceInvCode = SH.ServiceInvCode AND\n\tH.ServiceInvCode = SVD.ServiceInvCode AND\n\tH.ServiceResultCode = D.ServiceResultCode AND\n\tD.ServiceRowID = SVD.SrvRowID AND\n\tSVD.ServiceCode = S.ServiceCode AND\n\tD.ServiceComponentCode = SC.ServiceComponentCode AND\n\tH.UserCode = U.UserCode AND\n\tD.PrintOnReport = 'Y'\nORDER BY\n\tH.ServiceResultCode,\n\tPrintOnNewPage,\n\tD.ServiceRowID,\n\tD.ServiceHead,\n\tD.RowId",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
