  "retrieve": "SELECT \n\tServiceResultDetail.ServiceResultCode,   \n\tServiceResultDetail.ServiceRowID,   \n\tServiceInvCode=\n\t\t(SELECT SH.ServiceInvCode FROM ServiceDetail SD, ServiceHeader SH\n\t\tWHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID AND SD.ServiceInvCode=SH.ServiceInvCode),\n\tServiceCode = (SELECT ServiceCode FROM ServiceDetail SD WHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID),   \n\tPatientName = \n\t\t(SELECT P.Name + ' (' + ISNULL(P.RegNo,'') + ') ' + \n\t\tCASE WHEN P.AgeYears <= 0 OR P.AgeYears IS NULL THEN '' ELSE STR(ISNULL(P.AgeYears, ''), 5) + ' Years ' END +\n\t\tCASE WHEN P.AgeMonths <= 0 OR P.AgeMonths IS NULL THEN '' ELSE STR(ISNULL(P.AgeMonths, ''), 5) + ' Months ' END +\n\t\tCASE WHEN P.AgeDays <= 0 OR P.AgeDays IS NULL  THEN '' ELSE STR(ISNULL(P.AgeDays, ''), 5) + ' Days ' END +\n\t\tCASE P.Gender WHEN 'M' THEN ' MALE' ELSE ' FEMALE' END\n\t\tFROM Patient P WHERE P.PatientCode IN \n\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode)) \n\t\tFROM \n\t\tServiceDetail SD, ServiceHeader SH\n\t\tWHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID AND SD.ServiceInvCode=SH.ServiceInvCode)), \n\tGestationCode = \n\t\t(SELECT P.GestationCode\n\t\tFROM Patient P WHERE P.PatientCode IN \n\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode)) \n\t\tFROM \n\t\tServiceDetail SD, ServiceHeader SH\n\t\tWHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID AND SD.ServiceInvCode=SH.ServiceInvCode)), \n\tGender = \n\t\t(SELECT P.Gender\n\t\tFROM Patient P WHERE P.PatientCode IN \n\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode)) \n\t\tFROM \n\t\tServiceDetail SD, ServiceHeader SH\n\t\tWHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID AND SD.ServiceInvCode=SH.ServiceInvCode)), \n\tAgeYears = \n\t\t(SELECT P.AgeYears\n\t\tFROM Patient P WHERE P.PatientCode IN \n\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode)) \n\t\tFROM \n\t\tServiceDetail SD, ServiceHeader SH\n\t\tWHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID AND SD.ServiceInvCode=SH.ServiceInvCode)), \n\tAgeMonths = \n\t\t(SELECT P.AgeMonths\n\t\tFROM Patient P WHERE P.PatientCode IN \n\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode)) \n\t\tFROM \n\t\tServiceDetail SD, ServiceHeader SH\n\t\tWHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID AND SD.ServiceInvCode=SH.ServiceInvCode)), \n\tAgeDays = \n\t\t(SELECT P.AgeDays\n\t\tFROM Patient P WHERE P.PatientCode IN \n\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode)) \n\t\tFROM \n\t\tServiceDetail SD, ServiceHeader SH\n\t\tWHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID AND SD.ServiceInvCode=SH.ServiceInvCode)), \n\tServiceName = (SELECT S.Name FROM Service S WHERE S.ServiceCode IN (SELECT ServiceCode FROM ServiceDetail SD WHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID)), \n\tServiceResultDetail.RowID,   \n\tServiceResultDetail.ServiceHead,\n\tServiceResultDetail.ServiceComponentCode,   \n\tServiceResultDetail.ServiceComponentUnitCode,   \n\tAskComments = (SELECT MAX(AskComments) FROM ServiceComponentType SCT\n\t\tWHERE SCT.ServiceComponentTypeCode IN \n\t\t\t(SELECT S.ServiceComponentTypeCode \n\t\t\tFROM ServiceComponent S \n\t\t\tWHERE S.ServiceComponentCode = ServiceResultDetail.ServiceComponentCode)),\n\tServiceComponentTypeCode = \n\t\t(SELECT S.ServiceComponentTypeCode \n\t\tFROM ServiceComponent S \n\t\tWHERE S.ServiceComponentCode = ServiceResultDetail.ServiceComponentCode),\n\tValueType = \n\t\t(SELECT U.ValueType \n\t\tFROM ServiceComponentUnit U \n\t\tWHERE U.ServiceComponentUnitCode IN \n\t\t\t(SELECT SC.ServiceComponentUnitCode \n\t\t\tFROM ServiceComponent SC \n\t\t\tWHERE SC.ServiceComponentCode = ServiceResultDetail.ServiceComponentCode)),\n\tServiceResultDetail.DeliveryDate,\n\tServiceResultDetail.CostPrice,   \n\tServiceResultDetail.SalePrice,   \n\tServiceResultDetail.TestMachineCode,\n\tServiceResultDetail.ComponentValue,\n\tServiceResultDetail.ComponentValue2,\n\tServiceResultDetail.LowerReferenceValue, \n\tServiceResultDetail.UpperReferenceValue, \n\tPriority = (SELECT SB.Priority FROM ServiceBreakUp SB WHERE SB.ServiceCode IN (SELECT ServiceCode FROM ServiceDetail SD WHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID) AND SB.ServiceComponentCode = ServiceResultDetail.ServiceComponentCode),\n\tServiceResultDetail.Remarks,\n\tServiceResultDetail.PrintOnReport,\n\tServiceResultDetail.Comments\nFROM \n\tServiceResultDetail\nWHERE \n\tServiceResultDetail.DeliveryDate = :adt_date",
  "update": "ServiceResultDetail",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_date",
      "datetime"
     ]
    }
   ]
  },
  "sort": "deliverydate A, serviceinvcode A, servicerowid A, priority A, servicehead A, rowid A"
 },
