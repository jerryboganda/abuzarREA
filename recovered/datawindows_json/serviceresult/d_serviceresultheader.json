  "retrieve": "SELECT \n\tServiceResultHeader.ServiceResultCode,   \n\tServiceResultHeader.Date,   \n\tServiceInvCode = ServiceResultHeader.ServiceInvCode,\n\tServiceDate = GETDATE(),\n\tPatientRegNo= \n\t\t(SELECT P.RegNo \n\t\tFROM Patient P \n\t\tWHERE P.PatientCode IN \n\t\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),\n\tPatientCode = \n\t\t(SELECT P.PatientCode \n\t\tFROM Patient P \n\t\tWHERE P.PatientCode IN \n\t\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),\n\tFName = \n\t\t(SELECT P.FName\n\t\tFROM Patient P \n\t\tWHERE P.PatientCode IN \n\t\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),\n\tAdmissionCode= (SELECT SH.AdmissionCode FROM ServiceHeader SH WHERE SH.ServiceInvCode = ServiceResultHeader.ServiceInvCode),\n\tDOB= \n\t\t(SELECT P.DOB\n\t\tFROM Patient P \n\t\tWHERE P.PatientCode IN \n\t\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),\n\tGestationCode = \n\t\t(SELECT P.GestationCode\n\t\tFROM Patient P \n\t\tWHERE P.PatientCode IN \n\t\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),\n\tAgeYears = \n\t\t(SELECT DATEDIFF(yy, P.DOB, getdate())\n\t\tFROM Patient P \n\t\tWHERE P.PatientCode IN \n\t\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),\n\tAgeMonths = \n\t\t(SELECT CAST(DATEDIFF(dd, P.DOB, getdate()) % 360 / 30 AS INT)\n\t\tFROM Patient P \n\t\tWHERE P.PatientCode IN \n\t\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),\n\tAgeDays = \n\t\t(SELECT CAST(DATEDIFF(dd, P.DOB, getdate()) % 360 % 30 AS INT)\n\t\tFROM Patient P \n\t\tWHERE P.PatientCode IN \n\t\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),\n\tGender= \n\t\t(SELECT P.Gender \n\t\tFROM Patient P \n\t\tWHERE P.PatientCode IN \n\t\t\t(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),\n\tLocationCode= (SELECT PA.LocationCode FROM PatientAdmission PA WHERE PA.AdmissionCode IN (SELECT SH.AdmissionCode FROM ServiceHeader SH WHERE SH.ServiceInvCode = ServiceResultHeader.ServiceInvCode)),\n\tServiceResultHeader.UserCode,\n\tServiceResultHeader.Remarks,\n\tServiceResultHeader.Posted,\n\tServiceResultHeader.PostDate,\n\tServiceResultHeader.PostedBY,\n\tServiceResultHeader.ServiceResultStampCode\nFROM \n\tServiceResultHeader, ServiceHeader SH\nWHERE \n\tServiceResultHeader.ServiceResultCode = :ai_code AND\n\tServiceResultHeader.ServiceInvCode = SH.ServiceInvCode\n\n",
  "update": "ServiceResultHeader",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
