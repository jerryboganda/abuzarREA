  "retrieve": "SELECT   \n\tpurledger.purinvcode,   \n\tpurledger.purcatcode,\n\tpurledger.purtypecode,\n\tpurledger.printbalance,\n\tpurledger.suppinvdate,\n\tpurledger.grn,\n\taliasname=accounts.aliasname,\n\tpurledger.suppcode,   \n\tpurledger.suppinvcode,\n\tpurledger.pocode,   \n\tpurledger.salesmancode,   \n\tpurledger.date,   \n\tpurledger.discperc,   \n\tpurledger.flatdisc,   \n\tpurledger.misccharges,   \n\tpurledger.salestax,   \n\tpurledger.posted,   \n\tpurledger.postdate,   \n\tpurledger.remarks, \n\tpurledger.invtotal,  \n\tusers.username,   \n\tsupplier.address1,   \n\tsupplier.city,   \n\tsupplier.phone,   \n\tpodate=Getdate(),   \n\tposupplierreference=SPACE(100),   \n\tmanfname='                                        '  ,   \n\tmanfcode=0,\n\tpurledger.originaldate,\n\tpurledger.modifiedby,\n\tpurledger.postedby,\n\tpurledger.porb,\n\tpurledger.headerno,\n\tgcode=0,\n\tsuppbalance=0.00,\n\tcreditordebit=' ',\n\tdbo.purledger.purinvpagesize,\n\tpurledger.invgstperc1,\n\tdbo.purledger.headerinvno,\n\tdbo.purledger.AccountFor,\n\tdbo.purledger.PaymentMode,\n\tdbo.purledger.PaymentAccCode,\n\tdbo.purledger.Amt,\n\tdbo.purledger.AmtBy,\n\tdbo.purledger.AmtDate,\n\tdbo.purledger.AmtReference,\n\tdbo.purledger.Outstandingamt,\n\tdbo.purledger.marked,\n\tdbo.purledger.currencycode,\n\tdbo.purledger.conversionfactor,\n\tdbo.purledger.AssociatedSaleOrderCode,\n\tdbo.purledger.AssociatedSaleInvCode,\n\tdbo.purledger.GCCode,\n\tdbo.purledger.Vehicle,\n\tdbo.purledger.ShipTo,\n\tdbo.purledger.NewPurchaseOrderNo,\n\tdbo.purledger.LCNo,\n\tdbo.purledger.UpdateAvgPriceWithNetRate\nFROM \n\tpurledger,   \n\tusers,   \n\tsupplier,\n\taccounts  \nWHERE\n\t( purledger.suppcode = supplier.suppcode ) and  \n\t( purledger.suppcode = accounts.acccode )  and\n\t( purledger.salesmancode = users.usercode) and  \n\t( ( dbo.purledger.purinvcode = :r_InvCode ) )    \n",
  "update": "purledger",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "r_InvCode",
      "number"
     ]
    }
   ]
  }
