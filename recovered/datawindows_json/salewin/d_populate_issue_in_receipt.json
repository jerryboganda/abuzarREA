  "retrieve": "SELECT\n\tissuedetail.issueinvcode,   \n\tissuedetail.icode,   \n\titemname = (SELECT Item.Name FROM Item WHERE Item.ICode=issuedetail.ICode),\n\tissuedetail.batch, \n\tissuedetail.expiry,   \n\tissuedetail.gcode,\n\tissuedetail.qty,\n\tissuerowid=issuedetail.issrowid,\t\n\tprice = issuedetail.price,\n\titemdescription=issuedetail.itemdescription,\n\tpackunits = issuedetail.packunits,\n\treceiptqty = \n\t\tISNULL(\n\t\t\t(SELECT SUM(SD.Qty) \n\t\t\tFROM ReceiptDetail SD \n\t\t\tWHERE SD.IssueRowID = IssueDetail.IssRowId), 0)\nFROM\n\tIssueDetail\nWHERE\n\t( dbo.issuedetail.issueinvcode = :ar_IssueInvCode )\nORDER BY IssueDetail.IssRowId",
