  "retrieve": "SELECT\n\tCode=SaleInvGroup.SaleInvGroupCode,\n\tDate = SaleInvGroup.Date,\n\tUsername = (select u.username from users u where u.usercode = SaleInvGroup.UserCode),\n\tRemarks = SaleInvGroup.Remarks,\n\tSaleInvCode=SaleInvGroupDetail.SaleInvCode,\n\tSaleDate=SaleLedger.Date,\n\tRowId=SaleInvGroupDetail.RowId,\n\tCustCode=SaleLedger.CustCode,\n\tAliasName= Accounts.AliasName,\n\tCustomerName= Accounts.Name,\n\tInvTotal = SaleLedger.InvTotal,\n\tCustRefNo=SaleLedger.CustRefNo,\n\tCustRefNo2=SaleLedger.CustRefNo2,\n\tCustRefNo3=SaleLedger.CustRefNo3,\n\tCustRefNo4=SaleLedger.CustRefNo4,\n\tCustRefNo5=SaleLedger.CustRefNo5,\n\tSaleRemarks=SaleLedger.Remarks\nFROM\n\tSaleInvGroup, SaleInvGroupDetail, SaleLedger, Accounts\nWHERE\n\tSaleInvGroup.SaleInvGroupCode = :ai_code AND\n\tSaleInvGroup.SaleInvGroupCode = SaleInvGroupDetail.SaleInvGroupCode AND\n\tSaleInvGroupDetail.SaleInvCode = SaleLedger.SaleInvCode AND\n\tSaleLedger.CustCode = Accounts.AccCode\nORDER BY\n\tSaleInvGroupDetail.RowID",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
