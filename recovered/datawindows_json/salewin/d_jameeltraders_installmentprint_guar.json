  "retrieve": "SELECT \n\tCustCode=(SELECT IH.CustCode FROM InstallmentHeader IH WHERE InstallmentCode = :ai_code),   \n\tGuaranteePersonCode=InstallmentGuarantor.GuaranteePersonCode,   \n\tGuaranteePerson=GuaranteePerson.Name,   \n\tFHName=GuaranteePerson.FHName,   \n\tResAddress=GuaranteePerson.Address,   \n\tOffAddress=GuaranteePerson.OffAddress,   \n\tMobile=GuaranteePerson.Mobile,\n\tPhone = GuaranteePerson.Phone,\n\tCast = GuaranteePerson.Education,\n\tNIC = GuaranteePerson.NIC,\n\tOccupation = GuaranteePerson.Occupation \nFROM \n\tInstallmentGuarantor,   \n\tGuaranteePerson  \nWHERE \n\tGuaranteePerson.GuaranteePersonCode = InstallmentGuarantor.GuaranteePersonCode and  \n\tInstallmentGuarantor.InstallmentCode = :ai_code\n",
