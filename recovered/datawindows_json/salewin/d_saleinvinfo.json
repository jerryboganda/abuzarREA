  "retrieve": "  SELECT saledetail.saleinvcode, \n         saledetail.gcode,   \n         saledetail.icode,   \n         saledetail.batch,   \n         saledetail.expiry,   \n         Id = saledetail.IDENTITYCOL,   \n         looseqty = saledetail.looseqty,\n\t\t\tpackqty  = saledetail.packqty,\n         bonusqty = saledetail.bonusqty,\n\t\t\tpackunits= saledetail.packunits,\n\t \t\tsaleprice= saledetail.saleprice,\n         discperc = saledetail.discperc,  \n         rate     = saledetail.rate,  \n         avgprice = saledetail.avgprice,  \n         salestax = saledetail.salestax, \n\t\t\t\n\t\t\tDue      = saledetail.Due,\n\t\t\titemflatdisc = saledetail.itemflatdisc,\n\t\t\tSatisfiedDate = saledetail.SatisfiedDate,\n\t\t\tstock = 0.0000, \n\t\t\ttotalstock = 0.0000,\n\t\t\tSaleItemDescription =  saledetail.SaleItemDescription,\n\t\t\trowgroup=saledetail.rowgroup\n\n    FROM saledetail\n\n   WHERE ( dbo.saledetail.saleinvcode = :ar_SaleInvCode )\n\nORDER BY saledetail.IDENTITYCOL\n\n\n\n",
  "update": "saledetail",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
