  "retrieve": "SELECT \n\tSaleInvCode=SaleInvCode, \n\tDate,\n\tInvTotal, \n\tIcode,\n\tAliasName,\n\tItemName,\n\tGodown,\t\n\tLooseQty,\n\tBonusQty,\n\tGcode,\n\tBatch,\n\tExpiry,\n\tPackUnits,\n\tSalePrice,\n\tDiscPerc,\n\tItemFlatDisc,\n\tUnitSalesTax,\n\tGstPerc,\n\tAvgPrice,\n\tRate,\n\tSaleRowID,\n\tSaleItemDescription,\n\tPackPrice,\n\tPackQtyForSale,\n\tBonusPackQtyForSale,\n\tSourceSaleInvcode,\n\tINVSELECTED='N',\n\tSELECTED='N',\n\tStatus\nFROM\n\t(SELECT \n\t\tSL.SaleInvCode, \n\t\tSL.Date, \n\t\tSL.InvTotal, \n\t\tI.Icode,\n\t\tAliasName = I.CustomICode,\n\t\tItemName = I.Name,\n\t\tGodown = G.Name,\t\n\t\tSD.LooseQty,\n\t\tSD.BonusQty,\n\t\tSD.Gcode,\n\t\tSD.Batch,\n\t\tSD.Expiry,\n\t\tSD.PackUnits,\n\t\tSD.SalePrice,\n\t\tSD.DiscPerc,\n\t\tSD.ItemFlatDisc,\n\t\tSD.UnitSalesTax,\n\t\tSD.GstPerc,\n\t\tSD.AvgPrice,\n\t\tSD.Rate,\n\t\tSaleRowID=SD.RowID,\n\t\tSD.SaleItemDescription,\n\t\tSD.PackPrice,\n\t\tSD.PackQtyForSale,\n\t\tSD.BonusPackQtyForSale,\n\t\tSourceSaleInvcode=SL.SaleInvCode,\n\t\tINVSELECTED='N',\n\t\tSELECTED='N',\n\t\tStatus=CASE (SELECT Count(d.salerowid) FROM saleinvdetail d WHERE d.salerowid = SD.RowID) \n\t\t\t\t\tWHEN NULL THEN 'N' \n\t\t\t\t\tWHEN 0 THEN 'N' \n\t\t\t\t\tELSE 'Y' END\n\tFROM\n\t\tSaleLedger SL, SaleDetail SD, Item I, Godown G\n\tWHERE \n\t\tSL.SaleInvCode IN (:ai_invcode) AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSL.ImpactInventory = 'Y' AND\n\t\tSD.ICode = I.ICode AND\n\t\tSD.GCode = G.GCode\n\tUNION ALL\n\tSELECT \n\t\tSL.SaleInvCode, \n\t\tSL.Date, \n\t\tSL.InvTotal, \n\t\tI.Icode,\n\t\tAliasName = I.CustomICode,\n\t\tItemName = I.Name,\n\t\tGodown = G.Name,\t\n\t\tSD.LooseQty,\n\t\tSD.BonusQty,\n\t\tSD.Gcode,\n\t\tSD.Batch,\n\t\tSD.Expiry,\n\t\tSD.PackUnits,\n\t\tSD.SalePrice,\n\t\tSD.DiscPerc,\n\t\tSD.ItemFlatDisc,\n\t\tSD.UnitSalesTax,\n\t\tSD.GstPerc,\n\t\tSD.AvgPrice,\n\t\tSD.Rate,\n\t\tSaleRowID=SD.RowID,\n\t\tSD.SaleItemDescription,\n\t\tSD.PackPrice,\n\t\tSD.PackQtyForSale,\n\t\tSD.BonusPackQtyForSale,\n\t\tSourceSaleInvcode=SL.SaleInvCode,\n\t\tINVSELECTED='N',\n\t\tSELECTED='N',\n\t\tStatus=CASE (SELECT Count(d.salerowid) FROM saleinvdetail d WHERE d.salerowid = SD.RowID) \n\t\t\t\t\tWHEN NULL THEN 'N' \n\t\t\t\t\tWHEN 0 THEN 'N' \n\t\t\t\t\tELSE 'Y' END\n\tFROM\n\t\tSaleLedger SL, SaleInvDetail SD, Item I, Godown G\n\tWHERE \n\t\tSL.SaleInvCode IN (:ai_invcode) AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSL.ImpactInventory = 'N' AND\n\t\tSD.ICode = I.ICode AND\n\t\tSD.GCode = G.GCode) T\nORDER BY\n\t:ai_ordercol",
