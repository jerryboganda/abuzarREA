  "retrieve": "SELECT \n\tSaleLedger.SaleInvCode,\n\tSaleLedger.HeaderNo,\n\tSaleLedger.HeaderInvNo,\n\tSaleLedger.Date,\n\tSaleLedger.CustCode,\n\tAccounts.Name,\n\tAccounts.AliasName,\n\tSaleLedger.OutstandingAmt,\n\tSaleLedger.InvTotal,\n\tSaleLedger.Posted,\n\tOldMarked=SaleLedger.Marked,\n\tSaleLedger.AccountFor,\n\tSaleLedger.Marked\nFROM \n\tSaleLedger, Accounts\nWHERE\n\tSaleLedger.AccountFor = 'Y' AND\n\tSaleLedger.Posted ='Y' AND\n\tSaleLedger.SaleCatCode IN (2) AND\n\tSaleLedger.CustCode = Accounts.AccCode",
