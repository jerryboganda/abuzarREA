  ],
  "retrieve": "SELECT\n\tA.Name,\n\tSA.Name,\n\tAC.AliasName,\n\tinvcode=S.Saleinvcode, balance=S.outstandingamt\nFROM\n\tSaleLedger S, Customer C, Area A, SubArea SA, Accounts AC\nWHERE\n\tS.salecatcode in (2) AND \n\tS.posted='Y' and S.accountfor='Y' AND S.marked='N' AND S.OutStandingAmt > 0 AND\n\tS.CustCode = C.CustCode AND\n\tC.CustCode = AC.AccCode AND\n\tC.AreaCode = A.AreaCode AND\n\tC.SubAreaCode = SA.SubAreaCode AND\n\tSA.AreaCode = A.AreaCode AND\n\tSA.SubAreaCode IN (:ai_subareacode)\nORDER BY\n\tA.Name,\n\tSA.Name,\n\tAC.AliasName,\n\tS.Saleinvcode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_subareacode",
      "numberlist"
     ]
    }
   ]
  }
 },
