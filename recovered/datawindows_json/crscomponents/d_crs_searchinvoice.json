  "retrieve": "SELECT \n\tSELECTED='N',\n\tType=S.Type,\n\tCRS_ClientName=CL.Name + '(' + CI.Name + ')',\n\tDate=S.Date,\n\tInvCode=S.InvCode,\n\tClientInstanceID=S.ClientInstanceID,\n\tCustRefNo=S.CustRefNo,\n\tCustRefNo2=S.CustRefNo2,\n\tCustRefNo3=S.CustRefNo3,\n\tCustRefNo4=S.CustRefNo4,\n\tCustRefNo5=S.CustRefNo5,\n\tRemarks=S.Remarks,\n\tInvTotal=S.InvTotal\nFROM \n\tCRS_ClientInstance CI, \n\tCRS_ClientList CL,\n\t(SELECT \n\t\tType= 'S',\n\t\tS.ClientInstanceID,\n\t\tS.Date,\n\t\tInvCode=S.SaleInvCode,\n\t\tS.CustRefNo,\n\t\tS.CustRefNo2,\n\t\tS.CustRefNo3,\n\t\tS.CustRefNo4,\n\t\tS.CustRefNo5,\n\t\tS.Remarks,\n\t\tS.InvTotal\n\tFROM CRS_SaleLedger S\n\tWHERE S.CustRefNo LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo2 LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo3 LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo4 LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo5 LIKE ('%' + :as_searchtext + '%') OR S.Remarks LIKE ('%' + :as_searchtext + '%')\n\tUNION ALL\n\tSELECT \n\t\tType= 'R',\n\t\tS.ClientInstanceID,\n\t\tS.Date,\n\t\tInvCode=S.SRInvCode,\n\t\tS.CustRefNo,\n\t\tS.CustRefNo2,\n\t\tS.CustRefNo3,\n\t\tS.CustRefNo4,\n\t\tCustRefNo5='',\n\t\tS.Remarks,\n\t\tS.InvTotal\n\tFROM CRS_SRLedger S\n\tWHERE S.CustRefNo LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo2 LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo3 LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo4 LIKE ('%' + :as_searchtext + '%') OR S.Remarks LIKE ('%' + :as_searchtext + '%') ) AS S\nWHERE \n\tCL.ClientID = CI.ClientID AND\n\tCI.ClientInstanceID = S.ClientInstanceID\nORDER BY\n\t\tDate\t\t",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_searchtext",
      "string"
     ]
    }
   ]
  }
