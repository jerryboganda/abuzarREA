   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "id",
    "dbname": "ID"
   }
  ],
  "retrieve": "SELECT \n\tItemName = I.Name,\n\tQty = SUM(D.LooseQty),\n\tBonusQty= SUM(D.BonusQty),\n\tSalePrice = D.SalePrice,\n\tItemFlatDisc=D.ItemFlatDisc,\n\tDiscPerc = D.DiscPerc,\n\tAmount = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.Discperc * 0.01)),\n\tID = MAX(D.SaleRowID)\nFROM CRS_SaleDetail D, Item I\nWHERE \n\t:as_type = 'S' AND\n\tD.ClientInstanceID = :ai_clientinstance AND\n\tD.SaleInvCode = :ai_invcode AND\n\tD.ICode=I.ICode\nGROUP BY\n\tI.Name,\n\tD.SalePrice,\n\tD.ItemFlatDisc,\n\tD.DiscPerc\nUNION ALL\nSELECT \n\tItemName = I.Name,\n\tQty = SUM(D.LooseQty),\n\tBonusQty= SUM(D.BonusQty),\n\tSalePrice = D.SRPrice,\n\tItemFlatDisc=0.00,\n\tDiscPerc = D.DiscPerc,\n\tAmount = SUM(D.LooseQty * D.SRPrice * (1 - D.Discperc * 0.01)),\n\tID = MAX(D.RowID)\nFROM CRS_SRDetail D, Item I\nWHERE \n\t:as_type = 'R' AND\n\tD.ClientInstanceID = :ai_clientinstance AND\n\tD.SRInvCode = :ai_invcode AND\n\tD.ICode=I.ICode\nGROUP BY\n\tI.Name,\n\tD.SRPrice,\n\tD.DiscPerc\nORDER BY \n\tID",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_clientinstance",
      "number"
     ]
    },
    {
     "_items": [
      "as_type",
      "string"
     ]
    },
    {
     "_items": [
      "ai_invcode",
      "number"
     ]
    }
   ]
  }
 },
