  "retrieve": "SELECT \n\titem.customicode, \n\titemname= item.name, \n\tlocksaleprice = dbo.item.locksaleprice,\n\tlockdiscperc = dbo.item.lockdiscperc,\n\tcurrlistrow = 0,\n\tstock     = 0.0000, \n\tqtysale=item.saleqty,\n\tbonus=item.bonusqty,\n\ttotalstock= 0.0000, \n\tpurprice=0.00,\n\trecentpurprice=0.00,\n\tavgprice=0.000,\n\titemtotalval=space(30),\n\tassgcode  = 1, \n\tupdatesaleprice = 'N',\n\tcode=d.srinvcode,   \n\td.icode,   \n\td.gcode,\n\tId        = max(d.rowid), \n\tpackunits = max(d.packunits),\n\tsaleprice = max(d.srprice),\n\tsalestax  = max(d.salestax), \n\tDueQty    = 0.0000,\n\tpackqty   = sum(d.packqty),\n\tSaleItemDescription =  max( d.ReturnItemDescription),\n\tdiscperc  = max(d.discperc),\n\titemcode = 0,\n\tunitsalestax=max(d.unitsalestax),\n\tgstperc=max(d.gstperc),\n\tbonusqty=sum (d.bonusqty),\n\tlooseqty  = sum(d.looseqty) \nFROM \n\tcrs_srdetail d, item \nWHERE \n\t( d.clientinstanceid = :ai_clientinstanceid) AND\n\t( d.srinvcode = :ar_SrInvCode ) AND \n\t( d.icode = item.icode )\nGROUP BY \n\td.srinvcode, \n\td.icode, \n\td.gcode, \n\titem.customicode, \n\titem.saleqty, \n\titem.bonusqty, \n\titem.name,\n\titem.locksaleprice,\n\titem.lockdiscperc\nORDER BY \n\tMIN(d.rowid)",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_clientinstanceid",
      "number"
     ]
    },
    {
     "_items": [
      "ar_SRInvCode",
      "number"
     ]
    }
   ]
  },
  "sort": "id A"
 },
