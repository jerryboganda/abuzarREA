  "retrieve": "SELECT \n\titemname= item.name, \n\theaderno=max(issueheader.headerno),\n\trecipient = Case RecipientCode When 1 Then (Select Name From Department Where DeptCode=issueheader.deptcode) When 2 Then (Select Name From Accounts Where AccCode =max( issueheader.AccCode)) When 3 Then (Select Name From Accounts Where AccCode =Max( issueheader.AccCode)) When 4 Then (Select Name From SalesMan Where SalesManCode =max(issueheader.RecipientSalesMan) ) End,\n\tsalesman = max(dbo.users.username), \n\tissueinvcode = dbo.issueheader.issueinvcode, \n\tsmanname=(SELECT salesman.name FROM SalesMan WHERE SalesMan.SalesManCode =max( IssueHeader.SMANCode)),\n\titemlaias=max(item.customicode), \n\tprice =max( issuedetail.price),\n\tdate = dbo.issueheader.date,   \n\tdbo.issueheader.deptcode, \n\tdbo.issueheader.remarks,\t\n\t\n\ticode = issuedetail.icode,   \n\tbatch =max( issuedetail.batch),   \n\texpiry = min(issuedetail.expiry),   \n\tlooseqty = sum(issuedetail.qty),\n\treferenceno=ISNULL((select name from issuetype where issuetypecode = issueheader.issuetypecode), '') + CASE issueheader.issuetypecode WHEN NULL THEN '' ELSE '-' END + dbo.issueheader.referenceno,\n\t\n\t\n\t\n\tId       = max(dbo.issuedetail.IDENTITYCOL )\n\t\nFROM \n\tissueheader, \n\tissuedetail, \n\tusers, \n\titem \n\tLEFT OUTER JOIN itempacking ON (dbo.item.packcode = dbo.itempacking.packcode)\n\tLEFT OUTER JOIN Godown ON (dbo.item.gcode = dbo.Godown.gcode)\t\nWHERE \n\t( dbo.issueheader.issueinvcode = :ar_issueInvCode ) AND\n\t( dbo.issueheader.issueinvcode = dbo.issuedetail.issueinvcode) AND\n\t( dbo.issueheader.salesmancode = dbo.users.usercode ) AND \n\t( dbo.issuedetail.icode = dbo.item.icode)\ngroup by\n\tissueheader.issueinvcode,\n\tissueheader.date,\n\tissueheader.issuetypecode,\n\tissueheader.referenceno,\n\tissueheader.remarks,\n\tissueheader.deptcode,\n\tissueheader.RecipientCode,\n\tissuedetail.icode,\n\titem.name\n\t\nORDER BY \n\tmax(dbo.issuedetail.IDENTITYCOL)",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_IssueInvCode",
      "number"
     ]
    }
   ]
  }
 },
