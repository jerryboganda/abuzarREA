  "retrieve": "  SELECT issuedetail.issueinvcode,   \n         issuedetail.gcode,   \n         issuedetail.icode,   \n         issuedetail.batch, \n         issuedetail.expiry,   \n         Id = issuedetail.IDENTITYCOL,   \n         qty = issuedetail.qty,\n\t\t\t\n\t\t\tpackunits= issuedetail.packunits,\n\t \t\tsaleprice= issuedetail.saleprice,\n          \n          \n         avgprice = issuedetail.avgprice,  \n         mrpp = issuedetail.mrpp, \n\t\t\t\n\t\t\t\n\t\t\tstock = 0, \n\t\t\ttotalstock = 0 \n\t\t\t\n\n    FROM issuedetail\n\n   WHERE ( dbo.issuedetail.issueinvcode = :ar_IssueInvCode )\n\nORDER BY issuedetail.IDENTITYCOL\n\n\n\n",
  "update": "issuedetail",
  "updatewhere": "0",
  "updatekeyinplace": "yes",
  "arguments": {
