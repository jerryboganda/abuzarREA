    "name": "itemcategory",
    "dbname": "itemcategory"
   }
  ],
  "retrieve": "SELECT\n\tIssueinvcode=sl.Issueinvcode,\n\tSD.ICode, \n\tAliasName = I.CustomICode,\n\tItem = I.Name,\n\tGodown = G.Name,\n\tItemClass = ICL.Name,\n\tSUM(SD.Qty) AS Qty, \n\t0.0000 AS Bonus,\n\tManufacturer = M.Name,\n\tVolume = SUM( SD.Qty * I.PackingFactor),\n\tWeight = SUM( SD.Qty * I.UnitWeight),\n\tSaleComments1 = MAX(SL.Terms1),\n\tSaleComments2 = MAX(SL.Terms2),\n\titemcategory=(select name from itemcategory where max(I.icatcode)=itemcategory.icatcode)\nFROM\n\tIssueDetail SD,\n\tIssueHeader SL,\n\tItemClass ICL,\n\tManufacturer M,\n\tItem\tI,\n\tGodown G\nWHERE \n\tSL.IssueInvCode = :ai_invCode AND\n\tSL.IssueInvCode = SD.IssueInvcode AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = M.ManfCode AND\n\tI.ICCode = ICL.ICCode AND\n\tSD.GCode = G.GCode AND\t\n\tSD.GCode IN \n\t\t(SELECT GCode\n\t\tFROM GroupAllowedGodown\n\t\tWHERE Module = 5 AND GroupCode=:ai_groupcode)\nGROUP BY\n\tSL.IssueInvCode,\n\tSD.ICode, \n\tSD.GCode,\n\tM.Name,\n\tICL.Name,\n\tI.Name,\n\tI.CustomICode,\n\tG.Name\nORDER BY\n\tG.Name,\n\titemcategory,\n\tICL.Name,\n\tI.Name,\n\tI.CustomICode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_invcode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "number"
     ]
    }
   ]
  }
 },
