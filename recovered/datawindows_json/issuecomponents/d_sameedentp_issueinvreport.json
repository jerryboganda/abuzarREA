  "retrieve": "SELECT \n\titemname= item.name, \n\theaderno=issueheader.headerno,\n\trecipient = Case RecipientCode When 1 Then (Select Name From Department Where DeptCode=issueheader.deptcode) When 2 Then (Select Name From Accounts Where AccCode = issueheader.AccCode) When 3 Then (Select Name From Accounts Where AccCode = issueheader.AccCode) When 4 Then (Select Name From SalesMan Where SalesMan.SalesManCode = issueheader.RecipientSalesMan ) End,\n\treceiptaddress1=(select address1 from customer where customer.custcode= issueheader.AccCode),\n\treceiptaddress2=(select address2 from customer where customer.custcode= issueheader.AccCode),\n\treceiptcity=(select city from customer where customer.custcode= issueheader.AccCode),\n\tsalesman = dbo.users.username, \n\tmanf=(select name from manufacturer where manufacturer.manfcode=item.manfcode),\n\tmfgdate=(select min(manfdate) from purdetail where purdetail.batch=issuedetail.batch),\n\tissueinvcode = dbo.issueheader.issueinvcode, \n\tsmanname=(SELECT salesman.name FROM SalesMan WHERE SalesMan.SalesManCode = IssueHeader.SManCode),\n\tprice = Case ( Select a=DBO.Fn_Get_Int_Preference('IssuePriceInPrint')) When 1 THEN issuedetail.saleprice When 2 THEN issuedetail.purchaseprice WHEN 3 THEN issuedetail.avgprice WHEN 4 THEN issuedetail.MRPP END,\n\tdate = dbo.issueheader.date,   \n\tdbo.issueheader.deptcode, \n\tdbo.issueheader.remarks,\t\n\tgcode = issuedetail.gcode,   \n\ticode = issuedetail.icode,   \n\tbatch = issuedetail.batch,   \n\texpiry = issuedetail.expiry,   \n\tlooseqty = issuedetail.qty,\n\treferenceno=ISNULL((select name from issuetype where issuetypecode = issueheader.issuetypecode), '') + CASE issueheader.issuetypecode WHEN NULL THEN '' ELSE '-' END + dbo.issueheader.referenceno,\n\tdbo.issueheader.referencedate,\n\tGodown = (SELECT Godown.name FROM Godown WHERE Godown.GCode=IssueDetail.GCode),\n\titempacking = (SELECT itempacking.name FROM itempacking WHERE itempacking.PackCode=Item.PackCode),\n\tId       = dbo.issuedetail.IDENTITYCOL \nFROM \n\tissueheader, \n\tissuedetail, \n\tusers, \n\titem\nWHERE \n\t( dbo.issueheader.issueinvcode = :ar_issueInvCode ) AND\n\t( dbo.issueheader.issueinvcode = dbo.issuedetail.issueinvcode) AND\n\t( dbo.issueheader.salesmancode = dbo.users.usercode ) AND \n\t( dbo.issuedetail.icode = dbo.item.icode)\n\t\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_IssueInvCode",
      "number"
     ]
    }
   ]
  },
  "sort": "itemname A"
 },
