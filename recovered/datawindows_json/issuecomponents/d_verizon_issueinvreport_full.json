  "retrieve": "SELECT \n\titemname= item.name, \n\trecipient = Case RecipientCode When 1 Then (Select Name From Department Where DeptCode=issueheader.deptcode) When 2 Then (Select Name From Accounts Where AccCode = issueheader.AccCode) When 3 Then (Select Name From Accounts Where AccCode = issueheader.AccCode) When 4 Then (Select Name From SalesMan Where SalesManCode = issueheader.RecipientSalesMan ) End,\n\tsalesman = dbo.users.username, \n\tissueinvcode = dbo.issueheader.issueinvcode, \n\tsmanname=salesman.name,\n\titemlaias=item.customicode, \n\tmanf=(select name from manufacturer where manufacturer.manfcode=item.manfcode),\n\tprice = issuedetail.price,\n\tdate = dbo.issueheader.date,   \n\tdbo.issueheader.deptcode, \n\tdbo.issueheader.remarks,\t\n\tgcode = issuedetail.gcode,   \n\ticode = issuedetail.icode,   \n\tbatch = issuedetail.batch,   \n\texpiry = issuedetail.expiry,   \n\tlooseqty = issuedetail.qty,\n\treferenceno=ISNULL((select name from issuetype where issuetypecode = issueheader.issuetypecode), '') + CASE issueheader.issuetypecode WHEN NULL THEN '' ELSE '-' END + dbo.issueheader.referenceno,\n\tdbo.issueheader.referencedate,\n\tGodown = Godown.name,\n\titempacking = itempacking.name,\n\tId       = dbo.issuedetail.IDENTITYCOL \n\t\nFROM \n\tissueheader, \n\tissuedetail, \n\tusers, \n\titem \n\tLEFT OUTER JOIN itempacking ON (dbo.item.packcode = dbo.itempacking.packcode)\n\tLEFT OUTER JOIN Godown ON (dbo.item.gcode = dbo.Godown.gcode),\n\tsalesman\n\t\nWHERE \n\t( dbo.issueheader.issueinvcode = :ar_issueInvCode ) AND\n\t( dbo.issueheader.issueinvcode = dbo.issuedetail.issueinvcode) AND\n\t( dbo.issueheader.Smancode = dbo.SalesMan.Salesmancode ) AND \n\t( dbo.issueheader.salesmancode = dbo.users.usercode ) AND \n\t( dbo.issuedetail.icode = dbo.item.icode)\n\t\nORDER BY \n\tdbo.issuedetail.IDENTITYCOL",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_IssueInvCode",
      "number"
     ]
    }
   ]
  }
 },
