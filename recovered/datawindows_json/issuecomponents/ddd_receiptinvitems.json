  "retrieve": " SELECT \n\tcustomicode,\n\talternatecustomicode,\n\tname, \n\tcompute_0002, \n\ticode, \n\tgcode, \n\tbatch, \n\texpiry,\n\tsaleprice, \n\tdiscperc=0.00,\n\tReceiptQty=SUM(qty),\n\tBonusQty=0.0000,\t \n\tpackunits, \n\tIssuedQty, \n\tTotalPieces = SUM(TotalPieces),\n\tIssuedTotalPieces = SUM(IssuedTotalPieces),\n\tReceiptRowID=RowID,\n\tavgprice,\n\titemdesc=max(itemdesc)\nFROM \n\t(SELECT \n\t\tdbo.item.name, \n\t\tdbo.item.name + space(70) + str(receiptdetail.RowID) as compute_0002, \n\t\tdbo.item.icode,\n\t\tdbo.item.customicode,\n\t\tdbo.receiptdetail.alternatecustomicode,\n\t\tdbo.receiptdetail.gcode,\n\t\tdbo.receiptdetail.batch,\n\t\tdbo.receiptdetail.expiry,\n\t\tsaleprice=dbo.receiptdetail.price,\n\t\tdbo.receiptdetail.qty,\n\t\tdbo.receiptdetail.packunits,\n\t\tdbo.receiptdetail.TotalPieces,\n\t\tdbo.receiptdetail.PiecesInHand,\n\t\tIssuedTotalPieces = (SELECT IsNull(Sum(issuedetail.TotalPieces), 0.0000)\n\t\t\t\tFROM   \tissueheader, issuedetail\n\t\t\t\tWHERE  \tissueheader.receiptinvcode = receiptdetail.ReceiptInvCode    and\n\t\t\t\t\tissueheader.posted      = 'Y'                and\n\t\t\t\t\tissueheader.issueinvcode   = issuedetail.IssueInvCode and\n\t\t\t\t\tissuedetail.ReceiptRowID = dbo.receiptdetail.RowID),\n\t\tIssuedQty = (SELECT IsNull(Sum(issuedetail.Qty), 0.0000)\n\t\t\t\tFROM   \tissueheader, issuedetail\n\t\t\t\tWHERE  \tissueheader.receiptinvcode = receiptdetail.ReceiptInvCode and\n\t\t\t\t\tissueheader.posted      = 'Y'  and\n\t\t\t\t\tissueheader.issueinvcode   = issuedetail.IssueInvCode and\n\t\t\t\t\tissuedetail.ReceiptRowID = dbo.receiptdetail.RowID),\n\t\t receiptdetail.RowID,\n\t\t itemdesc=dbo.receiptdetail.itemdescription,\n\t\t AvgPrice=receiptdetail.AvgPrice\n\tFROM \n\t\tdbo.item, dbo.receiptdetail\n\tWHERE \n\t\t( receiptdetail.receiptinvcode = :ar_receiptInvCode ) and\n\t\t( item.icode = receiptdetail.icode )) AS TMP\nGROUP BY \n\ticode, \n\tname, \n\tcompute_0002, \n\tcustomicode, \n\talternatecustomicode,\n\tgcode, \n\tbatch, \n\texpiry, \n\tsaleprice, \n\tpackunits, \n\tIssuedQty,\n\tavgprice,\n\tRowID\nORDER BY \n\tname, \n\tbatch,\n\texpiry",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_receiptInvCode",
      "number"
     ]
    }
   ]
  }
 },
