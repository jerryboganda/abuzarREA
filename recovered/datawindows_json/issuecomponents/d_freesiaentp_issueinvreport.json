  "retrieve": " SELECT \n\titemname= item.name,\n\taccname = dbo.accounts.name,\n\tpackingdesc=max(item.packingdesc),\n\taliasname=max(item.customicode),\n\taddress = max(dbo.customer.address1),\n\tcity = max(dbo.customer.city),\n\tcountry = max(dbo.customer.country),\n\tphone = max(dbo.customer.phone),\n\temail = max(dbo.customer.email), \n\tsalesperson = ( Select Name From SalesMan Where SalesManCode = Max(issueheader.SManCode) ),\n\tsalesman = dbo.users.username,  \n\tissueinvcode = issueheader.issueinvcode, \n\theaderno = max(issueheader.headerno),\n\theaderinvno = max(issueheader.headerinvno),  \n\tdate = issueheader.date,   \n\trefno=max(issueheader.referenceno),  \n\trefdate=max(issueheader.referencedate),\n\n\tissueheader.acccode,\n\t\n\tissueheader.remarks,\t\n\tgcode = issuedetail.gcode,   \n\ticode = issuedetail.icode,   \n\tbatch = max(issuedetail.batch),   \n\texpiry = max(issuedetail.expiry),   \n\tqty = isnull(sum(issuedetail.qty  ),0),\n\tlooseqty = isnull(sum(issuedetail.qty),0),\n\n\tpackunits= max(issuedetail.packunits),\n\tsaleprice= max(issuedetail.saleprice),\n\n\titempacking = max(itempacking.name),\n\titemdescription = max(issuedetail.itemdescription),\t\n\tGodown =max(Godown.name),\t\n\tId       = max(issuedetail.IDENTITYCOL) \nFROM \n\tissueheader , \n\tissuedetail , \n\taccounts, \n\tcustomer,\n\tGodown,\n\tusers, \n\titem LEFT OUTER JOIN ItemPacking ON (dbo.Item.PackCode = ItemPacking.PackCode)\nWHERE \n\t( issueheader.issueinvcode = :ar_SInvCode ) AND\n\t( issueheader.issueinvcode = issuedetail.issueinvcode) AND\n\t( issueheader.acccode = dbo.accounts.acccode ) AND \n\t( dbo.customer.custcode = dbo.accounts.acccode ) AND \n\t( issueheader.salesmancode = dbo.users.usercode ) AND \n\t( issuedetail.icode = dbo.item.icode) and \n\t( issuedetail.gcode = dbo.godown.gcode)\nGROUP BY \n\tissueheader.issueinvcode, \n\tissueheader.date, \n\t/*issueheader.headerno,*/\n\tissueheader.acccode, \n\t\n\t\n \n\n\tissueheader.remarks,\n\t\n\tissuedetail.icode,\n\tissuedetail.rowgroup,\n\tissuedetail.batch,\n\tissuedetail.expiry,\n\tissuedetail.gcode, \n\titem.name,\n\titem.icode,\n\titem.printable, \n\taccounts.name,\n\tdbo.users.username\nORDER BY\n\tissueinvcode, \n\tID\n",
  "arguments": {
