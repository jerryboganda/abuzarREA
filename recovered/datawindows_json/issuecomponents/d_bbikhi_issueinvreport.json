  "retrieve": "SELECT \n\titemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end,\n\treprintdate=getdate(), \n\tusers.username,\n\theaderno =max(IssueHeader.headerno),\n\theaderinvno=max(IssueHeader.headerinvno),\n\tposted=max(IssueHeader.posted),\n\tIssueInvCode=dbo.IssueHeader.Issueinvcode,   \n\tDate=dbo.IssueHeader.date,   \n\tRecipientCode = dbo.IssueHeader.RecipientCode,   \n\tRecipient = CASE dbo.IssueHeader.RecipientCode \n\t\tWHEN 1 THEN (SELECT D.Name FROM Department D WHERE D.DeptCode = IssueHeader.DeptCode)\n\t\tWHEN 4 THEN (SELECT S.Name FROM Salesman S WHERE S.SalesmanCode = IssueHeader.RecipientSalesMan)\n\t\tELSE (SELECT A.Name FROM Accounts A WHERE A.AccCode = IssueHeader.AccCode) END,\n\tRecipientcity = CASE dbo.IssueHeader.RecipientCode \n\t\tWHEN 1 THEN ''\n\t\tWHEN 4 THEN ''\n\t\tELSE (SELECT city from customer WHERE customer.custcode = IssueHeader.AccCode) END,\naddress1 = CASE dbo.IssueHeader.RecipientCode \n\t\tWHEN 1 THEN ''\n\t\tWHEN 4 THEN ''\n\t\tELSE (SELECT address1 from customer WHERE customer.custcode = IssueHeader.AccCode) END,\naddress2 = CASE dbo.IssueHeader.RecipientCode \n\t\tWHEN 1 THEN ''\n\t\tWHEN 4 THEN ''\n\t\tELSE (SELECT address2 from customer WHERE customer.custcode = IssueHeader.AccCode) END,\n\tRemarks=dbo.IssueHeader.remarks,\n\tReferenceNo=dbo.IssueHeader.ReferenceNo,\t\n\tIcode=dbo.IssueDetail.icode,   \n\tGCode=dbo.IssueDetail.gcode,\n\tId        = MAX(dbo.IssueDetail.IDENTITYCOL),     \n\tqty  = sum(IssueDetail.qty), \n\tpackunits = max(IssueDetail.packunits), \n\tsaleprice = max(IssueDetail.saleprice), \n\tserverdate=getdate(),\n\tItemClass = ICL.Name,\n\tWeight = SUM(Item.UnitWeight * IssueDetail.qty),\n\tVolume = SUM(Item.PackingFactor * IssueDetail.qty),\n\tTerms1 = MAX(IssueHeader.Terms1),\n\tTerms2 = MAX(IssueHeader.Terms2),\n\tGODOWN=(select name from godown where IssueDetail.gcode=godown.gcode),\n\titemcategory=(select name from itemcategory where itemcategory.icatcode=max(item.icatcode))\nFROM \n\tdbo.IssueHeader,   \n\tdbo.IssueDetail,  \n\titem, \n\titemclass ICL,\n\tusers \nWHERE \n\t( dbo.IssueHeader.IssueInvCode = :ra_InvCode ) AND\n\t( dbo.IssueHeader.IssueInvCode = dbo.IssueDetail.IssueInvCode ) AND \n\t( dbo.IssueHeader.salesmancode = dbo.users.usercode ) AND\n\t( IssueDetail.icode = item.icode )  AND\n\t( item.iccode = ICL.ICCode )\nGROUP BY \n\tIssueHeader.IssueInvCode, \n\tIssueHeader.date, \n\tIssueHeader.RecipientCode,\n\tIssueHeader.AccCode, \n\tIssueHeader.remarks,\n\tIssueHeader.ReferenceNo, \n\tIssueHeader.DeptCode,\n\tIssueHeader.AccCode,\n\tIssueHeader.RecipientSalesMan,\n\tIssueDetail.icode,\n\tIssueDetail.gcode, \n\titem.name,\n\titem.icode,\n\titem.printable, \n\tICL.Name,\n\tdbo.users.username\nORDER BY  \n\titemcategory,\n\tItem.Name,\n\tMAX(dbo.IssueDetail.IDENTITYCOL)\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  }
 },
