  "retrieve": "SELECT \n\titemname=item.name,\n\titemdesc=issuedetail.itemdescription,\n\taliasname=item.customicode,\n\tpackingdesc=item.packingdesc, \n\taccname =  accounts.name,   \n\taddress =   customer.address1,\n\taddress2=   customer.address2,  \n\tcustphone=customer.phone, \n\tcity=   customer.city,   \n\tlicenceno=   customer.licenceno,   \n\tusername=   users.username,   \n\tissueinvcode =   issueheader.issueinvcode,   \n\theaderno =   issueheader.headerno, \n\theaderinvno=issueheader.headerinvno,  \n\tdate =   issueheader.date,   \n\t\n\t\n\t\n\tgcode = issuedetail.gcode,   \n\ticode = issuedetail.icode,   \n\tbatch = issuedetail.batch,   \n\texpiry = issuedetail.expiry,   \n\tlooseqty = issuedetail.qty,   \n\tpackunits= issuedetail.packunits,   \n\tsaleprice= issuedetail.saleprice,   \n\tprice=issuedetail.price,\n\tId =   issuedetail.IDENTITYCOL,   \n\tposted=issueheader.posted,   \n\tbalance=0,   \n\tcustTaxRegno=customer.salestaxregno  ,\n\tcustntnno=customer.ntnno,\n\tcustrefno= issueheader.referenceno,\n\tissueheader.remarks,\n\tsalesman=ltrim(rtrim(  salesman.name)),\n\tMessage=ltrim(rtrim(  Message.description)),\n\tmanufacturer=(select name from manufacturer where manfcode=item.manfcode),\n\tCUSTALIAS=ACCOUNTS.ALIASNAME\nFROM \n\tissueheader\n\tLEFT OUTER JOIN SalesMan ON (issueheader.smancode = salesman.salesmancode),\n\tissuedetail,   \n\taccounts,   \n\tcustomer,   \n\tusers,   \n\tmessage,\n\titem \nWHERE \n\t(   issueheader.issueinvcode=:ar_InvCode) AND\n\t(   issueheader.issueinvcode=issuedetail.issueinvcode) AND\n\t(   issueheader.acccode =   accounts.acccode ) AND  \n\t(   customer.custcode =   accounts.acccode ) AND  \n\t(   issueheader.salesmancode =   users.usercode ) AND  \n\t(   issuedetail.icode =   item.icode)    \nORDER BY   \n\tissuedetail.issueinvcode,\n\tissuedetail.IDENTITYCOL",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_InvCode",
      "number"
     ]
    }
   ]
  }
 },
