  "retrieve": "SELECT \n\tCategory=CC.Name,\n\tAliasName=A.AliasName,\n\tCustomer=A.Name,\n\tOutStandingAmt=S.OutStandingAmt, \n\tLimit = \n\t\tCASE WHEN \n\t\t(SELECT MIN(AID2.Limit) - 1\n\t\tFROM AgingIntervalDetail AID2\n\t\tWHERE AID2.AgingIntervalCode=:ai_aginginterval AND AID2.LIMIT >\n\t\t\t(SELECT L=MAX(AID.Limit) \n\t\t\tFROM AgingIntervalDetail AID\n\t\t\tWHERE AID.AgingIntervalCode=:ai_aginginterval AND DATEDIFF(day, S.date, GETDATE()) >= limit)) IS NULL THEN 'More Than ' ELSE '' END +\n\t\t(SELECT REPLICATE('0', 3 - LEN(LTRIM(RTRIM(STR(MAX(AID.Limit), 10))))) + LTRIM(RTRIM(STR(MAX(AID.Limit), 10)))\n\t\tFROM AgingIntervalDetail AID\n\t\tWHERE AID.AgingIntervalCode=:ai_aginginterval AND DATEDIFF(day, S.date, GETDATE()) >= limit)  + \n\t\t(SELECT ISNULL(' - ' + REPLICATE('0', 3 - LEN(LTRIM(RTRIM(STR((MIN(AID2.Limit) - 1), 10))))) + LTRIM(RTRIM(STR((MIN(AID2.Limit) - 1), 10))), '')\n\t\tFROM AgingIntervalDetail AID2\n\t\tWHERE AID2.AgingIntervalCode=:ai_aginginterval AND AID2.LIMIT >\n\t\t\t(SELECT L=MAX(AID.Limit) \n\t\t\tFROM AgingIntervalDetail AID\n\t\t\tWHERE AID.AgingIntervalCode=:ai_aginginterval AND DATEDIFF(day, S.date, GETDATE()) >= limit))\nFROM \n\tSaleLedger S, Customer C, CustomerCategory CC, Accounts A\nWHERE \n\tS.SaleCatCode IN (2) AND S.Posted='Y' AND S.Marked ='N' AND \n\tS.CustCode=C.CustCode AND C.CustCode = A.AccCode AND \n\tC.CustCatCode = CC.CustCatCode AND\n\tC.CustCatCode IN (:ai_custcatcode)",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_custcatcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_aginginterval",
      "number"
     ]
    }
   ]
  },
  "sort": "category A, aliasname A, customer A"
 },
