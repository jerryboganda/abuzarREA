    "name": "saleprice",
    "dbname": "saleprice"
   }
  ],
  "retrieve": " SELECT \n\titemname=Itemlog.Name, \n\toldsaleprice = saleprice, \n\tname=(select name from item where item.icode=itemlog.icode),\n\titemcategory=(select name from itemcategory where itemcategory.icatcode=itemlog.icatcode),\n\tsaleprice = convert(int,newsaleprice)\n\nFROM itemlog, \n\t(SELECT L.ICode, MaxID=MAX(L.ItemRowID)\n\tFROM itemlog L\n\tWHERE L.logdate >= :ar_startdate AND \n\t\tL.logdate <= :ar_enddate AND \n\t\tL.icatcode in (:aa_icatcode) AND \n\t\t(L.saleprice <> L.newsaleprice)\n\tGROUP BY L.ICode) T\nWHERE\n\tItemLog.ItemRowId = T.MaxID\nORDER BY \n\titemcategory, \n\tName\n\t\n\n\n/*SELECT Name,\n\t\tsaleprice=convert(int,saleprice),\n\t\titemclass=(select name from itemclass where itemclass.iccode=item.iccode)\nfrom item\nwhere item.iccode IN (:aa_icatcode)\norder by itemclass,\n\t\t\tname*/\n",
  "arguments": {
   "_items": [
