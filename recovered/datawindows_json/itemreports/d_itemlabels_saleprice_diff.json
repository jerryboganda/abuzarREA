      "ar_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_enddate",
      "datetime"
     ]
    },
    {
     "_items": [
      "aa_icatcode",
      "numberlist"
     ]
    }
   ]
  }
 },
