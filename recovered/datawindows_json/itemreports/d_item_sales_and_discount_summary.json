  ],
  "retrieve": "SELECT \n\tAliasName=I.CustomICode,\n\tItemName=I.Name,\n\tSalePrice = ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),\n\tPacking=I.PackingDesc,\n\tGroupCode=  \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END,\n\tGroupName= \n\t\tCASE :as_reportgrouping \n\t\tWHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)\n\t\tWHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)\n\t\tWHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)\n\t\tELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,   \n\tTotalSaleQty = SUM(S.LooseQty + S.BonusQty),\n\tTotalSaleValue = Round(SUM(S.LooseQty * ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2) ), 2),\n\tSaleQtyAtTP= SUM(CASE S.ItemFlatDisc + S.DiscPerc + S.InvDiscPerc + (S.TP - S.SalePrice)\n\t\tWHEN 0 THEN S.LooseQty + S.BonusQty ELSE 0 END),\n\tSaleValueAtTP= Round(SUM(CASE S.ItemFlatDisc + S.DiscPerc + S.InvDiscPerc + (S.TP - S.SalePrice)\n\t\tWHEN 0 THEN (S.LooseQty * ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) ELSE 0 END), 2),\n\tSaleQtyAtDisc= SUM(CASE S.ItemFlatDisc + S.DiscPerc + S.InvDiscPerc + (S.TP - S.SalePrice)\n\t\tWHEN 0 THEN 0 ELSE S.LooseQty + S.BonusQty END),\n\tSaleValueAtDisc= Round(SUM(CASE S.ItemFlatDisc + S.DiscPerc + S.InvDiscPerc + (S.TP - S.SalePrice)\n\t\tWHEN 0 THEN 0 ELSE (S.LooseQty * ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) END), 2),\n\tDiscValue= Round(SUM((S.ItemFlatDisc * S.LooseQty) + \n\t\t(S.LooseQty * (S.SalePrice - S.ItemFlatDisc) * S.DiscPerc * 0.01) +\n\t\t(S.LooseQty * (S.SalePrice - S.ItemFlatDisc) * (1 - S.DiscPerc * 0.01) * S.InvDiscPerc * 0.01) + \n\t\tCASE S.TP - S.SalePrice WHEN 0 THEN 0 ELSE (S.TP - S.SalePrice) * S.LooseQty END), 2)\n\nFROM\n\tItem I,\n\t(SELECT \n\t\tD.ICode,\n\t\tD.LooseQty,\n\t\tD.BonusQty,\n\t\tD.ItemFlatDisc,\n\t\tD.DiscPerc,\n\t\tD.SalePrice,\n\t\tTP = Round(D.PackPrice / CASE D.PackUnits WHEN 0 THEN 1 ELSE D.PackUnits END, 2),\n\t\tInvDiscPerc=S.DiscPerc\n\tFROM\n\t\tSaleLedger S, SaleDetail D, Item I\n\tWHERE\n\t\t:as_saletype IN (1,2) AND\n\t\tS.SaleInvCode = D.SaleInvCode AND\n\t\tS.Posted = 'Y' AND\n\t\tS.Date >= :ad_startdate AND S.DATE <= :ad_enddate AND\n\t\tD.ICode = I.ICode AND\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ai_groupcode)\n\tUNION ALL\n\tSELECT \n\t\tD.ICode,\n\t\tD.LooseQty,\n\t\tD.BonusQty,\n\t\tD.ItemFlatDisc,\n\t\tD.DiscPerc,\n\t\tD.SalePrice,\n\t\tTP = Round(D.PackPrice / CASE D.PackUnits WHEN 0 THEN 1 ELSE D.PackUnits END, 2),\n\t\tInvDiscPerc=S.DiscPerc\n\tFROM\n\t\tSaleLedger S, SaleInvDetail D, Item I\n\tWHERE\n\t\t:as_saletype IN (1,3) AND\n\t\tS.impactinventory = 'N' AND\n\t\tS.SaleInvCode = D.SaleInvCode AND\n\t\tS.Posted = 'Y' AND\n\t\tS.Date >= :ad_startdate AND S.DATE <= :ad_enddate AND\n\t\tD.ICode = I.ICode AND\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ai_groupcode)) S\nWHERE \n\tI.ICode = S.ICode AND\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ai_groupcode)\nGROUP BY\n\tI.Name,\n\tI.CustomICode,\n\tI.SalePrice,\n\tI.PackUnits,\n\tI.PackingDesc,\n\tI.ManfCode,\n\tI.ICatCode,\n\tI.ICCode,\n\tI.Packcode\nORDER BY\n\tGroupName,\n\tItemName,\n\tAliasName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_reportgrouping",
      "string"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
