    "dbname": "Qty"
   }
  ],
  "retrieve": "SELECT \n\tAliasName = '*' + Item.CustomICode + '*',\n\tAliasName2 = Item.CustomICode,\n\tName = Item.Name,\n\tPackingDesc=Item.PackingDesc,\n\titemcategory=(select name from itemcategory where itemcategory.icatcode=itemlog.icatcode),\n\tOldSalePrice = ItemLog.SalePrice,\n\tSalePrice = ItemLog.NewSalePrice,\n\tRsSalePrice = 'Rs.:' +'  '+ Convert(varchar(15), CAST(ROUND(ItemLog.NewSalePrice * (1 - itemlog.salediscperc * 0.01),2) AS NUMERIC(12,2))),\n\tQty = 1\nFROM \n\titemlog, \n\t(SELECT L.ICode, MaxID=MAX(L.ItemRowID)\n\tFROM itemlog L\n\tWHERE L.logdate >= :ar_startdate AND \n\t\tL.logdate <= :ar_enddate AND \n\t\tL.icatcode in (:aa_icatcode) AND \n\t\t(L.saleprice <> L.newsaleprice)\n\tGROUP BY L.ICode) T,\n\tItem\nWHERE\n\tItemLog.ItemRowId = T.MaxID AND\n\tItemLog.ICode = Item.ICode\nORDER BY \n\titemcategory, \n\tName\n",
  "arguments": {
   "_items": [
    {
     "_items": [
