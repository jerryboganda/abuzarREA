    "dbname": "purquotationcode"
   }
  ],
  "retrieve": "select \n\tgenericname=(select name from genericitem where genericitem.genericcode=T.genericcode),\n\titemname=(select name from item where item.icode=PQD.icode),\n\tmanufacturer=(select name from manufacturer where manufacturer.manfcode=T.manfcode),\n\tsupplier=(select name from accounts where accounts.acccode=PQH.suppcode),\n\tsaleprice=(select saleprice from item where item.icode=PQD.icode),\n\tpurprice=PQD.purprice,\n\tdiscper=PQD.discperc,\n\tpurquotationcode=PQH.purquotationcode\n\nfrom purquotationdetail PQD,\n     purquotationheader PQH,\n     (select icode,genericcode,MANFCODE from item where genericcode in (:ar_genericcode)) AS T\n\nwhere \tPQH.active='Y' and\n\t\t\tPQH.purquotationcode=PQD.purquotationcode and\n\t\t\tPQD.icode = T.icode\n\norder by genericname,\n\titemname\n\t",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_genericcode",
      "numberlist"
     ]
    }
   ]
  }
 },
