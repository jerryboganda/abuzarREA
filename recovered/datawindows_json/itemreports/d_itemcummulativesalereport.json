    "dbname": "CummulativeSaleQty"
   }
  ],
  "retrieve": "SELECT \n\tINVCODE=SL.SALEINVCODE, \n\tDATE=SL.DATE, \n\tRemarks=SL.Remarks,\n\tRegNo=P.RegNo,\n\tPatient=P.Name,\n\tDoctor=(SELECT D.Name FROM Doctors D WHERE D.DoctCode = SL.DoctCode),\n\tALIASNAME=I.CUSTOMICODE, \n\tITEM=I.NAME,  \n\tQTY=SUM(SD.LOOSEQTY), \n\tCummulativeSaleQty=SUM(PS.Qty)\nFROM\n\tSaleLedger SL,\n\tSaleDetail SD,\n\tItem I,\n\tPatient P,\n\t(SELECT \n\t\tD.ICode, S.PatientCode, Qty=SUM(D.LooseQTY)\n\tFROM \n\t\tSaleLedger S, \n\t\tSaleDetail D, \n\t\t(SELECT T1.PatientCode, T2.ICode\n\t\tFROM\n\t\t\t(SELECT DISTINCT PatientCode FROM SaleLedger WHERE Date BETWEEN :AD_STARTDATE AND :AD_ENDDATE) T1,\n\t\t\t(SELECT ICode FROM Item WHERE ICode IN (:AI_ICODE)) T2) T\n\tWHERE \n\t\tS.Date < :AD_ENDDATE AND \n\t\tS.SaleInvCode = D.SaleInvCode AND\n\t\tD.ICode = T.ICode AND\n\t\tS.PatientCode = T.PatientCode\n\tGROUP BY \n\t\tD.ICode, S.PatientCode) PS\nWHERE\n\tSL.Date BETWEEN :AD_STARTDATE AND :AD_ENDDATE AND\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSD.ICode = I.ICode AND\n\tI.ICode IN (:AI_ICODE) AND\n\tSL.PatientCode = P.PatientCode AND\n\tP.PatientCode = PS.PatientCode AND \n\tI.ICode = PS.ICode\nGROUP BY\n\tI.CUSTOMICODE, \n\tI.NAME,  \n\tP.RegNo,\n\tP.Name,\n\tSL.SALEINVCODE, \n\tSL.DATE, \n\tSL.Remarks,\n\tSL.DoctCode\n\n/*\nSELECT \n\tINVCODE=S.SALEINVCODE, \n\tDATE=S.DATE, \n\tRemarks=S.Remarks,\n\tRegNo=(SELECT P.RegNo FROM Patient P WHERE P.PatientCode = S.PatientCode),\n\tPatient=(SELECT P.Name FROM Patient P WHERE P.PatientCode = S.PatientCode),\n\tDoctor=(SELECT D.Name FROM Doctors D WHERE D.DoctCode = S.DoctCode),\n\tALIASNAME=I.CUSTOMICODE, \n\tITEM=I.NAME,  \n\tQTY=SUM(SD.LOOSEQTY), \n\tCummulativeSaleQty=(SELECT SUM(DD.LooseQty) \n\tFROM SaleLedger SS, SaleDetail DD \n\tWHERE SS.PatientCode = S.PatientCode AND DD.ICode = SD.ICode AND\n\t\tSS.SaleInvCode <= S.SaleInvCode AND SS.Date <= S.Date AND SS.SaleInvCode = DD.SaleInvCode)\nFROM \n\tSALELEDGER S, \n\tSALEDETAIL SD,\n\tITEM I\nWHERE \n\tS.DATE BETWEEN :AD_STARTDATE AND :AD_ENDDATE AND\n\tS.SALEINVCODE = SD.SALEINVCODE AND\n\tSD.ICODE IN (:AI_ICODE) AND\n\tSD.ICODE = I.ICODE\nGROUP BY\n\tS.SALEINVCODE, \n\tS.DATE,\n\tS.Remarks, \n\tS.PatientCode, \n\tS.DoctCode,\n\tSD.ICode,\n\tI.CUSTOMICODE, \n\tI.NAME\nORDER BY\n\tITEM,\n\tALIASNAME, \n\tDATE, \n\tINVCODE, \n\tPatient\n\n*/",
  "arguments": {
   "_items": [
    {
     "_items": [
      "AI_ICODE",
      "numberlist"
     ]
    },
    {
     "_items": [
      "AD_STARTDATE",
      "datetime"
     ]
    },
    {
     "_items": [
      "AD_ENDDATE",
      "datetime"
     ]
    }
   ]
  },
  "sort": "item A, patient A, date A, invcode A"
 },
