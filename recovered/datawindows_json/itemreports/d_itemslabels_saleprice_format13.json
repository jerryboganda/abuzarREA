    "dbname": "groupname"
   }
  ],
  "retrieve": "SELECT \n\tAliasName = '*' + Item.CustomICode + '*',\n\tAliasName2 = Item.CustomICode,\n\titemname=item.name,\n\tmarketprice=item.saleprice2,\n\tstoreprice='RS' +'  '+ Convert(varchar(15), CAST(ROUND(item.saleprice * (1 - item.salediscperc * 0.01), 2) AS NUMERIC(12,2))),\n\tgroupname=(CASE :as_grouptype WHEN 'M' THEN (select Manufacturer.name from manufacturer where manufacturer.manfcode= item.manfcode)\n\t\t\t\t\t\t\t\t\t\t\t\t \tWHEN 'C' THEN (select itemcategory.name from itemcategory where itemcategory.icatcode= item.icatcode)\n\t\t\t\t\t\t\t\t\t\t\t\t\tWHEN 'P' THEN (select itempacking.name from itempacking where itempacking.packcode= item.packcode)\n\t\t\t\t\t\t\t\t\t\t\t\t\t ELSE (select itemclass.name from itemclass where itemclass.iccode= item.iccode) END)\nfrom item\nwhere CASE :as_grouptype \n\t\tWHEN 'M' THEN Item.ManfCode\n\t\tWHEN 'C' THEN Item.ICatCode \n\t\tWHEN 'P' THEN item.PackCode \n\t\tELSE Item.ICCode END IN (:ai_groupcode) \n\norder by groupname,\n\t\t\tname\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_grouptype",
      "string"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "numberlist"
     ]
    }
   ]
  }
 },
