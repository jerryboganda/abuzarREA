  "retrieve": "SELECT \n\tCode=ItemRegRequest.ItemRegReqCode,   \n\tDate = ItemRegRequest.Date,\n\tStatus = ItemRegRequest.Status,   \n\tRequestedItemName=ItemRegRequest.Name,   \n\tRegisteredItemName=(SELECT Item.Name FROM ITEM WHERE Item.ICode = ItemRegRequest.ICode),   \n\tCustomICode=ItemRegRequest.CustomICode,   \n\tpurprice=ItemRegRequest.purprice,\n\tsaleprice=ItemRegRequest.saleprice,\n\tpackunits=ItemRegRequest.packunits,\n\tManufacturer=Manufacturer.Name,\n\tItemPacking=ItemPacking.name,\n\titemclass=itemclass.name,\n\titemcategory=itemcategory.name,\n\tSent=ItemRegRequest.Sent,   \n\tSentBy=ItemRegRequest.SentBy   \nFROM\n\tItemRegRequest \n\tLEFT OUTER JOIN ItemPacking ON (ItemRegRequest.Packcode = ItemPacking.PackCode)\n\tLEFT OUTER JOIN itemclass ON (ItemRegRequest.Iccode = itemClass.iccode),   \n\tManufacturer,\n\titemcategory\nWHERE\n\t( ItemRegRequest.ManfCode = Manufacturer.ManfCode )    and\n\t( ItemRegRequest.icatcode = itemcategory.Icatcode) AND\n\t(ItemRegRequest.Date BETWEEN :adt_startdate AND :adt_enddate) ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
