    "dbname": "UTN"
   }
  ],
  "retrieve": " select   invcode=SL.saleinvcode,\n\t\t\titemname=I.name,\n\t\t\tremarks=SL.remarks,\n\t\t\tref=SL.custrefno,\n\t\t\tstockatsale=SD.Godownbalancestock,\n   \t\t\tsaleqty=SD.looseqty + SD.bonusqty,\n\t\t\tpurqty=0,\n\t\t\tdate=SL.date,\n\t\t\tbatch=SD.batch,\n\t\t\texpiry=SD.expiry,\n\t\t\tusername=U.username,\n\t\t\tmanufacturer=M.name,\n\t\t\tItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = I.ICatCode),\n\t\t\tUTN=SD.saleutn\n\nfrom saleledger SL,\n\t\tsaledetail  SD,\n\t\tUsers U,\n\t\tItem I,\n\t\tManufacturer M\n\nwhere (SL.date>=:ar_stdate)and\n\t\t(SL.date<=:ar_enddate)and\n\t\t(SL.salesmancode=U.usercode)and\n\t\t(SL.saleinvcode=SD.saleinvcode)  and\n\t\t(I.icode=SD.icode)and\n\t\t(I.antinorcotix='Y')and\n\t\t(I.manfcode=M.manfcode)\n\t\t\nunion all\n\nselect  invcode=PL.purinvcode,\n\t\t\titemname=I.name,\n\t\t\tremarks=PL.remarks,\n\t\t\tref=' ',\n\t\t\tstockatpur= ISNULL(PD.currstock, 0) + \n\t\t\t\tPD.looseqty + (PD.packqty * PD.packunits ) + \n\t\t\t\t(case when PL.purcatcode in (1,2) then PD.bonusqty * PD.packunits else PD.bonusqty end),\n\t\t\tsaleqty=0,\n\t\t\tpurqty=PD.looseqty + (PD.packqty * PD.packunits )+ (case when PL.purcatcode in (1,2) then PD.bonusqty * PD.packunits\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t else\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tPD.bonusqty\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t end),\n\t\t\t\n\t\t\tdate=PL.date,\n\t\t\tbatch=PD.batch,\n\t\t\texpiry=PD.expiry,\n\t\t\tusername=U.username,\n\t\t\tManufacturer=M.name,\n\t\t\tItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = I.ICatCode),\n\t\t\tUTN=PD.purutn\n\nfrom purledger PL,\n\t\tpurdetail  PD,\n\t\tUsers U,\n\t\tItem I,\n\t\tManufacturer M\n\nwhere (PL.date>=:ar_stdate)and\n\t\t(PL.date<=:ar_enddate)and\n\t\t(PL.posted='Y')and\n\t\t(PL.salesmancode=U.usercode)and\n\t\t(PL.purinvcode=PD.purinvcode) and\n\t\t(I.icode=PD.icode) and\n\t\t(I.antinorcotix='Y')and\n\t\t(I.manfcode=M.manfcode)\n\nOrder by itemname, UTN\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_stdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
