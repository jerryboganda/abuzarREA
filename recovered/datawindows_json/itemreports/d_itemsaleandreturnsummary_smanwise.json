  "retrieve": "SELECT \n\tAliasName=(SELECT I.CustomICode FROM ITEM I WHERE I.ICODE = :ai_ICode), \n\tItem=(SELECT I.Name FROM ITEM I WHERE I.ICODE = :ai_ICode),\n\tRate = (SELECT ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2) FROM ITEM I WHERE I.ICODE = :ai_ICode),\n\tPacking=(SELECT I.PackingDesc FROM ITEM I WHERE I.ICODE = :ai_ICode),\n\tSalePerson=SM.Name,\n\tQtySold = ISNULL(SUM(QTYSOLD), 0),\n\tBonusSold = ISNULL(SUM(BONUSSOLD), 0),  \n\tQtyReturned = ISNULL(SUM(QTYReturned), 0),\n\tBonusReturned = ISNULL(SUM(BONUSReturned), 0)\nFROM \n\tSalesman SM\n\tLEFT OUTER JOIN\n\t(SELECT\n\t\tSMANCODE=SL.SMANCODE,\n\t\tInvCode=SL.SaleInvCode,\n\t\tICode=SD.ICode, \n\t\tQtySold=SUM(SD.LooseQty),\n\t\tBonusSold=SUM(SD.BonusQty),\n\t\tQtyReturned=0,\n\t\tBonusReturned=0\n\tFROM\n\t\tSaleLedger SL, SaleDetail SD\n\tWHERE\n\t\tSL.Date BETWEEN :ad_StartDate AND :ad_EndDate AND\n\t\tSD.ICode = :ai_ICode AND\n\t\tSL.SMANCODE IN (:ai_SManCode) AND\n\t\tSL.SaleInvCode = SD.SaleInvCode\n\tGROUP BY\n\t\tSL.SaleInvCode,\n\t\tSL.SManCode,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT\n\t\tSMANCODE=SL.SMANCODE,\n\t\tInvCode=SL.SaleInvCode,\n\t\tICode=SD.ICode, \n\t\tQtySold=SUM(SD.LooseQty),\n\t\tBonusSold=SUM(SD.BonusQty),\n\t\tQtyReturned=0,\n\t\tBonusReturned=0\n\tFROM\n\t\tSaleLedger SL, SaleInvDetail SD\n\tWHERE\n\t\tSL.ImpactInventory = 'N' AND\n\t\tSL.Date BETWEEN :ad_StartDate AND :ad_EndDate AND\n\t\tSD.ICode = :ai_ICode AND\n\t\tSL.SMANCODE IN (:ai_SManCode) AND\n\t\tSL.SaleInvCode = SD.SaleInvCode\n\tGROUP BY\n\t\tSL.SaleInvCode,\n\t\tSL.SManCode,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT\n\t\tSMANCODE=SL.SMANCODE,\n\t\tInvCode=SL.SRInvCode,\n\t\tICode=SD.ICode, \n\t\tQtySold=0,\n\t\tBonusSold=0,\n\t\tQtyReturned=SUM(SD.LooseQty),\n\t\tBonusReturned=SUM(SD.BonusQty)\n\tFROM\n\t\tSRLedger SL, SRDetail SD\n\tWHERE\n\t\tSL.Date BETWEEN :ad_StartDate AND :ad_EndDate AND\n\t\tSD.ICode = :ai_ICode AND\n\t\tSL.SMANCODE IN (:ai_SManCode) AND\n\t\tSL.SRInvCode = SD.SRInvCode\n\tGROUP BY\n\t\tSL.SRInvCode,\n\t\tSL.SMANCODE,\n\t\tSD.ICode) S ON (SM.SalesManCode = S.SMANCODE)\nWHERE\n\tSM.SalesManCode IN (:ai_SManCode)\nGROUP BY\n\tSM.Name, S.ICode\nORDER BY\n\tSalePerson",
  "arguments": {
