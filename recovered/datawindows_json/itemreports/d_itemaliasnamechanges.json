  ],
  "retrieve": "SELECT \n\titemname = (SELECT Item.Name From Item WHERE item.icode = itemlog.icode),\n\tItemRowId,\n\tLogDate, \n\tICode,\n\tName, \n\tAliasName=CustomICode,\n\tUserName=(SELECT Users.UserName FROM Users WHERE Users.UserCode = ItemLog.UserCode),\n\tChangeReason,\n\tModule\nFROM \n\tItemLog\nWHERE \n\tlogdate >= :ad_startdate AND logdate <= :ad_enddate AND\n\tICODE IN \n\t\t(SELECT ICode\n\t\tFROM\n\t\t\t(SELECT ICode, CustomICode FROM ItemLog\n\t\t\t\tWHERE logdate >= :ad_startdate AND logdate <= :ad_enddate\n\t\t\tUNION ALL\n\t\t\tSELECT ICode, CustomICode FROM ItemLog\n\t\t\t\tWHERE ItemRowID IN (SELECT MIN(ItemRowID) FROM ItemLog WHERE logdate >= :ad_enddate)\n\t\t\tUNION ALL\n\t\t\tSELECT ICode, CustomICode FROM Item\n\t\t\t\tWHERE\tIcode not in (SELECT ICode FROM Itemlog where logdate >= :ad_enddate)) T\n\t\tGROUP BY ICode\n\t\tHAVING COUNT(DISTINCT CustomICode) > 1)\nUNION ALL\nSELECT \t\n\titemname = (SELECT Item.Name From Item WHERE item.icode = itemlog.icode),\n\tItemRowId,\n\tLogDate, \n\tICode,\n\tName,\n\tAliasName=CustomICode,\n\tUserName=(SELECT Users.UserName FROM Users WHERE Users.UserCode = ItemLog.UserCode),\n\tChangeReason,\n\tModule\nFROM \n\tItemLog\nWHERE \n\tItemRowID IN (SELECT MIN(ItemRowID) FROM ItemLog WHERE logdate >= :ad_enddate) AND \n\tICODE IN \n\t(SELECT ICode\n\tFROM\n\t\t(SELECT ICode, CustomICode FROM ItemLog\n\t\t\tWHERE logdate >= :ad_startdate AND logdate <= :ad_enddate\n\t\tUNION ALL\n\t\tSELECT ICode, CustomICode FROM ItemLog\n\t\t\tWHERE ItemRowID IN (SELECT MIN(ItemRowID) FROM ItemLog WHERE logdate >= :ad_enddate)\n\t\tUNION ALL\n\t\tSELECT ICode, CustomICode FROM Item\n\t\t\tWHERE\tIcode not in (SELECT ICode FROM Itemlog where logdate >= :ad_enddate)) T\n\tGROUP BY ICode\n\tHAVING COUNT(DISTINCT CustomICode) > 1)\nUNION ALL\nSELECT \n\titemname = Item.Name,\n\tItemRowId=999999999, \n\tLogDate=lastupdate, \n\tICode,\n\tName,\n\tAliasName=CustomICode,\n\tUserName=(SELECT Users.UserName FROM Users WHERE Users.UserCode = Item.UserCode),\n\tChangeReason,\n\tModule\nFROM \n\tItem\nWHERE\t\n\tIcode not in (SELECT ICode FROM Itemlog where logdate >= :ad_enddate) AND\n\tICODE IN \n\t\t(SELECT ICode\n\t\tFROM\n\t\t\t(SELECT ICode, CustomICode FROM ItemLog\n\t\t\t\tWHERE logdate >= :ad_startdate AND logdate <= :ad_enddate\n\t\t\tUNION ALL\n\t\t\tSELECT ICode, CustomICode FROM ItemLog\n\t\t\t\tWHERE ItemRowID IN (SELECT MIN(ItemRowID) FROM ItemLog WHERE logdate >= :ad_enddate)\n\t\t\tUNION ALL\n\t\t\tSELECT ICode, CustomICode FROM Item\n\t\t\t\tWHERE\tIcode not in (SELECT ICode FROM Itemlog where logdate >= :ad_enddate)) T\n\t\tGROUP BY ICode\n\t\tHAVING COUNT(DISTINCT CustomICode) > 1)\t\nORDER BY\n\titemname, \n\ticode,\n\titemrowid\n",
  "update": "ItemLog",
  "updatewhere": "1",
  "updatekeyinplace": "no",
