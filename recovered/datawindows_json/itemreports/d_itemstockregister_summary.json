  "retrieve": "select name=(select name from item where icode=:ai_icode),\n   \t aliasname=(select customicode from item where icode=:ai_icode),\n\t packunits=(select  convert(numeric(5,2),packunits) from item where item.icode=:ai_icode),\n     sale=(select sum(looseqty+bonusqty) from saledetail,saleledger \n             where saleledger.date>=:adt_sdate and\n                   saleledger.date<= :adt_ldate and\n                   saleledger.posted='Y' and\n                   saleledger.saleinvcode=saledetail.saleinvcode and\n                   saledetail.icode=:ai_icode\n              ),\n      \n       salereturn=(select sum(looseqty+bonusqty) from srdetail,srledger\n                    where  srledger.postdate >=:adt_sdate and\n                           srledger.postdate <= :adt_ldate and\n                           srledger.posted='Y' and\n                           srledger.srinvcode=srdetail.srinvcode and\n                           srdetail.icode=:ai_icode\n                            ),\n\n       packpurchase=(select sum(packqty) from purdetail,purledger\n       \t\t         where purledger.postdate >=:adt_sdate and\n                           purledger.postdate <= :adt_ldate and\n                           purledger.posted='Y' and\n                    \t\t\tpurledger.purinvcode=purdetail.purinvcode and\n                   \t\t\tpurdetail.icode=:ai_icode\n            \t\t\t ),\n\n\n\n \t\tloosepurchase=(select sum(packqty+looseqty) from purdetail,purledger\n       \t\t     \t\twhere purledger.date>=:adt_sdate and\n                 \t\t\t\tpurledger.date<= :adt_ldate and\n                   \t\t\tpurledger.posted='Y' and\n                   \t\t\tpurledger.purinvcode=purdetail.purinvcode and\n                  \t\t\t purdetail.icode=:ai_icode\n           \t\t\t  ),\n\n\n       \n\t\tissue=(select sum(qty) from issuedetail,issueheader\n             where issueheader.date>=:adt_sdate and\n                   issueheader.date<= :adt_ldate and\n                   issueheader.posted='Y' and\n                   issueheader.issueinvcode=issuedetail.issueinvcode and\n                   issuedetail.icode=:ai_icode\n             ),\n                 \n\n\t\treceipt=(select sum(qty) from receiptdetail,receiptheader\n             where receiptheader.postdate>=:adt_sdate and\n                   receiptheader.postdate<= :adt_ldate and\n                   receiptheader.posted='Y' and\n                   receiptheader.receiptinvcode=receiptdetail.receiptinvcode and\n                   receiptdetail.icode=:ai_icode\n             ),\n\n\t\tadjincrease=(select sum(looseqty) from adjdetail,adjheader\n             where adjheader.posteddate >=:adt_sdate and\n                   adjheader.posteddate <= :adt_ldate and\n                   adjheader.posted='Y' and\n\t\t\t\t\t\t adjheader.adjcatcode=1 and\n                   adjheader.adjcode=adjdetail.adjcode and\n                   adjdetail.icode=:ai_icode\n             ),\n\n\t\tadjdecrease=(select sum(looseqty) from adjdetail,adjheader\n             where adjheader.posteddate >=:adt_sdate and\n                   adjheader.posteddate <= :adt_ldate and\n                   adjheader.posted='Y' and\n\t\t\t\t\t\t adjheader.adjcatcode=2 and\n                   adjheader.adjcode=adjdetail.adjcode and\n                   adjdetail.icode=:ai_icode\n             ), \n\n\n\t\tpurchasereturn=(select sum(looseqty) from prdetail,prledger\n                       where prledger.date>=:adt_sdate and\n                   prledger.date<= :adt_ldate and\n                   prledger.posted='Y' and\n                   prledger.prinvcode=prdetail.prinvcode and\n                   prdetail.icode=:ai_icode\n              )",
  "arguments": {
