  "retrieve": "Select \tSManCode = IsNull(A.smancode, :al_salesmancode ),\n\t\t\tMonth = DateName(Month, Cast( :al_month As VarChar(2)) + '/01/' + Cast( :al_year As VarChar(4)) ) + '  ' + Cast( :al_year As VarChar(4) ) ,\n\t\t\tSalesMan = ( Select Name From SalesMan Where SalesManCode = IsNull(A.smancode, :al_salesmancode ) ),\n\t\t\tD.date,\n       \treceipts = IsNull( Sum(A.credit) , 0 ),\n       \tsaleamount = IsNull( Sum(A.saleamount) , 0 ) ,\n       \trate = IsNull( Sum(A.amount) , 0 )\nFrom \n(\nSelect  \tsmancode = glheader.smancode,\n\t\t\tcredit = gldetail.credit,\n\t\t\tamount = 0 ,\n\t\t\tsaleamount = 0,\n      \tdate = Convert(VarChar(12),glheader.date,103)\nFrom    glheader , gldetail\nWhere   \tglheader.glvochcode = gldetail.glvochcode And\n\t\t\tglheader.Posted = 'Y' And\n\t\t\tglheader.smancode IN (:al_salesmancode) AND\n\t\t\tgldetail.credit > 0 AND\n\t\t\tglheader.vochcatcode IN (2, 4, 12, 13) and glheader.acccode <> gldetail.acccode and \n\t\t\tMonth(glheader.date) = :al_month  And\n\t\t\tYear(glheader.date) = :al_year  \nUnion All\nSelect  \tsmancode = sl.smancode,\n\t\t\tcredit = 0,\n\t\t\tamount=Round(\n\t\t\t\t\t\t\tSUM((SD.looseqty*(SD.Rate - SD.itemflatdisc)) *\n\t\t\t\t\t\t\t(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + \n\t\t\t\t\t\t\tSL.misccharges + SL.salestax - SL.flatdisc, 0)+\n\t\t\t\t\t\t\tRound(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + \n\t\t\t\t\t\t\tSUM(ROUND( (SD.looseqty * (SD.Rate - SD.itemflatdisc)) *\n\t\t\t\t\t\t\t\t(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +\n\t\t\t\t\t\t\tROUND( (SUM((SD.looseqty * \n\t\t\t\t\t\t\t\t(SD.Rate - SD.itemflatdisc)) *\n\t\t\t\t\t\t\t\t(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -\n\t\t\t\t\t\t\t\tSL.flatdisc) * (SL.invgstperc1 * .01), 2), 0),\n\t\t\tsaleamount=Round(\n\t\t\t\t\t\t\tSUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *\n\t\t\t\t\t\t\t(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + \n\t\t\t\t\t\t\tSL.misccharges + SL.salestax - SL.flatdisc, 0)+\n\t\t\t\t\t\t\tRound(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + \n\t\t\t\t\t\t\tSUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *\n\t\t\t\t\t\t\t\t(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +\n\t\t\t\t\t\t\tROUND( (SUM((SD.looseqty * \n\t\t\t\t\t\t\t\t(SD.saleprice - SD.itemflatdisc)) *\n\t\t\t\t\t\t\t\t(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -\n\t\t\t\t\t\t\t\tSL.flatdisc) * (SL.invgstperc1 * .01), 2), 0),\n      \tdate = Convert( VarChar(12), sl.date , 103 )\nFrom    SaleLedger sl , SaleDetail sd\nWhere   \tsl.saleinvcode = sd.saleinvcode And\n\t\t\tsl.Posted = 'Y' And\n\t\t\tsl.smancode IN (:al_salesmancode) And\n\t\t\tMonth(sl.date) = :al_month And\n\t\t\tYear(sl.date) = :al_year  \nGroup By SL.SaleInvCode,\n\t \t\tSL.smancode,\n\t \t\tSL.date,\n\t \t\tSL.discperc,\n\t \t\tSL.flatdisc,\n\t \t\tSL.invgstperc1,\n\t \t\tSL.MiscCharges,\n\t \t\tSL.SalesTax\n\n) A Right Outer Join udf_DaysOfMonthList( :al_month , :al_year ) D On A.Date = Convert( VarChar(12), D.Date , 103) \n\nGroup By \tA.smancode,\n\t\t\t \tD.date",
  "arguments": {
   "_items": [
