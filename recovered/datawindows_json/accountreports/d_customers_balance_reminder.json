    "dbname": "salesperson"
   }
  ],
  "retrieve": " SELECT \n\tAliasName, \n\tcustomername = name1, \n\tAddress1,\n\tAddress2, \n\tCity,\n\tBalance=Value1, \n\tDetail = :as_detail + SPACE(LEN(:as_detail)),\n\tsalesperson=(select name from salesman S where S.salesmancode=A.SalesManCode)\nFROM\n\t(SELECT \n\t\tA.Name AS name1, \n\t\tAddress1 = C.Address1,\n\t\tAddress2 = C.Address2,\n\t\tCity = C.City,\n\t\tSum(Debit - Credit) AS value1, \n\t\tA.AliasName, \n\t\tsalesmancode=max(C.SalesManCode)\n\tFROM VirtualGL V,\n\t\t  Accounts A,\n\t\t  SubAccounts S,\n\t\t  Customer C\n\tWHERE V.Date <= :adt_Date AND \n\t\t\tV.AccCode IN (:ai_custcode) AND\n\t\t\tV.AccCode = A.AccCode AND \n\t\t\tA.SubCode = S.SubAccCode AND \n\t\t\tS.SubAccCode = 3 AND \n\t\t\tA.AccCode = C.CustCode\n\tGROUP BY \n\t\tA.AccCode, A.Name, A.AliasName, C.Address1, C.Address2, C.City) A\nORDER BY \n\tcustomername, \n\tAliasName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_custcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "adt_date",
      "datetime"
     ]
    },
    {
     "_items": [
      "as_detail",
      "string"
     ]
    }
   ]
  }
 },
