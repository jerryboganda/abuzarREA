  "retrieve": "SELECT\n\tGlCode = H.GLVochCode,\n\tH.VoucherCode,\n\tDate = H.Date,\n\tAccCode=D.AccCode,\n\tAliasName = A.AliasName,\n\tTitle = A.Name,\n\tAmount = D.Credit,\n\tRemarks = D.Remarks,\n\tChequeNo= D.ChkNo,\n\tPosted=H.Posted,\n\tInvoiceCode = D.InvoiceCode\nFROM\n\tGLHeader H,\n\tGLDetail D,\n\tAccounts A\nWHERE\n\tH.VochCatCode= :ai_VoucherCatCode AND\n\tH.GLVochCode = D.GLVochCode AND\n\tD.GLRowID IN (:ai_SelectedRowID) AND\n\tD.AccCode = A.AccCode\nORDER BY\n\tH.GLVochCode,\n\tD.GLRowID",
