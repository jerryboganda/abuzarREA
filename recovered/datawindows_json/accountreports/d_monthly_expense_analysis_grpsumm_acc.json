   {
    "type": "number",
    "updatewhereclause": "yes",
    "name": "amount",
    "dbname": "amount"
   }
  ],
  "retrieve": "SELECT \n\tSortOrder=0,\n\tSummaryAccountName = SA.Name,\n\tAliasName = A.AliasName,\n\tAccountName = A.Name,\n\tMonth = CAST(ltrim(rtrim(str(datepart(mm, V.Date), 5))) + '-01-' +  ltrim(rtrim(str(datepart(yyyy, V.Date), 5))) AS DATETIME),\n\tAmount=SUM(V.Debit-V.Credit)\nFROM \n\tSummaryAccount SA,\n\tGroupSummaryAccount GSA,\n\tSummaryAccountDetail SAD,\n\tVirtualGL V,\n\tAccounts A\nWHERE \n\tGSA.GroupSummaryAccCode IN (:ai_groupsummaryacccode) AND\n\tGSA.GroupSummaryAccCode = SA.GroupSummaryAccCode AND\n\tSA.SummaryAccCode = SAD.SummaryAccCode AND\n\tSAD.AccCode = A.AccCode AND\n\tA.AccCode = V.AccCode AND\n\tV.Date BETWEEN :adt_startdate AND :adt_enddate\nGROUP BY\n\tSA.Name,\n\tA.AliasName,\n\tA.Name,\n\tCAST(ltrim(rtrim(str(datepart(mm, V.Date), 5))) + '-01-' +  ltrim(rtrim(str(datepart(yyyy, V.Date), 5))) AS DATETIME)\nUNION\nSELECT \n\tSortOrder=1,\n\tSummaryAccountName = 'NON-SUMMARY A/C',\n\tAliasName = A.AliasName,\n\tAccountName = A.Name,\n\tMonth = CAST(ltrim(rtrim(str(datepart(mm, V.Date), 5))) + '-01-' +  ltrim(rtrim(str(datepart(yyyy, V.Date), 5))) AS DATETIME),\n\tAmount=SUM(V.Debit-V.Credit)\nFROM \n\tVirtualGL V,\n\tAccounts A\nWHERE \n\tA.AccCode IN (:ai_acccode) AND\n\tA.AccCode = V.AccCode AND\n\tV.Date BETWEEN :adt_startdate AND :adt_enddate\nGROUP BY\n\tA.AliasName,\n\tA.Name,\n\tCAST(ltrim(rtrim(str(datepart(mm, V.Date), 5))) + '-01-' +  ltrim(rtrim(str(datepart(yyyy, V.Date), 5))) AS DATETIME)\nORDER BY\n\tSortOrder,\n\tMonth,\n\tSummaryAccountName,\n\tAccountName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_groupsummaryacccode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_acccode",
      "numberlist"
     ]
    },
    {
