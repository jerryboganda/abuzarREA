    "dbname": "Collection"
   }
  ],
  "retrieve": "SELECT \n\tAccount = (SELECT A.Name FROM Accounts A WHERE A.AccCode = T.AccCode),\n\tS.SchoolBranch,\n\tS.ClassName,\n\tS.RegNo,\n\tS.Name,\n\tCollection=SUM(T.Collection)\nFROM\n\t(SELECT S.StudentCode, S.RegNo, S.Name, S.CurrentClass,  ClassName=C.Name, B.SchoolBranchCode, SchoolBranch=B.Name\n\tFROM \n\t\tStudent S, SchoolBranch B, Class C\n\tWHERE \n\t\tB.SchoolBranchCode = C.SchoolBranchCode AND\n\t\tC.ClassCode = S.CurrentClass) S,\n\t(SELECT /*Transaction Details debit=credit and credit=debit*/\n\t\th.acccode,\n\t\td.studentcode,\n\t\tCollection=d.credit - d.debit\n\tFROM\n\t\tglheader h,\n\t\tgldetail d,\n\t\tvochercategory vc,\n\t\taccounts a\n\tWHERE\n\t\th.posted = 'Y' and\n\t\th.glvochcode = d.glvochcode and\n\t\th.vochcatcode = vc.vochcatcode and\n\t\tvc.journalvoucher = 0 and\n\t\th.acccode in (:ai_acccode) and\n\t\th.acccode <> d.acccode and \n\t\td.acccode = a.acccode and\n\t\th.date BETWEEN :ad_StartDate and :ad_endDate\n\tUNION ALL\n\tSELECT /*transaction involving cash in detail but not a cash voucher category*/\n\t\th.acccode,\n\t\td.studentcode,\n\t\tCollection=d.debit - d.credit\n\tFROM\n\t\tglheader h,\n\t\tgldetail d,\n\t\tvochercategory vc,\n\t\taccounts a\n\tWHERE\n\t\th.posted = 'Y' and\n\t\th.glvochcode = d.glvochcode and\n\t\th.vochcatcode = vc.vochcatcode and\n\t\tvc.journalvoucher = 0 and\n\t\th.acccode not in (:ai_acccode) and\n\t\td.acccode in (:ai_acccode) and\n\t\td.acccode = a.acccode and\n\t\th.date BETWEEN :ad_StartDate and :ad_endDate\n\tUNION ALL\n\tSELECT /*transaction involving cash deposited in a cash a/c from another cash a/c*/\n\t\th.acccode,\n\t\td.studentcode,\n\t\tCollection=d.debit - d.credit\n\tFROM\n\t\tglheader h,\n\t\tgldetail d,\n\t\tvochercategory vc,\n\t\taccounts a\n\tWHERE\n\t\th.posted = 'Y' and\n\t\th.glvochcode = d.glvochcode and\n\t\th.vochcatcode = vc.vochcatcode and\n\t\tvc.journalvoucher = 0 and\n\t\th.acccode in (:ai_acccode) and\n\t\td.acccode in (:ai_acccode) and\n\t\th.acccode <> d.acccode and\n\t\td.acccode = a.acccode and\n\t\th.date BETWEEN :ad_StartDate and :ad_endDate\n\tUNION ALL\n\tSELECT /*debit/credit adjustment for cash/bank accounts using JVs*/\n\t\tacc=d.acccode,\n\t\td.studentcode,\n\t\tCollection=d.debit - d.credit\n\tFROM\n\t\tglheader h,\n\t\tgldetail d,\n\t\tvochercategory vc\n\tWHERE\n\t\th.posted = 'Y' and\n\t\th.glvochcode = d.glvochcode and\n\t\th.vochcatcode = vc.vochcatcode and\n\t\tvc.journalvoucher = 1 and\n\t \td.acccode IN (:ai_acccode) and \n\t\th.date BETWEEN :ad_StartDate and :ad_endDate\n\tUNION ALL\n\tSELECT \n\t\tacccode=s.paymentacccode ,\n\t\ts.studentcode,\n\t\tCollection = ISNULL(SUM(S.Amt), 0)\n\tFROM\n\t\t(SELECT h.paymentacccode, h.studentcode, amt=ISNULL(Round(SUM(d.looseqty * d.unitsalestax) + \n\t\t\t\tSUM(ROUND( (d.looseqty * \n\t\t\t\t\t(d.saleprice - d.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * d.discperc)) * \n\t\t\t\t\td.gstperc * .01, 2)) +\n\t\t\t\tROUND( (SUM((d.looseqty * \n\t\t\t\t\t(d.saleprice - d.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) -\n\t\t\t\t\th.flatdisc) * (h.invgstperc1 * .01), 2), 0) +\n\t\t\t\tRound( SUM((d.looseqty * (d.saleprice - d.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + \n\t\t\t\t\th.misccharges + h.salestax - h.flatdisc, 0), 0)\n\t\tFROM\n\t\t\tsaleledger h,\n\t\t\tsaledetail d\n\t\tWHERE\n\t\t\th.saleinvcode = d.saleinvcode and\n\t\t\th.salecatcode = 3 and\n\t\t\th.paymentacccode IN (:ai_acccode) AND\n\t\t\th.posted = 'Y' and \n\t\t\th.accountfor='Y' and\n\t\t\th.date BETWEEN :ad_StartDate and :ad_endDate\n\t\tGROUP BY \n\t\t\t h.paymentacccode, h.studentcode,\n\t\t\t h.saleinvcode,\n\t\t\t h.salecatcode, \n\t\t\t h.date,\n\t\t\t h.discperc,\n\t\t\t h.misccharges,\n\t\t\t h.salestax,\n\t\t\t h.InvGSTPerc1,\n\t\t\t h.flatdisc) S \n\tGROUP BY\n\t\ts.paymentacccode ,\n\t\ts.studentcode\n\tHAVING SUM(S.Amt) <> 0\n\tUNION ALL\n\tSELECT \n\t\tacccode=s.paymentacccode ,\n\t\ts.studentcode,\n\t\tCollection = ISNULL(SUM(S.Amt), 0)\n\tFROM\n\t\t(SELECT h.paymentacccode, h.studentcode, amt=ISNULL(Round(SUM(d.looseqty * d.unitsalestax) + \n\t\t\t\tSUM(ROUND( (d.looseqty * \n\t\t\t\t\t(d.saleprice - d.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * d.discperc)) * \n\t\t\t\t\td.gstperc * .01, 2)) +\n\t\t\t\tROUND( (SUM((d.looseqty * \n\t\t\t\t\t(d.saleprice - d.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) -\n\t\t\t\t\th.flatdisc) * (h.invgstperc1 * .01), 2), 0) +\n\t\t\t\tRound( SUM((d.looseqty * (d.saleprice - d.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + \n\t\t\t\t\th.misccharges + h.salestax - h.flatdisc, 0), 0)\n\t\tFROM\n\t\t\tsaleledger h,\n\t\t\tsaledetail d\n\t\tWHERE\n\t\t\th.saleinvcode = d.saleinvcode and\n\t\t\th.salecatcode = 1 and\n\t\t\th.paymentacccode IN (:ai_acccode) AND\n\t\t\th.posted = 'Y' and \n\t\t\th.accountfor='Y' and\n\t\t\th.date BETWEEN :ad_StartDate and :ad_endDate\n\t\tGROUP BY h.paymentacccode, h.studentcode, h.saleinvcode,\n\t\t\t h.salecatcode, \n\t\t\t h.date,\n\t\t\t h.discperc,\n\t\t\t h.misccharges,\n\t\t\t h.salestax,\n\t\t\t h.InvGSTPerc1,\n\t\t\t h.flatdisc) S \n\tGROUP BY\n\t\ts.paymentacccode ,\n\t\ts.studentcode\n\tHAVING SUM(S.Amt) > 0\n\tUNION ALL\n\tSELECT \n\t\tacccode=s.paymentacccode ,\n\t\ts.studentcode,\n\t\tCollection = - ISNULL(SUM(S.Amt), 0)\n\tFROM\n\t\t(SELECT h.paymentacccode, h.studentcode, amt=ISNULL(sum(amt), 0)\n\t\tFROM\n\t\t\tsaleledger h\n\t\tWHERE\n\t\t\th.salecatcode IN (1, 2) and\n\t\t\th.amt <> 0 and\n\t\t\th.posted = 'Y' and \n\t\t\th.accountfor='Y' and\n\t\t\th.date BETWEEN :ad_StartDate and :ad_endDate AND\n\t\t\th.paymentacccode in (:ai_acccode)\n\t\tGROUP BY h.paymentacccode, h.studentcode) S\n\tGROUP BY\n\t\ts.paymentacccode ,\n\t\ts.studentcode\n\tHAVING SUM(S.Amt) > 0\n\tUNION ALL\n\tSELECT \n\t\tacccode=s.paymentacccode,\n\t\ts.studentcode, \n\t\tCollection = - ISNULL(SUM(S.Amt), 0)\n\tFROM\n\t\t(SELECT h.paymentacccode, h.studentcode, amt=ISNULL(Round(SUM(d.looseqty * d.unitsalestax) + \n\t\t\t\tSUM(ROUND( (d.looseqty * d.srprice) * (1 - (.01 * d.discperc)) * d.gstperc * .01, 2)) +\n\t\t\t\tROUND( (SUM((d.looseqty * d.srprice) * \t(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) - h.flatdisc) * (h.invgstperc1 * .01), 2), 0) +\n\t\t\t\tRound( SUM((d.looseqty * d.srprice) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges + h.salestax - h.flatdisc, 0), 0)\n\t\tFROM\n\t\t\tsrledger h,\n\t\t\tsrdetail d\n\t\tWHERE\n\t\t\th.srinvcode = d.srinvcode and\n\t\t\th.srcatcode = 8 and\n\t\t\th.paymentacccode IN (:ai_acccode) AND\n\t\t\th.posted = 'Y' and\n\t\t\th.accountfor = 'Y' and\n\t\t\th.date BETWEEN :ad_StartDate and :ad_endDate\n\t\tGROUP BY h.srinvcode, h.paymentacccode, h.studentcode, \n\t\t\t h.srcatcode, \n\t\t\t h.date,\n\t\t\t h.discperc,\n\t\t\t h.misccharges,\n\t\t\t h.salestax,\n\t\t\t h.InvGSTPerc1,\n\t\t\t h.flatdisc) S \n\tGROUP BY\n\t\ts.paymentacccode ,\n\t\ts.studentcode\n\tHAVING SUM(S.Amt) > 0\n\tUNION ALL\n\tSELECT \n\t\tacccode=s.paymentacccode, s.studentcode, \n\t\tCollection = - ISNULL(SUM(S.Amt), 0)\n\tFROM\n\t\t(SELECT h.paymentacccode, h.studentcode, amt=ISNULL(Round(SUM(d.looseqty * d.unitsalestax) + \n\t\t\t\tSUM(ROUND( (d.looseqty * d.srprice) * (1 - (.01 * d.discperc)) * d.gstperc * .01, 2)) +\n\t\t\t\tROUND( (SUM((d.looseqty * d.srprice) * \t(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) - h.flatdisc) * (h.invgstperc1 * .01), 2), 0) +\n\t\t\t\tRound( SUM((d.looseqty * d.srprice) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges + h.salestax - h.flatdisc, 0), 0)\n\t\tFROM\n\t\t\tsrledger h,\n\t\t\tsrdetail d\n\t\tWHERE\n\t\t\th.srinvcode = d.srinvcode and\n\t\t\th.srcatcode = 6 and\n\t\t\th.paymentacccode IN (:ai_acccode) AND\n\t\t\th.posted = 'Y' and \n\t\t\th.accountfor='Y' and\n\t\t\th.date BETWEEN :ad_StartDate and :ad_endDate\n\t\tGROUP BY h.paymentacccode, h.studentcode, h.srinvcode,\n\t\t\t h.srcatcode, \n\t\t\t h.date,\n\t\t\t h.discperc,\n\t\t\t h.misccharges,\n\t\t\t h.salestax,\n\t\t\t h.InvGSTPerc1,\n\t\t\t h.flatdisc) S \n\tGROUP BY\n\t\ts.paymentacccode ,\n\t\ts.studentcode\n\tHAVING SUM(S.Amt) > 0\n\tUNION ALL\n\tSELECT \n\t\tacccode=s.paymentacccode, \n\t\ts.studentcode, \n\t\tCollection = - ISNULL(SUM(S.Amt), 0)\n\tFROM\n\t\t(SELECT h.paymentacccode, h.studentcode, amt=ISNULL(SUM(h.amt), 0)\n\t\tFROM\n\t\t\tsrledger h\n\t\tWHERE\n\t\t\th.srcatcode IN (6,7) and\n\t\t\th.posted = 'Y' and \n\t\t\th.accountfor='Y' and\n\t\t\th.date BETWEEN :ad_StartDate and :ad_endDate AND\n\t\t\th.paymentacccode in (:ai_acccode)\n\t\tGROUP BY h.paymentacccode, h.studentcode) S\n\tGROUP BY\n\t\ts.paymentacccode ,\n\t\ts.studentcode\n\tHAVING SUM(S.Amt) > 0\n\tUNION ALL\n\tSELECT \n\t\tacccode=h.CashAccCode, \n\t\th.studentcode, \n\t\tCollection = CASE WHEN H.ServiceCatCode = 10 THEN H.InvTotal ELSE H.CashCharged END\n\tFROM\n\t\tserviceheader h\n\tWHERE\n\t\t(h.CashCharged > 0 OR H.ServiceCatCode = 10) and\n\t\th.cashacccode in (:ai_acccode) AND\n\t\th.posted = 'Y' and\n\t\th.date BETWEEN :ad_StartDate and :ad_endDate\n\tUNION ALL\n\tSELECT \n\t\tacccode=h.CashAccCode, \n\t\th.studentcode, \n\t\tCollection = CASE WHEN H.ServiceRCatCode = 13 THEN H.InvTotal ELSE H.CashCharged END\n\tFROM\n\t\tservicerheader h\n\tWHERE\n\t\t(h.CashCharged > 0 OR H.ServiceRCatCode = 13) and\n\t\th.cashacccode in (:ai_acccode) AND\n\t\th.posted = 'Y' and\n\t\th.date BETWEEN :ad_StartDate and :ad_endDate) T\nWHERE\n\tS.StudentCode = T.StudentCode\nGROUP BY\n\tT.AccCode,\n\tS.StudentCode,\n\tS.RegNo,\n\tS.Name,\n\tS.ClassName,\n\tS.SchoolBranch\nORDER BY \n\tAccount,\n\tS.SchoolBranch,\n\tS.ClassName,\n\tS.Name,\n\tS.RegNo\n",
  "arguments": {
