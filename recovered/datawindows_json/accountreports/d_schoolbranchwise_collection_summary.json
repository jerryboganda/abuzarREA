   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "collection",
    "dbname": "Collection"
   }
  ],
  "retrieve": "SELECT \t\n\tSchoolBranch=S.SchoolBranch, \n\tStudentCode=S.StudentCode, \n\tRegNo = S.RegNo,\n\tStudentName=S.Name, \n\tNetRevenue=SUM(CASE WHEN DocumentType IN ('RS','SV') THEN V.Debit WHEN DocumentType IN ('SR','RR') THEN - (V.Credit) ELSE 0 END),\n\tCollection=SUM(CASE WHEN Credit > 0 AND DocumentType NOT IN ('SR','RR') THEN V.Credit WHEN V.Debit > 0 AND DocumentType IN ('SR','RR') THEN - V.Debit ELSE 0 END)\nFROM\n\tVirtualGL V,\n\t(SELECT S.StudentCode, S.RegNo, S.Name, S.CurrentClass,  ClassName=C.Name, B.SchoolBranchCode, SchoolBranch=B.Name\n\tFROM \n\t\tStudent S, SchoolBranch B, Class C\n\tWHERE \n\t\tB.SchoolBranchCode IN (:ai_SchoolBranchCode) AND \n\t\tB.SchoolBranchCode = C.SchoolBranchCode AND\n\t\tC.ClassCode = S.CurrentClass) S\nWHERE \n\tV.Date BETWEEN :adt_StartDate AND :adt_EndDate AND\n\tV.StudentCode = S.StudentCode AND\n\t(V.AccCode IN (SELECT A.AccCode FROM Accounts A WHERE A.SubCode = 3) OR\n\tISNULL(V.AlternateAccCode,-1) IN (SELECT A.AccCode FROM Accounts A WHERE A.SubCode = 3))\nGROUP BY\n\tS.SchoolBranch, S.StudentCode, S.RegNo, S.Name\nORDER BY\n\tSchoolBranch, S.Name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_schoolbranchcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
