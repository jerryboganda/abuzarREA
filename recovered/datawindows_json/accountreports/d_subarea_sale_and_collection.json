  "retrieve": "SELECT \n\tSubAreaCode=C.SubAreaCode,\n\tSubArea=S.Name,\n\tAccCode=A.AccCode,\n\tAliasName=A.AliasName,\n\tCustomer=A.Name, \n\tAddress1=C.Address1,\n\tAccountBalance=ISNULL(SUM(NS.Balance), 0),\n\tOverDueBalance=ISNULL(SUM(NS.ODBalance), 0),\n\tAmtCollected= ISNULL(SUM(NS.Collection), 0),\n\tLastCollectionDate=MAX(NS.CollectionDate),\n\tNetSale=ISNULL(Sum(NS.NetSale), 0),\n\tNetSaleVolume=ISNULL(Sum(NS.Volume), 0),\n\tLastInvDate = NS.SaleDate\nFROM \n\tSubArea S, Customer C,\n\tAccounts A\n\tLEFT OUTER JOIN \n\t(SELECT\n\t\tS.CustCode,\n\t\tSaleDate=Max(S.Date),\n\t\tNetSale=SUM(S.Sale),\n\t\tVolume=SUM(S.Volume),\n\t\tBalance = SUM(S.Balance),\n\t\tODBalance= SUM(S.ODBalance),\n\t\tCollection = SUM(S.Collection),\n\t\tCollectionDate = MAX(S.CollectionDate)\n\tFROM\n\t\t(SELECT\n\t\t\tS.CustCode,\n\t\t\tInvCode=Max(S.SaleInvCode),\n\t\t\tDate=Max(S.Date),\n\t\t\tVolume = 0,\n\t\t\tSale=SUM(S.InvTotal),\n\t\t\tBalance = 0.00,\n\t\t\tODBalance=0,\n\t\t\tCollection=0,\n\t\t\tCollectionDate=NULL\n\t\tFROM\n\t\t\tSaleLedger S, Customer C\n\t\tWHERE \n\t\t\tS.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\t\t\tS.CustCode = C.CustCode AND\n\t\t\tC.SubAreaCode IN (:ai_subareacode)\n\t\tGROUP BY\n\t\t\tS.CustCode\n\t\tUNION ALL\n\t\tSELECT\n\t\t\tS.CustCode,\n\t\t\tInvCode=Max(S.SaleInvCode),\n\t\t\tDate=Max(S.Date),\n\t\t\tVolume = 0,\n\t\t\tSale=-SUM(S.InvTotal),\n\t\t\tBalance = 0.00,\n\t\t\tODBalance=0,\n\t\t\tCollection=0,\n\t\t\tCollectionDate=NULL\n\t\tFROM\n\t\t\tSRLedger S, Customer C\n\t\tWHERE \n\t\t\tS.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\t\t\tS.CustCode = C.CustCode AND\n\t\t\tC.SubAreaCode IN (:ai_subareacode)\n\t\tGROUP BY\n\t\t\tS.CustCode\n\t\tUNION ALL\n\t\tSELECT\n\t\t\tS.CustCode,\n\t\t\tInvCode=NULL,\n\t\t\tDate=Null,\n\t\t\tVolume = SUM(SD.LooseQty * I.PackingFactor),\n\t\t\tSale=0,\n\t\t\tBalance = 0.00,\n\t\t\tODBalance=0,\n\t\t\tCollection=0,\n\t\t\tCollectionDate=NULL\n\t\tFROM\n\t\t\tSaleLedger S, SaleDetail SD, Customer C, Item I\n\t\tWHERE \n\t\t\tS.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\t\t\tS.SaleInvCode = SD.SaleInvCode AND\n\t\t\tSD.ICode = I.ICode AND\n\t\t\tS.CustCode = C.CustCode AND\n\t\t\tC.SubAreaCode IN (:ai_subareacode)\n\t\tGROUP BY\n\t\t\tS.CustCode\n\t\tUNION ALL\n\t\tSELECT\n\t\t\tS.CustCode,\n\t\t\tInvCode=NULL,\n\t\t\tDate=Null,\n\t\t\tVolume = - SUM(SD.LooseQty * I.PackingFactor),\n\t\t\tSale=0,\n\t\t\tBalance = 0.00,\n\t\t\tODBalance=0,\n\t\t\tCollection=0,\n\t\t\tCollectionDate=NULL\n\t\tFROM\n\t\t\tSRLedger S, SRDetail SD, Customer C, Item I\n\t\tWHERE \n\t\t\tS.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\t\t\tS.SRInvCode = SD.SRInvCode AND \n\t\t\tSD.ICode = I.ICode AND\n\t\t\tS.CustCode = C.CustCode AND\n\t\t\tC.SubAreaCode IN (:ai_subareacode)\n\t\tGROUP BY\n\t\t\tS.CustCode\n\t\tUNION ALL\n\t\tSELECT \n\t\t\tCustCode=C.CustCode, \n\t\t\tInvCode= NULL,\n\t\t\tDate = NULL,\n\t\t\tVolume=0,\n\t\t\tSale = 0,\n\t\t\tBalance=ISNULL(SUM(V.Debit - V.Credit),0),\n\t\t\tODBalance=0,\n\t\t\tCollection=0,\n\t\t\tCollectionDate=NULL\n\t\tFROM \n\t\t\tCustomer C\n\t\t\tLEFT OUTER JOIN VirtualGL AS V ON (C.CustCode = V.AccCode)\n\t\tWHERE \n\t\t\tC.SubAreaCode IN (:ai_subareacode) AND\n\t\t\tV.Date <= :ad_enddate\n\t\tGROUP BY \n\t\t\tC.CustCode\n\t\tUNION ALL\n\t\tSELECT \n\t\t\tCustCode=C.CustCode, \n\t\t\tInvCode= NULL,\n\t\t\tDate = NULL,\n\t\t\tVolume=0,\n\t\t\tSale = 0,\n\t\t\tBalance=0,\n\t\t\tODBalance=ISNULL((SELECT SUM(R.Value1) FROM ReportData R WHERE R.Code1 = C.CustCode), 0),\n\t\t\tCollection=0,\n\t\t\tCollectionDate=NULL\n\t\tFROM \n\t\t\tCustomer C\n\t\tWHERE \n\t\t\tC.SubAreaCode IN (:ai_subareacode)\n\t\tUNION ALL\n\t\tSELECT \n\t\t\tCustCode=C.CustCode, \n\t\t\tInvCode= NULL,\n\t\t\tDate = NULL,\n\t\t\tVolume=0,\n\t\t\tSale = 0,\n\t\t\tBalance=0,\n\t\t\tODBalance=0,\n\t\t\tCollection=SUM(GG.Credit),\n\t\t\tCollectionDate=MAX(CASE WHEN GL.VochCatCode = 2 THEN GL.Date ELSE NULL END)\n\t\tFROM \n\t\t\tGLDetail GG, GLHeader GL, Customer C\n\t\tWHERE \n\t\t\tC.SubAreaCode IN (:ai_subareacode) AND\n\t\t\tGG.AccCode = C.CustCode AND\n\t\t\tGG.Credit <> 0 AND\n\t\t\tGL.Posted = 'Y' AND \n\t\t\tGL.Date BETWEEN :ad_startdate AND :ad_enddate AND \n\t\t\tGG.GLVochcode = GL.GLVochCode\n\t\tGROUP BY \n\t\t\tC.CustCode) S\n\tGROUP BY S.CustCode) AS NS ON (A.AccCode = NS.CustCode)\nWHERE \n\tS.subareacode IN (:ai_subareacode) AND\n\tC.subareacode = S.subareacode AND\n\tC.CustCode = A.AccCode\nGROUP BY\n\tC.subareacode,\n\tS.Name,\n\tA.AccCode,\n\tA.AliasName,\n\tA.Name,\n\tC.Address1,\n\tNS.SaleDate\nORDER BY SubArea, Customer\n",
  "arguments": {
