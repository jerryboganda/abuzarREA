    "name": "studentname",
    "dbname": "StudentName"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "netrevenue",
    "dbname": "NetRevenue"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "collection",
    "dbname": "Collection"
   }
  ],
  "retrieve": "SELECT \t\n\tService=SV.Name, \n\tStudentCode=S.StudentCode, \n\tRegNo = S.RegNo,\n\tStudentName=S.Name, \n\tNetRevenue=SUM(RC.NetRevenue),\n\tCollection=SUM(RC.Collection)\nFROM\n\tStudent S, Service SV, \n\t(SELECT \n\t\tSD.ServiceCode,\n\t\tSH.ServiceinvCode,\n\t\tSH.StudentCode,\n\t\tNetRevenue = SUM(SD.Qty * (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SH.DiscPerc * 0.01)),\n\t\tCollection=0\n\tFROM\n\t\tServiceHeader SH, ServiceDetail SD\n\tWHERE\n\t\tSH.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSH.StudentCode IS NOT NULL AND\n\t\tSH.ServiceInvCode = SD.ServiceInvCode AND\n\t\tSD.ServiceCode IN (:ai_servicecode)\n\tGROUP BY\n\t\tSH.ServiceinvCode,\n\t\tSH.StudentCode,\n\t\tSD.ServiceCode\n\tUNION ALL\n\tSELECT \n\t\tSD.ServiceCode,\n\t\tSH.ServiceinvCode,\n\t\tSH.StudentCode,\n\t\tNetRevenue = -SUM(SD.Qty * (SD.ServicePrice - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SH.DiscPerc * 0.01)),\n\t\tCollection=0\n\tFROM\n\t\tServiceRHeader SH, ServiceRDetail SD\n\tWHERE\n\t\tSH.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSH.StudentCode IS NOT NULL AND\n\t\tSH.ServiceRInvCode = SD.ServiceRInvCode AND\n\t\tSD.ServiceCode IN (:ai_servicecode)\n\tGROUP BY\n\t\tSH.ServiceinvCode,\n\t\tSH.StudentCode,\n\t\tSD.ServiceCode\n\tUNION ALL\n\tSELECT \n\t\tServiceCode=D.ServiceCode,\n\t\tV.InvoiceCode,\n\t\tV.StudentCode,\n\t\tNetRevenue = 0,\n\t\tCollection=SUM(CASE WHEN Credit > 0 THEN V.Credit ELSE 0 END)\n\tFROM\n\t\tVirtualGL V, ServiceDetail D, ServiceHeader S\n\tWHERE\n\t\tV.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tV.StudentCode IS NOT NULL AND\n\t\tV.Credit > 0 AND\n\t\tV.InvoiceCode > 0 AND\n\t\t(V.AccCode IN (SELECT A.AccCode FROM Accounts A WHERE A.SubCode = 3) OR\n\t\tISNULL(V.AlternateAccCode,-1) IN (SELECT A.AccCode FROM Accounts A WHERE A.SubCode = 3)) AND\n\t\t(V.DocumentType IN ('RS') OR\n\t\tV.DocumentType IN (SELECT VC.ShortName FROM VocherCategory VC WHERE VC.InvoiceType=3)) AND\n\t\tV.InvoiceCode = S.ServiceInvCode AND\n\t\tV.InvoiceCode = D.ServiceInvCode AND\n\t\tS.ServiceInvCode = D.ServiceInvCode AND \n\t\tS.Outstandingamt = 0 AND\n\t\tD.ServiceCode IN (:ai_servicecode)\n\tGROUP BY\n\t\tV.InvoiceCode,\n\t\tV.StudentCode,\n\t\tD.ServiceCode) RC\nWHERE\n\tS.StudentCode = RC.StudentCode AND\n\tSV.ServiceCode = RC.ServiceCode\nGROUP BY\n\tSV.Name, \n\tS.StudentCode, \n\tS.RegNo,\n\tS.Name\nORDER BY\n\tService,\n\tStudentName\n",
  "arguments": {
   "_items": [
