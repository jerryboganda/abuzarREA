  "retrieve": "SELECT  \n\tAreaCode=Code1,\n\tCustCode=Code2,\n\tAreaName=Name1, \n\tAliasName=Name2,\n\tCustomerName=Name3,\n\tAddress=Name4,\n\tSalePerson=(SELECT S.Name FROM SalesMan S WHERE S.SalesmanCode = :ai_salesmancode),\n\tCurrentBalance = Value3,\n\tBeforeDueDays = Value1,\n\tAfterDueDays = Value2,\n\tTotalDue= Value1 + Value2,\n\tLastCollectionDate=\n\t\t(SELECT Gl.date\n\t\tFROM GLDetail GG, GLHeader GL\n\t\tWHERE \n\t\tGG.GLVochcode = GL.GLVochCode AND\n\t\tGG.GLRowID IN \n\t\t\t(SELECT MAX(GD.GLRowID) \n\t\t\tFROM GlDetail GD, GlHeader G\n\t\t\tWHERE GD.AccCode = Code2 AND \n\t\t\t\tG.Posted = 'Y' AND \n\t\t\t\tG.VochCatCode=2 AND \n\t\t\t\tG.GlVochCode = GD.GLVochCode)),\n\tLastCollectionAmt=\n\t\t(SELECT GG.Credit\n\t\tFROM GLDetail GG WHERE \n\t\tGG.GLRowID IN \n\t\t\t(SELECT MAX(GD.GLRowID) \n\t\t\tFROM GlDetail GD, GlHeader G\n\t\t\tWHERE GD.AccCode = Code2 AND \n\t\t\t\tG.Posted = 'Y' AND \n\t\t\t\tG.VochCatCode=2 AND \n\t\t\t\tG.GlVochCode = GD.GLVochCode))\nFROM ReportData\nORDER BY\n\tSalePerson,\n\tAreaName,\n\tCustomerName\n",
  "arguments": {
