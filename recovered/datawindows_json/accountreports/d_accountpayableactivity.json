  "retrieve": "SELECT\tSNO=1,\n\tREMARKS='OPENING BALANCE OF A/P ON : ' + rtrim(ltrim(convert(varchar(50), :ar_startdate))),\n\tCOMPUTABLE='N',\n\tSUBAMT=0, \n\tNETAMT = ISNULL(SUM(DEBIT-CREDIT), 0)\nFROM VIRTUALGL\nWHERE ACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND DATE < :ar_startdate\nUNION ALL\nSELECT\tSNO=2,\n\tREMARKS='TOTAL PURCHASES DURING THE PERIOD',\n\tCOMPUTABLE='N',\n\tSUBAMT= ISNULL(SUM(DEBIT-CREDIT), 0),\n\tNETAMT = 0\nFROM VIRTUALGL\nWHERE \tACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND \n\tDATE >= :ar_startdate AND DATE <= :ar_enddate AND\n\tDOCUMENTTYPE='PV'\nUNION ALL\nSELECT\tSNO=3,\n\tREMARKS='TOTAL PURCHASES RETURNS DURING THE PERIOD',\n\tCOMPUTABLE='N',\n\tSUBAMT= ISNULL(SUM(DEBIT-CREDIT), 0),\n\tNETAMT = 0\nFROM VIRTUALGL\nWHERE \tACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND \n\tDATE >= :ar_startdate AND DATE <= :ar_enddate AND\n\tDOCUMENTTYPE='PR'\nUNION ALL\nSELECT\tSNO=4,\n\tREMARKS='NET PURCHASES DURING THE PERIOD',\n\tCOMPUTABLE='N',\n\tSUBAMT= 0,\n\tNETAMT = ISNULL(SUM(DEBIT-CREDIT), 0)\nFROM VIRTUALGL\nWHERE \tACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND \n\tDATE >= :ar_startdate AND DATE <= :ar_enddate AND\n\tDOCUMENTTYPE IN ('PV', 'PR')\nUNION ALL\nSELECT\tSNO=5,\n\tREMARKS='TOTAL A/P FOR THE PERIOD',\n\tCOMPUTABLE='Y',\n\tSUBAMT=0,\n\tNETAMT =0\nUNION ALL\nSELECT\tSNO=6,\n\tREMARKS='TOTAL CASH PAYMENTS DURING THE PERIOD',\n\tCOMPUTABLE='N',\n\tSUBAMT=0,\n\tNETAMT = ISNULL(SUM(D.DEBIT-D.CREDIT), 0)\nFROM GLHEADER H, GLDETAIL D, VOCHERCATEGORY VC\nWHERE H.GLVOCHCODE = D.GLVOCHCODE AND\n\tH.DATE >= :ar_startdate AND H.DATE <= :ar_enddate AND\n\tD.ACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND \n\tH.VOCHCATCODE = VC.VOCHCATCODE AND\n\tVC.JOURNALVOUCHER = 0 AND \n\tD.CREDIT > 0 AND\n\tH.AccCode IN \n\t\t(SELECT ACCCODE FROM ACCOUNTS \n\t\tWHERE SUBCODE IN \n\t\t\t(SELECT CODE FROM GLOBAL WHERE NAME='GT_CashSub'))\nUNION ALL\nSELECT\tSNO=7,\n\tREMARKS='TOTAL A/P AFTER CASH PAYMENTS',\n\tCOMPUTABLE='Y',\n\tSUBAMT=0,\n\tNETAMT =0\nUNION ALL\nSELECT\tSNO=8,\n\tREMARKS='TOTAL BANK PAYMENTS DURING THE PERIOD',\n\tCOMPUTABLE='N',\n\tSUBAMT=0,\n\tNETAMT = ISNULL(SUM(D.DEBIT-D.CREDIT), 0)\nFROM GLHEADER H, GLDETAIL D, VOCHERCATEGORY VC\nWHERE H.GLVOCHCODE = D.GLVOCHCODE AND\n\tH.DATE >= :ar_startdate AND H.DATE <= :ar_enddate AND\n\tD.ACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND \n\tH.VOCHCATCODE = VC.VOCHCATCODE AND\n\tVC.JOURNALVOUCHER = 0 AND \n\tD.CREDIT > 0 AND\n\tH.AccCode IN \n\t\t(SELECT ACCCODE FROM ACCOUNTS \n\t\tWHERE SUBCODE IN \n\t\t\t(SELECT CODE FROM GLOBAL WHERE NAME='GT_BankSub'))\nUNION ALL\nSELECT\tSNO=9,\n\tREMARKS='TOTAL A/P AFTER BANK PAYMENTS',\n\tCOMPUTABLE='Y',\n\tSUBAMT=0,\n\tNETAMT =0\nUNION ALL\nSELECT\tSNO=10,\n\tREMARKS='TOTAL NOTES PAYABLES DURING THE PERIOD',\n\tCOMPUTABLE='N',\n\tSUBAMT=0,\n\tNETAMT = ISNULL(SUM(DEBIT-CREDIT), 0)\nFROM VIRTUALGL\nWHERE ACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND \n\tDATE >= :ar_startdate AND DATE <= :ar_enddate AND\n\tDOCUMENTTYPE='NP'\nUNION ALL\nSELECT\tSNO=11,\n\tREMARKS='TOTAL A/P AFTER NOTES PAYABLES',\n\tCOMPUTABLE='Y',\n\tSUBAMT=0,\n\tNETAMT =0\nUNION ALL\nSELECT\tSNO=12,\n\tREMARKS='TOTAL CASH RECEIPTS DURING THE PERIOD',\n\tCOMPUTABLE='N',\n\tSUBAMT=0,\n\tNETAMT = ISNULL(SUM(D.DEBIT-D.CREDIT), 0)\nFROM GLHEADER H, GLDETAIL D, VOCHERCATEGORY VC\nWHERE H.GLVOCHCODE = D.GLVOCHCODE AND\n\tH.DATE >= :ar_startdate AND H.DATE <= :ar_enddate AND\n\tD.ACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND \n\tH.VOCHCATCODE = VC.VOCHCATCODE AND\n\tVC.JOURNALVOUCHER = 0 AND \n\tD.DEBIT > 0 AND\n\tH.AccCode IN \n\t\t(SELECT ACCCODE FROM ACCOUNTS \n\t\tWHERE SUBCODE IN \n\t\t\t(SELECT CODE FROM GLOBAL WHERE NAME='GT_CashSub'))\nUNION ALL\nSELECT\tSNO=13,\n\tREMARKS='TOTAL A/P AFTER CASH RECEIPTS',\n\tCOMPUTABLE='Y',\n\tSUBAMT=0,\n\tNETAMT =0\nUNION ALL\nSELECT\tSNO=14,\n\tREMARKS='TOTAL BANK RECEIPTS DURING THE PERIOD',\n\tCOMPUTABLE='N',\n\tSUBAMT=0,\n\tNETAMT = ISNULL(SUM(D.DEBIT-D.CREDIT), 0)\nFROM GLHEADER H, GLDETAIL D, VOCHERCATEGORY VC\nWHERE H.GLVOCHCODE = D.GLVOCHCODE AND\n\tH.DATE >= :ar_startdate AND H.DATE <= :ar_enddate AND\n\tD.ACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND \n\tH.VOCHCATCODE = VC.VOCHCATCODE AND\n\tVC.JOURNALVOUCHER = 0 AND \n\tD.DEBIT > 0 AND\n\tH.AccCode IN \n\t\t(SELECT ACCCODE FROM ACCOUNTS \n\t\tWHERE SUBCODE IN \n\t\t\t(SELECT CODE FROM GLOBAL WHERE NAME='GT_BankSub'))\nUNION ALL\nSELECT\tSNO=15,\n\tREMARKS='TOTAL A/P AFTER BANK RECEIPTS',\n\tCOMPUTABLE='Y',\n\tSUBAMT=0,\n\tNETAMT =0\nUNION ALL\nSELECT\tSNO=16,\n\tREMARKS='TOTAL DEBIT ADJUSTMENTS DURING THE PERIOD',\n\tCOMPUTABLE='N',\n\tSUBAMT=0,\n\tNETAMT = ISNULL(SUM(NETAMT), 0)\nFROM\n\t(SELECT\tNETAMT = ISNULL(SUM(D.DEBIT-D.CREDIT), 0)\n\tFROM GLHEADER H, GLDETAIL D, VOCHERCATEGORY VC\n\tWHERE H.GLVOCHCODE = D.GLVOCHCODE AND\n\t\tH.DATE >= :ar_startdate AND H.DATE <= :ar_enddate AND\n\t\tD.ACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND \n\t\tH.VOCHCATCODE = VC.VOCHCATCODE AND\n\t\tVC.JOURNALVOUCHER = 1 AND\n\t\tD.DEBIT > 0\n\tUNION ALL\n\tSELECT\tNETAMT = ISNULL(SUM(D.DEBIT-D.CREDIT), 0)\n\tFROM GLHEADER H, GLDETAIL D, VOCHERCATEGORY VC\n\tWHERE H.GLVOCHCODE = D.GLVOCHCODE AND\n\t\tH.DATE >= :ar_startdate AND H.DATE <= :ar_enddate AND\n\t\tD.ACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND \n\t\tH.VOCHCATCODE = VC.VOCHCATCODE AND\n\t\tVC.JOURNALVOUCHER = 0 AND\n\t\tD.DEBIT > 0 AND\n\t\tH.AccCode NOT IN \n\t\t\t(SELECT ACCCODE FROM ACCOUNTS \n\t\t\tWHERE SUBCODE IN \n\t\t\t\t(SELECT CODE FROM GLOBAL WHERE NAME IN ('GT_BankSub', 'GT_CashSub')))) T\nUNION ALL\nSELECT\tSNO=17,\n\tREMARKS='TOTAL A/P AFTER DEBIT ADJUSTMENTS',\n\tCOMPUTABLE='Y',\n\tSUBAMT=0,\n\tNETAMT =0\nUNION ALL\nSELECT\tSNO=16,\n\tREMARKS='TOTAL CREDIT ADJUSTMENTS DURING THE PERIOD',\n\tCOMPUTABLE='N',\n\tSUBAMT=0,\n\tNETAMT = ISNULL(SUM(NETAMT), 0)\nFROM\n\t(SELECT\tNETAMT = ISNULL(SUM(D.DEBIT-D.CREDIT), 0)\n\tFROM GLHEADER H, GLDETAIL D, VOCHERCATEGORY VC\n\tWHERE H.GLVOCHCODE = D.GLVOCHCODE AND\n\t\tH.DATE >= :ar_startdate AND H.DATE <= :ar_enddate AND\n\t\tD.ACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND \n\t\tH.VOCHCATCODE = VC.VOCHCATCODE AND\n\t\tVC.JOURNALVOUCHER = 1 AND\n\t\tD.CREDIT > 0\n\tUNION ALL\n\tSELECT\tNETAMT = ISNULL(SUM(D.DEBIT-D.CREDIT), 0)\n\tFROM GLHEADER H, GLDETAIL D, VOCHERCATEGORY VC\n\tWHERE H.GLVOCHCODE = D.GLVOCHCODE AND\n\t\tH.DATE >= :ar_startdate AND H.DATE <= :ar_enddate AND\n\t\tD.ACCCODE IN (SELECT SUPPCODE FROM SUPPLIER) AND \n\t\tH.VOCHCATCODE = VC.VOCHCATCODE AND\n\t\tVC.JOURNALVOUCHER = 0 AND\n\t\tD.CREDIT > 0 AND\n\t\tH.AccCode NOT IN \n\t\t\t(SELECT ACCCODE FROM ACCOUNTS \n\t\t\tWHERE SUBCODE IN \n\t\t\t\t(SELECT CODE FROM GLOBAL WHERE NAME IN ('GT_BankSub', 'GT_CashSub')))) T\nUNION ALL\nSELECT\tSNO=19,\n\tREMARKS='CLOSING BALANCE OF A/P ON : ' + rtrim(ltrim(convert(varchar(50), :ar_enddate))),\n\tCOMPUTABLE='Y',\n\tSUBAMT=0,\n\tNETAMT =0\n",
