    "updatewhereclause": "yes",
    "name": "pendingcheques",
    "dbname": "PendingCheques"
   },
   {
    "type": "char(12)",
    "updatewhereclause": "yes",
    "name": "aliasname",
    "dbname": "AliasName"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "salesperson",
    "dbname": "SalesPerson"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "area",
    "dbname": "Area"
   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "areacode",
    "dbname": "AreaCode"
   }
  ],
  "retrieve": "SELECT \n\tCustomer, \n\tDrBalance=CASE WHEN Balance > 0 THEN Balance ELSE 0 END, \n\tCrBalance=CASE WHEN Balance < 0 THEN ABS(Balance) ELSE 0 END, \n\tPendingCheques = ISNULL(DBO.fn_GetAmountOfInProcessCheques(A.AccCode), 0),\n\tAliasName, \n\tSalesPerson, \n\tArea,  \n\tAreaCode\nFROM\n\n(SELECT \n\tA.AccCode, \n\tA.AliasName, \n\tCustomer=A.Name, \n\tBalance=Sum(Debit - Credit), \n\tSalesPerson=SM.Name, \n\tArea=Ar.Name, \n\tAreaCode=Ar.AreaCode\nFROM VirtualGL V,\n\t  Accounts A,\n\t  Customer C,\n\t  Salesman SM,\n\t  Area Ar\nWHERE \n\tV.Date <= :ar_Date AND \n\tV.AccCode = A.AccCode AND \n\t(A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'Y' END OR\n\tA.Restricted = CASE WHEN  :ar_restricted = 0 THEN 'N' ELSE 'N' END) AND\n\tA.AccCode = C.CustCode AND \n\tC.SalesManCode = SM.SalesManCode AND\n\tSM.SalesManCode IN (:ar_SMan) AND \n\tC.AreaCode IN (:ar_Areas) AND \n\tC.AreaCode = Ar.AreaCode\nGROUP BY A.AccCode, A.Name, A.AliasName, Ar.Name, Ar.AreaCode, SM.Name) A\nORDER BY Area, SalesPerson, Customer, AliasName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_restricted",
      "number"
     ]
    },
    {
     "_items": [
      "ar_date",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_sman",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ar_areas",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "salesperson A, area A, customer A, aliasname A"
 },
