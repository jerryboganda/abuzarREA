   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "amount",
    "dbname": "Amount"
   }
  ],
  "retrieve": "SELECT \n\tAccCode=GLDetail.AccCode,\n\tCashAccount = (SELECT A.Name FROM Accounts A WHERE A.AccCode= Glheader.AccCode),\n\tAccountName = Accounts.Name,\n\tAmount = SUM(GLDetail.Credit - GLDetail.Debit)\nFROM \n\tGLDetail,   \n\tGlheader,   \n\tAccounts  \nWHERE \n\t( GLHeader.Posted = 'Y' ) AND\n\t( GLHeader.Date BETWEEN :adt_startdate AND :adt_enddate) AND\n\t( Glheader.GLVochCode = GLDetail.GLVochCode ) AND  \n\t( Accounts.AccCode = GLDetail.AccCode ) AND  \n\t( Glheader.AccCode <> GlDetail.AccCode ) AND \n\t( Glheader.AccCode IN \n\t\t(SELECT G.CashAccCode \n\t\tFROM Groupcashaccount G \n\t\tWHERE G.GroupCode IN \n\t\t\t(SELECT GroupCode FROM UserGroups WHERE UserCode=:ai_usercode)))\nGROUP BY\n\tGlheader.AccCode,\n\tGLDetail.AccCode,\n\tAccounts.Name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_usercode",
      "number"
     ]
    }
   ]
  },
  "sort": "cashaccount A, accountname A"
 },
