  "retrieve": "SELECT \n\tsaleinvdetail.avgprice,\n\tsaleinvdetail.saleinvcode,   \n\tsaleinvdetail.icode,   \n\tsaleinvdetail.gcode,\n\tsaleinvdetail.batch,\n\tsaleinvdetail.expiry,\n\tsaleinvdetail.saleutn,\n\tsaleinvdetail.itemflatdisc,\n\tsaleinvdetail.IDENTITYCOL, \n\tsaleinvdetail.packunits,\n\tsaleinvdetail.saleprice,\n\tsaleinvdetail.rate,\n\tsaleinvdetail.SaleItemDescription,\n\tsaleinvdetail.DescICode,\n\tsaleinvdetail.discperc,\n\tsaleinvdetail.salerowid,\n\tsaleinvdetail.issuerowid,\n\tsaleinvdetail.sourcesaleinvcode,\n\tsaleinvdetail.rowgroup,\n\tsaleinvdetail.packprice,\n\tsaleinvdetail.unitsalestax,\n\tsaleinvdetail.alternatepurprice,\n\tsaleinvdetail.gstperc,\n\tsaleinvdetail.claimable,\n\tsaleinvdetail.claimablediscperc,\n\tsaleinvdetail.packqtyforsale, \n\tsaleinvdetail.bonuspackqtyforsale,\n\tsaleinvdetail.bonusqty,\n\tsaleinvdetail.looseqty \nFROM  \n\tsaleinvdetail, item \nWHERE \n\t( dbo.saleinvdetail.saleinvcode = :ar_SaleInvCode ) AND\n\t( saleinvdetail.icode = item.icode )\nORDER BY \n\tsaleinvdetail.IDENTITYCOL",
