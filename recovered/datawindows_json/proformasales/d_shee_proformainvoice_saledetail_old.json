  "retrieve": "SELECT \n\titem.customicode, \n\titemname= item.name, \n\tlocksaleprice = dbo.item.locksaleprice,\n\tlockdiscperc = dbo.item.lockdiscperc,\n\tcurrlistrow = 0,\n\tstock     = 0, \n\tpackingdesc=item.packingdesc,\n\ttotalstock= 0, \n\tqtysale=item.saleqty,\n\tpurprice=0.00,\n\trecentpurprice=0.00,\n\tavgprice=0.000,\n\titemtotalval=space(30),\n\tBonus=item.bonusqty,\n\tassgcode  = 1, \n\tupdatesaleprice = 'N',\n\tsaleinvdetail.saleinvcode,   \n\ticode=saleinvdetail.icode,   \n\tgcode=saleinvdetail.gcode,\n\tbatch=saleinvdetail.batch,\n\texpiry=saleinvdetail.expiry,\n\tsaleutn=saleinvdetail.saleutn,\n\titemflatdisc = saleinvdetail.itemflatdisc,\n\trowid       = saleinvdetail.IDENTITYCOL, \n\tpackunits = saleinvdetail.packunits,\n\tsaleprice = saleinvdetail.saleprice,\n\trate      = saleinvdetail.rate,\n\tSaleItemDescription = saleinvdetail.SaleItemDescription,\n\tsaleinvdetail.DescICode,\n\titemcode = 0,\n\tretailprice=item.retailprice,\n\tsaleinvdetail.rowgroup,\n\tsaleinvdetail.sourcesaleinvcode,\n\tsaleinvdetail.salerowid,\n\tsaleinvdetail.issuerowid,\n\tpackprice = saleinvdetail.packprice,\n\tpackqtyforsale = saleinvdetail.packqtyforsale,\n\tbonuspackqtyforsale = saleinvdetail.bonuspackqtyforsale,\n\tBonusqty  = saleinvdetail.Bonusqty,\n\tlooseqty  = saleinvdetail.looseqty,\n\tunitsalestax=saleinvdetail.unitsalestax,\n\tgstperc=saleinvdetail.gstperc,\n\tdiscperc  = saleinvdetail.discperc \n\nFROM saleinvdetail,   \n\titem \n\nWHERE ( dbo.saleinvdetail.saleinvcode = :ar_SaleInvCode )    AND\n\t( saleinvdetail.icode = item.icode )\n\t\nORDER BY saleinvdetail.IDENTITYCOL\n\n",
  "update": "saleinvdetail",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
