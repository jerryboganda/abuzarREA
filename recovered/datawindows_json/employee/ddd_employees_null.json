  "retrieve": "SELECT \n\tEmpCode=NULL,\n\tEmployeeName = '<NONE>',\n\tFullName=NULL,\n\tEmpID=NULL,\n\tGender=NULL,\n\tMaritalStatus=NULL,\n\tEmpCatCode=NULL,\n\tDeptCode=NULL,\n\tDesigCode=NULL\nUNION ALL\nSELECT \n\tEMP_Employee.EmpCode,   \n\tEmployeeName = EMP_Employee.FullName + ' (' + EMP_Employee.EmpID + ')',\n\tEMP_Employee.FullName,   \n\tEMP_Employee.EmpID,   \n\tEMP_Employee.Gender,   \n\tEMP_Employee.MaritalStatus,   \n\tEMP_Employee.EmpCatCode,   \n\tEMP_Employee.DeptCode,   \n\tEMP_Employee.DesigCode  \nFROM \n\tEMP_Employee   \nWHERE\n\tEMP_Employee.Active='Y'\nORDER BY\n\tEmployeeName\n"
 },
