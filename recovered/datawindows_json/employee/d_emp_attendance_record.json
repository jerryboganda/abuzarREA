    "name": "leaves",
    "dbname": "Leaves"
   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "sundays",
    "dbname": "Sundays"
   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "holidays",
    "dbname": "Holidays"
   },
   {
    "type": "decimal(7)",
    "updatewhereclause": "yes",
    "name": "overtimehrs",
    "dbname": "OverTimeHrs"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "hoursworked",
    "dbname": "HoursWorked"
   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "minworked",
    "dbname": "MinWorked"
   }
  ],
  "retrieve": "SELECT \n\tEA.EmpCode, \n\tPresents = SUM(CASE WHEN EA.AttendanceStatusCode = 1 THEN 1 WHEN EA.AttendanceStatusCode = 4 OR EA.AttendanceStatusCode = 5 OR EA.AttendanceStatusCode = 6 OR EA.AttendanceStatusCode = 10 THEN 0.5 ELSE 0 END),\n\tAbsents = SUM(CASE WHEN EA.AttendanceStatusCode = 2 OR EA.AttendanceStatusCode = 12 THEN 1 ELSE 0 END),\n\tLeaves = SUM(CASE WHEN EA.AttendanceStatusCode = 11 OR EA.AttendanceStatusCode = 3 THEN 1 WHEN EA.AttendanceStatusCode = 5 OR EA.AttendanceStatusCode = 6 OR EA.AttendanceStatusCode = 7 OR EA.AttendanceStatusCode = 8 THEN 0.5 ELSE 0 END),\n\tSundays = CASE WHEN E.SundaysPaid ='Y' THEN ISNULL(DBO.udf_Count_DayOfWeek(:adt_startdate, :adt_enddate, 'Sunday'), 0) ELSE 0 END,\n\tHolidays = CASE WHEN E.HolidaysPaid ='Y' THEN ISNULL((SELECT COUNT(EH.Date) FROM EMP_Holiday EH WHERE EH.Date BETWEEN :adt_startdate AND :adt_enddate), 0) ELSE 0 END,\n\tOverTimeHrs = \n\t\tCASE \n\t\tWHEN E.Overtime='N' THEN 0 \n\t\tELSE \n\t\t\tCASE \n\t\t\t\tWHEN (SUM(DATEDIFF(n, EA.TimeIn, ISNULL(EA.TimeOut, GETDATE()))) / 60.0000) > (E.WorkingHours * E.WorkingWeekDays) THEN \n\t\t\t\t\t(SUM(DATEDIFF(n, EA.TimeIn, ISNULL(EA.TimeOut, GETDATE()))) / 60.0000) - (E.WorkingHours * E.WorkingWeekDays) \n\t\t\t\tELSE 0 \n\t\t\tEND\n\t\tEND,\n\tHoursWorked = CAST(SUM(DATEDIFF(n, EA.TimeIn, ISNULL(EA.TimeOut, GETDATE()))) / 60.0000 AS NUMERIC(12,4)),\n\tMinWorked = CAST((SUM(DATEDIFF(n, EA.TimeIn, ISNULL(EA.TimeOut, GETDATE()))) / 60) % 60 AS INT)\nFROM EMP_Attendance EA, \n\t\t(SELECT EE.EmpCode, EE.DeptCode, EE.EmpCatCode, EP.Overtime, EP.WorkingHours, EP.WorkingWeekDays, EP.PerHourRate, EP.SundaysPaid, EP.HolidaysPaid\n\t\tFROM EMP_Employee EE LEFT OUTER JOIN EMP_Pay EP ON (EE.EmpCode = EP.EmpCode)) AS E\nWHERE \n\tE.EmpCode = :ai_empcode AND\n\tEA.EmpCode = :ai_empcode AND \n\tE.EmpCode = EA.EmpCode AND\n\tEA.TimeIn IS NOT NULL AND \n\tEA.TimeOut IS NOT NULL AND \n\tEA.TimeIn >= :adt_startdate AND EA.TimeOut <= :adt_enddate AND\n\tEA.Payed = 'N'\nGROUP BY \n\tEA.EmpCode,\n\tE.Overtime,\n\tE.WorkingHours,\n\tE.WorkingWeekDays,\n\tE.SundaysPaid,\t\n\tE.HolidaysPaid",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_empcode",
      "number"
     ]
    },
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
