  "retrieve": "SELECT\n\tEmployeeCategory = C.Name,\n\tEmployeeDepartment = (SELECT D.Name FROM Emp_Department D WHERE D.DeptCode = E.DeptCode),\n\tEmployeeDesignation = (SELECT D.Name FROM Emp_Designation D WHERE D.DesigCode = E.DesigCode),\n\tEmpCode=E.EmpCode,   \n\tEmpID=E.EmpID,   \n\tName=E.FullName, \n\tEmployeeName = E.FullName + ' (' + E.EmpID + ')',\n\tFatherHusband=E.FHName,   \n\tGender=E.Gender, \n\tMaritalStatus=E.MaritalStatus, \n\tMobileSelected='N',\n\tMobile = E.MobileNo\nFROM \n\tEmp_Employee E, Emp_Category C\nWHERE\n\t:ai_type = 1 AND\n\tE.EmpCatCode = C.EmpCatCode AND\n\tC.EmpCatCode in (:ai_code)\nUNION ALL\nSELECT\n\tEmployeeCategory = (SELECT C.Name FROM Emp_Category C WHERE C.EmpCatCode = E.EmpCatCode),\n\tEmployeeDepartment = D.Name,\n\tEmployeeDesignation = (SELECT D.Name FROM Emp_Designation D WHERE D.DesigCode = E.DesigCode),\n\tEmpCode=E.EmpCode,   \n\tEmpID=E.EmpID,   \n\tName=E.FullName, \n\tEmployeeName = E.FullName + ' (' + E.EmpID + ')',\n\tFatherHusband=E.FHName,   \n\tGender=E.Gender, \n\tMaritalStatus=E.MaritalStatus, \n\tMobileSelected='N',\n\tMobile = E.MobileNo\nFROM \n\tEmp_Employee E, Emp_Department D\nWHERE\n\t:ai_type = 2 AND\n\tE.DeptCode = D.DeptCode AND\n\tD.DeptCode in (:ai_code)\nUNION ALL\nSELECT\n\tEmployeeCategory = (SELECT C.Name FROM Emp_Category C WHERE C.EmpCatCode = E.EmpCatCode),\n\tEmployeeDepartment = (SELECT D.Name FROM Emp_Department D WHERE D.DeptCode = E.DeptCode),\n\tEmployeeDesignation = D.Name,\n\tEmpCode=E.EmpCode,   \n\tEmpID=E.EmpID,   \n\tName=E.FullName, \n\tEmployeeName = E.FullName + ' (' + E.EmpID + ')',\n\tFatherHusband=E.FHName,   \n\tGender=E.Gender, \n\tMaritalStatus=E.MaritalStatus, \n\tMobileSelected='N',\n\tMobile = E.MobileNo\nFROM \n\tEmp_Employee E, Emp_Designation D\nWHERE\n\t:ai_type = 3 AND\n\tE.DesigCode = D.DesigCode AND\n\tD.DesigCode in (:ai_code)\nORDER BY\n\tEmployeeCategory,\n\tEmployeeDepartment,\n\tEmployeeDesignation,\n\tEmployeeName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_type",
      "number"
     ]
    },
    {
     "_items": [
      "ai_code",
      "numberlist"
     ]
    }
   ]
  }
 },
