  ],
  "retrieve": "SELECT \n\tEmpCode=E.EmpCode, EMPID=E.EMPID, EmployeeName=E.FullName, Gender=E.Gender,\n\tDesignation = (SELECT D.Name FROM EMP_Designation D WHERE D.DesigCode = E.DesigCode),\n\tCategory = (SELECT C.Name FROM EMP_Category C WHERE C.EmpCatCode = E.EmpCatCode),\n\tDepartment = (SELECT D.Name FROM EMP_Department D WHERE D.DeptCode = E.DeptCode),\n\tBasicPay = ISNULL((SELECT MAX(EP.BasicPay) FROM Emp_Pay EP WHERE EP.EmpCode = E.EmpCode), 0),\n\tAllowances = ISNULL((SELECT MAX((EP.BasicPay * EA.Percentage * 0.01) + EA.FlatAmount) FROM Emp_Pay EP, Emp_PayAllowance EA WHERE EP.EmpCode = E.EmpCode AND EA.EmpCode = E.EmpCode), 0),\n\tDedcutions = ISNULL((SELECT MAX((EP.BasicPay * ED.Percentage * 0.01) + ED.FlatAmount) FROM Emp_Pay EP, Emp_PayDeduction ED WHERE EP.EmpCode = E.EmpCode AND ED.EmpCode = E.EmpCode), 0),\n\tNetPay = ISNULL((SELECT MAX(EP.BasicPay) FROM Emp_Pay EP WHERE EP.EmpCode = E.EmpCode), 0) + \n\t\tISNULL((SELECT MAX((EP.BasicPay * EA.Percentage * 0.01) + EA.FlatAmount) FROM Emp_Pay EP, Emp_PayAllowance EA WHERE EP.EmpCode = E.EmpCode AND EA.EmpCode = E.EmpCode), 0) - \n\t\tISNULL((SELECT MAX((EP.BasicPay * ED.Percentage * 0.01) + ED.FlatAmount) FROM Emp_Pay EP, Emp_PayAllowance ED WHERE EP.EmpCode = E.EmpCode AND ED.EmpCode = E.EmpCode), 0)\nFROM Emp_Employee E\nWHERE E.Active = 'Y'",
  "sort": "employeename A, empid A"
 },
