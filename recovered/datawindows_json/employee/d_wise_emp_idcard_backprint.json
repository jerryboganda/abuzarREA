  "retrieve": "SELECT  \n\tEMPCode=E.EMPCode,\n\tEMPID=E.EMPID,\n\tName=E.FullName,\n\tFHName=E.FHName,\n\tGender=E.Gender,\n\tBirthDate=E.BirthDate,\n\tCNICNo=E.CNICNo,\n\tMobileNo=E.MobileNo,\n\tTransportRouteCode=E.TransportRouteCode,\n\tVehicleCode=E.VehicleCode,\n\tPMTAddress=E.PMTAddress,\n\tBloodGroup=E.BloodGroup,\n\tDepartment = (SELECT EC.Name FROM Emp_Department EC WHERE EC.DeptCode = E.DeptCode),\n\tCategory = (SELECT EC.Name FROM Emp_Category EC WHERE EC.EmpCatCode = E.EmpCatCode),\n\tDesignation = (SELECT EC.Name FROM Emp_Designation EC WHERE EC.DesigCode = E.DesigCode),\n\tIssueDate = GETDATE(),\n\tExpiryDate = ISNULL((SELECT CAST(DBO.FN_GetPreference('DefaultExpiry') AS DATETIME)), GETDATE()+365),\n\tFileName = 'c:~\\waseela_temp~\\'+LTRIM(RTRIM(STR(E.EMPCode)))+'.jpg',\n\tSignatureFile = 'c:~\\waseela_temp~\\sigfile.jpg'\nFROM\n\tEMP_Employee E\nWHERE \n\tE.EMPCode IN (:ai_code) AND\n\tE.Active = 'Y'\nORDER BY\n\tName",
  "arguments": {
   "_items": [
