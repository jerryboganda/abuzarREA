  "retrieve": "SELECT \n\tPayrollCode,\n\tDate,\n\tEmpID = (SELECT E.EmpID FROM EMP_Employee E WHERE E.EMPCode = EMP_Payroll.EmpCode),\n\tEmployee=(SELECT E.FullName FROM EMP_Employee E WHERE E.EMPCode = EMP_Payroll.EmpCode),\n\tPaid,\n\tPaymentDate,\n\tPaidVia,\n\tPaidBy,\n\tPaymentRefNo,\n\tPaymentRemarks,\n\tNetPayable\nFROM \n\tEMP_Payroll\nWHERE \n\tPosted='Y' AND Paid='N'\nORDER BY\n\tPayrollCode",
