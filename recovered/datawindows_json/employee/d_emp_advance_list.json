  "retrieve": "SELECT \n\tAdvanceCode,\n\tDATE=Date,\n\tUserName=(SELECT U.UserName FROM Users U WHERE U.UserCode=Emp_Advance.UserCode),\n\tPaidVia=(SELECT A.Name FROM Accounts A WHERE A.AccCode=Emp_Advance.AccCode),\n\tEmpAdvAccCode,\n\tEmployee = (SELECT E.FullName FROM Emp_Employee E WHERE E.AdvAccCode=Emp_Advance.EmpAdvAccCode),\n\tEmpID = (SELECT E.EMPID FROM Emp_Employee E WHERE E.AdvAccCode=Emp_Advance.EmpAdvAccCode),\n\tCategory = (SELECT C.Name FROM Emp_Employee E, Emp_Category C WHERE E.AdvAccCode=Emp_Advance.EmpAdvAccCode AND E.EmpCatCode=C.EmpCatCode),\n\tDepartment = (SELECT D.Name FROM Emp_Employee E, Emp_Department D WHERE E.AdvAccCode=Emp_Advance.EmpAdvAccCode AND E.DeptCode=D.DeptCode),\n\tDesignation = (SELECT D.Name FROM Emp_Employee E, Emp_Designation D WHERE E.AdvAccCode=Emp_Advance.EmpAdvAccCode AND E.DesigCode=D.DesigCode),\n\tAmount,\n\tReturnedAmt,\n\tBalance=Amount - ReturnedAmt,\n\tInstallment,\n\tGLVochCode,\n\tRefNo,\n\tRemarks\nFROM \n\tEmp_Advance\n",
  "update": "Emp_Advance",
  "updatewhere": "1",
  "updatekeyinplace": "no"
 },
