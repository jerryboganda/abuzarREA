  "retrieve": "SELECT \n\tPayrollCode=EP.PayrollCode, \n\tAdvance=EP.Advance, \n\tEmpCode=EP.EmpCode, \n\tAccCode=E.AccCode, \n\tAdvAccCode=E.AdvAccCode, \n\tBalance=(SELECT SUM(EA.Amount - EA.ReturnedAmt) FROM EMP_Advance EA WHERE EA.EmpAdvAccCode = E.AdvAccCode),\n\tPosted=EP.Posted,\n\tPostDate=EP.PostDate,\n\tPostedBy=EP.PostedBy\nFrom\n\tEmp_Payroll EP, Emp_Employee E\nWhere  \n\tEP.PayrollCode Between :ai_scode AND :ai_ecode AND EP.Posted='N' AND EP.EmpCode=E.EmpCode\nORDER BY\n\tPayrollCode",
  "arguments": {
   "_items": [
