  "retrieve": " SELECT\n\tPRAllocationDetail.PRAllocationCode,\n\tPRAllocationDetail.PurInvCode,\n\tPurLedger.Date,\n\tPurLedger.InvTotal,\n\tPRAllocationDetail.OutstandingAmt,\n\tPRAllocationDetail.IDENTITYCOL,\n\tPRAllocationDetail.PRAllocationUTN,\n\tPRAllocationDetail.Amt\nFROM\n\tPRAllocationDetail,\n\tPRAllocationHeader,\n\tPurLedger\nWHERE\n\t( PRAllocationHeader.PRAllocationCode = :Code ) AND\n\t( PRAllocationHeader.PRAllocationCode = PRAllocationDetail.PRAllocationCode ) and  \n\t( PRAllocationDetail.PurInvCode = PurLedger.PurInvCode )\nORDER BY\n\tPRAllocationDetail.PRAllocationCode,   \n\tPRAllocationDetail.IDENTITYCOL,\n\tPRAllocationDetail.PurInvCode\n",
