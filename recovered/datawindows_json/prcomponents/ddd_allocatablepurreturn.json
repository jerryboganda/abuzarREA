    "dbname": "InvTotal"
   }
  ],
  "retrieve": "SELECT \n\tPRInvCode,   \n\tPurInvCode,   \n\tDate,   \n\tSuppCode,   \n\tSupplier,\n\tAliasName,\n\tOutstandingAmt,\n\tPRCatCode,\n\tInvTotal\nFROM \n\t(SELECT \n\t\tPRLedger.PRInvCode,   \n\t\tPRLedger.PurInvCode,   \n\t\tPRLedger.Date,   \n\t\tPRLedger.SuppCode,   \n\t\tSupplier=Accounts.Name,\n\t\tAliasName=Accounts.AliasName,\n\t\tOutstandingAmt = PRLedger.OutstandingAmt + \n\t\t\tISNULL((SELECT PRAllocationHeader.PRInvCode FROM PRAllocationHeader \n\t\t\t\tWHERE PRAllocationHeader.PRAllocationCode = :Code AND \n\t\t\t\t\tPRAllocationHeader.PRInvCode = PRLedger.PRInvCode), 0),\n\t\tPRLedger.PRCatCode,\n\t\tPRLedger.InvTotal\n\t\n\tFROM \n\t\tPRLedger, Accounts\n\tWHERE\n\t\tPRLedger.AccountFor = 'Y' AND\n\t\tPRLedger.Marked = 'N' AND\n\t\tPRLedger.Posted ='Y' AND\n\t\tPRLedger.SuppCode = Accounts.AccCode) PR\nWHERE \n\tOutstandingAmt > 0\nORDER BY\n\tDate,   \n\tPRInvCode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "code",
      "number"
     ]
    }
   ]
  }
 },
