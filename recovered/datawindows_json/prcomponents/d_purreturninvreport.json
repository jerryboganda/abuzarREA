  "retrieve": "SELECT  \t\n\titemname= itemclass.name\t+' ' +itemcategory.name+' ' +itempacking.name+' '+manufacturer.name, \n\tdbo.prledger.prinvcode,  \n\tdbo.prledger.date , \n\tdbo.prledger.discperc, \n\tdbo.prledger.misccharges, \n\tdbo.prledger.flatdisc, \n\tdbo.prledger.salestax, \n\tdbo.prledger.suppcode, \n\tdbo.prdetail.Looseqty, \n\tdbo.prdetail.icode, \n\tdbo.prdetail.prprice, \n\tdbo.prdetail.avgprice, \n\tdbo.prdetail.discperc, \n\tSupplierName='                                             ' \n\t\nFROM\t\n\tdbo.prledger,   \n\tdbo.prdetail, \n\titem\n\tLEFT OUTER JOIN itempacking ON (dbo.item.packcode = dbo.itempacking.packcode),\n\titemclass, \n\titemcategory, \n\tmanufacturer \n\t\nWHERE\n\t( dbo.prledger.prinvcode = :ra_InvCode ) and \n\t( dbo.prledger.prinvcode = dbo.prdetail.prinvcode ) and  \n\t( prdetail.icode = item.icode ) and  \n\t( item.iccode = itemclass.iccode ) and  \n\t( item.icatcode = itemcategory.icatcode ) and  \n\t( item.manfcode = manufacturer.manfcode )",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  }
 },
