  "retrieve": "SELECT\n\tPRAllocationHeader.PRAllocationCode,   \n\tPRAllocationHeader.Date,   \n\tPRAllocationHeader.PRInvCode,   \n\tReturnType=PRLedger.PRCatCode,\n\tReturnDate=PRLedger.Date, \n\tReturnAmt=PRLedger.InvTotal,\n\tPRLedger.PurInvCode, \n\tAccounts.AliasName, \n\tAccounts.Name,\n\tUsers.UserName,\n\tPRAllocationHeader.Posted, \n\tPRAllocationHeader.PostDate\n\nFROM \n\tPRAllocationHeader, PRLedger, Accounts, Supplier, Users\n\nWHERE\n\tPRAllocationHeader.PRInvCode = PRLedger.PRInvCode AND\n\tPRLedger.SuppCode = Supplier.SuppCode AND\n\tSupplier.SuppCode = Accounts.AccCode AND\n\tPRAllocationHeader.UserCode = Users.UserCode\n\nORDER BY\n\tPRAllocationHeader.PRAllocationCode"
 },
