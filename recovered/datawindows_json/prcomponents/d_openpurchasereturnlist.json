  "retrieve": "SELECT  \n\tPRLedger.prinvcode ,\n\tsuppcode=PRLedger.suppcode,\n\tPRLedger.date ,\n\taccounts.name ,\n\tposted,\n\tPRLedger.invtotal,\n\tPostedBy = IsNull((Select username from users \n\t\t\t\twhere dbo.PRLedger.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\t\t\twhere dbo.PRLedger.modifiedby = dbo.users.usercode), ''),\n\tusers=(select username from users where usercode=PRLedger.salesmancode),\n\tPushed = PRLedger.Pushed,\n\tPushedOn = PRLedger.PushedOn,\n\tPushedBy = (select username from users where usercode=PRLedger.PushedBy),\n\tPushedFor = IsNull((SELECT S.Name + ' (' + S.InstanceID + ')' FROM Site S WHERE S.SiteCode=PRLedger.TargetSiteCode),'')\nFROM\n\tAccounts ,\n\tPRLedger     \nWHERE   \n\tPRLedger.suppcode = accounts.acccode AND\n\tdbo.PRLedger.prcatcode IN (4,5) AND\n\tPosted IN (:as_Posted) AND \n\t(dbo.PRLedger.HeaderNo IS NULL OR\n\t\t(dbo.PRLedger.HeaderNo IN \n\t\t\t\t(SELECT HeaderCode FROM GroupAllowedHeader \n\t\t\t\tWHERE GroupCode = :ai_GroupCode AND Module=:ai_Module)))\n",
  "arguments": {
   "_items": [
