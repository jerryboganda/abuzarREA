  "retrieve": "SELECT  \n\tpurledger.purcatcode ,\n\tprledger.purinvcode ,\n\tprledger.prinvcode ,\n\tprledger.suppcode ,\n\tprledger.salesmancode ,\n\tprledger.date ,\n\tprledger.discperc ,\n\tprledger.flatdisc ,\n\tprledger.misccharges ,\n\tprledger.salestax ,\n\tprledger.posted ,\n\tprledger.postdate ,\n\tprledger.remarks ,\n\tsupplier.address1 ,\n\tsupplier.city ,\n\tsupplier.phone ,\n\tusers.username ,\n\tprledger.prcatcode ,\n\tpurledger.date ,\n\taccounts.name,\n\tdbo.prledger.AccountFor,\n\tdbo.prledger.PaymentMode,\n\tdbo.prledger.PaymentAccCode,\n\tdbo.prledger.Amt,\n\tdbo.prledger.AmtBy,\n\tdbo.prledger.AmtDate,\n\tdbo.prledger.AmtReference,\n\tdbo.prledger.Outstandingamt,\n\tdbo.prledger.marked\n\nFROM \n\tprledger ,\n\tsupplier ,\n\tusers ,\n\tpurledger ,\n\taccounts     \nWHERE \n\t( prledger.suppcode = supplier.suppcode ) and \n\t( prledger.salesmancode = users.usercode ) and\n\t( prledger.purinvcode = purledger.purinvcode ) and \n\t( prledger.suppcode = accounts.acccode ) and \n\t( ( dbo.prledger.prinvcode = :ar_prinvcode ) )",
  "update": "prledger",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
