  "retrieve": "SELECT  \n\tServicePRHeader.ServicePRInvCode , \n\tServicePRHeader.ServicePurInvCode , \n\tServicePRHeader.Date , \n\tInvTotal = ServicePRHeader.InvTotal,\n\tServicePRHeader.Remarks , \n\tSuppCode=ServicePRHeader.SuppCode,\n\tSupplierName=accounts.name,\n\tposted = ServicePRHeader.posted,\n\tPostedBy = IsNull((Select username from users \n\t\t\t\twhere dbo.ServicePRHeader.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\t\t\twhere dbo.ServicePRHeader.modifiedby = dbo.users.usercode), '') ,\n\tRef1=Ref1,\n\tRef2=Ref2,\n\tRef3=Ref3,\n\tRef4=Ref4,\n\tRemarks=ServicePRHeader.Remarks,\n\tHeaderNo=ServicePRHeader.HeaderNo\nFROM\n\taccounts , \n\tServicePRHeader\nWHERE \n\t(dbo.ServicePRHeader.date > :ad_invdate) and\n\t( ServicePRHeader.SuppCode = accounts.acccode ) and \n\t( Posted IN (:as_Posted))",
