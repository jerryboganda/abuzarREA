  "retrieve": "SELECT \n\tServicePrInvCode=H.ServicePrInvCode,\n\tServicePurInvCode=H.ServicePurInvCode,\n\tDate = H.Date,\n\tSupplierAlias=A.AliasName,\n\tSupplierName=A.Name,\n\tUserName=U.UserName,\n\tHeaderNo = H.HeaderNo,\n\tAliasName = SV.AliasName,\n\tServiceName=SV.Name,\n\tRef1 = H.Ref1,\n\tRef2 = H.Ref2,\n\tRef3 = H.Ref3,\n\tRef4 = H.Ref4,\n\tRemarks=H.Remarks,\n\tQty =D.Qty,\n\tPrice=D.Price,\n\tServiceFlatDisc=D.ServiceFlatDisc,\n\tDiscPerc=D.DiscPerc,\n\tRowId=D.RowID,\n\tInvDiscPerc=H.DiscPerc,\n\tFlatDiscount=H.FlatDisc,\n\tMiscCharges=H.MiscCharges,\n\tCashPaid = H.CashCharged,\n\tOtherPaid = ISNULL((SELECT SUM(M.Amount) FROM MasterCashWin M WHERE M.DocumentCode = :ai_code AND DocumentType='RP'), 0)\nFROM ServicePrHeader H, ServicePrDetail D, Supplier S, Accounts A, Users U, Service SV\nWHERE H.ServicePrInvCode = :ai_Code AND \n\tH.ServicePrInvCode=D.ServicePrInvCode AND\n\tH.SuppCode=S.SuppCode AND\n\tS.SuppCode=A.AccCode AND\n\tH.UserCode = U.UserCode AND\n\tD.ServiceCode=SV.ServiceCode\nORDER BY\n\tD.RowID\n\t",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
