  "retrieve": "SELECT \n\tfullcode=Service.aliasname,\n\titemname= Service.name, \n\tServicePurDetail.Servicecode,\n\titemcode = ServicePurDetail.Servicecode,\n\tcurrlistrow = 0,\n\tServicePurDetail.ServicePurInvCode,   \n\tServicePurDetail.RowID,\n\tServicePurDetail.qty,\n\tServicePurDetail.price,\n\tServicePurDetail.Serviceflatdisc,\n\tAllowSaleInDecimal=Service.AllowSaleInDecimal,\n\tServicePurDetail.Remarks,\n\tServicePurDetail.discperc\nFROM \n\tServicePurDetail, Service \nWHERE \n\tServicePurDetail.ServicePurInvCode = :ai_Code AND \n\tServicePurDetail.ServiceCode = Service.ServiceCode",
