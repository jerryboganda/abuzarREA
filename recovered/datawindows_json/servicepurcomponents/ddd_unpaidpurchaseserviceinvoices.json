   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "invtotal",
    "dbname": "InvTotal"
   }
  ],
  "retrieve": "SELECT \n\tServicePurInvCode,\n\tDate,\n\tSuppCode,\n\tSupplier,\n\tAliasName,\n\tOutstandingAmt,\n\tInvTotal\nFROM\n(SELECT \n\tServicePurHeader.ServicePurInvCode,\n\tServicePurHeader.Date,\n\tServicePurHeader.SuppCode,\n\tSupplier=Accounts.Name,\n\tAliasName=Accounts.AliasName,\n\tOutstandingAmt = ServicePurHeader.OutstandingAmt + \n\t\tCASE :module\n\t\tWHEN 'PRA' THEN \n\t\t\tISNULL((SELECT SUM(Amt) FROM ServicePRAllocationDetail \n\t\t\tWhere ServicePRAllocationCode = :Code AND ServicePRAllocationDetail.ServicePurInvCode = ServicePurHeader.ServicePurInvCode), 0)\n\t\tELSE \n\t\t\tISNULL((SELECT SUM(D.Debit - D.Credit) \n\t\t\tFROM GLDetail D, GLHeader H, VocherCategory C\n\t\t\tWhere D.GlVochCode = :Code AND D.InvoiceCode = ServicePurHeader.ServicePurInvCode AND \n\t\t\t\tD.GLVochCode=H.GLVochCode AND H.VochCatCode = C.VochCatCode AND C.InvoiceType=4), 0)\n\t\tEND,\n\tServicePurHeader.InvTotal\nFROM \n\tServicePurHeader, Accounts\nWHERE\n\tServicePurHeader.Marked = 'N' AND\n\tServicePurHeader.Posted ='Y' AND\n\tServicePurHeader.SuppCode = :suppcode AND\n\tServicePurHeader.SuppCode = Accounts.AccCode) P\nWHERE\n\tOutstandingAmt > 0\nORDER BY\n\tDate,   \n\tServicePurInvCode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "suppcode",
      "number"
     ]
    },
    {
     "_items": [
      "code",
      "number"
     ]
    },
    {
     "_items": [
      "module",
      "string"
     ]
    }
   ]
  }
 },
