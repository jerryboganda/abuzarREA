  "retrieve": "SELECT \n\tServicePurTempDetail.ServicePurTempCode,\n\titemcode = ServicePurTempDetail.ServiceCode,\n\titemname= service.name, \n\tcurrlistrow = 0,\n\tfullcode = '         ',\n\tServicePurTempDetail.ServiceCode,\n\tServicePurTempDetail.SuppCode,\n\tServicePurTempDetail.Qty,\n\tServicePurTempDetail.PriceRule,\n\tServicePurTempDetail.SalePrice,\n\tServicePurTempDetail.SalePricePerc,\n\tServicePurTempDetail.PurPrice,\n\tServicePurTempDetail.ServiceFlatDisc,\n\tAllowSaleInDecimal=Service.AllowSaleInDecimal,\n\tServiceStatus = 'N',\n\tServicePurTempDetail.IDentityCOL,\n\tServicePurTempDetail.Discperc\nFROM ServicePurTempDetail, Service\nWHERE ( ServicePurTempDetail.ServicePurTempCode = :ai_code )    AND\n\t( ServicePurTempDetail.ServiceCode = Service.ServiceCode )\n\t",
  "update": "ServicePurTempDetail",
  "updatewhere": "1",
