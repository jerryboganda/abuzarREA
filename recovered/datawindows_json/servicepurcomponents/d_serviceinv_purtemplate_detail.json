  "retrieve": "SELECT \n\tServiceInvPurTempDetail.ServiceInvCode,\n\titemcode = ServiceInvPurTempDetail.ServiceCode,\n\titemname= service.name, \n\tcurrlistrow = 0,\n\tfullcode = '         ',\n\tServiceInvPurTempDetail.SRVRowID,\n\tServiceToPurchase=(SELECT SV.Name FROM Service SV, ServiceDetail SD WHERE SD.ServiceInvCode=:ai_code AND SD.SrvRowID=ServiceInvPurTempDetail.SrvRowID AND SD.ServiceCode=SV.ServiceCode),\n\tServicePrice=(SELECT Price=MAX(ROUND((SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01), 2)) FROM Service SV, ServiceDetail SD WHERE SD.ServiceInvCode=:ai_code AND SD.SrvRowID=ServiceInvPurTempDetail.SrvRowID AND SD.ServiceCode=SV.ServiceCode),\n\tServiceInvPurTempDetail.ServiceCode,\n\tServiceInvPurTempDetail.SuppCode,\n\tServiceInvPurTempDetail.Qty,\n\tServiceInvPurTempDetail.PriceRule,\n\tServiceInvPurTempDetail.SalePrice,\n\tServiceInvPurTempDetail.SalePricePerc,\n\tServiceInvPurTempDetail.PurPrice,\n\tServiceInvPurTempDetail.ServiceFlatDisc,\n\tAllowSaleInDecimal=Service.AllowSaleInDecimal,\n\tServiceStatus = 'N',\n\tServiceInvPurTempDetail.IDentityCOL,\n\tServiceInvPurTempDetail.Discperc\nFROM ServiceInvPurTempDetail, Service\nWHERE ( ServiceInvPurTempDetail.ServiceInvCode = :ai_code )    AND\n\t( ServiceInvPurTempDetail.ServiceCode = Service.ServiceCode )\n\t",
  "update": "ServiceInvPurTempDetail",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  },
  "sort": "code A, srvrowid A, servicetopurchase A, rowid A"
