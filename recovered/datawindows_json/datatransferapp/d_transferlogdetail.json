  "retrieve": "SELECT DataTransferLogDetail.TRANSFERLOGID,   \n         DataTransferLogDetail.INVOICECODE,   \n         DataTransferLogDetail.INVOICETYPE,   \n         DataTransferLogDetail.ICODE,    \n         DataTransferLogDetail.GCODE,   \n         DataTransferLogDetail.BATCH,   \n         DataTransferLogDetail.EXPIRY,   \n         DataTransferLogDetail.QTY,   \n         DataTransferLogDetail.BONUSQTY,   \n         DataTransferLogDetail.DUEQTY,   \n         DataTransferLogDetail.PRICE,   \n         DataTransferLogDetail.STATUS,\n         Item.CustomICode  \n    FROM DataTransferLogDetail,   \n         Item  \n   WHERE ( DataTransferLogDetail.TRANSFERLOGID = :ar_logid ) AND  \n         ( DataTransferLogDetail.INVOICECODE = :ar_invoicecode ) AND  \n         ( DataTransferLogDetail.INVOICETYPE = :ar_invoicetype ) AND  \n         ( DataTransferLogDetail.ICODE = ITEM.ICode )   \nORDER BY DataTransferLogDetail.TRANSFERLOGID ASC,   \n         DataTransferLogDetail.INVOICECODE ASC,   \n         DataTransferLogDetail.INVOICETYPE ASC,   \n         DataTransferLogDetail.STATUS ASC,\n         Item.Name,\n         DataTransferLogDetail.ICODE ASC,  \n         DataTransferLogDetail.GCODE ASC,   \n         DataTransferLogDetail.BATCH ASC,   \n         DataTransferLogDetail.EXPIRY ASC,   \n         DataTransferLogDetail.QTY ASC\n",
  "arguments": {
