  "retrieve": "  SELECT Theader.TransCode,   \n         Theader.SGCode,   \n         Theader.DGCode,   \n         Theader.Date ,\n\t\t\tTheader.Remarks,\n\t\t\tTheader.Salesmancode,\n\t\t\tTheader.Posted,\n\t\t\tTheader.PostDate,\n\t\t\tTheader.StartDate,\n\t\t\tTheader.EndDate,\n\t\t\tTheader.TTCode,\n\t\t\tUsers.username,\n\t\t\tTheader.HeaderNo,\n\t\t\tTheader.HeaderInvNo\n    FROM Theader,   \n         Users  \n   WHERE (Theader.SalesManCode = Users.UserCode) and \n\t\t\t(Theader.TransCode = :ar_tcode)",
