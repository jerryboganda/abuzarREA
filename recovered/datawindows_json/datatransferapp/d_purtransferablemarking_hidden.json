  "retrieve": "SELECT \n\tPurLedger.PurInvCode,\n\tPurLedger.Date,\n\tPurLedger.SuppCode,\n\tAccounts.Name,\n\tAccounts.AliasName,\n\tPurLedger.InvTotal,\n\tPurLedger.Posted,\n\tOldTransferable=PurLedger.Transferable,\n\tPurLedger.Transfered,\n\tPurLedger.TransferedBy,\n\tPurLedger.Transferable\nFROM \n\tPurLedger, Accounts\nWHERE\n\tPurLedger.PurInvCode IN (:ia_invoices) AND\n\tPurLedger.SuppCode = Accounts.AccCode",
