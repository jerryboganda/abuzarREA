  ],
  "retrieve": "SELECT \n\tTheader.TransCode,\n\tTheader.Date,\n\tTheader.SGCode,\n\tSourceGodown= (SELECT name from Godown WHERE gcode = Theader.SGCode),\n\tTargetGodown= (SELECT name from Godown WHERE gcode = Theader.DGCode),\n\tNetAmt=SUM(TDetail.Qty * TDetail.SalePrice),\n\tTheader.Posted,\n\tOldTransferable=Theader.Transferable,\n\tTheader.Transfered,\n\tTheader.TransferedBy,\n\tTheader.Transferable\nFROM \n\tTheader, TDetail\nWHERE\n\tTHeader.TransCode IN (:ia_invoices) AND\n\tTheader.TransCode = TDetail.TransCode\nGROUP BY\n\tTheader.TransCode,\n\tTheader.Date,\n\tTheader.SGCode,\n\tTheader.DGCode,\n\tTheader.Posted,\n\tTheader.Transferable,\n\tTheader.Transfered,\n\tTheader.TransferedBy",
  "update": "Theader",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ia_invoices",
      "numberlist"
     ]
    }
   ]
  }
 },
