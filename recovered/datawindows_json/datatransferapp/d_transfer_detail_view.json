  "retrieve": "SELECT \n\tcurrlistrow = 0,\n\tstock     = 0.0000, \n\ttotalstock= 0.0000, \n\ttdetail.transcode,\n\ttdetail.icode, \n\ttdetail.batch, \n\ttdetail.expiry,  \n\titem.customicode, \n\titemname = item.name, \n\tId   = max(tdetail.IDENTITYCOL),\n\ttdetail.transferutn,\n\ttdetail.avgprice,\n\ttdetail.saleprice,\n\ttdetail.purprice,\n\ttdetail.packunits,\n\trequiredqty = tdetail.requiredqty,\n\treorderqty = tdetail.reorderqty,\n\toptimumqty = tdetail.optimumqty,\n\ttdetail.targetstock,\n\ttdetail.sourcestock,\n\taliasname='            ',\n\tqty  = sum(tdetail.qty)\nFROM \n\ttdetail, item \nWHERE \n\t( dbo.tdetail.transcode = :ar_tCode )    AND\n\t( tdetail.icode = item.icode )\nGROUP BY \n\ttdetail.transcode, \n\ttdetail.icode, \n\ttdetail.batch,\n\ttdetail.expiry,  \n\titem.customicode, \n\ttdetail.transferutn,\n\titem.name,\n\ttdetail.avgprice,\n\ttdetail.purprice,\n\ttdetail.saleprice,\n\ttdetail.packunits,\n\ttdetail.requiredqty,\n\ttdetail.optimumqty,\n\ttdetail.reorderqty,\n\ttdetail.sourcestock,\n\ttdetail.targetstock\nORDER BY \n\tId\n\t\n\t\n\t\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_tCode",
      "number"
     ]
    }
   ]
  }
 },
