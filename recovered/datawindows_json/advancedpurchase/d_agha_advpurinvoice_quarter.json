  "retrieve": "SELECT\n\tpurinvcode = dbo.advpurheader.purinvcode,    \n\tadvpurinvcode = dbo.advpurheader.advpurinvcode, \n\tdate = dbo.advpurheader.date,   \n\tinvdiscperc = dbo.advpurheader.discperc,    \n\tinvgstperc1 = dbo.advpurheader.invgstperc1,\n\tflatdisc = dbo.advpurheader.flatdisc,    \n\tmisccharges = dbo.advpurheader.misccharges, \n\tinvsalestax = 0, \n\taliasname=item.customicode,\n\tinvtype = Case dbo.advpurheader.purcatcode \tWhen 1 Then 'Pack' \t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 2 Then 'Pack' \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 7 Then 'Loose '\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 8 Then 'Loose '\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tElse 'Opening' End,  \t   \n\tlooseqty = dbo.advpurdetail.looseqty, \n\tpackqty  = advpurdetail.packqty, \n\tquantity = dbo.advpurdetail.looseqty + advpurdetail.packqty, \n\tbonusqty  = advpurdetail.bonusqty, \t  \n\tunitsalestax  = advpurdetail.unitsalestax, \n\tgstperc = advpurdetail.gstperc,\t\n\tsaleprice = CASE advpurheader.purcatcode When 1 Then advpurdetail.salepriceforitem\n\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 2 Then advpurdetail.salepriceforitem\n\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 3 Then Round(advpurdetail.salepriceforitem / advpurdetail.packunits, 2)\n\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 7 Then Round(advpurdetail.salepriceforitem / advpurdetail.packunits, 2)\n\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 8 Then Round(advpurdetail.salepriceforitem / advpurdetail.packunits, 2)\n\t\n\t\t\t\t END\t,\n\tloosesaleprice=(item.saleprice/(Case when item.packunits=0 then 1 else item.packunits end)),\n\tpacksaleprice=item.saleprice,\n\tprice = dbo.advpurdetail.purprice,    \n\titemdiscperc = dbo.advpurdetail.discperc,    \n\tpackunits = dbo.advpurdetail.packunits,    \n\tpacking=  case when (dbo.item.packcode is null) then space(30)\n\t\t\t\t else  dbo.itempacking.name\n\t\t\t  end,\n\tbatch = dbo.advpurdetail.batch,    \n\texpiry = dbo.advpurdetail.expiry,    \n\titemname = item.name,\n\tdatestring = Rtrim(LTrim(Str(DatePart(dd, advpurheader.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, advpurheader.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, advpurheader.date)))), \n\tPerson = dbo.accounts.name,\n\tPosted=dbo.advpurheader.posted,\n\tPOCode = dbo.advpurheader.POCode,\n\tPOStatus = CASE WHEN dbo.advpurheader.POCode > 0 THEN CASE WHEN dbo.advpurdetail.ICode = (SELECT PD.ICode FROM PurOrderDetail PD WHERE PD.POCode = dbo.advpurheader.POCode AND PD.Icode = dbo.advpurdetail.ICode AND dbo.AdvPurDetail.PackQty = PD.Qty) THEN 1 ELSE 2 END ELSE 0 END,\n\tpurrowid=dbo.advpurdetail.purrowid\nFROM \t \n\tdbo.advpurheader\n\tLEFT OUTER JOIN purchasetype ON (advpurheader.purtypecode = purchasetype.purtypecode),\n\tdbo.advpurdetail,\n\tdbo.accounts, \n\titem\n\tLEFT OUTER JOIN itempacking ON (item.packcode = itempacking.packcode)\nWHERE  \n\tdbo.advpurheader.advpurinvcode = :ai_invcode and\n\tdbo.advpurheader.purcatcode IN (1, 2, 3, 7, 8) and\n\tdbo.advpurheader.advpurinvcode = dbo.advpurdetail.advpurinvcode and  \n\tdbo.advpurdetail.icode = item.icode and \n\tdbo.advpurheader.suppcode = dbo.accounts.acccode\nUNION ALL\nSELECT\n\tpurinvcode = dbo.advpurheader.purinvcode,    \n\tadvpurinvcode = dbo.advpurheader.advpurinvcode, \n\tdate = dbo.advpurheader.date,   \n\tinvdiscperc = dbo.advpurheader.discperc,    \n\tinvgstperc1 = dbo.advpurheader.invgstperc1,\n\tflatdisc = dbo.advpurheader.flatdisc,    \n\tmisccharges = dbo.advpurheader.misccharges, \n\tinvsalestax = 0, \n\taliasname=item.customicode,\n\tinvtype = Case dbo.advpurheader.purcatcode \tWhen 1 Then 'Pack' \t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 2 Then 'Pack' \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 7 Then 'Loose '\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 8 Then 'Loose '\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tElse 'Opening' End,  \t   \n\tlooseqty = 0, \n\tpackqty  = 0, \n\tquantity = dbo.purorderdetail.qty, \n\tbonusqty  = dbo.purorderdetail.bonusqty, \t  \n\tunitsalestax  = 0, \n\tgstperc = dbo.purorderdetail.gstperc,\t\n\tsaleprice = 0,\n\tloosesaleprice=(item.saleprice/(Case when item.packunits=0 then 1 else item.packunits end)),\n\tpacksaleprice=0,\n\tprice = 0,    \n\titemdiscperc = dbo.purorderdetail.discperc,    \n\tpackunits = dbo.purorderdetail.packunits,    \n\tpacking=  case when (dbo.item.packcode is null) then space(30)\n\t\t\t\t else  dbo.itempacking.name\n\t\t\t  end,\n\tbatch = dbo.purorderdetail.batch,    \n\texpiry = dbo.purorderdetail.expiry,    \n\titemname = item.name,\n\tdatestring = Rtrim(LTrim(Str(DatePart(dd, advpurheader.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, advpurheader.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, advpurheader.date)))), \n\tPerson = dbo.accounts.name,\n\tPosted=dbo.advpurheader.posted,\n\tPOCode = dbo.advpurheader.POCode,\n\tPOStatus = 3,\n\tpurrowid=9999999999\nFROM \t \n\tdbo.advpurheader\n\tLEFT OUTER JOIN purchasetype ON (advpurheader.purtypecode = purchasetype.purtypecode),\n\tdbo.purorderdetail,\n\tdbo.accounts, \n\titem\n\tLEFT OUTER JOIN itempacking ON (item.packcode = itempacking.packcode)\nWHERE  \n\tdbo.advpurheader.advpurinvcode = :ai_invcode and\n\tdbo.advpurheader.purcatcode IN (1, 2, 3, 7, 8) and\n\tdbo.advpurheader.pocode = dbo.purorderdetail.pocode AND\n\tdbo.purorderdetail.icode = item.icode and \n\tdbo.advpurheader.suppcode = dbo.accounts.acccode and\n\tdbo.purorderdetail.ICode NOT IN (SELECT DISTINCT PD.ICode FROM AdvPurDetail PD WHERE PD.AdvPurInvCode = :ai_invcode)\norder by \n\tpurrowid, dbo.item.name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_invcode",
      "number"
     ]
    }
   ]
  },
  "sort": "purrowid A, itemname A"
 },
