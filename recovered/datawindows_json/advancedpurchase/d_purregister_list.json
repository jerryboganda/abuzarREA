  "retrieve": "SELECT  \n\tpurregister.purregistercode, \n\tdate=purregister.date , \n\tLotNo = dbo.purregister.lotno, \n\tremarks=dbo.purregister.remarks, \n\treferenceno=dbo.purregister.referenceno, \n\ttotalamount=dbo.purregister.totalamount,\n\taccounts.name,\n\tusername=(select username from users where users.usercode=purregister.usercode),\n\tposted = purregister.posted\nFROM  \n\tpurregister ,  \n\taccounts     \nWHERE  ( purregister.suppcode = accounts.acccode ) and \n\t( Posted IN (:as_Posted))",
