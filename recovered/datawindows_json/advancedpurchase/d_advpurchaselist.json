  "retrieve": "  SELECT  advpurheader.advpurinvcode , \n\t\tadvpurheader.purinvcode,\n          date=advpurheader.date, \n\t\t\t suppinvcode=dbo.advpurheader.suppinvcode, \n\t\t\t suppinvdate=dbo.advpurheader.suppinvdate, \n\t\t\t GRN=dbo.advpurheader.GRN, \n\t\t\t invtotal=dbo.advpurheader.invtotal,\n          accounts.name, \n\t\t\t username=(select username from users where users.usercode=advpurheader.usercode),\n\t\t\t posted = advpurheader.posted,\n\t\t\tPostedBy = IsNull((Select username from users \n\t\t\t\t\t\t\twhere dbo.advpurheader.postedby = dbo.users.usercode), ''),\n\t\t\tModifiedBy = IsNull((Select username from users \n\t\t\t\t\t\t\twhere dbo.advpurheader.modifiedby = dbo.users.usercode), '') \n    FROM  \n\t\tadvpurheader ,  \n\t\taccounts,\n\t\tusers\n\tWHERE  ( advpurheader.suppcode = accounts.acccode ) and \n\t\t\t ( ( advpurheader.purcatcode = 1 ) or \n\t\t\t ( advpurheader.purcatcode = 2 ) )     and\n\t\t\t ( Posted IN (:as_Posted)) AND\n\t\t\t ( advpurheader.usercode = users.usercode ) AND\n\t\t\t ( dbo.advpurheader.HeaderNo IS NULL OR\n\t\t\t\t\t( dbo.advpurheader.HeaderNo IN \n\t\t\t\t\t\t\t(SELECT HeaderCode FROM GroupAllowedHeader \n\t\t\t\t\t\t\tWHERE GroupCode = :ai_GroupCode AND Module=:ai_Module))) AND\n\t\t\tExists (SELECT DBO.Fn_GetPreference('allowedgroupsinpurchaselist') \n\t\t\t\t\tWHERE DBO.Fn_GetPreference('allowedgroupsinpurchaselist') = 'N')\nUNION ALL\nSELECT  advpurheader.advpurinvcode , \n\t\tadvpurheader.purinvcode , \n          date=advpurheader.date , \n\t\t\t suppinvcode=dbo.advpurheader.suppinvcode, \n\t\t\t suppinvdate=dbo.advpurheader.suppinvdate, \n\t\t\t GRN=dbo.advpurheader.GRN, \n\t\t\t invtotal=dbo.advpurheader.invtotal,\n          accounts.name, \n\t\t\t username=(select username from users where users.usercode=advpurheader.usercode),\n\t\t\t posted = advpurheader.posted,\n\t\t\tPostedBy = IsNull((Select username from users \n\t\t\t\t\t\t\twhere dbo.advpurheader.postedby = dbo.users.usercode), ''),\n\t\t\tModifiedBy = IsNull((Select username from users \n\t\t\t\t\t\t\twhere dbo.advpurheader.modifiedby = dbo.users.usercode), '') \n    FROM  \n\t\tadvpurheader ,  \n         accounts,\n\t\tUsers\n\tWHERE  ( advpurheader.suppcode = accounts.acccode ) and \n\t\t\t ( ( advpurheader.purcatcode = 1 ) or \n\t\t\t ( advpurheader.purcatcode = 2 ) )     and\n\t\t\t ( Posted IN (:as_Posted)) AND\n\t\t\t ( advpurheader.usercode = users.usercode ) AND\n\t\t\t ( dbo.advpurheader.HeaderNo IS NULL OR\n\t\t\t\t\t( dbo.advpurheader.HeaderNo IN \n\t\t\t\t\t\t\t(SELECT HeaderCode FROM GroupAllowedHeader \n\t\t\t\t\t\t\tWHERE GroupCode = :ai_GroupCode AND Module=:ai_Module))) AND\n\t\t\tadvpurheader.usercode IN (\n\t\t\t\t\t\t\t\t\t\t\tSelect \tDistinct U.usercode\n\t\t\t\t\t\t\t\t\t\t\tFrom   \tUsers U, UserGroups UG, GroupAllowedGroups GAG\n\t\t\t\t\t\t\t\t\t\t\tWhere  \tU.UserCode = UG.UserCode And UG.GroupCode = GAG.AllowedGroupCode And \n\t\t\t\t\t\t\t\t\t\t\t\t      GAG.GroupCode = :ai_groupcode And GAG.Module = :ai_module\n\t\t\t\t\t\t\t\t\t\t\tUnion \n\t\t\t\t\t\t\t\t\t\t\tSelect   U.Usercode\n\t\t\t\t\t\t\t\t\t\t\tFrom     Users U, UserGroups UG\n\t\t\t\t\t\t\t\t\t\t\tWhere    U.usercode = UG.usercode And UG.GroupCode = :ai_groupcode\n\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t  ) And\n\t\t\tExists (SELECT DBO.Fn_GetPreference('allowedgroupsinpurchaselist') \n\t\t\t\t\tWHERE DBO.Fn_GetPreference('allowedgroupsinpurchaselist') = 'Y')\n",
  "arguments": {
