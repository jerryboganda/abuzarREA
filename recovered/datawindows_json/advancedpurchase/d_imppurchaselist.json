  "retrieve": "SELECT  \n\tCode=ImpPurHeader.ImpPurInvCode , \n\tdate=ImpPurHeader.date , \n\theaderno=ImpPurHeader.headerno, \n\trefno1=dbo.ImpPurHeader.refno1, \n\trefno2=dbo.ImpPurHeader.refno2, \n\trefno3=dbo.ImpPurHeader.refno3, \n\trefno4=dbo.ImpPurHeader.refno4, \n\tcontainer=dbo.ImpPurHeader.container, \n\tCurrencyCode=dbo.ImpPurHeader.CurrencyCode, \n\tConversionFactor=dbo.ImpPurHeader.ConversionFactor, \n\tinvtotal=dbo.ImpPurHeader.invtotal,\n\tusername=(select username from users where users.usercode=ImpPurHeader.usercode),\n\tFinalized = ImpPurHeader.Finalized,\n\tFinalizedBy = IsNull((Select username from users where dbo.ImpPurHeader.Finalizedby = dbo.users.usercode), ''),\n\tposted = ImpPurHeader.posted,\n\tPostedBy = IsNull((Select username from users where dbo.ImpPurHeader.postedby = dbo.users.usercode), '')\nFROM  \n\tImpPurHeader ,  \n\tusers\nWHERE  \n\t( Posted IN (:as_Posted)) AND\n\t( ImpPurHeader.usercode = users.usercode ) AND\n\t( dbo.ImpPurHeader.HeaderNo IS NULL OR\n\t( dbo.ImpPurHeader.HeaderNo IN \n\t\t(SELECT HeaderCode FROM GroupAllowedHeader \n\t\tWHERE GroupCode = :ai_GroupCode AND Module=:ai_Module))) AND\n\t\tExists (SELECT DBO.Fn_GetPreference('allowedgroupsinpurchaselist') \n\t\tWHERE DBO.Fn_GetPreference('allowedgroupsinpurchaselist') = 'N')\nUNION ALL\nSELECT  \n\tCode=ImpPurHeader.ImpPurInvCode,\n\tdate=ImpPurHeader.date,\n\theaderno=ImpPurHeader.headerno, \n\trefno1=dbo.ImpPurHeader.refno1, \n\trefno2=dbo.ImpPurHeader.refno2, \n\trefno3=dbo.ImpPurHeader.refno3, \n\trefno4=dbo.ImpPurHeader.refno4, \n\tcontainer=dbo.ImpPurHeader.container, \n\tCurrencyCode=dbo.ImpPurHeader.CurrencyCode, \n\tConversionFactor=dbo.ImpPurHeader.ConversionFactor, \n\tinvtotal=dbo.ImpPurHeader.invtotal,\n\tusername=(select username from users where users.usercode=ImpPurHeader.usercode),\n\tFinalized = ImpPurHeader.Finalized,\n\tFinalizedBy = IsNull((Select username from users where dbo.ImpPurHeader.Finalizedby = dbo.users.usercode), ''),\n\tposted = ImpPurHeader.posted,\n\tPostedBy = IsNull((Select username from users where dbo.ImpPurHeader.postedby = dbo.users.usercode), '')\nFROM  \n\tImpPurHeader ,  \n\tUsers\nWHERE  \n\t( Posted IN (:as_Posted)) AND\n\t( ImpPurHeader.usercode = users.usercode ) AND\n\t( dbo.ImpPurHeader.HeaderNo IS NULL OR\n\t( dbo.ImpPurHeader.HeaderNo IN \n\t(SELECT HeaderCode FROM GroupAllowedHeader \n\tWHERE GroupCode = :ai_GroupCode AND Module=:ai_Module))) AND\n\tImpPurHeader.usercode IN (\n\t\t\t\t\tSelect \tDistinct U.usercode\n\t\t\t\t\tFrom   \tUsers U, UserGroups UG, GroupAllowedGroups GAG\n\t\t\t\t\tWhere  \tU.UserCode = UG.UserCode And UG.GroupCode = GAG.AllowedGroupCode And \n\t\t\t\t\t\t\t\tGAG.GroupCode = :ai_groupcode And GAG.Module = :ai_module\n\t\t\t\t\tUnion \n\t\t\t\t\tSelect   U.Usercode\n\t\t\t\t\tFrom     Users U, UserGroups UG\n\t\t\t\t\tWhere    U.usercode = UG.usercode And UG.GroupCode = :ai_groupcode\n\t\t\t\t\t\n\t\t\t\t  ) And\n\tExists (SELECT DBO.Fn_GetPreference('allowedgroupsinpurchaselist') \n\tWHERE DBO.Fn_GetPreference('allowedgroupsinpurchaselist') = 'Y')\n",
  "arguments": {
