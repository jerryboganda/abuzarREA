  "retrieve": "SELECT  \n\tGroupType = 'I',\n\tImpPurInvCode=H.ImpPurInvCode,\t\n\tDate=H.Date,\n\tUserName = (Select Users.UserName FROM Users WHERE Users.UserCode=H.UserCode),\n\tHeaderNo=H.HeaderNo,\n\tCurrency = (Select C.Name FROM Currency C WHERE C.CurrencyCode=H.CurrencyCode),\n\tExchangeRate = H.ConversionFactor,\n\tContainer = H.Container,\n\tRefNo1 = H.RefNo1,\n\tRefNo2 = H.RefNo2,\n\tRefNo3 = H.RefNo3,\n\tRefNo4 = H.RefNo4,\n\tRemarks = H.Remarks,\n\tForeignAmt=H.ForeignAmt,\n\tInvTotal = H.InvTotal,\n\tFinalized = H.Finalized,\n\tPosted = H.Posted,\n\tGlVochcode=H.GlVochcode,\n\tICode = D.ICode,\n\tCustomICode = I.CustomICode,\n\tItemName = I.Name,\n\tBatch = D.Batch,\n\tExpiry = D.Expiry,\n\tQty = D.PackQty,\n\tBonusQty = D.BonusQty,\n\tForeignPrice=D.ForeignPrice,\n\tPurPrice=(D.PurPrice + D.PurPrice2 + D.PurPrice3 + D.PurPrice4),\n\tNetDiscountedRate = D.NetDiscountedRate,\n\tProfitPerc=D.ProfitPerc,\n\tSalePriceForItem=D.SalePriceForItem,\n\tExpenseType=NULL,\n\tAccCode = D.SuppCode,\n\tAliasname=A.AliasName,\n\tAccountName= A.Name,\n\tForeignExpAmt = 0.00,\n\tLocalAmt = 0.00\t\nFROM ImpPurHeader H, ImpPurDetail D, Item I, Accounts A\nWHERE\n\tH.ImpPurInvCode=:ai_code AND \n\tH.ImpPurInvCode = D.ImpPurInvCode AND\n\tD.ICode = I.ICode AND\n\tD.SuppCode = A.Acccode\nORDER BY\n\tGroupType,\n\tItemName,\n\tAccountName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  },
  "sort": "grouptype A, accountname A, itemname A"
 },
