    "dbname": "ROWId"
   }
  ],
  "retrieve": "SELECT \n\tServiceName = (SELECT S.Name + ' (' + LTRIM(RTRIM(STR(SD.SrvRowID,10))) + ')' \n\t\tFROM Service S, ServiceDetail SD \n\t\tWHERE SD.SrvRowID = ServiceIssueRequestDetail.ServiceRowID AND \n\t\t\tS.ServiceCode = SD.ServiceCode),\n\titemname= item.name, \n\tdepartment = dbo.department.name, \n\tsalesman = users.username, \n\tArea = (SELECT A.name FROM Area A WHERE A.AreaCode = dbo.ServiceIssueRequest.AreaCode),\n\tSalesPerson = (SELECT S.name FROM SalesMan S WHERE S.SalesManCode = dbo.ServiceIssueRequest.SMANCode),\n\tcode = dbo.ServiceIssueRequest.ServiceIssueRequestcode, \n\taccountname=(SELECT A.name FROM Accounts A WHERE A.AccCode = dbo.ServiceIssueRequest.AccCode),\n\tdate = dbo.ServiceIssueRequest.date,   \n\tdbo.ServiceIssueRequest.deptcode,\n\tdbo.ServiceIssueRequest.remarks,\t \n\tlooseqty = ServiceIssueRequestDetail.qty,\n\tprocesscharge = ServiceIssueRequestDetail.processcharge,\n\titempacking = itempacking.name,\n\tServiceRowId= ServiceIssueRequestDetail.ServiceRowID,\n\tROWId       = dbo.ServiceIssueRequestDetail.IDENTITYCOL\nFROM \n\tServiceIssueRequest, \n\tServiceIssueRequestDetail,\n\tusers, \n\titem\n\tLEFT OUTER JOIN itempacking ON (dbo.item.packcode = dbo.itempacking.packcode),\n\tdepartment\nWHERE \n\t( dbo.ServiceIssueRequest.ServiceIssueRequestCode = :ar_code ) AND\n\t( dbo.ServiceIssueRequest.ServiceIssueRequestcode = dbo.ServiceIssueRequestDetail.ServiceIssueRequestcode) AND\n\t( dbo.ServiceIssueRequest.deptcode = dbo.department.deptcode ) AND \n\t( dbo.ServiceIssueRequest.salesmancode = users.usercode ) AND \n\t( dbo.ServiceIssueRequestDetail.icode = dbo.item.icode)\nORDER BY\n\tServiceRowID, \n\tRowID",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_Code",
      "number"
     ]
    }
   ]
  }
 },
