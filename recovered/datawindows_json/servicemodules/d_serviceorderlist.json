  ],
  "retrieve": "  SELECT  serviceoheader.serviceocode , \n          serviceoheader.date , \n\t\t\t serviceoheader.posted, \t\n\t\t \t serviceoheader.remarks , \n          accounts.name,\n          posted = serviceoheader.posted,\n\t\t\t PostedBy = IsNull((Select username from users \n\t\t\t\t\t\t\twhere dbo.serviceoheader.postedby = dbo.users.usercode), ''),\n\t       ModifiedBy = IsNull((Select username from users \n\t\t\t\t\t\t\twhere dbo.serviceoheader.modifiedby = dbo.users.usercode), '') \n    FROM  accounts , \n          serviceoheader\n\n   WHERE  ( serviceOheader.custcode = accounts.acccode ) and \n\t\t\t (dbo.serviceOheader.date > :ad_invdate) and\n\t\t\t ( Posted IN (:as_Posted)) AND serviceOheader.AdmissionCode IS NULL\n\n\tOrder By serviceocode desc",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_Posted",
      "stringlist"
     ]
    },
    {
     "_items": [
      "ad_invdate",
      "datetime"
     ]
    }
   ]
  }
 },
