  "retrieve": "SELECT \n\tServiceCode = ServiceOdetail.servicecode,\n\tService = service.name, \n\tServiceODetail.smancode,\n\tServiceODetail.qty,\n\tServiceODetail.price,\n\tServiceODetail.ServiceFlatDisc,\n\tServiceODetail.discperc,\n\tServiceODetail.SrvORowId,\n\tServiceOHeader.AdmissionCode,\n\tServiceOHeader.PatientCode\nFROM \n\tServiceODetail, Service, ServiceOHeader\nWHERE \n\tServiceODetail.SrvORowId = :ai_SrvORowId  AND\n\tServiceOHeader.ServiceOCode = ServiceODetail.ServiceOCode AND\n\tServiceODetail.ServiceCode = Service.ServiceCode\n\t\n\t\n\t\n\t\n\t\n\t\n",
