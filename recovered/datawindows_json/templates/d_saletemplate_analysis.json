    "name": "groupname",
    "dbname": "GroupName"
   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "qty",
    "dbname": "Qty"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "value",
    "dbname": "Value"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "salestax",
    "dbname": "SalesTax"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "total",
    "dbname": "Total"
   }
  ],
  "retrieve": "SELECT \n\tGroupCode = G.GroupCode,\n\tGroupName = G.GroupName,\n\tQty = SUM(D.LooseQty),\n\tValue = Round(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2),\n\tSalesTax = ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + \n\t\t(D.LooseQty * D.UnitSalestax) ), 2),\n\tTotal = ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2) +\n\t\tROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + \n\t\t\t\t(D.LooseQty * D.UnitSalestax) ), 2)\nFROM \n\tSaleTemplateHeader H, \n\tSaleTemplateDetail D,\n\tItem I,\n\t(SELECT GroupCode = NULL, GroupName = 'NONE'\n\tUNION ALL\n\tSELECT GroupCode = ManfCode, GroupName = Name\n\tFROM Manufacturer\n\tWHERE :as_group = 'M' \n\tUNION ALL\n\tSELECT GroupCode = ICatCode, GroupName = Name\n\tFROM ItemCategory\n\tWHERE :as_group = 'C' \n\tUNION ALL\n\tSELECT GroupCode = ICCode, GroupName = Name\n\tFROM ItemClass\n\tWHERE :as_group = 'L' \n\tUNION ALL\n\tSELECT GroupCode = PackCode, GroupName = Name\n\tFROM ItemPacking\n\tWHERE :as_group = 'P' ) G\nWHERE \n\tH.SaleTemplateCode IN (:ai_templatecode) AND\n\tH.SaleTemplateCode = D.SaleTemplateCode AND\n\tD.ICode = I.ICode AND\n\tG.GroupCode = \n\t\tCASE :as_group \n\t\t\tWHEN 'M' THEN I.ManfCode \n\t\t\tWHEN 'C' THEN I.ICatCode \n\t\t\tWHEN 'L' THEN I.ICCode \n\t\t\tELSE I.PackCode END\nGROUP BY\n\tG.GroupCode,\n\tG.GroupName\nORDER BY \n\tGroupName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_group",
      "string"
     ]
    },
    {
     "_items": [
      "ai_templatecode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "groupname A"
 },
