  "retrieve": "SELECT\n\tGroupCode=GroupAllowedGodown.GroupCode,\n\tGodown=Godown.Name,\n\tGCode=GroupAllowedGodown.GCode,\n\tALLowed=1,\n\tModule=GroupAllowedGodown.Module,\n\tPriority=GroupAllowedGodown.Priority\nFROM\tGroupAllowedGodown, Godown\nWHERE\tGroupAllowedGodown.GroupCode = :ai_GroupCode AND\n\t\tGroupAllowedGodown.Module = :ai_Module AND\n\t\tGroupAllowedGodown.GCode=Godown.GCode\nUNION ALL\nSELECT\n\tGroupCode=:ai_GroupCode,\n\tGodown=Godown.Name,\n\tGCode=Godown.GCode,\n\tALLowed=0,\n\tModule=:ai_Module,\n\tPriority=10\nFROM\tGodown\nWHERE\tGodown.GCode NOT IN \n\t\t(SELECT DISTINCT gcode FROM GroupAllowedGodown WHERE GroupCode = :ai_GroupCode and Module = :ai_module)\nORDER BY Godown.Name",
  "update": "GroupAllowedGodown",
