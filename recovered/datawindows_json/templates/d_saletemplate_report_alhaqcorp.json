  "retrieve": "SELECT \n\titemname = item.name,\n\taliasname= item.customicode,\n\tGenericName= (SELECT GenericItem.name from GenericItem WHERE item.GenericCode = GenericItem.GenericCode),\n\tpacking= (SELECT itempacking.name from itempacking WHERE item.packcode = itempacking.packcode),\n\tmanufacturer = manufacturer.name,\n\tmanufcode=item.manfcode,\n\tpackingdesc= item.packingdesc,\n\theaderno = saletemplateheader.headerno,\n\tremarks = saletemplatedetail.remarks,\n\tcurrlistrow = 0,\n\ttemplatename=saletemplateheader.name,\n\tsaletemplatedetail.saletemplatecode,\n\tsaleprice = saletemplatedetail.saleprice,\n\tretailprice = Round(item.retailprice / case when item.packunits > 0 THEN item.packunits ELSE 1 END, 2),\n\tsaletemplatedetail.rowid,\n\tsaletemplatedetail.looseqty \nFROM \n\tsaletemplateheader,\n\tsaletemplatedetail,   \n\titem,\n\tmanufacturer\nWHERE \n\t( dbo.saletemplateheader.saletemplatecode = :ra_InvCode ) AND\n\t( dbo.saletemplateheader.saletemplatecode = dbo.saletemplatedetail.saletemplatecode) AND\n\t( saletemplatedetail.icode = item.icode )  AND\n\t( item.manfcode = manufacturer.manfcode )\nORDER BY\n\titemname",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  },
  "sort": "genericname A, itemname A"
 },
