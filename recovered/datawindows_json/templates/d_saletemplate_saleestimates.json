    "validation": "real(gettext()) >= 0",
    "validationmsg": "\"Required Sales Value must be Possitive.\"",
    "initial": "0",
    "name": "requiredvalue",
    "dbname": "RequiredValue"
   }
  ],
  "retrieve": "SELECT \n\tSaleTemplateCode=H.SaleTemplateCode, \n\tTemplate = H.Name,\n\tGroupCode = G.GroupCode,\n\tGroupName = G.GroupName,\n\tStockQty = ISNULL(\n\t\t(SELECT SUM(GD.CurrQty) \n\t\tFROM GodownDetail GD, Item II,\n\t\t\t(SELECT GroupCode = ManfCode, GroupName = Name\n\t\t\tFROM Manufacturer\n\t\t\tWHERE :as_group = 'M' \n\t\t\tUNION ALL\n\t\t\tSELECT GroupCode = ICatCode, GroupName = Name\n\t\t\tFROM ItemCategory\n\t\t\tWHERE :as_group = 'C' \n\t\t\tUNION ALL\n\t\t\tSELECT GroupCode = ICCode, GroupName = Name\n\t\t\tFROM ItemClass\n\t\t\tWHERE :as_group = 'L' \n\t\t\tUNION ALL\n\t\t\tSELECT GroupCode = PackCode, GroupName = Name\n\t\t\tFROM ItemPacking\n\t\t\tWHERE :as_group = 'P' ) GG\n\t\tWHERE GD.ICode = II.ICode AND \t\n\t\t\tG.GroupCode = \n\t\t\tCASE :as_group \n\t\t\t\tWHEN 'M' THEN II.ManfCode \n\t\t\t\tWHEN 'C' THEN II.ICatCode \n\t\t\t\tWHEN 'L' THEN II.ICCode \n\t\t\t\tELSE II.PackCode END AND \n\t\t\tGG.GroupCode = G.GroupCode), 0),\n\tStockValue = ISNULL(\n\t\t(SELECT SUM(GD.CurrQty * ROUND(II.SalePrice / CASE WHEN II.PackUnits > 0 THEN II.PackUnits ELSE 1 END, 2)) \n\t\tFROM GodownDetail GD, Item II,\n\t\t\t(SELECT GroupCode = ManfCode, GroupName = Name\n\t\t\tFROM Manufacturer\n\t\t\tWHERE :as_group = 'M' \n\t\t\tUNION ALL\n\t\t\tSELECT GroupCode = ICatCode, GroupName = Name\n\t\t\tFROM ItemCategory\n\t\t\tWHERE :as_group = 'C' \n\t\t\tUNION ALL\n\t\t\tSELECT GroupCode = ICCode, GroupName = Name\n\t\t\tFROM ItemClass\n\t\t\tWHERE :as_group = 'L' \n\t\t\tUNION ALL\n\t\t\tSELECT GroupCode = PackCode, GroupName = Name\n\t\t\tFROM ItemPacking\n\t\t\tWHERE :as_group = 'P' ) GG\n\t\tWHERE GD.ICode = II.ICode AND \t\n\t\t\tG.GroupCode = \n\t\t\tCASE :as_group \n\t\t\t\tWHEN 'M' THEN II.ManfCode \n\t\t\t\tWHEN 'C' THEN II.ICatCode \n\t\t\t\tWHEN 'L' THEN II.ICCode \n\t\t\t\tELSE II.PackCode END AND \n\t\t\tGG.GroupCode = G.GroupCode), 0),\n\tQty = SUM(D.LooseQty),\n\tValue = Round(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2),\n\tRequiredValue = Round(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2)\nFROM \n\tSaleTemplateHeader H, \n\t(SELECT STD.SaleTemplateCode, STD.ICode, STD.LooseQty, STD.BonusQty, STD.SalePrice, STD.DiscPerc, STD.ItemFlatDisc, STD.MArked\n\tFROM SaleTemplateDetail STD \n\tWHERE STD.SaleTemplateCode = :ai_templatecode\n\tUNION ALL\n\tSELECT SaleTemplateCode=:ai_templatecode, Item.ICode, LooseQty=0, BonusQty=0, \n\t\tSalePrice=Round(Item.SalePrice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2), \n\t\tDiscPerc=0, ItemFlatDisc=0, MArked='Y'\n\tFROM Item\n\tWHERE :ai_format = 2) D,\n\tItem I,\n\t(SELECT GroupCode = NULL, GroupName = 'NONE'\n\tUNION ALL\n\tSELECT GroupCode = ManfCode, GroupName = Name\n\tFROM Manufacturer\n\tWHERE :as_group = 'M' \n\tUNION ALL\n\tSELECT GroupCode = ICatCode, GroupName = Name\n\tFROM ItemCategory\n\tWHERE :as_group = 'C' \n\tUNION ALL\n\tSELECT GroupCode = ICCode, GroupName = Name\n\tFROM ItemClass\n\tWHERE :as_group = 'L' \n\tUNION ALL\n\tSELECT GroupCode = PackCode, GroupName = Name\n\tFROM ItemPacking\n\tWHERE :as_group = 'P' ) G\nWHERE \n\tH.SaleTemplateCode = :ai_templatecode AND\n\tH.SaleTemplateCode = D.SaleTemplateCode AND\n\tD.Marked = 'Y' AND\n\tD.ICode = I.ICode AND\n\tG.GroupCode = \n\t\tCASE :as_group \n\t\t\tWHEN 'M' THEN I.ManfCode \n\t\t\tWHEN 'C' THEN I.ICatCode \n\t\t\tWHEN 'L' THEN I.ICCode \n\t\t\tELSE I.PackCode END\nGROUP BY\n\tH.SaleTemplateCode,\n\tH.Name,\n\tG.GroupCode,\n\tG.GroupName\nORDER BY \n\tGroupName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_group",
      "string"
     ]
    },
    {
     "_items": [
      "ai_templatecode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_format",
      "number"
     ]
    }
   ]
  },
  "sort": "groupname A"
 },
