  ],
  "retrieve": "Select Customer = Accounts.Name, \n\t\t Customer.Phone, \n\t\t Service = Service.Name,\n\t\t Qty = ServiceODetail.Qty,\n\t\t Shift = Shift.Name,\n\t\t TimeSlot = TimeSlot.Name,\n\t\t ServiceODetail.price, \n\t\t ServiceODetail.CashReceived\n\nFrom   Accounts, Customer, Service, ServiceOHeader, ServiceODetail, TimeSlot, Shift\n\nWhere  ServiceOHeader.ServiceOCode = ServiceODetail.ServiceOCode AND\n       ServiceOHeader.custcode = Accounts.AccCode AND\n       ServiceOHeader.custcode = Customer.custcode AND\n       ServiceODetail.Date >= :ad_startdate AND\n       ServiceODetail.Date <= :ad_enddate AND\n       ServiceODetail.ServiceCode = Service.ServiceCode AND\n       ServiceODetail.ServiceCode = :ai_servicecode AND\n       ServiceODetail.TSCode = TimeSlot.TSCode AND \n       ServiceODetail.ShiftCode = Shift.ShiftCode AND \n\t\t ServiceODetail.CancelStatus Not In ('Y')\n\nOrder By Shift,Service,TimeSlot",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_EndDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_ServiceCode",
      "number"
     ]
    }
   ]
  }
 },
