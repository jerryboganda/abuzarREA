    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "totalsaletax",
    "dbname": "TotalSaleTax"
   }
  ],
  "retrieve": "SELECT \n\tTemplate = H.Name, \n\tCustCode=D.CustCode,\n\tAliasName = (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = D.CustCode),\n\tCustomer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = D.CustCode),\n\tCashSaleCount = CASE WHEN D.SaleCatCode = 3 THEN COUNT(DISTINCT D.SaleInvCode) ELSE 0 END,\n\tCashSaleAmt = CASE WHEN D.SaleCatCode = 3 THEN ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2) +\n\t\tROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + \n\t\t\t\t(D.LooseQty * D.UnitSalestax) ), 2) ELSE 0 END,\n\tCashSaleTax = CASE WHEN D.SaleCatCode = 3 THEN ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + \n\t\t\t\t(D.LooseQty * D.UnitSalestax) ), 2) ELSE 0 END,\n\tCreditSaleCount = CASE WHEN D.SaleCatCode = 3 THEN 0 ELSE COUNT(DISTINCT D.SaleInvCode) END,\n\tCreditSaleAmt = CASE WHEN D.SaleCatCode = 3 THEN 0 ELSE ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2) +\n\t\tROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + \n\t\t\t\t(D.LooseQty * D.UnitSalestax) ), 2) END,\n\tCreditSaleTax = CASE WHEN D.SaleCatCode = 3 THEN 0 ELSE ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + \n\t\t\t\t(D.LooseQty * D.UnitSalestax) ), 2) END,\n\tTotalSaleCount = COUNT(DISTINCT D.SaleInvCode),\n\tTotalSaleAmt = ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2) +\n\t\tROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + \n\t\t\t\t(D.LooseQty * D.UnitSalestax) ), 2),\n\tTotalSaleTax = ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + \n\t\t\t\t(D.LooseQty * D.UnitSalestax) ), 2)\nFROM \n\tSaleTemplateHeader H, SaleTemplateDetail D\nWHERE\n\tH.SaleTemplateCode IN (:ai_code) AND \n\tH.SaleTemplateCode = D.SaleTemplateCode AND\n\tD.Marked='Y'\nGROUP BY\n\tH.Name,\n\tD.CustCode,\n\tD.SaleCatCode\nORDER BY \n\tCustomer",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
