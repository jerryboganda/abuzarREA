  "retrieve": "  SELECT itemname = item.name,\n\t\t \tcurrlistrow = 0,\n\t\t\tsaletemplateheader.name,\n\t\t\tsaletemplatedetail.saletemplatecode,\n\t\t \tsaleprice = saletemplatedetail.saleprice,\n         saletemplatedetail.rowid,\n         saletemplatedetail.looseqty \n\n    FROM saletemplateheader,\n\t\t\tsaletemplatedetail,   \n         item \n\n   WHERE ( dbo.saletemplateheader.saletemplatecode = :ra_InvCode ) AND\n\t\t\t( dbo.saletemplateheader.saletemplatecode = dbo.saletemplatedetail.saletemplatecode) AND\n\t\t \t( saletemplatedetail.icode = item.icode ) \n",
