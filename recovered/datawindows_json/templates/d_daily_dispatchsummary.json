    "dbname": "saleinvamt"
   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "saleinvcode",
    "dbname": "DispatchDetail.SaleInvCode"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "customer",
    "dbname": "Accounts.name"
   },
   {
    "type": "datetime",
    "updatewhereclause": "yes",
    "name": "date",
    "dbname": "DispatchHeader.date"
   },
   {
    "type": "char(100)",
    "updatewhereclause": "yes",
    "name": "remarks",
    "dbname": "remarks"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "builtyexpenses",
    "dbname": "DispatchHeader.BuiltyExpenses"
   }
  ],
  "retrieve": "SELECT   DispatchHeader.DispCode,   \n         DispatchHeader.BiltyNo,   \n         goodscompany.name,   \n         DispatchHeader.Cartons, \n\t\t\tsaleinvamt = Round(Sum ( (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc )) *  (1 - dbo.saledetail.discperc /100) * (1 - dbo.saleledger.discperc /100)) + dbo.saleledger.misccharges  - dbo.saleledger.flatdisc, 0), \n\t\t\tDispatchDetail.SaleInvCode,\n         accounts.name,\n         DispatchHeader.date,\n\t\t\tremarks=max(dispatchheader.remarks),\n\t\t\tDispatchHeader.BuiltyExpenses\n \n    FROM DispatchHeader,\n\t\t\tdbo.DispatchDetail, \n\t\t \tdbo.saledetail,   \n         dbo.saleledger ,\n\t\t\tgoodscompany,\n         accounts\n\n   WHERE ( DispatchHeader.date >= :ad_startdate ) and  \n         ( DispatchHeader.date <= :ad_enddate )   and\n\t\t\t( DispatchHeader.DispCode = dbo.DispatchDetail.DispCode) and\n\t\t\t( dbo.saleledger.saleinvcode  = dbo.DispatchDetail.SaleInvCode) and\n\t \t\t( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and\n\t\t\t( dbo.goodscompany.GCcode = DispatchHeader.GCCode ) and\n\t\t\t( DispatchHeader.custCode = dbo.accounts.accCode)\n\nGROUP BY DispatchHeader.DispCode,    \n         DispatchHeader.BiltyNo,   \n\t\t\tDispatchHeader.BuiltyExpenses,\n         goodscompany.name,\n         DispatchHeader.date,\n         accounts.name,   \n         DispatchHeader.Cartons, \n\t \t\tDispatchDetail.saleinvcode,   \n\t \t\tdbo.saleledger.misccharges,   \n         dbo.saleledger.flatdisc,   \n\t \t\tdbo.saleledger.discperc   \n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_EndDate",
      "datetime"
     ]
    }
   ]
  }
 },
