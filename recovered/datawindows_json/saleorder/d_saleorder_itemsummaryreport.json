    "updatewhereclause": "yes",
    "name": "item",
    "dbname": "Item"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "orderqty",
    "dbname": "OrderQty"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "soldqty",
    "dbname": "SoldQty"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "stockinhand",
    "dbname": "StockInHand"
   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "reorderqty",
    "dbname": "ReOrderQty"
   }
  ],
  "retrieve": "SELECT\n\tICatCode=T.ICatCode,\n\tCategoryName=T.CategoryName,\n\tItemAlias=T.ItemAlias,\n\tItem=T.Item,\n\tOrderQty=ISNULL(SUM(T.OrderQty), 0),\n\tSoldQty = ISNULL(SUM(T.SoldQty),0),\n\tStockInHand = ISNULL(MAX(T.StockInHand), 0),\n\tReOrderQty = ISNULL(MAX(T.ReOrderQty), 0)\nFROM\n\t(SELECT \n\t\tICatCode=IC.ICatCode,\n\t\tCategoryName=IC.Name,\n\t\tItemAlias=I.CustomICode,\n\t\tItem=I.Name,\n\t\tOrderQty=SUM(D.LooseQty + D.BonusQty),\n\t\tSoldQty = ISNULL((SELECT SUM(SD.LooseQty + SD.BonusQty) FROM SaleDetail SD WHERE SD.ICode = I.ICode AND SD.SaleOrderRowID = D.RowID),0),\n\t\tStockInHand = ISNULL((SELECT SUM(GD.CurrQty) FROM GodownDetail GD WHERE GD.ICode = I.ICode AND GD.GCode IN (:ai_gcode)), 0),\n\t\tReOrderQty = I.ReOrderQty\n\tFROM\n\t\tSaleOrderHeader H, \n\t\tSaleOrderDetail D, \n\t\tItem I,\n\t\tItemCategory IC\n\tWHERE\n\t\tH.Posted = 'N' AND \n\t\tH.Finalized = CASE :ai_orderstatus WHEN 1 THEN 'Y' WHEN 2 THEN 'N' ELSE H.Finalized END AND\n\t\tH.Date BETWEEN  :ad_startdate AND :ad_enddate AND \n\t\tH.SaleOrderCode = D.SaleOrderCode AND \n\t\tD.ICode = I.ICode AND \n\t\tI.ICatCode = IC.ICatCode\n\tGROUP BY\n\t\tI.ICode,\n\t\tI.CustomICode,\n\t\tI.Name,\n\t\tI.ReOrderQty,\n\t\tIC.ICatCode,\n\t\tIC.Name,\n\t\tD.RowID) T\nGROUP BY\n\tT.ICatCode,\n\tT.CategoryName,\n\tT.ItemAlias,\n\tT.Item\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_orderstatus",
      "number"
     ]
    },
    {
     "_items": [
      "ai_gcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "categoryname A, item A",
  "filter": "(orderqty - stockinhand + reorderqty) > 0"
 },
