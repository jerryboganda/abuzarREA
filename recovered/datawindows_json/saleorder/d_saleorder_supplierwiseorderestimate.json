    "dbname": "Date"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "saleordertotal",
    "dbname": "SaleOrderTotal"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "supplier",
    "dbname": "Supplier"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "suppliertotal",
    "dbname": "SupplierTotal"
   }
  ],
  "retrieve": "SELECT \n\tSaleOrderCode=SO.SaleOrderCode, \n\tDate=SO.Date, \n\tSaleOrderTotal=MAX(SO.InvTotal),\n\tSupplier = (SELECT A.Name FROM Accounts A WHERE A.AccCode = IL.Suppcode),\n\tSupplierTotal = SUM(SD.Looseqty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SO.DiscPerc * 0.01))\nFROM \n\tSaleOrderHeader SO,\n\tSaleOrderDetail SD,\n\tItem I,\n\t(SELECT \n\tItemSuppliers.ICode,   \n\tItemSuppliers.SuppCode  \nFROM \n\tItemSuppliers,\n\t(SELECT ITS.ICode, P=MIN(ITS.Priority)\n\tFROM ItemSuppliers ITS\n\tGROUP BY ITS.ICode) T\n\tWHERE\n\t\tdbo.Fn_GetPreference('POSupplierConsideration')='1' AND\n\t\tItemSuppliers.ICode = T.ICode AND ItemSuppliers.Priority = T.P\n\tUNION\n\tSELECT \n\t\tItemSuppliers.ICode,   \n\t\tItemSuppliers.SuppCode  \n\tFROM \n\t\tItemSuppliers\n\tWHERE\n\t\tdbo.Fn_GetPreference('POSupplierConsideration')='2') IL\nWHERE\n\tSO.SaleOrderCode BETWEEN :ai_startsocode AND :ai_endsocode AND\n\tSO.SaleOrderCode = SD.SaleOrderCode AND\n\tSD.ICode = I.ICode AND\n\tI.ICode = IL.ICode\nGROUP BY\n\tSO.SaleOrderCode, \n\tSO.Date,\n\tIL.SuppCode\nORDER BY \n\tSO.SaleOrderCode, \n\tSupplier",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_startsocode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_endsocode",
      "number"
     ]
    }
   ]
  },
  "sort": "saleordercode A, supplier A"
 },
