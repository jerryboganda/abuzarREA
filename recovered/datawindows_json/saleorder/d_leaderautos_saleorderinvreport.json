  "retrieve": "SELECT \n\t\titemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END, \n         aliasname=item.customicode,\n\t\tlocalitemname=item.localitemname,\n\t\tclass=(select name from itemclass where itemclass.iccode=item.iccode),   \n\t\titemcategory=(select name from itemcategory where itemcategory.icatcode=item.icatcode),\n         packingdesc=item.packingdesc, \n\t\t\tamt=saleorderheader.amt,  \n         accname =  accounts.name,   \n         address =  customer.address1,   \n         address2=  customer.address2,   \n\n         saleinvcode =  saleorderheader.saleordercode,\n     \n         date =  saleorderheader.date,\n         invdiscperc =  saleorderheader.discperc,   \n         misccharges =  saleorderheader.misccharges,   \n         flatdisc =  saleorderheader.flatdisc,   \n          \n\n         gcode = saleorderdetail.gcode,   \n         icode = saleorderdetail.icode,   \n         batch = saleorderdetail.batch,   \n         expiry = saleorderdetail.expiry,   \n         looseqty = saleorderdetail.looseqty,  \n\t\tstockinhand=(select sum(currqty) from godowndetail gd where  gd.icode=saleorderdetail.icode),\n         bonusqty = saleorderdetail.bonusqty,   \n\n         packunits= saleorderdetail.packunits,   \n         saleprice= saleorderdetail.saleprice,   \n         discperc = saleorderdetail.discperc,  \n\t\t\titemflatdisc=saleorderdetail.itemflatdisc,   \n\n         Id =  saleorderdetail.IDENTITYCOL,   \n         posted=saleorderheader.posted,   \n\n         unitsalestax = saleorderdetail.unitsalestax,   \n         gstperc = saleorderdetail.gstperc,   \n         invgstperc = saleorderheader.invgstperc1,   \n         custTaxRegno=customer.salestaxregno  ,\n\t\t\t saleorderheader.custrefno,\t\n\t\t\t saleorderheader.remarks,\n\n\n\t\t\tcustcode=saleorderheader.custcode,\n\n\t\t\tmessages=(select description from message where messagecode=saleorderheader.messagecode)\n\n    FROM saleorderheader,   \n         saleorderdetail,   \n         accounts,   \n         customer,   \n         \n         item  \n\n   WHERE (  saleorderheader.saleordercode = :ar_SaleInvCode ) AND  \n         (  saleorderheader.saleordercode =  saleorderdetail.saleordercode) AND  \n         (  saleorderheader.custcode =  accounts.acccode ) AND  \n         (  customer.custcode =  accounts.acccode ) AND  \n        \n         (  saleorderdetail.icode =  item.icode)    \n\nORDER BY /* item.customicode,*/\n\t\t\t saleorderdetail.saleordercode,\n\t\t\titemcategory,\n\t\t\titemname,\n\t\t\t saleorderdetail.IDENTITYCOL",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_SaleInvCode",
      "number"
     ]
    }
   ]
  }
