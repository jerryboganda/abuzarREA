  "retrieve": "SELECT \n\tItemName=I.Name,\n\tAliasName=I.CustomICode,\n\tBarCode = '*' + LTRIM(RTRIM(I.CustomICode)) + '*',\n\tPacking = IP.Name,\n\tBatchNo = SPACE(150),\n\tMfgDate = I.LastUpdate,\n\tExpiry = GETDATE()+(365*5),\n\tStrengthPerc = CAST(0.00 AS INT),\n\tSalePrice = I.SalePrice,\n\tMfgRemarks = SPACE(100),\n\tClass = IL.Name,\n\tGenericItem = (SELECT GI.Name FROM GenericItem GI WHERE GI.GenericCode=I.GenericCode),\n\tSizeDescription = I.SizeDescription\nFROM \n\tItem I LEFT OUTER JOIN ItemPacking AS IP ON (I.PackCode = IP.PackCode),\n\tItemClass IL\nWHERE icode <=14 AND I.ICCode = IL.ICCode\n"
 },
