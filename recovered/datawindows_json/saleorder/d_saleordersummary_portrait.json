  "retrieve": "SELECT\n\tcode = saleorderheader.saleordercode , \n\tOrderCode=saleorderheader.ordercode,\n\tSOCatCode=saleorderheader.SOCatCode,\n\tSaleOrderCategory=SOC.Name,\n\tdate = saleorderheader.date , \n\theaderno = saleorderheader.headerno,\n\theaderinvmo=saleorderheader.headerinvno,\n\tcustrefno=saleorderheader.custrefno, \n\tcustrefno2=saleorderheader.custrefno2, \n\tcustrefno3=saleorderheader.custrefno3, \n\tremarks=saleorderheader.remarks , \n\taccounts.name,\n\tusers.username, \n\tposted = saleorderheader.posted,\n\tPostedBy = IsNull((Select username from users where dbo.saleorderheader.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users where dbo.saleorderheader.modifiedby = dbo.users.usercode), ''),\n\tNetAmount = saleorderheader.invtotal,\n\tReprintingCounter=dbo.saleorderheader.ReprintingCounter,\n\tOriginalDate=dbo.saleorderheader.OriginalDate,\n\tModifyCounter=dbo.saleorderheader.ModifyCounter,\n\tDeleted=dbo.saleorderheader.Deleted,\n\tFinalized=dbo.saleorderheader.Finalized,\n\tSection = (SELECT S.Name FROM Section S WHERE S.SectCode = dbo.saleorderheader.SectCode)\nFROM  \n\taccounts, saleorderheader, users, SaleOrderCategory SOC\nWHERE\t\t \n\tsaleorderheader.custcode = accounts.acccode and \n\tdbo.saleorderheader.usercode = dbo.users.usercode   and\n\tsaleorderheader.socatcode = SOC.SOCatCode AND\n\tdbo.saleorderheader.date BETWEEN :adt_startdate AND :adt_enddate\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "date A"
 },
