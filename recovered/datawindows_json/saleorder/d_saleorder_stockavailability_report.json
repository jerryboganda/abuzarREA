  "retrieve": "SELECT\n\tOrderCode=H.SaleOrderCode,\n\tCustomerAlias=A.AliasName,\n\tDate = H.Date,\n\tCustomer=A.Name,\n\tPosted=H.Posted,\n\tFinalized=H.Finalized,\n\tItemAlias=I.CustomICode, \n\tItem=I.Name, \n\tGodown = (SELECT G.Name FROM Godown G WHERE G.GCode = D.GCode),\n\tOrderQty=SUM(D.LooseQty),\n\tOrderBonus=SUM(D.BonusQty), \n\tRowid = MAX(D.RowID),\n\tGodownStock = ISNULL((SELECT SUM(GD.CurrQty) \n\t\t\t\t\t\tFROM GodownDetail GD\n\t\t\t\t\t\tWHERE GD.ICode = I.ICode AND GD.GCode = D.GCode), 0),\n\tTotalStock = ISNULL((SELECT SUM(GD.CurrQty) \n\t\t\t\t\t\tFROM GodownDetail GD\n\t\t\t\t\t\tWHERE GD.ICode = I.ICode), 0),\n\tSalePrice=MAX(D.SalePrice)\nFROM\n\tSaleOrderHeader H, \n\tSaleOrderDetail D, \n\tAccounts A,\n\tItem I\nWHERE\n\tH.SaleOrderCode = :ai_code AND\n\tH.SaleOrderCode = D.SaleOrderCode AND\n\tH.CustCode = A.AccCode AND\n\tD.ICode = I.ICode\nGROUP BY\n\tH.SaleOrderCode,\n\tA.AliasName,\n\tH.Date,\n\tA.Name,\n\tH.Posted,\n\tH.Finalized,\n\tI.ICode, \n\tI.CustomICode, \n\tI.Name, \n\tD.GCode\nORDER BY\n\tOrderCode,\n\tRowid,\n\tItem\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
