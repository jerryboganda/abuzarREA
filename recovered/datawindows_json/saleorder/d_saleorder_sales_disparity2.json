    "name": "saledisparity",
    "dbname": "SaleDisparity"
   }
  ],
  "retrieve": "SELECT \n\tCustomerGroup = (SELECT CG.Name FROM CustomerGroup CG WHERE CG.CustomerGroupCode=:ar_custgroupcode),\n\tDate=SO.Date,\n\tCustomerAlias = A.AliasName,\n\tCustomerName = A.Name,\n\tSaleOrderCategory=SC.Name,\n\tSalesPerson = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode=SO.SManCode),\n\tSaleOrderCode=SO.SaleOrderCode,\n\tSaleOrderAmount = ISNULL(SO.InvTotal, 0),\n\tSaleInvCode = SL.SaleInvCode,\n\tSaleInvoiceAmount= ISNULL(SL.InvTotal,0),\n\tSaleDisparity = ISNULL(SO.InvTotal, 0) - ISNULL(SL.InvTotal,0)\nFROM \n\tSaleOrderHeader SO LEFT OUTER JOIN SaleLedger SL ON SO.SaleOrderCode = SL.SaleOrderCode,\n\tSaleOrderCategory SC,\n\tAccounts A\nWHERE\n\tSO.Date BETWEEN :ar_startdate AND :ar_enddate AND\n\tSO.CustCode IN (SELECT CustCode FROM CustomerGroupDetail WHERE CustomerGroupCode = :ar_custgroupcode) AND \n\tISNULL(SO.SManCode, -1) = ISNULL(CASE :ar_smancode WHEN -1 THEN SO.SManCode ELSE :ar_smancode END, -1) AND\n\tSO.SOCatCode = SC.SOCatCode AND\n\tSO.CustCode = A.AccCode \n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_enddate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_custgroupcode",
      "number"
     ]
    },
    {
     "_items": [
      "ar_smancode",
      "number"
     ]
    }
   ]
  },
  "sort": "customergroup A, salesperson A, customername A, saleordercode A, saleinvcode A",
  "filter": " saledisparity <> 0"
 },
