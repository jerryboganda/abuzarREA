    "name": "saleqty",
    "dbname": "SaleQty"
   }
  ],
  "retrieve": "SELECT \n\tCustomerGroup = (SELECT CG.Name FROM CustomerGroup CG WHERE CG.CustomerGroupCode=:ar_custgroupcode),\n\tDate=SO.Date,\n\tCustCode=SO.CustCode,\n\tCustomerAlias = A.AliasName,\n\tCustomerName = A.Name,\n\tSalesPerson = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode=SO.SManCode),\n\tSaleOrderCode=SO.SaleOrderCode,\n\tSaleInvCode = NULL,\n\tItemAlias = I.CustomICode,\n\tItemName = I.Name,\n\tSOQty = ISNULL(SUM(SD.Looseqty + SD.BonusQty), 0),\n\tSaleQty = ISNULL((SELECT SUM(D.Looseqty + D.BonusQty) FROM SaleLedger S, SaleDetail D WHERE D.SaleOrderRowID > 0 AND D.SaleOrderRowID = SD.RowID AND S.SaleInvCode=D.SaleInvCode), 0)\nFROM\n\tSaleOrderHeader SO,\n\tSaleOrderDetail SD,\n\tItem I,\n\tAccounts A\nWHERE\n\tSO.Date BETWEEN :ar_startdate AND :ar_enddate AND\n\tSO.SaleOrderCode = SD.SaleOrderCode AND\n\tSO.CustCode = A.AccCode AND\n\tSD.ICode = I.ICode AND\n\tSO.CustCode IN (SELECT CustCode FROM CustomerGroup WHERE CustomerGroupCode=  :ar_custgroupcode) AND \n\tISNULL(SO.SManCode, -1) = ISNULL(CASE :ar_smancode WHEN -1 THEN SO.SManCode ELSE :ar_smancode END, -1)\nGROUP BY\n\tSO.Date,\n\tSO.CustCode,\n\tA.AliasName,\n\tA.Name,\n\tSO.SManCode,\n\tSO.SaleOrderCode,\n\tSO.SaleOrderCode,\n\tSD.RowID,\n\tI.CustomICode,\n\tI.Name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_enddate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_custgroupcode",
      "number"
     ]
    },
    {
     "_items": [
      "ar_smancode",
      "number"
     ]
    }
   ]
  },
  "sort": "saleordercode A, saleinvcode A, customername A, itemname A",
  "filter": " soqty <> saleqty "
 },
