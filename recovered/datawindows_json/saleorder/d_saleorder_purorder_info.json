    "name": "value",
    "dbname": "Value"
   }
  ],
  "retrieve": "SELECT \n\tSaleOrderCode=H.SaleOrderCode,\n\tDate=H.Date,\n\tCustomer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = H.CustCode),\n\tPosted = H.Posted,\n\tPostDate=H.PostDate,\n\tHeaderNo=H.HeaderNo,\n\tRemarks=H.Remarks,\n\tAliasName = I.CustomICode,\n\tItemName = I.Name,\n\tRowID = D.RowID,\n\tQty=SUM(D.LooseQty),\n\tPO_Qty =ISNULL((SELECT SUM(POD.Qty) FROM PurOrderHeader PO, PurOrderDetail POD WHERE PO.SaleOrderCode > 0 AND PO.POCode = POD.POCode AND POD.ICode=D.ICode),0),\n\tRate = Max(D.SalePrice),\n\tValue = SUM(D.LooseQty * D.SalePrice)\nFROM\n\tSaleOrderHeader H,\n\tSaleOrderDetail D,\n\tItem I\nWHERE\n\tH.SaleOrderCode = :ai_code AND\n\tH.SaleOrderCode = D.SaleOrderCode AND\n\tD.ICode = I.ICode\nGROUP BY\n\tH.SaleOrderCode,\n\tH.Date,\n\tH.CustCode,\n\tH.Posted,\n\tH.PostDate,\n\tH.HeaderNo,\n\tH.Remarks,\n\tD.ICode,\n\tD.RowID,\n\tI.CustomICode,\n\tI.Name\nORDER BY \n\tROWID",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
