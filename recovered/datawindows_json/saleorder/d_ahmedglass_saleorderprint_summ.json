   {
    "type": "decimal(9)",
    "updatewhereclause": "yes",
    "name": "amount",
    "dbname": "amount"
   }
  ],
  "retrieve": "select \t\n\titemcategory=IC.name,\n\tqty=sum(SD.looseqty+SD.bonusqty),\n\tamount=sum(looseqty * ((SD.saleprice - SD.itemflatdisc) * (1 - SD.discperc*0.01)))\nfrom \n\tsaleorderdetail SD , itemcategory IC, Item I, SaleorderHeader S\nwhere \t\n\tS.SaleOrderCode=SD.SaleOrderCode AND\n\tSD.SaleOrderCode=:ar_InvCode and\n\tSD.icode=I.icode and\n\tI.icatcode=IC.icatcode\ngroup by \t\n\tSD.SaleOrderCode,\n\tIC.icatcode,\n\tIC.name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_InvCode",
      "number"
     ]
    }
   ]
  }
 },
