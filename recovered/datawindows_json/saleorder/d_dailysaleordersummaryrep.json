  "retrieve": "SELECT\n\tSaleOrderCode=H.SaleOrderCode, \n\tSaleOrderCategory = SOC.Name,\n\tOrderCode=H.OrderCode,\n\tDate = H.Date,\n\tFinalized = H.Finalized,\n\tPosted = H.Posted,\n\tNetAmt = H.InvTotal,\n\tAliasName= A.AliasName,\n\tCustomer = A.Name,\n\tOrderDate=H.BillingDate,\n\tDeliveryDeadline = H.DeliveryDeadline,\n\tLateDeliveryCharges=H.LateDeliveryCharges,\n\tLateDeliveryValue= H.LateDeliveryCharges * H.InvTotal * 0.01\nFROM SaleOrderHeader H, Accounts A, SaleOrderCategory SOC\nWHERE \n\tH.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tH.CustCode = A.AccCode AND\n\tH.SOCatCode = SOC.SOCatCode\n",
