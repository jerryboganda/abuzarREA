  "retrieve": "SELECT\n\tSaleInvCode=S.SaleInvCode, \n\tDate=S.Date, \n\tCustAlias=A.AliasName, \n\tCustomer=A.Name, \n\tAddress1 = C.Address1,\n\tAddress2 = C.Address2,\n\tCity = C.City,\n\tPhone = C.Phone,\n\tAliasName = I.CustomICode, \n\tItemName = I.Name, \n\tSoldQty = SUM(D.LooseQty), \n\tBonusQty = SUM(D.BonusQty), \n\tSaleValue = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),\n\tReturnQty = ISNULL((SELECT SUM(RD.LooseQty) FROM SRLedger R, SRDetail RD WHERE R.SaleInvCode = :ai_invcode AND R.SRInvCode = RD.SRInvCode AND RD.ICode = D.ICode), 0),\n\tReturnBonus = ISNULL((SELECT SUM(RD.BonusQty) FROM SRLedger R, SRDetail RD WHERE R.SaleInvCode = :ai_invcode AND R.SRInvCode = RD.SRInvCode AND RD.ICode = D.ICode), 0),\n\tReturnValue = ISNULL((SELECT SUM(RD.LooseQty * RD.SRPrice * (1 - RD.DiscPerc * 0.01) * (1 - R.DiscPerc * 0.01)) FROM SRLedger R, SRDetail RD WHERE R.SaleInvCode = :ai_invcode AND R.SRInvCode = RD.SRInvCode AND RD.ICode = D.ICode), 0),\n\tReturnCount = ISNULL((SELECT Count(R.SRInvCode) FROM SRLedger R WHERE R.SaleInvCode = :ai_invcode), 0),\n\tLastReturn = ISNULL((SELECT MAX(R.SRInvCode) FROM SRLedger R WHERE R.SaleInvCode = :ai_invcode), 0)\nFROM\n\tSaleLedger S, SaleDetail D, Customer C, Accounts A, Item I\nWHERE \n\tS.SaleInvCode = :ai_invcode AND\n\tS.SaleInvCode = D.SaleInvCode AND\n\tS.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND\n\tD.ICode = I.ICode\nGROUP BY\n\tS.SaleInvCode, \n\tS.Date, \n\tA.AliasName, \n\tA.Name, \n\tC.Address1,\n\tC.Address2,\n\tC.City,\n\tC.Phone,\n\tD.ICode,\n\tI.CustomICode, \n\tI.Name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_invcode",
      "number"
     ]
    }
   ]
  },
  "sort": "saleinvcode A, itemname A, soldqty A"
 },
