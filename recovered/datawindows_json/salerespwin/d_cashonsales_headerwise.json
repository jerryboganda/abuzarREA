  "retrieve": "SELECT\n\tSaleInvCode=S.SaleInvCode,\n\tHeaderInvNo=S.HeaderInvNo,\n\tHeaderNo=S.HeaderNo,\n\tDate=S.Date,\n\tAliasName=A.AliasName,\n\tAccountName=A.Name,\n\tInvTotal=ISNULL(S.InvTotal, 0),\n\tOldAmt=ISNULL(S.Amt, 0),\n\tAmt=ISNULL(S.Amt, 0),\n\tPaymentMode=S.PaymentMode,\n\tPaymentAccCode=S.PaymentAccCode,\n\tAmtDate=S.AmtDate,\n\tAmtReference=S.AmtReference,\n\tAmtBy=S.AmtBy,\n\tOutStandingAmt=S.OutStandingAmt\n\t\nFROM SaleLedger S WITH (READPAST, ROWLOCK, UPDLOCK), Accounts A\nWHERE\n\tS.AccountFor = 'Y' AND\n\tS.Posted = 'N' AND \n\tS.Deleted='N' AND\n\tS.CustCode = A.AccCode AND\n\tS.SaleCatCode = 2 AND \n\tS.SaleInvCode = :ai_saleinvcode\nORDER BY\n\tS.SaleInvCode,\n\tA.Name,\n\tA.AliasName",
  "update": "SaleLedger",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_saleinvcode",
      "number"
     ]
    }
   ]
  }
 },
