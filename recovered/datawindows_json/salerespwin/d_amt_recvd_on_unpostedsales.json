  "retrieve": "SELECT\n\tSaleInvCode=S.SaleInvCode,\n\tDate=S.Date,\n\tAliasName=A.AliasName,\n\tAccountName=A.Name,\n\tInvTotal=ISNULL(S.InvTotal, 0),\n\tOldAmt=ISNULL(S.Amt, 0),\n\tAmt=ISNULL(S.Amt, 0),\n\tPaymentMode=S.PaymentMode,\n\tPaymentAccCode=S.PaymentAccCode,\n\tAmtDate=S.AmtDate,\n\tAmtReference=S.AmtReference,\n\tAmtBy=S.AmtBy\n\t\nFROM SaleLedger S, Accounts A\nWHERE\n\tS.Posted = 'N' AND \n\tS.Deleted='N' AND\n\tS.CustCode = A.AccCode AND\n\tS.SaleCatCode = 2\nORDER BY\n\tS.SaleInvCode,\n\tA.Name,\n\tA.AliasName",
  "update": "SaleLedger",
  "updatewhere": "1",
