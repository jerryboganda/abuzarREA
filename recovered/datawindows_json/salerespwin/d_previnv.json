  "retrieve": "Select\t \n\titem.name,\n\taliasname=item.customicode,\n\tsl.saleinvcode,\n\tsl.date,\n\tsd.looseqty, \n\tsd.bonusqty,\n\tsd.SalePrice,\n\tsd.Itemflatdisc,\t\t\n\tsd.discperc,\n\tsd.batch,\n\tsd.expiry,\n\tsd.gstperc,\n\tsd.unitsalestax,\n\tsl.headerno,\n\tsl.headerinvno,\n\tsl.remarks,\n\tsl.custrefno,\n\tinvdiscperc=sl.discperc\nFrom   \n\t(Select saleinvcode,CustCode,date,postdate,headerno,headerinvno,remarks,custrefno,discperc \n\tFrom SaleLedger With (Index(IDX_SaleLedger_CustCode)) \n\tWhere CustCode = :ar_custcode) SL Inner Loop Join\n\t(Select icode,saleinvcode,looseqty,bonusqty,saleprice,itemflatdisc,discperc,batch,expiry,gstperc,unitsalestax\n\tFrom saledetail with (index(IDX_SaleDetail_ICode)) \n\tWhere icode = :ar_icode) SD \n\tOn SL.saleinvcode = SD.saleinvcode \n\tInner Join Accounts On SL.CustCode = Accounts.Acccode \n\tInner Join Item On SD.Icode = Item.Icode \nUNION\nSelect\t \n\titem.name,\n\taliasname=item.customicode,\n\tsl.saleinvcode,\n\tsl.date,\n\tsd.looseqty, \n\tsd.bonusqty,\n\tsd.SalePrice,\n\tsd.Itemflatdisc,\t\t\n\tsd.discperc,\n\tsd.batch,\n\tsd.expiry,\n\tsd.gstperc,\n\tsd.unitsalestax,\n\tsl.headerno,\n\tsl.headerinvno,\n\tsl.remarks,\n\tsl.custrefno,\n\tinvdiscperc=sl.discperc\nFrom   \n\t(Select saleinvcode,CustCode,date,postdate,headerno,headerinvno,remarks,custrefno,discperc \n\tFrom SaleLedgerModified\n\tWhere CustCode = :ar_custcode) SL Inner Loop Join\n\t(Select icode,saleinvcode,looseqty,bonusqty,saleprice,itemflatdisc,discperc,batch,expiry,gstperc,unitsalestax\n\tFrom saledetailModified\n\tWhere icode = :ar_icode) SD \n\tOn SL.saleinvcode = SD.saleinvcode \n\tInner Join Accounts On SL.CustCode = Accounts.Acccode \n\tInner Join Item On SD.Icode = Item.Icode \nUNION\nSelect\t \n\titem.name,\n\taliasname=item.customicode,\n\tsl.saleinvcode,\n\tsl.date,\n\tsd.looseqty, \n\tsd.bonusqty,\n\tsd.SalePrice,\n\tsd.Itemflatdisc,\t\t\n\tsd.discperc,\n\tsd.batch,\n\tsd.expiry,\n\tsd.gstperc,\n\tsd.unitsalestax,\n\tsl.headerno,\n\tsl.headerinvno,\n\tsl.remarks,\n\tsl.custrefno,\n\tinvdiscperc=sl.discperc\nFrom   \n\t(Select saleinvcode,CustCode,date,postdate,headerno,headerinvno,remarks,custrefno,discperc \n\tFrom SaleLedgerDump\n\tWhere CustCode = :ar_custcode) SL Inner Loop Join\n\t(Select icode,saleinvcode,looseqty,bonusqty,saleprice,itemflatdisc,discperc,batch,expiry,gstperc,unitsalestax\n\tFrom saledetaildump with (index(IDX_SaleDetailDump_ICode)) \n\tWhere icode = :ar_icode) SD \n\tOn SL.saleinvcode = SD.saleinvcode \n\tInner Join Accounts On SL.CustCode = Accounts.Acccode \n\tInner Join Item On SD.Icode = Item.Icode \n\n",
