  "retrieve": "SELECT  \n\tSaleReceivableAdj.SaleInvCode,\n\tfullcode=dbo.accounts.AliasName,\n\taccountname=dbo.accounts.Name,\n\tCurrListRow=0,\n\tSaleReceivableAdj.AccCode,\n\tSaleReceivableAdj.CheckNo,\n\tSaleReceivableAdj.Remarks,\n\tSaleReceivableAdj.ROWID,\n\tSaleReceivableAdj.Debit,\n\tSaleReceivableAdj.Credit,\n\tTreatment=CASE WHEN SaleReceivableAdj.Credit > 0 THEN 'I' ELSE 'D' END,\n\tAmount = CASE WHEN SaleReceivableAdj.Debit > 0 THEN SaleReceivableAdj.Debit ELSE SaleReceivableAdj.Credit END\nFROM\n\tSaleReceivableAdj,\n\tAccounts\nWHERE\n\tSaleReceivableAdj.SaleInvCode = :Code AND\n\tSaleReceivableAdj.Acccode = Accounts.acccode\nORDER BY\n\tSaleReceivableAdj.ROWID\n",
  "update": "SaleReceivableAdj",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
