  "retrieve": "SELECT \n\tI.customicode, \n\titemname= I.name, \n\tpackingdesc=I.packingdesc,\n\tRefusedSaleInvCode=T.RefusedSaleInvCode,   \n\tReasonCode=T.Reasoncode,\n\tUnKnownItemName=T.UnKnownItemName,\n\ticode=T.icode,   \n\tROWID=T.RowID,\n\tlooseqty= T.looseqty,\n\tsaleqty = SUM(T.SaleQty),\n\tAlternateICode=NULL\nFROM\n\tItem I,\n\t(SELECT \n\t\tS.RefusedSaleInvCode,   \n\t\tS.icode,   \n\t\tS.Reasoncode,\n\t\tS.UnKnownItemName,\n\t\tS.RowID,\n\t\tS.looseqty,\n\t\tsaleqty = ISNULL(SUM(S.SaleQty), 0)\n\tFROM\n\t\t(SELECT \n\t\t\tRefusedSaleInvCode=SORD.RefusedSaleInvCode,   \n\t\t\ticode=SORD.icode,   \n\t\t\tReasonCode=SORD.Reasoncode,\n\t\t\tUnKnownItemName=SORD.UnKnownItemName,\n\t\t\tRowID=SORD.IDENTITYCOL,\n\t\t\tlooseqty= SORD.qty,\n\t\t\tsaleqty = CASE :ar_populationmethod WHEN 1 THEN ISNULL(sum(SD.LooseQty), 0) ELSE 0 END\n\t\tFROM\n\t\t\tRefusedSaleDetail SORD,\n\t\t\tSaleDetail SD\n\t\tWHERE \n\t\t\tSORD.RefusedSaleInvCode IN (:ar_RefusedSaleInvCode) AND\n\t\t\tSORD.rowid = SD.RefusalSaleRowID\n\t\tGROUP BY\n\t\t\tSORD.RefusedSaleInvCode,   \n\t\t\tSORD.icode,   \n\t\t\tSORD.Reasoncode,\n\t\t\tSORD.UnKnownItemName,\n\t\t\tSORD.IDENTITYCOL,\n\t\t\tSORD.qty\n\t\tUNION\n\t\tSELECT \n\t\t\tRefusedSaleInvCode=SORD.RefusedSaleInvCode,   \n\t\t\ticode=SORD.icode,   \n\t\t\tReasonCode=SORD.Reasoncode,\n\t\t\tUnKnownItemName=SORD.UnKnownItemName,\n\t\t\tROWID=SORD.IDENTITYCOL,\n\t\t\tlooseqty= SORD.qty,\n\t\t\tsaleqty = 0\n\t\tFROM\n\t\t\tRefusedSaleDetail SORD\n\t\tWHERE \n\t\t\tSORD.RefusedSaleInvCode IN (:ar_RefusedSaleInvCode)) S\n\tGROUP BY\n\t\tS.RefusedSaleInvCode,   \n\t\tS.icode,   \n\t\tS.Reasoncode,\n\t\tS.UnKnownItemName,\n\t\tS.RowID,\n\t\tS.looseqty) T\nWHERE\n\tT.ICode = I.ICode\nGROUP BY\n\tI.customicode, \n\tI.name, \n\tI.packingdesc,\n\tT.RefusedSaleInvCode,   \n\tT.icode,   \n\tT.Reasoncode,\n\tT.UnKnownItemName,\n\tT.RowID,\n\tT.Looseqty\nORDER BY\n\tRowID\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_RefusedSaleInvCode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ar_populationmethod",
      "number"
     ]
    }
   ]
  }
 },
