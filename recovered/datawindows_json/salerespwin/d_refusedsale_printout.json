  "retrieve": "SELECT\n\tRefusedSaleInvCode=RefusedSaleHeader.RefusedSaleInvCode,   \n\tSaleInvCode=RefusedSaleHeader.SaleInvCode,   \n\tDate=RefusedSaleHeader.Date,   \n\tUserName=(SELECT Users.UserName FROM Users WHERE Users.UserCode = RefusedSaleHeader.UserCode),\n\tRemarks=RefusedSaleHeader.Remarks,   \n\tReasonCode=RefusedSaleDetail.ReasonCode,   \n\tRowID=RefusedSaleDetail.RowID,\n\tIcode=RefusedSaleDetail.ICode,\n\tCustomICode = (SELECT Item.CustomICode FROM Item WHERE RefusedSaleDetail.ICode = Item.ICode),\n\tItemName = CASE WHEN RefusedSaleDetail.ICode IS NULL THEN RefusedSaleDetail.UnknownItemName ELSE (SELECT Item.Name FROM Item WHERE RefusedSaleDetail.ICode = Item.ICode) END,\n\tUnknownItemName=RefusedSaleDetail.UnknownItemName,   \n\tRemarks=RefusedSaleDetail.Remarks,   \n\tQty=RefusedSaleDetail.Qty  \nFROM \n\tRefusedSaleDetail, RefusedSaleHeader\nWHERE \n\tRefusedSaleHeader.RefusedSaleInvCode = :ai_code AND\n\tRefusedSaleHeader.RefusedSaleInvCode = RefusedSaleDetail.RefusedSaleInvCode\nORDER BY\n\tRefusedSaleInvCode,\n\tRowID",
  "arguments": {
   "_items": [
