  "retrieve": "SELECT \n\tSELECTED = 'N',\n\tCode = S.SaleInvCode,\n\tDate = \tS.Date,\n\tPatientCode = S.PatientCode,\n\tPatientRegNo = P.RegNo,\n\tPatientName = P.Name,\n\tInvTotal = S.InvTotal,\n\tTotalItems = (SELECT COUNT(D.ICode) FROM SaleDetail D WHERE S.SaleInvCode = D.SaleInvCode)\nFROM \n\tSaleLedger S, Patient P\nWHERE \n\tS.PatientCode = :ai_patientcode AND\n\tS.PatientCode = P.PatientCode\nORDER BY\n\tS.SaleInvCode DESC",
