  "retrieve": "SELECT\n\tIP.IPartCode,\n\tIP.Name,\n\tIP.Description,\n\tIP.Remarks,\n\tIP.Application,\n\tIP.QtyUsed,\n\tIP.ICatCode,\n\tIP.ICCode,\n\tIP.PurPrice,\n\tIP.SalePrice\nFROM\n\tItemPart IP\nWHERE\n\tIP.IPartCode IN\n\t(SELECT\n\t\tDISTINCT\n\t\tIPartCode = AssociatedItemPart.AssociatedIPartCode\n\tFROM\n\t\tAssociatedItemPart\n\tWHERE\n\t\tAssociatedItemPart.IPartCode = :Code\n\tUNION\n\tSELECT\n\t\tDISTINCT\n\t\tIPartCode = AssociatedItemPart.IPartCode\n\tFROM\n\t\tAssociatedItemPart\n\tWHERE\n\t\tAssociatedItemPart.AssociatedIPartCode = :Code\n\tUNION\n\tSELECT IPARTCODE=:CODE)\nORDER BY\n\tIP.NAME",
  "update": "ItemPart",
  "updatewhere": "1",
