  "retrieve": "SELECT\n\titem.customicode,  \n\titemname= item.name,  \n\tstock     = 0.0000, \n\tpackingdesc=item.packingdesc,\n\ttotalstock= 0.0000, \n\tsaledetail.saleinvcode,   \n\tsaledetail.icode,   \n\tsaledetail.gcode,\n\tbatch=saledetail.batch,\n\texpiry=saledetail.expiry,\n\tmanfdate = saledetail.manfdate,\n\tId        = max(saledetail.IDENTITYCOL), \n\tDueQty    = 0.0000,\n\tDue = ' ',\n\trowgroup=saledetail.rowgroup,\n\tbonusqty=sum (saledetail.bonusqty),\n\tlooseqty  = sum(saledetail.looseqty) \n\nFROM \n\tsaledetail, \n\titem \n\nWHERE \n\t( dbo.saledetail.saleinvcode = :ar_SaleInvCode )    AND\n\t( saledetail.icode = item.icode )\n         \nGROUP BY \n\tsaledetail.saleinvcode, \n\tsaledetail.icode, \n\tsaledetail.RowGroup,\n\tsaledetail.gcode, \n\titem.customicode, \n\tSaleDetail.AlternateCustomICode,\n\titem.bonusqty, \n\titem.name,\n\titem.packingdesc,\n\tsaledetail.batch,\n\tsaledetail.expiry,\n\tsaledetail.manfdate\nORDER BY \n\tMIN(saledetail.IDENTITYCOL)",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_SaleInvCode",
      "number"
     ]
    }
   ]
  }
 },
