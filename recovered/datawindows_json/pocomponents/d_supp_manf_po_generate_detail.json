  "retrieve": "SELECT \n\tICODE=dbo.item.icode , \n\tItemAliasName=dbo.item.customicode, \n\tItemName=dbo.item.name,  \n\tmanfcode = dbo.item.manfcode, \n\tManufacturer=dbo.Manufacturer.name,\n\tItemCategory=dbo.ItemCategory.name,\n\tItemClass=dbo.ItemClass.name,\n\tItemPacking=(SELECT IP.Name FROM ItemPacking IP WHERE IP.Packcode = dbo.item.packcode),\n\tgenericitem=genericitem.Name,\n\tstockinhand = Case When sum(dbo.godowndetail.currqty) IS NULL Then 0 Else sum(dbo.godowndetail.currqty) End, \n\tOptimumQty = dbo.item.optimumqty,\n\tReorderQty = dbo.item.reorderqty,  \n\tMinQty = dbo.item.minqty,  \n\tPurPrice = dbo.item.purprice,\n\tPackUnits = dbo.item.packunits,\n\tTransitStock = ISNULL(dbo.item.transitstock, 0),\n\tLastPurInvCode = (SELECT MAX(P.PurInvCode) FROM PurDetail D, PurLedger P WHERE D.ICode = Item.ICode AND P.PurInvCode = D.PurInvCode AND P.Posted='Y'),\n\tLastPurDate = (SELECT MAX(P.Date) FROM PurDetail D, PurLedger P WHERE D.ICode = Item.ICode AND P.PurInvCode = D.PurInvCode AND P.Posted='Y'),\n\tGstPerc = item.gstperc1,\n\tPackSalesTax = item.packsalestax,\n\tSalePrice=dbo.item.saleprice,\n\tRPP=dbo.item.recentpurprice,\n\tPackAvgPrice=ROUND(dbo.item.avgprice * dbo.item.packunits, 2),\n\tQty = CEILING( (dbo.item.optimumqty - Case When sum(dbo.godowndetail.currqty) IS NULL Then 0 Else sum(dbo.godowndetail.currqty) End + ISNULL(dbo.item.transitstock, 0)) / CASE WHEN dbo.item.packunits > 0 THEN dbo.item.packunits ELSE 1 END)\nFROM \n\tdbo.item\n\tLEFT OUTER JOIN dbo.godowndetail ON (dbo.item.icode = dbo.godowndetail.icode),\n\tdbo.Manufacturer,\n\tdbo.itemcategory,\n\tdbo.itemclass,\n\tdbo.genericitem\nWHERE\n\t( dbo.item.optimumqty > 0 ) AND\n\t( dbo.item.manfcode = dbo.manufacturer.manfcode ) AND\n\t( dbo.Item.ICatCode = dbo.itemcategory.icatcode ) AND\n\t( dbo.Item.ICCode = dbo.itemclass.iccode ) AND\n\t( dbo.Item.Active = 1 ) AND\n\t( dbo.Item.GeneratePO = 'Y' ) AND\n\t( dbo.genericitem.genericcode = dbo.item.genericcode )\nGROUP BY \n\tdbo.item.icode , \n\tdbo.item.manfcode, \n\tdbo.item.minqty,  \n\tdbo.item.optimumqty, \n\tdbo.item.reorderqty, \n\tdbo.item.purprice, \n\tdbo.item.purprice,\n\tdbo.item.saleprice,\n\tdbo.item.recentpurprice,\n\tdbo.item.packunits,\n\tdbo.item.avgprice,\n\tdbo.item.name,\n\tdbo.Manufacturer.Name,\n\tdbo.ItemCategory.name,\n\tdbo.ItemClass.name,\n\tdbo.genericitem.name,\n\tdbo.item.customicode,\n\tdbo.item.transitstock,\n\tdbo.item.packcode,\n\titem.gstperc1,\n\titem.packsalestax\n\nHAVING\n   ( dbo.item.reorderqty > \n\t\t(Case When sum(dbo.godowndetail.currqty) IS NULL Then 0 Else sum(dbo.godowndetail.currqty) End + ISNULL(dbo.item.transitstock, 0)) )\nORDER BY Manufacturer, ItemName\n"
 },
