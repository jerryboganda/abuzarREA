  "retrieve": "   SELECT item.customicode,\n\t\t   item.name, \n\t\t\tManufName=(SELECT name FROM Manufacturer where manfcode=item.manfcode),\n\t\t\tcurrlistrow = 0,\n         purorderdetail.pocode,   \n         purorderdetail.icode,   \n         purorderdetail.rate,\n\t\t \tpurorderdetail.bonusqty ,\n\t\t \tbaseperiod = 0,\n\t\t \tavgsaleqty = 0,\n\t\t \tforecastqty = 0,\n\t\t \tstock = 0,\n         looseqty = 0,\n\t     \tpackqty = 0,\n\t\t\tpurorderdetail.PORowID,\n\t\t\tpurorderdetail.qty,\n\t\t \tpurorderdetail.discperc\n\t\t\t\n    FROM purorderdetail,   \n         item\n  \n   WHERE ( purorderdetail.icode = item.icode ) and  \n         ( dbo.purorderdetail.pocode = :ra_POCode )   \nORDER BY purorderdetail.PORowID\n",
  "update": "purorderdetail",
