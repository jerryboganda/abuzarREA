  "retrieve": "SELECT \n\tdbo.item.icode , \n\tdbo.item.customicode, \n\tcurrqty = GDN.Stock, \n\tOptimumQty = GDN.optimumqty,\n\tReorderQty = GDN.reorderqty,  \n\tminqty=0,  \n\tdbo.item.purprice,\n\tpackunits=dbo.item.packunits,\n\titem=dbo.item.name,  \n\tManufacturer=dbo.Manufacturer.name,\n\tItemCategory=dbo.ItemCategory.name,\n\tItemClass=dbo.ItemClass.name,\n\tItemPacking=(SELECT IP.Name FROM ItemPacking IP WHERE IP.Packcode = dbo.item.packcode),\n\tgenericitem=genericitem.Name,\n\ttransitstock = 0,\n\tLastPurInvCode = (SELECT MAX(P.PurInvCode) FROM PurDetail D, PurLedger P WHERE D.ICode = Item.ICode AND P.PurInvCode = D.PurInvCode AND P.Posted='Y'),\n\tLastPurDate = (SELECT MAX(P.Date) FROM PurDetail D, PurLedger P WHERE D.ICode = Item.ICode AND P.PurInvCode = D.PurInvCode AND P.Posted='Y'),\n\tgstperc=item.gstperc1,\n\tpacksalestax=item.packsalestax,\n\tpurprice=dbo.item.purprice,\n\tsaleprice=dbo.item.saleprice,\n\trpp=dbo.item.recentpurprice,\n\tpackavgprice=ROUND(dbo.item.avgprice * dbo.item.packunits, 2)\nFROM \n\tdbo.item, \n\tdbo.Manufacturer,\n\tdbo.itemcategory,\n\tdbo.itemclass,\n\tdbo.genericitem,\n\t(SELECT \n\t\tGIS.GCode, \n\t\tGIS.ICode, \n\t\tReOrderQty = ISNULL(GIS.ReOrderQty, 0), \n\t\tOptimumQty = ISNULL(GIS.OptimumQty, 0),\n\t\tStock = ISNULL(SUM(GD.Stock), 0)\n\tFROM \n\t\tGodownItemSetting GIS\n\t\tLEFT OUTER JOIN\n\t\t(SELECT GCode, ICode, Stock=ISNULL(SUM(CurrQty),0)\n\t\tFROM GodownDetail \n\t\tWHERE GCode = :ar_gcode AND GCode IN (SELECT G.Gcode FROM Godown G WHERE G.ConsiderStockInPO='Y')\n\t\tGROUP BY GCode, ICode) AS GD ON (GIS.ICode = GD.ICode)\n\tWHERE \n\t\tdbo.Fn_GetPreference('fetchlastpurinfoinpo')='Y' AND\n\t\tGIS.GCode = :ar_gcode \n\tGROUP BY \n\t\tGIS.GCode, \n\t\tGIS.ICode, \n\t\tGIS.ReOrderQty, \n\t\tGIS.OptimumQty) GDN\nWHERE\n\tdbo.Fn_GetPreference('fetchlastpurinfoinpo')='Y' AND\n\t( \tdbo.item.manfcode in (:ar_manfcode) OR \n\t\tdbo.item.icatcode in (:ar_icatcode) OR \n\t \tdbo.item.iccode in (:ar_iccode) OR \n\t\tdbo.item.Packcode in (:ar_Packcode) OR\n\t\tdbo.item.NAME LIKE (:ar_itemlike)\n\t) AND \n\t( dbo.item.icode = GDN.icode ) AND \n\t( GDN.optimumqty > 0 ) AND\n\t( dbo.item.manfcode = dbo.manufacturer.manfcode ) AND \n\t( dbo.Item.ICatCode = dbo.itemcategory.icatcode ) AND \n\t( dbo.Item.ICCode = dbo.itemclass.iccode ) AND \n\t( dbo.Item.Active = 1 ) AND \n\t( dbo.Item.GeneratePO = 'Y' ) AND \n\t( dbo.genericitem.genericcode = dbo.item.genericcode ) AND\n  /* ( GDN.reorderqty >  GDN.Stock )*/\n\t(GDN.reorderqty> case :ar_isall when 1 then GDN.reorderqty - 1 else GDN.Stock end)\nUNION ALL\nSELECT \n\tdbo.item.icode , \n\tdbo.item.customicode, \n\tcurrqty = GDN.Stock, \n\tOptimumQty = GDN.optimumqty,\n\tReorderQty = GDN.reorderqty,  \n\tminqty=0,  \n\tdbo.item.purprice,\n\tpackunits=dbo.item.packunits,\n\titem=dbo.item.name,  \n\tManufacturer=dbo.Manufacturer.name,\n\tItemCategory=dbo.ItemCategory.name,\n\tItemClass=dbo.ItemClass.name,\n\tItemPacking=(SELECT IP.Name FROM ItemPacking IP WHERE IP.Packcode = dbo.item.packcode),\n\tgenericitem=genericitem.Name,\n\ttransitstock = 0,\n\tLastPurInvCode = NULL,\n\tLastPurDate = NULL,\n\tgstperc=item.gstperc1,\n\tpacksalestax=item.packsalestax,\n\tpurprice=dbo.item.purprice,\n\tsaleprice=dbo.item.saleprice,\n\trpp=dbo.item.recentpurprice,\n\tpackavgprice=ROUND(dbo.item.avgprice * dbo.item.packunits, 2)\nFROM \n\tdbo.item, \n\tdbo.Manufacturer,\n\tdbo.itemcategory,\n\tdbo.itemclass,\n\tdbo.genericitem,\n\t(SELECT \n\t\tGIS.GCode, \n\t\tGIS.ICode, \n\t\tReOrderQty = ISNULL(GIS.ReOrderQty, 0), \n\t\tOptimumQty = ISNULL(GIS.OptimumQty, 0),\n\t\tStock = ISNULL(SUM(GD.Stock), 0)\n\tFROM \n\t\tGodownItemSetting GIS\n\t\tLEFT OUTER JOIN\n\t\t(SELECT GCode, ICode, Stock=ISNULL(SUM(CurrQty),0)\n\t\tFROM GodownDetail \n\t\tWHERE GCode = :ar_gcode AND GCode IN (SELECT G.Gcode FROM Godown G WHERE G.ConsiderStockInPO='Y')\n\t\tGROUP BY GCode, ICode) AS GD ON (GIS.ICode = GD.ICode)\n\tWHERE \n\t\tdbo.Fn_GetPreference('fetchlastpurinfoinpo')='N' AND\n\t\tGIS.GCode = :ar_gcode\n\tGROUP BY \n\t\tGIS.GCode, \n\t\tGIS.ICode, \n\t\tGIS.ReOrderQty, \n\t\tGIS.OptimumQty) GDN\nWHERE\n\tdbo.Fn_GetPreference('fetchlastpurinfoinpo')='N' AND\n\t( \tdbo.item.manfcode in (:ar_manfcode) OR \n\t\tdbo.item.icatcode in (:ar_icatcode) OR \n\t \tdbo.item.iccode in (:ar_iccode) OR \n\t\tdbo.item.Packcode in (:ar_Packcode) OR\n\t\tdbo.item.NAME LIKE (:ar_itemlike)\n\t) AND \n\t( dbo.item.icode = GDN.icode ) AND \n\t( GDN.optimumqty > 0 ) AND\n\t( dbo.item.manfcode = dbo.manufacturer.manfcode ) AND \n\t( dbo.Item.ICatCode = dbo.itemcategory.icatcode ) AND \n\t( dbo.Item.ICCode = dbo.itemclass.iccode ) AND \n\t( dbo.Item.Active = 1 ) AND \n\t( dbo.Item.GeneratePO = 'Y' ) AND \n\t( dbo.genericitem.genericcode = dbo.item.genericcode ) AND\n\t(GDN.reorderqty> case :ar_isall when 1 then GDN.reorderqty - 1 else GDN.Stock end)\nORDER BY \n\tmanufacturer, \n\titem\n",
