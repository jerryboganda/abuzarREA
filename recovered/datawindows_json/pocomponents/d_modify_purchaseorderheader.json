  "retrieve": "SELECT \n\tpurorderheader.ManfCode,   \n\tpurorderheader.SuppCode,   \n\tpurorderheader.Date,   \n\tpurorderheader.POCode,\n\tdbo.purorderheader.salesmancode,\n\tdbo.purorderheader.remarks,  \n\tdbo.purorderheader.purorderterms1,  \n\tdbo.purorderheader.purorderterms2,\n\tdbo.purorderheader.purorderterms3,  \n\tdbo.purorderheader.purorderterms4,  \n\tdbo.purorderheader.purorderterms5,  \n\tdbo.purorderheader.purorderterms6,  \n\tdbo.purorderheader.purorderterms7,  \n\tdbo.purorderheader.purorderterms8,  \n\tdbo.users.username,     \n\tdbo.purorderheader.projectionperiod,\n\tdbo.purorderheader.ZeroQty,\n\tdbo.purorderheader.demanddraftno,\n\tdbo.purorderheader.dated,\n\tdbo.purorderheader.amount,\n\tdbo.purorderheader.custcode,\n\tdbo.purorderheader.startdate,\n\tdbo.purorderheader.EndDate,\n\tdbo.purorderheader.discperc,\n\tdbo.purorderheader.posted,\n\tdbo.purorderheader.PurOrderCatCode,\n\tdbo.purorderheader.SaleOrderCode,\n\tdbo.purorderheader.SupplierReference,\n\tdbo.purorderheader.DeliveryLocation,\n\tdbo.purorderheader.UsageLocation,\n\tdbo.purorderheader.RequiredDate,\n\tdbo.purorderheader.InvGSTPerc1,\n\tdbo.purorderheader.FlatDisc,\n\tdbo.purorderheader.MiscCharges,\n\tdbo.purorderheader.Marked\nFROM \n\tpurorderheader,   \n\tusers  \nWHERE \n\tdbo.purorderheader.salesmancode = dbo.users.usercode\nORDER BY dbo.purorderheader.pocode",
  "update": "purorderheader",
