  "retrieve": "   SELECT customername='abcdefghijklmnopqrstuvwxyzabcd'  ,   \n\t\t\titemname= item.name, \n         PurOrderHeader.POCode,   \n         PurOrderHeader.Date,   \n         PurOrderDetail.ICode,   \n         PurOrderDetail.Qty,  \n\t\tpackingdesc=item.packingdesc, \n         Accounts.Name,\n\t\t\tPurOrderDetail.PORowID,\n\t\t\tPurOrderDetail.Rate,\n\t\t\tManufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode)\n    FROM PurOrderDetail,    \n         PurOrderHeader,   \n         Accounts, \n         item \n   WHERE ( PurOrderHeader.POCode = PurOrderDetail.POCode ) and  \n\t\t\t( PurOrderDetail.icode = item.icode ) and  \n         ( PurOrderHeader.SuppCode = Accounts.AccCode ) and  \n         ( ( PurOrderHeader.POCode = :ra_POCode ) )    \nORDER BY PurOrderDetail.PORowID\n/*item.icatcode,\n\t\t\titem.packcode, \n\t\t\titem.iccode\n\nI.manfcode, I.PackCode, I.IcatCode, I.Iccode*/",
