  "retrieve": "SELECT\n\taliasname=item.customicode,\n\titem.icode, \n\titem.ManfCode,\n\tItem=item.name,\n\tManufacturer=Manufacturer.name,\n\tItemCategory=ItemCategory.name,\n\tItemClass=ItemClass.name,\n\titem.packunits,\n\titem.purPrice,  \n\titem.minqty,\n\tSoldQty = ISNULL(SUM(SL.SoldQty), 0),\n\tReturnQty = ISNULL(SUM(SL.ReturnQty), 0),\n\tStock = ISNULL((select SUM(currqty) from godowndetail where godowndetail.icode = Item.icode AND GodownDetail.GCode IN (SELECT G.Gcode FROM Godown G WHERE G.ConsiderStockInPO='Y')), 0),\n\tTransitStock = ISNULL(dbo.item.transitstock, 0),\n\tpurprice=dbo.item.purprice,\n\tsaleprice=dbo.item.saleprice,\n\trpp=dbo.item.recentpurprice,\n\tpackavgprice=ROUND(dbo.item.avgprice * dbo.item.packunits, 2)\nFROM \n\tManufacturer,\n\tItemCategory,\n\tItemClass,\n\tItem\n\tLEFT OUTER JOIN\n\t(SELECT\n\t\tSaledetail.icode,\n\t\tsoldqty   = SUM(Saledetail.LooseQty),\n\t\tReturnQty = 0\n\tFROM \tSaledetail, SaleLedger\n\tWHERE\t( SaleLedger.date >= :ar_StartDate ) and\n        \t( SaleLedger.date <= :ar_EndDate ) and\n\t        ( SaleLedger.SaleInvCode = Saledetail.SaleInvcode ) and  \n        \t( Saledetail.ICode IN \n\t\t\t\t(SELECT Icode FROM Item WHERE Item.ManfCode IN (:ar_manfcode) OR \n\t\t\t\t\tdbo.item.icatcode in (:ar_icatcode) OR \n\t\t\t\t\tdbo.item.iccode in (:ar_iccode) OR dbo.item.NAME LIKE (:ar_itemlike)))\n\tGROUP BY Saledetail.icode\n\tUNION ALL\n\tSELECT\n\t\tSrdetail.icode,\n\t\tsoldqty   = 0,\n\t\tReturnQty = SUM(Srdetail.LooseQty)\n\tFROM \tSrdetail, SrLedger\n\tWHERE\t( SrLedger.date >= :ar_StartDate ) and\n        \t( SrLedger.date <= :ar_EndDate ) and\n\t      \t( SrLedger.SrInvCode = Srdetail.SrInvcode ) and  \n        \t( Srdetail.ICode IN \n\t\t\t\t(SELECT Icode FROM Item WHERE Item.ManfCode IN (:ar_manfcode) OR dbo.item.icatcode in (:ar_icatcode) OR \n\t\t\t\t\tdbo.item.iccode in (:ar_iccode) OR \n\t\t\t\t\tdbo.item.NAME LIKE (:ar_itemlike)))\n\tGROUP BY\tSrdetail.icode) AS SL ON (dbo.Item.ICode = SL.ICode)\nWHERE\t\n\t(dbo.item.manfcode in (:ar_manfcode) OR dbo.item.icatcode in (:ar_icatcode) OR \n\t\tdbo.item.iccode in (:ar_iccode) OR dbo.item.NAME LIKE (:ar_itemlike)) AND\n\t( dbo.item.manfcode = dbo.manufacturer.manfcode ) AND\n\t( dbo.Item.ICatCode = dbo.itemcategory.icatcode ) AND\n\t( dbo.Item.ICCode = dbo.itemclass.iccode ) AND\n\t( dbo.Item.Active = 1 )\nGROUP BY\n\titem.icode,\n\tItem.ManfCode,\n\tItem.Name,\n\titem.customicode,\n\tManufacturer.Name,\n\tItemCategory.name,\n\tItemClass.name,\n\tItem.PackUnits,\n\titem.purprice,\n\titem.minqty,\n\titem.transitstock,\n\titem.saleprice,\n\titem.recentpurprice,\n\titem.avgprice\n\nORDER BY\n\tManufacturer.Name,\n\tItemCategory.name,\n\tItemClass.name,\n\tItem.Name\n",
