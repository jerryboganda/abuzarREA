  "retrieve": "   SELECT item.customicode,\n\t\t   item.name, \n\t\t\tmanufname=manufacturer.name,\n\t\t  \tcurrlistrow = 0,\n         purorderdetail.pocode,\n         purorderdetail.icode,   \n         reorderqty = 0,\n\t\t\tstock = 0,\n\t\t\toptimumqty = 0,\n\t\t\tpurorderdetail.rate,\n\t\t\tpurorderdetail.bonusqty,\n\t\t\tlooseqty=0,\n\t\t\tpackunits=item.packunits,\n\t\t\tpurorderdetail.PORowID,\n\t\t\tpurorderdetail.qty,\n\t\t\tpurorderdetail.discperc\n\t\t\t\n\n    FROM purorderdetail,   \n         item,\n\t\t\tmanufacturer\n   WHERE ( purorderdetail.icode = item.icode ) and  \n\t\t\t( dbo.purorderdetail.pocode = :ra_POCode )   and\n\t\t\t( item.manfcode = manufacturer.manfcode )\nORDER BY purorderdetail.PORowID\n\n/*item.icatcode,\n\t\t\titem.packcode, \n\t\t\titem.iccode*/\n",
  "update": "purorderdetail",
  "updatewhere": "2",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_POCode",
      "number"
     ]
    }
   ]
  }
