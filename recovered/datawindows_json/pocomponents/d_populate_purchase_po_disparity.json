      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "itemname A",
  "filter": " netqty > 0 OR netbonus > 0"
 },
