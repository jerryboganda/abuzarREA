   }
  ],
  "retrieve": "SELECT \n\titem.name,\n\tPOCode=H.POCode,   \n\tDate=H.Date,   \n\tSupplier=isnull((select name from accounts where accounts.acccode=itemsuppliers.suppcode),'    Items without supplier'),\n\tQty=D.qty,\n\tSuppCode=ItemSuppliers.suppcode\nFROM\n\tPurOrderHeader H,\n\tPurOrderDetail D\n\tLEFT OUTER JOIN ItemSuppliers ON (D.ICode = ItemSuppliers.ICode),\n\tItem\nWHERE \n\tH.pocode = D.pocode AND\n\tH.pocode = :ra_POCode AND\n\tD.icode = Item.ICode\nORDER BY \n\tsupplier,\n\titem.name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_POCode",
      "number"
     ]
    }
   ]
  }
