  "retrieve": "SELECT \n\tI.name,\n\titemalias=I.customicode,\n\tOH.POCode,\n\tOH.Date,\n\tAcc.Aliasname,\n\tAcc.name,\n\tS.address1,\n\tS.address2,\n\tS.city,\n\tS.phone,\n\tS.fax,\n\tOH.remarks,\n\tOH.Discperc,\n\tI.packingdesc,\n\tOD.rate,\n\tOD.qty,\n\tOD.bonusqty,\n\tOD.discperc,\n\tOD.reorderqty,\n\tOD.OptimumQty,\n\tOD.minQty,\n\tOD.Stock,\n\tOD.TransitStock,\n\tOD.SoldQty,\n\tOD.ReturnQty,\n\tamount= (OD.qty * OD.rate) * ( 1 - (OD.discperc * 0.01) ) ,\n\tOH.PurOrderCatCode,\n\tManufacturer=(SELECT Manufacturer.Name FROM Manufacturer WHERE Manufacturer.ManfCode=I.ManfCode),\n\tCategory=(SELECT ItemCategory.Name FROM ItemCategory WHERE ItemCategory.ICatCode=I.ICatCode),\n\tPacking=(SELECT ItemPacking.Name FROM ItemPacking WHERE ItemPacking.PackCode=I.PackCode),\n\tGenericItem=(SELECT GenericItem.Name FROM GenericItem WHERE GenericItem.GenericCode=I.GenericCode),\n\tItemDescription=I.Remarks\n\nFROM item I, accounts Acc, purorderheader OH, purorderdetail OD , Supplier S\n\nWHERE OH.pocode = :ai_sPOCode AND\n      OH.pocode=OD.pocode AND\n\t\tOH.suppCode = S.SuppCode AND\n      OH.suppcode=Acc.acccode AND\n      OD.icode=I.icode\n\norder by oh.pocode, category, i.name, i.customicode, packing, manufacturer",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_sPOCode",
      "number"
     ]
    }
   ]
  },
  "sort": "pocode A, category A, genericitem A, manufacturer A, packingdesc A, item_name A, packing A"
 },
