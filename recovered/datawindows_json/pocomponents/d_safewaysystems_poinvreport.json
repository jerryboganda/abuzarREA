  "retrieve": "SELECT  \n\t\t aliasname=i.customicode,\n\t\t I.name,\n\t\t OH.POCode,\n\t    OH.Date,\n       Acc.name,\n\t\t S.address1,  \n\t\t S.address2,\n\t\t S.city,\n\t\t S.phone,\n\t\t S.fax,\n\t\t OH.remarks,\n\t\t OH.purorderterms1,\n\t\t OH.purorderterms2,\n\t\t OH.purorderterms3,\n\t\t OH.purorderterms4,\n\t\t OH.purorderterms5,\n\t\t OH.purorderterms6,\n\t\t OH.purorderterms7,\n\t\t OH.purorderterms8,\n\t\t OH.Discperc,\n\t\t I.packingdesc,\n       OD.rate,\n       OD.qty,\n\t\t OD.bonusqty,\n\t\t OD.discperc,\n       amount= (OD.qty * OD.rate) * ( 1 - (OD.discperc * 0.01) ) \n\n\nFROM item I, accounts Acc, purorderheader OH, purorderdetail OD , Supplier S\n\nWHERE OH.pocode = :ai_sPOCode AND\n\t\t\n      OH.pocode=OD.pocode AND\n\t\tOH.suppCode = S.SuppCode AND\n      OH.suppcode=Acc.acccode AND\n      OD.icode=I.icode\n\norder by oh.pocode, i.name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_sPOCode",
      "number"
     ]
    }
   ]
  }
 },
