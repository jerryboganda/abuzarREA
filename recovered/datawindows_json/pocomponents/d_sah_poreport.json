  "retrieve": "  SELECT customername='abcdefghijklmnopqrstuvwxyzabcd'  ,   \n\t\t\titemname= item.name, \n         PurOrderHeader.POCode,   \n\t\t\tremarks=PurOrderHeader.remarks,\n         PurOrderHeader.Date,   \n         PurOrderDetail.ICode,\n\t\t\tRATE=purorderdetail.rate,\n\t\t\titemflatdisc=purorderdetail.itemflatdisc,\n\t\t\tDiscperc=purorderdetail.discperc,  \n         PurOrderDetail.Qty,  \n\t\t\tPACKINGDESC=ITEM.packingdesc, \n         Accounts.Name,\n\t\t\tsuppadd1=(select address1 from supplier where suppcode=acccode),\n\t\t\tsuppadd2=(select address2 from supplier where suppcode=acccode),\n\t\t\tsuppphone=(select phone from supplier where suppcode=acccode),\n\t\t\tsuppfax=(select fax from supplier where suppcode=acccode),\n\t\t\tsuppcity=(select city from supplier where suppcode=acccode),\n\t\t\tPurOrderDetail.PORowID,\n\t\t\tManufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode)\n    FROM PurOrderDetail,   \n         PurOrderHeader,   \n         Accounts, \n         item \n  \n   WHERE ( PurOrderHeader.POCode = PurOrderDetail.POCode ) and  \n\t\t\t( PurOrderDetail.icode = item.icode ) and  \n         ( PurOrderHeader.SuppCode = Accounts.AccCode ) and  \n         ( ( PurOrderHeader.POCode = :ra_POCode ) )    \n\n\nORDER BY PurOrderDetail.PORowID\n\n/*item.icatcode,\n\t\t\titem.packcode, \n\t\t\titem.iccode\n\nI.manfcode, I.PackCode, I.IcatCode, I.Iccode*/",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_POCode",
      "number"
     ]
    }
   ]
  }
