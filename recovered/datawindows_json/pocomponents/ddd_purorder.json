  "retrieve": "SELECT \n\tpurorderheader.pocode, \n\tpurorderheader.date,   \n\taccounts.name,\n\tsupplierreference=purorderheader.supplierreference,\n\tPurCount = (SELECT COUNT(P.POCode) FROM PurLedger P WHERE P.POCode=PurOrderHeader.POCode),\n\tTotalofpurchases= purorderheader.Totalofpurchases,\n\tlistofpurinvoices = purorderheader.listofpurinvoices\nFROM \n\taccounts,   \n\tpurorderheader  \nWHERE \n\t( purorderheader.suppcode = accounts.acccode and purorderheader.Posted = 'Y' )    \nUNION\nSELECT pocode=NULL,   \n\tdate=NULL,   \n\tname='[None]' ,\n\tsupplierreference=SPACE(100),\n\tPurCount = NULL,\n\tTotalofpurchases= NULL,\n\tlistofpurinvoices = NULL\n\n",
  "sort": "pocode D"
 },
