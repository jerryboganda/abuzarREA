  "retrieve": "  SELECT customername='abcdefghijklmnopqrstuvwxyzabcd'  ,   \n\t\t\titemname= item.name, \n\t\titempacking=(select name from itempacking where itempacking.packcode=item.packcode),\n         PurOrderHeader.POCode,   \n         PurOrderHeader.Date,   \n         PurOrderDetail.ICode,   \n         PurOrderDetail.Qty,\n\t\tRemarks=PurOrderheader.Remarks,\n\t\tstockinhand=stock,\n\t\tcategory=(select name from itemcategory where itemcategory.icatcode=item.icatcode), \n\t\t itemremarks=purorderdetail.remarks,\n\t\tmonthlyconsumption=(select isnull(sum(ID.qty),0) \n\t\t\t\t\t\t\t\t\tfrom issueheader IH, Issuedetail ID \n\t\t\t\t\t\t\t\t\twhere  /*IH.date> DATEADD(mm, - 1 , PurOrderHeader.Date) AND*/\n\t\t\t\t\t\t\t\t\t\t\t\tIH.date>rtrim(ltrim(str(MONTH( PurOrderHeader.Date))))+'/01/' +rtrim(ltrim(str(year( PurOrderHeader.Date)))) AND\n\t\t\t\t\t\t\t\t\t\t\t\tIH.date< PurOrderHeader.Date AND \n\t\t\t\t\t\t\t\t\t\t\t\tIH.issueinvcode=ID.issueinvcode and\n\t\t\t\t\t\t\t\t\t\t\tID.icode=PurOrderDetail.Icode),\n\t\tlastreceiptdate=(select max(RH.postdate) \n\t\t\t\t\t\t\t\tfrom purledger RH, purdetail RD\n\t\t\t\t\t\t\t\twhere RH.posted='Y' AND\n\t\t\t\t\t\t\t\t\t\tRH.purinvcode=RD.purinvcode AND\n\t\t\t\t\t\t\t\t\t\t RD.icode=PurOrderDetail.Icode),\n\t\tlastreceiptremarks=(select max(RH.remarks) \n\t\t\t\t\t\t\t\tfrom purledger RH, purdetail RD\n\t\t\t\t\t\t\t\twhere RH.posted='Y' AND\n\t\t\t\t\t\t\t\t\t\tRH.purinvcode=RD.purinvcode AND\n\t\t\t\t\t\t\t\t\t\t RD.icode=PurOrderDetail.Icode),\n         Accounts.Name,\n\t\t\tPurOrderDetail.PORowID,\n\t\t\tManufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),\n\t\t\tstartdate=PurOrderHeader.startdate,\n\t\t\tenddate=PurOrderHeader.enddate,\n\t\t\tprojectiondays=PurOrderheader.Projectionperiod,\n\t\t\tpurordercatcode=PurOrderHeader.purordercatcode\n    FROM PurOrderDetail,    \n         PurOrderHeader,   \n         Accounts, \n         item \n   WHERE ( PurOrderHeader.POCode = PurOrderDetail.POCode ) and  \n\t\t\t( PurOrderDetail.icode = item.icode ) and  \n         ( PurOrderHeader.SuppCode = Accounts.AccCode ) and  \n         ( ( PurOrderHeader.POCode = :ra_POCode ) )    \nORDER BY\n\t\t\tcategory,\n\t\t\titemname\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_POCode",
      "number"
     ]
    }
   ]
  }
 },
