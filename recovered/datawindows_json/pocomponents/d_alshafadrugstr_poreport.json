  ],
  "retrieve": "SELECT \n\tType = '   ',\n\tcustomername=SPACE(60),   \n\titemname= item.name, \n\tCode=PurOrderHeader.POCode,   \n\tPurOrderHeader.Date,   \n\tPurOrderDetail.ICode,   \n\tQty = PurOrderDetail.Qty,   \n\tPrice = PurOrderDetail.PurPrice,   \n\tDiscperc = PurOrderDetail.Discperc,   \n\tAccounts.Name,\n\tRowID=PurOrderDetail.PORowID,\n\tManufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),\n\tRemarks = PurOrderHeader.Remarks,\n\tTotal = ISNULL((SELECT ROUND(SUM(POD.QTY * POD.PurPrice * (1 - POD.DiscPerc * 0.01)), 0) FROM PurOrderDetail POD WHERE POD.POCode = PurOrderHeader.POCode), 0)\nFROM PurOrderDetail,    \n\tPurOrderHeader,   \n\tAccounts, \n\titem \nWHERE \n\tPurOrderHeader.POCode = PurOrderDetail.POCode and  \n\tPurOrderDetail.icode = item.icode and  \n\tPurOrderHeader.SuppCode = Accounts.AccCode and  \n\tPurOrderHeader.POCode = :ra_POCode\nUNION ALL\nSELECT \n\tType = 'Expiry Reminder',\n\tcustomername=SPACE(60),   \n\titemname= item.name, \n\tCode=PRLedger.PRInvCode,   \n\tDate=PRLedger.Date,   \n\tICode=PRDetail.ICode,   \n\tQty = PRDetail.LooseQty,   \n\tPrice = PRDetail.PRPrice,   \n\tDiscperc = PRDetail.Discperc,   \n\tAccounts.Name,\n\tRowID = 999999999,\n\tManufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),\n\tRemarks = PRLedger.Remarks,\n\tTotal = ISNULL(\n\t\t(SELECT ROUND( ROUND(\n\t\t\t\t\tSUM(PD.LooseQty * PD.PRPrice * \n\t\t\t\t\t\t(1 - PD.discperc * 0.01) * \n\t\t\t\t\t\t(1 - PL.discperc * 0.01)) + PL.MiscCharges - PL.FlatDisc, 0) + \n\t\t\t\tRound (\n\t\t\t\t/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( PD.looseqty + PD.packqty ) * PD.prprice * (1 - PD.discperc * 0.01 ) , 2 ) )\n\t\t\t\t* ( 1 - PL.discperc * 0.01 ) , 2 ) - PL.flatdisc ) * PL.invgstperc1 * 0.01  , 2 )\n\t\t\t\t/*items salestax*/\t\t + Sum (Round ( (PD.looseqty + PD.packqty + PD.bonusqty)* PD.unitsalestax + Round ( Round ( (PD.looseqty + PD.packqty) * PD.prprice * (1 - PD.discperc * 0.01 ), 2 ) * PD.gstperc * 0.01 , 2 ) , 2 ) )\t\t\t\t\t\t \n\t\t\t\t, 0 ), 0)\n\t\tFROM PRLedger PL, PRDetail PD \n\t\tWHERE PL.PRInvCode = PD.PRInvCode AND\n\t\t\tPL.PRInvCode = PRLedger.PRInvCode\n\t\tGROUP BY PL.MiscCharges, PL.FlatDisc, PL.DiscPerc, PL.InvGSTPErc1), 0)\nFROM PRDetail,    \n\tPRLedger,   \n\tAccounts, \n\titem \nWHERE \n\tPRLedger.Posted='N' AND\n\tPRLedger.SuppCode IN \n\t\t(SELECT DISTINCT PO.SuppCode\n\t\tFROM PurOrderHeader PO\n\t\tWHERE PO.POCode = :ra_POCode ) AND\n\tPRLedger.PRInvCode = PRDetail.PRInvCode and  \n\tPRDetail.ICode = item.icode and  \n\tPRLedger.SuppCode = Accounts.AccCode\nORDER BY \n\tType,\n\tCode,\n\tItemName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_POCode",
      "number"
     ]
    }
   ]
  },
  "sort": "type A, code A, itemname A"
 },
