  "retrieve": "SELECT  \n\tI.name, \n\titemalias=I.customicode,\n\tOH.POCode,\n\tOH.Date,\n\tAcc.Aliasname,\n\tAcc.name,\n\tS.address1,\n\tS.address2,\n\tS.city,\n\tS.phone, \n\tS.fax,\n\tOH.remarks,\n\tOH.startdate,\n\tOH.Enddate,\n\tOH.projectionperiod,\n\tOH.Discperc,\n\tI.packingdesc,\n\tOD.rate,\n\tOD.qty,\n\tOD.bonusqty,\n\tpackunits=(case OD.packunits when 0 then 1 else OD.packunits end),\n\tOD.discperc,\n\tOD.reorderqty,\n\tOD.OptimumQty,\n\tOD.minQty,\n\tOD.Stock,\n\tOD.TransitStock,\n\tOD.SoldQty,\n\tOD.ReturnQty,\n\t/*amount= (OD.qty * OD.rate) * ( 1 - (OD.discperc * 0.01) ) ,*/\n\tamount= (OD.qty * I.recentpurprice)  ,\n\tOH.PurOrderCatCode,\n\trecentpurprice=I.recentpurprice,\n\tManufacturer=(SELECT Manufacturer.Name FROM Manufacturer WHERE Manufacturer.ManfCode=I.ManfCode),\n\tCategory=(SELECT ItemCategory.Name FROM ItemCategory WHERE ItemCategory.ICatCode=I.ICatCode),\n\tPacking=(SELECT ItemPacking.Name FROM ItemPacking WHERE ItemPacking.PackCode=I.PackCode)\n\nFROM item I, accounts Acc, purorderheader OH, purorderdetail OD , Supplier S\n\nWHERE OH.pocode= :ai_POCode AND\n\t\t      OH.pocode=OD.pocode AND\n\t\tOH.suppCode = S.SuppCode AND\n      OH.suppcode=Acc.acccode AND\n      OD.icode=I.icode\n\norder by oh.pocode, category, i.name, i.customicode, packing, manufacturer",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_POCode",
      "number"
     ]
    }
   ]
  },
  "sort": "pocode A, category A, packingdesc A, item_name A, packing A, manufacturer A"
 },
