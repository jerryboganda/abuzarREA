    "name": "aliasname",
    "dbname": "AliasName"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "suppliername",
    "dbname": "SupplierName"
   }
  ],
  "retrieve": "SELECT \n\tSuppCode= A.AccCode, \n\tAliasName = A.AliasName,\n\tSupplierName = A.Name\nFROM\n\tAccounts A,\n\t(SELECT \n\t\tDISTINCT IPS.SuppCode\n\tFROM\n\t\tItem I,\n\t\tManufacturer M,\n\t\tItemSuppliers IPS, \n\t\t(SELECT ManfCode \n\t\tFROM Manufacturer\n\t\tWHERE\n\t\t\tPOPolicyCode IN \n\t\t\t\t(SELECT DISTINCT CP.POPolicyCode \n\t\t\t\tFROM POPolicy CP, POPolicyDetail CPD\n\t\t\t\tWHERE \n\t\t\t\t\tCP.POPolicyCode = CPD.POPolicyCode AND\n\t\t\t\t\tCPD.WeekDayCode = DatePart(weekday, :ad_orderdate) AND\n\t\t\t\t\tCPD.WeekOfMonth IN \n\t\t\t\t\t\t(SELECT WeekOfMonth=DBO.Fn_WeekDayCountInMonth(:ad_orderdate)))) TM\n\tWHERE\n\t\tTM.ManfCode = M.ManfCode AND M.ManfCode = I.ManfCode AND I.ICode = IPS.ICode) T\nWHERE A.AccCode=T.SuppCode\nORDER BY \n\tSupplierName ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_orderdate",
      "datetime"
     ]
    }
   ]
  }
 },
