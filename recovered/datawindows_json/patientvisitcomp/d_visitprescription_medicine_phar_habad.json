  "retrieve": "SELECT \n\tVisitCode = V.VisitCode,\n\tVisitDate = V.Date,\n\tVisitType = (SELECT VT.Name FROM VisitType VT WHERE VT.VisitTypeCode = V.VisitTypeCode),\n\tPatientRegNo = P.RegNo,\n\tPatientName = CASE V.PatientCode WHEN NULL THEN V.PatientDetails ELSE LTRIM(RTRIM(P.Name)) + ' (' + LTRIM(RTRIM(P.RegNo)) + ')' END,\n\tPatientGender = P.Gender,\n\tPatientPhone = P.Phone,\n\tAge = DATEDIFF(YYYY, P.DOB, V.Date),\n\tHeight = LTRIM(RTRIM(STR(VV.Height1))) + ' ' + VV.HeightUnit1 + ' ' + LTRIM(RTRIM(STR(ISNULL(VV.Height2,'0')))) + ' ' + VV.HeightUnit2,\n\tWeight = LTRIM(RTRIM(STR(VV.Weight1))) + ' ' + VV.WeightUnit1 + ' ' + LTRIM(RTRIM(STR(ISNULL(VV.Weight2, '0')))) + ' ' + VV.WeightUnit2,\n\tPulseRate = LTRIM(RTRIM(STR(VV.PulseRate))),\n\tRespirationRate = LTRIM(RTRIM(STR(VV.Respiration))),\n\tBP = LTRIM(RTRIM(STR(VV.BloodPressureSysTolic))) + '/' + LTRIM(RTRIM(STR(VV.BloodPressureDiaSTolic))),\n\tPreviousDiagnosis = V.PreviousDiagnosis,\n\tDiagnosis = V.Diagnosis,\n\tRecommendations = V.Recommendations,\n\tRemarks = V.Remarks,\n\tFollowUpDate = V.Date + V.FollowUpDays,\n\tItemName = (SELECT I.Name FROM Item I WHERE VP.ICode = I.ICode),\n\tDosageQty = VP.Qty,\n\tDosageUnit = (SELECT DU.Name FROM DosageUnit DU WHERE DU.DosageUnitCode = VP.DosageUnitCode),\n\tLocalDosageUnit = (SELECT DU.LocalDosageUnit FROM DosageUnit DU WHERE DU.DosageUnitCode = VP.DosageUnitCode),\n\tDosageStrength = VP.DosageStrength,\n\tDosageFreq = (SELECT D.Name FROM Dosage D WHERE D.DosageCode = VP.DosageCode),\n\tLocalDosage = (SELECT D.LocalDosage FROM Dosage D WHERE D.DosageCode = VP.DosageCode),\n\tDuration = VP.Duration,\n\tDoctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = V.DoctCode)\nFROM\n\tVisit V\n\tLEFT OUTER JOIN Patient AS P ON (V.PatientCode = P.PatientCode)\n\tLEFT OUTER JOIN VisitPrescription AS VP ON (V.VisitCode = VP.VisitCode),\n\tVisitVitals VV\nWHERE\n\tV.VisitCode = :ai_code AND\n\tV.VisitCode = VV.VisitCode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
