  "retrieve": "SELECT \n\tVisitCode,\n\tAppointmentCode=AppointmentCode,\n\tDoctCode,\n\tDate,\n\tVisitTypeCode,\n\tVisitStatusCode,\n\tRegno = (SELECT Patient.RegNo FROM Patient WHERE Patient.PatientCode = Visit.PatientCode),\n\tPatientName = ISNULL((SELECT Patient.Name FROM Patient WHERE Patient.PatientCode = Visit.PatientCode), PatientDetails),\n\tPatientCode,\n\tPosted,\n\tUserCode,\n\tAppointmentStatusCode=(SELECT AP.AppointmentStatusCode FROM VisitAppointment AP WHERE AP.AppointmentCode = Visit.AppointmentCode),\n\tColorValue = (SELECT APS.ColorValue  FROM VisitAppointment AP, AppointmentStatus APS  WHERE AP.AppointmentCode = Visit.AppointmentCode AND APS.AppointmentStatusCode = AP.AppointmentStatusCode)\nFROM\n\tDBO.Visit\nWHERE\n\tDate BETWEEN :adt_startdate AND :adt_enddate",
  "update": "DBO.Visit",
  "updatewhere": "1",
  "updatekeyinplace": "no",
