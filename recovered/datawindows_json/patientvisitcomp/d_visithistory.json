  "retrieve": "SELECT \n\tVisitCode=V.VisitCode,\n\tVisitDate=V.Date,\n\tVisitType = VT.Name,\n\tPatientCode = P.PatientCode,\n\tPatientRegNo=P.Regno,\n\tWeight = (SELECT LTRIM(RTRIM(STR(VV.Weight1))) + ' ' + VV.WeightUnit1 + ' ' + LTRIM(RTRIM(STR(ISNULL(VV.Weight2, '0')))) + ' ' + VV.WeightUnit2 FROM VisitVitals VV WHERE VV.VisitCode = V.VisitCode), \n\tHeight = (SELECT LTRIM(RTRIM(STR(VV.Height1))) + ' ' + VV.HeightUnit1 + ' ' + LTRIM(RTRIM(STR(ISNULL(VV.Height2,'0')))) + ' ' + VV.HeightUnit2 FROM VisitVitals VV WHERE VV.VisitCode = V.VisitCode), \n\tPulseRate = (SELECT LTRIM(RTRIM(STR(VV.PulseRate))) FROM VisitVitals VV WHERE VV.VisitCode = V.VisitCode), \n\tRespirationRate = (SELECT LTRIM(RTRIM(STR(VV.Respiration))) FROM VisitVitals VV WHERE VV.VisitCode = V.VisitCode), \n\tBMI = (SELECT VV.BMI FROM VisitVitals VV WHERE VV.VisitCode = V.VisitCode), \n\tBSA = (SELECT VV.BSA FROM VisitVitals VV WHERE VV.VisitCode = V.VisitCode),\n\tBP = (SELECT LTRIM(RTRIM(STR(VV.BloodPressureSysTolic))) + '/' + LTRIM(RTRIM(STR(VV.BloodPressureDiaSTolic))) FROM VisitVitals VV WHERE VV.VisitCode = V.VisitCode), \n\tVisitStatus = (SELECT VS.Name FROM VisitStatus VS WHERE VS.VisitStatusCode = V.VisitStatusCode),\n\tPatientName= LTRIM(RTRIM(P.Name)) + ' (' + LTRIM(RTRIM(STR(P.PatientCode))) + ')',\n\tDoctor = D.Name\nFROM\n\tVisit V, Patient P, Doctors D, VisitType VT\nWHERE\n\tV.PatientCode = :ai_patientcode AND\n\tV.PatientCode = P.PatientCode AND\n\tV.DoctCode = D.DoctCode AND\n\tV.VisitTypeCode = VT.VisitTypeCode\nORDER BY\n\tVisitDate",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_patientcode",
      "number"
     ]
    }
   ]
  },
  "sort": "visitcode D"
 },
