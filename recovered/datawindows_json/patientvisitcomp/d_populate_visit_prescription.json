  "retrieve": "SELECT \n\tDISTINCT \n\tVisitPrescription.ICode,   \n\tItemName = (SELECT Item.Name FROM Item WHERE Item.ICode = VisitPrescription.ICode),\n\tVisitPrescription.Duration,\n\tVisitPrescription.DiseaseCode,\n\tVisitPrescription.DosageCode,\n\tDosage = (SELECT D.Name FROM Dosage D WHERE D.DosageCode=VisitPrescription.DosageCode),\n\tLocalDosage = (SELECT D.LocalDosage FROM Dosage D WHERE D.DosageCode=VisitPrescription.DosageCode),\n\tVisitPrescription.DosageFactor,\n\tVisitPrescription.RouteCode,\n\tVisitPrescription.InsCode,\n\tVisitPrescription.Qty,\n\tManualChangeInTotQty = 0,\n\tVisitPrescription.DosageUnitCode,\n\tDosageUnit = (SELECT D.Name FROM DosageUnit D WHERE D.DosageUnitCode=VisitPrescription.DosageUnitCode),\n\tLocalDosageUnit = (SELECT D.LocalDosageUnit FROM DosageUnit D WHERE D.DosageUnitCode=VisitPrescription.DosageUnitCode),\n\tVisitPrescription.DosageStrength,\n\tRate = 0.00,\n\tVisitPrescription.TotalQty,\n\tVisitPrescription.Details\nFROM \n\tVisitPrescription  \nWHERE \n\tVisitPrescription.ICode = :ai_icode\nORDER BY \n\tVisitPrescription.Qty ASC,   \n\tVisitPrescription.Duration ASC",
  "arguments": {
   "_items": [
