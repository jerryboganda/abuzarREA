  ],
  "retrieve": "SELECT \n\tAppointmentCode,\n\tDate,\n\tDueDate,\n\tTokenNo,\n\tAppointmentMethodCode,\n\tAppointmentStatusCode,\n\tColorValue = (SELECT APS.ColorValue FROM AppointmentStatus APS WHERE APS.AppointmentStatusCode = VisitAppointment.AppointmentStatusCode),\n\tRegno = (SELECT Patient.RegNo FROM Patient WHERE Patient.PatientCode = VisitAppointment.PatientCode),\n\tPatientName = ISNULL((SELECT Patient.Name FROM Patient WHERE Patient.PatientCode = VisitAppointment.PatientCode), PatientDetails),\n\tPatientCode,\n\tRemarks,\n\tReferredBy,\n\tUserCode\nFROM\n\tDBO.VisitAppointment\nWHERE\n\tDoctCode = :ai_doctcode AND \n\tPosted = 'N' AND \n\tDueDate BETWEEN CAST(CONVERT(VARCHAR(100), GETDATE(),111) + ' 00:00:00' AS DATETIME) AND \n\t\tCAST(CONVERT(VARCHAR(100), GETDATE(),111) + ' 23:59:59' AS DATETIME)\nUNION ALL\nSELECT \n\tAppointmentCode=NULL,\n\tDate=NULL,\n\tDueDate=NULL,\n\tTokenNo=NULL,\n\tAppointmentMethodCode=NULL,\n\tAppointmentStatusCode=NULL,\n\tColorValue = NULL,\n\tRegno = NULL,\n\tPatientName = NULL,\n\tPatientCode=NULL,\n\tRemarks=NULL,\n\tReferredBy=NULL,\n\tUserCode=NULL\n",
  "update": "DBO.VisitAppointment",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_doctcode",
      "number"
     ]
    }
   ]
  },
  "sort": "duedate A, code A, tokenno A"
 },
