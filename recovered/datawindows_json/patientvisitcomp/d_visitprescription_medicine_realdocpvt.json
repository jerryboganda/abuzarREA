  "retrieve": "SELECT \n\tTYPE = 1,\n\tTypeDesc = 'Drug Name and Dosage',\n\tVisitCode = V.VisitCode,\n\tItemName = LTRIM(RTRIM(ISNULL((SELECT DU.Name FROM DosageUnit DU WHERE DU.DosageUnitCode = VP.DosageUnitCode),'') + ' ' + (SELECT I.Name + ' (' + GI.Name + ')' FROM Item I, GenericItem GI WHERE VP.ICode = I.ICode AND GI.GenericCode = I.GenericCode))),\n\tDosageQty = VP.Qty,\n\tDosageUnit = NULL,\n\tLocalDosageUnit = NULL,/*(SELECT DU.LocalDosageUnit FROM DosageUnit DU WHERE DU.DosageUnitCode = VP.DosageUnitCode),*/\n\tDosageStrength = VP.DosageStrength,\n\tDosageFreq = (SELECT D.Name FROM Dosage D WHERE D.DosageCode = VP.DosageCode),\n\tLocalDosage = (SELECT D.LocalDosage FROM Dosage D WHERE D.DosageCode = VP.DosageCode),\n\tRowID = VP.RowID,\n\tDuration = VP.Duration,\n\tDoctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = V.DoctCode),\n\tDisease = (SELECT D.Name FROM Disease D WHERE D.DiseaseCode = VP.DiseaseCode),\n\tDetails = VP.Details \nFROM\n\tVisit V\n\tLEFT OUTER JOIN VisitPrescription AS VP ON (V.VisitCode = VP.VisitCode)\nWHERE\n\tV.VisitCode = :ai_code\nUNION ALL\nSELECT \n\tTYPE = 2,\n\tTypeDesc = 'Precausions',\n\tVisitCode = VisitPrecaution.VisitCode,\n\tItemName = Precaution.Name,\n\tDosageQty = 0,\n\tDosageUnit = NULL,\n\tLocalDosageUnit = NULL,   \n\tDosageStrength = NULL,\n\tDosageFreq = NULL,\n\tLocalDosage = Precaution.LocalPrecaution, \n\tRowID = NULL,\n\tDuration = NULL,\n\tDoctor = NULL,\n\tDisease = NULL,\n\tDetails = NULL\nFROM Precaution,   \n\tVisitPrecaution  \nWHERE ( VisitPrecaution.PrecautionCode = Precaution.PrecautionCode ) and  \n\t( VisitPrecaution.VisitCode = :ai_code )\nUNION ALL\nSELECT \n\tTYPE = 3,\n\tTypeDesc = 'Test Recommedations',\n\tVisitCode = VisitDiagnostics.VisitCode,\n\tItemName = DiagnosticItem.Name,\n\tDosageQty = 0,\n\tDosageUnit = (SELECT MAX(Visit.Recommendations) FROM Visit WHERE Visit.VisitCode = :ai_code),\n\tLocalDosageUnit = NULL,   \n\tDosageStrength = NULL,\n\tDosageFreq = NULL,\n\tLocalDosage = NULL,\n\tRowID = NULL,\n\tDuration = NULL,\n\tDoctor = NULL,\n\tDisease = NULL,\n\tDetails = NULL\nFROM DiagnosticItem,   \n\tVisitDiagnostics\nWHERE VisitDiagnostics.DiagnosticItemCode = DiagnosticItem.DiagnosticItemCode  AND \n\tVisitDiagnostics.VisitCode = :ai_code\nUNION ALL\nSELECT \n\tTYPE = 4,\n\tTypeDesc = 'Clinical Diagnosis',\n\tVisitCode = VS.VisitCode,\n\tItemName = S.Name,\n\tDosageQty = 0,\n\tDosageUnit = NULL,\n\tLocalDosageUnit = NULL,   \n\tDosageStrength = NULL,\n\tDosageFreq = NULL,\n\tLocalDosage = (SELECT SL.Name FROM SeverityLevel SL WHERE VS.SeverityLevelCode = SL.SeverityLevelCode) + ' - ' + VS.Details,\n\tRowID = VS.RowID, \n\tDuration = VS.Duration,\n\tDoctor = NULL,\n\tDisease = NULL,\n\tDetails = NULL\nFROM \n\tVisitSymptoms VS, Symptom S\nWHERE \n\tVS.VisitCode = :ai_code AND\n\tS.SymptomCode = VS.SymptomCode\nUNION ALL\nSELECT \n\tTYPE = 5,\n\tTypeDesc = 'Physical Examination',\n\tVisitCode = VP.VisitCode,\n\tItemName = PE.Name,\n\tDosageQty = 0,\n\tDosageUnit = NULL,\n\tLocalDosageUnit = NULL,   \n\tDosageStrength = NULL,\n\tDosageFreq = NULL,\n\tLocalDosage = VP.Details,\n\tRowID = VP.RowID, \n\tDuration = NULL,\n\tDoctor = NULL,\n\tDisease = NULL,\n\tDetails = NULL\nFROM \n\tVisitPhysicalExam VP, PhysicalExam PE\nWHERE \n\tVP.VisitCode = :ai_code AND\n\tVP.PhysicalExamCode = PE.PhysicalExamCode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  },
  "sort": "type A, rowid A"
 },
