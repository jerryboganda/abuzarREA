  "retrieve": "SELECT  \n\tIssueReqHeader.IssueReqinvcode , \n\tIssueReqHeader.date , \n\tIssueReqHeader.remarks , \n\tDepartment = (SELECT D.Name FROM Department D WHERE D.DeptCode = IssueReqHeader.DeptCode), \n\tArea = (SELECT A.Name FROM Area A WHERE A.AreaCode = IssueReqHeader.AreaCode), \n\tSalesPerson = (SELECT S.Name FROM SalesMan S WHERE S.SalesmanCode = IssueReqHeader.SManCode), \n\tAccountName = (SELECT A.Name FROM Accounts A WHERE A.AccCode = IssueReqHeader.AccCode), \n\tdbo.users.username,\n\tposted = IssueReqHeader.posted,\n\tPostedBy = IsNull((Select username from users \n\t\t\t\twhere dbo.IssueReqHeader.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\t\t\twhere dbo.IssueReqHeader.modifiedby = dbo.users.usercode), '') \nFROM  \n\tusers,\n\tIssueReqHeader\n\t\nWHERE  \n\t(dbo.IssueReqHeader.date > :ad_invdate) and\n\t( Posted IN (:as_Posted)) and\n\t( dbo.IssueReqHeader.salesmancode = dbo.users.usercode ) ",
