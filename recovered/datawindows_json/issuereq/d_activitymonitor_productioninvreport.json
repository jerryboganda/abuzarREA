  "retrieve": "SELECT \n\titemname= item.name, \n\turduname=item.localitemname,\n\tsalesman = dbo.users.username, \n\tcode =prodheader.prodcode,\n\tdate = dbo.prodheader.date,   \n\tdbo.prodheader.remarks,\t \n\tlooseqty = proddetail.qty,\n\tId       = proddetail.IDENTITYCOL \nFROM \n\t(SELECT DISTINCT DocumentCode \n\tFROM\n\t\tActivityMonitor\n\tWHERE DocRowID = :ar_rowid) T,\n\tprodheader, \n\tproddetail,\n\tusers, \n\titem\n\t\n\tWHERE ( dbo.prodheader.prodcode = T.DocumentCode ) AND\n\t( dbo.prodheader.prodcode = dbo.proddetail.prodcode) AND\n\t( dbo.prodheader.createdby = dbo.users.usercode ) AND \n\t( dbo.proddetail.icode = item.icode)\nORDER BY \n\tdbo.proddetail.IDENTITYCOL",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_rowid",
      "numberlist"
     ]
    }
   ]
  }
