  "retrieve": "SELECT \n\tProdCode,\n\tProdRowID,\n\tRowID,\n\tFullCode=(SELECT Item.CustomICode FROM ITEM WHERE Item.ICode = ProdBuffer.ICode),\n\tItemName=(SELECT Item.Name FROM ITEM WHERE Item.ICode = ProdBuffer.ICode),\n\tCurrListRow=0, \n\tItemCode=ICode,\n\tSetCode=(SELECT Item.ICode FROM ITEM, ProdDetail D WHERE ProdBuffer.ProdRowID = D.RowID AND Item.ICode = D.ICode),   \n\tProdQty=(SELECT D.Qty FROM ITEM, ProdDetail D WHERE ProdBuffer.ProdRowID = D.RowID AND Item.ICode = D.ICode),   \n\tICode=ICode,   \n\tRemarks=Remarks,   \n\tTotalStock=0.0000,   \n\tParentRow=0,\n\tPackPrice=ProdBuffer.PackPrice,\n\tPrice=ProdBuffer.Price,\n\tPackUnits=ProdBuffer.PackUnits,\n\tItemFlatDisc=ProdBuffer.ItemFlatDisc,\n\tDiscPerc=ProdBuffer.DiscPerc,\n\tProcessCharge=ProdBuffer.ProcessCharge,\n\tProcessChargePerc=ProdBuffer.ProcessChargePerc,\n\tQty=ProdBuffer.Qty\nFROM \n\tProdBuffer\nWHERE \n\tProdBuffer.ProdCode = :ai_code\nORDER BY\n\tProdBuffer.ProdRowID,\n\tProdBuffer.RowID\n\t",
  "update": "ProdBuffer",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
