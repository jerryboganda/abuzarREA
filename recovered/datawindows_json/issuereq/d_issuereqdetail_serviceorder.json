    "values": "Yes\tY/No\tN/"
   },
   {
    "type": "decimal(2)",
    "update": "yes",
    "updatewhereclause": "yes",
    "validation": "real(gettext()) >= 0 AND real(gettext()) <= 100",
    "validationmsg": "\"Claimable Disc. % mest be in range [0-100]\"",
    "initial": "0",
    "name": "claimablediscperc",
    "dbname": "ClaimableDiscPerc"
   },
   {
    "type": "long",
    "update": "yes",
    "updatewhereclause": "yes",
    "validation": "real(gettext()) > 0",
    "validationmsg": "\"Quantity should be greater than zero\"",
    "initial": "1",
    "name": "qty",
    "dbname": "qty"
   }
  ],
  "retrieve": "SELECT \n\titem.customicode, \n\titemname= item.name, \n\tcurrlistrow = 0,\n\tstock     = 0.0000, \n\ttotalstock= 0.0000, \n\tassgcode  = 1, \n\tupdatesaleprice = 'N',\n\tissuereqdetail.issuereqinvcode,   \n\tsectcode = issuereqdetail.sectcode,\n\ticode = issuereqdetail.icode,   \n\tpackunits = max(issuereqdetail.packunits),\n\tIssueReqRowID=MAX(issuereqdetail.IssueReqRowID),\n\tsaleprice = max(issuereqdetail.saleprice),\n\tpurchaseprice = max(issuereqdetail.purchaseprice),\n\tavgprice = max(issuereqdetail.avgprice),\n\titemcode = issuereqdetail.icode,\n\tClaimable = issuereqdetail.Claimable,\n\tClaimableDiscPerc = issuereqdetail.ClaimableDiscPerc,\n\tqty  = sum(issuereqdetail.qty)\nFROM \n\tissuereqdetail, item \nWHERE \n\t( dbo.issuereqdetail.issuereqinvcode IN (SELECT IssueReqInvCode=MIN(IssueReqInvCode) FROM IssueReqHeader WHERE ServiceOCode = :ar_ServiceOCode)) AND\n\t( issuereqdetail.icode = item.icode )\nGROUP BY \n\tissuereqdetail.issuereqinvcode, \n\tissuereqdetail.icode, \n\tissuereqdetail.sectcode,\n\titem.customicode, \n\tissuereqdetail.Claimable,\n\tissuereqdetail.ClaimableDiscPerc,\n\tissuereqdetail.IssueReqRowID,\n\titem.name\nORDER BY\n\tIssueReqRowID\n\t\n",
  "update": "issuereqdetail",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_ServiceOCode",
      "number"
     ]
    }
   ]
  }
 },
