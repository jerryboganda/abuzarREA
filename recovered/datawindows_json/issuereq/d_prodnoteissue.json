  "retrieve": "SELECT\n\tProdNoteCode, \n\tRowID,\n\tFullCode=(SELECT Item.CustomICode FROM ITEM WHERE Item.ICode = ProdNoteIssue.ICode),\n\tItemName=(SELECT Item.Name FROM ITEM WHERE Item.ICode = ProdNoteIssue.ICode),\n\tCurrListRow=0, \n\tItemCode=0,\n\tICode,\n\tTotalStock=0.0000,\n\tGodownStock=0.0000,\n\tGCode,\n\tTotalPieces,\n\tPiecesInHand,\n\tPrice, \n\tPackUnits,\n\tQty\nFROM\n\tProdNoteIssue\nWHERE \n\tProdNoteIssue.ProdNoteCode = :ai_code\nORDER BY\n\tProdNoteIssue.ProdNoteCode,\n\tProdNoteIssue.RowID\n",
