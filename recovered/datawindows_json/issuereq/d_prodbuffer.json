  "retrieve": "SELECT \t\n\tdbo.ProdHeader.ProdCode,   \n\tdate = dbo.ProdHeader.date,\n\tProdHeader.OriginalDate,\n\tProdHeader.PostDate,\n\tProdHeader.CreatedBy,\n\tProdHeader.ModifiedBy,\n\tProdHeader.PostedBy,\n\tsalesmanname = dbo.users.username,\n\tremarks = dbo.ProdHeader.remarks,   \n\tFinalized = dbo.ProdHeader.Finalized,\n\tFinalizedOn = dbo.ProdHeader.FinalizedOn,\n\tFinalizedBy = dbo.ProdHeader.FinalizedBy,\n\tposted = dbo.ProdHeader.posted,\n\tProdHeader.IssueGCode,\n\tProdHeader.ReceiptGCode\nFROM \n\tdbo.ProdHeader, dbo.users\nWHERE \n\tdbo.users.usercode = dbo.ProdHeader.CreatedBy and  \n\tdbo.ProdHeader.ProdCode = :ar_ProdCode\n",
