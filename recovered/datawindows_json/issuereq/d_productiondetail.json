  "retrieve": "SELECT \n\titem.customicode, \n\titemname= item.name, \n\tcurrlistrow = 0,\n\tstock     = 0.0000, \n\ttotalstock= 0.0000, \n\tassgcode  = 1, \n\tupdatesaleprice = 'N',\n\tproddetail.prodcode,   \n\tproddetail.RowId,\n\ticode = proddetail.icode,   \n\titemcode = 0,\n\tProdDetail.Batch,\n\tProdDetail.Expiry,\n\tMinRecipeQty=ISNULL(\n\t\t(SELECT M=MAX(R.Qty) \n\t\tFROM Recipe R \n\t\tWHERE R.ResultedItem = ProdDetail.ICode AND R.Priority IN \n\t\t\t(SELECT Min(Priority) FROM Recipe WHERE ResultedItem = ProdDetail.icode)), 1),\n\tqty  = ProdDetail.qty\nFROM\n\tProdDetail, \n\titem \nWHERE \n\t( dbo.Proddetail.ProdCode = :ar_IssueInvCode ) AND\n\t( ProdDetail.icode = item.icode )\nORDER BY \n\tProdDetail.RowID\n\t\n\t\n",
  "update": "ProdDetail",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_IssueInvCode",
      "number"
     ]
    }
   ]
  }
 },
