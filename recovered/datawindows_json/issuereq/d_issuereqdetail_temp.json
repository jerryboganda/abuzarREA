  ],
  "retrieve": "SELECT item.customicode, \n\t\t\titemname= item.name, \n\t\t\tcurrlistrow = 0,\n\t\t\tstock     = 0.0000, \n\t\t\ttotalstock= 0.0000, \n\t\t\tassgcode  = 1, \n\t\t\tupdatesaleprice = 'N',\n         issuereqdetail.issuereqinvcode,   \n\t\t\tsectcode = issuereqdetail.sectcode,\n         icode = issuereqdetail.icode,   \n\t\t\tpackunits = max(issuereqdetail.packunits),\n       \tsaleprice = max(issuereqdetail.saleprice),\n\t\t\tpurchaseprice = max(issuereqdetail.purchaseprice),\n\t\t\tavgprice = max(issuereqdetail.avgprice),\n\t\t\titemcode = 0,\n\t\t\tqty  = sum(issuereqdetail.qty)\n\nFROM issuereqdetail, item \n\nWHERE ( dbo.issuereqdetail.issuereqinvcode = :ar_IssueInvCode )    AND\n\t\t   ( issuereqdetail.icode = item.icode )\n         \nGROUP BY issuereqdetail.issuereqinvcode, \n\t\t\tissuereqdetail.icode, \n\t\t\tissuereqdetail.sectcode,\n\t\t\titem.customicode, \n\t\t\titem.name \n\n\n\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_IssueInvCode",
      "number"
     ]
    }
   ]
  }
 },
