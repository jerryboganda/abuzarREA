   }
  ],
  "retrieve": "select \n\titem.name,\n\titemaliasname=item.customicode,\n\tItemPacking.name, \n\tissueheader.issueinvcode,\n\tRecipientName = \n\t\tCASE issueheader.RecipientCode \n\t\tWHEN 1 THEN\n\t\t\t(SELECT D.Name FROM Department D WHERE D.DeptCode = issueheader.DeptCode)\n\t\tWHEN 4 THEN\n\t\t\t(SELECT S.Name FROM Salesman S WHERE S.SalesManCode = issueheader.SManCode)\n\t\tELSE\n\t\t\t(SELECT A.Name FROM Accounts A WHERE A.AccCode = issueheader.Acccode)\n\t\tEND,\n\tissueheader.headerno,\n\tissueheader.headerinvno,\n\tissueheader.remarks,\n\tissueheader.date,\n\tsd.qty,\n\tsd.Price, \n\tsd.batch, \n\tsd.expiry\nFrom   \n\t(Select icode,issueinvcode,qty,price,batch,expiry From issuedetail Where icode = :ar_icode) sd \n\t\tInner Loop join issueheader On sd.issueinvcode = issueheader.issueinvcode \n\t\tInner Join Item On SD.Icode = Item.Icode \n\t\tLeft  Outer Join ItemPacking On Item.packcode = ItemPacking.PackCode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_icode",
      "number"
     ]
    }
   ]
  },
  "sort": "date D, itemname A, saledetail_batch A, saledetail_expiry A"
 },
