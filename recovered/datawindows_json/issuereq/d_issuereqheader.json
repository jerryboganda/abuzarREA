  "retrieve": "SELECT \n\tdbo.IssueReqHeader.issuereqinvcode,   \n\tsalesmancode = dbo.IssueReqHeader.salesmancode,\n\tdeptcode = dbo.IssueReqHeader.DeptCode,   \n\tdate = dbo.IssueReqHeader.date,\n\tsalesmanname = dbo.users.username,\n\tpostdate = dbo.IssueReqHeader.postdate,   \n\tremarks = dbo.IssueReqHeader.remarks,   \n\tposted = dbo.IssueReqHeader.posted, \n\toriginaldate = dbo.IssueReqHeader.originaldate,\n\tAccCode = dbo.IssueReqHeader.AccCode,\n\tmodifiedby = dbo.IssueReqHeader.modifiedby,\n\tpostedby = dbo.IssueReqHeader.postedby,\n\tsmancode = dbo.IssueReqHeader.SmanCode,\n\tareacode = dbo.IssueReqHeader.areaCode,\n\tServiceOCode = dbo.IssueReqHeader.ServiceOCode\n\t\nFROM \n\tdbo.IssueReqHeader,\n\tdbo.users\nWHERE \n\n\t( dbo.users.usercode = dbo.IssueReqHeader.salesmancode ) and  \n\t( ( dbo.IssueReqHeader.issuereqinvcode = :ar_IssueInvCode ) )    \n",
