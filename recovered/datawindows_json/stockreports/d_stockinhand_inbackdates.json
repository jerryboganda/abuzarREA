   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "stockvalue",
    "dbname": "StockValue"
   }
  ],
  "retrieve": "SELECT\n\tItem.Icode,\n\tItem.Name,\n\taliasname=item.customicode,\n\tpackunits=Isnull(St.packUnits, item.PackUnits),\n\tQTY = ISNULL(St.NewStock, 0),\n\tManufacturer.name,\n\tclassname=itemclass.name,\n\tCategory=itemcategory.name,\n\tUnitPrice=ROUND(MAX(St.NewAvgPrice), 2),\n\tPackQty=Round(sum(St.NewStock) / CASE WHEN MAX(St.packUnits) > 0 THEN MAX(ST.PackUnits) ELSE 1 END, 2),\n\tStockValue = Sum(St.NewStock) * Round(MAX(St.NewAvgPrice), 2)\nFROM\t\n\tItem\n\tLEFT OUTER JOIN\n\t(SELECT\tStockLedger.icode, \n\t\tStockLedger.newstock, \n\t\tnewavgprice,\n\t\tpackunits\n\tFROM \tStockLedger\n\tWHERE\tStockLedger.date <= :ar_enddate AND\n\t\tStockLedger.UTN IN \n\t\t(SELECT MAX(utn) utn FROM StockLedger WHERE date <= :ar_enddate GROUP BY icode)) AS St ON (Item.ICode = St.ICode)\n\tLEFT OUTER JOIN ItemClass ON (Item.iccode=itemclass.iccode),\n\tManufacturer,\n\tItemCategory\nWHERE \t\n\t(Item.ManfCode IN (:manfcode) ) and\n\t(Manufacturer.manfcode = Item.ManfCode) and\n\t(Item.icatcode=itemcategory.icatcode) and\n\t(Item.active=1)\nGROUP BY\n\tItem.Icode,\n\tItem.name,\n\titem.customicode, \n\tManufacturer.name,\n\titemcategory.name,\n\tItemclass.name,\n\tSt.PackUnits,\n\tItem.PackUnits,\n\tSt.NewStock\nORDER BY\n\tManufacturer.name,\n\tItem.name,\n\titemcategory.name,\n\tItemclass.name,\n\titem.customicode, \n\tSt.PackUnits,\n\tSt.NewStock",
  "arguments": {
   "_items": [
    {
     "_items": [
      "manfcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ar_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
