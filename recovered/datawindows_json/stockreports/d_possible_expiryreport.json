  "retrieve": "    SELECT Item.CustomICode, \n\t\tGroupCode=\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN max(Item.ManfCode)\n\t\tWHEN 'C' THEN max(Item.ICatCode)\n\t\tWHEN 'L' THEN max(Item.ICCode)\n\t\tELSE Max(Item.PACKCODE) END,\n\t\tGroupName= \n\t\tCASE :as_reportgrouping \n\t\tWHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = max(Item.ManfCode))\n\t\tWHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = max(Item.ICatCode))\n\t\tWHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = max(Item.ICCode))\n\t\tELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = max(Item.PACKCODE)) END,    \n         Item.Name,   \n\t\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n         Item.PackUnits,   \n          \n         Purdetail.Batch,   \n         Purdetail.Expiry,   \n         Purdetail.packQty,\n         purdetail.looseqty  \n    FROM Purdetail,   \n         Item\n        \n   WHERE \n          ( Purdetail.Expiry Between :adt_sdate and :adt_edate ) and\n          ( Purdetail.icode=item.icode)and\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN Item.ManfCode\n\t\tWHEN 'C' THEN Item.ICatCode\n\t\tWHEN 'L' THEN Item.ICCode\n\t\tELSE item.PACKCODE END IN (:ai_groupcode) \nGROUP BY Item.CustomICode,    \n         Item.Name,   \n\t\tItem.Active,\n         Item.PackUnits,   \n          \n         purdetail.Batch,   \n         PurDetail.Expiry,   \n         purDetail.packQty,\n         purdetail.looseqty \n\nunion all\n\nSELECT Item.CustomICode, \n\t\tGroupCode=  \n\t\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN max(Item.ManfCode)\n\t\tWHEN 'C' THEN max(Item.ICatCode)\n\t\tWHEN 'L' THEN max(Item.ICCode)\n\t\tELSE Max(Item.PACKCODE) END,\n\tGroupName= \n\t\tCASE :as_reportgrouping \n\t\tWHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = max(Item.ManfCode))\n\t\tWHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = max(Item.ICatCode))\n\t\tWHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = max(Item.ICCode))\n\t\tELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = max(Item.PACKCODE)) END,    \n         Item.Name,   \n\t\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n         Item.PackUnits,   \n            \n         Srdetail.Batch,   \n         srdetail.Expiry,   \n         srdetail.packQty,\n         srdetail.looseqty  \n    FROM srdetail,   \n         Item\n   WHERE \n          ( srdetail.Expiry Between :adt_sdate and :adt_edate ) and\n          ( srdetail.icode=item.icode)and\n\t\t CASE :as_reportgrouping\n\t\tWHEN 'M' THEN Item.ManfCode\n\t\tWHEN 'C' THEN Item.ICatCode\n\t\tWHEN 'L' THEN Item.ICCode\n\t\tELSE item.PACKCODE END IN (:ai_groupcode) \nGROUP BY Item.CustomICode,   \n         Item.Name,   \n\t\tItem.Active,\n         Item.PackUnits,   \n         \n         Srdetail.Batch,   \n         SrDetail.Expiry,   \n         SrDetail.packQty,\n         Srdetail.looseqty \norder by \n\t\tGroupName,\n\t\t Item.Name,   \n         Item.PackUnits,   \n           \n         purdetail.Batch,   \n         PurDetail.Expiry,   \n         purDetail.packQty,\n         purdetail.looseqty \n",
  "arguments": {
