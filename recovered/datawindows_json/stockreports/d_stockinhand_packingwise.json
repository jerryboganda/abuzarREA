    "dbname": "val"
   }
  ],
  "retrieve": "select  qty=case when sum(godowndetail.currqty) is null then 0\n            else sum(godowndetail.currqty) \n            end,\n        packing=(select itempacking.name from itempacking where packcode=:ai_packcode),\n        item.customicode,\n       item.name,\n       item.packunits,\n       item.purprice,\n       unitprice=item.purprice/item.packunits,\n       godown=(select godown.name from godown where godown.gcode=1)\n\nfrom \n\tItem\n\tLEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)\n\nwhere item.packcode=:ai_packcode and\n      godowndetail.gcode=1\n\ngroup by item.name,\n         item.customicode,\n         item.purprice,\n         item.packunits\n\nunion all\n\nselect qty=case when sum(godowndetail.currqty) is null then 0\n           else sum(godowndetail.currqty) \n           end,\n        packing=(select itempacking.name from itempacking where packcode=:ai_packcode),\n        item.customicode,\n       item.name,\n       item.packunits,\n      \n       item.purprice,\n       unitprice=item.purprice/item.packunits,\n       godown=(select godown.name from godown where godown.gcode=2)\n\nfrom \n\tItem\n\tLEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)\n\nwhere item.packcode=:ai_packcode and\n      godowndetail.gcode=2\n\ngroup by item.name,\n         item.customicode,\n         item.purprice,\n    \n         item.packunits\n\nunion all\n\nselect qty=case when sum(godowndetail.currqty) is null then 0\n           else sum(godowndetail.currqty) \n           end,\n        packing=(select itempacking.name from itempacking where packcode=:ai_packcode),\n       item.customicode,\n       item.name,\n       \n       item.packunits,\n       item.purprice,\n       unitprice=item.purprice/item.packunits,\n       godown=(select godown.name from godown where godown.gcode=3)\n\nfrom \n\tItem\n\tLEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)\n\nwhere item.packcode=:ai_packcode and\n      godowndetail.gcode=3\n\ngroup by item.name,\n         item.customicode,\n         item.purprice,\n         \n         item.packunits",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_packcode",
      "number"
     ]
    }
   ]
  },
  "sort": "name A, customicode A, packing A, unitprice A"
 },
