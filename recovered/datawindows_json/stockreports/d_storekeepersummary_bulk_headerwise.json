  "retrieve": " SELECT\n\t\tSaleinvcode=(select count(saleledger.saleinvcode) \n\t\t\t\tfrom saleledger \n\t\t\t\twhere  \n\t\t\t\t\tsaleledger.headerno = :ar_headerno AND\n\t\t\t\t\tsaleledger.HeaderInvNo Between :ar_SinvCode AND :ar_LinvCode AND\n\t\t\t\t\tsaleledger.SManCode = CASE :ar_allsaleman WHEN 1 THEN saleledger .SManCode ELSE :ar_SmanCode END AND\n\t\t\t\t\t(saleledger.POSTED = CASE :ac_Posted WHEN 'B' THEN 'Y' ELSE :ac_Posted END OR  \n\t\t\t\t\tsaleledger.POSTED = CASE :ac_Posted WHEN 'B' THEN 'N' ELSE :ac_Posted END )), \n\t\tSD.ICode, \n\t\tSD.Batch, \n\t\tItem = I.Name,\n\t\tPacking=MAX(I.packingdesc),\n\t\tSUM(SD.looseQty) AS Qty, \n\t\tSUM(SD.BonusQty) AS Bonus,\n\t\tSaleValue=SUM((SD.looseQty * (SD.SalePrice - ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) *\n\t\t\t(1 - SL.DiscPerc * 0.01)),\n\t\tManufacturer = M.Name,\n\t\tSalesPerson = (SELECT Name FROM Salesman WHERE SalesmanCode = :ar_SmanCode)\n\nFROM\n\t\tSaledetail SD,\n\t\tSaleLedger SL,\n\t\tManufacturer M,\n\t\tItem\tI\nWHERE \n\t\t(SL.POSTED = CASE :ac_Posted WHEN 'B' THEN 'Y' ELSE :ac_Posted END OR  \n\t\tSL.POSTED = CASE :ac_Posted WHEN 'B' THEN 'N' ELSE :ac_Posted END ) AND\n\t\tSL.HeaderNo = :ar_headerno AND\n\t\tSL.HeaderInvNo Between :ar_SinvCode AND :ar_LinvCode AND\n\t\tSL.SManCode = CASE :ar_allsaleman WHEN 1 THEN SL.SManCode ELSE :ar_SmanCode END AND\n\t\tSL.SaleInvCode = SD.SaleInvcode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = M.ManfCode\nGROUP BY\n\t\tSD.ICode, \n\t\tSD.Batch, \n\t\tM.Name,\n\t\tI.Name\nORDER BY\n\t\tM.Name,\n\t\tI.Name \n",
  "arguments": {
