    "dbname": "Saledetail.PackUnits"
   }
  ],
  "retrieve": "  SELECT Item.CustomICode,   \n         Item.Name,   \n\t\t\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n         Item.PackUnits,   \n         Saledetail.SalePrice,   \n         GodownDetail.CurrQty,   \n         Saledetail.PackQty,   \n         Saledetail.LooseQty,   \n         Saledetail.PackUnits  \n    FROM Item,   \n         Saledetail,   \n         SaleLedger,   \n         GodownDetail  \n   WHERE ( Saledetail.ICode = Item.ICode ) and  \n         ( SaleLedger.SaleInvCode = Saledetail.SaleInvcode ) and  \n         ( GodownDetail.ICode = Item.ICode ) and  \n         ( ( Item.ManfCode = :Manfcode)) AND  \n         ( SaleLedger.date between :StartDate and :EndDate)    \n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "Manfcode",
      "number"
     ]
    },
    {
     "_items": [
      "StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "EndDate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "item_customicode A, item_name A"
 },
