  "retrieve": "SELECT  \n\t\titemname = dbo.item.name,\t\t\n      itemcode = dbo.item.icode,  \n\t\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\t   categoryname = dbo.itemcategory.name,\n      manufacturer = dbo.manufacturer.name,\n\t\tsaleqty = Round(Sum(Convert(real,dbo.saledetail.looseqty)) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2),\t\t \n\t\tsalevalue = Round(Sum(Convert(real,dbo.saledetail.looseqty)) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2) * max(dbo.item.saleprice),\n\t   currqty = IsNull((Select  sum(Convert(real,currqty)) \t\n\t\t\t\t\tfrom godowndetail \t\n\t\t\t\t\twhere dbo.item.icode = godowndetail.icode),0)/ CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END,\n\t   Projection = :al_projection,\n\t\tExcessORRequired =  '                            ',\n\t\tExcessORRequiredQTY = 1234567        ,\n\t\titemsaleprice=max(dbo.item.saleprice),\n\t\titempackunits= max(dbo.item.packunits),\n\t\titemrank = 0\n\t\nFROM dbo.saleledger,\t \n\t dbo.saledetail,\n\t dbo.item,\n\t dbo.itemcategory,\n\t dbo.manufacturer \t\n\nWHERE  dbo.saleledger.date >= :ad_StartDate and \t\n \t   dbo.saleledger.date <= :ad_EndDate and \t\n\t   dbo.saleledger.salecatcode IN (3) and\t \n\t   dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and\t   \n\t  /* dbo.item.icatcode  IN (:aia_categories) and\t  */\n\t\tcase :as_group when 'P' then item.packcode\n\t\t\t\t\t\twhen 'C' THEN item.icatcode\n\t\t\t\t\t\twhen 'L' THEN item.iccode\n\t\t\t\t\t\twhen 'M' THEN item.manfcode  end  IN (:aia_categories) and\n\t\tdbo.item.icatcode = dbo.itemcategory.icatcode and \n\t\tdbo.item.manfcode = dbo.manufacturer.manfcode and \n\t   dbo.saledetail.icode = dbo.item.icode \n\t\t\t \t\t \nGROUP BY saledetail.icode,\n\t\t\tdbo.itemcategory.name,\n\t\t\tdbo.manufacturer.name, \t \t\n\t\t\titem.name, item.icode,\n\t\t \tdbo.item.packunits, item.active\n\nORDER BY dbo.itemcategory.name\t ",
  "arguments": {
