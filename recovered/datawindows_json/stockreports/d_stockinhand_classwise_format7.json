    "name": "category",
    "dbname": "Category"
   },
   {
    "type": "decimal(13)",
    "updatewhereclause": "yes",
    "name": "unitprice",
    "dbname": "UnitPrice"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "packqty",
    "dbname": "PackQty"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "stockvalue",
    "dbname": "StockValue"
   }
  ],
  "retrieve": "SELECT \n\tItem.Name,  \n\taliasname=item.customicode, \n\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\tItem.purprice,   \n\tItem.PackUnits,   \n\tQTY = isnull(sum(GodownDetail.CurrQty),0),   \n\tManufacturer.name,\n\tclassname=itemclass.name,\n\tCategory=itemcategory.name,  \n\tUnitPrice = Case :ai_pricetype \n\t\tWHEN 2 THEN Round(Item.purprice /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\tWHEN 1 THEN Round(max(Item.Saleprice) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\tWHEN 3 THEN Round(max(Item.avgprice), 2)\n\tEND ,\n\tPackQty = Round(isnull(sum(GodownDetail.CurrQty),0) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2),\n\tStockValue = isnull(Sum(GodownDetail.CurrQty),0) *\n\tCase :ai_pricetype \n\t\tWHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\tWHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\tWHEN 3 THEN Round(max(Item.avgprice), 2)\n\tEND\n\nFROM \n\tManufacturer,   \n\tItem\n\tLEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)\n\tLEFT OUTER JOIN ItemClass ON (Item.iccode=itemclass.iccode),\n\tItemCategory\nWHERE \n\t( Item.ICCode IN (:classcode ) ) and\n\t( itemclass.iccode = Item.iccode ) and\n\t( Item.icatcode=itemcategory.icatcode) and\n\t( Item.active=1) and\n\t( Item.manfcode=manufacturer.manfcode)\n\nGROUP BY \n\tItem.name,\n\titem.customicode, \n\tItem.Active, \n\tItem.purprice, \n\tItem.PackUnits, \n\tItemclass.name,\n\titemcategory.name,\n\tItemclass.name ,\n\tManufacturer.name\n\nORDER BY \n\titemclass.name, \n\titem.name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "classcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_pricetype",
      "number"
     ]
    }
   ]
  }
 },
