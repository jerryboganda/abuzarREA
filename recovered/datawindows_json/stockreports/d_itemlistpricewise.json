    "name": "category",
    "dbname": "category"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "manufacturer",
    "dbname": "manufacturer"
   }
  ],
  "retrieve": "select\n\t\titemanme = item.name, \n\t\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\t\tUnitPrice = item.saleprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, \n\t\tcategory= itemcategory.name,\n\t\tmanufacturer=(select M.name from manufacturer M where M.manfcode=item.manfcode)\n\t\t \nfrom   item,itemcategory \nwhere  item.active=1 and\n\t\t item.icatcode = itemcategory.icatcode and \n   \t\t itemcategory.name in (:asa_categories) \n\norder by category,\n\t\t\tunitprice desc,\n\t\t\titemanme \n\t\t \n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "asa_categories",
      "stringlist"
     ]
    },
    {
     "_items": [
      "as_zerostock",
      "string"
     ]
    }
   ]
  }
 },
