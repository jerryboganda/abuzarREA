    "dbname": "Manufacturer"
   }
  ],
  "retrieve": " SELECT  \n\tSaleinvcode=sl.saleinvcode, \n\tDate=sl.Date, \n\tCustomerAlias=A.AliasName, \n\tCustomer=A.Name, \n\tCity=C.City, \n\tSalePerson = (SELECT SM.Name FROM Salesman SM WHERE SM.SalesManCode = SL.SManCode),\n\tUserName = (SELECT U.UserName FROM Users U WHERE U.UserCode = SL.SalesmanCode),\n\tSD.ICode, \n\tSD.Batch, \n\tSD.Expiry, \n\tAliasName = I.CustomICode,\n\tItem = I.Name + CASE WHEN SD.SaleItemDescription IS NULL OR SD.SaleItemDescription = '' THEN '' ELSE CHAR(13) + CHAR(10) + SD.SaleItemDescription END,\n\tGodown = G.Name + ' - ' + G.Location,\n\tPacking=MAX(I.packingdesc),\n\tSUM(SD.looseQty) AS Qty, \n\tSUM(SD.BonusQty) AS Bonus,\n\tManufacturer = M.Name\nFROM\n\tSaledetail SD,\n\tSaleLedger SL,\n\tCustomer C,\n\tAccounts A,\n\tManufacturer M,\n\tItem\tI,\n\tGodown G\nWHERE \n\tSL.SaleInvCode = :ai_invCode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND\n\tSL.SaleInvCode = SD.SaleInvcode AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = M.ManfCode AND\n\tSD.GCode = G.GCode AND\t\n\tSD.GCode NOT IN \n\t\t(SELECT TOP 1 GCode=Min(GCode)\n\t\tFROM GroupAllowedGodown\n\t\tWHERE Module = 1 AND GroupCode=:ai_groupcode\n\t\tGROUP BY Priority)\nGROUP BY\n\tSL.SaleInvCode,\n\tSL.Date,\n\tA.AliasName, \n\tA.Name, \n\tC.City, \n\tSL.SManCode,\n\tSL.SalesmanCode,\n\tSD.ICode, \n\tSD.GCode,\n\tSD.Batch, \n\tSD.Expiry,\n\tSD.SaleItemDescription,\n\tM.Name,\n\tI.Name,\n\tI.CustomICode,\n\tG.Name,\n\tG.Location\nORDER BY\n\tG.Name,\n\tI.Name,\n\tI.CustomICode,\n\tSD.Batch,\n\tSD.Expiry",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_invcode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "number"
     ]
    }
   ]
  }
 },
