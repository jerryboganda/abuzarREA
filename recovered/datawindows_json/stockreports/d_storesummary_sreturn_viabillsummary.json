  "retrieve": "SELECT\n\tICode=SD.ICode, \n\tBatch=SD.Batch, \n\tExpiry=SD.Expiry, \n\tItem = I.Name,\n\tPacking=MAX(I.packingdesc),\n\tQty = SUM(SD.looseQty), \n\tBonus = SUM(SD.BonusQty),\n\tSaleValue=SUM((SD.looseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)) * (1 - SL.DiscPerc * 0.01)),\n\tDiscPerc=SD.DiscPerc,\n\tSRPrice = SD.SRPrice,\n\tDiscValue = SUM(SD.looseQty * SD.SRPrice * (SD.DiscPerc * 0.01)),\n\tManufacturer = M.Name,\n\tRemarks = B.Remarks,\n\tMinSaleInvCode = S.MinSaleInvCode,\n\tMaxSaleInvCode = S.MaxSaleInvCode,\n\tTotalInvoices = S.TotalInvoices,\n\tMinSRCode = S.MinSRCode,\n\tMaxSRCode = S.MaxSRCode,\n\tTotalSRCount = S.TotalSRCount\nFROM \n\tBillSummary B, \n\tBillSummaryDetail D, \n\tSRBufferLedger SL, \n\tSRBufferDetail SD,\n\tItem I,\n\tManufacturer M,\n\t(SELECT BD.BillSummaryCode,\n\t\tMinSaleInvCode = MIN(BD.SaleInvCode),\n\t\tMaxSaleInvCode = MAX(BD.SaleInvCode),\n\t\tTotalInvoices = COUNT(BD.SaleInvCode),\n\t\tMinSRCode = MIN(BD.SRBufferInvCode),\n\t\tMaxSRCode = MAX(BD.SRBufferInvCode),\n\t\tTotalSRCount = COUNT(BD.SRBufferInvCode)\n\tFROM BillSummaryDetail BD \n\tWHERE BD.BillSummaryCode=:ai_code\n\tGROUP BY BD.BillSummaryCode) S\nWHERE\n\tB.BillSummaryCode= :ai_code AND\n\tB.BillSummaryCode= S.BillSummaryCode AND\n\tB.BillSummaryCode = D.BillSummaryCode AND\n\tD.SRBufferInvCode > 0 AND\n\tD.SRBufferInvCode = SL.SRBufferInvCode AND\n\tSL.SRBufferInvCode = SD.SRBufferInvCode AND\n\tSD.ICode = I.ICode AND \n\tI.ManfCode = M.ManfCode\nGROUP BY\n\tS.MinSaleInvCode,\n\tS.MaxSaleInvCode,\n\tS.TotalInvoices,\n\tS.MinSRCode,\n\tS.MaxSRCode,\n\tS.TotalSRCount,\n\tB.Remarks,\n\tSD.ICode, \n\tI.Name,\n\tSD.Batch, \n\tSD.Expiry,\n\tM.Name,\n\tSD.DiscPerc,\n\tSD.SRPrice\nORDER BY\n\tManufacturer,\n\tI.Name \n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
