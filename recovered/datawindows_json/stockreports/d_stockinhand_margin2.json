  "retrieve": "SELECT \n\tGroupCode = CASE :as_reportgrouping \n\t\t\t\t\t\t\t\tWHEN 'M' THEN I.ManfCode \n\t\t\t\t\t\t\t\tWHEN 'P' THEN I.PackCode \n\t\t\t\t\t\t\t\tWHEN 'L' THEN I.ICCode \n\t\t\t\t\t\t\t\tELSE I.ICatCode END,\n\tGroupName = CASE :as_reportgrouping \n\t\t\t\t\t\t\t\tWHEN 'M' THEN M.Name\n\t\t\t\t\t\t\t\tWHEN 'P' THEN P.Name\n\t\t\t\t\t\t\t\tWHEN 'L' THEN L.Name\n\t\t\t\t\t\t\t\tELSE C.Name END,\n\tAliasName = I.CustomICode,\n\tItemName = I.Name,\n\tActive=CASE I.Active WHEN 1 THEN 'Y' ELSE 'N' END,\n\tStock = SUM(G.CurrQty),\n\tSalePrice=Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),\n\tFlatDisc=I.FlatDisc,\n\tSaleDiscPerc = I.SaleDiscPerc,\n\tpurval2=Isnull(SUM(G.CurrQty),0) *Round(I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),\n\tPurPrice=Round(CASE :ai_pricetype When 1 THEN ( I.RecentPurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) When 2 THEN (I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) ELSE I.AvgPrice END, 2),\n\tSalesValue = SUM(G.CurrQty) * (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)),\n\tPurValue = SUM(G.CurrQty) * \n\t\tRound(\n\t\t\tCASE :ai_pricetype When 1 THEN \n\t\t\t\t( I.RecentPurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) \n\t\t\tWhen 2 THEN \n\t\t\t\t(I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) \n\t\t\tELSE I.AvgPrice END, 2),\n\tMarginAmount = SUM(G.CurrQty) * (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) -\n\t\t\t\t\t\tSUM(G.CurrQty) * Round(CASE :ai_pricetype When 1 THEN ( I.RecentPurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) When 2 THEN (I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) ELSE I.AvgPrice END, 2),\n\tMarginPercentage = \n\t\tRound(((SUM(G.CurrQty) * (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) - SUM(G.CurrQty) * Round(CASE :ai_pricetype When 1 THEN ( I.RecentPurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) When 2 THEN (I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) ELSE I.AvgPrice END, 2)) / \n\t\t(CASE SUM(G.CurrQty) * Round(CASE :ai_margintype When 1 THEN (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) When 2 THEN (I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) ELSE (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) END, 2)\n\t\tWHEN 0 THEN 1 \n\t\tELSE SUM(G.CurrQty) * Round(CASE :ai_margintype When 1 THEN (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) When 2 THEN (I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) ELSE (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) END, 2) END)) * 100, 2)\nFROM \n\tGodownDetail G, \n\tItem I, \n\tManufacturer M, \n\tItemCategory C, \n\tItemClass L,\n\tItemPacking P\nWHERE\n\tG.ICode = I.ICode AND\n\tI.ManfCode = M.ManfCode AND\n\tI.ICatCode = C.ICatCode AND\n\tI.ICCode = L.ICCode AND\n\tI.PackCode = P.PackCode AND\n\tCASE :as_reportgrouping \n\t\tWHEN 'M' THEN I.ManfCode \n\t\tWHEN 'P' THEN I.PackCode \n\t\tWHEN 'L' THEN I.ICCode \n\t\tELSE I.ICatCode END IN (:ai_grouplist)\n\nGROUP BY\n\tI.CustomICode,\n\tI.Name,\n\tI.Active,\n\tI.SalePrice,\n\tI.PurPrice,\n\tI.FlatDisc,\n\tI.SaleDiscPerc,\n\tI.RecentPurPrice,\n\tI.AvgPrice,\n\tI.PackUnits,\n\tI.ManfCode, \n\tI.PackCode,\n\tI.ICCode,\n\tI.ICatCode,\n\tM.Name,\n\tP.Name,\n\tL.Name,\n\tC.Name\nORDER BY\n\tGroupName,\n\tI.Name,\n\tI.CustomICode\n",
  "arguments": {
