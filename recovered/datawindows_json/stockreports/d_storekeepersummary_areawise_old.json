    "dbname": "Manufacturer"
   }
  ],
  "retrieve": " SELECT\n\t\tSaleinvcode=(select count(saleinvcode) \n\t\t\t\tfrom saleledger, customer\n\t\t\t\twhere \n\t\t\t\t\tPosted = 'N' AND\n\t\t\t\t\tsaleledger.CustCode = Customer.CustCode AND\n\t\t\t\t\tCustomer.AreaCode IN (:ai_AreaCode)\n\t\t\t\t\t), \n\t\tSD.ICode, \n\t\tSD.Batch, \n\t\tItem = I.Name,\n\t\tPacking=MAX(I.packingdesc),\n\t\tSUM(SD.looseQty) AS Qty, \n\t\tSUM(SD.BonusQty) AS Bonus,\n\t\tSaleValue=SUM((SD.looseQty * (SD.SalePrice - ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) *\n\t\t\t(1 - SL.DiscPerc * 0.01)),\n\t\tManufacturer = M.Name\n\nFROM\n\t\tSaledetail SD,\n\t\tSaleLedger SL,\n\t\tManufacturer M,\n\t\tItem\tI,\n\t\tCustomer C\nWHERE \n\t\tSL.Posted = 'N' AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.AreaCode IN (:ai_AreaCode) AND\n\t\tSL.SaleInvCode = SD.SaleInvcode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = M.ManfCode\nGROUP BY\n\t\tSD.ICode, \n\t\tSD.Batch, \n\t\tM.Name,\n\t\tI.Name\nORDER BY\n\t\tM.Name,\n\t\tI.Name \n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_areacode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "as_string",
      "string"
     ]
    }
   ]
  }
 },
