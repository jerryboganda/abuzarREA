  "retrieve": " SELECT\n\t\tSaleinvcode=(select count(saleinvcode) \n\t\t\t\tfrom saleledger \n\t\t\t\twhere \n\t\t\t\t\tSaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND\n\t\t\t\t\t(Posted = Case :ar_postedunposted \n\t\t\t\t\t WHEN 'B' THEN 'Y'\n\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t  \t\t\t\t WHEN 'N' THEN 'N'\n\t\t  \t\t\t ELSE 'Z' \n\t\t\t\t\t END OR\n\t\t\t\t\tPosted = Case :ar_postedunposted \n\t\t\t\t\t WHEN 'B' THEN 'N'\n\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t\t  \t\t\t WHEN 'N' THEN 'N'\n\t\t  \t\t\t ELSE 'Z'\n\t\t\t\t\t END) AND\n\t\t\t\tSalesManCode IN (:ar_usercode)), \n\t\tSD.ICode, \n\t\tSD.Batch, \n\t\tAliasName=I.CustomICode,\n\t\tItem = I.Name,\n\t\tPacking=IP.Name,\n\t\tCustRefNo=MAX(SL.CustRefNo),\n\t\tSUM(SD.looseQty + SD.BonusQty) AS Qty, \n\t\tSaleValue=SUM((SD.looseQty * (SD.SalePrice - ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) *\n\t\t\t(1 - SL.DiscPerc * 0.01)),\n\t\tManufacturer = CASE :ar_grouping WHEN 1 THEN ICT.Name WHEN 2 THEN M.Name ELSE IC.Name END\n\nFROM\n\t\tSaledetail SD,\n\t\tSaleLedger SL,\n\t\tManufacturer M,\n\t\tItemCategory ICT,\n\t\tItemClass IC,\n\t\tItemPacking IP,\n\t\tItem\tI\nWHERE \n\t\tSL.SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND\n\t\tSL.SaleInvCode = SD.SaleInvcode AND\n\t\tSL.SalesManCode IN (:ar_UserCode) AND\n\t\t(SL.Posted = Case :ar_postedunposted \n\t\t\t\t\t\t WHEN 'B' THEN 'Y'\n\t\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t\t\t  \t\t\t WHEN 'N' THEN 'N'\n\t\t\t  \t\t\t ELSE 'Z'\n\t\t\t\t\t\t END OR\n\t\tSL.Posted = Case :ar_postedunposted \n\t\t\t\t\t\t WHEN 'B' THEN 'N'\n\t\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t\t\t  \t\t\t WHEN 'N' THEN 'N'\n\t\t\t  \t\t\t ELSE 'Z'\n\t\t\t\t\t\t END) AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = M.ManfCode AND\n\t\tI.ICatCode = ICT.ICatCode AND\n\t\tI.ICCode = IC.ICCode AND\n\t\tI.PackCode = IP.PackCode\nGROUP BY\n\t\tSD.ICode, \n\t\tSD.Batch, \n\t\tM.Name,\n\t\tICT.Name,\n\t\tIC.Name,\n\t\tIP.Name,\n\t\tI.CustomICode,\n\t\tI.Name\n\nORDER BY\n\t\tManufacturer,\n\t\tI.Name \n",
  "arguments": {
   "_items": [
