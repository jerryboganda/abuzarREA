  "retrieve": "SELECT\n\tGroupName    = CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) \tELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,\n\tManufacturer   = (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode),\n\tAliasName    = I.CustomICode,\n\tItemName     = I.Name,\n\tClass        = (SELECT C.NAME FROM ItemClass C WHERE C.ICCODE  = I.ICCode),\n\tModel        = (SELECT M.Name FROM Model M WHERE M.ModelCode IN \n\t\t\t\t\t(SELECT ModelCode=MAX(IM.ModelCode) \n\t\t\t\t\tFROM ItemInModel IM \n\t\t\t\t\tWHERE IM.ICode=I.ICode)),\n\tStockInHand  = ISNULL(SUM(GD.CurrQty), 0),\n\tTransitStock = ISNULL(I.TransitStock, 0)\nFROM\n\tItem I LEFT OUTER JOIN GodownDetail AS GD ON (I.ICode = GD.ICode)\nWHERE \n\tCASE :as_grouptype \n\t\tWHEN 'M' THEN I.MANFCODE \n\t\tWHEN 'C' THEN I.ICatCode \n\t\tWHEN 'L' THEN I.ICCode \n\t\tELSE I.PACKCODE \n\tEND IN (:ai_groupcode) AND\n\tI.ManfCode IN (:ai_ManfCode)\nGROUP BY\n\tI.ManfCode,\n\tI.ICatCode,\n\tI.ICCode,\n\tI.Packcode,\n\tI.ICode,\n\tI.CustomICode,\n\tI.Name,\n\tI.TransitStock\nORDER BY\n\tGroupName,\n\tManufacturer,\n\tItemName,\n\tAliasName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_grouptype",
      "string"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_manfcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "groupname A, itemname A, class A, model A, aliasname A"
 },
