    "dbname": "stockvalue"
   }
  ],
  "retrieve": " SELECT Item.ICode,   \n       Item.Name,\n\t\t active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n       Itemclass.name,\n\t\t Item.PackUnits,   \n\t    ItemCategory.name, \n\t    manufacturer=Manufacturer.name, \n\t\t purprice=Item.purprice,\n\t\tsaleprice=max(item.saleprice),\n\t\t Item.customicode,\n\t\t stock = Case When Sum(GodownDetail.CurrQty) IS NULL then 0 Else Sum(GodownDetail.CurrQty) End,\n\t\t UnitPrice = Case :ai_pricetype \n\t\t\t\t\t\t\t\tWHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n                     \tWHEN 1 THEN Round(max(Item.Saleprice) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END,2)\n                     \tWHEN 3 THEN Round(max(Item.avgprice), 2)\n                     END ,\n\t\tstockvalue= ISNULL(Sum(GodownDetail.CurrQty),0) *\n\t\t\t\t\t\t\tCase :ai_pricetype \n\t\t\t\t\t\t\t\tWHEN 2 THEN Round(Item.purprice /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n                     \tWHEN 1 THEN Round(max(Item.Saleprice) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n                     \tWHEN 3 THEN Round(max(Item.avgprice), 2)\n                     END \n \nFROM \n\t  ItemCategory,   \n\tItem\n\tLEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)\n\tLEFT OUTER JOIN ItemClass ON (Item.iccode=itemclass.iccode),\n\t  Manufacturer\n\nWHERE \n      ( ( Item.IcatCode IN( :aa_icatcode) )) and\n\t\t(  Item.icatCode = ItemCategory.icatcode ) and\n\t\t(item.manfcode = manufacturer.manfcode)  and\n\t\t(item.active=1) \nGROUP BY Manufacturer.name, \n\t\t\tItem.ICode,\n\t\t\tItem.customicode,\n\t\t\tItem.Name,\n\t\t\titem.active,\n\t\t\tItem.purprice,\n\t\t\tItemCategory.Name,\n\t\t\tItem.PackUnits,\n\t\t\titemclass.name\n\t\t\t\nOrder By itemcategory.name,\n\t\t\tItem.Name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "aa_icatcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_pricetype",
      "number"
     ]
    }
   ]
  }
 },
