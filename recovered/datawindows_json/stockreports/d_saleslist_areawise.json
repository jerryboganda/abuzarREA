    "updatewhereclause": "yes",
    "name": "saleinvcode",
    "dbname": "SaleLedger.Saleinvcode"
   }
  ],
  "retrieve": "SELECT \n\t\tS.Saleinvcode\nFROM\tSaleledger S, Customer C, Area A\nWHERE (S.Posted = Case :ar_postedunposted \n\t\t\t\t\t WHEN 'B' THEN 'Y'\n\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t  \t\t\t\t WHEN 'N' THEN 'N'\n\t\t  \t\t\t ELSE 'Z'\n\t\t\t\t\t END OR\n\t\tS.Posted = Case :ar_postedunposted \n\t\t\t\t\t WHEN 'B' THEN 'N'\n\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t\t  \t\t\t WHEN 'N' THEN 'N'\n\t\t  \t\t\t ELSE 'Z'\n\t\t\t\t\t END) AND\n\t\tS.SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND\n\t\tS.SaleTypeCode IN (:ar_saletypecode) AND\n\t\tS.CustCode = C.CustCode AND\n\t\tC.AreaCode = A.AreaCode AND\n\t\tA.AreaCode IN (:ar_areacode)\nORDER BY\n\t\tS.Saleinvcode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_areacode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ar_saletypecode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ar_postedunposted",
      "string"
     ]
    },
    {
     "_items": [
      "ar_SinvCode",
      "number"
     ]
    },
    {
     "_items": [
      "ar_LinvCode",
      "number"
     ]
    }
   ]
  }
 },
