  "retrieve": " SELECT \n\tICode=GodownDetail.ICode,   \n\tItemName=I.Name, \n\tAliasName=I.CustomICode,\n\tGodown=(SELECT G.NAME FROM Godown G WHERE G.GCode = GodownDetail.GCode),\n\tBatch=GodownDetail.Batch,   \n\tExpiry=GodownDetail.Expiry,   \n\tStock=GodownDetail.CurrQty,   \n\tManufacturer=M.Name,\n\tInvCode=P.PurInvCode,\n\tCategory=CASE WHEN P.PurCatCode < 3 THEN 'Pack' ELSE 'Loose' END,\n\tDATE=P.Date,\n\tCurrency=C.ShortName,\n\tConversionFactor=P.ConversionFactor,\n\tForeignPrice=D.ForeignPrice * (1 - D.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01),\n\tPurPrice = \n\tROUND(D.PurPrice / \n\t\tCASE WHEN P.PurCatCode < 3 THEN \n\t\t\tCASE D.PackUnits WHEN 0 THEN 1 ELSE D.PackUnits END \n\t\tELSE 1 END, 2) * (1 - D.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01),\n\tROWID=D.IDENTITYCOL,\n\tPurQty=CASE WHEN P.PurCatCode < 3 THEN D.PackQty * D.PackUnits ELSE D.LooseQty END,\n\tAvgPrice=I.AvgPrice\nFROM \n\tGodownDetail, PurDetail D, PurLedger P, Item I, Manufacturer M, Currency C\nWHERE \n\tLEFT(GodownDetail.Batch, 1) = '»' AND\n\tGodownDetail.ICode = D.ICode AND\n\tGodownDetail.Batch = D.Batch AND\n\tD.PurRowID >= \n\t\tISNULL((SELECT MAX(PD.PurRowID) \n\t\tFROM PurDetail PD \n\t\tWHERE PD.ICode = D.ICode AND PD.Batch=D.Batch), 0) AND\n\tD.PurInvCode = P.PurInvCode AND\n\tD.ICode = I.ICode AND\n\tI.ManfCode IN (:ai_manfcode) AND\n\tI.ManfCode = M.ManfCode AND\n\tP.CurrencyCode = C.CurrencyCode\nUNION ALL\nSELECT \n\tICode=GodownDetail.ICode,   \n\tItemName=I.Name,\n\tAliasName=I.CustomICode,\n\tGodown=(SELECT G.NAME FROM Godown G WHERE G.GCode = GodownDetail.GCode),\n\tBatch=GodownDetail.Batch,   \n\tExpiry=GodownDetail.Expiry,   \n\tStock=GodownDetail.CurrQty,   \n\tManufacturer=M.Name,\n\tInvCode=NULL,\n\tCategory=NULL,\n\tDATE=NULL,\n\tCurrency=NULL,\n\tConversionFactor=NULL,\n\tForeignPrice=NULL,\n\tPurPrice = I.AvgPrice,\n\tROWID=NULL,\n\tPurQty=0,\n\tAvgPrice=I.AvgPrice\nFROM \n\tGodownDetail, Item I, Manufacturer M\nWHERE \n\tLEFT(GodownDetail.Batch, 1) <> '»' AND\n\tGodownDetail.ICode = I.ICode AND\n\tI.ManfCode IN (:ai_manfcode) AND\n\tI.ManfCode = M.ManfCode\nORDER BY\n\tM.Name,\n\tI.Name,\n\tAliasName,\n\tDate,\n\tInvCode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_manfcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_price",
      "number"
     ]
    }
   ]
  },
  "sort": "manufacturer A, itemname A, aliasname A, rowid A, date A, invcode A"
 },
