    "name": "godown",
    "dbname": "godown"
   }
  ],
  "retrieve": "   SELECT Item.CustomICode,   \n         Item.Name,   \n\t\t\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n         Item.PackUnits,   \n         ItemPacking.Name,   \n         GodownDetail.Batch,   \n         GodownDetail.Expiry,   \n         Item.AvgPrice,   \n         GodownDetail.CurrQty,\n\t\t\titemclass=itemclass.name ,\n\t\t\tgcode=godowndetail.gcode,\n\t\t\tgodown=(select name from godown where gcode=godowndetail.gcode) \n    FROM GodownDetail,   \n\t\tItem LEFT OUTER JOIN ItemPacking ON (item.packcode = ItemPacking.packcode),\n\t\titemclass\n\t\t\t  \n   WHERE ( Item.iccode IN (:aa_iccode)) and\n\t\t\t( item.iccode=itemclass.iccode)and\n\t\t\t( Item.ICode = GodownDetail.ICode ) and  \n         ( ( GodownDetail.Expiry <= DateAdd(day, :ar_date, GetDate()) ) )    \n\t\n\t order by itemclass.name  ,\n\t\t\t Item.name\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_date",
      "number"
     ]
    },
    {
     "_items": [
      "aa_iccode",
      "numberlist"
     ]
    }
   ]
  }
 },
