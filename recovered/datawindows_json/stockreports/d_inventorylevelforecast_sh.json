  "retrieve": "SELECT \n\taliasname=(SELECT customicode FROM item WHERE item.icode=H.itemcode),\n\titemname,\t\t\n\titemcode,   \n\tActive,\n\tcategoryname ,\n\tmanufacturer ,\n\tnetqty = Sum(H.saleqty),\t\t \n\tProjection = :al_projection,\n\tExcessORRequired =  '                            ',\n\tExcessORRequiredQTY = 1234567        ,\n\titemsaleprice,\n\titempackunits,\n\tamount=0.00,\n\tcurrqty = IsNull(\n\t\t(SELECT sum(currqty) \t\n\t\tFROM godowndetail \t\n\t\tWHERE H.itemcode = godowndetail.icode),0)\nFROM\n\t(SELECT \n\t\titemname = dbo.item.name,\t\t\n\t\titemcode = dbo.item.icode,  \n\t\tactive=CASE dbo.item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\t\tcategoryname = dbo.itemcategory.name,\n\t\tmanufacturer = dbo.manufacturer.name,\n\t\tsaleqty = Sum(dbo.saledetail.looseqty),\t\t \n\t\tProjection = :al_projection,\n\t\titemsaleprice=max(dbo.item.saleprice),\n\t\titempackunits= max(dbo.item.packunits)\n\tFROM dbo.saleledger,\t \n\t\tdbo.saledetail,\n\t\tdbo.item,\n\t\tdbo.itemcategory,\n\t\tdbo.manufacturer \t\n\tWHERE  dbo.saleledger.date >= :ad_StartDate and \t\n\t\tdbo.saleledger.date <= :ad_EndDate and \t\n\t\tdbo.saleledger.salecatcode IN (1, 2, 3) and\t \n\t\tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and\t   \n\t\t/*dbo.item.icatcode  IN (:aia_categories) and\t  */\n\t\tcase :as_group when 'P' then item.packcode\n\t\t\t\t\t\twhen 'C' THEN item.icatcode\n\t\t\t\t\t\twhen 'L' THEN item.iccode\n\t\t\t\t\t\twhen 'M' THEN item.manfcode  end  IN (:aia_categories) and\n\t\tdbo.item.icatcode = dbo.itemcategory.icatcode and \n\t\tdbo.item.manfcode = dbo.manufacturer.manfcode and \n\t\tdbo.saledetail.icode = dbo.item.icode \n\tGROUP BY saledetail.icode,\n\t\tdbo.itemcategory.name,\n\t\tdbo.manufacturer.name, \t \t\n\t\titem.name, item.icode, item.active\n\tUNION ALL\n\tSELECT \n\t\titemname = dbo.item.name,\t\t\n\t\titemcode = dbo.item.icode,  \n\t\tactive=CASE dbo.item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\t\tcategoryname = dbo.itemcategory.name,\n\t\tmanufacturer = dbo.manufacturer.name,\n\t\tsaleqty = (-1) * Sum(dbo.srdetail.looseqty),\t\t \n\t\tProjection = :al_projection,\n\t\titemsaleprice=max(dbo.item.saleprice),\n\t\titempackunits= max(dbo.item.packunits)\n\tFROM dbo.srledger,\t \n\t\tdbo.srdetail,\n\t\tdbo.item,\n\t\tdbo.itemcategory,\n\t\tdbo.manufacturer \t\n\tWHERE  dbo.srledger.date >= :ad_StartDate and \t\n\t\tdbo.srledger.date <= :ad_EndDate and \t\n\t\tdbo.srledger.srcatcode IN (6, 7, 8) and\t \n\t\tdbo.srledger.srinvcode = dbo.srdetail.srinvcode and\t   \n\t\t/*dbo.item.icatcode  IN (:aia_categories) and\t  */\n\t\tcase :as_group when 'P' then item.packcode\n\t\t\t\t\t\twhen 'C' THEN item.icatcode\n\t\t\t\t\t\twhen 'L' THEN item.iccode\n\t\t\t\t\t\twhen 'M' THEN item.manfcode  end  IN (:aia_categories) and\n\t\tdbo.item.icatcode = dbo.itemcategory.icatcode and \n\t\tdbo.item.manfcode = dbo.manufacturer.manfcode and \n\t\tdbo.srdetail.icode = dbo.item.icode \n\tGROUP BY srdetail.icode,\n\t\tdbo.itemcategory.name,\n\t\tdbo.manufacturer.name, \t \t\n\t\titem.name, item.icode, item.active\n\tUNION ALL\n\tSELECT itemname = dbo.item.name,\t\t\n\t\titemcode = dbo.item.icode,  \n\t\tactive=CASE dbo.item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\t\tcategoryname = dbo.itemcategory.name,\n\t\tmanufacturer = dbo.manufacturer.name,\n\t\tsaleqty = 0,\t\t \n\t\tProjection = :al_projection,\n\t\titemsaleprice=dbo.item.saleprice,\n\t\titempackunits= dbo.item.packunits\n\tFROM dbo.item,\n\t\tdbo.itemcategory,\n\t\tdbo.manufacturer \t\n\tWHERE /*dbo.item.icatcode  IN (:aia_categories) and\t  */\n\t\t\t\tcase :as_group when 'P' then item.packcode\n\t\t\t\t\t\twhen 'C' THEN item.icatcode\n\t\t\t\t\t\twhen 'L' THEN item.iccode\n\t\t\t\t\t\twhen 'M' THEN item.manfcode  end  IN (:aia_categories) and\n\t\tdbo.item.icatcode = dbo.itemcategory.icatcode and \n\t\tdbo.item.manfcode = dbo.manufacturer.manfcode) as H\nGROUP BY \n\tH.itemcode,\n\tH.categoryname,\n\tH.manufacturer, \t \t\n\tH.itemname, H.itemcode,\n\titemsaleprice,\n\titempackunits, H.Active\nORDER BY \n\tH.categoryname\n",
