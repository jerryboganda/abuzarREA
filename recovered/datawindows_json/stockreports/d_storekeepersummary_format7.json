  ],
  "retrieve": " SELECT\n\t\tSaleinvcode=(select count(saleinvcode) \n\t\t\t\tfrom saleledger \n\t\t\t\twhere \n\t\t\t\t\tSaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND\n\t\t\t\t\t(Posted = Case :ar_postedunposted \n\t\t\t\t\t WHEN 'B' THEN 'Y'\n\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t  \t\t\t\t WHEN 'N' THEN 'N'\n\t\t  \t\t\t ELSE 'Z' \n\t\t\t\t\t END OR\n\t\t\t\t\tPosted = Case :ar_postedunposted \n\t\t\t\t\t WHEN 'B' THEN 'N'\n\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t\t  \t\t\t WHEN 'N' THEN 'N'\n\t\t  \t\t\t ELSE 'Z'\n\t\t\t\t\t END) AND\n\t\t\t\tSalesManCode IN (:ar_SalesManCode)), \n\t\tSD.ICode, \n\t\t\n\t\tItem = I.Name,\n\t\tpackunits=max(I.packunits),\n\t\titemalias=I.customicode,\n\t\tPacking=MAX(I.packingdesc),\n\t\tCustRefNo=MAX(SL.CustRefNo),\n\t\tSUM(SD.looseQty) AS Qty, \n\t\tSUM(SD.BonusQty) AS Bonus,\n\t\t/*SaleValue=SUM(SD.looseQty * (SD.SalePrice - ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) *\n\t\t\t(1 - SL.DiscPerc * 0.01),*/\n\t\tManufacturer = CASE :ar_grouping WHEN 1 THEN ICT.Name WHEN 2 THEN M.Name ELSE IC.Name END\n\nFROM\n\t\tSaledetail SD,\n\t\tSaleLedger SL,\n\t\tManufacturer M,\n\t\tItemCategory ICT,\n\t\tItemClass IC,\n\t\tItem\tI\nWHERE \n\t\tSL.SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND\n\t\tSL.SaleInvCode = SD.SaleInvcode AND\n\t\tSL.SManCode IN (:ar_SalesManCode) AND\n\t\t(SL.Posted = Case :ar_postedunposted \n\t\t\t\t\t\t WHEN 'B' THEN 'Y'\n\t\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t\t\t  \t\t\t WHEN 'N' THEN 'N'\n\t\t\t  \t\t\t ELSE 'Z'\n\t\t\t\t\t\t END OR\n\t\tSL.Posted = Case :ar_postedunposted \n\t\t\t\t\t\t WHEN 'B' THEN 'N'\n\t\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t\t\t  \t\t\t WHEN 'N' THEN 'N'\n\t\t\t  \t\t\t ELSE 'Z'\n\t\t\t\t\t\t END) AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = M.ManfCode AND\n\t\tI.ICatCode = ICT.ICatCode AND\n\t\tI.ICCode = IC.ICCode\nGROUP BY\n\t\tSD.ICode, \n\t\tM.Name,\n\t\tICT.Name,\n\t\tIC.Name,\n\t\tI.Name,\n\t\tI.customicode\n\nORDER BY\n\t\tManufacturer,\n\t\tI.Name \n",
  "arguments": {
   "_items": [
