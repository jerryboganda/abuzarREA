    "name": "manufacturer_name",
    "dbname": "Manufacturer.name"
   },
   {
    "type": "char(100)",
    "updatewhereclause": "yes",
    "name": "batch",
    "dbname": "GodownDetail.batch"
   },
   {
    "type": "datetime",
    "updatewhereclause": "yes",
    "name": "expiry",
    "dbname": "GodownDetail.expiry"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "stock",
    "dbname": "stock"
   }
  ],
  "retrieve": "  SELECT Item.ICode,   \n       Item.Name,   \n\t\t active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\t    ItemCategory.name, \n\t    Manufacturer.name,\n\t\t GodownDetail.batch,\n\t\t GodownDetail.expiry,\n       stock = Case When Sum(GodownDetail.CurrQty) IS NULL then 0 Else Sum(GodownDetail.CurrQty) End\nFROM \n\tItemCategory,   \n\tItem\n\tLEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode),\n\tManufacturer  \n\nWHERE \n      ( ( Item.IcatCode = :ll_icatcode) ) and\n\t\t(  Item.icatCode = ItemCategory.icatcode ) and\n\t\t(item.manfcode = manufacturer.manfcode)  \n\nGROUP BY Manufacturer.name, \n\t\t\tItem.ICode,\n\t\t\tItem.Name,\n\t\t\titem.active,\n\t\t\tItemCategory.Name,\n\t\t\tGodownDetail.batch,\n\t\t\tGodownDetail.expiry\n\nOrder By Manufacturer.name, \n\t\t\tItem.Name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ll_icatcode",
      "number"
     ]
    }
   ]
  }
 },
