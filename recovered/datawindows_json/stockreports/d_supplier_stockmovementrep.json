    "dbname": "SaleReturn"
   }
  ],
  "retrieve": "SELECT \n\tICode=I.ICode, \n\tAliasName = I.CustomICode,\n\tItemName = I.Name,\n\tPacking = I.PackingDesc, \n\tSupplier = (SELECT A.Name FROM Accounts A WHERE A.AccCode IN (SELECT MIN(SI.SuppCode) FROM ItemSuppliers SI WHERE SI.ICode = I.ICode)),\n\tSoldQty = SUM(T.SoldQty), \n\tCGS=SUM(T.CGS), \n\tSalesValue = SUM(T.SalesValue),\n\tGP = SUM(T.SalesValue) - SUM(T.CGS),\n\tGPRate = ROUND(((SUM(T.SalesValue) - SUM(T.CGS)) / CASE WHEN SUM(T.SalesValue) = 0 THEN 1 ELSE SUM(T.SalesValue) END) * 100, 2),\n\tStockInHand=SUM(T.StockInHand),\n\tSaleReturn = SUM(T.SaleReturn)\nFROM\n\tItem I,\n\t(SELECT \n\t\tD.ICode, \n\t\tSoldQty = SUM(D.LooseQty + D.BonusQty), \n\t\tCGS=SUM((D.LooseQty + D.BonusQty) * D.AvgPrice), \n\t\tSalesValue = SUM( D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),\n\t\tStockInHand=0.000,\n\t\tSaleReturn = 0.0000\n\tFROM \n\t\tSaleLedger S, SaleDetail D\n\tWHERE \n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.SaleInvCode = D.SaleInvCode\n\tGROUP BY\n\t\tD.Icode\n\tUNION ALL\n\tSELECT \n\t\tD.ICode, \n\t\tSoldQty = -SUM(D.LooseQty + D.BonusQty), \n\t\tCGS= - SUM((D.LooseQty + D.BonusQty) * D.AvgPrice), \n\t\tSalesValue = - SUM( D.LooseQty * D.SalePrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),\n\t\tStockInHand=0.000,\n\t\tSaleReturn = SUM(D.LooseQty + D.BonusQty)\n\tFROM \n\t\tSRLedger S, SRDetail D\n\tWHERE \n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.SRInvCode = D.SRInvCode\n\tGROUP BY\n\t\tD.Icode\n\tUNION ALL\n\tSELECT \n\t\tI.ICode, \n\t\tSoldQty = 0.0000, \n\t\tCGS=0.00000, \n\t\tSalesValue = 0.00000,\n\t\tStockInHand= ISNULL((SELECT SUM(G.CurrQty) FROM GodownDetail G WHERE G.ICode = I.ICode), 0),\n\t\tSaleReturn = 0.0000\n\tFROM \n\t\tItem I\n\tGROUP BY\n\t\tI.Icode) T\nWHERE\n\tT.ICode = I.ICode\nGROUP BY\t\n\tI.ICode, \n\tI.CustomICode,\n\tI.Name,\n\tI.PackingDesc\n",
