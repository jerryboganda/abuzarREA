   },
   {
    "type": "decimal(13)",
    "updatewhereclause": "yes",
    "name": "unitprice",
    "dbname": "UnitPrice"
   }
  ],
  "retrieve": "SELECT \n\tgodown=(SELECT name FROM godown WHERE gcode=:ai_gcode),\n\tI.ICode,\n\tI.customicode,   \n\tI.Name,\n\tactive=CASE i.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\tI.PackUnits,   \n\tItemCategory.name, \n\tManufacturer.name,\n\tI.purprice,\n\tstock = Case When Sum(G.CurrQty) IS NULL then 0 Else Sum(G.CurrQty) End,\n\tUnitPrice = Round(I.purprice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END, 2)\n\nFROM \n\t(SELECT * FROM Item where item.manfcode=:al_manfcode) AS I\n\tLEFT OUTER JOIN \n\t(SELECT * FROM GodownDetail WHERE gcode=:ai_gcode) AS G ON (I.ICode = G.ICode),\n\tItemCategory,   \n\tManufacturer  \nWHERE \n\t(  I.icatCode = ItemCategory.icatcode ) and\n\t(I.manfcode = manufacturer.manfcode)  \nGROUP BY \n\tManufacturer.name, \n\tItemCategory.Name,\n\tI.ICode,\n\tI.customicode,\n\tI.Name,\n\tI.active,\n\tI.purprice,\n\tI.PackUnits\nOrder By \n\tManufacturer.name, \n\tI.Name",
