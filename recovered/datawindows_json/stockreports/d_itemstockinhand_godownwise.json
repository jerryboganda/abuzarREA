   }
  ],
  "retrieve": "Select  godown.gcode,\n\tgodown.name,  \n\titemname = ( select name from item where icode = :ai_icode ),\n\taliasname = ( select customicode from item where icode = :ai_icode ),\n\tactive= ( SELECT CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END FROM item WHERE item.icode = :ai_icode),\n\tstock = CASE When Sum(godowndetail.currqty) Is Null Then 0 Else Sum(godowndetail.currqty) END,\n \trate = Round(CASE :ai_pricetype WHEN 1 THEN (SELECT Item.saleprice / Item.PackUnits From Item Where item.icode = :ai_icode)  WHEN 2 THEN (SELECT Item.purprice / Item.PackUnits From Item Where item.icode = :ai_icode) ELSE (SELECT Item.AvgPrice From Item Where item.icode = :ai_icode) END, 2)\t\n\nFrom godown LEFT OUTER JOIN godowndetail ON (godown.gcode = godowndetail.gcode)\n\nWhere \n      godowndetail.icode = :ai_icode\n\nGroup by godowndetail.icode,\n\t\t\tgodown.gcode,\n\t\t\tgodown.name\n\nOrder by godown.gcode,itemname",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_icode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_pricetype",
      "number"
     ]
    }
   ]
  }
