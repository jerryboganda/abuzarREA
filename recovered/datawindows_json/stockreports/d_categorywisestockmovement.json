    "dbname": "Stock"
   }
  ],
  "retrieve": "SELECT\t\n\tDATE=CONVERT(datetime, R.Date),\n\tCategory=IC.name, \n\tIC.ICatCode,\n\tPurchase=ROUND(SUM(CASE Type WHEN 'PUR' THEN R.Value ELSE 0 END), 0),\n\tPRet=ROUND(SUM(CASE Type WHEN 'PRET' THEN R.Value ELSE 0 END), 0),\n\tSales=ROUND(SUM(CASE Type WHEN 'SALE' THEN R.Value ELSE 0 END), 0),\n\tRet=ROUND(SUM(CASE Type WHEN 'SRET' THEN R.Value ELSE 0 END), 0),\n\tCGS=ROUND(SUM(CASE Type WHEN 'SALE' THEN R.COST WHEN 'SRET' THEN -R.COST ELSE 0 END), 0),\n\tAdj=ROUND(SUM(CASE Type WHEN 'ADJ' THEN R.Value ELSE 0 END), 0),\n\tStock=ROUND(SUM(0), 0) \nFROM\n\t(SELECT\tDATE=Ltrim(str(DATEPART(mm, PL.PostDate))) +'-' + Ltrim(STR(DATEPART(dd, PL.PostDate))) +'-'+ LTRIM(str(DATEPART(yyyy, PL.PostDate))),\n\t\tPD.ICode, \n\t\tValue=SUM((PD.looseqty + PD.packqty) * PD.purprice * \n\t\t(1 - (.01 * PD.discperc))) * (1- (.01 * PL.discperc)),\n\t\tCost=0,\n\t\tType='PUR'\n\tFROM\tPurLedger PL, PurDetail PD\n\tWHERE\tPL.PurInvCode = PD.PurInvCode AND\n\t\tPL.PostDate >= :ar_startdate AND PL.PostDate <= :ar_enddate\n\tGROUP BY PL.PurInvCode, PL.PostDate, PD.ICode, PL.DiscPerc\n\tUNION ALL\n\tSELECT\tDATE=Ltrim(str(DATEPART(mm, PL.Date))) +'-' + Ltrim(STR(DATEPART(dd, PL.Date))) +'-'+ LTRIM(str(DATEPART(yyyy, PL.Date))),\n\t\tPD.ICode, \n\t\tValue=SUM((PD.looseqty + PD.packqty) * PD.prprice * \n\t\t(1 - (.01 * PD.discperc))) * (1- (.01 * PL.discperc)),\n\t\tCost=0,\n\t\tType='PRET'\n\tFROM\tPrLedger PL, PrDetail PD\n\tWHERE\tPL.PrInvCode = PD.PrInvCode AND\n\t\tPL.PostDate >= :ar_startdate AND PL.PostDate <= :ar_enddate\n\tGROUP BY PL.PrInvCode, PL.Date, PD.ICode, PL.DiscPerc\n\tUNION ALL\n\tSELECT\tDATE=Ltrim(str(DATEPART(mm, SL.Date))) +'-' + Ltrim(STR(DATEPART(dd, SL.Date))) +'-'+ LTRIM(str(DATEPART(yyyy, SL.Date))),\n\t\tSD.ICode, \n\t\tValue=IsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2)) ,0),\n\t\tCost=SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice),\n\t\tType='SALE'\n\tFROM\tSaleLedger SL, SaleDetail SD\n\tWHERE\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSL.Date >= :ar_startdate AND SL.Date <= :ar_enddate\n\tGROUP BY SL.SaleInvCode, SL.Date, SD.ICode\n\tUNION ALL\n\tSELECT\t\n\t\tDATE=Ltrim(str(DATEPART(mm, SL.Date))) +'-' + Ltrim(STR(DATEPART(dd, SL.Date))) +'-'+ LTRIM(str(DATEPART(yyyy, SL.Date))),\n\t\tSD.ICode, \n\t\tValue=IsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * SD.srprice ) * (1 - (.01 *  SD.discperc)),2)) ,0),\n\t\tCost=SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice),\n\t\tType='SRET'\n\tFROM\tSRLedger SL, SRDetail SD\n\tWHERE\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSL.Date >= :ar_startdate AND SL.Date <= :ar_enddate\n\tGROUP BY SL.SRInvCode, SL.Date, SD.ICode\n\tUNION ALL\n\tSELECT\t\n\t\tDATE=Ltrim(str(DATEPART(mm, H.Date))) +'-' + Ltrim(STR(DATEPART(dd, H.Date))) +'-'+ LTRIM(str(DATEPART(yyyy, H.Date))),\n\t\tD.ICode, \n\t\tValue=IsNull(sum(round(D.looseqty * D.price * CASE H.AdjCatCode WHEN 1 THEN 1 ELSE -1 END, 2)), 0),\n\t\tCost=0,\n\t\tType='ADJ'\n\tFROM\tAdjHeader H, AdjDetail D\n\tWHERE\tH.AdjCode = D.AdjCode AND\n\t\tH.Date >= :ar_startdate AND H.Date <= :ar_enddate\n\tGROUP BY H.AdjCode, H.Date, D.ICode) R,\n\tItem I, ItemCategory IC\nWHERE\t\n\tR.ICode = I.ICode AND\n\tI.ICatCode = IC.ICatCode\nGROUP BY \n\tR.Date,\n\tIC.name,\n\tIC.ICatCode\nORDER BY\n\tIC.name,\n\tIC.ICatCode,\n\tR.Date",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
