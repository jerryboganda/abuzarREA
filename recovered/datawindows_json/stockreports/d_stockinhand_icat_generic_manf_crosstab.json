   },
   {
    "type": "number",
    "updatewhereclause": "yes",
    "name": "qty",
    "dbname": "qty"
   }
  ],
  "retrieve": "SELECT \n\tItemCategory=IC.Name,\n\tItemDesc = I.PackingDesc, \n\tGenericItem=GI.Name,\n\tManufacturer=M.Name,\n\tQty = SUM(GD.CurrQty)\nFROM \n\tGenericItem GI, \n\tItem I\n\tLEFT OUTER JOIN GodownDetail AS GD ON (I.ICode = GD.ICode),\n\tManufacturer M, \n\tItemCategory IC\nWHERE\n\tI.ICatCode IN (:ai_icatcode) AND\n\tGD.GCode IN (:ai_gcode) AND\n\tI.ManfCode = M.ManfCode AND\n\tI.GenericCode = GI.GenericCode AND\n\tI.ICatCode = IC.ICatCode\nGROUP BY\n\tIC.Name,\n\tI.PackingDesc, \n\tGI.Name,\n\tM.Name\nORDER BY \n\tGenericItem, \n\tManufacturer",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_icatcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_gcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "itemcategory A, genericitem A, itemdesc A"
 },
