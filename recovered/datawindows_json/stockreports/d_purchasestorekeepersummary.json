  "retrieve": " SELECT\n\t\tpurinvcode=(select count(purinvcode) \n\t\t\t\tfrom purledger \n\t\t\t\twhere\n\t\t\t\t\tPurInvCode Between :ar_SinvCode AND :ar_LinvCode AND\n\t\t\t\t\t(Posted = Case :ar_postedunposted \n\t\t\t\t\t WHEN 'B' THEN 'Y'\n\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t  \t\t\t\t WHEN 'N' THEN 'N'\n\t\t  \t\t\t ELSE 'Z'\n\t\t\t\t\t END OR\n\t\t\t\t\tPosted = Case :ar_postedunposted \n\t\t\t\t\t WHEN 'B' THEN 'N'\n\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t\t  \t\t\t WHEN 'N' THEN 'N'\n\t\t  \t\t\t ELSE 'Z'\n\t\t\t\t\t END)), \n\t\tPD.ICode, \n\t\tPD.Batch, \n\t\tPD.Expiry, \n\t\tItem = I.Name,\n\t\tactive=CASE I.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\t\tPacking=MAX(I.packingdesc),\n\t\tSUM(PD.looseQty) AS Qty, \n\t\tSUM(PD.BonusQty) AS Bonus,\n\t\tManufacturer = M.Name\n\nFROM\n\t\t(SELECT * FROM Purdetail WHERE PurInvCode Between :ar_SinvCode AND :ar_LinvCode) PD,\n\t\t(SELECT * FROM PurLedger WHERE PurInvCode Between :ar_SinvCode AND :ar_LinvCode) PL,\n\t\tManufacturer M,\n\t\tItem\tI\nWHERE \n\t\tPL.PurInvCode Between :ar_SinvCode AND :ar_LinvCode AND\n\t\tPL.PurInvCode = PD.PurInvcode AND\n\t\t(PL.Posted = Case :ar_postedunposted \n\t\t\t\t\t\t WHEN 'B' THEN 'Y'\n\t\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t\t\t  \t\t\t WHEN 'N' THEN 'N'\n\t\t\t  \t\t\t ELSE 'Z'\n\t\t\t\t\t\t END OR\n\t\tPL.Posted = Case :ar_postedunposted \n\t\t\t\t\t\t WHEN 'B' THEN 'N'\n\t\t\t\t\t\t WHEN 'Y' THEN 'Y'\n\t\t\t  \t\t\t WHEN 'N' THEN 'N'\n\t\t\t  \t\t\t ELSE 'Z'\n\t\t\t\t\t\t END) AND\n\t\tPD.ICode = I.ICode AND\n\t\tI.ManfCode = M.ManfCode\nGROUP BY\n\t\tPD.ICode, \n\t\tPD.Batch, \n\t\tPD.Expiry,\n\t\tM.Name,\n\t\tI.Name,\n\t\tI.Active\n\nORDER BY\n\t\tM.Name,\n\t\tI.Name \n\n",
  "arguments": {
