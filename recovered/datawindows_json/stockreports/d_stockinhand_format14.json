  "retrieve": "SELECT \n\tGroupname = CASE :as_type WHEN 'M' THEN ISNULL((SELECT Manufacturer.name FROM Manufacturer WHERE Manufacturer.ManfCode = item.manfcode), '')\n\t\t\tWHEN 'C' THEN ISNULL((SELECT ItemCategory.name FROM ItemCategory WHERE ItemCategory.ICatCode = item.icatcode), '')\n\t\t\tWHEN 'L' THEN ISNULL((SELECT ItemClass.name FROM ItemClass WHERE ItemClass.ICCode = item.iccode), '')\n\t\t\tELSE ISNULL((SELECT itempacking.name FROM itempacking WHERE itempacking.PackCode = item.packcode), '') END,\n\tItem.Name,  \n\taliasname=item.customicode, \n\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\tsaleprice=item.saleprice,\n\tItem.purprice,   \n\tItem.PackUnits,   \n\tQTY = isnull(sum(GodownDetail.CurrQty),0),   \n\tManufacturer.name,  \n\tclassname=itemclass.name,\n\tCategory=itemcategory.name,\n\tUnitPrice = Case :ai_pricetype \n\t\tWHEN 2 THEN Round(Item.purprice /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\tWHEN 1 THEN Round(max(Item.Saleprice) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\t/*WHEN 3 THEN Round(max(Item.avgprice), 2)*/\n\t\tWHEN 3 THEN max(Item.avgprice)\n\t\tEND,\n\tPackQty =isnull( Round(sum(GodownDetail.CurrQty) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2),0),\n\tStockValue = isnull(Sum(GodownDetail.CurrQty),0) *\n\t Case :ai_pricetype \n\t\t WHEN 2 THEN Round(Item.purprice /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\t WHEN 1 THEN Round(max(Item.Saleprice) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\t/* WHEN 3 THEN Round(max(Item.avgprice), 2)*/\n\tWHEN 3 THEN max(Item.avgprice)\n\tEND\n\nFROM\n\tManufacturer,   \n\tItem\n\tLEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)\n\tLEFT OUTER JOIN ItemClass ON (Item.iccode=itemclass.iccode),\n\tItemCategory\nWHERE \n\tCASE :as_type WHEN 'M' THEN Item.ManfCode\n\t\tWHEN 'C' THEN Item.ICatCode\n\t\tWHEN 'L' THEN Item.ICCode\n\t\t\t\t ELSE Item.PackCode END in (:ai_groupcode) AND\n\t( Manufacturer.manfcode = Item.ManfCode ) and\n\t( Item.icatcode=itemcategory.icatcode) and\n\t( Item.active=1)\n\nGROUP BY \n\tItem.name, item.customicode, Item.Active, Item.purprice, Item.PackUnits, Manufacturer.name,\n\tItem.ManfCode, Item.ICatCode, Item.ICCode, Item.PackCode, \n\titem.saleprice, itemcategory.name, Itemclass.name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_type",
      "string"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_pricetype",
      "number"
     ]
    }
   ]
  },
  "sort": "groupname A, item_name A"
 },
