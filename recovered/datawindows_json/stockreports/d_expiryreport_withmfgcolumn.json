    "name": "godown",
    "dbname": "godown"
   }
  ],
  "retrieve": "   SELECT Item.CustomICode,    \n         Item.Name,   \n\t\t\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n         Item.PackUnits,   \n         ItemPacking.Name,   \n         GodownDetail.Batch,   \n\t\t GodownDetail.ManfDate,   \n         GodownDetail.Expiry,   \n         Item.AvgPrice,   \n         GodownDetail.CurrQty,\n\t\t\tmanufacturer=manufacturer.name  ,\n\t\t\tManfcode=item.manfcode,\n\t\t\tgcode=godowndetail.gcode,\n\t\t\tgodown=(select name from godown where gcode=godowndetail.gcode)\n    FROM GodownDetail,   \n\t\tItem LEFT OUTER JOIN ItemPacking ON (item.packcode = ItemPacking.packcode),\n         manufacturer\n\t\t\t  \n   WHERE case :as_group when 'P' then item.packcode\n\t\t\t\t\t\twhen 'C' THEN item.icatcode\n\t\t\t\t\t\twhen 'L' THEN item.iccode\n\t\t\t\t\t\twhen 'M' THEN item.manfcode  end  IN (:aa_manfcode) and\n\t\t\t( item.manfcode=manufacturer.manfcode)and\n\t\t\t( Item.ICode = GodownDetail.ICode ) and  \n         ( ( GodownDetail.Expiry <= DateAdd(day, :ar_date, GetDate()) ) )    \n order by manufacturer.name  ,\n\t\t\t Item.name\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_date",
      "number"
     ]
    },
    {
     "_items": [
      "aa_manfcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "as_group",
      "string"
     ]
    }
   ]
  }
 },
