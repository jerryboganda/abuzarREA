  "retrieve": "select  \n\taliasname=max(t.aliasname),\n\tname=max(t.name),\n\t\n\tgodown=(select name from godown where godown.gcode=t.gcode),\n\tclass=(select name from itemclass where iccode=:ai_classcode),\n\tcategory=(select name from itemcategory where icatcode=:ai_catcode),\n\t\n\tqty=isNULL(sum(currqty),0),\n\tpiplinestock=(select ISNULL(sum(qty),0) from purorderheader POH, purorderdetail POD where POD.POCODE=POH.POCode and POH.Posted='N' and POD.icode=t.icode  )\n\t\n\t\nfrom \tgodowndetail GD\n\tRIGHT OUTER JOIN \t(select icode,name=item.name,aliasname=item.customicode,godown.gcode\n\tfrom item,godown \n\twhere item.iccode IN (:ai_classcode) and Item.ICatCode IN (:ai_catcode)) as t\n\tON (GD.ICode = t.icode AND GD.GCode=T.GCode)\ngroup by t.gcode,\n\t t.icode\norder by \n\tt.name,\n\tt.gcode\n",
  "arguments": {
   "_items": [
