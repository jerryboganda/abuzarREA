    "dbname": "Item.Name"
   },
   {
    "type": "char(1)",
    "updatewhereclause": "yes",
    "name": "active",
    "dbname": "active"
   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "optimumqty",
    "dbname": "Item.optimumQty"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "purprice",
    "dbname": "purprice"
   },
   {
    "type": "char(20)",
    "updatewhereclause": "yes",
    "name": "packing",
    "dbname": "Packing"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "required",
    "dbname": "Required"
   }
  ],
  "retrieve": "SELECT \n\tItem.CustomICode,   \n\tStock = isnull(SUM(GodownDetail.CurrQty),0),   \n\tItem.Name,   \n\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n   Item.optimumQty,\n\tpurprice=item.purprice,\n\tPacking= ISNULL((SELECT itempacking.Name FROM itempacking WHERE itempacking.packcode = item.packcode), ''),\n\tRequired= (Case WHEN isnull(SUM(GodownDetail.CurrQty),0)>=Item.optimumQty THEN 0\n\t\t\t\t\tELSE Item.optimumQty - isnull(SUM(GodownDetail.CurrQty),0) END)\t\nFROM \n\tItem\n\tLEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)\n\nWHERE\n\tItem.ManfCode IN (:aa_manfcode)  and\n\tItem.ICatCode IN (:aa_icatcode)  and\n\tItem.ICCode\t IN (:aa_iccode)    and\n\tItem.PackCode IN (:aa_packcode)\nGROUP BY \n\tItem.Name,   \n\tItem.CustomICode,   \n\titem.active,\n\titem.packcode,\n \tItem.optimumQty,\n\tItem.purprice\n\nORDER BY\n\titem.name,\n\tItem.CustomICode\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "aa_manfcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "aa_icatcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "aa_iccode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "aa_packcode",
      "numberlist"
     ]
    }
   ]
  }
 },
