  "retrieve": "SELECT \n\tgodown = case :as_allgodown when 'Y' then 'All Godown'\n\t\t\t\telse (select G.Name \n\t\t\t\t \t\tFrom Godown G where G.Gcode = :ai_Gcode)\n\t\t\t\tend, \n\tDate=S.Date,\n\tCode = CASE :as_ReportType WHEN 'M' THEN I.ManfCode \n\t\t\tWHEN 'C' THEN I.ICatCode \n\t\t\tELSE I.ICCode END,\n\tName = CASE :as_ReportType WHEN 'M' THEN M.name \n\t\t\tWHEN 'C' THEN IC.name \n\t\t\tELSE  ICL.name END,\n\tAliasName=I.customicode, \n\tItem=I.Name,\n\tactive=CASE I.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\tPurchasePrice=S.purchaseprice,\n\tPackUnits=S.PackUnits,   \n\tStock = sum(S.Stock),   \n\tUnitPrice = Case :ai_pricetype\n\t\tWHEN 2 THEN Round(S.purchaseprice/ CASE WHEN S.PackUnits > 0 THEN S.PackUnits ELSE 1 END, 2)\n\t\tWHEN 1 THEN Round(max(S.Saleprice) / CASE WHEN S.PackUnits > 0 THEN S.PackUnits ELSE 1 END, 2)\n\t\tWHEN 3 THEN Round(max(S.avgprice), 2) END ,\n\tStockValue = Sum(S.Stock) * \n\t\tCase :ai_pricetype\n\t\tWHEN 2 THEN Round(S.purchaseprice/ CASE WHEN S.PackUnits > 0 THEN S.PackUnits ELSE 1 END, 2)\n\t\tWHEN 1 THEN Round(max(S.Saleprice) / CASE WHEN S.PackUnits > 0 THEN S.PackUnits ELSE 1 END, 2)\n\t\tWHEN 3 THEN Round(max(S.avgprice), 2) END,\n\tManufacturer=M.name,\n\tClass=ICL.name,\n\tCategory=IC.name\n\nFROM \n\tStockReport S,\n\tItem I,\n\tManufacturer M,   \n\tItemCategory IC,\n\tItemClass ICL\nWHERE\n\tS.Date = :ad_date AND\n\t( I.ICode = S.ICode ) AND \n\t( S.GCode IN \n\t\t(select case :as_allgodown when 'Y' then gcode else :ai_GCode end \n\t\tfrom godown) ) AND\n\t( CASE :as_ReportType \n\t\t WHEN 'M' THEN I.ManfCode\n\t\t WHEN 'C' THEN I.ICatCode \n\t\t ELSE I.ICCode END IN (:ai_code) ) AND\n\t( M.ManfCode = I.ManfCode ) and\n\t( I.ICatCode= IC.ICatCode) and\n\t( I.ICCode=ICL.ICCode)\n\nGROUP BY \n\tS.Date,\n\tI.Name, \n\tI.CustomICode, \n\tI.Active,\n\tS.PurchasePrice, \n\tS.PackUnits, \n\tI.ManfCode,\n\tM.Name, \n\tI.ICatCode,\n\tIC.Name, \n\tI.ICCode,\n\tICL.Name\n\nORDER BY\n\tName,\n\tCODE,\n\tItem,\n\tAliasName\n",
