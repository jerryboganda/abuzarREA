   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "dueqty",
    "dbname": "DueQty"
   }
  ],
  "retrieve": "SELECT \n\tItem.CustomICode,   \n\tStock = isnull(SUM(GodownDetail.CurrQty),0),\n\tItem.Name,\n\tActive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\tItem.ReorderQty,\n\tgroupname = CASE :as_type WHEN 'M' THEN ISNULL((SELECT Manufacturer.name FROM Manufacturer WHERE Manufacturer.ManfCode = item.manfcode), '')\n\t\t\tWHEN 'C' THEN ISNULL((SELECT ItemCategory.name FROM ItemCategory WHERE ItemCategory.ICatCode = item.icatcode), '')\n\t\t\tWHEN 'L' THEN ISNULL((SELECT ItemClass.name FROM ItemClass WHERE ItemClass.ICCode = item.iccode), '')\n\t\t\tELSE ISNULL((SELECT itempacking.name FROM itempacking WHERE itempacking.PackCode = item.packcode), '') END,\n\tpacking=ISNULL((SELECT itempacking.name FROM itempacking WHERE itempacking.PackCode = item.packcode), ''),\n\tManufacturer=ISNULL((SELECT Manufacturer.name FROM Manufacturer WHERE Manufacturer.ManfCode = item.manfcode), ''),\n\tCategory=ISNULL((SELECT ItemCategory.name FROM ItemCategory WHERE ItemCategory.ICatCode = item.icatcode), ''),\n\tClass=ISNULL((SELECT ItemClass.name FROM ItemClass WHERE ItemClass.ICCode = item.iccode), ''),\n\tpurprice=item.purprice/(case item.packunits when 0 then 1 else item.packunits end),\n\tsaleprice=item.saleprice/(case item.packunits when 0 then 1 else item.packunits end),\n\tDueQty = (select isnull(sum(SD.looseqty+SD.bonusqty),0) from saledetail SD where SD.Due IN ('X','D','S') and SD.icode=Item.Icode)\n\t\t\t\t- (select isnull(sum(DD.DeletedQty),0) from DueDeleteDetail DD where DD.icode=Item.ICode)\n\t\t\t\t- (select isnull(sum(DS.DueSatisfyQty),0) from duesatisfydetail DS where DS.icode=item.icode)\nFROM \n\tItem LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode),\n\tManufacturer\nWHERE\n\t( Item.ManfCode = Manufacturer.ManfCode ) and  \n\tCASE :as_type WHEN 'M' THEN Item.ManfCode\n\t\tWHEN 'C' THEN Item.ICatCode\n\t\tWHEN 'L' THEN Item.ICCode\n\t\t\t\t ELSE Item.PackCode END in (:aa_code) \n\nGROUP BY \n\tItem.Icode,\n\tItem.CustomICode,   \n\tItem.Name,   \n\tItem.Active,\n\tItem.ManfCode,\n\tItem.PackCode,\n\tItem.ICCode,\n\tItem.ICatCode,\n\tItem.ReorderQty ,  \n\tItem.purprice,\n\tItem.saleprice,\n\titem.packunits\n\nORDER BY\n\tgroupname,\n\titem.name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "aa_code",
      "numberlist"
     ]
    },
    {
     "_items": [
      "as_type",
      "string"
     ]
    }
   ]
  },
  "sort": "groupname A, itemname A"
 },
