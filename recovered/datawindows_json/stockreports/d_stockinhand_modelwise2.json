  "retrieve": "Select \tItemName = I.Name,\n\t\t\tPackingDesc = I.PackingDesc,\n\t\t\tModel = MO.Name,\n\t\t\tManufacturer = M.Name,\n\t\t\tCategory = ICat.Name,\n\t\t\tColour = C.Name,\n\t       \tSize = S.Name,\n\t\t\tTotalStock = '',\n\t\t\tGodown1 = IsNull( (Select Name From Godown Where Gcode = 1) , '' ) ,\n\t\t\tGodown2 = IsNull( (Select Name From Godown Where Gcode = 2) , '' ),\n\t\t\tGodown1Stock = dbo.Fn_GetItemStockInGodowns(I.icode,1,1),\n\t\t\tGodown2Stock = dbo.Fn_GetItemStockInGodowns(I.icode,2,2),\n\t\t\tOthergodownsStock = dbo.Fn_GetItemStockInGodowns(I.icode,3,(Select Max(Gcode) From Godown) )\n\nFrom\t\tItem I, Manufacturer M, ItemCategory ICat, ItemClass C, ItemSize S, ItemInModel IM, Model MO\n\nWhere \tI.manfcode = M.manfcode AND\n\t\t\tI.iccode = C.iccode AND\n\t\t\tI.icatcode = ICat.icatcode AND\n\t\t\tICat.icatcode IN ( :ai_itemcategories ) AND\n\t\t\tI.isizecode = S.ISizeCode AND\n\t\t\tI.icode = IM.icode AND\n\t\t\tIM.modelcode IN (Select Min(modelcode) From ItemInModel Where ItemInModel.icode = I.Icode AND modelcode IN (:ai_models)) AND\n\t\t\tIM.modelcode = MO.modelcode\n\t\t\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_itemcategories",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_models",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "category A, model A, itemname A"
 },
