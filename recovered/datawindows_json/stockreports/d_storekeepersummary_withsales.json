  ],
  "retrieve": " SELECT  \n\tSaleinvcode=sl.saleinvcode, \n\tSD.ICode, \n\tSD.Batch, \n\tAliasName = I.CustomICode,\n\tItem = I.Name,\n\tGodown = G.Name,\n\tPacking=MAX(I.packingdesc),\n\tSUM(SD.looseQty) AS Qty, \n\tSUM(SD.BonusQty) AS Bonus,\n\tManufacturer = M.Name\nFROM\n\tSaledetail SD,\n\tSaleLedger SL,\n\tManufacturer M,\n\tItem\tI,\n\tGodown G\nWHERE \n\tSL.SaleInvCode = :ai_invCode AND\n\tSL.SaleInvCode = SD.SaleInvcode AND\n\tSD.ICode = I.ICode AND\n\tI.ManfCode = M.ManfCode AND\n\tSD.GCode = G.GCode AND\t\n\tSD.GCode NOT IN \n\t\t(SELECT TOP 1 GCode=Min(GCode)\n\t\tFROM GroupAllowedGodown\n\t\tWHERE Module = 1 AND GroupCode=:ai_groupcode\n\t\tGROUP BY Priority)\nGROUP BY\n\tSL.SaleInvCode,\n\tSD.ICode, \n\tSD.GCode,\n\tSD.Batch, \n\tM.Name,\n\tI.Name,\n\tI.CustomICode,\n\tG.Name\nORDER BY\n\tG.Name,\n\tI.Name,\n\tI.CustomICode,\n\tSD.Batch",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_invcode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "number"
     ]
    }
   ]
  }
 },
