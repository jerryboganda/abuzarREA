  "retrieve": "SELECT\n\tItem.Name,  \n\taliasname=item.customicode, \n\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\tItem.purprice,   \n\tItem.PackUnits,   \n\tItem.PackingDesc,\n\tQTY = isnull(sum(GodownDetail.CurrQty),0),   \n\tcurrstockval=isnull(sum(GodownDetail.CurrQty),0) *(Case :ai_pricetype \n\t\t\t\t\t\tWHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\t\t\t\t\tWHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\t\t\t\t\tWHEN 3 THEN Round(max(Item.avgprice), 2)\n\t\t\t\t\tEND),\n\tDueQty = (select isnull(sum(SD.looseqty+SD.bonusqty),0) from saledetail SD where SD.Due IN ('X','D','S') and SD.icode=Item.Icode)\n\t\t\t\t- (select isnull(sum(DD.DeletedQty),0) from DueDeleteDetail DD where DD.icode=Item.ICode)\n\t\t\t\t- (select isnull(sum(DS.DueSatisfyQty),0) from duesatisfydetail DS where DS.icode=item.icode),\n\tDueQtyValue=((select isnull(sum(SD.looseqty + SD.bonusqty),0) from saledetail SD where SD.Due IN ('X','D','S') and SD.icode=Item.Icode)\n\t\t\t\t\t- (select isnull(sum(DD.DeletedQty),0) from DueDeleteDetail DD where DD.icode=Item.ICode)\n\t\t\t\t\t- (select isnull(sum(DS.DueSatisfyQty),0) from duesatisfydetail DS where DS.icode=item.icode) )\n\t\t\t\t\t*(Case :ai_pricetype \n\t\t\t\t\t\tWHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\t\t\t\t\tWHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\t\t\t\t\tWHEN 3 THEN Round(max(Item.avgprice), 2)\n\t\t\t\t\tEND ),\n\tsatisfyqty=(select isnull(sum(DS.DueSatisfyQty),0) from duesatisfydetail DS where DS.icode=item.icode),\n\tManufacturer.name,\n\tItemPacking = itempacking.name,\n\tCategory=itemcategory.name,\n\tUnitPrice = \n\t\tCase :ai_pricetype \n\t\t\tWHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\t\tWHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\t\tWHEN 3 THEN Round(max(Item.avgprice), 2)\n\t\tEND ,\n\tPackQty =isnull( Round(sum(GodownDetail.CurrQty) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2),0),\n\tStockValue = isnull(Sum(GodownDetail.CurrQty),0) *\n\t\tCase :ai_pricetype \n\t\t\tWHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\t\tWHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)\n\t\t\tWHEN 3 THEN Round(max(Item.avgprice), 2)\n\t\tEND\n\nFROM \n\tManufacturer,   \n\tItem\n\tLEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)\n\tLEFT OUTER JOIN ItemPacking ON (Item.packcode=itempacking.packcode),\n\tItemCategory\n\nWHERE \n\t( Item.ManfCode IN (:manfcode ) ) and\n\t( Manufacturer.manfcode = Item.ManfCode ) and\n\t( Item.icatcode=itemcategory.icatcode) and\n\t( Item.active=1)\n\nGROUP BY \n\tItem.icode,\n\tItem.name,\n\titem.customicode, \n\titem.active,\n\tItem.purprice, \n\tItem.PackUnits, \n\tItem.PackingDesc,\n\tManufacturer.name,\n\titemcategory.name,\n\tItemPacking.name \n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "manfcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_pricetype",
      "number"
     ]
    }
   ]
  },
  "sort": "manufacturer_name A, item_name A"
 },
