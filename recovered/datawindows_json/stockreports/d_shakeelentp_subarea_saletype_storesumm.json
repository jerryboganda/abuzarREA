  "retrieve": " SELECT \n\t\tSaleinvcode=(SELECT COUNT(s.saleinvcode) \n\t\t\t\tFROM saleledger s, customer cc, area ar, subarea sar\n\t\t\t\tWHERE\n\t\t\t\t\ts.SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND \n\t\t\t\t\ts.SaleTypeCode IN ((SELECT Code FROM DBO.udf_stringtotabl(:ar_saletypecode, ','))) AND\n\t\t\t\t\ts.custcode = cc.custcode AND \n\t\t\t\t\tcc.areacode = ar.areacode AND \n\t\t\t\t\tcc.subareacode = sar.subareacode AND \n\t\t\t\t\tar.areacode = sar.areacode AND \n\t\t\t\t\tsar.subareacode IN ((SELECT Code FROM DBO.udf_stringtotabl(:ar_subareacode, ','))) AND\n\t\t\t\t\ts.Posted = 'Y'), \n\t\tSD.ICode, \n\t\tSD.Batch, \n\t\tItem = I.Name,\n\t\tPacking=MAX(I.packingdesc),\n\t\tSUM(SD.looseQty) AS Qty, \n\t\tSUM(SD.BonusQty) AS Bonus,\n\t\tsaleprice=SD.saleprice,\n\t\tSaleValue=SUM(SD.looseQty * (SD.SalePrice - ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) *\n\t\t\t(1 - SL.DiscPerc * 0.01)),\n\t\tManufacturer = CASE :ar_grouping WHEN 1 THEN ICT.Name WHEN 2 THEN M.Name ELSE IC.Name END\nFROM\n\t\tSaledetail SD,\n\t\tSaleLedger SL,\n\t\tCustomer C,\n\t\tArea A,\n\t\tSubArea SA,\n\t\tManufacturer M,\n\t\tItemCategory ICT,\n\t\tItemClass IC,\n\t\tItem\tI\nWHERE \n\t\tSL.SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND\n\t\tSL.SaleTypeCode IN ((SELECT Code FROM DBO.udf_stringtotabl(:ar_saletypecode, ','))) AND\n\t\tSL.SaleInvCode = SD.SaleInvcode AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.AreaCode = A.AreaCode AND\n\t\tC.SubAreaCode = SA.SubAreaCode AND\n\t\tA.AreaCode = SA.AreaCode AND\n\t\tSA.SubAreaCode IN ((SELECT Code FROM DBO.udf_stringtotabl(:ar_subareacode, ','))) AND\n\t\tSL.Posted = 'Y' AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = M.ManfCode AND\n\t\tI.ICatCode = ICT.ICatCode AND\n\t\tI.ICCode = IC.ICCode\nGROUP BY\n\t\tSD.ICode, \n\t\tSD.Batch, \n\t\tSD.saleprice,\n\t\tM.Name,\n\t\tICT.Name,\n\t\tIC.Name,\n\t\tI.Name\nORDER BY\n\t\tManufacturer,\n\t\tI.Name \n",
