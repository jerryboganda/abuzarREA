  "retrieve": "Select\n\tRights.RightCode, Rights.LevelIndex, IndicesString=REPLACE(Rights.IndicesString, :ar_indicesstring, ''), Rights.Object, Status=1, Rights.RightName\nFrom\n\tUserGroups,GroupRights, Rights  \nWhere\n\tUserGroups.UserCode = :ar_User And \n\tGroupRights.GroupCode = UserGroups.GroupCode And \n\tRights.Object = :ar_ObjectLevel  And \n\tRights.IndicesString LIKE (:ar_indicesstring + '%') And\n\tRights.RightCode = GroupRights.RightCode \nUnion  \nSelect \n\tRights.RightCode, Rights.LevelIndex, IndicesString=REPLACE(Rights.IndicesString, :ar_indicesstring, ''), Rights.Object, Status=UserRights.Status ,Rights.RightName \nFrom \n\tUsers,UserRights, Rights  \nWhere\n\tUsers.UserCode = :ar_User And \n\tUserRights.UserCode = Users.UserCode And \n\tRights.Object = :ar_ObjectLevel And \n\tRights.IndicesString LIKE (:ar_indicesstring + '%') And\n\tRights.RightCode = UserRights.RightCode \nOrder by \n\tstatus desc ",
  "arguments": {
