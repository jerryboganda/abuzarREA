  "retrieve": "SELECT\n\tServiceSRAllocationHeader.ServiceSRAllocationCode,   \n\tServiceSRAllocationHeader.Date,   \n\tServiceSRAllocationHeader.ServiceRInvCode,   \n\tReturnDate=ServiceRHeader.Date, \n\tReturnAmt=ServiceRHeader.InvTotal,\n\tReturnOutstanding=ServiceRHeader.OutStandingAmt,\n\tServiceRHeader.ServiceInvCode, \n\tServiceRHeader.CustCode,\n\tAccounts.AliasName, \n\tAccounts.Name,\n\tServiceSRAllocationHeader.UserCode,\n\tServiceSRAllocationHeader.Modified, \n\tServiceSRAllocationHeader.ModifiedBy,\n\tServiceSRAllocationHeader.Posted, \n\tServiceSRAllocationHeader.PostedBy,\n\tServiceSRAllocationHeader.PostDate\nFROM \n\tServiceSRAllocationHeader, ServiceRHeader, Accounts, Customer\nWHERE\n\tServiceSRAllocationHeader.ServiceSRAllocationCode = :code AND\n\tServiceSRAllocationHeader.ServiceRInvCode = ServiceRHeader.ServiceRInvCode AND\n\tServiceRHeader.CustCode = Customer.CustCode AND\n\tCustomer.CustCode = Accounts.AccCode\n",
