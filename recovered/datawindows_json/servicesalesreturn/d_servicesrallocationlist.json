  "retrieve": "SELECT\n\tServiceSRAllocationHeader.ServiceSRAllocationCode,   \n\tServiceSRAllocationHeader.Date,   \n\tServiceSRAllocationHeader.ServiceRInvCode,   \n\tReturnDate=ServiceRHeader.Date, \n\tReturnAmt=ServiceRHeader.InvTotal,\n\tServiceRHeader.ServiceInvCode, \n\tAccounts.AliasName, \n\tAccounts.Name,\n\tUsers.UserName,\n\tServiceSRAllocationHeader.Posted, \n\tServiceSRAllocationHeader.PostDate\nFROM \n\tServiceSRAllocationHeader, ServiceRHeader, Accounts, Customer, Users\n\nWHERE\n\tServiceSRAllocationHeader.ServiceRInvCode = ServiceRHeader.ServiceRInvCode AND\n\tServiceRHeader.CustCode = Customer.CustCode AND\n\tCustomer.CustCode = Accounts.AccCode AND\n\tServiceSRAllocationHeader.UserCode = Users.UserCode\n\nORDER BY\n\tServiceSRAllocationHeader.ServiceSRAllocationCode"
 },
