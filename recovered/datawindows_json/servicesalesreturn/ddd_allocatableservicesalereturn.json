   }
  ],
  "retrieve": "SELECT \n\tServiceRInvCode,\n\tServiceInvCode,   \n\tDate,   \n\tCustCode,   \n\tCustomer,\n\tAliasName,\n\tOutstandingAmt,\n\tInvTotal\nFROM \n\t(SELECT \n\t\tServiceRHeader.ServiceRInvCode,   \n\t\tServiceRHeader.ServiceInvCode,   \n\t\tServiceRHeader.Date,   \n\t\tServiceRHeader.CustCode,   \n\t\tCustomer=Accounts.Name,\n\t\tAliasName=Accounts.AliasName,\n\t\tOutstandingAmt = ServiceRHeader.OutstandingAmt + \n\t\t\tISNULL((SELECT ServiceSRAllocationHeader.ServiceRInvCode FROM ServiceSRAllocationHeader \n\t\t\t\tWHERE ServiceSRAllocationHeader.ServiceSRAllocationCode = :Code AND \n\t\t\t\t\tServiceSRAllocationHeader.ServiceRInvCode = ServiceRHeader.ServiceRInvCode), 0),\n\t\tServiceRHeader.InvTotal\n\t\n\tFROM \n\t\tServiceRHeader, Accounts\n\tWHERE\n\t\tServiceRHeader.Marked = 'N' AND\n\t\tServiceRHeader.Posted ='Y' AND\n\t\tServiceRHeader.CustCode = Accounts.AccCode) SR\nWHERE \n\tOutstandingAmt > 0\nORDER BY\n\tDate,   \n\tServiceRInvCode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "code",
      "number"
     ]
    }
   ]
  }
 },
