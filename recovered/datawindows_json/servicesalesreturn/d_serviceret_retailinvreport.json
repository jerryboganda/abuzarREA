  "retrieve": "SELECT \n\titemname = service.name,\n\tusers.username,  \n\taccounts.name, \n\treprintdate = getDate(),\n\treprintcount = 0,\n\tdbo.serviceRheader.serviceRinvcode,   \n\tdbo.serviceRheader.date,  \n\tdbo.serviceRheader.headerno, \n\tdbo.serviceRheader.discperc,  \n\tdbo.serviceRheader.flatdisc,\t \n\tdbo.serviceRheader.misccharges,   \n\tdbo.serviceRheader.custcode,   \n\tdbo.serviceRheader.remarks,\n\tdbo.service.servicecode,   \n\tprice = dbo.serviceRdetail.Serviceprice, \n\tServiceFlatDisc = ServiceRDetail.ServiceFlatDisc,\n\tQty = dbo.serviceRdetail.qty,\n\tservicedetail_discperc = dbo.serviceRdetail.discperc, \n\tcustomername='                                  '  \n\t\nFROM \n\tdbo.serviceRheader,   \n\tdbo.serviceRdetail,  \n\tservice, \n\tcustomer, \n\taccounts,\n\tusers \n\t\nWHERE \n\t( dbo.serviceRheader.serviceRinvcode = :ra_InvCode ) AND\n\t( dbo.serviceRheader.serviceRinvcode = dbo.serviceRdetail.serviceRinvcode ) AND \n\t( dbo.serviceRheader.custcode = dbo.customer.custcode ) AND \n\t( dbo.customer.custcode = dbo.accounts.acccode ) AND \n\t( dbo.serviceRheader.salesmancode = dbo.users.usercode ) AND\n\t( serviceRdetail.servicecode = service.servicecode )  \n\t\nOrder by \n\tdbo.ServiceRDetail.SrvRRowid",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  }
