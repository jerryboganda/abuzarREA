  "retrieve": "SELECT \n\tservicerheader.servicerinvcode,   \n\tservicerheader.serviceinvcode,   \n\tservicerheader.date,  \n\tInvTotal = servicerheader.invtotal,\n\tposted = servicerheader.posted,\n\tPostedBy = IsNull((Select username from users \n\t\t\t\twhere servicerheader.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\t\t\twhere servicerheader.modifiedby = dbo.users.usercode), '')  \nFROM \n\tservicerheader  \nWHERE \n\tservicerheader.servicercatcode = :ai_srCatCode    and\n\tservicerheader.Posted IN (:as_Posted) \n",
