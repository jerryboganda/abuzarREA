  "retrieve": "SELECT  \n\tWard = (SELECT W.Name FROM Ward W WHERE W.WardCode=dbo.saleledger.WardCode),\n\tAmount = Sum (dbo.saledetail.looseqty * dbo.saledetail.saleprice)\nFROM \t \n\tdbo.saleledger, \n\tdbo.saledetail, \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Accounts,\n\tdbo.Manufacturer \nWHERE  \n\t:as_doctype = 'originaldate' AND\n\tdbo.saleledger.originaldate >= :ad_StartDate AND\n\tdbo.saleledger.originaldate <= :ad_EndDate  AND \n\tdbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND\n\tdbo.saleledger.salecatcode IN (1, 2, 3) AND\n\tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\tdbo.saledetail.icode = item.icode AND\n\tdbo.saleledger.custcode = dbo.customer.custcode AND\n\tdbo.customer.custcode = dbo.accounts.acccode AND\n\tdbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\tdbo.saleledger.WardCode\nUNION ALL\nSELECT \n\tWard = (SELECT W.Name FROM Ward W WHERE W.WardCode=dbo.saleledger.WardCode),\n\tAmount = Sum (sd.looseqty * sd.saleprice)\nFROM \t \n\tdbo.saleledger, \n\tdbo.saleinvdetail sd,    \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Accounts,\n\tdbo.Manufacturer \nWHERE  \n\tDBO.SaleLedger.impactinventory = 'N' AND\n\t:as_doctype = 'originaldate' AND\n\tdbo.saleledger.originaldate >= :ad_StartDate AND\n\tdbo.saleledger.originaldate <= :ad_EndDate  AND \n\tdbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND\n\tdbo.saleledger.salecatcode IN (1, 2, 3) AND\n\tdbo.saleledger.saleinvcode = sd.saleinvcode AND\n\tsd.icode = item.icode AND\n\tdbo.saleledger.custcode = dbo.customer.custcode AND\n\tdbo.customer.custcode = dbo.accounts.acccode AND\n\tdbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\tdbo.saleledger.WardCode\nUNION\nSELECT \n\tWard = (SELECT W.Name FROM Ward W WHERE W.WardCode=dbo.saleledger.WardCode),\n\tAmount = Sum (dbo.saledetail.looseqty * dbo.saledetail.saleprice)\nFROM\n\tdbo.saleledger, \n\tdbo.saledetail,    \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Accounts,\n\tdbo.Manufacturer \nWHERE  \n\t:as_doctype = 'billingdate' AND\n\tdbo.saleledger.billingdate >= :ad_StartDate AND\n\tdbo.saleledger.billingdate <= :ad_EndDate  AND \n\tdbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND\n\tdbo.saleledger.salecatcode IN (1, 2, 3) AND\n\tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\tdbo.saledetail.icode = item.icode AND\n\tdbo.saleledger.custcode = dbo.customer.custcode AND\n\tdbo.customer.custcode = dbo.accounts.acccode AND\n\tdbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\tdbo.saleledger.WardCode\nUNION ALL\nSELECT \n\tWard = (SELECT W.Name FROM Ward W WHERE W.WardCode=dbo.saleledger.WardCode),\n\tAmount = Sum (sd.looseqty * sd.saleprice)\nFROM\n\tdbo.saleledger, \n\tdbo.saleinvdetail sd,    \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Accounts,\n\tdbo.Manufacturer \nWHERE  \n\tDBO.SaleLedger.impactinventory = 'N' AND\n\t:as_doctype = 'billingdate' AND\n\tdbo.saleledger.billingdate >= :ad_StartDate AND\n\tdbo.saleledger.billingdate <= :ad_EndDate  AND \n\tdbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND\n\tdbo.saleledger.salecatcode IN (1, 2, 3) AND\n\tdbo.saleledger.saleinvcode = sd.saleinvcode AND\n\tsd.icode = item.icode AND\n\tdbo.saleledger.custcode = dbo.customer.custcode AND\n\tdbo.customer.custcode = dbo.accounts.acccode AND\n\tdbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\tdbo.saleledger.WardCode\nUNION\nSELECT \n\tWard = (SELECT W.Name FROM Ward W WHERE W.WardCode=dbo.saleledger.WardCode),\n\tAmount = Sum (dbo.saledetail.looseqty * dbo.saledetail.saleprice)\nFROM\n\tdbo.saleledger, \n\tdbo.saledetail,    \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Accounts,\n\tdbo.Manufacturer \nWHERE  \n\t:as_doctype = 'lastsavingdate' AND\n\tdbo.saleledger.date >= :ad_StartDate AND\n\tdbo.saleledger.date <= :ad_EndDate  AND \n\tdbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,'