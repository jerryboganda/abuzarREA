  "retrieve": "SELECT saleinvcode = dbo.saleledger.saleinvcode, \n\t\t CustomerRef = convert(int ,rtrim(ltrim(IsNull(dbo.saleledger.CustRefNo, '0')))), \n       date = dbo.saleledger.date,    \n       invdiscperc = dbo.saleledger.discperc,    \n       flatdisc = dbo.saleledger.flatdisc,    \n       misccharges = dbo.saleledger.misccharges, \n       invsalestax = dbo.saleledger.salestax,\n       remarks = dbo.saleledger.remarks,\n       custcode = dbo.saleledger.custcode,\n\t\t looseqty = dbo.saledetail.looseqty, \n\t\t packqty  = saledetail.packqty,  \n\t\t price = round(dbo.Item.saleprice / dbo.saledetail.packunits,4),\t\n       /*price = dbo.saledetail.saleprice,*/    \n       itemdiscperc = dbo.saledetail.discperc,    \n\t\t packunits = dbo.saledetail.packunits,    \n\t\t batch = dbo.saledetail.batch,    \n\t\t expiry = dbo.saledetail.expiry,    \n\t\t salestax  = saledetail.salestax,\n\t\t rowid     = saledetail.rowid,\n\t \t itemname = item.name, \n\t\t datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), \n\t\t Person = dbo.accounts.name,\n\t\t manufacurer = dbo.manufacturer.name,\n\t\t address = dbo.customer.address1,\n\t\t city = dbo.customer.city,\n\t\t cumulativesum=0\n\t\t  \nFROM \t dbo.saleledger, \n\t\t dbo.saledetail,    \n\t\t dbo.item, \n\t\t dbo.accounts,\n\t\t dbo.Customer,\n\t\t dbo.Manufacturer \n\nWHERE  dbo.saleledger.date >= :ad_StartDate and\n\t\t dbo.saleledger.date <= :ad_EndDate  and \n\t\t (dbo.saleledger.custcode >= ( Case :al_CustCode When 0 Then 10 Else :al_CustCode End) and \n\t\t dbo.saleledger.custcode  <= ( Case :al_CustCode When 0 THEN (Select max(custcode) From Customer) Else :al_CustCode End )) and\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) and\n\t\t dbo.saleledger.saleinvcode NOT IN (select distinct srledger.saleinvcode from srledger where srledger.date between :ad_StartDate and :ad_EndDate and srledger.saleinvcode IS NOT NULL) and\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  \n\t\t dbo.saledetail.icode = item.icode and \n\t\t dbo.saleledger.custcode = dbo.accounts.acccode and\n\t\t dbo.saleledger.custcode = dbo.customer.custcode and\n\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\nUNION ALL\nSELECT saleinvcode = dbo.saleledger.saleinvcode, \n\t\t CustomerRef = convert(int ,rtrim(ltrim(IsNull(dbo.saleledger.CustRefNo, '0')))), \n       date = dbo.saleledger.date,   \n       invdiscperc = dbo.saleledger.discperc,    \n       flatdisc = dbo.saleledger.flatdisc,    \n       misccharges = dbo.saleledger.misccharges, \n       invsalestax = dbo.saleledger.salestax,\n       remarks = dbo.saleledger.remarks,\n       custcode = dbo.saleledger.custcode,\n\t\t looseqty = sd.looseqty, \n\t\t packqty  = 0,  \n\t\t price = round(dbo.Item.saleprice / sd.packunits,4),\t\n       /*price = sd.saleprice,*/    \n       itemdiscperc = sd.discperc,    \n\t\t packunits = sd.packunits,    \n\t\t batch = sd.batch,    \n\t\t expiry = sd.expiry,    \n\t\t salestax  = 0,\n\t\t rowid     = sd.rowid,\n\t \t itemname = item.name, \n\t\t datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), \n\t\t Person = dbo.accounts.name,\n\t\t manufacurer = dbo.manufacturer.name,\n\t\t address = dbo.customer.address1,\n\t\t city = dbo.customer.city,\n\t\t cumulativesum=0\n\t\t  \nFROM \t dbo.saleledger, \n\t\t dbo.saleinvdetail sd,\n\t\t dbo.item, \n\t\t dbo.accounts,\n\t\t dbo.Customer,\n\t\t dbo.Manufacturer \n\nWHERE  DBO.SaleLedger.impactinventory = 'N' AND \n\t\t dbo.saleledger.date >= :ad_StartDate and\n\t\t dbo.saleledger.date <= :ad_EndDate  and \n\t\t (dbo.saleledger.custcode >= ( Case :al_CustCode When 0 Then 10 Else :al_CustCode End) and \n\t\t dbo.saleledger.custcode  <= ( Case :al_CustCode When 0 THEN (Select max(custcode) From Customer) Else :al_CustCode End )) and\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) and\n\t\t dbo.saleledger.saleinvcode NOT IN (select distinct srledger.saleinvcode from srledger where srledger.date between :ad_StartDate and :ad_EndDate and srledger.saleinvcode IS NOT NULL) and\n\t\t dbo.saleledger.saleinvcode = sd.saleinvcode and  \n\t\t sd.icode = item.icode and \n\t\t dbo.saleledger.custcode = dbo.accounts.acccode and\n\t\t dbo.saleledger.custcode = dbo.customer.custcode and\n\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\n",
  "arguments": {
