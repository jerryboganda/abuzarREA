   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "invoices",
    "dbname": "Invoices"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "invoicesvalue",
    "dbname": "InvoicesValue"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "balance",
    "dbname": "Balance"
   }
  ],
  "retrieve": "SELECT\n\tS.CustCode,\n\tA.AliasName, \n\tA.Name As Customer,\n\tCOUNT(S.saleinvcode) as Invoices,\n\tSUM(S.Net) AS InvoicesValue,\n\tBalance=ISNULL(B.Balance, 0)\n\nFROM\t\n\t(SELECT \n\t\tSL.saleinvcode,\n\t\tSL.Custcode,\n\t\tNet=Round(\n\t\t\tSUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *\n\t\t\t(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + \n\t\t\tSL.misccharges + SL.salestax - SL.flatdisc, 0)+\n\t\t\tRound(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + \n\t\t\tSUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *\n\t\t\t\t(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +\n\t\t\tROUND( (SUM((SD.looseqty * \n\t\t\t\t(SD.saleprice - SD.itemflatdisc)) *\n\t\t\t\t(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -\n\t\t\t\tSL.flatdisc) * (SL.invgstperc1 * .01), 2), 0)\n\tFROM    saleledger SL, saledetail SD\n\tWHERE   SL.Posted = 'Y' AND\n\t\tSL.SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND\n\t\tSL.SaleInvCode = SD.SaleInvcode\n\tGROUP BY SL.saleinvcode,\n\t\t SL.CustCode,\n\t\t SL.discperc,\n\t\t SL.misccharges,\n\t\t SL.salestax,\n\t\t SL.flatdisc,\n\t\t SL.invgstperc1\n\tUNION ALL\n\tSELECT SL.saleinvcode,\n\t\tSL.Custcode,\n\t\tNet=Round(\n\t\t\tSUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *\n\t\t\t(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + \n\t\t\tSL.misccharges + SL.salestax - SL.flatdisc, 0)+\n\t\t\tRound(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + \n\t\t\tSUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *\n\t\t\t\t(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +\n\t\t\tROUND( (SUM((SD.looseqty * \n\t\t\t\t(SD.saleprice - SD.itemflatdisc)) *\n\t\t\t\t(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -\n\t\t\t\tSL.flatdisc) * (SL.invgstperc1 * .01), 2), 0)\n\tFROM saleledger SL,\t \n\t\tsaleinvdetail SD\n\tWHERE SL.Posted = 'Y' AND ImpactInventory='N' AND\n\t\tSL.SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND\n\t\tSL.SaleInvCode = SD.SaleInvcode\n\tGROUP BY SL.saleinvcode,\n\t\t SL.CustCode,\n\t\t SL.discperc,\n\t\t SL.misccharges,\n\t\t SL.salestax,\n\t\t SL.flatdisc,\n\t\t SL.invgstperc1) AS S \n\tLEFT OUTER JOIN  \n\t(SELECT  Acccode,\n\t\tBalance=Sum(debit-credit)\n\tFrom VirtualGL\n\tWhere Acccode IN (select custcode from customer)\n\tGroup By Acccode) AS B ON (S.CustCode = B.AccCode),\n\tAccounts A\n\nWHERE\n\tS.CustCode = A.AccCode\nGROUP BY\n\tS.CustCode,\n\tA.Name,\n\tA.AliasName,\n\tB.Balance\nORDER BY\n\tA.Name,\n\tA.AliasName,\n\tS.CustCode,\n\tB.Balance\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_SinvCode",
      "number"
     ]
    },
    {
     "_items": [
      "ar_LinvCode",
      "number"
     ]
    }
   ]
  }
 },
