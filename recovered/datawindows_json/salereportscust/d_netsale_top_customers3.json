  "retrieve": "SELECT \n\tA.GroupCode, \n\tGroupName= \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = A.GroupCode)\n\t\tWHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = A.GroupCode)\n\t\tWHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = A.GroupCode)\n\t\tELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = A.GroupCode) END,   \n\tSalesManCode=A.SalesManCode,\n\tSalesMan=(Select SM.Name FROM SalesMan SM Where SM.SalesManCode = A.SalesManCode),\n\tAliasName=(Select Ac.AliasName FROM accounts Ac Where Ac.Acccode = A.CustCode),\n\tcustomer=(Select Ac.Name FROM accounts Ac Where Ac.Acccode = A.CustCode),\n\tAddress=(Select RTRIM(LTRIM(C.Address1)) + ' ' + RTRIM(LTRIM(C.Address2)) FROM Customer C Where C.CustCode = A.CustCode),\n\tCity=(Select C.CITY FROM Customer C Where C.CustCode = A.CustCode),\n\tAmount=Sum(A.amount),\n\tShow='N' \nFROM\n\t(SELECT\t\n\t\tSaleType='S',\n\t\tSalesManCode=S.SManCode,\n\t\tCustCode=S.CustCode,\n\t\tICode=D.ICode,\n\t\tGroupCode=\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END,   \n\t\tAmount = Round(Sum ( D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)), 2)\n\tFROM \n\t\tdbo.SaleLedger S, \n\t\tdbo.Customer C, \n\t \tdbo.SaleDetail D, \n\t \tdbo.Item I\n\tWHERE\n\t\tS.Date >= :ad_StartDate and\n\t \tS.Date <= :ad_EndDate  and\n\t\tS.CustCode = C.CustCode and\n\t\tS.SManCode IN (:ai_SalesManCode) and\n\t \tS.SaleInvCode = D.SaleInvCode and  \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ai_groupcode) and\n\t \tD.icode = I.icode \n\tGROUP BY\n\t\tS.CustCode,\n\t\tS.SManCode,\n\t\tD.ICode,\n\t\tI.ManfCode,\n\t\tI.ICatCode,\n\t\tI.ICCode,\n\t\tI.PackCode\n\tUNION ALL\n\tSELECT\t\n\t\tSaleType='S',\n\t\tSalesManCode=S.SManCode,\n\t\tCustCode=S.CustCode,\n\t\tICode=D.ICode,\n\t\tGroupCode=\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END,   \n\t\tAmount = Round(Sum ( D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)), 2)\n\tFROM \n\t\tdbo.SaleLedger S, \n\t\tdbo.Customer C, \n\t \tdbo.SaleInvDetail D, \n\t \tdbo.Item I\n\tWHERE\t\n\t\tS.ImpactInventory = 'N' AND\n\t\tS.Date >= :ad_StartDate and\n\t \tS.Date <= :ad_EndDate  and\n\t\tS.CustCode = C.CustCode and\n\t\tS.SManCode IN (:ai_SalesManCode) and\n\t \tS.SaleInvCode = D.SaleInvCode and  \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ai_groupcode) and\n\t \tD.icode = I.icode \n\tGROUP BY\n\t\tS.CustCode,\n\t\tS.SManCode,\n\t\tD.ICode,\n\t\tI.ManfCode,\n\t\tI.ICatCode,\n\t\tI.ICCode,\n\t\tI.PackCode\n\tUNION ALL\n\tSELECT\t\n\t\tSaleType='R',\n\t\tSalesManCode=S.SManCode,\n\t\tCustCode=S.CustCode,\n\t\tICode=D.ICode,\n\t\tGroupCode=\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END,   \n\t\tAmount = - Round(Sum ( D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)), 2)\n\tFROM \n\t\tdbo.SRLedger S, \n\t\tdbo.Customer C, \n\t \tdbo.SRDetail D, \n\t \tdbo.Item I\n\tWHERE\n\t\tS.Date >= :ad_StartDate and\n\t \tS.Date <= :ad_EndDate  and\n\t\tS.CustCode = C.CustCode and\n\t\tS.SManCode IN (:ai_SalesManCode) and\n\t \tS.SRInvCode = D.SRInvCode and  \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ai_groupcode) and\n\t \tD.icode = I.icode \n\tGROUP BY\n\t\tS.CustCode,\n\t\tS.SManCode,\n\t\tD.ICode,\n\t\tI.ManfCode,\n\t\tI.ICatCode,\n\t\tI.ICCode,\n\t\tI.PackCode) AS A\nGROUP BY  \n\tA.CustCode,\n\tA.SalesManCode,\n\tA.GroupCode\nORDER BY\n\tGroupName,\n\tSalesMan,\n\tAmount Desc,\n\tCustomer\n",
