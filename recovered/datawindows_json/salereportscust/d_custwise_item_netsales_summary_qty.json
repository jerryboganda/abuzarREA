    "name": "salevalue",
    "dbname": "salevalue"
   }
  ],
  "retrieve": "SELECT \n\tAreaName = A.Name,\n\tAliasName = AC.AliasName,\n\tCustomerName = AC.Name,\n\tItemName = I.Name,\n\tSaleValue = Round(SUM(SaleValue), 2)\nFROM \n\tArea A, \n\tAccounts AC, \n\tCustomer C, \n\tItem I,\n\t(SELECT \n\t\tC.AreaCode,\n\t\tST.SaleTypeCode,\n\t\tC.CustCode,\n\t\tA.Active,\t\n\t\tI.ICode,\n\t\tSaleValue = 0\n\tFROM Customer C, Accounts A, Item I, SaleType ST\n\tWHERE \tC.AreaCode IN (:ai_areacode) AND \n\t\tC.CustCode = A.AccCode AND \n\t\tST.SaleTypeCode IN (:ai_SaleTypeCode) AND\n\t\tI.ICode IN (:ai_icode)\n\tUNION ALL\n\tSELECT \n\t\tC.AreaCode,\n\t\tST.SaleTypeCode,\n\t\tC.CustCode,\n\t\tA.Active,\n\t\tI.ICode,\n\t\tSaleValue = SUM(D.LooseQty)\n\tFROM Customer C, Accounts A, SaleLedger S, SaleDetail D, Item I, SaleType ST\n\tWHERE S.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.CustCode = C.CustCode AND\n\t\tC.CustCode = A.AccCode AND\n\t\tC.AreaCode IN (:ai_areacode) AND\n\t\tST.SaleTypeCode IN (:ai_SaleTypeCode) AND\n\t\tS.SaleTypeCode = ST.SaleTypeCode AND\n\t\tS.SaleInvCode = D.SaleInvCode AND\n\t\tD.ICode = I.ICode AND\n\t\tI.ICode IN (:ai_icode)\n\tGROUP BY \n\t\tC.AreaCode,\n\t\tST.SaleTypeCode,\n\t\tC.CustCode,\n\t\tA.Active,\n\t\tI.ICode\n\tUNION ALL\n\tSELECT \n\t\tC.AreaCode,\n\t\tST.SaleTypeCode,\n\t\tC.CustCode,\n\t\tA.Active,\n\t\tI.ICode,\n\t\tSaleValue = SUM(D.LooseQty)\n\tFROM Customer C, Accounts A, SaleLedger S, SaleInvDetail D, Item I, SaleType ST\n\tWHERE S.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.CustCode = C.CustCode AND\n\t\tC.CustCode = A.AccCode AND\n\t\tC.AreaCode IN (:ai_areacode) AND\n\t\tST.SaleTypeCode IN (:ai_SaleTypeCode) AND\n\t\tS.SaleTypeCode = ST.SaleTypeCode AND\n\t\tS.SaleInvCode = D.SaleInvCode AND\n\t\tD.ICode = I.ICode AND\n\t\tI.ICode IN (:ai_icode)\n\tGROUP BY \n\t\tC.AreaCode,\n\t\tST.SaleTypeCode,\n\t\tC.CustCode,\n\t\tA.Active,\n\t\tI.ICode\n\tUNION ALL\n\tSELECT \n\t\tC.AreaCode,\n\t\tSaleTypeCode=NULL,\n\t\tC.CustCode,\n\t\tA.Active,\n\t\tI.ICode,\n\t\tSaleValue = - SUM(D.LooseQty)\n\tFROM Customer C, Accounts A, SRLedger S, SRDetail D, Item I\n\tWHERE S.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.CustCode = C.CustCode AND\n\t\tC.CustCode = A.AccCode AND\n\t\tC.AreaCode IN (:ai_areacode) AND\n\t\tS.SRInvCode = D.SRInvCode AND\n\t\tD.ICode = I.ICode AND\n\t\tI.ICode IN (:ai_icode)\n\tGROUP BY \n\t\tC.AreaCode,\n\t\tC.CustCode,\n\t\tA.Active,\n\t\tI.ICode) SL\nWHERE \n\tSL.CustCode = C.CustCode AND \n\tC.CustCode = AC.AccCode AND \n\tAC.Active = CASE :as_active WHEN 'B' THEN AC.Active ELSE :as_active END AND\n\tC.AreaCode = A.AreaCode AND\n\tSL.ICode = I.ICode\nGROUP BY \n\tA.Name,\n\tAC.AliasName,\n\tAC.Name,\n\tI.Name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_areacode",
      "numberlist"
