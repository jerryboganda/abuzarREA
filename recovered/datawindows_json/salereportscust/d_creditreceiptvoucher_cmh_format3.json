  "retrieve": "SELECT  \n\t\t itemname = item.name,\n\t\t packing = dbo.item.packingdesc,\n\t\t manufacurer = (dbo.manufacturer.name),\n\t\t looseqty = Sum (dbo.saledetail.looseqty),\n\t\t price = max(dbo.saledetail.saleprice),\n\t\t id = max(dbo.saledetail.rowid), \n\t\t utn = max(dbo.saledetail.saleutn),\n\t\t saledetail = ISNULL(DBO.fn_GetSaleQtyListForAnItem(Item.ICode, :as_custcode, :ad_StartDate, :ad_EndDate), '')\nFROM \t dbo.saleledger, \n\t\t dbo.saledetail,    \n\t\t dbo.item, \n\t\t dbo.Customer,\n\t\t dbo.Accounts,\n\t\t dbo.Manufacturer \nWHERE \n\t\t( case lower(:as_doctype)  when 'originaldate' then SaleLedger.originaldate \n\t\t\t\t\t\t\t\twhen 'billingdate' then SaleLedger.billingdate\n\t\t\t\t\t\t\t\twhen 'lastsavingdate' then SaleLedger.date end)\n\t\tbetween :ad_StartDate  and :ad_EndDate and\n\t\t\n\t\t dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t\t dbo.saledetail.icode = item.icode AND\n\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t dbo.customer.custcode = dbo.accounts.acccode AND\n\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\t\tdbo.saledetail.icode,\n\t\tdbo.item.icode,\n\t\tdbo.item.name,\n\t\tdbo.item.packingdesc,\n\t\tdbo.manufacturer.name\nUNION ALL\nSELECT \n\t\t itemname = item.name,\n\t\t packing = dbo.item.packingdesc,\n\t\t manufacurer = (dbo.manufacturer.name),\n\t\t looseqty = Sum (sd.looseqty),\n\t\t price = max(sd.saleprice),\n\t\t id = max(sd.rowid), \n\t\t utn = max(sd.saleutn),\n\t\t sd = ISNULL(DBO.fn_GetSaleQtyListForAnItem(Item.ICode, :as_custcode, :ad_StartDate, :ad_EndDate), '')\nFROM \t dbo.saleledger, \n\t\t dbo.saleinvdetail sd,    \n\t\t dbo.item, \n\t\t dbo.Customer,\n\t\t dbo.Accounts,\n\t\t dbo.Manufacturer \nWHERE  \n\t\t ( case lower(:as_doctype) when 'originaldate' then SaleLedger.originaldate \n\t\t\t\t\t\t\t\twhen 'billingdate' then SaleLedger.billingdate\n\t\t\t\t\t\t\t\twhen 'lastsavingdate' then SaleLedger.date end)\n\t\tbetween :ad_StartDate  and :ad_EndDate and\n\t\t DBO.SaleLedger.impactinventory = 'N' AND\n\t\t  dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t dbo.saleledger.saleinvcode = sd.saleinvcode AND\n\t\t sd.icode = item.icode AND\n\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t dbo.customer.custcode = dbo.accounts.acccode AND\n\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\t\tsd.icode,\n\t\tdbo.item.icode,\n\t\tdbo.item.name,\n\t\tdbo.item.packingdesc,\n\t\tdbo.manufacturer.name\n",
