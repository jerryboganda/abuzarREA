  "retrieve": "SELECT invcode = dbo.saleledger.saleinvcode,\n\t\t customer = dbo.accounts.name,\n\t\t contactperson=(dbo.customer.cp), \n\t\t address = (dbo.customer.address1),\n\t\t city = (dbo.customer.city), \n\t\t formno = dbo.saleledger.custrefno,\n\t\t date = dbo.saleledger.originaldate,\n\t\t /*regno = dbo.patient.regno,*/\n\t\t patient = saleledger.remarks, \n\t\t disease = saleledger.custrefno ,\n       ward = saleledger.custrefno2,\n\t\t doctor = dbo.doctors.name,\n\t\t itemname = item.name,\n\t\t looseqty = dbo.saledetail.looseqty,\n\t\t issue=saledetail.looseqty,\n\t\t cost=saledetail.looseqty*saledetail.saleprice,\n \t\t cumulativesum = round(0.00,2),\n \t\t cumulativesumfoot = round(0.00,2)\nFROM \t\n\tdbo.saleledger\n\tLEFT OUTER JOIN dbo.doctors ON (dbo.saleledger.doctcode = dbo.doctors.doctcode),\n\tdbo.saledetail,    \n\tdbo.item, \n\tdbo.Customer,\n\t/*dbo.Patient,*/\n\tdbo.Accounts\n\nWHERE  dbo.saleledger.originaldate >= :ad_startdate AND\n\t\t dbo.saleledger.originaldate <= :ad_enddate  AND \n\t\t dbo.saleledger.custcode  IN ( :al_custcode ) AND\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t\t dbo.saledetail.icode = item.icode AND\n\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t dbo.customer.custcode = dbo.accounts.acccode/* AND\n\t\t dbo.saleledger.patientcode = dbo.patient.patientcode*/\n\nUNION ALL\n\nSELECT invcode = dbo.saleledger.saleinvcode,\n\t\t customer = dbo.accounts.name,\n\t\t contactperson=(dbo.customer.cp), \n\t\t address = (dbo.customer.address1),\n\t\t city = (dbo.customer.city), \n\t\t formno = dbo.saleledger.custrefno,\n\t\t date = dbo.saleledger.originaldate,\n\t\t/* regno = dbo.patient.regno,*/\n\t\t patient = saleledger.remarks,\n\t\t disease = saleledger.custrefno ,\n       ward = saleledger.custrefno2,\n\t\t doctor = dbo.doctors.name,\n\t\t itemname = item.name,\n\t\t looseqty = sd.looseqty,\n\t\tissue=sd.looseqty,\n\t\t cost=sd.looseqty*sd.saleprice,\n \t\t cumulativesum = round(0.00,2),\n \t\t cumulativesumfoot = round(0.00,2)\nFROM \t \n\tdbo.saleledger\n\tLEFT OUTER JOIN dbo.doctors ON (dbo.saleledger.doctcode = dbo.doctors.doctcode),\n\tdbo.saleinvdetail sd, \n\tdbo.item, \n\tdbo.Customer,\n\t/*dbo.Patient,*/\n\tdbo.Accounts\n\nWHERE  DBO.SaleLedger.impactinventory = 'N' AND\n\t\t dbo.saleledger.originaldate >= :ad_startdate AND\n\t\t dbo.saleledger.originaldate <= :ad_enddate  AND \n\t\t dbo.saleledger.custcode  IN ( :al_custcode ) AND\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t dbo.saleledger.saleinvcode = sd.saleinvcode AND\n\t\t sd.icode = item.icode AND\n\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t dbo.customer.custcode = dbo.accounts.acccode /*AND\n\t\t dbo.saleledger.patientcode = dbo.patient.patientcode*/\n",
