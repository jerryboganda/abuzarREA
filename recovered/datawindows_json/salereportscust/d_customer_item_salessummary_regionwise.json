  "retrieve": "SELECT \n\tSalesMan=(SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode=C.SalesManCode),\n\tCustomerAlias=C.AliasName,\n\tCustomerName=C.Customer,\n\tRegion = C.Region, \n\tArea = C.Area,\n\tItemAlias=I.CustomICode,\n\tItemName=I.ItemName,\n\tItemCategory=I.ItemCategory,\n\tItemClass=I.ItemClass,\n\tQty=SUM(CASE ST.SaleType WHEN 'S' THEN ST.Qty ELSE - ST.Qty END),\n\tBonus=SUM(CASE ST.SaleType WHEN 'S' THEN ST.Bonus ELSE - ST.Bonus END),\n\tSaleVolume=SUM(CASE ST.SaleType WHEN 'S' THEN (ST.Qty + ST.Bonus) ELSE - (ST.Qty + ST.Bonus ) END * I.AreaVolume),\n\tGrossSale = SUM(CASE ST.SaleType WHEN 'S' THEN ST.Gross ELSE - ST.Gross END),\n\tDiscount = SUM(CASE ST.SaleType WHEN 'S' THEN ST.Discount ELSE - ST.Discount END),\n\tDiscountedSale = SUM(CASE ST.SaleType WHEN 'S' THEN (ST.Gross - ST.Discount) ELSE - (ST.Gross - ST.Discount) END)\nFROM \n\t(SELECT \n\t\tSaleType='S',\n\t\tC.CustCode,\n\t\tI.ICode,\n\t\tQty=0.0000,\n\t\tBonus=0.0000,\n\t\tGross = 0.0000,\n\t\tDiscount = 0.0000\n\tFROM \n\t\tCustomer C, Item I\n\tWHERE\n\t\tI.ICode IN (:ai_icode) AND\n\t\tC.CustCode IN (:ai_custcode)\n\tGROUP BY\n\t\tC.CustCode,\n\t\tI.ICode\n\tUNION ALL\n\tSELECT \n\t\tSaleType='S',\n\t\tS.CustCode,\n\t\tSD.ICode,\n\t\tQty=SUM(SD.LooseQty),\n\t\tBonus=SUM(SD.BonusQty),\n\t\tGross = SUM(SD.SalePrice * (SD.LooseQty + SD.BonusQty)),\n\t\tDiscount = SUM(\n\t\t(SD.ItemFlatDisc * SD.LooseQty) + \n\t\t((SD.SalePrice - SD.ItemFlatDisc) * SD.LooseQty * SD.DiscPerc * 0.01) + \n\t\t((SD.SalePrice - SD.ItemFlatDisc) * SD.LooseQty * (1 - SD.DiscPerc * 0.01) * S.DiscPerc * 0.01))\n\tFROM \n\t\tSaleLedger S, SaleDetail SD\n\tWHERE\n\t\tS.SaleInvCode=SD.SaleInvCode AND\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSD.ICode IN (:ai_icode) AND\n\t\tS.CustCode IN (:ai_custcode)\n\tGROUP BY\n\t\tS.CustCode,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT \n\t\tSaleType='R',\n\t\tS.CustCode,\n\t\tSD.ICode,\n\t\tQty=SUM(SD.LooseQty),\n\t\tBonus=SUM(SD.BonusQty),\n\t\tGross = SUM(SD.SalePrice * (SD.LooseQty + SD.BonusQty)),\n\t\tDiscount = SUM(\n\t\t(SD.SRPrice * SD.LooseQty * SD.DiscPerc * 0.01) + \n\t\t(SD.SRPrice * SD.LooseQty * (1 - SD.DiscPerc * 0.01) * S.DiscPerc * 0.01))\n\tFROM \n\t\tSRLedger S, SRDetail SD\n\tWHERE\n\t\tS.SRInvCode=SD.SRInvCode AND\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSD.ICode IN (:ai_icode) AND\n\t\tS.CustCode IN (:ai_custcode)\n\tGROUP BY\n\t\tS.CustCode,\n\t\tSD.ICode) AS ST \n\t\t\tRIGHT OUTER JOIN \n\t\t\t\t(SELECT \n\t\t\t\t\tIT.ICode, IT.CustomICode, ItemName=IT.Name, IT.AreaVolume, IT.ICatCode, IT.ICCode,\n\t\t\t\t\tItemCategory=(SELECT C.Name FROM ItemCategory C WHERE C.ICatCode = IT.ICatCode),\n\t\t\t\t\tItemClass=(SELECT C.Name FROM ItemClass C WHERE C.ICCode = IT.ICCode)\n\t\t\t\tFROM \n\t\t\t\t\tItem IT \n\t\t\t\tWHERE IT.ICode IN (:ai_icode)) AS I ON (ST.ICode = I.ICode)\n\t\t\tRIGHT OUTER JOIN \n\t\t\t\t(SELECT \n\t\t\t\t\tCu.SalesManCode, Cu.CustCode, A.AliasName, Customer=A.Name, Region=R.Name, Area=AR.Name\n\t\t\t\tFROM \n\t\t\t\t\tCustomer Cu, Area AR, Region R, Accounts A\n\t\t\t\tWHERE \n\t\t\t\t\tCu.CustCode IN (:ai_custcode) AND\n\t\t\t\t\tCu.CustCode = A.AccCode AND\n\t\t\t\t\tCu.AreaCode = AR.AreaCode AND\n\t\t\t\t\tAR.RegionCode = R.RegionCode) AS C ON (ST.CustCode = C.CustCode)\nGROUP BY\n\tC.SalesManCode,\n\tC.AliasName,\n\tC.Customer,\n\tC.Region,\n\tC.Area,\n\tI.CustomICode,\n\tI.ItemName,\n\tI.ICatCode,\n\tI.ICCode,\n\tItemCategory,\n\tItemClass",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_icode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_custcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "customername A, itemname A"
 },
