  "retrieve": "  SELECT invcode = dbo.saleledger.saleinvcode, \n         date        = dbo.saleledger.date, \n         flatdisc    = dbo.saleledger.flatdisc, \n\t\t\tsalestax    = dbo.saleledger.salestax,\n\t\t\trelation\t\t= (select name from relation where relation.relationcode=max(saleledger.relationcode)), \n         misccharges = dbo.saleledger.misccharges, \n\t\t\tinvdiscperc = dbo.saleledger.discperc, \n\t\t\tinvgstperc1 = dbo.saleledger.invgstperc1,\n\t\t\trefno=dbo.saleledger.custrefno,\n\t\t\trefno2=max(dbo.saleledger.custrefno2),\n\t\t\tremarks=dbo.saleledger.remarks,\n\t\t\tdoctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, \n         dbo.accounts.name, \n\t\t\tdbo.customer.cp,\n\t\t\tdbo.customer.address1,\n\t\t\tdbo.customer.address2,\n\t\t\tdbo.customer.city,\n\t\t\tinvtotal= /*-------gross------*/\n\t\t\tRound(\n\t\t\tSUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) *\n\t\t\t(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) + \n\t\t\tsaleledger.misccharges + saleledger.salestax - saleledger.flatdisc, 0)\n\t\t\t+ /*-----sales tax-------*/\n\t\t\tRound(\n\t\t\tSUM( (saledetail.looseqty + saledetail.bonusqty) * saledetail.unitsalestax) + \n\t\t\tSUM(ROUND( (saledetail.looseqty * \n\t\t\t(saledetail.saleprice - saledetail.itemflatdisc)) *\n\t\t\t(1 - (.01 * saledetail.discperc)) * saledetail.gstperc * .01, 2)) +\n\t\t\tROUND( (SUM((saledetail.looseqty * \n\t\t\t(saledetail.saleprice - saledetail.itemflatdisc)) *\n\t\t\t(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) -\n\t\t\tsaleledger.flatdisc) * (saleledger.invgstperc1 * .01), 2), 0)/*,\n\n\n\t\t\tregno = (Select dbo.patient.regno From dbo.Patient Where dbo.saleledger.patientcode = dbo.patient.patientcode ),\n\t\t\tpatientname = (Select dbo.patient.name From dbo.Patient Where dbo.saleledger.patientcode = dbo.patient.patientcode ),\n\t\t\tdesignation = (Select dbo.rank.name From dbo.Patient, dbo.Rank Where dbo.saleledger.patientcode = dbo.patient.patientcode AND dbo.patient.rankcode = dbo.rank.rankcode),\n         department = (Select dbo.unit.name From dbo.Patient, dbo.Unit Where dbo.saleledger.patientcode = dbo.patient.patientcode AND dbo.patient.unitcode = dbo.unit.unitcode)\n\t\t\t*/\n    FROM dbo.saleledger, \n         dbo.saledetail,   \n         dbo.accounts, \n\t\t\tdbo.customer\t\n\n   WHERE dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  \n\t\t\tdbo.saleledger.date Between :ad_StartDate and :ad_EndDate and\n\t\t\tdbo.saleledger.salecatcode IN (1, 2, 3) and\n\t\t\tdbo.saleledger.custcode  = :al_CustCode and \n         dbo.saleledger.custcode = dbo.accounts.acccode and\t\n         dbo.customer.custcode = dbo.saleledger.custcode \n\n\nGROUP BY dbo.saleledger.saleinvcode,   \n\t\t\tdbo.saleledger.date,   \n\t\t\tdbo.saleledger.misccharges,   \n         dbo.saleledger.flatdisc,   \n         dbo.saleledger.discperc,  \n\t\t\tdbo.saleledger.salestax, \n\t\t\tdbo.saleledger.invgstperc1,\n\t\t\tdbo.saleledger.salecatcode, \n\t\t\tdbo.saleledger.patientcode,\n\t\t\tdbo.saleledger.custrefno,\t \n\t\t\tdbo.saleledger.remarks,\n\t\t\tdbo.accounts.name,\t\n\t\t\tdbo.customer.cp,\n\t\t\tdbo.customer.address1,\n\t\t\tdbo.customer.address2,\n\t\t\tdbo.customer.city\nUNION ALL\n  SELECT invcode     = dbo.saleledger.saleinvcode, \n         date        = dbo.saleledger.date, \n         flatdisc    = dbo.saleledger.flatdisc, \n\t\t\tsalestax    = dbo.saleledger.salestax,\n\t\t\trelation\t\t= (select name from relation where relation.relationcode=max(saleledger.relationcode)), \n         misccharges = dbo.saleledger.misccharges, \n\t\t\tinvdiscperc = dbo.saleledger.discperc, \n\t\t\tinvgstperc1 = dbo.saleledger.invgstperc1,\n\t\t\trefno=dbo.saleledger.custrefno,\n\t\t\trefno2=max(dbo.saleledger.custrefno2),\n\t\t\tremarks=dbo.saleledger.remarks,\n\t\t\tdoctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, \n         dbo.accounts.name, \n\t\t\tdbo.customer.cp,\n\t\t\tdbo.customer.address1,\n\t\t\tdbo.customer.address2,\n\t\t\tdbo.customer.city,\n\t\t\tinvtotal= /*-------gross------*/\n\t\t\tRound(\n\t\t\tSUM((sd.looseqty*(sd.saleprice - sd.itemflatdisc)) *\n\t\t\t(1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) + \n\t\t\tsaleledger.misccharges + saleledger.salestax - saleledger.flatdisc, 0)\n\t\t\t+ /*-----sales tax-------*/\n\t\t\tRound(\n\t\t\tSUM( (sd.looseqty + sd.bonusqty) * sd.unitsalestax) + \n\t\t\tSUM(ROUND( (sd.looseqty * \n\t\t\t(sd.saleprice - sd.itemflatdisc)) *\n\t\t\t(1 - (.01 * sd.discperc)) * sd.gstperc * .01, 2)) +\n\t\t\tROUND( (SUM((sd.looseqty * \n\t\t\t(sd.saleprice - sd.itemflatdisc)) *\n\t\t\t(1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) -\n\t\t\tsaleledger.flatdisc) * (saleledger.invgstperc1 * .01), 2), 0)/*,\n\n\n\t\t\tregno = (Select dbo.patient.regno From dbo.Patient Where dbo.saleledger.patientcode = dbo.patient.patientcode ),\n\t\t\tpatientname = (Select dbo.patient.name From dbo.Patient Where dbo.saleledger.patientcode = dbo.patient.patientcode ),\n\t\t\tdesignation = (Select dbo.rank.name From dbo.Patient, dbo.Rank Where dbo.saleledger.patientcode = dbo.patient.patientcode AND dbo.patient.rankcode = dbo.rank.rankcode),\n         department = (Select dbo.unit.name From dbo.Patient, dbo.Unit Where dbo.saleledger.patientcode = dbo.patient.patientcode AND dbo.patient.unitcode = dbo.unit.unitcode)\n\t\t\t*/\n    FROM dbo.saleledger, \n         dbo.saleinvdetail sd,   \n         dbo.accounts, \n\t\t\tdbo.customer\t\n\n   WHERE DBO.SaleLedger.impactinventory = 'N' AND \n\t\t\tdbo.saleledger.saleinvcode = sd.saleinvcode and  \n\t\t\tdbo.saleledger.date Between :ad_StartDate and :ad_EndDate and\n\t\t\tdbo.saleledger.salecatcode IN (1, 2, 3) and\n\t\t\tdbo.saleledger.custcode  = :al_CustCode and \n         dbo.saleledger.custcode = dbo.accounts.acccode and\t\n         dbo.customer.custcode = dbo.saleledger.custcode \n\n\nGROUP BY dbo.saleledger.saleinvcode,   \n\t\t\tdbo.saleledger.date,   \n\t\t\tdbo.saleledger.misccharges,   \n         dbo.saleledger.flatdisc,   \n         dbo.saleledger.discperc,  \n\t\t\tdbo.saleledger.salestax, \n\t\t\tdbo.saleledger.invgstperc1,\n\t\t\tdbo.saleledger.salecatcode, \n\t\t\tdbo.saleledger.patientcode,\n\t\t\tdbo.saleledger.custrefno,\t \n\t\t\tdbo.saleledger.remarks,\n\t\t\tdbo.accounts.name,\t\n\t\t\tdbo.customer.cp,\n\t\t\tdbo.customer.address1,\n\t\t\tdbo.customer.address2,\n\t\t\tdbo.customer.city         \n\nORDER BY dbo.saleledger.saleinvcode ASC,   \n         dbo.saleledger.date ASC   \n\n",
  "arguments": {
