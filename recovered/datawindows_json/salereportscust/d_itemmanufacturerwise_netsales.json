  "retrieve": "SELECT\n\tI.ManfCode,\n\tManufacturer=M.Name,\n\tI.ICode, \n\tItemName=I.Name,\n\tPackUnits=I.PackUnits,\n\tCurrentSalePrice = CASE When Sum(D.SaleQty) > 0 Then Max(I.SalePrice) Else 0 End,\n\tCurrentPurPrice = CASE When Sum(D.SaleQty) > 0 Then Max(I.PurPrice) Else 0 End,\n\tQty=ISNULL(sum(D.saleqty),0),\n\tGrossSales = ISNULL(sum(D.GrossSales), 0),\n\tSaleAmount=ISNULL(sum(D.salevalue), 0),\n\tItemCost=ISNULL(sum(D.itemcost), 0),\n\tMargin=ISNULL((sum(D.salevalue) - sum(D.itemcost) ) / \n\t\t\tCase sum(D.salevalue) WHEN 0 THEN 1 ELSE sum(D.salevalue) END, 0) * 100,\n\tExpectedMargin=ISNULL((sum(D.GrossSales) - sum(D.itemcost) ) / \n\t\t\tCase sum(D.GrossSales) WHEN 0 THEN 1 ELSE sum(D.GrossSales) END, 0) * 100,\n\tDiscMargin=ISNULL((sum(D.GrossSales) - sum(D.salevalue) ) / \n\t\t\tCase sum(D.GrossSales) WHEN 0 THEN 1 ELSE sum(D.GrossSales) END, 0) * 100,\n\tBonus=ISNULL(sum(D.bonus),0)\nFROM\n\tManufacturer M,\n\tItem I LEFT OUTER JOIN \n\t(SELECT saleqty=ISNULL(sum(SD.looseqty),0) ,\n\t\t\t\tbonus=ISNULL(sum(SD.bonusqty),0) ,\n\t\t\t\tGrossSales = IsNull( Sum ( SD.Rate * SD.looseqty) , 0 ),\n\t\t\t\tsalevalue=ISNULL(round(sum((SD.looseqty * (SD.saleprice - itemflatdisc)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01),2),0),\n\t        \tI.ICode,\n\t        \titemcost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)),2),0)\n\tFROM\t\tsaleledger SL,\n\t\t\t\tsaledetail SD,\n\t\t\t\titem I\n\tWHERE\t\tSD.icode=I.icode AND\n\t\t\t\tI.manfcode IN (:ala_manfcode) AND\n\t\t\t\tSD.saleinvcode=SL.saleinvcode AND\n\t\t\t\tSL.salecatcode IN (:aa_salecatcode) and\n\t\t\t\tSL.date BETWEEN :adt_sdate AND :adt_ldate\n\tGROUP BY \n\t         SD.icode,\n\t\t \t\tI.ICode,\n\t         SL.saleinvcode,\n\t         SL.discperc\n\tUNION ALL\n\tSELECT saleqty=ISNULL(sum(SD.looseqty),0) ,\n\t\t\t\tbonus=ISNULL(sum(SD.bonusqty),0) ,\n\t\t\t\tGrossSales = IsNull( Sum ( SD.Rate * SD.looseqty) , 0 ),\n\t\t\t\tsalevalue=ISNULL(round(sum((SD.looseqty * (SD.saleprice - itemflatdisc)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01),2),0),\n\t        \tI.ICode,\n\t        \titemcost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)),2),0)\n\tFROM\t\tsaleledger SL,\n\t\t\t\tsaleinvdetail SD,\n\t\t\t\titem I\n\tWHERE\t\tSL.ImpactInventory ='N' AND \n\t\t\t\tSD.icode=I.icode AND\n\t\t\t\tI.manfcode IN (:ala_manfcode) AND\n\t\t\t\tSD.saleinvcode=SL.saleinvcode AND\n\t\t\t\tSL.salecatcode IN (:aa_salecatcode) and\n\t\t\t\tSL.date BETWEEN :adt_sdate AND :adt_ldate\n\tGROUP BY \n\t         SD.icode,\n\t\t \t\tI.ICode,\n\t         SL.saleinvcode,\n\t         SL.discperc\n\tUNION ALL\n\tSELECT\tsaleqty=-ISNULL(sum(SD.looseqty),0) ,\n\t\t\t\tbonus=-ISNULL(sum(SD.bonusqty),0) ,\n\t\t\t\tGrossSales = -1 * ( IsNull ( Sum ( SD.SalePrice * SD.LooseQty) , 0 )  ),\n\t\t\t\tsalevalue=-ISNULL(round(sum((SD.looseqty * (SD.srprice)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01),2),0),\n\t\t\t\tI.ICode,\n\t\t\t\titemcost=-ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)),2),0)\n\tFROM\t\tsrledger SL,\n\t\t\t\tsrdetail SD,\n\t\t\t\titem I\n\tWHERE\t\tSD.icode=I.icode AND\n\t\t\t\tI.manfcode IN (:ala_manfcode) AND\n\t\t\t\tSD.srinvcode=SL.srinvcode AND\n\t\t\t\tSL.srcatcode IN (:aa_srcatcode) AND\n\t\t\t\tSL.date BETWEEN :adt_sdate AND :adt_ldate\n\tGROUP BY\n\t\t\t\tSD.icode,\n\t\t\t\tI.ICode,\n\t\t\t\tSL.srinvcode,\n\t\t\t\tSL.discperc) AS D ON (I.ICode = D.ICode)\n\tWHERE \n\t\t\tI.manfcode IN (:ala_manfcode) AND\n\t\t\tI.ManfCode = M.ManfCode\n\tGROUP BY\n\t\tI.ManfCode,\n\t\tM.Name,\n\t\tI.ICode,\n\t\tI.name,\n\t\tI.PackUnits\nORDER BY\n\tM.Name,\n\tI.name\n",
