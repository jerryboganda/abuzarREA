  ],
  "retrieve": "select \n\tB.date, \n\tB.type,\n\tB.custcode,\n\tCUSTOMERNAME=(select name from accounts where acccode=B.custcode),\n\tcustaliasname=(select aliasname from accounts where acccode=B.custcode),\n\tarea=(select name from area,customer where  customer.custcode=B.custcode and Customer.areacode=area.areacode)\n\nfrom (\t\n\n\tSELECT A.DATE,\n\t\tA.CUSTCODE,\n\t\tA.TYPE\n\tFROM customer C,\n\t\t\t(select  distinct(custcode),\n\t\t\t\ttype='S-'+ convert(varchar(12),saleinvcode),\n\t\t\t\tdate=date\n\t\t\tfrom saleledger\n\t\t\twhere date<:ad_StartDate\n\t\t\tunion all\n\t\t\tselect  distinct(custcode),\n\t\t\t\ttype='SR-'+ convert(varchar(12),srinvcode),\n\t\t\t\tdate=date\n\t\t\tfrom srledger\n\t\t\twhere date<:ad_StartDate \n\n\t\t\t) AS A\n\n\n\tWHERE A.custcode NOT IN\n\n\t\t\t\t(\n\n\t\t\t\t\tselect  distinct(custcode)\n\t\t\t\t\tfrom saleledger\n\t\t\t\t\twhere date>=:ad_StartDate and\n\t\t\t\t\t\tdate<=:ad_EndDate\n\t\t\t\t\tunion all\n\t\t\t\t\tselect  distinct(custcode)\n\t\t\t\t\tfrom srledger\n\t\t\t\t\twhere date>=:ad_StartDate and\n\t\t\t\t\t\tdate<=:ad_EndDate\n\n\t\t\t\t\t) AND\n\n \t\tA.custcode=C.custcode AND\n     \t\tC.areacode IN (:aa_areacode)\n\n\n\t) AS B\n\n\n\n\n\n\n\n\n\nwhere B. date IN (select max(K.date) from  (\n\t\t\t\t\t   SELECT A.DATE,\n\t\t\t\t\t\tA.CUSTCODE,\n\t\t\t\t\t\tA.TYPE\n\t\t\t\t\t   FROM customer C,\n\t\t\t\t\t\t\t(select  distinct(custcode),\n\t\t\t\t\t\t\t\t\ttype='S-'+ convert(varchar(12),saleinvcode),\n\t\t\t\t\t\t\t\t\tdate=date\n\t\t\t\t\t\t\tfrom saleledger\n\t\t\t\t\t\t\twhere date<:ad_StartDate\n\t\t\t\t\t\t\tunion all\n\t\t\t\t\t\t\tselect  distinct(custcode),\n\t\t\t\t\t\t\t\ttype='SR-'+ convert(varchar(12),saleinvcode),\n\t\t\t\t\t\t\t\tdate=date\n\t\t\t\t\t\t\tfrom srledger\n\t\t\t\t\t\t\twhere date<:ad_StartDate \n\n\t\t\t\t\t\t\t) AS A\n\n\n\t\t\t\t\tWHERE A.custcode NOT IN\n\n\t\t\t\t\t\t\t\t(\n\n\t\t\t\t\t\t\t\tselect  distinct(custcode)\n\t\n\t\t\t\t\t\t\t\tfrom saleledger\n\t\t\t\t\t\t\t\twhere date>=:ad_StartDate and\n\t\t\t\t\t\t\t\t\tdate<=:ad_EndDate\n\t\t\t\t\t\t\t\tunion all\n\t\t\t\t\t\t\t\tselect  distinct(custcode)\n\t\t\t\t\t\t\t\tfrom srledger\n\t\t\t\t\t\t\t\twhere date>=:ad_StartDate and\n\t\t\t\t\t\t\t\tdate<=:ad_EndDate\n\n\t\t\t\t\t\t\t)\n\n\t\t\t\t\t\tAND A.custcode=C.custcode AND\n    \t\t\t\t\t \t    C.areacode IN (:aa_areacode)\n\n\t\t\t\t\t\t) AS K\n\t\t\t\tGROUP BY K.custcode\n\t\t\t)\nORDER BY \n\tarea,\n\tcustomername\n",
