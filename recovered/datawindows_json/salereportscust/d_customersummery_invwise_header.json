  "retrieve": "  SELECT invcode     = dbo.saleledger.saleinvcode,    \n         date        = dbo.saleledger.date,    \n         flatdisc    = dbo.saleledger.flatdisc, \n\t\t\tsalestax    = dbo.saleledger.salestax,       \n         misccharges = dbo.saleledger.misccharges, \n\t\t\tinvdiscperc = dbo.saleledger.discperc,  \n\t\t\tinvgstperc1 = dbo.saleledger.invgstperc1, \n\t\t\tdoctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, \n         dbo.accounts.name, \n         amount =  Round(Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice), 2),    \n\t\t\titemdiscpercvalue = Round(Sum (( dbo.saledetail.looseqty  * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01)) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc)), 2),    \n    \t\tinvdiscpercvalue =Sum (Round( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01)),2)) * (dbo.saleledger.discperc /100), \n\t\t\tsalesman = dbo.users.username ,\n\t\t\ttotaldiscount= dbo.saleledger.flatdisc + Round(Sum (( dbo.saledetail.looseqty  * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01)) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc)), 2)  + Round(Sum ( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01))) * (dbo.saleledger.discperc /100), 2),\n\t\t\trealamount=sum(Round(saledetail.packprice/ISNULL(saledetail.packunits ,1),2) * saledetail.looseqty) , \n\t\t\titemsalestax = Sum (Round (dbo.saledetail.looseqty * dbo.saledetail.unitsalestax + Round ( Round (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc ) * (1 - dbo.saledetail.discperc * 0.01 ), 2 ) * dbo.saledetail.gstperc * 0.01 , 2 ) , 2 ) )\n\n    FROM dbo.saleledger, \n         dbo.saledetail,   \n         dbo.accounts,\n\t\t\tdbo.users  \n\n   WHERE ( dbo.saleledger.headerno=:ai_headerno)and\n\t\t\t( dbo.saleledger.headerinvno between :ar_StartInv and :ar_EndInv)and\n\t\t\t\n\t\t\t( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and  \n         ( dbo.saleledger.custcode = dbo.accounts.acccode )and  \n\t\t\t( dbo.saleledger.salesmancode = dbo.users.usercode )  \n     \t               \n\nGROUP BY dbo.saleledger.misccharges,   \n         dbo.saleledger.flatdisc,   \n         dbo.saleledger.date,   \n         dbo.saleledger.saleinvcode,   \n\t\t\tdbo.saleledger.discperc,  \n\t\t\tdbo.saleledger.invgstperc1, \n\t\t\tdbo.saleledger.salestax, \n\t\t\tdbo.saleledger.salecatcode, \n\t\t\tdbo.accounts.name,\n\t\t\tdbo.users.username \nUNION ALL\n  SELECT invcode     = dbo.saleledger.saleinvcode,    \n         date        = dbo.saleledger.date,    \n         flatdisc    = dbo.saleledger.flatdisc, \n\t\t\tsalestax    = dbo.saleledger.salestax,       \n         misccharges = dbo.saleledger.misccharges, \n\t\t\tinvdiscperc = dbo.saleledger.discperc, \n\t\t\tinvgstperc1 = dbo.saleledger.invgstperc1, \n\t\t\tdoctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, \n         dbo.accounts.name, \n         amount =  Round(Sum ( sd.looseqty * sd.saleprice), 2),    \n\t\t\titemdiscpercvalue = Round(Sum (( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc)), 2),    \n    \t\tinvdiscpercvalue =Sum (Round( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01)),2)) * (dbo.saleledger.discperc /100), \n\t\t\tsalesman = dbo.users.username ,\n\t\t\ttotaldiscount= dbo.saleledger.flatdisc + Round(Sum (( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc)), 2)  + Round(Sum ( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01))) * (dbo.saleledger.discperc /100), 2),\n\t\t\trealamount=sum(Round(sd.packprice/ISNULL(sd.packunits ,1),2) * sd.looseqty) , \n\t\t\titemsalestax = Sum (Round (sd.looseqty * sd.unitsalestax + Round ( Round (sd.looseqty * (sd.saleprice - sd.itemflatdisc ) * (1 - sd.discperc * 0.01 ), 2 ) * sd.gstperc * 0.01 , 2 ) , 2 ) )\n\n    FROM dbo.saleledger, \n         dbo.saleinvdetail sd,\n         dbo.accounts,\n\t\t\tdbo.users  \n\n   WHERE ( dbo.saleledger.impactinventory = 'N' ) AND\n\t\t\t( dbo.saleledger.headerno=:ai_headerno) and\n\t\t\t( dbo.saleledger.headerinvno between :ar_StartInv and :ar_EndInv) and\n\t\t\t( dbo.saleledger.saleinvcode = sd.saleinvcode ) and  \n         ( dbo.saleledger.custcode = dbo.accounts.acccode ) and  \n\t\t\t( dbo.saleledger.salesmancode = dbo.users.usercode )  \n     \t               \nGROUP BY dbo.saleledger.misccharges,   \n         dbo.saleledger.flatdisc,   \n         dbo.saleledger.date,   \n         dbo.saleledger.saleinvcode,   \n\t\t\tdbo.saleledger.discperc,  \n\t\t\tdbo.saleledger.invgstperc1, \n\t\t\tdbo.saleledger.salestax, \n\t\t\tdbo.saleledger.salecatcode, \n\t\t\tdbo.accounts.name,\n\t\t\tdbo.users.username \n         \nORDER BY dbo.accounts.name   \n\n",
