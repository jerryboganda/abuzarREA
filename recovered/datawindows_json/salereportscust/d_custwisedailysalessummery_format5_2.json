 "table": {
  "columns": [
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "customername",
    "dbname": "CustomerName"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "itemname",
    "dbname": "ItemName"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "qty",
    "dbname": "Qty"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "rate",
    "dbname": "Rate"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "discount",
    "dbname": "Discount"
   }
  ],
  "retrieve": "SELECT \n\tCustomerName = A.Name,\n\tItemName=I.Name,\n\tQty = SUM(D.LooseQty),\n\tRate = AVG(D.SalePrice),\n\tDiscount = SUM(D.Looseqty * D.ItemFlatDisc) +\n\t\tSUM(Round(D.Looseqty * (D.SalePrice - D.ItemFlatDisc) * (D.Discperc * 0.01), 2)) +\n\t\tSUM(Round(D.Looseqty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.Discperc * 0.01) * (S.DiscPerc * 0.01), 2))\nFROM\n\tSaleLedger S,\n\tSaleDetail D,\n\tAccounts A,\n\tItem I\nWHERE \n\tS.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\tS.SaleInvCode = D.SaleInvcode AND\n\tS.Custcode = :ai_custcode AND\n\tS.Custcode = A.Acccode AND\n\tD.ICode = I.ICode\nGROUP BY\n\tA.Name,\n\tI.Name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_EndDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_custcode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_discperc",
      "number"
     ]
    },
    {
     "_items": [
      "ai_withholdingtax",
      "number"
     ]
    }
   ]
  },
  "sort": "customername A, itemname A"
 },
