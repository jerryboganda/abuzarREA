    "name": "qty",
    "dbname": "qty"
   }
  ],
  "retrieve": "SELECT \n\tCustomer = A.Name,\n\tItemName = I.Name,\n\tDate = S.Date,\n\tQty = SUM(S.Qty),\n\tValue = SUM(S.Value)\nFROM\n\tAccounts A,\n\tItem I,\n\t(SELECT SD.ICode, \n\t\tSL.CustCode, \n\t\tDate = CAST(STR(DATEPART(mm, SL.Date)) +'-01-' +STR(DATEPART(yy, SL.Date)) AS DATETIME),\n\t\tQty = SUM(SD.LooseQty + SD.BonusQty), \n\t\tValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))\n\tFROM \n\t\tSaleLedger SL, SaleDetail SD\n\tWHERE\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.CustCode IN (:ai_custcode) AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\t(SD.ICode IN (:ai_icode) OR :ai_item_one_or_all=1)\n\tGROUP BY\n\t\tSD.ICode, SL.CustCode, SL.Date\n\tUNION ALL\n\tSELECT \n\t\tSD.ICode,\n\t\tSL.CustCode, \n\t\tDate = CAST(STR(DATEPART(mm, SL.Date)) +'-01-' +STR(DATEPART(yy, SL.Date)) AS DATETIME),\n\t\tQty = -SUM(SD.LooseQty + SD.BonusQty), \n\t\tValue = -SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))\n\tFROM \n\t\tSRLedger SL, SRDetail SD\n\tWHERE\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.CustCode IN (:ai_custcode) AND\n\t\tSL.SRInvCode = SD.SRInvCode AND\n\t\t(SD.ICode IN (:ai_icode) OR :ai_item_one_or_all=1)\n\tGROUP BY\n\t\tSD.ICode, SL.CustCode, SL.Date) S\nWHERE\n\tI.ICode = S.ICode AND\n\tA.AccCode = S.CustCode\nGROUP BY\n\tI.ICode,\n\tI.Name,\n\tA.AccCode,\n\tA.Name,\n\tS.Date\nORDER BY\n\tCustomer,\n\tItemName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_custcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_cust_one_or_all",
      "number"
     ]
    },
    {
     "_items": [
      "ai_icode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_item_one_or_all",
      "number"
     ]
    },
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "itemname A, customer A"
 },
