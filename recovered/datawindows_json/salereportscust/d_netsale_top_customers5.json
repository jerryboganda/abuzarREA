  "retrieve": "SELECT\n\tGroupCode=1,\n\tAliasName=(Select Ac.AliasName FROM accounts Ac Where Ac.Acccode = A.CustCode),\n\tcustomer=(Select Ac.Name FROM accounts Ac Where Ac.Acccode = A.CustCode),\n\tAddress=(Select RTRIM(LTRIM(C.Address1)) + ' ' + RTRIM(LTRIM(C.Address2)) FROM Customer C Where C.CustCode = A.CustCode),\n\tCity=(Select C.CITY FROM Customer C Where C.CustCode = A.CustCode),\n\tArea = (SELECT Area.Name FROM Area WHERE Area.AreaCode = A.AreaCode),\n\tAmount=Sum(A.amount),\n\tShow='N'\nFROM \n\t(SELECT\t\n\t\tSaleType='S',\n\t\tAreaCode=C.AreaCode,\n\t\tCustCode=C.CustCode,\n\t\tICode=I.ICode,\n\t\tGroupCode=\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END,   \n\t\tAmount = 0.00\n\tFROM \n\t\tdbo.Customer C, dbo.Item I\n\tWHERE\n\t\tC.AreaCode IN (:ai_AreaCode) and\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ai_groupcode)\n\tUNION ALL\n\tSELECT\t\n\t\tSaleType='S',\n\t\tAreaCode=C.AreaCode,\n\t\tCustCode=S.CustCode,\n\t\tICode=D.ICode,\n\t\tGroupCode=\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END,   \n\t\tAmount = Round(Sum ( D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) ), 2)\n\tFROM \n\t\tdbo.SaleLedger S, \n\t\tdbo.Customer C, \n\t \tdbo.SaleDetail D, \n\t \tdbo.Item I\n\tWHERE\n\t\tS.Date BETWEEN :ad_StartDate and :ad_EndDate  and\n\t\tS.CustCode = C.CustCode and\n\t\tC.AreaCode IN (:ai_AreaCode) and\n\t \tS.SaleInvCode = D.SaleInvCode and  \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ai_groupcode) and\n\t \tD.icode = I.icode \n\tGROUP BY\n\t\tS.CustCode,\n\t\tC.AreaCode,\n\t\tD.ICode,\n\t\tI.ManfCode,\n\t\tI.ICatCode,\n\t\tI.ICCode,\n\t\tI.PackCode\n\tUNION ALL\n\tSELECT\t\n\t\tSaleType='S',\n\t\tAreaCode=C.AreaCode,\n\t\tCustCode=S.CustCode,\n\t\tICode=D.ICode,\n\t\tGroupCode=\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END,   \n\t\tAmount = Round(Sum ( D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)), 2)\n\tFROM \n\t\tdbo.SaleLedger S, \n\t\tdbo.Customer C, \n\t \tdbo.SaleInvDetail D, \n\t \tdbo.Item I\n\tWHERE\n\t\tS.impactinventory = 'N' AND\n\t\tS.Date BETWEEN :ad_StartDate and :ad_EndDate  and\n\t\tS.CustCode = C.CustCode and\n\t\tC.AreaCode IN (:ai_AreaCode) and\n\t \tS.SaleInvCode = D.SaleInvCode and  \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ai_groupcode) and\n\t \tD.icode = I.icode \n\tGROUP BY\n\t\tS.CustCode,\n\t\tC.AreaCode,\n\t\tD.ICode,\n\t\tI.ManfCode,\n\t\tI.ICatCode,\n\t\tI.ICCode,\n\t\tI.PackCode\n\tUNION ALL\n\tSELECT\t\n\t\tSaleType='R',\n\t\tAreaCode=C.AreaCode,\n\t\tCustCode=S.CustCode,\n\t\tICode=D.ICode,\n\t\tGroupCode=\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END,   \n\t\tAmount = - Round(Sum ( D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) ), 2)\n\tFROM \n\t\tdbo.SRLedger S, \n\t\tdbo.Customer C, \n\t \tdbo.SRDetail D, \n\t \tdbo.Item I\n\tWHERE\n\t\tS.Date BETWEEN :ad_StartDate and :ad_EndDate  and\n\t\tS.CustCode = C.CustCode and\n\t\tC.AreaCode IN (:ai_AreaCode) and\n\t \tS.SRInvCode = D.SRInvCode and  \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ai_groupcode) and\n\t \tD.icode = I.icode \n\tGROUP BY\n\t\tS.CustCode,\n\t\tC.AreaCode,\n\t\tD.ICode,\n\t\tI.ManfCode,\n\t\tI.ICatCode,\n\t\tI.ICCode,\n\t\tI.PackCode) AS A\nGROUP BY  \n\tA.CustCode,\n\tA.AreaCode\nORDER BY\n\tAmount Desc,\n\tCustomer\n",
