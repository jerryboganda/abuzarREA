  "retrieve": "SELECT dbo.saleledger.saleinvcode,\n\t\t dbo.saleledger.custrefno,\n\t\t date =\tCASE lower(:as_datetype) \n\t\t\t\t\t \tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate\n\t\t\t \t\tEnd,\n\t\t/* itemname = CASE saledetail.claimable WHEN 'Y' THEN itempacking.name ELSE item.name END,*/\n\t\t itemname = Case When Max(saledetail.saleitemdescription) IS Null OR RTrim(LTrim(Max(saledetail.saleitemdescription))) = '' THEN item.name Else Max(saledetail.saleitemdescription) END,\n\t\t manufacurer = (dbo.manufacturer.name),\n\t\t looseqty = Sum(dbo.saledetail.looseqty),\n\t\t price = Max(dbo.saledetail.saleprice), \n\t\t rowid = max(dbo.saledetail.rowid),   \n \t\t cumulativesum = round(0.00,2),\n \t\t cumulativesumfoot = round(0.00,2) \nFROM \t dbo.saleledger, \n\t\t dbo.saledetail,    \n\t\t dbo.item, \n\t\t dbo.itempacking,\n\t\t dbo.Customer,\n\t\t dbo.Manufacturer \n\nWHERE  CASE lower(:as_datetype) \n\t\t \tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate\n  \t\t End Between :ad_startdate AND :ad_enddate AND\n\t\t dbo.saleledger.custcode IN (:al_custcode) AND\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t\t dbo.saledetail.icode = item.icode AND\n\t\t dbo.item.packcode = dbo.itempacking.packcode AND\n\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\n\nGroup by \n\t\tdbo.saleledger.saleinvcode,\n\t\tdbo.saleledger.custrefno,\n\t\tCASE lower(:as_datetype) \n\t\t \tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate\n  \t\tEnd ,\n\t\tdbo.item.name,\n\t\tdbo.manufacturer.name,\n\t\tdbo.itempacking.name,\n\t\tdbo.saledetail.claimable\n\norder by dbo.saleledger.saleinvcode , rowid\n",
