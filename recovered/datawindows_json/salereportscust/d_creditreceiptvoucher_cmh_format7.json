  "retrieve": "SELECT \n\titemname, \n\tpacking,\n\tmanufacurer,\n\tlooseqty = Sum (looseqty),\n\tprice = max(price), \n\tid = max(id), \n\tcumulativesum = round(0.00,2),\n\tcumulativesumfoot = round(0.00,2),\n\trowid=max(rowid)\nFROM\n\t(SELECT itemname = item.name, \n\t\t\t packing = dbo.item.packingdesc,\n\t\t\t manufacurer = (dbo.manufacturer.name),\n\t\t\t looseqty = Sum (dbo.saledetail.looseqty),\n\t\t\t price = max(dbo.saledetail.saleprice), \n\t\t\t id = max(dbo.saledetail.rowid), \n\t\t\t cumulativesum = round(0.00,2),\n\t\t\t cumulativesumfoot = round(0.00,2),\n\t\t\trowid=max(saledetail.rowid)\n\tFROM \t dbo.saleledger, \n\t\t\t dbo.saledetail,    \n\t\t\t dbo.item, \n\t\t\t dbo.Customer,\n\t\t\t dbo.Accounts,\n\t\t\t dbo.Manufacturer \n\tWHERE  \n\t\t\t:as_doctype = 'originaldate' AND\n\t\t\tdbo.saleledger.originaldate >= :ad_StartDate AND\n\t\t\t dbo.saleledger.originaldate <= :ad_EndDate  AND \n\t\t\t dbo.saleledger.custcode IN ( :al_custcode ) AND\n\t\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t\t\t dbo.saledetail.icode = item.icode AND\n\t\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t\t dbo.customer.custcode = dbo.accounts.acccode AND\n\t\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\n\t\t\t\n\tGroup by \n\t\t\tdbo.saledetail.icode,\n\t\t\tdbo.saledetail.rowgroup,\n\t\t\tdbo.item.name,\n\t\t\tdbo.item.packingdesc,\n\t\t\tdbo.manufacturer.name\n\tUNION ALL\n\tSELECT itemname = item.name,\n\t\t\t packing = dbo.item.packingdesc,\n\t\t\t manufacurer = (dbo.manufacturer.name),\n\t\t\t looseqty = Sum (sd.looseqty),\n\t\t\t price = max(sd.saleprice),    \n\t\t\t id = max(sd.rowid), \n\t\t\t cumulativesum = round(0.00,2),\n\t\t\t cumulativesumfoot = round(0.00,2),\n\t\t\trowid=max(sd.rowid)\n\tFROM \t dbo.saleledger, \n\t\t\t dbo.saleinvdetail sd,    \n\t\t\t dbo.item, \n\t\t\t dbo.Customer,\n\t\t\t dbo.Accounts,\n\t\t\t dbo.Manufacturer \n\tWHERE  \n\t\t\t:as_doctype = 'originaldate' AND\n\t\t\tdbo.saleledger.impactinventory = 'N' AND\n\t\t\t dbo.saleledger.originaldate >= :ad_StartDate AND\n\t\t\t dbo.saleledger.originaldate <= :ad_EndDate  AND \n\t\t\t dbo.saleledger.custcode IN ( :al_custcode ) AND\n\t\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t\t dbo.saleledger.saleinvcode = sd.saleinvcode AND\n\t\t\t sd.icode = item.icode AND\n\t\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t\t dbo.customer.custcode = dbo.accounts.acccode AND\n\t\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\n\tGroup by \n\t\t\tsd.icode,\n\t\t\tsd.rowgroup,\n\t\t\tdbo.item.name,\n\t\t\tdbo.item.packingdesc,\n\t\t\tdbo.manufacturer.name\n\tUNION \n\tSELECT itemname = item.name,\n\t\t\t packing = dbo.item.packingdesc,\n\t\t\t manufacurer = (dbo.manufacturer.name),\n\t\t\t looseqty = Sum (dbo.saledetail.looseqty),\n\t\t\t price = max(dbo.saledetail.saleprice),    \n\t\t\t id = max(dbo.saledetail.rowid), \n\t\t\t cumulativesum = round(0.00,2),\n\t\t\t cumulativesumfoot = round(0.00,2),\n\t\t\trowid=max(saledetail.rowid)\n\tFROM \t dbo.saleledger, \n\t\t\t dbo.saledetail,    \n\t\t\t dbo.item, \n\t\t\t dbo.Customer,\n\t\t\t dbo.Accounts,\n\t\t\t dbo.Manufacturer \n\tWHERE  \n\t\t\t:as_doctype = 'billingdate' AND\n\t\t\tdbo.saleledger.billingdate >= :ad_StartDate AND\n\t\t\t dbo.saleledger.billingdate <= :ad_EndDate  AND \n\t\t\t dbo.saleledger.custcode IN ( :al_custcode ) AND\n\t\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t\t\t dbo.saledetail.icode = item.icode AND\n\t\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t\t dbo.customer.custcode = dbo.accounts.acccode AND\n\t\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\n\tGroup by \n\t\t\tdbo.saledetail.icode,\n\t\t\tdbo.saledetail.rowgroup,\n\t\t\tdbo.item.name,\n\t\t\tdbo.item.packingdesc,\n\t\t\tdbo.manufacturer.name\n\tUNION ALL\n\tSELECT itemname = item.name,\n\t\t\t packing = dbo.item.packingdesc,\n\t\t\t manufacurer = (dbo.manufacturer.name),\n\t\t\t looseqty = Sum (sd.looseqty),\n\t\t\t price = max(sd.saleprice),    \n\t\t\t id = max(sd.rowid), \n\t\t\t cumulativesum = round(0.00,2),\n\t\t\t cumulativesumfoot = round(0.00,2),\n\t\t\trowid=max(sd.rowid)\n\tFROM \t dbo.saleledger, \n\t\t\t dbo.saleinvdetail sd,    \n\t\t\t dbo.item, \n\t\t\t dbo.Customer,\n\t\t\t dbo.Accounts,\n\t\t\t dbo.Manufacturer \n\tWHERE  \n\t\t\t:as_doctype = 'billingdate' AND\n\t\t\tdbo.saleledger.impactinventory = 'N' AND\n\t\t\t dbo.saleledger.billingdate >= :ad_StartDate AND\n\t\t\t dbo.saleledger.billingdate <= :ad_EndDate  AND \n\t\t\t dbo.saleledger.custcode IN ( :al_custcode ) AND\n\t\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t\t dbo.saleledger.saleinvcode = sd.saleinvcode AND\n\t\t\t sd.icode = item.icode AND\n\t\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t\t dbo.customer.custcode = dbo.accounts.acccode AND\n\t\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\n\tGroup by \n\t\t\tsd.icode,\n\t\t\tsd.rowgroup,\n\t\t\tdbo.item.name,\n\t\t\tdbo.item.packingdesc,\n\t\t\tdbo.manufacturer.name\n\tUNION \n\tSELECT itemname = item.name,\n\t\t\t packing = dbo.item.packingdesc,\n\t\t\t manufacurer = (dbo.manufacturer.name),\n\t\t\t looseqty = Sum (dbo.saledetail.looseqty),\n\t\t\t price = max(dbo.saledetail.saleprice),    \n\t\t\t id = max(dbo.saledetail.rowid), \n\t\t\t cumulativesum = round(0.00,2),\n\t\t\t cumulativesumfoot = round(0.00,2),\n\t\t\trowid=max(saledetail.rowid)\n\tFROM \t dbo.saleledger, \n\t\t\t dbo.saledetail,    \n\t\t\t dbo.item, \n\t\t\t dbo.Customer,\n\t\t\t dbo.Accounts,\n\t\t\t dbo.Manufacturer \n\tWHERE  \n\t\t\t:as_doctype = 'lastsavingdate' AND\n\t\t\tdbo.saleledger.date >= :ad_StartDate AND\n\t\t\t dbo.saleledger.date <= :ad_EndDate  AND \n\t\t\t dbo.saleledger.custcode IN ( :al_custcode ) AND\n\t\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t\t\t dbo.saledetail.icode = item.icode AND\n\t\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t\t dbo.customer.custcode = dbo.accounts.acccode AND\n\t\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\n\tGroup by \n\t\t\tdbo.saledetail.icode,\n\t\t\tdbo.saledetail.rowgroup,\n\t\t\tdbo.item.name,\n\t\t\tdbo.item.packingdesc,\n\t\t\tdbo.manufacturer.name\n\tUNION ALL\n\tSELECT itemname = item.name,\n\t\t\t packing = dbo.item.packingdesc,\n\t\t\t manufacurer = (dbo.manufacturer.name),\n\t\t\t looseqty = Sum (sd.looseqty),\n\t\t\t price = max(sd.saleprice),    \n\t\t\t id = max(sd.rowid), \n\t\t\t cumulativesum = round(0.00,2),\n\t\t\t cumulativesumfoot = round(0.00,2),\n\t\t\trowid=max(sd.rowid)\n\tFROM \t dbo.saleledger, \n\t\t\t dbo.saleinvdetail sd,    \n\t\t\t dbo.item, \n\t\t\t dbo.Customer,\n\t\t\t dbo.Accounts,\n\t\t\t dbo.Manufacturer \n\tWHERE  \n\t\t\t:as_doctype = 'lastsavingdate' AND\n\t\t\tdbo.saleledger.impactinventory = 'N' AND\n\t\t\t dbo.saleledger.date >= :ad_StartDate AND\n\t\t\t dbo.saleledger.date <= :ad_EndDate  AND \n\t\t\t dbo.saleledger.custcode IN ( :al_custcode ) AND\n\t\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t\t dbo.saleledger.saleinvcode = sd.saleinvcode AND\n\t\t\t sd.icode = item.icode AND\n\t\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t\t dbo.customer.custcode = dbo.accounts.acccode AND\n\t\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\n\tGroup by \n\t\t\tsd.icode,\n\t\t\tsd.rowgroup,\n\t\t\tdbo.item.name,\n\t\t\tdbo.item.packingdesc,\n\t\t\tdbo.manufacturer.name) T\nGROUP BY\n\tmanufacurer,\n\titemname, \n\tpacking\norder by rowid",
