    "name": "saleprice",
    "dbname": "saleprice"
   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "packunits",
    "dbname": "PackUnits"
   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "id",
    "dbname": "ID"
   }
  ],
  "retrieve": "SELECT \n\tCustomer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),\n\titemname = item.name,  \n\tpackingdesc = dbo.item.packingdesc,\n\tPackqty = CAST(Sum (dbo.saledetail.looseqty) / CASE WHEN dbo.item.packunits > 0 THEN dbo.item.packunits ELSE 1 END AS INT), \n\tpurprice = dbo.item.purprice,\n\tsaleprice = dbo.item.saleprice,\n\tPackUnits = dbo.item.PackUnits,\n\tID = MAX(dbo.saledetail.rowid)\nFROM \t \n\tdbo.saleledger, \n\tdbo.saledetail,    \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Manufacturer \nWHERE  \n\tCASE lower(:as_datetype) \n\t\tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\tWhen 'billingdate' Then dbo.saleledger.billingdate\n\t End Between :ad_startdate AND :ad_enddate AND\n\t dbo.saleledger.custcode IN (:al_custcode) AND\n\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t dbo.saledetail.icode = item.icode AND\n\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t dbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\tdbo.saledetail.icode,\n\tdbo.item.name,\n\tdbo.item.packingdesc,\n\tdbo.item.packunits,\n\tdbo.item.purprice,\n\tdbo.item.saleprice",
  "arguments": {
   "_items": [
    {
     "_items": [
      "al_CustCode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ad_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_EndDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_discperc",
      "number"
     ]
    },
    {
     "_items": [
      "as_datetype",
      "string"
     ]
    }
   ]
  },
  "sort": "itemname A"
 },
