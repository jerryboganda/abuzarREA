  "retrieve": "SELECT\n\tdate = CAST(CONVERT(VARCHAR(100), A.Date, 111) AS DATETIME),\n\titemname=A.itemname,\n\tpacking=A.packing,\n\tsubcategory=A.itemclass,\n\tlooseqty=Sum(A.looseqty),\n\tprice=max(A.price),\n\tid=max(A.id),\n\tcumulativesum = round(0.00,2),\n\tcumulativesumfoot = round(0.00,2)\n\t\n\tFROM\n\n\t(\tSELECT\n\t\t\t\t\t date = \tCASE lower(:as_doctype) \n\t\t\t\t\t\t\tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate END,\n\t\t\t\t\t itemname = item.name, \n\t\t\t\t\t packing = dbo.item.packingdesc,\n\t\t\t\t\t itemclass = (dbo.itemclass.name),\n\t\t\t\t\t looseqty = Sum (dbo.saledetail.looseqty),\n\t\t\t\t\t price = max(dbo.saledetail.saleprice), \n\t\t\t\t\t id = max(dbo.saledetail.rowid),\n\t\t\t\t\ticode=saledetail.icode\n\t\t\t\t\t\n\t\t\tFROM dbo.saleledger, \n\t\t\t\t\t dbo.saledetail,    \n\t\t\t\t\t dbo.item, \n\t\t\t\t\t dbo.Customer,\n\t\t\t\t\t dbo.Accounts,\n\t\t\t\t\t dbo.itemclass \n\t\t\tWHERE  \n\t\t\t\t\tCASE lower(:as_doctype) \n\t\t\t\t\t\t\tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate END >= :ad_StartDate AND\n\t\t\t\t\t CASE lower(:as_doctype) \n\t\t\t\t\t\t\tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate  END  <= :ad_EndDate  AND \n\t\t\t\t\t dbo.saleledger.custcode IN ( :al_custcode ) AND\n\t\t\t\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t\t\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t\t\t\t\t dbo.saledetail.icode = item.icode AND\n\t\t\t\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t\t\t\t dbo.customer.custcode = dbo.accounts.acccode AND\n\t\t\t\t\t dbo.Item.iccode= dbo.itemclass.iccode\n\t\t\tGroup by \n\t\t\t\t\tdbo.saleledger.originaldate,\n\t\t\t\t\tdbo.saleledger.date ,\n\t\t\t\t\tdbo.saleledger.billingdate,\n\t\t\t\t\tdbo.saledetail.icode,\n\t\t\t\t\tdbo.item.name,\n\t\t\t\t\tdbo.item.packingdesc,\n\t\t\t\t\tdbo.itemclass.name\n\t\t\tUNION ALL\n\t\t\tSELECT \n\t\t\t\t\t date = \tCASE lower(:as_doctype) \n\t\t\t\t\t\t\tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate END,\n\t\t\t\t\t itemname = item.name,\n\t\t\t\t\t packing = dbo.item.packingdesc,\n\t\t\t\t\t itemclass = (dbo.itemclass.name),\n\t\t\t\t\t looseqty = Sum (sd.looseqty),\n\t\t\t\t\t price = max(sd.saleprice),    \n\t\t\t\t\t id = max(sd.rowid),\n\t\t\t\t\ticode=sd.icode\n\t\t\t\t\t\n\t\t\tFROM \t dbo.saleledger, \n\t\t\t\t\t dbo.saleinvdetail sd,    \n\t\t\t\t\t dbo.item, \n\t\t\t\t\t dbo.Customer,\n\t\t\t\t\t dbo.Accounts,\n\t\t\t\t\t dbo.itemclass \n\t\t\tWHERE  \n\t\t\t\t\t\n\t\t\t\t\tdbo.saleledger.impactinventory = 'N' AND\n\t\t\t\t\tCASE lower(:as_doctype) \n\t\t\t\t\t\t\tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate END >= :ad_StartDate AND\n\t\t\t\t\t CASE lower(:as_doctype) \n\t\t\t\t\t\t\tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate  END  <= :ad_EndDate  AND \n\t\t\t\t\t dbo.saleledger.custcode IN ( :al_custcode ) AND\n\t\t\t\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t\t\t\t dbo.saleledger.saleinvcode = sd.saleinvcode AND\n\t\t\t\t\t sd.icode = item.icode AND\n\t\t\t\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t\t\t\t dbo.customer.custcode = dbo.accounts.acccode AND\n\t\t\t\t\t dbo.Item.iccode = dbo.itemclass.iccode\n\t\t\tGroup by \n\t\t\t\t\tdbo.saleledger.originaldate,\n\t\t\t\t\tdbo.saleledger.date ,\n\t\t\t\t\tdbo.saleledger.billingdate,\n\t\t\t\t\tsd.icode,\n\t\t\t\t\tdbo.item.name,\n\t\t\t\t\tdbo.item.packingdesc,\n\t\t\t\t\tdbo.itemclass.name )AS A\n\t\t\t\n\nGROUP BY\n\t\t\tCAST(CONVERT(VARCHAR(100), A.Date, 111) AS DATETIME),\n\t\t\tA.icode,\n\t\t\tA.itemname,\n\t\t\tA.packing,\n\t\t\tA.itemclass",
