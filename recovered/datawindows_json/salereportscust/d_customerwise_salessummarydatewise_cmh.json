  ],
  "retrieve": "SELECT date = Convert(varchar(15), CASE lower(:as_datetype) \n\t\t\t\t\t\t\t\t\t\t\t  When 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t\t\t\t\t\t\t  When 'lastsavingdate' Then dbo.saleledger.date\n \t\t\t\t\t\t\t\t\t\t\t  When 'billingdate' Then dbo.saleledger.billingdate\n\t\t\t\t\t\t\t\t\t\t\t  End ,   \n\t\t\t\t\t\t\t 101), \n\t\t amout = Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice ) \n\t\t  \nFROM \t dbo.saleledger, \n\t\t dbo.saledetail,    \n\t\t dbo.item, \n\t\t dbo.Customer\n\nWHERE  DBO.SaleLedger.impactinventory = 'N' AND\n\t\t CASE lower(:as_datetype) \n\t\t \tWhen 'originaldate'   Then dbo.saleledger.originaldate \n\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n \t\t\tWhen 'billingdate'    Then dbo.saleledger.billingdate\n\t  \t End Between :ad_StartDate AND :ad_EndDate AND\n\t\t dbo.saleledger.custcode IN (:al_custcode) AND\n\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t\t dbo.saledetail.icode = item.icode \n\nGroup by Convert(varchar(15), CASE lower(:as_datetype) \n\t\t\t\t\t\t\t\t\t \t\tWhen 'originaldate'   Then dbo.saleledger.originaldate \n\t\t\t\t\t\t\t\t\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t\t\t\t \t\t\tWhen 'billingdate'    Then dbo.saleledger.billingdate\n\t\t\t\t\t\t\t\t\t  \tEnd,\n\t\t\t\t\t 101)\n\nUNION ALL\nSELECT date = Convert(varchar(15), CASE lower(:as_datetype) \n\t\t\t\t\t\t\t\t\t\t\t  When 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t\t\t\t\t\t\t  When 'lastsavingdate' Then dbo.saleledger.date\n \t\t\t\t\t\t\t\t\t\t\t  When 'billingdate' Then dbo.saleledger.billingdate\n\t\t\t\t\t\t\t\t\t\t\t  End ,   \n\t\t\t\t\t\t\t 101),\n\t\t amout = Sum ( sd.looseqty * sd.saleprice ) \n\t\t  \nFROM \t dbo.saleledger, \n\t\t dbo.saleinvdetail sd,\n\t\t dbo.item, \n\t\t dbo.Customer\n\nWHERE  CASE lower(:as_datetype) \n\t\t \tWhen 'originaldate'   Then dbo.saleledger.originaldate \n\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n \t\t\tWhen 'billingdate'    Then dbo.saleledger.billingdate\n\t  \t End Between :ad_StartDate AND :ad_EndDate AND\n\t\t dbo.saleledger.custcode IN (:al_custcode) AND\n\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t dbo.saleledger.saleinvcode = sd.saleinvcode AND\n\t\t sd.icode = item.icode \n\nGroup by Convert(varchar(15), CASE lower(:as_datetype) \n\t\t\t\t\t\t\t\t\t \t\tWhen 'originaldate'   Then dbo.saleledger.originaldate \n\t\t\t\t\t\t\t\t\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t\t\t\t \t\t\tWhen 'billingdate'    Then dbo.saleledger.billingdate\n\t\t\t\t\t\t\t\t\t  \tEnd,\n\t\t\t\t\t 101)\n\n\n\n\n\n",
