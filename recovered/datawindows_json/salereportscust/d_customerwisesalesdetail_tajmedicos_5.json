  "retrieve": "SELECT \n\t\t\n\t\tdate=max(saleledger.date),\n\t\theaderno=max(saleledger.headerno),\t\n\t\titemname = item.name, \n\t\t manufacurer = max(dbo.manufacturer.name),\n\t\t itempacking = max(dbo.itempacking.name),\n\t\t claim = Max(dbo.saledetail.claimable),\t \t\t\n\t\t looseqty = Sum (dbo.saledetail.looseqty),\n\t\t price = Max (dbo.saledetail.saleprice),\n\t\t taxregno=max(customer.salestaxregno),\n\t\t custpostcode=max(customer.postcode),\n\t\t custdesignation=max(customer.designation),\n\t\t ID = MAX(dbo.saledetail.rowid),\n\t\t customername=(select name from accounts where accounts.acccode=:al_custcode),\n\t\t custadd=max(customer.address1),\n\t\t custadd2=max(customer.address2),\n\t\tcustphone=max(customer.phone),\n\t\tcustfax=max(customer.fax),\n\t\tcustemail=max(customer.email)\n\t\t\nFROM \t dbo.saleledger, \n\t\t dbo.saledetail,    \n\t\t dbo.item, \n\t\t dbo.itempacking,\n\t\t customer,\n\t\t dbo.Manufacturer \n\t\t\nWHERE saleledger.saleinvcode>= :al_sinvcode AND\n\t\t\tsaleledger.saleinvcode<= :al_linvcode AND\n\t\t\tdbo.saleledger.custcode = :al_custcode AND\n\t\t    saleledger.custcode=customer.custcode and\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t\t dbo.saledetail.icode = item.icode AND\n\t\t dbo.item.packcode = dbo.itempacking.packcode AND\n\t\t  dbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\t\tdbo.saledetail.icode,\n\t\tdbo.item.name,\n\t\tdbo.manufacturer.name,\n\t\tdbo.itempacking.name\norder by itemname\n\t\t\t\n\n\n\n",
