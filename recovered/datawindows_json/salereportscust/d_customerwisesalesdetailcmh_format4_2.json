  "retrieve": "SELECT saleinvcode = MAX(dbo.saleledger.saleinvcode),  \n\t\t CustomerRef = max(dbo.saleledger.CustRefNo), \n       date = CASE lower(:as_datetype) \n\t\t\t\t\t\t\tWhen 'originaldate' Then Max(dbo.saleledger.originaldate) \n\t\t\t\t\t\t\tWhen 'lastsavingdate' Then Max(dbo.saleledger.date)\n\t\t\t\t\t\t\tWhen 'billingdate' Then Max(dbo.saleledger.billingdate)\n\t\t\t\t  End, \n\t\t invdiscperc = max(dbo.saleledger.discperc),    \n       flatdisc = max(dbo.saleledger.flatdisc),    \n       misccharges = max(dbo.saleledger.misccharges), \n       invsalestax = max(dbo.saleledger.salestax),\n       remarks = MAX(dbo.saleledger.remarks),\n       custcode = max(dbo.saleledger.custcode),\n\t\t packing = item.packingdesc,\n\t\t looseqty = sum(dbo.saledetail.looseqty), \n\t\t packqty  = max(saledetail.packqty),  \n       price = max(dbo.saledetail.saleprice),    \n       unittax=max(saledetail.unitsalestax),\n\t\t taxamount= max(saledetail.unitsalestax) * sum(dbo.saledetail.looseqty),\n\t\t itemdiscperc = max(dbo.saledetail.discperc),    \n\t\t packunits = max(dbo.saledetail.packunits),    \n\t\t batch = max(dbo.saledetail.batch),    \n\t\t expiry = max(dbo.saledetail.expiry),    \n\t\t salestax  = max(saledetail.salestax),\n\t\t rowid     = max(saledetail.rowid),\n\t \t itemname = Case When Max(saledetail.saleitemdescription) IS Null OR RTrim(LTrim(Max(saledetail.saleitemdescription))) = '' THEN item.name Else Max(saledetail.saleitemdescription) END,\n\t\t /*datestring = max((Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))))), */\n\t\t Customer = 'M/S :' + MAX(dbo.accounts.name),\n\t\t contactperson = MAX(dbo.customer.cp),\n\t\t manufacurer = (dbo.manufacturer.name),\n\t\t address = MAX(dbo.customer.address1),\n\t\t city = MAX(dbo.customer.city)\t\t  \n\nFROM \t dbo.saleledger, \n\t\t dbo.saledetail,    \n\t\t dbo.item, \n\t\t dbo.accounts,\n\t\t dbo.Customer,\n\t\t dbo.Manufacturer \n\nWHERE  CASE lower(:as_datetype) \n\t\t\t\tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate\n\t\t End Between :ad_startdate And :ad_enddate  And \n\t\t dbo.saleledger.custcode = :al_custcode And\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) and\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  \n\t\t dbo.saledetail.icode = item.icode and \n\t\t dbo.saleledger.custcode = dbo.accounts.acccode and\n\t\t dbo.saleledger.custcode = dbo.customer.custcode and\n\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\t\tsaledetail.icode,\n\t\titem.name,\n\t\titem.packingdesc,\n\t\tmanufacturer.name\nUNION ALL\nSELECT saleinvcode = MAX(dbo.saleledger.saleinvcode), \n\t\t CustomerRef = max(dbo.saleledger.CustRefNo), \n       date = CASE lower(:as_datetype) \n\t\t\t\t\t\t\tWhen 'originaldate' Then Max(dbo.saleledger.originaldate) \n\t\t\t\t\t\t\tWhen 'lastsavingdate' Then Max(dbo.saleledger.date)\n\t\t\t\t\t\t\tWhen 'billingdate' Then Max(dbo.saleledger.billingdate)\n\t\t\t\t  End, \n\t\t invdiscperc = max(dbo.saleledger.discperc),    \n       flatdisc = max(dbo.saleledger.flatdisc),    \n       misccharges = max(dbo.saleledger.misccharges), \n       invsalestax = max(dbo.saleledger.salestax),\n       remarks = MAX(dbo.saleledger.remarks),\n       custcode = max(dbo.saleledger.custcode),\n\t\t packing = item.packingdesc,\n\t\t looseqty = sum(sd.looseqty), \n\t\t packqty  = 0,  \n       price = max(sd.saleprice),    \n       unittax=max(sd.unitsalestax),\n\t\t taxamount= max(sd.unitsalestax) * sum(sd.looseqty),\n\t\t itemdiscperc = max(sd.discperc),    \n\t\t packunits = max(sd.packunits),    \n\t\t batch = max(sd.batch),    \n\t\t expiry = max(sd.expiry),    \n\t\t salestax  = 0,\n\t\t rowid     = max(sd.rowid),\n\t \t itemname = Case When Max(sd.saleitemdescription) IS Null OR RTrim(LTrim(Max(sd.saleitemdescription))) = '' THEN item.name Else Max(sd.saleitemdescription) END,\n\t\t /*datestring = max((Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))))), */\n\t\t Customer = 'M/S :' + MAX(dbo.accounts.name),\n\t\t contactperson = MAX(dbo.customer.cp),\n\t\t manufacurer = (dbo.manufacturer.name),\n\t\t address = MAX(dbo.customer.address1),\n\t\t city = MAX(dbo.customer.city)\t\t  \n\nFROM \t dbo.saleledger, \n\t\t dbo.saleinvdetail sd,    \n\t\t dbo.item, \n\t\t dbo.accounts,\n\t\t dbo.Customer,\n\t\t dbo.Manufacturer \n\nWHERE  DBO.SaleLedger.impactinventory = 'N' AND \n\t\t CASE lower(:as_datetype) \n\t\t\t\tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate\n\t\t End Between :ad_startdate And :ad_enddate  And \n\t\t dbo.saleledger.custcode = :al_custcode And\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) and\n\t\t dbo.saleledger.saleinvcode = sd.saleinvcode and  \n\t\t sd.icode = item.icode and \n\t\t dbo.saleledger.custcode = dbo.accounts.acccode and\n\t\t dbo.saleledger.custcode = dbo.customer.custcode and\n\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\t\tsd.icode,\n\t\titem.name,\n\t\titem.packingdesc,\n\t\tmanufacturer.name\n",
