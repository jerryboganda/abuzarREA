  "retrieve": "SELECT item.icode,  \n\t\t item.name,\n\t\tpackingfactor=item.packingfactor,\n\t\t customer=(select accounts.name from accounts where acccode=:ai_custcode),\n\t\t salaeqty=ISNULL((select sum(saledetail.looseqty) \n                 from saledetail,saleledger\n\t\t\t\t\t  where saleledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t\t\t\t saledetail.icode=item.icode\n\t\t\t\t\t\t),0) +\n\t\t\t\t\tISNULL((select sum(saledetail.looseqty) \n                 from saleinvdetail saledetail, saleledger\n\t\t\t\t\t  where saleledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t SaleLedger.impactinventory = 'N' AND \n\t\t\t\t\t\t\t saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t\t\t\t saledetail.icode=item.icode),0),\n\t\tsalebonus=ISNULL((select sum(saledetail.bonusqty) \n                 from saledetail,saleledger\n\t\t\t\t\t  where saleledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t\t\t\t saledetail.icode=item.icode\n\t\t\t\t\t\t),0) +\n\t\t\t\t\tISNULL((select sum(saledetail.bonusqty) \n                 from saleinvdetail saledetail, saleledger\n\t\t\t\t\t  where saleledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t SaleLedger.impactinventory = 'N' AND \n\t\t\t\t\t\t\t saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t\t\t\t saledetail.icode=item.icode),0),\n\t\tsalevalue=ISNUll((select IsNull( sum(Round(((saledetail.looseqty + saledetail.packqty * saledetail.packunits) * (saledetail.saleprice - saledetail.itemflatdisc)),2) * (1 - (.01 * saledetail.discperc)) * (1- (.01 * saleledger.discperc))) ,0) \n\t\t\t\t\t\tfrom saledetail,saleledger\n\t\t\t\t\t  where saleledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t\t\t\t saledetail.icode=item.icode),0) + \n\t\t\t\t\tISNUll((select IsNull( sum(Round(((saledetail.looseqty) * (saledetail.saleprice - saledetail.itemflatdisc)),2) * (1 - (.01 * saledetail.discperc)) * (1- (.01 * saleledger.discperc))) ,0)\n                 from saleinvdetail saledetail, saleledger\n\t\t\t\t\t  where saleledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t SaleLedger.impactinventory = 'N' AND \n\t\t\t\t\t\t\t saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t\t\t\t saledetail.icode=item.icode\n\t\t\t\t\t\t),0),\n\n\t\tsaleretqty=ISNULL((select sum(srdetail.looseqty) \n                 from srdetail,srledger\n\t\t\t\t\t  where srledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t srledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t srledger.srinvcode=srdetail.srinvcode and\n\t\t\t\t\t\t\t srdetail.icode=item.icode\n\t\t\t\t\t\t),0),\n\t\tretbonus=ISNULL((select sum(srdetail.bonusqty) \n                 from srdetail,srledger\n\t\t\t\t\t  where srledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t srledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t srledger.srinvcode=srdetail.srinvcode and\n\t\t\t\t\t\t\t srdetail.icode=item.icode\n\t\t\t\t\t\t),0),\n\n\t  saleretvalue=ISNULL((select IsNull( sum(Round(((srdetail.looseqty + srdetail.packqty * srdetail.packunits) * srdetail.srprice) * (1 - (.01 * srdetail.discperc)),2) * (1- (.01 * srledger.discperc))) ,0) from srdetail,srledger\n\t\t\t\t\t  where srledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t srledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t srledger.srinvcode=srdetail.srinvcode and\n\t\t\t\t\t\t\t srdetail.icode=item.icode),0),\n\n\t\t\t netqty=ISNULL((select sum(saledetail.looseqty) \n                 from saledetail,saleledger\n\t\t\t\t\t  where saleledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t\t\t\t saledetail.icode=item.icode\n\t\t\t\t\t\t) ,0) +\n\n\t\t\t\t\tISNULL((select sum(saledetail.looseqty) \n                 from saleinvdetail saledetail, saleledger\n\t\t\t\t\t  where saleledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t SaleLedger.impactinventory = 'N' AND \n\t\t\t\t\t\t\t saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t\t\t\t saledetail.icode=item.icode\n\t\t\t\t\t\t),0)\n\t\t\t\t\t\t-\n\t\t\n\t\t\t\t\t\tISNULL((select sum(srdetail.looseqty) \n                 \t from srdetail,srledger\n\t\t\t\t\t  \t where srledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t srledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t srledger.srinvcode=srdetail.srinvcode and\n\t\t\t\t\t\t\t srdetail.icode=item.icode\n\t\t\t\t\t\t),0),\n\t\tnetvalue=ISNUll((select IsNull( sum(Round(((saledetail.looseqty + saledetail.packqty * saledetail.packunits) * (saledetail.saleprice - saledetail.itemflatdisc)),2) * (1 - (.01 * saledetail.discperc)) * (1- (.01 * saleledger.discperc))) ,0) \n\t\t\t\t\t\tfrom saledetail,saleledger\n\t\t\t\t\t  where saleledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t\t\t\t saledetail.icode=item.icode),0) + \n\t\t\t\t\tISNUll((select IsNull( sum(Round(((saledetail.looseqty) * (saledetail.saleprice - saledetail.itemflatdisc)),2) * (1 - (.01 * saledetail.discperc)) * (1- (.01 * saleledger.discperc))) ,0)\n                 from saleinvdetail saledetail, saleledger\n\t\t\t\t\t  where saleledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t SaleLedger.impactinventory = 'N' AND \n\t\t\t\t\t\t\t saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t\t\t\t saledetail.icode=item.icode\n\t\t\t\t\t\t),0) -\n\t\t\t\t\t\n\t\t\t\t\tISNULL((select IsNull( sum(Round(((srdetail.looseqty + srdetail.packqty * srdetail.packunits) * srdetail.srprice) * (1 - (.01 * srdetail.discperc)),2) * (1- (.01 * srledger.discperc))) ,0) \n\t\t\t\t\t\tfrom srdetail,srledger\n\t\t\t\t\t\twhere srledger.custcode=:ai_custcode and\n\t\t\t\t\t\t\t srledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\t\t\t srledger.srinvcode=srdetail.srinvcode and\n\t\t\t\t\t\t\t srdetail.icode=item.icode),0)\nFROM item\nORDER BY item.name",
