  "retrieve": "SELECT \n\tinvcode = dbo.saleledger.saleinvcode,\n\tcustomer = dbo.accounts.name,\n\tcontactperson=(dbo.customer.cp), \n\taddress = (dbo.customer.address1),\n\tcity = (dbo.customer.city), \n\tdate =\tCASE lower(:as_datetype)\n\t\tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\tWhen 'date' Then dbo.saleledger.date\n\t\tWhen 'billingdate' Then dbo.saleledger.billingdate\n\t\tEnd,\n\tregno = dbo.patient.regno,\n\tpatient = dbo.patient.name,\n\titemname = item.name,\n\tlooseqty = SUM(dbo.saledetail.looseqty),\n\tsaleprice = MAX(dbo.saledetail.saleprice),\n\tOrderDate  = dbo.saleledger.billingdate,\n\tCustRefNo  = dbo.saleledger.CustRefNo,\n\tCustRefNo2 = dbo.saleledger.CustRefNo2,\n\tCustRefNo3 = dbo.saleledger.CustRefNo3,\n\tCustRefNo4 = dbo.saleledger.CustRefNo4,\n\tRank = (Select dbo.rank.name From dbo.Rank Where dbo.patient.rankcode = dbo.rank.rankcode)\nFROM \t \n\tdbo.saleledger, \n\tdbo.saledetail,    \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Patient,\n\tdbo.Accounts\nWHERE  \n\tCASE \n\tWHEN lower(:as_datetype)  = 'originaldate' THEN dbo.saleledger.originaldate \n\tWHEN lower(:as_datetype)  = 'lastsavingdate' THEN dbo.saleledger.date \n\tWHEN lower(:as_datetype)  = 'billingdate' THEN dbo.saleledger.billingdate \n\tELSE dbo.saleledger.date \n\tEnd Between :adt_startdate AND :adt_enddate AND\n\tdbo.saleledger.custcode = :al_custcode AND\n\tISNULL(dbo.saleledger.custrefno, '')  = ISNULL(CASE WHEN lower(:as_datetype)  = 'date' THEN :as_refno ELSE dbo.saleledger.custrefno END, '') AND\n\tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\tdbo.saledetail.icode = item.icode AND\n\tdbo.saleledger.custcode = dbo.customer.custcode AND\n\tdbo.customer.custcode = dbo.accounts.acccode AND\n\tdbo.saleledger.patientcode = dbo.patient.patientcode\nGROUP BY\n\tdbo.saleledger.saleinvcode,\n\tdbo.accounts.name,\n\tdbo.customer.cp, \n\tdbo.customer.address1,\n\tdbo.customer.city, \n\tdbo.saleledger.custrefno,\n\tdbo.saleledger.originaldate,\n\tdbo.saleledger.date,\n\tdbo.patient.regno,\n\tdbo.patient.name,\n\titem.name,\n\tdbo.saleledger.billingdate,\n\tdbo.saleledger.CustRefNo,\n\tdbo.saleledger.CustRefNo2,\n\tdbo.saleledger.CustRefNo3,\n\tdbo.saleledger.CustRefNo4,\n\tdbo.patient.rankcode\nUNION ALL\nSELECT\n\tinvcode = dbo.saleledger.saleinvcode,\n\tcustomer = dbo.accounts.name,\n\tcontactperson=(dbo.customer.cp), \n\taddress = (dbo.customer.address1),\n\tcity = (dbo.customer.city), \n\tdate =\tCASE lower(:as_datetype)\n\t\tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\tWhen 'date' Then dbo.saleledger.date\n\t\tWhen 'billingdate' Then dbo.saleledger.billingdate\n\t\tEnd,\n\tregno = dbo.patient.regno,\n\tpatient = dbo.patient.name,\n\titemname = item.name,\n\tlooseqty = SUM(saledetail.looseqty),\n\tsaleprice = MAX(saledetail.saleprice),\n\tOrderDate  = dbo.saleledger.billingdate,\n\tCustRefNo  = dbo.saleledger.CustRefNo,\n\tCustRefNo2 = dbo.saleledger.CustRefNo2,\n\tCustRefNo3 = dbo.saleledger.CustRefNo3,\n\tCustRefNo4 = dbo.saleledger.CustRefNo4,\n\tRank = (Select dbo.rank.name From dbo.Rank Where dbo.patient.rankcode = dbo.rank.rankcode)\nFROM \t \n\tdbo.saleledger, \n\tdbo.saleinvdetail saledetail, \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Patient,\n\tdbo.Accounts\nWHERE  \n\tCASE \n\tWHEN lower(:as_datetype)  = 'originaldate' THEN dbo.saleledger.originaldate \n\tWHEN lower(:as_datetype)  = 'lastsavingdate' THEN dbo.saleledger.date \n\tWHEN lower(:as_datetype)  = 'billingdate' THEN dbo.saleledger.billingdate \n\tELSE dbo.saleledger.date \n\tEnd Between :adt_startdate AND :adt_enddate AND\n\tdbo.saleledger.custcode = :al_custcode AND\n\tISNULL(dbo.saleledger.custrefno, '')  = ISNULL(CASE WHEN lower(:as_datetype)  = 'date' THEN :as_refno ELSE dbo.saleledger.custrefno END, '') AND\n\tdbo.saleledger.saleinvcode = saledetail.saleinvcode AND\n\tsaledetail.icode = item.icode AND\n\tdbo.saleledger.custcode = dbo.customer.custcode AND\n\tdbo.customer.custcode = dbo.accounts.acccode AND\n\tdbo.saleledger.patientcode = dbo.patient.patientcode\nGROUP BY\n\tdbo.saleledger.saleinvcode,\n\tdbo.accounts.name,\n\tdbo.customer.cp, \n\tdbo.customer.address1,\n\tdbo.customer.city, \n\tdbo.saleledger.custrefno,\n\tdbo.saleledger.originaldate,\n\tdbo.saleledger.date,\n\tdbo.patient.regno,\n\tdbo.patient.name,\n\titem.name,\n\tdbo.saleledger.billingdate,\n\tdbo.saleledger.CustRefNo,\n\tdbo.saleledger.CustRefNo2,\n\tdbo.saleledger.CustRefNo3,\n\tdbo.saleledger.CustRefNo4,\n\tdbo.patient.rankcode",
