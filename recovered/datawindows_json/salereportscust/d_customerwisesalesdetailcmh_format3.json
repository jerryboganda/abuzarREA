  "retrieve": "SELECT saleinvcode = (dbo.saleledger.saleinvcode),     \n\t\t CustomerRef = max(convert(int ,rtrim(ltrim(IsNull(dbo.saleledger.CustRefNo, '0'))))), \n       date = max(dbo.saleledger.date), \n\t\t invdiscperc = max(dbo.saleledger.discperc),    \n       flatdisc = max(dbo.saleledger.flatdisc), \n       misccharges = max(dbo.saleledger.misccharges), \n       invsalestax = max(dbo.saleledger.salestax),\n       remarks = (dbo.saleledger.remarks), \n       custcode = max(dbo.saleledger.custcode),\n\t\t looseqty = sum(dbo.saledetail.looseqty), \n\t\t packqty  = max(saledetail.packqty),  \n\t\t/* price = max(round(dbo.saledetail.packprice / dbo.saledetail.packunits,4)),\t*/\n       price = max(dbo.saledetail.saleprice),    \n       unittax=max(saledetail.unitsalestax),\n\t\t taxamount= max(saledetail.unitsalestax) * sum(dbo.saledetail.looseqty),\n\t\t itemdiscperc = max(dbo.saledetail.discperc),    \n\t\t packunits = max(dbo.saledetail.packunits),    \n\t\t batch = max(dbo.saledetail.batch),    \n\t\t expiry = max(dbo.saledetail.expiry),    \n\t\t salestax  = max(saledetail.salestax),\n\t\t rowid     = max(saledetail.rowid),\n\t \t itemname = item.name,\n\t\t /*datestring = max((Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))))), */\n\t\t Person = (dbo.accounts.name),\n\t\t contactperson=(dbo.customer.cp),\n\t\t manufacurer = (dbo.manufacturer.name),\n\t\t address = (dbo.customer.address1),\n\t\t city = (dbo.customer.city)\n\nFROM \t dbo.saleledger, \n\t\t dbo.saledetail,    \n\t\t dbo.item, \n\t\t dbo.accounts,\n\t\t dbo.Customer,\n\t\t dbo.Manufacturer \n\nWHERE  dbo.saleledger.originaldate >= :ad_StartDate and\n\t\t dbo.saleledger.originaldate <= :ad_EndDate  and \n\t\t (dbo.saleledger.custcode >= ( Case :al_CustCode When 0 Then 10 Else :al_CustCode End) and \n\t\t dbo.saleledger.custcode  <= ( Case :al_CustCode When 0 THEN (Select max(custcode) From Customer) Else :al_CustCode End )) and\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) and\n\t\t /*dbo.saleledger.saleinvcode NOT IN (select distinct srledger.saleinvcode from srledger where srledger.originaldate between :ad_StartDate and :ad_EndDate and srledger.saleinvcode IS NOT NULL) and*/\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  \n\t\t dbo.saledetail.icode = item.icode and \n\t\t dbo.saleledger.custcode = dbo.accounts.acccode and\n\t\t dbo.saleledger.custcode = dbo.customer.custcode and\n\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by saleledger.saleinvcode,\n\t\tsaledetail.icode,\n\t\titem.name,\n\t\t(dbo.accounts.name),\n\t\t(dbo.manufacturer.name),\n\t\t(dbo.customer.cp),\n\t\t(dbo.customer.address1),\n\t\t(dbo.customer.city),\n\t\t(dbo.saleledger.remarks)\nUNION ALL\nSELECT saleinvcode = (dbo.saleledger.saleinvcode),    \n\t\t CustomerRef = max(convert(int ,rtrim(ltrim(IsNull(dbo.saleledger.CustRefNo, '0'))))), \n       date = max(dbo.saleledger.date), \n\t\t invdiscperc = max(dbo.saleledger.discperc),    \n       flatdisc = max(dbo.saleledger.flatdisc), \n       misccharges = max(dbo.saleledger.misccharges), \n       invsalestax = max(dbo.saleledger.salestax),\n       remarks = (dbo.saleledger.remarks), \n       custcode = max(dbo.saleledger.custcode),\n\t\t looseqty = sum(sd.looseqty), \n\t\t packqty  = 0,  \n\t\t/* price = max(round(sd.packprice / sd.packunits,4)),\t*/\n       price = max(sd.saleprice),    \n       unittax=max(sd.unitsalestax),\n\t\t taxamount= max(sd.unitsalestax) * sum(sd.looseqty),\n\t\t itemdiscperc = max(sd.discperc),    \n\t\t packunits = max(sd.packunits),    \n\t\t batch = max(sd.batch),    \n\t\t expiry = max(sd.expiry),    \n\t\t salestax  = 0,\n\t\t rowid     = max(sd.rowid),\n\t \t itemname = item.name,\n\t\t /*datestring = max((Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))))), */\n\t\t Person = (dbo.accounts.name),\n\t\t contactperson=(dbo.customer.cp),\n\t\t manufacurer = (dbo.manufacturer.name),\n\t\t address = (dbo.customer.address1),\n\t\t city = (dbo.customer.city)\n\nFROM \t dbo.saleledger, \n\t\t dbo.saleinvdetail sd, \n\t\t dbo.item, \n\t\t dbo.accounts,\n\t\t dbo.Customer,\n\t\t dbo.Manufacturer \n\nWHERE  DBO.SaleLedger.impactinventory = 'N' AND \n\t\t dbo.saleledger.originaldate >= :ad_StartDate and\n\t\t dbo.saleledger.originaldate <= :ad_EndDate  and \n\t\t (dbo.saleledger.custcode >= ( Case :al_CustCode When 0 Then 10 Else :al_CustCode End) and \n\t\t dbo.saleledger.custcode  <= ( Case :al_CustCode When 0 THEN (Select max(custcode) From Customer) Else :al_CustCode End )) and\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) and\n\t\t /*dbo.saleledger.saleinvcode NOT IN (select distinct srledger.saleinvcode from srledger where srledger.originaldate between :ad_StartDate and :ad_EndDate and srledger.saleinvcode IS NOT NULL) and*/\n\t\t dbo.saleledger.saleinvcode = sd.saleinvcode and  \n\t\t sd.icode = item.icode and \n\t\t dbo.saleledger.custcode = dbo.accounts.acccode and\n\t\t dbo.saleledger.custcode = dbo.customer.custcode and\n\t\t dbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by saleledger.saleinvcode,\n\t\tsd.icode,\n\t\titem.name,\n\t\t(dbo.accounts.name),\n\t\t(dbo.manufacturer.name),\n\t\t(dbo.customer.cp),\n\t\t(dbo.customer.address1),\n\t\t(dbo.customer.city),\n\t\t(dbo.saleledger.remarks)\n",
  "arguments": {
   "_items": [
