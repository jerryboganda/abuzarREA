  "retrieve": "SELECT \n\tGrouping = 1,\n\tDateString = convert(varchar(100), dbo.saleledger.Date, 103),\n\tDate=dbo.saleledger.Date,\n\tInvNo = dbo.saleledger.SaleInvCode,\n\tCustomer= (SELECT A.Name FROM Accounts A WHERE A.AccCode = saleledger.custcode),\n\tAddress = Customer.Address1,\n\tPhone = Customer.Phone,\n\tRefNo = (SELECT C.refno FROM Customer C WHERE C.CustCode = min(saleledger.custcode)),\n\tCustRefNo = dbo.saleledger.CustRefNo,\n\tItemCode = item.CustomICode,  \n\titemname = item.name,  \n\tManufacturer = dbo.Manufacturer.Name,\n\tpackingdesc = dbo.item.packingdesc,\n\tPackqty = Sum (dbo.saledetail.looseqty), \n\tsaleprice = dbo.saledetail.saleprice, \n\tPackUnits = dbo.saledetail.PackUnits,\n\tID = MAX(dbo.saledetail.rowid)\nFROM \t \n\tdbo.saleledger, \n\tdbo.saledetail,    \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Manufacturer \nWHERE  \n\tCASE lower(:as_datetype) \n\t\tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\tWhen 'billingdate' Then dbo.saleledger.billingdate\n\t End Between :ad_startdate AND :ad_enddate AND\n\tdbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND\n\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t dbo.saledetail.icode = item.icode AND\n\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t dbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\tdbo.saleledger.Date, \n\tdbo.saleledger.SaleInvCode,\n\tsaleledger.custcode,\n\tdbo.saleledger.CustRefNo,\n\tCustomer.Address1,\n\tCustomer.Phone,\n\tCustomer.RefNo,\n\tdbo.saledetail.icode,\n\titem.CustomICode,  \n\tdbo.item.name,\n\tdbo.item.packingdesc,\n\tdbo.saledetail.packunits,\n\tdbo.saledetail.saleprice,\n\tdbo.Manufacturer.Name",
  "arguments": {
   "_items": [
