  "retrieve": "  SELECT invcode     = dbo.saleledger.saleinvcode,    \n         date        = CASE lower(:as_datetype) \n\t\t\t\t\t\t\t\t\t When 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t\t\t\t\t When 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t\t\t\t\t When 'billingdate' Then dbo.saleledger.billingdate\n\t\t\t\t\t\t\t  END\t,     \n         flatdisc    = dbo.saleledger.flatdisc, \n\t\t\tsalestax    = dbo.saleledger.salestax,       \n         misccharges = dbo.saleledger.misccharges, \n\t\t\tinvdiscperc = dbo.saleledger.discperc, \n\t\t\tinvgstperc1 = dbo.saleledger.invgstperc1,\n\t\t\tdoctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, \n         dbo.accounts.name, \n\t\t\tdbo.customer.cp,\n\t\t\tdbo.customer.address1,\n\t\t\tdbo.customer.address2,\n\t\t\tdbo.customer.city,\n\t\t\t\n         amount =  Round(Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice), 2),    \n\t\t\titemdiscpercvalue = Round(Sum ( dbo.saledetail.looseqty  * ( dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc)), 2),    \n    \t\tinvdiscpercvalue = Round(Sum ( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01))) * (dbo.saleledger.discperc /100), 2),\n\t\t\titemsalestax = Sum (Round (dbo.saledetail.looseqty * dbo.saledetail.unitsalestax + Round ( Round (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc ) * (1 - dbo.saledetail.discperc * 0.01 ), 2 ) * dbo.saledetail.gstperc * 0.01 , 2 ) , 2 ) ) ,\n\t\t\tcustrefno = dbo.saleledger.custrefno,\t       \n\t\t\tremarks = dbo.saleledger.remarks,\n\t\t\tHeaderInvNo=dbo.saleledger.HeaderInvNo,\n\t\t\tsaletyeinvno=max(saleledger.saletypeinvno)\n\t\t\t\n    FROM dbo.saleledger, \n         dbo.saledetail,   \n         dbo.accounts, \n\t\t\tdbo.customer\n\n   WHERE dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  \n\t\t\tCASE lower(:as_datetype) \n\t\t\t\t When 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t    When 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t When 'billingdate' Then dbo.saleledger.billingdate\n\t\t   END between :ad_StartDate and :ad_EndDate and\n\t\t\tdbo.saleledger.salecatcode IN (1, 2, 3) and\n\t\t\tdbo.saleledger.custcode = :al_CustCode and\n\t\t\tsaleledger.saletypecode=:al_saletypeno and\n         dbo.saleledger.custcode = dbo.accounts.acccode and\t\n         dbo.saleledger.custcode = dbo.customer.custcode \n\nGROUP BY dbo.saleledger.saleinvcode,   \n\t\t\tdbo.saleledger.HeaderInvNo,\n\t      CASE lower(:as_datetype) \n\t\t\t\t When 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t When 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t When 'billingdate' Then dbo.saleledger.billingdate\n \t\t   END\t,   \n\t\t\tdbo.saleledger.misccharges,   \n         dbo.saleledger.flatdisc,   \n   \t\tdbo.saleledger.discperc,  \n\t\t\tdbo.saleledger.salestax, \n\t\t\tdbo.saleledger.invgstperc1,\n\t\t\tdbo.saleledger.salecatcode, \n\t\t\tdbo.accounts.name,\t\n\t\t\tdbo.saleledger.custrefno,\t \n\t\t\tdbo.saleledger.remarks,\n\t\t\tdbo.customer.cp,\n\t\t\tdbo.customer.address1,\n\t\t\tdbo.customer.address2,\n\t\t\tdbo.customer.city\nUNION ALL\n  SELECT invcode     = dbo.saleledger.saleinvcode,    \n         date        = CASE lower(:as_datetype) \n\t\t\t\t\t\t\t\t\t When 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t\t\t\t\t When 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t\t\t\t\t When 'billingdate' Then dbo.saleledger.billingdate\n\t\t\t\t\t\t\t  END\t,     \n         flatdisc    = dbo.saleledger.flatdisc, \n\t\t\tsalestax    = dbo.saleledger.salestax,       \n         misccharges = dbo.saleledger.misccharges, \n\t\t\tinvdiscperc = dbo.saleledger.discperc, \n\t\t\tinvgstperc1 = dbo.saleledger.invgstperc1,\n\t\t\tdoctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, \n         dbo.accounts.name, \n\t\t\tdbo.customer.cp,\n\t\t\tdbo.customer.address1,\n\t\t\tdbo.customer.address2,\n\t\t\tdbo.customer.city,\n\t\t\t\n         amount =  Round(Sum ( sd.looseqty * sd.saleprice), 2),    \n\t\t\titemdiscpercvalue = Round(Sum ( sd.looseqty  * ( sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01) + (sd.looseqty  * sd.itemflatdisc)), 2),    \n    \t\tinvdiscpercvalue = Round(Sum ( sd.looseqty   * (sd.saleprice - sd.itemflatdisc) * (1 - (sd.discperc * .01))) * (dbo.saleledger.discperc /100), 2),\n\t\t\titemsalestax = Sum (Round (sd.looseqty * sd.unitsalestax + Round ( Round (sd.looseqty * (sd.saleprice - sd.itemflatdisc ) * (1 - sd.discperc * 0.01 ), 2 ) * sd.gstperc * 0.01 , 2 ) , 2 ) ) ,\n\t\t\tcustrefno = dbo.saleledger.custrefno,\t       \n\t\t\tremarks = dbo.saleledger.remarks,\n\t\t\tHeaderInvNo=dbo.saleledger.HeaderInvNo,\n\t\t\tsaletyeinvno=max(saleledger.saletypeinvno)\n\t\t\t\n    FROM dbo.saleledger, \n         dbo.saleinvdetail sd,   \n         dbo.accounts, \n\t\t\tdbo.customer\n\n   WHERE DBO.SaleLedger.impactinventory = 'N' AND \n\t\t\tdbo.saleledger.saleinvcode = sd.saleinvcode and  \n\t\t\tCASE lower(:as_datetype) \n\t\t\t\t When 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t    When 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t When 'billingdate' Then dbo.saleledger.billingdate\n\t\t   END between :ad_StartDate and :ad_EndDate and\n\t\t\tdbo.saleledger.salecatcode IN (1, 2, 3) and\n\t\t\tdbo.saleledger.custcode = :al_CustCode and\n\t\t\tsaleledger.saletypecode=:al_saletypeno and\n         dbo.saleledger.custcode = dbo.accounts.acccode and\t\n         dbo.saleledger.custcode = dbo.customer.custcode \n\nGROUP BY dbo.saleledger.saleinvcode,   \n\t\t\tdbo.saleledger.HeaderInvNo,\n\t      CASE lower(:as_datetype) \n\t\t\t\t When 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t When 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t When 'billingdate' Then dbo.saleledger.billingdate\n \t\t   END\t,   \n\t\t\tdbo.saleledger.misccharges,   \n         dbo.saleledger.flatdisc,   \n   \t\tdbo.saleledger.discperc,  \n\t\t\tdbo.saleledger.salestax, \n\t\t\tdbo.saleledger.invgstperc1,\n\t\t\tdbo.saleledger.salecatcode, \n\t\t\tdbo.accounts.name,\t\n\t\t\tdbo.saleledger.custrefno,\t \n\t\t\tdbo.saleledger.remarks,\n\t\t\tdbo.customer.cp,\n\t\t\tdbo.customer.address1,\n\t\t\tdbo.customer.address2,\n\t\t\tdbo.customer.city\n         \nORDER BY \n\tinvcode ASC,   \n\tdate ASC   \n\n",
