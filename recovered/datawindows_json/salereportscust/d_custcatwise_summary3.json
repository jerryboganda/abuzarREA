    "name": "customercategory",
    "dbname": "CustomerCategory"
   }
  ],
  "retrieve": "SELECT  \n\tItemName = I.Name,\n\tAliasName= I.CustomICode, \n\tQty = SUM(SD.LooseQty),\n\tValue=SUM(SD.LooseQty * (SD.SalePrice + (SD.SalePrice * sd.GSTPerc * 0.01) ) ),\n\tInvDiscount = SUM(\n\t\t(SD.LooseQty * (SD.SalePrice + \n\t\t\t(SD.SalePrice * sd.GSTPerc * 0.01) ) ) * SL.DiscPerc * 0.01),\n\tGSTPERC=MAX(SD.GSTPerc),\n\tCustomerCategory = (SELECT CC.Name FROM CustomerCategory CC WHERE CC.CustCatCode = C.CustCatCode)\nFROM\n\tSaleLedger SL, SaleDetail SD, Customer C, Accounts A, Item I\nWHERE\n\tSL.Date BETWEEN :ar_Sdate AND :ar_Ldate AND\n\tC.CustCatCode IN (:ai_custcatcode) AND\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND\n\tSD.ICode = I.ICode\nGROUP BY\n\tC.CustCatCode,\n\tI.Name,\n\tI.CustomICode\nUNION ALL\nSELECT \n\tItemName = I.Name,\n\tAliasName= I.CustomICode, \n\tQty = SUM(SD.LooseQty),\n\tValue=SUM(SD.LooseQty * (SD.SalePrice + (SD.SalePrice * sd.GSTPerc * 0.01) ) ),\n\tInvDiscount = SUM(\n\t\t(SD.LooseQty * (SD.SalePrice + \n\t\t\t(SD.SalePrice * sd.GSTPerc * 0.01) ) ) * SL.DiscPerc * 0.01),\n\tGSTPERC=MAX(SD.GSTPerc),\n\tCustomerCategory = (SELECT CC.Name FROM CustomerCategory CC WHERE CC.CustCatCode = C.CustCatCode)\nFROM\n\tSaleLedger SL, SaleInvDetail SD, Customer C, Accounts A, Item I\nWHERE\n\tSL.ImpactInventory = 'N' AND\n\tSL.Date BETWEEN :ar_Sdate AND :ar_Ldate AND\n\tC.CustCatCode IN (:ai_custcatcode) AND\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND\n\tSD.ICode = I.ICode\nGROUP BY\n\tC.CustCatCode,\n\tI.Name,\n\tI.CustomICode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_Sdate",
      "datetime"
     ]
    },
