  ],
  "retrieve": "select\n\tcustalia=A.custalias,\n\tcustomer=A.customer,\n\tinvtotal=ISNULL(sum(A.netamount),0),\n\tcustomercategory=(select name from customercategory where custcatcode=A.Custcatcode)\nfrom\n\n(\n\tSELECT  \tsaleinvcode=SL.saleinvcode,\n\t\t\t\tcustomer=(select name from accounts where acccode=C.custCode),\n\t\t\t\tCustAlias=(select aliasname from accounts where acccode=C.custCode),\n\t\t\t\tcustcode=C.custcode,\n\t\t\t\tCustcatcode=max(C.CustCatCode),\n\t\t\t\tnetamount =  Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc   +   misccharges, 2) \n\t\t\t\t\t\t\t\t+\n\t\t\t\t\t\t\t\tRound(Sum (Round (  (SD.looseqty + SD.bonusqty)*   SD.unitsalestax + Round ( Round (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc ) * (1 -   SD.discperc * 0.01 ), 2 ) *   SD.gstperc * 0.01 , 2 ) , 2 ) )\n\t\t\t\t \t\t\t\t+  \n\t\t\t\t\t\t\t\t( (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc ,2) ) * SL.invgstperc1 * 0.01 ), 2)\n\n\tFROM Saleledger SL, Saledetail SD, Customer C\n\n\tWHERE C.custcatcode IN (:al_custcatcode) AND\n\t\t\tSL.CustCode =C.custcode AND\n\t\t\tSL.date>=:ad_startdate AND SL.date<=:ad_enddate AND\n\t\t\tSL.saleinvcode = SD.saleinvcode \n\tGROUP BY\tSL.saleinvcode,\n\t\t\tC.custCode,\n\t\t\tSL.flatdisc,\n\t\t\tSL.misccharges,\n\t\t\tSL.discperc,\n\t\t\tSL.invgstperc1) AS A\n\ngroup by \n\t A.CustCatCode,\n\t A.custcode,\n\t A.customer,\n\t A.custalias\nUNION ALL\nselect\n\tcustalia=A.custalias,\n\tcustomer=A.customer,\n\tinvtotal=ISNULL(sum(A.netamount),0),\n\tcustomercategory=(select name from customercategory where custcatcode=A.Custcatcode)\nfrom\n\n(\n\tSELECT  \tsaleinvcode=SL.saleinvcode,\n\t\t\t\tcustomer=(select name from accounts where acccode=C.custCode),\n\t\t\t\tCustAlias=(select aliasname from accounts where acccode=C.custCode),\n\t\t\t\tcustcode=C.custcode,\n\t\t\t\tCustcatcode=max(C.CustCatCode),\n\t\t\t\tnetamount =  Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc   +   misccharges, 2) \n\t\t\t\t\t\t\t\t+\n\t\t\t\t\t\t\t\tRound(Sum (Round (  (SD.looseqty + SD.bonusqty)*   SD.unitsalestax + Round ( Round (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc ) * (1 -   SD.discperc * 0.01 ), 2 ) *   SD.gstperc * 0.01 , 2 ) , 2 ) )\n\t\t\t\t \t\t\t\t+  \n\t\t\t\t\t\t\t\t( (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc ,2) ) * SL.invgstperc1 * 0.01 ), 2)\n\n\tFROM Saleledger SL, Saleinvdetail SD, Customer C\n\n\tWHERE C.custcatcode IN (:al_custcatcode) AND\n\t\t\tSL.CustCode =C.custcode AND\n\t\t\tSL.date>=:ad_startdate AND SL.date<=:ad_enddate AND\n\t\t\tSL.saleinvcode = SD.saleinvcode \n\tGROUP BY\tSL.saleinvcode,\n\t\t\tC.custCode,\n\t\t\tSL.flatdisc,\n\t\t\tSL.misccharges,\n\t\t\tSL.discperc,\n\t\t\tSL.invgstperc1) AS A\n\ngroup by \n\t A.CustCatCode,\n\t A.custcode,\n\t A.customer,\n\t A.custalias\n\nOrder by CustomerCategory, \n\t     A.customer\n\n\n\n\n\n\n/*select\n\tcustalia=A.custalias,\n\tcustomer=A.customer,\n\tinvtotal=ISNULL(sum(A.netamount),0),\n\tcustomercategory=(select name from customercategory where custcatcode=A.Custcatcode)\nfrom\n\n(\n\tSELECT  \tsaleinvcode=SL.saleinvcode,\n\t\t\t\tcustomer=(select name from accounts where acccode=C.custCode),\n\t\t\t\tCustAlias=(select aliasname from accounts where acccode=C.custCode),\n\t\t\t\tcustcode=C.custcode,\n\t\t\t\tCustcatcode=max(C.CustCatCode),\n\t\t\t\tnetamount =  Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc   +   misccharges, 2) \n\t\t\t\t\t\t\t\t+\n\t\t\t\t\t\t\t\tRound(Sum (Round (  (SD.looseqty + SD.bonusqty)*   SD.unitsalestax + Round ( Round (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc ) * (1 -   SD.discperc * 0.01 ), 2 ) *   SD.gstperc * 0.01 , 2 ) , 2 ) )\n\t\t\t\t \t\t\t\t+  \n\t\t\t\t\t\t\t\t( (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc ,2) ) * SL.invgstperc1 * 0.01 ), 2)\n\n\tFROM Saleledger SL, Saledetail SD, Customer C\n\n\tWHERE C.custcatcode IN (:al_custcatcode) AND\n\t\t\tSL.CustCode =C.custcode AND\n\t\t\tSL.date>=:ad_startdate AND SL.date<=:ad_enddate AND\n\t\t\tSL.saleinvcode = SD.saleinvcode \n\tGROUP BY\tSL.saleinvcode,\n\t\t\tC.custCode,\n\t\t\tSL.flatdisc,\n\t\t\tSL.misccharges,\n\t\t\tSL.discperc,\n\t\t\tSL.invgstperc1) AS A\n\ngroup by \n\t A.CustCatCode,\n\t A.custcode,\n\t A.customer,\n\t A.custalias\nOrder by CustomerCategory, \n\t     A.customer\n\n*/\n",
