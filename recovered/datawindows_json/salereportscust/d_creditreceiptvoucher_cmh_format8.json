  "retrieve": "SELECT\n\tWard = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),\n\titemname = item.name,\n\tpacking = dbo.item.packingdesc,\n\tmanufacurer = (dbo.manufacturer.name),\n\tlooseqty = Sum (dbo.saledetail.looseqty),\n\tprice = max(dbo.saledetail.saleprice),    \n\tid = max(dbo.saledetail.rowid), \n\tcumulativesum = round(0.00,2),\n\tcumulativesumfoot = round(0.00,2)\nFROM \t \n\tdbo.saleledger, \n\tdbo.saledetail,    \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Accounts,\n\tdbo.Manufacturer \nWHERE  \n\t:as_doctype = 'originaldate' AND\n\tdbo.saleledger.originaldate >= :ad_StartDate AND\n\tdbo.saleledger.originaldate <= :ad_EndDate  AND \n\tdbo.saleledger.custcode IN ( :al_custcode ) AND\n\tdbo.saleledger.salecatcode IN (1, 2, 3) AND\n\tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\tdbo.saledetail.icode = item.icode AND\n\tdbo.saleledger.custcode = dbo.customer.custcode AND\n\tdbo.customer.custcode = dbo.accounts.acccode AND\n\tdbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\tdbo.saleledger.wardcode,\n\tdbo.saledetail.icode,\n\tdbo.item.name,\n\tdbo.item.packingdesc,\n\tdbo.manufacturer.name\nUNION ALL\nSELECT \n\tWard = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),\n\titemname = item.name,\n\tpacking = dbo.item.packingdesc,\n\tmanufacurer = (dbo.manufacturer.name),\n\tlooseqty = Sum (sd.looseqty),\n\tprice = max(sd.saleprice),    \n\tid = max(sd.rowid), \n\tcumulativesum = round(0.00,2),\n\tcumulativesumfoot = round(0.00,2)\nFROM \t \n\tdbo.saleledger, \n\tdbo.saleinvdetail sd,    \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Accounts,\n\tdbo.Manufacturer \nWHERE  \n\t:as_doctype = 'originaldate' AND\n\tdbo.saleledger.impactinventory = 'N' AND\n\tdbo.saleledger.originaldate >= :ad_StartDate AND\n\tdbo.saleledger.originaldate <= :ad_EndDate  AND \n\tdbo.saleledger.custcode IN ( :al_custcode ) AND\n\tdbo.saleledger.salecatcode IN (1, 2, 3) AND\n\tdbo.saleledger.saleinvcode = sd.saleinvcode AND\n\tsd.icode = item.icode AND\n\tdbo.saleledger.custcode = dbo.customer.custcode AND\n\tdbo.customer.custcode = dbo.accounts.acccode AND\n\tdbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\tdbo.saleledger.wardcode,\n\tsd.icode,\n\tdbo.item.name,\n\tdbo.item.packingdesc,\n\tdbo.manufacturer.name\nUNION \nSELECT \n\tWard = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),\n\titemname = item.name,\n\tpacking = dbo.item.packingdesc,\n\tmanufacurer = (dbo.manufacturer.name),\n\tlooseqty = Sum (dbo.saledetail.looseqty),\n\tprice = max(dbo.saledetail.saleprice),    \n\tid = max(dbo.saledetail.rowid), \n\tcumulativesum = round(0.00,2),\n\tcumulativesumfoot = round(0.00,2)\nFROM\n\tdbo.saleledger, \n\tdbo.saledetail,    \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Accounts,\n\tdbo.Manufacturer \nWHERE  \n\t:as_doctype = 'billingdate' AND\n\tdbo.saleledger.billingdate >= :ad_StartDate AND\n\tdbo.saleledger.billingdate <= :ad_EndDate  AND \n\tdbo.saleledger.custcode IN ( :al_custcode ) AND\n\tdbo.saleledger.salecatcode IN (1, 2, 3) AND\n\tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\tdbo.saledetail.icode = item.icode AND\n\tdbo.saleledger.custcode = dbo.customer.custcode AND\n\tdbo.customer.custcode = dbo.accounts.acccode AND\n\tdbo.Item.manfcode = dbo.manufacturer.manfcode\nGroup by \n\tdbo.saleledger.wardcode,\n\tdbo.saledetail.icode,\n\tdbo.item.name,\n\tdbo.item.packingdesc,\n\tdbo.manufacturer.name\nUNION ALL\nSELECT \n\tWard = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),\n\titemname = item.name,\n\tpacking = dbo.item.packingdesc,\n\tmanufacurer = (dbo.manufacturer.name),\n\tlooseqty = Sum (sd.looseqty),\n\tprice = max(sd.saleprice),    \n\tid = max(sd.rowid), \n\tcumulativesum = round(0.00,2),\n\tcumulativesumfoot = round(0.00,2)\nFROM \t \n\tdbo.saleledger, \n\tdbo.saleinvdetail sd,    \n\tdbo.item, \n\tdbo.Customer,\n\tdbo.Accounts,\n\tdbo.Manufacturer \nWHERE  \n\t:as_doctype = 'billingdate' AND\n\tdbo.saleledger.i