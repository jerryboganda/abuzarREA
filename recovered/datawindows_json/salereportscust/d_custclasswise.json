  "retrieve": "  SELECT \n\t    Class.name,\n\t\t customer=accounts.name,\n\t\t netsaleqty=ISNULL((select sum(saledetail.looseqty) \n                 \t\t  from saledetail,saleledger,item\n\t\t\t\t  where saleledger.custcode=customer.custcode and\n\t\t\t\t  saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t  saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t  saledetail.icode=item.icode and\n\t\t\t\t  item.iccode=Class.iccode),0)\n\t\t\t\t  \n\t\t\t\t  +\n\t\t\t\t  \n\t\t\t\t\tISNULL((select sum(saledetail.looseqty) \n                 \t\t  from saleinvdetail saledetail,saleledger,item\n\t\t\t\t  where \n\t\t\t\t  saleledger.impactinventory = 'N' AND\n\t\t\t\t  saleledger.custcode=customer.custcode and\n\t\t\t\t  saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t  saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t  saledetail.icode=item.icode and\n\t\t\t\t  item.iccode=Class.iccode),0)\t\t\t\t  \n\t\t\t\t  -\n\n\t\t\n\t\t\t\tISNULL((select sum(srdetail.looseqty) \n               \t\t\t\tfrom srdetail,srledger,item\n\t\t\t\t\twhere srledger.custcode=customer.custcode and\n\t\t\t\t\tsrledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\tsrledger.srinvcode=srdetail.srinvcode and\n\t\t\t\t\tsrdetail.icode=item.icode and\n\t\t\t\t  \titem.iccode=Class.iccode\n\t\t\t\t\t\t),0)/*,\n\n\t\tnetvalue=ISNULL((select IsNull( sum(Round(((saledetail.looseqty + saledetail.packqty * saledetail.packunits) * (saledetail.saleprice - saledetail.itemflatdisc)),2) * (1 - (.01 * saledetail.discperc)) * (1- (.01 * saleledger.discperc))) ,0) \n                 \t\t  from saledetail,saleledger,item\n\t\t\t\t  where saleledger.custcode=customer.custcode and\n\t\t\t\t  saleledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t  saleledger.saleinvcode=saledetail.saleinvcode and\n\t\t\t\t  saledetail.icode=item.icode and\n\t\t\t\t  item.iccode=Class.iccode),0)  -\n\n\t\t\n\t\t\t\tISNULL((select IsNull( sum(Round(((srdetail.looseqty + srdetail.packqty * srdetail.packunits) * srdetail.srprice) * (1 - (.01 * srdetail.discperc)),2) * (1- (.01 * srledger.discperc))) ,0) \n               \t\t\t\tfrom srdetail,srledger,item\n\t\t\t\t\twhere srledger.custcode=customer.custcode and\n\t\t\t\t\tsrledger.date between :ad_sdate and :ad_ldate and\n\t\t\t\t\tsrledger.srinvcode=srdetail.srinvcode and\n\t\t\t\t\tsrdetail.icode=item.icode and\n\t\t\t\t  \titem.iccode=Class.iccode\n\t\t\t\t\t\t),0)*/\n\nFROM accounts,\n\t  customer,\n\t  (SELECT * FROM itemclass  WHERE iccode IN (:aa_classcode) ) AS Class\nWHERE accounts.acccode=customer.custcode",
