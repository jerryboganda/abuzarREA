  ],
  "retrieve": "SELECT \n\tManufacturer=M.Name,\n\tAliasName = I.CustomICode,\n\tItemName = I.Name,\n\tSalesMan = S.Name,\n\tSaleQty = SUM(T.SaleQty),\n\tCustomerCount = COUNT(DISTINCT T.CustCode)\nFROM\n\tManufacturer M,\n\tItem I,\n\tSalesman S,\n\t(SELECT \n\t\tI.ManfCode,\n\t\tS.SalesManCode,\n\t\tI.ICode,\n\t\tSS.SubAreaCode,\n\t\tSL.CustCode,\n\t\tSaleQty = SUM(SD.LooseQty + SD.BonusQty)\n\tFROM\n\t\tSaleLedger SL,\n\t\tSaleDetail SD,\n\t\tItem I,\n\t\tSalesMan S,\n\t\tCustomer C,\n\t\t(SELECT DISTINCT ManfCode, SalesManCode, SubAreaCode FROM SalesManScope) SS\n\tWHERE\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.Posted = 'Y' AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.SubAreaCode = SS.SubAreaCode AND\n\t\tSS.SalesManCode = S.SalesManCode AND\n\t\tS.SalesManCode IN (:ai_salesmancode) AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode IN (:ai_manfcode) AND\n\t\tI.ManfCode = SS.ManfCode\n\tGROUP BY \n\t\tI.ManfCode,\n\t\tS.SalesManCode,\n\t\tI.ICode,\n\t\tSS.SubAreaCode,\n\t\tSL.CustCode\n\tUNION ALL\n\tSELECT \n\t\tI.ManfCode,\n\t\tS.SalesManCode,\n\t\tI.ICode,\n\t\tSS.SubAreaCode,\n\t\tSL.CustCode,\n\t\tSaleQty = SUM(SD.LooseQty + SD.BonusQty)\n\tFROM\n\t\tSaleLedger SL,\n\t\tSaleInvDetail SD,\n\t\tItem I,\n\t\tSalesMan S,\n\t\tCustomer C,\n\t\t(SELECT DISTINCT ManfCode, SalesManCode, SubAreaCode FROM SalesManScope) SS\n\tWHERE\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.Posted = 'Y' AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.SubAreaCode = SS.SubAreaCode AND\n\t\tSS.SalesManCode = S.SalesManCode AND\n\t\tS.SalesManCode IN (:ai_salesmancode) AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode IN (:ai_manfcode) AND\n\t\tI.ManfCode = SS.ManfCode\n\tGROUP BY \n\t\tI.ManfCode,\n\t\tS.SalesManCode,\n\t\tI.ICode,\n\t\tSS.SubAreaCode,\n\t\tSL.CustCode\n\tUNION ALL\n\tSELECT \n\t\tI.ManfCode,\n\t\tS.SalesManCode,\n\t\tI.ICode,\n\t\tSS.SubAreaCode,\n\t\tSL.CustCode,\n\t\tSaleQty = - SUM(SD.LooseQty + SD.BonusQty)\n\tFROM\n\t\tSRLedger SL,\n\t\tSRDetail SD,\n\t\tItem I,\n\t\tSalesMan S,\n\t\tCustomer C,\n\t\t(SELECT DISTINCT ManfCode, SalesManCode, SubAreaCode FROM SalesManScope) SS\n\tWHERE\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.Posted = 'Y' AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.SubAreaCode = SS.SubAreaCode AND\n\t\tSS.SalesManCode = S.SalesManCode AND\n\t\tS.SalesManCode IN (:ai_salesmancode) AND\n\t\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode IN (:ai_manfcode) AND\n\t\tI.ManfCode = SS.ManfCode\n\tGROUP BY \n\t\tI.ManfCode,\n\t\tS.SalesManCode,\n\t\tI.ICode,\n\t\tSS.SubAreaCode,\n\t\tSL.CustCode) T\nWHERE\n\tT.ManfCode = M.ManfCode AND\n\tT.ICode = I.ICode AND\n\tT.SalesManCode = S.SalesManCode\nGROUP BY\n\tM.Name,\n\tI.CustomICode,\n\tI.Name,\n\tS.Name\n",
  "arguments": {
