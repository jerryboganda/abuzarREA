  ],
  "retrieve": "SELECT aliasname=item.customicode,\n\titemname=item.name,\n\tmanufacturer=(select name from manufacturer where manufacturer.manfcode=item.manfcode),\n\tunitprice=item.saleprice/item.packunits,\n\tsoldqty=A.saleqty, \n\tsalevalue=A.saleqty  * item.saleprice/item.packunits,\n\tcustomer=(select name from accounts where accounts.acccode=:ai_custcode)\nFROM Item,\n\t(select itemcode=saledetail.icode,\n\t\tsaleqty=sum(looseqty)\n\tfrom saleledger,saledetail\n\twhere saleledger.custcode=:ai_custcode and\n      \t\tsaleledger.originaldate>=:ad_startdate and \n\t\t\t\tsaleledger.originaldate<=:ad_enddate  and\n\t\t\t\tsaleledger.saleinvcode=saledetail.saleinvcode\n\tgroup by icode\n\tUNION ALL\n\tselect itemcode=saledetail.icode,\n\t\tsaleqty=sum(looseqty)\n\tfrom saleledger,saleinvdetail saledetail\n\twhere saleledger.custcode=:ai_custcode and\n\t\t\tSaleLedger.impactinventory = 'N' AND\n      \tsaleledger.originaldate>=:ad_startdate and \n\t\t\tsaleledger.originaldate<=:ad_enddate  and\n\t\t\tsaleledger.saleinvcode=saledetail.saleinvcode\n\tgroup by icode) AS A\nWHERE Item.icode=A.itemcode\nORDER BY item.name\n\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_custcode",
      "number"
     ]
    },
    {
     "_items": [
      "ad_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_EndDate",
      "datetime"
     ]
    }
   ]
  }
 },
