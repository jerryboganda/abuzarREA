    "name": "netsalevolume",
    "dbname": "netsalevolume"
   }
  ],
  "retrieve": "SELECT\n\tItemClass=IC.Name,\n\tSubAreaName=AR.Name,\n\tCustomerAlias=A.AliasName,\n\tCustomer=A.Name,\n\tAddress=C.Address1,\n\tNetSale=ISNULL(SUM(S.NetSale), 0),\n\tNetSaleVolume=ISNULL(SUM(S.NetSaleVolume), 0)\nFROM\n\tItemClass IC,\n\tSubArea AR, \n\tCustomer C,\n\tAccounts A,\n\t(SELECT\n\t\tC.CustCode,\n\t\tICCode=(SELECT MIN(ICCODE) FROM ITEM WHERE ICCODE IN (:ai_iccode)),\n\t\tNetSale = 0,\n\t\tNetSaleVolume = 0\n\tFROM Customer C, ItemClass IC\n\tWHERE C.SubAreaCode IN (:ai_subareacode) AND\n\t\tIC.ICCode IN (:ai_iccode)\n\tUNION ALL\n\tSELECT\n\t\tS.CustCode,\n\t\tICCode=I.ICCode,\n\t\tNetSale = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),\n\t\tNetSaleVolume = SUM(SD.LooseQty * I.PackingFactor)\n\tFROM\n\t\tSaleLedger S, SaleDetail SD, Item I, Customer C\n\tWHERE \n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tC.AreaCode IN (:ai_subareacode) AND\n\t\tC.CustCode = S.CustCode AND\n\t\tS.SaleInvCode = SD.SaleInvCode AND \n\t\tSD.ICode = I.ICode AND I.ICCODE IN (:ai_iccode)\n\tGROUP BY\n\t\tS.CustCode,\n\t\tI.ICCode\n\tUNION ALL\n\tSELECT\n\t\tS.CustCode,\n\t\tICCode=I.ICCode,\n\t\tNetSale = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),\n\t\tNetSaleVolume = SUM(SD.LooseQty * I.PackingFactor)\n\tFROM\n\t\tSaleLedger S, SaleInvDetail SD, Item I, Customer C\n\tWHERE \n\t\tS.ImpactInventory = 'N' AND\n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tC.AreaCode IN (:ai_subareacode) AND\n\t\tC.CustCode = S.CustCode AND\n\t\tS.SaleInvCode = SD.SaleInvCode AND \n\t\tSD.ICode = I.ICode AND I.ICCODE IN (:ai_iccode)\n\tGROUP BY\n\t\tS.CustCode,\n\t\tI.ICCode\n\tUNION ALL\n\tSELECT\n\t\tS.CustCode,\n\t\tICCode=I.ICCode,\n\t\tNetSale = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),\n\t\tNetSaleVolume = - SUM(SD.LooseQty * I.PackingFactor)\n\tFROM\n\t\tSRLedger S, SRDetail SD, Item I, Customer C\n\tWHERE \n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tC.AreaCode IN (:ai_subareacode) AND\n\t\tC.CustCode = S.CustCode AND\n\t\tS.SRInvCode = SD.SRInvCode AND \n\t\tSD.ICode = I.ICode AND I.ICCODE IN (:ai_iccode)\n\tGROUP BY\n\t\tS.CustCode,\n\t\tI.ICCode) S\nWHERE\n\tAR.SubAreaCode IN (:ai_subareacode) AND\n\tAR.SubAreaCode = C.SubAreaCode AND\n\tC.CustCode = A.AccCode AND\n\tC.CustCode = S.CustCode AND\n\tIC.ICCODE IN (:ai_iccode) AND\n\tIC.ICCode = S.ICCODE\nGROUP BY\n\tIC.Name,\n\tAR.Name,\n\tA.Name,\n\tA.AliasName,\n\tC.Address1\nORDER BY\n\tItemClass,\n\tSubAreaName,\n\tCustomer\n",
  "arguments": {
   "_items": [
