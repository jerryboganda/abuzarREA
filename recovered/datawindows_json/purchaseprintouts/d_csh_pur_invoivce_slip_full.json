 "table": {
  "columns": [
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "purinvcode",
    "dbname": "Purledger.PurinvCode"
   },
   {
    "type": "datetime",
    "updatewhereclause": "yes",
    "name": "date",
    "dbname": "Purledger.Date"
   },
   {
    "type": "char(100)",
    "updatewhereclause": "yes",
    "name": "suppinvcode",
    "dbname": "Purledger.SuppinvCode"
   },
   {
    "type": "datetime",
    "updatewhereclause": "yes",
    "name": "suppinvdate",
    "dbname": "Purledger.SuppInvDate"
   },
   {
    "type": "char(12)",
    "updatewhereclause": "yes",
    "name": "aliasname",
    "dbname": "AliasName"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "supplier",
    "dbname": "Supplier"
   },
   {
    "type": "char(1)",
    "updatewhereclause": "yes",
    "name": "posted",
    "dbname": "Purledger.Posted"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "saletax",
    "dbname": "SaleTax"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "gross",
    "dbname": "Gross"
   },
   {
    "type": "char(100)",
    "updatewhereclause": "yes",
    "name": "remarks",
    "dbname": "Purledger.Remarks"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "samt",
    "dbname": "SAmt"
   },
   {
    "type": "datetime",
    "updatewhereclause": "yes",
    "name": "duedate",
    "dbname": "DueDate"
   }
  ],
  "retrieve": "SELECT \n\tH.PurinvCode, \n\tH.Date, \n\tH.SuppinvCode,\n\tH.SuppInvDate,\n\tAliasName = A.aliasname,\n\tSupplier = A.name,\n\tH.Posted, \n\tSaleTax=ROUND(\n\t\t\tSUM((D.looseqty + D.packqty + D.bonusqty) *\n\t\t\t\tD.unitsalestax) +\n\t\t\tSUM(ROUND((D.looseqty + D.packqty) * D.purprice * \n\t\t\t\t(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +\n\t\t\tROUND((SUM(((D.looseqty + D.packqty) * D.purprice) * \n\t\t\t\t(1 - (.01 * D.discperc))) * \n\t\t\t\t(1- (.01 * H.discperc)) - H.flatdisc) * \n\t\t\t\t(H.invgstperc1 * .01), 2), ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)),\n\tGross=  ROUND(SUM((D.looseqty + D.packqty) * D.purprice * \n\t\t\t(1 - (.01 * D.discperc))) * (1- (.01 * H.discperc)) + \n\t\t\tH.misccharges + H.salestax - H.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)),\n\tH.Remarks,\n\tSAmt=max(H.suppinvamount),\n\tDueDate=DateAdd(dd,max(H.creditdays),H.date)\nFROM \n\tPurledger H, Purdetail D, Accounts A\nWHERE \n\tH.PurInvCode = :ai_invcode AND\n\tH.Purinvcode = D.Purinvcode AND\n\tH.SuppCode = A.AccCode\nGROUP BY\n\tH.PurinvCode,\n\tH.Date,\n\tH.SuppinvCode,\n\tH.SuppInvDate,\n\tH.Posted,\n\tH.DiscPerc,\n\tH.FlatDisc,\n\tH.InvGSTPerc1,\n\tH.SalesTax,\n\tH.MiscCharges,\n\tH.Remarks,\n\tA.AliasName,\n\tA.name\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_invcode",
      "number"
     ]
    }
   ]
  }
 },
