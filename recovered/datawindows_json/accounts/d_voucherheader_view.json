  "retrieve": "SELECT\n\tdbo.glheader.glvochcode ,\n\tdbo.glheader.vouchercode,\n\tdbo.glheader.acccode,\n\tJV = (SELECT VC.JournalVoucher FROM VocherCategory VC WHERE VC.VochCatCode = dbo.glheader.vochcatcode),\n\taccount = (SELECT A.Name FROM Accounts A WHERE A.AccCode = dbo.glheader.acccode),\n\tremarks='                                                                               ',\n\tdbo.glheader.vochcatcode ,\n\tdbo.glheader.salesmancode ,\n\tdbo.glheader.date ,\n\tdbo.glheader.posted ,\n\tdbo.glheader.postdate ,\n\tdbo.users.username,\n\tdbo.glheader.originaldate,\n\tdbo.glheader.modifiedby,\n\tdbo.glheader.postedby,\n\tdbo.glheader.chkno,\n\tdbo.glheader.smancode,\n\tdbo.glheader.currencycode,\n\tdbo.glheader.conversionrate\nFROM \n\tdbo.glheader ,\n\tdbo.users     \nWHERE \n\t( dbo.glheader.salesmancode = dbo.users.usercode ) and  \n\t( dbo.glheader.glvochcode = :ar_VoucherCode )    ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_VoucherCode",
      "number"
     ]
    }
   ]
  }
