    "values": "Yes\t1/\t0/"
   }
  ],
  "retrieve": "SELECT\n\tVocherCategoryDetail.VochCatCode,   \n\tVocherCategoryDetail.SubAccCode,\n\tName=SubAccounts.Name,\n\tCategory=CategoryAccounts.Name,\n\tMainAccount=MainAccounts.Name,\n\tSelected=1\nFROM\n\tVocherCategoryDetail, SubAccounts, CategoryAccounts, MainAccounts\nWHERE\n\tVocherCategoryDetail.VochCatCode = :ai_vochcatcode AND\n\tSubAccounts.SubAccCode = VocherCategoryDetail.SubAccCode AND\n\tSubAccounts.CatAccCode = CategoryAccounts.CatAccCode AND\n\tCategoryAccounts.MainAccCode = MainAccounts.MainAccCode\nUNION ALL\nSELECT\n\tVochCatCode=:ai_vochcatcode,   \n\tSubAccounts.SubAccCode,\n\tName=SubAccounts.Name,\n\tCategory=CategoryAccounts.Name,\n\tMainAccount=MainAccounts.Name,\n\tSelected=0\nFROM\n\tSubAccounts, CategoryAccounts, MainAccounts\nWHERE\n\tSubAccounts.SubAcccode NOT IN \n\t\t(SELECT VocherCategoryDetail.SubAccCode \n\t\tFROM VocherCategoryDetail  \n\t\tWHERE VocherCategoryDetail.VochCatCode = :ai_vochcatcode) AND\n\tSubAccounts.CatAccCode = CategoryAccounts.CatAccCode AND\n\tCategoryAccounts.MainAccCode = MainAccounts.MainAccCode\nORDER BY \n\tName,\n\tVochCatCode\n",
  "update": "VocherCategoryDetail",
  "updatewhere": "0",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_vochcatcode",
