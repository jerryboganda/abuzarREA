  "retrieve": "SELECT \n\tTransactionCategory=TC.Name,\n\tTransactionType=TT.Name,\n\tShortName=TT.ShortName,\n\tDocumentCode=TH.DocumentCode,\n\tTansactionTypeCode=TH.TransactionTypeCode,\n\tTransactionCode=TH.TransactionCode,\n\tDate=TH.Date,\n\tUserCode=TH.UserCode,\n\tRemarks=TH.Remarks,\n\tPatientCode=TH.PatientCode,\n\tPatientName=(SELECT P.Name FROM Patient P WHERE TH.PatientCode=P.PatientCode),\n\tAdmissionCode=TH.AdmissionCode,\n\tAccCode=TH.AccCode,\n\tAccountName=(SELECT A.Name FROM Accounts A WHERE TH.AccCode=A.AccCode),\n\tCashCharged=TH.CashCharged,\n\tPosted=TH.Posted\nFROM \n\tTransactionCategory TC,\n\tTransactionType TT,\n\tTransactionHeader TH\nWHERE \n\tTH.TransactionTypeCode = TT.TransactionTypeCode and\n\tTT.TransactionCatCode = TC.TransactionCatCode AND\n\tTT.TransactionCatCode = :ai_transactioncatcode\nORDER BY\n\tTH.DocumentCode DESC",
  "arguments": {
