   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "camount",
    "dbname": "amount"
   }
  ],
  "retrieve": "  SELECT VocherCategory.Name,   \n         GLDetail.GLVochCode,   \n         Glheader.Date,   \n         Accounts_a.Name,   \n         Accounts_b.Name,   \n         GLDetail.ChkNo,   \n         amount = GLDetail.Credit + GLDetail.Debit    \n    FROM GLDetail,   \n         Glheader,   \n         VocherCategory,   \n         Accounts Accounts_a,   \n         Accounts Accounts_b  \n   WHERE ( Glheader.GLVochCode = GLDetail.GLVochCode ) and  \n         ( VocherCategory.VochCatCode = Glheader.VochCatCode ) and  \n         ( Glheader.AccCode = Accounts_a.AccCode ) and  \n         ( GLDetail.AccCode = Accounts_b.AccCode ) and  \n         ( dbo.glheader.acccode <> dbo.gldetail.acccode ) AND  \n         ( Glheader.GLVochCode = :vno)    \n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "vno",
      "number"
     ]
    }
   ]
  },
  "sort": "accounts_name A"
 },
