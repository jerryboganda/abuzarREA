  "retrieve": "SELECT \n\tAccounts.Name,\n\tAccounts.AliasName,\n\tGlheader.vochcatcode,   \n\tGLDetail.Debit,   \n\tGLDetail.Credit,   \n\tGLDetail.ChkNo,   \n\tremarks=(case when glheader.acccode<>gldetail.acccode then GLDetail.Remarks else '' end),   \n\tGlheader.Posted,\n\tGlheader.Date,   \n\tGlheader.Remarks,   \n\tVocherCategory.Name,   \n\tUsers.UserName,   \n\tGlheader.GLVochCode,\n\tGlheader.VoucherCode,\n\tCreditorDebit = Case GLDetail.Debit When 0 Then 'C' Else 'D' End,\n\tgldetail.glrowid,\n\tInvoiceCode=GLDetail.InvoiceCode,\n\tOutstandingamt = GLDetail.Outstandingamt,\n\tInvoiceBased=VocherCategory.InvoiceBased,\n\tStudentRegNo = (SELECT S.Regno FROM Student S WHERE S.Studentcode = GLDetail.StudentCode),\n\tStudentName = (SELECT S.Name FROM Student S WHERE S.Studentcode = GLDetail.StudentCode),\n\tClass = (SELECT C.Name \n\t\tFROM Student S, Class C, StudentClass SC\n\t\tWHERE S.Studentcode = GLDetail.StudentCode AND \n\t\t\tS.CurrentClass=C.ClassCode AND\n\t\t\tC.ClassCode = SC.ClassCode AND\n\t\t\tS.Studentcode = SC.Studentcode),\n\tRollNo = (SELECT SC.RollNo \n\t\tFROM Student S, Class C, StudentClass SC\n\t\tWHERE S.Studentcode = GLDetail.StudentCode AND \n\t\t\tS.CurrentClass=C.ClassCode AND\n\t\t\tC.ClassCode = SC.ClassCode AND\n\t\t\tS.Studentcode = SC.Studentcode)\nFROM \n\tGLDetail,   \n\tGlheader,   \n\tAccounts,   \n\tVocherCategory,   \n\tUsers  \nWHERE \n\t( Glheader.GLVochCode = GLDetail.GLVochCode ) and  \n\t( Accounts.AccCode = GLDetail.AccCode ) and  \n\t( VocherCategory.VochCatCode = Glheader.VochCatCode ) and  \n\t( Users.UserCode = Glheader.salesmancode ) and  \n\t( Glheader.GLVochCode = :ar_code ) AND\n\t( Glheader.AccCode <> GLDetail.AccCode )",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_code",
      "number"
     ]
    }
   ]
  }
 },
