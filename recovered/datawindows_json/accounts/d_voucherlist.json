   }
  ],
  "retrieve": "SELECT\n\tdbo.glheader.glvochcode ,\n\tdbo.glheader.vouchercode ,\n\tdbo.glheader.date,\n\taccountname= (SELECT CASE WHEN VC.JournalVoucher=1 THEN '' ELSE dbo.accounts.name END FROM VocherCategory VC WHERE VC.VochCatCode=glheader.vochcatcode),\n\tdbo.glheader.posted,\n\tdbo.glheader.postdate,\n\tUserName = IsNull((Select username from users\n\t\t\t\t\t\t\t\twhere dbo.glheader.salesmancode = users.usercode), ''),\n\tVoucherCategory = (SELECT Name FROM VocherCategory \n\t\t\t\t\t\t\t\tWHERE VocherCategory.VochCatCode = :ai_VochCatCode),\n\tPostedBy = IsNull((Select username from users\n\t\t\t\t\t\t\t\twhere dbo.glheader.postedby = users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users\n\t\t\t\t\t\t\t\t\twhere dbo.glheader.modifiedby = users.usercode), ''),\n\tRemarks=glheader.remarks\nFROM\n\tdbo.glheader,\n\tdbo.accounts     \nWHERE \n\tdbo.glheader.acccode = dbo.accounts.acccode AND\n\tdbo.glheader.vochcatcode = :ai_vochcatcode AND\n\tdbo.glheader.posted IN (:as_posted) AND\n\tdbo.glheader.salesmancode = \n\t\tCASE (SELECT 'Y' FROM GroupRights WHERE GroupCode = :gl_groupcode AND RightCode = 606) \n\t\tWHEN 'Y' THEN dbo.glheader.salesmancode ELSE :gl_usercode END\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_vochcatcode",
      "number"
     ]
    },
    {
     "_items": [
      "as_posted",
      "stringlist"
     ]
    },
    {
     "_items": [
      "gl_groupcode",
      "number"
     ]
    },
    {
     "_items": [
      "gl_usercode",
      "number"
     ]
    }
   ]
  }
 },
