  "retrieve": "SELECT  \n\tpurledger.purinvcode,\n\tPreSaleInvCode = (SELECT MIN(PSD.PreSaleInvCode) FROM PreSaleDetail PSD WHERE PSD.PurInvCode=purledger.purinvcode),\n\tContainerNo = (SELECT MIN(PS.CustRefNo) FROM PreSaleDetail PSD, PreSaleHeader PS WHERE PSD.PurInvCode=purledger.purinvcode AND PSD.PreSaleInvCode = PS.PreSaleInvCode),\n\tItemDescription = (SELECT MIN(PSD.ItemDescription) FROM PreSaleDetail PSD WHERE PSD.PurInvCode=purledger.purinvcode),\n\tQty = (SELECT SUM(PSD.Qty) FROM PreSaleDetail PSD WHERE PSD.PurInvCode=purledger.purinvcode),\n\tNewPurchaseOrderNo=purledger.NewPurchaseOrderNo,\n\tPhone=(SELECT S.Phone FROM Supplier S WHERE purledger.SuppCode=S.SuppCode),\n\tpurledger.date,\n\tsuppcode=purledger.suppcode,\n\tdbo.purledger.suppinvcode, \n\tdbo.purledger.suppinvdate, \n\tdbo.purledger.GRN, \n\tdbo.purledger.invtotal,\n\tOutStandingAmt = dbo.purledger.OutStandingAmt,\n\taccounts.name, \n\tprintcounter=purledger.printcounter,\n\tusername=(select username from users where users.usercode=purledger.salesmancode),\n\tposted = purledger.posted,\n\tPostedBy = IsNull((Select username from users \n\t\twhere dbo.purledger.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\twhere dbo.purledger.modifiedby = dbo.users.usercode), ''),\n\tRemarks = purledger.remarks ,\n\tpurchasetype=(select name from purchasetype where purchasetype.purtypecode=purledger.purtypecode)\nFROM  \n\tpurledger ,  \n\taccounts,\n\tusers\nWHERE  \n\t( purledger.AccountFor = 'Y' ) AND\n\t( purledger.suppcode = accounts.acccode ) and \n\t( purledger.purcatcode <> 3 )  and\n\t( Posted = 'Y' ) AND\n\t( purledger.salesmancode = users.usercode )\n",
  "sort": "presaleinvcode A, containerno A, code A"
 },
