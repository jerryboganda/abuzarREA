    "name": "balance",
    "dbname": "Balance"
   }
  ],
  "retrieve": "SELECT\n\tSummaryAccount = \n\t\tCASE \n\t\tWHEN (SELECT Count(SD.AccCode) \n\t\t\t\tFROM SummaryAccountDetail SD \n\t\t\t\tWHERE SD.AccCode = A.AccCode) = 0 THEN NULL \n\t\tELSE\n\t\t\t(SELECT MAX(SA.Name) + ' (' + MAX(SA.AliasName) + ')' \n\t\t\tFROM SummaryAccount SA, SummaryAccountDetail SD \n\t\t\tWHERE SD.AccCode = A.AccCode AND \n\t\t\t\tSD.SummaryAccCode = SA.SummaryAccCode)\n\t\tEND, \n\tA.AliasName, \n\tA.SubCode,\n\tA.AccCode,\n\tA.Name,\n\tBalance=ISNULL(Sum(V.Debit - V.Credit), 0)\nFROM \n\tAccounts A\n\tLEFT OUTER JOIN VirtualGL V ON(A.AccCode = V.AccCode),\n\tUDF_GetSummaryAccountList(:ai_accCode) L\nWHERE\n\tL.AccCode = A.AccCode\nGROUP BY\n\tA.AccCode,\n\tA.Name,\n\tA.AliasName, \n\tA.SubCode\nORDER BY\n\tSummaryAccount,\n\tA.Name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_acccode",
      "number"
     ]
    }
   ]
  }
 },
