  "retrieve": "SELECT \n\tReceiptCode,\n\tDATE,\n\tUserCode, \n\tSaleInvCode,\n\tNetAmt,\n\tOutstandingAmt,\n\tCustCode = (SELECT MIN(H.CustCode) FROM InstallmentHeader H WHERE H.SaleInvCode = InstallmentReceipt.SaleInvCode),\n\tItemName = (SELECT I.Name FROM InstallmentHeader H, Item I WHERE H.SaleInvCode = InstallmentReceipt.SaleInvCode AND H.ICode=I.ICode),\n\tGLVochCode,\n\tGLVochCodeDisount,\n\tGLVochCodeFine,\n\tRemarks,\n\tRecoveryPersonCode,\n\tInstallmentRowID,\n\tInstallmentAmount,\n\tInstallmentBalance,\n\tAmtReceived,\n\tDiscount,\n\tFine\nFROM \n\tInstallmentReceipt\nWHERE\n\tReceiptCode = :ai_code",
