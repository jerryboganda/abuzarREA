  "retrieve": "SELECT  \n\tdbo.gldetail.invoicecode,\n\tinvdate=GetDate(),\n\tNetAmt=0.00,\n\tdbo.gldetail.OutStandingAmt,\n\tfullcode=dbo.accounts.aliasname,\n\tdbo.gldetail.acccode,\n\tdbo.gldetail.chkno,\n\tdbo.gldetail.remarks,\n\tdbo.gldetail.glvochcode ,\n\tregno = (SELECT regno FROM Patient WHERE Patient.PatientCode = dbo.gldetail.patientcode),\n\tdbo.gldetail.patientcode,\n\tguestregno = (SELECT regno FROM Guest WHERE Guest.GuestCode = dbo.gldetail.Guestcode),\n\tdbo.gldetail.guestcode,\n\tStudentregno = (SELECT regno FROM Student WHERE Student.StudentCode = dbo.gldetail.Studentcode),\n\tdbo.gldetail.studentcode,\n\tGLROWID=dbo.gldetail.IDENTITYCOL,\n\tGLUTN=dbo.gldetail.GLUTN,\n\tdbo.gldetail.balance,\n\tdbo.gldetail.ForeignAmt,\n\tdbo.gldetail.debit,\n\tdbo.gldetail.credit\n\t\nFROM    \n\tdbo.gldetail ,\n\tdbo.glheader, \n\tdbo.accounts\n\t\nWHERE   \n\t( dbo.glheader.glvochcode = :ar_VochCode ) and\n\t( dbo.glheader.glvochcode = dbo.gldetail.glvochcode ) and\n\t( dbo.gldetail.acccode = dbo.accounts.acccode )\nORDER BY\n\tdbo.gldetail.IDENTITYCOL\n",
  "update": "gldetail",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_VochCode",
      "number"
     ]
    }
   ]
  }
 },
