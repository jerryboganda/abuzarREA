  "retrieve": "  SELECT Accounts.Name,\n\t\t\tAccounts.AliasName,\n\t\t\tGlheader.vochcatcode,   \n         GLDetail.Debit,   \n         GLDetail.Credit,   \n\t\tdetailaccamt= GLDetail.Credit+GLDetail.Debit,\n\t\theaderaccamt=(select gd.Debit+gd.Credit from gldetail gd where gd.glvochcode=GLheader.GLVochCode and GLheader.acccode=gd.acccode),\n      \tglheaderaccname=(select name from accounts where acccode=GLHeader.acccode),   \n\t\tGLDetail.ChkNo,   \n         GLDetail.Remarks,   \n\t\t\tGlheader.Posted,\n         Glheader.Date,   \n         Glheader.Remarks,   \n         VocherCategory.Name,   \n         Users.UserName,   \n         Glheader.GLVochCode,\n         Glheader.VoucherCode,\n\t\t headerchkno=glheader.chkno,\n\t\t\tCreditorDebit = Case GLDetail.Debit When 0 Then 'Cr' Else 'Dr' End,\n\t\t\tgldetail.glrowid,\n\t\t\tInvoiceCode=GLDetail.InvoiceCode,\n\t\t\tInvoiceBased=VocherCategory.InvoiceBased\n    FROM GLDetail,   \n         Glheader,   \n         Accounts,   \n         VocherCategory,   \n         Users  \n   WHERE ( Glheader.GLVochCode = GLDetail.GLVochCode ) and  \n\t\t(GlHeader.acccode<>gldetail.acccode)and\n         ( Accounts.AccCode = GLDetail.AccCode ) and  \n         ( VocherCategory.VochCatCode = Glheader.VochCatCode ) and  \n         ( Users.UserCode = Glheader.salesmancode ) and  \n         ( Glheader.GLVochCode = :ar_code )   \n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_code",
      "number"
     ]
    }
   ]
  }
 },
