  ],
  "retrieve": "SELECT \n\tAccCode=A.AccCode, \n\tAccountName=A.Name,\n\tAliasName=A.AliasName,\n\tAddress = \n\t\tCASE A.SubCode \n\t\t\tWHEN 3 THEN (SELECT ISNULL(C.Address1,'') + ' ' + ISNULL(C.Address2, '') FROM Customer C WHERE C.CustCode = A.AccCode)\n\t\t\tWHEN 7 THEN (SELECT ISNULL(S.Address1,'') + ' ' + ISNULL(S.Address2, '') FROM Supplier S WHERE S.SuppCode = A.AccCode)\n\t\t\tELSE '' \n\t\tEND,\n\tCity = \n\t\tCASE A.SubCode \n\t\t\tWHEN 3 THEN (SELECT C.City FROM Customer C WHERE C.CustCode = A.AccCode)\n\t\t\tWHEN 7 THEN (SELECT S.City FROM Supplier S WHERE S.SuppCode = A.AccCode)\n\t\t\tELSE '' \n\t\tEND,\n\tGroupAccount = S.Name,\n\tSummaryAccount = \n\t\tCASE \n\t\tWHEN (SELECT Count(SD.AccCode) \n\t\t\t\tFROM SummaryAccountDetail SD \n\t\t\t\tWHERE SD.AccCode = A.AccCode) = 0 THEN NULL \n\t\tELSE\n\t\t\t(SELECT MAX(SA.Name) + ' (' + MAX(SA.AliasName) + ')' \n\t\t\tFROM SummaryAccount SA, SummaryAccountDetail SD \n\t\t\tWHERE SD.AccCode = A.AccCode AND \n\t\t\t\tSD.SummaryAccCode = SA.SummaryAccCode)\n\t\tEND,\n\tA.AlertCode,\n\tAlertTypeCode=(SELECT Alert.AlertTypeCode FROM Alert WHERE Alert.AlertCode = A.AlertCode)\nFROM\n\tAccounts A, SubAccounts S\nWHERE\n\tA.SubCode = S.SubAccCode AND A.Active = 'Y' AND Restricted='N'\nUNION \nSELECT \n\tAccCode=NULL, \n\tAccountName='  <NONE>',\n\tAliasName='<NONE>',\n\tAddress = '',\n\tCity = '',\n\tGroupAccount = '<NONE>',\n\tSummaryAccount = '<NONE>',\n\tAlertCode=1,\n\tAlertTypeCode=1\nORDER BY\n\tA.Name,\n\tA.AliasName,\n\tS.Name"
 },
