  "retrieve": "SELECT \n\tAccounts.Name,\n\tAccounts.AliasName,\n\tGlheader.vochcatcode,   \n\tGLDetail.Debit,   \n\tGLDetail.Credit,   \n\tGLDetail.ChkNo,   \n\tGLDetail.Remarks,   \n\tGlheader.Posted,\n\tGlheader.Date,   \n\tGlheader.OriginalDate,\n\tGlheader.PostDate,\n\tGlheader.Remarks,   \n\tVocherCategory.Name,   \n\tPostedBy = (SELECT U.UserName FROM Users U WHERE GlHeader.PostedBy=U.UserCode),\n\tUsers.UserName,   \n\tGlheader.GLVochCode,\n\tGlheader.VoucherCode,\n\tGlDetail.Balance,\n\tCreditorDebit = Case GLDetail.Debit When 0 Then 'C' Else 'D' End,\n\tgldetail.glrowid,\n\tInvoiceCode=GLDetail.InvoiceCode,\n\tInvoiceBased=VocherCategory.InvoiceBased\nFROM \n\tGLDetail,   \n\tGlheader,   \n\tAccounts,   \n\tVocherCategory,   \n\tUsers  \nWHERE \n\t( Glheader.GLVochCode = GLDetail.GLVochCode ) and  \n\t( Accounts.AccCode = GLDetail.AccCode ) and  \n\t( VocherCategory.VochCatCode = Glheader.VochCatCode ) and  \n\t( Users.UserCode = Glheader.salesmancode ) and  \n\t( Glheader.GLVochCode = :ar_code )",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_code",
      "number"
     ]
    }
   ]
  }
 },
