  "retrieve": "SELECT dbo.accounts.acccode, dbo.accounts.name  \nFROM dbo.accounts  \nWHERE (dbo.accounts.subcode IN \n\t\t(SELECT dbo.VocherCategoryHeader.SubAccCode\n\t\t FROM   dbo.VocherCategoryHeader\n\t\t WHERE  dbo.VocherCategoryHeader.VochCatCode = :ai_vochcatcode) OR\n\t\tdbo.accounts.subcode IN \n\t\t(SELECT SubAccCode = CASE dbo.VocherCategory.JournalVoucher\n\t\t\t\t\t\t\t\t\tWhen 1 THEN 2 ELSE -1000 END\n\t\tFROM dbo.VocherCategory WHERE dbo.VocherCategory.VochCatCode = :ai_vochcatcode)) AND\n\t\tdbo.accounts.active = 'Y'\nORDER BY dbo.accounts.name  ",
  "update": "accounts",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_vochcatcode",
      "number"
     ]
    }
   ]
  }
 },
