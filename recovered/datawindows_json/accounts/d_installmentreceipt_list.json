  "retrieve": "SELECT \n\tReceiptCode,\n\tDATE,\n\tUserCode,\n\tSaleInvCode,\n\tNetAmt,\n\tOutstandingAmt,\n\tCustCode = (SELECT MIN(H.CustCode) FROM InstallmentHeader H WHERE H.SaleInvCode = InstallmentReceipt.SaleInvCode),\n\tItemName = (SELECT I.Name FROM InstallmentHeader H, Item I WHERE H.SaleInvCode = InstallmentReceipt.SaleInvCode AND H.ICode=I.ICode),\n\tAmtReceived = (SELECT SUM(D.AmtReceived) FROM InstallmentReceiptDetail D WHERE D.ReceiptCode = InstallmentReceipt.ReceiptCode),\n\tDiscount = (SELECT SUM(D.Discount) FROM InstallmentReceiptDetail D WHERE D.ReceiptCode = InstallmentReceipt.ReceiptCode),\n\tFine = (SELECT SUM(D.Fine) FROM InstallmentReceiptDetail D WHERE D.ReceiptCode = InstallmentReceipt.ReceiptCode),\n\tGLVochCode,\n\tGLVochCodeDisount,\n\tGLVochCodeFine,\n\tRemarks\nFROM \n\tInstallmentReceipt\n",
  "update": "InstallmentReceipt",
