  "retrieve": "  SELECT glvochcode,\n\t\t\tvochercategory=(select name from vochercategory where vochercategory.vochcatcode=glheader.vochcatcode),\n\t\t\tremarks=glheader.remarks,\n\t\t\tAccName=accounts.name,\n\t\t\toriginaldate,\n\t\t\tPostdate,\n\t\t\tdate,\n\t\t   chkno,\n\t\t\tglheader.vochcatcode\n\t\t\t\n\t\t\t\n\n  FROM \tglheader, accounts\n\n  WHERE \t\n\t\t\tglheader.originaldate >= :ad_sdate AND \n\t\t\tglheader.originaldate <= :ad_edate AND\n\t\t\tglheader.acccode=accounts.acccode\n\t\t\t\n\n",
  "update": "glheader",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_sdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_edate",
      "datetime"
     ]
    }
   ]
  }
 },
