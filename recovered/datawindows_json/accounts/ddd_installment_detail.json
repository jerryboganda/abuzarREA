  "retrieve": "SELECT \n\tInstallmentCode = InstallmentDetail.InstallmentCode,\n\tInstallment = 'SI-' + LTRIM(RTRIM(STR(InstallmentHeader.SaleInvCode,10))) + '-IN-' + LTRIM(RTRIM(STR(InstallmentDetail.InstallmentCode,10))) + '-DT-' + CONVERT(VARCHAR(10), InstallmentDetail.Date, 103) + '-' + LTRIM(RTRIM(STR(InstallmentDetail.rowid,10))),\n\tDate=InstallmentDetail.Date,\n\tAmtReceived=InstallmentDetail.AmtReceived,\n\tDiscount=InstallmentDetail.Discount,\n\tFine=InstallmentDetail.Fine,\n\tAmount=InstallmentDetail.Amount,\n\tRowID=InstallmentDetail.RowID,\n\tCancelled = InstallmentDetail.Cancelled\nFROM\n\tInstallmentDetail, InstallmentHeader\nWHERE \n\tInstallmentHeader.SaleInvCode = :ai_code AND\n\tInstallmentHeader.Approved = 'Y' AND\n\tInstallmentHeader.Posted = 'Y' AND\n\tInstallmentHeader.InstallmentCode = InstallmentDetail.InstallmentCode AND\n\tInstallmentDetail.Amount - InstallmentDetail.Discount - InstallmentDetail.AmtReceived > 0 AND\n\tInstallmentDetail.Cancelled = 'N'\nORDER BY\n\tInstallmentDetail.InstallmentCode,\n\tInstallmentDetail.Date,\n\tInstallmentDetail.RowID\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
