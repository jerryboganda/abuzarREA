 "table": {
  "columns": [
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "sale",
    "dbname": "sale"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "sret",
    "dbname": "sret"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "voch",
    "dbname": "voch"
   }
  ],
  "retrieve": "select sale = isnull((select IsNull(Round(sum(( (sd.looseqty + sd.packqty * sd.packunits) *\n\t(sd.saleprice - sd.itemflatdisc)) * (1 - (.01 * sd.discperc))) * \n\t(1- (.01 * sl.discperc)) + sl.misccharges + sl.salestax -\n\tsl.flatdisc, 0), 0)\n\n     from saleledger sl, saledetail sd\n\n     where sl.saleinvcode = :ar_invcode and sl.Posted = 'Y' and\n\t   sl.saleinvcode = sd.saleinvcode\n\n     group by sl.saleinvcode, sl.discperc, sl.flatdisc, sl.misccharges, sl.salestax), 0),\n\n     sret = isnull((select IsNull(Round(sum(((sd.looseqty + sd.packqty * sd.packunits) * \n\tsd.srprice) * (1 - (.01 * sd.discperc))) * \n\t(1- (.01 * sl.discperc)) + sl.misccharges + sl.salestax -\n\tsl.flatdisc, 0), 0)\n\n     from     srledger sl, srdetail sd\n\n     where    sl.saleinvcode = :ar_invcode and sl.posted = 'Y' and\n  \t      sl.srinvcode = sd.srinvcode \n\n     group by sl.srinvcode,\n\t      sl.saleinvcode,\n\t      sl.discperc,\n\t      sl.misccharges,\n\t      sl.salestax,\n\t      sl.flatdisc), 0),\n\n     voch = isnull((select sum(gl.credit - gl.debit)\n\n     from   invledger il, invdetail gl\n\n     where  gl.invcode = :ar_invcode  and\n\t\t  \t   il.invvochcode = gl.invvochcode and \n\t   \t\til.invvochcatcode in (12,13,14)), 0)\n\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_invcode",
      "number"
     ]
    }
   ]
  }
 },
