  "retrieve": "SELECT \n\tPurPaymentCode,\n\tDate,\n\tUserCode,\n\tPurInvCode=PurInvCode,\n\tNetAmt,\n\tOutstandingAmt,\n\tAliasName = (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = PurPayment.AccCode),\n\tAccCode ,\n\tPosted,\n\tPostedBy,\n\tPostDate,\n\t\n\tPaymentMode,\n\tPaymentAccCode,\n\tPaymentAmt,\n\tPaymentCheckNo,\n\tPaymentRemarks,\n\t\n\tWHTaxAccCode,\n\tWHTaxPerc,\n\tWHTaxBaseAmt,\n\tWHTaxAmt,\n\tWHTaxCheckNo,\n\tWHTaxRemarks,\n\n\tGLVochCode\nFROM \n\tPurPayment\nWHERE \n\tPurPaymentCode = :ai_code\n",
  "update": "PurPayment",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
