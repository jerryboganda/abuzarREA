  "retrieve": "SELECT \n\tAccounts.Name,\n\tAccounts.AliasName,\n\tGlheader.vochcatcode,   \n\tGLDetail.Debit,   \n\tGLDetail.Credit,   \n\tGLDetail.ChkNo,   \n\tremarks=GLDetail.Remarks,   \n\tGlheader.Posted,\n\tGlheader.Date,   \n\tGlheader.Remarks,   \n\tVocherCategory.Name,   \n\tUsers.UserName,   \n\tGlheader.GLVochCode,\n\tGlheader.VoucherCode,\n\tCreditorDebit = Case GLDetail.Debit When 0 Then 'C' Else 'D' End,\n\tgldetail.glrowid,\n\tInvoiceCode=GLDetail.InvoiceCode,\n\tOutstandingamt = GLDetail.Outstandingamt,\n\tInvoiceBased=VocherCategory.InvoiceBased,\n\tStudentCode=GLDetail.StudentCode,\n\tStudentRegNo = (SELECT S.Regno FROM Student S WHERE S.Studentcode = GLDetail.StudentCode),\n\tStudentName = (SELECT S.Name FROM Student S WHERE S.Studentcode = GLDetail.StudentCode),\n\tStudentFName = (SELECT S.FName FROM Student S WHERE S.Studentcode = GLDetail.StudentCode),\n\tGrade = (SELECT G.Name \n\t\tFROM Student S, Class C, StudentClass SC, Grade G\n\t\tWHERE S.Studentcode = GLDetail.StudentCode AND \n\t\t\tS.CurrentClass=C.ClassCode AND\n\t\t\tC.GradeCode = G.GradeCode AND\n\t\t\tC.ClassCode = SC.ClassCode AND\n\t\t\tS.Studentcode = SC.Studentcode),\n\tClass = (SELECT C.Name \n\t\tFROM Student S, Class C, StudentClass SC, Grade G\n\t\tWHERE S.Studentcode = GLDetail.StudentCode AND \n\t\t\tS.CurrentClass=C.ClassCode AND\n\t\t\tC.GradeCode = G.GradeCode AND\n\t\t\tC.ClassCode = SC.ClassCode AND\n\t\t\tS.Studentcode = SC.Studentcode),\n\tSection = (SELECT LTRIM(RTRIM(SUBSTRING(C.Name, CHARINDEX(',', C.Name, 1)+1, CHARINDEX(',', SUBSTRING(C.Name, CHARINDEX(',', C.Name, 1)-1, LEN(C.Name)),1))))\n\t\tFROM Student S, Class C, StudentClass SC\n\t\tWHERE S.Studentcode = GLDetail.StudentCode AND \n\t\t\tS.CurrentClass=C.ClassCode AND\n\t\t\tC.ClassCode = SC.ClassCode AND\n\t\t\tS.Studentcode = SC.Studentcode),\n\tClassMedium = (SELECT CM.Name \n\t\tFROM Student S, Class C, StudentClass SC, ClassMedium CM\n\t\tWHERE S.Studentcode = GLDetail.StudentCode AND \n\t\t\tS.CurrentClass=C.ClassCode AND\n\t\t\tC.ClassMediumCode = CM.ClassMediumCode AND\n\t\t\tC.ClassCode = SC.ClassCode AND\n\t\t\tS.Studentcode = SC.Studentcode),\n\tRollNo = (SELECT SC.RollNo \n\t\tFROM Student S, StudentClass SC\n\t\tWHERE S.Studentcode = GLDetail.StudentCode AND \n\t\t\tS.CurrentClass=SC.ClassCode AND\n\t\t\tS.Studentcode = SC.Studentcode),\n\tSchool = (SELECT School.Name \n\t\tFROM Student S, Class C, StudentClass SC, School \n\t\tWHERE S.Studentcode = GLDetail.StudentCode AND \n\t\t\tS.CurrentClass=C.ClassCode AND\n\t\t\tC.SchoolCode = School.SchoolCode AND\n\t\t\tC.ClassCode = SC.ClassCode AND\n\t\t\tS.Studentcode = SC.Studentcode)\nFROM \n\tGLDetail,   \n\tGlheader,   \n\tAccounts,   \n\tVocherCategory,   \n\tUsers  \nWHERE \n\t( Glheader.GLVochCode = GLDetail.GLVochCode ) and  \n\t( Accounts.AccCode = GLDetail.AccCode ) and  \n\t( VocherCategory.VochCatCode = Glheader.VochCatCode ) and  \n\t( Users.UserCode = Glheader.salesmancode ) and  \n\t( Glheader.GLVochCode = :ar_code ) AND\n\t( Glheader.AccCode <> GLDetail.AccCode ) AND\n\t( GLDetail.Credit > 0 )",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_code",
      "number"
     ]
    }
   ]
  },
  "sort": "glheader_glvochcode A, studentregno A, studentname A, aliasname A, accounts_name A"
 },
