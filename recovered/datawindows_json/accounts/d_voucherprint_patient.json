    "name": "location",
    "dbname": "Location"
   }
  ],
  "retrieve": "SELECT \n\tAccounts.Name,\n\tAccounts.AliasName,\n\tGlheader.vochcatcode,   \n\tGLDetail.Debit,   \n\tGLDetail.Credit,   \n\tGLDetail.ChkNo,   \n\tGLDetail.Remarks,   \n\tGlheader.Posted,\n\tGlheader.Date,   \n\tGlheader.Remarks,   \n\tVocherCategory.Name,   \n\tUsers.UserName,   \n\tGlheader.GLVochCode,\n\tGlheader.VoucherCode,\n\tCreditorDebit = Case GLDetail.Debit When 0 Then 'C' Else 'D' End,\n\tgldetail.glrowid,\n\tPatientRegNo=(SELECT P.RegNo FROM Patient P WHERE P.PatientCode = GLDetail.PatientCode),\n\tpatientname=(SELECT P.name FROM Patient P WHERE P.PatientCode = GLDetail.PatientCode),\n\tLocation=\n\t\t(SELECT LocationCode = \n\t\t\t\t(SELECT PL.Name\n\t\t\t\tFROM PatientLocation PL \n\t\t\t\tWHERE PL.LocationCode IN\n\t\t\t\t\t\t(ISNULL((SELECT TargetLocation FROM PatientTransfer \n\t\t\t\t\t\t\tWHERE PatientTransfer.TransferCode = \n\t\t\t\t\t\t\t\t(SELECT Max(PatientTransfer.TransferCode) \n\t\t\t\t\t\t\t\tFROM PatientTransfer \n\t\t\t\t\t\t\t\tWHERE PatientTransfer.AdmissionCode = PA.AdmissionCode)), \n\t\t\t\t\t\t\t(SELECT A.LocationCode FROM PatientAdmission A \n\t\t\t\t\t\t\tWHERE A.AdmissionCode = PA.AdmissionCode))))\n\t\t\t\t\t\t\tFROM PatientAdmission PA\n\t\t\t\t\t\t\tWHERE \n\t\t\t\t\t\t\t\tPatientCode = GLDETAIL.PatientCode AND \n\t\t\t\t\t\t\t\tPA.AdmissionCode IN \n\t\t\t\t\t\t\t\t\t(SELECT MAX(PAA.AdmissionCode) \n\t\t\t\t\t\t\t\t\tFROM PatientAdmission PAA WHERE PAA.PatientCode = GLDETAIL.PatientCode))\nFROM \n\tGLDetail,   \n\tGlheader,   \n\tAccounts,   \n\tVocherCategory,   \n\tUsers  \nWHERE \n\t( Glheader.GLVochCode = GLDetail.GLVochCode ) and  \n\t( Accounts.AccCode = GLDetail.AccCode ) and  \n\t( VocherCategory.VochCatCode = Glheader.VochCatCode ) and  \n\t( Users.UserCode = Glheader.salesmancode ) and  \n\t( Glheader.GLVochCode = :ar_code )   \nORDER BY \n\tGLDetail.GLRowID",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_code",
      "number"
     ]
    }
   ]
  }
 },
