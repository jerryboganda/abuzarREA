  "retrieve": "SELECT \n\tdbo.accounts.acccode,   \n\tdbo.accounts.subcode, \n\tdbo.accounts.aliasname, \n\tdbo.accounts.name,   \n\tcustcatcode = CASE WHEN dbo.accounts.subcode = 3 THEN dbo.customer.custcatcode ELSE -1 END,\n\tCategory = \n\t\tCASE WHEN dbo.accounts.subcode = 3 THEN \n\t\t\t(Select Name From CustomerCategory Where dbo.customer.custcatcode = dbo.CustomerCategory.CustCatCode)\n\t\tWHEN dbo.accounts.subcode = 7 THEN \n\t\t\t(Select Name From SupplierCategory Where dbo.supplier.suppcatcode = dbo.SupplierCategory.SuppCatCode)\n\t\tELSE Null END,\n\tcity = CASE WHEN dbo.accounts.subcode = 3 THEN dbo.customer.city ELSE dbo.supplier.city END,\n\tdbo.subaccounts.name,\n\tAddress = CASE WHEN dbo.accounts.subcode = 3 THEN dbo.customer.address1 ELSE dbo.Supplier.address1 END,\n\tdbo.accounts.restricted,\n\tbalance=CASE accounts.restricted when'Y' then 0 ELSE isnull(V.balance,0) END,\n\tBalanceType=CASE WHEN V.Balance > 0 THEN 'DR.' ELSE 'CR.' END,\n\tAlertCode=Accounts.AlertCode,\n\tAlertTypeCode=(SELECT Alert.AlertTypeCode FROM Alert WHERE Alert.AlertCode = Accounts.AlertCode)\nFROM \n\tdbo.accounts\n\tLEFT OUTER JOIN dbo.customer ON (dbo.accounts.acccode = dbo.customer.custcode)\n\tLEFT OUTER JOIN dbo.supplier ON (dbo.accounts.acccode = dbo.supplier.suppcode)\n\tLEFT OUTER JOIN (SELECT acccode, sum(debit - credit) as balance FROM virtualgl GROUP BY acccode) AS V ON (dbo.accounts.acccode = V.acccode), \n\tdbo.subaccounts\n\t\nWHERE \n\t(dbo.accounts.subcode = dbo.subaccounts.subacccode)\nOrder By \n\tdbo.accounts.name \n",
  "sort": "name A"
 },
