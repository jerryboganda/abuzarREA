  "retrieve": "SELECT\n\tItemType='PAYMENT/RECEIPT',\n\tTransCode=GL.GLVochCode, \n\tDate = GL.Date, \n\tUserName=(SELECT U.UserName FROM Users U WHERE U.UserCode=GL.Salesmancode),\n\tTransType = RTRIM(LTRIM(VC.ShortName)) + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), GL.GLVochCode))), \n\tDetails = GD.Remarks,\n\tGD.ChkNo,\n\tVrow=GD.GLROWID,\n\tDebit=GD.Debit,\n\tCredit=GD.Credit\nFROM\n\tVocherCategory VC,\n\tGLHeader GL,\n\tGLDetail GD,\n\t(SELECT * FROM Patient P \n\tWHERE P.PatientCode IN (SELECT S.PatientCode FROM ServiceHeader S WHERE S.ServiceInvCode=:ai_code)) P\nWHERE   \n\tGL.Posted = 'Y' AND\n\tGL.GlVochCode = GD.GLVochCode AND\n\tGL.VochCatCode = VC.VochCatCode AND\n\tGD.PatientCode = P.PatientCode AND\n\tGD.AccCode IN (SELECT AccCode FROM Accounts WHERE SubCode=3) AND\n\tVC.InvoiceBased = 1 AND VC.InvoiceType = 3 AND\n\tGD.InvoiceCode = :ai_code\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    },
    {
     "_items": [
      "ad_balance",
      "number"
     ]
    }
   ]
  }
 },
