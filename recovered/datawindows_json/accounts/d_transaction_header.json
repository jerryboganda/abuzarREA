  "retrieve": "SELECT \n\tTransactionHeader.DocumentCode,\n\tTransactionHeader.TransactionTypeCode,\n\tTransactionHeader.TransactionCode,\n\tTransactionHeader.Date,\n\tTransactionHeader.UserCode,\n\tTransactionHeader.Remarks,\n\tRegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = TransactionHeader.PatientCode),\n\tTransactionHeader.PatientCode,\n\tTransactionHeader.AdmissionCode,\n\tTransactionHeader.PatientBalance,\n\tAliasName = (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = TransactionHeader.AccCode),\n\tTransactionHeader.AccCode,\n\tTransactionHeader.AccBalance,\n\tTransactionHeader.CashAccCode,\n\tTransactionHeader.CashTendered,\n\tTransactionHeader.CashCharged,\n\tTransactionHeader.CashBack,\n\tTransactionHeader.Posted,\n\tTransactionHeader.PostedBy,\n\tTransactionHeader.PostDate\nFROM \n\tTransactionHeader\nWHERE\n\tTransactionHeader.DocumentCode = :ai_code\n",
  "update": "TransactionHeader",
  "updatewhere": "1",
