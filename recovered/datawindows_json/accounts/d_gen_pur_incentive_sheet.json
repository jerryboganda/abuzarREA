    "dbname": "ItemName"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "qty",
    "dbname": "Qty"
   }
  ],
  "retrieve": "SELECT\n\tICode = I.ICode,\n\tCustomICode = I.CustomICode,\n\tItemName = I.Name,\n\tQty = SUM( (PD.PackQty + PD.LooseQty + PD.BonusQty) * CASE WHEN PL.PurCatCode < 3 THEN PD.PackUnits ELSE 1 END)\nFROM\n\tPurLedger PL, PurDetail PD, Item I\nWHERE\n\tPL.SuppCode = :ai_suppcode AND\n\tPL.Posted = 'Y' AND\n\tPL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tPL.PurInvCode = PD.PurInvCode AND \n\tPD.ICode = I.ICode AND\n\tCASE :as_grouping WHEN 'M' THEN I.ManfCode WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PackCode END IN (:ai_codelist)\nGROUP BY\n\tI.ICode,\n\tI.CustomICode,\n\tI.Name\nHAVING \n\tSUM( (PD.PackQty + PD.LooseQty + PD.BonusQty) * CASE WHEN PL.PurCatCode < 3 THEN PD.PackUnits ELSE 1 END) <> 0\nORDER BY\n\tItemName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_suppcode",
      "number"
     ]
    },
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
