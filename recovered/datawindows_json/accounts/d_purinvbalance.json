  "retrieve": "Select pur = IsNull((select  IsNull( Round(sum(( (purdetail.looseqty + purdetail.packqty \n\t\t\t\t\t* purdetail.packunits) * purdetail.purprice) * (1 - (.01 * purdetail.discperc)))\n\t\t\t\t\t* (1- (.01 * purledger.discperc)) + purledger.misccharges + purledger.salestax - \n\t\t\t\t\t\tpurledger.flatdisc, 0), 0)\n\t\t\t\t\t\tfrom     purledger,\t \n\t\t\t\t\t\t\t\t\tpurdetail \n\t\t\t\t\t\twhere    purledger.purinvcode  = :ar_code and\n\t\t\t\t\t\t\t\t   purledger.purinvcode = purdetail.purinvcode and\n\t\t\t\t\t\t\t\t\tpurledger.posted = 'Y' \n\t\t\t\t\t\tgroup by purledger.purinvcode,\n\t\t\t\t\t\t\t\t   purledger.discperc,\n\t\t\t\t\t\t\t      purledger.misccharges,\n\t\t\t\t\t\t\t      purledger.salestax,\n\t\t\t\t\t\t\t\t   purledger.flatdisc), 0),\n\t\tpret = IsNull((select IsNull(Round(sum((( prdetail.looseqty + prdetail.packqty * \n\t\t\t\t\t\t\tprdetail.packunits) * prdetail.prprice) * (1 - (.01 *\n\t\t\t\t\t\t   prdetail.discperc))) * (1- (.01 * prledger.discperc)) + \n\t\t\t\t\t\t\tprledger.misccharges + prledger.salestax - prledger.flatdisc,\n\t\t\t\t\t\t\t 0), 0)\n\t\t\t\t\t\t\tfrom     prledger,\t \n\t\t\t\t\t\t\t\t\t   prdetail\t\t\n\t\t\t\t\t\t\twhere    prledger.PurInvCode = :ar_code and\n\t\t\t\t\t\t\t\t \t\tprledger.posted = 'Y' and\n\t\t                        prledger.prinvcode = prdetail.prinvcode\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\tgroup by prledger.prinvcode,\n\t\t\t\t\t\t\t\t\t\t prledger.discperc,\n\t\t\t\t\t\t\t\t\t\t prledger.misccharges,\n\t\t\t\t\t\t\t\t\t\t prledger.salestax,\n\t\t\t\t\t\t\t\t\t\t prledger.flatdisc), 0),\n\t\tvoch = IsNull((select sum(gl.credit - gl.debit)\n\t\t\t\t\t     from     invledger il, invdetail gl\n\t\t\t\t\t     where    gl.invcode = :ar_code and\n\t\t\t\t\t\t\t  \t     il.invvochcode = gl.invvochcode and \n\t\t\t\t\t\t\t        il.invvochcatcode in (15,16,17)), 0)",
