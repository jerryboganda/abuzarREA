   {
    "type": "char(100)",
    "updatewhereclause": "yes",
    "name": "crs_clientname",
    "dbname": "CRS_ClientName"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "manufacturer",
    "dbname": "Manufacturer"
   },
   {
    "type": "char(75)",
    "updatewhereclause": "yes",
    "name": "aliasname",
    "dbname": "AliasName"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "itemname",
    "dbname": "ItemName"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "qty",
    "dbname": "Qty"
   },
   {
    "type": "decimal(16)",
    "updatewhereclause": "yes",
    "name": "value",
    "dbname": "Value"
   }
  ],
  "retrieve": "SELECT \n\tCRS_ClientName=CL.Name,\n\tManufacturer = (SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = I.MANFCODE),\n\tAliasName = I.CustomICode,\n\tItemName = I.Name,\n\tQty = SUM(G.CurrQty),\n\tValue = SUM(G.CurrQty * ROUND(I.SalePrice / CASE WHEN I.PackUnits <= 0 THEN 1 ELSE I.PackUnits END, 2))\nFROM \n\tItem I,\n\tCRS_ClientInstance CI, \n\tCRS_ClientList CL,\n\tCRS_GodownDetail G\nWHERE \n\tCL.ClientID = CI.ClientID AND\n\tCI.ClientInstanceID = G.ClientInstanceID AND\n\tI.ICode = G.ICode AND\n\tI.ICode IN (:ai_icode)\nGROUP BY\n\tCL.Name, I.CustomICode, I.Name, I.MANFCODE\nORDER BY\n\tItemName,\n\tCRS_ClientName\n\t",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_icode",
      "numberlist"
     ]
    }
   ]
  }
 },
