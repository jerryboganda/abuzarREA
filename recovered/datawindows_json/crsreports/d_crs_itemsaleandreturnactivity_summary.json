    "name": "packing",
    "dbname": "Packing"
   }
  ],
  "retrieve": "SELECT \n\tItemCode=S.ItemCode, \n\tAliasName=I.CustomICode, \n\tItem=I.Name, \n\tQty=SUM(S.Qty),\n\tBonus=SUM(S.Bonus),\n\tSaleValue = ROUND(SUM(S.SaleValue), 2),\n\tRetQty=SUM(S.RetQty),\n\tRetBonus=SUM(S.RetBonus),\n\tRetValue = ROUND(SUM(S.RetValue), 2), \n\tNetQty = SUM(S.Qty - S.RetQty),\n\tNetBonus = SUM(S.Bonus - S.RetBonus),\n\tNetValue = ROUND(SUM(S.SaleValue), 2) - ROUND(SUM(S.RetValue), 2),\n\tPacking=I.PackingDesc\nFROM\n\tItem I\n\tLEFT OUTER JOIN \n\t(SELECT\n\t\tClient=CL.Name,\n\t\tItemCode=SD.ICode, \n\t\tQty=SUM(SD.LooseQty),\n\t\tBonus=SUM(SD.BonusQty),\n\t\tSaleValue = SUM(SD.LooseQty * (SD.saleprice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ) ,\n\t\tRetQty=0,\n\t\tRetBonus=0,\n\t\tRetValue = 0.00\n\tFROM\n\t\tCRS_ClientInstance CI, \n\t\tCRS_ClientList CL,\n\t\tcrs_saleledger SL, crs_saledetail SD\n\tWHERE\n\t\tCL.ClientID = CI.ClientID AND \n\t\tCI.ClientInstanceID = SL.ClientInstanceID AND\n\t\tSL.ClientInstanceID = SD.ClientInstanceID AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\t\tSD.ICode IN (:ar_ICode)\n\tGROUP BY\n\t\tCL.Name,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT\n\t\tClient=CL.Name,\n\t\tItemCode=SD.ICode, \n\t\tQty=0,\n\t\tBonus=0,\n\t\tSaleValue = 0.00,\n\t\tRetQty=SUM(SD.LooseQty),\n\t\tRetBonus=SUM(SD.BonusQty),\n\t\tRetValue = SUM(SD.LooseQty * SD.srprice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) )\n\tFROM\n\t\tCRS_ClientInstance CI, \n\t\tCRS_ClientList CL,\n\t\tcrs_srledger SL, crs_srdetail SD\n\tWHERE\n\t\tCL.ClientID = CI.ClientID AND \n\t\tCI.ClientInstanceID = SL.ClientInstanceID AND\n\t\tSL.ClientInstanceID = SD.ClientInstanceID AND\n\t\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\t\tSD.ICode IN (:ar_ICode)\n\tGROUP BY\n\t\tCL.Name,\n\t\tSD.ICode) S ON (I.ICode = S.ItemCode)\nWHERE\n\tI.ICode IN (:ar_icode)\nGROUP BY\n\tS.ItemCode,\n\tI.Name, \n\tI.CustomICode,\n\tI.PackingDesc\nORDER BY\n\tItem, \n\tAliasName",
  "arguments": {
