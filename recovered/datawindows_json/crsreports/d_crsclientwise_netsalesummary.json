    "name": "crs_clientname",
    "dbname": "CRS_ClientName"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "sales",
    "dbname": "Sales"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "sreturns",
    "dbname": "SReturns"
   }
  ],
  "retrieve": "SELECT \n\tCRS_ClientName=CL.Name,\n\tSales = SUM(S.Sales),\n\tSReturns = SUM(S.SReturns)\nFROM \n\tCRS_ClientInstance CI, \n\tCRS_ClientList CL,\n\t(SELECT \n\t\tS.ClientInstanceID,\n\t\tSales = SUM(S.InvTotal),\n\t\tSReturns = 0.00\n\tFROM CRS_SaleLedger S\n\tWHERE S.Date BETWEEN :adt_startdate AND :adt_enddate\n\tGROUP BY\n\t\tS.ClientInstanceID\n\tUNION ALL\n\tSELECT \n\t\tS.ClientInstanceID,\n\t\tSales = 0.00,\n\t\tSReturns = SUM(S.InvTotal)\n\tFROM CRS_SRLedger S\n\tWHERE S.Date BETWEEN :adt_startdate AND :adt_enddate\n\tGROUP BY\n\t\tS.ClientInstanceID\n\tUNION ALL\n\tSELECT\n\t\tClientInstanceID,\n\t\tSales = 0.00,\n\t\tSReturns = 0.00\n\tFROM CRS_ClientInstance) S\nWHERE \n\tCL.ClientID = CI.ClientID AND\n\tCI.ClientInstanceID = S.ClientInstanceID\nGROUP BY\n\tCL.Name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
