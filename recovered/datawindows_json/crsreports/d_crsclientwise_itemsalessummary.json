  "retrieve": "SELECT \n\tCRS_ClientName=CL.Name,\n\tGroupName = CASE :as_grouptype\n\t\tWHEN 'M' THEN (SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = I.MANFCODE)\n\t\tWHEN 'C' THEN (SELECT C.Name FROM ItemCategory C WHERE C.ICatCode = I.ICatCode)\n\t\tWHEN 'L' THEN (SELECT L.Name FROM ItemClass L WHERE L.ICCode = I.ICCode)\n\t\tELSE (SELECT P.Name FROM ItemPacking P WHERE P.PackCode = I.PACKCODE) END,\n\tAliasName = I.CustomICode,\n\tItemName = I.Name,\n\tQty = SUM(S.Qty),\n\tValue = SUM(S.Value)\nFROM \n\tItem I,\n\tCRS_ClientInstance CI, \n\tCRS_ClientList CL,\n\t(SELECT \n\t\tS.ClientInstanceID,\n\t\tD.ICode,\n\t\tQty = SUM(D.LooseQty),\n\t\tValue = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))\n\tFROM CRS_SaleLedger S, CRS_SaleDetail D, Item I\n\tWHERE S.Date BETWEEN :adt_startdate AND :adt_enddate AND\t\n\t\tS.ClientInstanceID = D.ClientInstanceID AND S.SaleInvCode = D.SaleInvCode AND D.ICode = I.ICode AND\n\t\tCASE :as_grouptype\n\t\t\tWHEN 'M' THEN I.MANFCODE \n\t\t\tWHEN 'C' THEN I.ICatCode \n\t\t\tWHEN 'L' THEN I.ICCode \n\t\t\tELSE I.PACKCODE \n\t\tEND IN (:ai_groupcode)\n\tGROUP BY\n\t\tS.ClientInstanceID, D.ICode\n\tUNION ALL\n\tSELECT \n\t\tS.ClientInstanceID,\n\t\tD.ICode,\n\t\tQty = - SUM(D.LooseQty),\n\t\tValue = - SUM(D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))\n\tFROM CRS_SRLedger S, CRS_SRDetail D, Item I\n\tWHERE S.Date BETWEEN :adt_startdate AND :adt_enddate AND\t\n\t\tS.ClientInstanceID = D.ClientInstanceID AND S.SRInvCode = D.SRInvCode AND D.ICode = I.ICode AND\n\t\tCASE :as_grouptype\n\t\t\tWHEN 'M' THEN I.MANFCODE \n\t\t\tWHEN 'C' THEN I.ICatCode \n\t\t\tWHEN 'L' THEN I.ICCode \n\t\t\tELSE I.PACKCODE \n\t\tEND IN (:ai_groupcode)\n\tGROUP BY\n\t\tS.ClientInstanceID, D.ICode) S\nWHERE \n\tCL.ClientID = CI.ClientID AND\n\tCI.ClientInstanceID = S.ClientInstanceID AND\n\tI.ICode = S.ICode AND\n\tCASE :as_grouptype\n\t\tWHEN 'M' THEN I.MANFCODE \n\t\tWHEN 'C' THEN I.ICatCode \n\t\tWHEN 'L' THEN I.ICCode \n\t\tELSE I.PACKCODE \n\tEND IN (:ai_groupcode)\nGROUP BY\n\tCL.Name, I.ManfCode, I.ICatCode, I.ICCode, I.Packcode, I.CustomICode, I.Name\n\t",
  "arguments": {
   "_items": [
    {
     "_items": [
