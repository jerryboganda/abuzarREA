   }
  ],
  "retrieve": "SELECT \n\titemname = item.name,\n\titemalias= item.customicode,\n\tmanfcode = Manufacturer.manfcode, \n\tmanfname = Manufacturer.Name,\n\tqty      = ISNULL(Sum(S.qty), 0), \n\tdiscount = ISNULL(SUM(S.Discount), 0),\n\tamount   = ISNULL(Sum(S.Amount), 0),\n\tsupplier=\n\t\t(select a.name\n\t\tfrom \n\t\t\taccounts a, itemsuppliers isp\n\t\twhere \n\t\t\tisp.icode = item.icode and \n\t\t\tisp.suppcode = a.acccode and\n\t\t\tisp.priority in \n\t\t\t\t(select p=min(ip.priority) \n\t\t\t\tfrom itemsuppliers ip \n\t\t\t\twhere ip.icode = isp.icode))\nFROM\n\tdbo.item,\n\t(SELECT \n\t\tClient=CL.Name,\n\t\tcrs_saledetail.icode,\n\t\tqty      = Sum(dbo.crs_saledetail.looseqty),\n\t\tdiscount = Round(Sum ( (dbo.crs_saledetail.looseqty * (dbo.crs_saledetail.saleprice - dbo.crs_saledetail.itemflatdisc)) * (dbo.crs_saledetail.discperc) * .01 + dbo.crs_saledetail.looseqty * dbo.crs_saledetail.itemflatdisc) , 2),\n\t\tamount   = Round(Sum ( dbo.crs_saledetail.looseqty * dbo.crs_saledetail.saleprice), 2)\n\tFROM \t \n\t\tCRS_ClientInstance CI, \n\t\tCRS_ClientList CL,\n\t\tdbo.crs_saleledger, dbo.crs_saledetail\n\tWHERE\n\t\tCL.ClientID = CI.ClientID AND \n\t\tCI.ClientInstanceID = dbo.crs_saleledger.ClientInstanceID AND\n\t\tdbo.crs_saleledger.ClientInstanceID = dbo.crs_saledetail.ClientInstanceID AND\n\t\tdbo.crs_saleledger.saleinvcode = dbo.crs_saledetail.saleinvcode and  \n\t\tdbo.crs_saleledger.date BETWEEN :ad_StartDate and :ad_EndDate  and\n\t\tdbo.crs_saleledger.salecatcode IN (1, 2, 3) and\n\t\tdbo.crs_saledetail.icode IN (SELECT item.icode FROM Item WHERE Item.ManfCode IN (:ll_manfcode) and item.active = 1)\n\tGROUP BY \n\t\tCL.Name,\n\t\tcrs_saledetail.icode\n\tUNION ALL\n\tSELECT \n\t\tClient=CL.Name,\n\t\tcrs_srdetail.icode,\n\t\tqty      = -Sum(dbo.crs_srdetail.looseqty),\n\t\tdiscount = -Round(Sum ( (dbo.crs_srdetail.looseqty * dbo.crs_srdetail.srprice) * (dbo.crs_srdetail.discperc) * .01) , 2),\n\t\tamount   = -Round(Sum ( dbo.crs_srdetail.looseqty * dbo.crs_srdetail.srprice), 2)\n\tFROM \t \n\t\tCRS_ClientInstance CI, \n\t\tCRS_ClientList CL,\n\t\tdbo.crs_srledger, dbo.crs_srdetail\n\tWHERE\n\t\tCL.ClientID = CI.ClientID AND \n\t\tCI.ClientInstanceID = dbo.crs_srledger.ClientInstanceID AND\n\t\tdbo.crs_srledger.ClientInstanceID = dbo.crs_srdetail.ClientInstanceID AND\n\t\tdbo.crs_srledger.srinvcode = dbo.crs_srdetail.srinvcode and  \n\t\tdbo.crs_srledger.date BETWEEN :ad_StartDate and :ad_EndDate  and\n\t\tdbo.crs_srdetail.icode IN (SELECT item.icode FROM Item WHERE Item.ManfCode IN (:ll_manfcode) and item.active = 1) AND\n\t\tIsNull(crs_srledger.saleinvcode,-1) IN (SELECT saleinvcode =\n\t\tCASE :as_return when 'A' THEN\n\t\t\tIsNull(crs_srledger.saleinvcode,-1) \n\t\tELSE\n\t\t\t(SELECT crs_saleledger.SALEINVCODE FROM dbo.crs_saleledger \n\t\t\tWHERE dbo.crs_saleledger.date >= :ad_StartDate and dbo.crs_saleledger.date <= :ad_EndDate  and\n\t\t\t\tcrs_saleledger.SALEINVCODE = crs_srledger.saleinvcode)\n\t\tEND)\n\nGROUP BY \n\tCL.Name,\n\tcrs_srdetail.icode) S, Manufacturer\nWHERE\n\tdbo.item.manfcode in (:ll_manfcode) and\n\tdbo.item.active = 1 and\n\tdbo.item.manfcode = Manufacturer.manfcode AND\n\tdbo.item.icode = S.icode\nGROUP BY \n\titem.Icode,\n\titem.name,\n\titem.customicode,\n\tManufacturer.manfcode,\n\tManufacturer.Name\nORDER BY\n\tManufacturer.Name,\n\titem.name",
  "arguments": {
   "_items": [
    {
     "_items": [
