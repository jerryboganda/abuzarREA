  "retrieve": "SELECT\n\tClientID=S.ClientID,\n\tClientName=S.Name,\n\tAliasName=I.CustomICode, \n\tI.Name as Item, \n\tManufacturer= M.Name,\n\tCategory= IC.Name,\n\tS.Bonus,\n\tS.Sales,\n\tI.AvgPrice,\n\tI.SalePrice,\n\tI.PackUnits,\n\tI.PackingDesc,\n\tS.Type,\n\tS.InvCode,\n\tHeaderNo=S.HeaderNo,\n\tHeaderInvNo=S.HeaderInvNo,\n\tCustAlias=A.AliasName,\n\tCustomer=A.Name\nFROM\n\tItem I,\n\tManufacturer M,\n\tItemCategory IC,\n\tAccounts A,\n\t(SELECT\n\t\tType='S',\n\t\tCL.ClientID,\n\t\tCL.Name,\n\t\tSD.ClientInstanceID,\n\t\tSD.ICode,\n\t\tSUM(SD.BonusQty) as Bonus,\n\t\tSUM(SD.LooseQty) as Sales,\n\t\tInvCode=SL.SaleInvCode,\n\t\tSL.HeaderNo,\n\t\tSL.CustCode,\n\t\tSL.HeaderInvNo\n\tFROM\n\t\tCRS_ClientInstance CI, \n\t\tCRS_ClientList CL,\n\t\tCRS_SaleLedger SL,\n\t\tCRS_SaleDetail SD,\n\t\tItem IT\n\tWHERE\n\t\tCL.ClientID = CI.ClientID AND \n\t\tCI.ClientInstanceID = SL.ClientInstanceID AND\n\t\tCI.ClientInstanceID = SD.ClientInstanceID AND\n\t\tSL.ClientInstanceID = SD.ClientInstanceID AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND \n\t\tSL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\t\tSD.ICode = IT.ICode AND\n\t\tSD.BonusQty <> 0 AND\n\t\tIT.ICatCode IN (:ar_icatcode)\n\tGROUP BY\n\t\tCL.ClientID,\n\t\tCL.Name,\n\t\tSD.ClientInstanceID,\n\t\tSD.ICode,\n\t\tSL.SaleInvCode,\n\t\tSL.HeaderNo,\n\t\tSL.CustCode,\n\t\tSL.HeaderInvNo\n\tHAVING SUM(SD.BonusQty) <> 0\n\tUNION ALL\n\tSELECT\n\t\tType='R',\n\t\tCL.ClientID,\n\t\tCL.Name,\n\t\tSD.ClientInstanceID,\n\t\tSD.ICode,\n\t\t-SUM(SD.BonusQty) as Bonus,\n\t\t-SUM(SD.LooseQty) as Sales,\n\t\tInvCode=SL.SRInvCode,\n\t\tSL.HeaderNo,\n\t\tSL.CustCode,\n\t\tSL.HeaderInvNo\n\tFROM\n\t\tCRS_ClientInstance CI, \n\t\tCRS_ClientList CL,\n\t\tCRS_SrLedger SL,\n\t\tCRS_SrDetail SD,\n\t\tItem IT\n\tWHERE\n\t\tCL.ClientID = CI.ClientID AND \n\t\tCI.ClientInstanceID = SL.ClientInstanceID AND\n\t\tSL.ClientInstanceID = SD.ClientInstanceID AND\n\t\tCI.ClientInstanceID = SD.ClientInstanceID AND\n\t\tSL.SrInvCode = SD.SrInvCode AND \n\t\tSL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\t\tSD.BonusQty <> 0 AND\n\t\tSD.ICode = IT.ICode AND\n\t\tIT.ICatCode IN (:ar_icatcode)\n\tGROUP BY\n\t\tCL.ClientID,\n\t\tCL.Name,\n\t\tSD.ClientInstanceID,\n\t\tSD.ICode,\n\t\tSL.SRInvCode,\n\t\tSL.HeaderNo,\n\t\tSL.CustCode,\n\t\tSL.HeaderInvNo\n\tHAVING SUM(SD.BonusQty) <> 0) S\nWHERE\n\tS.ICode = I.ICode AND\n\tS.CustCode=A.AccCode AND\n\tI.ManfCode = M.ManfCode AND\n\tI.ICatCode IN (:ar_icatcode) AND\n\tI.ICatCode = IC.ICatCode \n",
  "arguments": {
