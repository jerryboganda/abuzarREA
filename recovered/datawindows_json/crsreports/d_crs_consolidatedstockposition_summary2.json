 "table": {
  "columns": [
   {
    "type": "char(100)",
    "updatewhereclause": "yes",
    "name": "crs_clientname",
    "dbname": "CRS_ClientName"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "qty",
    "dbname": "Qty"
   },
   {
    "type": "decimal(16)",
    "updatewhereclause": "yes",
    "name": "value",
    "dbname": "Value"
   }
  ],
  "retrieve": "SELECT \n\tCRS_ClientName=CL.Name,\n\tQty = SUM(G.CurrQty),\n\tValue = SUM(G.CurrQty * ROUND(I.SalePrice / CASE WHEN I.PackUnits <= 0 THEN 1 ELSE I.PackUnits END, 2))\nFROM \n\tCRS_ClientInstance CI, \n\tCRS_ClientList CL,\n\tManufacturer,   \n\tItem I\n\tLEFT OUTER JOIN itemclass ON (I.ICCode = itemclass.ICCode)\n\tLEFT OUTER JOIN itempacking ON (I.PackCode = itempacking.PackCode),\n\tItemCategory,\n\tCRS_GodownDetail G\nWHERE \n\tCASE :as_grouptype\n\t\tWHEN 'M' THEN I.ManfCode\n\t\tWHEN 'C' THEN I.ICatCode \n\t\tWHEN 'P' THEN I.PackCode \n\t\tELSE I.ICCode END IN (:ai_groupcode) and\n\tManufacturer.manfcode = I.ManfCode and\n\tI.icatcode=itemcategory.icatcode and\n\tI.active=1 AND\n\tCL.ClientID = CI.ClientID AND\n\tCI.ClientInstanceID = G.ClientInstanceID AND\n\tI.ICode = G.ICode\nGROUP BY\n\tCL.Name\nORDER BY\n\tCRS_ClientName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_grouptype",
      "string"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "numberlist"
     ]
    }
   ]
  }
 },
