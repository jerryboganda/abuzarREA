    "updatewhereclause": "yes",
    "name": "avgprice",
    "dbname": "Item.AvgPrice"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "saleprice",
    "dbname": "Item.SalePrice"
   },
   {
    "type": "long",
    "updatewhereclause": "yes",
    "name": "packunits",
    "dbname": "Item.PackUnits"
   },
   {
    "type": "char(50)",
    "updatewhereclause": "yes",
    "name": "packingdesc",
    "dbname": "Item.PackingDesc"
   }
  ],
  "retrieve": "SELECT\n\tI.Name as Item,\n\tM.Name as Manufacturer,\n\tIC.Name as Category,\n\tBonus=SUM(S.Bonus),\n\tSales=SUM(S.Sales), \n\tI.AvgPrice,\n\tI.SalePrice,  \n\tI.PackUnits,\n\tI.PackingDesc\nFROM\n\tItem I,\n\tManufacturer M,\n\tItemCategory IC,\n\t(SELECT\n\t\tCL.ClientID,\n\t\tCL.Name,\n\t\tSL.ClientInstanceID,\n\t\tSD.ICode,\n\t\tSUM(SD.BonusQty) as Bonus,\n\t\tSUM(SD.LooseQty) as Sales\n\tFROM\n\t\tCRS_ClientInstance CI, \n\t\tCRS_ClientList CL,\n\t\tCRS_SaleLedger SL,\n\t\tCRS_SaleDetail SD\n\tWHERE\n\t\tCL.ClientID = CI.ClientID AND \n\t\tCI.ClientInstanceID = SL.ClientInstanceID AND\n\t\tCI.ClientInstanceID = SD.ClientInstanceID AND\n\t\tSL.ClientInstanceID = SD.ClientInstanceID AND\n\t\tSD.BonusQty <>  0 AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND \n\t\tSL.Date BETWEEN :ar_StartDate AND :ar_EndDate\n\tGROUP BY\n\t\tCL.ClientID,\n\t\tCL.Name,\n\t\tSL.ClientInstanceID,\n\t\tSD.ICode\n\tHAVING\n\t\tSUM(SD.BonusQty) <> 0\n\tUNION ALL\n\tSELECT\n\t\tCL.ClientID,\n\t\tCL.Name,\n\t\tSL.ClientInstanceID,\n\t\tSD.ICode,\n\t\t-SUM(SD.BonusQty) as Bonus,\n\t\t-SUM(SD.LooseQty) as Sales\n\tFROM\n\t\tCRS_ClientInstance CI, \n\t\tCRS_ClientList CL,\n\t\tCRS_SrLedger SL,\n\t\tCRS_SrDetail SD\n\tWHERE\n\t\tCL.ClientID = CI.ClientID AND \n\t\tCI.ClientInstanceID = SL.ClientInstanceID AND\n\t\tCI.ClientInstanceID = SD.ClientInstanceID AND\n\t\tSL.ClientInstanceID = SD.ClientInstanceID AND\n\t\tSD.BonusQty <>  0 AND\n\t\tSL.SrInvCode = SD.SrInvCode AND \n\t\tSL.Date BETWEEN :ar_StartDate AND :ar_EndDate\n\tGROUP BY\n\t\tCL.ClientID,\n\t\tCL.Name,\n\t\tSL.ClientInstanceID,\n\t\tSD.ICode\n\tHAVING\n\t\tSUM(SD.BonusQty) <> 0) S\nWHERE\n\tS.ICode = I.ICode AND\n\tI.ManfCode = M.ManfCode AND\n\tI.ICatCode IN (:ar_icatcode) AND\n\tI.ICatCode = IC.ICatCode\nGROUP BY\n\tI.Name,\n\tM.Name,\n\tIC.Name,\n\tI.AvgPrice,\n\tI.SalePrice,  \n\tI.PackUnits,\n\tI.PackingDesc\nORDER BY\n\tM.Name,\n\tI.Name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_StartDate",
      "datetime"
     ]
    },
    {
