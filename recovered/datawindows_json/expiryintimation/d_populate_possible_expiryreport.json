    "name": "suppinvdate",
    "dbname": "SuppInvDate"
   },
   {
    "type": "char(100)",
    "updatewhereclause": "yes",
    "name": "batch",
    "dbname": "Purdetail.Batch"
   },
   {
    "type": "datetime",
    "updatewhereclause": "yes",
    "name": "expiry",
    "dbname": "Purdetail.Expiry"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "qty",
    "dbname": "Qty"
   }
  ],
  "retrieve": "SELECT Item.CustomICode, \n\tGroupCode=\n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN max(Item.ManfCode)\n\t\tWHEN 'C' THEN max(Item.ICatCode)\n\t\tWHEN 'L' THEN max(Item.ICCode)\n\t\tELSE Max(Item.PACKCODE) END,\n\tGroupName= \n\t\tCASE :as_reportgrouping \n\t\tWHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = max(Item.ManfCode))\n\t\tWHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = max(Item.ICatCode))\n\t\tWHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = max(Item.ICCode))\n\t\tELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = max(Item.PACKCODE)) END,    \n\tICode=Item.ICode,\n\tItem.Name,   \n\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\tItem.PackUnits,   \n\tPurInvCode = P.PurInvCode,\n\tDate = P.Date,\n\tSuppCode=P.SuppCode,\n\tSuppInvCode=P.SuppInvCode,\n\tSuppInvDate=P.SuppInvDate,\n\tPurdetail.Batch,   \n\tPurdetail.Expiry,   \n\tQty = SUM(CASE WHEN P.PurCatCode <=2 THEN PurDetail.PackUnits ELSE 1 END * (Purdetail.PackQty + purdetail.looseqty + purdetail.bonusqty))\nFROM PurLedger P, Purdetail, Item\nWHERE \n\tP.PurInvcode = PurDetail.PurInvCode AND\n\tPurdetail.Expiry Between :adt_sdate and :adt_edate AND\n\tPurdetail.icode=item.icode AND\n\tCASE :as_reportgrouping\n\tWHEN 'M' THEN Item.ManfCode\n\tWHEN 'C' THEN Item.ICatCode\n\tWHEN 'L' THEN Item.ICCode\n\tELSE item.PACKCODE END IN (:ai_groupcode) \nGROUP BY \n\tItem.CustomICode,    \n\tItem.ICode,\n\tItem.Name,   \n\tItem.Active,\n\tItem.PackUnits,   \n\tpurdetail.Batch,   \n\tP.PurInvCode,\n\tP.Date,\n\tP.SuppCode,\n\tP.SuppInvCode,\n\tP.SuppInvDate,\n\tPurDetail.Expiry,   \n\tpurDetail.packQty,\n\tpurdetail.looseqty \nORDER BY \n\tGroupName,\n\tItem.Name,   \n\tItem.PackUnits,   \n\tpurdetail.Batch,   \n\tPurDetail.Expiry,   \n\tpurDetail.packQty,\n\tpurdetail.looseqty \n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_reportgrouping",
      "string"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "adt_sdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_edate",
      "datetime"
     ]
    }
   ]
  }
 },
