  "retrieve": "SELECT \n\titemname = service.name,\n\treprintdate = GETDate(),\n\tusers.username,  \n\tdoctor = (SELECT d.Name FROM Doctors D WHERE D.DoctCode = dbo.serviceheader.doctcode ),\n\tpatientrefby = dbo.serviceheader.patientrefby,\n\tdbo.serviceheader.serviceinvcode,   \n\tdbo.serviceheader.date,  \n\tdbo.serviceheader.headerno,\n\tdbo.serviceheader.discperc,   \n\tdbo.serviceheader.misccharges,   \n\tdbo.serviceheader.custcode,   \n\tdbo.serviceheader.remarks,\n\tdbo.serviceheader.flatdisc,\n\treprintcounter = dbo.serviceheader.reprintingcounter,\n\tref1=dbo.serviceheader.ref1,\n\tref2=dbo.serviceheader.ref2,\n\tdbo.service.servicecode,   \n\tprice = dbo.servicedetail.price, \n\tserviceflatdisc= dbo.servicedetail.serviceflatdisc,\n\tQty = dbo.servicedetail.qty,\n\tservicedetail_discperc = servicedetail.discperc, \n\tcustomername=(SELECT Accounts.Name FROM Accounts WHERE Accounts.AccCode  = serviceheader.Custcode),\n\tServiceCategory =  (SELECT sc.name FROM ServiceCategory sc WHERE service.servicecatcode = sc.servicecatcode),\n\tSaleperson =  (SELECT SM.name FROM SalesMan SM WHERE servicedetail.smancode = SM.SalesMancode),\n\tregno=guest.regno,\n\tguest=guest.name,\n\tdbo.serviceheader.saleinvcode,\n\tdbo.serviceheader.servicecatcode,\n\tdeliverydate=dbo.servicedetail.deliverydate\n\t\nFROM \n\tdbo.serviceheader LEFT OUTER JOIN GUEST ON (dbo.serviceheader.guestcode = guest.guestcode),\n\tdbo.servicedetail,  \n\tservice, \n\tusers\n\t\nWHERE \n\t( dbo.serviceheader.serviceinvcode = :ra_InvCode ) AND\n\t( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND \n\t( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND\n\t( servicedetail.servicecode = service.servicecode )\n\t",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  }
 },
