  "retrieve": "SELECT \n\tAliasName = NULL,\n\treprintdate=getdate(),\n\tusers.username,  \n\taccounts.name, \n\theaderno = 1,\n\tposted=h.posted,\n\tbalance=0,\n\tsaleinvcode=h.saleinvcode, \n\tSrBufferInvCode=NULL,\n\tserviceinvcode = h.serviceinvcode,\n\th.date,   \n\th.custcode,   \n\th.remarks,\n\tcustrefno=h.ref1,\t\n\tgcode=NULL,\n\tservicecatcode=h.servicecatcode,\n\tcustomername='                                  '  ,\n\treprintcounter=h.reprintingcounter,\n\tpatient=FullPatientName,\n\tGender=PatientSex,\n\tAge=PatientAge\nFROM \n\tdbo.serviceheader h,\n\tcustomer, \n\taccounts,\n\tusers\nWHERE \n\t( h.serviceinvcode = :ra_InvCode ) AND\n\t( h.custcode = customer.custcode ) AND \n\t( customer.custcode = accounts.acccode ) AND \n\t( h.salesmancode = users.usercode )\n",
