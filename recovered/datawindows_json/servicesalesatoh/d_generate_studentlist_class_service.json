  "retrieve": "SELECT \n\tClassCode = SC.ClassCode,\n\tClassName = C.Name,\n\tStudentCode = SC.StudentCode,\n\tRegNo = S.RegNo,\n\tStudentName = S.Name,\n\tRollNo = SC.RollNo,\n\tServiceCode = :ai_servicecode,\n\tServiceName = (SELECT SV.Name FROM Service SV WHERE SV.ServiceCode = :ai_servicecode),\n\tFee = (SELECT SV.Price FROM Service SV WHERE SV.ServiceCode = :ai_servicecode),\n\tFlatDiscount = (SELECT SV.ServiceFlatDisc FROM Service SV WHERE SV.ServiceCode = :ai_servicecode), \n\tDiscPerc = 0.00,\n\tOmitSpecialCharges=S.OmitSpecialCharges,\n\tSELECTED='Y'\nFROM\n\tStudent S, StudentClass SC, Class C\nWHERE \n\tC.ClassCode IN (:ai_classcode) AND\n\tC.ClassCode = SC.ClassCode AND\n\tSC.StudentCode = S.StudentCode AND\n\tSC.PromotionRowID IS NULL AND\n\tSC.GraduationRowID IS NULL\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_classcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_servicecode",
      "number"
     ]
    }
   ]
  },
  "sort": "classname A, servicename A, rollno A, servicename A"
