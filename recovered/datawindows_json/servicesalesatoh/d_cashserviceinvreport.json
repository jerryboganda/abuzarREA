  "retrieve": "SELECT \n\titemname = service.name,\n\treprintdate = getDate(),\n\tusers.username,  \n\tdbo.serviceheader.serviceinvcode,   \n\tdbo.serviceheader.date,  \n\tdbo.serviceheader.headerno,\n\tdbo.serviceheader.discperc,   \n\tdbo.serviceheader.misccharges,   \n\tdbo.serviceheader.custcode,   \n\tdbo.serviceheader.remarks,\n\tdbo.serviceheader.flatdisc,\n\treprintcounter = dbo.serviceheader.reprintingcounter,\n\tdbo.service.servicecode,   \n\tprice = dbo.servicedetail.price, \n\tserviceflatdisc = dbo.servicedetail.serviceflatdisc, \n\tQty = dbo.servicedetail.qty,\n\tservicedetail_discperc = servicedetail.discperc, \n\tcustomername='                                  '  ,\n\ttokenno = dbo.serviceheader.tokenno,\n\tserviceinvtotal=dbo.fn_getserviceinvtotal(:ra_InvCode)\n\t\nFROM \n\tdbo.serviceheader,   \n\tdbo.servicedetail,  \n\tservice, \n\tusers \n\t\nWHERE \n\t( dbo.serviceheader.serviceinvcode = :ra_InvCode ) AND\n\t( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND \n\t( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND\n\t( servicedetail.servicecode = service.servicecode )  ",
  "arguments": {
