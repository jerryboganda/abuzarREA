  "retrieve": "SELECT \n\tusers.username,  \n\tdbo.serviceheader.serviceinvcode,\n\tdbo.serviceheader.patientrefby,\n\tdbo.serviceheader.date,  \n\tdbo.serviceheader.headerno,\n\tdbo.serviceheader.custcode,   \n\tdbo.serviceheader.remarks,\n\tdbo.serviceheader.servicecatcode,\n\tdeliverydate = dbo.servicedetail.deliverydate,\n\tcustomername=(SELECT Accounts.Name FROM Accounts WHERE Accounts.AccCode  = serviceheader.Custcode),\n\tpatient.regno,\n\tpatient=patient.name,\n\tGender = patient.gender, \n\tAge=LTRIM(RTRIM(STR(DATEDIFF(yyyy, Patient.DOB, getdate()), 4, 0))) + ' Year(s) ' +\n\t\tLTRIM(RTRIM(STR(DATEDIFF(dd, Patient.DOB, getdate()) % 360 / 30, 4, 0))) + ' Month(s) ' +\n\t\tLTRIM(RTRIM(STR(DATEDIFF(dd, Patient.DOB, getdate()) % 360 % 30, 4, 0))) + ' Day(s) ',\n\tdbo.service.servicecode,   \n\titemname = service.name,\n\tservicecomponent = servicecomponent.name,\n\tSampleType = (SELECT SM.Name FROM ServiceSampleRequirement SSR, SampleType SM WHERE SM.SampleTypeCode = SSR.SampleTypeCode AND SSR.ServiceCode = Service.ServiceCode)\nFROM \n\tdbo.serviceheader LEFT OUTER JOIN Patient ON (dbo.serviceheader.patientcode = patient.patientcode),   \n\tdbo.servicedetail,  \n\tservice, \n\tservicebreakup,\n\tservicecomponent,\n\tusers\n\t\nWHERE \n\t( dbo.serviceheader.serviceinvcode = :ra_InvCode ) AND\n\t( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND \n\t( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND\n\t( servicedetail.servicecode = service.servicecode )  and\n\t( service.servicecode = servicebreakup.servicecode )  and\n\t( servicebreakup.servicecomponentcode = servicecomponent.servicecomponentcode )\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  },
  "sort": "serviceheader_serviceinvcode A, itemname A, servicecomponent A"
 },
