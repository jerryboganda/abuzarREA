  "retrieve": "SELECT \n\titemname = service.name,\n\treprintdate = getDate(),\n\tusers.username,  \n\tdbo.serviceheader.serviceinvcode,\n\tdoctor=(select name from doctors where doctors.doctcode=serviceheader.doctcode),   \n\tdbo.serviceheader.date,  \n\tdbo.serviceheader.headerno,\n\tdbo.serviceheader.discperc,   \n\tdbo.serviceheader.misccharges,   \n\tdbo.serviceheader.custcode,   \n\tdbo.serviceheader.remarks,\n\tdbo.serviceheader.flatdisc,\n\tpatientrefby = dbo.serviceheader.patientrefby,\n\treprintcounter = dbo.serviceheader.reprintingcounter,\n\tdbo.service.servicecode,   \n\tprice = dbo.servicedetail.price, \n\tserviceflatdisc=servicedetail.serviceflatdisc,\n\tQty = dbo.servicedetail.qty,\n\tservicedetail_discperc = servicedetail.discperc, \n\tcustomername=(SELECT Accounts.Name FROM Accounts WHERE Accounts.AccCode  = serviceheader.Custcode),\n\tpatient.regno,\n\tpatient=patient.name,\n\tGender = (SELECT P.Gender\n\t\tFROM Patient P\n\t\tWHERE ISNULL(serviceheader.PatientCode, \n\t\t\t(SELECT PA.PatientCode \n\t\t\tFROM PatientAdmission PA \n\t\t\tWHERE PA.AdmissionCode=serviceheader.AdmissionCode)) = P.PatientCode), \n\tDOB = (SELECT P.DOB\n\t\tFROM Patient P\n\t\tWHERE ISNULL(serviceheader.PatientCode, \n\t\t\t(SELECT PA.PatientCode \n\t\t\tFROM PatientAdmission PA \n\t\t\tWHERE PA.AdmissionCode=serviceheader.AdmissionCode)) = P.PatientCode), \n\tAgeYears=\n\t\t(SELECT P.AgeYears\n\t\tFROM Patient P\n\t\tWHERE ISNULL(serviceheader.PatientCode, \n\t\t\t(SELECT PA.PatientCode \n\t\t\tFROM PatientAdmission PA \n\t\t\tWHERE PA.AdmissionCode=serviceheader.AdmissionCode)) = P.PatientCode), \n\tAgeMonths=\n\t\t(SELECT P.AgeMonths\n\t\tFROM Patient P\n\t\tWHERE ISNULL(serviceheader.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=serviceheader.AdmissionCode)) = P.PatientCode), \n\tAgeDays=\n\t\t(SELECT P.AgeDays\n\t\tFROM Patient P\n\t\tWHERE ISNULL(serviceheader.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=serviceheader.AdmissionCode)) = P.PatientCode), \n\n\tdbo.serviceheader.saleinvcode,\n\tdbo.serviceheader.servicecatcode,\n\ttokenno = dbo.serviceheader.tokenno,\n\tDeliveryDate=dbo.servicedetail.DeliveryDate,\n\tCashCharged = dbo.serviceheader.CashCharged\n\t\nFROM \n\tdbo.serviceheader LEFT OUTER JOIN Patient ON (dbo.serviceheader.patientcode = patient.patientcode),   \n\tdbo.servicedetail,  \n\tservice, \n\tusers\n\t\nWHERE \n\t( dbo.serviceheader.serviceinvcode = :ra_InvCode ) AND\n\t( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND \n\t( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND\n\t( servicedetail.servicecode = service.servicecode )\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  }
 },
