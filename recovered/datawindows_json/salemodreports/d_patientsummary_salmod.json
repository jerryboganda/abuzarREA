 "table": {
  "columns": [
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "amount",
    "dbname": "amount"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "qty",
    "dbname": "qty"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "itemname",
    "dbname": "itemname"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "patient",
    "dbname": "patient"
   },
   {
    "type": "char(50)",
    "updatewhereclause": "yes",
    "name": "regno",
    "dbname": "regno"
   }
  ],
  "retrieve": "SELECT amount=sum(amount),\n\t\t qty=sum(looseqty),\n\t\t itemname, \n\t\t patient = (SELECT name FROM patient WHERE patientcode=:ai_patientcode),\n\t\t regno = (SELECT regno FROM patient WHERE patientcode=:ai_patientcode)\nFROM\n\t(SELECT saleinvcode = dbo.saleledgermodified.saleinvcode,    \n\t\t\t looseqty=saledetailmodified.looseqty,\n\t\t\t price = dbo.saledetailmodified.saleprice,    \n\t\t\t itemdiscperc = dbo.saledetailmodified.discperc,    \n\t\t\n\t\t\t\n\t\t\t amount=(((saledetailmodified.looseqty + saledetailmodified.packqty * saledetailmodified.packunits) * (saledetailmodified.saleprice - saledetailmodified.itemflatdisc)) * (1 - (.01 * saledetailmodified.discperc))) * (1- (.01 * saleledgermodified.discperc)),\n\t\t\t itemname=item.name\n\tFROM \t dbo.saleledgermodified, \n\t\t\t dbo.saledetailmodified,    \n\t\t\t dbo.item \n\t\t\t\n\tWHERE  dbo.saleledgermodified.date >= :ad_StartDate AND\n\t\t\t dbo.saleledgermodified.date <= :ad_EndDate  AND\n\t\t\t dbo.saleledgermodified.patientcode=:ai_patientcode AND\n\t\t\t dbo.saleledgermodified.saleinvcode = dbo.saledetailmodified.saleinvcode AND  \n\t\t\t dbo.saledetailmodified.icode = item.icode) AS a\n\nGROUP BY itemname",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_EndDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_patientcode",
      "number"
     ]
    }
   ]
  }
 },
