  "retrieve": " SELECT  documentcode = saleledgermodified.saleinvcode,\n\t\tdivision=max(custrefno2),\n\t\tcustomer=(select name from accounts where accounts.acccode=:ai_custcode),\n\t\trelation=ISNULL((select name from relation where relationcode=saleledgermodified.relationcode),'None'),\n\t\tpatient=(select name from patient where patient.patientcode=saleledgermodified.patientcode),\n\t\tDesignation=(select rank.name from rank,patient where patient.patientcode=saleledgermodified.patientcode and patient.rankcode=rank.rankcode),\n\t\t\n\t\tAlternateAccCode = CASE saleledgermodified.saleCatCode\n\t\t\t\tWHEN 1 THEN saleledgermodified.custcode  /* Cash Sale */\n\t\t\t\tWHEN 3 THEN saleledgermodified.custcode  /* Cash Sale */\n\t\t\t\tELSE Null\n\t\t\t\tEND,\n\t\tDate    = saleledgermodified.date,\n\t\t\n\t\tinvtotal= /*-------gross------*/\n\t\t\tRound(\n\t\t\tSUM((saledetailmodified.looseqty*(saledetailmodified.saleprice - saledetailmodified.itemflatdisc)) *\n\t\t\t(1 - (.01 * saledetailmodified.discperc))) * (1- (.01 * saleledgermodified.discperc)) + \n\t\t\tsaleledgermodified.misccharges + saleledgermodified.salestax - saleledgermodified.flatdisc, 0)\n\t\t\t+ /*-----sales tax-------*/\n\t\t\tRound(\n\t\t\tSUM( (saledetailmodified.looseqty + saledetailmodified.bonusqty) * saledetailmodified.unitsalestax) + \n\t\t\tSUM(ROUND( (saledetailmodified.looseqty * \n\t\t\t(saledetailmodified.saleprice - saledetailmodified.itemflatdisc)) *\n\t\t\t(1 - (.01 * saledetailmodified.discperc)) * saledetailmodified.gstperc * .01, 2)) +\n\t\t\tROUND( (SUM((saledetailmodified.looseqty * \n\t\t\t(saledetailmodified.saleprice - saledetailmodified.itemflatdisc)) *\n\t\t\t(1 - (.01 * saledetailmodified.discperc))) * (1- (.01 * saleledgermodified.discperc)) -\n\t\t\tsaleledgermodified.flatdisc) * (saleledgermodified.invgstperc1 * .01), 2), 0)\n\n\t\t\n\t\t\n\tFROM    saleledgermodified,\t \n\t\t\t  saledetailmodified\t\t\n\tWHERE saleledgermodified.custcode IN (:ai_custcode) AND\n\t\t\tsaleledgermodified.date>=:ad_sdate AND saleledgermodified.date<=:ad_ldate AND\n\t\t\tsaleledgermodified.saleinvcode = saledetailmodified.saleinvcode \n\tGROUP BY saleledgermodified.saleinvcode,\n\t\t saleledgermodified.custcode, \n\t\t saleledgermodified.salecatcode,\n\t\t saleledgermodified.date,\n\t\t saleledgermodified.discperc,\n\t\t saleledgermodified.misccharges,\n\t\t saleledgermodified.salestax,\n\t\t saleledgermodified.flatdisc,\n\t\t saleledgermodified.invgstperc1,\n\t\t saleledgermodified.relationcode,\n\t\t saleledgermodified.patientcode\n  ORDER BY saleledgermodified.saleinvcode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_sdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_ldate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_custcode",
      "number"
     ]
    }
   ]
  },
  "sort": "customer A, documentcode A, date A, patient A, designation A, division A"
 },
