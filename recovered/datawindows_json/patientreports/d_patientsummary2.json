  "retrieve": "SELECT\n\tReportGroup='D',\n\tpatient = (SELECT name FROM patient WHERE patientcode = :ai_patientcode ),\n\tregno = (SELECT regno FROM patient WHERE patientcode = :ai_patientcode ),\n\ta.itemname,\n\tqty =  ISNULL(SUM (CASE type When 'S' THEN ISNULL(Looseqty,0) END) , 0 ) ,\n\tamount = ISNULL(SUM (CASE type When 'S' THEN ISNULL(Amount,0)  END),  0 ) , \n\tsrqty =  ISNULL(SUM (CASE type When 'R' THEN ISNULL(Looseqty,0) END) , 0 ) ,\n\tsramount = ISNULL(SUM (CASE type When 'R' THEN ISNULL(Amount,0)  END) , 0),\n\tMiscCharges=0,\n\tFlatDisc=0,\n\tInvSaleTax=0, \n\tRoundingDiff = 0,\n\tOthers = 0,\n\tDebit=0.00000,\n\tCredit=0.00000,\n\tInActiveDate = (SELECT InActiveDate FROM patient WHERE patientcode = :ai_patientcode ),\n\tInActiveCount = (SELECT InActiveCount FROM patient WHERE patientcode = :ai_patientcode )\nFROM\n\t(SELECT \n\t\ttype = 'S' ,\n\t\tlooseqty=saledetail.looseqty,\n\t\tamount=( ( saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)),\n\t\titemname=item.name\n\tFROM\n\t\tdbo.saleledger, \n\t\tdbo.saledetail,    \n\t\tdbo.item \n\tWHERE\n\t\tdbo.saleledger.date >= :ad_startdate AND\n\t\tdbo.saleledger.date <= :ad_enddate  AND\n\t\tdbo.saleledger.patientcode = :ai_patientcode AND\n\t\tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND  \n\t\tdbo.saledetail.icode = item.icode \n\tUNION ALL\n\tSELECT \n\t\ttype = 'R' ,\n\t\tlooseqty= srdetail.looseqty,\n\t\tamount=( ( srdetail.looseqty * srdetail.srprice ) * (1 - (.01 * srdetail.discperc) )  ) * (1- (.01 * srledger.discperc)),\n\t\titemname = item.name\n\tFROM\n\t\tdbo.srledger, \n\t\tdbo.srdetail,    \n\t\tdbo.item \n\tWHERE\n\t\tdbo.srledger.date >= :ad_startdate AND\n\t\tdbo.srledger.date <= :ad_enddate  AND\n\t\tdbo.srledger.patientcode = :ai_patientcode AND\n\t\tdbo.srledger.srinvcode = dbo.srdetail.srinvcode AND  \n\t\tdbo.srdetail.icode = item.icode) AS A\nGROUP BY itemname\nUNION ALL\nSELECT\n\tReportGroup='T',\n\tpatient = (SELECT patient.name FROM patient WHERE patient.patientcode = :ai_patientcode ),\n\tregno = (SELECT patient.regno FROM patient WHERE patient.patientcode = :ai_patientcode ),\n\titemname='',\n\tqty = 0 ,\n\tamount = 0 , \n\tsrqty = 0 ,\n\tsramount = 0,\n\tMiscCharges=0,\n\tFlatDisc=0,\n\tInvSaleTax=0,\n\tRoundingDiff = 0,\n\tOthers = 0,\n\tDebit=ISNULL(SUM(GD.Debit), 0),\n\tCredit=-ISNULL(SUM(GD.Credit), 0),\n\tInActiveDate = (SELECT InActiveDate FROM patient WHERE patientcode = :ai_patientcode ),\n\tInActiveCount = (SELECT InActiveCount FROM patient WHERE patientcode = :ai_patientcode )\nFROM\n\tGLHeader GL,\n\tGLDetail GD\nWHERE   \n\tGD.PatientCode IN (:ai_patientcode) AND\n\tGL.Posted = 'Y' AND\n\tGL.GlVochCode = GD.GLVochCode AND\n\tGD.AccCode IN (SELECT AccCode FROM Accounts WHERE SubCode=3) AND\n\tGL.Date BETWEEN :ad_startdate AND :ad_enddate\nUNION ALL\nSELECT\n\tReportGroup='S',\n\tpatient = (SELECT name FROM patient WHERE patientcode = :ai_patientcode ),\n\tregno = (SELECT regno FROM patient WHERE patientcode = :ai_patientcode ),\n\titemname='',\n\tqty = 0 ,\n\tamount = 0 , \n\tsrqty = 0 ,\n\tsramount = 0,\n\tMiscCharges=SUM(T.MiscCharges),\n\tFlatDisc=SUM(T.FlatDisc),\n\tInvSaleTax=SUM(T.InvSaleTax),\n\tRoundingDiff = SUM(T.RoundingDiff),\n\tOthers = SUM(ISNULL(T.MiscCharges, 0) - ISNULL(T.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0)),\n\tDebit=0.00000,\n\tCredit=0.00000,\n\tInActiveDate = (SELECT InActiveDate FROM patient WHERE patientcode = :ai_patientcode),\n\tInActiveCount = (SELECT InActiveCount FROM patient WHERE patientcode = :ai_patientcode )\nFROM \n\t(SELECT \n\t\tPatientCode=:ai_patientcode,\n\t\tType='S',\n\t\tInvCode=SS.SaleInvCode,\n\t\tMiscCharges=SS.MiscCharges,\n\t\tFlatDisc=SS.FlatDisc,\n\t\tInvSaleTax=\tROUND((SUM((DD.looseqty * \n\t\t\t(DD.saleprice - DD.itemflatdisc)) *\n\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -\n\t\t\tSS.flatdisc) * (SS.invgstperc1 * .01), 2),\n\t\tRoundingDiff=\n\t\t\tROUND(\n\t\t\t\t\tSUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + \n\t\t\t\t\t\tSUM(ROUND( (DD.looseqty * \n\t\t\t\t\t\t\t(DD.saleprice - DD.itemflatdisc)) *\n\t\t\t\t\t\t\t(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +\n\t\t\t\t\t\tROUND( (SUM((DD.looseqty * \n\t\t\t\t\t\t\t(DD.saleprice - DD.itemflatdisc)) *\n\t\t\t\t\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -\n\t\t\t\t\t\t\tSS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + \n\t\t\t\t\tRound(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *\n\t\t\t\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + \n\t\t\t\t\t\tSS.misccharges + SS.salestax - SS.flatdisc, 0) - \n\t\t\t\n\t\t\t\t\t(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + \n\t\t\t\t\t\tSUM(ROUND( (DD.looseqty * \n\t\t\t\t\t\t\t(DD.saleprice - DD.itemflatdisc)) *\n\t\t\t\t\t\t\t(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +\n\t\t\t\t\t\tROUND( (SUM((DD.looseqty * \n\t\t\t\t\t\t\t(DD.saleprice - DD.itemflatdisc)) *\n\t\t\t\t\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -\n\t\t\t\t\t\t\tSS.flatdisc) * (SS.invgstperc1 * .01), 2) + \n\t\t\t\t\tSUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *\n\t\t\t\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + \n\t\t\t\t\t\tSS.misccharges + SS.salestax - SS.flatdisc),\n\t\tNetAmt=ROUND(\n\t\tSUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + \n\t\t\tSUM(ROUND( (DD.looseqty * \n\t\t\t\t(DD.saleprice - DD.itemflatdisc)) *\n\t\t\t\t(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +\n\t\t\tROUND( (SUM((DD.looseqty * \n\t\t\t\t(DD.saleprice - DD.itemflatdisc)) *\n\t\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -\n\t\t\t\tSS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + \n\t\tRound(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *\n\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + \n\t\t\tSS.misccharges + SS.salestax - SS.flatdisc, 0)\n\tFROM SaleLedger SS, SaleDetail DD \n\tWHERE \n\t\tSS.PatientCode IN (:ai_patientcode) AND\n\t\tSS.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\t\tSS.SaleInvCode = DD.SaleInvCode\n\tGROUP BY\n\t\tSS.SaleInvCode,\n\t\tSS.DiscPerc,\n\t\tSS.FlatDisc,\n\t\tSS.InvGSTPerc1,\n\t\tSS.DiscPerc,\n\t\tSS.MiscCharges,\n\t\tSS.SalesTax\n\tUNION ALL\n\tSELECT \n\t\tPatientCode=:ai_patientcode,\n\t\tType='R',\n\t\tInvCode=SS.SRInvCode,\n\t\tMiscCharges=-SS.MiscCharges,\n\t\tFlatDisc=-SS.FlatDisc,\n\t\tInvSaleTax=\tROUND((SUM((DD.looseqty * DD.SRPrice) *\n\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -\n\t\t\tSS.flatdisc) * (SS.invgstperc1 * .01), 2),\n\t\tRoundingDiff=\n\t\t- (ROUND(\n\t\tSUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + \n\t\t\tSUM(ROUND( (DD.looseqty * DD.SRPrice) *\n\t\t\t\t(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +\n\t\t\tROUND( (SUM((DD.looseqty * DD.SRPrice) *\n\t\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -\n\t\t\t\tSS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + \n\t\tRound(SUM((DD.looseqty * DD.SRPrice) *\n\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + \n\t\t\tSS.misccharges + SS.salestax - SS.flatdisc, 0) - \n\t\t\n\t\t(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + \n\t\t\tSUM(ROUND( (DD.looseqty * DD.SRPrice) *\n\t\t\t\t(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +\n\t\t\tROUND( (SUM((DD.looseqty * DD.SRPrice) *\n\t\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -\n\t\t\t\tSS.flatdisc) * (SS.invgstperc1 * .01), 2) + \n\t\tSUM((DD.looseqty * DD.SRPrice) *\n\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + \n\t\t\tSS.misccharges + SS.salestax - SS.flatdisc) ),\n\t\tNetAmt=\n\t\tROUND(\n\t\tSUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + \n\t\t\tSUM(ROUND( (DD.looseqty * DD.SRPrice) *\n\t\t\t\t(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +\n\t\t\tROUND( (SUM((DD.looseqty * DD.SRPrice) *\n\t\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -\n\t\t\t\tSS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + \n\t\tRound(SUM((DD.looseqty * DD.SRPrice) *\n\t\t\t(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + \n\t\t\tSS.misccharges + SS.salestax - SS.flatdisc, 0)\n\tFROM SRLedger SS, SRDetail DD \n\tWHERE \n\t\tSS.PatientCode IN (:ai_patientcode) AND\n\t\tSS.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\t\tSS.SRInvCode = DD.SRInvCode\n\tGROUP BY\n\t\tSS.SRInvCode,\n\t\tSS.DiscPerc,\n\t\tSS.FlatDisc,\n\t\tSS.InvGSTPerc1,\n\t\tSS.DiscPerc,\n\t\tSS.MiscCharges,\n\t\tSS.SalesTax) T\nGROUP BY PatientCode\nORDER BY\n\tPATIENT,\n\tREGNO,\n\tREPORTGROUP,\n\tITEMNAME",
  "arguments": {
