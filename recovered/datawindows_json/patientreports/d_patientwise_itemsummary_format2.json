    "dbname": "itemname"
   }
  ],
  "retrieve": "SELECT \n\t\t patient = Max(patient.name) ,\n\t\t regno = Max(patient.regno) ,\n\t\t rank = Max(rank.name),  \n\t\t unit = Max(unit.name),\n\t    looseqty = Sum(saledetail.looseqty),\n       unitprice = Max(SaleDetail.saleprice),\n       itemname=(CASE max(SaleDetail.SaleItemDescription) WHEN NULL THEN item.name ELSE max(SaleDetail.SaleItemDescription) END)\n\nFROM \t dbo.saleledger, \n\t\t dbo.saledetail,    \n\t\t dbo.item,\n   \t dbo.patient,\n\t\t dbo.rank,\n\t\t dbo.unit \n\nWHERE  dbo.saleledger.date >= :ad_startdate AND\n\t\t dbo.saleledger.date <= :ad_enddate  AND\n\t\t dbo.saleledger.patientcode = dbo.patient.patientcode AND\n\t\t dbo.patient.patientcode = :ai_patientcode AND\n\t\t dbo.patient.rankcode = dbo.rank.rankcode AND\n\t\t dbo.patient.unitcode = dbo.unit.unitcode AND\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND  \n\t\t dbo.saledetail.icode = item.icode \n\nGROUP BY dbo.item.name",
  "arguments": {
   "_items": [
