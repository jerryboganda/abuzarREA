    "dbname": "ReturnAmount"
   },
   {
    "type": "decimal(2)",
    "update": "yes",
    "updatewhereclause": "yes",
    "name": "netsale",
    "dbname": "NetSale"
   }
  ],
  "retrieve": "SELECT \n\tPatientCode = P.PatientCode,\n\tPatient = P.Name,\n\tRegNo = P.RegNo,\n\tDate=CONVERT(DateTime, S.Date),\n\tS.Month,\n\tSaleAmount = ISNULL(SUM(SaleAmount), 0), \n\tReturnAmount = ISNULL(SUM(ReturnAmount), 0),\n\tNetSale = ISNULL(SUM(SaleAmount), 0) - ISNULL(SUM(ReturnAmount), 0)\nFROM\n\tDBO.Patient P,\n\t(SELECT\n\t\tSL.PatientCode,\n\t\tDate=LTRIM(RTRIM(STR(DATEPART(YEAR, SL.DATE)))) + '-' + LTRIM(RTRIM(STR(DATEPART(MONTH, SL.DATE)))) + '-' + '01' + ' 00:00:00',\n\t\tMonth=DATENAME(MONTH, SL.DATE) + ' ' + DATENAME(YEAR, SL.DATE),\n\t\tSaleAmount = SUM(SL.InvTotal),\n\t\tReturnAmount= 0.00\n\tFROM \t \n\t\tDBO.SaleLedger SL, DBO.Patient P\n\tWHERE\n\t\tSL.Date >= :ad_startdate AND\n\t\tSL.Date <= :ad_enddate AND\n\t\tSL.patientcode = P.PatientCode\n\tGROUP BY\n\t\tSL.PatientCode,\n\t\tSL.DATE\n\tUNION ALL\n\tSELECT \n\t\tSL.PatientCode,\n\t\tDate=LTRIM(RTRIM(STR(DATEPART(YEAR, SL.DATE)))) + '-' + LTRIM(RTRIM(STR(DATEPART(MONTH, SL.DATE)))) + '-' + '01' + ' 00:00:00',\n\t\tMonth=DATENAME(MONTH, SL.DATE) + ' ' + DATENAME(YEAR, SL.DATE),\n\t\tSaleAmount = 0.00,\n\t\tReturnAmount= SUM(SL.InvTotal)\n\tFROM \t \n\t\tDBO.SRLedger SL, DBO.Patient P\n\tWHERE\n\t\tSL.Date >= :ad_startdate AND\n\t\tSL.Date <= :ad_enddate AND\n\t\tSL.patientcode = P.PatientCode\n\tGROUP BY\n\t\tSL.PatientCode, SL.Date) S\nWHERE\n\tP.PatientCode = S.PatientCode\nGROUP BY \n\tP.PatientCode,\n\tP.Name,\n\tP.RegNo,\n\tS.Date,\n\tS.Month\nORDER BY\n\tPatient,\n\tRegno,\n\tDate,\n\tMonth\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "patient A, regno A, patientcode A, date A, month A"
 },
