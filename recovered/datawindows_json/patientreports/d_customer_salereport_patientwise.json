    "name": "amount",
    "dbname": "Amount"
   }
  ],
  "retrieve": "SELECT \n\tCustomerName = A.Name,\n\tAliasName = A.AliasName,\n\tCustomerLine1 = :as_line1,\n\tCustomerLine2 = :as_line2,\n\tSaleType = (SELECT ST.Name FROM SaleType ST WHERE ST.SaleTypeCode = :ai_SaleTypeCode),\n\tPatientCode=P.PatientCode,\n\tRegno=P.RegNo,\n\tEmployeeName = P.Name,\n\tDesignation = (SELECT R.Name FROM Rank R WHERE P.RankCode = R.RankCode),\n\tAmount = ISNULL(SUM(T.Amount), 0)\nFROM\n\tCustomer C,\n\tAccounts A,\n\tPatient P,\n\t(SELECT \n\t\tS.CustCode,\n\t\tS.SaleTypeCode,\n\t\tS.PatientCode,\n\t\tS.SaleInvCode,\n\t\tAmount = SUM((D.LooseQty * D.SalePrice) * (1 + :ad_servicecharge * 0.01))\n\tFROM\n\t\tSaleLedger S,\n\t\tSaleDetail D\n\tWHERE\n\t\tS.CustCode = :ai_custcode AND\n\t\tS.SaleTypeCode = :ai_SaleTypeCode AND\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.SaleInvCode = D.SaleInvCode\n\tGROUP BY \n\t\tS.CustCode,\n\t\tS.SaleTypeCode,\n\t\tS.PatientCode,\n\t\tS.SaleInvCode) T\nWHERE\t\t\n\tC.CustCode = :ai_custcode AND\n\tC.CustCode = A.AccCode AND\n\tA.AccCode = T.CustCode AND\n\tT.PatientCode = P.PatientCode\nGROUP BY\n\tA.Name,\n\tA.AliasName,\n\tP.PatientCode,\n\tP.RegNo,\n\tP.Name,\n\tP.RankCode",
  "arguments": {
   "_items": [
