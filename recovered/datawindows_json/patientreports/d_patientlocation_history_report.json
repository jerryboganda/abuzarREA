  "retrieve": "SELECT\n\tLocationCode=PL.LocationCode,\n\tLocationName=PL.Name + ', ' + W.Name,\n\tTransferCode=NULL,\n\tAdmissionCode=PA.AdmissionCode,\n\tRegNo=P.RegNo,\n\tPatientName=P.Name,\n\tDate=PA.Date,\n\tType = 'IN',\n\tSourceLocation=NULL,\n\tTargetLocation=PA.LocationCode,\n\tRemarks='Admission',\n\tDiseaseName = (SELECT D.Name FROM Disease D WHERE D.DiseaseCode = PA.DiseaseCode),\n\tDoctorName = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = PA.DoctorCode)\nFROM \n\tPatientAdmission PA, Patient P, Patientlocation PL, Ward W\nWHERE \n\tPA.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tPL.LocationCode IN (:ai_locationcode) AND\n\tPL.WardCode=W.WardCode AND\n\tPA.LocationCode = PL.LocationCode AND\n\tPA.PatientCode=P.PatientCode\nUNION ALL\nSELECT \n\tLocationCode=PL.LocationCode,\n\tLocationName=PL.Name + ', ' + W.Name,\n\tTransferCode=PT.TransferCode,\n\tAdmissionCode=PT.AdmissionCode,\n\tRegNo=P.RegNo,\n\tPatientName=P.Name,\n\tPT.Date,\n\tType = 'IN',\n\tSourceLocation=PT.SourceLocation,\n\tTargetLocation=PT.TargetLocation,\n\tRemarks='Transfer',\n\tDiseaseName = (SELECT D.Name FROM Disease D WHERE D.DiseaseCode = PA.DiseaseCode),\n\tDoctorName = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = PA.DoctorCode)\nFROM \n\tPatientTransfer PT, PatientAdmission PA, Patient P, Patientlocation PL, Ward W\nWHERE \n\tPT.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tPL.LocationCode IN (:ai_locationcode) AND\n\tPL.WardCode=W.WardCode AND\n\tPT.TargetLocation = PL.LocationCode AND\n\tPA.AdmissionCode=PT.AdmissionCode AND\n\tPA.PatientCode=P.PatientCode\nUNION ALL\nSELECT \n\tLocationCode=PL.LocationCode,\n\tLocationName=PL.Name + ', ' + W.Name,\n\tTransferCode=PT.TransferCode,\n\tAdmissionCode=PT.AdmissionCode,\n\tRegNo=P.RegNo,\n\tPatientName=P.Name,\n\tPT.Date,\n\tType = 'OUT',\n\tSourceLocation=PT.SourceLocation,\n\tTargetLocation=PT.TargetLocation,\n\tRemarks='Transfer',\n\tDiseaseName = (SELECT D.Name FROM Disease D WHERE D.DiseaseCode = PA.DiseaseCode),\n\tDoctorName = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = PA.DoctorCode)\nFROM \n\tPatientTransfer PT, PatientAdmission PA, Patient P, Patientlocation PL, Ward W\nWHERE \n\tPT.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tPL.LocationCode IN (:ai_locationcode) AND\n\tPL.WardCode=W.WardCode AND\n\tPT.SourceLocation = PL.LocationCode AND\n\tPA.AdmissionCode=PT.AdmissionCode AND\n\tPA.PatientCode=P.PatientCode\nUNION ALL\nSELECT \n\tLocationCode=PL.LocationCode,\n\tLocationName=PL.Name + ', ' + W.Name,\n\tTransferCode=NULL,\n\tAdmissionCode=PA.AdmissionCode,\n\tRegNo=P.RegNo,\n\tPatientName=P.Name,\n\tDate=PA.DischargedOn,\n\tType = 'OUT',\n\tSourceLocation=PA.LocationCode,\n\tTargetLocation=NULL,\n\tRemarks='Discharged',\n\tDiseaseName = (SELECT D.Name FROM Disease D WHERE D.DiseaseCode = PA.DiseaseCode),\n\tDoctorName = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = PA.DoctorCode)\nFROM \n\tPatientAdmission PA, Patient P, Patientlocation PL, Ward W\nWHERE \n\tPA.DischargedOn BETWEEN :adt_startdate AND :adt_enddate AND\n\tPL.LocationCode IN (:ai_locationcode) AND\n\tPL.WardCode=W.WardCode AND\n\tPA.LocationCode = PL.LocationCode AND\n\tPA.PatientCode=P.PatientCode\n",
  "arguments": {
   "_items": [
