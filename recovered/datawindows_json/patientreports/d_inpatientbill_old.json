  "retrieve": "SELECT \n\tRowGroup=1,\n\tItemType='MEDICINE',\n\tRegNo = P.RegNo,\n\tPatient=P.Name,  \n\tAdmissionCode=SL.AdmissionCode,\n\tAdmittedOn=PA.Date,\n\tAdmittedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.UserCode),\n\tDischargedOn=PA.DischargedOn,\n\tDischargedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.DischargedBy),\n\tPA.Discharged,\n\tInvCode=SL.SaleInvCode,\n\tInvDate=SL.Date,\n\tAliasName= I.CustomICode,\n\tItem=I.Name,\n\tType='SL',\n\tQty  = SUM(SD.looseQty),\n\tRate = (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01),\n\tValue= Round(SUM(SD.looseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)), 2)\nFROM \n\tPatient P,\n\tPatientAdmission PA,\n\tSaledetail SD,\n\tSaleLedger SL,\n\tItem I\nWHERE\n\t( PA.AdmissionCode = :ar_admissioncode ) AND\n\t( PA.PatientCode = P.PatientCode ) and  \n\t( SL.AdmissionCode = PA.AdmissionCode ) and  \n\t( SL.SaleInvCode = SD.SaleInvCode ) and\n\t( SD.ICode = I.Icode )\nGROUP  BY\n\tP.RegNo,\n\tP.Name,\n\tSL.AdmissionCode,\n\tPA.Date,\n\tPA.UserCode,\n\tPA.DischargedOn,\n\tPA.DischargedBy,\n\tPA.Discharged,\n\tSL.SaleInvCode,\n\tSL.Date,\n\tI.CustomICode,\n\tI.Name,\n\tSD.SalePrice,\n\tSD.ItemFlatDisc,\n\tSD.DiscPerc,\n\tSL.DiscPerc\nUNION ALL\nSELECT \n\tRowGroup=2,\n\tItemType='MEDICINE',\n\tRegNo = P.RegNo,\n\tPatient=P.Name,\n\tAdmissionCode=SL.AdmissionCode,\n\tAdmittedOn=PA.Date,\n\tAdmittedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.UserCode),\n\tDischargedOn=PA.DischargedOn,\n\tDischargedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.DischargedBy),\n\tPA.Discharged,\n\tInvCode=SL.SRInvCode,\n\tInvDate=SL.Date,\n\tAliasName= I.CustomICode,\n\tItem=I.Name,\n\tType='SR',\n\tQty  = - SUM(SD.looseQty),\n\tRate = SD.SRPrice * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01),\n\tValue= - Round(SUM(SD.looseQty * (SD.SRPrice) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)), 2)\nFROM \n\tPatient P,\n\tPatientAdmission PA,\n\tSRDetail SD,\n\tSRLedger SL,\n\tItem I\nWHERE\n\t( PA.AdmissionCode = :ar_admissioncode ) AND\n\t( PA.PatientCode = P.PatientCode ) and  \n\t( SL.AdmissionCode = PA.AdmissionCode ) and  \n\t( SL.SRInvCode = SD.SRInvCode ) and\n\t( SD.ICode = I.Icode )\nGROUP  BY\n\tP.RegNo,\n\tP.Name,\n\tSL.AdmissionCode,\n\tPA.Date,\n\tPA.UserCode,\n\tPA.DischargedOn,\n\tPA.DischargedBy,\n\tPA.Discharged,\n\tSL.SRInvCode,\n\tSL.Date,\n\tI.CustomICode,\n\tI.Name,\n\tSD.SRPrice,\n\tSD.DiscPerc,\n\tSL.DiscPerc\nUNION ALL\nSELECT \n\tRowGroup=3,\n\tItemType='SERVICES',\n\tRegNo = P.RegNo,\n\tPatient=P.Name,\n\tAdmissionCode=SL.AdmissionCode,\n\tAdmittedOn=PA.Date,\n\tAdmittedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.UserCode),\n\tDischargedOn=PA.DischargedOn,\n\tDischargedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.DischargedBy),\n\tPA.Discharged,\n\tInvCode=SL.ServiceInvCode,\n\tInvDate=SL.Date,\n\tAliasName= '',\n\tItem=S.Name,\n\tType='SV',\n\tQty  = SUM(SD.Qty),\n\tRate = (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01),\n\tValue= Round(SUM(SD.Qty * (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)), 2)\nFROM \n\tPatient P,\n\tPatientAdmission PA,\n\tServicedetail SD,\n\tServiceHeader SL,\n\tService S\nWHERE\n\t( PA.AdmissionCode = :ar_admissioncode ) AND\n\t( PA.PatientCode = P.PatientCode ) and  \n\t( SL.AdmissionCode = PA.AdmissionCode ) and  \n\t( SL.ServiceInvCode = SD.ServiceInvCode ) and\n\t( SD.ServiceCode = S.Servicecode )\nGROUP  BY\n\tP.RegNo,\n\tP.Name,\n\tSL.AdmissionCode,\n\tPA.Date,\n\tPA.UserCode,\n\tPA.DischargedOn,\n\tPA.DischargedBy,\n\tPA.Discharged,\n\tSL.ServiceInvCode,\n\tSL.Date,\n\tS.Name,\n\tSD.Price,\n\tSD.ServiceFlatDisc, \n\tSD.DiscPerc,\n\tSL.DiscPerc\nUNION ALL\nSELECT \n\tRowGroup=4,\n\tItemType='SERVICES',\n\tRegNo = P.RegNo,\n\tPatient=P.Name,\n\tAdmissionCode=SL.AdmissionCode,\n\tAdmittedOn=PA.Date,\n\tAdmittedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.UserCode),\n\tDischargedOn=PA.DischargedOn,\n\tDischargedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.DischargedBy),\n\tPA.Discharged,\n\tInvCode=SL.ServiceRInvCode,\n\tInvDate=SL.Date,\n\tAliasName= '',\n\tItem=S.Name,\n\tType='RS',\n\tQty  = - SUM(SD.Qty),\n\tRate = (SD.ServicePrice - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01),\n\tValue= - Round(SUM(SD.Qty * (SD.ServicePrice - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)), 2)\nFROM \n\tPatient P,\n\tPatientAdmission PA,\n\tServiceRDetail SD,\n\tServiceRHeader SL,\n\tService S\nWHERE\n\t( PA.AdmissionCode = :ar_admissioncode ) AND\n\t( PA.PatientCode = P.PatientCode ) and  \n\t( SL.AdmissionCode = PA.AdmissionCode ) and  \n\t( SL.ServiceRInvCode = SD.ServiceRInvCode ) and\n\t( SD.ServiceCode = S.Servicecode )\nGROUP  BY\n\tP.RegNo,\n\tP.Name,\n\tSL.AdmissionCode,\n\tPA.Date,\n\tPA.UserCode,\n\tPA.DischargedOn,\n\tPA.DischargedBy,\n\tPA.Discharged,\n\tSL.ServiceRInvCode,\n\tSL.Date,\n\tS.Name,\n\tSD.ServicePrice,\n\tSD.ServiceFlatDisc, \n\tSD.DiscPerc,\n\tSL.DiscPerc\nUNION ALL\nSELECT \n\tRowGroup=5,\n\tItemType='OTHERS',\n\tRegNo = P.RegNo,\n\tPatient=P.Name,\n\tAdmissionCode=PA.AdmissionCode,\n\tAdmittedOn=PA.Date,\n\tAdmittedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.UserCode),\n\tDischargedOn=PA.DischargedOn,\n\tDischargedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.DischargedBy),\n\tPA.Discharged,\n\tInvCode=GL.GLVochCode,\n\tInvDate=GL.Date,\n\tAliasName= GD.CHKNO,\n\tItem=GD.Remarks,\n\tType=VC.ShortName,\n\tQty  = NULL,\n\tRate = NULL,\n\tValue= SUM(GD.Debit - Credit)\nFROM \n\tPatient P,\n\tPatientAdmission PA,\n\tGLDetail GD,\n\tGLHeader GL,\n\tVocherCategory VC\nWHERE\n\t( PA.AdmissionCode = :ar_admissioncode ) AND\n\t( PA.PatientCode = P.PatientCode ) AND\n\t( GL.Posted = 'Y' ) AND\n\t( GD.PatientCode = P.PatientCode ) AND\n\t( GL.GLVochCode = GD.GLVochCode ) AND\n\t( GL.VochCatCode = VC.VochCatCode ) AND\n\t( GL.Date >= PA.Date ) AND\n\t( GL.Date <= PA.DischargedOn )\nGROUP  BY\n\tP.RegNo,\n\tP.Name,\n\tPA.AdmissionCode,\n\tPA.Date,\n\tPA.UserCode,\n\tPA.DischargedOn,\n\tPA.DischargedBy,\n\tPA.Discharged,\n\tGL.GLVochCode,\n\tGL.Date,\n\tVC.ShortName,\n\tGD.CHKNO,\n\tGD.Remarks\nORDER BY\n\tRowGroup,\n\tItemType,\n\tRegNo,\n\tPatient,\n\tInvDate,\n\tType,\n\tInvCode,\n\tItem,\n\tAliasName,\n\tQty,\n\tRate,\n\tValue\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_admissioncode",
      "number"
     ]
    }
   ]
  },
  "sort": "rowgroup A, itemtype A, regno A, patient A, invdate A, type A, invcode A"
 },
