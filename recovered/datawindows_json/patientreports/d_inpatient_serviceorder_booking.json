    "name": "ward",
    "dbname": "Ward"
   }
  ],
  "retrieve": "SELECT \n\tOrderCode=H.ServiceOCode,\n\tOrderDate=H.Date,\n\tBookingDate=D.Date, \n\tPatientRegNo=P.RegNo,\n\tPatient=P.Name,\n\tSEX= CASE P.GENDER WHEN 'M' THEN 'Male' ELSE 'Female' END,\n\tAGE= DATEDIFF(yy, P.DOB, GETDATE()),\n\tService= S.Name,\n\tDoctor= (SELECT D.Name FROM Doctors D WHERE D.DoctCode = H.DoctCode),\n\tLocation = LTRIM(RTRIM(PL.Name)) + '(' + LTRIM(RTRIM(W.Name)) + ')',\n\tWard = W.Name\nFROM \n\tServiceOHeader H, \n\tServiceODetail D,\n\tPatientAdmission PA,\n\tPatientLocation PL,\n\tPatient P,\n\tService S,\n\t(SELECT \n\t\tPA.AdmissionCode, \n\t\tLocationCode = ISNULL((SELECT TargetLocation FROM PatientTransfer \n\t\t\t\t\t\t\t\t\tWHERE PatientTransfer.TransferCode = \n\t\t\t\t\t\t\t\t\t\t\t(SELECT Max(PatientTransfer.TransferCode) \n\t\t\t\t\t\t\t\t\t\t\tFROM PatientTransfer \n\t\t\t\t\t\t\t\t\t\t\tWHERE PatientTransfer.AdmissionCode = PA.AdmissionCode)), (SELECT A.LocationCode FROM PatientAdmission A WHERE A.AdmissionCode = PA.AdmissionCode))\n\tFROM PatientAdmission PA) L,\n\tWard W\n\nWHERE\n\tD.Date >= :ad_startdate AND D.Date <= :ad_enddate AND\n\tD.ServiceCode = S.ServiceCode AND \n\tD.ServiceOCode = H.ServiceOCode AND\n\tH.AdmissionCode = PA.AdmissionCode AND\n\tPA.PatientCode = P.PatientCode AND\n\tPA.AdmissionCode = L.AdmissionCode AND\n\tL.LocationCode = PL.LocationCode AND\n\tPL.WardCode = W.WardCode\nORDER BY\n\tBookingDate\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "bookingdate A, location A, sex A, age A, doctor A"
 },
