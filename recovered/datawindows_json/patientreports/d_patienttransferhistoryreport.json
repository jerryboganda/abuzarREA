    "name": "transferto",
    "dbname": "TransferTo"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "transferby",
    "dbname": "TransferBy"
   }
  ],
  "retrieve": "SELECT\n\tPatientCode=P.PatientCode,\n\tRegNo=P.RegNo,\n\tName = P.Name,\n\tAdmissionCode=PA.AdmissionCode,\n\tTransferCode=T.TransferCode,\n\tTransferDate=T.Date,\n\tTransferFrom=(SELECT LTRIM(RTRIM(PL.NAME)) + ', ' + LTRIM(RTRIM(W.Name))\n\t\t\tFROM PatientLocation PL, Ward W\n\t\t\tWHERE PL.LocationCode=T.SourceLocation AND\n\t\t\t\tPL.WardCode=W.WardCode),\n\tTransferTo=(SELECT LTRIM(RTRIM(PL.NAME)) + ', ' + LTRIM(RTRIM(W.Name))\n\t\t\tFROM PatientLocation PL, Ward W\n\t\t\tWHERE PL.LocationCode=T.TargetLocation AND\n\t\t\t\tPL.WardCode=W.WardCode),\n\tTransferBy=U.UserName\nFROM\n\tPatientTransfer T, \n\tPatientAdmission PA,\n\tPatient P,\n\tUsers U\nWHERE\n\tT.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tT.AdmissionCode=PA.AdmissionCode AND\n\tPA.PatientCode = P.PatientCode AND\n\tT.Usercode = U.UserCode\nORDER BY\n\tName,\n\tRegNo,\n\tPA.AdmissionCode,\n\tT.Date,\n\tT.TransferCode,\n\tTransferFrom,\n\tTransferTo,\n\tTransferBy\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
