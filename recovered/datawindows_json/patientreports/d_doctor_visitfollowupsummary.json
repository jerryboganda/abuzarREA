    "dbname": "Diagnosis"
   }
  ],
  "retrieve": "SELECT \n\tVisitCode=V.VisitCode,\n\tVisitDate=V.Date,\n\tFollowUpDate= V.FollowUpDate,\n\tDoctCode=V.DoctCode,\n\tDoctorName = D.Name,\n\tPatientRegNo = P.RegNo,\n\tPatientName = P.Name,\n\tMobileNo = P.MobileNo1,\n\tDiagnosis = V.Diagnosis\nFROM \n\tVisit V\n\tLEFT OUTER JOIN Patient AS P ON (V.PatientCode = P.PatientCode), \n\tDoctors D\nWHERE \n\tV.UserCode = :ai_usercode AND\n\tV.Date + V.FollowUpDays >= GETDATE() AND \n\tV.Date + V.FollowUpDays <= GETDATE() + :ai_day AND \n\tV.DoctCode = D.DoctCode\nORDER BY\n\tDoctorName,\n\tV.Date",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_usercode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_day",
      "number"
     ]
    }
   ]
  },
  "sort": "doctorname A, visitdate A"
 },
