    "name": "doctor",
    "dbname": "Doctor"
   }
  ],
  "retrieve": "SELECT \n\tPatientCode,\n\tRegNo,\n\tName, \n\tContact = LTRIM(RTRIM(ISNULL(MobileNo1, '') + ' ' + ISNULL(MobileNo2, '') + ' ' + ISNULL(MobileNo3, ''))),\n\tDoctor = (/*SELECT DoctCode=MAX(S.DoctCode)\n\t\t\t\t\tFROM SaleLedger S\n\t\t\t\t\tWHERE S.PatientCode = Patient.PatientCode\n\t\t\t\t\tUNION*/\n\t\t\t\tSELECT MAX(D.Name) FROM Doctors D \n\t\t\t\tWHERE D.DoctCode IN\n\t\t\t\t\t(SELECT DoctCode=MAX(S.DoctCode)\n\t\t\t\t\tFROM ServiceHeader S\n\t\t\t\t\tWHERE S.PatientCode = Patient.PatientCode))\nFROM \n\tPatient\nWHERE\t\n\tDATEPART(month, :adt_birthdate) = DATEPART(month, Patient.DOB)  AND\n\tDATEPART(d, :adt_birthdate) = DATEPART(d, Patient.DOB)\nORDER BY\n\tName, RegNo",
  "update": "Patient",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_birthdate",
      "datetime"
     ]
    }
   ]
  }
 },
