    "name": "patienttotal",
    "dbname": "patienttotal"
   }
  ],
  "retrieve": "SELECT\n\tA.regno,\n\tA.patientname,\n\tA.customer,\n\tpatienttotal=sum(A.patienttotal)\n\nFROM\n\t\t(select  \n\t\t\t\n\t\t\tregno=P.regno,\n\t\t\tpatientname=P.name,\n\t\t\tcustomer=(select name from accounts where accounts.acccode=P.custcode),\n\t\t\tpatienttotal=dbo.fn_getsaleinvtotal(SL.saleinvcode)\n\t\tfrom \n\t\t\tsaleledger SL , patient P\n\t\twhere  \n\t\t\tSL.date>=:ad_StartDate AND \n\t\t\tSL.date<=:ad_EndDate AND\n\t\t\tSL.custcode IN (:ai_custcode) AND\n\t\t\tP.patientcode=SL.patientcode \n\t\t\n\t\t\t) as A\nGROUP By\n\tA.customer,\n\tA.Patientname,\n\tA.Regno\n\nORDER BY\n\tA.customer,\n\tA.patientname,\n\tA.Regno\n\t\n\n\t",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_EndDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_custcode",
      "numberlist"
     ]
    }
   ]
  }
 },
