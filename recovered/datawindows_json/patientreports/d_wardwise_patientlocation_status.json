  "retrieve": "SELECT\n\tPA.AdmissionCode,\n\tPA.PatientCode,\n\tPatientRegNo=P.RegNo, \n\tPatientName=P.Name, \n\tPA.Date,\n\tAdmittedBy=(SELECT Users.UserName FROM Users WHERE Users.UserCode = PA.UserCode),\n\tPA.Diagnosis, \n\tDoctor=(SELECT Doctors.Name FROM Doctors WHERE Doctors.DoctCode = PA.DoctorCode), \n\tDisease=(SELECT Disease.Name FROM Disease WHERE Disease.DiseaseCode = PA.DiseaseCode), \n\tPA.Discharged,\n\tLocation = L.Name,\n\tWardCode=L.WardCode,\n\tWardName=W.Name,\n\tOccupied='Y'\nFROM \n\tPatientAdmission PA, \n\tPatient P, \n\tPatientLocation L,\n\tWard W,\n\t(SELECT \n\t\tPA.AdmissionCode, \n\t\tLocationCode= \t\t\t\t\tISNULL((SELECT TargetLocation FROM PatientTransfer \n\t\t\t\t\t\t\t\t\tWHERE PatientTransfer.TransferCode = \n\t\t\t\t\t\t\t\t\t\t\t(SELECT Max(PatientTransfer.TransferCode) \n\t\t\t\t\t\t\t\t\t\t\tFROM PatientTransfer \n\t\t\t\t\t\t\t\t\t\t\tWHERE PatientTransfer.AdmissionCode = PA.AdmissionCode)), (SELECT A.LocationCode FROM PatientAdmission A WHERE A.AdmissionCode = PA.AdmissionCode))\n\tFROM PatientAdmission PA\n\tWHERE PA.Discharged = 'N') PAL\nWHERE \n\tL.WardCode IN (:ai_wardcode) AND\n\tPA.Discharged = 'N' AND\n\tPA.PatientCode = P.PatientCode AND\n\tPA.AdmissionCode = PAL.AdmissionCode AND\n\tPAL.LocationCode = L.LocationCode AND\n\tL.WardCode = W.WardCode\nUNION ALL\nSELECT \n\tAdmissionCode=NULL,\n\tPatientCode=NULL,\n\tPatientRegNo=NULL, \n\tPatientName=NULL, \n\tDate=NULL,\n\tAdmittedBy=NULL,\n\tDiagnosis=NULL, \n\tDoctor=NULL, \n\tDisease=NULL, \n\tDischarged=NULL,\n\tLocation = L.Name,\n\tWardCode=L.WardCode,\n\tWardName=W.Name,\n\tOccupied='N'\nFROM \n\tPatientLocation L,\n\tWard W\nWHERE \n\tL.WardCode IN (:ai_wardcode) AND\n\tL.LocationCode NOT IN \n\t \t(SELECT DISTINCT LocationCode= ISNULL(\n\t\t\t\t(SELECT TargetLocation FROM PatientTransfer \n\t\t\t\tWHERE PatientTransfer.TransferCode = \n\t\t\t\t\t\t(SELECT Max(PatientTransfer.TransferCode) \n\t\t\t\t\t\tFROM PatientTransfer \n\t\t\t\t\t\tWHERE PatientTransfer.AdmissionCode = PA.AdmissionCode)), \n\t\t\t(SELECT A.LocationCode \n\t\t\tFROM PatientAdmission A \n\t\t\tWHERE A.AdmissionCode = PA.AdmissionCode))\n\t\tFROM PatientAdmission PA\n\t\tWHERE PA.Discharged = 'N') AND\n\tL.WardCode = W.WardCode\nORDER BY\n\tW.Name,\n\tL.Name,\n\tOccupied,\n\tPatientName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_wardcode",
      "numberlist"
     ]
    }
   ]
  }
 },
