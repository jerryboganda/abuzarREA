    "name": "date",
    "dbname": "Date"
   }
  ],
  "retrieve": "SELECT DISTINCT\n\tPatientCode=P.PatientCode, \n\tRegNo=P.Regno, \n\tPatientName=P.Name, \n\tDisease = D.Name,\n\tDiagnosis=P.Diagnosis,\n\tDoctor = (SELECT DC.Name FROM Doctors DC WHERE DC.DoctCode = P.DoctCode),\n\tDate = S.Date\nFROM \n\tPatient P\n\tLEFT OUTER JOIN Disease AS D ON (P.DiseaseCode = D.DiseaseCode),\n\tSaleLedger S\nWHERE\n\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\tP.PatientCode = S.PatientCode AND\n\t(P.DiseaseCode IS NOT NULL OR P.DiagNosis IS NOT NULL)\nORDER BY\n\tDate,\n\tPatientName\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "date A, patientname A"
 },
