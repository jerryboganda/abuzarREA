  ],
  "retrieve": "SELECT\n\tTransferCode=T.TransferCode,\n\tTransferDate=T.Date,\n\tTransferFrom=(SELECT LTRIM(RTRIM(PL.NAME)) + ', ' + LTRIM(RTRIM(W.Name))\n\t\t\tFROM PatientLocation PL, Ward W\n\t\t\tWHERE PL.LocationCode=T.SourceLocation AND\n\t\t\t\tPL.WardCode=W.WardCode),\n\tTransferTo=(SELECT LTRIM(RTRIM(PL.NAME)) + ', ' + LTRIM(RTRIM(W.Name))\n\t\t\tFROM PatientLocation PL, Ward W\n\t\t\tWHERE PL.LocationCode=T.TargetLocation AND\n\t\t\t\tPL.WardCode=W.WardCode),\n\tTransferBy=U.UserName\nFROM\n\tPatientTransfer T, \n\tUsers U\nWHERE\n\tT.AdmissionCode = :Code And\n\tT.Usercode = U.UserCode\nORDER BY\n\tT.TransferCode DESC,\n\tT.Date,\n\tTransferFrom,\n\tTransferTo,\n\tTransferBy",
  "arguments": {
   "_items": [
    {
     "_items": [
      "code",
      "number"
     ]
    }
   ]
  }
 },
