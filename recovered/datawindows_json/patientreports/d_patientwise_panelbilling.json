  "retrieve": "SELECT\n\tDate = S.Date,\n\tSaleInvCode = S.SaleInvCode,\n\tCustCode = S.CustCode,\n\tCustomerName = A.Name,\n\tCustomerAliasName = A.AliasName,\n\tPatientCode = S.PatientCode,\n\tPatientName = P.Name,\n\tPatientRegNo = P.RegNo,\n\tItemCode = D.ICode,\n\tItemName = I.Name,\n\tItemAliasName = I.CustomICode,\n\tSalePrice = MAX(D.SalePrice),\n\tQty = SUM(D.LooseQty),\n\tAmount = SUM(D.LooseQty * D.SalePrice)\nFROM \n\tPatient P,\n\tCustomer C,\t\n\tAccounts A,\n\tSaleLedger S,\n\tSaleDetail D,\n\tItem I\nWHERE\n\tS.Date BETWEEN :ad_startdate AND :ad_enddate AND\n\tS.PatientCode IN (:ai_patientcode) AND\n\tS.PatientCode = P.PatientCode AND\n\tS.CustCode = C.CustCode AND\n\tC.CustCode = A.AccCode AND\n\tS.SaleInvCode = D.SaleInvCode AND\n\tD.ICode = I.ICode \nGROUP BY\n\tS.Date,\n\tS.SaleInvCode,\n\tS.CustCode,\n\tA.Name,\n\tA.AliasName,\n\tS.PatientCode,\n\tP.Name,\n\tP.RegNo,\n\tD.ICode,\n\tI.Name,\n\tI.CustomICode\nORDER BY\n\tCustomerName,\n\tPatientName,\n\tDate,\n\tItemName",
