   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "location",
    "dbname": "Location"
   }
  ],
  "retrieve": "SELECT \n\tA.RegNo,\n\tA.Name, \n\tA.PatientCode,\n\tDoctor=(SELECT D.Name FROM Doctors D WHERE D.DoctCode = A.DoctCode),\n\tA.Customer,\n\tCustomerCategory = (SELECT CustomerCategory.Name FROM CustomerCategory WHERE CustomerCategory.CustCatCode = A.CustCatCode),\n\tDebit= CASE WHEN Balance > 0 THEN Balance ELSE 0 END,\n\tCredit= CASE WHEN Balance < 0 THEN ABS(Balance) ELSE 0 END,\n\tDischarged=\n\t\t(SELECT PA.Discharged \n\t\tFROM PatientAdmission PA\n\t\tWHERE PA.AdmissionCode IN \t\n\t\t\t(SELECT AdmissionCode=MAX(AdmissionCode) \n\t\t\tFROM PatientAdmission \n\t\t\tWHERE PatientCode = A.PatientCode)),\n\tLocation=\n\t\tCASE WHEN A.LocationCode IS NULL THEN\n\t\t\t(SELECT PL.Name\n\t\t\tFROM PatientAdmission PA, PatientLocation PL\n\t\t\tWHERE \n\t\t\t\tPA.PatientCode = A.PatientCode AND\n\t\t\t\tPA.AdmissionCode IN \n\t\t\t\t\t(SELECT AdmissionCode=MAX(AdmissionCode) \n\t\t\t\t\tFROM PatientAdmission \n\t\t\t\t\tWHERE PatientAdmission.PatientCode = A.PatientCode) AND\n\t\t\t\t\tPA.LocationCode = PL.LocationCode)\n\t\tELSE\n\t\t\t(SELECT PL.Name\n\t\t\tFROM PatientLocation PL\n\t\t\tWHERE \n\t\t\t\tA.LocationCode = PL.LocationCode)\n\t\tEND\t\nFROM\n\t(SELECT \n\t\tP.Name, P.RegNo, P.LocationCode, P.PatientCode, P.DoctCode,\n\t\tC.CustCode, Customer=A.Name, C.CustCatCode,\n\t\tBalance=SUM(V.Debit - V.Credit)\n\tFROM\n\t\tVirtualGL V,\n\t\tAccounts A,\n\t\tCustomer C,\n\t\tSubAccounts S,\n\t\tPatient P\n\tWHERE \n\t\tV.PatientCode = P.PatientCode AND\n\t\tV.Date <= :ad_Date AND \n\t\tV.AccCode = A.AccCode AND\n\t\tA.AccCode = C.CustCode AND\n\t\tC.CustCode IN (:ai_custcode) AND\n\t\tV.AccCode = C.CustCode AND\n\t\tA.SubCode = S.SubAccCode \n\tGROUP BY \n\t\tP.PatientCode, \n\t\tP.Name, \n\t\tP.RegNo, \n\t\tP.LocationCode,\n\t\tP.DoctCode,\n\t\tA.Name, \n\t\tC.CustCode,\n\t\tC.CustCatCode) A\nORDER BY CustomerCategory, A.RegNo, A.Name, A.PatientCode, A.Customer\n   ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_date",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_custcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "customercategory A, customer A, regno A, name A"
 },
