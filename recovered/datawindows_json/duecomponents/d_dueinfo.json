    "dbname": "salesman"
   }
  ],
  "retrieve": "SELECT\n\tgroupcode = \tcase :ar_grouptype \n\t\twhen 'P' then item.packcode\n\t\twhen 'C' THEN item.icatcode\n\t\twhen 'L' THEN item.iccode\n\t\twhen 'M' THEN item.manfcode  end,\n\tgroupname = \tcase :ar_grouptype \n\t\twhen 'P' then (SELECT P.Name FROM ItemPacking P WHERE P.PackCode = item.packcode)\n\t\twhen 'C' THEN (SELECT C.Name FROM ItemCategory C WHERE C.ICatCode = item.icatcode) \n\t\twhen 'L' THEN (SELECT L.Name FROM ItemClass L WHERE L.ICCode = item.iccode) \n\t\twhen 'M' THEN (SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = item.manfcode) end,\n\tinvcode     = dbo.saleledger.saleinvcode,\n\tdate        = dbo.saleledger.date,\n\titemname    = dbo.item.name, \n\taliasname=item.customicode,\n\tdbo.accounts.name, \n\tstatus = Case\tWhen dbo.saledetail.Due = 'D' Then 'Due'\n\t\t\tWhen dbo.saledetail.Due = 'X' Then 'Deleted' \n\t\t\tWhen dbo.saledetail.Due = 'S' Then 'Satisfied' \n\t\t\tEnd, \n\trate = dbo.saledetail.rate, \n\tquantity = dbo.saledetail.looseqty, \n\tsalesman = dbo.users.username \nFROM \n\tdbo.saleledger, \n\tdbo.saledetail,  \n\tdbo.item, \n\tdbo.accounts,\n\tdbo.users\nWHERE \n\t( dbo.saleledger.date between :ar_StartDate and :ar_EndDate) and\n\t( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and  \n\t( dbo.saledetail.Due in ('D', 'X', 'S')) and  \n\t( dbo.saledetail.icode = dbo.item.icode ) and\n\tcase :ar_grouptype \n\t\twhen 'P' then item.packcode\n\t\twhen 'C' THEN item.icatcode\n\t\twhen 'L' THEN item.iccode\n\t\twhen 'M' THEN item.manfcode  end  IN (:ar_groupcode) and\n\t( dbo.saleledger.custcode = dbo.accounts.acccode ) and  \n\t( dbo.saleledger.salesmancode = dbo.users.usercode )\nORDER BY \n\tgroupname,\n\tgroupcode,\n\tdbo.saleledger.saleinvcode ASC,\n\tdbo.saleledger.date ASC\n",
  "arguments": {
