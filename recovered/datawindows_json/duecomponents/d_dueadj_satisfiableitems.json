   }
  ],
  "retrieve": "Select Sl.SaleInvcode, Sd.icode, i.name, Sd.gcode, Sd.RowId, Sd.looseqty,\n\t\t SatisfiedQty = IsNull ( (select sum(dsd.duesatisfyqty) from duesatisfyheader dsh, duesatisfydetail dsd where dsh.saleinvcode = sl.saleinvcode And dsh.duesatisfycode = dsd.duesatisfycode And dsd.icode = sd.icode And dsd.salerowid = sd.rowid )  ,  0  )\nFrom   SaleLedger Sl, SaleDetail Sd , item i \nWhere  sl.saleinvcode = sd.saleinvcode And  \n\t    sl.Posted = 'Y'  And\n\t    sl.Date Between :ad_startdate  And :ad_enddate And\n\t    sd.icode = i.icode And\n\t    sd.Due = 'D' \nOrder By Sl.saleinvcode, i.name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
