  "retrieve": "SELECT \n\tDueSatisfyDetail.DueSatisfyCode,   \n\tDueSatisfyDetail.ICode,   \n\tDueSatisfyDetail.GCode,   \n\tDueSatisfyDetail.Batch,   \n\tDueSatisfyDetail.Expiry,\n\tDueSatisfyDetail.BalanceStock,\n\tDueSatisfyDetail.SaleRowId,\n\ttotalsatisfyqty = 0.0000,  \n\tDueDelete = 0.0000,\n\tDueQty = (select looseqty from saledetail\n\t\t\t\t where saleinvcode = (Select saleinvcode from DueSatisfyHeader\n\t\t\t\t\t\t\t\t\t\t\t\twhere DueSatisfyHeader.DueSatisfyCode = :ar_DueSatisfyCode )And\n\t\t\t\t\t\t saledetail.icode = DueSatisfyDetail.icode and \n\t\t\t\t\t\t saledetail.RowId = DueSatisfyDetail.SaleRowId and\n\t\t\t\t\t\t saledetail.due In ('D', 'S', 'X')),\n\tDueSatisfyDetail.DueSatisfyQty\nFROM \n\tDueSatisfyDetail  \nWHERE \n\tDueSatisfyDetail.DueSatisfyCode = :ar_DueSatisfyCode    \n",
