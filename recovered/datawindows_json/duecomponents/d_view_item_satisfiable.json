    "dbname": "SatisfiedQty"
   }
  ],
  "retrieve": "SELECT \n\tSaleInvCode = SL.SaleInvcode, \n\tDate = SL.Date,\n\tSD.ICode, \n\tAliasName = I.CustomICode,\n\tItemName = I.Name, \n\tGodown = SD.GCode, \n\tRowID=SD.RowID, \n\tDueQty = SD.LooseQty,\n\tSatisfiedQty = \n\t\tISNULL(\n\t\t\t(SELECT SUM(DSD.DueSatisfyQty) \n\t\t\tFROM DueSatisfyHeader DSH, DueSatisfyDetail DSD \n\t\t\tWHERE DSH.SaleInvCode = SL.SaleInvCode AND \n\t\t\t\tDSH.DueSatisfyCode = DSD.DueSatisfyCode AND \n\t\t\t\tDSD.ICode = SD.ICode AND\n\t\t\t\tDSD.SaleRowID = SD.RowID), 0)\nFROM\n\tSaleLedger SL, \n\tSaleDetail SD, \n\tItem I \nWHERE\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSL.Posted = 'Y'  AND\n\tSD.ICode = :ai_icode AND\n\tSD.ICode = I.ICode AND\n\tSD.Due = 'D' \nORDER BY \n\tSL.SaleInvCode, \n\tI.Name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_icode",
      "number"
     ]
    }
   ]
  },
  "sort": "date A",
  "filter": "(dueqty - satisfiedqty) > 0"
 },
