  "retrieve": "SELECT \n\tcode=dbo.duesatisfyheader.duesatisfycode,\n\tsaleinvcode=dbo.duesatisfyheader.saleinvcode, \n\tdate\t\t=dbo.duesatisfyheader.duesatisfydate,\n\tsaledate\t=(select date from dbo.saleledger  \n\t\t\t\twhere saleinvcode = dbo.duesatisfyheader.saleinvcode),\n\tcustomer\t=(select name from dbo.accounts  \n\t\t\t  where acccode =\n\t\t\t\t(select custcode from dbo.saleledger \n\t\t\t  \twhere saleinvcode = dbo.duesatisfyheader.saleinvcode)),\n\titemname = dbo.item.name, \n\tquantity = dbo.duesatisfydetail.duesatisfyqty, \n\tgodown=(select name from dbo.godown where gcode = dbo.duesatisfydetail.gcode),\n\tdbo.duesatisfydetail.batch, \n\tdbo.duesatisfydetail.expiry,\n\trate=Round(dbo.duesatisfydetail.packsaleprice/CASE dbo.duesatisfydetail.packunits WHEN 0 THEN 1 ELSE dbo.duesatisfydetail.packunits END, 2),\n\tusername = dbo.users.username,\n\ticatcode = dbo.item.icatcode,\n\tcategory = dbo.itemcategory.name\nFROM \n\tdbo.duesatisfyheader,\n\tdbo.duesatisfydetail,\n\tdbo.item, \n\tdbo.users,\n\tdbo.itemcategory \nWHERE \n\t( dbo.duesatisfyheader.duesatisfydate between :ar_StartDate and :ar_EndDate) and\n\t( dbo.duesatisfyheader.duesatisfycode = dbo.duesatisfydetail.duesatisfycode ) and  \n\t( dbo.duesatisfydetail.icode = dbo.item.icode ) and\n\t( dbo.item.icatcode = dbo.itemcategory.icatcode) and\n\t( dbo.itemcategory.icatcode IN (:ar_icatcode)) and\n\t( dbo.duesatisfyheader.usercode = dbo.users.usercode )\nORDER BY \n\tdbo.itemcategory.name,\n\tdbo.item.icatcode,\n\tdbo.duesatisfyheader.duesatisfydate,\n\tdbo.item.name,\n\tdbo.item.icode\n",
  "arguments": {
