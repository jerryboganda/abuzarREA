  "retrieve": "  SELECT dad.dueadjcode,\n\t\t\tdad.saleinvcode,\t\n\t\t\tdad.icode,\n\t\t\tdad.gcode,\n\t\t\tdad.salerowid,\n\t\t\ti.name,\n\t\t\tdad.dueqty,\n\t\t\tdad.satisfiedqty,\n\t\t\tdad.satisfiableqty,\n\t\t\tstock = 0.0000,\n\t\t\tdad.duedelete\n\nFrom    dueadjdetail dad, item i\n\nWhere   dad.dueadjcode = :ar_dueadjcode And\n\t\t  dad.icode = i.icode\n\nOrder By dad.SaleInvCode,\n\t\t\ti.name",
  "update": "dueadjdetail",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
