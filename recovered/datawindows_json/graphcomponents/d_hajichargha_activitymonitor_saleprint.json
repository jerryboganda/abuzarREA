  "retrieve": "SELECT \n\titemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end,  \n\tusers.username, \n\tsalecat=max(saleledger.salecatcode),\n\tsaleledger.custcode,\n\theaderno = dbo.saleledger.headerno,\n\tcustomer=(select name from accounts where acccode=saleledger.custcode),\n\tinvoicetotal=dbo.fn_getsaleinvtotal(saleledger.saleinvcode),\n\theaderinvno=max(saleledger.headerinvno),\n\tdbo.saleledger.saleinvcode, \n\tposted=max(saleledger.posted),\n\tbalance=max(saleledger.balance),  \n\tdbo.saleledger.date,   \n\tdbo.saleledger.discperc,   \n\tdbo.saleledger.misccharges,   \n\tinvgstperc = dbo.saleledger.invgstperc1,\n\tdbo.saleledger.flatdisc,   \n\tdbo.saleledger.salestax,   \n\tdbo.saleledger.custcode,   \n\tdbo.saleledger.remarks,   \n\tdbo.saledetail.icode,   \n\tdbo.saledetail.gcode, \n\tcashreceived=max(dbo.saleledger.cashreceived),\n\tcustrefno=max(saleledger.custrefno),\n\tId        = MAX(dbo.saledetail.IDENTITYCOL),  \n\tlooseqty  = sum(saledetail.looseqty) - \n\t\tISNULL((SELECT SUM(DL.LooseQty)\n\t\tFROM\n\t\t\tSaleDetailLog DL,\n\t\t\t(SELECT LogID=MAX(LLD.SaleLedgerLogID)\n\t\t\tFROM SaleDetailLog LLD\n\t\t\tWHERE\n\t\t\t\tLLD.SaleInvCode = SaleLedger.SaleInvCode) T\n\t\tWHERE \n\t\t\tDL.SaleLedgerLogID = T.LogID AND DL.ICode = dbo.saledetail.icode AND DL.RowGroup = dbo.saledetail.rowgroup), 0), \n\tbonusqty  = sum(saledetail.bonusqty), \n\tpackqty   = sum(saledetail.packqty), \n\tpackunits = max(saledetail.packunits), \n\tsaleprice = saledetail.saleprice, \n\trate      = max(saledetail.rate),\n\tsalestax  = max(saledetail.salestax),   \n\tdiscperc  = saledetail.discperc, \n\tgstperc=saledetail.gstperc,\n\tunitsalestax=saledetail.unitsalestax,\n\tcustomername='                                  '  ,\n\titemflatdisc  = saledetail.itemflatdisc,\n\taliasname=item.customicode,\n\tmachinename=',' +  max(saleledger.machinename),\n\treprintcounter=max(saleledger.reprintingcounter),\n\tserverdate=getdate(),\n\tSaleType = (SELECT ST.Name FROM SaleType ST WHERE ST.SaleTypeCode = SaleLedger.SaleTypeCode),\n\tSaleTypeInvNo = SaleLedger.SaleTypeInvNo,\n\tOrderPerson=\t(SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = saleLedger.SManCode)\n\t\nFROM \n\tdbo.saleledger,\n\tdbo.saledetail,\n\titem,\n\tUsers\nWHERE \n\t( dbo.saleledger.saletypecode > 1 ) AND \n\t( dbo.saleledger.saleinvcode IN \n\t\t(SELECT DocumentCode=MAX(AM.DocumentCode)\n\t\tFROM ActivityMonitor AM\n\t\tWHERE AM.DocumentType IN ('SC', 'ST') AND \n\t\t\tAM.DocRowID IN (:ar_docrowid) ) ) AND\n\t( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND \n\t( saleLedger.SalesManCode = users.userCode ) and\n\t( saledetail.icode = item.icode ) AND\n\tSTR(saledetail.RowGroup) + STR(saledetail.ICode) + STR(saledetail.RowGroup) + STR(saledetail.LooseQty) NOT IN\n\t(SELECT STR(LD.RowGroup) + STR(LD.ICode) + STR(LD.RowGroup) + STR(LD.LooseQty)\n\tFROM\n\t\tSaleDetailLog LD,\n\t\t(SELECT LogID=MAX(LLD.SaleLedgerLogID)\n\t\tFROM SaleDetailLog LLD\n\t\tWHERE\n\t\t\tLLD.SaleInvCode = SaleLedger.SaleInvCode) T\n\tWHERE \n\t\tLD.SaleLedgerLogID = T.LogID)\nGROUP BY \n\tsaleledger.saleinvcode, \n\tsaleledger.date, \n\tsaleledger.custcode, \n\tsaleLedger.SManCode,\n\tSaleLedger.SaleTypeCode,\n\tSaleLedger.SaleTypeInvNo,\n\tsaleledger.discperc, \n\tsaleledger.flatdisc, \n\tsaleledger.misccharges, \n\tsaleledger.invgstperc1, \n\tsaleledger.headerno,\n\tsaleledger.salestax, \n\tsaleledger.remarks, \n\tsaledetail.icode, \n\tdbo.saledetail.rowgroup,\n\tsaledetail.saleprice,\n\tsaledetail.itemflatdisc,\n\tsaledetail.discperc,\n\tsaledetail.gstperc,\n\tsaledetail.unitsalestax,\n\tsaledetail.gcode, \n\titem.name,\n\titem.icode,\n\titem.printable,\n\titem.customicode,\n\tusers.username\nORDER BY \n\tMAX(dbo.saledetail.IDENTITYCOL)",
  "arguments": {
