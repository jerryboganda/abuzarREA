  "retrieve": "SELECT\n\tDocRowId,\n\tDocumentCode,   \n\tDocumentType,   \n\tDocCatCode, \n\tCategory = Category,\n\tPartyType,   \n\tPartyCode,\n\tPartyName = \n\t\tCASE \n\t\t\tWHEN PartyType='G' THEN (SELECT Godown.Name FROM Godown WHERE Godown.GCode = ActivityMonitor.PartyCode) \n\t\t\tWHEN PartyType='P' THEN (SELECT SalesMan.Name FROM SalesMan WHERE SalesMan.SalesManCode = ActivityMonitor.PartyCode) \n\t\t\tWHEN PartyType IN ('C','S','A') THEN (SELECT A.Name FROM Accounts A WHERE A.AccCode = PartyCode)\n\t\tELSE '' END,\n\tUserCode,   \n\tUserName = (SELECT U.UserName FROM Users U WHERE U.UserCode = ActivityMonitor.UserCode),\n\tAmount, \n\tRemarks,   \n\tPrinted,   \n\tDate,\n\tMachineName,\n\tTotalQty = ISNULL((\n\t\tCASE\n\t\tWHEN DocumentType IN ('SC','ST') THEN (SELECT SUM(LooseQty + BonusQty) FROM SaleDetail WHERE SaleInvCode=ActivityMonitor.DocumentCode)\n\t\tWHEN DocumentType = 'SR' THEN (SELECT SUM(LooseQty + BonusQty) FROM SRDetail WHERE SRInvCode=ActivityMonitor.DocumentCode)\n\t\tELSE 0 END), 0)\nFROM ActivityMonitor  \nWHERE DocRowID IN (:ai_docrowid)\nORDER BY DocumentCode, DocRowID\n",
  "update": "ActivityMonitor",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
