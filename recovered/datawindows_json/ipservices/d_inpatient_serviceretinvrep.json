  "retrieve": "SELECT\n\titemname = service.name,\n\treprintdate = getDate(),\n\tusers.username,  \n\tdbo.servicerheader.servicerinvcode,   \n\tdbo.servicerheader.date,  \n\tdbo.servicerheader.headerno,\n\tdbo.servicerheader.discperc,   \n\tdbo.servicerheader.misccharges,   \n\tdbo.servicerheader.custcode,   \n\tdbo.servicerheader.remarks,\n\tdbo.servicerheader.flatdisc,\n\tdbo.service.servicecode,   \n\tprice = dbo.servicerdetail.serviceprice, \n\tServiceFlatDisc = ServiceRDetail.ServiceFlatDisc,\n\tQty = dbo.servicerdetail.qty,\n\tservicerdetail_discperc = servicerdetail.discperc, \n\tcustomername=(SELECT Accounts.Name FROM Accounts WHERE Accounts.AccCode  = servicerheader.Custcode),\n\tpatient.regno,\n\tpatient=patient.name,\n\tdbo.servicerheader.saleinvcode,\n\tdbo.servicerheader.servicercatcode,\n\tlocation=(SELECT patientlocation.name FROM PatientLocation WHERE PatientLocation.LocationCode = PatientAdmission.LocationCode)\n\t\nFROM \n\tdbo.servicerheader,   \n\tdbo.servicerdetail,  \n\tservice, \n\tusers,\n\tpatient,\n\tpatientadmission\n\t\nWHERE \n\t( dbo.servicerheader.servicerinvcode = :ra_InvCode ) AND\n\t( dbo.servicerheader.servicerinvcode = dbo.servicerdetail.servicerinvcode ) AND \n\t( dbo.servicerheader.salesmancode = dbo.users.usercode ) AND\n\t( dbo.servicerdetail.servicecode = dbo.service.servicecode ) AND\n\t( dbo.servicerheader.admissioncode = dbo.patientadmission.admissioncode ) AND\n\t( dbo.patientadmission.patientcode = dbo.patient.patientcode )",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  }
 },
