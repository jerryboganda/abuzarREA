  "retrieve": "SELECT\n\tSVCRH.servicerinvcode ,\n\tSVCRH.serviceinvcode ,\n\tSVCRH.date ,\n\tSVCRH.servicercatcode ,\n\tSVCRH.custcode ,\n\tSVCRH.salesmancode ,\n\tSVCRH.discperc ,\n\tSVCRH.flatdisc ,\n\tSVCRH.misccharges ,\n\tusers.username ,\n\tSVCRH.headerno ,\n\tSVCRH.posted ,\n\tSVCRH.postdate ,\n\tSVCRH.remarks ,\n\taccounts.aliasname ,\n\taccounts.name , \n\tcustomer.address1 ,\n\tcustomer.city ,\n\tcustomer.phone,\n\tSVCRH.originaldate,\n\tSVCRH.modifiedby,\n\tSVCRH.postedby,\t   \n\tSVCRH.doctcode,\n\tpatientregno=patient.regno,\n\tSVCRH.patientcode,\n\tSVCRH.admissioncode,\n\tpatientadmission.locationcode,\n\tSVCRH.CashAccCode,\n\tSVCRH.CashTendered,\n\tSVCRH.CashCharged,\n\tSVCRH.CashBack,\n\tSVCRH.InvTotal\nFROM\n\taccounts ,\n\tcustomer ,\n\tusers ,\n\tservicerheader SVCRH\n\tLEFT OUTER JOIN Doctors ON (SVCRH.doctcode = Doctors.doctcode),\n\tpatientadmission,\n\tpatient\nWHERE \n\t( SVCRH.servicerinvcode = :ai_servicerinvcode ) and\n\t( SVCRH.admissioncode IS NOT NULL ) and\n   ( SVCRH.custcode = customer.custcode ) and          \n\t( SVCRH.salesmancode = users.usercode ) and          \n\t( SVCRH.custcode = accounts.acccode ) and\n\t( SVCRH.admissioncode = patientadmission.admissioncode ) and\n\t( patientadmission.patientcode = patient.patientcode )\n",
  "update": "servicerheader",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_servicerinvcode",
      "number"
     ]
    }
   ]
  }
 },
