  "retrieve": "SELECT \n\tfullcode=service.aliasname,\n\tservice.servicecode,\n\tSVCRD.smancode,   \n\tSVCRD.qty,\n\tServiceQty = SVCRD.qty,\n\tSVCRD.ServicePrice,\n\tSVCRD.ServiceFlatDisc,\n\tAllowSaleInDecimal=service.AllowSaleInDecimal,\n\tSVCRD.CostPrice,\n\tcurrlistrow = 0,\n\tSVCRD.Commission,\n\tSVCRD.SharePerc,\n\tSVCRD.servicerinvcode,\n\tSVCRD.srvrrowid,\n\tSVCRD.srvrowid,\n\tretqty = 0,\n\t/* SVCRD.salestax,*/ \n\tSVCRD.discperc\n\t\nFROM \n\tservicerdetail SVCRD,\n\tservice  \n\t\nWHERE \n\t( SVCRD.servicecode = service.servicecode ) and  \n\t(SVCRD.servicerinvcode = :ra_salesretinvno )\n",
  "update": "servicerdetail",
