  "retrieve": "SELECT \n\tfullcode=service.aliasname,\n\tservice.name,\n\tSVCD.servicecode,\n\tSVCD.smancode, \n\tsalesman.name,\t\n\tSVCD.qty,\n\tReturnQty = ISNULL((Select IsNull(Sum(qty),0 ) \n\t\tFrom   ServiceRHeader srh ,ServiceRDetail srd\n\t\tWhere  srh.admissioncode = :ai_admissioncode AND \n\t\t\t srh.servicerinvcode = srd.servicerinvcode AND\n\t\t\t srd.servicecode = SVCD.servicecode AND\n\t\t\t srd.srvrowid = SVCD.srvrowid), 0),\n\tSVCD.price,\n\tSVCD.ServiceFlatDisc,\n\tAllowSaleInDecimal=Service.AllowSaleInDecimal,\n\tSVCD.costprice,\n\tSVCD.Commission,\n\tSVCD.SharePerc,\n\tSVCD.srvrowid,\n\tSVCD.DiscPerc\nFROM\n\tServiceHeader SH, \n\tServiceDetail SVCD LEFT OUTER JOIN SalesMan ON (SVCD.smancode = salesman.salesmancode),\n\tService\nWHERE  \n\tSH.AdmissionCode IS NOT NULL AND\n\tSH.Serviceinvcode = SVCD.ServiceinvCode AND\n\tSH.Posted='Y' AND\n\tSH.AdmissionCode = :ai_admissioncode AND\n\tSVCD.servicecode=service.servicecode\n         ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_admissioncode",
      "number"
     ]
    }
   ]
  }
 },
