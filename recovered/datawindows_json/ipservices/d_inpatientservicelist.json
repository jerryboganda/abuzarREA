  "retrieve": "SELECT   \n\tserviceheader.serviceinvcode , \n\tserviceheader.date , \n\tInvTotal = ServiceHeader.InvTotal,\n\tserviceheader.remarks , \n\tcustcode=serviceheader.custcode,\n\taccounts.name,\n\tposted = serviceheader.posted,\n\tPostedBy = IsNull((Select username from users \n\t\t\t\twhere dbo.serviceheader.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\t\t\twhere dbo.serviceheader.modifiedby = dbo.users.usercode), ''),\n\tpatient.regno,\n\tpatient=patient.name,\n\tpatientcode=patient.patientcode,\n\tadmissioncode=serviceheader.admissioncode\nFROM  \n\taccounts , \n\tserviceheader,\n\tpatient,\n\tpatientadmission\n\t\nWHERE  \n\t( dbo.serviceheader.servicecatcode IN(12, 11 )) and\n\t(dbo.serviceheader.date > :ad_invdate) and\n\t( serviceheader.admissioncode IS NOT NULL ) and \n\t( serviceheader.custcode = accounts.acccode ) and \n\t( dbo.serviceheader.admissioncode = dbo.patientadmission.admissioncode) and\n\t( dbo.patientadmission.patientcode = dbo.patient.patientcode ) and\n\t( Posted IN (:as_Posted))",
  "arguments": {
   "_items": [
