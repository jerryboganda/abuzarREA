  "retrieve": "SELECT  \n\tserviceoheader.serviceocode , \n\tserviceoheader.date , \n\tserviceoheader.posted, \t\n\tserviceoheader.remarks , \n\taccounts.name,\n\tposted = serviceoheader.posted,\n\tPostedBy = IsNull((Select username from users \n\t\t\t\twhere dbo.serviceoheader.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\t\t\twhere dbo.serviceoheader.modifiedby = dbo.users.usercode), ''),\n\tpatient.regno,\n\tpatient=patient.name,\n\tadmissioncode=dbo.serviceOheader.admissioncode\n\t\nFROM  \n\taccounts , \n\tserviceoheader,\n\tpatient,\n\tpatientadmission\n\t\nWHERE  \n\t( dbo.serviceOheader.admissioncode IS NOT NULL ) and \n\t( dbo.serviceOheader.admissioncode = dbo.patientadmission.admissioncode) and\n\t( dbo.patientadmission.patientcode = dbo.patient.patientcode ) and\n\t( dbo.serviceOheader.custcode = dbo.accounts.acccode ) and \n\t( dbo.serviceOheader.date > :ad_invdate ) and\n\t( dbo.serviceOheader.Posted IN (:as_Posted))\n\nOrder By \n\tserviceocode desc",
  "arguments": {
   "_items": [
