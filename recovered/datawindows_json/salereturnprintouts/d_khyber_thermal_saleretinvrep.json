  "retrieve": "SELECT\n\titemname= item.name,\n\theaderno=max(srledger.headerno),\n\tdbo.users.username,  \n\taccname = accounts.name, \n\tsrcatcode = dbo.srledger.srcatcode,\n\tdbo.srledger.srinvcode,   \n\tdbo.srledger.saleinvcode, \n\tdbo.srledger.date,   \n\tdbo.srledger.discperc,   \n\tdbo.srledger.misccharges,   \n\tdbo.srledger.flatdisc,   \n\tdbo.srledger.salestax,   \n\tdbo.srledger.remarks,   \n\tdbo.srledger.custrefno,\n\tAdmissionCode=srledger.AdmissionCode,\n\tlooseqty = Sum(dbo.srdetail.looseqty),   \n\tpackqty  = Sum(dbo.srdetail.packqty),   \n\ticode = Max(dbo.srdetail.icode),   \n\tsrprice = Max(dbo.srdetail.srprice),   \n\tdiscperc = Max(dbo.srdetail.discperc) ,\n\tunitsalestax=max(srdetail.unitsalestax),\n\titemgstperc=max(srdetail.gstperc),\n\tinvgstperc=max(srledger.invgstperc1),\n\treprintingcounter=max(srledger.reprintingcounter),\n\tPatientRegNo  = PA.RegNo,\n\tPatient = PA.Name,\n\tlocation=(SELECT patientlocation.name FROM PatientLocation WHERE PatientLocation.LocationCode = PA.LocationCode)\nFROM \n\tdbo.srledger\n\tLEFT OUTER JOIN \n\t(SELECT PA.AdmissionCode, PA.PatientCode, PA.LocationCode, PA.Date, PA.UserCode, PA.DoctorCode, P.RegNo, P.Name\n\tFROM PatientAdmission PA, Patient P\n\tWHERE \n\t\tPA.AdmissionCode IN \n\t\t\t(SELECT SL.AdmissionCode \n\t\t\tFROM SRLedger SL \n\t\t\tWHERE SL.SRInvCode = :ra_InvCode) AND\n\t\tPA.PatientCode = P.PatientCode\n\tUNION\n\tSELECT AdmissionCode=NULL, PatientCode=P.PatientCode, LocationCode=NULL, Date=NULL, UserCode=NULL, DoctorCode=NULL, P.RegNo, P.Name\n\tFROM Patient P\n\tWHERE \n\t\tP.PatientCode IN \n\t\t\t(SELECT SL.PatientCode \n\t\t\tFROM SRLedger SL \n\t\t\tWHERE SL.SRInvCode = :ra_InvCode)) AS PA ON (srledger.AdmissionCode = PA.AdmissionCode),   \n\tdbo.srdetail,  \n\tcustomer, \n\taccounts, \n\titem,\n\tusers\nWHERE \n\t( dbo.srledger.srinvcode= :ra_InvCode ) AND \n\t( dbo.srledger.srinvcode= dbo.srdetail.srinvcode) AND \n\t( dbo.srledger.custcode = dbo.customer.custcode) AND \n\t( dbo.customer.custcode = dbo.accounts.acccode) AND \n\t( dbo.srledger.salesmancode = dbo.users.usercode) AND \n\t( srdetail.icode = item.icode ) \nGROUP BY\n\tdbo.srledger.srinvcode, \n\tdbo.srledger.saleinvcode, \n\tdbo.srledger.srcatcode,\n\tdbo.srledger.date, \n\tdbo.srledger.discperc, \n\tdbo.srledger.flatdisc, \n\tdbo.srledger.misccharges, \n\tdbo.srledger.salestax, \n\tdbo.srledger.remarks, \n\tdbo.srledger.AdmissionCode,\n\tdbo.srledger.custrefno,\n\tPA.RegNo,\n\tPA.Name,\n\tPA.LocationCode,\n\tdbo.item.name, \n\tdbo.accounts.name, \n\tdbo.users.username",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  }
 },
