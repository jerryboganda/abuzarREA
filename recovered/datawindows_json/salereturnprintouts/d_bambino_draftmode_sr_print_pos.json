  "retrieve": "SELECT\n\trowdetail = \n\t\tCASE WHEN LEN(LTRIM(RTRIM(IT.name))) >= 20 THEN SUBSTRING(IT.Name,1, 20) ELSE LTRIM(RTRIM(IT.Name)) + REPLICATE(' ', 20 - LEN(LTRIM(RTRIM(IT.Name)))) END +\n\t\tCASE WHEN sum(SD.looseqty) = 0 THEN SPACE(5) ELSE STR(sum(SD.looseqty), 5) END +\n\t\tCASE WHEN sum(SD.SRPrice) = 0 THEN SPACE(7) ELSE STR(max(SD.SRPrice), 7) END +\n\t\tCASE WHEN \n\t\t\tRound(SUM(\n\t\t\t\t(SD.looseqty * SD.SRPrice * \n\t\t\t\t(1 - SD.discperc * 0.01))), 2) +\n\t\t\t\tSUM( \n\t\t\t\tRound(\n\t\t\t\t\t(SD.looseqty * SD.SRPrice * \n\t\t\t\t\t\t(1 - SD.discperc * 0.01) * SD.gstperc * 0.01), 2) + \n\t\t\t\t\tRound(SD.unitsalestax * SD.looseqty, 2)) = 0 THEN SPACE(8) \n\t\t\tELSE\t\n\t\t\t\tstr(\n\t\t\t\t\tRound(SUM(\n\t\t\t\t\t\t(SD.looseqty * SD.SRPrice * \n\t\t\t\t\t\t(1 - SD.discperc * 0.01))), 2) +\n\t\t\t\t\tSUM( \n\t\t\t\t\tRound(\n\t\t\t\t\t(SD.looseqty * SD.SRPrice * \n\t\t\t\t\t\t(1 - SD.discperc * 0.01) * SD.gstperc * 0.01), 2) + \n\t\t\t\t\tRound(SD.unitsalestax * SD.looseqty, 2)), 8) \n\t\t\tEND,\n\tFooterRow3=\n\t\tCASE WHEN SL.flatdisc = 0 THEN SPACE(1) \n\t\tELSE 'Less Flat Discount: ' + SPACE(6) + STR(max(SL.flatdisc), 14, 2) \n\t\tEND,\n\tFooterRow4=\n\t\tCASE WHEN SL.MiscCharges = 0 THEN SPACE(1) \n\t\tELSE 'Add  Misc. Charges: ' + SPACE(6) + STR(max(SL.MiscCharges), 14, 2) \n\t\tEND,\n\tFooterRow5 =\n\t\tCASE WHEN SL.discperc = 0 THEN SPACE(1)\n\t\tELSE 'Less Inv. Discount: ' + STR(SL.discperc, 6, 2) + '% = ' + \n\t\tSTR((SELECT ISNULL(\n\t\t\tRound( (\n\t\t\t\tSUM(D.looseqty * D.SRPrice * (1 - D.discperc * 0.01)) * \n\t\t\t\t(S.discperc * 0.01)\t), 2), 0)\n\t\t\tFROM SRBufferLedger S, SRBufferDetail D \n\t\t\tWHERE S.SRBufferInvCode = :ra_InvCode AND S.SRBufferInvCode = D.SRBufferInvCode\n\t\t\tGROUP BY S.SRBufferInvCode, S.discperc), 10, 2)\n\t\tEND,\n\tFooterRow6 =\t\t\n\t\tCASE WHEN SL.invgstperc1 = 0 THEN SPACE(1)\n\t\tELSE 'Add Inv. GST (%)  : ' + STR(SL.invgstperc1, 6, 2) + '% = ' + \n\t\tSTR((SELECT ISNULL(\n\t\t\tRound( ( (SUM( D.looseqty * D.SRPrice * \n\t\t\t\t(1 - D.discperc * 0.01)) * (1 - S.discperc * 0.01)) - S.FlatDisc) * \n\t\t\t\tSL.invgstperc1 * 0.01, 2), 0)\n\t\t\tFROM SRBufferLedger S, SRBufferDetail D \n\t\t\tWHERE S.SRBufferInvCode = :ra_InvCode AND S.SRBufferInvCode = D.SRBufferInvCode\n\t\t\tGROUP BY S.SRBufferInvCode, S.DiscPerc, S.FlatDisc, S.invgstperc1), 10, 2)\n\t\tEND,\n\tSaleInvCode = SL.SaleInvCode,\n\tusername=U.username, \n\treprintdate=getdate(),\n\theaderno = SL.headerno,\n\tposted = max(SL.posted),\n\tbalance=0,\n\tSRInvCode=SL.SRBufferInvCode,   \n\tdate=SL.date,   \n\tinvdiscperc=SL.discperc,   \n\tmisccharges=SL.misccharges,   \n\tflatdisc=SL.flatdisc,   \n\tcustcode = SL.custcode, \n\tremarks = SL.remarks,\n\ticode = SD.icode,   \n\tgcode = SD.gcode, \n\tId        = MAX(SD.IDENTITYCOL),  \n\tlooseqty = SUM(SD.looseqty),  \n\tbonusqty = SUM(SD.bonusqty),  \n\tpackunits= MAX(SD.packunits),  \n\tSRPrice= MAX(SD.SRPrice),  \n\tItemFlatDisc= 0,  \n\tdiscperc= MAX(SD.discperc),  \n\tunitsalestax = MAX(SD.unitsalestax),  \n\tgstperc = MAX(SD.gstperc),  \n\tcustomername=A.Name,\n\tP=max(P.name),\n\tMachine=SL.MachineName,\n\tserverdate=getdate(),\n\tcustrefno = SL.custrefno,\n\tinvgstperc = max(SL.invgstperc1),\n\tInvTotal = STR(SL.InvTotal, 14, 2)\nFROM \n\tSRBufferLedger SL\n\tLEFT OUTER JOIN Patient AS P ON (SL.PatientCode = P.PatientCode),\n\tSRBufferDetail SD,  \n\tItem IT,\n\tUsers U,\n\tAccounts A\nWHERE \n\t( SL.SRBufferInvCode = :ra_InvCode ) AND\n\t( SL.SRBufferInvCode = SD.SRBufferInvCode ) AND \n\t( SL.SalesManCode = U.userCode ) and\n\t( SL.CustCode = A.AccCode ) and\n\t( SD.icode = IT.icode )\nGROUP BY \n\tSL.SRBufferInvCode, \n\tSL.SaleInvCode,\n\tSL.date, \n\tSL.custcode, \n\tA.Name,\n\tSL.discperc, \n\tSL.flatdisc, \n\tSL.misccharges, \n\tSL.headerno,\n\tSL.salestax, \n\tSL.remarks, \n\tSL.custrefno,\n\tSL.InvTotal,\n\tSL.invgstperc1, \n\tU.username,\n\tSD.icode, \n\tIT.name,\n\tIT.customicode, \n\tIT.icode,\n\tIT.printable,\n\tSD.GCode,\n\tSL.MachineName\nORDER BY \n\tID\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  }
 },
