  "retrieve": "SELECT\n\titemname= item.name, \n\tdbo.users.username, \n\taccname = accounts.name, \n\tsrcatcode = dbo.srbufferledger.srcatcode,\n\tcode = dbo.srbufferledger.srbufferinvcode,   \n\tsaleinvcode = dbo.srbufferledger.saleinvcode, \n\tsalesperson=(SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = SRBufferLedger.SManCode),\n\tdate = dbo.srbufferledger.date,   \n\tinvdiscperc = dbo.srbufferledger.discperc,   \n\tmisccharges = dbo.srbufferledger.misccharges,   \n\tflatdisc = dbo.srbufferledger.flatdisc,   \n\tsalestax = dbo.srbufferledger.salestax,   \n\tremarks = dbo.srbufferledger.remarks,   \n\tlooseqty = Sum(dbo.srbufferdetail.looseqty),   \n\tpackqty  = Sum(dbo.srbufferdetail.packqty),   \n\ticode = Max(dbo.srbufferdetail.icode),   \n\tsrprice = Max(dbo.srbufferdetail.srprice),   \n\tdiscperc = Max(dbo.srbufferdetail.discperc) ,\n\theaderno = Max(srbufferledger.headerno),\n\tunitsalestax=max(srbufferdetail.unitsalestax),\n\titemgstperc=max(srbufferdetail.gstperc),\n\tinvgstperc=max(srbufferledger.invgstperc1)\n\t\nFROM \n\tdbo.srbufferledger,   \n\tdbo.srbufferdetail,  \n\tcustomer, \n\taccounts, \n\titem,\n\tusers \n\t\nWHERE \n\t( dbo.srbufferledger.srbufferinvcode= :ra_InvCode ) AND \n\t( dbo.srbufferledger.srbufferinvcode= dbo.srbufferdetail.srbufferinvcode) AND \n\t( dbo.srbufferledger.custcode = dbo.customer.custcode) AND \n\t( dbo.customer.custcode = dbo.accounts.acccode) AND \n\t( dbo.srbufferledger.salesmancode = dbo.users.usercode) AND \n\t( srbufferdetail.icode = item.icode ) \n\t\nGROUP BY \n\tdbo.srbufferledger.srbufferinvcode, \n\tdbo.srbufferledger.saleinvcode, \n\tdbo.srbufferledger.date, \n\tdbo.srbufferledger.srcatcode, \n\tdbo.srbufferledger.discperc, \n\tdbo.srbufferledger.flatdisc, \n\tdbo.srbufferledger.misccharges, \n\tdbo.srbufferledger.salestax, \n\tdbo.srbufferledger.remarks, \n\tdbo.item.name, \n\tdbo.accounts.name, \n\tdbo.srbufferledger.smancode,\n\tdbo.users.username",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  }
 },
