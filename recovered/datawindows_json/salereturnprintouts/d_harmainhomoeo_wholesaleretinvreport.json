  "retrieve": "SELECT\n\titemname= item.name,\n\theaderno=max(srledger.headerno),\n\tdbo.users.username,  \n\taccname = accounts.name, \n\tdbo.srledger.srinvcode,   \n\tdbo.srledger.saleinvcode, \n\tdbo.srledger.date,   \n\tdbo.srledger.discperc,   \n\tdbo.srledger.misccharges,   \n\tdbo.srledger.flatdisc,   \n\tdbo.srledger.salestax,   \n\tdbo.srledger.remarks,   \n\tlooseqty = Sum(dbo.srdetail.looseqty),   \n\tpackqty  = Sum(dbo.srdetail.packqty),   \n\ticode = Max(dbo.srdetail.icode),   \n\tsrprice = Max(dbo.srdetail.srprice),   \n\tdiscperc = Max(dbo.srdetail.discperc) ,\n\tunitsalestax=max(srdetail.unitsalestax),\n\titemgstperc=max(srdetail.gstperc),\n\tinvgstperc=max(srledger.invgstperc1),\n\treprintingcounter=max(srledger.reprintingcounter),\n\trowid = MAX(srdetail.rowid)\nFROM \n\tdbo.srledger,   \n\tdbo.srdetail,  \n\tcustomer, \n\taccounts, \n\titem,\n\tusers \nWHERE \n\t( dbo.srledger.srinvcode= :ra_InvCode ) AND \n\t( dbo.srledger.srinvcode= dbo.srdetail.srinvcode) AND \n\t( dbo.srledger.custcode = dbo.customer.custcode) AND \n\t( dbo.customer.custcode = dbo.accounts.acccode) AND \n\t( dbo.srledger.salesmancode = dbo.users.usercode) AND \n\t( srdetail.icode = item.icode ) \nGROUP BY \n\tdbo.srledger.srinvcode, \n\tdbo.srledger.saleinvcode, \n\tdbo.srledger.date, \n\tdbo.srledger.discperc, \n\tdbo.srledger.flatdisc, \n\tdbo.srledger.misccharges, \n\tdbo.srledger.salestax, \n\tdbo.srledger.remarks, \n\tdbo.item.name, \n\tdbo.accounts.name, \n\tdbo.users.username\nORDER BY\n\tRowID",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  }
 },
