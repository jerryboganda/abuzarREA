  "retrieve": "SELECT\n\titemname= item.name, \n\theaderno=max(srledger.headerno),\n\t users.username,  \n\taccname = accounts.name, \n\t srledger.srbufferinvcode,   \n\t srledger.saleinvcode, \n\t srledger.date,   \n\t srledger_discperc=srledger.discperc,   \n\t srledger.misccharges,   \n\t srledger.flatdisc,   \n\t srledger.salestax,   \n\t srledger.remarks,   \n\tlooseqty = Sum( srdetail.looseqty),   \n\tpackqty  = Sum( srdetail.packqty),   \n\ticode = Max( srdetail.icode),   \n\tsrprice = Max( srdetail.srprice),   \n\tsrdetail_discperc = Max( srdetail.discperc) ,\n\tunitsalestax=max(srdetail.unitsalestax),\n\titemgstperc=max(srdetail.gstperc),\n\tinvgstperc=max(srledger.invgstperc1),\n\tinvtotal=max(srledger.invtotal),\n\t\n\trowid = MAX(srdetail.rowid)\nFROM \n\t srbufferledger srledger,   \n\t srbufferdetail srdetail,  \n\tcustomer, \n\taccounts, \n\titem,\n\tusers \nWHERE \n\t(  srledger.srbufferinvcode= :ra_InvCode ) AND \n\t(  srledger.srbufferinvcode=  srdetail.srbufferinvcode) AND \n\t(  srledger.custcode =  customer.custcode) AND \n\t(  customer.custcode =  accounts.acccode) AND \n\t(  srledger.salesmancode =  users.usercode) AND \n\t( srdetail.icode = item.icode ) \nGROUP BY \n\t srledger.srbufferinvcode, \n\t srledger.saleinvcode, \n\t srledger.date, \n\t srledger.discperc, \n\t srledger.flatdisc, \n\t srledger.misccharges, \n\t srledger.salestax, \n\t srledger.remarks, \n\t item.name, \n\t accounts.name, \n\t users.username\nORDER BY\n\tRowID",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_InvCode",
      "number"
     ]
    }
   ]
  }
 },
