    "name": "salesperson",
    "dbname": "SalesPerson"
   }
  ],
  "retrieve": " SELECT \n\t\tBillSummaryCode=BS.BillSummaryCode,\n\t\tSaleInvoices = COUNT(DISTINCT BSD.SaleInvCode),\n\t\tMinSaleInvCode=(SELECT MIN(D.SaleInvCode) FROM BillSummaryDetail D WHERE D.BillSummaryCode = :ai_code),\n\t\tMaxSaleInvCode=(SELECT MAX(D.SaleInvCode) FROM BillSummaryDetail D WHERE D.BillSummaryCode = :ai_code),\n\t\tAliasName = I.CustomICode,\n\t\tSD.ICode,  \n\t\tSD.Batch, \n\t\tSD.Expiry, \n\t\tItem = I.Name,\n\t\tPacking=MAX(I.packingdesc),\n\t\tSUM(SD.looseQty) AS Qty, \n\t\tSUM(SD.BonusQty) AS Bonus,\n\t\tSD.SalePrice,\n\t\tDiscountValue = SUM(SD.looseQty * SD.ItemFlatDisc) +  \n\t\t\tSUM(SD.looseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)) +\n\t\t\tSUM(SD.looseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (SL.DiscPerc * 0.01)),\n\t\tSaleValue=SUM(SD.looseQty * (SD.SalePrice - ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) *\n\t\t\t(1 - SL.DiscPerc * 0.01),\n\t\tManufacturer = M.Name,\n\t\tSalesPerson = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode=SL.SManCode)\nFROM\n\t\tBillSummary BS,\t\n\t\tBillSummaryDetail BSD,\t\n\t\tSaledetail SD,\n\t\tSaleLedger SL,\n\t\tManufacturer M,\n\t\tItem\tI\nWHERE \n\t\tBS.BillSummaryCode = :ai_Code AND\n\t\tBS.BillSummaryCode = BSD.BillSummaryCode AND\n\t\tBSD.SaleInvCode > 0 AND\n\t\tBSD.SaleInvCode = SL.SaleInvCode AND\n\t\tSL.SaleInvCode = SD.SaleInvcode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = M.ManfCode\nGROUP BY\n\t\tBS.BillSummaryCode,\n\t\tSL.SManCode,\n\t\tM.Name,\n\t\tSD.ICode, \n\t\tI.Name,\n\t\tI.CustomICode,\n\t\tSD.Batch, \n\t\tSD.Expiry,\n\t\tSD.SalePrice,\n\t\tSL.DiscPerc\nORDER BY\n\t\tM.Name,\n\t\tI.Name,\n\t\tSD.Batch\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_Code",
      "number"
     ]
    }
   ]
  },
  "sort": "manufacturer A, item A, batch A, expiry A"
 },
