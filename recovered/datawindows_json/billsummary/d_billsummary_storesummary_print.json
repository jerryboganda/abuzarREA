    "dbname": "Manufacturer"
   }
  ],
  "retrieve": "SELECT\n\tBillSummaryCode,\n\t\tSaleInvoices=max(SaleInvoices) ,\n\t\tMinSaleInvCode=max(MinSaleInvCode) ,\n\t\tMaxSaleInvCode =max(MaxSaleInvCode),\n\t\ticode,  \n\t\tbatch, \n\t\texpiry, \n\t\tItem ,\n\t\tPacking,\n\t\tqty=Sum(A.Qty), \n\t\tbonus=sum(A.Bonus),\n\t\tsalevalue=sum(A.SaleValue),\n\t\tManufacturer \n\n\n\t\tFROM (SELECT \n\t\t\t\tBillSummaryCode=BS.BillSummaryCode,\n\t\t\t\tSaleInvoices = COUNT(DISTINCT BSD.SaleInvCode),\n\t\t\t\tMinSaleInvCode = MIN(BSD.SaleInvCode),\n\t\t\t\tMaxSaleInvCode = MAX(BSD.SaleInvCode),\n\t\t\t\tSD.ICode,  \n\t\t\t\tSD.Batch, \n\t\t\t\tSD.Expiry, \n\t\t\t\tItem = I.Name,\n\t\t\t\tPacking=MAX(I.packingdesc),\n\t\t\t\tSUM(SD.looseQty) AS Qty, \n\t\t\t\tSUM(SD.BonusQty) AS Bonus,\n\t\t\t\tSaleValue=SUM(SD.looseQty * (SD.SalePrice - ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) *\n\t\t\t\t\t(1 - SL.DiscPerc * 0.01),\n\t\t\t\tManufacturer = M.Name\n\t\t\n\t\tFROM\n\t\t\t\tBillSummary BS,\t\n\t\t\t\tBillSummaryDetail BSD,\t\n\t\t\t\tSaledetail SD,\n\t\t\t\tSaleLedger SL,\n\t\t\t\tManufacturer M,\n\t\t\t\tItem\tI\n\t\tWHERE \n\t\t\t\tBS.BillSummaryCode = :ai_Code AND\n\t\t\t\tBS.BillSummaryCode = BSD.BillSummaryCode AND\n\t\t\t\tBSD.SaleInvCode > 0 AND\n\t\t\t\tBSD.SaleInvCode = SL.SaleInvCode AND\n\t\t\t\tSL.SaleInvCode = SD.SaleInvcode AND\n\t\t\t\tSD.ICode = I.ICode AND\n\t\t\t\tI.ManfCode = M.ManfCode\n\t\tGROUP BY\n\t\t\t\tBS.BillSummaryCode,\n\t\t\t\tSD.ICode, \n\t\t\t\tSD.Batch, \n\t\t\t\tSD.Expiry,\n\t\t\t\tSL.DiscPerc,\n\t\t\t\tM.Name,\n\t\t\t\tI.Name) A\nGROUP BY\n\t\tBillSummaryCode,\n\t\tICode, \n\t\tBatch, \n\t\tExpiry,\n\t\tManufacturer,\n\t\tItem,\n\t\tA.packing\nORDER BY\n\t\tManufacturer,\n\t\tItem\n\n\n/* SELECT \n\t\tBillSummaryCode=BS.BillSummaryCode,\n\t\tSaleInvoices = COUNT(DISTINCT BSD.SaleInvCode),\n\t\tMinSaleInvCode = MIN(BSD.SaleInvCode),\n\t\tMaxSaleInvCode = MAX(BSD.SaleInvCode),\n\t\tSD.ICode,  \n\t\tSD.Batch, \n\t\tSD.Expiry, \n\t\tItem = I.Name,\n\t\tPacking=MAX(I.packingdesc),\n\t\tSUM(SD.looseQty) AS Qty, \n\t\tSUM(SD.BonusQty) AS Bonus,\n\t\tSaleValue=SUM(SD.looseQty * (SD.SalePrice - ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) *\n\t\t\t(1 - SL.DiscPerc * 0.01),\n\t\tManufacturer = M.Name\n\nFROM\n\t\tBillSummary BS,\t\n\t\tBillSummaryDetail BSD,\t\n\t\tSaledetail SD,\n\t\tSaleLedger SL,\n\t\tManufacturer M,\n\t\tItem\tI\nWHERE \n\t\tBS.BillSummaryCode = :ai_Code AND\n\t\tBS.BillSummaryCode = BSD.BillSummaryCode AND\n\t\tBSD.SaleInvCode > 0 AND\n\t\tBSD.SaleInvCode = SL.SaleInvCode AND\n\t\tSL.SaleInvCode = SD.SaleInvcode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = M.ManfCode\nGROUP BY\n\t\tBS.BillSummaryCode,\n\t\tSD.ICode, \n\t\tSD.Batch, \n\t\tSD.Expiry,\n\t\tSL.DiscPerc,\n\t\tM.Name,\n\t\tI.Name\nORDER BY\n\t\tM.Name,\n\t\tI.Name \n*/",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_Code",
      "number"
     ]
    }
   ]
  },
  "sort": "manufacturer A, item A, batch A, expiry A"
 },
