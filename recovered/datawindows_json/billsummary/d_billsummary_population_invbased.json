  "retrieve": "SELECT \n\tAreaCode=T.AreaCode, \n\tAreaName = AR.Name, \n\tCustCode=T.CustCode,\n\tCustName = AC.Name, \n\tSaleInvCode=T.SaleInvCode\nFROM\n\tArea AR, Accounts AC,\n\t(SELECT DISTINCT \n\t\tAR.AreaCode, S.SaleInvCode, C.CustCode\n\tFROM\n\t\tSaleLedger S, Customer C, Area AR, Accounts A\n\tWHERE\n\t\tS.Posted = 'Y' AND\n\t\tS.SaleinvCode BETWEEN :ai_sinvcode AND :ai_Linvcode AND \n\t\tS.SaleCatCode <> 3 AND \n\t\tS.OutStandingAmt <> 0 AND\n\t\tS.CustCode = C.CustCode AND \n\t\tC.CustCode = A.AccCode AND\n\t\tA.Active = 'Y' AND\n\t\tC.AreaCode IN (:ai_areacode) AND \n\t\tC.AreaCode = AR.AreaCode) T\nWHERE \n\tT.CustCode = AC.AccCode AND\n\tT.AreaCode = AR.AreaCode\nORDER BY\n\tAreaName,\n\tCustName,\n\tSaleInvCode\n\t",
  "arguments": {
   "_items": [
