  "retrieve": "SELECT \n\tGrade=G.Name, \n\tG.NumericalFactor, \n\tSchoolBranch=SB.Name, \n\tStudentCount = COUNT(SC.StudentCode)\nFROM \n\tClass C, \n\tGrade G, \n\tSchoolBranch SB, \n\tStudentClass SC, \n\t(SELECT ClassCode=CP.PromoteClassFrom\n\tFROM ClassPromotion CP\n\tWHERE CP.Date BETWEEN :adt_startdate AND :adt_enddate\n\tUNION ALL\n\tSELECT ClassCode=CG.ClassCode\n\tFROM ClassGraduation CG\n\tWHERE CG.Date BETWEEN :adt_startdate AND :adt_enddate) CT\nWHERE \tC.CreationDate BETWEEN :adt_startdate AND :adt_enddate AND\n\tC.ClassCode = CT.ClassCode AND\n\tG.GradeCode=C.GradeCode AND \n\tC.SchoolBranchCode = SB.SchoolBranchCode AND \n\tC.ClassCode=SC.ClassCode\nGROUP BY SB.Name, G.Name, G.NumericalFactor\nORDER BY SB.Name, G.NumericalFactor, G.Name\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "grade A"
 },
