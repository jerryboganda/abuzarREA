  "retrieve": "SELECT\n\tStudentCode,\n\tName,\n\tClass = (SELECT C.Name FROM Class C WHERE C.ClassCode = Student.CurrentClass),\n\tGrade = (SELECT G.Name FROM Class C, Grade G WHERE C.ClassCode = Student.CurrentClass AND C.GradeCode = G.GradeCode),\n\tMobile,\n\tShortName= (SELECT C.ShortName FROM Class C WHERE C.ClassCode = Student.CurrentClass),\n\tWhatsAppGroupName= (SELECT C.WhatsAppGroupName FROM Class C WHERE C.ClassCode = Student.CurrentClass)\nFROM\n\tStudent\nWHERE \n\tStatus <> 'L' AND\n\tCurrentClass IN (:ai_classcode)\nORDER BY\n\tClass, Name\n",
  "update": "Student",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_classcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "class A, name A"
