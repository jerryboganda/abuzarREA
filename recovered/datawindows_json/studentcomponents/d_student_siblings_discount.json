  "retrieve": "SELECT \n\tFNIC=S.FNIC,\n\tFname=S.FName,\n\tMName = S.MName,\n\tNoofSiblings = N.FNicCount,\n\tStudentCode = S.StudentCode,\n\tRegNo = S.RegNo,\n\tStudentName = S.Name,\n\tCurrentClass = (SELECT C.Name FROM Class C WHERE C.ClassCode = S.CurrentClass),\n\tRollNo = (SELECT SC.RollNo FROM StudentClass SC WHERE SC.ClassCode = S.CurrentClass AND SC.StudentCode=S.StudentCode),\n\tGender = S.Gender,\n\tDiscPerc=S.DiscPerc,\n\tFlatDisc = S.FlatDisc,\n\tFeeComment = S.FeeComment,\n\tRemarks = S.Remarks,\n\tMobile = S.Mobile,\n\tFMobile = S.FMobile,\n\tMMobile = S.MMobile\nFROM\n\tStudent S,\n\t(SELECT FNIC, FNicCount=COUNT(FNIC)\n\tFROM Student\n\tWHERE Status='A' AND CurrentClass > 0\n\tGROUP BY FNIC\n\tHAVING COUNT(FNIC) >= :ai_noofsiblings) N\nWHERE\n\tS.FNIC = N.FNIC AND S.Status='A' AND S.CurrentClass > 0\nORDER BY\n\tNoofSiblings DESC, FNIC, StudentCode, Fname",
  "update": "Student",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_noofsiblings",
      "number"
     ]
    }
   ]
  },
  "sort": "noofsiblings D, fnic A, studentcode A, fname A"
 },
