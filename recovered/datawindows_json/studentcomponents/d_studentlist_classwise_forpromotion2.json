  "retrieve": "SELECT\n\tStudentCode,\n\tRollNo = CAST((SELECT SC.RollNo FROM StudentClass SC WHERE SC.StudentCode=Student.StudentCode AND ClassCode=Student.CurrentClass) AS INT),\n\tRegNo,\n\tName,\n\tClass = (SELECT C.Name FROM Class C WHERE C.ClassCode = Student.CurrentClass),\n\tGrade = (SELECT G.Name FROM Class C, Grade G WHERE C.ClassCode = Student.CurrentClass AND C.GradeCode = G.GradeCode),\n\tMedium = (SELECT M.Name FROM Class C, ClassMedium M WHERE C.ClassCode = Student.CurrentClass AND C.ClassMediumCode = M.ClassMediumCode),\n\tSchool = (SELECT S.Name FROM Class C, School S WHERE C.ClassCode = Student.CurrentClass AND C.SchoolCode = S.SchoolCode),\n\tClassType = (SELECT T.Name FROM Class C, ClassType T WHERE C.ClassCode = Student.CurrentClass AND C.ClassTypeCode = T.ClassTypeCode),\n\tClassYear=(SELECT C.ClassYear FROM Class C WHERE C.ClassCode = Student.CurrentClass),\n\tTuitionFee = (SELECT C.Fee FROM Class C WHERE C.ClassCode = Student.CurrentClass),\n\tActive=(SELECT C.Active FROM Class C WHERE C.ClassCode = Student.CurrentClass),\n\tStatus,\n\tFName,\n\tCurrentAddress,\n\tPhone,\n\tMobile,\n\tBirthDate,\n\tGender,\n\tFOccupation,\n\tRemarks\nFROM\n\tStudent\nWHERE \n\tStatus <> 'L' AND\n\tCurrentClass IN (:ai_classcode)\nORDER BY\n\tClass, Name\n",
  "update": "Student",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_classcode",
      "numberlist"
     ]
    }
   ]
  }
 },
