  "retrieve": "SELECT \n\tAsON = CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date)))) AS DATETIME),\n\tGrade=G.Name, \n\tSchoolBranch=SB.Name, \n\tStudentCount = COUNT(SC.StudentCode)\nFROM \n\tClass C, \n\tGrade G, \n\tSchoolBranch SB, \n\tStudentClass SC\nWHERE \t\n\tG.GradeCode=C.GradeCode AND \n\tC.SchoolBranchCode = SB.SchoolBranchCode AND \n\tC.ClassCode=SC.ClassCode AND\n\tSC.AdmissionDate BETWEEN CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 1))) AS DATETIME) AND CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date)))) AS DATETIME)\nGROUP BY SB.Name, G.Name\nUNION ALL\nSELECT \n\tAsON = CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 1))) AS DATETIME),\n\tGrade=G.Name, \n\tSchoolBranch=SB.Name, \n\tStudentCount = COUNT(SC.StudentCode)\nFROM \n\tClass C, \n\tGrade G, \n\tSchoolBranch SB, \n\tStudentClass SC\nWHERE \t\n\tG.GradeCode=C.GradeCode AND \n\tC.SchoolBranchCode = SB.SchoolBranchCode AND \n\tC.ClassCode=SC.ClassCode AND\n\tSC.AdmissionDate BETWEEN CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 2))) AS DATETIME) AND CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 1))) AS DATETIME)\nGROUP BY SB.Name, G.Name\nUNION ALL\nSELECT \n\tAsON = CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 2))) AS DATETIME),\n\tGrade=G.Name, \n\tSchoolBranch=SB.Name, \n\tStudentCount = COUNT(SC.StudentCode)\nFROM \n\tClass C, \n\tGrade G, \n\tSchoolBranch SB, \n\tStudentClass SC\nWHERE \t\n\tG.GradeCode=C.GradeCode AND \n\tC.SchoolBranchCode = SB.SchoolBranchCode AND \n\tC.ClassCode=SC.ClassCode AND\n\tSC.AdmissionDate BETWEEN CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 3))) AS DATETIME) AND CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 2))) AS DATETIME)\nGROUP BY SB.Name, G.Name\nUNION ALL\nSELECT \n\tAsON = CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 3))) AS DATETIME),\n\tGrade=G.Name, \n\tSchoolBranch=SB.Name, \n\tStudentCount = COUNT(SC.StudentCode)\nFROM \n\tClass C, \n\tGrade G, \n\tSchoolBranch SB, \n\tStudentClass SC\nWHERE \t\n\tG.GradeCode=C.GradeCode AND \n\tC.SchoolBranchCode = SB.SchoolBranchCode AND \n\tC.ClassCode=SC.ClassCode AND\n\tSC.AdmissionDate BETWEEN CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 4))) AS DATETIME) AND CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 3))) AS DATETIME)\nGROUP BY SB.Name, G.Name\nUNION ALL\nSELECT \n\tAsON = CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 4))) AS DATETIME),\n\tGrade=G.Name, \n\tSchoolBranch=SB.Name, \n\tStudentCount = COUNT(SC.StudentCode)\nFROM \n\tClass C, \n\tGrade G, \n\tSchoolBranch SB, \n\tStudentClass SC\nWHERE \t\n\tG.GradeCode=C.GradeCode AND \n\tC.SchoolBranchCode = SB.SchoolBranchCode AND \n\tC.ClassCode=SC.ClassCode AND\n\tSC.AdmissionDate BETWEEN CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 5))) AS DATETIME) AND CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(:adt_date) - 4))) AS DATETIME)\nGROUP BY SB.Name, G.Name\nORDER BY SB.Name, G.Name\n\n",
  "arguments": {
