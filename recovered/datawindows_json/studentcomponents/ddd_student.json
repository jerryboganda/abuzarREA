  "retrieve": "SELECT \n\tStudent.StudentCode,   \n\tStudent.RegNo,   \n\tStudent.Name,   \n\tStudent = Name + ' (' + Student.RegNo + ')',\n\tStudent.FName,   \n\tcustomer=(select accounts.name from accounts where acccode=Student.custcode),\n\tStudent.Gender, \n\tStudent.BirthDate, \n\tStudent.Phone,   \n\tStudent.Mobile,   \n\tStudent.Status  \nFROM \n\tStudent  \nORDER BY \n\tStudent.Name ASC,   \n\tStudent.RegNo ASC\n",
  "update": "Student",
