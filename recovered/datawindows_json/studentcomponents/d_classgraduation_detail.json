  "retrieve": "SELECT\n\tClassGraduationDetail.GraduationCode, \n\tClassGraduationDetail.StudentCode, \n\tAliasname = Student.RegNo,\n\titemname = Student.Name + ' (' + Student.RegNo + ')' ,\n\tFatherName = Student.FName,\n\tCurrListRow = 0, \n\tClassGraduationDetail.RowID,\n\tClassGraduationDetail.RollNo,\n\tClassGraduationDetail.Graduate\nFROM \n\tClassGraduationDetail, Student\nWHERE \n\tClassGraduationDetail.GraduationCode = :ai_code AND\n\tClassGraduationDetail.StudentCode = Student.StudentCode\nORDER BY\n\tClassGraduationDetail.RowID",
  "update": "ClassGraduationDetail",
