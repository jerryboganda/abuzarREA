  "retrieve": "SELECT\n\tICode=Student.StudentCode,   \n\tFullCode=Student.RegNo,   \n\tItemName1=Student.Name,   \n\tItemName = Student.Name + ' (' + Student.RegNo + ')',\n\tPacking=Student.FName, \n\tPackingDesc='',\n\tManufacturer='',\n\tLocation='',\n\tFatherName=Student.FName,   \n\tcustomer=(select accounts.name from accounts where acccode=Student.custcode),\n\tStudent.Gender,   \n\tStudent.BirthDate,   \n\tStudent.Phone,   \n\tStudent.Mobile,   \n\tStudent.Status  \nFROM \n\tStudent, StudentClass, Class\nWHERE\n\tStudent.StudentCode = StudentClass.StudentCode AND \n\tStudentClass.ClassCode = Class.ClassCode AND\n\tClass.Active = 'Y'\nORDER BY \n\tItemName,\n\tFullCode\n"
 },
