  "retrieve": "SELECT\n\tPromotionCode=C.PromotionCode,\n\tDate = C.Date,\n\tUserName = U.UserName,\n\tPromoteClassFrom = C.PromoteClassFrom,\n\tPromoteClassTo = C.PromoteClassTo,\n\tRemarks = C.Remarks,\n\tRollNo = D.RollNo,\n\tRegNo = S.RegNo,\n\tStudentName = S.Name,\n\tFatherName = S.FName,\n\tPromoted = D.Promote\nFROM\n\tClassPromotion C, ClassPromotionDetail D, Student S, Users U\nWHERE\n\tC.PromotionCode = :ai_code AND\n\tC.UserCode = U.UserCode AND\n\tC.PromotionCode = D.PromotionCode AND\n\tD.StudentCode = S.StudentCode\nORDER BY\n\tRollNo",
