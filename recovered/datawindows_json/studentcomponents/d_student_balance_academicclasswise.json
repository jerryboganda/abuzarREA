    "name": "customercategory",
    "dbname": "CustomerCategory"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "debit",
    "dbname": "Debit"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "credit",
    "dbname": "Credit"
   },
   {
    "type": "char(100)",
    "updatewhereclause": "yes",
    "name": "class",
    "dbname": "Class"
   }
  ],
  "retrieve": "SELECT \n\tA.RegNo,\n\tA.Name, \n\tA.StudentCode,\n\tA.Customer, \n\tCustomerCategory = (SELECT CustomerCategory.Name FROM CustomerCategory WHERE CustomerCategory.CustCatCode = A.CustCatCode),\n\tDebit= CASE WHEN Balance > 0 THEN Balance ELSE 0 END,\n\tCredit= CASE WHEN Balance < 0 THEN ABS(Balance) ELSE 0 END,\n\tClass = A.Class\nFROM\n\t(SELECT \n\t\tP.Name, P.RegNo, P.StudentCode, C.CustCode, Customer=A.Name, C.CustCatCode, Balance=SUM(V.Debit - V.Credit), AC.ClassCode, Class=AC.Name\n\tFROM\n\t\tVirtualGL V,\n\t\tAccounts A,\n\t\tCustomer C,\n\t\tSubAccounts S,\n\t\tStudent P,\n\t\tStudentClass SC,\n\t\tClass AC\n\tWHERE \n\t\tV.Date <= :ad_Date AND \n\t\tAC.ClassCode IN (:ai_ClassCode) AND\n\t\tAC.ClassCode = SC.ClassCode AND\n\t\tSC.StudentCode = P.StudentCode AND\n\t\tP.StudentCode = V.StudentCode AND\n\t\tV.AccCode = A.AccCode AND\n\t\tA.AccCode = C.CustCode AND\n\t\tV.AccCode = C.CustCode AND\n\t\tA.SubCode = S.SubAccCode \n\tGROUP BY \n\t\tAC.ClassCode,\n\t\tAC.Name,\n\t\tP.StudentCode, \n\t\tP.Name, \n\t\tP.RegNo,\n\t\tA.Name, \n\t\tC.CustCode,\n\t\tC.CustCatCode) A\n\n   ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_date",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_ClassCode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "class A, regno A, name A",
  "filter": "debit <> 0 OR credit <> 0"
 },
