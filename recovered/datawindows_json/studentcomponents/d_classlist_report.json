  "retrieve": "select \n\tname, \n\tActive=class.active,\n\tClassYear = Class.ClassYear,\n\tgrade=(select name from grade where grade.gradecode=class.gradecode),\n\tschool= (select name from school where school.schoolcode=class.schoolcode),\n\tclasstype=(select name from classtype where classtype.classtypecode=class.classtypecode),\n\tbranch=(select name from schoolbranch where schoolbranch.schoolbranchcode=class.schoolbranchcode),\n\tMedium=(select name from classmedium where classmedium.classmediumcode=class.classmediumcode),\n\tnoofstudent=(select count(*) from studentclass where studentclass.classcode=class.classcode),\n\tPromoted=(select count(*) from studentclass where studentclass.classcode=class.classcode AND (studentclass.promotionrowid > 0 OR studentclass.graduationrowid > 0)),\n\tClassStatus=CASE WHEN class.promoted = 'Y' THEN 'P' WHEN class.graduated = 'Y' THEN 'G' ELSE 'N' END\nfrom class\norder by name\n\n",
  "sort": "name A",
  "filter": " active ='Y'"
 },
