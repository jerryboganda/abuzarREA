  "retrieve": "SELECT \n\tCode=H.StudentServiceTemplateCode,\n\tName=H.Name,\n\tDate=H.Date,\n\tUserName=(SELECT U.UserName FROM Users U WHERE U.USerCode=H.UserCode),\n\tService=(SELECT SV.Name FROM Service SV WHERE SV.ServiceCode=H.ServiceCode),\n\tPosted=H.Posted,\n\tPostDate=H.PostDate,\n\tPostedBy=(SELECT U.UserName FROM Users U WHERE U.USerCode=H.PostedBy),\n\tSvcInvGenerated=H.SvcInvGenerated,\n\tRegNo=S.RegNo,   \n\tStudentName=S.Name,   \n\tStudent=S.Name + ' (' + S.RegNo + ')',\n\tFatherName=S.FName,   \n\tQty = D.Qty,\n\tCharges = D.Charges,\n\tDiscPerc = D.DiscPerc,\n\tServiceFlatDisc = D.ServiceFlatDisc,\n\tTransportRoute = (SELECT T.Name FROM TransportRoute T WHERE T.TransportRouteCode=D.TransportRouteCode),\n\tVehicle = (SELECT V.Name FROM Vehicle V WHERE V.VehicleCode=D.VehicleCode),\n\tRowID=D.RowID\nFROM\n\tStudentServiceTemplate H, StudentServiceTemplateDetail D, Student S\nWHERE\n\tH.StudentServiceTemplateCode = :ai_code AND\n\tH.StudentServiceTemplateCode = D.StudentServiceTemplateCode AND\n\tD.StudentCode = S.StudentCode\nORDER BY\n\tD.RowID",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
