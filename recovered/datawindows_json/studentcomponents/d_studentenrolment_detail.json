  "retrieve": "SELECT\n\tStudentClass.ClassCode,\n\tStudentClass.StudentCode,\n\tAliasname = Student.RegNo,\n\titemname = Student.Name + ' (' + Student.RegNo + ')' ,\n\tFatherName = Student.FName,\n\tCurrListRow = 0,\n\tStudentClass.AdmissionDate,\n\tStudentClass.ServiceInvCode,\n\tStudentClass.LastServiceInvDate,\n\tStudentClass.PromotionRowID,\n\tStudentClass.GraduationRowID,\n\tStudentClass.RollNo\nFROM \n\tStudentClass, Student\nWHERE \n\tStudentClass.ClassCode = :ai_classcode AND\n\tStudentClass.StudentCode = Student.StudentCode AND\n\tPromotionRowID IS NULL AND\n\tGraduationRowID IS NULL",
  "update": "StudentClass",
  "updatewhere": "0",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_classcode",
      "number"
     ]
    }
   ]
  },
  "sort": "long(rollno) A, admissiondate A"
