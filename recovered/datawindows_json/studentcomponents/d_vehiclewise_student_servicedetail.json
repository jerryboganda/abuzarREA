  "retrieve": "SELECT\n\tvehicle = (SELECT V.Name FROM Vehicle V WHERE V.VehicleCode=dbo.servicedetail.Vehiclecode),\n\tvehicleType = (SELECT VT.Name FROM Vehicle V,VehicleType VT WHERE V.VehicleCode=dbo.servicedetail.Vehiclecode AND V.VehicleTypeCode=VT.VehicleTypeCode),\n\tserviceinvcode = dbo.serviceheader.serviceinvcode,    \n\tdate = dbo.serviceheader.date,   \n\tinvdiscperc = dbo.serviceheader.discperc,    \n\tflatdisc = dbo.serviceheader.flatdisc,    \n\tmisccharges = dbo.serviceheader.misccharges, \n\tcashreceived = dbo.serviceheader.cashreceived,\n\tprice = dbo.servicedetail.price,    \n\tservicediscperc = dbo.servicedetail.discperc,    \n\tservicename = service.name,\n\tqty = dbo.servicedetail.qty,\n\tServiceFlatDisc = ServiceDetail.ServiceFlatDisc,\n\tPerson = dbo.accounts.name,\n\tstudentregno = (SELECT S.RegNo FROM Student S WHERE S.StudentCode=dbo.serviceheader.studentcode),\n\tstudentname = (SELECT S.Name + ' (' + S.RegNo + ')' FROM Student S WHERE S.StudentCode=dbo.serviceheader.studentcode),\n\tCurrentClass = (SELECT C.Name FROM Class C, Student S WHERE S.StudentCode=dbo.serviceheader.studentcode AND C.ClassCode = S.CurrentClass),\n\tdoctype=Case dbo.serviceheader.servicecatcode When 12 Then 'Cash' When 11 Then 'Credit' Else 'Cash' End,\n\theaderno=dbo.serviceheader.headerno,\n\tServiceRowID=servicedetail.srvrowid,\n\tserviceflattax=dbo.servicedetail.serviceflattax,\n\tservicegstperc=dbo.servicedetail.servicegstperc,\n\tserviceinvgstperc=dbo.serviceheader.serviceinvgstperc,\n\tReceivedOnInv=dbo.serviceheader.cashcharged + ISNULL((SELECT SUM(MCW.Amount) FROM MasterCashWin MCW WHERE MCW.DocumentCode=dbo.serviceheader.serviceinvcode and MCW.documenttype='RS'), 0),\n\tOtherReceipts=ISNULL((SELECT credit=SUM(D.credit) FROM GLdetail D, GLHeader H \n\t\t\tWHERE  H.GLVochCode = D.GLVochCode AND D.InvoiceCode = dbo.serviceheader.serviceinvcode AND \n\t\t\t\t\tH.VochCatCode IN (SELECT V.VochCatCode FROM VocherCategory V WHERE V.InvoiceBased=1 AND V.InvoiceType=3)),0),\n\tOtherAdj=ISNULL((SELECT credit=SUM(D.debit) FROM GLdetail D, GLHeader H \n\t\t\tWHERE  H.GLVochCode = D.GLVochCode AND D.InvoiceCode = dbo.serviceheader.serviceinvcode AND \n\t\t\t\t\tH.VochCatCode IN (SELECT V.VochCatCode FROM VocherCategory V WHERE V.InvoiceBased=1 AND V.InvoiceType=3)),0),\n\tBalance = ISNULL(dbo.serviceheader.OutstandingAmt, 0)\nFROM\n\tdbo.serviceheader,\n\tdbo.servicedetail,\n\tdbo.service, \n\tdbo.accounts\n\nWHERE  \n\tdbo.serviceheader.date BETWEEN :ad_StartDate and :ad_EndDate  and\n\tdbo.serviceheader.servicecatcode IN (10,11,12) and\n\tdbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode and  \n\tdbo.servicedetail.servicecode = service.servicecode and \n\tdbo.serviceheader.custcode = dbo.accounts.acccode and\n\tdbo.servicedetail.vehiclecode IN (:ai_vehiclecode)\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_vehiclecode",
      "numberlist"
     ]
    },
    {
