  "retrieve": "SELECT \n\tStudentCode,\n\tCustCode,\n\tRegNo,\n\tName,\n\tFName,\n\tGender,\n\tBirthDate,\n\tCurrentAddress,\n\tPhone,\n\tMobile,\n\tAdmissionReqIn,\n\tDiscPerc,\n\tStatus,\n\tRegisteredBy,\n\tRegisteredOn, \n\tAdmittedTo,\n\tAdmittedBy,\n\tRollNo = (SELECT MAX(RollNo) FROM StudentClass SC WHERE SC.StudentCode=Student.StudentCode AND ClassCode=Student.AdmittedTo),\n\tFlatDisc,\n\tRemarks\nFROM\n\tStudent\nWHERE \n\tRegisteredOn BETWEEN :adt_startdate AND :adt_enddate\nORDER BY\n\tRegisteredOn",
