  "retrieve": "SELECT\n\tCustomerServiceTemplateDetail.CustomerServiceTemplateCode,\n\tCustomerServiceTemplateDetail.CustCode,\n\tAliasname = Accounts.AliasName,\n\titemname = Accounts.Name + ' (' + Accounts.AliasName + ')' ,\n\tCurrListRow = 0,\n\tCustomerServiceTemplateDetail.TransportRouteCode,\n\tCustomerServiceTemplateDetail.VehicleCode,\n\tVehicleName = (SELECT V.Name FROM Vehicle V WHERE V.VehicleCode = CustomerServiceTemplateDetail.VehicleCode),\n\tCustomerServiceTemplateDetail.RowID,\n\tCustomerServiceTemplateDetail.Remarks,\n\tCustomerServiceTemplateDetail.Status,\n\tCustomerServiceTemplateDetail.Charges,\n\tCustomerServiceTemplateDetail.DiscPerc,\n\tCustomerServiceTemplateDetail.ServiceFlatDisc,\n\tCustomerServiceTemplateDetail.Qty\nFROM \n\tCustomerServiceTemplateDetail, Customer, Accounts\nWHERE \n\tCustomerServiceTemplateDetail.CustomerServiceTemplateCode = :ai_code AND\n\tCustomerServiceTemplateDetail.CustCode = Customer.CustCode AND\n\tCustomer.CustCode = Accounts.AccCode\nORDER BY \n\tCustomerServiceTemplateDetail.RowID",
  "update": "CustomerServiceTemplateDetail",
