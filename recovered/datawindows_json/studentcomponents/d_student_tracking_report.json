  "retrieve": "SELECT \n\tStudentCode, \n\tRegNo=S.RegNo,\n\tStudentName=S.Name,\n\tStatus = S.Status, \n\tDate=RegisteredOn, \n\tEvent=CASE WHEN S.AdmittedTo >= 0 THEN 'Admission' ELSE 'Registeration' END, \n\tClass=(SELECT C.Name FROM Class C WHERE C.ClassCode=S.AdmittedTo), \n\tRollNo=(SELECT SC.RollNo FROM StudentClass SC WHERE SC.ClassCode=S.AdmittedTo AND SC.StudentCode=S.StudentCode), \n\tToClass = NULL, \n\tNewRollNo=NULL\nFROM Student S\nWHERE S.StudentCode IN (:ai_studentcode)\nUNION ALL\nSELECT \n\tStudentCode, \n\tRegNo=(SELECT S.RegNo FROM Student S WHERE S.StudentCode = StudentClass.StudentCode),\n\tStudentName=(SELECT S.Name FROM Student S WHERE S.StudentCode = StudentClass.StudentCode),\n\tStatus=(SELECT S.Status FROM Student S WHERE S.StudentCode = StudentClass.StudentCode),\n\tDate=AdmissionDate, \n\tEvent='Enrollment', \n\tClass=(SELECT C.Name FROM Class C WHERE C.ClassCode=StudentClass.ClassCode), \n\tRollNo, \n\tToClass = NULL, \n\tNewRollNo=NULL\nFROM StudentClass\nWHERE StudentCode IN (:ai_studentcode)\nUNION ALL\nSELECT \n\tCPD.StudentCode, \n\tRegNo=(SELECT S.RegNo FROM Student S WHERE S.StudentCode = CPD.StudentCode),\n\tStudentName=(SELECT S.Name FROM Student S WHERE S.StudentCode = CPD.StudentCode),\n\tStatus=(SELECT S.Status FROM Student S WHERE S.StudentCode = CPD.StudentCode),\n\tDate=CP.Date, \n\tStatus='Promotion', \n\tClass=(SELECT C.Name FROM Class C WHERE C.ClassCode=CP.PromoteClassFrom), \n\tCPD.RollNo, \n\tToClass=(SELECT C.Name FROM Class C WHERE C.ClassCode=CP.PromoteClassTo), \n\tNewRollNo=(SELECT SC.RollNo FROM StudentClass SC WHERE SC.ClassCode=CP.PromoteClassTo AND SC.StudentCode=CPD.StudentCode)\nFROM ClassPromotionDetail CPD, ClassPromotion CP\nWHERE CP.PromotionCode = CPD.PromotionCode AND StudentCode IN (:ai_studentcode) AND CPD.Promote='Y'\nUNION ALL\nSELECT \n\tCGD.StudentCode, \n\tRegNo=(SELECT S.RegNo FROM Student S WHERE S.StudentCode = CGD.StudentCode),\n\tStudentName=(SELECT S.Name FROM Student S WHERE S.StudentCode = CGD.StudentCode),\n\tStatus=(SELECT S.Status FROM Student S WHERE S.StudentCode = CGD.StudentCode),\n\tDate=CG.Date, \n\tStatus='Graduation/Left School', \n\tClass=(SELECT C.Name FROM Class C WHERE C.ClassCode=CG.ClassCode), \n\tCGD.RollNo, \n\tToClass=NULL, \n\tNewRollNo=NULL\nFROM ClassGraduationDetail CGD, ClassGraduation CG\nWHERE CG.GraduationCode = CGD.GraduationCode AND StudentCode IN (:ai_studentcode) AND CGD.Graduate='Y'\nUNION ALL\nSELECT \n\tT.StudentCode, \n\tRegNo=(SELECT S.RegNo FROM Student S WHERE S.StudentCode = T.StudentCode),\n\tStudentName=(SELECT S.Name FROM Student S WHERE S.StudentCode = T.StudentCode),\n\tStatus=(SELECT S.Status FROM Student S WHERE S.StudentCode = T.StudentCode),\n\tDate=T.Date, \n\tStatus='Transfer', \n\tClass=(SELECT C.Name FROM Class C WHERE C.ClassCode=T.SourceClass), \n\tT.SourceClassRollNo, \n\tToClass=(SELECT C.Name FROM Class C WHERE C.ClassCode=T.TargetClass), \n\tNewRollNo=NULL\nFROM StudentClassTransfer T\nWHERE T.StudentCode IN (:ai_studentcode)\nUNION ALL\nSELECT \n\tStudentCode, \n\tRegNo=(SELECT S.RegNo FROM Student S WHERE S.StudentCode = SchoolLeaving.StudentCode),\n\tStudentName=(SELECT S.Name FROM Student S WHERE S.StudentCode = SchoolLeaving.StudentCode),\n\tStatus=(SELECT S.Status FROM Student S WHERE S.StudentCode = SchoolLeaving.StudentCode),\n\tDate=Date, \n\tStatus='Left School', \n\tClass=(SELECT C.Name FROM Class C WHERE C.ClassCode=SchoolLeaving.ClassCode), \n\tRollNo, \n\tToClass=NULL, \n\tNewRollNo=NULL\nFROM SchoolLeaving\nWHERE StudentCode IN (:ai_studentcode)\nORDER BY StudentName, RegNo, Date\n\n",
  "update": "Student",
  "updatewhere": "1",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_studentcode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "studentname A, regno A, date A"
 },
