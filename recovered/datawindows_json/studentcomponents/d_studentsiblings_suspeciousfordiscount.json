  "retrieve": "SELECT \n\tFNIC=S.FNIC,\n\tFname=S.FName,\n\tMName = S.MName,\n\tNoofSiblings = NULL,\n\tStudentCode = S.StudentCode,\n\tRegNo = S.RegNo,\n\tStudentName = S.Name,\n\tCurrentClass = (SELECT C.Name FROM Class C WHERE C.ClassCode = S.CurrentClass),\n\tGrade = G.Name,\n\tNumericalFactor = G.NumericalFactor,\n\tRollNo = (SELECT SC.RollNo FROM StudentClass SC WHERE SC.ClassCode = S.CurrentClass AND SC.StudentCode=S.StudentCode),\n\tGender = S.Gender,\n\tDiscPerc=S.DiscPerc,\n\tFlatDisc = S.FlatDisc,\n\tFeeComment = S.FeeComment,\n\tRemarks = S.Remarks,\n\tMobile = S.Mobile,\n\tFMobile = S.FMobile,\n\tMMobile = S.MMobile,\n\tTop1 = NULL,\n\tTop2 = NULL\nFROM\n\tStudent S, Grade G, Class C\nWHERE\n\t(S.DiscPerc > 0 OR S.FlatDisc > 0) AND\n\tS.Status='A' AND S.CurrentClass > 0 AND S.CurrentClass = C.ClassCode AND C.GradeCode = G.GradeCode AND G.NumericalFactor <= 10 AND\n\tS.StudentCode NOT IN \n\t\t(SELECT SS.StudentCode\n\t\tFROM\n\t\t\tStudent SS, Grade GG, Class CC,\n\t\t\t(SELECT ST.FNIC, FNicCount=COUNT(ST.FNIC)\n\t\t\tFROM Student ST, Grade G, Class C\n\t\t\tWHERE ST.Status='A' AND ST.CurrentClass > 0 AND ST.CurrentClass = C.ClassCode AND C.GradeCode = G.GradeCode AND G.NumericalFactor <= 10\n\t\t\tGROUP BY ST.FNIC\n\t\t\tHAVING COUNT(ST.FNIC) > 2) N\n\t\tWHERE\n\t\t\tSS.FNIC = N.FNIC AND SS.Status='A' AND SS.CurrentClass > 0 AND \n\t\t\tSS.CurrentClass = CC.ClassCode AND CC.GradeCode = GG.GradeCode AND GG.NumericalFactor <= 10 AND\n\t\t\tSS.StudentCode NOT IN \n\t\t\t\t(SELECT TOP 2 ST.StudentCode\n\t\t\t\tFROM Student ST, Grade GGG, Class CCC\n\t\t\t\tWHERE ST.FNIC = N.FNIC AND ST.Status='A' AND ST.CurrentClass > 0 AND \n\t\t\t\t\tST.CurrentClass = CCC.ClassCode AND CCC.GradeCode = GGG.GradeCode AND \n\t\t\t\t\tGGG.NumericalFactor <= 10\n\t\t\t\tORDER BY GGG.NumericalFactor DESC, ST.StudentCode))\n",
  "sort": "remarks A, studentname A"
 },
