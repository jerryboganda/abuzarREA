  "retrieve": "SELECT \n\tServiceInvCode=SH.ServiceInvCode, \n\tDate=SH.Date,\n\tServiceInvTypeCode=SH.ServiceInvTypeCode,\n\tStudentCode=SH.StudentCode,\n\tStudentRegNo=(SELECT S.RegNo FROM Student S WHERE S.StudentCode = SH.StudentCode),\n\tStudentName=(SELECT S.Name FROM Student S WHERE S.StudentCode = SH.StudentCode),\n\tStudentClass = (SELECT CL.Name FROM Class CL, Student S WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass = CL.ClassCode),\n\tOldFine=SH.MiscCharges,\n\tOldFeeAmt = SH.InvTotal,\n\tNewFine = :ai_fineamt,\n\tNewFeeAmt = ROUND(SH.InvTotal - SH.MiscCharges + :ai_fineamt, 0)\nFROM \n\tServiceHeader SH\nWHERE \n\t:ac_excludepartialpaidinvoices = 'N' AND \n\tSH.InvTotal > 0 AND\n\tSH.OutStandingAmt > 0 AND \n\tSH.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tSH.ServiceInvTypeCode = :ai_serviceinvtypecode\nUNION\nSELECT \n\tServiceInvCode=SH.ServiceInvCode, \n\tDate=SH.Date,\n\tServiceInvTypeCode=SH.ServiceInvTypeCode,\n\tStudentCode=SH.StudentCode,\n\tStudentRegNo=(SELECT S.RegNo FROM Student S WHERE S.StudentCode = SH.StudentCode),\n\tStudentName=(SELECT S.Name FROM Student S WHERE S.StudentCode = SH.StudentCode),\n\tStudentClass = (SELECT CL.Name FROM Class CL, Student S WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass = CL.ClassCode),\n\tOldFine=SH.MiscCharges,\n\tOldFeeAmt = SH.InvTotal,\n\tNewFine = :ai_fineamt,\n\tNewFeeAmt = ROUND(SH.InvTotal - SH.MiscCharges + :ai_fineamt, 0)\nFROM \n\tServiceHeader SH\nWHERE \n\t:ac_excludepartialpaidinvoices = 'Y' AND \n\tSH.InvTotal > 0 AND\n\tSH.OutStandingAmt = SH.InvTotal  AND \n\tSH.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\tSH.ServiceInvTypeCode = :ai_serviceinvtypecode\nORDER BY SH.ServiceInvCode\n",
  "arguments": {
   "_items": [
