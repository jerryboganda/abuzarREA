  "retrieve": "SELECT \n\tStudent.Name,   \n\tStudent.StudentCode,   \n\tStudent.RegNo,   \n\tStudent.FName,   \n\tStudent.CurrentClass,\n\tStudent.Gender,   \n\tStudent.BirthDate,   \n\tStudent.Phone,   \n\tStudent.Mobile,   \n\tStudent.Status,\n\tRollNo =  \n\t\t(SELECT C=MAX(SC.RollNo) \n\t\tFROM StudentClass SC, Class C \n\t\tWHERE SC.StudentCode=Student.StudentCode AND \n\t\t\tStudent.CurrentClass= SC.ClassCode AND\n\t\t\tSC.ClassCode = C.ClassCode AND C.Active='Y')\nFROM \n\tStudent  \nORDER BY \n\tStudent.Name ASC,   \n\tStudent.RegNo ASC   \n",
  "update": "Student",
  "updatewhere": "1",
  "updatekeyinplace": "no"
 },
