  "retrieve": "SELECT\n\tStudentCode,\n\tCustCode,\n\tRegNo,\n\tName,\n\tFName,\n\tGender,\n\tBirthDate,\n\tCurrentAddress,\n\tPhone,\n\tMobile,\n\tDiscPerc,\n\tStatus,\n\tRegisteredBy,\n\tRegisteredOn,\n\tAdmittedTo,\n\tAdmittedBy,\n\tCurrentClass = (SELECT C.Name FROM Class C WHERE C.ClassCode = Student.CurrentClass),\n\tClassFee = (SELECT C.Fee FROM Class C WHERE C.ClassCode = Student.CurrentClass),\n\tRollNo = CAST((SELECT RollNo FROM StudentClass SC WHERE SC.StudentCode=Student.StudentCode AND ClassCode=Student.CurrentClass) AS INT),\n\tFlatDisc,\n\tRemarks,\n\tDiscountAmt = ISNULL(flatdisc, 0) + Round((ISNULL(discperc,0) * ISNULL((SELECT C.Fee FROM Class C WHERE C.ClassCode = Student.CurrentClass),0) * 0.01), 2)\nFROM\n\tStudent\nWHERE \n\tStatus <> 'L' AND\n\tCurrentClass IN (:ai_classcode)\nORDER BY\n\tRegisteredOn",
  "update": "Student",
  "updatewhere": "1",
  "updatekeyinplace": "no",
