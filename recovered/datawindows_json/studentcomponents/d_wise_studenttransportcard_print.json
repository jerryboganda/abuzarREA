  "retrieve": "SELECT  \n\tStudentCode=Student.StudentCode,\n\tCustCode=Student.CustCode,\n\tRegNo=Student.RegNo,\n\tName=Student.Name,\n\tFName=Student.FName,\n\tGender=Student.Gender,\n\tBirthDate=Student.BirthDate,\n\tDiscPerc=Student.DiscPerc,\n\tStatus=Student.Status,\n\tRollNo = StudentClass.RollNo,\n\tGrade = Grade.Name,\n\tClass=Class.Name,\n\tSchool = (SELECT School.Name FROM School WHERE School.SchoolCode = Class.SchoolCode),\n\tSchoolAddress = (SELECT School.Description FROM School WHERE School.SchoolCode = Class.SchoolCode),\n\tTransportRouteCode=\n\t\t(SELECT Max(SD.TransportRouteCode) \n\t\tFROM StudentServiceTemplateDetail SD \n\t\tWHERE SD.StudentCode = Student.StudentCode AND \n\t\t\tSD.StudentServiceTemplateCode IN \n\t\t\t\t(SELECT Max(STD.StudentServiceTemplateCode) \n\t\t\t\tFROM StudentServiceTemplateDetail STD \n\t\t\t\tWHERE STD.StudentCode = Student.StudentCode)),\n\tVehicleCode=\n\t\t(SELECT Max(SD.VehicleCode) \n\t\tFROM StudentServiceTemplateDetail SD \n\t\tWHERE SD.StudentCode = Student.StudentCode AND \n\t\t\tSD.StudentServiceTemplateCode IN \n\t\t\t\t(SELECT Max(STD.StudentServiceTemplateCode) \n\t\t\t\tFROM StudentServiceTemplateDetail STD \n\t\t\t\tWHERE STD.StudentCode = Student.StudentCode)),\n\tIssueDate = GETDATE(),\n\tExpiryDate = ISNULL((SELECT CAST(DBO.FN_GetPreference('DefaultExpiry') AS DATETIME)), GETDATE()+365),\n\tFileName = 'c:~\\waseela_temp~\\'+LTRIM(RTRIM(STR(Student.StudentCode)))+'.' + ISNULL((SELECT MIN(Imagetype) FROM StudentImage SI WHERE SI.StudentCode = Student.StudentCode), 'bmp'),\n\tSignatureFile = 'c:~\\waseela_temp~\\sigfile.jpg'\nFROM\n\tStudent, StudentClass, Class, Grade\nWHERE \n\tStudent.StudentCode IN (:ai_code) AND\n\tStudent.StudentCode = StudentClass.StudentCode AND\n\tStudentClass.ClassCode = Class.ClassCode AND\n\tClass.Active = 'Y' AND\n\tClass.GradeCode = Grade.GradeCode\nORDER BY\n\tName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "numberlist"
     ]
    }
   ]
  }
 },
