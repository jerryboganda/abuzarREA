  "retrieve": "SELECT saleinvcode = dbo.saleledger.saleinvcode,\n\t\t rowid = Min(rowid),\n\t\t date = dbo.saleledger.date, \n       invdiscperc = dbo.saleledger.discperc, \n       flatdisc = dbo.saleledger.flatdisc,    \n       misccharges = dbo.saleledger.misccharges, \n       invsalestax = dbo.saleledger.salestax,\n       invgstperc1 = dbo.saleledger.invgstperc1,\n\t\t CustRefNo   = dbo.saleledger.CustRefNo,\n\t\t remarks     = dbo.saleledger.Remarks,\n\t\t posted = dbo.saleledger.posted,\t\n\t\t looseqty = Sum(dbo.saledetail.looseqty), \n\t\t manufacturer = dbo.manufacturer.name,\n\t\t bonusqty = Sum(dbo.saledetail.bonusqty), \n\t\t machinename = saleledger.machinename,\n\t\t machineuser = (select users.username from users where users.usercode=saleledger.salesmancode),\n\t \t itemname = item.name,\n       itemflatdisc = Max(saledetail.itemflatdisc),\n       packqty  = Max(saledetail.packqty),  \n       price = Max(dbo.saledetail.saleprice),    \n       itemdiscperc = Max(dbo.saledetail.discperc),    \n\t\t salestax  = Max(saledetail.salestax),\n\t\t unitsalestax = Max(dbo.saledetail.unitsalestax) ,    \n\t\t gstperc = Max(dbo.saledetail.gstperc) ,    \n\t\t datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), \n\t\t Person = dbo.accounts.name,\n\t\t invnettotal = dbo.fn_getsaleinvtotal(saleledger.saleinvcode),\n\t\t totalsalestax = (SELECT invtotalsalestax= \n\t\t\t\t\t\t\t\t\t\t Round (\n\t\t/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( SD.looseqty * ( SD.saleprice - SD.itemflatdisc ) * (1 - SD.discperc * 0.01 ) , 2 ) )\n\t\t\t\t\t\t\t\t\t\t\t    * ( 1 - SL.discperc * 0.01 ) , 2 ) - SL.flatdisc ) * SL.invgstperc1 * 0.01  , 2 )\n \t\t/*items salestax*/\t\t + Sum (Round ((SD.looseqty + SD.bonusqty) * SD.unitsalestax + Round ( Round (SD.looseqty * (SD.saleprice - SD.itemflatdisc ) * (1 - SD.discperc * 0.01 ), 2 ) * SD.gstperc * 0.01 , 2 ) , 2 ) )\n\t\t\t\t\t\t\t\t\t\t , 0 )\n    \t\t\t FROM dbo.saleledger SL , \n         \t\t\tdbo.saledetail SD\n\n   \t\t\t WHERE  (SL.saleinvcode = dbo.saleledger.saleinvcode )   and\n\t\t\t\t\t\t  (SL.saleinvcode = SD.saleinvcode )   \n         \n\t\t\t\t GROUP BY SL.saleinvcode, \n\t\t\t\t\t\t\t SL.misccharges,   \n         \t\t\t\t SL.flatdisc,   \n         \t\t\t    SL.invgstperc1, \n\t\t\t\t\t\t\t SL.discperc,  \n\t\t   \t\t\t  \t SL.salestax \n\t\t\t)\n\nFROM \t dbo.saleledger, \n\t\t dbo.saledetail,    \n\t\t dbo.item, \n\t\t dbo.manufacturer,\n\t\t dbo.accounts\n\nWHERE  dbo.saleledger.saleinvcode >= :ai_sinvcode and\n\t\t dbo.saleledger.saleinvcode <= :ai_linvcode  and\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  \n\t\t dbo.saledetail.icode = item.icode and \n\t\t dbo.saleledger.custcode = dbo.accounts.acccode and\n\t    dbo.item.manfcode = dbo.manufacturer.manfcode and\n\t\t dbo.saleledger.custcode = :al_custcode\nGroup By \n\t\t\tdbo.saleledger.saleinvcode,\n\t\t   dbo.saleledger.date,   \n       \tdbo.saleledger.discperc,    \n       \tdbo.saleledger.flatdisc,    \n       \tdbo.saleledger.misccharges, \n       \tdbo.saleledger.salestax,\n       \tdbo.saleledger.invgstperc1,\n\t\t \tdbo.saleledger.CustRefNo,\n\t\t \tdbo.saleledger.Remarks,\n\t\t \tdbo.saleledger.posted,\t\n\t\t\tdbo.saleledger.machinename,\n\t\t\tdbo.saleledger.salesmancode,\n\t\t\tdbo.accounts.name,\n\t\t\tdbo.item.name, \n\t\t \tdbo.manufacturer.name\nUNION ALL\nSELECT saleinvcode = dbo.saleledger.saleinvcode,\n\t\t rowid = Min(rowid),\n\t\t date = dbo.saleledger.date, \n       invdiscperc = dbo.saleledger.discperc,    \n       flatdisc = dbo.saleledger.flatdisc,    \n       misccharges = dbo.saleledger.misccharges, \n       invsalestax = dbo.saleledger.salestax,\n       invgstperc1 = dbo.saleledger.invgstperc1,\n\t\t CustRefNo   = dbo.saleledger.CustRefNo,\n\t\t remarks     = dbo.saleledger.Remarks,\n\t\t posted = dbo.saleledger.posted,\t\n\t\t looseqty = Sum(sd.looseqty), \n\t\t manufacturer = dbo.manufacturer.name,\n\t\t bonusqty = Sum(sd.bonusqty), \n\t\t machinename = saleledger.machinename,\n\t\t machineuser = (select users.username from users where users.usercode=saleledger.salesmancode),\n\t \t itemname = item.name,\n       itemflatdisc = Max(sd.itemflatdisc),\n       packqty  = 0,  \n       price = Max(sd.saleprice),    \n       itemdiscperc = Max(sd.discperc),    \n\t\t salestax  = 0.00,\n\t\t unitsalestax = Max(sd.unitsalestax) ,    \n\t\t gstperc = Max(sd.gstperc) ,    \n\t\t datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), \n\t\t Person = dbo.accounts.name,\n\t\t invnettotal = dbo.fn_getsaleinvtotal(saleledger.saleinvcode),\n\t\t totalsalestax = (SELECT invtotalsalestax= \n\t\t\t\t\t\t\t\t\t\t Round (\n\t\t/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( SDD.looseqty * ( SDD.saleprice - SDD.itemflatdisc ) * (1 - SDD.discperc * 0.01 ) , 2 ) )\n\t\t\t\t\t\t\t\t\t\t\t    * ( 1 - SL.discperc * 0.01 ) , 2 ) - SL.flatdisc ) * SL.invgstperc1 * 0.01  , 2 )\n \t\t/*items salestax*/\t\t + Sum (Round ((SDD.looseqty + SDD.bonusqty) * SDD.unitsalestax + Round ( Round (SDD.looseqty * (SDD.saleprice - SDD.itemflatdisc ) * (1 - SDD.discperc * 0.01 ), 2 ) * SDD.gstperc * 0.01 , 2 ) , 2 ) )\n\t\t\t\t\t\t\t\t\t\t , 0 )\n    \t\t\t FROM dbo.saleledger SL , \n         \t\t\tdbo.saleinvdetail SDD\n\n   \t\t\t WHERE  \n\t\t\t\t\t(SL.impactinventory = 'N') AND \n\t\t\t\t\t(SL.saleinvcode = dbo.saleledger.saleinvcode )   and\n\t\t\t\t\t(SL.saleinvcode = SDD.saleinvcode )   \n         \n\t\t\t\t GROUP BY SL.saleinvcode, \n\t\t\t\t\t\t\t SL.misccharges,   \n         \t\t\t\t SL.flatdisc,   \n         \t\t\t    SL.invgstperc1, \n\t\t\t\t\t\t\t SL.discperc,  \n\t\t   \t\t\t  \t SL.salestax \n\t\t\t)\n\nFROM \t dbo.saleledger, \n\t\t dbo.saleinvdetail sd,    \n\t\t dbo.item, \n\t\t dbo.manufacturer,\n\t\t dbo.accounts\n\nWHERE  DBO.SaleLedger.impactinventory = 'N' AND \n\t\t dbo.saleledger.saleinvcode >= :ai_sinvcode and\n\t\t dbo.saleledger.saleinvcode <= :ai_linvcode  and\n\t\t dbo.saleledger.saleinvcode = sd.saleinvcode and  \n\t\t sd.icode = item.icode and \n\t\t dbo.saleledger.custcode = dbo.accounts.acccode and\n\t    dbo.item.manfcode = dbo.manufacturer.manfcode and\n\t\t dbo.saleledger.custcode = :al_custcode\nGroup By \n\t\t\tdbo.saleledger.saleinvcode,\n\t\t   dbo.saleledger.date,   \n       \tdbo.saleledger.discperc,    \n       \tdbo.saleledger.flatdisc,    \n       \tdbo.saleledger.misccharges, \n       \tdbo.saleledger.salestax,\n       \tdbo.saleledger.invgstperc1,\n\t\t \tdbo.saleledger.CustRefNo,\n\t\t \tdbo.saleledger.Remarks,\n\t\t \tdbo.saleledger.posted,\t\n\t\t\tdbo.saleledger.machinename,\n\t\t\tdbo.saleledger.salesmancode,\n\t\t\tdbo.accounts.name,\n\t\t\tdbo.item.name, \n\t\t \tdbo.manufacturer.name\nOrder By saleinvcode,  Min(rowid)",
