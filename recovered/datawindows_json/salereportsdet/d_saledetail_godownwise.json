  "retrieve": "  select\tdate = saleledger.date,\n\tinvcode=saleledger.saleinvcode,\n\tPostdate = saleledger.postdate,\n\tDue = saledetail.Due,\n\tsalesman = users.username,\n\ttitle= Case\n\t\tWhen salecatcode = 1 or salecatcode = 2 Then\n\t\t\t(Select accounts.name from accounts where accounts.acccode = saleledger.custcode)\n\t\tElse 'Cash Sale'\tEnd,\n\taliasname=customicode,\n\titem=item.name,\n\tgodown= (select name from godown where gcode=:ar_gcode),\n\tqty = saledetail.looseqty+saledetail.bonusqty,\n\t\n\tbatch = saledetail.batch,\n\texpiry=saledetail.expiry,\n\trate=Round(saledetail.rate, 2),\n\tdiscount=saledetail.discperc,\n\tpurprice=saledetail.purunitrate,\n\treference = saleledger.remarks,\n\tUTN=isnull(saledetail.saleutn,0)\nfrom\tsaleledger, saledetail, users, item\nwhere\tsaledetail.gcode = :ar_gcode and\n\tsaleledger.date Between :ar_stdate and :ar_enddate and\n\tsaleledger.saleinvcode = saledetail.saleinvcode and\n\tsaledetail.icode = item.icode  AND \n\tsaleledger.salesmancode=users.usercode\norder by saledetail.rowid\n\t\n",
  "arguments": {
