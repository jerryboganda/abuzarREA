  "retrieve": "SELECT\t\n\tsaleledger.saleinvcode , \n\tsaleledger.date , \n\tsaleledger.custrefno, \n\tsaleledger.remarks , \n\tcustcode=saleledger.custcode,\n\taccounts.name,\n\tusers.username, \n\tposted = saleledger.posted,\n\tPostedBy = IsNull((Select username from users \n\t\t\t\t\t\t\t\twhere dbo.saleledger.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\t\t\t\t\t\t\twhere dbo.saleledger.modifiedby = dbo.users.usercode), ''),\n\tNetAmount =max( saleledger.invtotal),\n\t\t\t\t\t/* Round(SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) *\n\t\t\t\t\t\t(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) + \n\t\t\t\t\t\tsaleledger.misccharges + saleledger.salestax - saleledger.flatdisc, 0)+\n\t\t\t\t\t\tRound(SUM( (saledetail.looseqty + saledetail.bonusqty) * saledetail.unitsalestax) + \n\t\t\t\t\t\tSUM(ROUND( (saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) *\n\t\t\t\t\t\t(1 - (.01 * saledetail.discperc)) * saledetail.gstperc * .01, 2)) +\n\t\t\t\t\t\tROUND( (SUM((saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) *\n\t\t\t\t\t\t(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) -\n\t\t\t\t\t\tsaleledger.flatdisc) * (saleledger.invgstperc1 * .01), 2), 0),*/\n\tdbo.saleledger.ReprintingCounter,\n\tdbo.saleledger.OriginalDate,\n\tdbo.saleledger.ModifyCounter,\n\tdbo.saleledger.AdmissionCode,\n\tdbo.Patient.Regno,\n\tPatient=dbo.Patient.Name,\n\tpatientcode=patient.patientcode\n\t\nFROM  \n\taccounts, saleledger, saledetail, users, patientadmission, patient\nWHERE     \n\t( dbo.saleledger.AdmissionCode IS NOT NULL ) AND\n\t ( dbo.saleledger.AdmissionCode = dbo.patientadmission.AdmissionCode ) AND\n\t ( dbo.patientadmission.PatientCode = Patient.PatientCode ) AND\n\t ( saleledger.custcode = accounts.acccode ) and \n\t ( dbo.saleledger.salecatcode = 1 or \n\t\tdbo.saleledger.salecatcode = 2 )   and\n\t ( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode)   and\n\t ( dbo.saleledger.salesmancode = dbo.users.usercode)   and\n\t (dbo.saleledger.date > :ad_invdate) and\n\t ( Posted IN (:as_Posted)) and\n\t\t:as_showrows='Y' AND \n\t ( dbo.saleledger.headerno IS NULL OR\n\t ( dbo.saleledger.headerno in (SELECT headercode FROM GroupAllowedHeader WHERE GroupCode = :ai_groupcode and module = :ai_module)))\nGROUP BY \n\tsaleledger.SALEINVCODE,\n\tsaleledger.CustCode,\n\tsaleledger.DiscPerc,\n\tsaleledger.MiscCharges,\n\tsaleledger.SalesTax,\n\tsaleledger.FlatDisc,\n\tsaleledger.DiscPerc,\n\tsaleledger.FlatDisc,\n\tsaleledger.InvGSTPerc1,\n\tsaleledger.date , \n\tsaleledger.custrefno, \n\taccounts.name,\n\tsaleledger.posted,\n\tsaleledger.postedby,\n\tsaleledger.modifiedby,\n\tusers.username,\n\tdbo.saleledger.ReprintingCounter, \n\tsaleledger.remarks,\n\tdbo.saleledger.OriginalDate,\n\tdbo.saleledger.ModifyCounter,\n\tdbo.saleledger.AdmissionCode,\n\tdbo.Patient.RegNo,\n\tdbo.Patient.Name,\n\tdbo.patient.patientcode\n",
