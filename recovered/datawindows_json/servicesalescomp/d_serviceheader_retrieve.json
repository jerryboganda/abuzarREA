  "retrieve": "SELECT   \n\tserviceheader.serviceinvcode , \n\tserviceheader.serviceocode,\n\tserviceheader.date , \n\tserviceheader.remarks , \n\tserviceheader.custcode , \n\tserviceheader.salesmancode ,\n\tserviceheader.headerno,  \n\tusers.username , \n\tserviceheader.discperc , \n\tserviceheader.flatdisc , \n\tserviceheader.misccharges , \n\tserviceheader.posted , \n\tserviceheader.postdate , \n\tcustomer.address1 , \n\tcustomer.city, \n\tcustomer.phone ,\n\tcustomerbalance = 0,\n\taliasname='                     ',\n\tdebitorcredit = ' ',\n\tserviceheader.originaldate,\n\tserviceheader.modifiedby,\n\tserviceheader.postedby,\n\tserviceheader.saleinvcode\t,\n\tserviceheader.doctcode\t,\t\n\tserviceheader.servicecatcode,\n\tserviceheader.cashreceived,\n\tpatientRegNo=space(50),\n\tserviceheader.patientcode,\n\tserviceheader.admissioncode,\n\tServiceHeader.DueDate,\n\tFullPatientName,\n\tPatientAge,\n\tPatientSex,\n\tPatientRefBy,\n\tRef1,\n\tRef2\nFROM  \n\tcustomer , \n\tserviceheader, \n\tusers , \n\taccounts  \nWHERE \n\t( serviceheader.custcode = customer.custcode ) and \n\t( users.usercode = serviceheader.salesmancode ) and \n\t( serviceheader.custcode = accounts.acccode ) and \n\t( ( dbo.serviceheader.serviceinvcode = :ar_SaleInvCode ) )   ",
  "update": "serviceheader",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_SaleInvCode",
      "number"
     ]
    }
   ]
  }
