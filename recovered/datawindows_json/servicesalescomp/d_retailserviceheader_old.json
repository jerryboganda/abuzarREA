  "retrieve": "SELECT  \n\tserviceheader.servicecatcode , \n\tserviceheader.serviceocode,\n\tserviceheader.serviceinvcode , \n\tserviceheader.date , \n\tserviceheader.remarks , \n\tserviceheader.custcode , \n\tserviceheader.salesmancode ,\n\tserviceheader.headerno,  \n\tusers.username , \n\tserviceheader.discperc , \n\tserviceheader.flatdisc , \n\tserviceheader.misccharges , \n\tserviceheader.posted , \n\tserviceheader.postdate , \n\tcustomer.address1 , \n\tcustomer.city, \n\tcustomer.phone ,\n\tcustomerbalance = 0,\n\tdebitorcredit = ' ',\n\tserviceheader.originaldate,\n\tserviceheader.modifiedby,\n\tserviceheader.postedby,\n\tserviceheader.saleinvcode,\n\tserviceheader.doctcode,\n\tserviceheader.cashreceived,\n\tpatientregno=space(50),\n\tserviceheader.patientcode,\n\tserviceheader.admissioncode,\n\tserviceheader.duedate,\n\tFullPatientName,\n\tPatientAge,\n\tPatientSex,\n\tPatientRefBy,\n\tRef1,\n\tRef2\nFROM  \n\tcustomer , \n\tserviceheader, \n\tusers , \n\taccounts\nWHERE \n\t( serviceheader.custcode = customer.custcode ) and \n\t( users.usercode = serviceheader.salesmancode ) and \n\t( serviceheader.custcode = accounts.acccode ) and \n\t( ( dbo.serviceheader.serviceinvcode = :ar_SaleInvCode ) )   ",
  "update": "serviceheader",
