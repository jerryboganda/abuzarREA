    "dbname": "Customer"
   },
   {
    "type": "char(12)",
    "updatewhereclause": "yes",
    "name": "aliasname",
    "dbname": "AliasName"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "outstandingamt",
    "dbname": "OutstandingAmt"
   },
   {
    "type": "decimal(2)",
    "updatewhereclause": "yes",
    "name": "invtotal",
    "dbname": "InvTotal"
   }
  ],
  "retrieve": "SELECT  \n\tServiceInvCode,\n\tDate,\n\tCustCode,\n\tCustomer,\n\tAliasName,\n\tOutstandingAmt,\n\tInvTotal\nFROM\n(SELECT \n\tServiceHeader.ServiceInvCode,\n\tServiceHeader.Date,\n\tServiceHeader.CustCode,\n\tCustomer=Accounts.Name,\n\tAliasName=Accounts.AliasName,\n\tOutstandingAmt = ServiceHeader.OutstandingAmt + \n\t\tCASE :module\n\t\tWHEN 'SRA' THEN \n\t\t\tISNULL((SELECT SUM(Amt) FROM ServiceSRAllocationDetail \n\t\t\tWhere ServiceSRAllocationCode = :Code AND ServiceSRAllocationDetail.ServiceInvCode = ServiceHeader.ServiceInvCode), 0)\n\t\tELSE \n\t\t\tISNULL((SELECT SUM(Debit-Credit) \n\t\t\tFROM GLDetail D, GLHeader H, VocherCategory C\n\t\t\tWhere D.GlVochCode = :Code AND D.InvoiceCode = ServiceHeader.ServiceInvCode AND D.GlVochCode = H.GlVochCode AND H.VochCatCode = C.VochCatCode AND C.InvoiceType=3), 0)\n\t\tEND,\n\tServiceHeader.InvTotal\nFROM \n\tServiceHeader, Accounts\nWHERE\n\tServiceHeader.Marked ='N' AND\n\tServiceHeader.Posted ='Y' AND\n\tServiceHeader.CustCode = :custcode AND\n\tServiceHeader.CustCode = Accounts.AccCode) S\nWHERE\n\tOutstandingAmt > 0\nORDER BY\n\tDate,   \n\tServiceInvCode",
  "arguments": {
   "_items": [
    {
     "_items": [
      "custcode",
      "number"
     ]
    },
    {
     "_items": [
      "code",
      "number"
     ]
    },
    {
     "_items": [
      "module",
      "string"
     ]
    }
   ]
  }
 },
