  "retrieve": "SELECT\n\tAllSale=ISNULL(SUM(AllSale), 0),\n\tCategory=Category,\n\tTotalDisc= ISNULL(SUM(TotalDisc), 0),\n\tMiscCharg= ISNULL(SUM(MiscCharg), 0),\n\tTotalInvDiscPerc= ISNULL(SUM(TotalInvDiscPerc), 0),\n\tRefundAmt = ISNULL(SUM(RefundAmt), 0),\n\tDiff=ISNULL(SUM(Diff), 0),\n\tTotalTax=ISNULL(SUM(TotalTax), 0),\n\tAmountReceived = ISNULL(SUM(AmountReceived), 0)\nFROM\n(SELECT   \n\tAllSale=IsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2))  ,0),\n\tCategory=IC.name,\n\tTotalDisc= (select sum(flatdisc)\n\t\t from AdvSaleLedger\n\t\t where AdvSaleLedger.machinename=:as_machinename and\n\t\t\tAdvSaleLedger.date between :ar_startdate and :ar_enddate),\n\tMiscCharg= ( select sum(misccharges) \n\t\t from AdvSaleLedger\n\t\t where AdvSaleLedger.machinename=:as_machinename and\n\t\t\t\t AdvSaleLedger.date between :ar_startdate and :ar_enddate),\n\tTotalinvdiscperc= \n\t\t(select sum(ISNULL(B.invdiscperc,0))\n\t\tfrom\n\t\t\t(select invdiscperc = IsNull( sum(Round(((AdvSaleDetail.looseqty + AdvSaleDetail.packqty * AdvSaleDetail.packunits) * (AdvSaleDetail.saleprice - AdvSaleDetail.itemflatdisc)) * (1 - (.01 * AdvSaleDetail.discperc)),2)) * 0.01 * AdvSaleLedger.discperc, 0)\n\t\t\tfrom   AdvSaleLedger, AdvSaleDetail  \n\t\t\twhere  AdvSaleLedger.machinename=:as_machinename and\n\t\t\t\t\t (AdvSaleLedger.date between :ar_startdate and :ar_enddate) AND\n\t\t\t\t\t AdvSaleLedger.AdvSaleInvCode = AdvSaleDetail.AdvSaleInvCode \n\t\t\tgroup by AdvSaleLedger.AdvSaleInvCode, AdvSaleLedger.discperc) as  B),\n\tRefundAmt = (select sum(RefundAmt) \n\t\t from AdvSaleLedger\n\t\t where AdvSaleLedger.machinename=:as_machinename and\n\t\t\t\t AdvSaleLedger.date between :ar_startdate and :ar_enddate),\n\tdiff=(select sum ( ISNULL(A.rounddifference,0)) \n\t\tfrom\n\t\t\t(SELECT rounddifference= Round(Sum ( dbo.AdvSaleDetail.looseqty * dbo.AdvSaleDetail.saleprice)\n\t\t\t\t\t\t- Round(Sum (Round(( dbo.AdvSaleDetail.looseqty  * (dbo.AdvSaleDetail.saleprice - dbo.AdvSaleDetail.itemflatdisc) * (dbo.AdvSaleDetail.discperc * .01)) + (dbo.AdvSaleDetail.looseqty  * dbo.AdvSaleDetail.itemflatdisc),2)), 2)\n\t\t\t\t\t\t- Sum ( Round(dbo.AdvSaleDetail.looseqty   * (dbo.AdvSaleDetail.saleprice  - dbo.AdvSaleDetail.itemflatdisc) * (1 - (dbo.AdvSaleDetail.discperc * .01)),2)) * (dbo.AdvSaleLedger.discperc /100) \n\t\t\t\t\t\t+ dbo.AdvSaleLedger.misccharges - AdvSaleLedger.flatdisc - AdvSaleLedger.RefundAmt,0)  \n\t\t\t\t\t\t-\n\t\t\t\t\t  (Sum ( dbo.AdvSaleDetail.looseqty * dbo.AdvSaleDetail.saleprice)\n\t\t\t\t\t\t\t- Round(Sum (Round(( dbo.AdvSaleDetail.looseqty  * (dbo.AdvSaleDetail.saleprice - dbo.AdvSaleDetail.itemflatdisc) * (dbo.AdvSaleDetail.discperc * .01)) + (dbo.AdvSaleDetail.looseqty  * dbo.AdvSaleDetail.itemflatdisc),2)), 2)\n\t\t\t\t\t\t\t- Sum (Round( dbo.AdvSaleDetail.looseqty   * (dbo.AdvSaleDetail.saleprice  - dbo.AdvSaleDetail.itemflatdisc) * (1 - (dbo.AdvSaleDetail.discperc * .01)),2)) * (dbo.AdvSaleLedger.discperc /100)\n\t\t\t\t\t\t\t+ dbo.AdvSaleLedger.misccharges - AdvSaleLedger.flatdisc - AdvSaleLedger.RefundAmt),\n\t\t\t\t\tnetammount= (Sum ( dbo.AdvSaleDetail.looseqty * dbo.AdvSaleDetail.saleprice)\n\t\t\t\t\t\t- Round(Sum (Round(( dbo.AdvSaleDetail.looseqty * \n\t\t\t\t\t\t(dbo.AdvSaleDetail.saleprice - dbo.AdvSaleDetail.itemflatdisc) * \n\t\t\t\t\t\t(dbo.AdvSaleDetail.discperc * .01)) + \n\t\t\t\t\t\t(dbo.AdvSaleDetail.looseqty  * dbo.AdvSaleDetail.itemflatdisc),2)), 2) + \n\t\t\t\t\t\tRound(Sum ( dbo.AdvSaleDetail.looseqty   * \n\t\t\t\t\t\t\t(dbo.AdvSaleDetail.saleprice  - dbo.AdvSaleDetail.itemflatdisc) * \n\t\t\t\t\t\t\t(1 - (dbo.AdvSaleDetail.discperc * .01))) * (dbo.AdvSaleLedger.discperc /100), 2) - \n\t\t\t\t\t\t\tdbo.AdvSaleLedger.flatdisc + dbo.AdvSaleLedger.misccharges - AdvSaleLedger.RefundAmt)\n\t\t\tFROM dbo.AdvSaleLedger, dbo.AdvSaleDetail\n\t\t\tWHERE ( dbo.AdvSaleLedger.AdvSaleInvCode = dbo.AdvSaleDetail.AdvSaleInvCode ) and \n\t\t\t\t\t(AdvSaleLedger.machinename=:as_machinename ) and\n\t\t\t\t\t(AdvSaleLedger.date between :ar_startdate and :ar_enddate)\n\t\t\tGROUP BY dbo.AdvSaleLedger.misccharges, dbo.AdvSaleLedger.flatdisc, AdvSaleLedger.refundamt,\n\t\t\t\tdbo.AdvSaleLedger.date, dbo.AdvSaleLedger.AdvSaleInvCode,   \n\t\t\t\tdbo.AdvSaleLedger.discperc, dbo.AdvSaleLedger.salecatcode) as A),\n\ttotaltax=(SELECT ISNULL( SUM(Round(INV.itemsalestax + invtax,0) ),0)\n\t\t\t\tFROM\n\t\t\t\t\t(Select itemsalestax = Sum (Round (dbo.AdvSaleDetail.looseqty * dbo.AdvSaleDetail.unitsalestax + Round ( Round (dbo.AdvSaleDetail.looseqty * (dbo.AdvSaleDetail.saleprice - dbo.AdvSaleDetail.itemflatdisc ) * (1 - dbo.AdvSaleDetail.discperc * 0.01 ), 2 ) * dbo.AdvSaleDetail.gstperc * 0.01 , 2 ) , 2 ) ),\n\t\t\t\t\t\t\t\tinvtax=\tRound ( (Sum ( dbo.AdvSaleDetail.looseqty * dbo.AdvSaleDetail.saleprice) \n\t\t\t\t\t\t\t\t\t -   Round(Sum (Round(( dbo.AdvSaleDetail.looseqty  * (dbo.AdvSaleDetail.saleprice - dbo.AdvSaleDetail.itemflatdisc) * (dbo.AdvSaleDetail.discperc * .01)) + (dbo.AdvSaleDetail.looseqty  * dbo.AdvSaleDetail.itemflatdisc),2)), 2) \n\t\t\t\t\t\t\t\t\t -  Sum (Round( dbo.AdvSaleDetail.looseqty   * (dbo.AdvSaleDetail.saleprice  - dbo.AdvSaleDetail.itemflatdisc) * (1 - (dbo.AdvSaleDetail.discperc * .01)),2)) * (dbo.AdvSaleLedger.discperc /100)\n\t\t\t\t\t\t\t\t\t - AdvSaleLedger.flatdisc ) * AdvSaleLedger.invgstperc1 * 0.01 , 2)\n\t\t\t\t\tFROM AdvSaleLedger,AdvSaleDetail\n\t\t\t\t\tWHERE ( dbo.AdvSaleLedger.AdvSaleInvCode = dbo.AdvSaleDetail.AdvSaleInvCode ) and \n\t\t\t\t\t\t\t( dbo.AdvSaleLedger.date between :ar_startdate and :ar_enddate) AND\n\t\t\t\t\t\t\t( dbo.AdvSaleLedger.machinename= :as_machinename )         \n\t\t\t\t\tGROUP BY dbo.AdvSaleLedger.misccharges,   \n\t\t\t\t\t\t\tdbo.AdvSaleLedger.flatdisc,   \n\t\t\t\t\t\t\tdbo.AdvSaleLedger.date,   \n\t\t\t\t\t\t\tdbo.AdvSaleLedger.AdvSaleInvCode,   \n\t\t\t\t\t\t\tdbo.AdvSaleLedger.discperc,  \n\t\t\t\t\t\t\tdbo.AdvSaleLedger.invgstperc1) as INV),\n\tAmountReceived = (select SUM( ISNULL(CashAmt, 0) + ISNULL(CreditAmt1, 0) + ISNULL(CreditAmt2, 0) + ISNULL(CreditAmt3, 0) ) \n\t\t from AdvSaleLedger\n\t\t where AdvSaleLedger.machinename=:as_machinename and\n\t\t\tAdvSaleLedger.date between :ar_startdate and :ar_enddate)\nFROM \n\tAdvSaleDetail SD,\n\tAdvSaleLedger SL,\n\tItem I, \n\tItemCategory IC\n\nWHERE \n\tSL.machinename= :as_machinename and\t \n\tSL.date between :ar_startdate and :ar_enddate and\n\tSL.AdvSaleInvCode=SD.AdvSaleInvCode and\n\tSD.icode=I.icode AND\n\tI.icatcode=IC.icatcode \nGROUP BY \n\tI.icatcode,\n\tIC.name\nUNION ALL\nSELECT   \n\tAllSale=IsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2))  ,0),\n\tCategory=IC.name,\n\tTotalDisc= (select sum(flatdisc)\n\t\t from Saleledger\n\t\t where saleledger.saleinvcode IN (SELECT ADL.SaleInvCode FROM AdvSaleLedger AD, AssocAdvSaleInvList ADL WHERE AD.MachineName = :as_machinename AND AD.AdvSaleInvCode = ADL.AdvSaleInvCode)),\n\tMiscCharg= ( select sum(misccharges) \n\t\t from saleledger\n\t\t where saleledger.saleinvcode IN (SELECT ADL.SaleInvCode FROM AdvSaleLedger AD, AssocAdvSaleInvList ADL WHERE AD.MachineName = :as_machinename AND AD.AdvSaleInvCode = ADL.AdvSaleInvCode)),\n\tTotalinvdiscperc= \n\t\t(select sum(ISNULL(B.invdiscperc,0))\n\t\tfrom\n\t\t\t(select invdiscperc = IsNull( sum(Round(((saledetail.looseqty + saledetail.packqty * saledetail.packunits) * (saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc)),2)) * 0.01 * saleledger.discperc, 0)\n\t\t\tfrom   saleledger, saledetail  \n\t\t\twhere\tsaleledger.saleinvcode IN (SELECT ADL.SaleInvCode FROM AdvSaleLedger AD, AssocAdvSaleInvList ADL WHERE AD.MachineName = :as_machinename AND AD.AdvSaleInvCode = ADL.AdvSaleInvCode) AND\n\t\t\t\t\tsaleledger.saleinvcode = saledetail.saleinvcode \n\t\t\tgroup by saleledger.saleinvcode, saleledger.discperc) as  B),\n\tRefundAmt = 0.00,\n\tdiff=(select sum ( ISNULL(A.rounddifference,0)) \n\t\tfrom\n\t\t\t(SELECT rounddifference= Round(Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice)\n\t\t\t\t\t\t- Round(Sum (Round(( dbo.saledetail.looseqty  * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01)) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc),2)), 2)\n\t\t\t\t\t\t- Sum ( Round(dbo.saledetail.looseqty   * (dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01)),2)) * (dbo.saleledger.discperc /100) \n\t\t\t\t\t\t+ dbo.saleledger.misccharges - saleledger.flatdisc,0)  \n\t\t\t\t\t\t-\n\t\t\t\t\t  (Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice)\n\t\t\t\t\t\t\t- Round(Sum (Round(( dbo.saledetail.looseqty  * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01)) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc),2)), 2)\n\t\t\t\t\t\t\t- Sum (Round( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01)),2)) * (dbo.saleledger.discperc /100)\n\t\t\t\t\t\t\t+ dbo.saleledger.misccharges - saleledger.flatdisc),\n\t\t\t\t\tnetammount= (Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice)\n\t\t\t\t\t\t- Round(Sum (Round(( dbo.saledetail.looseqty * \n\t\t\t\t\t\t(dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * \n\t\t\t\t\t\t(dbo.saledetail.discperc * .01)) + \n\t\t\t\t\t\t(dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc),2)), 2) + \n\t\t\t\t\t\tRound(Sum ( dbo.saledetail.looseqty   * \n\t\t\t\t\t\t\t(dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * \n\t\t\t\t\t\t\t(1 - (dbo.saledetail.discperc * .01))) * (dbo.saleledger.discperc /100), 2) - \n\t\t\t\t\t\t\tdbo.saleledger.flatdisc + dbo.saleledger.misccharges )\n\t\t\tFROM dbo.saleledger, dbo.saledetail\n\t\t\tWHERE \n\t\t\t\tsaleledger.saleinvcode IN (SELECT ADL.SaleInvCode FROM AdvSaleLedger AD, AssocAdvSaleInvList ADL WHERE AD.MachineName = :as_machinename AND AD.AdvSaleInvCode = ADL.AdvSaleInvCode) AND\n\t\t\t\tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode\n\t\t\tGROUP BY dbo.saleledger.misccharges, dbo.saleledger.flatdisc, \n\t\t\t\tdbo.saleledger.date, dbo.saleledger.saleinvcode,   \n\t\t\t\tdbo.saleledger.discperc, dbo.saleledger.salestax,\n\t\t\t\tdbo.saleledger.salecatcode) as A),\n\ttotaltax=(SELECT ISNULL( SUM(Round(INV.itemsalestax + invtax,0) ),0)\n\t\t\t\tFROM\n\t\t\t\t\t(Select itemsalestax = Sum (Round (dbo.saledetail.looseqty * dbo.saledetail.unitsalestax + Round ( Round (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc ) * (1 - dbo.saledetail.discperc * 0.01 ), 2 ) * dbo.saledetail.gstperc * 0.01 , 2 ) , 2 ) ),\n\t\t\t\t\t\t\t\tinvtax=\tRound ( (Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice) \n\t\t\t\t\t\t\t\t\t -   Round(Sum (Round(( dbo.saledetail.looseqty  * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01)) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc),2)), 2) \n\t\t\t\t\t\t\t\t\t -  Sum (Round( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01)),2)) * (dbo.saleledger.discperc /100)\n\t\t\t\t\t\t\t\t\t - saleledger.flatdisc ) * saleledger.invgstperc1 * 0.01 , 2)\n\t\t\t\t\tFROM saleledger,saledetail\n\t\t\t\t\tWHERE \tsaleledger.saleinvcode IN (SELECT ADL.SaleInvCode FROM AdvSaleLedger AD, AssocAdvSaleInvList ADL WHERE AD.MachineName = :as_machinename AND AD.AdvSaleInvCode = ADL.AdvSaleInvCode) and\n\t\t\t\t\t\t\tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode\n\t\t\t\t\tGROUP BY dbo.saleledger.misccharges,   \n\t\t\t\t\t\t\tdbo.saleledger.flatdisc,   \n\t\t\t\t\t\t\tdbo.saleledger.date,   \n\t\t\t\t\t\t\tdbo.saleledger.saleinvcode,   \n\t\t\t\t\t\t\tdbo.saleledger.discperc,  \n\t\t\t\t\t\t\tdbo.saleledger.salestax, \n\t\t\t\t\t\t\tdbo.saleledger.invgstperc1) as INV),\n\tAmountReceived = 0.00\nFROM \n\tSaleDetail SD,\n\tSaleLedger SL,\n\tAdvSaleLedger ASL,\n\tAssocAdvSaleInvList ASIL,\n\tItem I, \n\tItemCategory IC\nWHERE \n\tASL.machinename= :as_machinename and\t \n\tASL.date between :ar_startdate and :ar_enddate and\n\tASL.Advsaleinvcode=ASIL.Advsaleinvcode and\n\tASIL.SaleInvCode = SL.SaleInvCode AND\n\tSL.SaleInvCode = SD.SaleInvCode AND\n\tSD.icode=I.icode AND\n\tI.icatcode=IC.icatcode \nGROUP BY \n\tI.icatcode,\n\tIC.name) S\nGROUP BY \n\tCategory\nORDER BY\n\tCategory\n",
