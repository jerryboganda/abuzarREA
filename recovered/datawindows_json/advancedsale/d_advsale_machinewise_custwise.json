    "dbname": "Amount"
   }
  ],
  "retrieve": "SELECT\n\tType = S.Type,\n\tDetails = S.Details,\n\tAmount = ISNULL(SUM(S.Amount), 0)\nFROM\n(SELECT\n\tType=1,\n\tDetails = ' *** Actual Sales *** ',\n\tAmount=SUM(SL.InvTotal)\nFROM \n\tAdvSaleLedger SL\nWHERE \n\tSL.machinename = ISNULL(:as_machinename, SL.machinename) and\t \n\tSL.date between :ar_startdate and :ar_enddate\nUNION ALL\nSELECT  \n\tType=1,\n\tDetails = ' *** Associated Sales *** ',\n\tAmount=SUM(DBO.Fn_GetSaleInvTotal(AST.SaleInvCode))\nFROM \n\tAdvSaleLedger SL, AssocAdvSaleInvList AST\nWHERE \n\tSL.machinename = ISNULL(:as_machinename, SL.machinename) and\t \n\tSL.date between :ar_startdate and :ar_enddate AND\n\tSL.AdvSaleInvCode = AST.AdvSaleInvCode\n/*\nUNION ALL\nSELECT  \n\tType=1,\n\tDetails = ' *** Refund Amt *** ',\n\tAmount= - SUM(SL.RefundAmt)\nFROM \n\tAdvSaleLedger SL\nWHERE \n\tSL.machinename = ISNULL(:as_machinename, SL.machinename) and\t \n\tSL.date between :ar_startdate and :ar_enddate\n*/\nUNION ALL\nSELECT  \n\tType=2,\n\tDetails = (SELECT NAME FROM Accounts A WHERE AccCode IN \n\t\t\t\t\t(SELECT Code FROM Global WHERE Name='GT_CashAcc')),\n\tAmount=-SUM(SL.CashAmt)\nFROM \n\tAdvSaleLedger SL\nWHERE \n\tSL.machinename = ISNULL(:as_machinename, SL.machinename) and\t \n\tSL.date between :ar_startdate and :ar_enddate  AND\n\tSL.CashAmt <> 0\nUNION ALL\nSELECT  \n\tType=2,\n\tDetails = \n\t\t(SELECT NAME FROM CustomerCategory CC \n\t\tWHERE CC.CustCatCode IN\n\t\t\t(SELECT C.CustCatCode \n\t\t\tFROM Customer C \n\t\t\tWHERE C.CustCode = SL.Credit1acccode)),\n\tAmount=-SUM(SL.CreditAmt1)\nFROM \n\tAdvSaleLedger SL\nWHERE \n\tSL.machinename = ISNULL(:as_machinename, SL.machinename) and\t \n\tSL.date between :ar_startdate and :ar_enddate  AND\n\tSL.CreditAmt1 <> 0\nGROUP BY \n\tSL.Credit1acccode\nUNION ALL\nSELECT  \n\tType=2,\n\tDetails = \n\t\t(SELECT NAME FROM CustomerCategory CC \n\t\tWHERE CC.CustCatCode IN\n\t\t\t(SELECT C.CustCatCode \n\t\t\tFROM Customer C \n\t\t\tWHERE C.CustCode = SL.Credit2acccode)),\n\tAmount=-SUM(SL.CreditAmt2)\nFROM \n\tAdvSaleLedger SL\nWHERE \n\tSL.machinename = ISNULL(:as_machinename, SL.machinename) and\t \n\tSL.date between :ar_startdate and :ar_enddate  AND\n\tSL.CreditAmt2 <> 0\nGROUP BY \n\tSL.Credit2acccode\nUNION ALL\nSELECT  \n\tType=2,\n\tDetails = \n\t\t(SELECT NAME FROM CustomerCategory CC \n\t\tWHERE CC.CustCatCode IN\n\t\t\t(SELECT C.CustCatCode \n\t\t\tFROM Customer C \n\t\t\tWHERE C.CustCode = SL.Credit3acccode)),\n\tAmount=-SUM(SL.CreditAmt3)\nFROM \n\tAdvSaleLedger SL\nWHERE \n\tSL.machinename = ISNULL(:as_machinename, SL.machinename) and\t \n\tSL.date between :ar_startdate and :ar_enddate  AND\n\tSL.CreditAmt3 <> 0\nGROUP BY \n\tSL.Credit3acccode) S\nGROUP BY\n\tS.Type,\n\tS.Details\nORDER BY\n\tType,\n\tDetails\n",
  "arguments": {
