  "retrieve": "SELECT \n\titem.customicode, \n\titemname= item.name, \n\tlocksaleprice = dbo.item.locksaleprice,\n\tlockdiscperc = dbo.item.lockdiscperc,\n\tcurrlistrow = 0,\n\tstock     = 0.0000, \n\tQuickSearch=SPACE(100),\n\tpackingdesc=item.packingdesc,\n\tqtysale=item.saleqty,\n\tbonus=item.bonusqty,\n\ttotalstock= 0.0000, \n\tpurprice=0.00,\n\trecentpurprice=0.00, \n\tavgprice=0.000,\n\titemtotalval=space(30),\n\tassgcode  = 1, \n\tupdatesaleprice = 'N',\n\tAdvSaleDetail.AdvSaleInvCode,   \n\tAdvSaleDetail.icode,   \n\tAdvSaleDetail.gcode,\n\titemflatdisc = max(AdvSaleDetail.itemflatdisc),\n\tId        = max(AdvSaleDetail.IDENTITYCOL), \n\tpackunits = max(AdvSaleDetail.packunits),\n\tsaleprice = max(AdvSaleDetail.saleprice),\n\trate      = max(AdvSaleDetail.rate),\n\tDue       = max(Due),\n\tSatisfiedDate = max(SatisfiedDate),\n\tDueQty    = 0.0000,\n\tpackqty   = sum(AdvSaleDetail.packqty),\n\tSaleItemDescription =  max( AdvSaleDetail.SaleItemDescription),\n\tDescICode =  max( AdvSaleDetail.DescICode),\n\tclaimable=max(AdvSaleDetail.claimable),\n\tclaimablediscperc=max(AdvSaleDetail.claimablediscperc),\n\tdiscperc  = max(AdvSaleDetail.discperc),\n\titemcode = 0,\n\trowgroup=AdvSaleDetail.rowgroup,\n\tretailprice=item.retailprice,\n\tpackprice = max(AdvSaleDetail.packprice),\n\tpurunitrate = max(AdvSaleDetail.purunitrate),\n\trppunitrate = max(AdvSaleDetail.rppunitrate),\n\tunitsalestax=max(AdvSaleDetail.unitsalestax),\n\tgstperc=max(AdvSaleDetail.gstperc),\n\tpackqtyforsale = Max(AdvSaleDetail.packqtyforsale) , \n\tbonuspackqtyforsale = Max(AdvSaleDetail.bonuspackqtyforsale),\n\tbonusqty=sum (AdvSaleDetail.bonusqty),\n\tlooseqty  = sum(AdvSaleDetail.looseqty) \n\nFROM \n\tAdvSaleDetail, \n\titem \n\nWHERE \n\t( dbo.AdvSaleDetail.AdvSaleInvCode = :ar_AdvSaleInvCode )    AND\n\t( AdvSaleDetail.icode = item.icode )\n         \nGROUP BY \n\tAdvSaleDetail.AdvSaleInvCode, \n\tAdvSaleDetail.icode, \n\tAdvSaleDetail.RowGroup,\n\tAdvSaleDetail.gcode, \n\titem.customicode, \n\titem.saleqty, \n\titem.bonusqty, \n\titem.name,\n\titem.locksaleprice,\n\titem.lockdiscperc,\n\titem.retailprice,\n\titem.packingdesc\n\nORDER BY \n\tMIN(AdvSaleDetail.IDENTITYCOL)",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_AdvSaleInvCode",
      "number"
     ]
    }
   ]
  },
