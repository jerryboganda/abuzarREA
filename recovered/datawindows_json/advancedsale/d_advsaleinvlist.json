  "retrieve": "SELECT\n\tCode=AdvSaleLedger.AdvSaleInvCode , \n\tDate=AdvSaleLedger.date , \n\theaderno= AdvSaleLedger.headerno,\n\theaderinvno = AdvSaleLedger.headerinvno,\n\tcustrefno = AdvSaleLedger.custrefno, \n\tcustrefno2 = AdvSaleLedger.custrefno2, \n\tcustrefno3 = AdvSaleLedger.custrefno3, \n\tremarks  = AdvSaleLedger.remarks, \n\taccounts.name, \n\tusers.username, \n\tposted = AdvSaleLedger.posted,\n\tPostedBy = IsNull((Select username from users \n\t\t\t\t\t\t\t\twhere dbo.AdvSaleLedger.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\t\t\t\t\t\t\twhere dbo.AdvSaleLedger.modifiedby = dbo.users.usercode), ''),\n\tNetAmount = AdvSaleLedger.invtotal,\n\tReprintingCounter = dbo.AdvSaleLedger.ReprintingCounter,\n\tOriginalDate = dbo.AdvSaleLedger.OriginalDate,\n\tModifyCounter = dbo.AdvSaleLedger.ModifyCounter,\n\tDeleted = dbo.AdvSaleLedger.Deleted\nFROM  \n\taccounts, AdvSaleLedger, users\nWHERE\t\t \n\t AdvSaleLedger.custcode = accounts.acccode AND\n\t dbo.AdvSaleLedger.salecatcode IN (:ai_salecatcode) AND\n\t dbo.AdvSaleLedger.salesmancode = dbo.users.usercode AND\n\t dbo.AdvSaleLedger.date > :ad_invdate AND\n\t Posted IN (:as_Posted) AND\n\t:as_showrows='Y'  AND \n\t(dbo.AdvSaleLedger.headerno IS NULL OR\n\tdbo.AdvSaleLedger.headerno IN\n\t\t(SELECT headercode FROM GroupAllowedHeader \n\t\tWHERE GroupCode = :ai_groupcode AND\n\t\tmodule = :ai_module)) AND\n\tExists (Select DBO.Fn_GetPreference('AllowedGroupsInSalesList') Where DBO.Fn_GetPreference('AllowedGroupsInSalesList') = 'N' )\nUnion All\nSELECT\t\n\tCode=AdvSaleLedger.AdvSaleInvCode , \n\tdate=AdvSaleLedger.date , \n\theaderno=AdvSaleLedger.headerno,\n\theaderinvno = AdvSaleLedger.headerinvno,\n\tcustrefno = AdvSaleLedger.custrefno, \n\tcustrefno2 = AdvSaleLedger.custrefno2, \n\tcustrefno3 = AdvSaleLedger.custrefno3, \n\tremarks = AdvSaleLedger.remarks , \n\taccounts.name,\n\tusers.username, \n\tposted = AdvSaleLedger.posted,\n\tPostedBy = IsNull((Select username from users \n\t\t\t\t\t\t\t\twhere dbo.AdvSaleLedger.postedby = dbo.users.usercode), ''),\n\tModifiedBy = IsNull((Select username from users \n\t\t\t\t\t\t\t\twhere dbo.AdvSaleLedger.modifiedby = dbo.users.usercode), ''),\n\tNetAmount = AdvSaleLedger.invtotal,\n\tReprintingCounter = dbo.AdvSaleLedger.ReprintingCounter,\n\tOriginalDate = dbo.AdvSaleLedger.OriginalDate,\n\tModifyCounter = dbo.AdvSaleLedger.ModifyCounter,\n\tDeleted = dbo.AdvSaleLedger.Deleted\nFROM\n\taccounts, AdvSaleLedger, users\nWHERE\n\tAdvSaleLedger.custcode = accounts.acccode AND\n\tdbo.AdvSaleLedger.salecatcode IN (:ai_salecatcode) AND\n\tdbo.AdvSaleLedger.salesmancode = dbo.users.usercode AND\n\tdbo.AdvSaleLedger.date > :ad_invdate AND\n\tPosted IN (:as_Posted) AND\n\t:as_showrows='Y'  AND \n\t(dbo.AdvSaleLedger.headerno IS NULL OR\n\tdbo.AdvSaleLedger.headerno IN\n\t\t(SELECT headercode FROM GroupAllowedHeader \n\t\tWHERE GroupCode = :ai_groupcode AND module = :ai_module)) AND\n\tAdvSaleLedger.salesmancode IN (\n\t\tSelect \tDistinct U.usercode\n\t\tFrom   \tUsers U, UserGroups UG, GroupAllowedGroups GAG\n\t\tWhere  \tU.UserCode = UG.UserCode And UG.GroupCode = GAG.AllowedGroupCode And \n\t\t\t\t\tGAG.GroupCode = :ai_groupcode And GAG.Module = :ai_module\n\t\tUnion \n\t\tSelect   U.Usercode\n\t\tFrom     Users U, UserGroups UG\n\t\tWhere    U.usercode = UG.usercode And UG.GroupCode = :ai_groupcode\n\t\t\n\t  ) And\n\tExists (Select DBO.Fn_GetPreference('AllowedGroupsInSalesList') Where DBO.Fn_GetPreference('AllowedGroupsInSalesList') = 'Y' )\n\nORDER BY \n\tAdvSaleLedger.AdvSaleInvCode",
