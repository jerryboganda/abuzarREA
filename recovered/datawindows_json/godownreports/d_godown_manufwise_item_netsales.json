    "updatewhereclause": "yes",
    "name": "saleamount",
    "dbname": "SaleAmount"
   },
   {
    "type": "decimal(9)",
    "updatewhereclause": "yes",
    "name": "itemcost",
    "dbname": "ItemCost"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "margin",
    "dbname": "Margin"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "bonus",
    "dbname": "Bonus"
   }
  ],
  "retrieve": "SELECT \n\tGodown= (SELECT Godown.Name FROM Godown WHERE Godown.GCode = :ar_gcode),\n\tI.ManfCode,\n\tManufacturer=M.Name,\n\tI.ICode,\n\tItemName=I.Name,\n\tQty=ISNULL(sum(D.saleqty), 0),\n \tSaleAmount=ISNULL(sum(D.salevalue), 0),\n\tItemCost=ISNULL(sum(D.itemcost), 0),\n\tMargin=ISNULL((sum(D.salevalue) - sum(D.itemcost) ) * 100 / \n\t\t\tCase sum(D.salevalue) WHEN 0 THEN 1 ELSE sum(D.salevalue) END, 0),\n\tBonus=ISNULL(sum(D.bonus), 0)\nFROM\n\tManufacturer M, \n\tItem I\n\tLEFT OUTER JOIN \n \t(SELECT saleqty=ISNULL(sum(SD.looseqty), 0),\n\t\t\t\tbonus=ISNULL(sum(SD.bonusqty), 0) ,\n\t\t\t\tsalevalue=ISNULL(round(sum((SD.looseqty * (SD.saleprice - itemflatdisc)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01), 2), 0),\n\t        \tI.ICode,\n\t        \titemcost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)), 2), 0)\n\tFROM\t\tsaleledger SL,\n\t\t\t\tsaledetail SD,\n\t\t\t\titem I\n\tWHERE\t\tSD.icode=I.icode AND\n\t\t\t\tI.manfcode IN (:ala_manfcode) AND\n\t\t\t\tSD.saleinvcode=SL.saleinvcode AND\n\t\t\t\tSD.GCode = :ar_gcode AND\n\t\t\t\tSL.date BETWEEN :adt_sdate AND :adt_ldate AND\n\t\t\t\tSL.SaleCatCode IN (:ala_saletype)\n\tGROUP BY \n\t         SD.icode,\n\t\t \t\tI.ICode,\n\t         SL.saleinvcode,\n\t         SL.discperc\n\tUNION ALL\n\tSELECT\tsaleqty=-ISNULL(sum(SD.looseqty), 0) ,\n\t\t\t\tbonus=-ISNULL(sum(SD.bonusqty), 0) ,\n\t\t\t\tsalevalue=-ISNULL(round(sum((SD.looseqty * (SD.srprice)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01), 2), 0),\n\t\t\t\tI.ICode,\n\t\t\t\titemcost=-ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)), 2), 0)\n\tFROM\t\tsrledger SL,\n\t\t\t\tsrdetail SD,\n\t\t\t\titem I\n\tWHERE\t\tSD.icode=I.icode AND\n\t\t\t\tI.manfcode IN (:ala_manfcode) AND\n\t\t\t\tSD.srinvcode=SL.srinvcode AND\n\t\t\t\tSD.GCode = :ar_gcode AND\n\t\t\t\tSL.date BETWEEN :adt_sdate AND :adt_ldate AND\n\t\t\t\tSL.SRCatCode IN (:ala_saletype)\n\tGROUP BY\n\t\t\t\tSD.icode,\n\t\t\t\tI.ICode,\n\t\t\t\tSL.srinvcode,\n\t\t\t\tSL.discperc) AS D ON (\tI.ICode = D.ICode)\nWHERE \n\tI.manfcode IN (:ala_manfcode) AND\n\tI.ManfCode = M.ManfCode\nGROUP BY\n\tI.ManfCode,\n\tM.Name,\n\tI.ICode,\n\tI.name\nORDER BY\n\tM.Name,\n\tI.name\n\n",
  "arguments": {
