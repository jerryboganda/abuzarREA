    "dbname": "PackUnits"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "qty",
    "dbname": "QTY"
   },
   {
    "type": "char(50)",
    "updatewhereclause": "yes",
    "name": "packingdesc",
    "dbname": "PackingDesc"
   },
   {
    "type": "decimal(13)",
    "updatewhereclause": "yes",
    "name": "unitprice",
    "dbname": "UnitPrice"
   }
  ],
  "retrieve": "SELECT  \n\tGodown=Godown.Name, \n\tStockTypeMark = \n\t\tCASE \n\t\t\tWHEN ISNULL(Item.OptimumQty, 0) > ISNULL(GD.Qty, 0) THEN 1 \n\t\t\tWHEN ISNULL(Item.OptimumQty, 0) < ISNULL(GD.Qty, 0) THEN 2\n\t\tEND,\n\tStockType = \n\t\tCASE \n\t\t\tWHEN ISNULL(Item.OptimumQty, 0) > ISNULL(GD.Qty, 0) THEN 'Items To Be Invoiced' \n\t\t\tWHEN ISNULL(Item.OptimumQty, 0) < ISNULL(GD.Qty, 0) THEN 'Items Over Invoiced'\n\t\tEND,\n\tItem.Name,  \n\taliasname=item.customicode, \n\tactive=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,\n\tItem.purprice,   \n\tItem.PackUnits,   \n\tQTY = \t\t\n\t\tCASE \n\t\t\tWHEN ISNULL(Item.OptimumQty, 0) > ISNULL(GD.Qty, 0) THEN ISNULL(Item.OptimumQty, 0) - ISNULL(GD.Qty, 0)\n\t\t\tWHEN ISNULL(Item.OptimumQty, 0) < ISNULL(GD.Qty, 0) THEN ISNULL(GD.Qty, 0) - ISNULL(Item.OptimumQty, 0)\n\t\tEND,\n\tPackingDesc=item.PackingDesc, \n\tUnitPrice = Round(Item.saleprice /(case Item.PackUnits when 0 then 1 else item.packunits end), 2)\nFROM \n\t(SELECT GD.GCode, GD.ICode, Qty = ISNULL(SUM(GD.CurrQty), 0)\n\tFROM GodownDetail GD \n\tWHERE GD.GCode IN (:ai_godown)\n\tGROUP BY GD.GCode, GD.ICode) GD,\n\tGodown,\n\tItem\nWHERE \n\tGodown.GCode IN (:ai_godown) AND\n\tGodown.GCode = GD.GCode AND\n\tItem.ICode = GD.ICode and  \n\tItem.active=1 and\n\tItem.OptimumQty <> GD.Qty\nGROUP BY \n\tGodown.Name,\n\tItem.name,\n\titem.customicode, \n\tItem.Active,\n\tItem.purprice, \n\tItem.PackUnits, \n\tItem.PackingDesc,\n\tItem.SalePrice,\n\tItem.PurPrice,\n\tItem.AvgPrice,\n\tItem.OptimumQty,\n\tGD.Qty\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_godown",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "godown A, stocktype A, item_name A"
 },
