    "name": "customer",
    "dbname": "customer"
   }
  ],
  "retrieve": "SELECT itemname = item.name,\n\t\tmanufacturer=(select name from manufacturer where manufacturer.manfcode=Max(Item.manfcode)),\n\t\t looseqty = Sum (dbo.saledetail.looseqty),\n\t\t price = Max (dbo.saledetail.saleprice),\n\t\twardname=(select name from ward where ward.wardcode=saleledger.wardcode),\n\t\tcustomer=(select name from accounts where accounts.acccode=:al_custcode)\nFROM \t dbo.saleledger, \n\t\t dbo.saledetail,    \n\t\t dbo.item\n\nWHERE  CASE lower(:as_datetype) \n\t\t \tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate\n  \t\t End Between :ad_startdate AND :ad_enddate AND\n\t\t dbo.saleledger.custcode=:al_custcode AND\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t dbo.saleledger.wardcode IN (:al_wardcode) AND\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t\t dbo.saledetail.icode = item.icode \n\nGroup by \n\t\tdbo.saleledger.wardcode,\n\t\tdbo.saledetail.icode,\n\t\tdbo.item.name\nUNION ALL\nSELECT itemname = item.name,\n\t\tmanufacturer=(select name from manufacturer where manufacturer.manfcode=Max(Item.manfcode)),\n\t\t looseqty = Sum (sd.looseqty),\n\t\t price = Max (sd.saleprice),\n\t\twardname=(select name from ward where ward.wardcode=saleledger.wardcode),\n\t\tcustomer=(select name from accounts where accounts.acccode=:al_custcode)\n\t\t  \nFROM \t dbo.saleledger, \n\t\t dbo.saleinvdetail sd,    \n\t\t dbo.item\n\nWHERE  CASE lower(:as_datetype) \n\t\t \tWhen 'originaldate' Then dbo.saleledger.originaldate \n\t\t\tWhen 'lastsavingdate' Then dbo.saleledger.date\n\t\t\tWhen 'billingdate' Then dbo.saleledger.billingdate\n  \t\t End Between :ad_startdate AND :ad_enddate AND\n\t\t  dbo.saleledger.custcode=:al_custcode AND\n\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t dbo.saleledger.wardcode IN (:al_wardcode) AND\n\t\t dbo.saleledger.saleinvcode = sd.saleinvcode AND\n\t\t sd.icode = item.icode \n\nGroup by \n\t\tdbo.saleledger.wardcode,\n\t\tsd.icode,\n\t\tdbo.item.name\nOrder by wardname,\n\t\t     itemname\n\n\n\n\n",
