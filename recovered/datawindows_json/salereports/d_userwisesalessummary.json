  "retrieve": "SELECT\n\tReportType = S.ReportType,\n\tUserCode = S.UserCode,\n\tUserName = (SELECT U.UserName FROM Users U WHERE U.UserCode = S.UserCode),\n\tAccount = (SELECT A.Name FROM Accounts A WHERE A.AccCode = S.AccCode),\n\tSales = SUM(S.Sales),\n\tCashAmount = SUM(S.CashAmt),\n\tCreditAmount = SUM(S.CreditAmt),\n\tCashReturn = SUM(S.CashReturn),\n\tCreditReturn = SUM(S.CreditReturn) \nFROM\n\t(SELECT \n\t\tReportType=1,\n\t\tUserCode = NULL,\n\t\tAccCode=S.CashAccCode, \n\t\tSales = SUM(S.InvTotal),\n\t\tCashAmt = 0.00,\n\t\tCreditAmt = 0.00,\n\t\tCashReturn= 0.00,\n\t\tCreditReturn=0.00\n\tFROM \n\t\tSaleLedger S\n\tWHERE\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate \n\tGROUP BY\n\t\tS.CashAccCode\n\tUNION ALL\n\tSELECT \n\t\tReportType=1,\n\t\tUserCode = NULL,\n\t\tAccCode=S.CashAccCode, \n\t\tSales = 0.00,\n\t\tCashAmt = SUM(CASE S.SaleCatCode WHEN 3 THEN S.CashCharged ELSE 0 END),\n\t\tCreditAmt = SUM(CASE S.SaleCatCode WHEN 3 THEN 0 ELSE S.CashCharged END),\n\t\tCashReturn= 0.00,\n\t\tCreditReturn=0.00\n\tFROM \n\t\tSaleLedger S\n\tWHERE\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate \n\tGROUP BY\n\t\tS.CashAccCode\n\tUNION ALL\n\tSELECT \n\t\tReportType=1,\n\t\tUserCode = NULL,\n\t\tAccCode=C.AccCode, \n\t\tSales = 0.00,\n\t\tCashAmt = SUM(CASE T.SaleCatCode WHEN 3 THEN C.Amount ELSE 0 END),\n\t\tCreditAmt = SUM(CASE T.SaleCatCode WHEN 3 THEN 0 ELSE C.Amount END),\n\t\tCashReturn= 0.00,\n\t\tCreditReturn=0.00\n\tFROM \n\t\tCashierWindow C, (SELECT S.SaleInvCode, S.SaleCatCode FROM SaleLedger S WHERE S.Date BETWEEN :adt_startdate AND :adt_enddate) T\n\tWHERE \n\t\tC.SaleInvCode = T.SaleInvCode\n\tGROUP BY\n\t\tC.AccCode\n\tUNION ALL\n\tSELECT \n\t\tReportType=1,\n\t\tUserCode = NULL,\n\t\tAccCode=S.CashAccCode, \n\t\tSales = 0.00,\n\t\tCashAmt = 0.00,\n\t\tCreditAmt = 0.00,\n\t\tCashReturn= SUM(CASE S.SRCatCode WHEN 8 THEN S.InvTotal ELSE 0.00 END),\n\t\tCreditReturn= SUM(CASE S.SRCatCode WHEN 8 THEN 0.00 ELSE S.InvTotal END)\n\tFROM \n\t\tSRLedger S\n\tWHERE\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate \n\tGROUP BY\n\t\tS.CashAccCode\n\tUNION ALL\n\tSELECT \n\t\tReportType=2,\n\t\tUserCode = S.Salesmancode,\n\t\tAccCode=S.CashAccCode, \n\t\tSales = SUM(S.InvTotal),\n\t\tCashAmt = SUM(CASE S.SaleCatCode WHEN 3 THEN S.CashCharged ELSE 0 END),\n\t\tCreditAmt = SUM(CASE S.SaleCatCode WHEN 3 THEN 0 ELSE S.CashCharged END),\n\t\tCashReturn= 0.00,\n\t\tCreditReturn=0.00\n\tFROM \n\t\tSaleLedger S\n\tWHERE\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate \n\tGROUP BY\n\t\tS.Salesmancode,\n\t\tS.CashAccCode\n\tUNION ALL\n\tSELECT \n\t\tReportType=2,\n\t\tUserCode = T.Salesmancode,\n\t\tAccCode=C.AccCode, \n\t\tSales = 0.00,\n\t\tCashAmt = SUM(CASE T.SaleCatCode WHEN 3 THEN C.Amount ELSE 0 END),\n\t\tCreditAmt = SUM(CASE T.SaleCatCode WHEN 3 THEN 0 ELSE C.Amount END),\n\t\tCashReturn= 0.00,\n\t\tCreditReturn=0.00\n\tFROM \n\t\tCashierWindow C, (SELECT S.SaleInvCode, S.Salesmancode, S.SaleCatCode FROM SaleLedger S WHERE S.Date BETWEEN :adt_startdate AND :adt_enddate) T\n\tWHERE \n\t\tC.SaleInvCode = T.SaleInvCode\n\tGROUP BY\n\t\tT.Salesmancode,\n\t\tC.AccCode\n\tUNION ALL\n\tSELECT \n\t\tReportType=2,\n\t\tUserCode = S.Salesmancode,\n\t\tAccCode=S.CashAccCode, \n\t\tSales = 0.00,\n\t\tCashAmt = 0.00,\n\t\tCreditAmt = 0.00,\n\t\tCashReturn= SUM(CASE S.SRCatCode WHEN 8 THEN S.InvTotal ELSE 0.00 END),\n\t\tCreditReturn= SUM(CASE S.SRCatCode WHEN 8 THEN 0.00 ELSE S.InvTotal END)\n\tFROM \n\t\tSRLedger S\n\tWHERE\n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate \n\tGROUP BY\n\t\tS.Salesmancode,\n\t\tS.CashAccCode) S\nGROUP BY\n\tS.ReportType,\n\tS.UserCode,\n\tS.AccCode\nORDER BY\n\tReportType, UserName, Account\n\t",
  "arguments": {
