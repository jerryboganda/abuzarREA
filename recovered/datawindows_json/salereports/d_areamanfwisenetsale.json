    "dbname": "manufacturer"
   }
  ],
  "retrieve": "SELECT netsale=isnull(sum(saleamount),0), \n\t\tzone=(select name from zone where zonecode=:ar_zonecode),\n\t\tareaname=(select name from area where areacode=zoneareas.areacode),\n\t\tcustomer=(select name from accounts where acccode=customer.custcode),\n\t\tcustomeradd1=max(customer.address1),\n\t\tcustomeradd2=max(customer.address2),\n\t\tcustomercity=max(customer.city),\n\t\tmanufacturer=(select name from manufacturer where manfcode=:ar_manfcode)\nFROM\n\n\tzoneareas,\n\tcustomer \n\tLEFT OUTER JOIN \n\t(\n\t\tSELECT  \n\t\t\tcustcode=SL.custcode,\n\t\t\tsaleamount=(IsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2) * (1 - SL.discperc*0.01))  ,0))\n\t\tFROM\n         saleledger SL,\n    \t\tsaledetail SD\n\t\tWHERE\n\t\t\tSL.date>= :ar_sdate and SL.date<=:ar_ldate and\n\t\t\tSL.saleinvcode=SD.saleinvcode and\n\t\t\tSD.icode IN (select icode from item where manfcode=:ar_manfcode)\n\t\tGroup by \n\t\t\tSL.custcode,\n\t\t\tSL.saleinvcode\n\nUNION ALL\n\n\t\tSELECT  \n\t\t\tcustcode=SL.custcode,\n\t\t\tsaleamount=(IsNull( sum(round(((SD.looseqty * SD.packunits) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2) * (1 - SL.discperc*0.01))  ,0))\n\t\tFROM\n         saleledger SL,\n    \t\tsaleinvdetail SD\n\t\tWHERE\n\t\t\tSL.ImpactInventory = 'N' AND\n\t\t\tSL.date>= :ar_sdate and SL.date<=:ar_ldate and\n\t\t\tSL.saleinvcode=SD.saleinvcode and\n\t\t\tSD.icode IN (select icode from item where manfcode=:ar_manfcode)\n\t\tGroup by \n\t\t\tSL.custcode,\n\t\t\tSL.saleinvcode\n\nUNION ALL\n\n\tSELECT  \n\t\tcustcode=SL.custcode,\n\t\tsaleamount= (- 1)*(IsNull( sum(round(SD.srprice * ((SD.looseqty + SD.packqty * SD.packunits) - (.01 *  SD.discperc)),2)*(1 - SL.discperc*0.01))  ,0))\n\n\tFROM\n    \tsrledger SL,\n    \tsrdetail SD\n\tWHERE\n\t\tSL.date>= :ar_sdate and SL.date<=:ar_ldate and\n\t\tSL.srinvcode=SD.srinvcode and\n\t\tSD.icode IN (select icode from item where manfcode=:ar_manfcode)\n\n\tGroup by \n\t\tSL.custcode,\n\t\tSL.srinvcode\n\t) AS A ON (customer.custcode=A.custcode)\n\nWHERE\n\tzoneareas.zonecode=:ar_zonecode and\n\tzoneareas.areacode=customer.areacode \nGroup By\n\tzoneareas.zonecode,\n\tzoneareas.areacode,\n\tcustomer.custcode\nOrder By\n\tareaname,\n\tcustomer",
  "arguments": {
