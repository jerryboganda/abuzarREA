  "retrieve": "SELECT\n\tSaleDate = datepart(hour, date),  \n\tInvCount= count(distinct saleinvcode) , \n\tSaleValue=sum(netamount),\n\tSaleCatgory = SaleType \nFROM\n\t(SELECT\n\t\tdate= S.date,\n\t\tS.saleinvcode,\n\t        SaleType = Case S.salecatcode \n\t\t\t\tWhen 1 Then 'Cash' \n\t\t\t\tWhen 2 Then 'Credit' \n\t\t\t\tElse 'Cash' End, \n\t\tNetAmount=Round(SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + \n\t\t\t\tSUM(ROUND( (D.looseqty * (D.saleprice - D.itemflatdisc)) *\n\t\t\t\t(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +\n\t\t\t\tROUND( (SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) -\n\t\t\t\t\tS.flatdisc) * (S.invgstperc1 * .01), 2), 0) +\n\t\t\t\tRound(SUM((D.looseqty*(D.saleprice - D.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) + \n\t\t\t\t\tS.misccharges + S.salestax - S.flatdisc, 0)\n\tFROM \n\t\tdbo.saleledger S, \n\t\tdbo.saledetail D\n\tWHERE\n\t\tS.saleinvcode = D.saleinvcode and\n\t\tS.date between :ad_StartDate and :ad_EndDate\n\tGROUP BY S.saleinvcode,\n\t\t S.salecatcode,\n\t\t S.date,\n\t\t S.discperc,\n\t\t S.misccharges,\n\t\t S.salestax,\n\t\t S.flatdisc,\n\t\t S.invgstperc1,\n\t\t S.salesmancode\n\tUNION ALL\n\tSELECT\n\t\tdate= S.date,\n\t\tS.saleinvcode,\n\t        SaleType = Case S.salecatcode \n\t\t\t\tWhen 1 Then 'Cash' \n\t\t\t\tWhen 2 Then 'Credit' \n\t\t\t\tElse 'Cash' End, \n\t\tNetAmount=Round(SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + \n\t\t\t\tSUM(ROUND( (D.looseqty * (D.saleprice - D.itemflatdisc)) *\n\t\t\t\t(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +\n\t\t\t\tROUND( (SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) -\n\t\t\t\t\tS.flatdisc) * (S.invgstperc1 * .01), 2), 0) +\n\t\t\t\tRound(SUM((D.looseqty*(D.saleprice - D.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) + \n\t\t\t\t\tS.misccharges + S.salestax - S.flatdisc, 0)\n\tFROM \n\t\tdbo.saleledger S, \n\t\tdbo.saleinvdetail D\n\tWHERE\n\t\tS.impactinventory = 'N' AND\n\t\tS.saleinvcode = D.saleinvcode and\n\t\tS.date between :ad_StartDate and :ad_EndDate\n\tGROUP BY S.saleinvcode,\n\t\t S.salecatcode,\n\t\t S.date,\n\t\t S.discperc,\n\t\t S.misccharges,\n\t\t S.salestax,\n\t\t S.flatdisc,\n\t\t S.invgstperc1,\n\t\t S.salesmancode) AS a\nGROUP BY\n\tdatepart(hour, date),\n\tSaleType\nORDER BY \n\tdatepart(hour, date),\n\tSaleType",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
