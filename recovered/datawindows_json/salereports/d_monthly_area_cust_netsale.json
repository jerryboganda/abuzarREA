    "updatewhereclause": "yes",
    "name": "amount",
    "dbname": "amount"
   }
  ],
  "retrieve": "SELECT\n\tArea=(SELECT SA.Name FROM Area SA WHERE SA.AreaCode = S.AreaCode),\n\tAliasName=A.AliasName,\n\tCustomerName=A.Name,\n\tSaleMonth = CAST(RTRIM(LTRIM(STR(DATEPART(MONTH, S.DATE)))) + '/01/' + LTRIM(RTRIM(STR(DATENAME(YEAR, S.DATE), 4))) AS DATETIME),\n\tAmount=SUM(Amount)\nFROM\n\tAccounts A,\n\t(SELECT \n\t\tAreaCode=C.AreaCode,\n\t\tS.CustCode,\n\t\tAmount=SUM(S.InvTotal),\n\t\tDate=CONVERT(VARCHAR(15), S.Date, 101)\n\tFROM \n\t\tSaleLedger S, Customer C\n\tWHERE\n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.CustCode = C.CustCode AND\n\t\tC.AreaCode IN (:ai_areacode)\n\tGROUP BY\n\t\tS.CustCode,\n\t\tC.AreaCode,\n\t\tS.Date\n\tUNION ALL\n\tSELECT \n\t\tAreaCode=C.AreaCode,\n\t\tS.CustCode,\n\t\tAmount= - SUM(S.InvTotal),\n\t\tDate=CONVERT(VARCHAR(15), S.Date, 101)\n\tFROM \n\t\tSRLedger S, Customer C\n\tWHERE\n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.CustCode = C.CustCode AND\n\t\tC.AreaCode IN (:ai_areacode)\n\tGROUP BY\n\t\tS.CustCode,\n\t\tC.AreaCode,\n\t\tS.Date) S\nWHERE\n\tS.CustCode = A.AccCode\nGROUP BY\n\tS.AreaCode,\n\tA.AliasName,\n\tA.Name,\n\tS.DATE\nORDER BY\n\tArea,\n\tCustomerName,\n\tAliasName\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_areacode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  },
  "sort": "area A, aliasname A, customername A"
 },
