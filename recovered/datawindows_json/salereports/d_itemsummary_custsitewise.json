    "name": "srqty",
    "dbname": "srqty"
   },
   {
    "type": "decimal(6)",
    "updatewhereclause": "yes",
    "name": "sramount",
    "dbname": "sramount"
   }
  ],
  "retrieve": "SELECT patient = (SELECT name FROM patient WHERE patientcode = :ai_patientcode ),\n\t\t regno = (SELECT regno FROM patient WHERE patientcode = :ai_patientcode ),\n\t\t a.itemname, \n\t\t qty =  ISNULL(SUM (CASE type When 'S' THEN ISNULL(Looseqty,0) END) , 0 ) ,\n\t\t amount = ISNULL(SUM (CASE type When 'S' THEN ISNULL(Amount,0)  END),  0 ) , \n\t\t srqty =  ISNULL(SUM (CASE type When 'R' THEN ISNULL(Looseqty,0) END) , 0 ) ,\n\t\t sramount = ISNULL(SUM (CASE type When 'R' THEN ISNULL(Amount,0)  END) , 0)\nFROM\n(\nSELECT \n\t\t type = 'S' ,\n       looseqty=saledetail.looseqty,\n       amount=( ( saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)),\n       itemname=item.name\n\nFROM \t dbo.saleledger, \n\t\t dbo.saledetail,    \n\t\t dbo.item \n\nWHERE  dbo.saleledger.date >= :ad_startdate AND\n\t\t dbo.saleledger.date <= :ad_enddate  AND\n\t\t dbo.saleledger.patientcode = :ai_patientcode AND\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND  \n\t\t dbo.saledetail.icode = item.icode \n\nUNION ALL\n\nSELECT \n\t\t type = 'S' ,\n       looseqty=sd.looseqty,\n       amount=( ( sd.looseqty * (sd.saleprice - sd.itemflatdisc)) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)),\n       itemname=item.name\n\nFROM \t dbo.saleledger, \n\t\t dbo.saleinvdetail sd,    \n\t\t dbo.item \n\nWHERE  DBO.SaleLedger.impactinventory = 'N' AND \n\t\t dbo.saleledger.date >= :ad_startdate AND\n\t\t dbo.saleledger.date <= :ad_enddate  AND\n\t\t dbo.saleledger.patientcode = :ai_patientcode AND\n\t\t dbo.saleledger.saleinvcode = sd.saleinvcode AND  \n\t\t sd.icode = item.icode \n\nUNION ALL\n\nSELECT \n\t\t type = 'R' ,\n\t\t looseqty= srdetail.looseqty,\n       amount=( ( srdetail.looseqty * srdetail.srprice ) * (1 - (.01 * srdetail.discperc) )  ) * (1- (.01 * srledger.discperc)),\n       itemname = item.name\nFROM \t dbo.srledger, \n\t\t dbo.srdetail,    \n\t\t dbo.item \nWHERE  dbo.srledger.date >= :ad_startdate AND\n\t\t dbo.srledger.date <= :ad_enddate  AND\n\t\t dbo.srledger.patientcode = :ai_patientcode AND\n\t\t dbo.srledger.srinvcode = dbo.srdetail.srinvcode AND  \n\t\t dbo.srdetail.icode = item.icode \n\n) AS A\n\nGROUP BY itemname",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_StartDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_EndDate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_patientcode",
      "number"
     ]
    }
   ]
  }
 },
