  "retrieve": "SELECT\n\tGroupCode,\n\tGroupName, \n\tItem1 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode1),\n\tQty1 = SUM(CASE ICode WHEN :ai_icode1 THEN Qty ELSE 0 END),\n\tItem2 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode2),\n\tQty2 = SUM(CASE ICode WHEN :ai_icode2 THEN Qty ELSE 0 END),\n\tItem3 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode3),\n\tQty3 = SUM(CASE ICode WHEN :ai_icode3 THEN Qty ELSE 0 END),\n\tItem4 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode4),\n\tQty4 = SUM(CASE ICode WHEN :ai_icode4 THEN Qty ELSE 0 END),\n\tItem5 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode5),\n\tQty5 = SUM(CASE ICode WHEN :ai_icode5 THEN Qty ELSE 0 END),\n\tItem6 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode6),\n\tQty6 = SUM(CASE ICode WHEN :ai_icode6 THEN Qty ELSE 0 END),\n\tItem7 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode7),\n\tQty7 = SUM(CASE ICode WHEN :ai_icode7 THEN Qty ELSE 0 END),\n\tItem8 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode8),\n\tQty8 = SUM(CASE ICode WHEN :ai_icode8 THEN Qty ELSE 0 END),\n\tItem9 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode9),\n\tQty9 = SUM(CASE ICode WHEN :ai_icode9 THEN Qty ELSE 0 END),\n\tItem10 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode10),\n\tQty10 = SUM(CASE ICode WHEN :ai_icode10 THEN Qty ELSE 0 END),\n\tTotalValue = SUM(Value)\nFROM\n\t(SELECT \n\t\tGroupCode = A.AreaCode,\n\t\tGroupName = A.Name,\n\t\tICode = SD.ICode,\n\t\tQty = Sum(SD.LooseQty),\n\t\tValue  = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))\n\tFROM\n\t\tSaleLedger S, SaleDetail SD, Customer C, Area A\n\tWHERE\n\t\t:as_group = 'A' AND\n\t\tA.AreaCode IN (:ai_groupcode) AND \n\t\tA.AreaCode = C.AreaCode AND \n\t\tC.CustCode = S.CustCode AND \n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND \n\t\tS.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)\n\tGROUP BY\n\t\tA.AreaCode,\n\t\tA.Name,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT \n\t\tGroupCode = A.AreaCode,\n\t\tGroupName = A.Name,\n\t\tICode = SD.ICode,\n\t\tQty = - Sum(SD.LooseQty),\n\t\tValue  = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))\n\tFROM\n\t\tSRLedger S, SRDetail SD, Customer C, Area A\n\tWHERE\n\t\t:as_group = 'A' AND\n\t\tA.AreaCode IN (:ai_groupcode) AND \n\t\tA.AreaCode = C.AreaCode AND \n\t\tC.CustCode = S.CustCode AND \n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.SRInvCode = SD.SRInvCode AND\n\t\tSD.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)\n\tGROUP BY\n\t\tA.AreaCode,\n\t\tA.Name,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT \n\t\tGroupCode = (SELECT MIN(A.AreaCode) FROM Area A WHERE A.AreaCode IN (:ai_groupcode)),\n\t\tGroupName = (SELECT MIN(A.Name) FROM Area A WHERE A.AreaCode IN ((SELECT MIN(A.AreaCode) FROM Area A WHERE A.AreaCode IN (:ai_groupcode)))),\n\t\tICode = I.ICode,\n\t\tQty = 0.0000,\n\t\tValue  = 0.0000\n\tFROM\n\t\tItem I\n\tWHERE\n\t\t:as_group = 'A' AND\n\t\tI.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)\n\tGROUP BY\n\t\tI.ICode\n\tUNION ALL\t\n\tSELECT \n\t\tGroupCode = A.AccCode,\n\t\tGroupName = A.Name,\n\t\tICode = SD.ICode,\n\t\tQty = Sum(SD.LooseQty),\n\t\tValue  = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))\n\tFROM\n\t\tSaleLedger S, SaleDetail SD, Customer C, Accounts A\n\tWHERE\n\t\t:as_group = 'C' AND\n\t\tA.AccCode IN (:ai_groupcode) AND \n\t\tA.AccCode = C.CustCode AND \n\t\tC.CustCode = S.CustCode AND \n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND \n\t\tS.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)\n\tGROUP BY\n\t\tA.AccCode,\n\t\tA.Name,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT \n\t\tGroupCode = A.AccCode,\n\t\tGroupName = A.Name,\n\t\tICode = SD.ICode,\n\t\tQty = - Sum(SD.LooseQty),\n\t\tValue  = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))\n\tFROM\n\t\tSRLedger S, SRDetail SD, Customer C, Accounts A\n\tWHERE\n\t\t:as_group = 'C' AND\n\t\tA.AccCode IN (:ai_groupcode) AND \n\t\tA.AccCode = C.CustCode AND \n\t\tC.CustCode = S.CustCode AND \n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.SRInvCode = SD.SRInvCode AND\n\t\tSD.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)\n\tGROUP BY\n\t\tA.AccCode,\n\t\tA.Name,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT \n\t\tGroupCode = (SELECT MIN(A.AccCode) FROM Accounts A WHERE A.AccCode IN (:ai_groupcode)),\n\t\tGroupName = (SELECT A.Name FROM Accounts A WHERE A.AccCode IN ((SELECT MIN(A.AccCode) FROM Accounts A WHERE A.AccCode IN (:ai_groupcode)))),\n\t\tICode = I.ICode,\n\t\tQty = 0.0000,\n\t\tValue  = 0.0000\n\tFROM\n\t\tItem I\n\tWHERE\n\t\t:as_group = 'C' AND \n\t\tI.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)\n\tGROUP BY\n\t\tI.ICode\n\tUNION ALL\n\tSELECT \n\t\tGroupCode = A.SubAreaCode,\n\t\tGroupName = A.Name,\n\t\tICode = SD.ICode,\n\t\tQty = Sum(SD.LooseQty),\n\t\tValue  = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))\n\tFROM\n\t\tSaleLedger S, SaleDetail SD, Customer C, SubArea A\n\tWHERE\n\t\t:as_group = 'S' AND\n\t\tA.SubAreaCode IN (:ai_groupcode) AND \n\t\tA.SubAreaCode = C.SubAreaCode AND \n\t\tC.CustCode = S.CustCode AND \n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND \n\t\tS.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)\n\tGROUP BY\n\t\tA.SubAreaCode,\n\t\tA.Name,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT \n\t\tGroupCode = A.SubAreaCode,\n\t\tGroupName = A.Name,\n\t\tICode = SD.ICode,\n\t\tQty = - Sum(SD.LooseQty),\n\t\tValue  = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))\n\tFROM\n\t\tSRLedger S, SRDetail SD, Customer C, SubArea A\n\tWHERE\n\t\t:as_group = 'S' AND\n\t\tA.SubAreaCode IN (:ai_groupcode) AND \n\t\tA.SubAreaCode = C.SubAreaCode AND \n\t\tC.CustCode = S.CustCode AND \n\t\tS.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tS.SRInvCode = SD.SRInvCode AND\n\t\tSD.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)\n\tGROUP BY\n\t\tA.SubAreaCode,\n\t\tA.Name,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT \n\t\tGroupCode = (SELECT MIN(A.SubAreaCode) FROM SubArea A WHERE A.SubAreaCode IN (:ai_groupcode)),\n\t\tGroupName = (SELECT A.Name FROM SubArea A WHERE A.SubAreaCode IN ((SELECT MIN(A.SubAreaCode) FROM SubArea A WHERE A.SubAreaCode IN (:ai_groupcode)))),\n\t\tICode = I.ICode,\n\t\tQty = 0.0000,\n\t\tValue  = 0.0000\n\tFROM\n\t\tItem I\n\tWHERE\n\t\t:as_group = 'S' AND\n\t\tI.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)\n\tGROUP BY\n\t\tI.ICode) S\nGROUP BY\n\tGroupCode,\n\tGroupName\nORDER BY\n\tGroupName",
