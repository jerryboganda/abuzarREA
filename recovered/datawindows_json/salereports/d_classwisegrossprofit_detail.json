    "name": "itemname",
    "dbname": "itemname"
   }
  ],
  "retrieve": "SELECT\t\n\tClass=R.Class,\n\tR.ICCode, \n\tSales=ROUND(SUM(R.Sales), 0),\n\tRet=ROUND(SUM(R.Ret), 0),\n\tCGS=ROUND(SUM(R.CGS), 0),\n\tStock=ROUND(SUM(R.Stock), 0),\n\titemname=R.itemname\n\nFROM\n(SELECT\t\n\tClass=IC.name,\n\tIC.ICCode,\n\tSales=SUM(S.Value),\n\tRet=0,\n\tCGS=-SUM(S.Cost),\n\tStock=0,\n\titemname=I.name\nFROM\t\n\t(SELECT\tSD.ICode, \n\tIsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2))  ,0) AS Value,\n\tSUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice) AS Cost\n\tFROM\tSaleLedger SL, SaleDetail SD\n\tWHERE\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSL.Date >= :ar_startdate AND SL.Date <= :ar_enddate\n\tGROUP BY SL.SaleInvCode, SD.ICode\n\tUNION ALL\n\tSELECT\tSD.ICode, \n\tIsNull( sum(round(((SD.looseqty) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2))  ,0) AS Value,\n\tSUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice) AS Cost\n\tFROM\tSaleLedger SL, SaleInvDetail SD\n\tWHERE\tSL.ImpactInventory='N' AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSL.Date >= :ar_startdate AND SL.Date <= :ar_enddate\n\tGROUP BY SL.SaleInvCode, SD.ICode) S,\n\tItem I, ItemClass IC\nWHERE\t\n\tS.ICode = I.ICode AND\n\tI.ICCode = IC.ICCode AND\n\tIC.ICCode IN (:ar_class)\nGROUP BY \n\tI.name,\n\tIC.name,\n\tIC.ICCode\nUNION ALL\nSELECT\t\n\tClass=IC.name,\n\tIC.ICCode,\n\tSales=0,\n\tRet=-SUM(S.Value),\n\tCGS=SUM(S.Cost),\n\tStock=0,\n\titemname=I.name\nFROM\t\n\t(SELECT\tSD.ICode, \n\tIsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * SD.srprice ) * (1 - (.01 *  SD.discperc)),2))  ,0) AS Value,\n\tSUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice) AS Cost\n\tFROM\tSRLedger SL, SRDetail SD\n\tWHERE\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSL.Date >= :ar_startdate AND SL.Date <= :ar_enddate\n\tGROUP BY SL.SRInvCode, SD.ICode) S,\n\tItem I, ItemClass IC\nWHERE\t\n\tS.ICode = I.ICode AND\n\tI.ICCode = IC.ICCode AND\n\tIC.ICCode IN (:ar_class)\nGROUP BY \n\tI.name,\n\tIC.name,\n\tIC.ICCode\nUNION ALL\nSELECT\t\n\tClass=IC.name,\n\tIC.ICCode,\n\tSales=0,\n\tRet=0,\n\tCGS=0,\n\tStock=SUM(S.CurrQty * I.AvgPrice),\n\titemname=I.name\nFROM\t\n\tGodownDetail S,\n\tItem I, ItemClass IC\nWHERE\t\n\tS.ICode = I.ICode AND\n\tI.ICCode = IC.ICCode AND\n\tIC.ICCode IN (:ar_class)\nGROUP BY \n\tI.name,\n\tIC.name,\n\tIC.ICCode) R\nGROUP BY \n\tR.itemname,\n\tR.Class,\n\tR.ICCode\nORDER BY\n\tR.Class,\n\tR.itemname,\n\tR.ICCode\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_enddate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_class",
      "numberlist"
     ]
    }
   ]
  }
 },
