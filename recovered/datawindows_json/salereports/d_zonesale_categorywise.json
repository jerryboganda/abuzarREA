    "name": "value",
    "dbname": "Value"
   }
  ],
  "retrieve": "SELECT \n\tZone=(SELECT Zone.Name FROM Zone WHERE Zone.ZoneCode=:ai_zonecode),\n\tIC.Icatcode, \n\tCategory=Ic.Name,\n\tAliasName=I.CustomICode, \n\tItem=I.Name,\n\tPacking=I.PackingDesc,\n\tI.Packunits,\n\tPrice=Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),\n\tQty = SUM(S.qty), \n\tBonus = SUM(S.bonus), \n\tValue = CASE :ai_pricetype WHEN 1 THEN Round(SUM(S.Value), 2) \n\t\t\tELSE SUM(S.qty * Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) END\t\nFROM \n(SELECT\n\tsaledetail.icode,\n\tQty = SUM(saledetail.looseqty),\n\tBonus = SUM(saledetail.bonusqty),\n\tValue=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*\n\t\t(1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),\n\titem.icatcode\nFROM\n\tsaleledger,\t \n\tsaledetail,\n\titem,\n\tzoneareas,\n\tcustomer\nWHERE\n\tsaleledger.saleinvcode = saledetail.saleinvcode AND \n\tsaleledger.date >= :ad_startdate AND saleledger.date <= :ad_enddate AND\n\tzoneareas.zonecode = :ai_zonecode AND\n\tzoneareas.areacode = customer.areacode AND\n\tsaleledger.custcode = customer.custcode AND\n\tsaledetail.icode = item.icode AND\n\titem.icatcode in (:ai_icatcode)\nGROUP BY \n\t saledetail.icode,\n\t saleledger.discperc,\n\t saleledger.flatdisc,\n\t item.icatcode\nUNION ALL\nSELECT\n\tsaledetail.icode,\n\tQty = SUM(saledetail.looseqty),\n\tBonus = SUM(saledetail.bonusqty),\n\tValue=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*\n\t\t(1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),\n\titem.icatcode\nFROM\n\tsaleledger,\t \n\tsaleinvdetail saledetail,\n\titem,\n\tzoneareas,\n\tcustomer\nWHERE\n\tSaleLedger.impactinventory = 'N' AND\n\tsaleledger.saleinvcode = saledetail.saleinvcode AND \n\tsaleledger.date >= :ad_startdate AND saleledger.date <= :ad_enddate AND\n\tzoneareas.zonecode = :ai_zonecode AND\n\tzoneareas.areacode = customer.areacode AND\n\tsaleledger.custcode = customer.custcode AND\n\tsaledetail.icode = item.icode AND\n\titem.icatcode in (:ai_icatcode)\nGROUP BY \n\t saledetail.icode,\n\t saleledger.discperc,\n\t saleledger.flatdisc,\n\t item.icatcode\nUNION ALL\nSELECT\n\tsrdetail.icode,\n\tQty = -SUM(srdetail.looseqty),\n\tBonus = -SUM(srdetail.bonusqty),\n\tValue= -SUM((srdetail.looseqty * srdetail.srprice)*\n\t\t(1 - (.01 * srdetail.discperc))) * (1 - (.01 * srledger.discperc)),\n\titem.icatcode\nFROM\n\tsrledger,\t \n\tsrdetail,\n\titem,\n\tzoneareas,\n\tcustomer\nWHERE\n\tsrledger.srinvcode = srdetail.srinvcode AND \n\tsrledger.date >= :ad_startdate AND srledger.date <= :ad_enddate AND\n\tzoneareas.zonecode = :ai_zonecode AND\n\tzoneareas.areacode = customer.areacode AND\n\tsrledger.custcode = customer.custcode AND\n\tsrdetail.icode = item.icode AND\n\titem.icatcode in (:ai_icatcode)\nGROUP BY \n\t srdetail.icode,\n\t srledger.discperc,\n\t srledger.flatdisc,\n\t item.icatcode) S, ItemCategory IC, Item I\nWHERE\n\tS.Icode = I.Icode AND \n\tI.ICatCode = IC.ICatCode\nGROUP BY \n\tIC.Icatcode, \n\tIc.Name,\n\tI.CustomICode, \n\tI.Name,\n\tI.PackingDesc,\n\tI.Packunits,\n\tI.SalePrice\nORDER BY \n\tIc.Name, \n\tIC.Icatcode,\n\tI.Name,\n\tI.CustomICode\n",
  "arguments": {
