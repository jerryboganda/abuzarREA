  ],
  "retrieve": "Select\tDate = Convert(VarChar(12), SL.Date, 103),\n\t\t\taliasname = item.customicode,\n\t\t\titemname  = item.name, \n\t\t\tpackingdesc = item.packingdesc,\n\t\t\tLooseQty   = Sum(sd.looseqty),\n\t\t\tBonusQty   = Sum(sd.bonusqty),\n\t\t\tAmount = Round(Sum( sd.looseqty * (sd.saleprice - sd.itemflatdisc) * (1 - (sd.discperc * 0.01)) * (1 - (SL.discperc * 0.01)) ), 0 )\nFrom \t\n\tSaleLedger SL Inner Join SaleDetail SD On SL.SaleInvCode = SD.SaleInvCode Inner Join Item On SD.Icode = Item.Icode And \n\tSL.date Between :ad_startdate And :ad_enddate And \n\tItem.ManfCode = :ai_manfcode\nGroup By  \n\tConvert(VarChar(12), SL.Date , 103),\n\tSD.ICODE, \n\titem.customicode, \n\titem.name, \n\titem.packingdesc\nUNION ALL\nSelect\tDate = Convert(VarChar(12), SL.Date, 103),\n\t\t\taliasname = item.customicode,\n\t\t\titemname  = item.name,\n\t\t\tpackingdesc = item.packingdesc,\n\t\t\tLooseQty   = Sum(sd.looseqty),\n\t\t\tBonusQty   = Sum(sd.bonusqty),\n\t\t\tAmount = Round(Sum( sd.looseqty * (sd.saleprice - sd.itemflatdisc) * (1 - (sd.discperc * 0.01)) * (1 - (SL.discperc * 0.01)) ), 0 )\nFrom \t\n\tSaleLedger SL Inner Join SaleInvDetail SD On SL.SaleInvCode = SD.SaleInvCode Inner Join Item On SD.Icode = Item.Icode And \n\tSL.date Between :ad_startdate And :ad_enddate And \n\tItem.ManfCode = :ai_manfcode AND\n\tSL.ImpactInventory = 'N'\nGroup By  \n\tConvert(VarChar(12), SL.Date , 103),\n\tSD.ICODE, \n\titem.customicode, \n\titem.name, \n\titem.packingdesc\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_manfcode",
      "number"
     ]
    },
    {
