  "retrieve": "SELECT \n\tSRInvCode=SRLedger.SRInvCode,   \n\tSaleInvCode=SRLedger.SaleInvCode,   \n\tDate=SRLedger.Date,   \n\tCustCode=SRLedger.CustCode,   \n\tCustomer=Accounts.Name,\n\tAliasName=Accounts.AliasName, \n\tOutstandingAmt = SRLedger.OutstandingAmt,\n\tInvTotal=SRLedger.InvTotal\nFROM SRLedger, Accounts \nWHERE \n\tSRLedger.SRCatCode IN (7) AND\n\tSRInvCode NOT IN\n\t\t(SELECT DISTINCT SRInvCode FROM SRAllocationHeader) AND\n\tSRLedger.CustCode = Accounts.AccCode\nORDER BY \n\tSRInvCode\n"
