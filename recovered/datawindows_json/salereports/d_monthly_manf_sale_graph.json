    "dbname": "manufacturer"
   }
  ],
  "retrieve": "SELECT DAY=datepart(dd,date),daytotal=sum(netamount),\n        manufacturer=(select name from manufacturer where manfcode=:ar_manfcode)\nFROM\n\n(SELECT   \n         \n\t\t\tdate= max(dbo.saleledger.date),    \n         netamount=ISNULL(Round(sum(saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc) * (1 - (0.01 * saledetail.discperc))) * (1 - (0.01 * saleledger.discperc)) - saleledger.flatdisc + saleledger.misccharges,0),0)\nFROM dbo.saleledger, \n     dbo.saledetail,\n     dbo.item  \n        \n\nWHERE ( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and \n      ( dbo.saleledger.date between :ar_StartDate and :ar_EndDate)and\n\t\t( dbo.saledetail.icode=item.icode) and\n      ( dbo.item.manfcode=:ar_manfcode) \n        \n     \t            \n\nGROUP BY\n         \n         dbo.saleledger.saleinvcode,\n\t\t\tdbo.saleledger.flatdisc,\n         dbo.saleledger.discperc,\n         dbo.saleledger.misccharges\n\nUNION ALL\n\nSELECT   \n         \n\t\t\tdate= max(dbo.saleledger.date),    \n         netamount=ISNULL(Round(sum(sd.looseqty * (sd.saleprice - sd.itemflatdisc) * (1 - (0.01 * sd.discperc))) * (1 - (0.01 * saleledger.discperc)) - saleledger.flatdisc + saleledger.misccharges,0),0)\nFROM dbo.saleledger, \n     dbo.saleinvdetail sd,\n     dbo.item  \n        \n\nWHERE ( DBO.SaleLedger.impactinventory = 'N' ) AND\n\t\t( dbo.saleledger.saleinvcode = sd.saleinvcode ) and \n      ( dbo.saleledger.date between :ar_StartDate and :ar_EndDate)and\n\t\t( sd.icode=item.icode) and\n      ( dbo.item.manfcode=:ar_manfcode) \n        \nGROUP BY\n         \n         dbo.saleledger.saleinvcode,\n\t\t\tdbo.saleledger.flatdisc,\n         dbo.saleledger.discperc,\n         dbo.saleledger.misccharges\n\nUNION ALL\n\nSELECT   \n\t\t\tdate= dbo.srledger.date, \n\t\t\tsramount= ISNULL(-1 * Round(sum((srdetail.looseqty * srdetail.srprice) * (1 - (0.01 * srdetail.discperc))) * (1 - (0.01 * srledger.discperc)) - srledger.flatdisc + srledger.misccharges,0),0)\n\nFROM     dbo.srledger, \n         dbo.srdetail,\n\t\t\tdbo.item \n\n\nWHERE ( dbo.srledger.srinvcode = dbo.srdetail.srinvcode ) and  \n      ( dbo.srledger.date between :ar_StartDate and :ar_EndDate)   and         \n\t\t( dbo.srdetail.icode=item.icode) and\n      ( dbo.item.manfcode=:ar_manfcode) \n        \nGROUP BY \n         dbo.srledger.srinvcode,\n\t\t\tdbo.srledger.date ,\n\t\t\tdbo.srledger.misccharges,   \n         dbo.srledger.flatdisc,  \n\t\t\tdbo.srledger.discperc  \n\t\t\t\n\n) AS a\n\nGROUP BY   datepart(dd,date) \nORDER BY  datepart(dd,date) ASC  ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_enddate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ar_manfcode",
      "number"
     ]
    }
   ]
  }
 },
