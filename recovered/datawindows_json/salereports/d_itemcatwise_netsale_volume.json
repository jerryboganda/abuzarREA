    "dbname": "NetSaleVolume"
   }
  ],
  "retrieve": "SELECT\n\tItemCategory=IC.Name,\n\tAliasName=I.CustomICode,\n\tItem=I.Name, \n\tSale=SUM(S.Sale),\n\tSaleVolume=SUM(S.SaleVolume), \n\tSaleReturn=SUM(S.SaleReturn),\n\tSaleReturnVolume=SUM(S.SaleReturnVolume),\n\tNetSale=SUM(S.Sale - S.SaleReturn),\n\tNetSaleVolume=SUM(S.SaleVolume - S.SaleReturnVolume)\nFROM\n\tItemCategory IC, \n\tItem I,\n\t(SELECT\n\t\tSD.ICode,\n\t\tSale = SUM(SD.LooseQty),\n\t\tSaleVolume = SUM(SD.LooseQty * I.PackingFactor),\n\t\tSaleReturn = 0.00,\n\t\tSaleReturnVolume = 0.00\n\tFROM\n\t\tSaleLedger S, SaleDetail SD, Item I\n\tWHERE \n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.SaleInvCode = SD.SaleInvCode AND \n\t\tSD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)\n\tGROUP BY\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT\n\t\tSD.ICode,\n\t\tSale = SUM(SD.LooseQty),\n\t\tSaleVolume = SUM(SD.LooseQty * I.PackingFactor),\n\t\tSaleReturn = 0.00,\n\t\tSaleReturnVolume = 0.00\n\tFROM\n\t\tSaleLedger S, SaleInvDetail SD, Item I\n\tWHERE \n\t\tS.ImpactInventory = 'N' AND\n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.SaleInvCode = SD.SaleInvCode AND \n\t\tSD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)\n\tGROUP BY\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT\n\t\tSD.ICode,\n\t\tSale = 0.00,\n\t\tSaleVolume = 0.00,\n\t\tSaleReturn = SUM(SD.LooseQty),\n\t\tSaleReturnVolume = SUM(SD.LooseQty * I.PackingFactor)\n\tFROM\n\t\tSRLedger S, SRDetail SD, Item I\n\tWHERE \n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.SRInvCode = SD.SRInvCode AND \n\t\tSD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)\n\tGROUP BY\n\t\tSD.ICode) S\nWHERE\n\tIC.ICatCode IN (:ai_icatcode) AND\n\tIC.ICatCode = I.ICatCode AND\n\tI.ICode = S.ICode\nGROUP BY\n\tIC.Name,\n\tI.Name,\n\tI.CustomICode\nORDER BY\n\tItemCategory,\n\tItem",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_icatcode",
      "numberlist"
     ]
    },
