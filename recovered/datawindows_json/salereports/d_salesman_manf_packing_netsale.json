    "name": "packing",
    "dbname": "PacKing"
   },
   {
    "type": "char(60)",
    "updatewhereclause": "yes",
    "name": "itemname",
    "dbname": "ItemName"
   },
   {
    "type": "decimal(4)",
    "updatewhereclause": "yes",
    "name": "netsaleqty",
    "dbname": "NetSaleQty"
   },
   {
    "type": "decimal(10)",
    "updatewhereclause": "yes",
    "name": "netsalevalue",
    "dbname": "NetSaleValue"
   }
  ],
  "retrieve": "SELECT \n\tSalesPercon = SM.Name,\n\tManufacturer = (SELECT M.NAME FROM Manufacturer M WHERE M.ManfCode = :ai_manfcode),\n\tPacKing = IP.Name,\n\tItemName = I.Name,  \n\tNetSaleQty = SUM(S.Qty), \n\tNetSaleValue = SUM(S.Value)\nFROM \n\t(SELECT \n\t\tSManCode=SL.SManCode,\n\t\tICode=SD.ICode, \n\t\tQty = SUM(SD.LooseQty), \n\t\tValue = ROUND(SUM( (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ), 2)\n\tFROM \n\t\tSaleLedger SL, SaleDetail SD, Item I\n\tWHERE \n\t\tSL.DATE BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = :ai_manfcode AND\n\t\tSL.SManCode IN (:ai_smancode)\n\tGROUP BY\n\t\tSL.SManCode,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT \n\t\tSManCode=SL.SManCode,\n\t\tICode=SD.ICode, \n\t\tQty = - SUM(SD.LooseQty), \n\t\tValue = - ROUND(SUM( SD.SRPrice* (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ), 2)\n\tFROM \n\t\tSRLedger SL, SRDetail SD, Item I\n\tWHERE \n\t\tSL.DATE BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = :ai_manfcode AND\n\t\tSL.SManCode IN (:ai_smancode)\n\tGROUP BY\n\t\tSL.SManCode,\n\t\tSD.ICode) S,\n\tItem I LEFT OUTER JOIN ItemPacking AS IP ON (I.packcode = IP.packcode),\n\tSalesMan SM\nWHERE\n\tS.ICode = I.ICode AND\n\tI.ManfCode = :ai_manfcode AND\n\tS.SManCode = SM.SalesManCode\nGROUP BY\n\tSM.Name,\n\tIP.Name,\n\tI.Name",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "adt_enddate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ai_manfcode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_smancode",
      "numberlist"
     ]
    }
   ]
  }
 },
