  "retrieve": "SELECT\n\titemname= CASE SaleInvDetail.SaleItemDescription WHEN NULL THEN item.name ELSE SaleInvDetail.SaleItemDescription END,   \n\taliasname=item.customicode,   \n\tpacking=item.Packingdesc,\n\taccalias = dbo.accounts.aliasname,   \n\taccname = dbo.accounts.name,   \n\taddress = dbo.customer.address1,   \n\taddress2= dbo.customer.address2,   \n\tsaleinvcode = dbo.saleledger.saleinvcode,   \n\theaderno = dbo.saleledger.headerno,   \n\tdate = dbo.saleledger.date,   \n\tinvdiscperc = dbo.saleledger.discperc,   \n\tlooseqty = SUM(SaleInvDetail.looseqty),   \n\tsaleprice= MAX(SaleInvDetail.saleprice)\nFROM \n\tsaleledger,   \n\tSaleInvDetail,   \n\tcustomer,\n\taccounts,   \n\titem  \nWHERE \n\t( dbo.saleledger.saleinvcode = :ar_SaleInvCode ) AND  \n\t( dbo.saleledger.saleinvcode = dbo.SaleInvDetail.saleinvcode) AND  \n\t( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  \n\t( dbo.customer.custcode = dbo.accounts.acccode ) AND  \n\t( dbo.SaleInvDetail.icode = dbo.item.icode)    \nGROUP BY\n\tsaleledger.saleinvcode,\n\tsaleledger.headerno,\n\tsaleledger.date,\n\tsaleledger.discperc,\n\tsaleinvdetail.icode,\n\tSaleInvDetail.SaleItemDescription,\n\titem.icode,\n\titem.name,\n\titem.Packingdesc,\n\titem.customicode,\n\taccounts.name,\n\taccounts.aliasname,\n\tcustomer.address1,\n\tcustomer.address2\n\t\nORDER BY \n\tsaleinvcode,\n\titemname",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_SaleInvCode",
      "number"
     ]
    }
   ]
  }
 },
