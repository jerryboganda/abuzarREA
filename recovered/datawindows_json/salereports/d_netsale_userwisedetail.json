  ],
  "retrieve": "Select A.saleinvcode,\n\t\t invcost=sum(A.avgprice*A.qty),\n\t\t invamount=Round(sum(A.netrate*A.qty) - A.flatdisc + A.misccharges,0),\n\n\t\t profit=Round(sum(A.netrate*A.qty) - A.flatdisc + A.misccharges,0) - sum(A.avgprice*A.qty),\n\t\t incentive=(Round(sum(A.netrate*A.qty) - A.flatdisc + A.misccharges,0) - sum(A.avgprice*A.qty))*0.01* :ll_incentiveperc,\n\t    users=max(A.username),\n\t\t usercode=max(A.usercode),\n\t\t Customer=max(A.customer) \nFrom \n(\nSELECT saleinvcode = dbo.saleledger.saleinvcode,    \n       date = dbo.saleledger.date, \n\t\t username= (select username from users where users.usercode=saleledger.salesmancode),  \n\t\t usercode= saleledger.salesmancode,\n       invdiscperc = dbo.saleledger.discperc,    \n       flatdisc = dbo.saleledger.flatdisc,    \n       misccharges = dbo.saleledger.misccharges, \n       invsalestax = dbo.saleledger.salestax,\n\t\t looseqty = dbo.saledetail.looseqty,\n       qty=saledetail.looseqty + saledetail.packqty * saledetail.packunits, \n\t\t \n       itemflatdisc=saledetail.itemflatdisc,\n       packqty  = saledetail.packqty,  \n       price = dbo.saledetail.saleprice,    \n       itemdiscperc = dbo.saledetail.discperc,    \n\t\t packunits = dbo.saledetail.packunits,    \n\t\t\n\t \t itemname = item.name,\n\t\t datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), \n\t\t customer = accounts.name,\n\t\t netrate=Round(((saledetail.saleprice - saledetail.itemflatdisc) * (1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) ,2),\n\t\t avgprice=saledetail.avgprice+item.packingcost,\n\t\tmargin=Round(((Round((((saledetail.saleprice - saledetail.itemflatdisc) * (1 - .01 * saledetail.discperc)) * (1- .01 * saleledger.discperc)),2) - Round(saledetail.avgprice,2)) * 100) / Round(((saledetail.saleprice - saledetail.itemflatdisc) * (1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) ,2),2) ,\n\t\tinvtype=Case dbo.saleledger.salecatcode \tWhen 1 Then 'Cash' \t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 2 Then 'Credit' \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 3 Then 'Cash'\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tEnd  \t\nFROM \t dbo.saleledger, \n\t\t dbo.saledetail,    \n\t\t dbo.item, \n\t\t dbo.accounts\n       \n\nWHERE  dbo.saleledger.date >= :ad_StartDate and\n\t\t dbo.saleledger.date <= :ad_EndDate  and\n\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  \n\t\t dbo.saledetail.icode = item.icode and \n\t\t dbo.saleledger.salesmancode IN (:la_usercode)and\n \t\t dbo.saleledger.custcode=accounts.acccode \nUNION ALL\nSELECT saleinvcode = dbo.saleledger.saleinvcode,    \n       date = dbo.saleledger.date, \n\t\t username= (select username from users where users.usercode=saleledger.salesmancode),  \n\t\t usercode= saleledger.salesmancode,\n       invdiscperc = dbo.saleledger.discperc,    \n       flatdisc = dbo.saleledger.flatdisc,    \n       misccharges = dbo.saleledger.misccharges, \n       invsalestax = dbo.saleledger.salestax,\n\t\t looseqty = sd.looseqty,\n       qty=sd.looseqty, \n       itemflatdisc=sd.itemflatdisc,\n       packqty  = 0,  \n       price = sd.saleprice,    \n       itemdiscperc = sd.discperc,    \n\t\t packunits = sd.packunits,    \n\t \t itemname = item.name,\n\t\t datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), \n\t\t customer = accounts.name,\n\t\t netrate=Round(((sd.saleprice - sd.itemflatdisc) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) ,2),\n\t\t avgprice=sd.avgprice+item.packingcost,\n\t\tmargin=Round(((Round((((sd.saleprice - sd.itemflatdisc) * (1 - .01 * sd.discperc)) * (1- .01 * saleledger.discperc)),2) - Round(sd.avgprice,2)) * 100) / Round(((sd.saleprice - sd.itemflatdisc) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) ,2),2) ,\n\t\tinvtype=Case dbo.saleledger.salecatcode \tWhen 1 Then 'Cash' \t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 2 Then 'Credit' \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tWhen 3 Then 'Cash'\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tEnd  \t\nFROM \t dbo.saleledger, \n\t\t dbo.saleinvdetail sd,    \n\t\t dbo.item, \n\t\t dbo.accounts\n       \n\nWHERE  DBO.SaleLedger.impactinventory = 'N' AND \n\t\t dbo.saleledger.date >= :ad_StartDate and\n\t\t dbo.saleledger.date <= :ad_EndDate  and\n\t\t dbo.saleledger.saleinvcode = sd.saleinvcode and  \n\t\t sd.icode = item.icode and \n\t\t dbo.saleledger.salesmancode IN (:la_usercode)and\n \t\t dbo.saleledger.custcode=accounts.acccode \n\n) AS A\n\nGroup by A.saleinvcode,\n\t\t\tA.flatdisc ,\n\t\t   A.misccharges\nORDER BY\n\t\t\tmax(A.username),\n\t\t\tA.saleinvcode\n\n  ",
  "arguments": {
