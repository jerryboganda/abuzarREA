    "dbname": "NetSaleValue"
   }
  ],
  "retrieve": "SELECT \n\tManufacturer=(SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = :ar_ManfCode),\n\tItem=I.Name, \n\tAliasName=I.CustomICode, \n\tArea=(SELECT AR.Name FROM Area AR WHERE AR.AreaCode = S.AreaCode), \n\tSoldQty=SUM(S.SoldQty), \n\tSoldBonus=SUM(S.SoldBonus), \n\tSaleValue=SUM(S.SaleValue), \n\tReturnQty=SUM(S.ReturnQty), \n\tReturnBonus=SUM(S.ReturnBonus), \n\tReturnValue=SUM(S.ReturnValue), \n\tNetSaleQty=SUM(S.SoldQty - S.ReturnQty), \n\tNetSaleBonus=SUM(S.SoldBonus - S.ReturnBonus), \n\tNetSaleValue=SUM(S.SaleValue - S.ReturnValue)\nFROM\n\tItem I,\n\t(SELECT\n\t\tSD.ICode, \n\t\tSoldQty=SUM(SD.LooseQty),\n\t\tSoldBonus=SUM(SD.BonusQty),\n\t\tReturnQty=0,\n\t\tReturnBonus=0,\n\t\tSaleValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)),\n\t\tReturnValue=0,\n\t\tC.AreaCode\n\tFROM\n\t\tSaleLedger SL, SaleDetail SD, Customer C, Item I\n\tWHERE\n\t\tSL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.AreaCode IN (:ar_AreaCode) AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = :ar_ManfCode\n\tGROUP BY\n\t\tC.AreaCode,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT\n\t\tSD.ICode, \n\t\tSoldQty=SUM(SD.LooseQty),\n\t\tSoldBonus=SUM(SD.BonusQty),\n\t\tReturnQty=0,\n\t\tReturnBonus=0,\n\t\tSaleValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)),\n\t\tReturnValue=0,\n\t\tC.AreaCode\n\tFROM\n\t\tSaleLedger SL, SaleInvDetail SD, Customer C, Item I\n\tWHERE\n\t\tSL.impactinventory = 'N' AND\n\t\tSL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.AreaCode IN (:ar_AreaCode) AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = :ar_ManfCode\n\tGROUP BY\n\t\tC.AreaCode,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT\n\t\tSD.ICode, \n\t\tSoldQty=0,\n\t\tSoldBonus=0,\n\t\tReturnQty=SUM(SD.LooseQty),\n\t\tReturnBonus=SUM(SD.BonusQty),\n\t\tSaleValue =0,\n\t\tReturnValue=SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)),\n\t\tC.AreaCode\n\tFROM\n\t\tSRLedger SL, SRDetail SD, Customer C, Item I\n\tWHERE\n\t\tSL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\t\tSL.CustCode = C.CustCode AND\n\t\tC.AreaCode IN (:ar_AreaCode) AND\n\t\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode = :ar_ManfCode\n\tGROUP BY\n\t\tC.AreaCode,\n\t\tSD.ICode) S\nWHERE\n\tS.ICode = I.ICode\nGROUP BY\n\tS.AreaCode,\n\tI.Name,\n\tI.CustomICode\nORDER BY\n\tArea,\n\tI.Name,\n\tI.CustomICode",
  "arguments": {
