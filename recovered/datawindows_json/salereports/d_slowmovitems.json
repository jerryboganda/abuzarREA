  "retrieve": "SELECT \n\titemname = dbo.item.name,\t\t\n\titemcode = dbo.item.icode,\n\tReorderLevel = dbo.item.ReorderLevel,\t \n\tManufacturer= dbo.Manufacturer.name,  \n\tCategory= dbo.ItemCategory.name, \n\tsaleqty = Sum(dbo.saledetail.looseqty),\t\t \n\tsalevalue = Sum(dbo.saledetail.looseqty) * (Max(dbo.item.saleprice) / Max(dbo.item.packunits)),\t\n\tcurrqty = IsNull((Select  sum(currqty) \t\n\t\tfrom godowndetail \t\n\t\twhere dbo.item.icode = godowndetail.icode and\n\t\t\t\t\tgodowndetail.gcode IN (:ana_gcode)),0),\n\tstockvalue = IsNull((Select  sum(currqty) \t\n\t\tfrom godowndetail \t\n\t\twhere dbo.item.icode = godowndetail.icode and\n\t\t\t\t\tgodowndetail.gcode IN (:ana_gcode)),0)   * (Max(dbo.item.saleprice) / Max(dbo.item.packunits))\nFROM \n\tdbo.saleledger,\t \n\tdbo.saledetail,\n\tdbo.item,\n\tdbo.Manufacturer,\n\tdbo.itemcategory\nWHERE \n\tdbo.saleledger.date >= :ad_StartDate and \t\n\tdbo.saleledger.date <= :ad_EndDate and \t\n\tdbo.saleledger.salecatcode IN (1, 2, 3) and\t \n\tcase :as_group when 'P' then item.packcode\n\t\t\t\t\t\twhen 'C' THEN item.icatcode\n\t\t\t\t\t\twhen 'L' THEN item.iccode\n\t\t\t\t\t\twhen 'M' THEN item.manfcode  end  IN (:ana_icatcode) and\n\tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and\t   \n\tdbo.saledetail.icode = dbo.item.icode and \n\tdbo.saledetail.gcode IN (:ana_gcode) AND\n\tdbo.item.manfcode = dbo.Manufacturer.manfcode and\n\tdbo.item.icatcode = dbo.itemcategory.icatcode\nGROUP BY \n\tManufacturer.Name, \n\tdbo.ItemCategory.name, \n\titem.name, \n\titem.icode, \n\tdbo.item.ReorderLevel\t \nUnion\nSELECT \n\titemname = dbo.item.name,\t\t\n\titemcode = dbo.item.icode,\n\tReorderLevel = dbo.item.ReorderLevel,\t \n\tManufacturer= dbo.Manufacturer.name, \n\tCategory= dbo.ItemCategory.name, \n\tsaleqty = 0, \t \n\tsalevalue = 0,\t\n\tcurrqty = IsNull((Select  sum(currqty) \t\n\t\t\tfrom godowndetail \t\n\t\t\twhere dbo.item.icode = godowndetail.icode and\n\t\t\t\t\tgodowndetail.gcode IN (:ana_gcode)),0),\n\tstockvalue = IsNull((Select  sum(currqty) \t\n\t\t\tfrom godowndetail \t\n\t\t\twhere dbo.item.icode = godowndetail.icode and\n\t\t\t\t\tgodowndetail.gcode IN (:ana_gcode)),0)   * (Max(dbo.item.saleprice) / Max(dbo.item.packunits)) \t\nFROM \t \n\tdbo.item,\n\tdbo.Manufacturer,\n\tdbo.itemcategory\nWHERE   \n\tdbo.item.icode Not in  (Select saledetail.icode\n\t\t\t\tFrom Saleledger,saledetail\n\t\t\t\tWhere \tdbo.saleledger.date >= :ad_StartDate and \t\n\t\t\t\t \t   dbo.saleledger.date <= :ad_EndDate and \t\n\t\t\t\t\t   dbo.saleledger.salecatcode IN (1, 2, 3) and\t \n\t\t\t\t\t   dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and \n\t\t\t\t\t   dbo.saledetail.gcode IN (:ana_gcode)) and\n\t /*dbo.Item.icatcode IN (:ana_icatcode) and*/\n\tcase :as_group when 'P' then item.packcode\n\t\t\t\t\t\twhen 'C' THEN item.icatcode\n\t\t\t\t\t\twhen 'L' THEN item.iccode\n\t\t\t\t\t\twhen 'M' THEN item.manfcode  end  IN (:ana_icatcode) and\n\t Item.manfcode = manufacturer.manfcode\t and\n\tdbo.item.icatcode = dbo.itemcategory.icatcode\nGROUP BY \n\tManufacturer.Name, \n\tdbo.ItemCategory.name, \n\titem.name, \n\titem.icode, \n\tdbo.item.ReorderLevel",
  "arguments": {
