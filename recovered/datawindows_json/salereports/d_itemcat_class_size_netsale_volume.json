  "retrieve": "SELECT\n\tCatCode=IC.ICatCode,\n\tItemCategory=IC.Name,\n\tICCode=ICL.ICCode,\n\tItemClass=ICL.Name,\n\tISizeCode=ISZ.ISizeCode,\n\tItemSize=ISZ.Name, \n\tSaleQty = SUM(S.SaleQty),  \n\tSale=Round(SUM(S.Sale), 2),\n\tSaleVolume=SUM(S.SaleVolume),\n\tSaleReturn=Round(SUM(S.SaleReturn), 2),\n\tSaleReturnVolume=SUM(S.SaleReturnVolume),\n\tNetSale=Round(SUM(S.Sale), 2) - Round(SUM(S.SaleReturn), 2),\n\tNetSaleVolume=SUM(S.SaleVolume - S.SaleReturnVolume)\nFROM\n\tItemClass ICL,\n\tItemSize ISZ,\n\tItemCategory IC, \n\tItem I\n\tLEFT OUTER JOIN \n\t(SELECT\n\t\tSD.ICode,\n\t\tSaleQty = SUM(SD.LooseQty), \n\t\tSale = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) ),\n\t\tSaleVolume = SUM(SD.LooseQty * I.PackingFactor),\n\t\tSaleReturn = 0.00,\n\t\tSaleReturnVolume = 0.00\n\tFROM\n\t\tSaleLedger S, SaleDetail SD, Item I\n\tWHERE \n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.SaleInvCode = SD.SaleInvCode AND \n\t\tSD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)\n\tGROUP BY\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT\n\t\tSD.ICode,\n\t\tSaleQty = SUM(SD.LooseQty), \n\t\tSale = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) ),\n\t\tSaleVolume = SUM(SD.LooseQty * I.PackingFactor),\n\t\tSaleReturn = 0.00,\n\t\tSaleReturnVolume = 0.00\n\tFROM\n\t\tSaleLedger S, SaleInvDetail SD, Item I\n\tWHERE \n\t\tS.impactinventory = 'N' AND\n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.SaleInvCode = SD.SaleInvCode AND \n\t\tSD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)\n\tGROUP BY\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT\n\t\tSD.ICode,\n\t\tSaleQty = - SUM(SD.LooseQty), \n\t\tSale = 0.00,\n\t\tSaleVolume = 0.00,\n\t\tSaleReturn = SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) ),\n\t\tSaleReturnVolume = SUM(SD.LooseQty * I.PackingFactor)\n\tFROM\n\t\tSRLedger S, SRDetail SD, Item I\n\tWHERE \n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.SRInvCode = SD.SRInvCode AND \n\t\tSD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)\n\tGROUP BY\n\t\tSD.ICode) S ON (I.ICode = S.ICode)\nWHERE\n\tIC.ICatCode IN (:ai_icatcode) AND\n\tIC.ICatCode = I.ICatCode AND\n\tI.ICCode = ICL.ICCode AND\n\tI.ISizeCode = ISZ.ISizeCode\nGROUP BY\n\tIC.ICatCode,\n\tIC.Name,\n\tICL.ICCode,\n\tICL.Name,\n\tISZ.ISizeCode,\n\tISZ.Name\nORDER BY\n\tItemCategory,\n\tItemClass,\n\tItemSize\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_icatcode",
      "numberlist"
     ]
