  "retrieve": "SELECT\n\tCustomerAlias=(Select Ac.AliasName FROM accounts Ac Where Ac.Acccode = A.CustCode),\n\tcustomer=(Select Ac.Name FROM accounts Ac Where Ac.Acccode = A.CustCode),\n\tSalesPerson = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode IN (SELECT C.SalesManCode FROM Customer C WHERE C.CustCode=A.CustCode) ),\n\tAddress=(Select C.NIC FROM Customer C Where C.CustCode = A.CustCode),\n\tCity=(Select C.CITY FROM Customer C Where C.CustCode = A.CustCode),\n\tGroupName=\n\t\tCASE :as_reportgrouping \n\t\tWHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)\n\t\tWHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)\n\t\tWHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)\n\t\tELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,   \n\tnetamount=Sum(A.amount)\nFROM\n\tItem I,\n\t(SELECT\t\n\t\tdbo.customer.custcode,\n\t\ticode=Null,\n\t\tamount   = 0.00\n\tFROM dbo.customer\n\tWHERE dbo.customer.salesmancode IN (:ll_smancode) \n\tUNION ALL\n\tSELECT\t\n\t\tdbo.saleledger.custcode,\n\t\tdbo.saledetail.icode,\n\t\tamount   = Round(Sum ( (saledetail.looseqty + saledetail.bonusqty) * \n\t\t\t\t\t\t\t\t\t\t(saledetail.saleprice - saledetail.itemflatdisc) * \n\t\t\t\t\t\t\t\t\t\t(1 - saledetail.discperc * 0.01)), 2)\n\tFROM dbo.saleledger, dbo.saledetail, dbo.item\n\tWHERE dbo.saleledger.date >= :ad_StartDate and\n\t \tdbo.saleledger.date <= :ad_EndDate and\n\t \tdbo.saleledger.custcode IN \n\t\t\t(SELECT c.custcode FROM dbo.customer c\n\t\t\tWHERE c.salesmancode IN (:ll_smancode)) and\n\t \tdbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN dbo.item.manfcode\n\t\tWHEN 'C' THEN dbo.item.ICatCode\n\t\tWHEN 'L' THEN dbo.item.ICCode\n\t\tELSE dbo.item.PACKCODE END IN (:ll_groupcode) and\n\t \tdbo.saledetail.icode = item.icode \n\tGROUP BY\n\t\tdbo.saleledger.custcode,\n\t\tsaledetail.icode\n\tUNION ALL\n\tSELECT\t\n\t\tdbo.saleledger.custcode,\n\t\tsd.icode,\n\t\tamount   = Round(Sum ( (sd.looseqty + sd.bonusqty) * \n\t\t\t\t\t\t\t\t\t\t(sd.saleprice - sd.itemflatdisc) * \n\t\t\t\t\t\t\t\t\t\t(1 - sd.discperc * 0.01)), 2)\n\tFROM \tdbo.saleledger, \n\t \tdbo.saleinvdetail sd, \n\t \tdbo.item\n\tWHERE\tdbo.saleledger.impactinventory = 'N' AND\n\t\tdbo.saleledger.date >= :ad_StartDate and\n\t \tdbo.saleledger.date <= :ad_EndDate  and\n\t \tdbo.saleledger.custcode IN \n\t\t\t(SELECT c.custcode FROM dbo.customer c\n\t\t\tWHERE c.salesmancode IN (:ll_smancode)) and\n\t \tdbo.saleledger.saleinvcode = sd.saleinvcode and  \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN dbo.item.manfcode\n\t\tWHEN 'C' THEN dbo.item.ICatCode\n\t\tWHEN 'L' THEN dbo.item.ICCode\n\t\tELSE dbo.item.PACKCODE END IN (:ll_groupcode) and\n\t \tsd.icode = item.icode \n\tGROUP BY\n\t\tdbo.saleledger.custcode,\n\t\tsd.icode\n\tUNION ALL\n\tSELECT \t\n\t\tdbo.srledger.custcode,\n\t\tdbo.srdetail.icode,\n\t\tamount   = (-1 * Round(Sum ( (srdetail.looseqty+srdetail.bonusqty) * srdetail.srprice * \n\t\t\t\t\t\t\t\t\t\t(1 - srdetail.discperc * 0.01) ), 2))\n\tFROM\n\t\tdbo.srledger, \n\t\tdbo.srdetail,    \n\t\tdbo.item\n\tWHERE\n\t\tdbo.srledger.date >= :ad_StartDate and\n\t\tdbo.srledger.date <= :ad_EndDate and\n\t \tdbo.srledger.custcode IN \n\t\t\t(SELECT c.custcode FROM dbo.customer c\n\t\t\tWHERE c.salesmancode IN (:ll_smancode)) and\n\t\tdbo.srledger.srinvcode = dbo.srdetail.srinvcode and  \n\t\tCASE :as_reportgrouping\n\t\tWHEN 'M' THEN dbo.item.manfcode\n\t\tWHEN 'C' THEN dbo.item.ICatCode\n\t\tWHEN 'L' THEN dbo.item.ICCode\n\t\tELSE dbo.item.PACKCODE END IN (:ll_groupcode) and\n\t\tdbo.srdetail.icode = item.icode \n\tGROUP BY \n\t\tsrledger.custcode,\n\t\tsrdetail.icode) AS A\nWHERE\n\tA.icode = I.icode\nGROUP BY \n\tA.CustCode,\n\tI.ManfCode,\n\tI.ICatCode,\n\tI.ICCode,\n\tI.PackCode\nORDER BY\n\tCustomer,\n\tGroupName",
  "arguments": {
