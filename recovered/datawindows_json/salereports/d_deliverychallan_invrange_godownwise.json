    "name": "id",
    "dbname": "Id"
   }
  ],
  "retrieve": "SELECT  \n\titemname= item.name, \n\tpackingdesc=item.packingdesc,\n\taliasname=item.customicode,\n\ticode = saledetail.icode,   \n\texpiry = saledetail.expiry,   \n\tqty = isnull( Sum(saledetail.looseqty + saledetail.bonusqty) ,0),\n\tGodown = Godown.name,\t\n\tId       = Min(dbo.saledetail.IDENTITYCOL)\nFROM \n\tsaleledger, \n\tsaledetail, \n\tGodown,\n\tItem LEFT OUTER JOIN ItemPacking ON (dbo.item.packcode = itempacking.packcode)\nWHERE \n\t( dbo.saleledger.saleinvcode Between :ar_SInvCode And :ar_LInvCode) And\n\t( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND\n\t( dbo.saledetail.icode = dbo.item.icode) and \n\t( dbo.saledetail.gcode IN (:ar_gcode )  ) and\n\t( dbo.saledetail.gcode = godown.gcode)\nGroup By\n\tGodown.Name,\n\tSaleDetail.ICode,\n\tItem.Name,\n\tItem.PackingDesc,\n\tItem.CustomICode,\n\tSaleDetail.Expiry",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_SInvCode",
      "number"
     ]
    },
    {
     "_items": [
      "ar_LInvCode",
      "number"
     ]
    },
    {
     "_items": [
      "ar_GCode",
      "numberlist"
     ]
    }
   ]
  },
  "sort": "godown A, itemname A"
 },
