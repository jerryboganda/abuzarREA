  "retrieve": "SELECT \tAliasName=ReportData.name1,   \n         Item=ReportData.name2,\n         Stock=SUM(CASE CODE2 WHEN 0 THEN ReportData.value1 ELSE 0.0000 END),   \n         NetSale=SUM(CASE CODE2 WHEN 1 THEN ReportData.value1 ELSE 0.0000 END),   \n\t\t\tstartdate=ReportData.date1,\n\t\t\tenddate=ReportData.date2,\n         Period= RTRIM(LTRIM(DATENAME(MONTH, ReportData.date1))) + ' ' + LTRIM(RTRIM(YEAR(ReportData.date1)))\nFROM ReportData  \nGROUP BY\n\tReportData.name1,   \n\tReportData.name2,   \n\tReportData.date1,\n\tReportData.date2\nORDER BY\n\t\t\tReportData.date1,\n\t\t\tReportData.date2,\n\t\t\tPeriod",
