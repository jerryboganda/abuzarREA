    "name": "netsale",
    "dbname": "netsale"
   }
  ],
  "retrieve": "SELECT\n\tManfCode=M.ManfCode,\n\tManufacturer=M.Name,\n\tSalesMan=S.Name,\n\tNetSale=ROUND(N.NetSale, 2)\n\nFROM\t(SELECT ManfCode, SManCode, SUM(NET) AS NetSale\n\tFROM (SELECT  SL.saleinvcode,\n\t\tSL.SManCode,\n\t\tI.ManfCode,\n\t\tNet=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *\n\t\t\t(1 - (.01 * SD.discperc)))\n\t\tFROM    saleledger SL,\t \n\t\t\tsaledetail SD,\n\t\t\tItem I\n\t\tWHERE   SL.Posted = 'Y' AND\n\t\t\tSL.DATE Between :ar_startdate AND :ar_enddate AND\n\t\t\tSL.SManCode IN (:ar_salesmancode) AND\n\t\t\tSL.SaleInvCode = SD.SaleInvcode AND SD.ICode = I.ICode\n\t\tGROUP BY \n\t\t\tI.ManfCode,\n\t\t\tSL.saleinvcode,\n\t\t\tSL.SManCode\n\t\tUNION ALL\n\t\tSELECT  SL.saleinvcode,\n\t\tSL.SManCode,\n\t\tI.ManfCode,\n\t\tNet=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *\n\t\t\t(1 - (.01 * SD.discperc)))\n\t\tFROM    saleledger SL,\t \n\t\t\tsaleinvdetail SD,\n\t\t\tItem I\n\t\tWHERE SL.ImpactInventory='N' AND  SL.Posted = 'Y' AND\n\t\t\tSL.DATE Between :ar_startdate AND :ar_enddate AND\n\t\t\tSL.SManCode IN (:ar_salesmancode) AND\n\t\t\tSL.SaleInvCode = SD.SaleInvcode AND SD.ICode = I.ICode\n\t\tGROUP BY \n\t\t\tI.ManfCode,\n\t\t\tSL.saleinvcode,\n\t\t\tSL.SManCode\n\t\tUNION ALL\t\t\n\t\tSELECT  SL.Srinvcode,\n\t\t\tSL.SManCode,\n\t\t\tI.ManfCode,\n\t\t\tNet=-SUM((SD.looseqty*(SD.srprice)) *\n\t\t\t\t(1 - (.01 * SD.discperc)))\n\t\tFROM    srledger SL,\t \n\t\t\tsrdetail SD,\n\t\t\tItem I\n\t\tWHERE   SL.Posted = 'Y' AND\n\t\t\tSL.DATE Between :ar_startdate AND :ar_enddate AND\n\t\t\tSL.SManCode IN (:ar_salesmancode) AND\n\t\t\tSL.SrInvCode = SD.SrInvcode AND SD.ICode = I.ICode\n\t\tGROUP BY I.ManfCode,\n\t\t\tSL.Srinvcode,\n\t\t\tSL.SManCode) S\n\tGROUP BY SManCode, ManfCode) N, \n\tSalesMan S, \n\tManufacturer M\n\nWHERE\tN.SManCode = S.SalesManCode AND \n\tN.ManfCode = M.ManfCode\n\nORDER BY\n\tS.Name,\n\tM.Name\n",
  "arguments": {
   "_items": [
