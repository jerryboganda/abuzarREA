    "dbname": "netval"
   }
  ],
  "retrieve": "SELECT\n\nitemname=A.itemname,\ngenericname=A.genericname,\nsalevalue=sum(A.saleval),\nsaleqty=sum(A.saleqty),\nreturnqty=sum(A.retqty),\nretval=Sum(A.retval),\nnetqty=sum(A.saleqty) - sum(A.retqty),\nnetval= sum(A.saleval) - Sum(A.retval)\n\n\nFROM\n\t\t(SELECT\n\t\t\titemname=I.Name,\n\t\t\tgenericname=(select name from genericitem where genericitem.genericcode=max(I.genericcode)),\n\t\t\tsaleqty=ISNULL(sum(SD.looseqty+SD.bonusqty),0),\n\t\t\tsaleval=ISNULL(sum(SD.looseqty*(((SD.saleprice - SD.itemflatdisc)*(1 - SD.discperc*0.01))*(1 - SL.discperc*0.01))),0),\n\t\t\tretqty=0,\n\t\t\tretval=0\n\t\t\n\t\tFROM  \tsaleledger SL,\n\t\t\tsaledetail SD,\n\t\t\titem I\n\t\t\n\t\tWHERE \n\t\t\tSL.date>=:ar_startdate AND\n\t\t\tSL.date<=:ar_enddate AND\n\t\t\tSL.saleinvcode=SD.saleinvcode AND\n\t\t\tI.icode=SD.icode AND\n\t\t\tI.genericcode IN (:ai_genericitem)\n\t\tGROUP BY I.icode,\n\t\t\t I.name\n\t\t\t\n\t\tUNION ALL\n\t\t\n\t\tselect \n\t\t\titemname=I.Name,\n\t\t\tgenericname=(select name from genericitem where genericitem.genericcode=max(I.genericcode)),\n\t\t\tsaleqty=ISNULL(sum(SD.looseqty+SD.bonusqty),0),\n\t\t\tsaleval=ISNULL(sum(SD.looseqty*(((SD.saleprice - SD.itemflatdisc)*(1 - SD.discperc*0.01))*(1 - SL.discperc*0.01))),0),\n\t\t\tretqty=0,\n\t\t\tretval=0\n\t\t\n\t\tFROM  \tsaleledger SL,\n\t\t\tsaleinvdetail SD,\n\t\t\titem I\n\t\t\n\t\tWHERE \n\t\t\tSL.date>=:ar_startdate AND\n\t\t\tSL.date<=:ar_enddate AND\n\t\t\tSL.saleinvcode=SD.saleinvcode AND\n\t\t\tI.icode=SD.icode AND\n\t\t\tI.genericcode IN (:ai_genericitem)\n\t\t\n\t\tGROUP BY I.icode,\n\t\t\t I.name\n\t\t\n\t\t\n\t\tUNION ALL\n\t\t\n\t\tselect \n\t\t\titemname=I.Name,\n\t\t\tgenericname=(select name from genericitem where genericitem.genericcode=max(I.genericcode)),\n\t\t\tsaleqty=0,\n\t\t\tsaleval=0,\n\t\t\tretqty=ISNULL(sum(SD.looseqty+SD.bonusqty),0),\n\t\t\tretval=ISNULL(sum(SD.looseqty*((SD.srprice *(1 - SD.discperc*0.01))*(1 - SL.discperc*0.01))),0)\n\t\t\n\t\tFROM  \tsrledger SL,\n\t\t\tsrdetail SD,\n\t\t\titem I\n\t\t\n\t\tWHERE \n\t\t\tSL.date>=:ar_startdate AND\n\t\t\tSL.date<=:ar_enddate AND\n\t\t\tSL.srinvcode=SD.srinvcode AND\n\t\t\tI.icode=SD.icode AND\n\t\t\tI.genericcode IN (:ai_genericitem)\n\t\t\n\t\tGROUP BY I.icode,\n\t\t\tI.name ) A\n\nGROUP BY\n\tA.genericname,\n\tA.itemname\nORDER BY\n\tA.genericname,\n\tA.itemname\n\n\t\n",
  "arguments": {
