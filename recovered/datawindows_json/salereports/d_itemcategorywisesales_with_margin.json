  "retrieve": "\nSELECT \t\n\tcategory=IC.name,\n\titemname=I.name,\n\tSaleqty=isnull(Sum( case A.type when 'S' then A.saleqty else 0 end),0),\n\tretqty=isnull(Sum( case  A.type when 'R' then A.saleqty else 0 end),0),\n\tnetqty=isnull(sum(case A.type when 'S' then A.saleqty else -1 * A.saleqty end),0),\n\tretval=isnull(Sum( case  A.type  when 'R' then A.netsaleprice else 0 end),0),\n\t/*salevalue=isnull(Sum( case  A.type when 'S' then A.netsaleprice else 0 end),0),*/\n\tsalevalue=isnull(Sum( case  A.type when 'S' then A.netsaleprice else ((A.netsaleprice) *( - 1)) end),0),\n\t/*salecost=isnull(Sum( case A.type when 'S' then A.itemcost else 0 end),0),*/\n\tsalecost=isnull(Sum( case A.type when 'S' then A.itemcost else (A.itemcost * ( - 1)) end),0),\n\tunitcost=isnull(Sum( case A.type when 'S' then A.itemcost else (A.itemcost * (- 1)) end),0)/(case isnull(Sum( case A.type when 'S' then A.saleqty else (A.saleqty * (- 1)) end),0) when 0 then 1 else isnull(Sum( case A.type when 'S' then A.saleqty else (A.saleqty * (- 1)) end),0) end),\n/*\tunitsaleprice=isnull(Sum( case A.type when 'S' then A.netsaleprice else 0 end),0)/(case isnull(Sum( case A.type when 'S' then A.saleqty else 0 end),0) when 0 then 1 else isnull(Sum( case A.type when 'S' then A.saleqty else 0 end),0) end),*/\n\tunitsaleprice=isnull(Sum( case A.type when 'S' then A.netsaleprice else (A.netsaleprice * (- 1)) end),0)/(case isnull(Sum( case A.type when 'S' then A.saleqty else (A.saleqty * ( - 1)) end),0) when 0 then 1 else isnull(Sum( case A.type when 'S' then A.saleqty  else (A.saleqty * ( - 1)) end),0) end),\n\t/*profitloss=isnull(Sum( case  A.type when 'S' then A.netsaleprice else 0 end),0) - isnull(Sum( case A.type when 'S' then A.itemcost else 0 end),0),*/\n\tprofitloss=isnull(Sum( case  A.type when 'S' then A.netsaleprice else (A.netsaleprice * (- 1)) end),0) - isnull(Sum( case A.type when 'S' then A.itemcost else (A.itemcost * (- 1)) end),0),\n\t/*margin=(isnull(Sum( case  A.type when 'S' then A.netsaleprice else 0 end),0) - \n\t\t\t\tisnull(Sum( case A.type when 'S' then A.itemcost else 0 end),0)) * 100/(case isnull(Sum( case  A.type when 'S' then A.netsaleprice else 0 end),0) when 0 then 1 else isnull(Sum( case  A.type when 'S' then A.netsaleprice else 0 end),0) end)*/\n\tmargin=(isnull(Sum( case  A.type when 'S' then A.netsaleprice else (A.netsaleprice * ( - 1)) end),0) - \n\t\t\t\tisnull(Sum( case A.type when 'S' then A.itemcost else (A.itemcost  * (- 1))end),0)) * 100/(case isnull(Sum( case  A.type when 'S' then A.netsaleprice else (A.netsaleprice * (- 1)) end),0) when 0 then 1 else isnull(Sum( case  A.type when 'S' then A.netsaleprice else (A.netsaleprice * ( - 1)) end),0) end)\n      FROM\n\t\t(select \ttype='S',\n\t\t\tsaleqty=SD.looseqty,\n\t\t\tsaleprice=SD.saleprice,\n\t\t\titemcost=(SD.avgprice*SD.looseqty),\n\t\t\tnetsaleprice=Round(((SD.saleprice - SD.itemflatdisc)*(1 - SD.discperc*0.01))*(1 - SL.discperc*0.01),2) * SD.looseqty,\n\t\t\ticode=SD.icode\n\t\t\tfrom Saleledger SL,\n \t\t\t\t\tSaledetail SD\n\t\t   where SL.date>=:ad_StartDate and \n\t\t\t\tSL.date<=:ad_EndDate and\n\t\t\t\tSL.saleinvcode=SD.saleinvcode and\n\t\t\t\tSD.gcode in (:aa_gcode)\n\t\t\n\t\tunion all\n\t\t\n\t\t\tselect \ttype='R',\n\t\t\tsrqty= SRD.looseqty,\n\t\t\tsrprice=SRD.saleprice,\n\t\t\tsritemcost=(SRD.avgprice*SRD.looseqty),\n\t\t\tnetsrprice=Round((SRD.srprice*(1 - SRD.discperc*0.01))*(1 - SRL.discperc*0.01),2) * SRD.looseqty,\n\t\t\ticode=SRD.icode\n\t\tfrom Srledger SRL,\n \t\t\t\tSrdetail SRD\n\t\twhere SRL.date>=:ad_StartDate and \n\t\t\tSRL.date<=:ad_EndDate and\n\t\t\tSRL.srinvcode=SRD.srinvcode and\n\t\t\tSRD.gcode in (:aa_gcode)\n\t\t\t) AS A\t,\nitem I,\nitemcategory IC\n\nWHERE \tI.icatcode IN (:aa_icatcode) AND\n\t\t\tI.icode=A.icode AND\n\t\t\tI.icatcode=IC.icatcode\n\nGROUP BY\n\tIC.name,\n\tA.icode,\n\tI.name\nORDER BY\n\tIC.name,\n\tI.name,\n\tA.icode\n\n/*\nSELECT \t\n\tcategory=IC.name,\n\titemname=I.name,\n\tSaleqty=isnull(Sum( case A.type when 'S' then A.saleqty else 0 end),0),\n\tretqty=isnull(Sum( case  A.type when 'R' then A.saleqty else 0 end),0),\n\tnetqty=isnull(sum(case A.type when 'S' then A.saleqty else -1 * A.saleqty end),0),\n\tretval=isnull(Sum( case  A.type  when 'R' then A.netsaleprice else 0 end),0),\n\tsalevalue=isnull(Sum( case  A.type when 'S' then A.netsaleprice else 0 end),0),\n\tsalecost=isnull(Sum( case A.type when 'S' then A.itemcost else 0 end),0),\n\tunitcost=isnull(Sum( case A.type when 'S' then A.itemcost else 0 end),0)/(case isnull(Sum( case A.type when 'S' then A.saleqty else 0 end),0) when 0 then 1 else isnull(Sum( case A.type when 'S' then A.saleqty else 0 end),0) end),\n\tunitsaleprice=isnull(Sum( case A.type when 'S' then A.netsaleprice else 0 end),0)/(case isnull(Sum( case A.type when 'S' then A.saleqty else 0 end),0) when 0 then 1 else isnull(Sum( case A.type when 'S' then A.saleqty else 0 end),0) end),\n\tprofitloss=isnull(Sum( case  A.type when 'S' then A.netsaleprice else 0 end),0) - isnull(Sum( case A.type when 'S' then A.itemcost else 0 end),0),\n\tmargin=(isnull(Sum( case  A.type when 'S' then A.netsaleprice else 0 end),0) - \tisnull(Sum( case A.type when 'S' then A.itemcost else 0 end),0)) * 100/(case isnull(Sum( case  A.type when 'S' then A.netsaleprice else 0 end),0) when 0 then 1 else isnull(Sum( case  A.type when 'S' then A.netsaleprice else 0 end),0) end)\n\nFROM\n\t\t(select \ttype='S',\n\t\tsaleqty=SD.looseqty,\n\t\tsaleprice=SD.saleprice,\n\t\titemcost=(SD.avgprice*SD.looseqty),\n\t\tnetsaleprice=Round(((SD.saleprice - SD.itemflatdisc)*(1 - SD.discperc*0.01))*(1 - SL.discperc*0.01),2) * SD.looseqty,\n\t\ticode=SD.icode\n\t\tfrom Saleledger SL,\n\t\t\t\t Saledetail SD\n\t\twhere SL.date>=:ad_StartDate and \n\t\t\tSL.date<=:ad_EndDate and\n\t\t\tSL.saleinvcode=SD.saleinvcode and\n\t\t\tSD.gcode in (:aa_gcode)\n\tunion all\n\t\t\tselect \ttype='R',\n\t\t\tsrqty= SRD.looseqty,\n\t\t\tsrprice=SRD.saleprice,\n\t\t\tsritemcost=(SRD.avgprice*SRD.looseqty),\n\t\t\tnetsrprice=Round((SRD.srprice*(1 - SRD.discperc*0.01))*(1 - SRL.discperc*0.01),2) * SRD.looseqty,\n\t\t\ticode=SRD.icode\n\t\tfrom Srledger SRL,\n\t\t\t\t Srdetail SRD\n\t\twhere SRL.date>=:ad_StartDate and \n\t\t\tSRL.date<=:ad_EndDate and\n\t\t\tSRL.srinvcode=SRD.srinvcode and\n\t\t\tSRD.gcode in (:aa_gcode)\n\t\t\t) AS A\t,\n\n\t\nitem I,\nitemcategory IC\nWHERE \tI.icatcode IN (:aa_icatcode) AND\n\t\t\tI.icode=A.icode AND\n\t\t\tI.icatcode=IC.icatcode\nGROUP BY\n\tIC.name,\n\tA.icode,\n\tI.name\nORDER BY\n\tIC.name,\n\tI.name,\n\tA.icode\n\n*/",
