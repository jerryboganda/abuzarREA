  "retrieve": "select \tcategory=itemcategory.name,\n\t\t\tA.itemname,\n\t\t\tA.icode,\n\t\t\tA.saleprice,\n\t\t\tA.looseqty,\n\t\t\tA.saleinvcode,\n\t\t\tA.rowid,\n\t\t\tA.invDate,\n\t\t\tvalue=(case when A.icatcode=itemcategory.icatcode THEN\n\t\t\t\t\t(A.looseqty*A.saleprice)\n\t\t\t\t      else\n\t\t\t\t\t0\n\t\t\t\t\tend )\n\n\n\nfrom  itemcategory,\n\n\t\t\t\t\t(select SD.saleinvcode,\n\t\t\t\t\t\t\t\trowid=max(SD.Rowid),\n\t\t\t\t\t\t\t\tI.icatcode,\n\t\t\t\t\t\t\t\tSD.icode,\n\t\t\t\t\t\t\t\tsaleprice=max(SD.saleprice),\n\t\t\t\t\t\t\t\tlooseqty=sum(SD.looseqty),\n\t\t\t\t\t\t\t\titemname=max(I.name),\n\t\t\t\t\t\t\t\tinvdate=max(SL.date)\n\t\t      \n\t\t\t\t\tfrom saledetail SD,\n\t\t\t\t\t\t\tsaleledger SL,\n\t     \t\t\t\t\titem I\n\t\t\t\t\twhere SL.custcode=:ar_custcode and\n\t\t\t\t\t\t\t(SL.saleinvcode between :ar_sinvcode and :ar_linvcode)and\n\t\t\t\t\t\t\t(SL.saleinvcode = SD.saleinvcode) and\n\t\t\t\t\t\t\tSD.icode=I.icode\n\t\n\t\t\t\t\tGroup by \n\t\t\t\t\t\t\tSD.saleinvcode,\n\t\t\t\t\t\t\tI.icatcode,\n\t\t\t\t\t\t\tSD.icode ) as A\n\n\norder by A.saleinvcode,A.rowid",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ar_sinvcode",
      "number"
     ]
    },
    {
     "_items": [
      "ar_linvcode",
      "number"
     ]
    },
    {
     "_items": [
      "ar_custcode",
      "number"
     ]
    }
   ]
  },
  "sort": "invdate A"
 },
