  ],
  "retrieve": "SELECT\n\tSaleMonth=STR(DATEPART(mm, S.Date), 2) + '/01/' + STR(DATENAME(Year, S.Date), 4),\n\tItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = I.ICatCode),\n\tItemClass = (SELECT IC.Name FROM ItemClass IC WHERE IC.ICCode = I.ICCode),\n\tItemBrand = (SELECT IB.Name FROM Manufacturer IB WHERE IB.ManfCode = I.ManfCode),\n\tModel = (SELECT Model.Name FROM MODEL WHERE MODELCODE IN (SELECT MIN(IM.ModelCode) FROM ItemInModel IM WHERE IM.ICode = I.ICode)),\n\tAliasName=I.CustomICode,\n\tItemName=I.Name,\n\tQty = ISNULL(SUM(S.QTY), 0)\nFROM\n\tItem I,\n\t(SELECT \n\t\tI.ICatCode,\n\t\tI.ICode,\n\t\tS.Date,\n\t\tQty=SUM(D.LooseQty + D.BonusQty)\n\tFROM \n\t\tSaleLedger S, SaleDetail D, Item I\n\tWHERE\n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.SaleInvCode = D.SaleInvCode AND\n\t\tI.ICatCode IN (:ai_icatcode) AND\n\t\tD.ICode = I.ICode\n\tGROUP BY\n\t\tI.ICatCode,\n\t\tI.ICode,\n\t\tS.Date\n\tUNION ALL\n\tSELECT \n\t\tI.ICatCode,\n\t\tI.ICode,\n\t\tS.Date,\n\t\tQty=SUM(D.LooseQty + D.BonusQty)\n\tFROM \n\t\tSaleLedger S, SaleInvDetail D, Item I\n\tWHERE\n\t\tS.ImpactInventory = 'N' AND\n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.SaleInvCode = D.SaleInvCode AND\n\t\tI.ICatCode IN (:ai_icatcode) AND\n\t\tD.ICode = I.ICode\n\tGROUP BY\n\t\tI.ICatCode,\n\t\tI.ICode,\n\t\tS.Date\n\tUNION ALL\n\tSELECT \n\t\tI.ICatCode,\n\t\tI.ICode,\n\t\tS.Date,\n\t\tQty=SUM(D.LooseQty + D.BonusQty)\n\tFROM \n\t\tSRLedger S, SRDetail D, Item I\n\tWHERE\n\t\tS.SRInvCode = D.SRInvCode AND\n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tI.ICatCode IN (:ai_icatcode) AND\n\t\tD.ICode = I.ICode\n\tGROUP BY\n\t\tI.ICatCode,\n\t\tI.ICode,\n\t\tS.Date) S\nWHERE\n\tI.ICatCode IN (:ai_icatcode) AND\n\tS.ICode = I.ICode\nGROUP BY\n\tI.ICatCode,\n\tI.ICCode,\n\tI.ManfCode,\n\tI.ICode,\n\tI.Name,\n\tI.CustomICode,\n\tSTR(DATEPART(mm, S.Date), 2) + '/01/' + STR(DATENAME(Year, S.Date), 4)\nORDER BY\n\tItemCategory,\n\tItemName,\n\tAliasName,\n\tSaleMonth\n",
  "arguments": {
