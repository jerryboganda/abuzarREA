  "retrieve": "SELECT \n\tManfCode=I.ManfCode,  \n\tManufacturer=I.Manufacturer,\n\tSubAreaCode=C.SubAreaCode,\n\tSubArea=C.SubArea,\n\tCustomerAlias=C.CustomerAlias,\n\tCustomer=C.Customer,\n\tICode=I.ICode,\n\tItemAlias=I.ItemAlias,\n\tItemName=I.ItemName,\n\tNetSale=SUM(S.Sale),\n\tNetSaleVolume=SUM(S.SaleVolume)\nFROM\n\t(SELECT I.ICode, I.ManfCode, ItemAlias=I.CustomICode, ItemName=I.Name, Manufacturer=M.Name\n\tFROM Item I, Manufacturer M\n\tWHERE I.ManfCode IN (:ai_manfcode) AND I.ManfCode = M.ManfCode) I,\n\t(SELECT C.CustCode, C.SubAreaCode, CustomerAlias=A.AliasName, Customer=A.Name, SubArea=SA.Name\n\tFROM Customer C, Accounts A, SubArea SA\n\tWHERE \n\t\tC.SubAreaCode IN (:ai_subareacode) AND \n\t\tC.SubAreaCode = SA.SubAreaCode AND \n\t\tC.CustCode = A.AccCode) C,\n\t(SELECT\n\t\tI.ICode,\n\t\tI.ManfCode,\n\t\tC.SubAreaCode,\n\t\tS.CustCode,\n\t\tSale = SUM(SD.LooseQty * ((SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - S.DiscPerc * .01) )),\n\t\tSaleVolume = SUM(SD.LooseQty * I.PackingFactor)\n\tFROM\n\t\t(SELECT CustCode, SubAreaCode FROM Customer WHERE SubAreaCode IN (:ai_subareacode)) C,\n\t\t(SELECT I.ICode, I.ManfCode, I.PackingFactor FROM Item I WHERE I.ManfCode IN (:ai_manfcode)) I,\n\t\tSaleLedger S, \n\t\tSaleDetail SD\n\tWHERE \n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.CustCode = C.CustCode AND\n\t\tS.SaleInvCode = SD.SaleInvCode AND \n\t\tSD.ICode = I.ICode\n\tGROUP BY\n\t\tS.CustCode,\n\t\tC.SubAreaCode,\n\t\tS.SaleInvCode,\n\t\tI.ICode,\n\t\tI.ManfCode\n\tUNION ALL\n\tSELECT\n\t\tI.ICode,\n\t\tI.ManfCode,\n\t\tC.SubAreaCode,\n\t\tS.CustCode,\n\t\tSale = SUM(SD.LooseQty * ((SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - S.DiscPerc * .01) )),\n\t\tSaleVolume = SUM(SD.LooseQty * I.PackingFactor)\n\tFROM\n\t\t(SELECT CustCode, SubAreaCode FROM Customer WHERE SubAreaCode IN (:ai_subareacode)) C,\n\t\t(SELECT I.ICode, I.ManfCode, I.PackingFactor FROM Item I WHERE I.ManfCode IN (:ai_manfcode)) I,\n\t\tSaleLedger S, \n\t\tSaleInvDetail SD\n\tWHERE \n\t\tS.ImpactInventory = 'N' AND\n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.CustCode = C.CustCode AND\n\t\tS.SaleInvCode = SD.SaleInvCode AND \n\t\tSD.ICode = I.ICode\n\tGROUP BY\n\t\tS.CustCode,\n\t\tC.SubAreaCode,\n\t\tS.SaleInvCode,\n\t\tI.ICode,\n\t\tI.ManfCode\n\tUNION ALL\n\n\tSELECT\n\t\tI.ICode,\n\t\tI.ManfCode,\n\t\tC.SubAreaCode,\n\t\tS.CustCode,\n\t\tSale = -SUM(SD.LooseQty * (SD.SRPrice * (1 - SD.DiscPerc * .01) * (1 - S.DiscPerc * .01) )),\n\t\tSaleVolume = -SUM(SD.LooseQty * I.PackingFactor)\n\tFROM\n\t\t(SELECT CustCode, SubAreaCode FROM Customer WHERE SubAreaCode IN (:ai_subareacode)) C,\n\t\t(SELECT I.ICode, I.ManfCode, I.PackingFactor FROM Item I WHERE I.ManfCode IN (:ai_manfcode)) I,\n\t\tSRLedger S, \n\t\tSRDetail SD\n\tWHERE \n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tS.SRInvCode = SD.SRInvCode AND \n\t\tS.CustCode = C.CustCode AND\n\t\tSD.ICode = I.ICode\n\tGROUP BY\n\t\tS.CustCode,\n\t\tC.SubAreaCode,\n\t\tS.SaleInvCode,\n\t\tI.ICode,\n\t\tI.ManfCode\n\tUNION ALL\n\tSELECT\n\t\tI.ICode,\n\t\tI.ManfCode,\n\t\tC.SubAreaCode,\n\t\tC.CustCode,\n\t\tSale = 0,\n\t\tSaleVolume = 0.00\n\tFROM\n\t\t(SELECT CustCode, SubAreaCode FROM Customer WHERE SubAreaCode IN (:ai_subareacode)) C,\n\t\t(SELECT I.ICode, I.ManfCode FROM Item I WHERE I.ManfCode IN (:ai_manfcode)) I) S\nWHERE\n\tS.SubAreaCode = C.SubAreaCode AND\n\tS.CustCode = C.CustCode AND\n\tS.ICode = I.ICode AND\n\tS.ManfCode = I.ManfCode\nGROUP BY\n\tI.ManfCode,\n\tI.Manufacturer,\n\tC.SubAreaCode,\n\tC.SubArea,\n\tC.CustomerAlias,\n\tC.Customer,\n\tI.ICode,\n\tI.ItemAlias,\n\tI.ItemName\nORDER BY\n\tManufacturer,\n\tSubArea,\n\tCustomer,\n\tItemName\n",
  "arguments": {
