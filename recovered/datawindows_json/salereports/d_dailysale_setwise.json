    "dbname": "saleAmount"
   }
  ],
  "retrieve": "Select\ticode = ssh.seticode,\n\t\t\tI.Name,\n\t\t\tsaleqty = Sum(ssh.qty), \n\t\t\tsaleAmount = Sum(ssh.qty * ssh.SalePrice)\nFrom  \tSaleLedger sl,\tsalesetsheader ssh, Item I\nWhere  \tsl.Date Between :ar_sdate And :ar_edate And\n\t\t\tsl.saleinvcode = ssh.saleinvcode  And\n\t\t\tssh.seticode = I.Icode\nGroup By\tssh.seticode, I.Name\n\nUnion All\n\nSelect\ticode = sd.icode,\n\t\t\tI.Name,\n\t\t\tsaleqty = Sum(sd.looseqty),\n\t\t\tSaleAmount = Sum(sd.looseqty * sd.SalePrice)\nFrom  \tSaleLedger sl, SaleDetail sd, Item I\nWhere  \tsl.Date Between :ar_sdate And :ar_edate And\n\t\t\tsl.saleinvcode = sd.saleinvcode And\n\t\t\tsd.icode = I.Icode And\n\t\t\tsd.RowGroup Not In \t(\n\t\t\t\t\t\t\t\t\t\t\tSelect \tSaleSetsDetail.RowGroup \n\t\t\t\t\t\t\t\t\t\t\tFrom   \tSaleSetsHeader, SaleSetsDetail\n\t\t\t\t\t\t\t\t\t\t\tWhere  \tSaleSetsHeader.SaleInvCode = sl.SaleInvCode And\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tSaleSetsHeader.SetCode = SaleSetsDetail.SetCode And\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tSaleSetsDetail.ICode = sd.icode And\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tSaleSetsDetail.RowGroup = sd.RowGroup\n\t\t\t\t\t\t\t\t\t\t)\nGroup By sd.icode, I.Name\n",
  "arguments": {
   "_items": [
