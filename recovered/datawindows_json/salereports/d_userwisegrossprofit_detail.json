  ],
  "retrieve": "SELECT\t\n\tUserName = (SELECT U.UserName FROM Users U WHERE U.UserCode = S.SalesManCode),\n\tGroupType=:ar_group,\n\tGroupName= \n\t\tCASE :ar_group\n\t\tWHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)\n\t\tWHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)\n\t\tWHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)\n\t\tELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,   \n\tItemName=I.Name,\n\tAliasName = I.CustomICode,\n\tSales=SUM(S.Sales),\n\tRet=SUM(S.Ret),\n\tCGS=SUM(S.Cost),\n\tStock=ISNULL((SELECT SUM(GD.CurrQty * IT.AvgPrice) FROM GodownDetail GD, Item IT WHERE GD.ICode = I.ICode AND GD.ICode=IT.ICode), 0)\nFROM\t\n\t(SELECT\t\n\t\tTYPE='S', \n\t\tSD.ICode, \n\t\tSL.SalesManCode,\n\t\tSales=IsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2))  ,0),\n\t\tRet = 0.00,\n\t\tCost= - SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice)\n\tFROM\tSaleLedger SL, SaleDetail SD, Item I\n\tWHERE\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSL.Date BETWEEN :ar_startdate AND :ar_enddate AND\n\t\tSL.SalesManCode IN (:ar_usercode) AND\n\t\tSD.ICode = I.ICode AND\n\t\tCASE :ar_group\n\t\tWHEN 'M' THEN I.manfcode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ar_groupcode)\n\tGROUP BY SL.SaleInvCode, SL.SalesManCode, SD.ICode\n\tUNION ALL\n\tSELECT\tTYPE='S', SD.ICode, SL.SalesManCode, \n\t\tSales=IsNull( sum(round(((SD.looseqty) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2))  ,0),\n\t\tRet = 0.00,\n\t\tCost= - SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice)\n\tFROM\tSaleLedger SL, SaleInvDetail SD, Item I\n\tWHERE\tSL.ImpactInventory='N' AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSL.Date BETWEEN :ar_startdate AND :ar_enddate AND\n\t\tSL.SalesManCode IN (:ar_usercode) AND\n\t\tSD.ICode = I.ICode AND\n\t\tCASE :ar_group\n\t\tWHEN 'M' THEN I.manfcode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ar_groupcode)\n\tGROUP BY SL.SaleInvCode, SL.SalesManCode, SD.ICode\n\tUNION ALL\n\tSELECT\tTYPE='R', SD.ICode, SL.SalesManCode, \n\t\tSales = 0.00,\n\t\tRet = - IsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * SD.srprice ) * (1 - (.01 *  SD.discperc)),2))  ,0),\n\t\tCost = SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice)\n\tFROM\tSRLedger SL, SRDetail SD, Item I\n\tWHERE\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSL.Date BETWEEN :ar_startdate AND :ar_enddate AND\n\t\tSL.SalesManCode IN (:ar_usercode) AND\n\t\tSD.ICode = I.ICode AND\n\t\tCASE :ar_group\n\t\tWHEN 'M' THEN I.manfcode\n\t\tWHEN 'C' THEN I.ICatCode\n\t\tWHEN 'L' THEN I.ICCode\n\t\tELSE I.PACKCODE END IN (:ar_groupcode)\n\tGROUP BY SL.SRInvCode, SL.SalesManCode, SD.ICode) S,\n\tItem I\nWHERE\t\n\tS.ICode = I.ICode\nGROUP BY\n\tS.SalesManCode, \n\tI.ManfCode,\n\tI.ICatCode,\n\tI.ICCode,\n\tI.PackCode,\n\tI.name,\n\tI.customicode,\n\tI.Icode\nORDER BY\n\tUserName,\n\tGroupName,\n\tItemName\n",
