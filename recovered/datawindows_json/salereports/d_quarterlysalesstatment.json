  "retrieve": "SELECT\n\tCategory=IC.Name,  \n\tItem=I.Name,\n\tAliasName=I.CustomICode, \n\tPacking=I.PackingDesc, \n\tPrice=Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),\n\tQty1=SUM(CASE S.SLOT WHEN 1 THEN S.Qty ELSE 0 END),\n\tBonus1=SUM(CASE S.SLOT WHEN 1 THEN S.BonusQty ELSE 0 END),\n\tValue1=SUM(CASE S.SLOT WHEN 1 THEN CASE :ai_Price WHEN 1 THEN S.Value ELSE S.Qty * Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2) END ELSE 0 END),\n\tQty2=SUM(CASE S.SLOT WHEN 2 THEN S.Qty ELSE 0 END), \n\tBonus2=SUM(CASE S.SLOT WHEN 2 THEN S.BonusQty ELSE 0 END), \n\tValue2=SUM(CASE S.SLOT WHEN 2 THEN CASE :ai_Price WHEN 1 THEN S.Value ELSE S.Qty * Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2) END ELSE 0 END), \n\tQty3=SUM(CASE S.SLOT WHEN 3 THEN S.Qty ELSE 0 END),\n\tBonus3=SUM(CASE S.SLOT WHEN 3 THEN S.BonusQty ELSE 0 END), \n\tValue3=SUM(CASE S.SLOT WHEN 3 THEN CASE :ai_Price WHEN 1 THEN S.Value ELSE S.Qty * Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2) END ELSE 0 END)\nFROM \n(SELECT\n\tMNO=MAX(MONTH(sl.DATE)),\n\tinv=sl.saleinvcode,\n\tsd.icode,\n\ti.icatcode,\n\tqty = SUM(sd.looseqty),\n\tbonusqty = SUM(sd.bonusqty),\n\tValue = SUM((sd.looseqty * (sd.saleprice - sd.itemflatdisc)) * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),\n\tslot = CASE MAX(MONTH(sl.DATE)) \n\t\tWHEN :ai_smonth then 1 \n\t\tWHEN CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END THEN 2\n\t\tELSE 3 END\nFROM\n\tsaleledger sl,\n\tsaledetail sd, \n\titem i\nWHERE\n\t( (month(sl.date) = :ai_smonth AND year(sl.date) = :ai_syear) OR \n\t  (month(sl.date) = CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END AND\n\t   year(sl.date) = CASE WHEN (:ai_smonth + 1) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) OR\n\t  (month(sl.date) = CASE ((:ai_smonth + 2) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 2) % 12) END AND\n\t   year(sl.date) = CASE WHEN (:ai_smonth + 2) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) ) AND\n\tsl.saleinvcode = sd.saleinvcode and\n\tsd.icode = i.icode and\n\ti.icatcode in (:ai_icatcode)\nGROUP BY \n\t sl.saleinvcode,\n\t i.icatcode,\n\t sd.icode\nUNION ALL\nSELECT\n\tMNO=MAX(MONTH(sl.DATE)),\n\tinv=sl.saleinvcode,\n\tsd.icode,\n\ti.icatcode,\n\tqty = SUM(sd.looseqty),\n\tbonusqty = SUM(sd.bonusqty),\n\tValue = SUM((sd.looseqty * (sd.saleprice - sd.itemflatdisc)) * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),\n\tslot = CASE MAX(MONTH(sl.DATE)) \n\t\tWHEN :ai_smonth then 1 \n\t\tWHEN CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END THEN 2\n\t\tELSE 3 END\nFROM\n\tsaleledger sl,\n\tsaleinvdetail sd, \n\titem i\nWHERE\n\t( sl.impactinventory = 'N' ) AND\n\t( (month(sl.date) = :ai_smonth AND year(sl.date) = :ai_syear) OR \n\t  (month(sl.date) = CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END AND\n\t   year(sl.date) = CASE WHEN (:ai_smonth + 1) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) OR\n\t  (month(sl.date) = CASE ((:ai_smonth + 2) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 2) % 12) END AND\n\t   year(sl.date) = CASE WHEN (:ai_smonth + 2) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) ) AND\n\tsl.saleinvcode = sd.saleinvcode and\n\tsd.icode = i.icode and\n\ti.icatcode in (:ai_icatcode)\nGROUP BY \n\t sl.saleinvcode,\n\t i.icatcode,\n\t sd.icode\nUNION ALL\nSELECT\n\tMNO=:ai_smonth,\n\tinv=0,\n\ti.icode,\n\ti.icatcode,\n\tqty = 0,\n\tbonusqty = 0,\n\tValue = 0,\n\tslot = 1\nFROM\n\titem i\nWHERE\n\ti.icatcode in (:ai_icatcode)\nUNION ALL\nSELECT\n\tMNO=MAX(MONTH(sl.DATE)),\n\tinv=sl.srinvcode,\n\tsd.icode,\n\ti.icatcode,\n\tqty = - SUM(sd.looseqty),\n\tbonusqty = - SUM(sd.bonusqty),\n\tValue = - SUM(sd.looseqty * sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),\n\tslot = CASE MAX(MONTH(CASE :as_return WHEN 'A' THEN sl.DATE ELSE s.Date END)) \n\t\tWHEN :ai_smonth then 1 \n\t\tWHEN CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END THEN 2\n\t\tELSE 3 END\nFROM\n\tsrledger sl\n\tLEFT OUTER JOIN saleledger AS s ON (sl.saleinvcode = s.saleinvcode),\n\tsrdetail sd, \n\titem i\nWHERE\n\t( (month(sl.date) = :ai_smonth AND year(sl.date) = :ai_syear) OR \n\t  (month(sl.date) = CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END AND\n\t   year(sl.date) = CASE WHEN (:ai_smonth + 1) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) OR\n\t  (month(sl.date) = CASE ((:ai_smonth + 2) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 2) % 12) END AND\n\t   year(sl.date) = CASE WHEN (:ai_smonth + 2) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) ) AND\n\tsl.srinvcode = sd.srinvcode and\n\tsd.icode = i.icode and\n\ti.icatcode in (:ai_icatcode) AND\n\tIsNull(SL.saleinvcode,-1) IN (SELECT saleinvcode =\n\t\tCASE :as_return when 'A' THEN\n\t\t\tIsNull(SL.saleinvcode,-1) \n\t\tELSE\n\t\t\t(SELECT SaleLedger.SALEINVCODE FROM dbo.SaleLedger \n\t\t\tWHERE ( (month(SaleLedger.date) = :ai_smonth AND year(SaleLedger.date) = :ai_syear) OR \n\t\t\t  (month(SaleLedger.date) = CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END AND\n\t\t\t\tyear(SaleLedger.date) = CASE WHEN (:ai_smonth + 1) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) OR\n\t\t\t  (month(SaleLedger.date) = CASE ((:ai_smonth + 2) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 2) % 12) END AND\n\t\t\t\tyear(SaleLedger.date) = CASE WHEN (:ai_smonth + 2) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) ) AND \n\t\t\t\tSaleLedger.SALEINVCODE = sl.saleinvcode\n\t\t\t \n\t\t\t)\n\t\tEND\n\t\t)\nGROUP BY \n\t sl.srinvcode,\n\t sl.saleinvcode,\n\t i.icatcode,\n\t sd.icode) S, Item I, ItemCategory IC\nWHERE S.ICode = I.ICode AND I.ICatCode = IC.ICatCode\nGROUP BY \n\tIC.Name, \n\tI.Name, \n\tI.CustomICode,\n\tI.PackingDesc,\n\tI.SalePrice,\n\tI.PackUnits,\n\tI.ICODE,\n\tI.ICATCODE\nORDER BY \n\tIC.Name, \n\tI.Name, \n\tI.CustomICode",
  "arguments": {
   "_items": [
