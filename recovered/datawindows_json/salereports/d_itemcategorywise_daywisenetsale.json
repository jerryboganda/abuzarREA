  "retrieve": "SELECT  \n\tItemCategory=Ic.Name,\n\tdate=max(p.date),\n\tsalevalue=ROUND(SUM(CASE P.TYPE WHEN 'S' THEN +1 ELSE -1 END * P.itemvalue), 0)\nFROM \n(\nSELECT\n\ttype='S',\n\tsaleledger.saleinvcode,\n\tdate=CAST(CONVERT(VARCHAR(100), saleledger.date, 101) AS DATETIME), \n\tsaledetail.icode,\n\tItemValue=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),\n\tcatcode=saleledger.salecatcode,\n\tday_of_year=DATEPART(y, saleledger.date)\nFROM\n\tsaleledger,\tsaledetail, item\nWHERE\n\tsaleledger.saleinvcode = saledetail.saleinvcode AND \n\tsaleledger.date between :adt_startdate AND :adt_enddate and\n\tsaledetail.icode = item.icode and\n\titem.icatcode in (:ai_icatcode)\nGROUP BY \n\t saleledger.saleinvcode,\n\t saleledger.salesmancode,\n\t saledetail.icode,\n\t saleledger.salecatcode,\n\t saleledger.discperc,\n\t saleledger.flatdisc,\n\t saleledger.invgstperc1,\n\t saleledger.salecatcode,\n\t DATEPART(y, saleledger.date),\n\t CAST(CONVERT(VARCHAR(100), saleledger.date, 101) AS DATETIME)\nUNION ALL\nSELECT\n\ttype='S',\n\tsaleledger.saleinvcode,\n\tdate=CAST(CONVERT(VARCHAR(100), saleledger.date, 101) AS DATETIME), \n\tsaledetail.icode,\n\tItemValue=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),\n\tcatcode=saleledger.salecatcode,\n\tday_of_year=DATEPART ( y , saleledger.date )\nFROM\n\tsaleledger,\tsaleinvdetail saledetail, item\nWHERE\n\tsaleledger.impactinventory='N' AND\n\tsaleledger.saleinvcode = saledetail.saleinvcode AND \n\tsaleledger.date between :adt_startdate AND :adt_enddate and\n\tsaledetail.icode = item.icode and\n\titem.icatcode in (:ai_icatcode)\nGROUP BY \n\t saleledger.saleinvcode,\n\t saleledger.salesmancode,\n\t saledetail.icode,\n\t saleledger.salecatcode,\n\t saleledger.discperc,\n\t saleledger.flatdisc,\n\t saleledger.invgstperc1,\n\t saleledger.salecatcode,\n\t DATEPART(y, saleledger.date),\n\t CAST(CONVERT(VARCHAR(100), saleledger.date, 101) AS DATETIME)\nUNION ALL\nSELECT\n\ttype='R',\n\tsrledger.srinvcode,\n\tdate=CAST(CONVERT(VARCHAR(100), srledger.date, 101) AS DATETIME), \n\tsrdetail.icode,\n\tItemValue=SUM((srdetail.looseqty * srdetail.srprice * (1 - (.01 * srdetail.discperc))) * (1 - (.01 * srledger.discperc))),\n\tcatcode=srledger.srcatcode,\n\tday_of_year=DATEPART ( y , srledger.date )\nFROM\n\tsrledger,\t srdetail, item\nWHERE\n\tsrledger.srinvcode = srdetail.srinvcode  AND \n\tsrledger.date between :adt_startdate AND :adt_enddate and\n\tsrdetail.icode = item.icode and\n\titem.icatcode in (:ai_icatcode)\nGROUP BY\n\t srledger.srinvcode,\n\t srledger.salesmancode,\n\t srdetail.icode,\n\t srledger.srcatcode,\n\t srledger.discperc,\n\t srledger.flatdisc,\n\t srledger.invgstperc1,\n\t srledger.srcatcode,\n\t DATEPART(y, srledger.date),\n\t CAST(CONVERT(VARCHAR(100), srledger.date, 101) AS DATETIME)) P, ItemCategory IC, Item I\nWHERE\n\tP.Icode = I.Icode AND \n\tI.ICatCode = IC.ICatCode\nGROUP BY \n\tIc.Name,\n\tday_of_year\nORDER BY \n\tIc.Name,\n\tday_of_year\n\n",
  "arguments": {
