  "retrieve": "SELECT  \n\tInvoiceCode=S.SaleInvCode,\n\tHeaderInvCode=S.HeaderInvNo,\n\tHeaderNo=S.HeaderNo,\n\tDate=Date,\n\tCustomer=A.Name, \n\tbranch=C.address2,\n\tAliasName=A.AliasName,\n\tAddress= RTRIM(LTRIM(C.Address1)) + ' ' + RTRIM(LTRIM(C.Address2)),\n\tCity=C.CITY, \n\tCountry=C.Country,\n\tNetAmt=InvTotal,\n\tBalance=S.OutstandingAmt,\n\tPosted=S.Posted,\n\tAccountFor=S.AccountFor,\n\tRefNo=S.CustRefNo\nFROM SaleLedger S, Accounts A, Customer C, (SELECT Acccode FROM dbo.udf_GetSummaryAccountList(:ai_acccode)) T\nWHERE\n\tS.OutstandingAmt  <> 0 and\n\tS.AccountFor = 'Y' AND\n\tS.Marked = 'N' AND\n\tS.SaleCatCode IN (1,2) AND\n\tS.CustCode = T.AccCode AND\n\tS.CustCode = A.AccCode AND\n\tA.AccCode = C.CustCode\n\n\n\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_acccode",
      "number"
     ]
    }
   ]
  },
  "sort": "invoicecode A, date A"
 },
