  "retrieve": "   SELECT invcode     = dbo.srledger.srinvcode,    \n         date        = dbo.srledger.date,    \n         flatdisc    = dbo.srledger.flatdisc, \n\t\t\tsalestax    = dbo.srledger.salestax,       \n         misccharges = dbo.srledger.misccharges, \n\t\t\tinvdiscperc = dbo.srledger.discperc, \n\t\t\tdoctype = Case dbo.srledger.srcatcode When 6 Then 'Cash' When 7 Then 'Credit' Else 'Cash' End, \n         dbo.accounts.name,  \n         amount =  Round(Sum ( dbo.srdetail.looseqty * dbo.srdetail.srprice), 2),    \n\t\t\titemdiscpercvalue = Round(Sum ( dbo.srdetail.looseqty  * dbo.srdetail.srprice * (dbo.srdetail.discperc * .01) ), 2),    \n    \t\tinvdiscpercvalue = Round(Sum ( (dbo.srdetail.looseqty  ) * dbo.srdetail.srprice * (1 - (dbo.srdetail.discperc * .01))) * (dbo.srledger.discperc /100), 2),\n\t\t/*\tcustrefno = dbo.srledger.custrefno,\t       */\n\t\t\tremarks = dbo.srledger.remarks\t\n\n    FROM dbo.srledger, \n         dbo.srdetail,   \n         dbo.accounts  \n\n   WHERE dbo.srledger.srinvcode = dbo.srdetail.srinvcode and  \n\t\t \t(dbo.srledger.custcode >= ( Case :al_CustCode When 0 Then 10 Else :al_CustCode End) and \n\t\t\tdbo.srledger.custcode  <= ( Case :al_CustCode When 0 THEN (Select max(custcode) From Customer) Else :al_CustCode End )) and\n\t\t\tdbo.srledger.srcatcode IN (6, 7, 8) and\n\t\t/*\tdbo.srledger.srinvcode NOT IN (select distinct srledger.srinvcode from srledger where srledger.date between :ad_StartDate and :ad_EndDate and srledger.srinvcode IS NOT NULL) and*/\n         dbo.srledger.custcode = dbo.accounts.acccode and\t\n\t\t\tdbo.srledger.date between :ad_StartDate and :ad_EndDate \n\nGROUP BY dbo.srledger.misccharges,   \n         dbo.srledger.flatdisc,   \n         dbo.srledger.date,   \n         dbo.srledger.srinvcode,   \n\t\t\tdbo.srledger.discperc,  \n\t\t\tdbo.srledger.salestax, \n\t\t\tdbo.srledger.srcatcode, \n\t\t\tdbo.accounts.name,\t\n\t\t/*\tdbo.srledger.custrefno,\t */\n\t\t\tdbo.srledger.remarks\n         \nORDER BY dbo.srledger.srinvcode ASC,   \n         dbo.srledger.date ASC   \n\n",
  "arguments": {
