  "retrieve": "SELECT \n\tDate = CAST(CONVERT(VARCHAR(100), A.Date, 111) AS DATETIME),\n\titemname = A.itemname, \n\tSubCategory = (A.ItemClass),\n\tlooseqty = Sum (A.looseqty),\n\tprice = max(A.price),    \n\tID = MAX(A.ID),\n\tcumulativesum = round(0.0000,2),\n\tcumulativesumfoot = round(0.0000,2)\nFROM\n\t(SELECT\n\t\t\t Date=CASE lower(:as_datetype) \n\t\t\t\t\t When 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t When 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t When 'billingdate' Then dbo.saleledger.billingdate\n\t\t\t\tEND,\n\t\t\t itemname = item.name, \n\t\t\t icode=saledetail.icode,\n\t\t\t ItemClass = (dbo.ItemClass.name),\n\t\t\t looseqty = Sum (dbo.saledetail.looseqty),\n\t\t\t price = max(dbo.saledetail.saleprice),    \n\t\t\t ID = MAX(dbo.saledetail.RowId)/*,\n\t\t\t cumulativesum = round(0.0000,2),\n\t\t\t cumulativesumfoot = round(0.0000,2)*/\n\tFROM \t dbo.saleledger, \n\t\t\t dbo.saledetail,\n\t\t\t dbo.item,\n\t\t\t dbo.Customer,\n\t\t\t dbo.Accounts,\n\t\t\t dbo.ItemClass \n\tWHERE  \n\t\t\t CASE lower(:as_datetype) \n\t\t\t\t\t When 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t When 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t When 'billingdate' Then dbo.saleledger.billingdate\n\t\t\t\tEND between :ad_StartDate and :ad_EndDate and\n\t\t\t dbo.saleledger.custcode  IN ( :al_custcode ) AND\n\t\t\t dbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t\t dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND\n\t\t\t dbo.saledetail.icode = item.icode AND\n\t\t\t dbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t\t dbo.customer.custcode = dbo.accounts.acccode AND\n\t\t\t dbo.Item.ICCode = dbo.ItemClass.ICCode\n\tGroup by \n\t\t\tdbo.saleledger.originaldate,\n\t\t\tdbo.saleledger.date,\n\t\t\tdbo.saleledger.billingdate,\n\t\t\tdbo.saledetail.icode,\n\t\t\tdbo.item.name,\n\t\t\tdbo.ItemClass.name\n\tUNION ALL\n\tSELECT \n\t\t\tDate=CASE lower(:as_datetype) \n\t\t\t\t\t When 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t When 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t When 'billingdate' Then dbo.saleledger.billingdate\n\t\t\t\tEND,\n\t\t\titemname = item.name, \n\t\t\ticode=saledetail.icode,\n\t\t\tItemClass = (dbo.ItemClass.name),\n\t\t\tlooseqty = Sum (saledetail.looseqty),\n\t\t\tprice = max(saledetail.saleprice),    \n\t\t\tID = MAX(saledetail.RowId)/*,\n\t\t\tcumulativesum = round(0.0000,2),\n\t\t\tcumulativesumfoot = round(0.0000,2)*/\n\t\n\tFROM \n\t\t\tdbo.saleledger, \n\t\t\tsaleinvdetail saledetail,    \n\t\t\tdbo.item, \n\t\t\tdbo.Customer,\n\t\t\tdbo.Accounts,\n\t\t\tdbo.ItemClass \n\tWHERE  \n\t\t\tCASE lower(:as_datetype) \n\t\t\t\t\t When 'originaldate' Then dbo.saleledger.originaldate \n\t\t\t\t\t When 'lastsavingdate' Then dbo.saleledger.date\n\t\t\t\t\t When 'billingdate' Then dbo.saleledger.billingdate\n\t\t\t\tEND between :ad_StartDate and :ad_EndDate and\n\t\t\tdbo.saleledger.custcode  IN ( :al_custcode ) AND\n\t\t\tdbo.saleledger.ImpactInventory='N' AND\n\t\t\tdbo.saleledger.salecatcode IN (1, 2, 3) AND\n\t\t\tdbo.saleledger.saleinvcode = saledetail.saleinvcode AND\n\t\t\tsaledetail.icode = item.icode AND \n\t\t\tdbo.saleledger.custcode = dbo.customer.custcode AND\n\t\t\tdbo.customer.custcode = dbo.accounts.acccode AND\n\t\t\tdbo.Item.ICCode = dbo.ItemClass.ICCode\n\tGroup by \n\t\t\tdbo.saleledger.originaldate,\n\t\t\tdbo.saleledger.date,\n\t\t\tdbo.saleledger.billingdate,\n\t\t\tsaledetail.icode,\n\t\t\tdbo.item.name,\n\t\t\tdbo.ItemClass.name) as A\nGROUP BY\n\tCAST(CONVERT(VARCHAR(100), A.Date, 111) AS DATETIME),\n\tA.icode,\n\tA.itemname,\n\tA.ItemClass",
