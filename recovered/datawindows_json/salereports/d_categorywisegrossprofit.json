  "retrieve": "SELECT\t\n\tCategory=R.Category,\n\tR.ICatCode,\n\tSales=ROUND(SUM(R.Sales), 0),\n\tRet=ROUND(SUM(R.Ret), 0),\n\tCGS=ROUND(SUM(R.CGS), 0),\n\tStock=ROUND(SUM(R.Stock), 0)\nFROM\n\t(SELECT\t \n\t\tCategory=IC.name,\n\t\tIC.ICatCode,\n\t\tSales=ROUND(SUM(\n\t\t\tCASE S.TYPE WHEN 'S' THEN \n\t\t\t\tS.itemvalue - (S.flatdisc * (S.itemvalue/\n\t\t\t\t\tCASE S.grossamt WHEN 0 THEN 1 ELSE S.grossamt END))\n\t\t\tELSE 0 END), 0),\n\t\tRet=0,\n\t\tCGS=-SUM(S.Cost),\n\t\tStock=0\n\tFROM\t\n\t\t(SELECT\n\t\t\tSL.saleinvcode,\n\t\t\tSD.icode,\n\t\t\tCost = SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice),\n\t\t\tGrossValue = SUM(SD.looseqty * SD.saleprice ) ,\n\t\t\tItemDiscValue = SUM((SD.looseqty * (SD.saleprice - SD.itemflatdisc))*\n\t\t\t\t\t\t\t\t (.01 * SD.discperc) + SD.itemflatdisc ),\n\t\t\tInvItemDiscValue = SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*\n\t\t\t\t\t\t\t\t\t(1 - (.01 * SD.discperc) ) *  (.01 * SL.discperc) ),\n\t\t\tItemValue=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*\n\t\t\t\t(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc)),\n\t\t\tGrossAmt=\n\t\t\t\tisnull((SELECT ISNULL(SUM((SDD.looseqty*(SDD.saleprice - SDD.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * SDD.discperc)) * (1- (.01 * SLL.discperc))), 0)\n\t\t\t\tFROM\tsaledetail SDD, saleledger SLL\n\t\t\t\tWHERE SLL.saleinvcode=SL.saleinvcode and SLL.saleinvcode=SDD.saleinvcode\n\t\t\t\tGROUP BY SLL.saleinvcode), 0),\n\t\t\tSL.flatdisc,\n\t\t\tcatcode=SL.salecatcode,\n\t\t\ttype='S'\n\t\t\n\t\tFROM\n\t\t\tsaleledger SL,\t \n\t\t\tsaledetail SD\n\t\t\n\t\tWHERE\n\t\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\t\tSL.Date >= :ar_startdate AND SL.Date <= :ar_enddate AND\n\t\t\tSL.SaleCatCode IN (:ai_salecatcode)\n\n\t\tGROUP BY \n\t\t\t SL.saleinvcode,\n\t\t\t SL.salesmancode,\n\t\t\t SD.icode,\n\t\t\t SL.salecatcode,\n\t\t\t SL.discperc,\n\t\t\t SL.flatdisc,\n\t\t\t SL.invgstperc1,\n\t\t\t SL.salecatcode\n\t\tUNION ALL\n\t\tSELECT\n\t\t\tSL.saleinvcode,\n\t\t\tSD.icode,\n\t\t\tCost = SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice),\n\t\t\tGrossValue = SUM(SD.looseqty * SD.saleprice ) ,\n\t\t\tItemDiscValue = SUM((SD.looseqty * (SD.saleprice - SD.itemflatdisc))*\n\t\t\t\t\t\t\t\t (.01 * SD.discperc) + SD.itemflatdisc ),\n\t\t\tInvItemDiscValue = SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*\n\t\t\t\t\t\t\t\t\t(1 - (.01 * SD.discperc) ) *  (.01 * SL.discperc) ),\n\t\t\tItemValue=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*\n\t\t\t\t(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc)),\n\t\t\tGrossAmt=\n\t\t\t\tisnull((SELECT ISNULL(SUM((SDD.looseqty*(SDD.saleprice - SDD.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * SDD.discperc)) * (1- (.01 * SLL.discperc))), 0)\n\t\t\t\tFROM\tsaledetail SDD, saleledger SLL\n\t\t\t\tWHERE SLL.saleinvcode=SL.saleinvcode and SLL.saleinvcode=SDD.saleinvcode\n\t\t\t\tGROUP BY SLL.saleinvcode), 0),\n\t\t\tSL.flatdisc,\n\t\t\tcatcode=SL.salecatcode,\n\t\t\ttype='S'\n\t\t\n\t\tFROM\n\t\t\tsaleledger SL,\t \n\t\t\tsaleinvdetail SD\n\t\t\n\t\tWHERE\n\t\t\tSL.ImpactInventory = 'N' AND\n\t\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\t\tSL.Date >= :ar_startdate AND SL.Date <= :ar_enddate AND\n\t\t\tSL.SaleCatCode IN (:ai_salecatcode)\n\n\t\tGROUP BY \n\t\t\t SL.saleinvcode,\n\t\t\t SL.salesmancode,\n\t\t\t SD.icode,\n\t\t\t SL.salecatcode,\n\t\t\t SL.discperc,\n\t\t\t SL.flatdisc,\n\t\t\t SL.invgstperc1,\n\t\t\t SL.salecatcode) S,\n\t\tItem I, \n\t\t(SELECT ICatCode = M.ManfCode, Name=M.Name \n\t\tFROM Manufacturer M \n\t\tWHERE :as_group = 'M'\n\t\tUNION ALL\n\t\tSELECT ICatCode = C.ICatCode, Name=C.Name \n\t\tFROM ItemCategory C \n\t\tWHERE :as_group = 'C'\n\t\tUNION ALL\n\t\tSELECT ICatCode = L.ICCode, Name=L.Name \n\t\tFROM ItemClass L \n\t\tWHERE :as_group = 'L'\n\t\tUNION ALL\n\t\tSELECT ICatCode = P.PackCode, Name=P.Name \n\t\tFROM ItemPacking P \n\t\tWHERE :as_group = 'P') IC\n\tWHERE\t\n\t\tS.ICode = I.ICode AND\n\t\tCASE :as_group \n\t\t\tWHEN 'M' THEN I.ManfCode \n\t\t\tWHEN 'C' THEN I.ICatCode \n\t\t\tWHEN 'L' THEN I.ICCode \n\t\t\tWHEN 'P' THEN I.PackCode \n\t\tEND = IC.ICatCode\n\tGROUP BY \n\t\tIC.name,\n\t\tIC.ICatCode\n\tUNION ALL\n\tSELECT\t\n\t\tCategory=IC.name,\n\t\tIC.ICatCode,\n\t\tSales=0,\n\t\tRet=-ROUND(SUM(\n\t\tCASE S.TYPE WHEN 'R' THEN\n\t\t\tS.itemvalue - (S.flatdisc*(S.itemvalue/\n\t\t\t\tCASE S.grossamt WHEN 0 THEN 1 \n\t\t\t\tELSE S.grossamt END)) \n\t\tELSE 0 END), 0),\n\t\tCGS=SUM(S.Cost),\n\t\tStock=0\n\tFROM\t\n\t\t(SELECT\n\t\t\tSL.srinvcode,\n\t\t\tSD.icode,\n\t\t\tCost = SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice),\n\t\t\tGrossValue = SUM( SD.looseqty * SD.srprice ) ,\n\t\t\tItemDiscValue = SUM((SD.looseqty * SD.srprice ) * (.01 * SD.discperc) ),\n\t\t\tInvItemDiscValue = SUM( ( (SD.looseqty * SD.srprice) *\n\t\t\t\t\t\t\t\t\t\t(1 - (.01 * SD.discperc) ) ) * (.01 * SL.discperc) ),\n\t\t\tItemValue=SUM((SD.looseqty * SD.srprice *\n\t\t\t\t(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc))),\n\t\t\tGrossAmt=ISNULL((SELECT SUM((SDD.looseqty * SDD.srprice *\n\t\t\t\t\t(1 - (.01 * SDD.discperc))) * (1- (.01 * SLL.discperc)))\n\t\t\t\tFROM\tsrdetail SDD, srledger SLL\n\t\t\t\tWHERE SLL.srinvcode=SL.srinvcode and SLL.srinvcode=SDD.srinvcode\n\t\t\t\tGROUP BY SLL.srinvcode), 0),\n\t\t\tSL.flatdisc,\n\t\t\tcatcode=SL.srcatcode,\n\t\t\ttype='R'\n\t\t\n\t\tFROM\n\t\t\tsrledger SL,\t \n\t\t\tsrdetail SD\n\t\t\n\t\tWHERE\n\t\t\tSL.SRInvCode = SD.SRInvCode AND\n\t\t\tSL.Date >= :ar_startdate AND SL.Date <= :ar_enddate AND\n\t\t\tSL.SRCatCode IN (:ai_salecatcode)\n\t\t\n\t\tGROUP BY\n\t\t\t SL.srinvcode,\n\t\t\t SL.salesmancode,\n\t\t\t SD.icode,\n\t\t\t SL.srcatcode,\n\t\t\t SL.discperc,\n\t\t\t SL.flatdisc,\n\t\t\t SL.invgstperc1,\n\t\t\t SL.srcatcode) S,\n\t\tItem I, \n\t\t(SELECT ICatCode = M.ManfCode, Name=M.Name \n\t\tFROM Manufacturer M \n\t\tWHERE :as_group = 'M'\n\t\tUNION ALL\n\t\tSELECT ICatCode = C.ICatCode, Name=C.Name \n\t\tFROM ItemCategory C \n\t\tWHERE :as_group = 'C'\n\t\tUNION ALL\n\t\tSELECT ICatCode = L.ICCode, Name=L.Name \n\t\tFROM ItemClass L \n\t\tWHERE :as_group = 'L'\n\t\tUNION ALL\n\t\tSELECT ICatCode = P.PackCode, Name=P.Name \n\t\tFROM ItemPacking P \n\t\tWHERE :as_group = 'P') IC\n\tWHERE\t\n\t\tS.ICode = I.ICode AND\n\t\tCASE :as_group \n\t\t\tWHEN 'M' THEN I.ManfCode \n\t\t\tWHEN 'C' THEN I.ICatCode \n\t\t\tWHEN 'L' THEN I.ICCode \n\t\t\tWHEN 'P' THEN I.PackCode \n\t\tEND = IC.ICatCode\n\tGROUP BY \n\t\tIC.name,\n\t\tIC.ICatCode\n\tUNION ALL\n\tSELECT\t\n\t\tCategory=IC.name,\n\t\tIC.ICatCode,\n\t\tSales=0,\n\t\tRet=0,\n\t\tCGS=0,\n\t\tStock=SUM(S.CurrQty * I.AvgPrice)\n\tFROM\t\n\t\tGodownDetail S, \n\t\tItem I, \n\t\t(SELECT ICatCode = M.ManfCode, Name=M.Name \n\t\tFROM Manufacturer M \n\t\tWHERE :as_group = 'M'\n\t\tUNION ALL\n\t\tSELECT ICatCode = C.ICatCode, Name=C.Name \n\t\tFROM ItemCategory C \n\t\tWHERE :as_group = 'C'\n\t\tUNION ALL\n\t\tSELECT ICatCode = L.ICCode, Name=L.Name \n\t\tFROM ItemClass L \n\t\tWHERE :as_group = 'L'\n\t\tUNION ALL\n\t\tSELECT ICatCode = P.PackCode, Name=P.Name \n\t\tFROM ItemPacking P \n\t\tWHERE :as_group = 'P') IC\n\tWHERE\t\n\t\tS.ICode = I.ICode AND\n\t\tCASE :as_group \n\t\t\tWHEN 'M' THEN I.ManfCode \n\t\t\tWHEN 'C' THEN I.ICatCode \n\t\t\tWHEN 'L' THEN I.ICCode \n\t\t\tWHEN 'P' THEN I.PackCode \n\t\tEND = IC.ICatCode\n\tGROUP BY \n\t\tIC.name,\n\t\tIC.ICatCode) R\nGROUP BY \n\tR.Category,\n\tR.ICatCode\nORDER BY\n\tR.Category,\n\tR.ICatCode\n",
