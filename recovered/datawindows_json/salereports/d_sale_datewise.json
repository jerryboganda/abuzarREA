    "dbname": "CreditSale"
   }
  ],
  "retrieve": "SELECT\n\tDAY=datepart(dd,date),\n\tInvCount= Count(SaleType), \n\tSaleValue=sum(netamount),\n\tCashInvCount= SUM(CASE SaleType WHEN 'CASH' THEN 1 ELSE 0 END), \n\tCreditInvCount= SUM(CASE SaleType WHEN 'CASH' THEN 0 ELSE 1 END),\n\tCashSale=sum(CASE SaleType WHEN 'Cash' THEN netamount ELSE 0 END),\n\tCreditSale=sum(CASE SaleType WHEN 'Cash' THEN 0 ELSE netamount END)\nFROM \n\t(SELECT\n\t\tdate= S.date,\n\t        saletype = Case S.salecatcode \n\t\t\t\tWhen 1 Then 'Cash' \n\t\t\t\tWhen 2 Then 'Credit' \n\t\t\t\tElse 'Cash' End, \n\t\tNetAmount=Round(SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + \n\t\t\t\tSUM(ROUND( (D.looseqty * (D.saleprice - D.itemflatdisc)) *\n\t\t\t\t(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +\n\t\t\t\tROUND( (SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) -\n\t\t\t\t\tS.flatdisc) * (S.invgstperc1 * .01), 2), 0) +\n\t\t\t\tRound(SUM((D.looseqty*(D.saleprice - D.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) + \n\t\t\t\t\tS.misccharges + S.salestax - S.flatdisc, 0)\n\tFROM \n\t\tdbo.saleledger S, \n\t\tdbo.saledetail D\n\tWHERE\n\t\tS.saleinvcode = D.saleinvcode and\n\t\tS.date between :ad_StartDate and :ad_EndDate\n\tGROUP BY S.saleinvcode,\n\t\t S.salecatcode,\n\t\t S.date,\n\t\t S.discperc,\n\t\t S.misccharges,\n\t\t S.salestax,\n\t\t S.flatdisc,\n\t\t S.invgstperc1,\n\t\t S.salesmancode\n\tUNION ALL\n\tSELECT\n\t\tdate= S.date,\n\t        saletype = Case S.salecatcode \n\t\t\t\tWhen 1 Then 'Cash' \n\t\t\t\tWhen 2 Then 'Credit' \n\t\t\t\tElse 'Cash' End, \n\t\tNetAmount=Round(SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + \n\t\t\t\tSUM(ROUND( (D.looseqty * (D.saleprice - D.itemflatdisc)) *\n\t\t\t\t(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +\n\t\t\t\tROUND( (SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) -\n\t\t\t\t\tS.flatdisc) * (S.invgstperc1 * .01), 2), 0) +\n\t\t\t\tRound(SUM((D.looseqty*(D.saleprice - D.itemflatdisc)) *\n\t\t\t\t\t(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) + \n\t\t\t\t\tS.misccharges + S.salestax - S.flatdisc, 0)\n\tFROM \n\t\tdbo.saleledger S, \n\t\tdbo.saleinvdetail D\n\tWHERE\n\t\tS.ImpactInventory = 'N' AND\n\t\tS.saleinvcode = D.saleinvcode and\n\t\tS.date between :ad_StartDate and :ad_EndDate\n\tGROUP BY S.saleinvcode,\n\t\t S.salecatcode,\n\t\t S.date,\n\t\t S.discperc,\n\t\t S.misccharges,\n\t\t S.salestax,\n\t\t S.flatdisc,\n\t\t S.invgstperc1,\n\t\t S.salesmancode) AS a\n\nGROUP BY\n\tdatepart(dd,date)\nORDER BY\n\tdatepart(dd,date) ASC  ",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ad_startdate",
      "datetime"
     ]
    },
    {
     "_items": [
      "ad_enddate",
      "datetime"
     ]
    }
   ]
  }
 },
