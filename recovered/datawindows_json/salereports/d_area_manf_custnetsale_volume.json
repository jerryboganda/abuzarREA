  "retrieve": "SELECT\n\tDate=CONVERT(DATETIME, (LTRIM(RTRIM(STR(MONTH(S.Date)))) + '/01/' + LTRIM(RTRIM(STR(YEAR(S.Date)))))),\n\tManufacturer=M.Name,\n\tAreaName=AR.Name,\n\tCustomerAlias=A.AliasName,\n\tCustomer=A.Name,\n\tAddress=C.Address1,\n\tNetSale=ISNULL(SUM(S.NetSale), 0),\n\tNetSaleVolume=ISNULL(SUM(S.NetSaleVolume), 0)\nFROM\n\tItem I,\n\tManufacturer M,\n\tArea AR, \n\tCustomer C,\n\tAccounts A,\n\t(SELECT\n\t\tC.CustCode,\n\t\tDate=:ad_enddate,\n\t\tICode=(SELECT MIN(ICODE) FROM ITEM WHERE ManfCode IN (:ai_manfcode)),\n\t\tNetSale = 0,\n\t\tNetSaleVolume = 0\n\tFROM Customer C\n\tWHERE C.AreaCode IN (:ai_areacode)\n\tUNION ALL\n\tSELECT\n\t\tS.CustCode,\n\t\tDate=S.Date,\n\t\tICode=SD.ICode,\n\t\tNetSale = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),\n\t\tNetSaleVolume = SUM(SD.LooseQty * I.PackingFactor)\n\tFROM\n\t\tSaleLedger S, SaleDetail SD, Item I, Customer C\n\tWHERE \n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tC.AreaCode IN (:ai_areacode) AND\n\t\tC.CustCode = S.CustCode AND\n\t\tS.SaleInvCode = SD.SaleInvCode AND \n\t\tSD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode)\n\tGROUP BY\n\t\tS.CustCode,\n\t\tS.SaleInvCode,\n\t\tS.Date,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT\n\t\tS.CustCode,\n\t\tDate=S.Date,\n\t\tICode=SD.ICode,\n\t\tNetSale = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),\n\t\tNetSaleVolume = SUM(SD.LooseQty * I.PackingFactor)\n\tFROM\n\t\tSaleLedger S, SaleInvDetail SD, Item I, Customer C\n\tWHERE \n\t\tS.ImpactInventory = 'N' AND\n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tC.AreaCode IN (:ai_areacode) AND\n\t\tC.CustCode = S.CustCode AND\n\t\tS.SaleInvCode = SD.SaleInvCode AND \n\t\tSD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode)\n\tGROUP BY\n\t\tS.CustCode,\n\t\tS.SaleInvCode,\n\t\tS.Date,\n\t\tSD.ICode\n\tUNION ALL\n\tSELECT\n\t\tS.CustCode,\n\t\tDate=S.Date,\n\t\tICode=SD.ICode,\n\t\tNetSale = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),\n\t\tNetSaleVolume = - SUM(SD.LooseQty * I.PackingFactor)\n\tFROM\n\t\tSRLedger S, SRDetail SD, Item I, Customer C\n\tWHERE \n\t\tS.Date >= :ad_startdate AND S.Date <= :ad_enddate AND\n\t\tC.AreaCode IN (:ai_areacode) AND\n\t\tC.CustCode = S.CustCode AND\n\t\tS.SRInvCode = SD.SRInvCode AND \n\t\tSD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode)\n\tGROUP BY\n\t\tS.CustCode,\n\t\tS.SRInvCode,\n\t\tS.Date,\n\t\tSD.ICode) S\nWHERE\n\tAR.AreaCode IN (:ai_areacode) AND\n\tAR.AreaCode = C.AreaCode AND\n\tC.CustCode = A.AccCode AND\n\tC.CustCode = S.CustCode AND\n\tS.ICode = I.ICode AND\n\tI.ManfCode IN (:ai_manfcode) AND\n\tI.ManfCode = M.ManfCode\nGROUP BY\n\tM.Name,\n\tAR.AreaCode,\n\tAR.Name,\n\tA.Name,\n\tA.AliasName,\n\tC.Address1,\n\tCONVERT(DATETIME, (LTRIM(RTRIM(STR(MONTH(S.Date)))) + '/01/' + LTRIM(RTRIM(STR(YEAR(S.Date))))))\nORDER BY\n\tM.Name,\n\tAreaName,\n\tCustomer\n",
