  "retrieve": "SELECT \n\titemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END,   \n\taliasname=item.customicode,   \n\tpackingdesc=max(item.packingdesc),   \n\taccname =(select name from accounts where acccode=:ar_custcode_for_print),   \n\taddress =(select address from customer where custcode=:ar_custcode_for_print),   \n\taddress2= (select address2 from customer where custcode=:ar_custcode_for_print), \n\tcp=(select cp from customer where custcode=:ar_custcode_for_print),\n\tpatient=(select name from patient where patient.patientcode=max(saleledger.patientcode)),\n\tcity= max(dbo.customer.city),\n\tlicenceno= max(dbo.customer.licenceno), \n\tusername= dbo.users.username,   \n\tsaleinvcode = dbo.saleledger.saleinvcode,   \n\theaderno = dbo.saleledger.headerno,   \n\tdate = dbo.saleledger.date, \n\tinvdiscperc = dbo.saleledger.discperc,   \n\tmisccharges = dbo.saleledger.misccharges,   \n\tflatdisc = dbo.saleledger.flatdisc,   \n\tinvsalestax = dbo.saleledger.salestax,   \n\ticode = saledetail.icode,   \n\tlooseqty = sum(saledetail.looseqty),   \n\tbonusqty = sum(saledetail.bonusqty),   \n\tpackqty = sum(saledetail.packqty),   \n\tpackunits= max(saledetail.packunits),   \n\tsaleprice= saledetail.saleprice,   \n\tdiscperc = saledetail.discperc,   \n\tsalestax = max(saledetail.salestax),  \n\titemflatdisc=saledetail.itemflatdisc,   \n\tId = max(dbo.saledetail.IDENTITYCOL),   \n\tposted=max(saleledger.posted),   \n\tbalance=0,   \n\tunitsalestax = saledetail.unitsalestax,   \n\tgstperc = saledetail.gstperc,   \n\tinvgstperc = max(saleledger.invgstperc1),   \n\tcustTaxRegno=max(customer.salestaxregno)  ,\n\tcustrefno=max(dbo.saleledger.custrefno),\t\n\tdbo.saleledger.remarks,\n\tprintwaranty=max(dbo.saleledger.printwaranty),\n\tprintbatch=max(dbo.saleledger.printbatch),\n\tsalesman=ltrim(rtrim(max(dbo.salesman.name))),\n\tMessage=ltrim(rtrim(max(dbo.Message.description))),\n\tCUSTALIAS=max(ACCOUNTS.ALIASNAME)\nFROM \n\tsaleledger\n\tLEFT OUTER JOIN DBO.SalesMan ON (dbo.saleledger.smancode = dbo.salesman.salesmancode)\n\tLEFT OUTER JOIN DBO.Message ON (dbo.saleledger.messagecode = dbo.message.messagecode),\n\tsaledetail,   \n\taccounts,   \n\tcustomer,   \n\tusers,   \n\titem  \n\t\nWHERE \n\t( dbo.saleledger.saleinvcode between :ar_SInvCode and :ar_linvcode ) AND  \n\t( dbo.saleledger.custcode = :ar_custcode ) AND \n\t( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND \n\t( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  \n\t( dbo.customer.custcode = dbo.accounts.acccode ) AND  \n\t( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  \n\t( dbo.saledetail.icode = dbo.item.icode)    \nGROUP BY\n\tsaleledger.saleinvcode, \n\tsaleledger.date, \n\tsaleledger.custcode, \n\tsaleledger.discperc, \n\tsaleledger.flatdisc, \n\tsaleledger.misccharges, \n\tsaleledger.headerno,\n\tsaleledger.salestax, \n\tsaleledger.remarks, \n\tsaledetail.icode, \n\tsaledetail.saleprice,\n\tsaledetail.itemflatdisc,\n\tsaledetail.discperc,\n\tsaledetail.gstperc,\n\tsaledetail.unitsalestax,\n\titem.name,\n\titem.icode,\n\titem.printable,\n\titem.customicode,\n\tusers.username\n\t\nORDER BY \n\tdbo.saleledger.saleinvcode,\n\tmax(dbo.saledetail.IDENTITYCOL)",
  "arguments": {
