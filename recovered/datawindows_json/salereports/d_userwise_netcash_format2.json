  "retrieve": "SELECT  \n\tReportType=1,\n\tReportGroup='Sales Summary',\n\tRowID=1,\n\tDescription= 'Total Sales',\n\tAmount = SUM(S.InvTotal),\n\tUserName=U.UserNAme,\n\tinvcount=count(saleinvcode)\nFROM \n\tSaleLedger S, Users U\nWHERE \n\tS.SalesManCode=:ai_usercode AND\n\tS.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\tS.SalesManCode=U.UserCode\nGROUP BY\n\tU.UserNAme\nUNION ALL\nSELECT \n\tReportType=1,\n\tReportGroup='Sales Summary',\n\tRowID=2,\n\tDescription= 'Credit Sales',\n\tAmount=-ISNULL(SUM(S.InvTotal), 0),\n\tUserName=U.UserNAme,\n\tinvcount=count(saleinvcode)\nFROM \n\tSaleLedger S, Users U\nWHERE \n\tS.SalesManCode=:ai_usercode AND\n\tS.CashCharged = 0 AND \n\tS.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\tS.SalesManCode=U.UserCode\nGROUP BY\n\tU.UserNAme\nUNION ALL\nSELECT \n\tReportType=1,\n\tReportGroup='Sales Summary',\n\tRowID=3,\n\tDescription= 'Partial Credit Sales',\n\tAmount = -ISNULL(SUM(S.InvTotal - S.CashCharged), 0),\n\tUserName=U.UserNAme,\n\tinvcount=count(saleinvcode)\nFROM \n\tSaleLedger S, Users U\nWHERE \n\tS.SalesManCode=:ai_usercode AND\n\tS.CashCharged > 0 AND S.CashCharged < S.InvTotal AND \n\tS.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\tS.SalesManCode=U.UserCode\nGROUP BY\n\tU.UserNAme\nUNION ALL\nSELECT \n\tReportType=1,\n\tReportGroup='Sales Summary',\n\tRowID=4,\n\tDescription= 'Cash Returns',\n\tAmount = -ISNULL(SUM(S.Amt), 0),\n\tUserName=S.UserNAme,\n\tinvcount=sum(s.invcount)\nFROM\n\t(SELECT \n\t\tamt=SUM(S.CashCharged), U.UserNAme,\n\t\tinvcount=count(srinvcode)\n\tFROM \n\t\tSRLedger S, Users U\n\tWHERE \n\t\tS.SalesManCode=:ai_usercode AND\n\t\t(S.CashCharged > 0) AND \n\t\tS.Date BETWEEN :ar_StartDate AND :ar_EndDate\t AND\n\t\tS.SalesManCode=U.UserCode\n\tGROUP BY\n\t\tU.UserNAme\n\tUNION ALL\n\tSELECT \n\t\tamt=SUM(S.InvTotal), U.UserNAme,\n\t\tinvcount=count(srinvcode)\n\tFROM \n\t\tSRLedger S, Users U\n\tWHERE \n\t\tS.SalesManCode=:ai_usercode AND\n\t\t(S.CashCharged = 0) AND \n\t\tS.Date BETWEEN :ar_StartDate AND :ar_EndDate\t AND\n\t\tS.SalesManCode=U.UserCode AND\n\t\tS.SRCatCode IN (6,8)\n\tGROUP BY\n\t\tU.UserNAme\t) s\nGROUP BY\n\tS.UserNAme\nUNION ALL\nSELECT \n\tReportType=2,\n\tReportGroup='Credit Customer Sales',\n\tRowID=1,\n\tDescription= A.Name,\n\tAmount = ISNULL(SUM(S.InvTotal - S.CashCharged), 0),\n\tUserName=U.UserNAme,\n\tinvcount=count(saleinvcode)\nFROM \n\tSaleLedger S, Users U, Accounts A\nWHERE \n\tS.SalesManCode=:ai_usercode AND\n\t((S.CashCharged > 0 AND S.CashCharged < S.InvTotal) OR (S.CashCharged=0)) AND\n\tS.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\tS.SalesManCode=U.UserCode AND\n\tS.CustCode=A.AccCode\nGROUP BY\n\tS.Custcode,\n\tA.Name,\n\tU.UserNAme\nUNION ALL\nSELECT \n\tReportType=3,\n\tReportGroup='Credit Cards Summary',\n\tRowID=1,\n\tDescription= A.Name,\n\tAmount = SUM(CW.Amount),\n\tUserName=U.UserNAme,\n\tinvcount=count(S.saleinvcode)\nFROM \n\tSaleLedger S, Users U, Accounts A, Cashierwindow CW\nWHERE \n\tS.SalesManCode=:ai_usercode AND\n\tS.Date BETWEEN :ar_StartDate AND :ar_EndDate AND\n\tS.SalesManCode=U.UserCode AND\n\tS.SaleInvCode = CW.SaleInvCode AND\n\tCW.AccCode=A.AccCode\nGROUP BY\n\tCW.AccCode,\n\tA.Name,\n\tU.UserNAme\nORDER BY\n\tReportType, RowID",
  "arguments": {
