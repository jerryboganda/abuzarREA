  "retrieve": "SELECT\n\tDoctCode=D.DoctCode,\n\tDoctorName=Dt.Name,\n\tICatCode=C.ICatCode,\n\tCategory=C.Name,\n\tI.ICode,\n\tAliasName=I.CustomICode,\n\tItemName=I.Name,  \n\tQty=ISNULL(SUM(D.saleqty), 0),\n \tSaleAmount=ISNULL(SUM(CASE D.TYPE WHEN 'S' THEN +1 ELSE -1 END * \n\t\t(D.itemvalue - (D.flatdisc * (D.itemvalue / CASE D.grossamt WHEN 0 THEN 1 ELSE D.grossamt END)))), 0),\n\tItemCost=ISNULL(SUM(D.itemcost), 0),\n\tMargin=ISNULL((ISNULL(SUM(CASE D.TYPE WHEN 'S' THEN +1 ELSE -1 END * \n\t\t(D.itemvalue - (D.flatdisc * (D.itemvalue / CASE D.grossamt WHEN 0 THEN 1 ELSE D.grossamt END)))), 0) - \n\t\tSUM(D.itemcost) ) * 100 / \n\t\tCase ISNULL(SUM(CASE D.TYPE WHEN 'S' THEN +1 ELSE -1 END * \n\t\t\t\t(D.itemvalue - (D.flatdisc * (D.itemvalue / CASE D.grossamt WHEN 0 THEN 1 ELSE D.grossamt END)))), 0) \n\t\tWHEN 0 THEN 1 ELSE ISNULL(SUM(CASE D.TYPE WHEN 'S' THEN +1 ELSE -1 END * \n\t\t(D.itemvalue - (D.flatdisc * (D.itemvalue / CASE D.grossamt WHEN 0 THEN 1 ELSE D.grossamt END)))), 0) END,  0),\n\tBonus=ISNULL(SUM(D.bonus), 0)\nFROM\n\t(SELECT ICatCode = M.ManfCode, Name=M.Name \n\tFROM Manufacturer M \n\tWHERE :as_group = 'M'\n\tUNION ALL\n\tSELECT ICatCode = C.ICatCode, Name=C.Name \n\tFROM ItemCategory C \n\tWHERE :as_group = 'C'\n\tUNION ALL\n\tSELECT ICatCode = L.ICCode, Name=L.Name \n\tFROM ItemClass L \n\tWHERE :as_group = 'L'\n\tUNION ALL\n\tSELECT ICatCode = P.PackCode, Name=P.Name \n\tFROM ItemPacking P \n\tWHERE :as_group = 'P') C,\n\tItem I,\n\tDoctors Dt \n\tLEFT OUTER JOIN \n \t(SELECT\n\t\tSL.saleinvcode,\n\t\tSD.icode,\n\t\tSL.Doctcode,\n\t\tSaleQty=ISNULL(sum(SD.looseqty), 0) ,\n\t\tBonus=ISNULL(sum(SD.bonusqty), 0) ,\n\t\tItemCost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)), 2), 0),\n\t\tGrossValue = SUM(SD.looseqty * SD.saleprice ),\n\t\tItemDiscValue = SUM((SD.looseqty * (SD.saleprice - SD.itemflatdisc))*\n\t\t\t\t\t\t\t (.01 * SD.discperc) + SD.itemflatdisc ),\n\t\tInvItemDiscValue = SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*\n\t\t\t\t\t\t\t\t(1 - (.01 * SD.discperc) ) *  (.01 * SL.discperc) ),\n\t\tItemValue=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*\n\t\t\t(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc)),\n\t\tGrossAmt=\n\t\t\t(SELECT SUM((SDD.looseqty*(SDD.saleprice - SDD.itemflatdisc)) *\n\t\t\t\t(1 - (.01 * SDD.discperc)) * (1- (.01 * SLL.discperc)))\n\t\t\tFROM\tsaledetail SDD, saleledger SLL\n\t\t\tWHERE SLL.saleinvcode=SL.saleinvcode and SLL.saleinvcode=SDD.saleinvcode\n\t\t\tGROUP BY SLL.saleinvcode),\n\t\tSL.flatdisc,\n\t\tcatcode=SL.salecatcode,\n\t\ttype='S'\n\tFROM\n\t\tsaleledger SL,\t \n\t\tsaledetail SD,\n\t\titem I\n\tWHERE\t\n\t\tSD.icode=I.icode AND\n\t\tCASE :as_group \n\t\t\tWHEN 'M' THEN I.ManfCode \n\t\t\tWHEN 'C' THEN I.ICatCode \n\t\t\tWHEN 'L' THEN I.ICCode \n\t\t\tWHEN 'P' THEN I.PackCode \n\t\tEND IN (:ala_icatcode) AND\n\t\tSD.saleinvcode=SL.saleinvcode AND\n\t\tSL.date BETWEEN :adt_sdate AND :adt_ldate\n\tGROUP BY \n\t\t SL.saleinvcode,\n\t\t SL.salesmancode,\n\t\t SD.icode,\n\t\t SL.Doctcode,\n\t\t SL.salecatcode,\n\t\t SL.discperc,\n\t\t SL.flatdisc,\n\t\t SL.invgstperc1,\n\t\t SL.salecatcode\n\tUNION ALL\n\tSELECT\n\t\tSL.saleinvcode,\n\t\tSD.icode,\n\t\tSL.Doctcode,\n\t\tSaleQty=ISNULL(sum(SD.looseqty), 0) ,\n\t\tBonus=ISNULL(sum(SD.bonusqty), 0) ,\n\t\tItemCost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)), 2), 0),\n\t\tGrossValue = SUM(SD.looseqty * SD.saleprice ),\n\t\tItemDiscValue = SUM((SD.looseqty * (SD.saleprice - SD.itemflatdisc))*\n\t\t\t\t\t\t\t (.01 * SD.discperc) + SD.itemflatdisc ),\n\t\tInvItemDiscValue = SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*\n\t\t\t\t\t\t\t\t(1 - (.01 * SD.discperc) ) *  (.01 * SL.discperc) ),\n\t\tItemValue=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*\n\t\t\t(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc)),\n\t\tGrossAmt=\n\t\t\t(SELECT SUM((SDD.looseqty*(SDD.saleprice - SDD.itemflatdisc)) *\n\t\t\t\t(1 - (.01 * SDD.discperc)) * (1- (.01 * SLL.discperc)))\n\t\t\tFROM\tsaleinvdetail SDD, saleledger SLL\n\t\t\tWHERE SLL.ImpactInventory='N' AND SLL.saleinvcode=SL.saleinvcode and SLL.saleinvcode=SDD.saleinvcode\n\t\t\tGROUP BY SLL.saleinvcode),\n\t\tSL.flatdisc,\n\t\tcatcode=SL.salecatcode,\n\t\ttype='S'\n\tFROM\n\t\tsaleledger SL,\t \n\t\tsaleinvdetail SD,\n\t\titem I\n\tWHERE\t\n\t\tSL.ImpactInventory='N' AND\n\t\tSD.icode=I.icode AND\n\t\tCASE :as_group \n\t\t\tWHEN 'M' THEN I.ManfCode \n\t\t\tWHEN 'C' THEN I.ICatCode \n\t\t\tWHEN 'L' THEN I.ICCode \n\t\t\tWHEN 'P' THEN I.PackCode \n\t\tEND IN (:ala_icatcode) AND\n\t\tSD.saleinvcode=SL.saleinvcode AND\n\t\tSL.date BETWEEN :adt_sdate AND :adt_ldate\n\tGROUP BY \n\t\t SL.saleinvcode,\n\t\t SL.salesmancode,\n\t\t SD.icode,\n\t\t SL.Doctcode,\n\t\t SL.salecatcode,\n\t\t SL.discperc,\n\t\t SL.flatdisc,\n\t\t SL.invgstperc1,\n\t\t SL.salecatcode\n\tUNION ALL\n\tSELECT\n\t\tSL.srinvcode,\n\t\tSD.icode,\n\t\tSL.Doctcode,\n\t\tsaleqty=-ISNULL(sum(SD.looseqty), 0) ,\n\t\tbonus=-ISNULL(sum(SD.bonusqty), 0) ,\n\t\tItemCost=-ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)), 2), 0),\n\t\tGrossValue = SUM( SD.looseqty * SD.srprice ) ,\n\t\tItemDiscValue = SUM((SD.looseqty * SD.srprice ) * (.01 * SD.discperc) ),\n\t\tInvItemDiscValue = SUM( ( (SD.looseqty * SD.srprice) *\n\t\t\t\t\t\t\t\t\t(1 - (.01 * SD.discperc) ) ) * (.01 * SL.discperc) ),\n\t\tItemValue=SUM((SD.looseqty * SD.srprice *\n\t\t\t(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc))),\n\t\tGrossAmt=(SELECT SUM((SDD.looseqty * SDD.srprice *\n\t\t\t\t(1 - (.01 * SDD.discperc))) * (1- (.01 * SLL.discperc)))\n\t\t\tFROM\tsrdetail SDD, srledger SLL\n\t\t\tWHERE SLL.srinvcode=SL.srinvcode and SLL.srinvcode=SDD.srinvcode\n\t\t\tGROUP BY SLL.srinvcode),\n\t\tSL.flatdisc,\n\t\tcatcode=SL.srcatcode,\n\t\ttype='R'\n\tFROM\n\t\tSRLedger SL,\t \n\t\tSRDetail SD,\n\t\tItem I\n\tWHERE\n\t\tSD.icode=I.icode AND\n\t\tCASE :as_group \n\t\t\tWHEN 'M' THEN I.ManfCode \n\t\t\tWHEN 'C' THEN I.ICatCode \n\t\t\tWHEN 'L' THEN I.ICCode \n\t\t\tWHEN 'P' THEN I.PackCode \n\t\tEND IN (:ala_icatcode) AND\n\t\tSD.srinvcode=SL.srinvcode AND\n\t\tSL.date BETWEEN :adt_sdate AND :adt_ldate\n\tGROUP BY\n\t\t SL.srinvcode,\n\t\t SL.salesmancode,\n\t\t SD.icode,\n\t\t SL.Doctcode,\n\t\t SL.srcatcode,\n\t\t SL.discperc,\n\t\t SL.flatdisc,\n\t\t SL.invgstperc1,\n\t\t SL.srcatcode) AS D ON (D.DoctCode = Dt.DoctCode)\nWHERE \n\tCASE :as_group \n\t\tWHEN 'M' THEN I.ManfCode \n\t\tWHEN 'C' THEN I.ICatCode \n\t\tWHEN 'L' THEN I.ICCode \n\t\tWHEN 'P' THEN I.PackCode \n\tEND = C.ICatCode AND\n\tC.ICatCode IN (:ala_icatcode) AND\n\tD.ICode = I.ICode\nGROUP BY\n\tDt.Name,\n\tD.DoctCode,\n\tC.ICatCode,\n\tC.Name,\n\tI.ICode,\n\tI.CustomICode,\n\tI.name\nORDER BY\n\tDt.Name,\n\tC.Name,\n\tI.name\n",
  "arguments": {
