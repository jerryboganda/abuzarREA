  "retrieve": "SELECT \n\tZoneCode=T.ZoneCode,\n\tZoneName=T.ZoneName,\n\tDate = CONVERT(VARCHAR(100), T.Date, 106),\n\tDescription=T.Description,\n\tValue = SUM(Value)\nFROM\n\t(SELECT \n\t\tZoneCode=Z.ZoneCode,\n\t\tZoneName=Z.Name,\n\t\tDate = CAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),\n\t\tDescription= LTRIM(RTRIM(I.CustomICode)) + ' / ' + I.Name,\n\t\tValue = CASE :ai_column WHEN 1 THEN SUM(SD.LooseQty) ELSE SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)) END\n\tFROM\n\t\tZone Z, ZoneAreas ZA, Customer C, Item I, SaleLedger SL, SaleDetail SD\n\tWHERE\n\t\t:ai_reporttype = 1 AND\n\t\tZ.ZoneCode IN (:ai_zonecode) AND\n\t\tZ.ZoneCode = ZA.ZoneCode AND\n\t\tZA.AreaCode = C.AreaCode AND\n\t\tC.CustCode = SL.CustCode AND\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.Posted = 'Y' AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode IN (SELECT ZM.ManfCode FROM ZONE ZM WHERE ZM.ZoneCode IN (:ai_zonecode))\n\tGROUP BY\n\t\tZ.ZoneCode,\n\t\tZ.Name,\n\t\tCAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),\n\t\tSD.ICode,\n\t\tI.CustomICode,\n\t\tI.Name\n\tUNION ALL\n\tSELECT \n\t\tZoneCode=Z.ZoneCode,\n\t\tZoneName=Z.Name,\n\t\tDate = CAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),\n\t\tDescription= LTRIM(RTRIM(I.CustomICode)) + ' / ' + I.Name,\n\t\tValue = - CASE :ai_column WHEN 1 THEN SUM(SD.LooseQty) ELSE SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)) END\n\tFROM\n\t\tZone Z, ZoneAreas ZA, Customer C, Item I, SRLedger SL, SRDetail SD\n\tWHERE\n\t\t:ai_reporttype = 1 AND\n\t\tZ.ZoneCode IN (:ai_zonecode) AND\n\t\tZ.ZoneCode = ZA.ZoneCode AND\n\t\tZA.AreaCode = C.AreaCode AND\n\t\tC.CustCode = SL.CustCode AND\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.Posted = 'Y' AND\n\t\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode IN (SELECT ZM.ManfCode FROM ZONE ZM WHERE ZM.ZoneCode IN (:ai_zonecode))\n\tGROUP BY\n\t\tZ.ZoneCode,\n\t\tZ.Name,\n\t\tCAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),\n\t\tSD.ICode,\n\t\tI.CustomICode,\n\t\tI.Name\n\tUNION ALL\n\tSELECT \n\t\tZoneCode=Z.ZoneCode,\n\t\tZoneName=Z.Name,\n\t\tDate = CAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),\n\t\tDescription= IC.Name,\n\t\tValue = CASE :ai_column WHEN 1 THEN SUM(SD.LooseQty) ELSE SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)) END\n\tFROM\n\t\tZone Z, ZoneAreas ZA, Customer C, Item I, SaleLedger SL, SaleDetail SD, ItemCategory IC\n\tWHERE\n\t\t:ai_reporttype = 2 AND\n\t\tZ.ZoneCode IN (:ai_zonecode) AND\n\t\tZ.ZoneCode = ZA.ZoneCode AND\n\t\tZA.AreaCode = C.AreaCode AND\n\t\tC.CustCode = SL.CustCode AND\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.Posted = 'Y' AND\n\t\tSL.SaleInvCode = SD.SaleInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode IN (SELECT ZM.ManfCode FROM ZONE ZM WHERE ZM.ZoneCode IN (:ai_zonecode)) AND\n\t\tI.ICatCode = IC.ICatCode\n\tGROUP BY\n\t\tZ.ZoneCode,\n\t\tZ.Name,\n\t\tCAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),\n\t\tIC.Name\n\tUNION ALL\n\tSELECT \n\t\tZoneCode=Z.ZoneCode,\n\t\tZoneName=Z.Name,\n\t\tDate = CAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),\n\t\tDescription= IC.Name,\n\t\tValue = - CASE :ai_column WHEN 1 THEN SUM(SD.LooseQty) ELSE SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)) END\n\tFROM\n\t\tZone Z, ZoneAreas ZA, Customer C, Item I, SRLedger SL, SRDetail SD, ItemCategory IC\n\tWHERE\n\t\t:ai_reporttype = 2 AND\n\t\tZ.ZoneCode IN (:ai_zonecode) AND\n\t\tZ.ZoneCode = ZA.ZoneCode AND\n\t\tZA.AreaCode = C.AreaCode AND\n\t\tC.CustCode = SL.CustCode AND\n\t\tSL.Date BETWEEN :adt_startdate AND :adt_enddate AND\n\t\tSL.Posted = 'Y' AND\n\t\tSL.SRInvCode = SD.SRInvCode AND\n\t\tSD.ICode = I.ICode AND\n\t\tI.ManfCode IN (SELECT ZM.ManfCode FROM ZONE ZM WHERE ZM.ZoneCode IN (:ai_zonecode)) AND\n\t\tI.ICatCode = IC.ICatCode\n\tGROUP BY\n\t\tZ.ZoneCode,\n\t\tZ.Name,\n\t\tCAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),\n\t\tIC.Name) T\nGROUP BY\n\tT.ZoneCode,\n\tT.ZoneName,\n\tT.Date,\n\tT.Description\n",
