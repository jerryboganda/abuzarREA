  "retrieve": "SELECT \n\tRowType = 2,\n\tRowClass = 'Investigation/Test(s)',\n\titemname = service.name,\n\tusers.username,  \n\theaderno=serviceheader.headerno,\n\tcustomername=(select name from accounts where acccode=serviceheader.custcode),\n\tcustref=SPACE(100),\n\tserviceinvcode = dbo.serviceheader.serviceinvcode,   \n\tsaleinvcode = dbo.serviceheader.saleinvcode,   \n\taltersaleinvcode=NULL,\n\tdate = dbo.serviceheader.date,   \n\tinvdiscperc=dbo.serviceheader.discperc,\n\tmisccharges=dbo.serviceheader.misccharges,   \n\tflatdisc=dbo.serviceheader.flatdisc,   \n\tinvsalestax=0.00,\n\tcustcode=dbo.serviceheader.custcode,   \n\tremarks=dbo.serviceheader.remarks,\n\theaderinv=null,  \n\tIcode=dbo.service.servicecode,   \n\tGCode = NULL,\n\tID = dbo.servicedetail.srvrowid,\n\tlooseqty = servicedetail.qty,\n\tpackqty = 0.0000,\n\tpackunits = 1,\n\tsaleprice = servicedetail.price, \n\trate      = 0.0000,\n\tsalestax  = 0.00,   \n\tdiscperc  = servicedetail.discperc,\n\titemflatdisc  = servicedetail.serviceflatdisc,\n\tunitsalestax  = 0.00,\n\tgstperc       = 0.00,\n\tinvgstperc    = 0.00,\n\treprintcounter=serviceheader.reprintingcounter,\n\tInvTotal = serviceheader.InvTotal\nFROM \n\t(SELECT TOP 2 SH.ServiceInvCode FROM ServiceHeader SH WHERE SH.patientcode  = :ai_patientcode AND SH.Date <= :adt_date AND SH.ServiceCatCode <> 10 ORDER BY SH.ServiceInvCode DESC) TS,\n\tdbo.serviceheader,   \n\tdbo.servicedetail,  \n\tservice, \n\tusers \nWHERE \n\t( dbo.serviceheader.serviceinvcode = TS.ServiceInvCode ) AND\n\t( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND \n\t( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND\n\t( servicedetail.servicecode = service.servicecode )  \nUNION ALL\nSELECT \n\tRowType = 1,\n\tRowClass = 'Medicine',\n\titemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, \n\tusers.username, \n\theaderno = dbo.saleledger.headerno,\n\tcustomername=(select name from accounts where acccode=saleledger.custcode)  ,\n\tcustref=max(dbo.saleledger.custrefno),\n\tserviceinvcode = NULL,   \n\tsaleinvcode=dbo.saleledger.saleinvcode,   \n\taltersaleinvcode=dbo.saleledger.altersaleinvcode,\n\tdate=dbo.saleledger.date,   \n\tinvdiscperc=dbo.saleledger.discperc,   \n\tmisccharges=dbo.saleledger.misccharges,   \n\tflatdisc=dbo.saleledger.flatdisc,   \n\tinvsalestax=dbo.saleledger.salestax,   \n\tcustcode=dbo.saleledger.custcode,   \n\tremarks=dbo.saleledger.remarks, \n\theaderinv=max(dbo.saleledger.headerinvno),  \n\ticode=dbo.saledetail.icode,   \n\tgcode=dbo.saledetail.gcode, \n\tId        = max(dbo.saledetail.IDENTITYCOL),  \n\tlooseqty  = sum(saledetail.looseqty), \n\tpackqty   = sum(saledetail.packqty), \n\tpackunits = max(saledetail.packunits), \n\tsaleprice = max(saledetail.saleprice), \n\trate      = max(saledetail.rate),\n\tsalestax  = max(saledetail.salestax),   \n\tdiscperc  = max(saledetail.discperc), \n\titemflatdisc  = max(saledetail.itemflatdisc),\n\tunitsalestax  = max(saledetail.unitsalestax),\n\tgstperc       = max(saledetail.gstperc),\n\tinvgstperc    = max(saleledger.invgstperc1),\n\treprintcounter=max(saleledger.reprintingcounter),\n\tInvTotal = MAX(saleledger.InvTotal)\nFROM \n\t(SELECT TOP 2 SH.SaleInvCode FROM SaleLedger SH WHERE SH.patientcode  = :ai_patientcode AND SH.Date <= :adt_date AND SH.SaleCatCode <> 3 ORDER BY SH.SaleInvCode DESC) S,\n\tdbo.saleledger,   \n\tdbo.saledetail,  \n\titem,\n\tUsers \nWHERE \n\t( S.SaleInvCode = dbo.saleledger.SaleInvCode ) AND\n\t( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND \n\t( saleLedger.SalesManCode = users.userCode ) and\n\t( saledetail.icode = item.icode )\nGROUP BY \n\tS.SaleInvCode,\n\tsaleledger.saleinvcode, \n\tsaleledger.altersaleinvcode,\n\tsaleledger.date, \n\tsaleledger.custcode, \n\tsaleledger.discperc, \n\tsaleledger.flatdisc, \n\tsaleledger.misccharges, \n\tsaleledger.headerno,\n\tsaleledger.salestax, \n\tsaleledger.remarks, \n\tsaledetail.icode, \n\tsaledetail.rowgroup,\n\tsaledetail.gcode, \n\titem.name,\n\titem.icode,\n\titem.printable,\n\tusers.username\nORDER BY \n\tRowType, ID\n",
  "arguments": {
