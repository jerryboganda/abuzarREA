  "retrieve": "SELECT \n\tRegNo = P.RegNo,\n\tPatientName = P.Name,\n\tFHName = P.FName,\n\tGender = CASE P.Gender WHEN 'M' THEN 'Male' WHEN 'F' THEN 'Female' ELSE ' ' END,\n\tAge = ISNULL(LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ','') /*+ ISNULL(LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ','') + ISNULL(LTRIM(RTRIM(STR(P.AgeDays))) + ' days ','')*/,\n\tAddress1=P.Address1,\n\tRowID=PFC.RowID,\n\tDate=PFC.Date,\n\tPatientCode=PFC.PatientCode,\n\tAdmissionCode=PFC.AdmissionCode,\n\tDoctCode=PFC.DoctCode,\n\tOptionCode=PFC.OptionCode,\n\tDetails=PFC.Details\nFROM\n\tPatientFirstContact PFC, Patient P\nWHERE \n\tPFC.RowID = :ai_rowid AND\n\tPFC.PatientCode = P.PatientCode",
  "arguments": {
   "_items": [
