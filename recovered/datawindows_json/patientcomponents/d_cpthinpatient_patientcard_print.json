  "retrieve": "SELECT  \n\tPatientCode=Patient.PatientCode,\n\tCustCode=Patient.CustCode,\n\tRegNo=Patient.RegNo,\n\tName=Patient.Name,\n\tDate = Patient.OriginalDate,\n\tFName=Patient.FName,\n\tGender=CASE WHEN Patient.Gender = 'M' THEN 'Male' ELSE 'Female' END,\n\tWard = (SELECT W.Name FROM Ward W WHERE W.WardCode = Patient.WardCode),\n\tBirthDate=Patient.DOB,\n\tAge=LTRIM(RTRIM(STR( (DATEDIFF(dd, Patient.DOB, getdate()) / 365), 4, 0))) + ' Yrs ' +\n\t\tLTRIM(RTRIM(STR(DATEDIFF(mm, Patient.DOB, getdate()) % 12, 4, 0))) + ' Mon ' +\n\t\tLTRIM(RTRIM(STR((DATEDIFF(dd, Patient.DOB, getdate()) % 365 % 12), 4, 0))) + ' Days',\n\tAddress1 = Patient.Address1,\n\tAddress2 = Patient.Address2,\n\tCNIC = Patient.NationalIDCard,\n\tMobile = Patient.MobileNo1,\n\tIssueDate = GETDATE()\nFROM\n\tPatient\nWHERE \n\tPatient.PatientCode IN (:ai_code) AND\n\tPatient.Active = 'Y'\nORDER BY\n\tName",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "numberlist"
     ]
    }
   ]
  }
 },
