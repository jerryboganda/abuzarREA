  "retrieve": "SELECT \n\tRowID,\n\tDate,\n\tRegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = PrevAbnormalLabs.PatientCode),\n\tPatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = PrevAbnormalLabs.PatientCode),\n\tFHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = PrevAbnormalLabs.PatientCode),\n\tAge = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = PrevAbnormalLabs.PatientCode),\n\tGender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = PrevAbnormalLabs.PatientCode),\n\tPatientCode,\n\tAdmissionCode,\n\tUserCode,\n\tAttendingDoctcode,\n\tIncUC,\n\tIncLFTs,\n\tIncPotK,\n\tDecInPotK,\n\tIncInHb,\n\tDecHB,\n\tIncPTINR,\n\tDecMeg,\n\tDecCal,\n\n\tPrevAbnormalLabs\nFROM \n\tPrevAbnormalLabs\nWHERE \n\tPrevAbnormalLabs.AdmissionCode = :ai_code\nORDER BY \n\tPrevAbnormalLabs.PatientCode,\n\tPrevAbnormalLabs.RowID DESC",
  "update": "PrevAbnormalLabs",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
