  "retrieve": "SELECT \n\tPatientName=Patient.Name, \n\tRegNo = Patient.RegNo,\n\tPatientAdmission.AdmissionCode,   \n\tPatientAdmission.PatientCode,   \n\tPatientAdmission.LocationCode,   \n\tLocation = RTRIM(LTRIM(PatientLocation.Name)) + ', ' + RTRIM(LTRIM(WARD.Name)),\n\tCurrentLocation = (SELECT LTRIM(RTRIM(PL.NAME)) + ', ' + LTRIM(RTRIM(W.Name))\n\t\t\tFROM PATIENTLOCATION PL, Ward W\n\t\t\tWHERE PL.LOCATIONCODE = \n\t\t\t\t\tISNULL((SELECT TargetLocation FROM PatientTransfer \n\t\t\t\t\t\t\t\tWHERE PatientTransfer.TransferCode = \n\t\t\t\t\t\t\t\t\t\t(SELECT Max(PatientTransfer.TransferCode) \n\t\t\t\t\t\t\t\t\t\tFROM PatientTransfer \n\t\t\t\t\t\t\t\t\t\tWHERE PatientTransfer.AdmissionCode = PatientAdmission.AdmissionCode)), (SELECT A.LocationCode FROM PatientAdmission A WHERE A.AdmissionCode = PatientAdmission.AdmissionCode)) AND PL.WardCode=W.WardCode),\n\tPatientAdmission.Date,   \n\tAdmittedBy=Users.UserName,\n\tPatientAdmission.Diagnosis,   \n\tPatientAdmission.DoctorCode,   \n\tDoctor=Doctors.Name,   \n\tInitialDischarged = PatientAdmission.Discharged1,\n\tInitialDischargedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=PatientAdmission.Discharged1By),\n\tPatientAdmission.Discharged,\n\tDischargedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=PatientAdmission.DischargedBy),\n\tDisease=Disease.Name\nFROM \n\tPatientAdmission\n\tLEFT OUTER JOIN Doctors ON (PatientAdmission.DoctorCode = Doctors.DoctCode)\n\tLEFT OUTER JOIN Users ON (PatientAdmission.Usercode = Users.UserCode),\n\tPatient, PatientLocation, Ward, Disease\nWHERE \n\tPatientAdmission.PatientCode = Patient.PatientCode ANd\n\tPatientAdmission.LocationCode = PatientLocation.LocationCode AND\n\tPatientAdmission.Date >= :adt_date AND\n\tPatientLocation.WardCode = Ward.WardCode AND\n\tPatientAdmission.DiseaseCode = Disease.DiseaseCode AND\n\tPatientAdmission.Discharged = CASE dbo.fn_GetPreference('patientadmission_listviewcriteria') WHEN '1' THEN PatientAdmission.Discharged WHEN '2' THEN 'N' ELSE 'Y' END\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "adt_date",
      "datetime"
     ]
    }
   ]
  }
 },
