  "retrieve": "SELECT \n\tRowID,\n\tDate,\n\tRegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = DischargePrescription.PatientCode),\n\tPatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = DischargePrescription.PatientCode),\n\tFHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = DischargePrescription.PatientCode),\n\tAge = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = DischargePrescription.PatientCode),\n\tGender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = DischargePrescription.PatientCode),\n\tPatientCode=PatientCode,\n\tAdmissionCode=AdmissionCode,\n\tUserCode,\n\tAttendingDoctCode,\n\tFullCode=(SELECT Item.CustomICode FROM ITEM WHERE Item.ICode = DischargePrescription.ICode),\n\tItemName=(SELECT Item.Name FROM ITEM WHERE Item.ICode = DischargePrescription.ICode),\n\tCurrListRow=0, \n\tItemCode=0,\n\tICode=ICode,\n\tDosageUnitCode=DosageUnitCode,\n\tQty=Qty,\n\tDosageStrength=DosageStrength,\n\tDosageCode=DosageCode,\n\tDosageFactor=DosageFactor,\n\tRouteCode=RouteCode,\n\tDuration=Duration,\n\tStartDate=StartDate,\n\tInsCode=InsCode\nFROM\n\tDischargePrescription\nWHERE \n\tDischargePrescription.AdmissionCode = :ai_code\nORDER BY\n\tDischargePrescription.PatientCode,\n\tDischargePrescription.RowID\n",
  "update": "DischargePrescription",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
