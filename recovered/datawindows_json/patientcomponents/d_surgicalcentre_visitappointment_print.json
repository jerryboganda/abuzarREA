  ],
  "retrieve": "SELECT  \n\tCode = VA.AppointmentCode,\n\tDate=VA.date,\n\tDoctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = VA.DoctCode),\n\tDoctortitle = (SELECT D.title1 FROM Doctors D WHERE D.DoctCode = VA.DoctCode),\n\tTokenNo=VA.TokenNo,\n\tPatientDetails=VA.PatientDetails,\n\tRemarks = VA.Remarks,\n\tComments = VA.Comments,\n\tReferredBy = VA.ReferredBy,\n\tUserCode=VA.Usercode,\n\tPatientCode = P.Patientcode,\n\tRegno = P.Regno,\n\tName = P.name ,\n\tGender = P.gender,\n\tFname = P.fname,\n\tcustcode=P.custcode,\n\tcustomername=(select name from accounts where accounts.acccode=p.custcode),\n\tAge=DATEDIFF(YYYY, DOB, GETDATE()),\n\tDueDate = VA.DueDate\nFROM \n\tvisitappointment VA LEFT OUTER JOIN patient AS P ON (VA.PatientCode = P.PatientCode)\nWHERE \n\tVA.AppointmentCode = :ra_code",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_code",
      "number"
     ]
    }
   ]
  }
 },
