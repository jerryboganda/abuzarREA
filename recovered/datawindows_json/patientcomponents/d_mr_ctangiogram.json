  "retrieve": "SELECT \n\tRowID,\n\tDate,\n\tRegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = CTAngiogram.PatientCode),\n\tPatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = CTAngiogram.PatientCode),\n\tFHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = CTAngiogram.PatientCode),\n\tAge = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = CTAngiogram.PatientCode),\n\tGender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = CTAngiogram.PatientCode),\n\tPatientCode,\n\tAdmissionCode,\n\tUserCode,\n\tAttendingDoctCode,\n\tHadCTCoronaryAngiogram,\n\tHadCTCoronaryAngiogramOn,\n\tNormalCoronaries,\n\tMildcoronaryArteryDisease,\n\tDiffuseCoronaryArteryDisease,\n\tEctaticCoronayArteries,\n\tSVCAD,\n\tDVCAD,\n\tTVCAD,\n\tOther,\n\tRemarks\nFROM \n\tCTAngiogram\nWHERE \n\tCTAngiogram.AdmissionCode = :ai_code\nORDER BY \n\tCTAngiogram.PatientCode,\n\tCTAngiogram.RowID DESC",
  "update": "CTAngiogram",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
