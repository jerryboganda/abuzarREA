  "retrieve": "Select p.prescode,\n\t\t p.icode,\n\t\t Discontinued='N',\n\t\t aliasname = i.customicode,\n\t\t i.name,\n\t\t CurrListRow = 0,\n\t\t p.rowid,\n\t\t p.noofunits,\n\t\t p.dosagecode,\n\t\t p.dosefactor,\n\t\t p.routecode,\n\t\t p.date,\n\t\t p.duration,\n\t\t p.inscode\n\t\t \nFrom   PrescriptionDetail p , Item i\n\nWhere  p.prescode = :ar_prescode And\n\t\t p.icode = i.icode\n\nOrder By RowID",
  "update": "PrescriptionDetail",
