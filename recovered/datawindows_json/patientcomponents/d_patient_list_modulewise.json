  "retrieve": "SELECT \n\tpatient.name,\n\tpatient.Patientcode,\n\tpatient.regno,\n\tpatient.fname,\n\tpatient.active,\n\tpatient.gender,\n\taccounts.name,\n\tpatient.city,\n\tPatient.UserCode,\n\tPatient.date,\n\tPatient.originaldate,\n\tPatient.createdby,\n\tPatient.inactivedate,\n\tPatient.inactivedby,\n\tpatient.locationcode,\n\tpatient.patientcatcode,\n\tpatient.membershipid,\n\tpatient.Phone,\n\tpatient.Phone2,\n\tpatient.MobileNo1\nFROM \n\tPatient\n\tLEFT OUTER JOIN Accounts ON (Patient.CustCode = Accounts.AccCode)\nWHERE\n\tpatient.patientcatcode IN \n\t\t(SELECT DISTINCT PatientCatCode \n\t\tFROM PatientCatAllowedModule\n\t\tWHERE ModuleID = :ai_module)",
  "arguments": {
   "_items": [
