  "retrieve": "SELECT\n\tRowID,\n\tDate,\n\tRegNo=(SELECT P.RegNo FROM Patient P WHERE P.PatientCode = LabInvestRec.PatientCode),\n\tPatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = LabInvestRec.PatientCode),\n\tFHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = LabInvestRec.PatientCode),\n\tAge = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = LabInvestRec.PatientCode),\n\tGender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = LabInvestRec.PatientCode),\n\tPatientCode,\n\tAdmissionCode,\n\tUserCode,\n\tAttendingDoctCode,\n\tCBC,\n\tRFTs,\n\tLFTs,\n\tUricAcid,\n\tSerumElectrolytes,\n\tUreaCreatinine,\n\tFastingLipidProfile,\n\tFastingBloodSugar,\n\tRandomBloodSugar,\n\tHbA1C,\n\tCardiacEnzymes,\n\tTropT,\n\tTropI,\n\tPTINR,\n\tAPTT,\n\tBNP,\n\tDDimmer,\n\tASOTitre,\n\tCRP,\n\tCRPHighSensitive,\n\tPSA,\n\tThyroidFunctionTest,\n\tOther\nFROM\n\tLabInvestRec\nWHERE \n\tLabInvestRec.AdmissionCode = :ai_code\nORDER BY\n\tLabInvestRec.PatientCode,\n\tLabInvestRec.RowID DESC",
  "update": "LabInvestRec",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
