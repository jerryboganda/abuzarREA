  "retrieve": "SELECT \n\tRowID,\n\tDate,\n\tRegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = ProvDiag.PatientCode),\n\tPatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = ProvDiag.PatientCode),\n\tFHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = ProvDiag.PatientCode),\n\tAge = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = ProvDiag.PatientCode),\n\tGender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = ProvDiag.PatientCode),\n\tPatientCode,\n\tAdmissionCode,\n\tUserCode,\n\tAttendingDoctCode,\n\tProvisionalDiagnosis,\n\tDetails\nFROM\n\tProvDiag\nWHERE \n\tProvDiag.AdmissionCode = :ai_code\nORDER BY\n\tProvDiag.PatientCode,\n\tProvDiag.RowID DESC",
  "update": "ProvDiag",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
