  "retrieve": "SELECT \n\tRowID,\n\tDate,\n\tRegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = ThaliumScan.PatientCode),\n\tPatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = ThaliumScan.PatientCode),\n\tFHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = ThaliumScan.PatientCode),\n\tAge = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = ThaliumScan.PatientCode),\n\tGender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = ThaliumScan.PatientCode),\n\tPatientCode,\n\tAdmissionCode,\n\tUserCode,\n\tAttendingDoctCode,\n\tThaliumScan, \n\tDateThaliumScan, \n\tDoctorThaliumScan,\n\tInstitutionThaliumScan,\n\tReversibleIschemiaPresent, \n\tReversibleIschemiaPresentThaliumScan, \n\tNoReversibleIschemia, \n\tNoReversibleIschemiaThaliumScan, \n\tMyocardiumViability, \n\tMyocardiumViabilityThaliumScan, \n\tEF,\n\tEFThaliumScan,\n\tOthers,\n\tRemarks\nFROM\n\tThaliumScan\nWHERE \n\tThaliumScan.AdmissionCode = :ai_code\nORDER BY\n\tThaliumScan.PatientCode,\n\tThaliumScan.RowID DESC\n",
  "update": "ThaliumScan",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
