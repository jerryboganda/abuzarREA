  "retrieve": "SELECT\n\tPatientLocation.LocationCode ,\n\tPatientLocation.Name ,\n\tPatientLocation.WardCode ,\n\tPatientLocation.Description ,\n\tOccupied=\n\t\tCASE WHEN PatientLocation.LocationCode IN\n\t\t\t(SELECT \n\t\t\t\tISNULL(\n\t\t\t\t\t(SELECT TargetLocation FROM PatientTransfer \n\t\t\t\t\tWHERE \n\t\t\t\t\t\tPatientTransfer.TransferCode IN\n\t\t\t\t\t\t\t(SELECT Max(PatientTransfer.TransferCode) \n\t\t\t\t\t\t\tFROM PatientTransfer \n\t\t\t\t\t\t\tWHERE PatientTransfer.AdmissionCode = PA.AdmissionCode)), \n\t\t\t\t\tPA.LocationCode)\n\t\t\tFROM PatientAdmission PA\n\t\t\tWHERE PA.Discharged = 'N') THEN 'Y' ELSE 'N' END\nFROM \n\tPatientLocation",
  "update": "PatientLocation",
  "updatewhere": "1",
  "updatekeyinplace": "no"
 },
