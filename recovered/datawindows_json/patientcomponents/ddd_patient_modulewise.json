  "retrieve": "SELECT  \n\tName=P.name,\n\tRegno=P.regno,\n\tpatientcode=P.patientcode,\n\tAddress1 = P.Address1,\n\tPhone = P.Phone,\n\trank=(select name from rank where rank.rankcode=P.rankcode),\n\tCity=P.city,\n\tNIC=P.NationalIDCard,\n\trelationcode=P.relationcode,\n\tdoctcode=P.doctcode,\n\twardcode=P.wardcode,\n\tcustomer=(SELECT A.name FROM Accounts A WHERE P.CustCode = A.AccCode),\n\tpatient = LTRIM(RTRIM(P.Name)) + ' (' + LTRIM(RTRIM(P.RegNo)) + ')',\n\tRecurringPeriod=ISNULL(P.RecurringPeriod,0),\n\tReference=P.Reference\nFROM Patient P, PatientCategory PC, PatientCatAllowedModule PAM\nWHERE \n\tP.Active='Y' AND \n\tP.PatientCatCode = PC.PatientCatCode AND\n\tP.PatientCatCode = PAM.PatientCatCode AND\tPAM.ModuleID = :ai_module\n\n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_module",
      "number"
     ]
    }
   ]
  },
  "sort": "name A, regno A, customer A"
