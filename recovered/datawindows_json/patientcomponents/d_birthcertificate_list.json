  "retrieve": "SELECT \n\tBirthCertificate.BirthCertificateCode,   \n\tRegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode=BirthCertificate.PatientCode),\n\tPatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode=BirthCertificate.PatientCode),\n\tBirthCertificate.VisitCode,   \n\tBirthCertificate.AdmissionCode,   \n\tBirthCertificate.UserCode,   \n\tBirthCertificate.Date,   \n\tBirthCertificate.DOB,   \n\tBirthCertificate.ChildName,   \n\tBirthCertificate.Gender,   \n\tBirthCertificate.FatherName,   \n\tBirthCertificate.FatherCNIC,   \n\tBirthCertificate.FatherCellNo,   \n\tBirthCertificate.MotherName,   \n\tBirthCertificate.MotherCNIC,   \n\tBirthCertificate.MotherCellNo,   \n\tBirthCertificate.AgeOfMother,   \n\tBirthCertificate.PlaceOfBirth,   \n\tBirthCertificate.DoctorName,   \n\tBirthCertificate.HospitalName,   \n\tBirthCertificate.IssuedTo,   \n\tBirthCertificate.IssuedToCNIC,   \n\tBirthCertificate.IssuedToCellNo  \nFROM \n\tBirthCertificate",
