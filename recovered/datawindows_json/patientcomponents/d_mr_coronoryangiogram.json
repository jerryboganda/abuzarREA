  "retrieve": "SELECT \n\tRowID,\n\tDate,\n\tRegNo= (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = CoronoryAngiogram.PatientCode),\n\tPatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = CoronoryAngiogram.PatientCode),\n\tFHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = CoronoryAngiogram.PatientCode),\n\tAge = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = CoronoryAngiogram.PatientCode),\n\tGender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = CoronoryAngiogram.PatientCode),\n\tPatientCode,\n\tAdmissionCode,\n\tUserCode,\n\tAttendingDoctCode,\n\tHadCoronaryAngiogram, \n\tHadCoronaryAngiogramon,\n\tNormalCoronaries, \n\tMildCoronary, \n\tArteryDisease, \n\tDiffuseCoronaryArteryDisease, \n\tEctaticCoronayArteries, \n\tSVCAD, \n\tDVCAD, \n\tTVCAD, \n\tOtherAngiogramFeature,\n\tRemarks\nFROM\n\tCoronoryAngiogram\nWHERE \n\tCoronoryAngiogram.AdmissionCode = :ai_code\nORDER BY\n\tCoronoryAngiogram.PatientCode,\n\tCoronoryAngiogram.RowID Desc\n\n",
  "update": "CoronoryAngiogram",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
