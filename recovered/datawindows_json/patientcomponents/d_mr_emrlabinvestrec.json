  "retrieve": "SELECT\n\tRowID,\n\tDate,\n\tRegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = EmrLabInvestRec.PatientCode),\n\tPatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = EmrLabInvestRec.PatientCode),\n\tFHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = EmrLabInvestRec.PatientCode),\n\tAge = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = EmrLabInvestRec.PatientCode),\n\tGender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = EmrLabInvestRec.PatientCode),\n\tPatientCode,\n\tAdmissionCode,\n\tUserCode,\n\tAttendingDoctCode,\n\tSetA,\n\tSetA_CBC,\n\tSetA_UreaCreatinine,\n\tSetA_SerumNa,\n\tSetA_K,\n\tSetA_RandomBloodSugar,\n\tSetA_CPK,\n\tSetA_CKMB,\n\tSetB,\n\tSetB_TropTI,\n\tSetB_CE,\n\tSetB_PTINR,\n\tSetB_APTT,\n\tSetC,\n\tSetC_SerumMagnesium,\n\tSetC_SerumCalcium,\n\tSetC_BNP,\n\tSetC_DDimmer,\n\tSetC_ASOTitre,\n\tSetC_CRP,\n\tSetC_CRPHighSensitive,\n\tSetC_UrineCE,\n\tOther\nFROM\n\tEmrLabInvestRec\nWHERE \n\tEmrLabInvestRec.AdmissionCode = :ai_code\nORDER BY\n\tEmrLabInvestRec.PatientCode,\n\tEmrLabInvestRec.RowID DESC",
  "update": "EmrLabInvestRec",
  "updatewhere": "1",
  "updatekeyinplace": "yes",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
 },
