  "retrieve": " SELECT  patientcode ,\n        Regno,\n\t\t\tname ,\n\t\t\tward,\n\t\t\tgender,\n\t\t\tactive,\n\t\t\tfname,\n\t\t\tdob,\n\t\t\tcustcode,\n\t\t\tusercode,\n\t\t\tdate,\n\t\t\tNationalIDCard,\n\t\t\tphone,\n\t\t\tfax,\n\t\t\temail,\n\t\t\trankcode,\n\t\t\tunitcode,\n\t\t\taddress1,\n\t\t\taddress2,\n\t\t\tcity,\n\t\t\tAge=DATEDIFF(YYYY, DOB, GETDATE()),\n\t\t\tMobileNo1 = MobileNo1,\n\t\t\tMobileNo2 = MobileNo2,\n\t\t\tMobileNo3 = MobileNo3,\n\t\t\tdoctor=(select name from doctors where doctors.doctcode=patient.doctcode),\n\t\t\tdiagnosis=patient.diagnosis,\n\t\t\tprofession=profession,\n\t\t\treference=reference,\n\t\t\tAllergies=allergies,\n\t\t\tdisease=(select name from disease where disease.diseasecode=patient.diseasecode)\n         \nFROM patient      \nWHERE ( patientcode = :ra_patientcode )   ",
  "update": "patient",
  "updatewhere": "0",
  "updatekeyinplace": "no",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ra_patientcode",
      "number"
     ]
    }
   ]
  }
