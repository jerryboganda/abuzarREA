  "retrieve": "SELECT \n\tRowID=DischargePrescription.RowID,   \n\tDate=DischargePrescription.Date,   \n\tPatientCode=DischargePrescription.PatientCode,   \n\tAdmissionCode=DischargePrescription.AdmissionCode,   \n\tIcode=DischargePrescription.ICode,   \n\tItemName = (SELECT I.Name FROM Item I WHERE I.ICode = DischargePrescription.ICode),\n\tDosageUnitCode=DischargePrescription.DosageUnitCode,   \n\tLocalDosageUnit = (SELECT DU.LocalDosageUnit FROM DosageUnit DU WHERE DU.DosageUnitCode = DischargePrescription.DosageUnitCode),\n\tQty=DischargePrescription.Qty,   \n\tDosageStrength=DischargePrescription.DosageStrength,   \n\tDosageCode=DischargePrescription.DosageCode,   \n\tDosageFactor=DischargePrescription.DosageFactor,   \n\tLocalDosage = (SELECT D.LocalDosage FROM Dosage D WHERE D.DosageCode = DischargePrescription.DosageCode),\n\tRouteCode=DischargePrescription.RouteCode,   \n\tLocalRoute = (SELECT R.LocalRoute FROM Route R WHERE R.RouteCode = DischargePrescription.RouteCode),\n\tDuration=DischargePrescription.Duration,   \n\tStartDate=DischargePrescription.StartDate,   \n\tInsCode=DischargePrescription.InsCode,\n\tLocalInstruction = (SELECT I.LocalInstruction FROM Instruction I WHERE I.InsCode = DischargePrescription.InsCode)\nFROM \n\tDischargePrescription  \nWHERE \n\tDischargePrescription.AdmissionCode = :ai_code     \nORDER BY \n\tDischargePrescription.RowID ASC   \n",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_code",
      "number"
     ]
    }
   ]
  }
