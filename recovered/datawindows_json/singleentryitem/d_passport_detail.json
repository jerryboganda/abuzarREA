  "retrieve": "SELECT\n\tItem.ICode,   \n\tItem.CustomICode,   \n\tItem.Name,   \n\tItem.ICCode,   \n\tItem.ICatCode,   \n\tAlternateAlias = (SELECT MAX(AA.CustomICode) FROM AlternateItemAlias AA WHERE AA.ICode=Item.ICode),\n\tItem.Packcode,   \n\tItem.ManfCode,   \n\tItem.SalePrice,   \n\tItem.PurPrice,   \n\tItem.RetailPrice,   \n\tItem.AvgPrice,   \n\tItem.SaleDiscPerc,   \n\tItem.PurDiscPerc,   \n\tItem.SalesTax,   \n\tItem.ReorderQty,   \n\tItem.OptimumQty,   \n\tItem.PackUnits,   \n\tItem.Active,   \n\tItem.Prescribed,   \n\tItem.Refrigrated,   \n\tItem.Printable,   \n\tItem.Location1,   \n\tItem.Remarks1,   \n\tItem.Location,   \n\tItem.Remarks,   \n\tItem.Gcode,   \n\tItem.saleprice2,\n\tItem.saleprice3,\n\tItem.RecentPurPrice,\n\tItem.GReorderQty,\n\tItem.GOptimumQty ,\n\tItem.AntiNorCotix,\n\tItem.Restricted,\n\titem.PackSalesTax,\n\titem.GSTPerc1,\n\titem.GSTPerc2,\n\titem.packingdesc,\n\titem.saleqty,\n\titem.bonusqty,\n\tItem.PrintExpiry,\n\tItem.UserCode,\n\tItem.LastUpdate,\n\tItem.locksaleprice,\n\tItem.lockdiscperc,\n\tItem.flatdisc,\n\tstock=(select isnull(sum(currqty),0) from godowndetail where godowndetail.icode=item.icode),\n\titem.salediscperc2,\n\titem.salediscperc3,\n\titem.salediscperc4,\n\titem.isizecode,\n\titem.istylecode,\n\titem.icolourcode,\n\titem.isleevecode,\n\titem.iyarncode,\n\titem.ifabriccode,\n\titem.ibrandcode,\n\titem.saleprice4,\n\titem.saleprice5,\n\titem.salediscperc5,\n\titem.minqty,\n\titem.IPartCode,\n\titem.OldPartCode,\n\titem.ItemYear,\n\titem.RemarksForPurchase,\n\titem.SizeDescription,\n\titem.ModelDescription,\n\titem.TypeDescription,\n\titem.GenericCode,\n\titem.TransitStock,\n\titem.PackingFactor,\n\titem.itemtypecode,\n\titem.DiscountedSalePrice,\n\titem.DiscountedPurPrice,\n\titem.SalePriceChangeMargin,\n\titem.GeneratePO,\n\titem.QtyUsed,\n\titem.MeasureUnitCode,\n\titem.MaxSaleDiscPerc,\n\titem.BonusPolicyCode,\n\titem.DiscountPolicyCode,\n\tItem.ItemDesignCode,\n\tItem.UnitWeight,\n\tItem.TotalPieces,\n\tItem.AlternatePurPrice,\n\tItem.PurFlatDisc,\n\tItem.ItemAlertCode,\n\tItem.MinSalePrice,\n\tItem.Taxable,\n\tItem.ForcePatientDoctorRecordInSale,\n\tItem.ForeignPrice,\n\tItem.CheckUpperSaleQtyLimit,\n\tItem.UpperSaleQtyLimit,\n\tmarkupperc=((saleprice - purprice)*100)/(case purprice when 0 then 1 else purprice end),\n\tItem.CommissionPerUnit,\n\tItem.CommissionPerc,\n\tItem.AllowDue,\n\tItem.LocalItemName,\n\tItem.ConfirmExpiry,\n\tItem.AllowSaleInDecimalQty,\n\tItem.Length,\n\tItem.Width,\n\tItem.AreaVolume, \n\tItem.Thickness,\n\tItem.Sheets,\n\tItem.Ingredients1,\n\tItem.Ingredients2,\n\tItem.ShortName,\n\tItem.LoyaltyItem,\n\tItem.RegdNo,\n\tItem.Gender,\n\tItem.Nationality,\n\tItem.BirthDate,\n\tItem.IssueDate,\n\tItem.ExpiryDate\nFROM\n\tItem  \nWHERE \n\tItem.ICode = :ar_icode\n\n",
  "update": "Item",
