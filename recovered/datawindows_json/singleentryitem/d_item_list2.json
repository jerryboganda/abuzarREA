  ],
  "retrieve": "SELECT \n\tPartNo=ItemPart.Name,\n\tOldPartNo=ISNULL((SELECT IP.Name FROM ItemPart IP WHERE IP.IpartCode = Item.OldPartCode), ''),\n\tItem.Name,   \n\tItem.ICode,   \n\tItem.CustomICode,   \n\tManufacturer.Name,\n\tItemPacking.name,\n\titemclass.name,\n\titemcategory.name,\n\tActive=case item.active when 1 then 'Y' else 'N' end, \n\tstock=(select isnull(sum(currqty),0) from godowndetail \n\t\t\twhere godowndetail.icode=item.icode)\nFROM\n\tItem \n\tLEFT OUTER JOIN ItemPacking ON (Item.Packcode = ItemPacking.PackCode)\n\tLEFT OUTER JOIN itemclass ON (Item.Iccode = itemClass.iccode),   \n\tManufacturer,\n\titemcategory,\n\titempart\nWHERE ( Item.ManfCode = Manufacturer.ManfCode )    and\n\t( Item.icatcode = itemcategory.Icatcode) and\n\t( Item.IPartCode = itemPart.iPartCode)\nOrder BY PartNo, Item.Name"
 },
