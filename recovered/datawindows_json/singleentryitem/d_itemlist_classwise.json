    "dbname": "Item.PurDiscPerc"
   }
  ],
  "retrieve": "SELECT\tItem.CustomICode,   \n\t\t\tNAME=RTRIM(LTRIM(Item.Name)) + ' ' + REPLICATE('-',50-LEN(RTRIM(LTRIM(Item.Name)))),\n\t\t\tItem.PackingDesc,\n\t\t\tItem.icode,   \n         PurPrice=(item.purprice/ISNULL(item.packunits,1)),   \n         Item.RetailPrice,    \n         Item.PackingDesc,   \n         SalePrice=(CASE  :ar_salepriceno WHEN 1 THEN item.saleprice/ISNULL(item.packunits,1)\n\t\t\t\t\t\t\t\t WHEN  2 THEN item.saleprice2/ISNULL(item.packunits,1)\n\t\t\t\t\t\t\t\t WHEN  3 THEN item.saleprice3/ISNULL(item.packunits,1)\n\t\t\t\t\t\t\t\t WHEN  4 THEN item.saleprice4/ISNULL(item.packunits,1)\n\t\t\t\t\t\t\t\t WHEN  5 THEN item.saleprice5/ISNULL(item.packunits,1)\n\t\t\t\t\t\t\tEND),\n\t\t\tSaleDiscPerc= (CASE :ar_salediscno WHEN 1 THEN salediscperc\n\t\t\t\t\t\t\t\t\t\tWHEN 2 THEN salediscperc2\n\t\t\t\t\t\t\t\t\t\tWHEN 3 THEN salediscperc3\n\t\t\t\t\t\t\t\t\t\tWHEN 4 THEN salediscperc4\n\t\t\t\t\t\t\t\t\t\tWHEN 5 THEN salediscperc5\n\t\t\t\t\t\t\t\tEND\n\t\t\t\t\t\t\t\t\t\t),\n\t\t\t\n\t\t\titemclass = CASE :as_type WHEN 'M' THEN ISNULL((SELECT Manufacturer.name FROM Manufacturer WHERE Manufacturer.ManfCode = item.manfcode), '')\n\t\t\tWHEN 'C' THEN ISNULL((SELECT ItemCategory.name FROM ItemCategory WHERE ItemCategory.ICatCode = item.icatcode), '')\n\t\t\tWHEN 'L' THEN ISNULL((SELECT ItemClass.name FROM ItemClass WHERE ItemClass.ICCode = item.iccode), '')\n\t\t\tELSE ISNULL((SELECT itempacking.name FROM itempacking WHERE itempacking.PackCode = item.packcode), '') END,\n\n\t\t\tItem.PurDiscPerc \n    FROM Item\n   WHERE \n\tCASE :as_type WHEN 'M' THEN Item.ManfCode\n\t\tWHEN 'C' THEN Item.ICatCode\n\t\tWHEN 'L' THEN Item.ICCode\n\t\t\t\t ELSE Item.PackCode END in (:aa_code) \nORDER BY itemclass,item.name\n\n\n\n",
  "update": "Item",
  "updatewhere": "0",
  "updatekeyinplace": "no",
