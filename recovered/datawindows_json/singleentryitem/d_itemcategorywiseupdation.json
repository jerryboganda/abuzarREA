  "retrieve": "SELECT\n\tICatCode,\n\tName = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = ItemCategoryWiseUpdation.ICatCode),\n\tUpdatePurPrice,\n\tUpdateSalePrice,\n\tUpdateSalePrice2,\n\tUpdateSalePrice3,\n\tUpdateSalePrice4,\n\tUpdateSalePrice5,\n\tUpdateSaleDiscPerc,\n\tUpdateSaleDiscPerc2 ,\n\tUpdateSaleDiscPerc3,\n\tUpdateSaleDiscPerc4,\n\tUpdateSaleDiscPerc5\nFROM\n\tItemCategoryWiseUpdation\nUNION ALL\nSELECT\n\tICatCode,\n\tName = ItemCategory.Name,\n\tUpdatePurPrice='N',\n\tUpdateSalePrice='N',\n\tUpdateSalePrice2='N',\n\tUpdateSalePrice3='N',\n\tUpdateSalePrice4='N',\n\tUpdateSalePrice5='N',\n\tUpdateSaleDiscPerc='N',\n\tUpdateSaleDiscPerc2='N',\n\tUpdateSaleDiscPerc3='N',\n\tUpdateSaleDiscPerc4='N',\n\tUpdateSaleDiscPerc5='N'\nFROM\n\tItemCategory \nWHERE ICatCode NOT IN (SELECT ICatCode FROM ItemCategoryWiseUpdation)",
