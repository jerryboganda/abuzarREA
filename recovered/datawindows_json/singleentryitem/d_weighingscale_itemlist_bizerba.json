    "dbname": "ChangePrice"
   },
   {
    "type": "char(50)",
    "updatewhereclause": "yes",
    "name": "item_name",
    "dbname": "Item_Name"
   }
  ],
  "retrieve": "SELECT \n\tADDREMOVE=0,\n\tItem_Num = I.CustomICode,\n\tDeptID = 1,\n\tPrice=CAST(I.SalePrice * CASE WHEN :ai_priceindecimals = 2 THEN 100 ELSE 1 END AS NUMERIC(18,0)),\n\tWeightItem=0,\n\tBarCodeStructureNo=21,\n\tExpiryDays=0,\n\tChangePrice=0,\n\tItem_Name = LEFT(I.Name, 50)\nFROM \n\tItem I\nWHERE\n\tCASE :as_grouping \n\tWHEN 'M' THEN I.ManfCode \n\tWHEN 'C' THEN I.ICatCode \n\tWHEN 'L' THEN I.ICCode \n\tWHEN 'P' THEN I.PackCode \n\tEND IN (:ai_groupcode) AND\n\tLEN(I.CustomICode) <= (SELECT WS.itemendpos - WS.itemstartpos + 1 FROM WeighingScale WS WHERE WS.WeighingScaleCode = :ai_weighingscalecode)\nORDER BY\n\tItem_Num",
  "arguments": {
   "_items": [
    {
     "_items": [
      "as_grouping",
      "string"
     ]
    },
    {
     "_items": [
      "ai_groupcode",
      "numberlist"
     ]
    },
    {
     "_items": [
      "ai_weighingscalecode",
      "number"
     ]
    },
    {
     "_items": [
      "ai_priceindecimals",
      "number"
     ]
    }
   ]
  }
 },
