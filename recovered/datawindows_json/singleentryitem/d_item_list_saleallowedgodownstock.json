   }
  ],
  "retrieve": "SELECT \n\tItem.Name,   \n\tItem.ICode,   \n\tItem.CustomICode,   \n\tManufacturer.Name,\n\tItemPacking.name,\n\titemclass.name,\n\titemcategory.name,\n\tActive=case item.active when 1 then 'Y'\n\t\t\t\telse 'N'\n\t\t\tend,\n\tstock = (select\tsum(dbo.godowndetail.currqty)\n\t\tfrom\tdbo.godowndetail \n\t\twhere\tdbo.godowndetail.icode = dbo.item.icode and\n\t\t\tdbo.godowndetail.gcode IN \n\t\t\t(SELECT Godown.GCode\n\t\t\tFROM Godown\n\t\t\tWHERE GCode IN\n\t\t\t\t(CASE (SELECT salegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)\n\t\t\t\tWHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = Godown.GCode)\n\t\t\t\tELSE (SELECT DISTINCT GCode From GroupAllowedGodown\n\t\t\t\t\tWHERE\tGroupAllowedGodown.GroupCode = :ai_groupcode AND\n\t\t\t\t\t\tGroupAllowedGodown.Module = 1 AND\n\t\t\t\t\t\tGroupAllowedGodown.GCode = Godown.GCode) END)))\nFROM \n\tItem \n\tLEFT OUTER JOIN ItemPacking ON (Item.Packcode = ItemPacking.PackCode)\n\tLEFT OUTER JOIN itemclass ON (Item.Iccode = itemClass.iccode),   \n\tManufacturer,\n\titemcategory\nWHERE \n\t( Item.ManfCode = Manufacturer.ManfCode )    and\n\t( Item.icatcode = itemcategory.Icatcode)",
  "arguments": {
   "_items": [
    {
     "_items": [
      "ai_groupcode",
      "number"
     ]
    }
   ]
  }
 },
