  "retrieve": "SELECT \n\tItem.Name,   \n\tItem.ICode,   \n\titem.purprice,\n\titem.saleprice,\n\titem.packunits,\n\tItem.CustomICode,   \n\tManufacturer.Name,\n\tItemPacking.name,\n\titemclass.name,\n\titemcategory.name,\n\titempart = (SELECT itempart.name FROM itempart where item.ipartcode = itempart.ipartcode),\n\tolditempart = (SELECT itempart.name FROM itempart where item.oldpartcode = itempart.ipartcode),\n\tActive=case item.active when 1 then 'Y'\n\t\t\t\telse 'N'\n\t\t\tend,\n\tstock=(select isnull(sum(currqty),0) from godowndetail \n\t\t\twhere godowndetail.icode=item.icode) ,\n\titemalertcode,\n\tAllowDue=Item.AllowDue,\n\tItemDesignCode,\n\tIBrandCode,\n\tLocation,\n\tShortName=Item.ShortName,\n\tLoyaltyItem=Item.LoyaltyItem,\n\tRegdNo = Item.RegdNo\nFROM\n\tItem \n\tLEFT OUTER JOIN ItemPacking ON (Item.Packcode = ItemPacking.PackCode)\n\tLEFT OUTER JOIN itemclass ON (Item.Iccode = itemClass.iccode),   \n\tManufacturer,\n\titemcategory\nWHERE\n\t( Item.ManfCode = Manufacturer.ManfCode )    and\n\t( Item.icatcode = itemcategory.Icatcode)"
 },
