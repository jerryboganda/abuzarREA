table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceResultHeader.ServiceResultCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="ServiceResultHeader.Date"  )
column=(type=long update=yes updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=servicedate dbname="ServiceDate"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode" 
 values=""  )
column=(type=char(60) updatewhereclause=yes name=fname dbname="FName"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=datetime updatewhereclause=yes name=dob dbname="DOB"  )
column=(type=long updatewhereclause=yes name=gestationcode dbname="GestationCode"  )
column=(type=long updatewhereclause=yes name=ageyears dbname="AgeYears"  )
column=(type=long updatewhereclause=yes name=agemonths dbname="AgeMonths"  )
column=(type=long updatewhereclause=yes name=agedays dbname="AgeDays"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=long updatewhereclause=yes name=locationcode dbname="LocationCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="ServiceResultHeader.UserCode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ServiceResultHeader.Remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="ServiceResultHeader.Posted"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="ServiceResultHeader.PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="ServiceResultHeader.PostedBY"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=serviceresultstampcode dbname="ServiceResultHeader.ServiceResultStampCode" 
 values=""  )
 retrieve="SELECT 
	ServiceResultHeader.ServiceResultCode,   
	ServiceResultHeader.Date,   
	ServiceInvCode = ServiceResultHeader.ServiceInvCode,
	ServiceDate = GETDATE(),
	PatientRegNo= 
		(SELECT P.RegNo 
		FROM Patient P 
		WHERE P.PatientCode IN 
			(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),
	PatientCode = 
		(SELECT P.PatientCode 
		FROM Patient P 
		WHERE P.PatientCode IN 
			(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),
	FName = 
		(SELECT P.FName
		FROM Patient P 
		WHERE P.PatientCode IN 
			(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),
	AdmissionCode= (SELECT SH.AdmissionCode FROM ServiceHeader SH WHERE SH.ServiceInvCode = ServiceResultHeader.ServiceInvCode),
	DOB= 
		(SELECT P.DOB
		FROM Patient P 
		WHERE P.PatientCode IN 
			(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),
	GestationCode = 
		(SELECT P.GestationCode
		FROM Patient P 
		WHERE P.PatientCode IN 
			(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),
	AgeYears = 
		(SELECT DATEDIFF(yy, P.DOB, getdate())
		FROM Patient P 
		WHERE P.PatientCode IN 
			(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),
	AgeMonths = 
		(SELECT CAST(DATEDIFF(dd, P.DOB, getdate()) % 360 / 30 AS INT)
		FROM Patient P 
		WHERE P.PatientCode IN 
			(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),
	AgeDays = 
		(SELECT CAST(DATEDIFF(dd, P.DOB, getdate()) % 360 % 30 AS INT)
		FROM Patient P 
		WHERE P.PatientCode IN 
			(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),
	Gender= 
		(SELECT P.Gender 
		FROM Patient P 
		WHERE P.PatientCode IN 
			(SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),
	LocationCode= (SELECT PA.LocationCode FROM PatientAdmission PA WHERE PA.AdmissionCode IN (SELECT SH.AdmissionCode FROM ServiceHeader SH WHERE SH.ServiceInvCode = ServiceResultHeader.ServiceInvCode)),
	ServiceResultHeader.UserCode,
	ServiceResultHeader.Remarks,
	ServiceResultHeader.Posted,
	ServiceResultHeader.PostDate,
	ServiceResultHeader.PostedBY,
	ServiceResultHeader.ServiceResultStampCode
FROM 
	ServiceResultHeader, ServiceHeader SH
WHERE 
	ServiceResultHeader.ServiceResultCode = :ai_code AND
	ServiceResultHeader.ServiceInvCode = SH.ServiceInvCode

"
  update="ServiceResultHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
