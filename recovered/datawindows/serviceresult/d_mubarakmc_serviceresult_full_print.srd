 values=""  )
column=(type=char(100) updatewhereclause=yes name=componentvalue dbname="ComponentValue"  )
column=(type=char(100) updatewhereclause=yes name=componentvalue2 dbname="ComponentValue2"  )
column=(type=char(100) updatewhereclause=yes name=lowerreferencevalue dbname="LowerReferenceValue"  )
column=(type=char(100) updatewhereclause=yes name=upperreferencevalue dbname="UpperReferenceValue"  )
column=(type=char(4000) updatewhereclause=yes name=comments dbname="Comments"  )
column=(type=char(100) updatewhereclause=yes name=testremarks dbname="TestRemarks"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(1) updatewhereclause=yes name=printable dbname="Printable"  )
column=(type=long updatewhereclause=yes name=priority dbname="Priority"  )
column=(type=char(400) updatewhereclause=yes name=detail1 dbname="Detail1"  )
column=(type=char(400) updatewhereclause=yes name=detail2 dbname="Detail2"  )
column=(type=char(400) updatewhereclause=yes name=detail3 dbname="Detail3"  )
column=(type=char(400) updatewhereclause=yes name=detail4 dbname="Detail4"  )
column=(type=char(400) updatewhereclause=yes name=detail5 dbname="Detail5"  )
column=(type=char(400) updatewhereclause=yes name=detail6 dbname="Detail6"  )
