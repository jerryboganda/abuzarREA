table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceResultDetail.ServiceResultCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=servicerowid dbname="ServiceResultDetail.ServiceRowID"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="ServiceCode" 
 values=""  )
column=(type=long key=yes update=yes updatewhereclause=yes name=rowid dbname="ServiceResultDetail.RowID"  )
column=(type=char(100) update=yes updatewhereclause=yes name=servicehead dbname="ServiceResultDetail.ServiceHead"  )
column=(type=long update=yes updatewhereclause=yes name=servicecomponentcode dbname="ServiceResultDetail.ServiceComponentCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=servicecomponentunitcode dbname="ServiceResultDetail.ServiceComponentUnitCode" 
 values=""  )
column=(type=char(1) updatewhereclause=yes initial="Y" name=askcomments dbname="AskComments"  )
column=(type=long updatewhereclause=yes name=servicecomponenttypecode dbname="ServiceComponentTypeCode"  )
column=(type=char(1) updatewhereclause=yes initial="S" name=valuetype dbname="ValueType"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=costprice dbname="ServiceResultDetail.CostPrice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=saleprice dbname="ServiceResultDetail.SalePrice"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=testmachinecode dbname="ServiceResultDetail.TestMachineCode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=componentvalue dbname="ServiceResultDetail.ComponentValue"  )
column=(type=char(100) update=yes updatewhereclause=yes name=componentvalue2 dbname="ServiceResultDetail.ComponentValue2"  )
column=(type=char(100) update=yes updatewhereclause=yes name=lowerreferencevalue dbname="ServiceResultDetail.LowerReferenceValue"  )
column=(type=char(100) update=yes updatewhereclause=yes name=upperreferencevalue dbname="ServiceResultDetail.UpperReferenceValue"  )
column=(type=long updatewhereclause=yes name=priority dbname="Priority"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ServiceResultDetail.Remarks"  )
column=(type=char(4000) update=yes updatewhereclause=yes name=comments dbname="ServiceResultDetail.Comments"  )
column=(type=datetime update=yes updatewhereclause=yes name=deliverydate dbname="ServiceResultDetail.DeliveryDate"  )
column=(type=char(1) update=yes updatewhereclause=yes name=printonreport dbname="ServiceResultDetail.PrintOnReport" 
 values="	Y/	N"  )
 retrieve="SELECT 
	ServiceResultDetail.ServiceResultCode,   
	ServiceResultDetail.ServiceRowID,   
	ServiceInvCode=
		(SELECT SH.ServiceInvCode FROM ServiceDetail SD, ServiceHeader SH
		WHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID AND SD.ServiceInvCode=SH.ServiceInvCode),
	ServiceCode = (SELECT ServiceCode FROM ServiceDetail SD WHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID),   
	ServiceResultDetail.RowID,   
	ServiceResultDetail.ServiceHead,
	ServiceResultDetail.ServiceComponentCode,   
	ServiceResultDetail.ServiceComponentUnitCode,   
	AskComments = (SELECT MAX(AskComments) FROM ServiceComponentType SCT
		WHERE SCT.ServiceComponentTypeCode IN 
			(SELECT S.ServiceComponentTypeCode 
			FROM ServiceComponent S 
			WHERE S.ServiceComponentCode = ServiceResultDetail.ServiceComponentCode)),
	ServiceComponentTypeCode = 
		(SELECT S.ServiceComponentTypeCode 
		FROM ServiceComponent S 
		WHERE S.ServiceComponentCode = ServiceResultDetail.ServiceComponentCode),
	ValueType = 
		(SELECT U.ValueType 
		FROM ServiceComponentUnit U 
		WHERE U.ServiceComponentUnitCode IN 
			(SELECT SC.ServiceComponentUnitCode 
			FROM ServiceComponent SC 
			WHERE SC.ServiceComponentCode = ServiceResultDetail.ServiceComponentCode)),
	ServiceResultDetail.CostPrice,   
	ServiceResultDetail.SalePrice,   
	ServiceResultDetail.TestMachineCode,
	ServiceResultDetail.ComponentValue,
	ServiceResultDetail.ComponentValue2,
	ServiceResultDetail.LowerReferenceValue, 
	ServiceResultDetail.UpperReferenceValue, 
	Priority = (SELECT SB.Priority FROM ServiceBreakUp SB WHERE SB.ServiceCode IN (SELECT ServiceCode FROM ServiceDetail SD WHERE SD.SrvRowID = ServiceResultDetail.ServiceRowID) AND SB.ServiceComponentCode = ServiceResultDetail.ServiceComponentCode),
	ServiceResultDetail.Remarks,
	ServiceResultDetail.Comments,
	ServiceResultDetail.DeliveryDate,
	ServiceResultDetail.PrintOnReport
FROM 
	ServiceResultDetail
WHERE 
	ServiceResultDetail.ServiceResultCode = :ai_code
"
  update="ServiceResultDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
 sort="code A, servicecode A, priority A, servicehead A, rowid A"
)
