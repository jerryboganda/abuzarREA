footer(height=0 color="536870912" )
detail(height=60 color="536870912"  height.autosize=yes)
table(column=(type=char(201) updatewhereclause=yes name=deliverydate2 dbname="DeliveryDate2"  )
column=(type=datetime updatewhereclause=yes name=deliverydate dbname="DeliveryDate"  )
column=(type=char(157) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=long updatewhereclause=yes name=servicerowid dbname="ServiceRowID"  )
column=(type=char(1) updatewhereclause=yes name=printreport dbname="PrintReport" 
 values="	Y/	N"  )
column=(type=long updatewhereclause=yes name=code dbname="ServiceResultCode"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted" 
 values="Yes	Y/No	N/"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=long updatewhereclause=yes name=postedby dbname="PostedBY" 
 values=""  )
 retrieve="SELECT 
	DeliveryDate2 = CONVERT(VARCHAR(100), SRD.DeliveryDate, 103) + ' ' + CONVERT(VARCHAR(100), SRD.DeliveryDate, 108),
	DeliveryDate = SRD.DeliveryDate,
	PatientName=
		(SELECT P.Name + ' (' + ISNULL(P.RegNo,'') + ') ' + 
			CASE WHEN P.AgeYears <= 0 OR P.AgeYears IS NULL THEN '' ELSE STR(ISNULL(P.AgeYears, ''), 5) + ' Years ' END +
			CASE WHEN P.AgeMonths <= 0 OR P.AgeMonths IS NULL THEN '' ELSE STR(ISNULL(P.AgeMonths, ''), 5) + ' Months ' END +
			CASE WHEN P.AgeDays <= 0 OR P.AgeDays IS NULL  THEN '' ELSE STR(ISNULL(P.AgeDays, ''), 5) + ' Days ' END +
			CASE P.Gender WHEN 'M' THEN ' MALE' ELSE ' FEMALE' END
		FROM Patient P WHERE P.PatientCode IN 
			(ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),
	RegNo = (SELECT P.RegNo FROM Patient P 
				WHERE P.PatientCode IN (SELECT ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)))),
	ServiceName=S.Name,
	ServiceRowID=SRD.ServiceRowID,
	PrintReport='Y',
	ServiceResultCode = SRH.ServiceResultCode,
	ServiceInvCode = SRH.ServiceInvCode,
	Date = SRH.Date,
	UserCode = SRH.UserCode,
	PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)),
	AdmissionCode = SH.AdmissionCode,
	Posted=SRH.Posted,
	PostDate = SRH.PostDate,
	PostedBY = SRH.PostedBy
FROM
	ServiceResultHeader SRH,
	ServiceResultDetail SRD,
	ServiceHeader SH,
	ServiceDetail SD,
	Service S
WHERE
	CONVERT(VARCHAR(100), SRD.DeliveryDate, 103) + ' ' + CONVERT(VARCHAR(100), SRD.DeliveryDate, 108) = CASE WHEN :adt_date IS NULL THEN CONVERT(VARCHAR(100), SRD.DeliveryDate, 103) + ' ' + CONVERT(VARCHAR(100), SRD.DeliveryDate, 108) ELSE :adt_date END AND
	SRH.ServiceInvCode = SH.ServiceInvCode AND
	SRH.ServiceResultCode = SRD.ServiceResultCode AND
	SRD.ServiceRowID = SD.SrvRowID AND
	SD.ServiceCode = S.ServiceCode AND
	SRH.Posted='N' AND
	S.ResultRequired='Y'
GROUP BY
	SRD.DeliveryDate,
	SRD.ServiceRowID,
	SH.PatientCode,
	SH.AdmissionCode,
	S.Name,
	SRH.ServiceInvCode,
	SRH.ServiceResultCode,
	SRH.Date,
	SRH.UserCode,
	SRH.Posted,
	SRH.PostDate,
	SRH.PostedBy
	
"
  arguments=(("adt_date", string))
 sort="deliverydate D, serviceinvcode A, servicerowid A, servicename A, patientname A"
)
