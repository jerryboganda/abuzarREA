release 12.5;
datawindow ( units=2 timer_interval=0 processing=7 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 pointer="ARROW!"  print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no richtext.inputfieldbackcolor=0 richtext.backcolor=0  richtext.headerfooter=no richtext.popmenu=no richtext.wordwrap=no)
 detail(text="")
 header(text="")
 footer(text="")
table(column=(type=char(4000) updatewhereclause=yes name=comments dbname="Comments"  )
 retrieve="SELECT
	Comments = D.Comments
FROM
	ServiceHeader SH,
	ServiceDetail SVD,
	ServiceResultHeader H,
	ServiceResultDetail D,
	ServiceComponent SC,
	Service S,
	Users U
WHERE
	H.ServiceResultCode = :ai_code AND 
	D.RowID = :ai_rowid AND
	H.ServiceInvCode = SH.ServiceInvCode AND
	H.ServiceInvCode = SVD.ServiceInvCode AND
	H.ServiceResultCode = D.ServiceResultCode AND
	D.ServiceRowID = SVD.SrvRowID AND
	SVD.ServiceCode = S.ServiceCode AND
	D.ServiceComponentCode = SC.ServiceComponentCode AND
	H.UserCode = U.UserCode
ORDER BY
	H.ServiceResultCode,
	D.ServiceRowID,
	D.ServiceHead,
	D.RowId"
  arguments=(("ai_code", number), ("ai_rowid", number))
)
column(id=1 width="0" alignment="0" format="[general]" visible="1" tabsequence=0 lineremove=no multiline=no width.autosize=yes )
