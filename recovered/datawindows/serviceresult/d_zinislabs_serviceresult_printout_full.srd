table(column=(type=long updatewhereclause=yes name=serviceresultcode dbname="ServiceResultCode"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=char(100) updatewhereclause=yes name=patientrefby dbname="PatientRefBy"  )
column=(type=datetime updatewhereclause=yes name=servicebookingdate dbname="ServiceBookingDate"  )
column=(type=datetime updatewhereclause=yes name=deliverydueon dbname="DeliveryDueOn"  )
column=(type=datetime updatewhereclause=yes name=resultdate dbname="ResultDate"  )
column=(type=long updatewhereclause=yes name=servicerowid dbname="ServiceRowID"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(60) updatewhereclause=yes name=serviccategory dbname="ServicCategory"  )
column=(type=char(60) updatewhereclause=yes name=doctorname dbname="DoctorName"  )
column=(type=long updatewhereclause=yes name=printonnewpage dbname="PrintOnNewPage"  )
column=(type=char(1) updatewhereclause=yes name=printrefrange dbname="ServiceComponent.PrintRefRange"  )
column=(type=char(4000) updatewhereclause=yes name=refdescription dbname="ServiceComponent.RefDescription"  )
column=(type=char(60) updatewhereclause=yes name=service dbname="Service"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=datetime updatewhereclause=yes name=dob dbname="DOB"  )
column=(type=long updatewhereclause=yes name=ageyears dbname="AgeYears"  )
column=(type=long updatewhereclause=yes name=agemonths dbname="AgeMonths"  )
column=(type=long updatewhereclause=yes name=agedays dbname="AgeDays"  )
column=(type=char(100) updatewhereclause=yes name=servicehead dbname="ServiceHead"  )
column=(type=char(100) updatewhereclause=yes name=servicecomponent dbname="ServiceComponent"  )
column=(type=char(100) updatewhereclause=yes name=servicecomponenttype dbname="ServiceComponentType"  )
column=(type=long updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=long updatewhereclause=yes name=servicecomponentunitcode dbname="ServiceComponentUnitCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=componentvalue dbname="ComponentValue"  )
column=(type=char(100) updatewhereclause=yes name=componentvalue2 dbname="ComponentValue2"  )
column=(type=char(100) updatewhereclause=yes name=lowerreferencevalue dbname="LowerReferenceValue"  )
column=(type=char(100) updatewhereclause=yes name=upperreferencevalue dbname="UpperReferenceValue"  )
column=(type=char(4000) updatewhereclause=yes name=comments dbname="Comments"  )
column=(type=char(100) updatewhereclause=yes name=testremarks dbname="TestRemarks"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(1) updatewhereclause=yes name=printable dbname="Printable"  )
column=(type=long updatewhereclause=yes name=priority dbname="Priority"  )
column=(type=char(400) updatewhereclause=yes name=detail1 dbname="Detail1"  )
column=(type=char(400) updatewhereclause=yes name=detail2 dbname="Detail2"  )
column=(type=char(400) updatewhereclause=yes name=detail3 dbname="Detail3"  )
column=(type=char(400) updatewhereclause=yes name=detail4 dbname="Detail4"  )
column=(type=char(400) updatewhereclause=yes name=detail5 dbname="Detail5"  )
column=(type=char(400) updatewhereclause=yes name=detail6 dbname="Detail6"  )
 retrieve="SELECT 
	ServiceResultCode=H.ServiceResultCode,
	ServiceInvCode = H.ServiceInvCode,
	HeaderNo=SH.HeaderNo,
	PatientRefBy=SH.PatientRefBy,
	ServiceBookingDate = SH.Date,
	DeliveryDueOn  = SVD.DeliveryDate,
	ResultDate=H.Date,
	ServiceRowID=D.ServiceRowID,
	UserName=U.UserName,
	ServicCategory = (SELECT SCT.Name FROM ServiceCategory SCT WHERE SCT.ServiceCatCode = S.ServiceCatCode),
	DoctorName=(SELECT D.Name FROM Doctors D WHERE D.DoctCode = SH.DoctCode),
	PrintOnNewPage = CASE S.PrintOnNewPage WHEN 'N' THEN 0 ELSE 1 END,
	SC.PrintRefRange,
	SC.RefDescription,
	Service = S.Name,
	RegNo=
		(SELECT P.RegNo
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, 
			(SELECT PA.PatientCode 
			FROM PatientAdmission PA 
			WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	Patient=
		(SELECT P.Name
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, 
			(SELECT PA.PatientCode 
			FROM PatientAdmission PA 
			WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	Gender = (SELECT P.Gender
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, 
			(SELECT PA.PatientCode 
			FROM PatientAdmission PA 
			WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	DOB = (SELECT P.DOB
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, 
			(SELECT PA.PatientCode 
			FROM PatientAdmission PA 
			WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	AgeYears=
		(SELECT AY=DATEDIFF(yy, P.DOB, getdate()) + 1
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, 
			(SELECT PA.PatientCode 
			FROM PatientAdmission PA 
			WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	AgeMonths=
		(SELECT AM=CAST(DATEDIFF(dd, P.DOB, getdate()) % 360 / 30 AS INT)
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	AgeDays=
		(SELECT AD=CAST(DATEDIFF(dd, P.DOB, getdate()) % 360 % 30 AS INT)
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	ServiceHead = D.ServiceHead,
	ServiceComponent = SC.Name,
	ServiceComponentType = SCT.Name,
	RowID = D.RowID,
	ServiceComponentUnitCode = D.ServiceComponentUnitCode,
	ComponentValue= D.ComponentValue,
	ComponentValue2= D.ComponentValue2,
	LowerReferenceValue = D.LowerReferenceValue,
	UpperReferenceValue = D.UpperReferenceValue,
	Comments = D.Comments,
	TestRemarks = D.Remarks,
	Remarks = H.Remarks,
	Printable = S.Printable,
	Priority = SB.Priority,
	Detail1 = (SELECT T.Detail1 FROM ServiceResultStamp T WHERE H.ServiceResultStampCode = T.ServiceResultStampCode),
	Detail2 = (SELECT T.Detail2 FROM ServiceResultStamp T WHERE H.ServiceResultStampCode = T.ServiceResultStampCode),
	Detail3 = (SELECT T.Detail3 FROM ServiceResultStamp T WHERE H.ServiceResultStampCode = T.ServiceResultStampCode),
	Detail4 = (SELECT T.Detail4 FROM ServiceResultStamp T WHERE H.ServiceResultStampCode = T.ServiceResultStampCode),
	Detail5 = (SELECT T.Detail5 FROM ServiceResultStamp T WHERE H.ServiceResultStampCode = T.ServiceResultStampCode),
	Detail6 = (SELECT T.Detail6 FROM ServiceResultStamp T WHERE H.ServiceResultStampCode = T.ServiceResultStampCode)
FROM
	ServiceResultHeader H,
	ServiceResultDetail D,
	ServiceHeader SH,
	ServiceDetail SVD,
	Customer C,
	ServiceComponent SC,
	ServiceComponentType SCT,
	Service S,
	ServiceBreakUp SB,
	Users U
WHERE
	H.ServiceResultCode = :ai_code AND 
	H.ServiceInvCode = SH.ServiceInvCode AND
	SH.CustCode = C.CustCode AND
	H.ServiceInvCode = SVD.ServiceInvCode AND
	H.ServiceResultCode = D.ServiceResultCode AND
	D.ServiceRowID = SVD.SrvRowID AND
	SVD.ServiceCode = S.ServiceCode AND
	S.ServiceCode = SB.ServiceCode AND
	D.ServiceComponentCode = SC.ServiceComponentCode AND
	D.ServiceComponentCode = SB.ServiceComponentCode AND
	SB.ServiceComponentCode = SC.ServiceComponentCode AND
	SC.ServiceComponentTypeCode = SCT.ServiceComponentTypeCode AND
	H.UserCode = U.UserCode AND
	C.PrintOutstandingServiceResult = 'Y' AND
	D.PrintOnReport = 'Y'
UNION ALL
SELECT
	ServiceResultCode=H.ServiceResultCode,
	ServiceInvCode = H.ServiceInvCode,
	HeaderNo=SH.HeaderNo,
	PatientRefBy=SH.PatientRefBy,
	ServiceBookingDate = SH.Date,
	DeliveryDueOn  = SVD.DeliveryDate,
	ResultDate=H.Date,
	ServiceRowID=D.ServiceRowID,
	UserName=U.UserName,
	ServicCategory = (SELECT SCT.Name FROM ServiceCategory SCT WHERE SCT.ServiceCatCode = S.ServiceCatCode),
	DoctorName=(SELECT D.Name FROM Doctors D WHERE D.DoctCode = SH.DoctCode),
	PrintOnNewPage = CASE S.PrintOnNewPage WHEN 'N' THEN 0 ELSE 1 END,
	SC.PrintRefRange,
	SC.RefDescription,
	Service = S.Name,
	RegNo=
		(SELECT P.RegNo
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, 
			(SELECT PA.PatientCode 
			FROM PatientAdmission PA 
			WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	Patient=
		(SELECT P.Name
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, 
			(SELECT PA.PatientCode 
			FROM PatientAdmission PA 
			WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	Gender = (SELECT P.Gender
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, 
			(SELECT PA.PatientCode 
			FROM PatientAdmission PA 
			WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	DOB = (SELECT P.DOB
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, 
			(SELECT PA.PatientCode 
			FROM PatientAdmission PA 
			WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	AgeYears=
		(SELECT AY=DATEDIFF(yy, P.DOB, getdate()) + 1
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, 
			(SELECT PA.PatientCode 
			FROM PatientAdmission PA 
			WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	AgeMonths=
		(SELECT AM=CAST(DATEDIFF(dd, P.DOB, getdate()) % 360 / 30 AS INT)
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	AgeDays=
		(SELECT AD=CAST(DATEDIFF(dd, P.DOB, getdate()) % 360 % 30 AS INT)
		FROM Patient P
		WHERE ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode)) = P.PatientCode), 
	ServiceHead = D.ServiceHead,
	ServiceComponent = SC.Name,
	ServiceComponentType = SCT.Name,
	RowID = D.RowID,
	ServiceComponentUnitCode = D.ServiceComponentUnitCode,
	ComponentValue= D.ComponentValue,
	ComponentValue2= D.ComponentValue2,
	LowerReferenceValue = D.LowerReferenceValue,
	UpperReferenceValue = D.UpperReferenceValue,
	Comments = D.Comments,
	TestRemarks = D.Remarks,
	Remarks = H.Remarks,
	Printable = S.Printable,
	Priority = SB.Priority,
	Detail1 = (SELECT T.Detail1 FROM ServiceResultStamp T WHERE H.ServiceResultStampCode = T.ServiceResultStampCode),
	Detail2 = (SELECT T.Detail2 FROM ServiceResultStamp T WHERE H.ServiceResultStampCode = T.ServiceResultStampCode),
	Detail3 = (SELECT T.Detail3 FROM ServiceResultStamp T WHERE H.ServiceResultStampCode = T.ServiceResultStampCode),
	Detail4 = (SELECT T.Detail4 FROM ServiceResultStamp T WHERE H.ServiceResultStampCode = T.ServiceResultStampCode),
	Detail5 = (SELECT T.Detail5 FROM ServiceResultStamp T WHERE H.ServiceResultStampCode = T.ServiceResultStampCode),
	Detail6 = (SELECT T.Detail6 FROM ServiceResultStamp T WHERE H.ServiceResultStampCode = T.ServiceResultStampCode)
FROM
	ServiceResultHeader H,
	ServiceResultDetail D,
	ServiceHeader SH,
	ServiceDetail SVD,
	Customer C,
	ServiceComponent SC,
	ServiceComponentType SCT,
	Service S,
	ServiceBreakUp SB,
	Users U
WHERE
	H.ServiceResultCode = :ai_code AND 
	H.ServiceInvCode = SH.ServiceInvCode AND
	SH.CustCode = C.CustCode AND
	H.ServiceInvCode = SVD.ServiceInvCode AND
	H.ServiceResultCode = D.ServiceResultCode AND
	D.ServiceRowID = SVD.SrvRowID AND
	SVD.ServiceCode = S.ServiceCode AND
	S.ServiceCode = SB.ServiceCode AND
	D.ServiceComponentCode = SC.ServiceComponentCode AND
	D.ServiceComponentCode = SB.ServiceComponentCode AND
	SB.ServiceComponentCode = SC.ServiceComponentCode AND
	SC.ServiceComponentTypeCode = SCT.ServiceComponentTypeCode AND
	H.UserCode = U.UserCode AND
	C.PrintOutstandingServiceResult = 'N' AND
	SH.OutStandingAmt <= 0 AND
	D.PrintOnReport = 'Y'
ORDER BY
	PrintOnNewPage,
	D.ServiceRowID,
	Priority,
	D.ServiceHead,
	D.RowID"
  arguments=(("ai_code", number))
 filter="componentvalue<>'' AND NOT ISNULL(componentvalue)"
 )
