release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=144 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long updatewhereclause=yes name=serviceresultcode dbname="ServiceResultCode"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="ServiceCode"  )
column=(type=long updatewhereclause=yes name=servicecomponentcode dbname="ServiceComponentCode"  )
column=(type=char(100) updatewhereclause=yes name=componentvalue dbname="ComponentValue"  )
column=(type=char(100) updatewhereclause=yes name=componentvalue2 dbname="ComponentValue2"  )
 retrieve="SELECT 
	ServiceResultCode=SRD.ServiceResultCode,
	ServiceCode=SD.ServiceCode,
	ServiceComponentCode=SRD.ServiceComponentCode,
	ComponentValue = MAX(SRD.ComponentValue),
	ComponentValue2 = MAX(SRD.ComponentValue2)
FROM 
	ServiceResultDetail SRD, ServiceDetail SD
WHERE 
	ServiceResultCode=:al_ServiceResultCode AND
	SRD.ServiceComponentCode = :al_servicecompcode AND
	SRD.ServiceRowID = SD.SrvrowID AND
	SD.ServiceCode = :al_servicecode
GROUP BY
	SRD.ServiceResultCode,
	SD.ServiceCode,
	SRD.ServiceComponentCode
"
  arguments=(("al_serviceresultcode", number), ("al_servicecode", number), ("al_servicecompcode", number))
)
