 retrieve="SELECT code=0, customer=space(100), CustRefNo=SPACE(100),type=space(100),Icode=0, aliasname=space(100), itemname=space(100), Qty=0.0000, Stock=0.0000, stockloosepack = ' ', balance=0.0000, balanceloosepack='',suppcode=0,suppname=space(100)"
