table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="WorkOrderAccount.WorkOrderAccCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="WorkOrderAccount.Name"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=description dbname="WorkOrderAccount.Description"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid limit value'" initial="0" name=limit dbname="WorkOrderAccount.Limit"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="D" name=drcr dbname="WorkOrderAccount.DrCr" 
 values="Debit	D/Credit	C|/"  )
 retrieve="SELECT 
	WorkOrderAccount.WorkOrderAccCode,   
	WorkOrderAccount.Name,   
	WorkOrderAccount.Description,   
	WorkOrderAccount.Limit,   
	WorkOrderAccount.DrCr  
FROM 
	WorkOrderAccount  
WHERE 
	WorkOrderAccount.WorkOrderAccCode = :ai_code    
"
  update="WorkOrderAccount" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
