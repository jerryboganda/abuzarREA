release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1437 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=ordercode dbname="OrderCode"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="CustomerAlias"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=char(1) updatewhereclause=yes name=finalized dbname="Finalized"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="ItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=decimal(4) updatewhereclause=yes name=orderqty dbname="OrderQty"  )
column=(type=decimal(4) updatewhereclause=yes name=orderbonus dbname="OrderBonus"  )
column=(type=long updatewhereclause=yes name=rowid dbname="Rowid"  )
column=(type=decimal(4) updatewhereclause=yes name=godownstock dbname="GodownStock"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="TotalStock"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
 retrieve="SELECT
	OrderCode=H.SaleOrderCode,
	CustomerAlias=A.AliasName,
	Date = H.Date,
	Customer=A.Name,
	Posted=H.Posted,
	Finalized=H.Finalized,
	ItemAlias=I.CustomICode, 
	Item=I.Name, 
	Godown = (SELECT G.Name FROM Godown G WHERE G.GCode = D.GCode),
	OrderQty=SUM(D.LooseQty),
	OrderBonus=SUM(D.BonusQty), 
	Rowid = MAX(D.RowID),
	GodownStock = ISNULL((SELECT SUM(GD.CurrQty) 
						FROM GodownDetail GD
						WHERE GD.ICode = I.ICode AND GD.GCode = D.GCode), 0),
	TotalStock = ISNULL((SELECT SUM(GD.CurrQty) 
						FROM GodownDetail GD
						WHERE GD.ICode = I.ICode), 0),
	SalePrice=MAX(D.SalePrice)
FROM
	SaleOrderHeader H, 
	SaleOrderDetail D, 
	Accounts A,
	Item I
WHERE
	H.SaleOrderCode = :ai_code AND
	H.SaleOrderCode = D.SaleOrderCode AND
	H.CustCode = A.AccCode AND
	D.ICode = I.ICode
GROUP BY
	H.SaleOrderCode,
	A.AliasName,
	H.Date,
	A.Name,
	H.Posted,
	H.Finalized,
	I.ICode, 
	I.CustomICode, 
	I.Name, 
	D.GCode
ORDER BY
	OrderCode,
	Rowid,
	Item
"
  arguments=(("ai_code", number))
)
