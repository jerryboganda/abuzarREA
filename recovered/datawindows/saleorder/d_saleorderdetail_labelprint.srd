compute(name=c_sumitemflatdisc visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="5161" y="3" height="61" width="256" format="###0.00" expression="sum(itemflatdisc*looseqty for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumitemdiscval visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="5426" y="3" height="61" width="283" format="###0.00" expression="sum( round(((saleprice - itemflatdisc)*discperc*0.01)*looseqty,2) for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_detaildwtotal visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="8855" y="3" height="61" width="357" format="[General]" expression="sum( ( ( looseqty *  (saleprice -  itemflatdisc )) ) *  ( 1-  (  discperc  *  .01 )  )  for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumtaxval visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="9554" y="3" height="61" width="247" format="###0.00" expression="sum( round( unitsalestax  * (Bonusqty + looseqty) ,2)  for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumgstval visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="10057" y="3" height="61" width="238" format="###0.00" expression="sum( round( c_itemtotal  *  gstperc * 0.01,2)  for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
