 retrieve="SELECT   
	Type = 'Work Order',
	WorkOrderCode=WorkOrder.WorkOrderCode,
	aliasname = accounts.aliasname,
	CustCode=WorkOrder.CustCode,
	CustomerName=Accounts.Name,
	Date=WorkOrder.Date,
	UserCode=WorkOrder.UserCode,
	InitiatedBy=WorkOrder.InitiatedBy,
	Address=WorkOrder.Address,
	ContactNo=WorkOrder.ContactNo,
	Email=WorkOrder.Email,
	AvailabilityToVisit=WorkOrder.AvailabilityToVisit,
	Complaint=WorkOrder.Complaint,
	Demand=WorkOrder.Demand,
	Remarks=WorkOrder.Remarks,
	Approved=WorkOrder.Approved,
	ApprovedOn=WorkOrder.ApprovedOn,
	ApprovedBy=WorkOrder.ApprovedBy,
	Posted=WorkOrder.Posted,
	PostedOn=WorkOrder.PostedOn,
	PostedBy=WorkOrder.PostedBy,
	AssessmentDate = (SELECT WOA.Date FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	AssessmentUser = (SELECT U.UserName FROM WorkOrderassessment WOA, Users U WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode AND WOA.UserCode=U.UserCode),
	AssessedON = (SELECT WOA.AssessedON FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	AssessedBy = (SELECT WOA.AssessedBy FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	Assessment = (SELECT WOA.Assessment FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	ActionProposed = (SELECT WOA.ActionProposed FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	AssessmentRemarks = (SELECT WOA.Remarks FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	Detail_On = WorkOrderResource.Date,
	Detail_By = (SELECT U.UserName FROM Users U WHERE WorkOrderResource.UserCode=U.UserCode),
	Description = (SELECT R.Name FROM Resource R WHERE R.ResourceCode = WorkOrderResource.ResourceCode),
	Qty = WorkOrderResource.Qty,
	Cost = WorkOrderResource.Cost,
	EstTimeReq = WorkOrderResource.EstTimeReq,
	TimeTaken = WorkOrderResource.TimeTaken,
	Remarks = WorkOrderResource.Remarks,
	SourceGodown=NULL,
	TargetGodown=NULL
FROM  
	customer , 
	WorkOrder
	LEFT OUTER JOIN WorkOrderResource ON (WorkOrder.WorkOrderCode = WorkOrderResource.WorkOrderCode),
	users, 
	accounts  
WHERE 
	WorkOrder.WorkOrderCode = :ai_code AND
	WorkOrder.custcode = customer.custcode and 
	users.usercode = WorkOrder.Usercode and 
	WorkOrder.custcode = accounts.acccode
UNION ALL
SELECT   
	Type = 'Work Order - Items Issued',
	WorkOrderCode=WorkOrder.WorkOrderCode,
	aliasname = accounts.aliasname,
	CustCode=WorkOrder.CustCode,
	CustomerName=Accounts.Name,
	Date=WorkOrder.Date,
	UserCode=WorkOrder.UserCode,
	InitiatedBy=WorkOrder.InitiatedBy,
	Address=WorkOrder.Address,
	ContactNo=WorkOrder.ContactNo,
	Email=WorkOrder.Email,
	AvailabilityToVisit=WorkOrder.AvailabilityToVisit,
	Complaint=WorkOrder.Complaint,
	Demand=WorkOrder.Demand,
	Remarks=WorkOrder.Remarks,
	Approved=WorkOrder.Approved,
	ApprovedOn=WorkOrder.ApprovedOn,
	ApprovedBy=WorkOrder.ApprovedBy,
	Posted=WorkOrder.Posted,
	PostedOn=WorkOrder.PostedOn,
	PostedBy=WorkOrder.PostedBy,
	AssessmentDate = (SELECT WOA.Date FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	AssessmentUser = (SELECT U.UserName FROM WorkOrderassessment WOA, Users U WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode AND WOA.UserCode=U.UserCode),
	AssessedON = (SELECT WOA.AssessedON FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	AssessedBy = (SELECT WOA.AssessedBy FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	Assessment = (SELECT WOA.Assessment FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	ActionProposed = (SELECT WOA.ActionProposed FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	AssessmentRemarks = (SELECT WOA.Remarks FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	Detail_On = IssueHeader.Date,
	Detail_By = (SELECT U.UserName FROM Users U WHERE IssueHeader.SalesmanCode=U.UserCode),
	Description = (SELECT I.Name FROM Item I WHERE I.ICode = IssueDetail.ICode),
	Qty=issuedetail.qty,
	Cost = IssueDetail.Avgprice,
	EstTimeReq = 1,
	TimeTaken = 1,
	Remarks = IssueDetail.ItemDescription,
	SourceGodown=issuedetail.gcode,
	TargetGodown=NULL
FROM
	customer , 
	WorkOrder,
	users, 
	accounts,
	issueheader,
	issuedetail,
	item, 
	recipient
WHERE  
	WorkOrder.WorkOrderCode = :ai_code AND
	WorkOrder.custcode = customer.custcode and 
	users.usercode = WorkOrder.Usercode and 
	WorkOrder.custcode = accounts.acccode AND
	issueheader.WorkOrderCode IS NOT NULL AND
	issueheader.WorkOrderCode = WorkOrder.WorkOrderCode AND
	issueheader.recipientcode = recipient.recipientcode and
	issueheader.issueinvcode=issuedetail.issueinvcode and
	issuedetail.icode=item.icode 
UNION ALL
SELECT   
	Type = 'Work Order - Items Receipt',
	WorkOrderCode=WorkOrder.WorkOrderCode,
	aliasname = accounts.aliasname,
	CustCode=WorkOrder.CustCode,
	CustomerName=Accounts.Name,
	Date=WorkOrder.Date,
	UserCode=WorkOrder.UserCode,
	InitiatedBy=WorkOrder.InitiatedBy,
	Address=WorkOrder.Address,
	ContactNo=WorkOrder.ContactNo,
	Email=WorkOrder.Email,
	AvailabilityToVisit=WorkOrder.AvailabilityToVisit,
	Complaint=WorkOrder.Complaint,
	Demand=WorkOrder.Demand,
	Remarks=WorkOrder.Remarks,
	Approved=WorkOrder.Approved,
	ApprovedOn=WorkOrder.ApprovedOn,
	ApprovedBy=WorkOrder.ApprovedBy,
	Posted=WorkOrder.Posted,
	PostedOn=WorkOrder.PostedOn,
	PostedBy=WorkOrder.PostedBy,
	AssessmentDate = (SELECT WOA.Date FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	AssessmentUser = (SELECT U.UserName FROM WorkOrderassessment WOA, Users U WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode AND WOA.UserCode=U.UserCode),
	AssessedON = (SELECT WOA.AssessedON FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	AssessedBy = (SELECT WOA.AssessedBy FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	Assessment = (SELECT WOA.Assessment FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	ActionProposed = (SELECT WOA.ActionProposed FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	AssessmentRemarks = (SELECT WOA.Remarks FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	Detail_On = receiptHeader.Date,
	Detail_By = (SELECT U.UserName FROM Users U WHERE receiptHeader.SalesmanCode=U.UserCode),
	Description = (SELECT I.Name FROM Item I WHERE I.ICode = receiptDetail.ICode),
	Qty=receiptdetail.qty,
	Cost = receiptDetail.AvgPrice,
	EstTimeReq = 1,
	TimeTaken = 1,
	Remarks = receiptDetail.ItemDescription,
	SourceGodown=NULL,
	TargetGodown=Receiptdetail.gcode
FROM
	customer , 
	WorkOrder,
	users, 
	accounts,
	receiptheader,
	receiptdetail,
	item, 
	recipient
WHERE  
	WorkOrder.WorkOrderCode = :ai_code AND
	WorkOrder.custcode = customer.custcode and 
	users.usercode = WorkOrder.Usercode and 
	WorkOrder.custcode = accounts.acccode AND
	receiptheader.WorkOrderCode IS NOT NULL AND
	receiptheader.WorkOrderCode = WorkOrder.WorkOrderCode AND
	receiptheader.recipientcode = recipient.recipientcode and
	receiptheader.receiptinvcode=receiptdetail.receiptinvcode and
	receiptdetail.icode=item.icode 
UNION ALL
SELECT   
	Type = 'Work Order - Items Transfered',
	WorkOrderCode=WorkOrder.WorkOrderCode,
	aliasname = accounts.aliasname,
	CustCode=WorkOrder.CustCode,
	CustomerName=Accounts.Name,
	Date=WorkOrder.Date,
	UserCode=WorkOrder.UserCode,
	InitiatedBy=WorkOrder.InitiatedBy,
	Address=WorkOrder.Address,
	ContactNo=WorkOrder.ContactNo,
	Email=WorkOrder.Email,
	AvailabilityToVisit=WorkOrder.AvailabilityToVisit,
	Complaint=WorkOrder.Complaint,
	Demand=WorkOrder.Demand,
	Remarks=WorkOrder.Remarks,
	Approved=WorkOrder.Approved,
	ApprovedOn=WorkOrder.ApprovedOn,
	ApprovedBy=WorkOrder.ApprovedBy,
	Posted=WorkOrder.Posted,
	PostedOn=WorkOrder.PostedOn,
	PostedBy=WorkOrder.PostedBy,
	AssessmentDate = (SELECT WOA.Date FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	AssessmentUser = (SELECT U.UserName FROM WorkOrderassessment WOA, Users U WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode AND WOA.UserCode=U.UserCode),
	AssessedON = (SELECT WOA.AssessedON FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	AssessedBy = (SELECT WOA.AssessedBy FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	Assessment = (SELECT WOA.Assessment FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	ActionProposed = (SELECT WOA.ActionProposed FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	AssessmentRemarks = (SELECT WOA.Remarks FROM WorkOrderassessment WOA WHERE WOA.WorkOrderCode=WorkOrder.WorkOrderCode),
	Detail_On = tHeader.Date,
	Detail_By = (SELECT U.UserName FROM Users U WHERE tHeader.SalesmanCode=U.UserCode),
	Description = (SELECT I.Name FROM Item I WHERE I.ICode = tDetail.ICode),
	Qty=tdetail.qty,
	Cost = tDetail.AvgPrice,
	EstTimeReq = 1,
	TimeTaken = 1,
	Remarks = tDetail.ItemDescription,
	SourceGodown=theader.sgcode,
	TargetGodown=theader.dgcode
FROM
	customer , 
	WorkOrder,
	users, 
	accounts,
	theader,
	tdetail,
	item
WHERE  
	WorkOrder.WorkOrderCode = :ai_code AND
	WorkOrder.custcode = customer.custcode and 
	users.usercode = WorkOrder.Usercode and 
	WorkOrder.custcode = accounts.acccode AND
	theader.WorkOrderCode IS NOT NULL AND
	theader.WorkOrderCode = WorkOrder.WorkOrderCode AND
	theader.transcode=tdetail.transcode and
	tdetail.icode=item.icode 
ORDER BY
	Type,
	Detail_On,
	Description"
  arguments=(("ai_code", number))
)
