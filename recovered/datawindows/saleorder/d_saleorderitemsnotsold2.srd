release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1406 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=208 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=customergroup dbname="CustomerGroup"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="CustomerAlias"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=long updatewhereclause=yes name=saleordercode dbname="SaleOrderCode"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="ItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=soqty dbname="SOQty"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
 retrieve="SELECT 
	CustomerGroup = (SELECT CG.Name FROM CustomerGroup CG WHERE CG.CustomerGroupCode=:ar_custgroupcode),
	Date=SO.Date,
	CustCode=SO.CustCode,
	CustomerAlias = A.AliasName,
	CustomerName = A.Name,
	SalesPerson = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode=SO.SManCode),
	SaleOrderCode=SO.SaleOrderCode,
	SaleInvCode = NULL,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	SOQty = ISNULL(SUM(SD.Looseqty + SD.BonusQty), 0),
	SaleQty = ISNULL((SELECT SUM(D.Looseqty + D.BonusQty) FROM SaleLedger S, SaleDetail D WHERE D.SaleOrderRowID > 0 AND D.SaleOrderRowID = SD.RowID AND S.SaleInvCode=D.SaleInvCode), 0)
FROM
	SaleOrderHeader SO,
	SaleOrderDetail SD,
	Item I,
	Accounts A
WHERE
	SO.Date BETWEEN :ar_startdate AND :ar_enddate AND
	SO.SaleOrderCode = SD.SaleOrderCode AND
	SO.CustCode = A.AccCode AND
	SD.ICode = I.ICode AND
	SO.CustCode IN (SELECT CustCode FROM CustomerGroup WHERE CustomerGroupCode=  :ar_custgroupcode) AND 
	ISNULL(SO.SManCode, -1) = ISNULL(CASE :ar_smancode WHEN -1 THEN SO.SManCode ELSE :ar_smancode END, -1)
GROUP BY
	SO.Date,
	SO.CustCode,
	A.AliasName,
	A.Name,
	SO.SManCode,
	SO.SaleOrderCode,
	SO.SaleOrderCode,
	SD.RowID,
	I.CustomICode,
	I.Name
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_custgroupcode", number), ("ar_smancode", number))
 sort="saleordercode A, saleinvcode A, customername A, itemname A"
 filter=" soqty <> saleqty "
 )
