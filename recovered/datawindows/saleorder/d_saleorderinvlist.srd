release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=70 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="code"  )
column=(type=long updatewhereclause=yes name=ordercode dbname="OrderCode"  )
column=(type=long updatewhereclause=yes name=socatcode dbname="SOCatCode"  )
column=(type=char(60) updatewhereclause=yes name=saleordercategory dbname="SaleOrderCategory"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvmo dbname="headerinvmo"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=char(100) updatewhereclause=yes name=custrefno2 dbname="custrefno2"  )
column=(type=char(100) updatewhereclause=yes name=custrefno3 dbname="custrefno3"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=user dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=long updatewhereclause=yes name=reprintingcounter dbname="ReprintingCounter"  )
column=(type=datetime updatewhereclause=yes name=originaldate dbname="OriginalDate"  )
column=(type=long updatewhereclause=yes name=modifycounter dbname="ModifyCounter"  )
column=(type=char(1) updatewhereclause=yes name=deleted dbname="Deleted"  )
column=(type=char(1) updatewhereclause=yes name=finalized dbname="Finalized"  )
column=(type=char(40) updatewhereclause=yes name=section dbname="Section"  )
 retrieve="SELECT
	code = saleorderheader.saleordercode , 
	OrderCode=saleorderheader.ordercode,
	SOCatCode=saleorderheader.SOCatCode,
	SaleOrderCategory=SOC.Name,
	date = saleorderheader.date , 
	headerno = saleorderheader.headerno,
	headerinvmo=saleorderheader.headerinvno,
	custrefno=saleorderheader.custrefno, 
	custrefno2=saleorderheader.custrefno2, 
	custrefno3=saleorderheader.custrefno3, 
	remarks=saleorderheader.remarks , 
	accounts.name,
	users.username, 
	posted = saleorderheader.posted,
	PostedBy = IsNull((Select username from users 
								where dbo.saleorderheader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
								where dbo.saleorderheader.modifiedby = dbo.users.usercode), ''),
	NetAmount = saleorderheader.invtotal,
	ReprintingCounter=dbo.saleorderheader.ReprintingCounter,
	OriginalDate=dbo.saleorderheader.OriginalDate,
	ModifyCounter=dbo.saleorderheader.ModifyCounter,
	Deleted=dbo.saleorderheader.Deleted,
	Finalized=dbo.saleorderheader.Finalized,
	Section = (SELECT S.Name FROM Section S WHERE S.SectCode = dbo.saleorderheader.SectCode)
FROM  
	accounts, saleorderheader, users, SaleOrderCategory SOC
WHERE		 
	saleorderheader.socatcode = :ai_socatcode AND
	saleorderheader.custcode = accounts.acccode and 
	dbo.saleorderheader.usercode = dbo.users.usercode   and
	saleorderheader.socatcode = SOC.SOCatCode AND
	dbo.saleorderheader.date > :ad_invdate and
	dbo.saleorderheader.Posted IN (:as_Posted) and
	:as_showrows='Y'  AND 
	(dbo.saleorderheader.headerno IS NULL OR
		(dbo.saleorderheader.headerno in  
			(SELECT headercode FROM GroupAllowedHeader 
			WHERE GroupCode = :ai_groupcode and module = :ai_module)))
ORDER BY
	saleorderheader.saleordercode"
  arguments=(("ai_socatcode", number), ("ai_SaleCatCode", numberlist), ("as_Posted", stringlist), ("ad_invdate", datetime), ("as_showrows", string), ("ai_groupcode", number), ("ai_module", number))
 sort="code A"
)
