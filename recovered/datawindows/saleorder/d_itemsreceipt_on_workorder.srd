release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=269 color="536870912" )
summary(height=90 color="536870912" )
footer(height=0 color="536870912" )
detail(height=70 color="536870912" )
table(column=(type=long updatewhereclause=yes name=receiptinvcode dbname="ReceiptHeader.ReceiptInvcode"  )
column=(type=char(100) updatewhereclause=yes name=referenceno dbname="ReceiptHeader.referenceno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ReceiptHeader.date"  )
column=(type=char(60) updatewhereclause=yes name=recipienttype dbname="recipienttype"  )
column=(type=char(60) updatewhereclause=yes name=recipient dbname="recipient"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.customicode"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="ReceiptDetail.qty"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="ReceiptDetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="ReceiptDetail.expiry"  )
column=(type=decimal(5) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(9) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=long updatewhereclause=yes name=workordercode dbname="WorkOrderCode"  )
 retrieve="SELECT 
	Receiptheader.ReceiptInvcode,
	Receiptheader.referenceno,
	Receiptheader.date,
	recipienttype = recipient.name,
	recipient = CASE Receiptheader.recipientcode When 1 Then (select name from department where deptcode = Receiptheader.deptcode) When 2 Then (Select Name From Accounts Where subcode = 3 and acccode=Receiptheader.acccode ) When 3 Then (Select Name from accounts where acccode=Receiptheader.acccode ) When 4 Then (Select name from salesman where salesmancode = Receiptheader.recipientsalesman) End, 
	item.name,
	item.customicode, 
	Receiptdetail.qty,
	Receiptdetail.batch,
	Receiptdetail.expiry,
	Price=Receiptdetail.AvgPrice,
	amount=Receiptdetail.qty * Receiptdetail.AvgPrice,
	WorkOrderCode = Receiptheader.WorkOrderCode
FROM
	Receiptheader,
	Receiptdetail,
	item, 
	recipient
WHERE  
	Receiptheader.WorkOrderCode IS NOT NULL AND
	Receiptheader.WorkOrderCode = :ai_code AND
	Receiptheader.recipientcode = recipient.recipientcode and
	Receiptheader.ReceiptInvcode=Receiptdetail.ReceiptInvcode and
	Receiptdetail.icode=item.icode 
ORDER BY 
	Receiptheader.ReceiptInvcode
"
  arguments=(("ai_code", number))
 sort="receiptinvcode A, itemname A"
)
