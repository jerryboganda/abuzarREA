footer(height=0 color="536870912" )
detail(height=3016 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(77) updatewhereclause=yes name=barcode dbname="BarCode"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(150) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=datetime updatewhereclause=yes name=mfgdate dbname="MfgDate"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=long updatewhereclause=yes name=strengthperc dbname="StrengthPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=char(100) updatewhereclause=yes name=mfgremarks dbname="MfgRemarks"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="Class"  )
column=(type=char(150) updatewhereclause=yes name=genericitem dbname="GenericItem"  )
column=(type=char(100) updatewhereclause=yes name=sizedescription dbname="SizeDescription"  )
 retrieve="SELECT 
	ItemName=I.Name,
	AliasName=I.CustomICode,
	BarCode = '*' + LTRIM(RTRIM(I.CustomICode)) + '*',
	Packing = IP.Name,
	BatchNo = SPACE(150),
	MfgDate = I.LastUpdate,
	Expiry = GETDATE()+(365*5),
	StrengthPerc = CAST(0.00 AS INT),
	SalePrice = I.SalePrice,
	MfgRemarks = SPACE(100),
	Class = IL.Name,
	GenericItem = (SELECT GI.Name FROM GenericItem GI WHERE GI.GenericCode=I.GenericCode),
	SizeDescription = I.SizeDescription
FROM 
	Item I LEFT OUTER JOIN ItemPacking AS IP ON (I.PackCode = IP.PackCode),
	ItemClass IL
WHERE icode <=1114 AND I.ICCode = IL.ICCode
"
 )
