detail(height=67 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(1) updatewhereclause=yes name=locksaleprice dbname="locksaleprice"  )
column=(type=char(1) updatewhereclause=yes name=lockdiscperc dbname="lockdiscperc"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes name=qtysale dbname="qtysale"  )
column=(type=long updatewhereclause=yes name=bonus dbname="bonus"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=recentpurprice dbname="recentpurprice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=updatesaleprice dbname="updatesaleprice"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="saleordercode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long update=yes updatewhereclause=yes name=gcode dbname="gcode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Item flat Disc should be greater than zero~"" name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="ROWID"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=rate dbname="rate"  )
column=(type=char(100) update=yes updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=0 and Real(GetText()) < 100" validationmsg="'Discount % value should be between 0 and 100'" name=discperc dbname="discperc"  )
column=(type=char(1) updatewhereclause=yes name=claimable dbname="claimable"  )
column=(type=decimal(2) updatewhereclause=yes name=claimablediscperc dbname="claimablediscperc"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="retailprice"  )
column=(type=long update=yes updatewhereclause=yes name=rowgroup dbname="rowgroup"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=packprice dbname="packprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Pack Qty should be greater than or equal to zero'" initial="0" name=packqtyforsale dbname="packqtyforsale"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Bonus Qty should be greater than or equal to zero'" initial="0" name=bonuspackqtyforsale dbname="bonuspackqtyforsale"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=saleorderitemstatuscode dbname="SaleOrderItemStatusCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=quotationrowid dbname="QuotationRowID"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(4) updatewhereclause=yes name=salebonus dbname="salebonus"  )
 retrieve="SELECT
	I.customicode,
	itemname= I.name, 
	locksaleprice = I.locksaleprice,
	lockdiscperc  = I.lockdiscperc,
	currlistrow   = 0,
	stock         = 0.0000, 
	packingdesc=I.packingdesc,
	qtysale=I.saleqty,
	bonus=I.bonusqty,
	totalstock= 0.0000, 
	purprice=0.00,
	recentpurprice=0.00,
	avgprice=T.avgprice,
	itemtotalval=space(30),
	assgcode  = 1, 
	updatesaleprice = 'N',
	saleordercode=T.saleordercode,   
	icode=T.icode,   
	gcode=T.gcode,
	itemflatdisc = T.itemflatdisc,
	ROWID=T.RowID,
	packunits = T.packunits,
	saleprice = T.saleprice,
	rate      = T.rate,
	SaleItemDescription =  T.SaleItemDescription,
	discperc  = T.discperc,
	claimable= T.claimable,
	claimablediscperc= T.claimablediscperc,
	itemcode = 0,
	retailprice=I.retailprice,
	rowgroup=T.rowgroup,
	packprice = T.packprice,
	unitsalestax=T.unitsalestax,
	gstperc=T.gstperc,
	packqtyforsale = T.packqtyforsale, 
	bonuspackqtyforsale = T.bonuspackqtyforsale,
	remarks = T.remarks,
	SaleOrderItemStatusCode=T.SaleOrderItemStatusCode,
	QuotationRowID=T.QuotationRowID,
	bonusqty=T.bonusqty,
	looseqty= T.looseqty,
	saleqty = SUM(T.SaleQty),
	salebonus = SUM(T.salebonus)
FROM
	Item I,
	(SELECT 
		avgprice=SORD.avgprice,
		saleordercode=SORD.saleordercode,   
		icode=SORD.icode,   
		gcode=SORD.gcode,
		itemflatdisc = SORD.itemflatdisc,
		RowID=SORD.IDENTITYCOL,
		packunits = SORD.packunits,
		saleprice = SORD.saleprice,
		rate      = SORD.rate,
		SaleItemDescription =  SORD.SaleItemDescription,
		discperc  = SORD.discperc,
		claimable=SORD.claimable,
		claimablediscperc=SORD.claimablediscperc,
		rowgroup=SORD.rowgroup,
		packprice = SORD.packprice,
		unitsalestax=SORD.unitsalestax,
		gstperc=SORD.gstperc,
		packqtyforsale = SORD.packqtyforsale, 
		bonuspackqtyforsale = SORD.bonuspackqtyforsale,
		remarks = SORD.remarks,
		SaleOrderItemStatusCode=SORD.SaleOrderItemStatusCode,
		QuotationRowID=SORD.QuotationRowID,
		bonusqty=SORD.bonusqty,
		looseqty= SORD.looseqty,
		saleqty = CASE :ar_populationmethod WHEN 1 THEN ISNULL(sum(SD.LooseQty), 0) ELSE 0 END,
		salebonus = CASE :ar_populationmethod WHEN 1 THEN ISNULL(sum(SD.BonusQty), 0) ELSE 0 END
	FROM
		SaleOrderDetail SORD,
		SaleDetail SD
	WHERE 
		SORD.saleordercode IN (:ar_SaleOrderCode) AND
		SORD.rowid = SD.SaleOrderRowID
	GROUP BY
		SORD.saleordercode,   
		 SORD.gcode,
		SORD.icode,   
		SORD.itemflatdisc,
		SORD.IDENTITYCOL,
		SORD.packunits,
		SORD.saleprice,
		SORD.rate,
		SORD.SaleItemDescription,
		SORD.discperc,
		SORD.claimable,
		SORD.claimableDiscperc,
		SORD.rowgroup,
		SORD.packprice,
		SORD.unitsalestax,
		SORD.gstperc,
		SORD.packqtyforsale, 
		SORD.bonuspackqtyforsale,
		SORD.remarks,
		SORD.SaleOrderItemStatusCode,
		SORD.QuotationRowID,
		SORD.bonusqty,
		SORD.looseqty,
		SORD.avgprice
	UNION
	SELECT 
		avgprice=SORD.avgprice,
		saleordercode=SORD.saleordercode,   
		icode=SORD.icode,   
		 gcode=SORD.gcode,
		itemflatdisc = SORD.itemflatdisc,
		ROWID=SORD.IDENTITYCOL,
		packunits = SORD.packunits,
		saleprice = SORD.saleprice,
		rate      = SORD.rate,
		SaleItemDescription =  SORD.SaleItemDescription,
		discperc  = SORD.discperc,
		claimable=SORD.claimable,
		claimablediscperc=SORD.claimablediscperc,
		rowgroup=SORD.rowgroup,
		packprice = SORD.packprice,
		unitsalestax=SORD.unitsalestax,
		gstperc=SORD.gstperc,
		packqtyforsale = SORD.packqtyforsale, 
		bonuspackqtyforsale = SORD.bonuspackqtyforsale,
		remarks = SORD.remarks,
		SaleOrderItemStatusCode=SORD.SaleOrderItemStatusCode,
		QuotationRowID=SORD.QuotationRowID,
		bonusqty=SORD.bonusqty,
		looseqty= SORD.looseqty,
		saleqty = 0,
		salebonus = 0
	FROM
		SaleOrderDetail SORD
	WHERE 
		SORD.saleordercode IN (:ar_SaleOrderCode)) T
WHERE
	T.ICode = I.ICode
GROUP BY
	I.customicode, 
	I.name, 
	I.locksaleprice,
	I.lockdiscperc,
	I.packingdesc,
	I.saleqty,
	I.bonusqty,
	T.avgprice,
	T.saleordercode,   
	T.icode,   
	T.gcode,
	T.itemflatdisc,
	T.RowID,
	T.packunits,
	T.saleprice,
	T.rate,
	T.SaleItemDescription,
	T.discperc,
	T.claimable,
	T.claimablediscperc,
	I.retailprice,
	T.rowgroup,
	T.packprice,
	T.unitsalestax,
	T.gstperc,
	T.packqtyforsale, 
	T.bonuspackqtyforsale,
	T.remarks,
	T.SaleOrderItemStatusCode,
	T.QuotationRowID,
	T.Looseqty,
	T.BonusQty
ORDER BY
	RowID


/*
SELECT
	I.customicode,
	itemname= I.name, 
	locksaleprice = I.locksaleprice,
	lockdiscperc  = I.lockdiscperc,
	currlistrow   = 0,
	stock         = 0.0000, 
	packingdesc=I.packingdesc,
	qtysale=I.saleqty,
	bonus=I.bonusqty,
	totalstock= 0.0000, 
	purprice=0.00,
	recentpurprice=0.00,
	avgprice=T.avgprice,
	itemtotalval=space(30),
	assgcode  = 1, 
	updatesaleprice = 'N',
	saleordercode=T.saleordercode,   
	icode=T.icode,   
	gcode=T.gcode,
	itemflatdisc = T.itemflatdisc,
	ROWID=T.RowID,
	packunits = T.packunits,
	saleprice = T.saleprice,
	rate      = T.rate,
	SaleItemDescription =  T.SaleItemDescription,
	discperc  = T.discperc,
	itemcode = 0,
	retailprice=I.retailprice,
	rowgroup=T.rowgroup,
	packprice = T.packprice,
	unitsalestax=T.unitsalestax,
	gstperc=T.gstperc,
	packqtyforsale = T.packqtyforsale, 
	bonuspackqtyforsale = T.bonuspackqtyforsale,
	remarks = T.remarks,
	SaleOrderItemStatusCode=T.SaleOrderItemStatusCode,
	QuotationRowID=T.QuotationRowID,
	bonusqty=T.bonusqty,
	looseqty= T.looseqty,
	saleqty = SUM(T.SaleQty),
	salebonus = SUM(T.salebonus)
FROM
	Item I,
	(SELECT 
		S.saleordercode,   
		S.avgprice,
		S.icode,   
	    S.gcode,
		S.itemflatdisc,
		S.RowID,
		S.packunits,
		S.saleprice,
		S.rate,
		S.SaleItemDescription,
		S.discperc,
		S.rowgroup,
		S.packprice,
		S.unitsalestax,
		S.gstperc,
		S.packqtyforsale, 
		S.bonuspackqtyforsale,
		S.remarks,
		S.SaleOrderItemStatusCode,
		S.QuotationRowID,
		S.bonusqty,
		S.looseqty,
		saleqty = ISNULL(SUM(S.SaleQty), 0),
		salebonus = ISNULL(SUM(S.salebonus), 0)
	FROM
		(SELECT 
			avgprice=SORD.avgprice,
			saleordercode=SORD.saleordercode,   
			icode=SORD.icode,   
		    gcode=SORD.gcode,
			itemflatdisc = SORD.itemflatdisc,
			RowID=SORD.IDENTITYCOL,
			packunits = SORD.packunits,
			saleprice = SORD.saleprice,
			rate      = SORD.rate,
			SaleItemDescription =  SORD.SaleItemDescription,
			discperc  = SORD.discperc,
			rowgroup=SORD.rowgroup,
			packprice = SORD.packprice,
			unitsalestax=SORD.unitsalestax,
			gstperc=SORD.gstperc,
			packqtyforsale = SORD.packqtyforsale, 
			bonuspackqtyforsale = SORD.bonuspackqtyforsale,
			remarks = SORD.remarks,
			SaleOrderItemStatusCode=SORD.SaleOrderItemStatusCode,
			QuotationRowID=SORD.QuotationRowID,
			bonusqty=SORD.bonusqty,
			looseqty= SORD.looseqty,
			saleqty = CASE :ar_populationmethod WHEN 1 THEN ISNULL(sum(SD.LooseQty), 0) ELSE 0 END,
			salebonus = CASE :ar_populationmethod WHEN 1 THEN ISNULL(sum(SD.BonusQty), 0) ELSE 0 END
		FROM
			SaleOrderDetail SORD,
			SaleDetail SD
		WHERE 
			SORD.saleordercode IN (:ar_SaleOrderCode) AND
			SORD.rowid = SD.SaleOrderRowID
		GROUP BY
			SORD.saleordercode,   
		    SORD.gcode,
			SORD.icode,   
			SORD.itemflatdisc,
			SORD.IDENTITYCOL,
			SORD.packunits,
			SORD.saleprice,
			SORD.rate,
			SORD.SaleItemDescription,
			SORD.discperc,
			SORD.rowgroup,
			SORD.packprice,
			SORD.unitsalestax,
			SORD.gstperc,
			SORD.packqtyforsale, 
			SORD.bonuspackqtyforsale,
			SORD.remarks,
			SORD.SaleOrderItemStatusCode,
			SORD.QuotationRowID,
			SORD.bonusqty,
			SORD.looseqty,
			SORD.avgprice
		UNION
		SELECT 
			avgprice=SORD.avgprice,
			saleordercode=SORD.saleordercode,   
			icode=SORD.icode,   
		    gcode=SORD.gcode,
			itemflatdisc = SORD.itemflatdisc,
			ROWID=SORD.IDENTITYCOL,
			packunits = SORD.packunits,
			saleprice = SORD.saleprice,
			rate      = SORD.rate,
			SaleItemDescription =  SORD.SaleItemDescription,
			discperc  = SORD.discperc,
			rowgroup=SORD.rowgroup,
			packprice = SORD.packprice,
			unitsalestax=SORD.unitsalestax,
			gstperc=SORD.gstperc,
			packqtyforsale = SORD.packqtyforsale, 
			bonuspackqtyforsale = SORD.bonuspackqtyforsale,
			remarks = SORD.remarks,
			SaleOrderItemStatusCode=SORD.SaleOrderItemStatusCode,
			QuotationRowID=SORD.QuotationRowID,
			bonusqty=SORD.bonusqty,
			looseqty= SORD.looseqty,
			saleqty = 0,
			salebonus = 0
		FROM
			SaleOrderDetail SORD
		WHERE 
			SORD.saleordercode IN (:ar_SaleOrderCode)) S
	GROUP BY
		S.saleordercode,   
		S.avgprice,
		S.icode,   
	    S.gcode,
		S.itemflatdisc,
		S.RowID,
		S.packunits,
		S.saleprice,
		S.rate,
		S.SaleItemDescription,
		S.discperc,
		S.rowgroup,
		S.packprice,
		S.unitsalestax,
		S.gstperc,
		S.packqtyforsale, 
		S.bonuspackqtyforsale,
		S.remarks,
		S.SaleOrderItemStatusCode,
		S.QuotationRowID,
		S.bonusqty,
		S.looseqty) T
WHERE
	T.ICode = I.ICode
GROUP BY
	I.customicode, 
	I.name, 
	I.locksaleprice,
	I.lockdiscperc,
	I.packingdesc,
	I.saleqty,
	I.bonusqty,
	T.avgprice,
	T.saleordercode,   
	T.icode,   
	T.gcode,
	T.itemflatdisc,
	T.RowID,
	T.packunits,
	T.saleprice,
	T.rate,
	T.SaleItemDescription,
	T.discperc,
	I.retailprice,
	T.rowgroup,
	T.packprice,
	T.unitsalestax,
	T.gstperc,
	T.packqtyforsale, 
	T.bonuspackqtyforsale,
	T.remarks,
	T.SaleOrderItemStatusCode,
	T.QuotationRowID,
	T.Looseqty,
	T.BonusQty
ORDER BY
	RowID
*/"
  arguments=(("ar_SaleOrderCode", numberlist), ("ar_populationmethod", number))
)
