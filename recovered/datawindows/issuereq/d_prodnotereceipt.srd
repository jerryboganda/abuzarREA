table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ProdNoteReceipt.ProdNoteCode"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="ProdNoteReceipt.RowID"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=currlistrow dbname="CurrListRow"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="TotalStock"  )
column=(type=decimal(4) updatewhereclause=yes name=godownstock dbname="GodownStock"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ProdNoteReceipt.ICode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=gcode dbname="ProdNoteReceipt.GCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="~"Please enter valid value for Total Pieces~"" initial="0" name=totalpieces dbname="ProdNoteReceipt.TotalPieces"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=piecesinhand dbname="ProdNoteReceipt.PiecesInHand"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes initial="." name=batch dbname="ProdNoteReceipt.Batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes initial="today" name=expiry dbname="ProdNoteReceipt.Expiry"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"please enter a valid price~"" name=price dbname="ProdNoteReceipt.Price"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="ProdNoteReceipt.PackUnits"  )
column=(type=decimal(3) update=yes updatewhereclause=yes initial="1" name=unitweight dbname="ProdNoteReceipt.UnitWeight"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"please enter a valid expense value~"" initial="0" name=qe1 dbname="ProdNoteReceipt.QE1"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"please enter a valid expense value~"" initial="0" name=qe2 dbname="ProdNoteReceipt.QE2"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"please enter a valid expense value~"" initial="0" name=qe3 dbname="ProdNoteReceipt.QE3"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"please enter a valid expense value~"" initial="0" name=qe4 dbname="ProdNoteReceipt.QE4"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"please enter a valid expense value~"" initial="0" name=qe5 dbname="ProdNoteReceipt.QE5"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"please enter a valid expense value~"" initial="0" name=we1 dbname="ProdNoteReceipt.WE1"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"please enter a valid expense value~"" initial="0" name=we2 dbname="ProdNoteReceipt.WE2"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"please enter a valid expense value~"" initial="0" name=we3 dbname="ProdNoteReceipt.WE3"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"please enter a valid expense value~"" initial="0" name=we4 dbname="ProdNoteReceipt.WE4"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"please enter a valid expense value~"" initial="0" name=we5 dbname="ProdNoteReceipt.WE5"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) > 0" validationmsg="~"please enter a valid qty~"" initial="1" name=qty dbname="ProdNoteReceipt.Qty"  )
 retrieve="SELECT
	ProdNoteCode, 
	RowID,
	FullCode=(SELECT Item.CustomICode FROM ITEM WHERE Item.ICode = ProdNoteReceipt.ICode),
	ItemName=(SELECT Item.Name FROM ITEM WHERE Item.ICode = ProdNoteReceipt.ICode),
	CurrListRow=0, 
	ItemCode=0,
	TotalStock=0.0000,
	GodownStock=0.0000,
	ICode,
	GCode,
	TotalPieces,
	PiecesInHand,
	Batch,
	Expiry,
	Price, 
	PackUnits,
	UnitWeight,
	QE1, 
	QE2, 
	QE3, 
	QE4, 
	QE5, 
	WE1, 
	WE2, 
	WE3, 
	WE4, 
	WE5,
	Qty
FROM
	ProdNoteReceipt
WHERE 
	ProdNoteReceipt.ProdNoteCode = :ai_code
ORDER BY
	ProdNoteReceipt.ProdNoteCode,
	ProdNoteReceipt.RowID
"
  update="ProdNoteReceipt" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
