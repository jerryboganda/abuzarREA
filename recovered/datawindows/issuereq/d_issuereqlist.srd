footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="IssueReqHeader.IssueReqinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="IssueReqHeader.date"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="IssueReqHeader.remarks"  )
column=(type=char(40) updatewhereclause=yes name=department dbname="Department"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
 retrieve="SELECT  
	IssueReqHeader.IssueReqinvcode , 
	IssueReqHeader.date , 
	IssueReqHeader.remarks , 
	Department = (SELECT D.Name FROM Department D WHERE D.DeptCode = IssueReqHeader.DeptCode), 
	Area = (SELECT A.Name FROM Area A WHERE A.AreaCode = IssueReqHeader.AreaCode), 
	SalesPerson = (SELECT S.Name FROM SalesMan S WHERE S.SalesmanCode = IssueReqHeader.SManCode), 
	AccountName = (SELECT A.Name FROM Accounts A WHERE A.AccCode = IssueReqHeader.AccCode), 
	dbo.users.username,
	posted = IssueReqHeader.posted,
	PostedBy = IsNull((Select username from users 
				where dbo.IssueReqHeader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
				where dbo.IssueReqHeader.modifiedby = dbo.users.usercode), '') 
FROM  
	users,
	IssueReqHeader
	
WHERE  
	(dbo.IssueReqHeader.date > :ad_invdate) and
	( Posted IN (:as_Posted)) and
	( dbo.IssueReqHeader.salesmancode = dbo.users.usercode ) "
  arguments=(("ai_SaleCatCode", number), ("as_Posted", stringlist), ("ad_invdate", datetime), ("ai_groupcode", number), ("ai_module", number))
)
