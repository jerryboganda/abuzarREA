header(height=74 color="536870912" )
summary(height=67 color="536870912" )
footer(height=0 color="536870912" )
detail(height=67 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=prodcode dbname="ProdBuffer.ProdCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=prodrowid dbname="ProdBuffer.ProdRowID"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="ProdBuffer.RowID"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=long updatewhereclause=yes name=setcode dbname="SetCode" 
 values=""  )
column=(type=decimal(4) updatewhereclause=yes name=prodqty dbname="ProdQty"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(200) update=yes updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="TotalStock"  )
column=(type=long updatewhereclause=yes name=parentrow dbname="ParentRow"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=packprice dbname="PackPrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=price dbname="Price"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >  0" initial="1" name=packunits dbname="PackUnits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0" initial="0" name=itemflatdisc dbname="ItemFlatDisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0 AND Real(GetText()) <= 100" initial="0" name=discperc dbname="DiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0" initial="0" name=processcharge dbname="ProcessCharge"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0 AND Real(GetText()) <= 100" initial="0" name=processchargeperc dbname="ProcessChargePerc"  )
column=(type=decimal(7) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0" initial="1" name=qty dbname="Qty"  )
 retrieve="SELECT 
	ProdCode,
	ProdRowID,
	RowID,
	FullCode=(SELECT Item.CustomICode FROM ITEM WHERE Item.ICode = ProdBuffer.ICode),
	ItemName=(SELECT Item.Name FROM ITEM WHERE Item.ICode = ProdBuffer.ICode),
	CurrListRow=0, 
	ItemCode=ICode,
	SetCode=(SELECT Item.ICode FROM ITEM, ProdDetail D WHERE ProdBuffer.ProdRowID = D.RowID AND Item.ICode = D.ICode),   
	ProdQty=(SELECT D.Qty FROM ITEM, ProdDetail D WHERE ProdBuffer.ProdRowID = D.RowID AND Item.ICode = D.ICode),   
	ICode=ICode,   
	Remarks=Remarks,   
	TotalStock=0.0000,   
	ParentRow=0,
	PackPrice=ProdBuffer.PackPrice,
	Price=ProdBuffer.Price,
	PackUnits=ProdBuffer.PackUnits,
	ItemFlatDisc=ProdBuffer.ItemFlatDisc,
	DiscPerc=ProdBuffer.DiscPerc,
	ProcessCharge=ProdBuffer.ProcessCharge,
	ProcessChargePerc=ProdBuffer.ProcessChargePerc,
	Qty=ProdBuffer.Qty
FROM 
	ProdBuffer
WHERE 
	ProdBuffer.ProdCode = :ai_code
ORDER BY
	ProdBuffer.ProdRowID,
	ProdBuffer.RowID
	"
  update="ProdBuffer" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
