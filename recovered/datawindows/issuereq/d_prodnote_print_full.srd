release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=0 print.margin.top=0 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1616 color="536870912" )
summary(height=0 color="536870912" )
footer(height=8 color="536870912" )
detail(height=183 color="536870912" )
table(column=(type=char(13) updatewhereclause=yes name=produtionpart dbname="ProdutionPart"  )
column=(type=char(40) updatewhereclause=yes name=issuedepartment dbname="IssueDepartment"  )
column=(type=char(40) updatewhereclause=yes name=receiptdepartment dbname="ReceiptDepartment"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=long updatewhereclause=yes name=code dbname="code"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ProdNote.remarks"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Id"  )
 retrieve="SELECT 
	ProdutionPart='Issued Items',
	IssueDepartment = (SELECT D.name FROM Department D WHERE D.DeptCode = Prodnote.IssueDeptCode),
	ReceiptDepartment = (SELECT D.name FROM Department D WHERE D.DeptCode = Prodnote.ReceiptDeptCode),
	AliasName= item.customicode, 
	itemname= item.name, 
	Godown = (SELECT g.name FROM Godown G WHERE G.GCode = ProdnoteIssue.GCode),
	salesman = dbo.users.username, 
	code =prodnote.prodnotecode,
	date = dbo.prodnote.date,   
	dbo.prodnote.remarks,	 
	qty = ProdnoteIssue.qty,
	Id       = ProdnoteIssue.RowID
FROM 
	ProdNote, 
	ProdNoteIssue,
	users, 
	item
WHERE 
	dbo.prodnote.prodnotecode = :ar_code AND
	dbo.prodnote.usercode = users.usercode AND
	dbo.prodnote.prodnotecode = dbo.prodnoteissue.prodnotecode AND
	dbo.prodnoteissue.icode = item.icode
UNION ALL
SELECT 
	ProdutionPart='Receipt Items',
	IssueDepartment = (SELECT D.name FROM Department D WHERE D.DeptCode = Prodnote.IssueDeptCode),
	ReceiptDepartment = (SELECT D.name FROM Department D WHERE D.DeptCode = Prodnote.ReceiptDeptCode),
	AliasName= item.customicode, 
	itemname= item.name, 
	Godown = (SELECT g.name FROM Godown G WHERE G.GCode = ProdnoteReceipt.GCode),
	salesman = dbo.users.username, 
	code =prodnote.prodnotecode,
	date = dbo.prodnote.date,   
	dbo.prodnote.remarks,	 
	qty = Prodnotereceipt.qty,
	Id       = Prodnotereceipt.RowID
FROM 
	ProdNote, 
	Prodnotereceipt,
	users, 
	item
WHERE 
	dbo.prodnote.prodnotecode = :ar_code AND
	dbo.prodnote.usercode = users.usercode AND
	dbo.prodnote.prodnotecode = dbo.Prodnotereceipt.prodnotecode AND
	dbo.Prodnotereceipt.icode = item.icode
ORDER BY 
	ProdutionPart, ID"
  arguments=(("ar_code", number))
 sort="produtionpart A, id A"
)
