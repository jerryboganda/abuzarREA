table(column=(type=long updatewhereclause=yes name=prodnotecode dbname="ProdNoteCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=issueinvcode dbname="IssueInvCode"  )
column=(type=long updatewhereclause=yes name=receiptinvcode dbname="ReceiptInvCode"  )
column=(type=char(40) updatewhereclause=yes name=issuedepartment dbname="IssueDepartment"  )
column=(type=char(40) updatewhereclause=yes name=receiptdepartment dbname="ReceiptDepartment"  )
column=(type=decimal(12) updatewhereclause=yes name=issuesqft dbname="IssueSqFt"  )
column=(type=decimal(12) updatewhereclause=yes name=receiptsqft dbname="ReceiptSqFt"  )
column=(type=decimal(6) updatewhereclause=yes name=efficiencyperc dbname="EfficiencyPerc"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="Salesman"  )
 retrieve="SELECT 
	ProdNoteCode = P.ProdNoteCode,
	Date = P.Date, 
	Remarks = P.Remarks,	 
	IssueInvCode = P.IssueInvCode,
	ReceiptInvCode = P.ReceiptInvCode,
	IssueDepartment = (SELECT D.name FROM Department D WHERE D.DeptCode = P.IssueDeptCode),
	ReceiptDepartment = (SELECT D.name FROM Department D WHERE D.DeptCode = P.ReceiptDeptCode),
	IssueSqFt = (SELECT SUM(PNI.Qty * I.AreaVolume) FROM ProdNoteIssue PNI, Item I WHERE PNI.ProdNoteCode = P.ProdNoteCode AND PNI.ICode = I.ICode),
	ReceiptSqFt = (SELECT SUM(PNR.Qty * I.AreaVolume) FROM ProdNoteReceipt PNR, Item I WHERE PNR.ProdNoteCode = P.ProdNoteCode AND PNR.ICode = I.ICode),
	EfficiencyPerc = (ISNULL((SELECT SUM(PNR.Qty * I.AreaVolume) FROM ProdNoteReceipt PNR, Item I WHERE PNR.ProdNoteCode = P.ProdNoteCode AND PNR.ICode = I.ICode), 0) /
		CASE WHEN ISNULL((SELECT SUM(PNI.Qty * I.AreaVolume) FROM ProdNoteIssue PNI, Item I WHERE PNI.ProdNoteCode = P.ProdNoteCode AND PNI.ICode = I.ICode), 1) = 0 THEN 1 ELSE ISNULL((SELECT SUM(PNI.Qty * I.AreaVolume) FROM ProdNoteIssue PNI, Item I WHERE PNI.ProdNoteCode = P.ProdNoteCode AND PNI.ICode = I.ICode), 1) END) * 100,
	Salesman = U.UserName
FROM 
	ProdNote P, users U
WHERE 
	P.Date BETWEEN :adt_startdate AND :adt_enddate AND
	P.usercode = U.usercode
ORDER BY 
	P.Date"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
)
