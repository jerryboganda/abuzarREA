detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=updatesaleprice dbname="updatesaleprice"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ProdDetail.prodcode"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="ProdDetail.RowId"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="." name=batch dbname="ProdDetail.Batch"  )
column=(type=datetime update=yes updatewhereclause=yes name=expiry dbname="ProdDetail.Expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=minrecipeqty dbname="MinRecipeQty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) > 0" validationmsg="~"Quantity should be greater than zero~"" initial="1" name=qty dbname="qty"  )
 retrieve="SELECT 
	item.customicode, 
	itemname= item.name, 
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= 0.0000, 
	assgcode  = 1, 
	updatesaleprice = 'N',
	proddetail.prodcode,   
	proddetail.RowId,
	icode = proddetail.icode,   
	itemcode = 0,
	ProdDetail.Batch,
	ProdDetail.Expiry,
	MinRecipeQty=ISNULL(
		(SELECT M=MAX(R.Qty) 
		FROM Recipe R 
		WHERE R.ResultedItem = ProdDetail.ICode AND R.Priority IN 
			(SELECT Min(Priority) FROM Recipe WHERE ResultedItem = ProdDetail.icode)), 1),
	qty  = ProdDetail.qty
FROM
	ProdDetail, 
	item 
WHERE 
	( dbo.Proddetail.ProdCode = :ar_IssueInvCode ) AND
	( ProdDetail.icode = item.icode )
ORDER BY 
	ProdDetail.RowID
	
	
"
  update="ProdDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_IssueInvCode", number))
)
