table(column=(type=long updatewhereclause=yes name=prodcode dbname="ProdBuffer.ProdCode"  )
column=(type=long updatewhereclause=yes name=prodrowid dbname="ProdBuffer.ProdRowID"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="ProdBuffer.RowID"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=datetime updatewhereclause=yes name=proddate dbname="ProdDate"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=long updatewhereclause=yes name=produceditemcode dbname="ProducedItemCode"  )
column=(type=char(75) updatewhereclause=yes name=produceditemaliasname dbname="ProducedItemAliasName"  )
column=(type=char(60) updatewhereclause=yes name=produceditemname dbname="ProducedItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=produceditemqty dbname="ProducedItemQty"  )
column=(type=char(100) updatewhereclause=yes name=produceditembatch dbname="ProducedItemBatch"  )
column=(type=datetime updatewhereclause=yes name=produceditemexpiry dbname="ProducedItemExpiry"  )
column=(type=char(60) updatewhereclause=no name=itemclass dbname="ItemClass"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(200) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=packprice dbname="PackPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="Price"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="ItemFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=processcharge dbname="ProcessCharge"  )
column=(type=decimal(2) updatewhereclause=yes name=processchargeperc dbname="ProcessChargePerc"  )
column=(type=decimal(7) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(7) updatewhereclause=yes name=recipeqty dbname="RecipeQty"  )
 retrieve="SELECT 
	ProdCode,
	ProdRowID,
	RowID,
	Posted=(SELECT DISTINCT H.Posted FROM ProdDetail D, ProdHeader H WHERE ProdBuffer.ProdRowID = D.RowID AND H.ProdCode=D.ProdCode), 
	ProdDate=(SELECT DISTINCT H.Date FROM ProdDetail D, ProdHeader H WHERE ProdBuffer.ProdRowID = D.RowID AND H.ProdCode=D.ProdCode), 
	UserName=(SELECT DISTINCT U.UserName FROM ProdDetail D, ProdHeader H, Users U WHERE ProdBuffer.ProdRowID = D.RowID AND H.ProdCode=D.ProdCode AND H.FinalizedBy=U.UserCode), 
	ProducedItemCode=(SELECT D.ICode FROM ProdDetail D WHERE ProdBuffer.ProdRowID = D.RowID),   
	ProducedItemAliasName = (SELECT I.CustomICode FROM ProdDetail D, Item I WHERE ProdBuffer.ProdRowID = D.RowID AND D.ICode=I.ICode),   
	ProducedItemName =(SELECT I.Name FROM ProdDetail D, Item I WHERE ProdBuffer.ProdRowID = D.RowID AND D.ICode=I.ICode),   
	ProducedItemQty =(SELECT D.Qty FROM ProdDetail D WHERE ProdBuffer.ProdRowID = D.RowID),   
	ProducedItemBatch =(SELECT D.Batch FROM ProdDetail D WHERE ProdBuffer.ProdRowID = D.RowID),   
	ProducedItemExpiry =(SELECT D.Expiry FROM ProdDetail D WHERE ProdBuffer.ProdRowID = D.RowID),   
	ItemClass = (SELECT IC.Name FROM ItemClass IC WHERE IC.ICCode = Item.ICCode),
	ICode=Item.ICode,   
	FullCode= Item.CustomICode,
	ItemName = Item.Name,
	Remarks=ProdBuffer.Remarks,   
	PackPrice=ProdBuffer.PackPrice,
	Price=ProdBuffer.Price,
	PackUnits=ProdBuffer.PackUnits,
	ItemFlatDisc=ProdBuffer.ItemFlatDisc,
	DiscPerc=ProdBuffer.DiscPerc,
	ProcessCharge=ProdBuffer.ProcessCharge,
	ProcessChargePerc=ProdBuffer.ProcessChargePerc,
	Qty=ProdBuffer.Qty,
	RecipeQty=(SELECT RD.Qty
	FROM Recipe R, RecipeDetail RD
	WHERE R.ResultedItem IN (SELECT D.ICode FROM ProdDetail D WHERE ProdBuffer.ProdRowID = D.RowID) AND
		R.Priority IN (SELECT MIN(RR.Priority) FROM Recipe RR WHERE RR.ResultedItem = R.ResultedItem) AND
		R.RecipeCode = RD.RecipeCode AND 
		RD.ICode = ProdBuffer.ICode)
FROM 
	ProdBuffer, Item
WHERE 
	ProdBuffer.ProdCode = :ai_prodcode AND
	ProdBuffer.ICode = Item.ICode
ORDER BY
	ProdBuffer.ProdRowID,
	ProdBuffer.RowID"
  arguments=(("ai_prodcode", number))
)
