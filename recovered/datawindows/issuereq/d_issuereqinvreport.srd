release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=0 print.margin.top=0 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1593 color="536870912" )
summary(height=281 color="536870912" )
footer(height=10 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(40) updatewhereclause=yes name=department dbname="department"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=long updatewhereclause=yes name=issuereqinvcode dbname="issuereqinvcode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="smanname"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="accountname"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=deptcode dbname="IssueReqHeader.deptcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="IssueReqHeader.remarks"  )
column=(type=long updatewhereclause=yes name=qty dbname="looseqty"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="itempacking"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(40) updatewhereclause=yes name=section dbname="section"  )
 retrieve="SELECT 
	itemname= item.name, 
	department = dbo.department.name, 
	salesman = dbo.users.username, 
	issuereqinvcode = dbo.issuereqheader.issuereqinvcode, 
	smanname=salesman.name,
	accountname=(SELECT A.name FROM Accounts A WHERE A.AccCode = dbo.issuereqheader.AccCode),
	date = dbo.issuereqheader.date,   
	dbo.issuereqheader.deptcode,
	dbo.issuereqheader.remarks,	 
	looseqty = issuereqdetail.qty,
	itempacking = itempacking.name,
	Id       = dbo.issuereqdetail.IDENTITYCOL ,
	section=section.name
	
FROM 
	issuereqheader, 
	issuereqdetail
	LEFT OUTER JOIN section ON (dbo.issuereqdetail.sectcode = section.sectcode),
	users, 
	item
	LEFT OUTER JOIN itempacking ON (dbo.item.packcode = dbo.itempacking.packcode),
	department ,
	salesman
	
	WHERE ( dbo.issuereqheader.issuereqinvcode = :ar_issuereqinvcode ) AND
	( dbo.issuereqheader.issuereqinvcode = dbo.issuereqdetail.issuereqinvcode) AND
	( dbo.issuereqheader.deptcode = dbo.department.deptcode ) AND 
	( dbo.issuereqheader.Smancode = dbo.SalesMan.Salesmancode ) AND 
	( dbo.issuereqheader.salesmancode = dbo.users.usercode ) AND 
	( dbo.issuereqdetail.icode = dbo.item.icode)
ORDER BY 
	dbo.issuereqdetail.IDENTITYCOL"
  arguments=(("ar_IssuereqInvCode", number))
)
