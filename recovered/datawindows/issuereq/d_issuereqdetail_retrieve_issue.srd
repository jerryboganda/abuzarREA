release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=74 color="536870912" )
summary(height=0 color="536870912" )
footer(height=67 color="536870912" )
detail(height=67 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=updatesaleprice dbname="updatesaleprice"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="IssueReqDetail.issuereqinvcode"  )
column=(type=long update=yes updatewhereclause=yes name=sectcode dbname="sectcode"  )
column=(type=long identity=yes updatewhereclause=yes name=issuereqrowid dbname="IssueReqDetail.issuereqrowid"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long update=yes updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="'Sale Price should be greater than zero'" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=purchaseprice dbname="purchaseprice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(4) updatewhereclause=yes name=issueqty dbname="issueqty"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(1) updatewhereclause=yes name=claimable dbname="Claimable"  )
column=(type=decimal(2) updatewhereclause=yes name=claimablediscperc dbname="ClaimableDiscPerc"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) > 0" validationmsg="~"Quantity should be greater than zero~"" initial="1" name=qty dbname="qty"  )
 retrieve="SELECT 
	item.customicode, 
	itemname= item.name, 
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= 0.0000, 
	assgcode  = 1, 
	updatesaleprice = 'N',
	issuereqdetail.issuereqinvcode,   
	sectcode = issuereqdetail.sectcode,
	issuereqdetail.issuereqrowid,
	icode = issuereqdetail.icode,   
	packunits = max(issuereqdetail.packunits),
	saleprice = max(issuereqdetail.saleprice),
	purchaseprice = max(issuereqdetail.purchaseprice),
	avgprice = max(issuereqdetail.avgprice),
	issueqty = ISNULL((SELECT sum(qty) FROM IssueDetail WHERE issuedetail.icode = issuereqdetail.icode and issuedetail.issuereqrowid = issuereqdetail.issuereqrowid), 0),
	itemcode = 0,
	Claimable = issuereqdetail.Claimable,
	ClaimableDiscPerc = issuereqdetail.ClaimableDiscPerc,
	qty  = sum(issuereqdetail.qty)

FROM 
	issuereqdetail, item 
WHERE 
	( dbo.issuereqdetail.issuereqinvcode = :ar_IssueInvCode )    AND
	( issuereqdetail.icode = item.icode )
GROUP BY 
	issuereqdetail.issuereqinvcode, 
	issuereqdetail.icode, 
	issuereqdetail.issuereqrowid,
	issuereqdetail.sectcode,
	issuereqdetail.Claimable,
	issuereqdetail.ClaimableDiscPerc,
	item.customicode, 
	item.name
"
  arguments=(("ar_IssueInvCode", number))
)
