table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ProdHeader.ProdCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="date"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=originaldate dbname="ProdHeader.OriginalDate"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="ProdHeader.PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=createdby dbname="ProdHeader.CreatedBy"  )
column=(type=long update=yes updatewhereclause=yes name=modifiedby dbname="ProdHeader.ModifiedBy"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="ProdHeader.PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=salesmanname dbname="salesmanname"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=finalized dbname="Finalized"  )
column=(type=datetime update=yes updatewhereclause=yes name=finalizedon dbname="FinalizedOn"  )
column=(type=long update=yes updatewhereclause=yes name=finalizedby dbname="FinalizedBy"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="posted"  )
column=(type=long update=yes updatewhereclause=yes name=issuegcode dbname="ProdHeader.IssueGCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=receiptgcode dbname="ProdHeader.ReceiptGCode" 
 values=""  )
 retrieve="SELECT 	
	dbo.ProdHeader.ProdCode,   
	date = dbo.ProdHeader.date,
	ProdHeader.OriginalDate,
	ProdHeader.PostDate,
	ProdHeader.CreatedBy,
	ProdHeader.ModifiedBy,
	ProdHeader.PostedBy,
	salesmanname = dbo.users.username,
	remarks = dbo.ProdHeader.remarks,   
	Finalized = dbo.ProdHeader.Finalized,
	FinalizedOn = dbo.ProdHeader.FinalizedOn,
	FinalizedBy = dbo.ProdHeader.FinalizedBy,
	posted = dbo.ProdHeader.posted,
	ProdHeader.IssueGCode,
	ProdHeader.ReceiptGCode
FROM 
	dbo.ProdHeader, dbo.users
WHERE 
	dbo.users.usercode = dbo.ProdHeader.CreatedBy and  
	dbo.ProdHeader.ProdCode = :ar_ProdCode
"
  update="ProdHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_ProdCode", number))
)
