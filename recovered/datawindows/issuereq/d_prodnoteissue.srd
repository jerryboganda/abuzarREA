summary(height=0 color="536870912" )
footer(height=72 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ProdNoteIssue.ProdNoteCode"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="ProdNoteIssue.RowID"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=currlistrow dbname="CurrListRow"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ProdNoteIssue.ICode"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="TotalStock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=godownstock dbname="GodownStock"  )
column=(type=long update=yes updatewhereclause=yes name=gcode dbname="ProdNoteIssue.GCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Please enter valid value for Total pieces'" initial="1" name=totalpieces dbname="ProdNoteIssue.TotalPieces"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=piecesinhand dbname="ProdNoteIssue.PiecesInHand"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Pkease enter valid price~"" name=price dbname="ProdNoteIssue.Price"  )
column=(type=long update=yes updatewhereclause=yes name=packunits dbname="ProdNoteIssue.PackUnits"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=qty dbname="ProdNoteIssue.Qty"  )
 retrieve="SELECT
	ProdNoteCode, 
	RowID,
	FullCode=(SELECT Item.CustomICode FROM ITEM WHERE Item.ICode = ProdNoteIssue.ICode),
	ItemName=(SELECT Item.Name FROM ITEM WHERE Item.ICode = ProdNoteIssue.ICode),
	CurrListRow=0, 
	ItemCode=0,
	ICode,
	TotalStock=0.0000,
	GodownStock=0.0000,
	GCode,
	TotalPieces,
	PiecesInHand,
	Price, 
	PackUnits,
	Qty
FROM
	ProdNoteIssue
WHERE 
	ProdNoteIssue.ProdNoteCode = :ai_code
ORDER BY
	ProdNoteIssue.ProdNoteCode,
	ProdNoteIssue.RowID
"
  update="ProdNoteIssue" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
