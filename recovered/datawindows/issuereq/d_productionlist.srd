release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=77 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=67 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="ProdHeader.ProdCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ProdHeader.date"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ProdHeader.remarks"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=finalized dbname="Finalized" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted" 
 values="Yes	Y/No	N/"  )
column=(type=char(60) updatewhereclause=yes name=finalizedby dbname="FinalizedBy"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=long updatewhereclause=yes name=issueinvcode dbname="IssueInvCode"  )
column=(type=char(1) updatewhereclause=yes name=issuestatus dbname="IssueStatus" 
 values="Posted	Y/Un-Posted	N/"  )
column=(type=long updatewhereclause=yes name=receiptinvcode dbname="ReceiptInvCode"  )
column=(type=char(1) updatewhereclause=yes name=receiptstatus dbname="ReceiptStatus" 
 values="Posted	Y/Un-Posted	N/"  )
 retrieve="SELECT  
	ProdHeader.ProdCode , 
	ProdHeader.date , 
	ProdHeader.remarks , 
	dbo.users.username,
	Finalized = ProdHeader.Finalized,
	posted = ProdHeader.posted,
	FinalizedBy = IsNull((Select username from users 
		where dbo.ProdHeader.FinalizedBy = dbo.users.usercode), ''),
	PostedBy = IsNull((Select username from users 
		where dbo.ProdHeader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
		where dbo.ProdHeader.modifiedby = dbo.users.usercode), '') ,
	IssueInvCode = ProdHeader.IssueInvCode,
	IssueStatus = (SELECT IH.Posted FROM IssueHeader IH WHERE IH.IssueInvCode = ProdHeader.IssueInvCode),
	ReceiptInvCode = ProdHeader.ReceiptInvCode,
	ReceiptStatus = (SELECT RH.Posted FROM ReceiptHeader RH WHERE RH.ReceiptInvCode = ProdHeader.ReceiptInvCode)
FROM
	Users,
	ProdHeader
WHERE  
	(dbo.ProdHeader.date > :ad_invdate) and
	( Posted IN (:as_Posted)) and
	( dbo.ProdHeader.CreatedBy = dbo.users.usercode ) "
  arguments=(("ai_SaleCatCode", number), ("as_Posted", stringlist), ("ad_invdate", datetime), ("ai_groupcode", number), ("ai_module", number))
)
