header(height=1260 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=250 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=accname dbname="Accounts.name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.aliasname"  )
column=(type=char(60) updatewhereclause=yes name=supplier_address1 dbname="Supplier.address1"  )
column=(type=char(30) updatewhereclause=yes name=supplier_city dbname="Supplier.city"  )
column=(type=char(30) updatewhereclause=yes name=supplier_country dbname="Supplier.country"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Supplier.phone"  )
column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTNNo"  )
column=(type=char(50) updatewhereclause=yes name=cnic dbname="CNIC"  )
column=(type=char(100) updatewhereclause=yes name=suppliercategory dbname="SupplierCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=whperc dbname="WHPerc"  )
 retrieve="SELECT  
	dbo.accounts.name,  
	dbo.accounts.aliasname,
	dbo.supplier.address1,
	dbo.supplier.city,
	dbo.supplier.country,
	dbo.supplier.phone,
	NTNNo=dbo.supplier.NTNNo,
	CNIC=dbo.supplier.CNIC,
	SupplierCategory = (SELECT SC.Name FROM SupplierCategory SC WHERE SC.SuppCatCode=supplier.SuppCatCode),
	WHPerc=supplier.WHPerc
FROM  
	dbo.supplier, dbo.accounts  
WHERE  
	(dbo.supplier.suppcode = dbo.accounts.acccode)  
	
	
	
"
  sort="accname A"
)
