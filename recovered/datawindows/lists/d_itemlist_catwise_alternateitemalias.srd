release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=300 print.margin.top=0 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1416 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(75) updatewhereclause=yes name=alternateitemalias dbname="alternateitemalias"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
 retrieve="select aliasname=item.customicode,
	alternateitemalias=alternateitemalias.customicode,
	itemname=item.name,
	itemcategory=(select name from itemcategory where itemcategory.icatcode=item.icatcode)

from item,alternateitemalias

where item.icatcode in (:aa_catcode) and
	item.icode=alternateitemalias.icode
	
order by itemcategory,
		    itemname,
			alternateitemalias"
  arguments=(("aa_catcode", numberlist))
 sort="itemcategory A, itemname A"
)
group(level=1 header.height=187 trailer.height=0 by=("itemcategory"  ) header.color="536870912" trailer.color="536870912" )
text(name=t_3 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="1" background.color="553648127" color="0" alignment="2" border="0" x="10" y="83" height="156" width="7697" text="Item List" html.valueishtml="0" )
