table(column=(type=char(4) updatewhereclause=yes name=year dbname="Year"  )
column=(type=char(37) updatewhereclause=yes name=month dbname="Month"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(60) updatewhereclause=yes name=country dbname="Country"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
 retrieve="SELECT 
	Year = LTRIM(RTRIM(STR(DATEPART(yyyy, A.OpeningDate),4))),
	Month = DATENAME(month, A.OpeningDate) + ' - ' + LTRIM(RTRIM(STR(DATEPART(yyyy, A.OpeningDate),4))),
	Date = A.OpeningDate,
	CustomerName = A.Name , 
	Address1 = C.Address1 ,
	City = C.City,
	Country= C.Country ,
	Area = AR.Name,
	Phone = C.Phone
FROM 
	Customer C, Accounts A, Area AR
WHERE 
	A.OpeningDate BETWEEN :adt_startdate AND :adt_enddate AND
	C.CustCode = A.AccCode AND
	AR.AreaCode = C.Areacode
ORDER BY 
	A.OpeningDate,
	A.name
	
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
)
