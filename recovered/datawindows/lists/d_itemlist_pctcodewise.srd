table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(100) updatewhereclause=yes name=pctcode dbname="PCTCode"  )
column=(type=char(100) updatewhereclause=yes name=salestaxschedule dbname="SalesTaxSchedule"  )
column=(type=char(1) updatewhereclause=yes name=applicable dbname="Applicable"  )
column=(type=char(1) updatewhereclause=yes name=taxtype dbname="TaxType"  )
column=(type=decimal(2) updatewhereclause=yes name=taxrate dbname="TaxRate"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
 retrieve="SELECT
	AliasName = I.CustomICode,
	ItemName = I.Name,
	ItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode=I.ICatCode),
	ItemClass = (SELECT IC.Name FROM ItemClass IC WHERE IC.ICCode=I.ICCode),
	Manufacturer = (SELECT M.Name FROM Manufacturer M WHERE M.ManfCode=I.ManfCode),
	PCTCode = P.Description,
	SalesTaxSchedule = S.Name,
	Applicable = S.Applicable,
	TaxType = S.TaxType,
	TaxRate = S.TaxPerc,
	Stock = ISNULL((SELECT SUM(GD.CurrQty) FROM GodownDetail GD WHERE GD.ICode=I.ICode), 0)
FROM
	Item I, PCT P, SalesTaxSchedule S
WHERE
	P.PCTCode IN (:ai_pctcode) AND
	I.PCTCode = P.PCTCode AND 
	I.SalesTaxScheduleCode=S.SalesTaxScheduleCode
"
  arguments=(("ai_pctcode", numberlist))
 sort="pctcode A, itemname A"
)
