table(column=(type=char(60) updatewhereclause=yes name=saleperson dbname="SalePerson"  )
 retrieve="SELECT 
	DISTINCT 
	SalePerson = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = SS.SalesManCode)/*, 
	WeekDay = (SELECT W.Name FROM WeekDays W WHERE W.WeekDayCode = SS.WeekDayCode)*/
FROM 
	SalesManScope SS
WHERE
	SS.ManfCode = :ai_ManfCode AND
	SS.SubAreaCode = :ai_SubAreaCode
ORDER BY SalePerson"
  arguments=(("ai_manfcode", number), ("ai_subareacode", number))
)
