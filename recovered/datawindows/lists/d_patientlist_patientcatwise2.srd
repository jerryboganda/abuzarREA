table(column=(type=char(25) updatewhereclause=yes name=city dbname="Patient.City"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Patient.Date"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=patientcode dbname="Patient.PatientCode"  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="Patient.RegNo"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Patient.Name"  )
column=(type=char(60) update=yes updatewhereclause=yes name=fname dbname="Patient.FName"  )
column=(type=datetime update=yes updatewhereclause=yes name=dob dbname="Patient.DOB"  )
column=(type=char(1) update=yes updatewhereclause=yes name=gender dbname="Patient.Gender"  )
column=(type=char(60) update=yes updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long update=yes updatewhereclause=yes name=patientcatcode dbname="Patient.PatientCatCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=patientcategory dbname="PatientCategory"  )
column=(type=char(30) update=yes updatewhereclause=yes name=phone dbname="Patient.Phone"  )
column=(type=char(100) update=yes updatewhereclause=yes name=phone2 dbname="Patient.Phone2"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mobileno1 dbname="Patient.MobileNo1"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mobileno2 dbname="Patient.MobileNo2"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mobileno3 dbname="Patient.MobileNo3"  )
column=(type=char(100) updatewhereclause=yes name=address dbname="Address"  )
column=(type=long updatewhereclause=yes name=medicinecount dbname="MedicineCount"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
 retrieve="SELECT 
	City,
	Date,
	PatientCode,
	RegNo, 
	Name, 
	FName,
	DOB,
	Gender,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = Patient.CustCode),
	PatientCatCode,
	PatientCategory = (SELECT PC.Name FROM PatientCategory PC WHERE PC.PatientCatCode = Patient.PatientCatCode),
	Phone,
	Phone2,
	MobileNo1,
	MobileNo2,
	MobileNo3,
	Address=Address1,
	MedicineCount=ISNULL((SELECT COUNT(SL.PatientCode) FROM SaleLedger SL WHERE SL.PatientCode = Patient.PatientCode), 0),
	Doctor = (SELECT D.Name From Doctors D WHERE Patient.DoctCode=D.DoctCode)
FROM 
	Patient
WHERE 
	PatientCatCode IN (:ai_patientcatcode) AND
	DATE BETWEEN :adt_startdate AND :adt_enddate
ORDER BY
	City,
	Patient.Name
	
	"
  update="Patient" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_patientcatcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="city A, date A, name A, regno A"
)
