release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=560 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="Manufacturer.Name"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_address1 dbname="Manufacturer.Address1"  )
column=(type=char(30) updatewhereclause=yes name=manufacturer_city dbname="Manufacturer.City"  )
column=(type=char(30) updatewhereclause=yes name=manufacturer_country dbname="Manufacturer.Country"  )
column=(type=char(30) updatewhereclause=yes name=manufacturer_phone dbname="Manufacturer.Phone"  )
column=(type=char(60) updatewhereclause=yes name=zone_name dbname="Zone.Name"  )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"Manufacturer~" )  TABLE(NAME=~"Zone~" ) COLUMN(NAME=~"Manufacturer.Name~") COLUMN(NAME=~"Manufacturer.Address1~") COLUMN(NAME=~"Manufacturer.City~") COLUMN(NAME=~"Manufacturer.Country~") COLUMN(NAME=~"Manufacturer.Phone~") COLUMN(NAME=~"Zone.Name~")    JOIN (LEFT=~"Zone.ManfCode~"    OP =~"=~"RIGHT=~"Manufacturer.ManfCode~" )WHERE(    EXP1 =~"Zone.ManfCode~"   OP =~"=~"    EXP2 =~":Zonemanfcode~" ) ) ARG(NAME = ~"Zonemanfcode~" TYPE = number) "
  arguments=(("Zonemanfcode", number))
 sort="zone_name A, manufacturer_name A"
)
