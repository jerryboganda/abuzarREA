table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
column=(type=char(100) updatewhereclause=yes name=model dbname="model"  )
column=(type=char(60) updatewhereclause=yes name=color dbname="color"  )
column=(type=char(60) updatewhereclause=yes name=color2 dbname="color2"  )
column=(type=char(100) updatewhereclause=yes name=itemthickness dbname="itemthickness"  )
column=(type=char(100) updatewhereclause=yes name=itemthickness2 dbname="itemthickness2"  )
column=(type=decimal(4) updatewhereclause=yes name=thickness dbname="thickness"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=decimal(4) updatewhereclause=yes name=length dbname="length"  )
column=(type=decimal(4) updatewhereclause=yes name=width dbname="width"  )
column=(type=decimal(8) updatewhereclause=yes name=areavolume dbname="areavolume"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice2 dbname="saleprice2"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice3 dbname="saleprice3"  )
 retrieve="select 
	aliasname=item.customicode,
	itemname=item.name,
	itemcategory=(select name from itemcategory where itemcategory.icatcode=item.icatcode),
	model=item.modeldescription,
	color=(select name from itemcolour where item.icolourcode=itemcolour.icolourcode),
	color2=(select name from itemcolour where item.itemcolourcode2=itemcolour.icolourcode),
	itemthickness=(select name from itemthickness where item.itemthicknesscode=itemthickness.itemthicknesscode),
	itemthickness2=(select name from itemthickness where item.itemthicknesscode2=itemthickness.itemthicknesscode),
	thickness=item.thickness,
	remarks=item.remarks,
	length=item.length,
	width=item.width,
	areavolume = item.areavolume,
	purprice=item.purprice,
	saleprice=item.saleprice,
	saleprice2=item.saleprice2,
	saleprice3=item.saleprice3

from item

where item.icatcode in (:aa_catcode) 
	
order by itemcategory,
		    itemname
			"
  arguments=(("aa_catcode", numberlist))
 sort="itemcategory A, itemname A"
)
