header(height=1625 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=customer dbname="name"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="custalias"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="customercategory"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=long updatewhereclause=yes name=custcatcode dbname="custcatcode"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(60) updatewhereclause=yes name=cp dbname="CP"  )
column=(type=char(100) updatewhereclause=yes name=fax dbname="Fax"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(60) updatewhereclause=yes name=email dbname="email"  )
column=(type=char(100) updatewhereclause=yes name=cellno dbname="cellno"  )
 retrieve="SELECT name=(select accounts.name from accounts where acccode=CUST.custcode),
	custalias=(select accounts.aliasname from accounts where acccode=CUST.custcode),
	customercategory=(select name from customercategory where customercategory.custcatcode=cust.custcatcode),
	address=CUST.address1,
	city=CUST.city,
	custcatcode=CUST.custcatcode,
	address2=CUST.address2,
   
	CP=CUST.CP,
	Fax=CUST.fax,
	Phone=CUST.phone,
	email=CUST.email,
	cellno=cust.cellno

FROM CUSTOMER CUST
WHERE custcatcode IN (:aa_custcatcode)
ORDER BY customercategory,
				name "
  arguments=(("aa_custcatcode", numberlist))
)
