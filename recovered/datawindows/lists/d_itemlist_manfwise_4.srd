table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="NAME"  )
column=(type=long updatewhereclause=yes name=item_icode dbname="Item.icode"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.Name"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="itempacking"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=commissionperunit dbname="CommissionPerUnit"  )
 retrieve=" SELECT	Item.CustomICode,   
			NAME=item.name,
			Item.icode,   
         	Manufacturer.Name,
			itempacking=(select name from itempacking where item.packcode=itempacking.packcode),   

         	price=(case :ar_pricetype 
						when 1 then item.saleprice 
						when 2 then saleprice2 
						when 3 then saleprice3 
					else saleprice end),
			CommissionPerUnit = Item.CommissionPerUnit
    FROM Item,   
         Manufacturer
        
   WHERE ( Item.ManfCode IN( :ar_ManfCode )) and
				(item.manfcode = manufacturer.manfcode) 
ORDER BY Manufacturer.Name, Item.Name"
  arguments=(("ar_manfcode", numberlist), ("ar_pricetype", number))
 sort="manufacturer A, itemname A"
)
