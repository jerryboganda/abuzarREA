release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1239 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=531 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=decimal(2) updatewhereclause=yes name=item_purprice dbname="Item.purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="RetailPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=ctnprice dbname="CTNPrice"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="Manufacturer.name"  )
column=(type=char(60) updatewhereclause=yes name=classname dbname="classname"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
 retrieve="SELECT 
	GroupName=CASE :as_grouptype WHEN 'M' THEN Manufacturer.name WHEN 'C' THEN itemcategory.name WHEN 'P' THEN itemPacking.name ELSE itemclass.name END,
	Item.Name,  
	aliasname=item.customicode, 
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	Item.purprice,   
	SalePrice=Item.RetailPrice, 
	RetailPrice=Item.SalePrice, 
	CTNPrice = (SELECT MAX(AA.SalePrice) FROM AlternateItemAlias AA WHERE AA.ICode =Item.ICode),
	Item.PackUnits,   
	Manufacturer.name,
	classname=itemclass.name,
	Category=itemcategory.name,
	Packing=itempacking.name,
	PackingDesc=item.PackingDesc
FROM 
	Manufacturer, 
	Item 
	LEFT OUTER JOIN itemclass ON (Item.ICCode = itemclass.ICCode)
	LEFT OUTER JOIN itempacking ON (Item.PackCode = itempacking.PackCode),
	ItemCategory
WHERE 
	CASE :as_grouptype 
		WHEN 'M' THEN Item.ManfCode
		WHEN 'C' THEN Item.ICatCode 
		WHEN 'P' THEN item.PackCode 
		ELSE Item.ICCode END IN (:ai_groupcode) and
	Manufacturer.manfcode = Item.ManfCode and
	Item.icatcode=itemcategory.icatcode and
	Item.active=1
GROUP BY 
	Item.ICode,
	Item.name,
	item.customicode, 
	Item.Active,
	Item.purprice, 
	Item.SalePrice,  
	Item.RetailPrice,
	Item.PackUnits, 
	Manufacturer.name,
	itemcategory.name,
	Itemclass.name,
	itempacking.name,
	Item.PackingDesc
"
  arguments=(("as_grouptype", string), ("ai_groupcode", numberlist))
 sort="groupname A, category A"
)
