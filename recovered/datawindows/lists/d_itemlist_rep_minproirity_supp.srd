table(column=(type=long updatewhereclause=yes name=item_icode dbname="Item.ICode"  )
column=(type=char(75) updatewhereclause=yes name=item_customicode dbname="Item.CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=long updatewhereclause=yes name=item_iccode dbname="Item.ICCode"  )
column=(type=char(60) updatewhereclause=yes name=itemclass_name dbname="ItemClass.name"  )
column=(type=long updatewhereclause=yes name=item_icatcode dbname="Item.ICatCode"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
column=(type=long updatewhereclause=yes name=item_packcode dbname="Item.Packcode"  )
column=(type=char(20) updatewhereclause=yes name=itempacking_name dbname="ItemPacking.name"  )
column=(type=decimal(2) updatewhereclause=yes name=item_saleprice dbname="Item.SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=item_purprice dbname="Item.PurPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=item_retailprice dbname="Item.RetailPrice"  )
column=(type=decimal(5) updatewhereclause=yes name=item_avgprice dbname="Item.AvgPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=item_salediscperc dbname="Item.SaleDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=item_purdiscperc dbname="Item.PurDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=item_salestax dbname="Item.SalesTax"  )
column=(type=long updatewhereclause=yes name=item_reorderqty dbname="Item.ReorderQty"  )
column=(type=long updatewhereclause=yes name=item_optimumqty dbname="Item.OptimumQty"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=long updatewhereclause=yes name=item_active dbname="Item.Active" 
 values="Yes	1/No	0/"  )
column=(type=long updatewhereclause=yes name=item_prescribed dbname="Item.Prescribed"  )
column=(type=long updatewhereclause=yes name=item_refrigrated dbname="Item.Refrigrated"  )
column=(type=long updatewhereclause=yes name=item_printable dbname="Item.Printable"  )
column=(type=char(100) updatewhereclause=yes name=item_location1 dbname="Item.Location1"  )
column=(type=char(100) updatewhereclause=yes name=item_remarks1 dbname="Item.Remarks1"  )
column=(type=char(100) updatewhereclause=yes name=item_location dbname="Item.Location"  )
column=(type=char(100) updatewhereclause=yes name=item_remarks dbname="Item.Remarks"  )
column=(type=long updatewhereclause=yes name=item_gcode dbname="Item.Gcode"  )
column=(type=char(60) updatewhereclause=yes name=godown_name dbname="Godown.name"  )
column=(type=long updatewhereclause=yes name=item_reorderlevel dbname="Item.reorderLevel"  )
column=(type=long updatewhereclause=yes name=item_optimumlevel dbname="Item.OptimumLevel"  )
column=(type=decimal(2) updatewhereclause=yes name=item_recentpurprice dbname="Item.RecentPurPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=item_saleprice2 dbname="Item.SalePrice2"  )
column=(type=decimal(2) updatewhereclause=yes name=item_saleprice3 dbname="Item.SalePrice3"  )
column=(type=long updatewhereclause=yes name=item_greorderqty dbname="Item.GReorderQty"  )
column=(type=long updatewhereclause=yes name=item_goptimumqty dbname="Item.GOptimumQty"  )
column=(type=char(1) updatewhereclause=yes name=taxable dbname="Taxable" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) updatewhereclause=yes name=item_packsalestax dbname="Item.Packsalestax"  )
column=(type=char(100) updatewhereclause=yes name=item_regdno dbname="Item.RegdNo"  )
column=(type=char(100) updatewhereclause=no name=itemalert dbname="ItemAlert"  )
column=(type=char(60) updatewhereclause=no name=supplier dbname="Supplier"  )
 retrieve="SELECT 
	item.ICode,
	item.CustomICode,
	item.Name,
	manufacturer=manufacturer.Name,
	item.ICCode,
	itemclass.name,
	item.ICatCode,
	ItemCategory=itemcategory.name,
	PackingDesc=Item.PackingDesc,
	item.Packcode,
	itempacking.name,
	item.SalePrice,
	item.PurPrice,
	item.RetailPrice,
	item.AvgPrice,
	item.SaleDiscPerc,
	item.PurDiscPerc,
	item.SalesTax,
	item.ReorderQty,
	item.OptimumQty,
	item.PackUnits,
	item.Active,
	item.Prescribed,
	item.Refrigrated,
	item.Printable,
	item.Location1,
	item.Remarks1,
	item.Location,
	item.Remarks,
	item.Gcode,
	godown.name,
	item.reorderLevel,
	item.OptimumLevel,
	item.RecentPurPrice,
	item.SalePrice2,
	item.SalePrice3,
	item.GReorderQty,
	item.GOptimumQty,
	Taxable=Item.Taxable,
	Item.Packsalestax,
	Item.RegdNo,
	ItemAlert = (SELECT IA.Name FROM ItemAlert IA WHERE IA.ItemAlertCode=Item.ItemAlertCode),
	Supplier = (SELECT MAX(A.Name)
		FROM Accounts A, Supplier S, ItemSuppliers ITS
		WHERE ITS.ICode=Item.ICode AND ITS.SuppCode = S.SuppCode AND S.SuppCode=A.AccCode AND
			ITS.Priority IN
			(SELECT Priority=MIN(ITTS.Priority) FROM ItemSuppliers ITTS WHERE ICode=Item.ICode))
FROM 
	Item 
	LEFT OUTER JOIN ItemPacking ON (Item.PackCode = ItemPacking.Packcode)
	LEFT OUTER JOIN itemclass ON (Item.ICCode = itemclass.ICCode),
	itemcategory,
	godown,
	manufacturer
WHERE 
	item.gcode=godown.gcode AND
	(item.icatcode=itemcategory.icatcode)AND
	(item.manfcode in (:aa_manfcode) ) and
	item.manfcode=manufacturer.manfcode
"
  arguments=(("aa_manfcode", numberlist))
 sort="item_name A, item_customicode A"
)
