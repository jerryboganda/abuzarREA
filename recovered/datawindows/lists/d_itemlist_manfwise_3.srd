release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=300 print.margin.top=0 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1645 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="NAME"  )
column=(type=long updatewhereclause=yes name=item_icode dbname="Item.icode"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.Name"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="itempacking"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(4) updatewhereclause=yes name=specialprice dbname="specialprice"  )
 retrieve=" SELECT	Item.CustomICode,   
			NAME=item.name,
			Item.icode,   
         	Manufacturer.Name,
			itempacking=(select name from itempacking where item.packcode=itempacking.packcode),   

         	price=(case :ar_pricetype 
						when 1 then item.saleprice 
						when 2 then saleprice2 
						when 3 then saleprice3 
					else saleprice end),
			specialprice= (case :ar_pricetype 
									when 1 then item.saleprice 
									when 2 then saleprice2 
									when 3 then saleprice3 
									else saleprice end) *( 1 - 0.01*:ar_discperc)
    FROM Item,   
         Manufacturer
        
   WHERE ( Item.ManfCode IN( :ar_ManfCode )) and
				(item.manfcode = manufacturer.manfcode) 
ORDER BY Manufacturer.Name, Item.Name"
  arguments=(("ar_manfcode", numberlist), ("ar_pricetype", number), ("ar_discperc", number))
 sort="manufacturer A, itemname A"
)
group(level=1 header.height=197 trailer.height=0 by=("manufacturer"  ) header.color="536870912" trailer.color="536870912" )
