 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"Accounts~" )  TABLE(NAME=~"Notes~" )  TABLE(NAME=~"Supplier~" ) COLUMN(NAME=~"Accounts.Name~") COLUMN(NAME=~"Notes.IssueDate~") COLUMN(NAME=~"Notes.DueDate~") COLUMN(NAME=~"Notes.Amount~") COLUMN(NAME=~"Notes.BankName~")    JOIN (LEFT=~"Notes.BankAccCode~"    OP =~"=~"RIGHT=~"Accounts.AccCode~" )    JOIN (LEFT=~"Supplier.SuppCode~"    OP =~"=~"RIGHT=~"Notes.AccCode~" )) "
  sort="accounts_name A"
)
