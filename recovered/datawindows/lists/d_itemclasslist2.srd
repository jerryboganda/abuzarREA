release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=708 color="536870912" )
summary(height=96 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=name dbname="ItemClass.Name"  )
column=(type=char(60) updatewhereclause=yes name=categoryname dbname="categoryname"  )
column=(type=long updatewhereclause=yes name=code dbname="code"  )
column=(type=long updatewhereclause=yes name=totalitem dbname="totalitem"  )
column=(type=long updatewhereclause=yes name=activeitem dbname="activeitem"  )
column=(type=long updatewhereclause=yes name=inactiveitem dbname="inactiveitem"  )
 retrieve="  SELECT ItemClass.Name,
			categoryname=(select name from itemcategory where itemcategory.icatcode=:ai_catcode),
			code=itemclass.iccode  ,
			totalitem=(select count(icode) from item where item.iccode=itemclass.iccode and item.icatcode=:ai_catcode),
			activeitem=(select count(icode) from item where item.iccode=itemclass.iccode and item.icatcode=:ai_catcode and active=1),
			inactiveitem=(select count(icode) from item where item.iccode=itemclass.iccode and item.icatcode=:ai_catcode and active=0)
    FROM ItemClass   
		where iccode in (select distinct(iccode) from item where icatcode=:ai_catcode)
order by name   "
  arguments=(("ai_catcode", number))
 sort="name A"
)
