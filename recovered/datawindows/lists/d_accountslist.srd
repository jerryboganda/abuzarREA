header(height=1375 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=accname dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=accgroup dbname="accgroup"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.aliasname"  )
column=(type=char(60) updatewhereclause=yes name=acccategory dbname="acccategory"  )
column=(type=char(60) updatewhereclause=yes name=acctype dbname="acctype"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
 retrieve="SELECT  
	dbo.accounts.name,
	accgroup=subaccounts.name,
	dbo.accounts.aliasname,
	acccategory=(select categoryaccounts.name from categoryaccounts where categoryaccounts.catacccode=dbo.subaccounts.catacccode), 
	acctype=(select mainaccounts.name from categoryaccounts,mainaccounts where categoryaccounts.catacccode=dbo.subaccounts.catacccode and categoryaccounts.mainacccode=mainaccounts.mainacccode),
	Active=dbo.accounts.Active
FROM  
	dbo.accounts, dbo.subaccounts   
WHERE  
	dbo.accounts.subcode = dbo.subaccounts.subacccode 
ORDER BY  
	dbo.accounts.name ASC, 
	dbo.accounts.aliasname"
  sort="accname A"
)
