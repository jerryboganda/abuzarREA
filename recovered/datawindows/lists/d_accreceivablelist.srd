header(height=544 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=datetime updatewhereclause=yes name=notes_issuedate dbname="Notes.IssueDate"  )
column=(type=datetime updatewhereclause=yes name=notes_duedate dbname="Notes.DueDate"  )
column=(type=number updatewhereclause=yes name=notes_amount dbname="Notes.Amount"  )
column=(type=char(40) updatewhereclause=yes name=notes_bankname dbname="Notes.BankName"  )
 retrieve="  SELECT Accounts.Name,   
         Notes.IssueDate,   
         Notes.DueDate,   
         Notes.Amount,   
         Notes.BankName  
    FROM Accounts,   
         Customer,   
         Notes  
   WHERE ( Notes.BankAccCode = Accounts.AccCode ) and  
         ( Notes.AccCode = Customer.CustCode )    
"
  sort="accounts_name A"
)
