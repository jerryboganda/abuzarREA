release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1633 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=183 color="536870912" )
table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.aliasname"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area.name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Accounts.Active"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Customer.address1"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="Customer.city"  )
column=(type=char(60) updatewhereclause=yes name=country dbname="Customer.country"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Customer.phone"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(30) updatewhereclause=yes name=category dbname="category"  )
column=(type=char(60) updatewhereclause=yes name=subarea dbname="subarea"  )
 retrieve="SELECT  
	dbo.accounts.aliasname,
	dbo.accounts.name,
	dbo.area.name,
	dbo.accounts.Active,
	dbo.customer.address1,
	dbo.customer.city,
	dbo.customer.country,
	dbo.customer.phone,
	salesman=dbo.salesman.name,
	category=dbo.customercategory.name,
	subarea=dbo.subarea.name
FROM 
	dbo.salesman, dbo.customer, dbo.customercategory, dbo.subarea, dbo.accounts, dbo.area
WHERE 
	( dbo.customer.salesmancode IN (:ai_salesmancode) ) AND
	( dbo.salesman.salesmancode = dbo.customer.salesmancode ) AND
	( dbo.customer.custcode = dbo.accounts.acccode ) AND
	( dbo.accounts.Active = CASE :as_status WHEN 'Y' THEN 'Y' WHEN 'N' THEN 'N' ELSE dbo.accounts.Active END) AND
	( dbo.customer.custcatcode = dbo.customercategory.custcatcode ) AND
	( dbo.area.areacode = dbo.customer.areacode ) and
	( dbo.subarea.subareacode = dbo.customer.subareacode ) 
ORDER BY 
	dbo.salesman.name,
	dbo.accounts.name,
	dbo.customer.address1,
	dbo.customer.city,
	dbo.customer.country,
	dbo.customer.phone"
  arguments=(("ai_salesmancode", numberlist), ("as_status", string))
)
