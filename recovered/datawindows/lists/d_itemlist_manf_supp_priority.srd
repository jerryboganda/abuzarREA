release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=300 print.margin.top=0 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1572 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=208 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=salediscperc dbname="SaleDiscPerc"  )
column=(type=decimal(6) updatewhereclause=yes name=discountedprice dbname="discountedprice"  )
column=(type=char(60) updatewhereclause=yes name=manf dbname="Manf"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="category"  )
column=(type=char(60) updatewhereclause=yes name=suppname dbname="SuppName"  )
 retrieve="select itemname=I.name,
	saleprice=( CASE :ar_SalePriceNo 
						WHEN 2  THEN I.saleprice2
					 	WHEN 3  THEN I.saleprice3
					   WHEN 4  THEN I.saleprice4
					 	WHEN 5  THEN I.saleprice5
					ELSE
					  I.saleprice
					END ),
				
	purprice=I.purprice,
	SaleDiscPerc=( CASE :ar_SaleDiscNo 
						WHEN 2  THEN I.salediscperc2
					 	WHEN 3  THEN I.salediscperc3
					   WHEN 4  THEN I.salediscperc4
					 	WHEN 5  THEN I.salediscperc5
					ELSE
					  I.salediscperc
					END ),
	discountedprice=round(I.saleprice *(1 - ( CASE :ar_SaleDiscNo 
																	WHEN 2  THEN I.salediscperc2
					 												WHEN 3  THEN I.salediscperc3
					   											WHEN 4  THEN I.salediscperc4
					 												WHEN 5  THEN I.salediscperc5
															ELSE
					  												I.salediscperc
															END) * 0.01),2),
 	Manf=M.Name,
	category=(select name from itemcategory where icatcode=I.icatcode),
	SuppName=(select name from accounts where acccode=ISS.suppcode)

from Item I
	LEFT OUTER JOIN 
     (select * from ItemSuppliers 
      where priority=1) AS ISS ON (I.icode = ISS.icode),
     Manufacturer M

Where  I.manfcode IN (:aa_manfcode) and
       I.manfcode=M.manfcode
order by M.name,
			I.name"
  arguments=(("aa_manfcode", numberlist), ("ar_SalePriceNo", number), ("ar_SaleDiscNo", number))
)
