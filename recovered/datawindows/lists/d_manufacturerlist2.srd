release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1406 color="536870912" )
summary(height=218 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=name dbname="Manufacturer.Name"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Manufacturer.Address1"  )
column=(type=char(30) updatewhereclause=yes name=city dbname="Manufacturer.City"  )
column=(type=char(30) updatewhereclause=yes name=country dbname="Manufacturer.Country"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Manufacturer.Phone"  )
column=(type=long updatewhereclause=yes name=purorderbaseperioddays dbname="Manufacturer.PurOrderBasePeriodDays"  )
column=(type=long updatewhereclause=yes name=purorderprojperioddays dbname="Manufacturer.PurOrderProjPeriodDays"  )
column=(type=char(100) updatewhereclause=yes name=purorderpolicy dbname="PurOrderPolicy"  )
column=(type=long updatewhereclause=yes name=totalitem dbname="totalitem"  )
column=(type=long updatewhereclause=yes name=activeitem dbname="activeitem"  )
column=(type=long updatewhereclause=yes name=inactiveitem dbname="inactiveitem"  )
 retrieve="  SELECT Manufacturer.Name,   
         Manufacturer.Address1,   
         Manufacturer.City,   
         Manufacturer.Country,   
         Manufacturer.Phone,   
         Manufacturer.PurOrderBasePeriodDays,   
         Manufacturer.PurOrderProjPeriodDays,   
         PurOrderPolicy = (SELECT P.Name FROM POPolicy P WHERE P.POPolicyCode = Manufacturer.POPolicyCode) ,
		totalitem=(select count(icode) from item where item.manfcode=manufacturer.manfcode),
		activeitem=(select count(icode) from item where item.manfcode=manufacturer.manfcode and active=1),
		inactiveitem=(select count(icode) from item where item.manfcode=manufacturer.manfcode and active=0) 
    FROM Manufacturer   
"
  sort="name A"
)
