table(column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.aliasname"  )
column=(type=char(60) updatewhereclause=yes name=area_name dbname="Area.name"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory.name"  )
column=(type=char(60) updatewhereclause=yes name=customer_address1 dbname="Customer.address1"  )
column=(type=char(60) updatewhereclause=yes name=customer_address2 dbname="Customer.address2"  )
column=(type=char(60) updatewhereclause=yes name=customer_city dbname="Customer.city"  )
column=(type=char(60) updatewhereclause=yes name=customer_country dbname="Customer.country"  )
column=(type=char(100) updatewhereclause=yes name=customer_phone dbname="Customer.phone"  )
column=(type=char(60) updatewhereclause=yes name=customer_cp dbname="Customer.cp"  )
column=(type=char(30) updatewhereclause=yes name=customer_licenceno dbname="Customer.licenceno"  )
column=(type=datetime updatewhereclause=yes name=customer_licenceexpiry dbname="Customer.licenceexpiry"  )
column=(type=char(30) updatewhereclause=yes name=customer_nic dbname="Customer.nic"  )
column=(type=char(50) updatewhereclause=yes name=customer_ntnno dbname="Customer.ntnno"  )
 retrieve="  SELECT dbo.accounts.name , 
			dbo.accounts.aliasname,
			dbo.area.name,
			dbo.customercategory.name,
			dbo.customer.address1,
			dbo.customer.address2,
			dbo.customer.city,
			dbo.customer.country,
			dbo.customer.phone,
			dbo.customer.cp,
			dbo.customer.licenceno,
			dbo.customer.licenceexpiry,
			dbo.customer.nic,
			dbo.customer.ntnno
    FROM dbo.customer, 
			dbo.accounts, 
         dbo.area,
			dbo.customercategory

   WHERE ( dbo.customer.custcode = dbo.accounts.acccode ) and
			( dbo.area.areacode = dbo.customer.areacode ) and
			( dbo.area.areacode IN (:ai_areacode) ) and
			( dbo.customer.custcatcode = dbo.customercategory.custcatcode ) and
			( dbo.customercategory.custcatcode IN (:ai_custcatcode) )
			 
ORDER BY
			dbo.area.name, 
			dbo.customercategory.name, 
			dbo.accounts.name ,
			dbo.accounts.aliasname,
			dbo.customer.address1 ,
			dbo.customer.city ,
			dbo.customer.country ,
			dbo.customer.phone

"
  arguments=(("ai_areacode", numberlist), ("ai_custcatcode", numberlist))
 sort="area_name A, customercategory A, accounts_name A, aliasname A, customer_city A"
)
