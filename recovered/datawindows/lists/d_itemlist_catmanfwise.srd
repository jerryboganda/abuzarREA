release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=1 print.margin.top=0 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1572 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.CustomICode"  )
column=(type=char(8000) updatewhereclause=yes name=itemname dbname="NAME"  )
column=(type=long updatewhereclause=yes name=item_icode dbname="Item.icode"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="Item.PurPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=item_retailprice dbname="Item.RetailPrice"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.Name"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory.Name"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Item.PackingDesc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Item.SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=salediscperc dbname="Item.SaleDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=purdiscperc dbname="Item.PurDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc1 dbname="Item.gstperc1"  )
 retrieve="SELECT	Item.CustomICode,   
			NAME=RTRIM(LTRIM(Item.Name)) + ' ' +isnull( REPLICATE('-',60-LEN(RTRIM(LTRIM(Item.Name)))),''),
			Item.icode,   
         Item.PurPrice,   
         Item.RetailPrice,   
         Manufacturer.Name,   
         ItemCategory.Name,   
         Item.PackingDesc,   
         Item.SalePrice,
			Item.SaleDiscPerc,
			Item.PurDiscPerc,
			item.gstperc1 
    FROM Item,   
         Manufacturer,   
         ItemCategory
   WHERE ( Item.ManfCode IN (:ar_ManfCode) ) and
			( Item.ICatCode = :ar_ICatCode ) and
			( Item.ICatCode = ItemCategory.icatcode) and
			(item.manfcode = manufacturer.manfcode) 
ORDER BY Manufacturer.Name, ItemCategory.Name, Item.Name"
  arguments=(("ar_manfcode", numberlist), ("ar_icatcode", number))
 sort="manufacturer A, itemcategory A, itemname A"
)
group(level=1 header.height=229 trailer.height=0 by=("manufacturer"  ) header.color="536870912" trailer.color="536870912" )
