release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes print.columns=2 print.columns.width=3744 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=312 color="536870912" )
summary(height=31 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="NAME"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.Name"  )
column=(type=char(2) updatewhereclause=yes name=stock dbname="Stock"  )
 retrieve="SELECT
	ICode=Item.ICode,
	NAME=Item.Name,
	AliasName=Item.CustomICode,   
	Manufacturer.Name,
	Stock=CASE WHEN (SELECT SUM(1) FROM GodownDetail G WHERE G.ICode=Item.ICode) IS NULL THEN '**' ELSE '  ' END
FROM 
	Item, Manufacturer
WHERE 
	( Item.ManfCode = :ai_ManfCode ) and
	( item.manfcode = manufacturer.manfcode) 
ORDER BY 
	Manufacturer.Name, 
	Item.Name"
  arguments=(("ai_manfcode", number))
)
