table(column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="Postdate"  )
column=(type=char(1) updatewhereclause=yes name=due dbname="Due"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(60) updatewhereclause=yes name=title dbname="title"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="item"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="godown"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=discount dbname="discount"  )
column=(type=decimal(4) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=char(100) updatewhereclause=yes name=reference dbname="reference"  )
column=(type=decimal(0) updatewhereclause=yes name=utn dbname="UTN"  )
 retrieve="  select	date = saleledger.date,
	invcode=saleledger.saleinvcode,
	Postdate = saleledger.postdate,
	Due = saledetail.Due,
	salesman = users.username,
	title= Case
		When salecatcode = 1 or salecatcode = 2 Then
			(Select accounts.name from accounts where accounts.acccode = saleledger.custcode)
		Else 'Cash Sale'	End,
	aliasname=customicode,
	item=item.name,
	godown= (select name from godown where gcode=:ar_gcode),
	qty = saledetail.looseqty+saledetail.bonusqty,
	
	batch = saledetail.batch,
	expiry=saledetail.expiry,
	rate=Round(saledetail.rate, 2),
	discount=saledetail.discperc,
	purprice=saledetail.purunitrate,
	reference = saleledger.remarks,
	UTN=isnull(saledetail.saleutn,0)
from	saleledger, saledetail, users, item
where	saledetail.gcode = :ar_gcode and
	saleledger.date Between :ar_stdate and :ar_enddate and
	saleledger.saleinvcode = saledetail.saleinvcode and
	saledetail.icode = item.icode  AND 
	saleledger.salesmancode=users.usercode
order by saledetail.rowid
	
"
  arguments=(("ar_gcode", number), ("ar_stdate", datetime), ("ar_enddate", datetime))
 sort="date A, batch A, expiry A"
)
