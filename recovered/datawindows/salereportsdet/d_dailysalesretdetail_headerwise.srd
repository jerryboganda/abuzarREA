table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Aliasname"  )
column=(type=long updatewhereclause=yes name=srinvcode dbname="srinvcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=char(20) updatewhereclause=yes name=machinename dbname="machinename"  )
column=(type=char(30) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(75) updatewhereclause=yes name=person dbname="Person"  )
column=(type=char(12) updatewhereclause=yes name=customeraliasname dbname="CustomerAliasname"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=decimal(6) updatewhereclause=yes name=totalsalestax dbname="totalsalestax"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=id dbname="ID"  )
 retrieve=" SELECT 
	Aliasname=item.customicode,
	srinvcode = dbo.srledger.srinvcode,    
	headerno = dbo.srledger.headerno,
	headerinvno = dbo.srledger.headerinvno,
	saleinvcode = dbo.srledger.saleinvcode,    
	date = dbo.srledger.date,   
	invdiscperc = dbo.srledger.discperc,    
	flatdisc = dbo.srledger.flatdisc,    
	misccharges = dbo.srledger.misccharges, 
	invsalestax = dbo.srledger.salestax,   
	invgstperc1 = dbo.srledger.invgstperc1,
	looseqty = dbo.srdetail.looseqty, 
	packqty  = srdetail.packqty,  
	bonusqty=srdetail.bonusqty,
	machinename=srledger.machinename,
	packing = case when dbo.item.packcode IS Null Then space(30) else dbo.itempacking.name end, 
	price = dbo.srdetail.srprice,    
	itemdiscperc = dbo.srdetail.discperc,    
	packunits = dbo.srdetail.packunits,    
	batch = dbo.srdetail.batch,    
	expiry = dbo.srdetail.expiry,    
	salestax  = srdetail.salestax,
	unitsalestax = srdetail.unitsalestax,
	gstperc = srdetail.gstperc,
	itemname = item.name,
	datestring = Rtrim(LTrim(Str(DatePart(dd, srledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, srledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, srledger.date)))), 
	Person = ltrim(rtrim(dbo.accounts.name)) + ' (' + ltrim(rtrim(dbo.accounts.aliasname)) + ')',
	CustomerAliasname = dbo.accounts.aliasname ,
	username=dbo.users.username ,
	totalsalestax = 
		(SELECT invtotalsalestax= 
			Round (
				/*invoice level salestax*/
				Round ( ( Round ( Sum ( Round ( SD.looseqty * SD.srprice * (1 - SD.discperc * 0.01 ) , 2 ) ) * 
					( 1 - SL.discperc * 0.01 ) , 2 ) - SL.flatdisc ) * SL.invgstperc1 * 0.01  , 2 ) +
				/*items salestax*/
				Sum (Round ((SD.looseqty + SD.Bonusqty) * SD.unitsalestax + 
					Round ( Round (SD.looseqty * SD.srprice * (1 - SD.discperc * 0.01 ), 2 ) * SD.gstperc * 0.01 , 2 ) , 2 ) )						 
			 , 0 )
		FROM dbo.srledger SL, dbo.srdetail SD
		WHERE  (SL.srinvcode = dbo.srledger.srinvcode )   and
			(SL.srinvcode = SD.srinvcode )   
		GROUP BY 
			SL.srinvcode,
			SL.misccharges,   
			SL.flatdisc,   
			SL.invgstperc1, 
			SL.discperc),
	posted = dbo.srledger.posted,
	ID = dbo.srdetail.rowid
FROM
	dbo.srledger, 
	dbo.srdetail,    
	dbo.item LEFT OUTER JOIN dbo.itempacking ON ( dbo.item.packcode = dbo.itempacking.packcode), 
	dbo.accounts,
	dbo.users
WHERE  
	dbo.srledger.date >= :ad_StartDate and
	dbo.srledger.date <= :ad_EndDate  and
	dbo.srledger.srcatcode IN (:ai_saletype) and
	dbo.srledger.headerno = :ai_headerno and
	dbo.srledger.salesmancode=users.usercode and
	dbo.srledger.srinvcode = dbo.srdetail.srinvcode and  
	dbo.srdetail.icode = item.icode and 
	/* (dbo.item.packcode=dbo.itempacking.packcode or dbo.item.packcode=null) and*/
	dbo.srledger.custcode = dbo.accounts.acccode
UNION ALL
SELECT 
	Aliasname=item.customicode,
	srinvcode = SRL.srbufferinvcode,    
	headerno = SRL.headerno,
	headerinvno = SRL.headerinvno,
	saleinvcode = SRL.saleinvcode,    
	date = SRL.date,   
	invdiscperc = SRL.discperc,    
	flatdisc = SRL.flatdisc,    
	misccharges = SRL.misccharges, 
	invsalestax = SRL.salestax,   
	invgstperc1 = SRL.invgstperc1,
	looseqty = SRD.looseqty, 
	packqty  = SRD.packqty,  
	bonusqty=SRD.bonusqty,
	machinename=SRL.machinename,
	packing = case when dbo.item.packcode IS Null Then space(30) else dbo.itempacking.name end, 
	price = SRD.srprice,    
	itemdiscperc = SRD.discperc,    
	packunits = SRD.packunits,    
	batch = SRD.batch,    
	expiry = SRD.expiry,    
	salestax  = SRD.salestax,
	unitsalestax = SRD.unitsalestax,
	gstperc = SRD.gstperc,
	itemname = item.name,
	datestring = Rtrim(LTrim(Str(DatePart(dd, SRL.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, SRL.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, SRL.date)))), 
	Person = ltrim(rtrim(dbo.accounts.name)) + ' (' + ltrim(rtrim(dbo.accounts.aliasname)) + ')',
	CustomerAliasname = dbo.accounts.aliasname ,
	username=dbo.users.username ,
	totalsalestax = 
		(SELECT invtotalsalestax= 
			Round (
				/*invoice level salestax*/
				Round ( ( Round ( Sum ( Round ( SD.looseqty * SD.srprice * (1 - SD.discperc * 0.01 ) , 2 ) ) * 
					( 1 - SL.discperc * 0.01 ) , 2 ) - SL.flatdisc ) * SL.invgstperc1 * 0.01  , 2 ) +
				/*items salestax*/
				Sum (Round ((SD.looseqty + SD.Bonusqty) * SD.unitsalestax + 
					Round ( Round (SD.looseqty * SD.srprice * (1 - SD.discperc * 0.01 ), 2 ) * SD.gstperc * 0.01 , 2 ) , 2 ) )
			 , 0 )
		FROM	dbo.SRBufferLedger SL, dbo.SRBufferDetail SD
		WHERE	(SL.srbufferinvcode = SRL.srbufferinvcode ) and
			(SL.srbufferinvcode = SD.srbufferinvcode )
		GROUP BY 
			SL.srbufferinvcode,
			SL.misccharges,   
			SL.flatdisc,   
			SL.invgstperc1, 
			SL.discperc),
	posted = SRL.posted,
	ID = SRD.rowid
FROM
	dbo.SRBufferLedger SRL, 
	dbo.SRBufferDetail SRD,    
	dbo.item LEFT OUTER JOIN dbo.itempacking ON ( dbo.item.packcode = dbo.itempacking.packcode), 
	dbo.accounts,
	dbo.users
WHERE  
	SRL.Posted = 'N' AND
	SRL.date >= :ad_StartDate and
	SRL.date <= :ad_EndDate  and
	SRL.srcatcode IN (:ai_saletype) and
	SRL.headerno = :ai_headerno and
	SRL.salesmancode=users.usercode and
	SRL.srbufferinvcode = SRD.srbufferinvcode and  
	SRD.icode = item.icode and 
	SRL.custcode = dbo.accounts.acccode
ORDER BY
	SRInvCode,
	ID,
	ItemName,
	AliasName,
	LooseQty"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_saletype", numberlist), ("ai_headerno", number))
)
