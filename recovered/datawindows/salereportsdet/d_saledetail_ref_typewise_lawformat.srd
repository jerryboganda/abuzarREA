header(height=3572 color="536870912" )
summary(height=250 color="536870912" )
footer(height=635 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvcode dbname="headerinvcode"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="class"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="itempacking"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="custalias"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(60) updatewhereclause=yes name=custcity dbname="custcity"  )
column=(type=char(60) updatewhereclause=yes name=custcountry dbname="custcountry"  )
column=(type=long updatewhereclause=yes name=saletypeinvno dbname="saletypeinvno"  )
 retrieve="SELECT 
	aliasname=item.customicode,
	itemname= item.name, 
	Batch = SaleDetail.Batch, 
	looseqty = SUM(saledetail.looseqty),
	headerno=saleledger.headerno,
	headerinvcode=saleledger.headerinvno,
	class = ISNULL((select itemclass.name from itemclass where itemclass.iccode = item.iccode), ''),
	itempacking = itempacking.name,
	itemcategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = Item.ICatCode),
	accname = dbo.accounts.name,   
	custalias=dbo.accounts.aliasname,
	address = dbo.customer.address1,   
	address2= dbo.customer.address2,   
	custcity= dbo.customer.city,
	custcountry= dbo.customer.country,
	saletypeinvno=saleledger.saletypeinvno
FROM 
	dbo.saleledger, 
	saledetail, 
	dbo.item LEFT OUTER JOIN dbo.itempacking ON ( dbo.item.packcode = dbo.itempacking.packcode), 
	Accounts, customer
WHERE 
	( saleledger.headerinvno = :ai_headerinvno ) AND
	( saleledger.headerno = :ai_headerno ) AND
	( saleledger.saleinvcode = saledetail.saleinvcode) AND 
	( saledetail.icode = item.icode) and 
	( saleLedger.CustCode = Customer.CustCode ) AND
	( Customer.CustCode = Accounts.AccCode )
GROUP BY
	saleledger.headerno,
	saleledger.headerinvno,
	saleledger.saletypeinvno,
	item.customicode,
	item.name,
	itempacking.name,
	Item.ICatCode,
	item.iccode,
	SaleDetail.Batch, 
	dbo.accounts.name,   
	dbo.accounts.aliasname,
	dbo.customer.address1,   
	dbo.customer.address2,   
	dbo.customer.city,
	dbo.customer.country
ORDER BY 
	item.name"
  arguments=(("ai_headerno", number), ("ai_headerinvno", number))
)
