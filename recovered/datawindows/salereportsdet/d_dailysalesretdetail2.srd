table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(6) updatewhereclause=yes name=retvalue dbname="retvalue"  )
 retrieve=" SELECT 
	Aliasname=item.customicode,
	itemname = item.name,
	looseqty = SUM(dbo.srdetail.looseqty + dbo.srdetail.bonusqty), 
	retvalue = SUM(dbo.srdetail.looseqty * dbo.srdetail.SRPRice * (1 - dbo.srdetail.discperc * 0.01) * (1 - dbo.srledger.discperc * 0.01))
FROM
	dbo.srledger, 
	dbo.srdetail,    
	dbo.item
WHERE  
	dbo.srledger.date BETWEEN :ad_StartDate and :ad_EndDate  and
	/*dbo.srledger.srcatcode IN (6, 7, 8) and*/
	dbo.srledger.srcatcode IN (:ai_salerettype) and
	dbo.srledger.srinvcode = dbo.srdetail.srinvcode and  
	dbo.srdetail.icode = item.icode
GROUP BY
	item.customicode,
	item.name
UNION ALL
 SELECT 
	Aliasname=item.customicode,
	itemname = item.name,
	looseqty = SUM(dbo.SRBufferDetail.looseqty + dbo.SRBufferDetail.bonusqty), 
	retvalue = SUM(dbo.SRBufferDetail.looseqty * dbo.SRBufferDetail.SRPRice * (1 - dbo.SRBufferDetail.discperc * 0.01) * (1 - dbo.SRBufferLedger.discperc * 0.01))
FROM
	dbo.SRBufferLedger, 
	dbo.SRBufferDetail,    
	dbo.item
WHERE  
	dbo.SRBufferLedger.Posted = 'N' AND
	dbo.SRBufferLedger.date BETWEEN :ad_StartDate and :ad_EndDate  and
	/*dbo.SRBufferLedger.srcatcode IN (6, 7, 8) and*/
	dbo.SRBufferLedger.srcatcode IN (:ai_salerettype) and
	dbo.SRBufferLedger.srbufferinvcode = dbo.SRBufferDetail.srbufferinvcode and  
	dbo.SRBufferDetail.icode = item.icode
GROUP BY
	item.customicode,
	item.name
ORDER BY
	ItemName,
	AliasName"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_salerettype", numberlist))
)
