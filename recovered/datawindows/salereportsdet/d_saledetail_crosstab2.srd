table(column=(type=char(20) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(20) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(20) updatewhereclause=yes name=location dbname="location"  )
column=(type=number updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=number updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(0) updatewhereclause=yes name=totalprice dbname="totalprice"  )
 retrieve="SELECT
	AliasName=I.CustomICode,
	ItemName=I.name,
	packing=(SELECT IP.Name FROM ItemPacking IP WHERE IP.PackCode = I.PackCode),
	Location = I.Location,
	stock=max(SD.godownbalancestock),
	packunits=Max(SD.packunits),
	Packqty=CAST(CAST(SUM(SD.looseqty) AS INT) / CASE WHEN Max(SD.packunits) > 0 THEN Max(SD.packunits) ELSE 1 END AS INT), 
	looseqty=CAST(SUM(SD.looseqty) AS INT) % CASE WHEN Max(SD.packunits) > 0 THEN Max(SD.packunits) ELSE 1 END, 
	totalprice=ROUND(SUM(SD.looseqty * ( SD.saleprice - SD.itemflatdisc) * ( 1 - SD.discperc * 0.01) * (1 - SL.discperc * 0.01)),2),
	Saletype=(select name from saletype where saletypecode=Max(SL.saletypecode))
FROM 
	Item I,
	saleledger SL,
	saledetail SD
WHERE 	
	SL.date BETWEEN :ad_sdate  AND :ad_ldate AND
	SL.saleinvcode=SD.saleinvcode AND
	SD.icode=I.icode
GROUP BY 
	I.CustomICode,
	I.name,
	I.icode,
	I.PackCode,
	I.Location

"
  arguments=(("ad_sdate", datetime), ("ad_ldate", datetime))
 sort="itemname A, packing A, location A, packqty A, looseqty A"
)
