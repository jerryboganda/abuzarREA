table(column=(type=long updatewhereclause=yes name=refusedsaleinvcode dbname="RefusedSaleInvCode"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes name=reasoncode dbname="ReasonCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=comments dbname="Comments"  )
column=(type=char(60) updatewhereclause=yes name=unknownitemname dbname="UnKnownItemName"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="ROWID"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(4) updatewhereclause=yes name=balance dbname="Balance"  )
 retrieve="SELECT 
	RefusedSaleInvCode=T.RefusedSaleInvCode,   
	SaleInvCode=T.SaleInvCode,   
	Date=T.Date,
	Remarks=T.Remarks,
	UserCode=T.UserCode,
	I.customicode, 
	itemname= CASE WHEN I.name IS NULL THEN T.UnKnownItemName ELSE I.name END, 
	packingdesc=I.packingdesc,
	ReasonCode=T.Reasoncode,
	Comments = T.Comments,	
	UnKnownItemName=T.UnKnownItemName,
	icode=T.icode,   
	ROWID=T.RowID,
	looseqty= T.looseqty,
	saleqty = T.SaleQty,
	Balance = T.looseqty - T.SaleQty
FROM
	(SELECT 
		RefusedSaleInvCode=RSD.RefusedSaleInvCode,   
		Date=RSH.Date,
		Remarks=RSH.Remarks,
		SaleInvCode=RSH.SaleInvCode,   
		UserCode=RSH.UserCode,
		icode=RSD.icode,   
		ReasonCode=RSD.Reasoncode,
		Comments = RSD.Remarks,	
		UnKnownItemName=RSD.UnKnownItemName,
		RowID=RSD.IDENTITYCOL,
		looseqty= RSD.qty,
		saleqty = ISNULL(sum(SD.LooseQty), 0)
	FROM
		RefusedSaleDetail RSD LEFT OUTER JOIN SaleDetail AS SD ON (RSD.rowid = SD.RefusalSaleRowID), 
		RefusedSaleHeader RSH
	WHERE 
		RSH.RefusedSaleInvCode = RSD.RefusedSaleInvCode
	GROUP BY
		RSD.RefusedSaleInvCode,   
		RSH.SaleInvCode,   
		RSH.Date,
		RSH.Remarks,
		RSH.UserCode,
		RSD.icode,   
		RSD.Reasoncode,
		RSD.Remarks,	
		RSD.UnKnownItemName,
		RSD.IDENTITYCOL,
		RSD.qty
	HAVING (RSD.qty - ISNULL(sum(SD.LooseQty), 0)) > 0) AS T LEFT OUTER JOIN Item AS I ON (T.ICode = I.ICode)
"
  sort="refusedsaleinvcode A, rowid A"
)
