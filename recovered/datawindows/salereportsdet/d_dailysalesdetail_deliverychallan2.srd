release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=300 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1864 color="536870912" )
summary(height=250 color="536870912" )
footer(height=385 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="CustRefNo"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Person"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="ICatCode"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=char(100) updatewhereclause=yes name=custrefno2 dbname="custrefno2"  )
column=(type=datetime updatewhereclause=yes name=billingdate dbname="billingdate"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
 retrieve="SELECT
	saleinvcode = dbo.saleledger.saleinvcode,
	date = dbo.saleledger.date, 
	CustRefNo   = dbo.saleledger.CustRefNo,
	remarks     = dbo.saleledger.Remarks,
	looseqty = Sum(dbo.saledetail.looseqty), 
	manufacturer = dbo.manufacturer.name,
	bonusqty = Sum(dbo.saledetail.bonusqty), 
	itemname = item.name,
	packqty  = Max(saledetail.packqty),  
	price = Max(dbo.saledetail.saleprice),    
	datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), 
	Person = dbo.accounts.name,
	ICatCode = IC.ICatCode,
	ItemCategory = IC.Name,
	custrefno2=max(saleledger.custrefno2),
	billingdate=max(saleledger.billingdate),
	DiscPerc = (SELECT Value1 FROM ReportData WHERE Code1 = IC.ICatCode)
	
FROM
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item, 
	dbo.manufacturer,
	dbo.accounts,
	Dbo.ItemCategory IC
WHERE  
	dbo.saleledger.saleinvcode >= :ai_sinvcode and
	dbo.saleledger.saleinvcode <= :ai_linvcode  and
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
	dbo.saledetail.icode = item.icode and 
	dbo.saleledger.custcode = dbo.accounts.acccode and
	dbo.item.manfcode = dbo.manufacturer.manfcode and
	dbo.saleledger.custcode = :al_custcode AND
	dbo.item.icatcode = IC.ICatCode
GROUP BY 
	dbo.saleledger.saleinvcode,
	dbo.saleledger.date,   
	dbo.saleledger.CustRefNo,
	dbo.saleledger.Remarks,
	dbo.saleledger.salesmancode,
	dbo.accounts.name,
	dbo.item.name, 
	dbo.manufacturer.name,
	IC.ICatCode,
	IC.Name
UNION ALL
SELECT 
	saleinvcode = dbo.saleledger.saleinvcode,
	date = dbo.saleledger.date, 
	CustRefNo   = dbo.saleledger.CustRefNo,
	remarks     = dbo.saleledger.Remarks,
	looseqty = Sum(sd.looseqty), 
	manufacturer = dbo.manufacturer.name,
	bonusqty = Sum(sd.bonusqty), 
	itemname = item.name,
	packqty  = 0,  
	price = Max(sd.saleprice),    
	datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), 
	Person = dbo.accounts.name,
	ICatCode = IC.ICatCode,
	ItemCategory = IC.Name,
	custrefno2=max(saleledger.custrefno2),
	billingdate=max(saleledger.billingdate),
	DiscPerc = (SELECT Value1 FROM ReportData WHERE Code1 = IC.ICatCode)
FROM
	dbo.saleledger, 
	dbo.saleinvdetail sd,
	dbo.item, 
	dbo.manufacturer,
	dbo.accounts,
	Dbo.ItemCategory IC
WHERE
	DBO.SaleLedger.impactinventory = 'N' AND
	dbo.saleledger.saleinvcode >= :ai_sinvcode and
	dbo.saleledger.saleinvcode <= :ai_linvcode  and
	dbo.saleledger.saleinvcode = sd.saleinvcode and  
	sd.icode = item.icode and 
	dbo.saleledger.custcode = dbo.accounts.acccode and
	dbo.item.manfcode = dbo.manufacturer.manfcode and
	dbo.saleledger.custcode = :al_custcode AND
	dbo.item.icatcode = IC.ICatCode
GROUP BY 
	dbo.saleledger.saleinvcode,
	dbo.saleledger.date,   
	dbo.saleledger.CustRefNo,
	dbo.saleledger.Remarks,
	dbo.saleledger.salesmancode,
	dbo.accounts.name,
	dbo.item.name, 
	dbo.manufacturer.name,
	IC.ICatCode,
	IC.Name
ORDER BY
	saleinvcode, IC.Name, dbo.item.Name"
  arguments=(("ai_sinvcode", number), ("ai_linvcode", number), ("al_custcode", number), ("as_term1", string), ("as_term2", string), ("as_caption", string))
)
