table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="CustomerAlias"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=long updatewhereclause=yes name=recipecode dbname="RecipeCode"  )
column=(type=long updatewhereclause=yes name=recipeicode dbname="RecipeICode"  )
column=(type=char(60) updatewhereclause=yes name=recipeitem dbname="RecipeItem"  )
column=(type=decimal(4) updatewhereclause=yes name=recipeqty dbname="RecipeQty"  )
column=(type=decimal(6) updatewhereclause=yes name=recipeamount dbname="RecipeAmount"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="ItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="LooseQty"  )
column=(type=decimal(2) updatewhereclause=yes name=invoicerate dbname="InvoiceRate"  )
column=(type=decimal(6) updatewhereclause=yes name=discvalue dbname="DiscValue"  )
column=(type=decimal(6) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=decimal(16) updatewhereclause=yes name=bdrate dbname="BDRate"  )
column=(type=decimal(16) updatewhereclause=yes name=bdratetotal dbname="BDRateTotal"  )
column=(type=decimal(16) updatewhereclause=yes name=bdunit dbname="BDUnit"  )
column=(type=decimal(15) updatewhereclause=yes name=bdprofit dbname="BDprofit"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="AvgPrice"  )
column=(type=decimal(9) updatewhereclause=yes name=avgpricetotal dbname="AvgPricetotal"  )
column=(type=decimal(6) updatewhereclause=yes name=processingfee dbname="ProcessingFee"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="InvDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=invflatdisc dbname="InvFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="MiscCharges"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="GSTPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="UnitSalesTax"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="InvGSTPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve="SELECT 
	SaleInvCode=sl.saleinvcode,
	Date=sl.date,
	CustomerAlias=A.AliasName,
	CustomerName=A.Name,
	RecipeCode=ssh.RecipeCode,
	RecipeICode = ssh.seticode,
	RecipeItem=(SELECT I.Name FROM Item I WHERE I.ICode = ssh.seticode),
	RecipeQty = ssh.qty, 
	RecipeAmount = ssh.qty * ssh.SalePrice,
	ItemAlias = (SELECT I.CustomICode FROM Item I WHERE I.ICode = SD.icode),
	ItemName = (SELECT I.Name FROM Item I WHERE I.ICode = SD.icode),
	LooseQty = SD.LooseQty,
	InvoiceRate = SD.SalePrice,
	DiscValue = SD.ItemFlatDisc + ((SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)),
	NetRate = (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01),
	BDRate = ROUND(SD.PackPrice / CASE WHEN SD.PackUnits > 0 THEN SD.PackUnits ELSE 1 END, 2),
	BDRateTotal=ROUND(SD.PackPrice / CASE WHEN SD.PackUnits > 0 THEN SD.PackUnits ELSE 1 END, 2)* SD.Looseqty,
	BDUnit= ROUND(SD.PackPrice / CASE WHEN SD.PackUnits > 0 THEN SD.PackUnits ELSE 1 END, 2) -  SD.SalePrice,
	BDprofit= (ROUND(SD.PackPrice / CASE WHEN SD.PackUnits > 0 THEN SD.PackUnits ELSE 1 END, 2) -  SD.SalePrice) * SD.LooseQty,
	AvgPrice = SD.AvgPrice,
	AvgPricetotal=(SD.AvgPrice * SD.LooseQty),
	ProcessingFee= (SSOD.ProcessCharge * SSOD.Qty) + (SSOD.Qty * (SSOD.Saleprice - SSOD.Itemflatdisc) * (1 - SSOD.discperc * 0.01) * SSOD.processchargeperc * 0.01),
	InvDiscPerc=SL.DiscPerc,
	InvFlatDisc=SL.FlatDisc,
	MiscCharges=SL.MiscCharges,
	GSTPerc = SD.GSTPerc,
	UnitSalesTax=SD.UnitSalesTax,
	InvGSTPerc = SL.InvGSTPerc1,
	InvTotal = SL.InvTotal
FROM
	SaleLedger sl,
	Accounts A,
	SaleSetsHeader ssh, 
	SaleSetsDetail SSD,
	SaleDetail SD,
	SaleSetsOrigDetail SSOD
WHERE 
	sl.date BETWEEN :adt_startdate AND :adt_enddate AND
	SL.CustCode = A.AccCode AND
	sl.saleinvcode = ssh.saleinvcode  And
	ssh.setcode = ssd.setcode AND
	ssh.setcode = ssod.setcode AND
	sl.saleinvcode = sd.saleinvcode AND
	ssod.icode = sd.icode and
	ssd.icode = sd.icode and
	ssd.rowgroup = sd.rowgroup
UNION ALL
SELECT 
	SaleInvCode=sl.saleinvcode,
	Date=sl.date,
	CustomerAlias=A.AliasName,
	CustomerName=A.Name,
	RecipeCode=NULL,
	RecipeICode = Null,
	RecipeItem=Null,
	RecipeQty = 0, 
	RecipeAmount = 0.00,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	LooseQty = SD.LooseQty,
	InvoiceRate = SD.SalePrice,
	DiscValue = SD.ItemFlatDisc + ((SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)),
	NetRate = (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01),
	BDRate = ROUND(SD.PackPrice / CASE WHEN SD.PackUnits > 0 THEN SD.PackUnits ELSE 1 END, 2),
	BDRateTotal=ROUND(SD.PackPrice / CASE WHEN SD.PackUnits > 0 THEN SD.PackUnits ELSE 1 END, 2)* SD.Looseqty,
	BDUnit= ROUND(SD.PackPrice / CASE WHEN SD.PackUnits > 0 THEN SD.PackUnits ELSE 1 END, 2) -  SD.SalePrice,
	BDprofit= (ROUND(SD.PackPrice / CASE WHEN SD.PackUnits > 0 THEN SD.PackUnits ELSE 1 END, 2) -  SD.SalePrice) * SD.LooseQty,
	AvgPrice = SD.AvgPrice,
	AvgPricetotal=(SD.AvgPrice * SD.LooseQty),
	ProcessingFee= 0.00,
	InvDiscPerc=SL.DiscPerc,
	InvFlatDisc=SL.FlatDisc,
	MiscCharges=SL.MiscCharges,
	GSTPerc = SD.GSTPerc,
	UnitSalesTax=SD.UnitSalesTax,
	InvGSTPerc = SL.InvGSTPerc1,
	InvTotal = SL.InvTotal
FROM
	SaleLedger sl, 
	Accounts A,
	SaleDetail sd, 
	Item I
WHERE 
	sl.date BETWEEN :adt_startdate AND :adt_enddate AND
	SL.CustCode = A.AccCode AND
	sl.saleinvcode = sd.saleinvcode  And
	sd.ICode = I.Icode AND
	sd.RowGroup Not In
		(SELECT
			SaleSetsDetail.RowGroup 
		FROM
			SaleSetsHeader, SaleSetsDetail
		WHERE 
			SaleSetsHeader.SaleInvCode = sl.SaleInvCode And
			SaleSetsHeader.SetCode = SaleSetsDetail.SetCode And
			SaleSetsDetail.ICode = sd.icode And
			SaleSetsDetail.RowGroup = sd.RowGroup)
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="date A, saleinvcode A, recipeitem A, itemname A"
)
