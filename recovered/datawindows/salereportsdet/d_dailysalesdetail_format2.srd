table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(1) updatewhereclause=yes name=impactinventory dbname="impactinventory"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
column=(type=char(60) updatewhereclause=yes name=saletype dbname="saletype"  )
column=(type=char(100) updatewhereclause=yes name=model dbname="Model"  )
column=(type=char(60) updatewhereclause=yes name=colour dbname="Colour"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=rowid dbname="rowid"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Person"  )
column=(type=decimal(2) updatewhereclause=yes name=invnettotal dbname="invnettotal"  )
column=(type=decimal(6) updatewhereclause=yes name=totalsalestax dbname="totalsalestax"  )
 retrieve="SELECT saleinvcode = dbo.saleledger.saleinvcode,
		 headerno=saleledger.headerno,
		 impactinventory = dbo.saleledger.impactinventory,
		 date = dbo.saleledger.date,
		 CustomerCategory = Customer.custcatcode,
		 saletype = (Select Name From SaleType Where SaleTypeCode = dbo.SaleLedger.SaleTypeCode) ,
		 Model = (Select Name From Model Where ModelCode IN (Select Min(ModelCode) From ItemInModel Where ItemInModel.ICode = Item.Icode ) ),
		 Colour = ItemClass.Name,
		 Manufacturer = manufacturer.name,
       invdiscperc = dbo.saleledger.discperc,    
       flatdisc = dbo.saleledger.flatdisc,    
       misccharges = dbo.saleledger.misccharges, 
       invsalestax = dbo.saleledger.salestax,
       invgstperc1 = dbo.saleledger.invgstperc1,
		 posted = dbo.saleledger.posted,	
		 rowid = dbo.saledetail.rowid,
		 looseqty = dbo.saledetail.looseqty, 
		 bonusqty = dbo.saledetail.bonusqty, 
       itemflatdisc=saledetail.itemflatdisc,
       packqty  = saledetail.packqty,  
       price = Round ( dbo.saledetail.saleprice , 0 ),    
       itemdiscperc = dbo.saledetail.discperc,    
		 packunits = dbo.saledetail.packunits,    
		 batch = dbo.saledetail.batch,    
		 expiry = dbo.saledetail.expiry,    
		 salestax  = saledetail.salestax,
	 	 itemname = item.name,
		 unitsalestax = dbo.saledetail.unitsalestax ,    
		 gstperc = dbo.saledetail.gstperc ,    
		 datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), 
		 Person = dbo.accounts.name,
		 invnettotal = Round( dbo.fn_getSaleInvTotal(dbo.saleledger.saleinvcode) , 0 ),
		 /* 
		 invnettotalexctax= (SELECT 
                    amountfg = Round( 
                                     Sum (  SD.looseqty *  SD.saleprice)    
			                            -  Round(Sum (Round((  SD.looseqty  * ( SD.saleprice -  SD.itemflatdisc) * ( SD.discperc * .01)) + ( SD.looseqty  *  SD.itemflatdisc),2)), 2)    
    		                            - Sum ( Round( SD.looseqty   * ( SD.saleprice  -  SD.itemflatdisc) * (1 - ( SD.discperc * .01)),2)) * ( SL.discperc /100)
	      									 + misccharges - flatdisc,0)
			
    			 FROM dbo.saleledger SL , 
         			dbo.saledetail SD

   			 WHERE  (SL.saleinvcode = dbo.saleledger.saleinvcode )   and
						  (SL.saleinvcode = SD.saleinvcode )   
         
				 GROUP BY SL.misccharges,   
         				 SL.flatdisc,   
         				 SL.date,   
         				 SL.saleinvcode, 
  						    SL.invgstperc1, 
							 SL.discperc,  
		   			  	 SL.salestax 
			) , */
		 totalsalestax = (SELECT invtotalsalestax= 
										 Round (
		/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( SD.looseqty * ( SD.saleprice - SD.itemflatdisc ) * (1 - SD.discperc * 0.01 ) , 2 ) )
											    * ( 1 - SL.discperc * 0.01 ) , 2 ) - SL.flatdisc ) * SL.invgstperc1 * 0.01  , 2 )
 		/*items salestax*/		 + Sum (Round ((SD.looseqty + SD.bonusqty) * SD.unitsalestax + Round ( Round (SD.looseqty * (SD.saleprice - SD.itemflatdisc ) * (1 - SD.discperc * 0.01 ), 2 ) * SD.gstperc * 0.01 , 2 ) , 2 ) )
										 , 0 )
    			 FROM dbo.saleledger SL , 
         			dbo.saledetail SD

   			 WHERE  (SL.saleinvcode = dbo.saleledger.saleinvcode )   and
						  (SL.saleinvcode = SD.saleinvcode )   
         
				 GROUP BY SL.misccharges,   
         				 SL.flatdisc,   
         				 SL.date,   
         				 SL.saleinvcode, 
  						    SL.invgstperc1, 
							 SL.discperc,  
		   			  	 SL.salestax 
			)
FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item, 
		 dbo.accounts,
		 dbo.customer,
       dbo.itemclass,
		 dbo.manufacturer

WHERE  dbo.saleledger.date Between :ad_StartDate and :ad_EndDate and
		 dbo.saleledger.salecatcode IN (:ai_saletype) and
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
		 dbo.saledetail.icode = item.icode and 
		 item.iccode = itemclass.iccode and
		 item.manfcode = manufacturer.manfcode and
		 dbo.saleledger.custcode = dbo.accounts.acccode and
	    dbo.accounts.acccode = customer.custcode
UNION ALL
SELECT saleinvcode = dbo.saleledger.saleinvcode,
		 headerno=saleledger.headerno,
		 impactinventory = dbo.saleledger.impactinventory,
		 date = dbo.saleledger.date,   
		 CustomerCategory = Customer.custcatcode,
		 saletype = (Select Name From SaleType Where SaleTypeCode = dbo.SaleLedger.SaleTypeCode) ,
		 Model = (Select Name From Model Where ModelCode IN (Select Min(ModelCode) From ItemInModel Where ItemInModel.ICode = Item.Icode ) ),
		 Colour = ItemClass.Name,
		 Manufacturer = manufacturer.name,
       invdiscperc = dbo.saleledger.discperc,    
       flatdisc = dbo.saleledger.flatdisc,    
       misccharges = dbo.saleledger.misccharges, 
       invsalestax = dbo.saleledger.salestax,
       invgstperc1 = dbo.saleledger.invgstperc1,
		 posted = dbo.saleledger.posted,	
		 rowid = sd.rowid,
		 looseqty = sd.looseqty, 
		 bonusqty = sd.bonusqty, 
       itemflatdisc=sd.itemflatdisc,
       packqty  = 0,  
       price = Round ( sd.saleprice , 0 ),    
       itemdiscperc = sd.discperc,    
		 packunits = sd.packunits,    
		 batch = sd.batch,    
		 expiry = sd.expiry,    
		 salestax  = 0.00,
	 	 itemname = item.name,
		 unitsalestax = sd.unitsalestax ,    
		 gstperc = sd.gstperc ,    
		 datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), 
		 Person = dbo.accounts.name,
		 invnettotal = Round( dbo.fn_getSaleInvTotal(dbo.saleledger.saleinvcode) , 0 ),
		 totalsalestax = (SELECT invtotalsalestax= 
										 Round (
		/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( SDD.looseqty * ( SDD.saleprice - SDD.itemflatdisc ) * (1 - SDD.discperc * 0.01 ) , 2 ) )
											    * ( 1 - SL.discperc * 0.01 ) , 2 ) - SL.flatdisc ) * SL.invgstperc1 * 0.01  , 2 )
 		/*items salestax*/		 + Sum (Round ((SDD.looseqty + SDD.bonusqty) * SDD.unitsalestax + Round ( Round (SDD.looseqty * (SDD.saleprice - SDD.itemflatdisc ) * (1 - SDD.discperc * 0.01 ), 2 ) * SDD.gstperc * 0.01 , 2 ) , 2 ) )
										 , 0 )
    			 FROM dbo.saleledger SL , 
         			dbo.saleinvdetail SDD

   			 WHERE  (SL.saleinvcode = dbo.saleledger.saleinvcode )   and
						  (SL.saleinvcode = SDD.saleinvcode )   
         
				 GROUP BY SL.misccharges,   
         				 SL.flatdisc,   
         				 SL.date,   
         				 SL.saleinvcode, 
  						    SL.invgstperc1, 
							 SL.discperc,  
		   			  	 SL.salestax 
			)
FROM 	 dbo.saleledger, 
		 dbo.saleinvdetail sd,
		 dbo.item, 
		 dbo.accounts,
		 dbo.customer,
       dbo.itemclass,
		 dbo.manufacturer

WHERE  DBO.SaleLedger.impactinventory = 'N' AND 
		 dbo.saleledger.date Between :ad_StartDate and :ad_EndDate and
		 dbo.saleledger.salecatcode IN (:ai_saletype) and
		 dbo.saleledger.saleinvcode = sd.saleinvcode and  
		 sd.icode = item.icode and 
		 item.iccode = itemclass.iccode and
		 item.manfcode = manufacturer.manfcode and
		 dbo.saleledger.custcode = dbo.accounts.acccode and
	    dbo.accounts.acccode = customer.custcode"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_saletype", numberlist))
 sort="saleinvcode A, rowid A"
)
