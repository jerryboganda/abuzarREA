table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(75) updatewhereclause=yes name=alternatecustomicode dbname="Saledetail.alternatecustomicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=itemtypecode dbname="itemtypecode"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=locksaleprice dbname="locksaleprice"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=lockdiscperc dbname="lockdiscperc"  )
column=(type=char(1) updatewhereclause=yes name=allowsaleindecimalqty dbname="AllowSaleInDecimalQty"  )
column=(type=decimal(2) updatewhereclause=yes name=recentpurprice dbname="recentpurprice"  )
column=(type=decimal(3) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=long updatewhereclause=yes name=qtysale dbname="qtysale"  )
column=(type=long updatewhereclause=yes name=bonus dbname="bonus"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=updatesaleprice dbname="updatesaleprice"  )
column=(type=long updatewhereclause=yes name=code dbname="Saledetail.saleinvcode"  )
column=(type=long updatewhereclause=yes name=icode dbname="Saledetail.icode"  )
column=(type=long updatewhereclause=yes initial="1" name=gcode dbname="Saledetail.gcode" 
 values=""  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=cloneitemflatdisc dbname="CloneItemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Item Flat Disc should be greater than zero~"" name=itemflatdisc dbname="Itemflatdisc"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=long updatewhereclause=yes initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=clonesaleprice dbname="clonesaleprice"  )
column=(type=long updatewhereclause=yes initial="0" name=pricepolicyapplied dbname="pricepolicyapplied"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=salestax dbname="salestax"  )
column=(type=char(1) updatewhereclause=yes name=due dbname="Due"  )
column=(type=datetime updatewhereclause=yes name=satisfieddate dbname="SatisfiedDate"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=dueqty dbname="DueQty"  )
column=(type=long updatewhereclause=yes initial="0" name=packqty dbname="packqty"  )
column=(type=char(100) updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=clonediscperc dbname="clonediscperc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) < 100" validationmsg="'Discount (%) must be between 0 and 100'" name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=alternatepurprice dbname="alternatepurprice"  )
column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="retailprice"  )
column=(type=long updatewhereclause=yes name=saleorderrowid dbname="saleorderrowid"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=decimal(5) updatewhereclause=yes name=packprice dbname="packprice"  )
column=(type=decimal(4) updatewhereclause=yes name=balancestock dbname="balancestock"  )
column=(type=long updatewhereclause=yes initial="0" name=taxflag dbname="taxflag"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(4) updatewhereclause=yes name=packsaleprice dbname="PackSalePrice"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=commissionperunit dbname="CommissionPerUnit"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=commissionperc dbname="CommissionPerc"  )
column=(type=decimal(4) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Bonus Quantity must be greater or Equal to zero'" initial="0" name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="'Quantity must be greater than zero'" initial="1" name=looseqty dbname="looseqty"  )
 retrieve="SELECT item.customicode,
			saledetail.alternatecustomicode,
			itemname= item.name, 
			itemtypecode = item.itemtypecode,
			currlistrow = 0,
			stock     = 0.0000, 
			totalstock= 0.0000, 
			purprice=0.00,
			locksaleprice = dbo.item.locksaleprice,
			lockdiscperc = dbo.item.lockdiscperc,
			AllowSaleInDecimalQty = dbo.item.AllowSaleInDecimalQty,
			recentpurprice=0.00,
			avgprice=0.000,
			itemtotalval=space(30),
			qtysale=item.saleqty,
			bonus=item.bonusqty,
			assgcode  = 1, 
			updatesaleprice = 'N',
         	saledetail.saleinvcode,   
         	saledetail.icode,   
         	saledetail.gcode,
			CloneItemflatdisc = max(Saledetail.cloneitemflatdisc),
			Itemflatdisc = max(Saledetail.itemflatdisc),
         	Id        = max(saledetail.IDENTITYCOL),
			packunits = max(saledetail.packunits),
	 		saleprice = max(saledetail.saleprice),
	 		clonesaleprice = max(saledetail.saleprice),
			pricepolicyapplied = 0,
	 		rate      = max(saledetail.rate),
         	salestax  = max(saledetail.salestax),  
         	Due       = max(Due),
			SatisfiedDate = max(SatisfiedDate),
			DueQty    = 0.0000,
			packqty   = sum(saledetail.packqty),
         	SaleItemDescription =  max( saledetail.SaleItemDescription),
			clonediscperc  = max(saledetail.clonediscperc),
			discperc  = max(saledetail.discperc),
			alternatepurprice = max(saledetail.alternatepurprice),
			retailprice=max(item.retailprice),
			saleorderrowid = saledetail.saleorderrowid,
			itemcode = 0,
			packprice = max(saledetail.packprice),
			balancestock=max(saledetail.balancestock),
			taxflag = 1,
			unitsalestax=max(saledetail.unitsalestax),
			gstperc=max(saledetail.gstperc),
			PackSalePrice = MAX(saledetail.PackSalePrice),
			CommissionPerUnit=Max(saledetail.commissionperunit),
			CommissionPerc=Max(saledetail.commissionperc),
			bonusqty  = sum(saledetail.bonusqty),			
			looseqty  = sum(saledetail.looseqty)

FROM 	saledetail,  item 

WHERE ( dbo.saledetail.saleinvcode = :ar_SaleInvCode )    AND
		   	( saledetail.icode = item.icode )
         
GROUP BY saledetail.saleinvcode, 
				saledetail.icode, 
				saledetail.rowgroup,
				saledetail.saleorderrowid,
				saledetail.gcode, 
				item.customicode, 
				saledetail.alternatecustomicode,
				item.saleqty,
				item.bonusqty,
				item.name,
				item.locksaleprice,
				item.lockdiscperc,
				dbo.item.AllowSaleInDecimalQty,
				item.itemtypecode

ORDER BY max(saledetail.IDENTITYCOL)"
  arguments=(("ar_SaleInvCode", number))
 sort="id A"
)
