table(column=(type=long updatewhereclause=yes name=code dbname="SaleLedger.saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleLedger.date"  )
column=(type=char(6) updatewhereclause=yes name=salecategory dbname="SaleCategory"  )
column=(type=char(100) updatewhereclause=yes name=saleledger_custrefno dbname="SaleLedger.custrefno"  )
column=(type=char(100) updatewhereclause=yes name=saleledger_remarks dbname="SaleLedger.remarks"  )
column=(type=char(60) updatewhereclause=yes name=customer_name dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=long updatewhereclause=yes name=saleledger_reprintingcounter dbname="SaleLedger.ReprintingCounter"  )
column=(type=decimal(2) updatewhereclause=yes name=totalofsalereturns dbname="totalofsalereturns"  )
column=(type=char(500) updatewhereclause=yes name=listofsalereturns dbname="listofsalereturns"  )
column=(type=char(1) updatewhereclause=yes name=fiscalized dbname="Fiscalized" 
 values="Yes	Y/No	N/"  )
column=(type=datetime updatewhereclause=yes name=fiscalizedon dbname="FiscalizedOn"  )
column=(type=char(100) updatewhereclause=yes name=fiscalinvoiceno dbname="FiscalInvoiceNo"  )
 retrieve="SELECT	
	saleledger.saleinvcode , 
	saleledger.date, 
	SaleCategory = CASE saleledger.salecatcode 
							  When 2 THEN 'Credit'
							  When 3 THEN 'Cash'
						END,
	saleledger.custrefno, 
	saleledger.remarks , 
	accounts.name,
	users.username, 
	posted = saleledger.posted,
	PostedBy = IsNull((Select username from users 
								where dbo.saleledger.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
								where dbo.saleledger.modifiedby = dbo.users.usercode), ''),
	NetAmount =max( saleledger.invtotal),
					/* Round(SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) *
						(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) + 
						saleledger.misccharges + saleledger.salestax - saleledger.flatdisc, 0)+
						Round(SUM( (saledetail.looseqty + saledetail.bonusqty) * saledetail.unitsalestax) + 
						SUM(ROUND( (saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) *
						(1 - (.01 * saledetail.discperc)) * saledetail.gstperc * .01, 2)) +
						ROUND( (SUM((saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) *
						(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) -
						saleledger.flatdisc) * (saleledger.invgstperc1 * .01), 2), 0),*/
	dbo.saleledger.ReprintingCounter,
	totalofsalereturns = dbo.saleledger.totalofsalereturns,
	listofsalereturns = dbo.saleledger.listofsrinvoices,
	Fiscalized = saleledger.Fiscalized,
	FiscalizedOn = saleledger.FiscalizedOn,
	FiscalInvoiceNo = saleledger.FiscalInvoiceNo
FROM  accounts, saleledger, saledetail, users
WHERE  	 
	( saleledger.admissioncode IS NULL ) and 
	( saleledger.custcode = accounts.acccode ) and 
	( dbo.saleledger.salecatcode IN ( :ai_SaleCatCode ) ) and
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode)   and
	( dbo.saleledger.salesmancode = dbo.users.usercode)   and
	( dbo.saleledger.date > :ad_invdate) and
	( Posted IN (:as_Posted)) AND :as_showrows = 'Y' AND
	( dbo.saleledger.HeaderNo IS NULL OR
		(dbo.saleledger.HeaderNo IN 
			(SELECT HeaderCode FROM GroupAllowedHeader 
			WHERE GroupCode=:ai_groupcode AND Module=:ai_Module))) AND
	 ( dbo.saleledger.impactinventory = 'Y' )
GROUP BY 
	saleledger.SALEINVCODE,
	saleledger.CustCode,
	saleledger.salecatcode,
	saleledger.DiscPerc,
	saleledger.MiscCharges,
	saleledger.SalesTax,
	saleledger.FlatDisc,
	saleledger.DiscPerc,
	saleledger.FlatDisc,
	saleledger.InvGSTPerc1,
	saleledger.date , 
	saleledger.custrefno, 
	accounts.name,
	saleledger.posted, 
	saleledger.postedby,
	saleledger.modifiedby,
	users.username,
	dbo.saleledger.ReprintingCounter, 
	dbo.saleledger.totalofsalereturns,
	dbo.saleledger.listofsrinvoices,
	saleledger.remarks,
	saleledger.Fiscalized,
	saleledger.FiscalizedOn,
	saleledger.FiscalInvoiceNo
"
  arguments=(("ai_SaleCatCode", numberlist), ("as_Posted", stringlist), ("ad_invdate", datetime), ("as_showrows", string), ("ai_groupcode", number), ("ai_module", number))
 sort="code A"
)
