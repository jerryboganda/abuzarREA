column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=long updatewhereclause=yes name=code dbname="ServiceOHeader.serviceOcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ServiceOHeader.date"  )
column=(type=long updatewhereclause=yes name=headerno dbname="ServiceOHeader.headerno"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceoheader_discperc dbname="ServiceOHeader.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="ServiceOHeader.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="ServiceOHeader.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceinvgstperc dbname="ServiceOHeader.ServiceInvGSTPerc"  )
column=(type=long updatewhereclause=yes name=serviceoheader_custcode dbname="ServiceOHeader.custcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ServiceOHeader.remarks"  )
column=(type=char(100) updatewhereclause=yes name=reference1 dbname="reference1"  )
column=(type=char(100) updatewhereclause=yes name=reference2 dbname="reference2"  )
column=(type=long updatewhereclause=yes name=service_servicecode dbname="Service.servicecode"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="serviceflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflattax dbname="ServiceFlatTax"  )
column=(type=decimal(2) updatewhereclause=yes name=servicegstperc dbname="ServiceGSTPerc"  )
column=(type=datetime updatewhereclause=yes name=servicedate dbname="servicedate"  )
column=(type=decimal(2) updatewhereclause=yes name=advance dbname="advance"  )
column=(type=decimal(2) updatewhereclause=yes name=invadvance dbname="invadvance"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="servicedetail_discperc"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="ServiceOHeader.PatientCode"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="ServiceOHeader.AdmissionCode"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=reference dbname="Reference"  )
column=(type=char(60) updatewhereclause=yes name=patientunit dbname="PatientUnit"  )
column=(type=char(60) updatewhereclause=yes name=patientrank dbname="PatientRank"  )
column=(type=datetime updatewhereclause=yes name=operationdate dbname="Operationdate"  )
column=(type=datetime updatewhereclause=yes name=dischargedate dbname="DischargeDate"  )
column=(type=char(100) updatewhereclause=yes name=patientrefby dbname="PatientRefBy"  )
 retrieve="SELECT 
	Grouping=1,
	IssueReqInvCode =NULL,
	itemname = service.name,
	users.username,  
	accounts.name, 
	address = Customer.Address1,
	Phone = Customer.Phone,
	dbo.serviceoheader.serviceOcode,   
	dbo.serviceOheader.date,  
	dbo.serviceOheader.headerno, 
	dbo.serviceOheader.discperc,  
	dbo.serviceOheader.flatdisc,	 
	dbo.serviceOheader.misccharges,   
	dbo.serviceOheader.ServiceInvGSTPerc,   
	dbo.serviceOheader.custcode,   
	dbo.serviceOheader.remarks,
	reference1=dbo.serviceOheader.reference1,
	reference2=dbo.serviceOheader.reference2,
	dbo.service.servicecode,   
	price = dbo.serviceOdetail.price, 
	serviceflatdisc = dbo.serviceOdetail.serviceflatdisc, 
	Qty = dbo.serviceOdetail.qty,
	ServiceFlatTax = dbo.serviceOdetail.ServiceFlatTax,
	ServiceGSTPerc = dbo.serviceOdetail.ServiceGSTPerc,
	servicedate = dbo.serviceOdetail.date,
	advance = dbo.serviceodetail.cashreceived,
	invadvance = dbo.serviceoheader.cashreceived,
	servicedetail_discperc = dbo.serviceOdetail.discperc, 
	customername='                                  ',
	dbo.serviceOheader.PatientCode,
	dbo.serviceOheader.AdmissionCode,
	Patient=(SELECT Patient.Name FROM Patient WHERE ServiceOHeader.PatientCode = Patient.PatientCode),
	RegNo=(SELECT Patient.Regno FROM Patient WHERE ServiceOHeader.PatientCode = Patient.PatientCode),
	Reference=(SELECT Patient.Reference FROM Patient WHERE ServiceOHeader.PatientCode = Patient.PatientCode),
	PatientUnit=(SELECT Unit.Name FROM Patient , Unit WHERE ServiceOHeader.PatientCode = Patient.PatientCode AND Patient.UnitCode = Unit.UnitCode),
	PatientRank=(SELECT Rank.Name FROM Patient , Rank WHERE ServiceOHeader.PatientCode = Patient.PatientCode AND Patient.RankCode = Rank.RankCode),
	Operationdate=dbo.serviceOheader.Operationdate,
	DischargeDate=dbo.serviceOheader.DischargeDate,
	PatientRefBy=dbo.serviceOheader.PatientRefBy
FROM 
	dbo.serviceOheader,   
	dbo.serviceOdetail,  
	service, 
	customer, 
	accounts,
	users
WHERE 
	( dbo.serviceOheader.serviceOcode = :ra_InvCode ) AND
	( dbo.serviceOheader.serviceOcode = dbo.serviceOdetail.serviceOcode ) AND 
	( dbo.serviceOheader.custcode = dbo.customer.custcode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( dbo.serviceOheader.salesmancode = dbo.users.usercode ) AND
	( serviceOdetail.servicecode = service.servicecode )
"
  arguments=(("ra_InvCode", number))
 sort="grouping A, service A"
)
