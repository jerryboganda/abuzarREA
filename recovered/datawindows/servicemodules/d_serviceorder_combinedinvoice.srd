table(column=(type=long updatewhereclause=yes name=grouping dbname="Grouping"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvcode"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=char(25) updatewhereclause=yes name=invoiceno dbname="InvoiceNo"  )
column=(type=char(60) updatewhereclause=yes name=service dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=long updatewhereclause=yes name=code dbname="ServiceOHeader.serviceOcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ServiceOHeader.date"  )
column=(type=long updatewhereclause=yes name=headerno dbname="ServiceOHeader.headerno"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceoheader_discperc dbname="ServiceOHeader.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="ServiceOHeader.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="ServiceOHeader.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceinvgstperc dbname="ServiceOHeader.ServiceInvGSTPerc"  )
column=(type=long updatewhereclause=yes name=serviceoheader_custcode dbname="ServiceOHeader.custcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ServiceOHeader.remarks"  )
column=(type=char(100) updatewhereclause=yes name=reference1 dbname="reference1"  )
column=(type=char(100) updatewhereclause=yes name=reference2 dbname="reference2"  )
column=(type=char(100) updatewhereclause=yes name=fullpatientname dbname="fullpatientname"  )
column=(type=char(60) updatewhereclause=yes name=patientage dbname="patientage"  )
column=(type=long updatewhereclause=yes name=service_servicecode dbname="servicecode"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="serviceflatdisc"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflattax dbname="ServiceFlatTax"  )
column=(type=decimal(2) updatewhereclause=yes name=servicegstperc dbname="ServiceGSTPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="servicedetail_discperc"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
column=(type=char(50) updatewhereclause=yes name=strn dbname="STRN"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="ServiceOHeader.PatientCode"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="ServiceOHeader.AdmissionCode"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=reference dbname="Reference"  )
column=(type=char(60) updatewhereclause=yes name=patientunit dbname="PatientUnit"  )
column=(type=char(60) updatewhereclause=yes name=patientrank dbname="PatientRank"  )
column=(type=datetime updatewhereclause=yes name=operationdate dbname="Operationdate"  )
column=(type=datetime updatewhereclause=yes name=dischargedate dbname="DischargeDate"  )
column=(type=char(100) updatewhereclause=yes name=patientrefby dbname="PatientRefBy"  )
column=(type=char(1) updatewhereclause=yes name=claimable dbname="Claimable" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) updatewhereclause=yes name=claimablediscperc dbname="ClaimableDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=whtaxamt dbname="WHTaxAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=otherdeductions dbname="OtherDeductions"  )
column=(type=decimal(2) updatewhereclause=yes name=receiptamt dbname="ReceiptAmt"  )
 retrieve="SELECT 
	Grouping=1,
	ServiceInvcode = serviceoheader.ServiceInvCode,
	SaleInvCode = serviceoheader.SaleInvCode,
	InvoiceNo = ISNULL(LTRIM(RTRIM(STR(serviceoheader.ServiceInvCode,  12))), '') + ISNULL('-' + LTRIM(RTRIM(STR(serviceoheader.SaleInvCode, 12))), ''),
	itemname = Item.name,
	users.username,
	accounts.name,
 	address = Customer.Address1,
	Phone = Customer.Phone,
	dbo.serviceOheader.serviceOcode,
  	dbo.serviceOheader.date,
  	dbo.serviceOheader.headerno,
	dbo.serviceOheader.discperc,
	dbo.serviceOheader.flatdisc,
	dbo.serviceOheader.misccharges,
	dbo.serviceOheader.ServiceInvGSTPerc,
	dbo.serviceOheader.custcode,
	dbo.serviceOheader.remarks,
	reference1=dbo.serviceOheader.reference1,
	reference2=dbo.serviceOheader.reference2,
	fullpatientname=dbo.serviceOheader.fullpatientname,
	patientage=dbo.serviceOheader.patientage,
	servicecode=dbo.item.icode,
	price = SD.Saleprice,
	serviceflatdisc = SD.Itemflatdisc,
	Qty = SD.Looseqty,
	ServiceFlatTax = SD.UnitSalesTax,
	ServiceGSTPerc = SD.GSTPerc,
	servicedetail_discperc = SD.discperc,
	customername='                                  ',
	NTN = Customer.NTNNo,
	STRN = Customer.SalesTaxRegNo,
	dbo.serviceOheader.PatientCode,
	dbo.serviceOheader.AdmissionCode,
	Patient=(SELECT Patient.Name FROM Patient WHERE ServiceOHeader.PatientCode = Patient.PatientCode),
	RegNo=(SELECT Patient.Regno FROM Patient WHERE ServiceOHeader.PatientCode = Patient.PatientCode),
	Reference=(SELECT Patient.Reference FROM Patient WHERE ServiceOHeader.PatientCode = Patient.PatientCode),
	PatientUnit=(SELECT Unit.Name FROM Patient, Unit WHERE ServiceOHeader.PatientCode = Patient.PatientCode AND Patient.UnitCode = Unit.UnitCode),
	PatientRank=(SELECT Rank.Name FROM Patient, Rank WHERE ServiceOHeader.PatientCode = Patient.PatientCode AND Patient.RankCode = Rank.RankCode),
	Operationdate=dbo.serviceOheader.Operationdate,
	DischargeDate=dbo.serviceOheader.DischargeDate,
	PatientRefBy=dbo.serviceOheader.PatientRefBy,
	Claimable = SD.Claimable,
	ClaimableDiscPerc = SD.ClaimableDiscPerc,
	WHTaxAmt = ISNULL((SELECT SUM(SOR.WHTaxAmt) FROM SOReceipt SOR WHERE SOR.ServiceOCode = :ra_InvCode), 0),
	OtherDeductions = ISNULL((SELECT SUM( ISNULL(SOR.Deduction1,0) + ISNULL(SOR.Deduction2,0) + ISNULL(SOR.Deduction3,0) + ISNULL(SOR.Deduction4,0) + ISNULL(SOR.Deduction5,0)) FROM SOReceipt SOR WHERE SOR.ServiceOCode = :ra_InvCode), 0),
	ReceiptAmt = ISNULL((SELECT SUM( ISNULL(SOR.ReceiptAmt,0)) FROM SOReceipt SOR WHERE SOR.ServiceOCode = :ra_InvCode), 0)
FROM 
	dbo.serviceOheader,
	dbo.SaleLedger SH,
	dbo.SaleInvDetail SD,
	item,
	customer,
	accounts,
	users
WHERE 
	( dbo.serviceOheader.serviceOcode = :ra_InvCode ) AND
	( SH.SaleInvCode = dbo.serviceOheader.SaleInvCode ) AND 
	( SH.custcode = dbo.customer.custcode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( SH.salesmancode = dbo.users.usercode ) AND
	( SH.saleinvcode = SD.saleinvcode ) AND 
	( SD.ICode = Item.ICode )
UNION ALL
SELECT 
	Grouping=2,
	ServiceInvcode = SO.ServiceInvCode,
	SaleInvCode = SO.SaleInvCode,
	InvoiceNo = ISNULL(LTRIM(RTRIM(STR(SO.ServiceInvCode, 12))), '') + ISNULL('-' + LTRIM(RTRIM(STR(SO.SaleInvCode, 12))), ''),
	itemname = service.name,
	users.username,
	accounts.name,
	address = Customer.Address1,
	Phone = Customer.Phone,
	serviceOcode=SH.serviceOcode,
	date=SH.date,
	headerno=SH.headerno,
	Invdiscperc=SH.discperc,
	flatdisc=SH.flatdisc,
	misccharges=SH.misccharges,
	ServiceInvGSTPerc=SH.ServiceInvGSTPerc,
	CustCode=SH.custcode,
	remarks=SH.remarks,
	reference1=SH.ref1,
	reference2=SH.ref2,
	fullpatientname=SH.fullpatientname,
	patientage=SH.patientage,
	dbo.service.servicecode,
	price = SD.price,
	serviceflatdisc = SD.serviceflatdisc,
	Qty = SD.qty,
	ServiceFlatTax = SD.ServiceFlatTax,
	ServiceGSTPerc = SD.ServiceGSTPerc,
	servicedetail_discperc = SD.discperc,
	customername='                                  ',
	NTN = Customer.NTNNo,
	STRN = Customer.SalesTaxRegNo,
	PatientCode=SH.PatientCode,
	AdmissionCode=SH.AdmissionCode,
	Patient=(SELECT Patient.Name FROM Patient WHERE SH.PatientCode = Patient.PatientCode),
	RegNo=(SELECT Patient.Regno FROM Patient WHERE SH.PatientCode = Patient.PatientCode),
	Reference=(SELECT Patient.Reference FROM Patient WHERE SH.PatientCode = Patient.PatientCode),
	PatientUnit=(SELECT Unit.Name FROM Patient, Unit WHERE SH.PatientCode = Patient.PatientCode AND Patient.UnitCode = Unit.UnitCode),
	PatientRank=(SELECT Rank.Name FROM Patient, Rank WHERE SH.PatientCode = Patient.PatientCode AND Patient.RankCode = Rank.RankCode),
	Operationdate=SO.Operationdate,
	DischargeDate=SO.DischargeDate,
	PatientRefBy=SH.PatientRefBy,
	Claimable = 'N',
	ClaimableDiscPerc = 0.00,
	WHTaxAmt = ISNULL((SELECT SUM(SOR.WHTaxAmt) FROM SOReceipt SOR WHERE SOR.ServiceOCode = :ra_InvCode), 0),
	OtherDeductions = ISNULL((SELECT SUM( ISNULL(SOR.Deduction1,0) + ISNULL(SOR.Deduction2,0) + ISNULL(SOR.Deduction3,0) + ISNULL(SOR.Deduction4,0) + ISNULL(SOR.Deduction5,0)) FROM SOReceipt SOR WHERE SOR.ServiceOCode = :ra_InvCode), 0),
	ReceiptAmt = ISNULL((SELECT SUM( ISNULL(SOR.ReceiptAmt,0)) FROM SOReceipt SOR WHERE SOR.ServiceOCode = :ra_InvCode), 0)
FROM 
	(SELECT * FROM dbo.serviceOheader WHERE dbo.serviceOheader.serviceOcode = :ra_InvCode) SO,
	DBO.ServiceHeader SH,
	dbo.serviceDetail SD,
	service,
	customer,
	accounts,
	users
WHERE 
	( SH.serviceOcode = SO.serviceOcode ) AND 
	( SH.custcode = dbo.customer.custcode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( SH.salesmancode = dbo.users.usercode ) AND
	( SH.serviceinvcode = SD.serviceinvcode  ) AND 
	( SD.servicecode = service.servicecode )
"
  arguments=(("ra_InvCode", number))
 sort="grouping A, service A"
)
