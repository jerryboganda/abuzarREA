table(column=(type=long updatewhereclause=yes name=code dbname="ServiceOHeader.serviceocode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ServiceOHeader.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="ServiceOHeader.posted"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ServiceOHeader.remarks"  )
column=(type=long updatewhereclause=yes name=acccode dbname="acccode"  )
column=(type=char(60) updatewhereclause=yes name=customer_name dbname="Accounts.name"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(1) updatewhereclause=yes name=cancelled dbname="cancelled" 
 values="Yes	Y/No	N/"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="patientcode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(100) updatewhereclause=yes name=status dbname="Status"  )
column=(type=char(25) updatewhereclause=yes name=invoiceno dbname="InvoiceNo"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=decimal(2) updatewhereclause=yes name=estamt dbname="NetAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=receiptamt dbname="ReceiptAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=advance dbname="Advance"  )
 retrieve="SELECT  
	serviceoheader.serviceocode , 
	serviceoheader.date , 
	serviceoheader.posted, 	
	serviceoheader.remarks , 
	acccode = accounts.acccode,
	accounts.name,
	posted = serviceoheader.posted,
	cancelled = serviceoheader.cancelled,
	patientcode = serviceoheader.PatientCode,
	RegNo = (SELECT P.Regno FROM Patient P WHERE P.PatientCode=serviceoheader.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode=serviceoheader.PatientCode),
	Status=(SELECT SS.Name FROM ServiceOrderStatus SS WHERE SS.ServiceOrderStatusCode = serviceoheader.ServiceOrderStatusCode),
	InvoiceNo = ISNULL(LTRIM(RTRIM(STR(serviceoheader.ServiceInvCode, 12))), '') + ISNULL('-' + LTRIM(RTRIM(STR(serviceoheader.SaleInvCode, 12))), ''),
	PostedBy = IsNull((Select username from users 
				where dbo.serviceoheader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
				where dbo.serviceoheader.modifiedby = dbo.users.usercode), ''),
	NetAmt = 
		ISNULL((SELECT NetAmt=Round(SUM(D.Qty * (D.Price - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01)) - H.FlatDisc + H.MiscCharges, 0) + 
			Round(
			Sum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01* D.servicegstPerc ) 			+
			Sum(D.qty * D.serviceflattax ) +
			Round((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc )*0.01*H.serviceinvgstperc,2), 0)
		FROM ServiceODetail D, ServiceOHeader H 
		WHERE H.ServiceOCode = serviceoheader.ServiceOCode AND H.ServiceOCode = D.ServiceOCode
		GROUP BY H.ServiceOCode, H.FlatDisc, H.MiscCharges, H.serviceinvgstperc), 0) + 
		CASE WHEN (SELECT COUNT(IH.IssueInvCode) FROM IssueHeader IH WHERE IH.ServiceOCode = serviceoheader.ServiceOCode) > 0 THEN
			ISNULL((SELECT NetAmt=SUM(D.Qty * D.Price)
				FROM IssueDetail D, IssueHeader H 
				WHERE H.ServiceOCode = serviceoheader.ServiceOCode AND H.IssueInvCode = D.IssueInvCode), 0)
		ELSE
			ISNULL((SELECT NetAmt=SUM(D.Qty * D.SalePrice)
				FROM IssueReqDetail D, IssueReqHeader H 
				WHERE H.ServiceOCode = serviceoheader.ServiceOCode AND H.IssueReqInvCode = D.IssueReqInvCode), 0)
		END,
	ReceiptAmt = ISNULL((SELECT SUM(R.ReceiptAmt) FROM SOReceipt R WHERE ServiceOCode = serviceoheader.ServiceOCode), 0),
	Advance=ISNULL((SELECT Adv=SUM(D.CashReceived) + H.CashReceived FROM ServiceODetail D, ServiceOHeader H WHERE H.ServiceOCode = serviceoheader.ServiceOCode AND H.ServiceOCode = D.ServiceOCode GROUP BY H.ServiceOCode, H.CashReceived), 0)
FROM  
	accounts , 
	serviceoheader
WHERE  
	serviceOheader.custcode = accounts.acccode
Order By 
	serviceocode desc"
 )
