table(column=(type=long identity=yes updatewhereclause=yes name=srvorowid dbname="ServiceODetail.srvorowid"  )
column=(type=long updatewhereclause=yes name=serviceoheader_serviceocode dbname="ServiceOHeader.serviceocode"  )
column=(type=datetime updatewhereclause=yes name=serviceorderdate dbname="ServiceOHeader.date"  )
column=(type=char(1) updatewhereclause=yes name=chkbox dbname="chkboxno" 
 values="	Y/	N"  )
column=(type=char(1) updatewhereclause=yes name=servicestatus dbname="ServiceODetail.ServiceStatus" 
 values="	Y/	N"  )
column=(type=char(1) updatewhereclause=yes name=cancelstatus dbname="ServiceODetail.CancelStatus" 
 values="	Y/	N"  )
column=(type=long updatewhereclause=yes name=custcode dbname="ServiceOHeader.CustCode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Accounts.Name"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Customer.Phone"  )
column=(type=char(60) updatewhereclause=yes name=service dbname="service"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=char(60) updatewhereclause=yes name=shift dbname="Shift"  )
column=(type=char(60) updatewhereclause=yes name=timeslot dbname="TimeSlot"  )
column=(type=decimal(2) updatewhereclause=yes validation="Integer ( GetText() ) >= 0" name=saleprice dbname="ServiceODetail.price"  )
column=(type=decimal(2) updatewhereclause=yes validation="real ( GetText() ) >= 0" initial="0" name=serviceflatdisc dbname="serviceflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes validation="real ( GetText() ) > 0" initial="1" name=qty dbname="ServiceODetail.qty"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real ( GetText() ) >= 0" initial="0" name=discperc dbname="ServiceODetail.discperc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real ( GetText() ) >= 0" initial="0" name=cashreceived dbname="ServiceODetail.cashreceived"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode" 
 values=""  )
 retrieve="SELECT 	serviceodetail.srvorowid, 
			serviceoheader.serviceocode,
			serviceoheader.date,
		   chkboxno = 'N', 
			ServiceODetail.ServiceStatus,
			ServiceODetail.CancelStatus,
			ServiceOHeader.CustCode,
			Accounts.Name,
			Customer.Phone,
			service = service.name, 
			SalesPerson = SalesMan.Name,
			Shift = Shift.Name,
			TimeSlot = TimeSlot.Name,
			serviceOdetail.price,
			serviceflatdisc = dbo.serviceodetail.serviceflatdisc,
			ServiceOdetail.qty,
	   	ServiceOdetail.discperc,
			ServiceOdetail.cashreceived,
			PatientCode=CASE ServiceOHeader.AdmissionCode 
							WHEN NULL THEN ServiceOHeader.PatientCode 
							ELSE (SELECT PatientAdmission.PatientCode FROM PatientAdmission 
									WHERE PatientAdmission.Admissioncode=ServiceOHeader.AdmissionCode) 
							END
FROM
	ServiceOHeader, 
	ServiceODetail LEFT OUTER JOIN SalesMan ON (ServiceODetail.smancode = SalesMan.SalesManCode), 
	Accounts, Customer, TimeSlot, Shift, 
	Service 
WHERE
	ServiceOHeader.ServiceOCode = ServiceODetail.ServiceOCode AND
	ServiceOdetail.date >= :adt_startdate  AND
	ServiceOdetail.date <= :adt_enddate  AND 
	ServiceOHeader.CustCode = Accounts.AccCode AND
	Accounts.AccCode = Customer.CustCode AND
	ServiceODetail.TSCode = TimeSlot.TSCode AND
	ServiceODetail.ShiftCode = Shift.ShiftCode AND	
	ServiceODetail.ServiceCode = Service.ServiceCode "
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="serviceorderdate A, customer A, service A, shift A, timeslot A"
)
