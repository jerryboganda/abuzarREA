release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=68 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=servicecode dbname="ServiceCode"  )
column=(type=char(60) updatewhereclause=yes name=service dbname="Service"  )
column=(type=long updatewhereclause=yes name=smancode dbname="ServiceODetail.smancode"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="ServiceODetail.qty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="ServiceODetail.price"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="ServiceODetail.ServiceFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="ServiceODetail.discperc"  )
column=(type=long identity=yes updatewhereclause=yes name=srvorowid dbname="ServiceODetail.SrvORowId"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="ServiceOHeader.AdmissionCode"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="ServiceOHeader.PatientCode"  )
 retrieve="SELECT 
	ServiceCode = ServiceOdetail.servicecode,
	Service = service.name, 
	ServiceODetail.smancode,
	ServiceODetail.qty,
	ServiceODetail.price,
	ServiceODetail.ServiceFlatDisc,
	ServiceODetail.discperc,
	ServiceODetail.SrvORowId,
	ServiceOHeader.AdmissionCode,
	ServiceOHeader.PatientCode
FROM 
	ServiceODetail, Service, ServiceOHeader
WHERE 
	ServiceODetail.SrvORowId = :ai_SrvORowId  AND
	ServiceOHeader.ServiceOCode = ServiceODetail.ServiceOCode AND
	ServiceODetail.ServiceCode = Service.ServiceCode
	
	
	
	
	
	
"
  arguments=(("ai_SrvORowId", number))
)
