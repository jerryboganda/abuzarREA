table(column=(type=long updatewhereclause=yes name=accounts_acccode dbname="Accounts.acccode"  )
column=(type=long updatewhereclause=yes name=accounts_subcode dbname="Accounts.subcode"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=datetime updatewhereclause=yes name=accounts_openingdate dbname="Accounts.openingdate"  )
column=(type=long updatewhereclause=yes name=customer_custcode dbname="Customer.custcode"  )
column=(type=long updatewhereclause=yes name=customer_custcatcode dbname="Customer.custcatcode"  )
column=(type=long updatewhereclause=yes initial="1" name=customer_areacode dbname="Customer.areacode"  )
column=(type=char(60) updatewhereclause=yes initial="." name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes initial="." name=city dbname="Customer.city"  )
column=(type=char(100) updatewhereclause=yes initial="." name=phone dbname="Customer.phone"  )
column=(type=char(1) updatewhereclause=yes initial="Y" name=newcustomer dbname="newcustomer" 
 values="New	Y/New	N"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceOHeader.serviceOcode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=date dbname="ServiceOHeader.date"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ServiceOHeader.remarks"  )
column=(type=long update=yes updatewhereclause=yes initial="22" name=custcode dbname="ServiceOHeader.custcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=salesmancode dbname="ServiceOHeader.salesmancode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=headerno dbname="ServiceOHeader.headerno" 
 values=""  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discperc dbname="ServiceOHeader.discperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=flatdisc dbname="ServiceOHeader.flatdisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=misccharges dbname="ServiceOHeader.misccharges"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="ServiceOHeader.posted"  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=postdate dbname="ServiceOHeader.postdate"  )
column=(type=long updatewhereclause=yes name=customerbalance dbname="customerbalance"  )
column=(type=char(1) updatewhereclause=yes name=debitorcredit dbname="debitorcredit"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="patientRegNo"  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=originaldate dbname="ServiceOHeader.originaldate"  )
column=(type=long update=yes updatewhereclause=yes name=modifiedby dbname="ServiceOHeader.modifiedby"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="ServiceOHeader.postedby"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=cashreceived dbname="ServiceOHeader.cashreceived"  )
column=(type=long update=yes updatewhereclause=yes name=doctcode dbname="ServiceOHeader.doctcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="ServiceOHeader.patientcode" 
 values=""  )
 retrieve="  SELECT   accounts.acccode, 
			  accounts.subcode , 
           accounts.name , 
           aliasname = accounts.aliasname,
			  accounts.openingdate ,
           customer.custcode ,
			  customer.custcatcode ,
           customer.areacode,
           address = customer.address1 ,
  			  customer.city ,
           customer.phone ,
			 newcustomer = 'Y',
          serviceOheader.serviceOcode , 
          serviceOheader.date , 
          serviceOheader.remarks , 
          serviceOheader.custcode , 
          serviceOheader.salesmancode ,
			 serviceOheader.headerno,  
          users.username , 
          serviceOheader.discperc , 
          serviceOheader.flatdisc , 
          serviceOheader.misccharges , 
          serviceOheader.posted , 
          serviceOheader.postdate , 
			 customerbalance = 0,
			 debitorcredit = ' ',
          patientRegNo=(SELECT Patient.Regno FROM Patient WHERE Patient.PatientCode = serviceOheader.patientcode),
			 serviceOheader.originaldate,
			 serviceOheader.modifiedby,
			 serviceOheader.postedby,
			 serviceOheader.cashreceived,
          serviceOheader.doctcode,
			 serviceOheader.patientcode

    FROM  customer , 
  			 serviceOheader, 
          users , 
          accounts  
   
   WHERE ( serviceOheader.custcode = customer.custcode ) and 
         ( users.usercode = serviceOheader.salesmancode ) and 
         ( serviceOheader.custcode = accounts.acccode ) and 
         ( ( dbo.serviceOheader.serviceOcode = :ar_SaleInvCode ) )   "
  update="serviceOheader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_SaleInvCode", number))
)
