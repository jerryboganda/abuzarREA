summary(height=0 color="536870912" )
footer(height=67 color="536870912" )
detail(height=67 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceODetail.serviceocode"  )
column=(type=long key=yes updatewhereclause=yes name=srvorowid dbname="ServiceODetail.srvorowid"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="ServiceODetail.servicecode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long update=yes updatewhereclause=yes name=smancode dbname="ServiceODetail.smancode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=date dbname="ServiceODetail.date"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=shiftcode dbname="ServiceODetail.shiftcode" 
 values=""  )
column=(type=char(60) updatewhereclause=yes name=ddtscode dbname="DDTsCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=tscode dbname="ServiceODetail.tscode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" name=saleprice dbname="ServiceODetail.price"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" initial="0" name=serviceflatdisc dbname="ServiceODetail.serviceflatdisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" initial="0" name=serviceflattax dbname="ServiceODetail.ServiceFlatTax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0 AND Real ( GetText() ) <= 100" initial="0" name=servicegstperc dbname="ServiceODetail.ServiceGSTPerc"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=allowsaleindecimal dbname="allowsaleindecimal"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real ( GetText() ) > 0" initial="1" name=qty dbname="ServiceODetail.qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" initial="0" name=discperc dbname="ServiceODetail.discperc"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=cancelstatus dbname="ServiceODetail.cancelstatus" 
 values="	Y/	N"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" initial="0" name=cashreceived dbname="ServiceODetail.cashreceived"  )
 retrieve="SELECT 
	FullCode=service.aliasname,
	serviceodetail.serviceocode,
	serviceodetail.srvorowid,
	itemcode = serviceodetail.serviceocode,
	serviceodetail.servicecode,
	itemname= service.name, 
	currlistrow = 0,
	ServiceOdetail.smancode,
	ServiceOdetail.date,
	ServiceOdetail.shiftcode,
	DDTsCode = TimeSlot.Name,
	ServiceOdetail.tscode,
	serviceOdetail.price,
	serviceOdetail.serviceflatdisc,
	serviceOdetail.ServiceFlatTax,
	serviceOdetail.ServiceGSTPerc,
	allowsaleindecimal=service.allowsaleindecimal,
	ServiceOdetail.qty,
	ServiceOdetail.discperc,
	ServiceOdetail.cancelstatus,
	ServiceOdetail.cashreceived
FROM 
	serviceOdetail, service, TimeSlot
WHERE 
	( serviceOdetail.serviceOcode = :ar_ServiceOrderCode )    AND
	( serviceOdetail.servicecode = service.servicecode ) AND
	( ServiceOdetail.tscode = TimeSlot.tscode ) 

         




"
  update="serviceOdetail" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_ServiceOrderCode", number))
)
