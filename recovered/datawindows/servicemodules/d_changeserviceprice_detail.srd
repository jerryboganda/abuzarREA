table(column=(type=long key=yes update=yes updatewhereclause=yes name=servicecode dbname="Service.ServiceCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Service.Name"  )
column=(type=char(60) update=yes updatewhereclause=yes name=aliasname dbname="Service.AliasName"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="~"Please enter valid sale price for service~"" initial="0" name=price dbname="Service.Price"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=servicecatcode dbname="Service.ServiceCatCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="~"Please enter valid commission for service~"" initial="0" name=commission dbname="Service.Commission"  )
column=(type=char(100) update=yes updatewhereclause=yes name=description dbname="Service.Description"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="~"Please enter valid cost price for service~"" initial="0" name=costprice dbname="Service.CostPrice"  )
column=(type=long update=yes updatewhereclause=yes validation="Integer ( GetText() ) >= 0" validationmsg="~"Please enter valid processing days for service~"" initial="0" name=processdays dbname="Service.ProcessDays"  )
column=(type=long update=yes updatewhereclause=yes validation="Integer ( GetText() ) >= 0" validationmsg="~"Please enter valid processing hours for service~"" initial="0" name=processhours dbname="Service.ProcessHours"  )
column=(type=long update=yes updatewhereclause=yes validation="Integer ( GetText() ) >= 0" validationmsg="~"Please enter valid processing minutes for service~"" initial="0" name=processmin dbname="Service.ProcessMin"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=resultrequired dbname="Service.ResultRequired" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=printonnewpage dbname="Service.PrintOnNewPage" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=serviceresulttemplate dbname="Service.ServiceResultTemplate"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=printable dbname="Service.Printable" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=ticketrequired dbname="Service.TicketRequired" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=servicepricepolicycode dbname="Service.ServicePricePolicyCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=serviceresultstylecode dbname="Service.ServiceResultStyleCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=serviceflatdisc dbname="Service.ServiceFlatDisc"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=allowsaleindecimal dbname="Service.AllowSaleInDecimal" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=servicetypecode dbname="Service.ServiceTypeCode" 
 values=""  )
 retrieve="SELECT 
	Service.ServiceCode,   
	Service.Name,   
	Service.AliasName,
	Service.Price,   
	Service.ServiceCatCode,
	Service.Commission,
	Service.Description,
	Service.CostPrice,
	Service.ProcessDays,
	Service.ProcessHours,
	Service.ProcessMin,
	Service.ResultRequired,
	Service.PrintOnNewPage,
	Service.ServiceResultTemplate,
	Service.Printable,
	Service.TicketRequired,
	Service.ServicePricePolicyCode,
	Service.ServiceResultStyleCode,
	Service.ServiceFlatDisc,
	Service.AllowSaleInDecimal,
	Service.ServiceTypeCode
FROM 
	Service   
Where 
	Service.ServiceCatCode = :ar_Code
ORDER BY
	Service.Name"
  update="Service" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_Code", number))
)
