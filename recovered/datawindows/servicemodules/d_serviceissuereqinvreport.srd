header(height=1583 color="536870912" )
summary(height=283 color="536870912" )
footer(height=8 color="536870912" )
detail(height=183 color="536870912" )
table(column=(type=char(73) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(40) updatewhereclause=yes name=department dbname="department"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=long updatewhereclause=yes name=code dbname="code"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="accountname"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=deptcode dbname="ServiceIssueRequest.deptcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ServiceIssueRequest.remarks"  )
column=(type=long updatewhereclause=yes name=qty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=processcharge dbname="processcharge"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="itempacking"  )
column=(type=long updatewhereclause=yes name=servicerowid dbname="ServiceRowId"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="ROWId"  )
 retrieve="SELECT 
	ServiceName = (SELECT S.Name + ' (' + LTRIM(RTRIM(STR(SD.SrvRowID,10))) + ')' 
		FROM Service S, ServiceDetail SD 
		WHERE SD.SrvRowID = ServiceIssueRequestDetail.ServiceRowID AND 
			S.ServiceCode = SD.ServiceCode),
	itemname= item.name, 
	department = dbo.department.name, 
	salesman = users.username, 
	Area = (SELECT A.name FROM Area A WHERE A.AreaCode = dbo.ServiceIssueRequest.AreaCode),
	SalesPerson = (SELECT S.name FROM SalesMan S WHERE S.SalesManCode = dbo.ServiceIssueRequest.SMANCode),
	code = dbo.ServiceIssueRequest.ServiceIssueRequestcode, 
	accountname=(SELECT A.name FROM Accounts A WHERE A.AccCode = dbo.ServiceIssueRequest.AccCode),
	date = dbo.ServiceIssueRequest.date,   
	dbo.ServiceIssueRequest.deptcode,
	dbo.ServiceIssueRequest.remarks,	 
	looseqty = ServiceIssueRequestDetail.qty,
	processcharge = ServiceIssueRequestDetail.processcharge,
	itempacking = itempacking.name,
	ServiceRowId= ServiceIssueRequestDetail.ServiceRowID,
	ROWId       = dbo.ServiceIssueRequestDetail.IDENTITYCOL
FROM 
	ServiceIssueRequest, 
	ServiceIssueRequestDetail,
	users, 
	item
	LEFT OUTER JOIN itempacking ON (dbo.item.packcode = dbo.itempacking.packcode),
	department
WHERE 
	( dbo.ServiceIssueRequest.ServiceIssueRequestCode = :ar_code ) AND
	( dbo.ServiceIssueRequest.ServiceIssueRequestcode = dbo.ServiceIssueRequestDetail.ServiceIssueRequestcode) AND
	( dbo.ServiceIssueRequest.deptcode = dbo.department.deptcode ) AND 
	( dbo.ServiceIssueRequest.salesmancode = users.usercode ) AND 
	( dbo.ServiceIssueRequestDetail.icode = dbo.item.icode)
ORDER BY
	ServiceRowID, 
	RowID"
  arguments=(("ar_Code", number))
)
