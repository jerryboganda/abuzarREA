table(column=(type=long updatewhereclause=yes name=code dbname="ServiceIssueRequest.ServiceIssueRequestcode"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ServiceIssueRequest.date"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ServiceIssueRequest.remarks"  )
column=(type=char(40) updatewhereclause=yes name=department dbname="Department"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
 retrieve="SELECT  
	ServiceIssueRequest.ServiceIssueRequestcode , 
	ServiceInvCode=ServiceIssueRequest.ServiceInvCode,
	ServiceIssueRequest.date , 
	ServiceIssueRequest.remarks , 
	Department = (SELECT D.Name FROM Department D WHERE D.DeptCode = ServiceIssueRequest.DeptCode), 
	Area = (SELECT A.Name FROM Area A WHERE A.AreaCode = ServiceIssueRequest.AreaCode), 
	SalesPerson = (SELECT S.Name FROM SalesMan S WHERE S.SalesmanCode = ServiceIssueRequest.SManCode), 
	AccountName = (SELECT A.Name FROM Accounts A WHERE A.AccCode = ServiceIssueRequest.AccCode), 
	dbo.users.username,
	posted = ServiceIssueRequest.posted,
	PostedBy = IsNull((Select username from users 
				where dbo.ServiceIssueRequest.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
				where dbo.ServiceIssueRequest.modifiedby = dbo.users.usercode), '') 
FROM  
	users,
	ServiceIssueRequest
WHERE  
	dbo.ServiceIssueRequest.salesmancode = dbo.users.usercode"
 )
