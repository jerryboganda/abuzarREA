footer(height=0 color="536870912" )
detail(height=1596 color="536870912" )
table(column=(type=long updatewhereclause=yes name=serviceticketcode dbname="ServiceTicket.ServiceTicketCode"  )
column=(type=long updatewhereclause=yes name=serviceticketno dbname="ServiceTicketNO"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ServiceTicket.Date"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceTicket.ServiceInvCode"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="ServiceTicket.ServiceCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=servicecatcode dbname="ServiceCatCode" 
 values=""  )
column=(type=char(1) updatewhereclause=yes initial="N" name=ticketused dbname="ServiceTicket.TicketUsed" 
 values="Yes	Y/No	N/"  )
column=(type=datetime updatewhereclause=yes name=ticketusedon dbname="ServiceTicket.TicketUsedOn"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode"  )
column=(type=datetime updatewhereclause=yes name=expireson dbname="ServiceTicket.ExpiresOn"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=price dbname="ServiceTicket.Price"  )
column=(type=char(1) updatewhereclause=yes name=visible dbname="Visible"  )
 retrieve="SELECT 
	ServiceTicket.ServiceTicketCode,   
	ServiceTicketNO = ServiceTicket.ServiceTicketCode,   
	ServiceTicket.Date,   
	ServiceTicket.ServiceInvCode,   
	ServiceTicket.ServiceCode,   
	ServiceCatCode=Service.ServiceCatCode,
	ServiceTicket.TicketUsed,   
	ServiceTicket.TicketUsedOn,   
	UserCode=ServiceTicket.UserCode,
	ServiceTicket.ExpiresOn,   
	ServiceTicket.Price,
	Visible='N'
FROM 
	ServiceTicket,   
	Service,   
	ServiceCategory  
 WHERE 
	ServiceTicket.ServiceTicketCode = :ai_code AND
	ServiceTicket.TicketUsed = 'N' AND
	ServiceTicket.ExpiresOn >= GETDATE() AND
	ServiceTicket.ServiceCode = Service.ServiceCode AND
	Service.ServiceCatCode = ServiceCategory.ServiceCatCode
"
  arguments=(("ai_code", number))
)
