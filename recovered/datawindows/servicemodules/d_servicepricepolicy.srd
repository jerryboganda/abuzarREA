column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ServicePricePolicy.Remarks"  )
 retrieve="  SELECT ServicePricePolicy.ServicePricePolicyCode,   
         ServicePricePolicy.Name,   
         ServicePricePolicy.ServiceCode,   
         ServicePricePolicy.StartDate,   
         ServicePricePolicy.EndDate,   
         ServicePricePolicy.Remarks  
    FROM ServicePricePolicy  
   WHERE ServicePricePolicy.ServicePricePolicyCode = :ai_code   
            
"
  update="ServicePricePolicy" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
