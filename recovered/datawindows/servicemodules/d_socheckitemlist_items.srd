footer(height=0 color="536870912" )
detail(height=70 color="536870912"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=checklistitemcode dbname="CheckListItemCode"  )
column=(type=char(100) updatewhereclause=yes name=checklistitem dbname="CheckListItem"  )
column=(type=long updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=char(100) updatewhereclause=yes name=description dbname="Description"  )
column=(type=long identity=yes updatewhereclause=yes name=sochecklistitem_rowid dbname="SOCheckListItem.ROWID"  )
 retrieve="SELECT 
	Code=SOCheckListItem.ServiceOCode,   
	CheckListItemCode=SOCheckListItem.CheckListItemCode,   
	CheckListItem=CheckListItem.NAME,
	Qty= SOCheckListItem.Qty,   
	Description=SOCheckListItem.Description,   
	SOCheckListItem.ROWID
FROM 
	SOCheckListItem, CheckListItem  
WHERE 
	SOCheckListItem.ServiceOCode = :ai_code AND
	CheckListItem.CheckListItemCode = SOCheckListItem.CheckListItemCode
ORDER BY
	SOCheckListItem.ROWID"
  arguments=(("ai_code", number))
)
