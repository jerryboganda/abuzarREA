header(height=74 color="536870912" )
summary(height=0 color="536870912" )
footer(height=67 color="536870912" )
detail(height=67 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=updatesaleprice dbname="updatesaleprice"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceIssueRequestDetail.serviceissuerequestcode"  )
column=(type=char(73) updatewhereclause=yes name=service dbname="Service"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=servicerowid dbname="servicerowid"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Process charge can not be -ve~"" initial="0" name=processcharge dbname="processcharge"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) > 0" validationmsg="~"Quantity should be greater than zero~"" initial="1" name=qty dbname="qty"  )
 retrieve="SELECT 
	item.customicode, 
	itemname= item.name, 
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= 0.0000, 
	assgcode  = 1, 
	updatesaleprice = 'N',
	serviceissuerequestdetail.serviceissuerequestcode, 
	Service = (SELECT S.Name + ' (' + LTRIM(RTRIM(STR(serviceissuerequestdetail.servicerowid, 10))) + ')' FROM Service S, ServiceDetail SD WHERE SD.SrvRowID = serviceissuerequestdetail.servicerowid AND SD.ServiceCode = S.ServiceCode),
	servicerowid = serviceissuerequestdetail.servicerowid,
	icode = serviceissuerequestdetail.icode,   
	RowID=serviceissuerequestdetail.RowID,
	processcharge = serviceissuerequestdetail.processcharge,
	itemcode = 0,
	qty  = serviceissuerequestdetail.qty
FROM 
	serviceissuerequestdetail, item 
WHERE 
	( dbo.serviceissuerequestdetail.serviceissuerequestcode = :ar_Code )    AND
	( serviceissuerequestdetail.icode = item.icode )
ORDER BY
	serviceissuerequestdetail.RowID"
  update="serviceissuerequestdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_Code", number))
 sort="servicerowid A, rowid A"
)
