 values=""  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discperc dbname="ServiceOHeader.discperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=flatdisc dbname="ServiceOHeader.flatdisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=misccharges dbname="ServiceOHeader.misccharges"  )
