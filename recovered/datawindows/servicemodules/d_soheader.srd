table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceOHeader.serviceOcode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=date dbname="ServiceOHeader.date"  )
