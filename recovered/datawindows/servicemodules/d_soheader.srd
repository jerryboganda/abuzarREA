column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=postdate dbname="ServiceOHeader.postdate"  )
column=(type=long updatewhereclause=yes name=customerbalance dbname="customerbalance"  )
column=(type=char(1) updatewhereclause=yes name=debitorcredit dbname="debitorcredit"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="patientRegNo"  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=originaldate dbname="ServiceOHeader.originaldate"  )
column=(type=long update=yes updatewhereclause=yes name=modifiedby dbname="ServiceOHeader.modifiedby"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="ServiceOHeader.postedby"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=cashreceived dbname="ServiceOHeader.cashreceived"  )
column=(type=long update=yes updatewhereclause=yes name=doctcode dbname="ServiceOHeader.doctcode"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="ServiceOHeader.patientcode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=reference1 dbname="ServiceOHeader.Reference1"  )
column=(type=char(100) update=yes updatewhereclause=yes name=reference2 dbname="ServiceOHeader.Reference2"  )
column=(type=char(100) update=yes updatewhereclause=yes name=reference3 dbname="ServiceOHeader.Reference3"  )
column=(type=char(100) update=yes updatewhereclause=yes name=reference4 dbname="ServiceOHeader.Reference4"  )
column=(type=char(100) update=yes updatewhereclause=yes name=reference5 dbname="ServiceOHeader.Reference5"  )
 retrieve="SELECT   
	serviceOheader.serviceOcode , 
	serviceOheader.date , 
	serviceOheader.remarks , 
	aliasname = accounts.aliasname,
	serviceOheader.custcode , 
	serviceOheader.salesmancode ,
	serviceOheader.headerno,  
	users.username , 
	serviceOheader.discperc , 
	serviceOheader.flatdisc , 
	serviceOheader.misccharges , 
	serviceOheader.posted , 
	serviceOheader.postdate , 
	customerbalance = 0,
	debitorcredit = ' ',
	patientRegNo=(SELECT Patient.Regno FROM Patient WHERE Patient.PatientCode = serviceOheader.patientcode),
	serviceOheader.originaldate,
	serviceOheader.modifiedby,
	serviceOheader.postedby,
	serviceOheader.cashreceived,
	serviceOheader.doctcode,
	serviceOheader.patientcode,
	serviceOheader.Reference1,
	serviceOheader.Reference2,
	serviceOheader.Reference3,
	serviceOheader.Reference4,
	serviceOheader.Reference5
FROM  
	customer , 
	serviceOheader, 
	users , 
	accounts  
WHERE 
	serviceOheader.custcode = customer.custcode and 
	users.usercode = serviceOheader.salesmancode and 
	serviceOheader.custcode = accounts.acccode and 
	dbo.serviceOheader.serviceOcode = :ar_SaleInvCode"
  update="serviceOheader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_SaleInvCode", number))
)
