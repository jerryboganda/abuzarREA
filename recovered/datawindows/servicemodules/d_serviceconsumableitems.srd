footer(height=0 color="536870912" )
detail(height=86 color="536870912" )
table(column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="ServiceCode"  )
column=(type=long identity=yes updatewhereclause=yes name=servicerowid dbname="ServiceRowID"  )
column=(type=char(73) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=decimal(2) updatewhereclause=yes name=processcharge dbname="ProcessCharge"  )
 retrieve="SELECT 
	ServiceInvCode = SD.ServiceInvCode, 
	ServiceCode = SD.ServiceCode, 
	ServiceRowID = SD.SrvRowID, 
	ServiceName = (SELECT S.Name + ' (' + LTRIM(RTRIM(STR(SD.SrvRowID,10))) + ')' FROM Service S WHERE S.ServiceCode = SD.ServiceCode),
	ICode = SCI.ICode, 
	Qty = SCI.Qty, 
	RowID=SCI.RowID,
	ProcessCharge = SCI.ProcessCharge
FROM ServiceHeader SH, ServiceDetail SD, ServiceConsumableItem SCI
WHERE 
	SH.ServiceInvCode = :ai_code AND 
	SH.Posted='Y' AND 
	SH.ServiceInvCode = SD.ServiceInvCode AND
	SD.ServiceCode = SCI.ServiceCode
ORDER BY
	ServiceRowID,
	RowID"
  arguments=(("ai_code", number))
)
