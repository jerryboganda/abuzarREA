compute(name=c_invdiscount visible="1	if( srledger_discperc = 0, 0, 1)" band=summary font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="3583" y="302" height="145" width="489" format="[general]" expression="Round(Sum(c_amount) *  srledger_discperc  * .01 , 2)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
