release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=1000 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1447 color="536870912" )
summary(height=1114 color="536870912" )
footer(height=0 color="536870912" )
detail(height=322 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long updatewhereclause=yes name=srledger_srinvcode dbname="SRLedger.srinvcode"  )
column=(type=long updatewhereclause=yes name=srledger_saleinvcode dbname="SRLedger.saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=srledger_date dbname="SRLedger.date"  )
column=(type=decimal(2) updatewhereclause=yes name=srledger_discperc dbname="SRLedger.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=srledger_misccharges dbname="SRLedger.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=srledger_flatdisc dbname="SRLedger.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=srledger_salestax dbname="SRLedger.salestax"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SRLedger.remarks"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(2) updatewhereclause=yes name=srdetail_srprice dbname="srprice"  )
column=(type=decimal(2) updatewhereclause=yes name=srdetail_discperc dbname="discperc"  )
 retrieve="  SELECT itemname= item.name,
			dbo.users.username,
			dbo.srledger.srinvcode,   
			dbo.srledger.saleinvcode, 
         dbo.srledger.date,   
         dbo.srledger.discperc,   
         dbo.srledger.misccharges,   
         dbo.srledger.flatdisc,   
         dbo.srledger.salestax,   
         dbo.srledger.remarks,   
         looseqty = Max(dbo.srdetail.looseqty),   
         packqty  = Max(dbo.srdetail.packqty),   
         icode = Max(dbo.srdetail.icode),   
         srprice = Max(dbo.srdetail.srprice),   
         discperc = Max(dbo.srdetail.discperc) 

    FROM dbo.srledger,   
         dbo.srdetail,  
         dbo.item,
			dbo.users 

   WHERE ( dbo.srledger.srinvcode = :ra_InvCode ) AND 
			( dbo.srledger.srinvcode = dbo.srdetail.srinvcode) AND 
			( dbo.srledger.salesmancode = dbo.users.usercode) AND 
			( srdetail.icode = item.icode ) 
         
GROUP BY dbo.srledger.srinvcode, 
			dbo.srledger.saleinvcode, 
			dbo.srledger.date, 
			dbo.srledger.discperc, 
			dbo.srledger.flatdisc, 
			dbo.srledger.misccharges, 
			dbo.srledger.salestax, 
			dbo.srledger.remarks, 
			dbo.item.name,
			dbo.users.username"
  arguments=(("ra_InvCode", number))
)
