column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="invsalestax"  )
column=(type=long updatewhereclause=yes name=custcode dbname="SRBufferLedger.custcode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="godown"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=saledetail_expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=itemgstperc dbname="itemgstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
 retrieve="SELECT
			itemname= item.name, 
			packingdesc=item.packingdesc,
			accname = dbo.accounts.name, 
			aliasname = dbo.accounts.aliasname, 
			address = dbo.customer.address1,
			address2=dbo.customer.address2,
			posted=srbufferledger.posted,
			custcity=dbo.customer.city,
			custphone=customer.phone,
			salesperson=(select name from salesman where salesman.salesmancode=srbufferledger.smancode),
			areaname=(select name from area where area.areacode=customer.areacode),
			salesman = dbo.users.username, 
			srbufferinvcode = dbo.srbufferledger.srbufferinvcode,   
			saleinvcode = dbo.srbufferledger.saleinvcode,   
         date = dbo.srbufferledger.date,   
         invdiscperc = dbo.srbufferledger.discperc,   
         misccharges = dbo.srbufferledger.misccharges,   
         flatdisc = dbo.srbufferledger.flatdisc,   
         invsalestax = dbo.srbufferledger.salestax,   
         dbo.srbufferledger.custcode, 
         gcode = srbufferdetail.gcode,
		godown=(select name from godown where godown.gcode=srbufferdetail.gcode),   
         icode = srbufferdetail.icode,   
         batch = srbufferdetail.batch,   
         expiry = srbufferdetail.expiry,   
			looseqty = srbufferdetail.looseqty,
			packqty  = srbufferdetail.packqty,
			bonusqty = srbufferdetail.bonusqty,
			packunits= srbufferdetail.packunits,
	 		saleprice= srbufferdetail.srprice,
	 		discperc = srbufferdetail.discperc,
         salestax = srbufferdetail.salestax ,
			unitsalestax=srbufferdetail.unitsalestax,
			itemgstperc=srbufferdetail.gstperc,
			invgstperc=srbufferledger.invgstperc1,
			remarks=srbufferledger.remarks,
			headerno = srbufferledger.headerno,
			headerinvno = srbufferledger.headerinvNo

    FROM srbufferledger, 
			srbufferdetail, 
			accounts, 
			customer,
			users, 
			item  
 
   WHERE ( dbo.srbufferledger.srbufferinvcode = :ar_srbufferinvcode ) AND
			( dbo.srbufferledger.srbufferinvcode = dbo.srbufferdetail.srbufferinvcode) AND
			( dbo.srbufferledger.custcode = dbo.accounts.acccode ) AND 
			( dbo.customer.custcode = dbo.accounts.acccode ) AND 
			( dbo.srbufferledger.salesmancode = dbo.users.usercode ) AND 
			( dbo.srbufferdetail.icode = dbo.item.icode)
"
  arguments=(("ar_SRBufferInvCode", number))
)
