footer(height=10 color="536870912" )
detail(height=145 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=char(60) updatewhereclause=yes name=caccname dbname="accname"  )
column=(type=long updatewhereclause=yes name=srcatcode dbname="srcatcode"  )
column=(type=long updatewhereclause=yes name=code dbname="code"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=datetime updatewhereclause=yes name=date_1 dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=srledger_salestax dbname="salestax"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(2) updatewhereclause=yes name=srprice dbname="srprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=itemgstperc dbname="itemgstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
 retrieve="SELECT
	itemname= item.name, 
	dbo.users.username, 
	accname = accounts.name, 
	srcatcode = dbo.srbufferledger.srcatcode,
	code = dbo.srbufferledger.srbufferinvcode,   
	saleinvcode = dbo.srbufferledger.saleinvcode, 
	salesperson=(SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = SRBufferLedger.SManCode),
	date = dbo.srbufferledger.date,   
	invdiscperc = dbo.srbufferledger.discperc,   
	misccharges = dbo.srbufferledger.misccharges,   
	flatdisc = dbo.srbufferledger.flatdisc,   
	salestax = dbo.srbufferledger.salestax,   
	remarks = dbo.srbufferledger.remarks,   
	looseqty = Sum(dbo.srbufferdetail.looseqty),   
	packqty  = Sum(dbo.srbufferdetail.packqty),   
	icode = Max(dbo.srbufferdetail.icode),   
	srprice = Max(dbo.srbufferdetail.srprice),   
	discperc = Max(dbo.srbufferdetail.discperc) ,
	headerno = Max(srbufferledger.headerno),
	unitsalestax=max(srbufferdetail.unitsalestax),
	itemgstperc=max(srbufferdetail.gstperc),
	invgstperc=max(srbufferledger.invgstperc1)
	
FROM 
	dbo.srbufferledger,   
	dbo.srbufferdetail,  
	customer, 
	accounts, 
	item,
	users 
	
WHERE 
	( dbo.srbufferledger.srbufferinvcode= :ra_InvCode ) AND 
	( dbo.srbufferledger.srbufferinvcode= dbo.srbufferdetail.srbufferinvcode) AND 
	( dbo.srbufferledger.custcode = dbo.customer.custcode) AND 
	( dbo.customer.custcode = dbo.accounts.acccode) AND 
	( dbo.srbufferledger.salesmancode = dbo.users.usercode) AND 
	( srbufferdetail.icode = item.icode ) 
	
GROUP BY 
	dbo.srbufferledger.srbufferinvcode, 
	dbo.srbufferledger.saleinvcode, 
	dbo.srbufferledger.date, 
	dbo.srbufferledger.srcatcode, 
	dbo.srbufferledger.discperc, 
	dbo.srbufferledger.flatdisc, 
	dbo.srbufferledger.misccharges, 
	dbo.srbufferledger.salestax, 
	dbo.srbufferledger.remarks, 
	dbo.item.name, 
	dbo.accounts.name, 
	dbo.srbufferledger.smancode,
	dbo.users.username"
  arguments=(("ra_InvCode", number))
)
