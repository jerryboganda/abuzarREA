release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2937 color="536870912" )
summary(height=2666 color="536870912" )
footer(height=10 color="536870912" )
detail(height=156 color="536870912"  height.autosize=yes)
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=char(60) updatewhereclause=yes name=caccname dbname="accname"  )
column=(type=long updatewhereclause=yes name=srbufferledger_srbufferinvcode dbname="SRBufferLedger.srbufferinvcode"  )
column=(type=long updatewhereclause=yes name=srbufferledger_saleinvcode dbname="SRBufferLedger.saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SRBufferLedger.date"  )
column=(type=decimal(2) updatewhereclause=yes name=srdetail_discperc dbname="SRBufferLedger.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=srledger_misccharges dbname="SRBufferLedger.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=srledger_flatdisc dbname="SRBufferLedger.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=srledger_salestax dbname="SRBufferLedger.salestax"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SRBufferLedger.remarks"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(2) updatewhereclause=yes name=srdetail_srprice dbname="srprice"  )
column=(type=decimal(2) updatewhereclause=yes name=srledger_discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=itemgstperc dbname="itemgstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=long updatewhereclause=yes name=rowid dbname="rowid"  )
 retrieve="SELECT
	itemname= item.name, 
	headerno=max(srledger.headerno),
	 users.username,  
	accname = accounts.name, 
	 srledger.srbufferinvcode,   
	 srledger.saleinvcode, 
	 srledger.date,   
	 srledger.discperc,   
	 srledger.misccharges,   
	 srledger.flatdisc,   
	 srledger.salestax,   
	 srledger.remarks,   
	looseqty = Sum( srdetail.looseqty),   
	packqty  = Sum( srdetail.packqty),   
	icode = Max( srdetail.icode),   
	srprice = Max( srdetail.srprice),   
	discperc = Max( srdetail.discperc) ,
	unitsalestax=max(srdetail.unitsalestax),
	itemgstperc=max(srdetail.gstperc),
	invgstperc=max(srledger.invgstperc1),
	
	rowid = MAX(srdetail.rowid)
FROM 
	 srbufferledger srledger,   
	 srbufferdetail srdetail,  
	customer, 
	accounts, 
	item,
	users 
WHERE 
	(  srledger.srbufferinvcode= :ra_InvCode ) AND 
	(  srledger.srbufferinvcode=  srdetail.srbufferinvcode) AND 
	(  srledger.custcode =  customer.custcode) AND 
	(  customer.custcode =  accounts.acccode) AND 
	(  srledger.salesmancode =  users.usercode) AND 
	( srdetail.icode = item.icode ) 
GROUP BY 
	 srledger.srbufferinvcode, 
	 srledger.saleinvcode, 
	 srledger.date, 
	 srledger.discperc, 
	 srledger.flatdisc, 
	 srledger.misccharges, 
	 srledger.salestax, 
	 srledger.remarks, 
	 item.name, 
	 accounts.name, 
	 users.username
ORDER BY
	RowID"
  arguments=(("ra_InvCode", number))
)
