detail(height=229 color="536870912" )
table(column=(type=char(88) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="area"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(12) updatewhereclause=yes name=accaliasname dbname="accaliasname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(30) updatewhereclause=yes name=custdruglicno dbname="custdruglicno"  )
column=(type=datetime updatewhereclause=yes name=custdrugexp dbname="custdrugexp"  )
column=(type=char(60) updatewhereclause=yes name=sman dbname="sman"  )
column=(type=long updatewhereclause=yes name=srbufferinvcode dbname="srbufferinvcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="invsalestax"  )
column=(type=long updatewhereclause=yes name=salecatcode dbname="salecatcode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=long updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="salestax"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="balance"  )
column=(type=decimal(2) updatewhereclause=yes name=amt dbname="amt"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(50) updatewhereclause=yes name=custtaxregno dbname="custTaxRegno"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="SRBufferLedger.custrefno"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SRBufferLedger.remarks"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(46) updatewhereclause=yes name=lastsalerecord dbname="LastSaleRecord"  )
column=(type=char(53) updatewhereclause=yes name=lastvouchrecord dbname="LastVouchRecord"  )
 retrieve="   SELECT itemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END, 
         aliasname=item.customicode, 
         packingdesc=item.packingdesc, 
		area=(select name from area  where area.areacode=customer.areacode),
         accname =  accounts.name,   
		accaliasname=accounts.aliasname,
         address =  customer.address1,   
         address2=  customer.address2,   
         salesman =  users.username,  
		custdruglicno=customer.licenceno,
		custdrugexp=customer.licenceexpiry,
		sman=(select name from salesman where salesman.salesmancode=saleledger.smancode), 
         srbufferinvcode =  saleledger.srbufferinvcode,   
         headerno =  saleledger.headerno,   
         date =  saleledger.date,
         invdiscperc =  saleledger.discperc,   
         misccharges =  saleledger.misccharges,   
         flatdisc =  saleledger.flatdisc,   
         invsalestax =  saleledger.salestax,   
			salecatcode =  saleledger.srcatcode,
         gcode = saledetail.gcode,   
         icode = saledetail.icode,   
         batch = saledetail.batch,   
         expiry = saledetail.expiry,   
         looseqty = saledetail.looseqty,   
         bonusqty = saledetail.bonusqty,   
         packqty = saledetail.packqty,   
         packunits= saledetail.packunits,   
         saleprice= saledetail.saleprice,   
         discperc = saledetail.discperc,  
			itemflatdisc=0,   
         salestax = saledetail.salestax,   
         Id =  saledetail.IDENTITYCOL,   
         posted=saleledger.posted,   
         balance=ISNULL(saleledger.outstandingamt, 0), 
		amt=saleledger.amt,  
		
         unitsalestax = saledetail.unitsalestax,   
         gstperc = saledetail.gstperc,   
         invgstperc = saleledger.invgstperc1,   
         custTaxRegno=customer.salestaxregno  ,
			 saleledger.custrefno,	
			 saleledger.remarks,
			
			custcode=saleledger.custcode,
			LastSaleRecord=
		(SELECT 'Last Est. No.: '+ RTRIM(LTRIM(STR(SS.HeaderInvNo))) + ' Amount: ' + RTRIM(LTRIM(STR(SS.InvTotal, 12, 2))) 
		FROM SaleLedger SS 
		WHERE SS.srbufferinvcode IN 
			(SELECT MAX(S.srbufferinvcode) 
			FROM saleledger s 
			WHERE S.srbufferinvcode < :ar_srbufferinvcode AND 
				s.custcode = saleledger.custcode)),
		LastVouchRecord=
								(SELECT '  L.C. No.: '+ RTRIM(LTRIM(GG.ChkNo)) + ' Amount: ' + RTRIM(LTRIM(STR(GG.Credit, 12, 2))) 
								FROM GLDetail GG 
								WHERE GG.GLRowID IN 
									(SELECT MAX(GD.GLRowID) 
									FROM GlDetail GD, GlHeader G
									WHERE
										G.Date <= (saleledger.date) AND 
										G.VochCatCode=2 AND 
										G.Posted = 'Y' AND
										GD.AccCode = saleledger.CustCode AND 
										G.GlVochCode = GD.GLVochCode))
			
			

    FROM srbufferledger saleledger,   
         srbufferdetail saledetail,   
         accounts,   
         customer,   
         users,   
         item  

   WHERE (  saleledger.srbufferinvcode = :ar_srbufferinvcode ) AND  
         (  saleledger.srbufferinvcode =  saledetail.srbufferinvcode) AND  
         (  saleledger.custcode =  accounts.acccode ) AND  
         (  customer.custcode =  accounts.acccode ) AND  
         (  saleledger.salesmancode =  users.usercode ) AND  
         (  saledetail.icode =  item.icode)    

ORDER BY /* item.customicode,*/
			 saledetail.srbufferinvcode,
			 saledetail.IDENTITYCOL"
  arguments=(("ar_srbufferinvcode", number))
)
