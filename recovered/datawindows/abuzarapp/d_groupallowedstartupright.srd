release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=134217752 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=rightcode dbname="RightCode"  )
column=(type=char(1) updatewhereclause=yes name=righttype dbname="RightType"  )
column=(type=char(255) updatewhereclause=yes name=rightname dbname="RightName"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(100) updatewhereclause=yes name=objectname dbname="ObjectName"  )
column=(type=char(100) updatewhereclause=yes name=details dbname="Details"  )
column=(type=char(255) updatewhereclause=yes name=information dbname="Information"  )
column=(type=char(1) updatewhereclause=yes name=allowed dbname="Allowed"  )
 retrieve="SELECT 
	RightCode = StartupRight.RightCode,
	RightType = StartupRight.RightType,
	RightName = StartupRight.RightName,   
	GroupCode = GroupAllowedStartupRight.GroupCode,   
	ObjectName= StartupRight.ObjectName, 
	Details   = GroupAllowedStartupRight.Details,
	Information = SPACE(255),
	Allowed   = StartupRight.Allowed
FROM 
	GroupAllowedStartupRight,   
	StartupRight  
WHERE
	StartupRight.RightCode = GroupAllowedStartupRight.RightCode AND
	GroupAllowedStartupRight.GroupCode = :al_groupcode AND  
	StartupRight.Allowed = 'Y'
ORDER BY 
	RightType,
	StartupRight.RightName
"
  arguments=(("al_groupcode", number))
)
group(level=1 header.height=76 trailer.height=0 by=("righttype"  ) header.color="536870912" trailer.color="536870912" )
