 retrieve="SELECT
	UserId,
	ShowPurchaseTypeInPurchase,
	ShowPurchaseOrderInPurchase,
	ShowAccountForinPurchase,
	PurchaseAccountFor,
	VisiblePorB,
	PurInvPageSize,
	PurSuppbalance,
	HeaderOnPurchaseInv,
	PurUserWindow,
	PurchaseAutoPosting,
	PurBatch,
	PurExpiry,
	BonusInPurchase,
	PurItemDescription,
	PackingDescinPurchase,
	SalePriceInPackPur,
	UpdateSalePriceForItem,
	UpdatePurPrice,
	UpdatePurDisc,
	PriceInLoosePur,
	PurchaseOnZeroprice,
	ShowPurInvGSTPerc,
	ShowPurItemGSTPerc,
	ShowPurItemUnitTax,
	PurReplaceitemSaledisc,
	PurReplaceitemSalediscNo,
	PurPrice2InAdvPur,
	PurPrice3InAdvPur,
	PurPrice4InAdvPur,
	TotPurPriceInAdvPur,
	ItemFlatDiscInAdvPur,
	UnitTaxRuleCodeInAdvPur,
	DefaultUnitTaxRuleInAdvPur,
	GSTRuleCodeInAdvPur,
	DefaultGSTRuleInAdvPur,
	ItemFlatDisc2InAdvPur,
	DiscPerc2InAdvPur,
	FlatDisc2InAdvPur,
	MiscCharges2InAdvPur,
	AutoCreatePurInvoiceFromAdvPur,
	AutoPostPurInvoiceFromAdvPur,
	ItmFlatDisAftDisPrcInAdvPur,
	ValueDiscOnItemInAdvPur,
	OverwriteBatchOnPurPosting,
	PurSlipSize,
	ShowNetRateInPurchase,
	ShowMeasuringUnitInAdvPur,
	ShowGSTTypeInAdvPur,
	AutoDueSatisfyOnPurPost,
	FormatForAmtInPur,
	ForceUniqueSuppInvNoInPur,
	IncPurInActMonitor,
	ShowPODisparityOnPurSaving,
	UpdRPPOnLoosePurPosting,
	AcceptFutureExpiryDays
FROM Preferences
"
  update="Preferences" updatewhere=1 updatekeyinplace=yes
 )
