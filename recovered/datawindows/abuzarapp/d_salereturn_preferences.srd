	UserId ,
	HeaderOnSaleReturnInv,
	SaleReturnAccountFor,
	ShowAccountForinSaleReturn,
	SaleReturnPageSize,
	PackingDescinSaleReturn,
	AutoSaleReturnAllocation,
	AutoPostSaleReturnAllocation,
	SaleRetItemDescription,
