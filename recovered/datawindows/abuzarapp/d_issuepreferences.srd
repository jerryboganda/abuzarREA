	ShowUnitWeightInIssue,
	ShowPackingFactorInIssue,
	UnitWeightCaptionInIssue,
	PackingFactorCaptionInIssue,
	PrintStoreSummWithIssue,
	IssueTerms1,
	IssueTerms2
