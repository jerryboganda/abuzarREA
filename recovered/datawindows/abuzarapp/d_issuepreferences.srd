	Preferences.UserId,
	Preferences.Issueposting,
	Preferences.HeaderOnIssueInv,
	SalesPersonInIssue,
	IssueTypeInIssue,
	SectionInIssue,
	AreaInIssue,
	IssuePriceInPrint,
	ShowAmtInIssueInv,
