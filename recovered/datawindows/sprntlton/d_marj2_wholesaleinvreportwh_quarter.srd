table(column=(type=char(88) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(255) updatewhereclause=yes name=localitemname dbname="localitemname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="customeralias"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(60) updatewhereclause=yes name=customercity dbname="customercity"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(60) updatewhereclause=yes name=sman dbname="sman"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="invsalestax"  )
column=(type=long updatewhereclause=yes name=salecatcode dbname="salecatcode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="salestax"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=decimal(5) updatewhereclause=yes name=balance dbname="balance"  )
column=(type=decimal(2) updatewhereclause=yes name=amt dbname="amt"  )
column=(type=char(1) updatewhereclause=yes name=printbalance dbname="printbalance"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(50) updatewhereclause=yes name=custtaxregno dbname="custTaxRegno"  )
column=(type=char(30) updatewhereclause=yes name=saleledger_custrefno dbname="custrefno"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SaleLedger.remarks"  )
column=(type=char(1) updatewhereclause=yes name=printwaranty dbname="printwaranty"  )
column=(type=char(1) updatewhereclause=yes name=printbatch dbname="printbatch"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(50) updatewhereclause=yes name=messages dbname="messages"  )
 retrieve="SELECT
		itemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END, 
         aliasname=item.customicode,   
		localitemname=item.localitemname,
         packingdesc=max(item.packingdesc), 
         accname = max(dbo.accounts.name),   
		customeralias=max(accounts.aliasname),
         address = max(dbo.customer.address1),   
         address2= max(dbo.customer.address2), 
		customercity=max(customer.city),  
         salesman = dbo.users.username,   
		sman=(select Name from salesman where salesman.salesmancode=max(saleledger.smancode)),
         saleinvcode = dbo.saleledger.saleinvcode,   
         headerno = dbo.saleledger.headerno,   
         date = dbo.saleledger.date,
         invdiscperc = dbo.saleledger.discperc,   
         misccharges = dbo.saleledger.misccharges,   
         flatdisc = dbo.saleledger.flatdisc,   
         invsalestax = dbo.saleledger.salestax,   
			salecatcode =max( dbo.saleledger.salecatcode),
         gcode = saledetail.gcode,   
         icode = saledetail.icode,   
         batch = max(saledetail.batch),   
         expiry = min(saledetail.expiry),   
         looseqty = sum(saledetail.looseqty),   
         bonusqty = sum(saledetail.bonusqty),   
         packqty = sum(saledetail.packqty),   
         packunits= max(saledetail.packunits),   
         saleprice= max(saledetail.saleprice),   
         discperc = max(saledetail.discperc),  
			itemflatdisc=max(saledetail.itemflatdisc),   
         salestax = max(saledetail.salestax),   
         Id =min( dbo.saledetail.IDENTITYCOL),   
         posted=max(saleledger.posted),   
         balance=ISNULL(max(saleledger.balance), 0), 
		amt=max(saleledger.amt),  
		printbalance=max(saleledger.printbalance),
         unitsalestax = max(saledetail.unitsalestax),   
         gstperc = max(saledetail.gstperc),   
         invgstperc = max(saleledger.invgstperc1),   
         custTaxRegno=max(customer.salestaxregno)  ,
			custrefno=max(dbo.saleledger.custrefno),	
			dbo.saleledger.remarks,
			printwaranty=max(dbo.saleledger.printwaranty),
			printbatch=max(dbo.saleledger.printbatch),
			custcode=saleledger.custcode,
			
			messages=(select description from message where messagecode=max(saleledger.messagecode))

    FROM saleledger,   
         saledetail,   
         accounts,   
         customer,   
         users,   
         item  

   WHERE
/*		 ( dbo.saleledger.Posted='Y' ) AND*/
		 ( dbo.saleledger.saleinvcode = :ar_SaleInvCode ) AND  
         ( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND  
         ( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  
         ( dbo.customer.custcode = dbo.accounts.acccode ) AND  
         ( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  
         ( dbo.saledetail.icode = dbo.item.icode)    

GROUP BY saleledger.saleinvcode, 
			saleledger.date, 
			saleledger.custcode, 
			saleledger.discperc, 
			saleledger.flatdisc, 
			saleledger.misccharges, 
			saleledger.headerno,
			saleledger.salestax, 
			saleledger.remarks, 
			saledetail.icode, 
			saledetail.rowgroup,
			/*saledetail.saleprice,
			saledetail.itemflatdisc,
			saledetail.discperc,
			saledetail.gstperc,
			saledetail.unitsalestax,*/

			saledetail.gcode, 
			item.name,
			item.localitemname,
			item.icode,
			item.printable,
			item.customicode,
			users.username
ORDER BY Min(dbo.saledetail.IDENTITYCOL)"
  arguments=(("ar_SaleInvCode", number))
)
