compute(name=c_grosstotal visible="1	if(getrow() = rowcount(), 1, 0)" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-11" font.pitch="2" font.weight="700" background.mode="1" background.color="553648127" color="0" x="6208" y="41" height="187" width="1635" format="##,###,##0.00" expression="Sum((  looseqty   *  ( saleprice  -  itemflatdisc) )  *  ( 1 -  (    discperc * .01 )  )  -  (  salestax   *  looseqty ) )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
