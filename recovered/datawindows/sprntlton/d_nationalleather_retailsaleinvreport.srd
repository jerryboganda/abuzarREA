compute(name=c_totaltax visible="1	0" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-11" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="3562" y="93" height="156" width="239" format="####0.00" expression="Round(Round((Round(sum((round(c_amount,2) ) for all)  *  (1 - invdiscperc * 0.01) ,2) -  flatdisc  )  *  invgstperc  * 0.01,2) + sum(c_salestaxval for all) , 0)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
