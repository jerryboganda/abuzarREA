compute(name=c_invsalestaxval visible="1	if(invgstperc>0 and getrow() = rowcount(),1,0)" band=footer font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="553648127" color="0" x="2354" y="520" height="166" width="916" format="#####0.00" expression="Round((Round(sum((round(c_amount,2) ) for all)  *  (1 - invdiscperc * 0.01),2) -  flatdisc  )  *  invgstperc  * 0.01,2)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
