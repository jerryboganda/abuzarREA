compute(name=compute_7 visible="1	if(getrow() = rowcount(), 1, 0)" band=footer font.charset="0" font.face="Times New Roman" font.family="1" font.height="-11" font.pitch="2" font.weight="400" background.mode="1" background.color="553648127" color="0" x="6937" y="52" height="166" width="989" format="####0.00" expression="sum(saleprice*looseqty for group 1)" alignment="1" border="2" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_nettotal visible="1	if(getrow() = rowcount(), 1, 0)" band=footer font.charset="0" font.face="Times New Roman" font.family="1" font.height="-11" font.pitch="2" font.weight="400" background.mode="1" background.color="553648127" color="0" x="6937" y="302" height="166" width="989" format="###,##,##,##0.00" expression="/*Round ( Sum((  looseqty   *  saleprice  )  *  ( 1 -  (    discperc * .01 )  )  -  (  salestax   *  looseqty ) ) *  ( 1 -  invdiscperc  * .01 )  -  flatdisc  +  misccharges  +  invsalestax , 0)*/Round(Sum (  c_netamount for group 1) -  flatdisc  + misccharges  + salestax , 0)  + Round(sum(c_salestaxval for group 1 ) + Round((Round(sum((round(c_amount,2) ) for group 1)  *  (1 - discperc * 0.01) , 2) -  flatdisc  )  *  invgstperc  * 0.01,2),2)" alignment="1" border="2" html.valueishtml="0" crosstab.repeat=no )
