column(name=gstperc visible="1	if(gstperc>0,1,0)" band=detail id=32 x="5687" y="11" height="156" width="385" color="0" border="0" alignment="1" format="##0.00" html.valueishtml="0" edit.autohscroll=no edit.autoselect=yes edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Times New Roman" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
compute(name=c_amount visible="1" band=detail font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="553648127" color="0" x="4937" y="11" height="166" width="708" format="###,##,##,##0.00" expression="(  looseqty   *  (saleprice - itemflatdisc)  )  *  ( 1 -  (    discperc * .01 )  )  -  (  salestax   *  looseqty )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_salestaxval visible="1	if(round( c_amount  *  gstperc * 0.01, 2) +  Round((looseqty+bonusqty) * unitsalestax ,2)>0,1,0)" band=detail font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="6114" y="11" height="166" width="604" format="###0.00" expression="round( c_amount  *  gstperc * 0.01, 2) +  Round((looseqty+bonusqty) * unitsalestax ,2)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_9 visible="1	if(sum(round( c_amount  *  gstperc * 0.01, 2) +  Round((looseqty+bonusqty) * unitsalestax ,2)  for group 1)>0,1,0)" band=detail font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="6760" y="11" height="166" width="583" format="####0.00" expression="round( c_amount  *  gstperc * 0.01, 2) +  Round((looseqty+bonusqty) * unitsalestax ,2) + c_amount" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
