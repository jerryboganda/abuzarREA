column=(type=char(1) updatewhereclause=yes name=printbatch dbname="printbatch"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(50) updatewhereclause=yes name=message dbname="Message"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CUSTALIAS"  )
column=(type=long updatewhereclause=yes name=i dbname="i"  )
 retrieve="SELECT 
	itemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(max(item.customicode))) END,   
	aliasname=max(item.customicode),   
	packingdesc=max(item.packingdesc),   
	accname = dbo.accounts.name,   
	address =max( dbo.customer.address1),   
	address2= max(dbo.customer.address2),   
	city= max(dbo.customer.city),
	licenceno= max(dbo.customer.licenceno),   
	username= dbo.users.username,   
	saleinvcode = dbo.saleledger.saleinvcode,   
	headerno = max(dbo.saleledger.headerno),   
	date = Case :ai_printdate When 1 Then max(dbo.saleledger.originaldate) When 2 Then dbo.saleledger.date When 3 Then max(dbo.saleledger.Billingdate)  End, 
	invdiscperc = dbo.saleledger.discperc,   
	misccharges = dbo.saleledger.misccharges,   
	flatdisc = dbo.saleledger.flatdisc,   
	invsalestax = dbo.saleledger.salestax,   
	gcode = saledetail.gcode,   
	icode = saledetail.icode,   
	batch = max(saledetail.batch),   
	expiry = max(saledetail.expiry),   
	looseqty = sum(saledetail.looseqty),   
	bonusqty = sum(saledetail.bonusqty),   
	packqty = sum(saledetail.packqty),   
	packunits=max(saledetail.packunits),   
	saleprice= max(saledetail.saleprice),   
	discperc = max(saledetail.discperc),   
	salestax = max(saledetail.salestax),  
	itemflatdisc=max(saledetail.itemflatdisc),   
	Id = max(dbo.saledetail.IDENTITYCOL),   
	posted=max(saleledger.posted),   
	balance=0,   
	unitsalestax =max(saledetail.unitsalestax),   
	gstperc = max(saledetail.gstperc),   
	invgstperc = max(saleledger.invgstperc1),   
	custTaxRegno=max(customer.salestaxregno ) ,
	dbo.saleledger.custrefno,	
	dbo.saleledger.remarks,
	printwaranty=max(dbo.saleledger.printwaranty),
	printbatch=max(dbo.saleledger.printbatch),
	salesman=ltrim(rtrim(max(dbo.salesman.name))),
	Message=ltrim(rtrim(max(dbo.Message.description))),
	CUSTALIAS=max(ACCOUNTS.ALIASNAME),
	i=1
FROM 
	saleledger
	LEFT OUTER JOIN DBO.SalesMan ON (dbo.saleledger.smancode = dbo.salesman.salesmancode)
	LEFT OUTER JOIN DBO.Message ON (dbo.saleledger.messagecode = dbo.message.messagecode),
	saledetail,   
	accounts,   
	customer,   
	users,   
	item  
WHERE 
	( dbo.saleledger.saleinvcode between :ar_SInvCode and :ar_linvcode ) AND  
	( dbo.saleledger.custcode IN (:ar_custcode) )AND 
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND 
	( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  
	( dbo.customer.custcode = dbo.accounts.acccode ) AND  
	( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  
	( dbo.saledetail.icode = dbo.item.icode)    
GROUP BY 
	saleledger.saleinvcode, 
	saleledger.date, 
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	saleledger.salestax, 
	saleledger.remarks,
	saleledger.custrefno, 
	saledetail.icode,
	saledetail.rowgroup, 
	saledetail.gcode, 
	item.name,
	item.icode,
	item.printable, 
	accounts.name,
	dbo.users.username
ORDER BY
	saleledger.saleinvcode, 
	MAX(dbo.saledetail.IDENTITYCOL)"
  arguments=(("ar_SInvCode", number), ("ar_linvcode", number), ("ar_custcode", numberlist), ("ai_PrintHeader", number), ("ai_PrintDate", number))
)
