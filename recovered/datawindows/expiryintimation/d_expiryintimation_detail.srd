table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="IntimationCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes initial="." name=batch dbname="batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=packprice dbname="packprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=price dbname="price"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="ExpiryIntimationDetail.RowID"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="Itemcode"  )
column=(type=long update=yes updatewhereclause=yes name=invoicecode dbname="invoicecode"  )
column=(type=datetime update=yes updatewhereclause=yes name=invoicedate dbname="invoicedate"  )
column=(type=long update=yes updatewhereclause=yes name=manfcode dbname="ManfCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=lastacccode dbname="LastAccCode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=refno dbname="refno"  )
column=(type=datetime update=yes updatewhereclause=yes name=refdate dbname="refdate"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=qty dbname="qty"  )
 retrieve="SELECT
	Item.customicode,
	Itemname= Item.name,
	currlistrow   = 0,
	stock         = 0.0000,
	packingdesc=Item.packingdesc,
	IntimationCode=ExpiryIntimationDetail.IntimationCode,
	icode=ExpiryIntimationDetail.icode,
	batch=ExpiryIntimationDetail.batch,
	expiry=ExpiryIntimationDetail.expiry,
	packunits=ExpiryIntimationDetail.packunits,
	packprice=ExpiryIntimationDetail.packprice,
	price=ExpiryIntimationDetail.price,
	ExpiryIntimationDetail.IDENTITYCOL,
	Itemcode = 0,
	invoicecode = ExpiryIntimationDetail.invoicecode,
	invoicedate = ExpiryIntimationDetail.invoicedate,
	ManfCode=CASE WHEN ExpiryIntimationDetail.ManfCode IS NULL THEN Item.ManfCode ELSE ExpiryIntimationDetail.ManfCode END,
	LastAccCode=ExpiryIntimationDetail.LastAccCode,
	refno = ExpiryIntimationDetail.refno,
	refdate = ExpiryIntimationDetail.refdate,
	qty = ExpiryIntimationDetail.qty
FROM  ExpiryIntimationDetail, Item 
WHERE 
	dbo.ExpiryIntimationDetail.IntimationCode = :ai_Code AND
	ExpiryIntimationDetail.icode = Item.icode
ORDER BY 
	ExpiryIntimationDetail.IDENTITYCOL"
  update="ExpiryIntimationDetail" updatewhere=0 updatekeyinplace=no
  arguments=(("ai_Code", number))
)
