table(column=(type=long key=yes updatewhereclause=yes name=code dbname="ExpiryIntimation.IntimationCode"  )
column=(type=long updatewhereclause=yes name=intimationserialno dbname="ExpiryIntimation.IntimationSerialNo"  )
column=(type=long updatewhereclause=yes name=acccode dbname="ExpiryIntimation.AccCode"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="AccName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ExpiryIntimation.Date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="ExpiryIntimation.UserCode" 
 values=""  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="ExpiryIntimation.Posted"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="ExpiryIntimation.PostDate"  )
column=(type=char(100) updatewhereclause=yes name=refno dbname="ExpiryIntimation.RefNo"  )
column=(type=char(255) updatewhereclause=yes name=remarks1 dbname="ExpiryIntimation.Remarks1"  )
column=(type=char(255) updatewhereclause=yes name=remarks2 dbname="ExpiryIntimation.Remarks2"  )
 retrieve="SELECT 
	ExpiryIntimation.IntimationCode,   
	ExpiryIntimation.IntimationSerialNo,   
	ExpiryIntimation.AccCode,
	AccName = (SELECT AC.Name FROM Accounts AC WHERE AC.AccCode = ExpiryIntimation.AccCode),
	ExpiryIntimation.Date,   
	ExpiryIntimation.UserCode,  
	Amount = ISNULL((SELECT SUM(D.Qty * D.Price) FROM ExpiryIntimationDetail D WHERE D.IntimationCode = ExpiryIntimation.IntimationCode),0), 
	ExpiryIntimation.Posted,   
	ExpiryIntimation.PostDate, 
	ExpiryIntimation.RefNo,
	ExpiryIntimation.Remarks1,
	ExpiryIntimation.Remarks2
FROM 
	ExpiryIntimation
WHERE	
	ExpiryIntimation.IntimationTypeCode=1
ORDER BY 
	ExpiryIntimation.IntimationCode
"
  update="ExpiryIntimation" updatewhere=1 updatekeyinplace=no
 )
