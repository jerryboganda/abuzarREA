header(height=77 color="536870912" )
summary(height=0 color="536870912" )
footer(height=74 color="536870912" )
detail(height=70 color="536870912" )
table(column=(type=char(1) updatewhereclause=yes name=selected dbname="SELECTED" 
 values="	Y/	N"  )
column=(type=long key=yes updatewhereclause=yes name=intimationcode dbname="ExpiryIntimation.IntimationCode"  )
column=(type=long updatewhereclause=yes name=intimationtypecode dbname="ExpiryIntimation.IntimationTypeCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=date dbname="ExpiryIntimation.Date"  )
column=(type=long updatewhereclause=yes name=acccode dbname="ExpiryIntimation.AccCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=custcode dbname="ExpiryIntimation.CustCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=refno dbname="ExpiryIntimation.RefNo"  )
column=(type=char(255) updatewhereclause=yes name=remarks1 dbname="ExpiryIntimation.Remarks1"  )
column=(type=char(255) updatewhereclause=yes name=remarks2 dbname="ExpiryIntimation.Remarks2"  )
 retrieve="SELECT 
	SELECTED='Y',
	IntimationCode,
	IntimationTypeCode,
	Date,
	AccCode,
	CustCode,
	RefNo,
	Remarks1,
	Remarks2
FROM
	ExpiryIntimation
WHERE 
	IntimationTypeCode = :ai_type AND
	IntimationCode BETWEEN :ai_startno AND :ai_endno
ORDER BY
	IntimationCode"
  update="ExpiryIntimation" updatewhere=0 updatekeyinplace=no
  arguments=(("ai_startno", number), ("ai_endno", number), ("ai_type", number))
 sort="date A"
)
