table(column=(type=char(75) updatewhereclause=yes name=item_customicode dbname="Item.CustomICode"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.Name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(100) updatewhereclause=yes name=suppinvcode dbname="SuppInvCode"  )
column=(type=datetime updatewhereclause=yes name=suppinvdate dbname="SuppInvDate"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Purdetail.Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Purdetail.Expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
 retrieve="SELECT Item.CustomICode, 
	GroupCode=
		CASE :as_reportgrouping
		WHEN 'M' THEN max(Item.ManfCode)
		WHEN 'C' THEN max(Item.ICatCode)
		WHEN 'L' THEN max(Item.ICCode)
		ELSE Max(Item.PACKCODE) END,
	GroupName= 
		CASE :as_reportgrouping 
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = max(Item.ManfCode))
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = max(Item.ICatCode))
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = max(Item.ICCode))
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = max(Item.PACKCODE)) END,    
	ICode=Item.ICode,
	Item.Name,   
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	Item.PackUnits,   
	PurInvCode = P.PurInvCode,
	Date = P.Date,
	SuppCode=P.SuppCode,
	SuppInvCode=P.SuppInvCode,
	SuppInvDate=P.SuppInvDate,
	Purdetail.Batch,   
	Purdetail.Expiry,   
	Qty = SUM(CASE WHEN P.PurCatCode <=2 THEN PurDetail.PackUnits ELSE 1 END * (Purdetail.PackQty + purdetail.looseqty + purdetail.bonusqty))
FROM PurLedger P, Purdetail, Item
WHERE 
	P.PurInvcode = PurDetail.PurInvCode AND
	Purdetail.Expiry Between :adt_sdate and :adt_edate AND
	Purdetail.icode=item.icode AND
	CASE :as_reportgrouping
	WHEN 'M' THEN Item.ManfCode
	WHEN 'C' THEN Item.ICatCode
	WHEN 'L' THEN Item.ICCode
	ELSE item.PACKCODE END IN (:ai_groupcode) 
GROUP BY 
	Item.CustomICode,    
	Item.ICode,
	Item.Name,   
	Item.Active,
	Item.PackUnits,   
	purdetail.Batch,   
	P.PurInvCode,
	P.Date,
	P.SuppCode,
	P.SuppInvCode,
	P.SuppInvDate,
	PurDetail.Expiry,   
	purDetail.packQty,
	purdetail.looseqty 
ORDER BY 
	GroupName,
	Item.Name,   
	Item.PackUnits,   
	purdetail.Batch,   
	PurDetail.Expiry,   
	purDetail.packQty,
	purdetail.looseqty 
"
  arguments=(("as_reportgrouping", string), ("ai_groupcode", numberlist), ("adt_sdate", datetime), ("adt_edate", datetime))
)
