table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ExpiryIntimation.IntimationCode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=intimationtypecode dbname="ExpiryIntimation.IntimationTypeCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=intimationserialno dbname="ExpiryIntimation.IntimationSerialNo"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long update=yes updatewhereclause=yes initial="19" name=acccode dbname="ExpiryIntimation.AccCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="ExpiryIntimation.Date"  )
column=(type=char(100) update=yes updatewhereclause=yes name=refno dbname="ExpiryIntimation.RefNo"  )
column=(type=char(255) update=yes updatewhereclause=yes name=remarks1 dbname="ExpiryIntimation.Remarks1"  )
column=(type=char(255) update=yes updatewhereclause=yes name=remarks2 dbname="ExpiryIntimation.Remarks2"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="ExpiryIntimation.UserCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="ExpiryIntimation.Posted"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="ExpiryIntimation.PostedBy"  )
column=(type=long update=yes updatewhereclause=yes name=sitecode dbname="ExpiryIntimation.Sitecode"  )
column=(type=long update=yes updatewhereclause=yes name=targetsitecode dbname="ExpiryIntimation.TargetSiteCode" 
 values=""  )
 retrieve="SELECT 
	ExpiryIntimation.IntimationCode,   
	ExpiryIntimation.IntimationTypeCode,   
	ExpiryIntimation.IntimationSerialNo,   
	AliasName = (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = ExpiryIntimation.AccCode),
	ExpiryIntimation.AccCode,   
	ExpiryIntimation.Date,   
	ExpiryIntimation.RefNo,   
	ExpiryIntimation.Remarks1,   
	ExpiryIntimation.Remarks2,   
	ExpiryIntimation.UserCode,   
	ExpiryIntimation.Posted,   
	ExpiryIntimation.PostedBy,
	ExpiryIntimation.Sitecode,
	ExpiryIntimation.TargetSiteCode
FROM 
	ExpiryIntimation  
WHERE 
	ExpiryIntimation.IntimationCode = :ai_code    
"
  update="ExpiryIntimation" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
