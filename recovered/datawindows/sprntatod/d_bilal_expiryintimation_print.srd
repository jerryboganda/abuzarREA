table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=intimationtypecode dbname="IntimationTypeCode"  )
column=(type=long updatewhereclause=yes name=intimationserialno dbname="IntimationSerialNo"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(12) updatewhereclause=yes name=accountaliasname dbname="AccountAliasName"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(100) updatewhereclause=yes name=fax dbname="Fax"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=refno dbname="RefNo"  )
column=(type=char(255) updatewhereclause=yes name=remarks1 dbname="Remarks1"  )
column=(type=char(255) updatewhereclause=yes name=remarks2 dbname="Remarks2"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=long updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=char(100) updatewhereclause=yes name=intimationtype dbname="IntimationType"  )
column=(type=long updatewhereclause=yes name=icode dbname="Icode"  )
column=(type=char(100) updatewhereclause=yes name=refnodetail dbname="refnodetail"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=decimal(2) updatewhereclause=yes name=packprice dbname="PackPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(6) updatewhereclause=yes name=itemtotal dbname="ItemTotal"  )
 retrieve=" SELECT  
	Code=ExpiryIntimation.IntimationCode,   
	IntimationTypeCode=ExpiryIntimation.IntimationTypeCode,   
	IntimationSerialNo=ExpiryIntimation.IntimationSerialNo,   
	AccCode=ExpiryIntimation.AccCode,   
	AccountName = A.Name,
	AccountAliasName = A.AliasName,
	Address1 = CS.Address1,
	Address2 = CS.Address2,
	City = CS.City,
	Phone = CS.Phone,
	Fax = CS.Fax,
	Date = ExpiryIntimation.Date,   
	RefNo=ExpiryIntimation.RefNo,   
	Remarks1=ExpiryIntimation.Remarks1,   
	Remarks2=ExpiryIntimation.Remarks2,   
	UserCode=ExpiryIntimation.UserCode,   
	Posted=ExpiryIntimation.Posted,   
	PostedBy=ExpiryIntimation.PostedBy,   
	PostDate=ExpiryIntimation.PostDate,   
	IntimationType=IntimationType.Name,   
	Icode=ExpiryIntimationDetail.ICode,   
	refnodetail = ExpiryIntimationDetail.refno,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	Batch=ExpiryIntimationDetail.Batch,   
	Expiry=ExpiryIntimationDetail.Expiry,   
	Qty=ExpiryIntimationDetail.Qty,   
	PackUnits=ExpiryIntimationDetail.Packunits,   
	PackPrice=ExpiryIntimationDetail.PackPrice,   
	Price=ExpiryIntimationDetail.Price,
	ItemTotal= ExpiryIntimationDetail.Qty * ExpiryIntimationDetail.Price
FROM 
	ExpiryIntimation,   
	ExpiryIntimationDetail,   
	IntimationType,
	Accounts A,
	(SELECT Code=C.CustCode, Address1=C.Address1, Address2=C.Address2, Phone=C.Phone, Fax=C.Fax, City=C.City
	FROM Customer C
	UNION ALL
	SELECT Code=C.SuppCode, Address1=C.Address1, Address2=C.Address2, Phone=C.Phone, Fax=C.Fax, City=C.City
	FROM Supplier C) CS,
	Item I
WHERE 
	ExpiryIntimationDetail.IntimationCode = :ai_code AND
	ExpiryIntimationDetail.IntimationCode = ExpiryIntimation.IntimationCode AND  
	IntimationType.IntimationTypeCode = ExpiryIntimation.IntimationTypeCode AND
	ExpiryIntimation.AccCode = A.AccCode AND
	A.AccCode = CS.Code AND
	ExpiryIntimationDetail.ICode = I.ICode
ORDER BY
	ExpiryIntimationDetail.RowID"
  arguments=(("ai_code", number))
)
