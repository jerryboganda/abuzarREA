column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="itempacking"  )
column=(type=char(100) updatewhereclause=yes name=itemdescription dbname="itemdescription"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
 retrieve="SELECT 
	itemname= item.name, 
	accname = dbo.accounts.name,
	packingdesc=max(item.packingdesc),
	aliasname=max(item.customicode),
	address = max(dbo.customer.address1),
	address2 = max(dbo.customer.address2),
	saleperson=(select name from salesman where salesmancode=max(saleledger.smancode)),
	Deliverdby=(select name from salesman where salesmancode=max(saleledger.deliveredby)),
	manufacturer=(select name from manufacturer where manfcode=max(item.manfcode)),
	packing=(select name from itempacking where packcode=max(item.packcode)),
	city = max(dbo.customer.city),
	salesman = dbo.users.username, 
	saleinvcode = dbo.saleledger.saleinvcode, 
	headerno = max(dbo.saleledger.headerno),
	headerinvno = max(dbo.saleledger.headerinvno),  
	date = dbo.saleledger.date,
	billingdate = dbo.saleledger.billingdate,
	invdiscperc = dbo.saleledger.discperc,   
	misccharges = dbo.saleledger.misccharges,   
	flatdisc = dbo.saleledger.flatdisc,   
	invsalestax = dbo.saleledger.salestax,   
	dbo.saleledger.custcode,
	dbo.saleledger.custrefno,	
	dbo.saleledger.remarks,	
	gcode = saledetail.gcode,   
	icode = saledetail.icode,   
	batch = max(saledetail.batch),   
	manfdate = max(saledetail.manfdate),   
	expiry = max(saledetail.expiry),   
	looseqty = isnull(sum(saledetail.looseqty),0),
	packqty  = isnull(sum(saledetail.packqty),0),
	bonusqty  = isnull(sum(saledetail.bonusqty),0),
	packunits= max(saledetail.packunits),
	saleprice= max(saledetail.saleprice),
	discperc = max(saledetail.discperc),
	salestax =max( saledetail.salestax),
	itemflatdisc =max(saledetail.itemflatdisc), 
	itempacking = max(itempacking.name),
	itemdescription = max(saledetail.saleitemdescription),	
	Godown =max(Godown.name),	
	Id       = max(dbo.saledetail.IDENTITYCOL) 
	
FROM 
	saleledger, 
	saledetail, 
	accounts, 
	customer,
	users, 
	Item 
	LEFT OUTER JOIN ItemPacking ON (dbo.item.packcode = dbo.itempacking.packcode)
	LEFT OUTER JOIN Godown ON (dbo.item.Gcode = dbo.Godown.Gcode)
	
WHERE 
	( dbo.saleledger.saleinvcode = :ar_SaleInvCode ) AND
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND
	( dbo.saleledger.custcode = dbo.accounts.acccode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( dbo.saleledger.salesmancode = dbo.users.usercode ) AND 
	( dbo.saledetail.icode = dbo.item.icode)
	
GROUP BY 
	saleledger.saleinvcode, 
	saleledger.date, 
	saleledger.billingdate,
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	saleledger.salestax, 
	saleledger.remarks,
	saleledger.custrefno, 
	saledetail.icode,
	saledetail.rowgroup, 
	saledetail.gcode, 
	item.name,
	item.icode,
	item.printable, 
	accounts.name,
	dbo.users.username
	
ORDER BY 
	max(dbo.saledetail.IDENTITYCOL)"
  arguments=(("ar_SaleInvCode", number))
)
