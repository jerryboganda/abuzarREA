table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=decimal(5) updatewhereclause=yes name=balance dbname="balance"  )
column=(type=char(50) updatewhereclause=yes name=salemessage dbname="salemessage"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleLedger.saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=saleledger_date dbname="SaleLedger.date"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_discperc dbname="SaleLedger.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_misccharges dbname="SaleLedger.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_flatdisc dbname="SaleLedger.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_salestax dbname="SaleLedger.salestax"  )
column=(type=long updatewhereclause=yes name=custcode dbname="SaleLedger.custcode"  )
column=(type=char(100) updatewhereclause=yes name=saleledger_remarks dbname="SaleLedger.remarks"  )
column=(type=char(100) updatewhereclause=yes name=saleledger_custrefno dbname="SaleLedger.custrefno"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Saledetail.icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=salecatcode dbname="salecatcode"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_discperc dbname="discperc"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=long updatewhereclause=yes name=reprintcounter dbname="reprintcounter"  )
column=(type=datetime updatewhereclause=yes name=serverdate dbname="serverdate"  )
 retrieve="  SELECT itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, 
			reprintdate=getdate(), 
			users.username,   
			accounts.name, 
			headerno =max(saleledger.headerno),
			posted=max(saleledger.posted),
			balance=isnull(max(balance),0),
			salemessage=(select description from message where max(saleledger.messagecode)=message.messagecode),
			dbo.saleledger.saleinvcode,   
         dbo.saleledger.date,   
         dbo.saleledger.discperc,   
         dbo.saleledger.misccharges,   
         dbo.saleledger.flatdisc,   
         dbo.saleledger.salestax,   
         dbo.saleledger.custcode,   
         dbo.saleledger.remarks,
   		dbo.saleledger.custrefno,	
         dbo.saledetail.icode,   
         gcode=max(dbo.saledetail.gcode),
         salecatcode=max(saleledger.salecatcode),
			Id        = MAX(dbo.saledetail.IDENTITYCOL),     
         looseqty  = sum(saledetail.looseqty) ,
			packqty   = sum(saledetail.packqty), 
			packunits = max(saledetail.packunits), 
	 		saleprice = max(saledetail.saleprice), 
	 		rate      = max(saledetail.rate),
         salestax  = max(saledetail.salestax),   
         discperc  = max(saledetail.discperc), 
			customername='                                  '  ,
         itemflatdisc  = max(saledetail.itemflatdisc),
			unitsalestax  = max(saledetail.unitsalestax),
			gstperc       = max(saledetail.gstperc),
			invgstperc    = max(saleledger.invgstperc1),
			reprintcounter=max(saleledger.reprintingcounter),
			serverdate=getdate()

    FROM dbo.saleledger,   
         dbo.saledetail,  
         item, 
			customer, 
			accounts,
			users 

   WHERE ( dbo.saleledger.saleinvcode = :ra_InvCode ) AND
         
			( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND 
			( dbo.saleledger.custcode = dbo.customer.custcode ) AND 
			( dbo.customer.custcode = dbo.accounts.acccode ) AND 
			( dbo.saleledger.salesmancode = dbo.users.usercode ) AND

			( saledetail.icode = item.icode )  

GROUP BY saleledger.saleinvcode, 
			saleledger.date, 
			/*saleledger.headerno,*/
			saleledger.custcode, 
			saleledger.discperc, 
			saleledger.flatdisc, 
			saleledger.misccharges, 
			saleledger.salestax, 
			saleledger.remarks,
			saleledger.custrefno, 
			saledetail.icode,
			/*saledetail.rowgroup, 
			saledetail.gcode, */
			item.name,
			item.icode,
			item.printable, 
			accounts.name,
			dbo.users.username

ORDER BY 
			MAX(dbo.saledetail.IDENTITYCOL)
"
  arguments=(("ra_InvCode", number))
 sort="id A"
)
