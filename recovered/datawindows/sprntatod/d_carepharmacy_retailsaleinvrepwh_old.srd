compute(name=compute_10 visible="1	if( Sum ( (  looseqty *  saledetail_saleprice - looseqty * itemflatdisc )  *  saledetail_discperc  * .01  ) + sum(looseqty * itemflatdisc for all) + (Sum (  c_amount for all )  * (  saleledger_discperc * .01) ) +  saleledger_flatdisc  -  saleledger_misccharges = 0 , 0, 1)" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="1781" y="396" height="166" width="968" format="####0.00" expression="Sum ( (  looseqty *  saledetail_saleprice - looseqty * itemflatdisc )  *  saledetail_discperc  * .01  ) + sum(looseqty * itemflatdisc for all) + (Sum (  c_amount for all )  * (  saleledger_discperc * .01) ) +                                  saleledger_flatdisc  /*-  saleledger_misccharges */" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
