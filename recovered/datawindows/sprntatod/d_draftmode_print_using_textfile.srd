release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=836 color="536870912" )
summary(height=912 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(8000) updatewhereclause=yes name=rowdetail dbname="rowdetail"  )
column=(type=char(69) updatewhereclause=yes name=footerrow2 dbname="FooterRow2"  )
column=(type=char(69) updatewhereclause=yes name=footerrow3 dbname="FooterRow3"  )
column=(type=char(69) updatewhereclause=yes name=footerrow4 dbname="FooterRow4"  )
column=(type=char(69) updatewhereclause=yes name=footerrow5 dbname="FooterRow5"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=decimal(5) updatewhereclause=yes name=balance dbname="balance"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="ItemFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=char(3) updatewhereclause=yes name=reprintcounter dbname="reprintcounter"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="doctor"  )
column=(type=char(60) updatewhereclause=yes name=p dbname="P"  )
column=(type=datetime updatewhereclause=yes name=serverdate dbname="serverdate"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(14) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve=" SELECT 
	rowdetail =  
		CASE WHEN LEN(LTRIM(RTRIM(IT.customicode))) >= 8 THEN LEFT(IT.customicode, 8) ELSE LTRIM(RTRIM(IT.customicode)) + REPLICATE(' ', 8 - LEN(LTRIM(RTRIM(IT.customicode)))) END + 
		SPACE(1) +
		CASE WHEN LEN(LTRIM(RTRIM(IT.name))) >= 15 THEN SUBSTRING(IT.Name,1, 15) ELSE LTRIM(RTRIM(IT.Name)) + REPLICATE(' ', 15 - LEN(LTRIM(RTRIM(IT.Name)))) END +
		SPACE(1) +
		CASE WHEN sum(SD.looseqty) = 0 THEN SPACE(5) ELSE STR(sum(SD.looseqty), 5) END +
		SPACE(1) +
		CASE WHEN sum(SD.bonusqty) = 0 THEN SPACE(5) ELSE STR(sum(SD.Bonusqty), 5) END +
		SPACE(1) +
		CASE WHEN sum(SD.saleprice) = 0 THEN SPACE(8) ELSE STR(max(SD.saleprice), 8, 2) END+
		SPACE(1) +
		CASE WHEN SUM( (SD.Itemflatdisc * SD.looseqty) + 
				(SD.looseqty * (SD.saleprice - SD.ItemFlatDisc) * 
				(SD.discperc * 0.01))) = 0 THEN SPACE(6) 
			ELSE 
				STR(SUM( (SD.ItemFlatDisc * SD.looseqty) + 
				(SD.looseqty * (SD.saleprice - SD.ItemFlatDisc) * 
				(SD.discperc * 0.01))) , 6, 2) 
			END +
		SPACE(1) +
		CASE WHEN SUM( 
				Round(
				(SD.looseqty * 
					(SD.saleprice - SD.ItemFlatDisc) * 
					(1 - SD.discperc * 0.01) * SD.gstperc * 0.01), 2) + 
				Round(SD.unitsalestax * SD.looseqty, 2))=0 THEN SPACE(6) 
			ELSE
				STR(SUM( 
				Round(
				(SD.looseqty * 
					(SD.saleprice - SD.ItemFlatDisc) * 
					(1 - SD.discperc * 0.01) * SD.gstperc * 0.01), 2) + 
				Round(SD.unitsalestax * SD.looseqty, 2)), 6, 2) 
			END + 
		SPACE(1) +
		CASE WHEN 
			Round(SUM(
				(SD.looseqty * (SD.saleprice - SD.ItemFlatDisc) * 
				(1 - SD.discperc * 0.01))), 2) +
				SUM( 
				Round(
					(SD.looseqty * 
						(SD.saleprice - SD.ItemFlatDisc) * 
						(1 - SD.discperc * 0.01) * SD.gstperc * 0.01), 2) + 
					Round(SD.unitsalestax * SD.looseqty, 2)) = 0 THEN SPACE(9) 
			ELSE	
				str(
					Round(SUM(
						(SD.looseqty * (SD.saleprice - SD.ItemFlatDisc) * 
						(1 - SD.discperc * 0.01))), 2) +
					SUM( 
					Round(
					(SD.looseqty * 
						(SD.saleprice - SD.ItemFlatDisc) * 
						(1 - SD.discperc * 0.01) * SD.gstperc * 0.01), 2) + 
					Round(SD.unitsalestax * SD.looseqty, 2)), 9, 2) 
			END,
	FooterRow2=
		CASE WHEN SL.flatdisc = 0 THEN SPACE(1) 
		ELSE SPACE(25) + 'Less Flat Discount: ' + SPACE(10) + STR(max(SL.flatdisc), 14, 2) 
		END,
	FooterRow3=
		CASE WHEN SL.MiscCharges = 0 THEN SPACE(1) 
		ELSE SPACE(25) + 'Add  Misc. Charges: ' + SPACE(10) + STR(max(SL.MiscCharges), 14, 2) 
		END,
	FooterRow4 =
		CASE WHEN SL.discperc = 0 THEN SPACE(1)
		ELSE SPACE(25) + 'Less Inv. Discount: ' + STR(SL.discperc, 6, 2) + '% = ' + 
		STR((SELECT ISNULL(
			Round( (
				SUM(D.looseqty * (D.saleprice - D.ItemFlatDisc) * (1 - D.discperc * 0.01)) * 
				(S.discperc * 0.01)	), 2), 0)
			FROM SaleLedger S, SaleDetail D 
			WHERE S.SaleInvCode = :ra_InvCode AND S.SaleInvCode = D.SaleInvCode
			GROUP BY S.SaleInvCode, S.discperc), 14, 2)
		END,
	FooterRow5 =		
		CASE WHEN SL.invgstperc1 = 0 THEN SPACE(1)
		ELSE SPACE(25) + 'Add Inv. GST (%)  : ' + STR(SL.invgstperc1, 6, 2) + '% = ' + 
		STR((SELECT ISNULL(
			Round( ( (SUM( D.looseqty * (D.saleprice - D.ItemFlatDisc) * 
				(1 - D.discperc * 0.01)) * (1 - S.discperc * 0.01)) - S.FlatDisc) * 
				SL.invgstperc1 * 0.01, 2), 0)
			FROM SaleLedger S, SaleDetail D 
			WHERE S.SaleInvCode = :ra_InvCode AND S.SaleInvCode = D.SaleInvCode
			GROUP BY S.SaleInvCode, S.DiscPerc, S.FlatDisc, S.invgstperc1), 14, 2)
		END,
	username=U.username, 
	reprintdate=getdate(),
	headerno = SL.headerno,
	posted = max(SL.posted),
	balance=isnull(max(balance),0),
	saleinvcode=SL.saleinvcode,   
	date=SL.date,   
	invdiscperc=SL.discperc,   
	misccharges=SL.misccharges,   
	flatdisc=SL.flatdisc,   
	custcode = SL.custcode, 
	remarks = SL.remarks,
	icode = SD.icode,   
	gcode = SD.gcode, 
	Id        = MAX(SD.IDENTITYCOL),  
	looseqty = SUM(SD.looseqty),  
	bonusqty = SUM(SD.bonusqty),  
	packunits= MAX(SD.packunits),  
	saleprice= MAX(SD.saleprice),  
	ItemFlatDisc= MAX(SD.ItemFlatDisc),  
	discperc= MAX(SD.discperc),  
	unitsalestax = MAX(SD.unitsalestax),  
	gstperc = MAX(SD.gstperc),  
	customername=A.Name,
	reprintcounter= STR(max(SL.reprintingcounter), 3),
	doctor=max(D.name),
	P=max(P.name),
	serverdate=getdate(),
	custrefno = SL.custrefno,
	invgstperc = max(SL.invgstperc1),
	InvTotal = STR(SL.InvTotal, 14, 2)
FROM 
	dbo.saleledger SL
	LEFT OUTER JOIN DBO.Doctors AS D ON (SL.doctcode = D.doctcode)
	LEFT OUTER JOIN DBO.Patient AS P ON (SL.Patientcode = P.Patientcode),
	SaleDetail SD,  
	Item IT,
	Users U,
	Accounts A

WHERE 
	( SL.saleinvcode = :ra_InvCode ) AND
	( SL.saleinvcode = SD.saleinvcode ) AND 
	( SL.SalesManCode = U.userCode ) and
	( SL.CustCode = A.AccCode ) and
	( SD.icode = IT.icode )
GROUP BY 
	SL.saleinvcode, 
	SL.date, 
	SL.custcode, 
	A.Name,
	SL.discperc, 
	SL.flatdisc, 
	SL.misccharges, 
	SL.headerno,
	SL.salestax, 
	SL.remarks, 
	SL.custrefno,
	SL.InvTotal,
	SL.invgstperc1, 
	U.username,
	SD.icode, 
	IT.name,
	IT.customicode, 
	IT.icode,
	IT.printable,
	SD.rowgroup,
	SD.gcode
ORDER BY 
	MAX(SD.IDENTITYCOL)

"
  arguments=(("ra_InvCode", number))
)
compute(name=c_line8 visible="1" band=header font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="18" y="540" height="64" width="1746" format="[General]" expression="'Ref. No.: ' + IF(ISNULL(custrefno), SPACE(15), LEFT(custrefno, 15)) + SPACE(2) + 'Remarks: ' + if(isnull(remarks), '', left(remarks, 30))" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_line7 visible="1" band=header font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="18" y="464" height="64" width="1746" format="[GENERAL]" expression="'M/S: ' + customername" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_line6 visible="1" band=header font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="18" y="388" height="64" width="1746" format="[General]" expression="'Inv. No.:' + STRING(saleinvcode) + SPACE(2) + 'Date:' + STRING(date, 'dd/mm/yyyy hh:mm') + SPACE(2) + 'User: ' + LEFT(username, 15)" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_line4 visible="1" band=header font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="18" y="236" height="64" width="1746" format="[GENERAL]" expression="IF( LEN( TRIM( f_ReportHeaderInfosale('address2', headerno))) > 74, LEFT(TRIM( f_ReportHeaderInfosale('address2', headerno)), 74), FILL(' ', INT((74 - LEN( TRIM( f_ReportHeaderInfosale('address2', headerno)))) / 2)) + TRIM( f_ReportHeaderInfosale('address2', headerno)))" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_line3 visible="1" band=header font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="18" y="160" height="64" width="1746" format="[General]" expression="CHAR(15) + IF( LEN( TRIM( f_ReportHeaderInfosale('address1', headerno))) > 74, LEFT(TRIM( f_ReportHeaderInfosale('address1', headerno)), 74), FILL(' ', INT((74 - LEN( TRIM( f_ReportHeaderInfosale('address1', headerno)))) / 2)) + TRIM( f_ReportHeaderInfosale('address1', headerno)))" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_line2 visible="1" band=header font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" x="18" y="84" height="64" width="1746" format="[GENERAL]" expression="CHAR(27) + 'G' + CHAR(15) + IF( LEN( TRIM( f_ReportHeaderInfosale('clientname', headerno))) > 74, LEFT(TRIM( f_ReportHeaderInfosale('clientname', headerno)), 74), FILL(' ', INT((74 - LEN( TRIM( f_ReportHeaderInfosale('clientname', headerno)))) / 2)) + TRIM( f_ReportHeaderInfosale('clientname', headerno))) + CHAR(27) + 'H' + CHAR(15)" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_line10 visible="1" band=header font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="18" y="692" height="64" width="1746" format="[GENERAL]" expression="'Code' + SPACE(5) + 'Item Name' + SPACE(10) + if(sum(looseqty)=0, SPACE(3), 'Qty') + SPACE(1) + if(sum(bonusqty)=0, SPACE(5), 'Bonus') + '    ' + if(sum(saleprice)=0, SPACE(5), 'Price') + SPACE(2) + if(sum(discperc + itemflatdisc) = 0,  SPACE(4), 'Disc') + SPACE(2) + if(sum(unitsalestax + gstperc)=0, SPACE(5), 'S/Tax') + '     Total'" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_line1 visible="1" band=header font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="18" y="8" height="64" width="1746" format="[General]" expression="SPACE(2) + CHAR(15) + 'Date:' + STRING(today(), 'dd/mm/yyyy hh:mm') + SPACE(8) + 'Sales Invoice' + SPACE(8) + 'Page 1/1'" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
