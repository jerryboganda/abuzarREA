table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Item.ICode"  )
column=(type=char(75) update=yes updatewhereclause=yes name=customicode dbname="Item.CustomICode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Item.Name"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="Item.SalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=purprice dbname="Item.PurPrice"  )
 retrieve="SELECT 
	Item.ICode,   
	Item.CustomICode,   
	Item.Name,   
	Item.SalePrice,   
	Item.PurPrice  
FROM 
	Item   
WHERE 
	ICode = :ai_code
"
  update="Item" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
