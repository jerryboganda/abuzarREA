table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ItemInquiry.ItemInquiryCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="ItemInquiry.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="ItemInquiry.UserCode"  )
column=(type=char(30) update=yes updatewhereclause=yes name=machinename dbname="ItemInquiry.MachineName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ItemInquiry.Remarks"  )
 retrieve="SELECT
	ItemInquiry.ItemInquiryCode,
	ItemInquiry.Date,
	ItemInquiry.UserCode,
	ItemInquiry.MachineName,
	ItemInquiry.Remarks
FROM
	ItemInquiry
WHERE
	ItemInquiry.ItemInquiryCode = :ai_code
"
  update="ItemInquiry" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
