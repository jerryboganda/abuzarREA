release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=74 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=quotationcode dbname="QuotationCode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long key=yes updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Sale Price~"" initial="0" name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Item Flat Discount~"" initial="0" name=itemflatdisc dbname="ItemFlatDisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid Item Discount Percentage~"" initial="0" name=discperc dbname="DiscPerc"  )
 retrieve="SELECT 
	QuotationCode=QuotationHeader.QuotationCode, 
	CustCode=QuotationHeader.CustCode, 
	Remarks=QuotationHeader.Remarks, 
	ICode = QuotationDetail.ICode,
	RowID=QuotationDetail.RowID,
	SalePrice=QuotationDetail.SalePrice, 
	ItemFlatDisc=QuotationDetail.ItemFlatDisc, 
	DiscPerc=QuotationDetail.DiscPerc
FROM 
	QuotationHeader,
	QuotationDetail
WHERE
	QuotationHeader.Active ='Y' AND
	QuotationHeader.QuotationCode = QuotationDetail.QuotationCode AND
	QuotationDetail.ICode = :ai_icode
ORDER BY
	QuotationCode"
  update="QuotationDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_icode", number))
)
