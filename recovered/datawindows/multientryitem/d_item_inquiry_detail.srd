table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ItemInquiryDetail.iteminquirycode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="manfcode"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="icatcode"  )
column=(type=long updatewhereclause=yes name=iccode dbname="iccode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=unknownitem dbname="UnKnownItem" 
 values="Yes	Y/No	N/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=unknownitemname dbname="UnKnownItemName"  )
column=(type=long updatewhereclause=yes name=packcode dbname="packcode"  )
column=(type=char(100) updatewhereclause=yes name=location dbname="Location"  )
column=(type=char(100) updatewhereclause=yes name=itemremarks dbname="ItemRemarks"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=pendingdue dbname="PendingDue"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=purprice dbname="purprice"  )
column=(type=decimal(13) updatewhereclause=yes initial="0" name=retailprice dbname="retailprice"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=recentpurprice dbname="recentpurprice"  )
column=(type=decimal(5) updatewhereclause=yes initial="0" name=avgprice dbname="avgprice"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="ItemInquiryDetail.icode"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="ItemInquiryDetail.rowid"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ItemInquiryDetail.remarks"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=saleprice dbname="Item.saleprice"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=purdiscperc dbname="Item.purdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=salediscperc dbname="Item.salediscperc"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=flatdisc dbname="Item.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=packsalestax dbname="Item.packsalestax"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=gstperc1 dbname="Item.gstperc1"  )
column=(type=long updatewhereclause=yes initial="1" name=packunits dbname="Item.packunits"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(100) updatewhereclause=yes name=itemname dbname="itemname"  )
 retrieve="SELECT 
	iteminquirydetail.iteminquirycode,
	fullcode = item.customicode,
	manfcode=item.manfcode,
	icatcode=item.icatcode,
	iccode=item.iccode,
	UnKnownItem = CASE WHEN iteminquirydetail.icode IS NULL THEN 'Y' ELSE 'N' END,
	UnKnownItemName = iteminquirydetail.UnKnownItemName,
	packcode=item.packcode,
	Location=item.Location,
	ItemRemarks=Item.Remarks,
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= iteminquirydetail.TotalStock, 
	PendingDue = iteminquirydetail.PendingDue,
	Qty = iteminquirydetail.Qty,
	purprice=item.purprice,
	retailprice=Round(item.retailprice / case when item.packunits > 0 then item.packunits else 1 end, 2),
	recentpurprice=item.recentpurprice,
	avgprice=item.avgprice,
	itemtotalval=space(30),
	iteminquirydetail.icode,
	iteminquirydetail.rowid,
	iteminquirydetail.remarks,
	Item.saleprice,
	Item.purdiscperc,
	Item.salediscperc,
	Item.flatdisc,
	Item.packsalestax,	
	Item.gstperc1,
	Item.packunits,
	itemcode = 0,
	itemname = CASE WHEN iteminquirydetail.icode IS NULL THEN iteminquirydetail.UnKnownItemName ELSE item.name END
FROM 
	iteminquirydetail
	LEFT OUTER JOIN Item ON 	(iteminquirydetail.ICode = item.ICode)
WHERE 
	( iteminquirydetail.iteminquirycode = :ar_ICode ) 

"
  update="iteminquirydetail" updatewhere=1 updatekeyinplace=no
  arguments=(("ar_ICode", number))
)
