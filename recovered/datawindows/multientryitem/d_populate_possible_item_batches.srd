release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=long updatewhereclause=yes name=priority dbname="Priority"  )
column=(type=datetime updatewhereclause=yes name=arrivedon dbname="ArrivedOn"  )
 retrieve="SELECT 
	ICode=GD.ICode, 
	Batch=GD.Batch, 
	Expiry=GD.Expiry,
	SalePrice = (SELECT I.SalePrice FROM Item I WHERE I.ICode=GD.ICode),
	Stock = ISNULL(SUM(GD.CurrQty), 0),
	Priority = ISNULL(MAX(GD.Priority), 10),
	ArrivedOn = GETDATE()
FROM GodownDetail GD, Item I
WHERE GD.ICode = :ai_icode AND GD.ICode = I.ICode AND
	STR(GD.ICode, 10) + GD.Batch + convert(varchar(100), GD.Expiry, 121) NOT IN
		(SELECT DISTINCT STR(IBP.ICode, 10) + IBP.Batch + convert(varchar(100), IBP.Expiry, 121)
		FROM ItemBatchPricing IBP
		WHERE IBP.ICode = :ai_icode) 
GROUP BY
	GD.ICode, 
	GD.Batch, 
	GD.Expiry
/*UNION
SELECT 
	ICode=PD.ICode, 
	Batch=PD.Batch, 
	Expiry=PD.Expiry,
	SalePrice = MAX(PD.SalePrice),
	ArrivedOn = MIN(PL.Date)
FROM PurDetail PD, PurLedger PL
WHERE PL.PurInvCode=PD.PurInvCode AND PD.ICode = :ai_icode AND
	STR(PD.ICode, 10) + PD.Batch + convert(varchar(100), PD.Expiry, 121) NOT IN
		(SELECT DISTINCT STR(IBP.ICode, 10) + IBP.Batch + convert(varchar(100), IBP.Expiry, 121)
		FROM ItemBatchPricing IBP
		WHERE IBP.ICode = :ai_icode) 
GROUP BY
	PD.ICode, 
	PD.Batch, 
	PD.Expiry
UNION
SELECT 
	ICode=SD.ICode, 
	Batch=SD.Batch, 
	Expiry=SD.Expiry,
	SalePrice = MAX(SD.SalePrice),
	ArrivedOn = MIN(SL.Date)
FROM SRDetail SD, SrLedger SL
WHERE SL.SRInvCode=SD.SRInvCode AND SD.ICode = :ai_icode AND
	STR(SD.ICode, 10) + SD.Batch + convert(varchar(100), SD.Expiry, 121) NOT IN
		(SELECT DISTINCT STR(IBP.ICode, 10) + IBP.Batch + convert(varchar(100), IBP.Expiry, 121)
		FROM ItemBatchPricing IBP
		WHERE IBP.ICode = :ai_icode) 
GROUP BY
	SD.ICode, 
	SD.Batch, 
	SD.Expiry
UNION
SELECT 
	ICode=SD.ICode, 
	Batch=SD.Batch, 
	Expiry=SD.Expiry,
	SalePrice = MAX(SD.SalePrice),
	ArrivedOn = MIN(SL.Date)
FROM ReceiptDetail SD, ReceiptHeader SL
WHERE SL.ReceiptInvCode=SD.ReceiptInvCode AND SD.ICode = :ai_icode AND
	STR(SD.ICode, 10) + SD.Batch + convert(varchar(100), SD.Expiry, 121) NOT IN
		(SELECT DISTINCT STR(IBP.ICode, 10) + IBP.Batch + convert(varchar(100), IBP.Expiry, 121)
		FROM ItemBatchPricing IBP
		WHERE IBP.ICode = :ai_icode) 
GROUP BY
	SD.ICode, 
	SD.Batch, 
	SD.Expiry
UNION
SELECT 
	ICode=SD.ICode, 
	Batch=SD.Batch, 
	Expiry=SD.Expiry,
	SalePrice = MAX(SD.SalePrice),
	ArrivedOn = MIN(SL.Date)
FROM AdjDetail SD, AdjHeader SL
WHERE SL.AdjCatCode = 1 AND SL.AdjCode=SD.AdjCode AND SD.ICode = :ai_icode AND
	STR(SD.ICode, 10) + SD.Batch + convert(varchar(100), SD.Expiry, 121) NOT IN
		(SELECT DISTINCT STR(IBP.ICode, 10) + IBP.Batch + convert(varchar(100), IBP.Expiry, 121)
		FROM ItemBatchPricing IBP
		WHERE IBP.ICode = :ai_icode) 
GROUP BY
	SD.ICode, 
	SD.Batch, 
	SD.Expiry*/
ORDER BY
	ICode, 
	Batch, 
	Expiry
"
  arguments=(("ai_icode", number))
)
