table(column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="GodownDetail.Batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes name=expiry dbname="GodownDetail.Expiry"  )
column=(type=datetime update=yes updatewhereclause=yes name=manfdate dbname="GodownDetail.ManfDate"  )
column=(type=long update=yes updatewhereclause=yes name=priority dbname="GodownDetail.Priority"  )
column=(type=decimal(4) updatewhereclause=yes name=currqty dbname="GodownDetail.CurrQty"  )
column=(type=long key=yes updatewhereclause=yes name=icode dbname="GodownDetail.ICode"  )
column=(type=long key=yes updatewhereclause=yes name=gcode dbname="GodownDetail.GCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes name=locked dbname="GodownDetail.Locked" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=lockreasoncode dbname="GodownDetail.LockReasonCode" 
 values=""  )
 retrieve="SELECT
	GodownDetail.Batch,
	GodownDetail.Expiry,
	GodownDetail.ManfDate,    
	GodownDetail.Priority,   
	GodownDetail.CurrQty,   
	GodownDetail.ICode,   
	GodownDetail.GCode,
	GodownDetail.Locked,
	GodownDetail.LockReasonCode
FROM GodownDetail  
WHERE GodownDetail.ICode = :code AND
	GodownDetail.GCode IN
		(CASE (SELECT salegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)
		WHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = GodownDetail.GCode)
		ELSE (SELECT DISTINCT GCode From GroupAllowedGodown
			WHERE	GroupAllowedGodown.GroupCode = :ai_groupcode AND
				GroupAllowedGodown.Module = 1 AND
				GroupAllowedGodown.GCode = GodownDetail.GCode) END)
"
  update="GodownDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("code", number), ("ai_groupcode", number))
)
