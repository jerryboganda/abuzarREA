table(column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ItemBatchPricing.ICode"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="ItemBatchPricing.Batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes name=expiry dbname="ItemBatchPricing.Expiry"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="ItemBatchPricing.SalePrice"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=long updatewhereclause=yes name=priority dbname="Priority"  )
column=(type=datetime update=yes updatewhereclause=yes name=arrivedon dbname="ItemBatchPricing.ArrivedOn"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="ItemBatchPricing.UserCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=lastmodified dbname="ItemBatchPricing.LastModified"  )
column=(type=long update=yes updatewhereclause=yes name=lastmodifiedby dbname="ItemBatchPricing.LastModifiedBy" 
 values=""  )
 retrieve="SELECT
	ICode,
	Batch,
	Expiry,
	SalePrice,
	Stock = (SELECT SUM(GD.CurrQty) FROM GodownDetail GD WHERE GD.ICode = ItemBatchPricing.ICode AND GD.Batch = ItemBatchPricing.Batch AND GD.Expiry = ItemBatchPricing.Expiry),
	Priority = (SELECT MAX(GD.Priority) FROM GodownDetail GD WHERE GD.ICode = ItemBatchPricing.ICode AND GD.Batch = ItemBatchPricing.Batch AND GD.Expiry = ItemBatchPricing.Expiry),
	ArrivedOn,
	UserCode,
	LastModified,
	LastModifiedBy
FROM
	ItemBatchPricing 
WHERE
	ICode = :ai_icode
ORDER BY
	ICode, Batch, Expiry"
  update="ItemBatchPricing" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_icode", number))
)
