summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=long updatewhereclause=yes name=currlistrow dbname="CurrListRow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ItemSuppliers.ICode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ItemSuppliers.SuppCode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=priority dbname="ItemSuppliers.Priority"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=rate dbname="ItemSuppliers.Rate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discperc dbname="ItemSuppliers.DiscPerc"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=saleqty dbname="ItemSuppliers.SaleQty"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=bonusqty dbname="ItemSuppliers.BonusQty"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=days dbname="ItemSuppliers.Days"  )
 retrieve="SELECT 
	gcode=0,
	FullCode=(SELECT CustomICode FROM ITEM WHERE ITEM.ICode = S.ICode),
	ItemName=(SELECT Name FROM ITEM WHERE ITEM.ICode = S.ICode),
	Manufacturer=(SELECT Manufacturer.Name FROM Manufacturer, Item WHERE ITEM.ICode = S.ICode AND Item.ManfCode = Manufacturer.Manfcode),
	CurrListRow = 0,
	ICode,
	SuppCode, 
	Priority, 
	Rate, 
	DiscPerc, 
	SaleQty,
	BonusQty,
	Days
FROM ITEMSUPPLIERS S
WHERE SuppCode = :ai_suppcode
ORDER BY Manufacturer,ItemName,priority"
  update="ITEMSUPPLIERS" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_suppcode", number))
)
