release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=88 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=long updatewhereclause=yes name=priority dbname="Priority"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=long updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=long updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=long updatewhereclause=yes name=days dbname="Days"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
 retrieve="SELECT 
	ICode=I.ICODE, 
	SuppCode=:ai_suppcode, 
	Priority=ISNULL(MAX(S.Priority),0), 
	Rate=ISNULL(MAX(D.PurPRice), 0), 
	DiscPerc=ISNULL(MAX(D.DiscPerc), 0), 
	SaleQty=ISNULL(MAX(S.SaleQty),0),
	BonusQty=ISNULL(MAX(S.BonusQty),0),
	Days=ISNULL(MAX(S.Days),0),
	Manufacturer = (SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = I.ManfCode)
FROM 
	ITEM I
	LEFT OUTER JOIN ITEMSUPPLIERS AS S ON (I.ICode = S.ICode),
	PurDetail D,
	(SELECT 
		D.ICode, PurInvCode=MAX(P.PurInvCode)
	FROM 
		Purledger P, PurDetail D
	WHERE
		P.SuppCode = :ai_suppcode AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.PurInvCode = D.PurInvCode
	GROUP BY
		D.ICode) P
WHERE 
	P.PurInvCode = D.PurInvCode AND
	P.ICode = D.ICode AND
	D.ICode = I.ICode AND
	I.ICode = D.ICode AND
	S.SuppCode = :ai_suppcode
GROUP BY I.ICode,I.Name,I.ManfCode
ORDER BY I.Name"
  arguments=(("ai_suppcode", number), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
