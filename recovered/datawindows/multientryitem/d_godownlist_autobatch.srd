table(column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="GodownDetail.Batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes name=expiry dbname="GodownDetail.Expiry"  )
column=(type=datetime update=yes updatewhereclause=yes name=manfdate dbname="GodownDetail.ManfDate"  )
column=(type=long update=yes updatewhereclause=yes name=priority dbname="GodownDetail.Priority"  )
column=(type=decimal(4) updatewhereclause=yes name=currqty dbname="GodownDetail.CurrQty"  )
column=(type=long key=yes updatewhereclause=yes name=icode dbname="GodownDetail.ICode"  )
column=(type=long key=yes updatewhereclause=yes name=gcode dbname="GodownDetail.GCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="Purledger.PurInvCode"  )
column=(type=long updatewhereclause=yes name=purcatcode dbname="Purledger.PurCatCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Purledger.Date"  )
column=(type=long updatewhereclause=yes name=currencycode dbname="Purledger.CurrencyCode" 
 values=""  )
column=(type=decimal(5) updatewhereclause=yes name=conversionfactor dbname="Purledger.ConversionFactor"  )
column=(type=decimal(5) updatewhereclause=yes name=foreignprice dbname="Purdetail.ForeignPrice"  )
column=(type=decimal(16) updatewhereclause=yes name=purprice dbname="PurPrice"  )
 retrieve="SELECT 
	GodownDetail.Batch,   
	GodownDetail.Expiry,   
	GodownDetail.ManfDate,
	GodownDetail.Priority,   
	GodownDetail.CurrQty,   
	GodownDetail.ICode, 
	GodownDetail.GCode,
	P.PurInvCode,
	P.PurCatCode,
	P.Date,
	P.CurrencyCode,
	P.ConversionFactor,
	D.ForeignPrice,
	PurPrice = 
	ROUND(D.PurPrice / 
		CASE WHEN P.PurCatCode < 3 THEN 
			CASE D.PackUnits WHEN 0 THEN 1 ELSE D.PackUnits END 
		ELSE 1 END, 2) * (1 - D.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01)
	
FROM GodownDetail, PurDetail D, PurLedger P
WHERE 
	GodownDetail.ICode = :code AND
	GodownDetail.GCode IN
			(CASE (SELECT salegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)
			WHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = GodownDetail.GCode)
			ELSE (SELECT DISTINCT GCode From GroupAllowedGodown
				WHERE	GroupAllowedGodown.GroupCode = :ai_groupcode AND
					/*GroupAllowedGodown.Module = 1 AND*/
					GroupAllowedGodown.Module = :ai_module AND
					GroupAllowedGodown.GCode = GodownDetail.GCode) END) AND
	LEFT(GodownDetail.Batch, 1) = '»' AND
	GodownDetail.ICode = D.ICode AND
	GodownDetail.Batch = D.Batch AND
	D.PurRowID IN 
		(SELECT MAX(PD.PurRowID) 
		FROM PurDetail PD 
		WHERE PD.ICode = D.ICode AND PD.Batch=D.Batch) AND
	D.PurInvCode = P.PurInvCode
UNION
SELECT 
	GodownDetail.Batch,   
	GodownDetail.Expiry,   
	GodownDetail.ManfDate,
	GodownDetail.Priority,   
	GodownDetail.CurrQty,   
	GodownDetail.ICode,   
	GodownDetail.GCode,
	PurInvCode=NULL,
	PurCatCode=NULL,
	Date=NULL,
	Currency=NULL,
	ConversionFactor=NULL,
	ForeignPrice=NULL,
	PurPrice = NULL
FROM GodownDetail
WHERE GodownDetail.ICode = :code AND
	GodownDetail.GCode IN
			(CASE (SELECT salegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)
			WHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = GodownDetail.GCode)
			ELSE (SELECT DISTINCT GCode From GroupAllowedGodown
				WHERE	GroupAllowedGodown.GroupCode = :ai_groupcode AND
					/*GroupAllowedGodown.Module = 1 AND*/
					GroupAllowedGodown.Module = :ai_module AND
					GroupAllowedGodown.GCode = GodownDetail.GCode) END) AND
	LEFT(GodownDetail.Batch, 1) <> '»'
"
  update="GodownDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("code", number), ("ai_groupcode", number), ("ai_module", number))
)
