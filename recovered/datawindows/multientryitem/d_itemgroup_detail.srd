header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ItemGroupDetail.ItemGroupCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ItemGroupDetail.icode"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
 retrieve="Select gi.ItemGroupCode,
		 gi.icode,
		 CurrListRow = 0,
		 aliasname = i.customicode,
		 i.name
From   itemgroupdetail gi, ItemGroup IG, Item i
Where  
	    ig.ItemGroupCode = :ai_code AND
		ig.ItemGroupCode = gi.ItemGroupCode AND
		gi.ICode = i.ICode
ORDER BY
	GI.ItemGroupCode,
	I.Name
"
  update="itemgroupdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
