summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=144 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="imppurinvcode"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="Itemtotalval"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="invtotal"  )
 retrieve="SELECT 
	imppurinvcode=dbo.imppurheader.imppurinvcode,   
	icode=0,
	stock=0.0000, 
	totalstock=0.0000,
	Itemtotalval=space(30),
	invtotal=0.00
FROM
	dbo.imppurheader   
WHERE
	dbo.imppurheader.ImpPurInvCode = :ai_PurInvCode
"
  arguments=(("ai_PurInvCode", number))
)
