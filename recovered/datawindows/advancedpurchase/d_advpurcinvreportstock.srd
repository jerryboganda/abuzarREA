column=(type=decimal(2) updatewhereclause=yes name=itemflatdiscafterdiscperc dbname="itemflatdiscafterdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc2 dbname="AdvPurDetail.discperc2"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="AdvPurDetail.gstperc"  )
