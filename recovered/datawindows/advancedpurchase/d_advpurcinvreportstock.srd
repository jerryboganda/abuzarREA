column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=decimal(8) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=long updatewhereclause=yes name=purledger_purinvcode dbname="purinvcode"  )
column=(type=decimal(5) updatewhereclause=yes name=netrate dbname="netrate"  )
