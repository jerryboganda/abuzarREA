header(height=68 color="536870912" )
summary(height=56 color="536870912" )
footer(height=0 color="536870912" )
detail(height=56 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ImpPurExp.ImpPurInvCode"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="L" name=expensetype dbname="ImpPurExp.ExpenseType" 
 values=""  )
column=(type=long key=yes update=yes updatewhereclause=yes name=acccode dbname="ImpPurExp.AccCode" 
 values=""  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="ImpPurExp.RowID"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=foreignamt dbname="ImpPurExp.ForeignAmt"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=localamt dbname="ImpPurExp.LocalAmt"  )
 retrieve="SELECT 
	dbo.imppurexp.ImpPurInvCode,
	dbo.imppurexp.ExpenseType,
	dbo.imppurexp.AccCode,
	dbo.imppurexp.RowID, 
	dbo.imppurexp.ForeignAmt,
	dbo.imppurexp.LocalAmt
FROM
	dbo.imppurexp
WHERE
	dbo.imppurexp.ImpPurInvCode = :ai_PurInvCode
"
  update="imppurexp" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_PurInvCode", number))
 sort="expensetype A, acccode A, rowid A"
)
group(level=1 header.height=0 trailer.height=0 by=("expensetype"  ) header.color="536870912" trailer.color="536870912" )
