table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ImpPurInvCode"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="usercode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="date"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=headerno dbname="headerno" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=currencycode dbname="currencycode" 
 values=""  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="conversionfactor > 0" initial="1.00000" name=conversionfactor dbname="conversionfactor"  )
column=(type=char(60) update=yes updatewhereclause=yes name=container dbname="Container"  )
column=(type=char(60) update=yes updatewhereclause=yes name=refno1 dbname="RefNo1"  )
column=(type=char(60) update=yes updatewhereclause=yes name=refno2 dbname="RefNo2"  )
column=(type=char(60) update=yes updatewhereclause=yes name=refno3 dbname="RefNo3"  )
column=(type=char(60) update=yes updatewhereclause=yes name=refno4 dbname="RefNo4"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=foreignamt dbname="ForeignAmt"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=invtotal dbname="InvTotal"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=finalized dbname="Finalized"  )
column=(type=long update=yes updatewhereclause=yes name=finalizedby dbname="FinalizedBy"  )
column=(type=datetime update=yes updatewhereclause=yes name=finalizeddate dbname="FinalizedDate"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="posted"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="postedBy"  )
column=(type=datetime update=yes updatewhereclause=yes name=posteddate dbname="posteddate"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="username"  )
column=(type=decimal(2) updatewhereclause=yes name=totalexpenses dbname="TotalExpenses"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=glvochcode dbname="GLVochCode"  )
 retrieve="SELECT   
	ImpPurInvCode=ImpPurHeader.ImpPurInvCode,   
	usercode=ImpPurHeader.usercode,   
	date=ImpPurHeader.date,   
	headerno=ImpPurHeader.headerno,
	currencycode=ImpPurHeader.currencycode,
	conversionfactor=ImpPurHeader.conversionfactor,
	Container=ImpPurHeader.Container,
	RefNo1=ImpPurHeader.RefNo1,
	RefNo2=ImpPurHeader.RefNo2,
	RefNo3=ImpPurHeader.RefNo3,
	RefNo4=ImpPurHeader.RefNo4,
	remarks=ImpPurHeader.remarks, 
	ForeignAmt=ImpPurHeader.ForeignAmt, 
	InvTotal=ImpPurHeader.InvTotal, 
	Finalized=ImpPurHeader.Finalized,
	FinalizedBy=ImpPurHeader.FinalizedBy,
	FinalizedDate=ImpPurHeader.FinalizedDate,
	posted=ImpPurHeader.posted,   
	postedBy=ImpPurHeader.postedBy,
	posteddate=ImpPurHeader.posteddate,
	username=users.username,   
	TotalExpenses=0.00,
	gcode=0,
	GLVochCode=ImpPurHeader.GLVochCode
FROM 
	ImpPurHeader,   
	users
WHERE 
	ImpPurHeader.usercode = users.usercode AND
	dbo.ImpPurHeader.ImpPurInvCode = :ai_purinvcode
"
  update="ImpPurHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_PurInvCode", number))
)
