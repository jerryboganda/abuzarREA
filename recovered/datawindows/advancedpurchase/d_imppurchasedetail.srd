column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <=100" initial="0" name=discperc dbname="discperc"  )
 retrieve="SELECT
	item.customicode,
	item.name, 
	currlistrow = 0,
	totalstock=0.0000,
	stock=0.0000,
	itemtotalval=space(30),
	packingdesc=item.packingdesc,
	suppcode=dbo.ImpPurDetail.suppcode,
	icode=dbo.ImpPurDetail.icode,
	batch=dbo.ImpPurDetail.batch,
	expiry=dbo.ImpPurDetail.expiry,
	gcode=dbo.ImpPurDetail.gcode,
	packqty=dbo.ImpPurDetail.packqty,   
	looseqty=dbo.ImpPurDetail.looseqty,
	bonusqty=dbo.ImpPurDetail.bonusqty,
	foreignprice=dbo.ImpPurDetail.foreignprice,
	packunits=dbo.ImpPurDetail.packunits,      
	measureunitcode=dbo.ImpPurDetail.measureunitcode,
	MeasureQty=(SELECT M.MeasureQty FROM DBO.MeasuringUnit M WHERE M.measureunitcode = ImpPurDetail.measureunitcode),
	measureunitrate=dbo.ImpPurDetail.measureunitrate,
	retailprice=dbo.ImpPurDetail.retailprice,
	purprice=dbo.ImpPurDetail.purprice,   
	purprice2=dbo.ImpPurDetail.purprice2,   
	purprice3=dbo.ImpPurDetail.purprice3,   
	purprice4=dbo.ImpPurDetail.purprice4,   
	itemflatdisc=dbo.ImpPurDetail.itemflatdisc,
	itemflatdiscafterdiscperc=dbo.ImpPurDetail.itemflatdiscafterdiscperc,
	itemflatdisc2=dbo.ImpPurDetail.itemflatdisc2,
	discperc2=dbo.ImpPurDetail.discperc2,	
	valuedisconitem=dbo.ImpPurDetail.valuedisconitem,
	ImpPurInvCode=dbo.ImpPurDetail.ImpPurInvCode,
	avgprice=dbo.ImpPurDetail.avgprice,
	dbo.ImpPurDetail.IDENTITYCOL,
	newavgprice=dbo.ImpPurDetail.newavgprice,
	currstock=dbo.ImpPurDetail.currstock,
	purutn=dbo.ImpPurDetail.purutn ,
	UnitIncomeTaxRuleCode=UnitIncomeTaxRuleCode,
	UnitIncomeTax=UnitIncomeTax,
	PercIncomeTaxRuleCode=PercIncomeTaxRuleCode,
	PercIncomeTax=PercIncomeTax,
	UnitAdditionalTaxRuleCode=UnitAdditionalTaxRuleCode,
	UnitAdditionalTax=UnitAdditionalTax,
	PercAdditionalTaxRuleCode=PercAdditionalTaxRuleCode,
	PercAdditionalTax=PercAdditionalTax,
	UnitExtraTaxRuleCode=UnitExtraTaxRuleCode,
	UnitExtraTax=UnitExtraTax,
	PercExtraTaxRuleCode=PercExtraTaxRuleCode,
	PercExtraTax=PercExtraTax,
	UnitCustomDutyRuleCode=UnitCustomDutyRuleCode,
	UnitCustomDuty=UnitCustomDuty,
	PercCustomDutyRuleCode=PercCustomDutyRuleCode,
	PercCustomDuty=PercCustomDuty,
	unittaxrulecode=dbo.ImpPurDetail.unittaxrulecode,
	gsttypecode=dbo.ImpPurDetail.gsttypecode,
	gstrulecode=dbo.ImpPurDetail.gstrulecode,
	gstperc=dbo.ImpPurDetail.gstperc,
	unitsalestax=dbo.ImpPurDetail.unitsalestax,
	saleprice=dbo.ImpPurDetail.saleprice,
	expenseperc=0.00,
	rate=dbo.ImpPurDetail.rate,
	NetRate=dbo.ImpPurDetail.NetRate,
	NetDiscountedRate=dbo.ImpPurDetail.NetDiscountedRate,
	ProfitPerc=dbo.ImpPurDetail.ProfitPerc,
	itemdescription=dbo.ImpPurDetail.itemdescription,
	salepriceforitem=dbo.ImpPurDetail.salepriceforitem,
	discperc=dbo.ImpPurDetail.discperc
FROM 
	dbo.ImpPurDetail , 
	dbo.item 
WHERE 
	dbo.ImpPurDetail.ImpPurInvCode = :ai_PurInvCode AND
	dbo.ImpPurDetail.icode = dbo.item.icode
ORDER BY
	dbo.ImpPurDetail.IDENTITYCOL"
  update="ImpPurDetail" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_PurInvCode", number))
)
