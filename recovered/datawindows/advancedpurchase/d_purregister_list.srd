table(column=(type=long updatewhereclause=yes name=code dbname="PurRegister.purregistercode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(100) updatewhereclause=yes name=lotno dbname="LotNo"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(100) updatewhereclause=yes name=referenceno dbname="referenceno"  )
column=(type=decimal(2) updatewhereclause=yes name=totalamount dbname="totalamount"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
 retrieve="SELECT  
	purregister.purregistercode, 
	date=purregister.date , 
	LotNo = dbo.purregister.lotno, 
	remarks=dbo.purregister.remarks, 
	referenceno=dbo.purregister.referenceno, 
	totalamount=dbo.purregister.totalamount,
	accounts.name,
	username=(select username from users where users.usercode=purregister.usercode),
	posted = purregister.posted
FROM  
	purregister ,  
	accounts     
WHERE  ( purregister.suppcode = accounts.acccode ) and 
	( Posted IN (:as_Posted))"
  arguments=(("as_Posted", stringlist))
)
