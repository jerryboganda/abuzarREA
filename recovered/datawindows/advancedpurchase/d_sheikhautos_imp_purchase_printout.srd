column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=decimal(5) updatewhereclause=yes name=foreignprice dbname="ForeignPrice"  )
column=(type=decimal(5) updatewhereclause=yes name=purprice dbname="PurPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=netdiscountedrate dbname="NetDiscountedRate"  )
column=(type=decimal(2) updatewhereclause=yes name=profitperc dbname="ProfitPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=salepriceforitem dbname="SalePriceForItem"  )
column=(type=long updatewhereclause=yes name=expensetype dbname="ExpenseType"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Aliasname"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=decimal(2) updatewhereclause=yes name=foreignexpamt dbname="ForeignExpAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=localamt dbname="LocalAmt"  )
 retrieve="SELECT  
	GroupType = 'I',
	ImpPurInvCode=H.ImpPurInvCode,	
	Date=H.Date,
	UserName = (Select Users.UserName FROM Users WHERE Users.UserCode=H.UserCode),
	HeaderNo=H.HeaderNo,
	Currency = (Select C.Name FROM Currency C WHERE C.CurrencyCode=H.CurrencyCode),
	ExchangeRate = H.ConversionFactor,
	Container = H.Container,
	RefNo1 = H.RefNo1,
	RefNo2 = H.RefNo2,
	RefNo3 = H.RefNo3,
	RefNo4 = H.RefNo4,
	Remarks = H.Remarks,
	ForeignAmt=H.ForeignAmt,
	InvTotal = H.InvTotal,
	Finalized = H.Finalized,
	Posted = H.Posted,
	GlVochcode=H.GlVochcode,
	ICode = D.ICode,
	CustomICode = I.CustomICode,
	ItemName = I.Name,
	Batch = D.Batch,
	Expiry = D.Expiry,
	Qty = D.PackQty,
	BonusQty = D.BonusQty,
	ForeignPrice=D.ForeignPrice,
	PurPrice=(D.PurPrice + D.PurPrice2 + D.PurPrice3 + D.PurPrice4),
	NetDiscountedRate = D.NetDiscountedRate,
	ProfitPerc=D.ProfitPerc,
	SalePriceForItem=D.SalePriceForItem,
	ExpenseType=NULL,
	AccCode = D.SuppCode,
	Aliasname=A.AliasName,
	AccountName= A.Name,
	ForeignExpAmt = 0.00,
	LocalAmt = 0.00	
FROM ImpPurHeader H, ImpPurDetail D, Item I, Accounts A
WHERE
	H.ImpPurInvCode=:ai_code AND 
	H.ImpPurInvCode = D.ImpPurInvCode AND
	D.ICode = I.ICode AND
	D.SuppCode = A.Acccode
ORDER BY
	GroupType,
	ItemName,
	AccountName"
  arguments=(("ai_code", number))
 sort="grouptype A, accountname A, itemname A"
)
