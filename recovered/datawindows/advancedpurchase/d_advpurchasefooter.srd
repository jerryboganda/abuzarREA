 retrieve="SELECT
	invgstperc1=dbo.advpurheader.invgstperc1,
	advpurinvcode=dbo.advpurheader.advpurinvcode,   
	purinvcode=dbo.advpurheader.purinvcode,   
	discperc=dbo.advpurheader.discperc,   
	flatdisc=dbo.advpurheader.flatdisc,   
	flatdisc2=dbo.advpurheader.flatdisc2,   
	misccharges=dbo.advpurheader.misccharges,   
	misccharges2=dbo.advpurheader.misccharges2,   
	FlatIncomeTax=FlatIncomeTax,
	PercIncomeTax=PercIncomeTax,
	FlatAdditionalTax=FlatAdditionalTax,
	PercAdditionalTax=PercAdditionalTax,
	FlatExtraTax=FlatExtraTax,
	PercExtraTax=PercExtraTax,
	FlatCustomDuty=FlatCustomDuty,
	PercCustomDuty=PercCustomDuty,
	FlatExciseDuty=FlatExciseDuty,
	PercExciseDuty=PercExciseDuty,
	FreightLocal=FreightLocal,
	FreightForeign=FreightForeign,
	icode=0,
	stock=0.0000,
	totalstock=0.0000,
	Itemtotalval=space(30),
	total=0.00
FROM
	dbo.advpurheader   
WHERE
	dbo.advpurheader.AdvPurInvCode = :ai_PurInvCode
"
  arguments=(("ai_PurInvCode", number))
)
