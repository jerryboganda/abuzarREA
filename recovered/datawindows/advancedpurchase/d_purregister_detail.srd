release 12.5;
datawindow ( units=0 timer_interval=60000 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=124 color="536870912" )
summary(height=0 color="536870912" )
footer(height=68 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PurRegisterCode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=qty dbname="qty"  )
column=(type=long update=yes updatewhereclause=yes validation="Real (GetText()) > 0" initial="1" name=packunits dbname="packunits"  )
column=(type=long update=yes updatewhereclause=yes validation="Real (GetText()) > 0" validationmsg="~"Please enter valid quantity for total pieces~"" initial="1" name=totalpieces dbname="totalpieces"  )
column=(type=long updatewhereclause=yes initial="0" name=piecesinhand dbname="PiecesInHand"  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="RowId"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=purprice dbname="purprice"  )
 retrieve="SELECT 
	PurRegisterCode = DBO.PurRegisterDetail.PurRegisterCode,
	item.customicode,
	item.name, 
	currlistrow = 0,
	totalstock=0.0000,
	stock=0.0000,
	itemtotalval=space(30),
	packingdesc=item.packingdesc,
	icode=dbo.purregisterdetail.icode,
	qty=dbo.purregisterdetail.qty,   
	packunits=dbo.purregisterdetail.packunits,      
	totalpieces=dbo.purregisterdetail.totalpieces,
	PiecesInHand = 0,
	RowId = dbo.purregisterdetail.RowId,
	purprice=dbo.purregisterdetail.purprice
FROM 
	dbo.PurRegisterDetail , 
	dbo.item
WHERE
	dbo.PurRegisterDetail.purregistercode = :ai_Code AND
	dbo.PurRegisterDetail.icode = dbo.item.icode
ORDER BY
	dbo.PurRegisterDetail.IDENTITYCOL
"
  update="PurRegisterDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_Code", number))
)
