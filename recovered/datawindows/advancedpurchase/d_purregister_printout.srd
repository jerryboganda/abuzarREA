release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=1000 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2312 color="536870912" )
summary(height=1354 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=long updatewhereclause=yes name=purregistercode dbname="PurRegister.PurRegisterCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurRegister.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="PurRegister.posted"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="PurRegister.suppcode"  )
column=(type=char(74) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=char(100) updatewhereclause=yes name=lotno dbname="PurRegister.LotNo"  )
column=(type=char(100) updatewhereclause=yes name=referenceno dbname="PurRegister.ReferenceNo"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="PurRegister.Remarks"  )
column=(type=long updatewhereclause=yes name=suppliertotalpieces dbname="SupplierTotalPieces"  )
column=(type=decimal(4) updatewhereclause=yes name=totalmeasure dbname="PurRegister.TotalMeasure"  )
column=(type=decimal(2) updatewhereclause=yes name=totalamount dbname="PurRegister.TotalAmount"  )
column=(type=long updatewhereclause=yes name=icode dbname="PurRegisterDetail.icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=totalpieces dbname="TotalPieces"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(5) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="rowid"  )
 retrieve="SELECT 
	dbo.PurRegister.PurRegisterCode, 
	dbo.PurRegister.date, 
	dbo.PurRegister.posted, 
	dbo.PurRegister.suppcode, 
	SupplierName=RTRIM(LTRIM(dbo.accounts.name)) + '(' + LTRIM(RTRIM(dbo.Accounts.AliasName)) + ')',
	dbo.PurRegister.LotNo,
	dbo.PurRegister.ReferenceNo,
	dbo.PurRegister.Remarks,
	SupplierTotalPieces=dbo.PurRegister.TotalPieces,  
	dbo.PurRegister.TotalMeasure,
	dbo.PurRegister.TotalAmount,  
	dbo.PurRegisterDetail.icode,  
	AliasName= (SELECT dbo.item.CustomICode FROM dbo.item WHERE dbo.item.icode=dbo.purregisterdetail.icode),
	itemname= (SELECT dbo.item.name FROM dbo.item WHERE dbo.item.icode=dbo.purregisterdetail.icode),
	TotalPieces= ISNULL(dbo.PurRegisterDetail.TotalPieces, 0),  
	qty=ISNULL(PurRegisterDetail.qty, 0),
	packunits = ISNULL(dbo.PurRegisterDetail.packunits, 0), 
	purprice = ISNULL(dbo.PurRegisterDetail.purprice,  0),
	rowid= dbo.PurRegisterDetail.IDENTITYCOL
FROM	
	dbo.PurRegister
	LEFT OUTER JOIN dbo.PurRegisterDetail ON (dbo.PurRegister.PurRegisterCode = dbo.PurRegisterDetail.PurRegisterCode),
	dbo.accounts
WHERE	
	( ( dbo.PurRegister.PurRegisterCode = :ra_InvCode ) ) and 
	(dbo.PurRegister.suppcode = dbo.accounts.acccode)
ORDER BY 
	ItemName,
	AliasName
"
  arguments=(("ra_InvCode", number))
)
