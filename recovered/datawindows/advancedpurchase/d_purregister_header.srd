table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PurRegister.PurRegisterCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="PurRegister.Date"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long update=yes updatewhereclause=yes name=suppcode dbname="PurRegister.SuppCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="PurRegister.UserCode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=areacode dbname="PurRegister.AreaCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=icatcode dbname="PurRegister.ICatCode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=lotno dbname="PurRegister.LotNo"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GETTEXT()) > 0" validationmsg="~"Please enter valid quantity for total pieces~"" initial="1" name=totalpieces dbname="PurRegister.TotalPieces"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GETTEXT()) > 0" validationmsg="~"Please enter valid quantity for total measurement~"" initial="1" name=totalmeasure dbname="PurRegister.TotalMeasure"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GETTEXT()) > 0" validationmsg="~"Please enter valid amount~"" initial="1" name=totalamount dbname="PurRegister.TotalAmount"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="PurRegister.Remarks"  )
column=(type=char(100) update=yes updatewhereclause=yes name=referenceno dbname="PurRegister.ReferenceNo"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="PurRegister.Posted"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=postdate dbname="PurRegister.PostDate"  )
 retrieve="SELECT 
	PurRegister.PurRegisterCode,   
	PurRegister.Date, 
	AliasName = (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = PurRegister.SuppCode),
	PurRegister.SuppCode,   
	PurRegister.UserCode,   
	PurRegister.AreaCode,   
	PurRegister.ICatCode,   
	PurRegister.LotNo,   
	PurRegister.TotalPieces,   
	PurRegister.TotalMeasure,   
	PurRegister.TotalAmount,   
	PurRegister.Remarks,   
	PurRegister.ReferenceNo,   
	PurRegister.Posted,   
	PurRegister.PostDate  
FROM 
	PurRegister   
WHERE 
	PurRegister.PurRegisterCode = :ai_code"
  update="PurRegister" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
