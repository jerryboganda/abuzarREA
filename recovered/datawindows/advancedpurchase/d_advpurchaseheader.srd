 retrieve="SELECT   
	advpurinvcode=advpurheader.advpurinvcode,   
	purinvcode=advpurheader.purinvcode,   
	purcatcode=advpurheader.purcatcode,
	purtypecode=advpurheader.purtypecode,
	printbalance=advpurheader.printbalance,
	suppinvdate=advpurheader.suppinvdate,
	grn=advpurheader.grn,
	aliasname='            ',
	suppcode=advpurheader.suppcode,   
	suppinvcode=advpurheader.suppinvcode,
	pocode=advpurheader.pocode,   
	usercode=advpurheader.usercode,   
	date=advpurheader.date,   
	discperc=advpurheader.discperc,   
	flatdisc=advpurheader.flatdisc,   
	flatdisc2=advpurheader.flatdisc2,   
	misccharges=advpurheader.misccharges,   
	misccharges2=advpurheader.misccharges2,   
	posted=advpurheader.posted,   
	postdate=advpurheader.postdate,   
	remarks=advpurheader.remarks, 
	invtotal=advpurheader.invtotal,  
	users.username,   
	supplier.address1,   
	supplier.city,   
	supplier.phone,   
	podate=Getdate(),   
	manfname='                                        '  ,   
	manfcode=0,
	originaldate=advpurheader.originaldate,
	modifiedby=advpurheader.modifiedby,
	postedby=advpurheader.postedby,
	porb=advpurheader.porb,
	headerno=advpurheader.headerno,
	gcode=0,
	suppbalance=0.00,
	creditordebit=' ',
	purinvpagesize=dbo.advpurheader.purinvpagesize,
	invgstperc1=advpurheader.invgstperc1,
	AccountFor=advpurheader.AccountFor,
	PaymentMode=advpurheader.PaymentMode,
	PaymentAccCode=advpurheader.PaymentAccCode,
	Amt=advpurheader.Amt,
	AmtBy=advpurheader.AmtBy,
	AmtDate=advpurheader.AmtDate,
	AmtReference=advpurheader.AmtReference,
	Outstandingamt=advpurheader.Outstandingamt,
	currencycode=advpurheader.currencycode,
	conversionfactor=advpurheader.conversionfactor,
	FlatIncomeTax=FlatIncomeTax,
	PercIncomeTax=PercIncomeTax,
	FlatAdditionalTax=FlatAdditionalTax,
	PercAdditionalTax=PercAdditionalTax,
	FlatExtraTax=FlatExtraTax,
	PercExtraTax=PercExtraTax,
	FlatCustomDuty=FlatCustomDuty,
	PercCustomDuty=PercCustomDuty,
	FlatExciseDuty=FlatExciseDuty,
	PercExciseDuty=PercExciseDuty,
	FreightLocal=FreightLocal,
	FreightForeign=FreightForeign
FROM 
	advpurheader,   
	users,   
	supplier,
	accounts
WHERE
	advpurheader.suppcode = supplier.suppcode AND
	advpurheader.suppcode = accounts.acccode AND
	advpurheader.usercode = users.usercode AND
	dbo.advpurheader.advpurinvcode = :ai_purinvcode
"
  update="advpurheader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_PurInvCode", number))
)
