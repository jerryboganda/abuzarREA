column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=decimal(5) updatewhereclause=yes name=foreignexpamt dbname="ForeignExpAmt"  )
column=(type=decimal(5) updatewhereclause=yes name=localamt dbname="LocalAmt"  )
 retrieve="SELECT  
	GroupType = 'I',
	ImpPurInvCode=H.ImpPurInvCode,	
	Date=H.Date,
	UserName = (Select Users.UserName FROM Users WHERE Users.UserCode=H.UserCode),
	HeaderNo=H.HeaderNo,
	Currency = (Select C.Name FROM Currency C WHERE C.CurrencyCode=H.CurrencyCode),
	ExchangeRate = H.ConversionFactor,
	Container = H.Container,
	RefNo1 = H.RefNo1,
	RefNo2 = H.RefNo2,
	RefNo3 = H.RefNo3,
	RefNo4 = H.RefNo4,
	Remarks = H.Remarks,
	ForeignAmt=H.ForeignAmt,
	InvTotal = H.InvTotal,
	Finalized = H.Finalized,
	Posted = H.Posted,
	GlVochcode=H.GlVochcode,
	ICode = D.ICode,
	CustomICode = I.CustomICode,
	ItemName = I.Name,
	Batch = D.Batch,
	Expiry = D.Expiry,
	Qty = D.PackQty,
	BonusQty = D.BonusQty,
	ForeignPrice=D.ForeignPrice,
	PurPrice=(D.PurPrice + D.PurPrice2 + D.PurPrice3 + D.PurPrice4),
	NetDiscountedRate = D.NetDiscountedRate,
	ProfitPerc=D.ProfitPerc,
	SalePriceForItem=D.SalePriceForItem,
	ExpenseType=NULL,
	AccCode = D.SuppCode,
	Aliasname=A.AliasName,
	AccountName= A.Name,
	ForeignExpAmt = 0.00,
	LocalAmt = 0.00	
FROM ImpPurHeader H, ImpPurDetail D, Item I, Accounts A
WHERE
	H.ImpPurInvCode=:ai_code AND 
	H.ImpPurInvCode = D.ImpPurInvCode AND
	D.ICode = I.ICode AND
	D.SuppCode = A.Acccode
UNION ALL
SELECT 
	GroupType = 'E',
	ImpPurInvCode=H.ImpPurInvCode,	
	Date=H.Date,
	UserName = (Select Users.UserName FROM Users WHERE Users.UserCode=H.UserCode),
	HeaderNo=H.HeaderNo,
	Currency = (Select C.Name FROM Currency C WHERE C.CurrencyCode=H.CurrencyCode),
	ExchangeRate = H.ConversionFactor,
	Container = H.Container,
	RefNo1 = H.RefNo1,
	RefNo2 = H.RefNo2,
	RefNo3 = H.RefNo3,
	RefNo4 = H.RefNo4,
	Remarks = H.Remarks,
	ForeignAmt=H.ForeignAmt,
	InvTotal = H.InvTotal,
	Finalized = H.Finalized,
	Posted = H.Posted,
	GlVochcode=H.GlVochcode,
	ICode = NULL,
	CustomICode = NULL,
	ItemName = NULL,
	Batch = NULL,
	Expiry = NULL,
	Qty = 0.0000,
	BonusQty = 0.0000,
	ForeignPrice=0.00,
	PurPrice=0.00,
	NetDiscountedRate = 0.00,
	ProfitPerc=0,
	SalePriceForItem=0,
	ExpenseType=D.ExpenseType,
	AccCode = D.AccCode,
	Aliasname=A.AliasName,
	AccountName = A.Name,
	ForeignExpAmt = D.ForeignAmt,
	LocalAmt = D.LocalAmt	
FROM ImpPurHeader H, ImpPurExp D, Accounts A
WHERE 
	H.ImpPurInvCode=:ai_code AND 
	H.ImpPurInvCode = D.ImpPurInvCode AND
	D.AccCode = A.AccCode
ORDER BY
	GroupType,
	ItemName,
	AccountName"
  arguments=(("ai_code", number))
 sort="grouptype A, accountname A, itemname A"
)
