summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=purinvcode dbname="purinvcode"  )
column=(type=long updatewhereclause=yes name=advpurinvcode dbname="advpurinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=long updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(7) updatewhereclause=yes name=invtype dbname="invtype"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(4) updatewhereclause=yes name=quantity dbname="quantity"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(8) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(13) updatewhereclause=yes name=loosesaleprice dbname="loosesaleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=packsaleprice dbname="packsaleprice"  )
column=(type=decimal(5) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(30) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=person dbname="Person"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=long updatewhereclause=yes name=pocode dbname="POCode"  )
column=(type=long updatewhereclause=yes name=postatus dbname="POStatus"  )
column=(type=decimal(0) updatewhereclause=yes name=purrowid dbname="purrowid"  )
 retrieve="SELECT
	purinvcode = dbo.advpurheader.purinvcode,    
	advpurinvcode = dbo.advpurheader.advpurinvcode, 
	date = dbo.advpurheader.date,   
	invdiscperc = dbo.advpurheader.discperc,    
	invgstperc1 = dbo.advpurheader.invgstperc1,
	flatdisc = dbo.advpurheader.flatdisc,    
	misccharges = dbo.advpurheader.misccharges, 
	invsalestax = 0, 
	aliasname=item.customicode,
	invtype = Case dbo.advpurheader.purcatcode 	When 1 Then 'Pack' 	
														When 2 Then 'Pack' 
														When 7 Then 'Loose '
														When 8 Then 'Loose '
														Else 'Opening' End,  	   
	looseqty = dbo.advpurdetail.looseqty, 
	packqty  = advpurdetail.packqty, 
	quantity = dbo.advpurdetail.looseqty + advpurdetail.packqty, 
	bonusqty  = advpurdetail.bonusqty, 	  
	unitsalestax  = advpurdetail.unitsalestax, 
	gstperc = advpurdetail.gstperc,	
	saleprice = CASE advpurheader.purcatcode When 1 Then advpurdetail.salepriceforitem
													When 2 Then advpurdetail.salepriceforitem
													When 3 Then Round(advpurdetail.salepriceforitem / advpurdetail.packunits, 2)
													When 7 Then Round(advpurdetail.salepriceforitem / advpurdetail.packunits, 2)
													When 8 Then Round(advpurdetail.salepriceforitem / advpurdetail.packunits, 2)
	
				 END	,
	loosesaleprice=(item.saleprice/(Case when item.packunits=0 then 1 else item.packunits end)),
	packsaleprice=item.saleprice,
	price = dbo.advpurdetail.purprice,    
	itemdiscperc = dbo.advpurdetail.discperc,    
	packunits = dbo.advpurdetail.packunits,    
	packing=  case when (dbo.item.packcode is null) then space(30)
				 else  dbo.itempacking.name
			  end,
	batch = dbo.advpurdetail.batch,    
	expiry = dbo.advpurdetail.expiry,    
	itemname = item.name,
	datestring = Rtrim(LTrim(Str(DatePart(dd, advpurheader.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, advpurheader.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, advpurheader.date)))), 
	Person = dbo.accounts.name,
	Posted=dbo.advpurheader.posted,
	POCode = dbo.advpurheader.POCode,
	POStatus = CASE WHEN dbo.advpurheader.POCode > 0 THEN CASE WHEN dbo.advpurdetail.ICode = (SELECT PD.ICode FROM PurOrderDetail PD WHERE PD.POCode = dbo.advpurheader.POCode AND PD.Icode = dbo.advpurdetail.ICode AND dbo.AdvPurDetail.PackQty = PD.Qty) THEN 1 ELSE 2 END ELSE 0 END,
	purrowid=dbo.advpurdetail.purrowid
FROM 	 
	dbo.advpurheader
	LEFT OUTER JOIN purchasetype ON (advpurheader.purtypecode = purchasetype.purtypecode),
	dbo.advpurdetail,
	dbo.accounts, 
	item
	LEFT OUTER JOIN itempacking ON (item.packcode = itempacking.packcode)
WHERE  
	dbo.advpurheader.advpurinvcode = :ai_invcode and
	dbo.advpurheader.purcatcode IN (1, 2, 3, 7, 8) and
	dbo.advpurheader.advpurinvcode = dbo.advpurdetail.advpurinvcode and  
	dbo.advpurdetail.icode = item.icode and 
	dbo.advpurheader.suppcode = dbo.accounts.acccode
UNION ALL
SELECT
	purinvcode = dbo.advpurheader.purinvcode,    
	advpurinvcode = dbo.advpurheader.advpurinvcode, 
	date = dbo.advpurheader.date,   
	invdiscperc = dbo.advpurheader.discperc,    
	invgstperc1 = dbo.advpurheader.invgstperc1,
	flatdisc = dbo.advpurheader.flatdisc,    
	misccharges = dbo.advpurheader.misccharges, 
	invsalestax = 0, 
	aliasname=item.customicode,
	invtype = Case dbo.advpurheader.purcatcode 	When 1 Then 'Pack' 	
														When 2 Then 'Pack' 
														When 7 Then 'Loose '
														When 8 Then 'Loose '
														Else 'Opening' End,  	   
	looseqty = 0, 
	packqty  = 0, 
	quantity = dbo.purorderdetail.qty, 
	bonusqty  = dbo.purorderdetail.bonusqty, 	  
	unitsalestax  = 0, 
	gstperc = dbo.purorderdetail.gstperc,	
	saleprice = 0,
	loosesaleprice=(item.saleprice/(Case when item.packunits=0 then 1 else item.packunits end)),
	packsaleprice=0,
	price = 0,    
	itemdiscperc = dbo.purorderdetail.discperc,    
	packunits = dbo.purorderdetail.packunits,    
	packing=  case when (dbo.item.packcode is null) then space(30)
				 else  dbo.itempacking.name
			  end,
	batch = dbo.purorderdetail.batch,    
	expiry = dbo.purorderdetail.expiry,    
	itemname = item.name,
	datestring = Rtrim(LTrim(Str(DatePart(dd, advpurheader.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, advpurheader.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, advpurheader.date)))), 
	Person = dbo.accounts.name,
	Posted=dbo.advpurheader.posted,
	POCode = dbo.advpurheader.POCode,
	POStatus = 3,
	purrowid=9999999999
FROM 	 
	dbo.advpurheader
	LEFT OUTER JOIN purchasetype ON (advpurheader.purtypecode = purchasetype.purtypecode),
	dbo.purorderdetail,
	dbo.accounts, 
	item
	LEFT OUTER JOIN itempacking ON (item.packcode = itempacking.packcode)
WHERE  
	dbo.advpurheader.advpurinvcode = :ai_invcode and
	dbo.advpurheader.purcatcode IN (1, 2, 3, 7, 8) and
	dbo.advpurheader.pocode = dbo.purorderdetail.pocode AND
	dbo.purorderdetail.icode = item.icode and 
	dbo.advpurheader.suppcode = dbo.accounts.acccode and
	dbo.purorderdetail.ICode NOT IN (SELECT DISTINCT PD.ICode FROM AdvPurDetail PD WHERE PD.AdvPurInvCode = :ai_invcode)
order by 
	purrowid, dbo.item.name
"
  arguments=(("ai_invcode", number))
 sort="purrowid A, itemname A"
)
