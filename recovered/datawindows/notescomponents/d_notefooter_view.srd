table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Notes.NoteCode"  )
column=(type=long update=yes updatewhereclause=yes name=vouchercode dbname="Notes.VoucherCode"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="Notes.AccCode"  )
column=(type=long update=yes updatewhereclause=yes name=bankacccode dbname="Notes.BankAccCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=issuedate dbname="Notes.IssueDate"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=duedate dbname="Notes.DueDate"  )
column=(type=number update=yes updatewhereclause=yes initial="0" name=amount dbname="Notes.Amount"  )
column=(type=char(40) update=yes updatewhereclause=yes name=bankname dbname="Notes.BankName"  )
column=(type=char(40) update=yes updatewhereclause=yes name=documentnumber dbname="Notes.DocumentNumber"  )
column=(type=char(60) update=yes updatewhereclause=yes name=remarks dbname="Notes.Remarks"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=notecatcode dbname="Notes.NoteCatCode"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="Notes.Posted"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="Notes.PostedBy"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=modified dbname="Notes.Modified"  )
column=(type=long update=yes updatewhereclause=yes name=modifiedby dbname="Notes.ModifiedBy"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=postdate dbname="Notes.PostDate"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=salesmancode dbname="Notes.SalesmanCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=number updatewhereclause=yes initial="0" name=unappliedamt dbname="UnAppliedAmt"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=finalized dbname="Notes.Finalized"  )
column=(type=datetime update=yes updatewhereclause=yes name=finalizeddate dbname="Notes.FinalizedDate"  )
column=(type=long update=yes updatewhereclause=yes name=finalizedby dbname="Notes.FinalizedBy"  )
 retrieve="SELECT
	Notes.NoteCode,   
	Notes.VoucherCode,
	Notes.AccCode,   
	Notes.BankAccCode,   
	Notes.IssueDate,   
	Notes.DueDate,   
	Notes.Amount,   
	Notes.BankName,   
	Notes.DocumentNumber,   
	Notes.Remarks,   
	Notes.NoteCatCode,   
	Notes.Posted,   
	Notes.PostedBy,   
	Notes.Modified,   
	Notes.ModifiedBy,   
	Notes.PostDate,   
	Notes.SalesmanCode,
	Accounts.AliasName,
	UnAppliedAmt= ISNULL(Notes.Amount - ISNULL((SELECT SUM(amt) FROM NotesDetail WHERE NotesDetail.NoteCode = Notes.NoteCode), 0), 0),
	Notes.Finalized,
	Notes.FinalizedDate,
	Notes.FinalizedBy
FROM
	Notes, Accounts  
WHERE
	Notes.NoteCode = :ar_notecode AND
	Notes.AccCode = Accounts.AccCode
"
  update="Notes" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_notecode", number))
)
