table(column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(60) updatewhereclause=yes name=transferaccount dbname="TransferAccount"  )
column=(type=datetime updatewhereclause=yes name=recorddate dbname="Notes.IssueDate"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="Notes.DueDate"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="Notes.PostDate"  )
column=(type=char(40) updatewhereclause=yes name=docno dbname="Notes.DocumentNumber"  )
column=(type=char(40) updatewhereclause=yes name=bankname dbname="Notes.BankName"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Notes.Amount"  )
column=(type=char(60) updatewhereclause=yes name=detail dbname="Notes.Remarks"  )
column=(type=long updatewhereclause=yes name=code dbname="Notes.NoteCode"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Notes.Posted"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="Notes.PostDate"  )
 retrieve="SELECT 
	AccountName=A2.Name,
	TransferAccount=Accounts.Name,   
	Notes.IssueDate,   
	Notes.DueDate,   
	Notes.PostDate,   
	Notes.DocumentNumber,   
	Notes.BankName,   
	Notes.Amount,   
	Notes.Remarks,   
	Notes.NoteCode,
	Notes.Posted,
	Notes.PostDate
FROM
	Notes,   
	Accounts,   
	Accounts A2
WHERE 
	Notes.BankAccCode = Accounts.AccCode and  
	Notes.AccCode = A2.AccCode and  
	Notes.NoteCatCode = 2 AND  
	CASE UPPER(:as_datetype) 
			When 'DUEDATE' Then Notes.DueDate 
			When 'POSTDATE' Then Notes.PostDate 
			When 'ISSUEDATE' Then Notes.IssueDate End 
				Between :ad_startdate AND :ad_enddate AND
	(Notes.Posted = Case :as_status 
		WHEN 'B' THEN 'Y' 
		WHEN 'Y' THEN 'Y' 
		WHEN 'N' THEN 'N'
		ELSE 'Z' END OR
	Notes.Posted = Case :as_status
		WHEN 'B' THEN 'N'
		WHEN 'Y' THEN 'Y'
		WHEN 'N' THEN 'N'
		ELSE 'Z'
		END)"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("as_status", string), ("as_datetype", string))
 sort="transferaccount A, recorddate A"
)
