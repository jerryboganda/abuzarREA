header(height=132 color="536870912" )
summary(height=0 color="536870912" )
footer(height=68 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="NotesDetail.NoteCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=invoicecode dbname="NotesDetail.InvoiceCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleLedger.Date"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=netamt dbname="SaleLedger.InvTotal"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=outstandingamt dbname="NotesDetail.OutstandingAmt"  )
column=(type=long identity=yes updatewhereclause=yes name=noterowid dbname="NotesDetail.NoteROWID"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=notesutn dbname="NotesDetail.NotesUTN"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=amt dbname="NotesDetail.Amt"  )
 retrieve="SELECT
	NotesDetail.NoteCode,
	NotesDetail.InvoiceCode,
	SaleLedger.Date,
	SaleLedger.InvTotal,
	NotesDetail.OutstandingAmt,
	NotesDetail.IDENTITYCOL,
	NotesDetail.NotesUTN,
	NotesDetail.Amt
FROM
	NotesDetail,
	Notes,
	SaleLedger
WHERE
	( Notes.NoteCode = :Code ) AND
	( Notes.NoteCode = NotesDetail.NoteCode ) and  
	( NotesDetail.InvoiceCode = SaleLedger.SaleInvCode )
ORDER BY
	NotesDetail.NoteCode,   
	NotesDetail.IDENTITYCOL,
	NotesDetail.InvoiceCode
"
  update="NotesDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("Code", number))
)
