footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VoucherCode"  )
column=(type=datetime updatewhereclause=yes name=issuedate dbname="IssueDate"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="DueDate"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(60) updatewhereclause=yes name=transferredto dbname="TransferredTo"  )
column=(type=char(40) updatewhereclause=yes name=bankname dbname="BankName"  )
column=(type=char(40) updatewhereclause=yes name=referenceno dbname="ReferenceNo"  )
column=(type=char(60) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(30) updatewhereclause=yes name=notecategory dbname="NoteCategory"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(1) updatewhereclause=yes name=finalized dbname="Finalized"  )
column=(type=datetime updatewhereclause=yes name=finalizeddate dbname="FinalizedDate"  )
column=(type=char(60) updatewhereclause=yes name=finalizedby dbname="FinalizedBy"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="OutStandingAmt"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=decimal(2) updatewhereclause=yes name=amt dbname="Amt"  )
 retrieve="SELECT 
	Code=N.NoteCode,
	VoucherCode = N.VoucherCode,
	IssueDate=N.IssueDate,
	DueDate=N.DueDate,
	Amount = N.Amount,
	AccountName = (SELECT A.Name FROM Accounts A WHERE N.AccCode=A.AccCode),
	TransferredTo = (SELECT A.Name FROM Accounts A WHERE N.BankAccCode=A.AccCode),
	BankName = N.BankName,
	ReferenceNo = N.DocumentNumber,
	Remarks = N.Remarks,
	NoteCategory = NC.Name,
	Posted = N.Posted,
	PostedBy = (SELECT U.UserName FROM Users U WHERE U.UserCode = N.PostedBy),
	PostDate = N.PostDate,
	UserName = (SELECT U.UserName FROM Users U WHERE U.UserCode = N.SalesManCode),
	Finalized = N.Finalized,
	FinalizedDate = N.FinalizedDate,
	FinalizedBy = (SELECT U.UserName FROM Users U WHERE U.UserCode = N.FinalizedBy),
	InvoiceCode = D.InvoiceCode,
	OutStandingAmt = D.OutStandingAmt,
	RowID=D.NoteRowID,
	Amt = D.Amt
FROM 
	Notes N
	LEFT OUTER JOIN NotesDetail AS D ON (N.NoteCode = D.NoteCode), NotesCategory NC
WHERE N.NoteCode = :ai_code AND
	N.NoteCatCode = NC.NoteCatCode
ORDER BY
	RowID
"
  arguments=(("ai_code", number))
)
