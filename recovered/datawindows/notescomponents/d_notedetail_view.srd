table(column=(type=long update=yes updatewhereclause=yes name=code dbname="NotesDetail.NoteCode"  )
column=(type=long update=yes updatewhereclause=yes name=invoicecode dbname="NotesDetail.InvoiceCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=netamt dbname="InvTotal"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=outstandingamt dbname="NotesDetail.OutstandingAmt"  )
column=(type=long identity=yes updatewhereclause=yes name=noterowid dbname="NotesDetail.NoteROWID"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=notesutn dbname="NotesDetail.NotesUTN"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=amt dbname="NotesDetail.Amt"  )
 retrieve="SELECT  
	NotesDetail.NoteCode,
	NotesDetail.InvoiceCode,
	Date=CASE Notes.NoteCatCode 
			WHEN 1 THEN 
				(SELECT S.Date FROM SaleLedger S WHERE S.SaleInvCode=NotesDetail.InvoiceCode)
			 ELSE 
				(SELECT S.Date FROM PurLedger S WHERE S.PurInvCode=NotesDetail.InvoiceCode)
			 END,
	InvTotal=CASE Notes.NoteCatCode
			WHEN 1 THEN 
				(SELECT S.InvTotal FROM SaleLedger S WHERE S.SaleInvCode=NotesDetail.InvoiceCode)
			 ELSE 
				(SELECT S.InvTotal FROM PurLedger S WHERE S.PurInvCode=NotesDetail.InvoiceCode)
			 END,
	NotesDetail.OutstandingAmt,
	NotesDetail.IDENTITYCOL,
	NotesDetail.NotesUTN,
	NotesDetail.Amt
FROM
	NotesDetail,
	Notes
WHERE
	( Notes.NoteCode = :Code ) AND
	( Notes.NoteCode = NotesDetail.NoteCode )
ORDER BY
	NotesDetail.NoteCode,   
	NotesDetail.IDENTITYCOL,
	NotesDetail.InvoiceCode
"
  arguments=(("Code", number))
)
