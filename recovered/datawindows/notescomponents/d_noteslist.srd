table(column=(type=long updatewhereclause=yes name=code dbname="Notes.NoteCode"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="Notes.VoucherCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(60) updatewhereclause=yes name=transferto dbname="TransferTo"  )
column=(type=datetime updatewhereclause=yes name=issuedate dbname="Notes.IssueDate"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="Notes.DueDate"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Notes.Amount"  )
column=(type=decimal(2) updatewhereclause=yes name=unappliedamt dbname="UnAppliedAmt"  )
column=(type=char(40) updatewhereclause=yes name=bankname dbname="Notes.BankName"  )
column=(type=char(40) updatewhereclause=yes name=documentnumber dbname="Notes.DocumentNumber"  )
column=(type=char(60) updatewhereclause=yes name=remarks dbname="Notes.Remarks"  )
column=(type=char(1) updatewhereclause=yes name=finalized dbname="Notes.Finalized"  )
column=(type=datetime updatewhereclause=yes name=finalizeddate dbname="Notes.FinalizedDate"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Notes.Posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="Notes.PostDate"  )
column=(type=char(40) updatewhereclause=yes name=referenceno dbname="Notes.DocumentNumber"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=long updatewhereclause=yes name=acccode dbname="Notes.AccCode"  )
column=(type=long updatewhereclause=yes name=bankacccode dbname="Notes.BankAccCode"  )
 retrieve="SELECT 
	Notes.NoteCode,   
	Notes.VoucherCode,
	Accounts.AliasName,
	AccountName=Accounts.Name,   
	TransferTo=(SELECT A.Name FROM Accounts A WHERE A.AccCode = Notes.BankAccCode),
	Notes.IssueDate,   
	Notes.DueDate,   
	Notes.Amount,   
	UnAppliedAmt = ISNULL(Notes.Amount - ISNULL((SELECT SUM(amt) FROM NotesDetail WHERE NotesDetail.NoteCode = Notes.NoteCode), 0), 0),
	Notes.BankName,   
	Notes.DocumentNumber,   
	Notes.Remarks,   
	Notes.Finalized,   
	Notes.FinalizedDate,   
	Notes.Posted,   
	PostedBy = (SELECT Users.UserName FROM users WHERE Users.UserCode = notes.postedby),
	Notes.PostDate,   
	Notes.DocumentNumber,
	UserName=(SELECT Users.UserName FROM users WHERE Users.UserCode = notes.salesmancode),
	Notes.AccCode,
	Notes.BankAccCode
FROM
	Notes, Accounts  
WHERE
	Notes.AccCode = Accounts.AccCode AND
	Notes.NoteCatCode = 1
"
 )
