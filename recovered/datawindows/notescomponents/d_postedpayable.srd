header(height=460 color="536870912" )
summary(height=84 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=accountsname dbname="Accounts.Name"  )
column=(type=datetime updatewhereclause=yes name=recorddate dbname="Notes.IssueDate"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="Notes.DueDate"  )
column=(type=char(40) updatewhereclause=yes name=docno dbname="Notes.DocumentNumber"  )
column=(type=char(40) updatewhereclause=yes name=bankname dbname="Notes.BankName"  )
column=(type=number updatewhereclause=yes name=amount dbname="Notes.Amount"  )
column=(type=char(60) updatewhereclause=yes name=remarks dbname="Notes.Remarks"  )
column=(type=long updatewhereclause=yes name=notecode dbname="Notes.NoteCode"  )
column=(type=number updatewhereclause=yes name=compute_0009 dbname="compute_0009"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="Notes.PostDate"  )
 retrieve="  SELECT Accounts.Name,   
         Notes.IssueDate,   
         Notes.DueDate,   
         Notes.DocumentNumber,   
         Notes.BankName,   
         Notes.Amount,   
         Notes.Remarks,   
         Notes.NoteCode,
			SUM(Notes.Amount),
			Notes.PostDate
    FROM Notes,   
         Accounts,   
         Supplier  
   WHERE ( Notes.BankAccCode = Accounts.AccCode ) and  
         ( Notes.AccCode = Supplier.SuppCode ) and  
         ( ( Notes.NoteCatCode = 2 ) ) AND  
         Notes.Posted = 'Y'     
GROUP BY Accounts.Name,   
         Notes.IssueDate,   
         Notes.DueDate,   
         Notes.DocumentNumber,   
         Notes.BankName,   
         Notes.Amount,   
         Notes.Remarks,
			Notes.PostDate,
         Notes.NoteCode  "
  sort="duedate A"
)
