table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="name"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="itemaliasname"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="name"  )
column=(type=long updatewhereclause=yes name=quotationcode dbname="quotationcode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=usercode dbname="usercode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="LooseQty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="Itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=char(12) updatewhereclause=yes name=customeraliasname dbname="customeraliasname"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="name"  )
 retrieve="select  	
	item.name,
	itemaliasname=item.customicode,
	ItemPacking.name, 
	quotationheader.quotationcode,
	quotationheader.custcode,
	quotationheader.custrefno,
	quotationheader.headerno,
	usercode=quotationheader.salesmancode,
	quotationheader.remarks,
	invdiscperc=quotationheader.discperc,
	quotationheader.date,
	LooseQty=sd.looseqty,
	sd.bonusqty,
	sd.SalePrice, 
	sd.Itemflatdisc,
	sd.discperc,
	sd.gstperc,
	sd.unitsalestax,
	customeraliasname=dbo.accounts.aliasname,	
	dbo.accounts.name
From   
	(Select icode,quotationcode,looseqty=qty,bonusqty,saleprice,itemflatdisc,discperc,gstperc,unitsalestax From quotationdetail Where icode = :ar_icode) sd 
       Inner Loop join quotationheader On sd.quotationcode = quotationheader.quotationcode 
       Inner Join Accounts On quotationheader.CustCode = Accounts.Acccode
       Inner Join Item On SD.Icode = Item.Icode 
       Left  Outer Join ItemPacking On Item.packcode = ItemPacking.PackCode  	
"
  arguments=(("ar_icode", number))
 sort="date D, itemname A"
)
