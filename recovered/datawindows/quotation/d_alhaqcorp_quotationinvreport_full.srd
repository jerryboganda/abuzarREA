summary(height=1093 color="536870912" )
footer(height=239 color="536870912" )
detail(height=166 color="536870912" )
table(column=(type=char(88) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(100) updatewhereclause=yes name=itemremarks dbname="itemremarks"  )
column=(type=char(100) updatewhereclause=yes name=itemshortname dbname="itemshortname"  )
column=(type=char(60) updatewhereclause=yes name=size dbname="size"  )
column=(type=char(150) updatewhereclause=yes name=genericname dbname="genericname"  )
column=(type=char(60) updatewhereclause=yes name=itemcolor dbname="itemcolor"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=long updatewhereclause=yes name=code dbname="code"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="invsalestax"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="salestax"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=balance dbname="balance"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(50) updatewhereclause=yes name=custtaxregno dbname="custTaxRegno"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="QuotationHeader.custrefno"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="QuotationHeader.remarks"  )
column=(type=datetime updatewhereclause=yes name=serverdate dbname="serverdate"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=char(50) updatewhereclause=yes name=messages dbname="messages"  )
 retrieve="SELECT 
		itemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END, 
         aliasname=item.customicode,  
		itemremarks=max(item.remarks), 
		itemshortname=max(item.shortname),
		size=(select name from itemsize where itemsize.isizecode=max(item.isizecode)),
		genericname=(select name from genericitem where max(item.genericcode)=genericitem.genericcode),
		itemcolor=(select name from itemcolour where itemcolour.icolourcode=max(item.icolourcode)),
		itemcategory=(select name from itemcategory where itemcategory.icatcode=max(item.icatcode)),
         packingdesc=max(item.packingdesc),   
		packing=(select name from itempacking where itempacking.packcode=max(item.packcode)),
         accname = dbo.accounts.name,   
         address =max( dbo.customer.address1),   
         address2= max(dbo.customer.address2),    
         salesman = dbo.users.username,   
         code = dbo.quotationheader.quotationcode,   
         headerno = max(dbo.quotationheader.headerno),   
         date = dbo.quotationheader.date,   
         invdiscperc = dbo.quotationheader.discperc,   
         misccharges = dbo.quotationheader.misccharges,   
         flatdisc = dbo.quotationheader.flatdisc,   
         invsalestax = dbo.quotationheader.salestax,   
         gcode = quotationdetail.gcode,   
         icode = quotationdetail.icode,   
  

         looseqty = sum(quotationdetail.qty),   
         bonusqty = sum(quotationdetail.bonusqty),   
          
         packunits=max( quotationdetail.packunits),   
         saleprice= max(quotationdetail.saleprice),   
         discperc = max(quotationdetail.discperc),  
			itemflatdisc=max(quotationdetail.itemflatdisc),   
         salestax = max(quotationdetail.salestax),   
         Id = max(dbo.quotationdetail.IDENTITYCOL),   
         posted=max(quotationheader.posted),   
         balance=0,   
         unitsalestax =max( quotationdetail.unitsalestax),   
         gstperc = max(quotationdetail.gstperc),   
         invgstperc =max( quotationheader.invgstperc1),   
         custTaxRegno=max(customer.salestaxregno)  ,
			dbo.quotationheader.custrefno,	
			dbo.quotationheader.remarks,
		
			
			
			serverdate=getdate(),
			custcode=dbo.quotationheader.custcode,
			salesperson=(select name from salesman where salesmancode=max(quotationheader.smancode)),
			messages=(select description from message where messagecode=max(quotationheader.messagecode))

    FROM quotationheader,   
         quotationdetail,   
         accounts,   
         customer,   
         users,   
         item  

   WHERE ( dbo.quotationheader.quotationcode = :ar_SaleInvCode ) AND  
         ( dbo.quotationheader.quotationcode = dbo.quotationdetail.quotationcode) AND  
         ( dbo.quotationheader.custcode = dbo.accounts.acccode ) AND  
         ( dbo.customer.custcode = dbo.accounts.acccode ) AND  
         ( dbo.quotationheader.salesmancode = dbo.users.usercode ) AND  
         ( dbo.quotationdetail.icode = dbo.item.icode)    
GROUP BY quotationheader.quotationcode, 
			quotationheader.date, 
			/*quotationheader.headerno,*/
			quotationheader.custcode, 
			quotationheader.discperc, 
			quotationheader.flatdisc, 
			quotationheader.misccharges, 
			quotationheader.salestax, 
			quotationheader.remarks,
			quotationheader.custrefno, 
			quotationdetail.icode,
		
			quotationdetail.gcode, 
			item.name,
			item.customicode,
			item.icode,
			item.icatcode,
			item.printable, 
			accounts.name,
			dbo.users.username

ORDER BY 	
			quotationheader.quotationcode,
			itemcategory,
			itemname
			
"
  arguments=(("ar_SaleInvCode", number))
)
