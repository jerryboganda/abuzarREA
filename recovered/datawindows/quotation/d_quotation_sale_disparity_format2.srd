table(column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="ItemAliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=quotedqty dbname="QuotedQty"  )
column=(type=decimal(4) updatewhereclause=yes name=quotedbonus dbname="QuotedBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="SoldQty"  )
column=(type=decimal(4) updatewhereclause=yes name=soldbonus dbname="SoldBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=netqty dbname="NetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=netbonus dbname="NetBonus"  )
 retrieve=" SELECT 

	
	
	ItemCategory=IC.Name,
	ICode = I.ICode,
	ItemAliasName=I.CustomICode,
	ItemName=I.Name,
	QuotedQty = ISNULL(SUM(Q.QuotedQty), 0),
	QuotedBonus = ISNULL(SUM(Q.QuotedBonus), 0),
	SoldQty = ISNULL(SUM(Q.SoldQty), 0),
	SoldBonus = ISNULL(SUM(Q.SoldBonus), 0),
	NetQty = ISNULL(SUM(Q.QuotedQty - Q.SoldQty), 0),
	NetBonus = ISNULL(SUM(Q.QuotedBonus - Q.SoldBonus), 0)
FROM
	Item I,
	ItemCategory IC,
	Accounts A,
	(SELECT 
		QuotationCode = QH.QuotationCode,
		Date = QH.Date,
		Remarks = QH.Remarks,
		CustCode=QH.CustCode,
		ICode = QD.ICode,
		QuotedQty = ISNULL(SUM(QD.Qty * CASE QH.LoosePack WHEN 1 THEN 1 ELSE QD.PackUnits END), 0),
		QuotedBonus = ISNULL(SUM(QD.BonusQty * CASE QH.LoosePack WHEN 1 THEN 1 ELSE QD.PackUnits END), 0),
		SoldQty = ISNULL((SELECT SUM(SD.LooseQty) 
			FROM SaleDetail SD, SaleLedger SL 
			WHERE SL.QuotationNo = QH.QuotationCode AND
				SL.SaleInvCode = SD.SaleInvCode AND
				SD.ICode = QD.ICode), 0),
		SoldBonus = ISNULL((SELECT SUM(SD.BonusQty) 
			FROM SaleDetail SD, SaleLedger SL 
			WHERE SL.QuotationNo = QH.QuotationCode AND
				SL.SaleInvCode = SD.SaleInvCode AND
				SD.ICode = QD.ICode), 0)
	FROM
		QuotationDetail QD,
		QuotationHeader QH
	WHERE
		QH.QuotationCode IN (:ai_quotationcode) AND
		QH.QuotationCode = QD.QuotationCode
	GROUP BY
		QH.QuotationCode,
		QH.Date,
		QH.Remarks,
		QH.CustCode,
		QD.ICode
	UNION ALL
	SELECT 
		QuotationCode = QH.QuotationCode,
		Date = QH.Date,
		Remarks = QH.Remarks,
		CustCode = QH.CustCode,
		ICode = SD.ICode,
		QuotedQty = 0.0000,
		QuotedBonus = 0.0000,
		SoldQty = ISNULL(SUM(SD.LooseQty), 0),
		SoldBonus = ISNULL(SUM(SD.BonusQty), 0)
	FROM
		SaleDetail SD,
		SaleLedger SL, 
		QuotationHeader QH
	WHERE
		QH.QuotationCode IN (:ai_quotationcode) AND
		QH.QuotationCode = SL.QuotationNO AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode NOT IN (SELECT QD.ICode FROM QuotationDetail QD WHERE QD.QuotationCode = QH.QuotationCode)
	GROUP BY
		QH.QuotationCode,
		QH.Date,
		QH.Remarks,
		QH.CustCode,
		SD.ICode) Q
WHERE
	(Q.QuotedQty - Q.SoldQty <> 0 OR Q.QuotedBonus - Q.SoldBonus <> 0) AND
	Q.ICode = I.ICode AND
	Q.CustCode = A.AccCode AND
	I.ICatCode = IC.ICatCode
GROUP BY
	I.ICode,
	I.CustomICode,
	I.Name,
	IC.Name
"
  arguments=(("ai_quotationcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="itemcategory A, itemname A"
)
