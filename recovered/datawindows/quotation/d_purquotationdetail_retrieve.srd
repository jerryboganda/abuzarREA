table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PurQuotationDetail.purquotationcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="PurQuotationDetail.icode"  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="PurQuotationDetail.RowID"  )
column=(type=char(100) update=yes updatewhereclause=yes name=itemdescription dbname="PurQuotationDetail.itemdescription"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=gcode dbname="PurQuotationDetail.gcode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="PurQuotationDetail.packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="PurQuotationDetail.saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="'Pur. Price should be greater than zero'" name=purprice dbname="PurQuotationDetail.purprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=gstperc dbname="GSTPerc"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=bonusqty dbname="PurQuotationDetail.bonusqty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) < 100" validationmsg="'Discount (%) must be between 0 and 100'" initial="0" name=discperc dbname="PurQuotationDetail.discperc"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=qty dbname="PurQuotationDetail.qty"  )
 retrieve="SELECT 
	item.customicode, 
	itemname= item.name, 
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= 0.0000, 
	assgcode  = 1, 
	purquotationdetail.purquotationcode,   
	purquotationdetail.icode,   
	purquotationdetail.IDENTITYCOL,
	purquotationdetail.itemdescription,
	purquotationdetail.gcode,
	purquotationdetail.packunits,
	purquotationdetail.saleprice,
	purquotationdetail.purprice,
	unitsalestax=purquotationdetail.unitsalestax,
	GSTPerc=purquotationdetail.GSTPErc,
	purquotationdetail.bonusqty,
	purquotationdetail.discperc,
	purquotationdetail.qty
	
FROM 
	purquotationdetail,   
	item 
	
WHERE 
	( dbo.purquotationdetail.purquotationcode = :ai_Code ) AND
	( purquotationdetail.icode = item.icode )
ORDER BY
	rowid
	
	
	
"
  update="purquotationdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
