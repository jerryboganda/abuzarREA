release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=76 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=long updatewhereclause=yes name=assgcode dbname="assgcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PreSaleDetail.PreSaleInvCode"  )
column=(type=long update=yes updatewhereclause=yes name=purinvcode dbname="PreSaleDetail.PurInvCode"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode" 
 values=""  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(100) updatewhereclause=yes name=purremarks dbname="PurRemarks"  )
column=(type=char(100) updatewhereclause=yes name=orderno dbname="OrderNo"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=purchaseamt dbname="PurchaseAmt"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="PreSaleDetail.ICode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=gcode dbname="PreSaleDetail.GCode"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes initial="." name=batch dbname="PreSaleDetail.Batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes initial="today+100" name=expiry dbname="PreSaleDetail.Expiry"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="PreSaleDetail.PackUnits"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=bonusqty dbname="PreSaleDetail.BonusQty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=saleprice dbname="PreSaleDetail.SalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discperc dbname="PreSaleDetail.DiscPerc"  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="PreSaleDetail.ROWID"  )
column=(type=char(100) update=yes updatewhereclause=yes name=itemdescription dbname="PreSaleDetail.ItemDescription"  )
column=(type=long update=yes updatewhereclause=yes name=purrowid dbname="PreSaleDetail.PurRowID"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=qty dbname="PreSaleDetail.Qty"  )
 retrieve="SELECT 
	item.customicode, 
	itemname= item.name, 
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= 0.0000, 
	assgcode  = 1, 
	PreSaleDetail.PreSaleInvCode,   
	PreSaleDetail.PurInvCode,   
	SuppCode=(SELECT P.SuppCode FROM PurLedger P WHERE P.PurInvCode=PreSaleDetail.PurInvCode),
	Phone=(SELECT S.Phone FROM PurLedger P, Supplier S WHERE P.PurInvCode=PreSaleDetail.PurInvCode AND P.SuppCode = S.SuppCode),
	PurRemarks=(SELECT P.Remarks FROM PurLedger P WHERE P.PurInvCode=PreSaleDetail.PurInvCode),
	OrderNo=(SELECT P.NewPurchaseOrderNo FROM PurLedger P WHERE P.PurInvCode=PreSaleDetail.PurInvCode),
	PurchaseAmt=ISNULL((SELECT P.InvTotal FROM PurLedger P WHERE P.PurInvCode=PreSaleDetail.PurInvCode), 0),
	PreSaleDetail.ICode,   
	PreSaleDetail.GCode,   
	PreSaleDetail.Batch,   
	PreSaleDetail.Expiry,   
	PreSaleDetail.PackUnits,   
	PreSaleDetail.BonusQty,   
	PreSaleDetail.SalePrice,   
	PreSaleDetail.DiscPerc,   
	PreSaleDetail.ROWID,   
	PreSaleDetail.ItemDescription,
	PreSaleDetail.PurRowID,   
	PreSaleDetail.Qty  
FROM 
	PreSaleDetail, Item
WHERE 
	PreSaleDetail.PreSaleInvCode = :ai_code AND
	PreSaleDetail.ICode = Item.ICode
ORDER BY 
	PreSaleDetail.PreSaleInvCode ASC,   
	PreSaleDetail.PurInvCode ASC,   
	PreSaleDetail.PurRowID ASC   


"
  update="PreSaleDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
 sort="code A, purinvcode A, purrowid A"
)
