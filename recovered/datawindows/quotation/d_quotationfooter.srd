release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=26 color="536870912" )
detail(height=176 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=code dbname="QuotationHeader.quotationcode"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Flat Discount should be greater equal zero'" initial="0" name=flatdisc dbname="QuotationHeader.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Miscellaneous Charges should be greater equal zero'" initial="0" name=misccharges dbname="QuotationHeader.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=salestax dbname="QuotationHeader.salestax"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100" validationmsg="'Discount % should be between 0 and 100'" initial="0" name=invdiscperc dbname="QuotationHeader.discperc"  )
column=(type=long updatewhereclause=yes initial="99999" name=icode dbname="Icode"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="Stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="TotalStock"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Invoice total can not be negative'" initial="0" name=total dbname="Total"  )
column=(type=decimal(2) updatewhereclause=yes name=rpp dbname="RPP"  )
column=(type=decimal(2) updatewhereclause=yes name=purdiscperc dbname="purdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="InvGSTPerc1"  )
column=(type=char(20) updatewhereclause=yes name=bonusratio dbname="BonusRatio"  )
 retrieve="SELECT 
	QuotationHeader.quotationcode,   
	QuotationHeader.flatdisc,   
	QuotationHeader.misccharges,   
	QuotationHeader.salestax,   
	QuotationHeader.discperc,
	Icode = 0, 
	Stock = 0.0000,
	TotalStock = 0.0000,
	Total = 0.00,
	RPP = 0.00,
	purdiscperc = 0.00,
	InvGSTPerc1= QuotationHeader.Invgstperc1,
	BonusRatio=SPACE(20)
FROM 
	QuotationHeader  
WHERE 
	QuotationHeader.quotationcode = :ar_invcode    
"
  update="QuotationHeader" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_invcode", number))
)
