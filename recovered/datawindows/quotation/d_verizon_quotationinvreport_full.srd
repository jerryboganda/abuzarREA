header(height=2333 color="536870912" )
summary(height=1447 color="536870912" )
footer(height=666 color="536870912" )
detail(height=343 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(60) updatewhereclause=yes name=saleperson dbname="saleperson"  )
column=(type=long updatewhereclause=yes name=quotationcode dbname="QuotationHeader.quotationcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="QuotationHeader.date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=char(100) updatewhereclause=yes name=itemdesc dbname="itemdesc"  )
column=(type=decimal(2) updatewhereclause=yes name=invmischarg dbname="invmischarg"  )
column=(type=decimal(2) updatewhereclause=yes name=invflatdisc dbname="invflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="QuotationHeader.salestax"  )
column=(type=long updatewhereclause=yes name=quotationheader_custcode dbname="QuotationHeader.custcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="QuotationHeader.remarks"  )
column=(type=long updatewhereclause=yes name=icode dbname="QuotationDetail.icode"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=detaildiscperc dbname="detaildiscperc"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=packsaleprice dbname="packsaleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=packpurprice dbname="packpurprice"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=char(60) updatewhereclause=yes name=custadd1 dbname="custadd1"  )
column=(type=char(60) updatewhereclause=yes name=custadd2 dbname="custadd2"  )
column=(type=char(100) updatewhereclause=yes name=custphone dbname="custphone"  )
 retrieve="SELECT 
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, 
	itemalias=max(item.customicode),
	custrefno=max(quotationheader.custrefno),
	users.username,  
	headerno = dbo.quotationheader.headerno,
	saleperson=(select name from salesman where salesman.salesmancode=max(quotationheader.smancode)),
	dbo.quotationheader.quotationcode,   
	dbo.quotationheader.date,   
	invdiscperc=dbo.quotationheader.discperc,   
	itemdesc=quotationdetail.itemdescription,
	invmischarg=dbo.quotationheader.misccharges,   
	invflatdisc=dbo.quotationheader.flatdisc,   
	dbo.quotationheader.salestax,   
	dbo.quotationheader.custcode,   
	dbo.quotationheader.remarks,   
	dbo.quotationdetail.icode,   
	Id        = MAX(dbo.quotationdetail.IDENTITYCOL),  
	qty   = sum(quotationdetail.qty), 
	packunits = max(quotationdetail.packunits), 
	saleprice = max(quotationdetail.saleprice), 
	salestax  = max(quotationdetail.salestax),   
	detaildiscperc  = max(quotationdetail.discperc), 
	customername='                                  '  ,
	itemflatdisc  = max(quotationdetail.itemflatdisc),
	packsaleprice=max(item.saleprice),
	packpurprice=max(item.purprice),
	manufacturer=max(manufacturer.name),
	customername=max(accounts.name),
	custadd1=max(customer.address1),
	custadd2=max(customer.address2),
	custphone=max(customer.phone)
FROM 
	dbo.quotationheader,   
	dbo.quotationdetail,  
	item,
	Users ,
	manufacturer,
	accounts,
	customer
WHERE 
	( dbo.quotationheader.quotationcode = :ra_InvCode ) AND
	( dbo.quotationheader.quotationcode = dbo.quotationdetail.quotationcode ) AND 
	( quotationheader.SalesManCode = users.userCode ) and
	( quotationheader.custcode=accounts.acccode) and
	( quotationdetail.icode = item.icode )and
	(customer.custcode=quotationheader.custcode)and
	(Item.manfcode=manufacturer.manfcode)
GROUP BY 
	quotationheader.quotationcode, 
	quotationheader.date, 
	quotationheader.custcode, 
	quotationheader.discperc, 
	quotationheader.flatdisc, 
	quotationheader.misccharges, 
	quotationheader.headerno,
	quotationheader.salestax, 
	quotationheader.remarks, 
	quotationdetail.icode,
	quotationdetail.itemdescription, 
	item.name,
	item.icode,
	item.printable,
	users.username
ORDER BY 
	MAX(dbo.quotationdetail.IDENTITYCOL)
"
  arguments=(("ra_InvCode", number))
 sort="id A"
)
