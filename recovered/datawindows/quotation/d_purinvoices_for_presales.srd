release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(100) updatewhereclause=yes name=purremarks dbname="PurRemarks"  )
column=(type=char(100) updatewhereclause=yes name=orderno dbname="OrderNo"  )
column=(type=decimal(2) updatewhereclause=yes name=purchaseamt dbname="PurchaseAmt"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(100) updatewhereclause=yes name=itemdescription dbname="ItemDescription"  )
column=(type=long updatewhereclause=yes name=gcode dbname="GCode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(5) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=long identity=yes updatewhereclause=yes name=purrowid dbname="PurRowID"  )
 retrieve="SELECT 
	PurInvCode=P.PurInvCode, 
	SuppCode=P.SuppCode, 
	Phone=(SELECT S.Phone FROM Supplier S WHERE P.SuppCode = S.SuppCode),
	PurRemarks=P.Remarks,
	OrderNo=P.NewPurchaseOrderNo,
	PurchaseAmt=P.InvTotal, 
	ICode=D.ICode, 
	CustomICode=I.customicode,
	ItemName=I.Name, 
	ItemDescription = D.ItemDescription,
	GCode=D.GCode,
	Batch=D.Batch,
	Expiry=D.Expiry,
	PackUnits = D.PackUnits,
	Qty = (CASE WHEN P.PurCatCode >= 3 THEN D.LooseQty + D.BonusQty ELSE (D.PackQty + D.BonusQty) * D.PackUnits END) -  ISNULL((SELECT SUM(PS.Qty) FROM PresaleDetail PS WHERE PS.PurRowID = D.PurRowID), 0),
	NetRate = D.NetRate,
	SalePrice = Round(CASE WHEN P.PurCatCode >= 3 THEN D.PurPrice ELSE D.PurPrice / CASE WHEN D.PackUnits IS NULL OR D.PackUnits <= 0 THEN 1 ELSE D.PackUnits END END, 2),
	DiscPerc = D.DiscPerc,
	PurRowID=D.PurRowID
FROM Purledger P, PurDetail D, Item I
WHERE P.Posted = 'Y' AND P.PurInvCode IN (:ai_PurInvCode) AND P.PurInvCode = D.PurInvCode AND
	D.ICode=I.ICode
ORDER BY 
	PurInvCode,
	PurRowID"
  arguments=(("ai_PurInvCode", numberlist))
)
