column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="invsalestax"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=balance dbname="balance"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(50) updatewhereclause=yes name=custtaxregno dbname="custTaxRegno"  )
column=(type=char(150) updatewhereclause=yes name=remarks2 dbname="remarks2"  )
column=(type=char(150) updatewhereclause=yes name=remarks3 dbname="remarks3"  )
column=(type=char(150) updatewhereclause=yes name=remarks4 dbname="remarks4"  )
column=(type=char(150) updatewhereclause=yes name=remarks5 dbname="remarks5"  )
column=(type=char(150) updatewhereclause=yes name=remarks6 dbname="remarks6"  )
column=(type=char(30) updatewhereclause=yes name=quotationheader_custrefno dbname="QuotationHeader.custrefno"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="QuotationHeader.remarks"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(50) updatewhereclause=yes name=message dbname="Message"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CUSTALIAS"  )
 retrieve="SELECT 
	itemname= item.name, 
	aliasname=item.customicode,   
	packingdesc=item.packingdesc, 
	accname = accounts.name,   
	address =  customer.address1,
	address2=  customer.address2,   
	city=  customer.city,   
	licenceno=  customer.licenceno,   
	username=  users.username,   
	quotationcode =  saleledger.quotationcode,   
	headerno =  saleledger.headerno, 
	
	date =  saleledger.date,   
	invdiscperc =  saleledger.discperc,   
	misccharges =  saleledger.misccharges,   
	flatdisc =  saleledger.flatdisc,   
	invsalestax =  saleledger.salestax,   
	gcode = saledetail.gcode,   
	icode = saledetail.icode,   
	
	
	looseqty = saledetail.qty,   
	bonusqty = saledetail.bonusqty,   
	
	packunits= saledetail.packunits,   
	saleprice= saledetail.saleprice,   
	discperc = saledetail.discperc,   
	salestax = saledetail.salestax,  
	itemflatdisc=saledetail.itemflatdisc,   
	Id =  saledetail.IDENTITYCOL,   
	
	
	posted=saleledger.posted,   
	balance=0,   
	unitsalestax = saledetail.unitsalestax,   
	gstperc = saledetail.gstperc,   
	invgstperc = saleledger.invgstperc1,   
	custTaxRegno=customer.salestaxregno  ,
	
	remarks2=saleledger.remarks2,
	remarks3=saleledger.remarks3,
	remarks4=saleledger.remarks4,
	remarks5=saleledger.remarks5,
	remarks6=saleledger.remarks6,
	
	 saleledger.custrefno,	
	 saleledger.remarks,
	
	
	salesman=ltrim(rtrim( salesman.name)),
	Message=ltrim(rtrim( Message.description)),
	manufacturer=(select name from manufacturer where manfcode=item.manfcode),
	CUSTALIAS=ACCOUNTS.ALIASNAME
	
FROM 
	quotationheader saleledger
	LEFT OUTER JOIN dbo.message ON (saleledger.messagecode =  message.messagecode)
	LEFT OUTER JOIN dbo.salesman ON (saleledger.smancode = salesman.salesmancode), 
	quotationdetail saledetail,   
	accounts,   
	customer,   
	users,   
	item 
WHERE 
	(  saleledger.quotationcode=:ar_InvCode) AND
	(  saleledger.quotationcode=saledetail.quotationcode) AND
	(  saleledger.custcode =  accounts.acccode ) AND  
	(  customer.custcode =  accounts.acccode ) AND  
	(  saleledger.salesmancode =  users.usercode ) AND
	(  saledetail.icode =  item.icode)
ORDER BY  
	saledetail.quotationcode,
	saledetail.IDENTITYCOL
"
  arguments=(("ar_InvCode", number))
)
