 values=" Sale Price 1	1/ Sale Price 2	2/ Sale Price 3	3/Pur Price	4/RPP	5/Avg.Price	6/ Sale Price 4	7/ Sale Price 5	8/"  )
column=(type=char(42) updatewhereclause=yes name=custname dbname="custname"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="QuotationHeader.posted"  )
column=(type=char(30) update=yes updatewhereclause=yes name=custrefno dbname="QuotationHeader.custrefno"  )
