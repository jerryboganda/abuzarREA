column=(type=char(150) update=yes updatewhereclause=yes name=remarks8 dbname="QuotationHeader.remarks8"  )
column=(type=char(150) update=yes updatewhereclause=yes name=remarks9 dbname="QuotationHeader.remarks9"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=loosepack dbname="loosepack" 
 values="Loose	1/Pack	2/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Q" name=pagesize dbname="QuotationHeader.pagesize" 
 values="Quarter	Q/Full	F/Half	H/Thermal	T/"  )
