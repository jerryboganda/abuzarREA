column=(type=long update=yes updatewhereclause=yes name=custcode dbname="QuotationHeader.custcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=salesmancode dbname="QuotationHeader.salesmancode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=date dbname="QuotationHeader.date"  )
