column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode" 
 values=""  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(100) updatewhereclause=yes name=purremarks dbname="PurRemarks"  )
column=(type=char(100) updatewhereclause=yes name=orderno dbname="OrderNo"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=char(100) updatewhereclause=yes name=itemdescription dbname="ItemDescription"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=long updatewhereclause=yes name=invsalestax dbname="salestax"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=balance dbname="balance"  )
column=(type=long updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=long updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=long updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="PreSaleHeader.remarks"  )
 retrieve="SELECT
	itemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:' + LTRIM(RTRIM(item.customicode)) END,   
	aliasname=item.customicode,
	packingdesc=item.packingdesc,  
	accname = dbo.accounts.name,   
	address = dbo.customer.address1,   
	address2= dbo.customer.address2, 
	CustRefNo=dbo.presaleheader.CustRefNo,
	CustRefNo2=dbo.presaleheader.CustRefNo2,
	CustRefNo3=dbo.presaleheader.CustRefNo3,
	CustRefNo4=dbo.presaleheader.CustRefNo4,
	OrderDate=dbo.presaleheader.OrderDate,
	salesman = dbo.users.username,   
	code = dbo.presaleheader.presaleinvcode,   
	date = dbo.presaleheader.date,   
	invdiscperc = 0,   
	misccharges = 0,   
	flatdisc = 0,   
	invsalestax = 0,

	PurInvCode = presaledetail.PurInvCode,
	SuppCode=(SELECT P.SuppCode FROM PurLedger P WHERE P.PurInvCode=PreSaleDetail.PurInvCode),
	Phone=(SELECT S.Phone FROM PurLedger P, Supplier S WHERE P.PurInvCode=PreSaleDetail.PurInvCode AND P.SuppCode = S.SuppCode),
	PurRemarks=(SELECT P.Remarks FROM PurLedger P WHERE P.PurInvCode=PreSaleDetail.PurInvCode),
	OrderNo=(SELECT P.NewPurchaseOrderNo FROM PurLedger P WHERE P.PurInvCode=PreSaleDetail.PurInvCode),

	icode = presaledetail.icode,   
	batch = presaledetail.batch,
	expiry = presaledetail.expiry,
	looseqty = presaledetail.qty,   
	bonusqty = presaledetail.bonusqty,   
	packunits= presaledetail.packunits,   
	purprice= presaledetail.saleprice,   
	ItemDescription=PreSaleDetail.ItemDescription,
	saleprice= presaledetail.saleprice,   
	discperc = presaledetail.discperc,   
	salestax = 0,   
	Id = dbo.presaledetail.IDENTITYCOL,   
	posted=presaleheader.posted,   
	balance=0,   
	unitsalestax = 0,   
	gstperc = 0,   
	invgstperc = 0,   
	dbo.presaleheader.remarks
	
FROM 
	presaleheader,   
	presaledetail,   
	accounts,   
	customer,   
	users,   
	item  
	
WHERE 
	( dbo.presaleheader.presaleinvcode = :ar_invcode ) AND  
	( dbo.presaleheader.presaleinvcode = dbo.presaledetail.presaleinvcode) AND  
	( dbo.presaleheader.custcode = dbo.accounts.acccode ) AND  
	( dbo.customer.custcode = dbo.accounts.acccode ) AND  
	( dbo.presaleheader.usercode = dbo.users.usercode ) AND  
	( dbo.presaledetail.icode = dbo.item.icode)    
ORDER BY 
	dbo.presaledetail.IDENTITYCOL"
  arguments=(("ar_InvCode", number))
)
