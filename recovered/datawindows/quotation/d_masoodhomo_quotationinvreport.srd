 retrieve="SELECT 
	itemname = 
		CASE item.printable 
		WHEN 1 THEN 
			CASE quotationdetail.itemdescription 
			WHEN NULL THEN item.name 
			WHEN '' THEN item.name 
			ELSE quotationdetail.itemdescription  END 
		ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END,   
	itemdescription = quotationdetail.itemdescription,
	aliasname=item.customicode,   
	packingdesc=item.packingdesc,   
	accname = dbo.accounts.name,   
	custalias=dbo.accounts.aliasname,
	address = dbo.customer.address1,   
	address2= dbo.customer.address2,   
	custcity= dbo.customer.city,
	custcountry= dbo.customer.country,
	bank=dbo.customer.bankname,
	bankadd=dbo.customer.bankadd,
	salesman = dbo.users.username,   
	quotationcode = dbo.quotationheader.quotationcode,   
	headerno = dbo.quotationheader.headerno,
	date = dbo.quotationheader.date,   
	invdiscperc = dbo.quotationheader.discperc,   
	misccharges = dbo.quotationheader.misccharges,   
	flatdisc = dbo.quotationheader.flatdisc,   
	invsalestax = dbo.quotationheader.salestax,   
	gcode = quotationdetail.gcode,   
	icode = quotationdetail.icode,   
	looseqty = quotationdetail.qty,   
	bonusqty = quotationdetail.bonusqty,   
	packunits= quotationdetail.packunits,   
	saleprice= quotationdetail.saleprice,   
	discperc = quotationdetail.discperc,  
	itemflatdisc=quotationdetail.itemflatdisc,   
	salestax = quotationdetail.salestax,   
	Id = dbo.quotationdetail.IDENTITYCOL,   
	posted=quotationheader.posted,   
	balance=0,   
	unitsalestax = quotationdetail.unitsalestax,   
	gstperc = quotationdetail.gstperc,   
	invgstperc = quotationheader.invgstperc1,   
	custTaxRegno=customer.salestaxregno  ,
	dbo.quotationheader.custrefno,
	dbo.quotationheader.remarks,
	serverdate=getdate(),
	custcode=dbo.quotationheader.custcode,
	salesperson=(select name from salesman where salesmancode=quotationheader.smancode),
	messages=(select description from message where messagecode=quotationheader.messagecode),
	itempacking=(select name from itempacking where itempacking.packcode=item.packcode),
	itemcategory=(select name from itemcategory where itemcategory.icatcode=item.icatcode),
	remarks2=quotationheader.remarks2,
	remarks3=quotationheader.remarks3,
	remarks4=quotationheader.remarks4,
	remarks5=quotationheader.remarks5,
	remarks6=quotationheader.remarks6,
	remarks7=quotationheader.remarks7,
	remarks8=quotationheader.remarks8,
	remarks9=quotationheader.remarks9

FROM 
	quotationheader,   
	quotationdetail,   
	accounts,   
	customer,   
	users,   
	item,
	itemcategory,
	itemclass,
	itempacking,
	genericitem
WHERE 
	( dbo.quotationheader.quotationcode = :ar_QuotationCode ) AND  
	( dbo.quotationheader.quotationcode = dbo.quotationdetail.quotationcode) AND  
	( dbo.quotationheader.custcode = dbo.accounts.acccode ) AND  
	( dbo.customer.custcode = dbo.accounts.acccode ) AND  
	( dbo.quotationheader.salesmancode = dbo.users.usercode ) AND  
	( dbo.quotationdetail.icode = dbo.item.icode) AND
	( dbo.item.icatcode = dbo.itemcategory.icatcode ) AND
	( dbo.item.iccode = dbo.itemclass.iccode ) AND
	( dbo.item.packcode = dbo.itempacking.packcode ) AND
	( dbo.item.genericcode = dbo.genericitem.genericcode )
ORDER BY 
	/*dbo.item.customicode,*/
	dbo.quotationdetail.quotationcode,
	dbo.itemcategory.icatcode,
	dbo.genericitem.name,
	dbo.itemclass.numericalfactor,
	dbo.itemclass.name,
	dbo.itempacking.numericalfactor,
	dbo.itempacking.name
/*	dbo.quotationdetail.IDENTITYCOL*/
"
  arguments=(("ar_QuotationCode", number))
)
