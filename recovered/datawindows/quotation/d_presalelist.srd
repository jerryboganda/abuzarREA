table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PreSaleHeader.PreSaleInvCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="PreSaleHeader.Date"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="PreSaleHeader.SaleInvCode"  )
column=(type=decimal(10) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=long update=yes updatewhereclause=yes name=custcode dbname="PreSaleHeader.CustCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="PreSaleHeader.UserCode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="PreSaleHeader.Remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="PreSaleHeader.Posted" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="PreSaleHeader.PostedBy" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="PreSaleHeader.PostDate"  )
 retrieve="SELECT 
	PreSaleInvCode,
	Date,
	SaleInvCode,
	Amount = ISNULL((SELECT SUM(D.Qty * D.SalePrice * (1 - D.DiscPerc * 0.01)) FROM PreSaleDetail D WHERE D.PreSaleInvCode=PreSaleHeader.PreSaleInvCode), 0),
	CustCode,
	UserCode,
	Remarks,
	Posted,
	PostedBy,
	PostDate
FROM 
	DBO.PreSaleHeader"
  update="DBO.PreSaleHeader" updatewhere=1 updatekeyinplace=no
 )
