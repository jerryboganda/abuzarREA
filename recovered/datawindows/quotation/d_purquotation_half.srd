release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1489 color="536870912" )
summary(height=562 color="536870912" )
footer(height=10 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="username"  )
column=(type=long updatewhereclause=yes name=quotationcode dbname="quotationcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invmischarg dbname="invmischarg"  )
column=(type=decimal(2) updatewhereclause=yes name=invflatdisc dbname="invflatdisc"  )
column=(type=long updatewhereclause=yes name=saleledger_salestax dbname="salestax"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="suppcode"  )
column=(type=char(150) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=long updatewhereclause=yes name=qty dbname="qty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_saleprice dbname="saleprice"  )
column=(type=long updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=detaildiscperc dbname="detaildiscperc"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="suppliername"  )
 retrieve="SELECT 
	itemname = case printable when  0  then ltrim(str(item.icode)) + 'Counter Sale' else item.name end, 
	username=users.username,
	quotationcode=dbo.purquotationheader.purquotationcode,   
	date=dbo.purquotationheader.date,   
	invdiscperc=dbo.purquotationheader.discperc,   
	invmischarg=dbo.purquotationheader.misccharges,   
	invflatdisc=dbo.purquotationheader.flatdisc,   
	salestax=0,   
	suppcode=dbo.purquotationheader.suppcode,   
	remarks=dbo.purquotationheader.remarks,   
	icode=dbo.purquotationdetail.icode,   
	Id   = MAX(dbo.purquotationdetail.IDENTITYCOL),  
	qty  = sum(purquotationdetail.qty), 
	packunits = max(purquotationdetail.packunits), 
	purprice = max(purquotationdetail.purprice), 
	saleprice = max(purquotationdetail.saleprice), 
	salestax  = 0,   
	detaildiscperc  = max(purquotationdetail.discperc), 
	manufacturer=max(manufacturer.name),
	suppliername=max(accounts.name)
FROM 
	dbo.purquotationheader,   
	dbo.purquotationdetail,  
	item,
	Users ,
	manufacturer,
	accounts

WHERE 
	( dbo.purquotationheader.purquotationcode = :ra_InvCode ) AND
	( dbo.purquotationheader.purquotationcode = dbo.purquotationdetail.purquotationcode ) AND 
	( purquotationheader.UserCode = users.userCode ) and
	( purquotationheader.suppcode=accounts.acccode) and
	( purquotationdetail.icode = item.icode )and
	(Item.manfcode=manufacturer.manfcode)

GROUP BY 
	purquotationheader.purquotationcode, 
	purquotationheader.date, 
	purquotationheader.suppcode, 
	purquotationheader.discperc, 
	purquotationheader.flatdisc, 
	purquotationheader.misccharges, 
	purquotationheader.remarks, 
	purquotationdetail.icode, 
	item.name,
	item.icode,
	item.printable,
	users.username
ORDER BY 
	MAX(dbo.purquotationdetail.IDENTITYCOL)"
  arguments=(("ra_InvCode", number))
 sort="id A"
)
