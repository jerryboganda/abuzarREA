release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=74 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=67 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=67 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=long updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=long updatewhereclause=yes name=qtysale dbname="qtysale"  )
column=(type=long updatewhereclause=yes name=bonus dbname="bonus"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=updatesaleprice dbname="updatesaleprice"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="quotationcode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Item Flat Disc should be greater than zero~"" initial="0" name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=char(100) update=yes updatewhereclause=yes name=itemdescription dbname="itemdescription"  )
column=(type=long update=yes updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="'Sale Price should be greater than zero'" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=salestax dbname="salestax"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=bonusqty dbname="bonusqty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=gstperc dbname="GSTPerc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=looseqty dbname="qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) < 100" validationmsg="'Dsicount (%) must be between 0 and 100'" initial="0" name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=claimablediscperc dbname="claimablediscperc"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="soldqty"  )
column=(type=decimal(4) updatewhereclause=yes name=soldbonus dbname="soldbonus"  )
 retrieve="SELECT 
	item.customicode, 
	itemname= item.name, 
	currlistrow = 0,
	stock     = 0, 
	totalstock= 0, 
	assgcode  = 1, 
	qtysale=item.saleqty,
	bonus=item.bonusqty,
	updatesaleprice = 'N',
	quotationdetail.quotationcode,   
	quotationdetail.icode,   
	quotationdetail.itemflatdisc,
	quotationdetail.IDENTITYCOL,
	quotationdetail.itemdescription,
	quotationdetail.gcode,
	quotationdetail.packunits,
	quotationdetail.saleprice,
	quotationdetail.salestax,  
	quotationdetail.bonusqty,
	unitsalestax=quotationdetail.unitsalestax,
	GSTPerc=quotationdetail.GSTPErc,
	quotationdetail.qty,
	quotationdetail.discperc,
	quotationdetail.claimablediscperc,
	soldqty = CASE :ar_populationmethod WHEN 1 THEN 
	ISNULL((select looseqty=sum(sd.looseqty)
		from saledetail AS sd inner join saleledger sl on sl.saleinvcode = sd.saleinvcode
		where sl.quotationno= :ar_QuotationCode and sd.icode=quotationdetail.icode
		group by sd.icode), 0) ELSE 0 END,
	soldbonus = CASE :ar_populationmethod WHEN 1 THEN 
	ISNULL((select bonusqty=sum(sd.bonusqty)
		from saledetail AS sd inner join saleledger sl on sl.saleinvcode = sd.saleinvcode
		where sl.quotationno= :ar_QuotationCode and sd.icode=quotationdetail.icode
		group by sd.icode), 0) ELSE 0 END
FROM 
	quotationdetail,
	(SELECT DISTINCT ICode FROM godowndetail) GD, 
	item
WHERE 
	quotationdetail.quotationcode = :ar_QuotationCode AND
	quotationdetail.icode = GD.icode AND
	quotationdetail.icode = item.icode
ORDER BY 
	rowid"
  arguments=(("ar_QuotationCode", number), ("ar_populationmethod", number))
)
