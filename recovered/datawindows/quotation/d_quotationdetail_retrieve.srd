table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=long updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=long updatewhereclause=yes name=qtysale dbname="qtysale"  )
column=(type=long updatewhereclause=yes name=bonus dbname="bonus"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=updatesaleprice dbname="updatesaleprice"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="QuotationDetail.quotationcode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="QuotationDetail.icode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Item Flat Disc should be greater than zero~"" initial="0" name=itemflatdisc dbname="QuotationDetail.itemflatdisc"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="QuotationDetail.RowID"  )
column=(type=char(100) update=yes updatewhereclause=yes name=itemdescription dbname="QuotationDetail.itemdescription"  )
column=(type=long update=yes updatewhereclause=yes name=gcode dbname="QuotationDetail.gcode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="QuotationDetail.packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="'Sale Price should be greater than zero'" name=saleprice dbname="QuotationDetail.saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Purchase Order Rate should be +ve value'" initial="0" name=porate dbname="QuotationDetail.porate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=podiscperc dbname="QuotationDetail.podiscperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=specialrate dbname="QuotationDetail.specialrate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=salestax dbname="QuotationDetail.salestax"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=bonusqty dbname="QuotationDetail.bonusqty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=gstperc dbname="GSTPerc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=looseqty dbname="QuotationDetail.qty"  )
column=(type=decimal(2) updatewhereclause=yes name=claimablediscperc dbname="QuotationDetail.claimablediscperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) < 100" validationmsg="'Dsicount (%) must be between 0 and 100'" initial="0" name=discperc dbname="QuotationDetail.discperc"  )
column=(type=decimal(4) updatewhereclause=yes name=saleorderqty dbname="saleorderqty"  )
column=(type=decimal(4) updatewhereclause=yes name=saleorderbonus dbname="saleorderbonus"  )
 retrieve="SELECT 
	item.customicode, 
	itemname= item.name, 
	currlistrow = 0,
	stock     = 0, 
	totalstock= 0, 
	assgcode  = 1, 
	qtysale=item.saleqty,
	bonus=item.bonusqty,
	updatesaleprice = 'N',
	quotationdetail.quotationcode,   
	quotationdetail.icode,   
	quotationdetail.itemflatdisc,
	quotationdetail.IDENTITYCOL,
	quotationdetail.itemdescription,
	quotationdetail.gcode,
	quotationdetail.packunits,
	quotationdetail.saleprice,
	quotationdetail.porate,
	quotationdetail.podiscperc,
	quotationdetail.specialrate,
	quotationdetail.salestax,  
	quotationdetail.bonusqty,
	unitsalestax=quotationdetail.unitsalestax,
	GSTPerc=quotationdetail.GSTPErc,
	quotationdetail.qty,
	quotationdetail.claimablediscperc,
	quotationdetail.discperc,
	saleorderqty = ISNULL((SELECT sum(looseqty) FROM SaleOrderDetail WHERE quotationrowid = quotationdetail.rowid), 0),
	saleorderbonus = ISNULL((SELECT sum(bonusqty) FROM SaleOrderDetail WHERE quotationrowid = quotationdetail.rowid), 0)
	
FROM 
	quotationdetail, item
	
WHERE 
	dbo.quotationdetail.quotationcode = :ar_QuotationCode AND
	quotationdetail.icode = item.icode
ORDER BY 
	rowid"
  arguments=(("ar_QuotationCode", number))
)
