table(column=(type=long updatewhereclause=yes name=code dbname="QuotationHeader.quotationcode"  )
column=(type=datetime updatewhereclause=yes name=quotationheader_originaldate dbname="QuotationHeader.originaldate"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="QuotationHeader.posted" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes name=locked dbname="Locked" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes name=autoinsertnewitems dbname="AutoInsertNewItems" 
 values="Yes	Y/No	N/"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="QuotationHeader.remarks"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="customeralias"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
 retrieve="SELECT 
	dbo.quotationheader.quotationcode , 
	dbo.quotationheader.originaldate,
	dbo.quotationheader.posted,
	active = dbo.quotationheader.active,
	Locked = dbo.quotationheader.Locked,
	AutoInsertNewItems = dbo.quotationheader.AutoInsertNewItems,
	dbo.users.username,
	dbo.quotationheader.remarks,
	customer=accounts.name,
	customeralias=accounts.aliasname,
	headerno=quotationheader.headerno
FROM 
	dbo.quotationheader, users,
	accounts
WHERE 
	dbo.quotationheader.originaldate > :ad_invdate AND
	dbo.quotationheader.salesmancode = dbo.users.usercode and
	dbo.quotationheader.custcode=accounts.acccode
ORDER BY 
	quotationCode"
  arguments=(("as_salecatcode", number), ("as_posted", stringlist), ("ad_invdate", datetime))
)
