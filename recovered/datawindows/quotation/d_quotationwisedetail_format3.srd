header(height=1947 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=208 color="536870912" )
table(column=(type=long updatewhereclause=yes name=quotationcode dbname="quotationcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(150) updatewhereclause=yes name=genericname dbname="genericname"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="CustRefNo"  )
column=(type=char(150) updatewhereclause=yes name=remarks2 dbname="QuotationHeader.Remarks2"  )
column=(type=char(150) updatewhereclause=yes name=remarks3 dbname="QuotationHeader.Remarks3"  )
column=(type=char(150) updatewhereclause=yes name=remarks4 dbname="QuotationHeader.Remarks4"  )
column=(type=char(150) updatewhereclause=yes name=remarks5 dbname="QuotationHeader.Remarks5"  )
column=(type=char(150) updatewhereclause=yes name=remarks6 dbname="QuotationHeader.Remarks6"  )
column=(type=char(150) updatewhereclause=yes name=remarks7 dbname="QuotationHeader.Remarks7"  )
column=(type=char(150) updatewhereclause=yes name=remarks8 dbname="QuotationHeader.Remarks8"  )
column=(type=char(150) updatewhereclause=yes name=remarks9 dbname="QuotationHeader.Remarks9"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(30) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Person"  )
column=(type=decimal(6) updatewhereclause=yes name=totalsalestax dbname="totalsalestax"  )
 retrieve="SELECT  
	quotationcode = dbo.quotationheader.quotationcode,
	date = dbo.quotationheader.date,   
	genericname=(select name from genericitem where genericcode=item.genericcode),
	manufacturer=(select name from manufacturer where manufacturer.manfcode=item.manfcode),
	invdiscperc = dbo.quotationheader.discperc,    
	flatdisc = dbo.quotationheader.flatdisc,    
	misccharges = dbo.quotationheader.misccharges, 
	invsalestax = dbo.quotationheader.salestax,
	invgstperc1 = dbo.quotationheader.invgstperc1,
	CustRefNo   = dbo.quotationheader.remarks,
	dbo.quotationheader.Remarks2,
	dbo.quotationheader.Remarks3,
	dbo.quotationheader.Remarks4,
	dbo.quotationheader.Remarks5,
	dbo.quotationheader.Remarks6,
	dbo.quotationheader.Remarks7,
	dbo.quotationheader.Remarks8,
	dbo.quotationheader.Remarks9,
	posted = dbo.quotationheader.posted,	
	looseqty = dbo.quotationdetail.qty,
	itemalias=item.customicode,
	packingdesc=item.packingdesc, 
	packing=case
				when dbo.item.packcode IS Null then space(30) 
				else dbo.itempacking.name
			end,
	itemflatdisc=quotationdetail.itemflatdisc,
	
	price = dbo.quotationdetail.saleprice,    
	itemdiscperc = dbo.quotationdetail.discperc,    
	packunits = dbo.quotationdetail.packunits,    
	
	salestax  = quotationdetail.salestax,
	itemname = item.name,
	unitsalestax = dbo.quotationdetail.unitsalestax ,    
	gstperc = dbo.quotationdetail.gstperc ,    
	datestring = Rtrim(LTrim(Str(DatePart(dd, quotationheader.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, quotationheader.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, quotationheader.date)))), 
	Person = dbo.accounts.name,
	/* 
	invnettotalexctax= (SELECT 
				  amountfg = Round( 
										 Sum (  SD.qty *  SD.saleprice)    
										 -  Round(Sum (Round((  SD.qty  * ( SD.saleprice -  SD.itemflatdisc) * ( SD.discperc * .01)) + ( SD.qty  *  SD.itemflatdisc),2)), 2)    
										 - Sum ( Round( SD.qty   * ( SD.saleprice  -  SD.itemflatdisc) * (1 - ( SD.discperc * .01)),2)) * ( SL.discperc /100)
										 + misccharges - flatdisc,0)
	
		 FROM dbo.quotationheader SL , 
				dbo.quotationdetail SD
	
		 WHERE  (SL.quotationcode = dbo.quotationheader.quotationcode )   and
				  (SL.quotationcode = SD.quotationcode )   
	
		 GROUP BY SL.misccharges,   
					 SL.flatdisc,   
					 SL.date,   
					 SL.quotationcode, 
					 SL.invgstperc1, 
					 SL.discperc,  
					 SL.salestax 
	) , */
	totalsalestax = (SELECT invtotalsalestax= 
								 Round (
	/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( SD.qty * ( SD.saleprice - SD.itemflatdisc ) * (1 - SD.discperc * 0.01 ) , 2 ) )
										 * ( 1 - SL.discperc * 0.01 ) , 2 ) - SL.flatdisc ) * SL.invgstperc1 * 0.01  , 2 )
	/*items salestax*/		 + Sum (Round (SD.qty * SD.unitsalestax + Round ( Round (SD.qty * (SD.saleprice - SD.itemflatdisc ) * (1 - SD.discperc * 0.01 ), 2 ) * SD.gstperc * 0.01 , 2 ) , 2 ) )						 
								 , 0 )
		 FROM dbo.quotationheader SL , 
				dbo.quotationdetail SD
	
		 WHERE  (SL.quotationcode = dbo.quotationheader.quotationcode )   and
				  (SL.quotationcode = SD.quotationcode )   
	
		 GROUP BY SL.misccharges,   
					 SL.flatdisc,   
					 SL.date,   
					 SL.quotationcode, 
					 SL.invgstperc1, 
					 SL.discperc,  
					 SL.salestax 
	)
FROM
	dbo.quotationheader, 
	dbo.quotationdetail,    
	dbo.item LEFT OUTER JOIN ItemPacking ON (dbo.item.packcode = dbo.itempacking.packcode), 
	dbo.accounts
WHERE  
	dbo.quotationheader.quotationcode >= :al_sqcode and
	dbo.quotationheader.quotationcode <= :al_lqcode  and
	dbo.quotationheader.quotationcode = dbo.quotationdetail.quotationcode and  
	dbo.quotationdetail.icode = item.icode and 
	dbo.quotationheader.custcode = dbo.accounts.acccode
order by 
	quotationcode
"
  arguments=(("al_sqcode", number), ("al_lqcode", number), ("as_caption1", string), ("as_caption2", string), ("ai_printheader", number))
)
