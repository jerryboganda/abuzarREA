column=(type=long updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=long updatewhereclause=yes name=invsalestax dbname="salestax"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=balance dbname="balance"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(30) updatewhereclause=yes name=refno dbname="PurQuotationHeader.refno"  )
column=(type=char(150) updatewhereclause=yes name=remarks dbname="PurQuotationHeader.remarks"  )
column=(type=char(150) updatewhereclause=yes name=remarks2 dbname="remarks2"  )
column=(type=char(150) updatewhereclause=yes name=remarks3 dbname="remarks3"  )
column=(type=char(150) updatewhereclause=yes name=remarks4 dbname="remarks4"  )
column=(type=char(150) updatewhereclause=yes name=remarks5 dbname="remarks5"  )
 retrieve="SELECT
	itemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:' + LTRIM(RTRIM(item.customicode)) END,   
	aliasname=item.customicode,
	packingdesc=item.packingdesc,  
	accname = dbo.accounts.name,   
	address = dbo.supplier.address1,   
	address2= dbo.supplier.address2, 
	salesman = dbo.users.username,   
	quotationcode = dbo.purquotationheader.purquotationcode,   
	date = dbo.purquotationheader.date,   
	invdiscperc = dbo.purquotationheader.discperc,   
	misccharges = dbo.purquotationheader.misccharges,   
	flatdisc = dbo.purquotationheader.flatdisc,   
	invsalestax = 0,
	icode = purquotationdetail.icode,   
	looseqty = purquotationdetail.qty,   
	bonusqty = purquotationdetail.bonusqty,   
	packunits= purquotationdetail.packunits,   
	purprice= purquotationdetail.purprice,   
	saleprice= purquotationdetail.saleprice,   
	discperc = purquotationdetail.discperc,   
	salestax = 0,   
	Id = dbo.purquotationdetail.IDENTITYCOL,   
	posted=purquotationheader.posted,   
	balance=0,   
	unitsalestax = purquotationdetail.unitsalestax,   
	gstperc = purquotationdetail.gstperc,   
	invgstperc = purquotationheader.invgstperc1,   
	dbo.purquotationheader.refno,	
	dbo.purquotationheader.remarks,
	remarks2=purquotationheader.remarks2,
	remarks3=purquotationheader.remarks3, 
	remarks4=purquotationheader.remarks4,
	remarks5=purquotationheader.remarks5
	
FROM 
	purquotationheader,   
	purquotationdetail,   
	accounts,   
	supplier,   
	users,   
	item  
	
WHERE 
	( dbo.purquotationheader.purquotationcode = :ar_invcode ) AND  
	( dbo.purquotationheader.purquotationcode = dbo.purquotationdetail.purquotationcode) AND  
	( dbo.purquotationheader.suppcode = dbo.accounts.acccode ) AND  
	( dbo.supplier.suppcode = dbo.accounts.acccode ) AND  
	( dbo.purquotationheader.usercode = dbo.users.usercode ) AND  
	( dbo.purquotationdetail.icode = dbo.item.icode)    
ORDER BY 
	dbo.purquotationdetail.IDENTITYCOL"
  arguments=(("ar_InvCode", number))
)
