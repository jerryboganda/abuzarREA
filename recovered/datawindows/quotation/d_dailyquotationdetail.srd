compute(name=compute_3 visible="1" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="2907" y="344" height="64" width="471" format="#,##0.00" expression=" Round ( Sum( c_amount for all) + sum ( misccharges for all distinct  quotationcode ) -  sum ( flatdisc  for all distinct quotationcode ) - Sum(  Round ( ( ( looseqty   *  price  ) - ( itemflatdisc *  looseqty) )    *  ( 1 -  (    itemdiscperc * .01 )  ) * (   invdiscperc  * 0.01 )   , 2)   for all ) , 0)  + Round ( Sum ( totalsalestax  for all distinct quotationcode ) , 0 )  " alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
