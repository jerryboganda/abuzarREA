release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1572 color="536870912" )
summary(height=531 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(6) updatewhereclause=yes name=gross dbname="gross"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=decimal(6) updatewhereclause=yes name=totaldiscount dbname="totaldiscount"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="CustomerAlias"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsalestax dbname="itemsalestax"  )
 retrieve="SELECT 
	invcode     = dbo.quotationheader.quotationcode,    
	date        = dbo.quotationheader.date,    
	flatdisc    = dbo.quotationheader.flatdisc, 
	salestax    = dbo.quotationheader.salestax,       
	misccharges = dbo.quotationheader.misccharges, 
	invdiscperc = dbo.quotationheader.discperc, 
	invgstperc1 = dbo.quotationheader.invgstperc1, 
	posted = dbo.quotationheader.posted,
	dbo.accounts.name, 
	remarks=max(quotationheader.remarks),
	custrefno=max(quotationheader.custrefno),
	amount =  Sum ( dbo.quotationdetail.qty * dbo.quotationdetail.saleprice),   
	gross= Sum ( dbo.quotationdetail.qty * dbo.quotationdetail.saleprice), 
	itemdiscpercvalue = Round(Sum (Round(( dbo.quotationdetail.qty  * (dbo.quotationdetail.saleprice - dbo.quotationdetail.itemflatdisc) * (dbo.quotationdetail.discperc * .01)) + (dbo.quotationdetail.qty  * dbo.quotationdetail.itemflatdisc),2)), 2),    
	invdiscpercvalue = Sum (Round( dbo.quotationdetail.qty   * (dbo.quotationdetail.saleprice  - dbo.quotationdetail.itemflatdisc) * (1 - (dbo.quotationdetail.discperc * .01)),2)) * (dbo.quotationheader.discperc /100),
	salesman = dbo.users.username ,
	totaldiscount= Round(Sum (Round(( dbo.quotationdetail.qty  * (dbo.quotationdetail.saleprice - dbo.quotationdetail.itemflatdisc) * (dbo.quotationdetail.discperc * .01)) + (dbo.quotationdetail.qty  * dbo.quotationdetail.itemflatdisc),2)), 2) + Round(Sum ( dbo.quotationdetail.qty   * (dbo.quotationdetail.saleprice  - dbo.quotationdetail.itemflatdisc) * (1 - (dbo.quotationdetail.discperc * .01))) * (dbo.quotationheader.discperc /100), 2) + dbo.quotationheader.flatdisc,
	CustomerAlias=max(accounts.aliasname),
	itemsalestax = Sum (Round (dbo.quotationdetail.qty * dbo.quotationdetail.unitsalestax + Round ( Round (dbo.quotationdetail.qty * (dbo.quotationdetail.saleprice - dbo.quotationdetail.itemflatdisc ) * (1 - dbo.quotationdetail.discperc * 0.01 ), 2 ) * dbo.quotationdetail.gstperc * 0.01 , 2 ) , 2 ) )
FROM
	dbo.quotationheader,
	dbo.quotationdetail,   
	dbo.accounts,
	dbo.users 
WHERE 
	( dbo.quotationheader.quotationcode = dbo.quotationdetail.quotationcode ) and 
	( dbo.quotationheader.custcode = dbo.accounts.acccode )and  
	( dbo.quotationheader.salesmancode = dbo.users.usercode )and  
	( dbo.quotationheader.date between :ar_StartDate and :ar_EndDate)  
GROUP BY 
	dbo.quotationheader.misccharges,   
	dbo.quotationheader.flatdisc,   
	dbo.quotationheader.date,   
	dbo.quotationheader.quotationcode,   
	dbo.quotationheader.discperc,  
	dbo.quotationheader.salestax, 
	dbo.quotationheader.invgstperc1 ,
	dbo.quotationheader.posted, 
	dbo.accounts.name,
	dbo.users.username 
ORDER BY 
	dbo.quotationheader.quotationcode ASC,   
	dbo.quotationheader.date ASC 
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
