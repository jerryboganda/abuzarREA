release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1302 color="536870912" )
summary(height=1000 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=icode dbname="Item.ICode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Item.Name"  )
column=(type=char(2000) updatewhereclause=yes name=rejectedquotlist dbname="RejectedQuotList"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=decimal(4) updatewhereclause=yes name=requestedqty dbname="RequestedQty"  )
column=(type=char(1) updatewhereclause=yes name=requestedloosepack dbname="RequestedLoosePack"  )
column=(type=decimal(4) updatewhereclause=yes name=givenqty dbname="GivenQty"  )
column=(type=char(1) updatewhereclause=yes name=givenloosepack dbname="GivenLoosePack"  )
column=(type=decimal(4) updatewhereclause=yes name=balanceqty dbname="BalanceQty"  )
column=(type=char(1) updatewhereclause=yes name=balanceloosepack dbname="BalanceLoosePack"  )
 retrieve="Select  A.ICode,
	I.Name,
     RejectedQuotList = dbo.Fn_GetQuotProcessedRejectItemList( :adt_sdate , :adt_edate ) ,
	Supplier = IsNull(Supplier.Name, 'Supplier Not Available') ,
	CASE ( (A.Qty / I.PackUnits) - CAST(A.Qty / I.PackUnits AS INT) ) When 0 Then (A.Qty / I.PackUnits) Else A.Qty End As RequestedQty,
	CASE ( (A.Qty / I.PackUnits) - CAST(A.Qty / I.PackUnits AS INT) ) When 0 Then '' Else 'L' End As RequestedLoosePack,
	ISNULL(CASE ( (B.Qty / I.PackUnits) - CAST(B.Qty / I.PackUnits AS INT) ) When 0 Then (B.Qty / I.PackUnits) Else B.Qty End, 0 ) As GivenQty,
	CASE When ( (B.Qty / I.PackUnits) - CAST(B.Qty / I.PackUnits AS INT) ) = 0 Then '' Else 'L' End As GivenLoosePack,
	CASE ( (A.Qty - IsNull(B.Qty,0) / I.PackUnits) - CAST((A.Qty - IsNull(B.Qty,0)) / I.PackUnits AS INT) ) When 0 Then ( (A.Qty - IsNull(B.Qty,0) ) / I.PackUnits) Else (A.Qty - IsNull(B.Qty,0) ) End As BalanceQty,
	CASE ( (A.Qty - IsNull(B.Qty,0) / I.PackUnits) - CAST((A.Qty - IsNull(B.Qty,0)) / I.PackUnits AS INT) ) When 0 Then '' Else 'L' End As BalanceLoosePack
From 
(
Select 	QD.icode As ICode, Sum(Case QH.LoosePack When 1 Then QD.qty When 2 Then QD.Qty * QD.PackUnits End) As Qty , 'Q' As Type
from 		QuotationHeader QH Inner Join QuotationDetail QD On QH.QuotationCode = QD.QuotationCode Inner Join SaleLedger SL On SL.QuotationNo = QH.QuotationCode
Where  	QH.Date Between :adt_sdate And :adt_edate
group by QD.icode
) A Left Outer Join 
(
Select 	 SD.Icode As ICode, Sum(SD.LooseQty) As Qty, 'S' As Type
From   	 QuotationHeader QH Inner Join QuotationDetail QD On QH.QuotationCode = QD.QuotationCode Inner Join SaleLedger SL ON QH.QuotationCode = SL.QuotationNo Inner Join SaleDetail SD On SL.SaleInvCode = SD.SaleInvCode
Where  	 QH.Date Between :adt_sdate And :adt_edate AND
	 QD.Icode = SD.ICode
Group By SD.ICode
) B On A.ICode = B.ICode Left Outer Join
(
Select A.Name, S.SuppCode,S.ICode
From  ItemSuppliers s Inner Join Accounts A ON A.AccCode = s.Suppcode Inner Join
(
Select icode, min(priority) as priority
From itemsuppliers
Group By icode ) si 
On s.icode = si.icode
Where s.priority = si.priority
) Supplier
On A.Icode = Supplier.ICode Inner Join Item I ON A.ICode = I.ICode

Where ( A.Qty - IsNull(B.Qty,0) ) > 0
"
  update="Item" updatewhere=0 updatekeyinplace=no
  arguments=(("adt_sdate", datetime), ("adt_edate", datetime))
 sort="supplier A, name A"
)
