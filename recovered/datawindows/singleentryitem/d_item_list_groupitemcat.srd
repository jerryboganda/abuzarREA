summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.Name"  )
column=(type=long updatewhereclause=yes name=code dbname="Item.ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.CustomICode"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="Item.purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Item.saleprice"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Item.packunits"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.Name"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="ItemPacking.name"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass.name"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory.name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
 retrieve="SELECT 
	Item.Name,   
	Item.ICode,   
	Item.CustomICode,   
	Item.purprice,
	Item.saleprice,
	Item.packunits,
	Manufacturer.Name,
	ItemPacking.name,
	itemclass.name,
	itemcategory.name,
	Active=case item.active when 1 then 'Y'
				else 'N'
			end,
	stock=(select isnull(sum(currqty),0) from godowndetail 
			where godowndetail.icode=item.icode) 
FROM
	Item 
	LEFT OUTER JOIN ItemPacking ON (Item.Packcode = ItemPacking.PackCode)
	LEFT OUTER JOIN itemclass ON (Item.Iccode = itemClass.iccode),   
	Manufacturer,
	itemcategory
WHERE
	( Item.ManfCode = Manufacturer.ManfCode )    and
	( Item.icatcode = itemcategory.Icatcode) 		and
	  Item.icatcode In (Select ItemsCategoryCode 
							  From   ItemsGroupCategory
							  Where  groupcode = :ai_groupcode )
"
  arguments=(("ai_groupcode", number))
)
