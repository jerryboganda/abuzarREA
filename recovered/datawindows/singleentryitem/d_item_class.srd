detail(height=444 color="536870912" )
table(column=(type=long updatewhereclause=yes name=tmp dbname="tmp"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ItemClass.iccode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="ItemClass.name"  )
column=(type=decimal(3) update=yes updatewhereclause=yes initial="1" name=numericalfactor dbname="ItemClass.numericalfactor"  )
 retrieve="SELECT tmp=1, 
	itemclass.iccode ,  
	itemclass.name,
	itemclass.numericalfactor   
FROM itemclass

WHERE ( itemclass.iccode = :ra_item_class )   "
  update="itemclass" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_item_class", number))
)
