column=(type=long updatewhereclause=yes name=prescribed dbname="Item.Prescribed"  )
column=(type=long updatewhereclause=yes name=refrigrated dbname="Item.Refrigrated"  )
column=(type=long updatewhereclause=yes name=printable dbname="Item.Printable"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
 retrieve="SELECT 
	dbo.item.icode,
	dbo.item.customicode,
	dbo.item.name,
	dbo.item.manfcode, 
	dbo.item.packunits,
	dbo.item.saleprice,
	dbo.Item.ICCode,   
	dbo.Item.ICatCode,   
	dbo.Item.Packcode,   
	dbo.Item.SalePrice,   
	dbo.Item.PurPrice,   
	dbo.Item.RetailPrice,   
	dbo.Item.AvgPrice,   
	dbo.Item.SaleDiscPerc,   
	dbo.Item.PurDiscPerc,   
	dbo.Item.SalesTax,   
	dbo.Item.ReorderQty,   
	dbo.Item.OptimumQty,   
	dbo.Item.PackUnits,   
	dbo.Item.Active,   
	dbo.Item.Prescribed,   
	dbo.Item.Refrigrated,   
	dbo.Item.Printable,   
	stock = (select  sum(dbo.godowndetail.currqty) 
				from dbo.godowndetail 
				where dbo.godowndetail.icode = dbo.item.icode)
FROM 
	dbo.item 
ORDER BY 
	dbo.item.name
"
  update="item" updatewhere=0 updatekeyinplace=no
 )
