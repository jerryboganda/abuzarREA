release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=132 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.Name"  )
column=(type=long updatewhereclause=yes name=code dbname="Item.ICode"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="Item.purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Item.saleprice"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Item.packunits"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.Name"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="ItemPacking.name"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass.name"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory.name"  )
column=(type=char(60) updatewhereclause=yes name=itempart dbname="itempart"  )
column=(type=char(60) updatewhereclause=yes name=olditempart dbname="olditempart"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=long updatewhereclause=yes name=itemalertcode dbname="Item.itemalertcode" 
 values=""  )
column=(type=char(1) updatewhereclause=yes name=allowdue dbname="AllowDue" 
 values="Yes	Y/No	N/"  )
column=(type=long updatewhereclause=yes name=itemdesigncode dbname="Item.ItemDesignCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=ibrandcode dbname="Item.IBrandCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=location dbname="Item.Location"  )
column=(type=char(100) updatewhereclause=yes name=shortname dbname="ShortName"  )
column=(type=char(1) updatewhereclause=yes name=loyaltyitem dbname="LoyaltyItem" 
 values="Yes	Y/No	N/"  )
column=(type=char(100) updatewhereclause=yes name=regdno dbname="RegdNo"  )
 retrieve="SELECT 
	Item.Name,   
	Item.ICode,   
	item.purprice,
	item.saleprice,
	item.packunits,
	Item.CustomICode,   
	Manufacturer.Name,
	ItemPacking.name,
	itemclass.name,
	itemcategory.name,
	itempart = (SELECT itempart.name FROM itempart where item.ipartcode = itempart.ipartcode),
	olditempart = (SELECT itempart.name FROM itempart where item.oldpartcode = itempart.ipartcode),
	Active=case item.active when 1 then 'Y'
				else 'N'
			end,
	stock=(select isnull(sum(currqty),0) from godowndetail 
			where godowndetail.icode=item.icode) ,
	itemalertcode,
	AllowDue=Item.AllowDue,
	ItemDesignCode,
	IBrandCode,
	Location,
	ShortName=Item.ShortName,
	LoyaltyItem=Item.LoyaltyItem,
	RegdNo = Item.RegdNo
FROM
	Item 
	LEFT OUTER JOIN ItemPacking ON (Item.Packcode = ItemPacking.PackCode)
	LEFT OUTER JOIN itemclass ON (Item.Iccode = itemClass.iccode),   
	Manufacturer,
	itemcategory
WHERE
	( Item.ManfCode = Manufacturer.ManfCode )    and
	( Item.icatcode = itemcategory.Icatcode)"
 )
