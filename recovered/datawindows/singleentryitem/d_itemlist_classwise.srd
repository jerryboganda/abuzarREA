release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=300 print.margin.top=0 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1572 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.CustomICode"  )
column=(type=char(8000) updatewhereclause=yes name=itemname dbname="NAME"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Item.PackingDesc"  )
column=(type=long key=yes updatewhereclause=yes name=item_icode dbname="Item.icode"  )
column=(type=decimal(8) updatewhereclause=yes name=purprice dbname="PurPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="Item.RetailPrice"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="Item.PackingDesc"  )
column=(type=decimal(8) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=salediscperc dbname="SaleDiscPerc"  )
column=(type=char(20) updatewhereclause=yes name=itemclass dbname="itemclass"  )
column=(type=decimal(2) updatewhereclause=yes name=purdiscperc dbname="Item.PurDiscPerc"  )
 retrieve="SELECT	Item.CustomICode,   
			NAME=RTRIM(LTRIM(Item.Name)) + ' ' + REPLICATE('-',50-LEN(RTRIM(LTRIM(Item.Name)))),
			Item.PackingDesc,
			Item.icode,   
         PurPrice=(item.purprice/ISNULL(item.packunits,1)),   
         Item.RetailPrice,    
         Item.PackingDesc,   
         SalePrice=(CASE  :ar_salepriceno WHEN 1 THEN item.saleprice/ISNULL(item.packunits,1)
								 WHEN  2 THEN item.saleprice2/ISNULL(item.packunits,1)
								 WHEN  3 THEN item.saleprice3/ISNULL(item.packunits,1)
								 WHEN  4 THEN item.saleprice4/ISNULL(item.packunits,1)
								 WHEN  5 THEN item.saleprice5/ISNULL(item.packunits,1)
							END),
			SaleDiscPerc= (CASE :ar_salediscno WHEN 1 THEN salediscperc
										WHEN 2 THEN salediscperc2
										WHEN 3 THEN salediscperc3
										WHEN 4 THEN salediscperc4
										WHEN 5 THEN salediscperc5
								END
										),
			
			itemclass = CASE :as_type WHEN 'M' THEN ISNULL((SELECT Manufacturer.name FROM Manufacturer WHERE Manufacturer.ManfCode = item.manfcode), '')
			WHEN 'C' THEN ISNULL((SELECT ItemCategory.name FROM ItemCategory WHERE ItemCategory.ICatCode = item.icatcode), '')
			WHEN 'L' THEN ISNULL((SELECT ItemClass.name FROM ItemClass WHERE ItemClass.ICCode = item.iccode), '')
			ELSE ISNULL((SELECT itempacking.name FROM itempacking WHERE itempacking.PackCode = item.packcode), '') END,

			Item.PurDiscPerc 
    FROM Item
   WHERE 
	CASE :as_type WHEN 'M' THEN Item.ManfCode
		WHEN 'C' THEN Item.ICatCode
		WHEN 'L' THEN Item.ICCode
				 ELSE Item.PackCode END in (:aa_code) 
ORDER BY itemclass,item.name



"
  update="Item" updatewhere=0 updatekeyinplace=no
  arguments=(("aa_code", numberlist), ("ar_salepriceno", number), ("ar_salediscno", number), ("as_type", string))
)
