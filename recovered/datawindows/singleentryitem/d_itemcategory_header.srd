table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ItemCategory.ICatCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="ItemCategory.Name"  )
 retrieve="SELECT 
	ItemCategory.ICatCode,   
	ItemCategory.Name  
FROM ItemCategory   
WHERE ItemCategory.ICatCode = :code"
  update="ItemCategory" updatewhere=1 updatekeyinplace=yes
  arguments=(("code", number))
)
