table(column=(type=char(1) updatewhereclause=yes name=taxtypecode dbname="TaxTypeCode"  )
column=(type=char(22) updatewhereclause=yes name=taxtypename dbname="TaxTypeName"  )
column=(type=char(81) updatewhereclause=yes name=taxtypedetails dbname="TaxTypeDetails"  )
 retrieve="SELECT
	TaxTypeCode='S',
	TaxTypeName='Sale/Transaction Price',
	TaxTypeDetails='Apply Tax on Transaction Price after discounts.' 
UNION ALL
SELECT
	TaxTypeCode='R',
	TaxTypeName='Retail Price',
	TaxTypeDetails='Apply Tax on Retail Price.' 
UNION ALL
SELECT
	TaxTypeCode='D',
	TaxTypeName='Discounted Net Price',
	TaxTypeDetails='Retail Price is Ex. S/Tax, Apply Tax on Retail Price (Substract from Net Price)' 
UNION ALL
SELECT
	TaxTypeCode='E',
	TaxTypeName='Discounted Net Price 2',
	TaxTypeDetails='Retail Price is Incl. S/Tax, Apply Tax on Retail Price (Substract from Net Price)' 
UNION ALL
SELECT
	TaxTypeCode='I',
	TaxTypeName='S/Tax Inclusive Price',
	TaxTypeDetails='Extract Sales Tax Amount from Transaction Price.' 
ORDER BY
	TaxTypeName"
 )
