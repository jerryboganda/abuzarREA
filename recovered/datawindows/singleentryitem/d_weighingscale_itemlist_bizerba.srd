table(column=(type=long updatewhereclause=yes name=addremove dbname="ADDREMOVE"  )
column=(type=char(75) updatewhereclause=yes name=item_num dbname="Item_Num"  )
column=(type=long updatewhereclause=yes name=deptid dbname="DeptID"  )
column=(type=decimal(0) updatewhereclause=yes name=price dbname="Price"  )
column=(type=long updatewhereclause=yes name=weightitem dbname="WeightItem"  )
column=(type=long updatewhereclause=yes name=barcodestructureno dbname="BarCodeStructureNo"  )
column=(type=long updatewhereclause=yes name=expirydays dbname="ExpiryDays"  )
column=(type=long updatewhereclause=yes name=changeprice dbname="ChangePrice"  )
column=(type=char(50) updatewhereclause=yes name=item_name dbname="Item_Name"  )
 retrieve="SELECT 
	ADDREMOVE=0,
	Item_Num = I.CustomICode,
	DeptID = 1,
	Price=CAST(I.SalePrice * CASE WHEN :ai_priceindecimals = 2 THEN 100 ELSE 1 END AS NUMERIC(18,0)),
	WeightItem=0,
	BarCodeStructureNo=21,
	ExpiryDays=0,
	ChangePrice=0,
	Item_Name = LEFT(I.Name, 50)
FROM 
	Item I
WHERE
	CASE :as_grouping 
	WHEN 'M' THEN I.ManfCode 
	WHEN 'C' THEN I.ICatCode 
	WHEN 'L' THEN I.ICCode 
	WHEN 'P' THEN I.PackCode 
	END IN (:ai_groupcode) AND
	LEN(I.CustomICode) <= (SELECT WS.itemendpos - WS.itemstartpos + 1 FROM WeighingScale WS WHERE WS.WeighingScaleCode = :ai_weighingscalecode)
ORDER BY
	Item_Num"
  arguments=(("as_grouping", string), ("ai_groupcode", numberlist), ("ai_weighingscalecode", number), ("ai_priceindecimals", number))
)
