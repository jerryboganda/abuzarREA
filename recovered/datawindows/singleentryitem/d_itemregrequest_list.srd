column=(type=long updatewhereclause=yes name=itemalertcode dbname="itemalertcode" 
 values=""  )
column=(type=char(1) updatewhereclause=yes name=allowdue dbname="AllowDue" 
 values="Yes	Y/No	N/"  )
column=(type=long updatewhereclause=yes name=itemdesigncode dbname="ItemDesignCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=ibrandcode dbname="IBrandCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=location dbname="Location"  )
column=(type=char(100) updatewhereclause=yes name=shortname dbname="ShortName"  )
column=(type=char(1) updatewhereclause=yes name=loyaltyitem dbname="LoyaltyItem" 
 values="Yes	Y/No	N/"  )
column=(type=char(100) updatewhereclause=yes name=regdno dbname="RegdNo"  )
 retrieve="SELECT 
	Sent=ItemRegRequest.Sent,   
	ICode=ItemRegRequest.ICode,   
	Status = ItemRegRequest.Status,   
	Name=ItemRegRequest.Name,   
	Code=ItemRegRequest.ItemRegReqCode,   
	purprice=ItemRegRequest.purprice,
	saleprice=ItemRegRequest.saleprice,
	packunits=ItemRegRequest.packunits,
	CustomICode=ItemRegRequest.CustomICode,   
	Manufacturer=Manufacturer.Name,
	ItemPacking=ItemPacking.name,
	itemclass=itemclass.name,
	itemcategory=itemcategory.name,
	itempart = (SELECT itempart.name FROM itempart where ItemRegRequest.ipartcode = itempart.ipartcode),
	olditempart = (SELECT itempart.name FROM itempart where ItemRegRequest.oldpartcode = itempart.ipartcode),
	Active=case ItemRegRequest.active when 1 then 'Y'
				else 'N'
			end,
	stock=0.0000,
	itemalertcode=ItemRegRequest.itemalertcode,
	AllowDue=ItemRegRequest.AllowDue,
	ItemDesignCode=ItemRegRequest.ItemDesignCode,
	IBrandCode=ItemRegRequest.IBrandCode,
	Location=ItemRegRequest.Location,
	ShortName=ItemRegRequest.ShortName,
	LoyaltyItem=ItemRegRequest.LoyaltyItem,
	RegdNo = ItemRegRequest.RegdNo
FROM
	ItemRegRequest 
	LEFT OUTER JOIN ItemPacking ON (ItemRegRequest.Packcode = ItemPacking.PackCode)
	LEFT OUTER JOIN itemclass ON (ItemRegRequest.Iccode = itemClass.iccode),   
	Manufacturer,
	itemcategory
WHERE
	( ItemRegRequest.ManfCode = Manufacturer.ManfCode )    and
	( ItemRegRequest.icatcode = itemcategory.Icatcode)"
 )
