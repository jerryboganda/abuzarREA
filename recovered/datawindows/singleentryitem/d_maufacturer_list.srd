table(column=(type=char(40) updatewhereclause=yes name=shortname dbname="Manufacturer.shortname"  )
column=(type=char(5) updatewhereclause=yes name=aliasname dbname="Manufacturer.aliasname"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Manufacturer.name"  )
column=(type=char(30) update=yes updatewhereclause=yes name=city dbname="Manufacturer.city"  )
column=(type=long key=yes updatewhereclause=yes name=code dbname="Manufacturer.manfcode"  )
column=(type=char(60) updatewhereclause=yes name=manufacturercategory dbname="ManufacturerCategory"  )
column=(type=char(100) updatewhereclause=yes name=manufacturertype dbname="ManufacturerType"  )
column=(type=char(100) updatewhereclause=yes name=purorderpolicy dbname="PurOrderPolicy"  )
 retrieve="SELECT 
	manufacturer.shortname,
	manufacturer.aliasname,
	manufacturer.name ,
	manufacturer.city , 
	manufacturer.manfcode,
	ManufacturerCategory = (SELECT P.Name FROM ManufacturerCategory P WHERE P.ManfCatCode = Manufacturer.ManfCatCode),
	ManufacturerType = (SELECT P.Name FROM ManufacturerType P WHERE P.ManufacturerTypeCode = Manufacturer.ManufacturerTypeCode),
	PurOrderPolicy = (SELECT P.Name FROM POPolicy P WHERE P.POPolicyCode = Manufacturer.POPolicyCode)  
FROM  manufacturer    "
  update="manufacturer" updatewhere=1 updatekeyinplace=no
 )
