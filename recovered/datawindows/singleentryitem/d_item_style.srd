detail(height=444 color="536870912" )
table(column=(type=long updatewhereclause=yes name=tmp dbname="tmp"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ItemStyle.IStylecode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="ItemStyle.name"  )
column=(type=char(100) update=yes updatewhereclause=yes name=description dbname="ItemStyle.description"  )
 retrieve="  SELECT tmp=1, 
			ItemStyle.IStylecode ,  
         ItemStyle.name,
			ItemStyle.description

    FROM ItemStyle      

   WHERE ( ItemStyle.IStyleCode = :ra_style_code )   "
  update="ItemStyle" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_style_code", number))
)
