table(column=(type=long updatewhereclause=yes name=tmp dbname="tmp"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ItemCategory.icatcode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="ItemCategory.name"  )
column=(type=decimal(3) update=yes updatewhereclause=yes initial="1" name=numericalfactor dbname="ItemCategory.NumericalFactor"  )
column=(type=long update=yes updatewhereclause=yes initial="90" name=saleexpirydays dbname="ItemCategory.SaleExpiryDays"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=categorysegmentcode dbname="ItemCategory.categorysegmentcode" 
 values=""  )
 retrieve="SELECT  
	tmp=1 ,
	itemcategory.icatcode ,
	itemcategory.name,
	itemcategory.NumericalFactor,
	itemcategory.SaleExpiryDays,
	ItemCategory.categorysegmentcode
FROM 
	itemcategory      
WHERE 
	( itemcategory.icatcode = :ra_item_category )"
  update="itemcategory" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_item_category", number))
)
