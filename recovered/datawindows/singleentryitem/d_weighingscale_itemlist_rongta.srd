table(column=(type=long updatewhereclause=yes name=hotkey dbname="HotKey"  )
column=(type=char(20) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(75) updatewhereclause=yes name=lfcode dbname="LFCode"  )
column=(type=char(75) updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=barcodetype dbname="BarCodeType"  )
column=(type=long updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
column=(type=long updatewhereclause=yes name=unitweight dbname="UnitWeight"  )
column=(type=long updatewhereclause=yes name=department dbname="Department"  )
column=(type=decimal(3) updatewhereclause=yes name=ptweight dbname="PTWeight"  )
column=(type=long updatewhereclause=yes name=shelftime dbname="ShelfTime"  )
column=(type=long updatewhereclause=yes name=packtype dbname="PackType"  )
column=(type=decimal(3) updatewhereclause=yes name=tare dbname="Tare"  )
column=(type=long updatewhereclause=yes name=error dbname="Error"  )
column=(type=long updatewhereclause=yes name=message1 dbname="Message1"  )
column=(type=long updatewhereclause=yes name=message2 dbname="Message2"  )
column=(type=long updatewhereclause=yes name=label dbname="Label"  )
column=(type=long updatewhereclause=yes name=discounttable dbname="DiscountTable"  )
column=(type=long updatewhereclause=yes name=account dbname="Account"  )
column=(type=long updatewhereclause=yes name=plutitle dbname="PluTitle"  )
column=(type=long updatewhereclause=yes name=account2 dbname="Account2"  )
column=(type=long updatewhereclause=yes name=recommendeddays dbname="RecommendedDays"  )
column=(type=long updatewhereclause=yes name=nutrition dbname="Nutrition"  )
 retrieve="SELECT 
	HotKey = 0,
	Name = LEFT(I.Name, 20),
	LFCode=I.CustomICode,
	Code=I.CustomICode,
	BarCodeType=CASE WHEN I.AllowSaleInDecimalQty = 'Y' THEN 7 ELSE 9 END,
	UnitPrice= CAST(STR(ROUND(I.SalePrice * 100, 0), 10) AS INT),
	UnitWeight =CASE WHEN I.AllowSaleInDecimalQty = 'Y' THEN 4 ELSE 9 END,
/*	UnitAmount = 0.00,*/
	Department=(SELECT CAST(WS.ScaleID AS INT) FROM WeighingScale WS WHERE WS.WeighingScaleCode = :ai_weighingscalecode),
	PTWeight = CASE WHEN I.AllowSaleInDecimalQty = 'Y' THEN 0.000 ELSE 0 END,
	ShelfTime=15,
	PackType = 0,
	Tare=0.000,
	Error=0,
	Message1=0,
	Message2=0,
	Label=0,
	DiscountTable=0,
	Account=0,
	PluTitle=0,
	Account2=0,
	RecommendedDays=0,
	Nutrition=0
FROM 
	Item I
WHERE
	CASE :as_grouping 
	WHEN 'M' THEN I.ManfCode 
	WHEN 'C' THEN I.ICatCode 
	WHEN 'L' THEN I.ICCode 
	WHEN 'P' THEN I.PackCode 
	END IN (:ai_groupcode) AND
	LEN(I.CustomICode) <= (SELECT WS.itemendpos - WS.itemstartpos + 1 FROM WeighingScale WS WHERE WS.WeighingScaleCode = :ai_weighingscalecode)
ORDER BY
	Code"
  arguments=(("as_grouping", string), ("ai_groupcode", numberlist), ("ai_weighingscalecode", number), ("ai_priceindecimals", number))
)
