table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Manufacturer.manfcode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Manufacturer.name"  )
column=(type=char(60) update=yes updatewhereclause=yes initial="." name=address1 dbname="Manufacturer.address1"  )
column=(type=char(60) update=yes updatewhereclause=yes initial="." name=address2 dbname="Manufacturer.address2"  )
column=(type=char(30) update=yes updatewhereclause=yes initial="Lahore" name=city dbname="Manufacturer.city"  )
column=(type=char(30) update=yes updatewhereclause=yes initial="Pakistan" name=country dbname="Manufacturer.country"  )
column=(type=char(30) update=yes updatewhereclause=yes initial="." name=phone dbname="Manufacturer.phone"  )
column=(type=char(16) update=yes updatewhereclause=yes initial="." name=fax dbname="Manufacturer.fax"  )
column=(type=char(60) update=yes updatewhereclause=yes initial="." name=cp dbname="Manufacturer.cp"  )
column=(type=char(30) update=yes updatewhereclause=yes initial="." name=email dbname="Manufacturer.email"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=manfcatcode dbname="Manufacturer.manfcatcode" 
 values=""  )
column=(type=char(5) update=yes updatewhereclause=yes name=aliasname dbname="Manufacturer.aliasname"  )
column=(type=long update=yes updatewhereclause=yes validation="  real(gettext()) >= 0 " initial="45" name=purorderbaseperioddays dbname="Manufacturer.PurOrderBasePeriodDays"  )
column=(type=long update=yes updatewhereclause=yes validation="  real(gettext()) >= 0 " initial="30" name=purorderprojperioddays dbname="Manufacturer.PurOrderProjPeriodDays"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=popolicycode dbname="Manufacturer.POPolicyCode" 
 values=""  )
column=(type=char(40) update=yes updatewhereclause=yes name=shortname dbname="Manufacturer.ShortName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=licenseno dbname="Manufacturer.LicenseNo"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=manufacturertypecode dbname="Manufacturer.ManufacturerTypeCode" 
 values=""  )
 retrieve="SELECT
	manfcode ,
	name ,
	address1 , 
	address2 , 
	city , 
	country , 
	phone , 
	fax , 
	cp , 
	email,
	manfcatcode,
	aliasname,
	PurOrderBasePeriodDays,
	PurOrderProjPeriodDays,
	POPolicyCode,
	ShortName,
	LicenseNo,
	ManufacturerTypeCode
FROM
	manufacturer      
WHERE
	( dbo.manufacturer.ManfCode = :ar_manuf_code )
"
  update="manufacturer" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_manuf_code", number))
)
