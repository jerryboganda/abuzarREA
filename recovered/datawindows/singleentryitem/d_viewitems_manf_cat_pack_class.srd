column=(type=decimal(2) updatewhereclause=yes validation="Real( GetText() ) >= 0" name=gstperc2 dbname="Item.GSTPerc2"  )
column=(type=char(1) updatewhereclause=yes name=printexpiry dbname="Item.printexpiry" 
 values="YES	Y/NO	N/"  )
column=(type=long updatewhereclause=yes name=packcode dbname="Item.packcode" 
 values=""  )
column=(type=long updatewhereclause=yes name=item_usercode dbname="Item.usercode"  )
column=(type=datetime updatewhereclause=yes name=item_lastupdate dbname="Item.lastupdate"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" name=packingcost dbname="Item.packingcost"  )
column=(type=long updatewhereclause=yes name=minqty dbname="Item.minqty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice4 dbname="Item.saleprice4"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice5 dbname="Item.saleprice5"  )
column=(type=long updatewhereclause=yes name=newprice dbname="newprice"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
 retrieve="SELECT
	item.customicode,
	item.name,
	item.saleprice,
	item.icode,
	item.Packcode, 
	item.SalePrice,
	item.PurPrice, 
	item.SaleDiscPerc, 
	item.PurDiscPerc, 
	item.ReorderQty, 
	item.OptimumQty,
	item.greorderqty,
	item.goptimumqty, 
	item.PackUnits, 
	item.Active ,
	item.Prescribed ,
	item.icatcode,
	item.Refrigrated ,
	item.saleprice2,
	item.saleprice3,
	item.Printable ,
	item.iccode,
	item.packSalestax,
	item.GSTPerc1,
	item.GSTPerc2,
	item.printexpiry,
	item.packcode,
	item.usercode,
	item.lastupdate,
	item.packingcost,
	item.minqty,
	item.saleprice4,
	item.saleprice5,
	newprice=:ar_price,
	stock=ISNULL((SELECT SUM(G.currqty) FROM GodownDetail G WHERE G.ICODE = Item.ICode), 0)
FROM 
	item
WHERE
	item.manfcode = :ar_manfcode AND 
	item.icatcode = :ar_catcode AND 
	item.packcode = :ar_packcode AND 
	item.iccode = :ar_classcode AND 
	item.Active   = :ar_active
ORDER BY
	item.name"
  update="item" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_manfcode", number), ("ar_catcode", number), ("ar_packcode", number), ("ar_classcode", number), ("ar_active", number), ("ar_price", number))
)
