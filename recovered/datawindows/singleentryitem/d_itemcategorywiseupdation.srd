 retrieve="SELECT
	ICatCode,
	Name = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = ItemCategoryWiseUpdation.ICatCode),
	UpdatePurPrice,
	UpdateSalePrice,
	UpdateSalePrice2,
	UpdateSalePrice3,
	UpdateSalePrice4,
	UpdateSalePrice5,
	UpdateSaleDiscPerc,
	UpdateSaleDiscPerc2 ,
	UpdateSaleDiscPerc3,
	UpdateSaleDiscPerc4,
	UpdateSaleDiscPerc5
FROM
	ItemCategoryWiseUpdation
UNION ALL
SELECT
	ICatCode,
	Name = ItemCategory.Name,
	UpdatePurPrice='N',
	UpdateSalePrice='N',
	UpdateSalePrice2='N',
	UpdateSalePrice3='N',
	UpdateSalePrice4='N',
	UpdateSalePrice5='N',
	UpdateSaleDiscPerc='N',
	UpdateSaleDiscPerc2='N',
	UpdateSaleDiscPerc3='N',
	UpdateSaleDiscPerc4='N',
	UpdateSaleDiscPerc5='N'
FROM
	ItemCategory 
WHERE ICatCode NOT IN (SELECT ICatCode FROM ItemCategoryWiseUpdation)"
  update="ItemCategoryWiseUpdation" updatewhere=1 updatekeyinplace=yes
  sort="name A"
)
