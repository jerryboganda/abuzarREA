 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=autosatisfydue dbname="Godown.AutoSatisfyDue" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=considerstockinpo dbname="Godown.ConsiderStockInPO" 
 values="Yes	Y/No	N/"  )
column=(type=char(255) update=yes updatewhereclause=yes name=localgodownname dbname="Godown.LocalGodownName"  )
 retrieve="SELECT  
	godown.gcode ,
	godown.name ,
	godown.location ,
	Godown.GodownGroupCode,
	Godown.AutoSatisfyDue,
	Godown.ConsiderStockInPO,
	Godown.LocalGodownName
FROM 
	godown      
WHERE 
	godown.gcode = :ai_gcode"
  update="godown" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_gcode", number))
)
