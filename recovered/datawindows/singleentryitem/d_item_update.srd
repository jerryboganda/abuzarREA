 values=""  )
 retrieve="SELECT 
	Item.ICode, 
	Item.CustomICode,   
	Item.Name,
	itemname2=item.name, 
	Item.ICCode,   
	Item.ICatCode,   
	Item.Packcode,   
	Item.ManfCode,   
	Item.SalePrice,   
	Item.PurPrice,   
	Item.RetailPrice,   
	Item.AvgPrice,   
	Item.SaleDiscPerc,   
	Item.PurDiscPerc,   
	Item.SalesTax,   
	Item.ReorderQty,   
	Item.OptimumQty,   
	Item.PackUnits,   
	Item.Active,   
	Item.Prescribed,   
	Item.Refrigrated,   
	Item.Printable,   
	Item.Location1,   
	Item.Remarks1,   
	Item.Location,   
	Item.Remarks,   
	Item.Gcode,   
	Item.saleprice2,
	Item.saleprice3,
	Item.RecentPurPrice,
	Item.GReorderQty,
	Item.GOptimumQty ,
	Item.AntiNorCotix,
	Item.Restricted,
	item.PackSalesTax,
	item.GSTPerc1,
	item.GSTPerc2,
	item.packingdesc,
	item.saleqty,
	item.bonusqty,
	Item.PrintExpiry,
	Item.UserCode,
	Item.LastUpdate,
	Item.locksaleprice,
	Item.lockdiscperc,
	Item.flatdisc,
	stock=(select isnull(sum(currqty),0) from godowndetail where godowndetail.icode=item.icode),
	item.salediscperc2,
	item.salediscperc3,
	item.salediscperc4,
	item.isizecode,
	item.istylecode,
	item.icolourcode,
	item.isleevecode,
	item.iyarncode,
	item.ifabriccode,
	item.ibrandcode,
	item.saleprice4,
	item.saleprice5,
	item.salediscperc5,
	item.minqty,
	item.IPartCode,
	item.OldPartCode,
	item.ItemYear,
	item.RemarksForPurchase,
	item.SizeDescription,
	item.ModelDescription,
	item.TypeDescription,
	item.GenericCode,
	item.TransitStock,
	item.PackingFactor,
	item.itemtypecode,
	item.DiscountedSalePrice,
	item.DiscountedPurPrice,
	item.SalePriceChangeMargin,
	item.generatepo,
	item.qtyused,
	item.measureunitcode,
	item.maxsalediscperc,
	item.BonusPolicyCode,
	Item.DiscountPolicyCode,
	Item.ItemDesignCode,
	Item.UnitWeight,
	Item.TotalPieces,
	Item.AlternatePurPrice,
	Item.PurFlatDisc,
	Item.ItemAlertCode,
	Item.MinSalePrice,
	Item.Taxable,
	Item.ForcePatientDoctorRecordInSale,
	Item.ForeignPrice,
	Item.AllowDue,
	Item.LocalItemName,
	Item.ConfirmExpiry,
	Item.Allowsaleindecimalqty,
	item.commissionperc,
	item.commissionperunit,
	Item.Length,
	Item.Width,
	Item.AreaVolume,
	Item.Thickness,
	Item.Sheets,
	Item.ShortName,
	Item.LoyaltyItem,
	Item.RegdNo,
	Item.PackingCost,
	Item.PrefferedSaleQty,
	Item.PackCapacity,
	Item.SalesTaxScheduleCode,
	Item.HeaderNo,
	Item.PCTCode,
	Item.RedemptionDiscPerc,
	Item.ClaimableDiscPerc,
	Item.ItemThicknessCode,
	Item.ItemThicknessCode2,
	Item.ItemColourCode2
	
FROM Item  
WHERE 
	CASE :as_type WHEN 'M' THEN Item.ManfCode
	WHEN 'C' THEN Item.ICatCode
	WHEN 'L' THEN Item.ICCode
	WHEN 'P' THEN Item.PackCode
	ELSE Item.ICode END in (:ai_code) AND
	item.Active=1
ORDER BY Item.Name
"
  update="Item" updatewhere=0 updatekeyinplace=yes
  arguments=(("ai_code", numberlist), ("as_type", string))
)
