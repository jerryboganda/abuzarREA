release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.Name"  )
column=(type=long key=yes updatewhereclause=yes name=code dbname="Item.ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.CustomICode"  )
column=(type=char(100) updatewhereclause=yes name=regdno dbname="Item.RegdNo"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Item.Gender"  )
column=(type=char(100) updatewhereclause=yes name=nationality dbname="Item.Nationality"  )
column=(type=datetime updatewhereclause=yes name=birthdate dbname="Item.BirthDate"  )
column=(type=datetime updatewhereclause=yes name=issuedate dbname="Item.IssueDate"  )
column=(type=datetime updatewhereclause=yes name=expirydate dbname="Item.ExpiryDate"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=long updatewhereclause=yes name=itemalertcode dbname="Item.itemalertcode"  )
 retrieve="SELECT 
	Item.Name,   
	Item.ICode,   
	Item.CustomICode,   
	Item.RegdNo,
	Item.Gender,
	Item.Nationality,
	Item.BirthDate,
	Item.IssueDate,
	Item.ExpiryDate,
	Active=case item.active when 1 then 'Y'
				else 'N'
			end,
	stock=(select isnull(sum(currqty),0) from godowndetail 
			where godowndetail.icode=item.icode) ,
	itemalertcode
FROM
	Item 
"
  update="Item" updatewhere=0 updatekeyinplace=no
 )
