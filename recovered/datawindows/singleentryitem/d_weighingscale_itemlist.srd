table(column=(type=long updatewhereclause=yes name=id dbname="ID"  )
column=(type=char(75) updatewhereclause=yes name=item_num dbname="Item_Num"  )
column=(type=char(18) updatewhereclause=yes name=item_name dbname="Item_Name"  )
column=(type=char(18) updatewhereclause=yes name=item_name2 dbname="Item_Name2"  )
column=(type=long updatewhereclause=yes name=land dbname="Land"  )
column=(type=long updatewhereclause=yes name=additem dbname="AddItem"  )
column=(type=decimal(0) updatewhereclause=yes name=fix_price dbname="fix_price"  )
column=(type=long updatewhereclause=yes name=piece dbname="piece"  )
column=(type=decimal(0) updatewhereclause=yes name=unitprice dbname="unitprice"  )
column=(type=decimal(3) updatewhereclause=yes name=weight dbname="weight"  )
column=(type=long updatewhereclause=yes name=fmark dbname="fmark"  )
column=(type=long updatewhereclause=yes name=pos_kind dbname="pos_kind"  )
column=(type=char(10) updatewhereclause=yes name=pos_flg dbname="pos_flg"  )
column=(type=char(75) updatewhereclause=yes name=pos_code dbname="pos_code"  )
column=(type=long updatewhereclause=yes name=dateprint dbname="dateprint"  )
column=(type=long updatewhereclause=yes name=limit_day dbname="limit_day"  )
column=(type=long updatewhereclause=yes name=limit_time dbname="limit_time"  )
column=(type=long updatewhereclause=yes name=sale_start dbname="sale_start"  )
column=(type=long updatewhereclause=yes name=sale_price dbname="sale_price"  )
column=(type=long updatewhereclause=yes name=sale_day dbname="sale_day"  )
column=(type=long updatewhereclause=yes name=total_weight dbname="total_weight"  )
column=(type=long updatewhereclause=yes name=total_price dbname="total_price"  )
column=(type=long updatewhereclause=yes name=total_print dbname="total_print"  )
column=(type=char(4) updatewhereclause=yes name=mg_id dbname="mg_id"  )
column=(type=long updatewhereclause=yes name=info dbname="info"  )
 retrieve="SELECT 
	ID=0,
	Item_Num = I.CustomICode,
	Item_Name = LEFT(I.Name, 18),
	Item_Name2 = LEFT(I.PackingDesc, 18),
	Land = 0,
	AddItem=NULL,
	fix_price= CASE WHEN I.AllowSaleInDecimalQty = 'Y' THEN 0 ELSE CAST(I.SalePrice * CASE WHEN :ai_priceindecimals = 2 THEN 100 ELSE 1 END AS NUMERIC(18,0)) END,
	piece = CAST(I.PrefferedSaleQty AS INT),
	unitprice=CASE WHEN I.AllowSaleInDecimalQty = 'Y' THEN CAST(I.SalePrice * CASE WHEN :ai_priceindecimals = 2 THEN 100 ELSE 1 END AS NUMERIC(18,0)) ELSE 0 END,
	weight=CASE WHEN I.AllowSaleInDecimalQty = 'Y' THEN 0.000 ELSE 1 END,
	fmark=NULL,
	pos_kind=NULL,
	pos_flg=(SELECT WS.ScaleID FROM WeighingScale WS WHERE WS.weighingscalecode = :ai_weighingscalecode),
	pos_code=I.CustomICode,
	dateprint=NULL,
	limit_day=NULL,
	limit_time=NULL,
	sale_start=NULL,
	sale_price=NULL,
	sale_day=NULL,
	total_weight=NULL,
	total_price=NULL,
	total_print=NULL,
	mg_id='root',
	info=NULL
FROM 
	Item I
WHERE
	CASE :as_grouping 
	WHEN 'M' THEN I.ManfCode 
	WHEN 'C' THEN I.ICatCode 
	WHEN 'L' THEN I.ICCode 
	WHEN 'P' THEN I.PackCode 
	END IN (:ai_groupcode) AND
	LEN(I.CustomICode) <= (SELECT WS.itemendpos - WS.itemstartpos + 1 FROM WeighingScale WS WHERE WS.WeighingScaleCode = :ai_weighingscalecode)
ORDER BY
	Item_Num"
  arguments=(("as_grouping", string), ("ai_groupcode", numberlist), ("ai_weighingscalecode", number), ("ai_priceindecimals", number))
)
