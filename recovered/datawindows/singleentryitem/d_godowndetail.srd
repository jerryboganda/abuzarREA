 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"godowndetail~" ) COLUMN(NAME=~"godowndetail.gcode~") COLUMN(NAME=~"godowndetail.icode~") COLUMN(NAME=~"godowndetail.reorderqty~") COLUMN(NAME=~"godowndetail.optimumqty~") COLUMN(NAME=~"godowndetail.currqty~")WHERE(    EXP1 =~"godowndetail.icode~"   OP =~"=~"    EXP2 =~":ra_itemcode~" ) ) ARG(NAME = ~"ra_itemcode~" TYPE = number) "
