table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="WeighingScale.WeighingScaleCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="WeighingScale.Name"  )
column=(type=char(100) update=yes updatewhereclause=yes name=manufacturer dbname="WeighingScale.Manufacturer"  )
column=(type=char(100) update=yes updatewhereclause=yes name=model dbname="WeighingScale.MODEL"  )
column=(type=char(10) update=yes updatewhereclause=yes initial="98" name=scaleid dbname="WeighingScale.ScaleID"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=scaleidpos dbname="WeighingScale.ScaleIDPos"  )
column=(type=long update=yes updatewhereclause=yes initial="13" name=barcodelen dbname="WeighingScale.BarCodeLen"  )
column=(type=long update=yes updatewhereclause=yes initial="3" name=itemstartpos dbname="WeighingScale.ItemStartPos"  )
column=(type=long update=yes updatewhereclause=yes initial="7" name=itemendpos dbname="WeighingScale.ItemEndPos"  )
column=(type=long update=yes updatewhereclause=yes initial="8" name=weightstartpos dbname="WeighingScale.WeightStartPos"  )
column=(type=long update=yes updatewhereclause=yes initial="12" name=weightendpos dbname="WeighingScale.WeightEndPos"  )
 retrieve="  SELECT WeighingScale.WeighingScaleCode,   
         WeighingScale.Name,   
         WeighingScale.Manufacturer,   
         WeighingScale.MODEL,   
         WeighingScale.ScaleID,   
         WeighingScale.ScaleIDPos,   
         WeighingScale.BarCodeLen,   
         WeighingScale.ItemStartPos,   
         WeighingScale.ItemEndPos,   
         WeighingScale.WeightStartPos,   
         WeighingScale.WeightEndPos  
    FROM WeighingScale  
   WHERE WeighingScale.WeighingScaleCode = :ai_code   
            
"
  update="WeighingScale" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
