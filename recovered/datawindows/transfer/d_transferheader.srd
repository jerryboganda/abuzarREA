table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Theader.transcode"  )
column=(type=long update=yes updatewhereclause=yes name=dgcode dbname="Theader.dgcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=sgcode dbname="Theader.sgcode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Theader.remarks"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="Theader.date"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="Theader.posted"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=postdate dbname="Theader.postdate"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=salesmancode dbname="Theader.salesmancode"  )
column=(type=char(60) updatewhereclause=yes name=salesman_name dbname="SalesMan.name"  )
column=(type=char(60) updatewhereclause=yes name=sglocation dbname="sglocation"  )
column=(type=char(60) updatewhereclause=yes name=dglocation dbname="dglocation"  )
 retrieve="SELECT  theader.transcode ,
           theader.dgcode ,
           theader.sgcode ,
           theader.remarks ,
           theader.date ,
           theader.posted ,
           theader.postdate ,
           theader.salesmancode ,
           salesman.name ,
           sglocation=godown_a.location ,
           dglocation=godown_b.location     
        FROM theader ,
           salesman ,
           godown godown_a ,
           godown godown_b     
        WHERE ( salesman.salesmancode = theader.salesmancode ) and          ( theader.sgcode = godown_a.gcode ) and          ( theader.dgcode = godown_b.gcode ) and          ( ( dbo.theader.transcode = :ar_transcode ) )  "
  update="theader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_transcode", number))
)
