footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=transreqcode dbname="TransReqCode"  )
column=(type=long updatewhereclause=yes name=ttcode dbname="TTCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=sgcode dbname="SGCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=dgcode dbname="DGCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Remarks"  )
 retrieve="SELECT 
	TransReqCode=NULL,   
	TTCode=NULL,
	SGCode=NULL,   
	DGCode=NULL,   
	Date=NULL,   
	Remarks='<NONE>'
UNION ALL
SELECT 
	TransferRequisitionHeader.TransReqCode,   
	TTCode=TransferRequisitionHeader.TTCode,
	TransferRequisitionHeader.SGCode,   
	TransferRequisitionHeader.DGCode,   
	TransferRequisitionHeader.Date,   
	TransferRequisitionHeader.Remarks  
FROM 
	TransferRequisitionHeader  
WHERE 
	TransferRequisitionHeader.Posted = 'Y'    
"
 )
