footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Theader.transcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Theader.date"  )
column=(type=char(60) updatewhereclause=yes name=dgodown dbname="dgodown"  )
column=(type=char(60) updatewhereclause=yes name=sgodown dbname="sgodown"  )
 retrieve="SELECT  dbo.theader.transcode ,
		  dbo.theader.date ,
		  dgodown=godown_a.name ,
		  sgodown=godown_b.name     
FROM dbo.theader ,
	  dbo.godown godown_a ,
	  dbo.godown godown_b     
WHERE ( dbo.theader.sgcode = godown_b.gcode ) and          ( dbo.theader.dgcode = godown_a.gcode )   "
 )
