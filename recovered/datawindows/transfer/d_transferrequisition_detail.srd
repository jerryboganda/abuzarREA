release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=128 color="536870912" )
summary(height=0 color="536870912" )
footer(height=72 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="TransferRequisitionDetail.TransReqCode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="CustomICode"  )
column=(type=char(75) update=yes updatewhereclause=yes name=alternatecustomicode dbname="TransferRequisitionDetail.alternatecustomicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long key=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=avgprice dbname="AvgPrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=purprice dbname="PurPrice"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="PackUnits"  )
column=(type=long update=yes updatewhereclause=yes name=rowgroup dbname="RowGroup"  )
column=(type=long updatewhereclause=yes name=sgcode dbname="sgcode"  )
column=(type=long updatewhereclause=yes name=dgcode dbname="dgcode"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="~"Quantity should be greater than or equal to zero~"" initial="0" name=packqty dbname="packqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=requiredqty dbname="requiredqty"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=reorderqty dbname="reorderqty"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=optimumqty dbname="optimumqty"  )
column=(type=char(100) update=yes updatewhereclause=yes name=itemdescription dbname="ItemDescription"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=targetstock dbname="TransferRequisitionDetail.targetstock"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=sourcestock dbname="TransferRequisitionDetail.sourcestock"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) > 0" validationmsg="~"Quantity should be greater than zero~"" initial="1" name=qty dbname="qty"  )
 retrieve="SELECT 
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= 0.0000, 
	TransferRequisitionDetail.TransReqCode,
	ICode=TransferRequisitionDetail.icode, 
	CustomICode=item.customicode, 
	TransferRequisitionDetail.alternatecustomicode,
	itemname = item.name, 
	Id   = max(TransferRequisitionDetail.IDENTITYCOL),
	AvgPrice=TransferRequisitionDetail.avgprice,
	SalePrice=TransferRequisitionDetail.saleprice,
	PurPrice=TransferRequisitionDetail.purprice,
	PackUnits=TransferRequisitionDetail.packunits,
	RowGroup=TransferRequisitionDetail.rowgroup,
	sgcode = (SELECT TransferRequisitionHeader.sgcode FROM TransferRequisitionHeader WHERE TransferRequisitionHeader.TransReqCode  = TransferRequisitionDetail.TransReqCode),
	dgcode = (SELECT TransferRequisitionHeader.dgcode FROM TransferRequisitionHeader WHERE TransferRequisitionHeader.TransReqCode = TransferRequisitionDetail.TransReqCode),
	packqty = Max(TransferRequisitionDetail.packqty),
	requiredqty = TransferRequisitionDetail.requiredqty,
	reorderqty = TransferRequisitionDetail.reorderqty,
	optimumqty = TransferRequisitionDetail.optimumqty,
	ItemDescription=TransferRequisitionDetail.ItemDescription,
	TransferRequisitionDetail.targetstock,
	TransferRequisitionDetail.sourcestock,
	aliasname=SPACE(12),
	qty  = sum(TransferRequisitionDetail.qty)
FROM
	TransferRequisitionDetail,   
	item 
WHERE 
	( dbo.TransferRequisitionDetail.TransReqCode = :ar_tCode )    AND
	( TransferRequisitionDetail.ICode = item.icode )
GROUP BY 
	TransferRequisitionDetail.TransReqCode, 
	TransferRequisitionDetail.ICode, 
	TransferRequisitionDetail.rowgroup,
	item.customicode, 
	TransferRequisitionDetail.alternatecustomicode,
	item.name,
	TransferRequisitionDetail.ItemDescription,
	TransferRequisitionDetail.avgprice,
	TransferRequisitionDetail.purprice,
	TransferRequisitionDetail.saleprice,
	TransferRequisitionDetail.packunits,
	TransferRequisitionDetail.requiredqty,
	TransferRequisitionDetail.optimumqty,
	TransferRequisitionDetail.reorderqty,
	TransferRequisitionDetail.sourcestock,
	TransferRequisitionDetail.targetstock
ORDER BY 
	Id
"
  update="TransferRequisitionDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_tCode", number))
)
