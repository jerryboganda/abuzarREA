table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Tdetail.TransCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="Tdetail.ICode"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="Tdetail.Batch"  )
