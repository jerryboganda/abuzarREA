column=(type=decimal(4) update=yes updatewhereclause=yes name=qty dbname="Tdetail.Qty"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=id dbname="Tdetail.id"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
 retrieve="SELECT 
	Tdetail.TransCode,   
	Tdetail.ICode,   
	Tdetail.Batch,   
	Tdetail.Expiry,   
	Tdetail.Qty,   
	Tdetail.id, 
	stock = 0.0000,
	totalstock = 0.0000  
FROM Tdetail   
"
  update="Tdetail" updatewhere=1 updatekeyinplace=yes
 )
