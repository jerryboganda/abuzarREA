release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=148 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes name=currqty dbname="currqty"  )
column=(type=long updatewhereclause=yes name=goptimumqty dbname="Goptimumqty"  )
column=(type=long updatewhereclause=yes name=greorderqty dbname="Greorderqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="purprice"  )
 retrieve="SELECT 
	icode, 
	currqty, 
	Goptimumqty,
	Greorderqty,
	packunits,
	purprice 
FROM
	(SELECT
		I.icode, 
		CurrQty = ISNULL(SUM(G.currqty),0), 
		I.GoptimumQty,
		I.GreorderQty,
		I.PackUnits,
		I.PurPrice,
		I.ManfCode,
		I.PackCode,
		I.ICatCode,
		I.ICCode
	FROM 	
		Item I
		LEFT OUTER JOIN (SELECT * FROM GodownDetail WHERE GCode = :ai_TGCode) AS G ON (I.ICode = G.ICode)
	WHERE
		(	I.manfcode in (:ai_manfcode) OR 
			I.ManfCode = (CASE :ai_allmanf WHEN 1 THEN I.ManfCode ELSE -1 END) OR
			I.icatcode in (:ai_icatcode) OR 
			I.ICatCode = (CASE :ai_allcat WHEN 1 THEN I.ICatCode ELSE -1 END) OR
			I.iccode in (:ai_iccode) OR 
			I.ICCode = (CASE :ai_allclass WHEN 1 THEN I.ICCode ELSE -1 END) OR
			I.Packcode in (:ai_Packcode) OR 
			I.PackCode = (CASE :ai_allpack WHEN 1 THEN I.PackCode ELSE -1 END) OR
			I.NAME LIKE (:as_itemlike) 
		) AND
		I.gcode = :ai_SGCode and 
		I.GOptimumqty > 0 and
		I.Icode in 
			(SELECT DISTINCT ICode FROM GodownDetail 
			WHERE GCode = :ai_SGCode )
	GROUP BY 
		I.icode , 
		I.manfcode, 
		I.iccode,
		I.packcode,
		I.Icatcode, 
		I.name,
		I.Goptimumqty,
		I.Greorderqty, 
		I.purprice, 
		I.packunits) b
WHERE greorderqty > currqty
ORDER BY 
	manfcode, 
	PackCode, 
	IcatCode, 
	Iccode
"
  arguments=(("ai_TGCode", number), ("ai_SGCode", number), ("ai_manfcode", numberlist), ("ai_allmanf", number), ("ai_icatcode", numberlist), ("ai_allcat", number), ("ai_iccode", numberlist), ("ai_allclass", number), ("ai_packcode", numberlist), ("ai_allpack", number), ("as_itemlike", string))
)
