table(column=(type=char(60) updatewhereclause=yes name=source dbname="source"  )
column=(type=char(60) updatewhereclause=yes name=target dbname="target"  )
column=(type=long updatewhereclause=yes name=theader_transcode dbname="Theader.transcode"  )
column=(type=datetime updatewhereclause=yes name=theader_date dbname="Theader.date"  )
column=(type=char(1) updatewhereclause=yes name=theader_posted dbname="Theader.posted"  )
column=(type=decimal(4) updatewhereclause=yes name=tdetail_qty dbname="qty"  )
column=(type=long updatewhereclause=yes name=theader_sgcode dbname="Theader.sgcode"  )
column=(type=long updatewhereclause=yes name=theader_dgcode dbname="Theader.dgcode"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.name"  )
column=(type=char(75) updatewhereclause=yes name=item_customicode dbname="Item.customicode"  )
 retrieve="SELECT 
      source=(select name from godown where godown.gcode=theader.sgcode),
      target=(select name from godown where godown.gcode=theader.dgcode),
      theader.transcode, 
      theader.date, 
      theader.posted, 
      qty=sum(tdetail.qty), 
      theader.sgcode, 
      theader.dgcode, 
      item.name,  
      item.customicode 
FROM item,tdetail,theader
WHERE theader.date>=:adt_sdate and 
      theader.date<=:adt_ldate and
     /* theader.posted='Y' and*/
      theader.transcode=tdetail.transcode and
      tdetail.icode=item.icode 
group by theader.transcode,
         item.name,
         item.customicode,
         theader.posted,
         theader.sgcode,
         theader.dgcode,
         theader.date
ORDER BY  
			theader.date,theader.transcode"
  arguments=(("adt_sdate", datetime), ("adt_ldate", datetime))
)
