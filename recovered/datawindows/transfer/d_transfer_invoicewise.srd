table(column=(type=long updatewhereclause=yes name=transcode dbname="Theader.Transcode"  )
column=(type=char(60) updatewhereclause=yes name=sourcegodown dbname="SourceGodown"  )
column=(type=char(60) updatewhereclause=yes name=targetgodown dbname="TargetGodown"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Theader.Date"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="Theader.PostDate"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Theader.Remarks"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Theader.Posted"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Tdetail.qty"  )
column=(type=decimal(8) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(4) updatewhereclause=yes name=sourceqty dbname="sourceqty"  )
column=(type=decimal(4) updatewhereclause=yes name=targetqty dbname="targetqty"  )
 retrieve="Select	THeader.Transcode,
      SourceGodown = ( Select name from Godown where gcode = THeader.sgcode),
      TargetGodown = ( Select name from Godown where gcode = THeader.dgcode),
		THeader.Date,
		THeader.PostDate,
		UserName = (Select username from users where usercode = THeader.salesmancode),
		THeader.Remarks,
	 	THeader.Posted,
		itemalias = item.customicode,
		itemname = item.name, 
		TDetail.qty,
		price = Round(CASE :ai_pricetype WHEN 1 THEN TDetail.saleprice / TDetail.PackUnits WHEN 2 THEN TDetail.purprice / TDetail.PackUnits ELSE TDetail.avgprice END, 2),
		sourceqty=tdetail.sourcestock,
		targetqty=tdetail.targetstock
From  THeader, TDetail, Item

Where THeader.TransCode = TDetail.TransCode AND
      TDetail.Icode = Item.Icode AND
      THeader.TransCode Between :al_stcode AND :al_ltcode

Order By THeader.TransCode,TDetail.ID
"
  arguments=(("al_stcode", number), ("al_ltcode", number), ("ai_pricetype", number))
)
