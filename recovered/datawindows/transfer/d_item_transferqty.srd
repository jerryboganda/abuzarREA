 retrieve=" Select source = name,
		 target = name,
		 icode = 0 ,
		 aliasname = customicode,
		 itemname = name,
		 sourcestk = 0.0000,
		 targetstk = 0.0000,
		 requiredqty = 0.0000

From Item
Where icode < 10
"
