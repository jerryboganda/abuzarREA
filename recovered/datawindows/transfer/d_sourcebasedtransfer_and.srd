footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=decimal(0) updatewhereclause=yes name=currqty dbname="currqty"  )
column=(type=long updatewhereclause=yes name=goptimumqty dbname="Goptimumqty"  )
column=(type=long updatewhereclause=yes name=greorderqty dbname="Greorderqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="purprice"  )
 retrieve="select
	icode, 
	Name,
	currqty=FLOOR(currqty * :ai_stockperc * 0.01), 
	Goptimumqty,
	Greorderqty,
	packunits,
	purprice  
from
(SELECT
	I.icode, 
	I.Name,
	Case When sum(G.currqty) IS NULL Then 0 Else sum(G.currqty) End as currqty, 
	I.Goptimumqty,
	I.Greorderqty,
	I.packunits,
	I.purprice,
	i.manfcode,
	i.packcode,
	i.icatcode,
	i.iccode
FROM 	
	(Select * from dbo.item
	where	
		dbo.item.manfcode in (:ai_manfcode) AND
		dbo.item.icatcode in (:ai_icatcode) AND
		dbo.item.iccode in (:ai_iccode) AND
		dbo.item.Packcode in (:ai_Packcode) ) I,
	(Select * From dbo.godowndetail where gcode = :ai_SGCode) G
WHERE  ( I.icode = G.icode)
GROUP BY 
	 I.icode , 
	 I.Name, 
	 I.manfcode, 
	 I.iccode,
	 I.packcode,
	 I.Icatcode, 
	 I.name,
	 I.Goptimumqty,
    I.Greorderqty, 
	 I.purprice, 
	 I.packunits) b
where currqty > 0
ORDER BY Name
"
  arguments=(("ai_SGCode", number), ("ai_manfcode", numberlist), ("ai_icatcode", numberlist), ("ai_iccode", numberlist), ("ai_packcode", numberlist), ("ai_stockperc", number))
)
