header(height=115 color="536870912" )
summary(height=0 color="536870912" )
footer(height=70 color="536870912" )
detail(height=67 color="536870912" )
table(column=(type=long updatewhereclause=yes name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Tdetail.transcode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="Tdetail.icode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=batch dbname="Tdetail.batch" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=expiry dbname="Tdetail.expiry"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(75) update=yes updatewhereclause=yes name=alternatecustomicode dbname="Tdetail.alternatecustomicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long key=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=transferutn dbname="Tdetail.transferutn"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=avgprice dbname="Tdetail.avgprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="Tdetail.saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=purprice dbname="Tdetail.purprice"  )
column=(type=long update=yes updatewhereclause=yes name=packunits dbname="Tdetail.packunits"  )
column=(type=long update=yes updatewhereclause=yes name=rowgroup dbname="Tdetail.rowgroup"  )
column=(type=long updatewhereclause=yes name=sgcode dbname="sgcode"  )
column=(type=long updatewhereclause=yes name=dgcode dbname="dgcode"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="~"Quantity should be greater than or equal to zero~"" initial="0" name=packqty dbname="packqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=requiredqty dbname="requiredqty"  )
column=(type=long update=yes updatewhereclause=yes name=reorderqty dbname="reorderqty"  )
column=(type=long update=yes updatewhereclause=yes name=optimumqty dbname="optimumqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=targetstk dbname="Tdetail.targetstock"  )
column=(type=long updatewhereclause=yes name=itemalertcode dbname="itemalertcode"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=sourcestk dbname="Tdetail.sourcestock"  )
column=(type=long update=yes updatewhereclause=yes name=transreqrowid dbname="Tdetail.transreqrowid"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(100) update=yes updatewhereclause=yes name=itemdescription dbname="Tdetail.itemdescription"  )
column=(type=decimal(4) updatewhereclause=yes name=packcapacity dbname="PackCapacity"  )
column=(type=decimal(8) updatewhereclause=yes name=areavolume dbname="AreaVolume"  )
column=(type=decimal(6) updatewhereclause=yes name=pcs dbname="PCS"  )
column=(type=char(17) updatewhereclause=yes name=cartons dbname="Cartons"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) > 0" validationmsg="~"Quantity should be greater than zero~"" initial="1" name=qty dbname="qty"  )
 retrieve="SELECT
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= 0.0000, 
	tdetail.transcode,
	tdetail.icode,
	tdetail.batch,
	tdetail.expiry,
	item.customicode, 
	tdetail.alternatecustomicode,
	itemname = item.name, 
	packingdesc=item.packingdesc,
	Id   = max(tdetail.IDENTITYCOL),
	tdetail.transferutn,
	tdetail.avgprice,
	tdetail.saleprice,
	tdetail.purprice,
	tdetail.packunits,
	tdetail.rowgroup,
	sgcode = (SELECT theader.sgcode FROM Theader WHERE Theader.TransCode = Tdetail.TransCode),
	dgcode = (SELECT theader.dgcode FROM Theader WHERE Theader.TransCode = Tdetail.TransCode),
	packqty = Max(tdetail.packqty),
	requiredqty = tdetail.requiredqty,
	reorderqty = tdetail.reorderqty,
	optimumqty = tdetail.optimumqty,
	tdetail.targetstock,
	itemalertcode = item.itemalertcode,
	tdetail.sourcestock,
	tdetail.transreqrowid,
	aliasname='            ',
	tdetail.itemdescription,
	PackCapacity = item.PackCapacity,
	AreaVolume = item.AreaVolume,
	PCS=ROUND(sum(tdetail.qty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6),
	Cartons= LTRIM(RTRIM(STR(CAST(((ROUND(sum(tdetail.qty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6)) / CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END) AS INT), 7, 0))) + ' : ' +
		LTRIM(RTRIM(STR(((CAST(ROUND(sum(tdetail.qty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6) AS INT)) % CAST(CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END AS INT)), 7, 0))),
	qty  = sum(tdetail.qty)
FROM
	tdetail,   
	item 
WHERE 
	( dbo.tdetail.transcode = :ar_tCode )    AND
	( tdetail.icode = item.icode )
GROUP BY 
	tdetail.transcode, 
	tdetail.icode, 
	tdetail.rowgroup,
	tdetail.batch,
	tdetail.expiry,  
	item.customicode, 
	tdetail.alternatecustomicode,
	tdetail.transferutn,
	item.name,
	item.packingdesc,
	item.PackCapacity,
	item.AreaVolume,
	tdetail.avgprice,
	tdetail.purprice,
	tdetail.saleprice,
	tdetail.packunits,
	tdetail.requiredqty,
	tdetail.optimumqty,
	tdetail.reorderqty,
	tdetail.sourcestock,
	tdetail.targetstock,
	item.itemalertcode,	
	tdetail.itemdescription,
	tdetail.transreqrowid
ORDER BY 
	Id
"
  update="tdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_tCode", number))
)
