release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=148 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=sourceqty dbname="SourceQty"  )
column=(type=decimal(4) updatewhereclause=yes name=netsaleqty dbname="NetSaleQty"  )
 retrieve="Select target.icode, itemcategory, itemname, IsNull(source.currqty, 0) As SourceQty, target.NetSaleQty 
From ( 
	Select godowndetail.icode , IsNull(Sum(godowndetail.currqty) , 0 ) as currqty
	From godowndetail, Item , ItemCategory
	where godowndetail.gcode = :ai_SGCode AND
		   godowndetail.icode = item.icode AND
         item.icatcode = itemcategory.icatcode AND
         itemcategory.icatcode In (:ai_icatcode) 		
	Group By godowndetail.icode
	) source Right Outer Join
	(
	Select S.icode , S.ItemCategory, S.ItemName, (SaleQty - IsNull(SaleRetQty,0)) As NetSaleQty
	From (
		Select saledetail.icode , ItemCategory.Name As ItemCategory, Item.Name As ItemName, IsNull ( Sum(saledetail.looseqty + saledetail.bonusqty) , 0) As SaleQty
		From Saleledger , Saledetail , Item , ItemCategory
		Where Saleledger.saleinvcode = saledetail.saleinvcode AND
				saleledger.date between :ad_startdate and :ad_enddate AND
				saledetail.icode = item.icode AND
				item.icatcode = itemcategory.icatcode AND
            itemcategory.icatcode In (:ai_icatcode) AND
				saledetail.gcode = :ai_TGCode
		Group By saledetail.icode, ItemCategory.Name, Item.Name
		) S Left Outer Join 
		(
		Select srdetail.icode , ItemCategory.Name As ItemCategory, Item.Name As ItemName, IsNull ( Sum(srdetail.looseqty + srdetail.bonusqty) , 0) As SaleRetQty
		From Srledger , Srdetail , Item, ItemCategory
		Where srledger.srinvcode = srdetail.srinvcode AND
				srledger.date between :ad_startdate and :ad_enddate AND
				srdetail.icode = item.icode AND
            item.icatcode = ItemCategory.icatcode AND
				itemCategory.icatcode In (:ai_icatcode) AND
				srdetail.gcode = :ai_TGCode
		Group By srdetail.icode, ItemCategory.Name, Item.Name
		) Sr 
	On S.icode = Sr.icode
	Where (SaleQty - IsNull(SaleRetQty,0) ) > 0
	) target
On target.icode = source.icode
Order By ItemCategory, ItemName"
  arguments=(("ai_TGCode", number), ("ai_SGCode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_icatcode", numberlist))
)
