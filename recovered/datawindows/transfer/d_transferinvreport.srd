release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=552 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=long updatewhereclause=yes name=tdetail_transcode dbname="Tdetail.transcode"  )
column=(type=long updatewhereclause=yes name=tdetail_icode dbname="Tdetail.icode"  )
column=(type=char(75) updatewhereclause=yes name=item_customicode dbname="Item.customicode"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Theader.posted"  )
column=(type=long updatewhereclause=yes name=theader_dgcode dbname="Theader.dgcode"  )
column=(type=long updatewhereclause=yes name=theader_sgcode dbname="Theader.sgcode"  )
column=(type=char(60) updatewhereclause=yes name=sourcegodown dbname="sourcegodown"  )
column=(type=char(60) updatewhereclause=yes name=targetgodown dbname="targetgodown"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(4) updatewhereclause=yes name=requiredqty dbname="requiredqty"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="reorderqty"  )
column=(type=long updatewhereclause=yes name=optimumqty dbname="optimumqty"  )
column=(type=decimal(4) updatewhereclause=yes name=targetstk dbname="targetstk"  )
column=(type=decimal(4) updatewhereclause=yes name=sourcestk dbname="sourcestk"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
 retrieve="SELECT   
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= 0.0000, 
	TD.transcode,
	TD.icode, 
	I.customicode, 
	TH.posted,
	TH.dgcode,
	TH.sgcode,
	sourcegodown=(SELECT  GC.NAME FROM GODOWN GC WHERE GC.GCODE=TH.sgcode),
	targetgodown=(SELECT  GD.NAME FROM GODOWN GD WHERE GD.GCODE=TH.dgcode),
	itemname = I.name, 
	Id   = max(TD.IDENTITYCOL),
	requiredqty =(SELECT IC.goptimumqty * IC.packunits FROM  item IC WHERE IC.icode=TD.icode )  - (SELECT sum(currqty) FROM  godowndetail G WHERE G.icode=TD.icode AND G.gcode=TH.dgcode) ,
	reorderqty = (SELECT IC.greorderqty * IC.packunits FROM  item IC WHERE IC.icode=TD.icode ) ,
	optimumqty = (SELECT IC.goptimumqty * IC.packunits FROM  item IC WHERE IC.icode=TD.icode ) ,
	targetstk = (SELECT sum(currqty) FROM  godowndetail G WHERE G.icode=TD.icode AND G.gcode=TH.dgcode) ,
	sourcestk = (SELECT sum(currqty) FROM  godowndetail G WHERE G.icode=TD.icode AND G.gcode=TH.sgcode) ,
	qty  = sum(TD.qty)
FROM 
	tdetail TD, theader TH, item  I
WHERE 
	(TH.transcode = :ar_tCode) AND
	( TD.transcode = TH.transcode ) AND
	( TD.icode = I.icode )
GROUP BY 
	TD.transcode, 
	TH.sgcode,
	TH.dgcode,
	TH.posted,
	TD.icode, 
	I.customicode, 
	I.name
ORDER BY 
	Id
	
	
"
  arguments=(("ar_tcode", number))
)
