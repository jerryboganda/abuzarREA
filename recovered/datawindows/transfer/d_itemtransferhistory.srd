release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=220 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=60 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="name"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="itemaliasname"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="name"  )
column=(type=long updatewhereclause=yes name=transcode dbname="TransCode"  )
column=(type=long updatewhereclause=yes name=sgcode dbname="SGCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=dgcode dbname="DGCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
column=(type=long updatewhereclause=yes name=usercode dbname="usercode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
 retrieve="select  	item.name,
			itemaliasname=item.customicode,
			ItemPacking.name, 
			THeader.TransCode,
			THeader.SGCode,
			THeader.DGCode,
			THeader.headerno,
			THeader.headerinvno,
			usercode=THeader.salesmancode,
			THeader.remarks,
			THeader.date,
			sd.qty,
		  	UnitPrice=ROUND(sd.SalePrice / CASE WHEN SD.Packunits < 1 THEN 1 ELSE SD.Packunits END, 2), 
			sd.batch, 
			sd.expiry
From   (Select ICode,TransCode,Qty,SalePrice,Batch,Expiry,Packunits From TDetail Where icode = :ar_icode) sd 
       Inner Loop join THeader On sd.TransCode = THeader.TransCode 
       Inner Join Item On SD.Icode = Item.Icode 
       Left  Outer Join ItemPacking On Item.packcode = ItemPacking.PackCode  	"
  arguments=(("ar_icode", number))
 sort="date D, itemname A, batch A, expiry A"
)
