table(column=(type=char(60) updatewhereclause=yes name=source dbname="source"  )
column=(type=char(60) updatewhereclause=yes name=target dbname="target"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=long updatewhereclause=yes name=transcode dbname="Theader.transcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Theader.date"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="Theader.postdate"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Theader.posted"  )
column=(type=decimal(12) updatewhereclause=yes name=stockvalue dbname="stockvalue"  )
column=(type=long updatewhereclause=yes name=theader_sgcode dbname="Theader.sgcode"  )
column=(type=long updatewhereclause=yes name=theader_dgcode dbname="Theader.dgcode"  )
 retrieve="SELECT 
      source=(select name from godown where godown.gcode=theader.sgcode),
      target=(select name from godown where godown.gcode=theader.dgcode),
		username = users.username,
      theader.transcode,
      theader.date,
      theader.postdate, 
      theader.posted,
      stockvalue = Round ( Sum ( tdetail.qty *
							Case :ai_pricetype 
								WHEN 2 THEN Round(tdetail.purprice / tdetail.PackUnits, 2)
                     	WHEN 1 THEN Round(tdetail.Saleprice / tdetail.PackUnits, 2)
                     	WHEN 3 THEN Round(tdetail.avgprice, 2)
                     END ) , 0 ) ,
      theader.sgcode,
      theader.dgcode

 
FROM  tdetail,theader,users

WHERE theader.date>=:adt_sdate and 
      theader.date<=:adt_ldate and
      theader.posted='Y' and
      theader.transcode = tdetail.transcode and
		theader.salesmancode = users.usercode and
		theader.sgcode IN (:al_sourcegodown) and
		theader.dgcode = :al_targetgodown 

Group By theader.transcode,
         theader.posted,
         theader.sgcode,
         theader.dgcode,
			theader.date,
         theader.postdate,
			users.username
          
ORDER BY  theader.date,theader.transcode"
  arguments=(("adt_sdate", datetime), ("adt_ldate", datetime), ("ai_pricetype", number), ("al_sourcegodown", numberlist), ("al_targetgodown", number))
)
