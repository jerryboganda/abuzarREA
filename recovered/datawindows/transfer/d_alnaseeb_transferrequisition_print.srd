release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=652 color="536870912" )
summary(height=360 color="536870912" )
footer(height=0 color="536870912" )
detail(height=96 color="536870912" )
table(column=(type=long updatewhereclause=yes name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=long updatewhereclause=yes name=code dbname="code"  )
column=(type=long updatewhereclause=yes name=icode dbname="TransferRequisitionDetail.icode"  )
column=(type=char(75) updatewhereclause=yes name=item_customicode dbname="Item.customicode"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="TransferRequisitionHeader.posted"  )
column=(type=long updatewhereclause=yes name=dgcode dbname="TransferRequisitionHeader.dgcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=sgcode dbname="TransferRequisitionHeader.sgcode"  )
column=(type=char(60) updatewhereclause=yes name=sourcegodown dbname="sourcegodown"  )
column=(type=char(255) updatewhereclause=yes name=localsourcegodown dbname="Localsourcegodown"  )
column=(type=char(60) updatewhereclause=yes name=targetgodown dbname="targetgodown"  )
column=(type=char(255) updatewhereclause=yes name=localtargetgodown dbname="localtargetgodown"  )
column=(type=char(255) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) updatewhereclause=yes name=itemdescription dbname="itemdescription"  )
column=(type=decimal(4) updatewhereclause=yes name=requiredqty dbname="requiredqty"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="reorderqty"  )
column=(type=long updatewhereclause=yes name=optimumqty dbname="optimumqty"  )
column=(type=decimal(4) updatewhereclause=yes name=targetstk dbname="targetstk"  )
column=(type=decimal(4) updatewhereclause=yes name=sourcestk dbname="sourcestk"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(8) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=datetime updatewhereclause=yes name=savedate dbname="savedate"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PostDate"  )
 retrieve="SELECT 
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= 0.0000, 
	code=TD.transreqcode,
	TD.icode,  
	I.customicode,  
	TH.posted,
	TH.dgcode,
	remarks=max(TH.remarks),
	TH.sgcode,
	sourcegodown=(SELECT  GC.NAME FROM GODOWN GC WHERE GC.GCODE=TH.sgcode),
	Localsourcegodown=(SELECT  GC.LocalGodownName FROM GODOWN GC WHERE GC.GCODE=TH.sgcode),
	targetgodown=(SELECT  GD.NAME FROM GODOWN GD WHERE GD.GCODE=TH.dgcode),
	localtargetgodown=(SELECT  GD.LocalGodownName FROM GODOWN GD WHERE GD.GCODE=TH.dgcode),
	itemname = CASE WHEN I.LocalItemName IS NULL THEN I.name ELSE I.LocalItemName END, 
	itemdescription = TD.itemdescription,
	requiredqty =MAX(TD.RequiredQty),
	reorderqty = MAX(TD.ReorderQty) ,
	optimumqty = MAX(TD.OptimumQty ),
	targetstk = SUM(TD.targetstock),
	sourcestk = SUM(TD.sourcestock),
	qty  = sum(TD.qty),
	saleprice=(max(TD.saleprice)/ISNULL(max(TD.packunits),1)),
	savedate=TH.date,
	PostDate=TH.postdate
FROM 
	TransferRequisitionDetail TD, 
	TransferRequisitionHeader TH,
	Item  I
WHERE 
	(TH.transreqcode = :ar_tCode) AND
	( TD.transreqcode = TH.transreqcode ) AND
	( TD.icode = I.icode )
GROUP BY 
	TD.transreqcode, 
	TH.sgcode,
	TH.dgcode,
	TH.Date,
	TH.postdate,
	TH.posted,
	TD.icode, 
	I.customicode, 
	I.name,
	TD.itemdescription,
	I.localitemname
"
  arguments=(("ar_tcode", number))
)
