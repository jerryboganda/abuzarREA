 values=""  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
 retrieve="SELECT 
	TransferRequisitionHeader.TransReqCode,   
	TransferRequisitionHeader.SGCode,   
	TransferRequisitionHeader.DGCode,   
	TransferRequisitionHeader.Date ,
	TransferRequisitionHeader.Remarks,
	TransferRequisitionHeader.Salesmancode,
	TransferRequisitionHeader.Posted,
	TransferRequisitionHeader.PostedBy,
	TransferRequisitionHeader.PostDate,
	TransferRequisitionHeader.StartDate,
	TransferRequisitionHeader.EndDate,
	TransferRequisitionHeader.TTCode,
	Users.username
FROM 
	TransferRequisitionHeader,   
	Users  
WHERE 
	TransferRequisitionHeader.SalesManCode = Users.UserCode and 
	TransferRequisitionHeader.TransReqCode = :ar_tcode"
  update="TransferRequisitionHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_tcode", number))
)
