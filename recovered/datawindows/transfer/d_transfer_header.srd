 values=""  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long update=yes updatewhereclause=yes name=headerno dbname="Theader.HeaderNo" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=headerinvno dbname="Theader.HeaderInvNo"  )
column=(type=long update=yes updatewhereclause=yes name=transreqcode dbname="Theader.TransReqCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=smancode dbname="Theader.SManCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=workordercode dbname="Theader.WorkOrderCode" 
 values=""  )
 retrieve="SELECT 
	Theader.TransCode,   
	Theader.SGCode,   
	Theader.DGCode,   
	Theader.Date ,
	Theader.Remarks,
	Theader.Salesmancode,
	Theader.Posted,
	Theader.PostedBy,
	Theader.PostDate,
	Theader.StartDate,
	Theader.EndDate,
	Theader.TTCode,
	Users.username,
	Theader.HeaderNo,
	Theader.HeaderInvNo,
	Theader.TransReqCode,
	THeader.SManCode,
	THeader.WorkOrderCode
FROM 
	Theader,   
	Users  
WHERE 
	(Theader.SalesManCode = Users.UserCode) and 
	(Theader.TransCode = :ar_tcode)
"
  update="Theader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_tcode", number))
)
