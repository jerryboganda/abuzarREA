release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=144 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="GodownItemSetting.icode"  )
column=(type=decimal(4) updatewhereclause=yes name=currqty dbname="currqty"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="reorderqty"  )
column=(type=long updatewhereclause=yes name=optimumqty dbname="optimumqty"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="manfcode"  )
column=(type=long updatewhereclause=yes name=packcode dbname="packcode"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="icatcode"  )
column=(type=long updatewhereclause=yes name=iccode dbname="iccode"  )
 retrieve="Select gis.icode , Isnull(Sum(gd.currqty), 0 ) as currqty , Max(gis.reorderqty) as reorderqty, Max(gis.optimumqty) as optimumqty,
      manfcode=(select manfcode from item where item.icode=gis.icode),
		packcode=(select packcode from item where item.icode=gis.icode),
		icatcode=(select icatcode from item where item.icode=gis.icode),
		iccode=(select iccode from item where item.icode=gis.icode)
From  godownitemsetting gis Left Outer Join godowndetail gd On 
	  (gd.icode = gis.icode and gd.gcode = gis.gcode)
Where   gis.gcode = :ai_TGCode
Group By gis.icode
Having  Max(gis.reorderqty) > IsNull(Sum(gd.currqty), 0 )

order by manfcode,packcode,icatcode,iccode

/*Select gis.icode , Isnull(Sum(gd.currqty), 0 ) as currqty , Max(gis.reorderqty) as reorderqty, Max(gis.optimumqty) as optimumqty
From  godownitemsetting gis Left Outer Join godowndetail gd On
	  (gd.icode = gis.icode and gd.gcode = gis.gcode)
Where   gis.gcode = :ai_TGCode 
Group By gis.icode 
Having  Max(gis.reorderqty) > IsNull(Sum(gd.currqty), 0 )*/"
  arguments=(("ai_TGCode", number))
)
