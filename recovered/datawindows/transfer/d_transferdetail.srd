release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(255) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=char(203) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Tdetail.transcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="Tdetail.icode"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="GodownDetail.currqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) > 0" initial="1" name=qty dbname="Tdetail.qty"  )
 retrieve="SELECT 
	fullcode=stuff('0000', 5 - datalength(ltrim(str(dbo.item.iccode))), datalength(ltrim(str(dbo.item.iccode))), ltrim(str(dbo.item.iccode))) + stuff('00', 3 - datalength(ltrim(str(dbo.item.icatcode))), datalength(ltrim(str(dbo.item.icatcode))), ltrim(str(dbo.item.icatcode)))+ stuff('000', 4 - datalength(ltrim(str(dbo.item.packcode))), datalength(ltrim(str(dbo.item.packcode))), ltrim(str(dbo.item.packcode)))+ stuff('000', 4 - datalength(ltrim(str(dbo.item.manfcode))), datalength(ltrim(str(dbo.item.manfcode))), ltrim(str(dbo.item.manfcode))),
	itemname= itemclass.name	+' ' +itemcategory.name+' ' +itempacking.name+' '+manufacturer.name, 
	currlistrow = 0,
	tdetail.transcode,   
	tdetail.icode,   
	godowndetail.currqty,   
	tdetail.qty  
FROM 
	tdetail,   
	godowndetail,   
	theader,   
	item ,
	itemclass,
	itemcategory,
	itempacking,
	manufacturer
WHERE 
	( tdetail.icode = godowndetail.icode ) and  
	( theader.transcode = tdetail.transcode ) and  
	( theader.sgcode = godowndetail.gcode ) and  
	( tdetail.icode = item.icode ) and  
	( item.iccode = itemclass.iccode ) and  
	(( item.icatcode = itemcategory.icatcode ) and  
	( item.packcode = itempacking.packcode ) and  
	( item.manfcode = manufacturer.manfcode )) and
	( ( dbo.tdetail.transcode = :ar_transcode ) )    
Order by 
	item.manfcode,
	item.packcode,
	item.icatcode,
	item.iccode
"
  update="tdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_transcode", number))
)
