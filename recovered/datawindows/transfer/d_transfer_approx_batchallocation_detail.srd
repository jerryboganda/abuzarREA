release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=484 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=customicode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=long updatewhereclause=yes name=transcode dbname="transcode"  )
column=(type=long updatewhereclause=yes name=icode dbname="Tdetail.icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode" 
 values=""  )
column=(type=long updatewhereclause=yes name=dgcode dbname="dgcode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=datetime updatewhereclause=yes name=manfdate dbname="manfdate"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=long updatewhereclause=yes name=rowgroup dbname="rowgroup"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
 retrieve="SELECT
	item.customicode,  
	itemname= item.name,  
	stock     = 0.0000, 
	packingdesc=item.packingdesc,
	totalstock= 0.0000, 
	transcode=tdetail.transcode,   
	tdetail.icode,   
	gcode=(SELECT THeader.SGCode FROM THeader WHERE THeader.TransCode = :ar_Code),
	dgcode=(SELECT THeader.DGCode FROM THeader WHERE THeader.TransCode = :ar_Code),
	batch=tdetail.batch,
	expiry=tdetail.expiry,
	manfdate = GETDATE(),
	Id        = max(tdetail.IDENTITYCOL), 
	rowgroup=tdetail.rowgroup,
	qty  = sum(tdetail.qty) 

FROM 
	tdetail, 
	item 

WHERE 
	( dbo.tdetail.transcode = :ar_Code )    AND
	( tdetail.icode = item.icode )
         
GROUP BY 
	tdetail.transcode, 
	tdetail.icode, 
	tdetail.RowGroup,
	item.customicode, 
	tdetail.AlternateCustomICode,
	item.name,
	item.packingdesc,
	tdetail.batch,
	tdetail.expiry
ORDER BY 
	MIN(tdetail.IDENTITYCOL)"
  arguments=(("ar_Code", number))
)
