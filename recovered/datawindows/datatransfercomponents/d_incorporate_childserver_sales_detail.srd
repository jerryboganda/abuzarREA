footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(100) key=yes updatewhereclause=yes name=childserver dbname="IMP_AdvSaleLedger.ChildServer"  )
column=(type=datetime updatewhereclause=yes name=transmitdate dbname="TransmitDate"  )
column=(type=long update=yes updatewhereclause=yes name=invtype dbname="IMP_AdvSaleLedger.InvType" 
 values="Cash	1/Credit	2/"  )
column=(type=long key=yes updatewhereclause=yes name=advsaleinvcode dbname="IMP_AdvSaleLedger.AdvSaleInvCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=custcode dbname="IMP_AdvSaleLedger.CustCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=date dbname="IMP_AdvSaleLedger.Date"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="IMP_AdvSaleLedger.InvTotal"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="IMP_AdvSaleLedger.Remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes name=transmit dbname="IMP_AdvSaleLedger.Transmit" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes name=transmited dbname="IMP_AdvSaleLedger.Transmited" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	ChildServer,
	TransmitDate=TransDate,
	InvType,
	AdvSaleInvCode, 
	AliasName=(SELECT A.AliasName FROM Accounts A WHERE A.AccCode = Imp_AdvSaleLedger.CustCode),
	CustCode,
	Date, 
	InvTotal, 
	UserName=(SELECT users.username FROM users where users.usercode = Imp_AdvSaleLedger.SalesManCode),
	Remarks,
	Transmit,
	Transmited
FROM
	Imp_AdvSaleLedger
WHERE 
	ChildServer = CASE WHEN LEN(:as_childserver) > 0 THEN :as_childserver ELSE ChildServer END AND
	CustCode = CASE WHEN :ai_custcode > 0 THEN :ai_custcode ELSE CustCode END AND
	Date BETWEEN :ad_startdate AND :ad_enddate AND
	InvType IN (1, 2) AND
	Transmited = 'N'
ORDER BY
	AdvSaleInvCode"
  update="Imp_AdvSaleLedger" updatewhere=1 updatekeyinplace=yes
  arguments=(("as_childserver", string), ("ai_custcode", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="childserver A, date A"
)
