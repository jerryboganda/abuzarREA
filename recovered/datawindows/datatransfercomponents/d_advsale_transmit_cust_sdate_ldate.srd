summary(height=76 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=advsaleinvcode dbname="AdvSaleLedger.AdvSaleInvCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=custcode dbname="AdvSaleLedger.CustCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=date dbname="AdvSaleLedger.Date"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="AdvSaleLedger.InvTotal"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="AdvSaleLedger.Remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes name=transmit dbname="AdvSaleLedger.Transmit" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=transmited dbname="AdvSaleLedger.Transmited" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	AdvSaleInvCode, 
	AliasName=(SELECT A.AliasName FROM Accounts A WHERE A.AccCode = AdvSaleLedger.CustCode),
	CustCode,
	Date, 
	InvTotal, 
	UserName=(SELECT users.username FROM users where users.usercode = AdvSaleLedger.SalesManCode),
	Remarks,
	Transmit,
	Transmited
FROM
	AdvSaleLedger
WHERE 
	CustCode = CASE :ai_custcode WHEN NULL THEN CustCode ELSE :ai_custcode END AND
	Date >= :ad_startdate AND Date <= :ad_enddate AND
	DELETED = 'N'
ORDER BY
	AdvSaleInvCode"
  update="AdvSaleLedger" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_custcode", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="date A"
)
