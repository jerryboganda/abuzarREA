table(column=(type=char(100) key=yes updatewhereclause=yes name=childserver dbname="IMP_SRLedger.ChildServer"  )
column=(type=datetime updatewhereclause=yes name=transmitdate dbname="TransmitDate"  )
column=(type=long updatewhereclause=yes name=invtype dbname="IMP_SRLedger.InvType" 
 values="Sales	1/S//R	3/"  )
column=(type=long key=yes updatewhereclause=yes name=srinvcode dbname="IMP_SRLedger.SRInvCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=custcode dbname="IMP_SRLedger.CustCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=date dbname="IMP_SRLedger.Date"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="IMP_SRLedger.InvTotal"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="IMP_SRLedger.Remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes name=transmit dbname="IMP_SRLedger.Transmit" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes name=transmited dbname="IMP_SRLedger.Transmited"  )
 retrieve="SELECT 
	ChildServer,
	TransmitDate=TransDate,
	InvType,
	SRInvCode, 
	AliasName=(SELECT A.AliasName FROM Accounts A WHERE A.AccCode = Imp_SRLedger.CustCode),
	CustCode,
	Date, 
	InvTotal, 
	UserName=(SELECT users.username FROM users where users.usercode = Imp_SRLedger.SalesManCode),
	Remarks,
	Transmit,
	Transmited
FROM
	Imp_SRLedger
WHERE 
	ChildServer = CASE WHEN LEN(:as_childserver) > 0 THEN :as_childserver ELSE ChildServer END AND
	CustCode = CASE WHEN :ai_custcode > 0 THEN :ai_custcode ELSE CustCode END AND
	Date BETWEEN :ad_startdate AND :ad_enddate AND
	InvType IN (3) AND Transmited = 'N'
ORDER BY
	SRInvCode"
  update="Imp_SRLedger" updatewhere=1 updatekeyinplace=yes
  arguments=(("as_childserver", string), ("ai_custcode", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="childserver A, date A"
)
