release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1354 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=logdate dbname="LogDate"  )
column=(type=char(60) updatewhereclause=yes name=importedby dbname="ImportedBy"  )
column=(type=char(20) updatewhereclause=yes name=importtype dbname="ImportType"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
 retrieve="SELECT 
	LogDate=DL.LogDate, 
	ImportedBy=U.UserName, 
	ImportType=DL.ImportType, 
	Remarks = DL.Remarks
FROM 
	DataImportLog DL, Users U
WHERE 
	DL.LogDate BETWEEN :adt_startdate AND :adt_enddate AND 
	DL.ImportedBy = U.UserCode"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
)
