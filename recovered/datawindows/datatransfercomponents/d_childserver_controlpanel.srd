 retrieve="SELECT
	ParentServer=SPACE(100),
	ParentDatabase=SPACE(100),
	ServerStatus=:ai_serverstatus,
	LastDataImport=(SELECT a=DBO.Fn_Get_DateTime_Preference('LastDataImport')),
	LastDataSynchronization=(SELECT a=DBO.Fn_Get_DateTime_Preference('LastDataSynchronization')),
	LastSaleTransmited=(SELECT a=DBO.Fn_Get_DateTime_Preference('LastSaleTransmited')),
	LastSaleSynchronized=(SELECT a=DBO.Fn_Get_DateTime_Preference('LastSaleSynchronized'))"
  arguments=(("ai_serverstatus", number))
)
