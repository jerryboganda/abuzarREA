table(column=(type=char(100) updatewhereclause=yes name=parentserver dbname="ParentServer"  )
column=(type=char(100) updatewhereclause=yes name=parentdatabase dbname="ParentDatabase"  )
column=(type=long updatewhereclause=yes name=serverstatus dbname="ServerStatus"  )
column=(type=datetime updatewhereclause=yes name=lastdataimport dbname="LastDataImport"  )
