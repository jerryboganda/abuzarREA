header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=83 color="536870912" )
table(column=(type=long updatewhereclause=yes name=position dbname="POSITION"  )
column=(type=char(128) updatewhereclause=yes name=itemname dbname="COLUMNNAME"  )
 retrieve="SELECT
	POSITION = convert(int,
			   (
				select count(*)
				from syscolumns sc
				where sc.id     =  c.id
				  AND sc.number =  c.number
				  AND sc.colid  <= c.colid
			    )),
	COLUMNNAME = convert(sysname,c.name)
FROM
	sysobjects o,
	syscolumns c,
	systypes t
WHERE
	o.id = (SELECT ID FROM SysObjects WHERE NAME = :as_tablename) AND c.id = o.id AND c.xtype = t.xtype and t.name in ('real','money','float','decimal','numeric','smallmoney')
ORDER BY Position
"
  arguments=(("as_tablename", string))
)
