detail(height=64 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleLedger.Date"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="SaleLedger.InvTotal"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="SaleLedger.Posted"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="SaleLedger.custrefno"  )
 retrieve="Select 	Code = SaleInvCode,
			Date,
			InvTotal,
			Accounts.Name,
			Posted,
			Remarks=SaleLedger.Remarks,
			custrefno

From     SaleLedger, Accounts

Where   SaleLedger.custcode = Accounts.AccCode"
  sort="code D"
)
