 retrieve="SELECT 
	CustCode=NULL,
	ExportItemChangesSince=CAST(CONVERT(VARCHAR(100), DATEADD(dd, - dbo.Fn_Get_Int_Preference('AgeOfItemChangesForDataCarryInDays'), GETDATE()), 101) AS DATETIME),
	BasicData = 'N',
	StockInHand='N',
	Sale='N',
	StartSaleInvCode=0,
	EndSaleInvCode=0,
	SaleCustomer = NULL,
	PO='N',
	StartPOCode=0,
	EndPOCode=0,
	PR='N',
	StartPRCode=0,
	EndPRCode=0,
	SO='N',
	StartSOCode=0,
	EndSOCode=0,
	Issue='N',
	StartIssueInvCode=0,
	EndIssueInvCode=0,
	ServiceSales='N',
	StartServicInvCode=0,
	EndServicInvCode=0,
	PUR='N',
	StartPurCode=0,
	EndPurCode=0,
	Quot='N',
	StartQuotCode=0,
	EndQuotCode=0,
	PExpIntimation='N',
	StartPExpIntimationCode=0,
	EndPExpIntimationCode=0,
	SExpIntimation='N',
	StartSExpIntimationCode=0,
	EndSExpIntimationCode=0

"
 )
