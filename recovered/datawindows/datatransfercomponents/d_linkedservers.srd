table(column=(type=long updatewhereclause=yes name=srvid dbname="sysservers.SrvId"  )
column=(type=long updatewhereclause=yes name=srvstatus dbname="sysservers.SrvStatus"  )
column=(type=char(128) updatewhereclause=yes name=srvname dbname="sysservers.SrvName"  )
column=(type=char(128) updatewhereclause=yes name=srvproduct dbname="sysservers.SrvProduct"  )
column=(type=char(128) updatewhereclause=yes name=providername dbname="sysservers.ProviderName"  )
column=(type=char(4000) updatewhereclause=yes name=datasource dbname="sysservers.DataSource"  )
column=(type=char(128) updatewhereclause=yes name=catalog dbname="sysservers.Catalog"  )
 retrieve="SELECT SrvId, SrvStatus, SrvName, SrvProduct, ProviderName, DataSource, Catalog 
FROM sysservers 
WHERE ProviderName = 'SQLOLEDB' AND isRemote=1
ORDER BY SrvName"
 )
