release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Item.icode"  )
column=(type=long updatewhereclause=yes name=item_iccode dbname="Item.iccode"  )
column=(type=long updatewhereclause=yes name=item_icatcode dbname="Item.icatcode"  )
column=(type=long updatewhereclause=yes name=item_packcode dbname="Item.packcode"  )
column=(type=long updatewhereclause=yes name=item_manfcode dbname="Item.manfcode"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory_name dbname="ItemCategory.name"  )
column=(type=char(60) updatewhereclause=yes name=itemclass_name dbname="ItemClass.name"  )
column=(type=char(20) updatewhereclause=yes name=itempacking_name dbname="ItemPacking.name"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="Manufacturer.name"  )
 retrieve="  SELECT item.icode,   
         item.iccode,   
         item.icatcode,   
         item.packcode,   
         item.manfcode,   
         itemcategory.name,   
         itemclass.name,   
         itempacking.name,   
         manufacturer.name  
    FROM item,   
         itemcategory, 
         itemclass,   
         itempacking,   
         manufacturer  
   WHERE ( itemcategory.icatcode = item.icatcode ) and  
         ( itemclass.iccode = item.iccode ) and  
         ( itempacking.packcode = item.packcode ) and  
         ( manufacturer.manfcode = item.manfcode )    
"
 )
text(name=t_2 band=header font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="2" background.color="80263581" color="0" alignment="2" border="6" x="439" y="16" height="60" width="1257" text="Name" )
text(name=t_1 band=header font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="2" background.color="80263581" color="0" alignment="2" border="6" x="9" y="16" height="60" width="421" text="Code" )
compute(name=itemfullcode band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="9" y="8" height="72" width="421" format="[general]" expression=" padzeros(item_iccode, 4 ) +padzeros ( item_icatcode,2 ) + padzeros( item_packcode, 3 ) + padzeros ( item_manfcode, 3 )" alignment="0" border="0" crosstab.repeat=no )
column(name=code visible="1	0" band=detail id=1 x="1705" y="4" height="76" width="9" color="0" border="0" alignment="0" format="[general]" edit.autohscroll=no edit.autoselect=yes edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="2" background.color="16777215" font.charset="0" font.face="Arial" font.family="2" font.height="-12" font.pitch="2" font.weight="400" tabsequence=0 )
compute(name=item_full_name band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="439" y="4" height="72" width="1257" format="[general]" expression=" itemclass_name + ~" ~" + itemcategory_name + ~" ~" + itempacking_name + ~" ~" + manufacturer_name " alignment="0" border="0" crosstab.repeat=no )
htmltable(border="0" )
htmlgen(clientComputedFields="1" clientEvents="1" clientFormatting="0" clientScriptable="0" clientValidation="1" generateJavaScript="1" pagingMethod=0 )
xhtmlgen() cssgen()
xmlgen()
xsltgen()
jsgen()
export.xml(metadatatype=0 savemetadata=0 )
import.xml()
export.pdf(method=0 )
export.xhtml()
