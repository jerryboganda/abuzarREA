detail(height=64 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="SRAllocationHeader.SRAllocationCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SRAllocationHeader.Date"  )
column=(type=long updatewhereclause=yes name=returncode dbname="SRAllocationHeader.SRInvCode"  )
column=(type=long updatewhereclause=yes name=returntype dbname="ReturnType"  )
column=(type=datetime updatewhereclause=yes name=returndate dbname="ReturnDate"  )
column=(type=decimal(2) updatewhereclause=yes name=returnamt dbname="ReturnAmt"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SRLedger.SaleInvCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="Accounts.Name"  )
column=(type=char(60) updatewhereclause=yes name=user dbname="Users.UserName"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="SRAllocationHeader.Posted"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="SRAllocationHeader.PostDate"  )
 retrieve="SELECT
	SRAllocationHeader.SRAllocationCode,   
	SRAllocationHeader.Date,   
	SRAllocationHeader.SRInvCode,   
	ReturnType=SRLedger.SRCatCode,
	ReturnDate=SRLedger.Date, 
	ReturnAmt=SRLedger.InvTotal,
	SRLedger.SaleInvCode, 
	Accounts.AliasName, 
	Accounts.Name,
	Users.UserName,
	SRAllocationHeader.Posted, 
	SRAllocationHeader.PostDate
FROM 
	SRAllocationHeader, SRLedger, Accounts, Customer, Users

WHERE
	SRAllocationHeader.SRInvCode = SRLedger.SRInvCode AND
	SRLedger.CustCode = Customer.CustCode AND
	Customer.CustCode = Accounts.AccCode AND
	SRAllocationHeader.UserCode = Users.UserCode

ORDER BY
	SRAllocationHeader.SRAllocationCode"
 )
