summary(height=0 color="536870912" )
footer(height=76 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SRAllocationDetail.SRAllocationCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=saleinvcode dbname="SRAllocationDetail.SaleInvCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=saledate dbname="SaleLedger.Date"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=netamt dbname="SaleLedger.InvTotal"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=outstandingamt dbname="SRAllocationDetail.OutstandingAmt"  )
column=(type=long identity=yes updatewhereclause=yes name=srallocationrowid dbname="SRAllocationDetail.SRAllocationRowID"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=srallocationutn dbname="SRAllocationDetail.SRAllocationUTN"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) > 0" name=amt dbname="SRAllocationDetail.Amt"  )
 retrieve="SELECT
	SRAllocationDetail.SRAllocationCode,
	SRAllocationDetail.SaleInvCode,
	SaleLedger.Date,
	SaleLedger.InvTotal,
	SRAllocationDetail.OutstandingAmt,
	SRAllocationDetail.IDENTITYCOL,
	SRAllocationDetail.SRAllocationUTN,
	SRAllocationDetail.Amt
FROM
	SRAllocationDetail,
	SRAllocationHeader,
	SaleLedger
WHERE
	( SRAllocationHeader.SRAllocationCode = :Code ) AND
	( SRAllocationHeader.SRAllocationCode = SRAllocationDetail.SRAllocationCode ) and  
	( SRAllocationDetail.SaleInvCode = SaleLedger.SaleInvCode )
ORDER BY
	SRAllocationDetail.SRAllocationCode,   
	SRAllocationDetail.IDENTITYCOL,
	SRAllocationDetail.SaleInvCode
"
  update="SRAllocationDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("Code", number))
)
