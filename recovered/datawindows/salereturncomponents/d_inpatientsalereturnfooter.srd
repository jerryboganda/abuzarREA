table(column=(type=decimal(2) updatewhereclause=yes initial="0" name=invgstperc1 dbname="SRLedger.invgstperc1"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0 AND Real (GetText()) <= 100" initial="0" name=discperc dbname="SRLedger.discperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=flatdisc dbname="SRLedger.flatdisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=misccharges dbname="SRLedger.misccharges"  )
column=(type=long updatewhereclause=yes initial="0" name=icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=retableqty dbname="retableqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=saleqty dbname="saleqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=retablebonusqty dbname="retablebonusqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=salebonusqty dbname="salebonusqty"  )
column=(type=decimal(1) updatewhereclause=yes initial="0" name=total dbname="total"  )
 retrieve="  SELECT srledger.invgstperc1,
			srledger.discperc,   
         srledger.flatdisc,   
         srledger.misccharges,
			icode = 0, 
			stock = 0.0000, 
			retableqty = 0.0000,
			saleqty = 0.0000,
			retablebonusqty = 0.0000,
			salebonusqty = 0.0000,
			total = 0.0
    FROM srledger  
   WHERE srledger.srinvcode = :ra_saleretinvcode    
"
  arguments=(("ra_saleretinvcode", number))
)
