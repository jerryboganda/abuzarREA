footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=invoicecode dbname="SRLedger.SrInvCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="SRLedger.Date"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="SRLedger.CustCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.Name"  )
column=(type=char(20) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=outstandingamt dbname="SRLedger.OutstandingAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=netamt dbname="SRLedger.InvTotal"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="SRLedger.Posted"  )
column=(type=char(1) updatewhereclause=yes name=oldmarked dbname="OldMarked"  )
column=(type=char(1) update=yes updatewhereclause=yes name=accountfor dbname="SRLedger.AccountFor"  )
column=(type=char(1) update=yes updatewhereclause=yes name=marked dbname="SRLedger.Marked" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	SrLedger.SrInvCode,
	SrLedger.Date,
	SrLedger.CustCode,
	Accounts.Name,
	Accounts.AliasName,
	SrLedger.OutstandingAmt,
	SrLedger.InvTotal,
	SrLedger.Posted,
	OldMarked=SrLedger.Marked,
	SrLedger.AccountFor,
	SrLedger.Marked
FROM 
	SrLedger, Accounts
WHERE
	SrLedger.SrInvCode IN (:ai_invoices) AND
	SrLedger.AccountFor = 'Y' AND
	SrLedger.Posted ='Y' AND
	SrLedger.CustCode = Accounts.AccCode"
  update="SrLedger" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_invoices", numberlist))
)
