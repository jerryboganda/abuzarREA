release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=name dbname="name"  )
column=(type=char(140) updatewhereclause=yes name=compute_0002 dbname="compute_0002"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="customicode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="LooseQty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(4) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
 retrieve=" SELECT name, compute_0002, icode, customicode, gcode, batch, expiry, saleprice, discperc, 
	SUM(looseqty) AS LooseQty, packunits, SUM(ReturnQty) as ReturnQty 
  FROM 

  (SELECT dbo.item.name, 
	dbo.item.name + space(70) + str(dbo.item.icode) as compute_0002, 
	dbo.item.icode,
	dbo.item.customicode, 
	dbo.saledetail.gcode,
	dbo.saledetail.batch,
	dbo.saledetail.expiry,
	dbo.saledetail.saleprice,
	dbo.saledetail.discperc,
	dbo.saledetail.looseqty,
	dbo.saledetail.packunits,
	ReturnQty = (SELECT IsNull(Sum(srdetail.looseqty), 0)
			FROM   	srledger, srdetail
			WHERE  	srledger.saleinvcode = saledetail.SaleInvCode    and
				srledger.posted      = 'Y'                and
				srledger.srinvcode   = srdetail.SRInvCode and
				srdetail.gcode       = saledetail.GCode and
				srdetail.icode       = item.ICode and
				srdetail.batch       = saledetail.Batch and
				srdetail.expiry      = saledetail.Expiry) 
	
    FROM dbo.item,   
	 dbo.saledetail	

    WHERE ( saledetail.saleinvcode = :ar_SaleInvCode )and
			( item.icode = saledetail.icode ) and
			( saledetail.due IN (NULL))

UNION ALL

SELECT dbo.item.name, 
	dbo.item.name + space(70) + str(dbo.item.icode) as compute_0002, 
	dbo.item.icode,
	max(dbo.item.customicode),
	dbo.Duesatisfydetail.gcode,
	dbo.Duesatisfydetail.batch,
	dbo.Duesatisfydetail.expiry,
	dbo.saledetail.saleprice,
	dbo.saledetail.discperc,
	looseqty = sum(dbo.Duesatisfydetail.duesatisfyqty),
	dbo.saledetail.packunits,
	ReturnQty = (SELECT IsNull(Sum(srdetail.looseqty), 0)
			FROM   	srledger, srdetail
			WHERE  	srledger.saleinvcode = Duesatisfyheader.SaleInvCode    and
				srledger.posted      = 'Y'                and
				srledger.srinvcode   = srdetail.SRInvCode and
				srdetail.gcode       = Duesatisfydetail.GCode and
				srdetail.icode       = Duesatisfydetail.ICode and
				srdetail.batch       = Duesatisfydetail.Batch and
				srdetail.expiry      = Duesatisfydetail.Expiry) 

    FROM dbo.item,   
	dbo.saledetail,
	dbo.duesatisfydetail,
	dbo.Duesatisfyheader
			

   WHERE ( saledetail.saleinvcode = :ar_SaleInvCode)and
			( dbo.Duesatisfyheader.saleinvcode = :ar_SaleInvCode) and
			( dbo.Duesatisfyheader.duesatisfycode = dbo.duesatisfydetail.duesatisfycode) and
			( item.icode = dbo.duesatisfydetail.icode ) and
			( saledetail.gcode = dbo.duesatisfydetail.gcode) and
			( saledetail.icode = dbo.duesatisfydetail.icode) and 
			( saledetail.due in ('S', 'D', 'X') )

GROUP BY item.icode,
	 dbo.item.name,
	duesatisfydetail.icode,
	duesatisfydetail.gcode,
	duesatisfydetail.batch,
	duesatisfydetail.expiry,
	duesatisfyheader.saleinvcode,
	dbo.saledetail.saleprice,
	dbo.saledetail.discperc,
	dbo.saledetail.packunits) AS TMP

  GROUP BY icode, name, compute_0002, customicode, gcode, batch, expiry, saleprice, discperc, packunits
ORDER BY name, 
			expiry,
			batch "
  arguments=(("ar_SaleInvCode", number))
)
