 retrieve="SELECT     srledger.saleinvcode ,
           srledger.srinvcode ,
           srledger.date ,
           srledger.srcatcode ,
           aliasname='            ',
           srledger.custcode ,
           srledger.salesmancode ,
           srledger.discperc ,
           srledger.flatdisc ,
			  srledger.invgstperc1,
           srledger.misccharges , 
           users.username , 
           srledger.posted ,
           srledger.originaldate ,
           srledger.postdate ,
           srledger.remarks ,
           customer.address1 ,
           customer.city ,
           customer.phone,
           srledger.smancode,
			  srledger.custrefno,
			  srledger.custrefno2,
			  srledger.custrefno3,
			  srledger.custrefno4,
			  patientRegno='           ',
			  srledger.patientcode,
  			 srledger.invtotal,
			  srledger.machinename,
			  gcode=0,
			  srledger.headerno,
			  srledger.headerinvno,
			  srledger.admissioncode,
			 Srledger.AccountFor,
			 Srledger.PaymentMode,
			 Srledger.PaymentAccCode,
			 Srledger.Amt,
			 Srledger.AmtBy,
			 Srledger.AmtDate,
			 Srledger.AmtReference,
			 Srledger.Outstandingamt,
			 Srledger.marked,
			 Srledger.PageSize,
			 Srledger.ConsiderInPO

  FROM
	customer ,
	accounts,
	users ,
	srledger     
	LEFT OUTER JOIN SalesMan ON (srledger.smancode = salesman.salesmancode)

  WHERE 	  ( srledger.custcode = customer.custcode ) and       
	        ( srledger.custcode = accounts.acccode ) and    
			  ( srledger.salesmancode = users.usercode ) and
           ( dbo.srledger.srinvcode = :ra_saleretinvcode )   "
  update="srledger" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_saleretinvcode", number))
)
