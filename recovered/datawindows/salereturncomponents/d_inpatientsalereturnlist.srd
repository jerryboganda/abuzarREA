header(height=76 color="536870912" )
summary(height=12 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="SRLedger.srinvcode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Accounts.name"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SRLedger.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="SRLedger.admissioncode"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
 retrieve="SELECT
	srledger.srinvcode , 
	accounts.name , 
	srledger.date,     
	posted = srledger.posted,
	regno= patient.regno,
	patient=patient.name,
	srledger.admissioncode,
	PostedBy = IsNull((Select username from users 
					where dbo.srledger.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
					where dbo.srledger.modifiedby = dbo.users.usercode), '')  
FROM  srledger, 
	 accounts,
	 patientadmission,
	 patient
			
WHERE ( dbo.srledger.admissioncode IS NOT NULL ) and
	( dbo.srledger.srcatcode = 7 ) and
	( dbo.srledger.saleinvcode IS NULL) and 
	( srledger.custcode = accounts.acccode ) and 
	( srledger.Posted IN (:as_Posted)) AND
	( dbo.srledger.HeaderNo IS NULL OR
		( dbo.srledger.HeaderNo IN 
			(SELECT HeaderCode FROM GroupAllowedHeader 
			WHERE GroupCode = :ai_GroupCode AND Module=:ai_Module)))  and
	( dbo.srledger.admissioncode = dbo.patientadmission.admissioncode ) and
	( dbo.patientadmission.patientcode = patient.patientcode )"
  arguments=(("ai_srCatCode", number), ("as_Posted", stringlist), ("ai_groupcode", number), ("ai_module", number))
)
