summary(height=0 color="536870912" )
footer(height=68 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="." name=batch dbname="batch"  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=expiry dbname="expiry"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=avgprice dbname="avgprice"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SRBufferDetail.srbufferinvcode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=gcode dbname="gcode" 
 values=""  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=packqty dbname="packqty"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" name=srprice dbname="srprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=salestax dbname="salestax"  )
column=(type=long update=yes updatewhereclause=yes name=salerowid dbname="salerowid"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=retableqty dbname="retableqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=saleqty dbname="saleqty"  )
column=(type=decimal(4) updatewhereclause=yes name=retablebonusqty dbname="retablebonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=salebonusqty dbname="salebonusqty"  )
column=(type=char(100) update=yes updatewhereclause=yes name=returnitemdescription dbname="returnitemdescription"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="rowid"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0 AND Real (GetText()) <= 100" validationmsg="'Value should be between 0 and 100'" initial="0" name=discperc dbname="discperc"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=srutn dbname="srutn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=gstperc dbname="gstperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="~"Please enter valid value for Total Pieces~"" initial="1" name=totalpieces dbname="TotalPieces"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=piecesinhand dbname="PiecesInHand"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="~"Bonus Qty Must be greater or Equal to Zero~"" initial="0" name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="~"Qty Must be greater or Equal to Zero~"" initial="1" name=looseqty dbname="looseqty"  )
 retrieve="SELECT 
	item.customicode, 
	currlistrow = 0, 
	icode = srbufferdetail.icode, 
	item.name,
	batch = srbufferdetail.batch, 
	expiry = srbufferdetail.expiry, 
	avgprice = srbufferdetail.avgprice,   
	srbufferdetail.srbufferinvcode,    
	gcode =srbufferdetail.gcode,    
	packqty = srbufferdetail.packqty, 
	packunits = srbufferdetail.packunits, 
	srprice = srbufferdetail.srprice, 
	salestax = srbufferdetail.salestax, 
	salerowid = srbufferdetail.salerowid,
	stock = 0.0000, 
	packingdesc=space(50),
	totalstock = 0.0000, 
	retableqty = 0.0000, 
	saleqty =0.0000, 
	retablebonusqty = 0.0000, 
	salebonusqty =0.0000, 
	returnitemdescription=srbufferdetail.returnitemdescription,
	rowid = srbufferdetail.rowid,
	discperc = srbufferdetail.discperc,
	srutn = srbufferdetail.SrUtn,
	unitsalestax = srbufferdetail.unitsalestax,
	gstperc = srbufferdetail.gstperc,
	saleprice = srbufferdetail.saleprice,
	TotalPieces = srbufferdetail.TotalPieces,
	PiecesInHand = srbufferdetail.PiecesInHand,
	bonusqty = srbufferdetail.bonusqty,
	looseqty = srbufferdetail.looseqty   
FROM 
	srbufferdetail,   
	item  
WHERE 
	( srbufferdetail.icode = item.icode ) and  
	(dbo.srbufferdetail.srbufferinvcode = :ra_salesretinvno )    
"
  update="srbufferdetail" updatewhere=1 updatekeyinplace=no
  arguments=(("ra_salesretinvno", number))
 sort="rowid A"
)
