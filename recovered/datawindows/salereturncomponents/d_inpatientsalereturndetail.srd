release 12.5;
datawindow ( units=0 timer_interval=60000 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=64 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="SRdetail.icode" 
 values=""  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="SRdetail.batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes validation="datetime(gettext()) > today()" validationmsg="~"Expiry must be greater than today's date~"" name=expiry dbname="SRdetail.expiry"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=avgprice dbname="SRdetail.avgprice"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SRdetail.srinvcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes initial="1" name=gcode dbname="SRdetail.gcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=packqty dbname="SRdetail.packqty"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=packunits dbname="SRdetail.packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" name=srprice dbname="SRdetail.srprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=salestax dbname="SRdetail.salestax"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=retableqty dbname="retableqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=saleqty dbname="saleqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=retablebonusqty dbname="retablebonusqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=salebonusqty dbname="salebonusqty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0 AND Real (GetText()) <= 100" validationmsg="'Value should be between 0 and 100'" initial="0" name=discperc dbname="SRdetail.discperc"  )
column=(type=decimal(0) key=yes update=yes updatewhereclause=yes name=srutn dbname="SRdetail.SrUtn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=unitsalestax dbname="SRdetail.unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=gstperc dbname="SRdetail.gstperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="SRdetail.saleprice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="~"Bonus Qty Must be greater or Equal to Zero~"" initial="0" name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="~"Qty Must be greater or Equal to Zero~"" initial="1" name=looseqty dbname="SRdetail.looseqty"  )
 retrieve="SELECT 
	item.customicode, 
	currlistrow = 0,
	srdetail.icode, 
	item.name,
	srdetail.batch, 
	srdetail.expiry, 
	srdetail.avgprice,   
	srdetail.srinvcode,    
	srdetail.gcode,    
	srdetail.packqty, 
	srdetail.packunits, 
	srdetail.srprice, 
	srdetail.salestax, 
	stock = 0.0000,
	totalstock = 0.0000, 
	retableqty = 0.0000, 
	saleqty =0.0000, 
	retablebonusqty = 0.0000, 
	salebonusqty =0.0000, 
	srdetail.discperc,
	srdetail.SrUtn,
	srdetail.unitsalestax,
	srdetail.gstperc,
	srdetail.saleprice,
	bonusqty=srdetail.bonusqty,
	srdetail.looseqty
FROM 
	srdetail,   
	item  
WHERE 
	(srdetail.icode = item.icode) AND 
	(dbo.srdetail.srinvcode = :ra_salesretinvno)"
  update="srdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_salesretinvno", number))
)
