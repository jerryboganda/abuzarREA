release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="name"  )
column=(type=char(70) updatewhereclause=yes name=item dbname="item"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=long updatewhereclause=yes name=itemalertcode dbname="itemalertcode" 
 values=""  )
column=(type=long updatewhereclause=yes name=itemalerttypecode dbname="itemalerttypecode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="LooseQty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(4) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
column=(type=decimal(4) updatewhereclause=yes name=returnbonusqty dbname="ReturnBonusQty"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(4) updatewhereclause=yes name=transitstock dbname="transitstock"  )
 retrieve="SELECT 
	customicode, 
	name, 
	item,
	icode,
	packingdesc,
	manufacturer=(SELECT m.Name FROM Manufacturer M WHERE M.ManfCode = TMP.ManfCode),
	itemalertcode,
	itemalerttypecode,
	batch, 
	expiry, 
	saleprice=max(saleprice), 
	discperc=discperc,
	LooseQty=SUM(looseqty), 
	BonusQty=SUM(Bonusqty), 
	packunits, 
	ReturnQty=SUM(ReturnQty), 
	ReturnBonusQty=SUM(ReturnBonusQty),
	unitsalestax,
	gstperc,
	transitstock
FROM 
	(SELECT
		i.name, 
		item=i.name + str(i.icode), 
		i.icode,
		i.customicode,
		i.packingdesc,
		i.manfcode,
		i.itemalertcode,
		itemalerttypecode = (select ia.itemalerttypecode from itemalert ia where ia.itemalertcode = i.itemalertcode),
		i.transitstock,
		sd.gcode,
		sd.batch,
		sd.expiry,
		sd.saleprice,
		sd.discperc,
		looseqty=IsNull(sum(sd.looseqty), 0),
		bonusqty=IsNull(sum(sd.bonusqty), 0),
		sd.packunits,
		unitsalestax=sd.unitsalestax,
		gstperc=sd.gstperc,
		ReturnQty = 0,
		ReturnBonusQty = 0
	
	FROM
		dbo.item i, 
		dbo.saledetail sd,
		dbo.saleledger sl
	WHERE
		( sl.admissioncode = :ar_AdmissionCode ) and
		( sl.saleinvcode = sd.saleinvcode ) and
		( sl.posted = 'Y' ) AND
		( i.icode = sd.icode ) and
		( sd.due IS NULL )
	GROUP BY
		i.name, 
		i.icode,
		i.customicode,
		i.packingdesc,
		i.manfcode,
		i.itemalertcode,
		i.transitstock,
		sd.gcode,
		sd.batch,
		sd.expiry,
		sd.saleprice,
		sd.discperc,
		sd.packunits,
		sd.unitsalestax,
		sd.gstperc
	UNION ALL
	SELECT
		i.name, 
		item=i.name + str(i.icode), 
		i.icode,
		i.customicode,
		i.packingdesc,
		i.manfcode,
		i.itemalertcode,
		itemalerttypecode = (select ia.itemalerttypecode from itemalert ia where ia.itemalertcode = i.itemalertcode),
		i.transitstock,
		sd.gcode,
		sd.batch,
		sd.expiry,
		saleprice=sd.srprice,
		sd.discperc,
		looseqty=0,
		bonusqty=0,
		sd.packunits,
		unitsalestax=sd.unitsalestax,
		gstperc=sd.gstperc,
		ReturnQty = IsNull(Sum(sd.looseqty), 0),
		ReturnBonusQty = IsNull(Sum(sd.bonusqty), 0)
	FROM
		dbo.item i, 
		dbo.srdetail sd,
		dbo.srledger sl
	WHERE
		( sl.admissioncode = :ar_AdmissionCode ) and
		( sl.srinvcode = sd.srinvcode ) and
		( i.icode = sd.icode )
	GROUP BY
		i.name, 
		i.icode,
		i.customicode,
		i.packingdesc,
		i.manfcode,
		i.itemalertcode,
		i.transitstock,
		sd.gcode,
		sd.batch,
		sd.expiry,
		sd.srprice,
		sd.discperc,
		sd.packunits,
		sd.unitsalestax,
		sd.gstperc
	UNION ALL
	SELECT
		i.name, 
		item=i.name + str(i.icode), 
		i.icode,
		max(i.customicode),
		i.packingdesc,
		i.manfcode,
		i.itemalertcode,
		itemalerttypecode = (select ia.itemalerttypecode from itemalert ia where ia.itemalertcode = i.itemalertcode),
		i.transitstock,
		dsd.gcode,
		dsd.batch,
		dsd.expiry,
		sd.saleprice,
		sd.discperc,
		looseqty = ISNULL(sum(dsd.duesatisfyqty), 0),
		Bonusqty=0,
		sd.packunits,
		unitsalestax=sd.unitsalestax,
		gstperc=sd.gstperc,
		ReturnQty = 0,
		ReturnBonusQty=0
	
	FROM 
		dbo.item i,   
		dbo.saleledger sl,
		dbo.saledetail sd,
		dbo.duesatisfydetail dsd,
		dbo.Duesatisfyheader dsh
	
	WHERE
		( sl.admissioncode = :ar_admissioncode ) and
		( sl.saleinvcode = sd.saleinvcode ) and
		( sd.due in ('S', 'D', 'X') ) and
		( dsh.saleinvcode = sd.saleinvcode ) and
		( dsh.duesatisfycode = dsd.duesatisfycode) and
		( i.icode = dsd.icode ) and
		( sd.icode = dsd.icode)
	
	GROUP BY
		i.icode,
		i.name,
		dsd.icode,
		i.packingdesc,
		i.manfcode,
		i.itemalertcode,
		i.transitstock,
		dsd.gcode,
		dsd.batch,
		dsd.expiry,
		dsh.saleinvcode,
		sd.saleprice,
		sd.discperc,
		sd.packunits,
		sd.unitsalestax,
		sd.gstperc) AS TMP

GROUP BY 
	icode, 
	name, 
	item,
	customicode, 
	packingdesc,
	manfcode,
	itemalertcode,
	itemalerttypecode,
	batch, 
	expiry, 
	discperc, 
	packunits, 
	unitsalestax,
	gstperc,
	transitstock

HAVING 
	SUM(looseqty) - SUM(ReturnQty) > 0 OR
	SUM(Bonusqty) - SUM(ReturnBonusQty) > 0

ORDER BY
	name, 
	expiry,
	batch "
  arguments=(("ar_AdmissionCode", number))
)
