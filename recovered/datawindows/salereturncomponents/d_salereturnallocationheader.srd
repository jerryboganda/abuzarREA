column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=modified dbname="SRAllocationHeader.Modified"  )
column=(type=long update=yes updatewhereclause=yes name=modifiedby dbname="SRAllocationHeader.ModifiedBy"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="SRAllocationHeader.Posted"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="SRAllocationHeader.PostedBy"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="SRAllocationHeader.PostDate"  )
 retrieve="SELECT
	SRAllocationHeader.SRAllocationCode,   
	SRAllocationHeader.Date,   
	SRAllocationHeader.SRInvCode,   
	ReturnType=SRLedger.SRCatCode,
	ReturnDate=SRLedger.Date, 
	ReturnAmt=SRLedger.InvTotal,
	ReturnOutstanding=SRLedger.OutStandingAmt,
	SRLedger.SaleInvCode, 
	SRLedger.CustCode,
	Accounts.AliasName, 
	Accounts.Name,
	SRAllocationHeader.UserCode,
	SRAllocationHeader.Modified, 
	SRAllocationHeader.ModifiedBy,
	SRAllocationHeader.Posted, 
	SRAllocationHeader.PostedBy,
	SRAllocationHeader.PostDate
FROM 
	SRAllocationHeader, SRLedger, Accounts, Customer
WHERE
	SRAllocationHeader.SRAllocationCode = :code AND
	SRAllocationHeader.SRInvCode = SRLedger.SRInvCode AND
	SRLedger.CustCode = Customer.CustCode AND
	Customer.CustCode = Accounts.AccCode

"
  update="SRAllocationHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("code", number))
)
