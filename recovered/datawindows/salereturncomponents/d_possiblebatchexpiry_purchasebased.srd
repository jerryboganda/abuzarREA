release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=refno dbname="Refno"  )
column=(type=datetime updatewhereclause=yes name=refdate dbname="RefDate"  )
 retrieve="SELECT DISTINCT  
	Batch=SD.Batch, Expiry=SD.Expiry, Qty = SUM((SD.PackQty * SD.PackUnits) + SD.LooseQty), InvCode=S.PurInvCode, Date=S.Date,
	Refno = S.SuppInvCode, RefDate = S.SuppInvDate
FROM 
	PurDetail SD, PurLedger S
WHERE
	S.SuppCode = :ar_suppcode AND 
	SD.ICode = :ar_icode AND 
	SD.PurInvCode = S.PurInvCode AND 
	S.Posted = 'Y'
GROUP BY
	S.SuppCode,
	S.PurInvCode, 
	S.SuppInvCode, 
	S.SuppInvDate,
	S.Date,
	SD.ICode,	
	SD.Batch, 
	SD.Expiry
ORDER BY
	Batch, Expiry"
  arguments=(("ar_suppcode", number), ("ar_icode", number))
)
