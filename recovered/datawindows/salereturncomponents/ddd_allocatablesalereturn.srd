footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=srinvcode dbname="SRInvCode"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="OutstandingAmt"  )
column=(type=long updatewhereclause=yes name=srcatcode dbname="SRCatCode"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve="SELECT 
	SRInvCode,
	SaleInvCode,   
	Date,   
	CustCode,   
	Customer,
	AliasName,
	OutstandingAmt,
	SRCatCode,
	InvTotal
FROM 
	(SELECT 
		SRLedger.SRInvCode,   
		SRLedger.SaleInvCode,   
		SRLedger.Date,   
		SRLedger.CustCode,   
		Customer=Accounts.Name,
		AliasName=Accounts.AliasName,
		OutstandingAmt = SRLedger.OutstandingAmt + 
			ISNULL((SELECT SRAllocationHeader.SRInvCode FROM SRAllocationHeader 
				WHERE SRAllocationHeader.SRAllocationCode = :Code AND 
					SRAllocationHeader.SRInvCode = SRLedger.SRInvCode), 0),
		SRLedger.SRCatCode,
		SRLedger.InvTotal
	
	FROM 
		SRLedger, Accounts
	WHERE
		SRLedger.AccountFor = 'Y' AND
		SRLedger.Marked = 'N' AND
		SRLedger.Posted ='Y' AND
		SRLedger.SRCatCode IN (7) AND
		SRLedger.CustCode = Accounts.AccCode) SR
WHERE 
	OutstandingAmt > 0
ORDER BY
	Date,   
	SRInvCode"
  arguments=(("code", number))
)
