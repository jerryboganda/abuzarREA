release 12.5;
datawindow ( units=0 timer_interval=60000 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=64 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=srinvcode dbname="SRdetail.srinvcode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=gcode dbname="SRdetail.gcode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="SRdetail.icode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=batch dbname="SRdetail.batch"  )
column=(type=datetime update=yes updatewhereclause=yes validation="datetime(gettext()) > today()" validationmsg="~"Expiry must be greater than today's date~"" name=expiry dbname="SRdetail.expiry"  )
column=(type=long update=yes updatewhereclause=yes name=packqty dbname="SRdetail.packqty"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="SRdetail.avgprice"  )
column=(type=decimal(10) updatewhereclause=yes name=netprice dbname="netprice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=looseqty dbname="SRdetail.looseqty"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="SRdetail.rowid"  )
 retrieve="SELECT 
	srdetail.srinvcode,   
	srdetail.gcode,   
	srdetail.icode, 
	srdetail.batch, 
	srdetail.expiry, 
	srdetail.packqty,
	srdetail.avgprice,
	netprice=Round(srdetail.srprice * (1 - srdetail.discperc * 0.01) * (1 - srledger.discperc * 0.01), 2),
	srdetail.looseqty,
	srdetail.rowid
FROM 
	srledger, srdetail
WHERE 
	srledger.srinvcode = srdetail.srinvcode AND 
	srledger.posted = 'N' AND
	srdetail.srinvcode BETWEEN :al_sinvcode AND :al_linvcode 
order by 
	srdetail.srinvcode"
  arguments=(("al_sinvcode", number), ("al_linvcode", number))
)
