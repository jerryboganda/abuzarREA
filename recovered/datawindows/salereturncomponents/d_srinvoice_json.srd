table(column=(type=long updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=long updatewhereclause=yes name=itemcount dbname="ItemCount"  )
column=(type=char(8000) updatewhereclause=yes name=json dbname="JSON"  )
 retrieve="SELECT RowID=T.RowID, ItemCount, JSON=T.JSON
FROM 
	(SELECT ROWID=-1, ItemCount=0, JSON=SPACE(8000)
	UNION ALL
	SELECT ROWID=0, ItemCount=ISNULL((SELECT Count(D.ICode) FROM SRDetail D WHERE D.SRInvCode=:ai_code),0), JSON='{~"InvoiceNumber~":~"~",~"POSID~":~"' + ISNULL(DBO.Fn_GetPreference('FBRPOSID'),'') + '~",~"USIN~":~"' + LTRIM(RTRIM(STR(S.SRInvCode))) + 
		'~",~"DateTime~":~"' + CONVERT(VARCHAR(100), S.DATE, 121) + 
		'~",~"BuyerNTN~":~"' + ISNULL(C.NTNNo,'') +
		'~",~"BuyerCNIC~":~"' + ISNULL(C.NIC,'') + 
		'~",~"BuyerName~":~"' + ISNULL(A.Name,'') + 
		'~",~"BuyerPhoneNumber~":~"' + ISNULL(C.Phone,'') + 
		'~",~"TotalBillAmount~":~"' + LTRIM(RTRIM(STR(S.InvTotal,12, 2))) + 
		'~",~"TotalQuantity~":~"' + LTRIM(RTRIM(STR(ISNULL((SELECT SUM(D.LooseQty + D.BonusQty) FROM SRDetail D WHERE D.SRInvCode = :ai_code),0)))) + 
		'~",~"TotalSaleValue~":~"' + LTRIM(RTRIM(STR(ISNULL(S.InvTotal - S.MiscCharges,0) - ISNULL(DBO.fn_getTaxOnSRInv(SRInvCode),0),12, 2))) + 
		'~",~"TotalTaxCharged~":~"' + LTRIM(RTRIM(STR(DBO.fn_getTaxOnSRInv(SRInvCode), 12,2))) + 
		'~",~"Discount~":~"' + LTRIM(RTRIM(STR( ISNULL((SELECT ROUND(SUM((D.LooseQty * D.SRPrice * (D.DiscPerc * 0.01))), 2) FROM SRDetail D WHERE D.SRInvCode = :ai_code),0) + S.FlatDisc )))  + 
		'~",~"FurtherTax~":~"' + LTRIM(RTRIM(STR(ISNULL((SELECT InvSaleTax=(Case when (Round(Sum ( (  D.looseqty * (D.srprice)) * (1 - D.discperc /100) * (1 - SL.discperc /100) - SL.flatdisc), 2)) * SL.invgstperc1 * 0.01 IS NULL Then 0 Else (Round(Sum ( (  D.looseqty * (  D.srprice)) *  (1 -   D.discperc /100) * (1 -   SL.discperc /100) ) - SL.flatdisc, 2) ) * SL.invgstperc1 * 0.01 End ) 
			FROM SRDetail D, SRLedger SL WHERE SL.SRInvCode=:ai_code AND SL.SRInvCode = D.SRInvCode
			GROUP BY SL.SRInvCode, SL.invgstperc1, SL.flatdisc, SL.discperc), 0), 12, 2))) +
		',~"PaymentMode~":~"1~",~"RefUSIN~":~"null~",~"InvoiceType~":~"3~",~"Items~":['
	FROM SRLedger S, Customer C, Accounts A
	WHERE S.SRInvCode=:ai_code AND S.CustCode=C.CustCode AND S.CustCode=A.AccCode
	UNION ALL
	SELECT ROWID=D.RowID, ItemCount=1, 
		JSON='{~"ItemCode~":~"' + I.customICode + 
			'~",~"ItemName~":~"' + I.Name + 
			'~",~"Quantity~":~"' + LTRIM(RTRIM(STR(D.LooseQty + D.BonusQty, 10,4))) +
			'~",~"PCTCode~":~"' + P.Description + 
			'~",~"TaxRate~":~"' + LTRIM(RTRIM(STR(CASE WHEN D.GSTPerc > 0 THEN D.GSTPerc ELSE 0 END + STS.TaxPerc, 6, 2))) + 
			'~",~"SaleValue~":~"' + LTRIM(RTRIM(STR(D.LooseQty * D.SRPrice, 12, 2))) + 
			'~",~"TotalAmount~":~"' + LTRIM(RTRIM(STR((D.LooseQty * D.SRPrice) + Round( Round (D.looseqty * D.SRPrice * (1 - D.discperc * 0.01), 2) * D.gstperc * 0.01, 2) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax),12, 2))) + 
			'~",~"TaxCharged~":~"' + LTRIM(RTRIM(STR( ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + Round( Round (D.looseqty * D.SRPrice * (1 - D.discperc * 0.01), 2) * D.gstperc * 0.01, 2),12,2))) + 
			'~",~"Discount~":~"' + LTRIM(RTRIM(STR(ROUND((D.LooseQty * D.SRPrice * (D.DiscPerc * 0.01)), 2),12,2))) + 
			'~",~"FurtherTax~":~"' + 
				LTRIM(RTRIM(STR(
					ROUND(ISNULL((SELECT InvSaleTax=(Case when ((Round(Sum ( (  D.looseqty * D.SRPrice) * (1 - D.discperc /100) * (1 - SL.discperc /100) - SL.flatdisc), 2)) * SL.invgstperc1 * 0.01) IS NULL Then 0 Else (Round(Sum ( (  D.looseqty * D.SRPrice) *  (1 - D.discperc /100) * (1 - SL.discperc /100) ) - SL.flatdisc, 2) ) * SL.invgstperc1 * 0.01 End ) 
						FROM SRDetail D, SRLedger SL 
						WHERE SL.SRInvCode=:ai_code AND D.SRInvCode=:ai_code AND SL.SRInvCode = D.SRInvCode
						GROUP BY SL.SRInvCode, SL.invgstperc1, SL.flatdisc, SL.discperc), 0) * ( ((D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01))  / CASE WHEN (S.Invtotal - S.MiscCharges - DBO.fn_getTaxOnSRInv(S.SRInvCode)) = 0 THEN 1 ELSE (S.Invtotal - S.MiscCharges - DBO.fn_getTaxOnSRInv(S.SRInvCode)) END)), 2)
				, 12, 2))) +
			',~"InvoiceType~":~"3~",~"RefUSIN~":~"null~"},'
	FROM SRLedger S, SRDetail D, Item I, PCT P, SalesTaxSchedule STS
	WHERE S.SRInvCode=:ai_code AND D.SRInvCode=:ai_code AND 
		S.SRInvCode=D.SRInvCode AND
		D.ICode=I.ICode AND 
		I.PCTCode = P.PCTCode AND 
		I.SalesTaxScheduleCode=STS.SalesTaxScheduleCode) T 
WHERE ROWID >= 0
ORDER BY RowID"
  arguments=(("ai_code", number))
)
