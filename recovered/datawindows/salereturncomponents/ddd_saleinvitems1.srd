table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(140) updatewhereclause=yes name=compute_0002 dbname="compute_0002"  )
column=(type=long updatewhereclause=yes name=icode dbname="Item.icode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="Saledetail.gcode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Saledetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Saledetail.expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Saledetail.saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="Saledetail.discperc"  )
column=(type=char(1) updatewhereclause=yes name=claimable dbname="Saledetail.claimable"  )
column=(type=decimal(2) updatewhereclause=yes name=claimablediscperc dbname="Saledetail.claimablediscperc"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="Saledetail.looseqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Saledetail.packunits"  )
column=(type=decimal(4) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
 retrieve="SELECT
	dbo.item.name,
	dbo.item.name + space(70) + str(dbo.item.icode), 
	dbo.item.icode, 
	dbo.item.customicode,
	dbo.saledetail.gcode,
	dbo.saledetail.batch,
	dbo.saledetail.expiry,
	dbo.saledetail.saleprice,
	dbo.saledetail.discperc,
	dbo.saledetail.claimable,
	dbo.saledetail.claimablediscperc,
	dbo.saledetail.looseqty,
	dbo.saledetail.packunits,
	ReturnQty = (SELECT IsNull(Sum(srdetail.looseqty), 0)
					FROM   	srledger, srdetail
					WHERE  	srledger.saleinvcode = saledetail.SaleInvCode    and
								srledger.posted      = 'Y'                and
								srledger.srinvcode   = srdetail.SRInvCode and
								srdetail.gcode       = saledetail.GCode and
								srdetail.icode       = item.ICode and
								srdetail.batch       = saledetail.Batch and
								srdetail.expiry      = saledetail.Expiry) 

FROM 
	dbo.item,   
	dbo.saledetail	

WHERE 
	( saledetail.saleinvcode = :ar_SaleInvCode )and
	( item.icode = saledetail.icode ) and
	( saledetail.due IS NULL OR saledetail.due = 's')
ORDER BY 
	dbo.item.name, 
	dbo.saledetail.expiry,
	dbo.saledetail.batch
"
  arguments=(("ar_SaleInvCode", number))
)
