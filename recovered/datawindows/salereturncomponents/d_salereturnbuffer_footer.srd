table(column=(type=decimal(2) updatewhereclause=yes initial="0" name=invgstperc1 dbname="invgstperc1"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0 AND Real (GetText()) <= 100" initial="0" name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=discvalue dbname="discvalue"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=fbrposfee dbname="FBRPosFee"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxamt dbname="AdvanceTaxAmt"  )
column=(type=long updatewhereclause=yes initial="0" name=icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=retableqty dbname="retableqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=saleqty dbname="saleqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=retablebonusqty dbname="retablebonusqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=salebonusqty dbname="salebonusqty"  )
column=(type=long updatewhereclause=yes name=piecesinhand dbname="piecesinhand"  )
column=(type=decimal(1) updatewhereclause=yes initial="0" name=total dbname="total"  )
 retrieve="SELECT 
	invgstperc1 = srbufferledger.invgstperc1,
	discperc = srbufferledger.discperc,   
	discvalue = 0.00,
	flatdisc = srbufferledger.flatdisc,   
	misccharges = srbufferledger.misccharges,
	FBRPosFee = srbufferledger.fbrposfee,
	AdvanceTaxAmt = srbufferledger.AdvanceTaxAmt,
	icode = 0, 
	stock = 0.0000, 
	retableqty = 0.0000,
	saleqty = 0.0000 ,
	retablebonusqty = 0.0000,
	salebonusqty = 0.0000 ,
	piecesinhand=0,
	total = 0.0
FROM 
	srbufferledger  
WHERE 
	srbufferledger.srbufferinvcode = :ra_saleretinvcode    
"
  arguments=(("ra_saleretinvcode", number))
)
