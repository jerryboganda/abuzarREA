footer(height=24 color="536870912" )
detail(height=212 color="536870912" )
table(column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0 AND Real (GetText()) <= 100" validationmsg="'please enter valid value for invoice level GST %age.'" initial="0" name=invgstperc1 dbname="SRLedger.invgstperc1"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0 AND Real (GetText()) <= 100" validationmsg="'please enter valid value for invoice level discount %age.'" initial="0" name=invdiscperc dbname="SRLedger.discperc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="'please enter valid value for invoice level flat discount.'" initial="0" name=flatdisc dbname="SRLedger.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="'please enter valid value for invoice level misc. charges'" initial="0" name=misccharges dbname="SRLedger.misccharges"  )
column=(type=decimal(1) updatewhereclause=yes initial="0" name=total dbname="total"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=saleqty dbname="saleqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=retableqty dbname="retableqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=salebonusqty dbname="salebonusqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=retablebonusqty dbname="retablebonusqty"  )
 retrieve="  SELECT srledger.invgstperc1,
			srledger.discperc,   
         srledger.flatdisc,   
         srledger.misccharges,
			total = 0.0,
			stock = 0.0000,
			saleqty=0.0000,
			retableqty=0.0000,
			salebonusqty=0.0000,
			retablebonusqty=0.0000
    FROM srledger  
   WHERE srledger.srinvcode = :ra_saleretinvcode    
"
  arguments=(("ra_saleretinvcode", number))
)
