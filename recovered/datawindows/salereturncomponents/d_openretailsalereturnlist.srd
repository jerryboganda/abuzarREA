table(column=(type=long updatewhereclause=yes name=code dbname="SRLedger.srinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SRLedger.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=customer_name dbname="customer_name"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="invtotal"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="salevalue"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="HeaderInvNo"  )
column=(type=long updatewhereclause=yes name=reprintcounter dbname="reprintcounter"  )
column=(type=char(1) updatewhereclause=yes name=fiscalized dbname="Fiscalized"  )
column=(type=datetime updatewhereclause=yes name=fiscalizedon dbname="FiscalizedOn"  )
column=(type=char(100) updatewhereclause=yes name=fiscalinvoiceno dbname="FiscalInvoiceNo"  )
column=(type=char(1) updatewhereclause=yes name=pushed dbname="Pushed" 
 values="Yes	Y/No	N/"  )
column=(type=datetime updatewhereclause=yes name=pushedon dbname="PushedOn"  )
column=(type=char(60) updatewhereclause=no name=pushedby dbname="PushedBy"  )
column=(type=char(203) updatewhereclause=no name=pushedfor dbname="PushedFor"  )
 retrieve="SELECT 
	dbo.srledger.srinvcode,   
	dbo.srledger.date,
	posted = dbo.srledger.posted,
	customer_name=accounts.name,
	invtotal=srledger.invtotal,
	salevalue=(select sum(((SRD.looseqty + SRD.bonusqty)*SRD.saleprice))
				  from srdetail SRD
				  where SRD.srinvcode=srledger.srinvcode),
	username=(select username from users where users.usercode=srledger.salesmancode),
	PostedBy = IsNull((Select username from users 
					where dbo.srledger.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
					where dbo.srledger.modifiedby = dbo.users.usercode), ''),
	HeaderNo=srledger.HeaderNo,
	HeaderInvNo=srledger.HeaderInvNo,
	reprintcounter=srledger.reprintingcounter,
	Fiscalized = srledger.Fiscalized,
	FiscalizedOn = srledger.FiscalizedOn,
	FiscalInvoiceNo = srledger.FiscalInvoiceNo,
	Pushed=srledger.Pushed,
	PushedOn=srledger.PushedOn,
	PushedBy=IsNull((Select username from users 
							where srledger.PushedBy = dbo.users.usercode), ''),
	PushedFor = IsNull((SELECT S.Name + ' (' + S.InstanceID + ')' FROM Site S WHERE S.SiteCode=srledger.TargetSiteCode),'')
FROM 
	dbo.srledger , accounts 
WHERE 
	dbo.srledger.srcatcode = :ai_srCatCode    and
	dbo.srledger.saleinvcode IS NULL and 
	dbo.srledger.Posted In(:as_Posted) AND
	dbo.srledger.custcode = accounts.acccode and
	( dbo.srledger.admissioncode IS NULL ) and
	( dbo.srledger.HeaderNo IS NULL OR
		( dbo.srledger.HeaderNo IN 
			(SELECT HeaderCode FROM GroupAllowedHeader 
			WHERE GroupCode = :ai_GroupCode AND Module=:ai_Module)))
"
  arguments=(("ai_srCatCode", number), ("as_Posted", stringlist), ("ai_groupcode", number), ("ai_module", number))
)
