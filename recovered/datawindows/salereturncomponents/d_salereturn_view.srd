 retrieve="SELECT
	srledger.srinvcode ,
	srledger.saleinvcode ,
	srledger.date ,
	srledger.srcatcode ,
	srledger.custcode ,
	srledger.salesmancode ,
	srledger.discperc ,
	srledger.flatdisc ,
	srledger.misccharges ,
	users.username ,
	Saledate=(SELECT SL.Date FROM SaleLedger SL WHERE SL.SaleInvCode=srledger.saleinvcode),
	srledger.headerno ,
	srledger.posted ,
	srledger.postdate ,
	srledger.remarks ,
	accounts.name ,
	customer.address1 ,
	customer.city ,
	customer.phone,
	srledger.originaldate,
	srledger.modifiedby,
	srledger.postedby,
	srledger.invgstperc1,
	srledger.smancode,
	srledger.custrefno,
	srledger.custrefno2,
	srledger.custrefno3,
	srledger.custrefno4 ,
	srledger.patientcode,
	srledger.invtotal,
	srledger.machinename,
	gcode=0,
	srledger.headerinvno,
	regno=space(60),
	aliasname=space(60),
	srledger.admissioncode,
	GuestRegNo=(SELECT G.RegNo FROM Guest G WHERE G.GuestCode=SrLedger.GuestCode),
	SrLedger.GuestCode,
	SrLedger.GuestCheckInCode,
	GuestBalance=0.00,
	StudentRegNo=(SELECT ST.RegNo FROM Student ST WHERE ST.StudentCode=SrLedger.StudentCode),
	SrLedger.StudentCode,
	StudentBalance=0.00,
	Srledger.AccountFor,
	Srledger.PaymentMode,
	Srledger.PaymentAccCode,
	Srledger.Amt,
	Srledger.AmtBy,
	Srledger.AmtDate,
	Srledger.AmtReference,
	Srledger.Outstandingamt,
	Srledger.marked,
	Srledger.PageSize,
	Srledger.ConsiderInPO,
	srledger.CashAccCode,
	srledger.CashTendered,
	srledger.CashCharged,
	srledger.CashBack,
	srledger.CurrencyCode,
	srledger.ConversionRate
FROM 
	accounts,
	customer,
	users,
	srledger
	LEFT OUTER JOIN SalesMan ON (srledger.smancode = salesman.salesmancode)
WHERE 
	( srledger.custcode = customer.custcode ) and 
	( srledger.salesmancode = users.usercode ) and 
	( srledger.custcode = accounts.acccode ) and 
	( dbo.srledger.srinvcode = :ra_saleretinvcode )"
  arguments=(("ra_saleretinvcode", number))
)
