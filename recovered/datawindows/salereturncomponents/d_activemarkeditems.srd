header(height=412 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="Item.ICode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Item.Name"  )
column=(type=char(75) update=yes updatewhereclause=yes name=customicode dbname="Item.CustomICode"  )
column=(type=long update=yes updatewhereclause=yes name=active dbname="Item.Active"  )
 retrieve="SELECT 
	Item.ICode,   
	Item.Name,   
	Item.CustomICode,   
	Item.Active  
FROM Item   
WHERE Item.ICode IN (:ai_icode)
ORDER BY Item.Name"
  update="Item" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_icode", numberlist))
)
