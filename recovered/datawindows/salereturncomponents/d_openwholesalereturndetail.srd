table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(75) update=yes updatewhereclause=yes name=alternatecustomicode dbname="SRdetail.alternatecustomicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(100) update=yes updatewhereclause=yes name=returnitemdescription dbname="SRdetail.returnitemdescription"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=currstock dbname="currstock"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=retableqty dbname="retableqty"  )
column=(type=decimal(4) updatewhereclause=yes name=retablebonusqty dbname="retablebonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=salebonusqty dbname="salebonusqty"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SRdetail.srinvcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes initial="1" name=gcode dbname="SRdetail.gcode" 
 values=""  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="SRdetail.icode"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes validation="gettext()<>''" validationmsg="~"Please type batch number~"" initial="." name=batch dbname="SRdetail.batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes validation="datetime(gettext()) > today()" validationmsg="~"expiry must be greater than today's date~"" name=expiry dbname="SRdetail.expiry"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(gettext()) > 0" validationmsg="~"Quantity should be greater than  0~"" initial="0" name=packqty dbname="SRdetail.packqty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=unitsalestax dbname="SRdetail.unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=gstperc dbname="SRdetail.gstperc"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="SRdetail.packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" name=srprice dbname="SRdetail.srprice"  )
column=(type=decimal(0) key=yes update=yes updatewhereclause=yes name=srutn dbname="SRdetail.srutn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="SRdetail.saleprice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=avgprice dbname="SRdetail.avgprice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=newavgprice dbname="SRdetail.newavgprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=salestax dbname="SRdetail.salestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"discount must be between 0 and 100~"" initial="0" name=discperc dbname="SRdetail.discperc"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=claimable dbname="SRdetail.claimable" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"discount must be between 0 and 100~"" initial="0" name=claimablediscperc dbname="SRdetail.claimablediscperc"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) > 0" validationmsg="~"Please enter valid value for Total Pieces~"" initial="1" name=totalpieces dbname="SRdetail.TotalPieces"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=piecesinhand dbname="SRdetail.PiecesInHand"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=commissionperc dbname="SRdetail.CommissionPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=commissionperunit dbname="SRdetail.CommissionPerUnit"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=alternatepurprice dbname="SRdetail.alternatepurprice"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=taxable dbname="Taxable"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=itemadvancetaxperc dbname="ItemAdvanceTaxPerc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Bonus Qty should be greater or equal to zero~"" initial="0" name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Quantity should be greater or equal to zero~"" initial="1" name=looseqty dbname="SRdetail.looseqty"  )
 retrieve="SELECT
	item.customicode, 
	srdetail.alternatecustomicode,
	item.name, 
	srdetail.returnitemdescription,  
	currlistrow = 0,
	stock = 0.0000, 
	currstock=srdetail.currstock,
	packingdesc=space(50),
	totalstock=0.0000,
	saleqty = 0.0000, 
	retableqty = 0.0000, 
	retablebonusqty = 0.0000, 
	salebonusqty = 0.0000, 
	dbo.srdetail.srinvcode ,
	dbo.srdetail.gcode , 
	dbo.srdetail.icode , 
	dbo.srdetail.batch , 
	dbo.srdetail.expiry , 
	dbo.srdetail.packqty ,
	dbo.srdetail.unitsalestax,
	dbo.srdetail.gstperc,  
	dbo.srdetail.packunits ,  
	dbo.srdetail.srprice ,
	dbo.srdetail.srutn ,
	dbo.srdetail.saleprice,
	dbo.srdetail.avgprice ,
	dbo.srdetail.newavgprice,
	dbo.srdetail.salestax ,
	dbo.srdetail.discperc ,
	dbo.srdetail.claimable,
	dbo.srdetail.claimablediscperc ,
	dbo.srdetail.TotalPieces,
	dbo.srdetail.PiecesInHand,
	srdetail.CommissionPerc,
	srdetail.CommissionPerUnit,
	dbo.srdetail.alternatepurprice,
	Taxable = Item.Taxable,
	ItemAdvanceTaxPerc = srdetail.ItemAdvanceTaxPerc,
	bonusqty=dbo.srdetail.bonusqty,
	dbo.srdetail.looseqty
FROM
	srdetail,   
	item 
WHERE 
	( srdetail.icode = item.icode ) and  
	( dbo.srdetail.srinvcode = :ra_salesretinvno )

	
"
  update="srdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_salesretinvno", number))
)
