table(column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=char(5) updatewhereclause=no name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=decimal(5) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(18) updatewhereclause=yes name=margin dbname="Margin"  )
column=(type=long updatewhereclause=yes name=previousinvcode dbname="PreviousInvCode"  )
column=(type=decimal(18) updatewhereclause=yes name=previousmargin dbname="PreviousMargin"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="ID"  )
 retrieve="SELECT 
	PurInvCode=P.PurInvCode,
	Type = CASE WHEN P.PurCatCode=3 THEN 'OPEN' WHEN P.PurCatCode = 2 THEN 'PACK' ELSE 'LOOSE' END,
	Date = P.Date,
	Supplier = A.Name,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	Qty = (D.LooseQty + D.PackQty),
	BonusQty = D.BonusQty,
	NetRate = D.NetRate,
	SalePrice = D.SalePriceForItem,
	Margin =ROUND( ((D.SalePriceForItem - D.NetRate) / CASE WHEN D.SalePriceForItem=0 THEN 1 ELSE D.SalePriceForItem END)* 100, 2),
	PreviousInvCode=(SELECT MAX(PP.PurInvCode)
			FROM PurLedger PP, PurDetail DD
			WHERE
				PP.Posted = 'Y' AND 
				DD.ICode = D.ICode AND
				PP.PurInvCode=DD.PurInvCode),
	PreviousMargin=(SELECT Margin = MAX(ROUND(((DD.SalePriceForItem - DD.NetRate) / CASE WHEN DD.SalePriceForItem = 0 THEN 1 ELSE DD.SalePriceForItem END) * 100, 2))
			FROM PurLedger PP, PurDetail DD
			WHERE
				PP.Posted = 'Y' AND 
				DD.ICode = D.ICode AND
				PP.PurInvCode=DD.PurInvCode),
	ID=D.PurrowID
FROM
	PurLedger P,
	PurDetail D,
	Item I,
	Accounts A
WHERE 
	P.PurInvCode BETWEEN :al_start AND :al_end AND
	P.PurInvCode = D.PurInvCode AND
	P.Posted = 'N' AND
	D.ICode = I.ICode AND
	P.SuppCode = A.AccCode

"
  arguments=(("al_start", number), ("al_end", number))
 sort="purinvcode A, id A"
 filter=" margin < previousmargin "
 )
