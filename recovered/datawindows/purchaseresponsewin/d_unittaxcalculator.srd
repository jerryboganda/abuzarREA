header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=1180 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="name"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=invpurprice dbname="InvPurPrice"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=invsaleprice dbname="InvSalePrice"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=invunittax dbname="InvUnitTax"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=retailprice dbname="RetailPrice"  )
column=(type=long updatewhereclause=yes initial="1" name=taxtype dbname="TaxType" 
 values="Invoice Purchase Price	1/Invoice Sale Price	2/Invoice Retail Price (Inc. S//Tax)	3/Invoice Retail Price	4/"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=taxperc dbname="taxperc"  )
column=(type=char(20) updatewhereclause=yes name=remarks dbname="remarks"  )
 retrieve="SELECT
	icode=ICode,
	aliasname=CustomICode,
	name=Name,
	InvPurPrice=:ad_price * 1.00,
	InvSalePrice=:ad_saleprice * 1.00,
	InvUnitTax = ROUND(:ad_unittax, 2) * 1.00,
	RetailPrice = :ad_retailprice * 1.00,
	TaxType=1,
	taxperc=0.00,
	remarks=SPACE(20)
FROM Item
WHERE ICode = :al_icode"
  arguments=(("al_icode", number), ("ad_price", number), ("ad_saleprice", number), ("ad_unittax", number), ("ad_retailprice", number))
)
