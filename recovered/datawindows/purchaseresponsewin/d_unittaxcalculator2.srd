table(column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="name"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=unittax dbname="UnitTax"  )
column=(type=decimal(2) updatewhereclause=yes name=totaltax dbname="TotalTax"  )
 retrieve="SELECT
	icode=ICode,
	aliasname=CustomICode,
	name=Name,
	Qty = :ad_qty * 1.0000,
	UnitTax = :ad_unittax * 1.00,
	TotalTax = ROUND(:ad_unittax, 2) * :ad_qty * 1.00
FROM Item
WHERE ICode = :al_icode"
  arguments=(("al_icode", number), ("ad_unittax", number), ("ad_qty", number))
)
