table(column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="itemaliasname"  )
column=(type=char(20) updatewhereclause=yes name=itempacking_name dbname="ItemPacking.Name"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=long updatewhereclause=yes name=purledger_purinvcode dbname="Purledger.Purinvcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=datetime updatewhereclause=yes name=purledger_date dbname="Purledger.Date"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=purdetail_bonusqty dbname="Purdetail.Bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=long updatewhereclause=yes name=purledger_suppcode dbname="Purledger.suppcode"  )
column=(type=char(10) updatewhereclause=yes name=currency dbname="currency"  )
column=(type=decimal(5) updatewhereclause=yes name=conversionfactor dbname="conversionfactor"  )
column=(type=char(12) updatewhereclause=yes name=supplieraliasname dbname="supplieraliasname"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=decimal(2) updatewhereclause=yes name=purdetail_discperc dbname="Purdetail.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=char(100) updatewhereclause=yes name=purtype dbname="purtype"  )
column=(type=char(7) updatewhereclause=yes name=type dbname="type"  )
column=(type=char(100) updatewhereclause=yes name=purdetail_batch dbname="Purdetail.batch"  )
column=(type=datetime updatewhereclause=yes name=purdetail_expiry dbname="Purdetail.expiry"  )
column=(type=decimal(5) updatewhereclause=yes name=foreignprice dbname="foreignprice"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="SalesTax"  )
column=(type=decimal(5) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted" 
 values="Yes	Y/No	N/"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
 retrieve="SELECT
	item.Name,
	itemaliasname=item.Customicode,
	ItemPacking.Name, 
	Item.PackUnits,
	purledger.Purinvcode, 
	remarks=purledger.remarks,
	purledger.Date,
	Qty = purdetail.Looseqty + purdetail.Packqty,
	purdetail.Bonusqty,
	Rate=purdetail.PurPrice,
	dbo.purledger.suppcode,
	currency = (SELECT Currency.shortname FROM Currency WHERE Currency.CurrencyCode = dbo.purledger.conversionfactor),
	conversionfactor=dbo.purledger.conversionfactor,
	supplieraliasname=dbo.accounts.aliasname,		
	dbo.accounts.name,		
	purdetail.discperc,
	invdiscperc=purledger.discperc,
	purtype=(select name from purchasetype where purtypecode=purledger.purtypecode),
	type=CASE 
		when purledger.purcatcode = 1 OR purledger.purcatcode=2 THEN 'PACK'
		when purledger.purcatcode = 7 OR purledger.purcatcode=8 THEN 'LOOSE'
		ELSE 'OPENING' END,
	purdetail.batch,
	purdetail.expiry,
	foreignprice=dbo.purdetail.foreignprice,
	SalesTax=
		(SELECT	SUM((PD.unitsalestax * ( PD.Looseqty + PD.PackQty + PD.bonusqty )) +  
				Round( PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
				(1 - PD.DiscPerc * .01) * 0.01 * PD.gstperc, 2) +
				( Round((Round( Round(PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
				(1 - PD.DiscPerc * .01), 2) * (1 -  PL.discperc * 0.01), 2) - 
				PL.flatdisc) * 0.01 *  PL.invgstperc1 ,2) ) / CASE WHEN (PD.Looseqty + PD.PackQty + PD.bonusqty) = 0 THEN 1 ELSE (PD.Looseqty + PD.PackQty + PD.bonusqty) END)
		FROM PurLedger PL, PurDetail PD
		WHERE PL.PurinvCode = PD.PurInvCode AND PD.purutn = purdetail.purutn),
	NetRate=purdetail.NetRate,
/*		(SELECT NETRATE=(PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
								(1 - PD.DiscPerc * .01) * ( 1 - PL.discperc * .01 ) + 
								(PD.unitsalestax * ( PD.Looseqty + PD.PackQty + PD.bonusqty )) +  
					Round( PD.PurPrice * (PD.LooseQty + PD.PackQty) * (1 - PD.DiscPerc * .01) * 0.01 * PD.gstperc, 2) +
						( Round((
							Round( 
								Round(PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
									(1 - PD.DiscPerc * .01),2) * 
									(1 -  PL.discperc * 0.01),2) - PL.flatdisc) * 0.01 *  
									PL.invgstperc1 ,2)) ) /
								CASE WHEN (PD.Looseqty + PD.PackQty + PD.bonusqty) = 0 THEN 1 ELSE (PD.Looseqty + PD.PackQty + PD.bonusqty) END
		FROM PurLedger PL, PurDetail PD
		WHERE PL.PurinvCode = PD.PurInvCode AND PD.purutn = purdetail.purutn),*/
	Posted=Purledger.Posted,
	UserName = (select u.username from users u where u.usercode=purledger.salesmancode)
FROM
	Item
	LEFT OUTER JOIN ItemPacking ON (Item.Packcode = ItemPacking.Packcode),
	purledger,
	accounts,
	purdetail

WHERE 
	(Item.icode = :ar_icode ) and
	( dbo.purdetail.icode = :ar_icode) and 
    (dbo.purdetail.Purinvcode=dbo.purledger.Purinvcode) and 
    (dbo.purledger.Suppcode=dbo.accounts.acccode)
			
UNION
SELECT
	item.Name,
	itemaliasname=item.Customicode,
	ItemPacking.Name, 
	Item.PackUnits,
	purledger.Purinvcode, 
	remarks=purledger.remarks,
	purledger.Date,
	Qty = purdetail.Looseqty + purdetail.Packqty,
	purdetail.Bonusqty,
	Rate=purdetail.PurPrice,
	purledger.suppcode,
	currency = (SELECT Currency.shortname FROM Currency WHERE Currency.CurrencyCode = purledger.conversionfactor),
	conversionfactor=purledger.conversionfactor,
	supplieraliasname=accounts.aliasname,		
	dbo.accounts.name,		
	purdetail.discperc,
	invdiscperc=purledger.discperc,
	purtype=(select name from purchasetype where purtypecode=purledger.purtypecode),
	type=CASE 
		when purledger.purcatcode = 1 OR purledger.purcatcode=2 THEN 'PACK'
		when purledger.purcatcode = 7 OR purledger.purcatcode=8 THEN 'LOOSE'
		ELSE 'OPENING' END,
	purdetail.batch,
	purdetail.expiry,
	foreignprice=purdetail.foreignprice,
	SalesTax=
		(SELECT	SUM((PD.unitsalestax * ( PD.Looseqty + PD.PackQty + PD.bonusqty )) +  
				Round( PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
				(1 - PD.DiscPerc * .01) * 0.01 * PD.gstperc, 2) +
				( Round((Round( Round(PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
				(1 - PD.DiscPerc * .01), 2) * (1 -  PL.discperc * 0.01), 2) - 
				PL.flatdisc) * 0.01 *  PL.invgstperc1 ,2) ) / CASE WHEN (PD.Looseqty + PD.PackQty + PD.bonusqty) = 0 THEN 1 ELSE (PD.Looseqty + PD.PackQty + PD.bonusqty) END)
		FROM PurLedgerMod PL, PurDetailMod PD
		WHERE PL.PurinvCode = PD.PurInvCode AND PD.purutn = purdetail.purutn),
	NetRate=purdetail.NetRate,
		/*(SELECT NETRATE=(PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
								(1 - PD.DiscPerc * .01) * ( 1 - PL.discperc * .01 ) + 
								(PD.unitsalestax * ( PD.Looseqty + PD.PackQty + PD.bonusqty )) +  
					Round( PD.PurPrice * (PD.LooseQty + PD.PackQty) * (1 - PD.DiscPerc * .01) * 0.01 * PD.gstperc, 2) +
						( Round((
							Round( 
								Round(PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
									(1 - PD.DiscPerc * .01),2) * 
									(1 -  PL.discperc * 0.01),2) - PL.flatdisc) * 0.01 *  
									PL.invgstperc1 ,2)) ) /
								CASE WHEN (PD.Looseqty + PD.PackQty + PD.bonusqty) = 0 THEN 1 ELSE (PD.Looseqty + PD.PackQty + PD.bonusqty) END
		FROM PurLedgerMod PL, PurDetailMod PD
		WHERE PL.PurinvCode = PD.PurInvCode AND PD.purutn = purdetail.purutn),*/
	Posted=Purledger.Posted,
	UserName = (select u.username from users u where u.usercode=purledger.salesmancode)
FROM
	Item
	LEFT OUTER JOIN ItemPacking ON (Item.Packcode = ItemPacking.Packcode),
	purledgermod purledger,
	accounts,
	purdetailmod purdetail

WHERE 
	(Item.icode = :ar_icode ) and
	( purdetail.icode = :ar_icode) and 
    (purdetail.Purinvcode=purledger.Purinvcode) and 
    (purledger.Suppcode=accounts.acccode)


ORDER BY
	date desc,
	purledger.Purinvcode,
	accounts.name,
	purledger.conversionfactor,
	purdetail.batch,
	purdetail.expiry,
	purdetail.foreignprice
"
  arguments=(("ar_icode", number))
)
