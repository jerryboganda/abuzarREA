table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Item.ICode"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="Item.CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Item.Name"  )
column=(type=long updatewhereclause=yes validation="  real(gettext()) > 0 " initial="1" name=packunits dbname="Item.PackUnits"  )
column=(type=long updatewhereclause=yes initial="1" name=active dbname="Item.Active" 
 values="Yes	1/No	0/"  )
column=(type=char(255) updatewhereclause=yes name=localitemname dbname="Item.LocalItemName"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=purprice dbname="Item.PurPrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="  real(gettext()) >= 0 " validationmsg="~"Sale Price should be greater than 0~"" initial="0" name=saleprice dbname="Item.SalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=saleprice2 dbname="Item.saleprice2"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=saleprice3 dbname="Item.saleprice3"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="  real(gettext()) >= 0 " initial="0" name=retailprice dbname="Item.RetailPrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=saleprice4 dbname="Item.saleprice4"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=saleprice5 dbname="Item.saleprice5"  )
column=(type=char(100) update=yes updatewhereclause=yes name=changereason dbname="Item.changereason"  )
column=(type=char(100) update=yes updatewhereclause=yes name=module dbname="Item.module"  )
 retrieve="SELECT
	Item.ICode,   
	Item.CustomICode,   
	Item.Name,   
	Item.PackUnits,   
	Item.Active,   
	Item.LocalItemName,
	Item.PurPrice,   
	Item.SalePrice,   
	Item.saleprice2,
	Item.saleprice3,
	Item.RetailPrice,   
	item.saleprice4,
	item.saleprice5,
	item.changereason,
	item.module
FROM
	Item  
WHERE 
	Item.ICode = :ar_icode

"
  update="Item" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_icode", number))
)
