header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=long updatewhereclause=yes name=recurringperiod dbname="RecurringPeriod"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="DueDate"  )
column=(type=long updatewhereclause=yes name=lastrecurringinvcode dbname="LastRecurringInvCode"  )
 retrieve="SELECT 
	SaleInvCode = S.SaleInvCode,
	Date = 	S.Date,
	PatientCode = S.PatientCode,
	PatientRegNo = P.RegNo,
	PatientName = P.Name,
	InvTotal = S.InvTotal,
	RecurringPeriod = S.RecurringPeriod,
	DueDate=S.Date+S.RecurringPeriod,
	LastRecurringInvCode = S.LastRecurringInvCode
FROM 
	SaleLedger S, Patient P
WHERE 
	S.PatientCode = :ai_patientcode AND
	S.RecurringInvoice='Y' AND 
	S.PatientCode = P.PatientCode
ORDER BY
	S.SaleInvCode"
  arguments=(("ai_patientcode", number))
)
