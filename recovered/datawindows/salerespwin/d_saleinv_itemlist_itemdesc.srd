release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=customicode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) update=yes updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="Saledetail.saleinvcode"  )
column=(type=long updatewhereclause=yes name=icode dbname="Saledetail.icode"  )
column=(type=long updatewhereclause=yes name=rowgroup dbname="Saledetail.rowgroup"  )
column=(type=long updatewhereclause=yes name=gcode dbname="Saledetail.gcode"  )
column=(type=long updatewhereclause=yes name=saleorderrowid dbname="Saledetail.saleorderrowid"  )
 retrieve="    SELECT item.customicode, 
			itemname= item.name, 
			SaleItemDescription =  max( saledetail.SaleItemDescription),
			bonusqty  = sum(saledetail.bonusqty),			
			looseqty  = sum(saledetail.looseqty),
			saledetail.saleinvcode,
			saledetail.icode,
			saledetail.rowgroup,
			saledetail.gcode, 
			saledetail.saleorderrowid

    FROM saledetail,   
         item 

   WHERE ( dbo.saledetail.saleinvcode = :ar_SaleInvCode )    AND
		   ( saledetail.icode = item.icode )
         
GROUP BY saledetail.saleinvcode, 
			saledetail.icode, 
			saledetail.rowgroup,
			saledetail.gcode, 
			saledetail.saleorderrowid,
			item.customicode, 
			item.saleqty,
			item.bonusqty,
			item.name,
			item.locksaleprice,
		   item.lockdiscperc,
			item.retailprice,
			item.packingdesc

ORDER BY MIN(saledetail.IDENTITYCOL)"
  arguments=(("ar_SaleInvCode", number))
)
