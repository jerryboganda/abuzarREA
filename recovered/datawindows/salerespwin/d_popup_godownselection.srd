release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Godown.GCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Godown.Name"  )
column=(type=long updatewhereclause=yes name=qty dbname="Qty"  )
 retrieve="SELECT
	G.GCode, 
	G.Name, 
	Qty = Sum(GD.CurrQty)
FROM	Godown G, GodownDetail GD
WHERE	G.GCode IN
	(CASE :ai_strategy
	WHEN 2 THEN (SELECT DISTINCT GG.GCode From Godown GG WHERE G.Gcode = GG.GCode)
	ELSE (SELECT DISTINCT GA.GCode From GroupAllowedGodown GA
		WHERE	GA.GroupCode = :ai_groupcode AND
			GA.Module = :ai_module AND
			GA.GCode = G.GCode) END) AND
	GD.GCode = G.GCode AND
	GD.ICode = :ai_icode
GROUP BY
	G.GCode,
	G.Name
ORDER BY
	Qty,
	G.Name"
  arguments=(("ai_icode", number), ("ai_strategy", number), ("ai_groupcode", number), ("ai_module", number))
)
