detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="RefusedSaleDetail.RefusedSaleInvCode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=reasoncode dbname="ReasonCode" 
 values=""  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=unknownitemname dbname="UnknownItemName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=totalstock dbname="TotalStock"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0" initial="0" name=saleprice dbname="RefusedSaleDetail.SalePrice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0" initial="1" name=qty dbname="Qty"  )
 retrieve="SELECT 
	FullCode=CASE RefusedSaleDetail.ICODE WHEN NULL THEN NULL
				ELSE (SELECT Item.CustomICode FROM ITEM WHERE Item.ICode = RefusedSaleDetail.ICode) END,
	ItemName=CASE WHEN RefusedSaleDetail.ICODE IS NULL THEN RefusedSaleDetail.UnknownItemName
				ELSE (SELECT Item.Name FROM ITEM WHERE Item.ICode = RefusedSaleDetail.ICode) END,
	CurrListRow=0, 
	ItemCode=0,
	RefusedSaleDetail.RefusedSaleInvCode,   
	ReasonCode=RefusedSaleDetail.ReasonCode,   
	ICode=RefusedSaleDetail.ICode,   
	UnknownItemName=RefusedSaleDetail.UnknownItemName,   
	Remarks=RefusedSaleDetail.Remarks,   
	TotalStock=RefusedSaleDetail.TotalStock,   
	RowID=RefusedSaleDetail.RowID,
	RefusedSaleDetail.SalePrice,
	Qty=RefusedSaleDetail.Qty
FROM 
	RefusedSaleDetail
WHERE 
	RefusedSaleDetail.RefusedSaleInvCode = :ai_code
ORDER BY
	RefusedSaleDetail.RefusedSaleInvCode,   
	RefusedSaleDetail.RowID
	"
  update="RefusedSaleDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
