table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long key=yes updatewhereclause=yes name=saleinvcode dbname="Saledetail.SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleLedger.Date"  )
column=(type=long updatewhereclause=yes name=icode dbname="Saledetail.ICode"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Saledetail.Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Saledetail.Expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="Saledetail.LooseQty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="Saledetail.BonusQty"  )
column=(type=decimal(2) updatewhereclause=yes name=oldprice dbname="OldPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=olddiscperc dbname="OldDiscperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Please enter valid sale price~"" initial="0" name=saleprice dbname="Saledetail.SalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100" validationmsg="~"Please enter valid discount percentage. Valid range [0.00-100.00]~"" initial="0" name=discperc dbname="Saledetail.Discperc"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="Saledetail.RowID"  )
 retrieve="SELECT 
	AliasName=Accounts.AliasName,
	Customer=Accounts.Name,
	SaleDetail.SaleInvCode,
	SaleLedger.Date,
	SaleDetail.ICode,
	CustomICode = I.CustomICode,
	ItemName = I.Name,
	SaleDetail.Batch,
	SaleDetail.Expiry,
	SaleDetail.LooseQty,
	SaleDetail.BonusQty,
	OldPrice=SaleDetail.SalePrice,
	OldDiscperc=SaleDetail.Discperc,
	SaleDetail.SalePrice,
	SaleDetail.Discperc,
	SaleDetail.RowID
FROM
	Accounts, SaleLedger, SaleDetail, Item I
WHERE
	SaleLedger.Posted = 'N' AND
	SaleDetail.SaleInvCode BETWEEN :ai_sinvcode AND :ai_linvcode AND
	SaleLedger.CustCode = CASE WHEN :ai_allcustomer = 1 THEN SaleLedger.CustCode ELSE :ai_custcode END AND
	SaleLedger.CustCode = Accounts.AccCode AND
	SaleLedger.SaleInvCode=SaleDetail.SaleInvCode AND
	SaleDetail.ICode = :ai_icode AND
	SaleDetail.ICode = I.ICode
ORDER BY
	Customer,
	SaleDetail.SaleInvCode,	
	SaleDetail.RowID"
  update="SaleDetail" updatewhere=0 updatekeyinplace=yes
  arguments=(("ai_allcustomer", number), ("ai_custcode", number), ("ai_sinvcode", number), ("ai_linvcode", number), ("ai_icode", number), ("ad_saleprice", number), ("ad_discperc", number))
)
