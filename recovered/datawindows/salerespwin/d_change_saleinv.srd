table(column=(type=long key=yes updatewhereclause=yes name=saleinvcode dbname="SaleLedger.saleinvcode"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="SaleLedger.headerinvno"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="SaleLedger.remarks"  )
column=(type=long update=yes updatewhereclause=yes name=custcode dbname="SaleLedger.custcode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=custrefno dbname="SaleLedger.custrefno"  )
column=(type=char(100) update=yes updatewhereclause=yes name=custrefno2 dbname="SaleLedger.custrefno2"  )
column=(type=char(100) update=yes updatewhereclause=yes name=custrefno3 dbname="SaleLedger.custrefno3"  )
column=(type=char(100) update=yes updatewhereclause=yes name=custrefno4 dbname="SaleLedger.custrefno4"  )
column=(type=datetime updatewhereclause=yes name=originaldate dbname="SaleLedger.originaldate"  )
column=(type=datetime updatewhereclause=yes name=lastsavingdate dbname="SaleLedger.date"  )
column=(type=datetime update=yes updatewhereclause=yes name=billingdate dbname="SaleLedger.billingdate"  )
column=(type=datetime update=yes updatewhereclause=yes name=duedate dbname="SaleLedger.duedate"  )
column=(type=long update=yes updatewhereclause=yes name=saletypecode dbname="SaleLedger.saletypecode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=deliveredby dbname="SaleLedger.deliveredby" 
 values=""  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="SaleLedger.invtotal"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=unreceivedbalance dbname="SaleLedger.unreceivedbalance"  )
column=(type=char(1) update=yes updatewhereclause=yes name=invoicesize dbname="SaleLedger.invoicesize" 
 values="Quarter	Q/Half	H/Full	F/Thermal	T/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=recurringinvoice dbname="SaleLedger.recurringinvoice" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Please Enter Valid Period in Days'" initial="0" name=recurringperiod dbname="SaleLedger.recurringperiod"  )
column=(type=char(1) update=yes updatewhereclause=yes name=printwaranty dbname="SaleLedger.printwaranty" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=printbatch dbname="SaleLedger.printbatch" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="SaleLedger.patientcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=relationcode dbname="SaleLedger.relationcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=diseasecode dbname="SaleLedger.diseasecode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=wardcode dbname="SaleLedger.wardcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=doctcode dbname="SaleLedger.doctcode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes name=paid dbname="SaleLedger.paid" 
 values="Yes	Y/No	N/"  )
 retrieve="  SELECT saleinvcode,
			headerinvno,
			saleledger.remarks,
			saleledger.custcode,
			custrefno,
			custrefno2,
			custrefno3,
			custrefno4,
			originaldate,
			date,
			billingdate,
			duedate,
			saletypecode,
			deliveredby,
			invtotal,
			unreceivedbalance,
			invoicesize,
			recurringinvoice,
			recurringperiod,
			printwaranty,
			printbatch,
			patientcode,
		   relationcode,
			diseasecode,
			wardcode,
			doctcode,
			paid

  FROM 	saleledger, accounts

  WHERE 
			:ai_period = 1 AND
			saleledger.custcode = CASE :ai_all WHEN 0 THEN :al_custcode ELSE saleledger.custcode END AND
			saleledger.originaldate BETWEEN :ad_sdate AND :ad_edate AND
			saleledger.custcode = accounts.acccode
UNION
  SELECT saleinvcode,
			headerinvno,
			saleledger.remarks,
			saleledger.custcode,
			custrefno,
			custrefno2,
			custrefno3,
			custrefno4,
			originaldate,
			date,
			billingdate,
			duedate,
			saletypecode,
			deliveredby,
			invtotal,
			unreceivedbalance,
			invoicesize,
			recurringinvoice,
			recurringperiod,
			printwaranty,
			printbatch,
			patientcode,
		   relationcode,
			diseasecode,
			wardcode,
			doctcode,
			paid

  FROM 	saleledger, accounts

  WHERE 
			:ai_period = 2 AND
			saleledger.custcode = CASE :ai_all WHEN 0 THEN :al_custcode ELSE saleledger.custcode END AND
			saleledger.saleinvcode BETWEEN :ai_sinvcode AND :ai_linvcode AND
			saleledger.custcode = accounts.acccode
"
  update="saleledger" updatewhere=2 updatekeyinplace=yes
  arguments=(("ai_all", number), ("al_custcode", number), ("ai_period", number), ("ad_sdate", datetime), ("ad_edate", datetime), ("ai_sinvcode", number), ("ai_linvcode", number))
)
