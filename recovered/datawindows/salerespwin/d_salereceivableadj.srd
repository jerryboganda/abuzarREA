detail(height=76 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SaleReceivableAdj.SaleInvCode"  )
column=(type=char(12) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="accountname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=acccode dbname="SaleReceivableAdj.AccCode"  )
column=(type=char(20) update=yes updatewhereclause=yes name=checkno dbname="SaleReceivableAdj.CheckNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="SaleReceivableAdj.Remarks"  )
column=(type=long key=yes identity=yes updatewhereclause=yes name=rowid dbname="SaleReceivableAdj.ROWID"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=debit dbname="SaleReceivableAdj.Debit"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=credit dbname="SaleReceivableAdj.Credit"  )
column=(type=char(1) updatewhereclause=yes initial="D" name=treatment dbname="Treatment" 
 values="Increase	I/Decrease	D/"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) > 0" initial="1" name=amount dbname="Amount"  )
 retrieve="SELECT  
	SaleReceivableAdj.SaleInvCode,
	fullcode=dbo.accounts.AliasName,
	accountname=dbo.accounts.Name,
	CurrListRow=0,
	SaleReceivableAdj.AccCode,
	SaleReceivableAdj.CheckNo,
	SaleReceivableAdj.Remarks,
	SaleReceivableAdj.ROWID,
	SaleReceivableAdj.Debit,
	SaleReceivableAdj.Credit,
	Treatment=CASE WHEN SaleReceivableAdj.Credit > 0 THEN 'I' ELSE 'D' END,
	Amount = CASE WHEN SaleReceivableAdj.Debit > 0 THEN SaleReceivableAdj.Debit ELSE SaleReceivableAdj.Credit END
FROM
	SaleReceivableAdj,
	Accounts
WHERE
	SaleReceivableAdj.SaleInvCode = :Code AND
	SaleReceivableAdj.Acccode = Accounts.acccode
ORDER BY
	SaleReceivableAdj.ROWID
"
  update="SaleReceivableAdj" updatewhere=1 updatekeyinplace=yes
  arguments=(("code", number))
)
