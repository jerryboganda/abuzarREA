 retrieve="SELECT
	customer=(select name from accounts where acccode=saleledger.custcode),
	saleinvcode=saleledger.saleinvcode,
	duedate=saleledger.duedate
FROM
	saleledger
WHERE saleinvcode=:ar_saleinvcode"
  update="saleledger" updatewhere=2 updatekeyinplace=yes
  arguments=(("ar_saleinvcode", number))
)
