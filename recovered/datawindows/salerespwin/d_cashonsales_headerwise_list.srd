table(column=(type=long updatewhereclause=yes name=headerinvno dbname="SaleLedger.headerinvno"  )
column=(type=long updatewhereclause=yes name=code dbname="SaleLedger.saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleLedger.date"  )
column=(type=long updatewhereclause=yes name=headerno dbname="SaleLedger.headerno"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="SaleLedger.custrefno"  )
column=(type=char(100) updatewhereclause=yes name=custrefno2 dbname="SaleLedger.custrefno2"  )
column=(type=char(100) updatewhereclause=yes name=custrefno3 dbname="SaleLedger.custrefno3"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SaleLedger.remarks"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=user dbname="Users.username"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=long updatewhereclause=yes name=reprintingcounter dbname="SaleLedger.ReprintingCounter"  )
column=(type=datetime updatewhereclause=yes name=originaldate dbname="SaleLedger.OriginalDate"  )
column=(type=long updatewhereclause=yes name=modifycounter dbname="SaleLedger.ModifyCounter"  )
column=(type=decimal(2) updatewhereclause=yes name=amt dbname="amt"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="balance"  )
 retrieve="SELECT	
	saleledger.headerinvno,
	saleledger.saleinvcode , 
	saleledger.date , 
	saleledger.headerno,
	saleledger.custrefno, 
	saleledger.custrefno2, 
	saleledger.custrefno3, 
	saleledger.remarks , 
	accounts.name,
	users.username, 
	ModifiedBy = IsNull((Select username from users 
								where dbo.saleledger.modifiedby = dbo.users.usercode), ''),
	NetAmount = saleledger.invtotal,
	dbo.saleledger.ReprintingCounter,
	dbo.saleledger.OriginalDate,
	dbo.saleledger.ModifyCounter,
	amt=dbo.saleledger.amt,
	balance=ISNULL(CASE WHEN dbo.saleledger.invtotal - dbo.saleledger.amt > 0 THEN dbo.saleledger.invtotal - dbo.saleledger.amt ELSE 0 END, 0)

FROM  accounts, saleledger, users
WHERE	dbo.saleledger.custcode = dbo.accounts.acccode and 
      dbo.saleledger.salecatcode IN (2) And
		dbo.saleledger.salesmancode = dbo.users.usercode   and
		dbo.SaleLedger.AccountFor = 'Y' AND
		dbo.SaleLedger.Posted = 'N' AND
		dbo.SaleLedger.Deleted = 'N' AND
		dbo.saleledger.headerno in 
						(SELECT headercode FROM GroupAllowedHeader 
						WHERE GroupCode = :ai_groupcode and module = :ai_module)
order by saleledger.saleinvcode
"
  arguments=(("ai_groupcode", number), ("ai_module", number))
 sort="code A"
)
