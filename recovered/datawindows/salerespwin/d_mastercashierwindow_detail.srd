release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=92 color="536870912" )
summary(height=88 color="536870912" )
footer(height=0 color="536870912" )
detail(height=88 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=documentcode dbname="MasterCashWin.DocumentCode"  )
column=(type=char(2) key=yes update=yes updatewhereclause=yes name=documenttype dbname="MasterCashWin.DocumentType"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=acccode dbname="MasterCashWin.AccCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="MasterCashWin.date"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="MasterCashWin.Remarks"  )
column=(type=long updatewhereclause=yes name=rowid dbname="MasterCashWin.RowID"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid amount'" initial="0" name=amount dbname="MasterCashWin.Amount"  )
 retrieve="SELECT 
	MasterCashWin.DocumentCode,
	MasterCashWin.DocumentType,
	MasterCashWin.AccCode,
	MasterCashWin.date,
	MasterCashWin.Remarks,
	MasterCashWin.RowID,
	MasterCashWin.Amount
FROM MasterCashWin
WHERE 
	MasterCashWin.DocumentCode = :ai_code AND MasterCashWin.DocumentType = :as_type
ORDER BY
	MasterCashWin.DocumentType,   
	MasterCashWin.DocumentCode,   
	MasterCashWin.RowID
"
  update="MasterCashWin" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number), ("as_type", string))
)
