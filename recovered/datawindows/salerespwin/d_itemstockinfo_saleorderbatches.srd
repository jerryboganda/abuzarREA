table(column=(type=char(100) updatewhereclause=yes name=batch dbname="GodownDetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="GodownDetail.expiry"  )
column=(type=long updatewhereclause=yes name=priority dbname="GodownDetail.priority"  )
column=(type=datetime updatewhereclause=yes name=manfdate dbname="GodownDetail.manfdate"  )
column=(type=decimal(4) updatewhereclause=yes name=currqty dbname="GodownDetail.Currqty"  )
 retrieve="select   batch, expiry, priority, manfdate, Currqty
from     godowndetail
where    
			LTRIM(RTRIM(STR(:al_saleordercode, 12))) = LEFT(batch, LEN(LTRIM(RTRIM(STR(:al_saleordercode, 12))))) AND
			godowndetail.gcode = :al_gcode and
			godowndetail.icode = :al_icode 
order by priority, 
			expiry, 
			Currqty"
  arguments=(("al_saleordercode", number), ("al_gcode", number), ("al_icode", number))
)
