table(column=(type=long updatewhereclause=yes name=code dbname="Item.icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Item.name"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="Item.manfcode"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Item.packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="Item.purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Item.saleprice"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.name"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=sstock dbname="sstock"  )
column=(type=decimal(4) updatewhereclause=yes name=pstock dbname="pstock"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(1) updatewhereclause=yes name=restricted dbname="Item.restricted"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="Item.icatcode"  )
column=(type=long updatewhereclause=yes name=iccode dbname="Item.iccode"  )
column=(type=long updatewhereclause=yes name=packcode dbname="Item.packcode"  )
column=(type=long updatewhereclause=yes name=isizecode dbname="Item.isizecode"  )
column=(type=long updatewhereclause=yes name=istylecode dbname="Item.istylecode"  )
column=(type=long updatewhereclause=yes name=icolourcode dbname="Item.icolourcode"  )
column=(type=long updatewhereclause=yes name=iyarncode dbname="Item.iyarncode"  )
column=(type=long updatewhereclause=yes name=isleevecode dbname="Item.isleevecode"  )
column=(type=long updatewhereclause=yes name=ifabriccode dbname="Item.ifabriccode"  )
column=(type=long updatewhereclause=yes name=ibrandcode dbname="Item.ibrandcode"  )
column=(type=long updatewhereclause=yes name=ipartcode dbname="Item.ipartcode"  )
column=(type=long updatewhereclause=yes name=masteripartcode dbname="MasterIPartCode"  )
column=(type=long updatewhereclause=yes name=oldpartcode dbname="Item.oldpartcode"  )
column=(type=long updatewhereclause=yes name=genericcode dbname="Item.genericcode"  )
column=(type=char(100) updatewhereclause=yes name=colname dbname="COLNAME"  )
column=(type=char(100) updatewhereclause=yes name=location dbname="Item.location"  )
 retrieve="SELECT 
	dbo.item.icode,
	dbo.item.customicode,
	dbo.item.name,
	dbo.item.manfcode, 
	dbo.item.packunits,
	dbo.item.purprice,
	dbo.item.saleprice,
	dbo.Manufacturer.name,
	stock = 0.0000,
	sstock = 0.0000,
	pstock= 0.0000,
	Packing = dbo.itempacking.name,
	packingdesc=item.packingdesc,
	dbo.item.restricted,
	dbo.item.icatcode,
	dbo.item.iccode,
	dbo.item.packcode,
	dbo.item.isizecode,
	dbo.item.istylecode,
	dbo.item.icolourcode,
	dbo.item.iyarncode,
	dbo.item.isleevecode,
	dbo.item.ifabriccode,
	dbo.item.ibrandcode,
	dbo.item.ipartcode,
	MasterIPartCode = (SELECT IP.MasterIPartCode from ItemPart IP WHERE IP.IPartCode = dbo.item.ipartcode),
	dbo.item.oldpartcode,
	dbo.item.genericcode,
	COLNAME = (SELECT TOP 1 colname 
				FROM InterfaceSetting 
				WHERE WinType=5 AND ModuleID=1 AND Visibility = 1
				ORDER BY SequenceID, ColCaption),
	dbo.item.location
FROM	
	dbo.item
	LEFT OUTER JOIN dbo.itempacking ON (dbo.item.packcode = dbo.itempacking.packcode), 
	dbo.Manufacturer
WHERE	dbo.item.icode = :ai_icode AND 
		dbo.item.Active = 1 and
		dbo.Manufacturer.manfcode = dbo.item.manfcode
ORDER BY dbo.item.name
"
  arguments=(("ai_icode", number))
)
