datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=252 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(12) updatewhereclause=yes name=custaliasname dbname="CustAliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="SoldQty"  )
column=(type=decimal(2) updatewhereclause=yes name=lastsaleprice dbname="LastSalePrice"  )
column=(type=decimal(6) updatewhereclause=yes name=avgsaleprice dbname="AvgSalePrice"  )
 retrieve="SELECT 
	CustCode=A.AccCode,
	CustAliasName=A.AliasName,
	Customer=A.Name,
	ItemCode=SD.ICode, 
	AliasName=I.CustomICode,
	ItemName=I.Name, 
	Packing=(SELECT IP.Name FROM ItemPacking IP WHERE IP.PackCode=I.Packcode),
	Manufacturer=M.Name,
	SoldQty=SUM(SD.LooseQty),
	LastSalePrice=(SELECT MAX(SalePrice) FROM SaleDetail D WHERE SD.ICode = D.ICode AND MAX(SD.SaleUtn) = D.SaleUtn),
	AvgSalePrice=AVG(SD.SalePrice)
FROM
	Accounts A,
	SaleLedger SL, 
	SaleDetail SD, 
	Item I,
	Manufacturer M
WHERE
	A.AccCode = :ai_custcode AND
	SL.CustCode = :ai_custcode AND
	A.AccCode = SL.CustCode AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SD.ICode = I.ICode AND
	I.ManfCode = M.ManfCode
GROUP BY
	A.AccCode,
	A.AliasName,
	A.Name,
	SD.ICode,
	I.CustomICode,
	I.Name,
	I.PackCode,
	M.Name 
ORDER BY 
	SoldQty DESC"
  arguments=(("ai_custcode", number))
)
