table(column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="CustomerAlias"  )
column=(type=char(100) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=long updatewhereclause=yes name=loyaltypointsbalance dbname="LoyaltyPointsBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=loyaltypointsvalue dbname="LoyaltyPointsValue"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="Item.ICode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100" validationmsg="~"Please enter valid percentage [0-100]~"" initial="0" name=redemptiondiscperc dbname="RedemptionDiscPerc"  )
 retrieve="SELECT 
	CustCode = 0,
	CustomerAlias = SPACE(12),
	CustomerName = SPACE(100),
	LoyaltyPointsBalance = 0,
	LoyaltyPointsValue = 0.00,
	ICode,
	FullCode = CustomICode,
	ItemName=Name,
	Qty = 0.0000,
	BonusQty=0.0000,
	SalePrice=SalePrice,
	DiscPerc = 0.00,
	RedemptionDiscPerc=Item.RedemptionDiscPerc
FROM
	Item
WHERE 
	ICode < 0"
  update="Item" updatewhere=1 updatekeyinplace=no
 )
