release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="code"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="purinvcode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="name"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Purdetail.batch"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
 retrieve="select code=PD.icode,
	aliasname=(select customicode from item where Item.icode=PD.icode),
	purinvcode=PD.purinvcode,
	name=(select name from item where Item.icode=PD.icode),
	PD.batch,
	purprice=PD.purprice,
	saleprice=PD.salepriceforitem,
	stock=(select sum(currqty) from godowndetail where icode=PD.icode and batch like :as_batch)
from purledger PL ,purdetail PD
where PL.posted='Y' AND
		PL.purinvcode=PD.purinvcode and
		PD.icode=:ai_icode and
		PD.batch like :as_batch"
  arguments=(("as_batch", string), ("ai_icode", number))
)
