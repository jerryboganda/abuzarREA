detail(height=84 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=saleinvcode dbname="SaleLedger.SaleInvCode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="SaleLedger.HeaderNo" 
 values=""  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="SaleLedger.HeaderInvNo"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="SaleLedger.Date"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=invtotal dbname="SaleLedger.InvTotal"  )
column=(type=char(60) update=yes updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SaleLedger.Remarks"  )
column=(type=char(1) updatewhereclause=yes name=selected dbname="SELECTED" 
 values="	Y/	N"  )
column=(type=char(1) updatewhereclause=yes name=impactinventory dbname="SaleLedger.ImpactInventory"  )
column=(type=char(1) update=yes updatewhereclause=yes name=status dbname="Status" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	SL.SaleInvCode, 
	SL.HeaderNo, 
	SL.HeaderInvNo, 
	SL.Date, 
	SL.InvTotal, 
	UserName=(SELECT users.username FROM users where users.usercode = SL.SalesManCode),
	SL.Remarks,
	SELECTED='N',
	SL.ImpactInventory,
	Status=CASE (SELECT Count(d.sourcesaleinvcode) FROM saleinvdetail d WHERE d.sourcesaleinvcode = SL.SALEINVCODE) 
				WHEN NULL THEN 'N' 
				WHEN 0 THEN 'N' 
				ELSE 'Y' END,
	Posted=SL.Posted

FROM
	SaleLedger SL
WHERE 
	SL.CustCode = :ai_custcode AND
	SL.HeaderNo = :ai_headerno
ORDER BY
	SL.HeaderNo, 
	SL.HeaderInvNo, 
	SL.SaleInvCode"
  update="SaleLedger" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_headerno", number), ("ai_custcode", number))
 sort="saleinvcode A, date A"
)
