release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80269524 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=128 color="536870912" )
summary(height=0 color="536870912" )
footer(height=76 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SaleInvCode"  )
column=(type=long update=yes updatewhereclause=yes name=headerinvno dbname="HeaderInvNo"  )
column=(type=long update=yes updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=decimal(2) updatewhereclause=yes name=oldamt dbname="OldAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=amt dbname="Amt"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="C" name=paymentmode dbname="PaymentMode" 
 values="Cash	C/Cheque	B/"  )
column=(type=long update=yes updatewhereclause=yes initial="2" name=paymentacccode dbname="PaymentAccCode"  )
column=(type=char(60) updatewhereclause=yes name=ddd_acccode dbname="ddd_AccCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=amtdate dbname="AmtDate"  )
column=(type=char(20) update=yes updatewhereclause=yes name=amtreference dbname="AmtReference"  )
column=(type=long update=yes updatewhereclause=yes name=amtby dbname="AmtBy"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=outstandingamt dbname="OutStandingAmt"  )
 retrieve="SELECT
	SaleInvCode=S.SaleInvCode,
	HeaderInvNo=S.HeaderInvNo,
	HeaderNo=S.HeaderNo,
	Date=S.Date,
	AliasName=A.AliasName,
	AccountName=A.Name,
	InvTotal=ISNULL(S.InvTotal, 0),
	OldAmt=ISNULL(S.Amt, 0),
	Amt=ISNULL(S.Amt, 0),
	PaymentMode=S.PaymentMode,
	PaymentAccCode=S.PaymentAccCode,
	ddd_AccCode=(SELECT A.Name FROM Accounts A WHERE A.AccCode = S.PaymentAccCode),
	AmtDate=S.AmtDate,
	AmtReference=S.AmtReference,
	AmtBy=S.AmtBy,
	OutStandingAmt=S.OutStandingAmt
	
FROM SaleLedger S WITH (READPAST, ROWLOCK, UPDLOCK), Accounts A
WHERE
	S.AccountFor = 'Y' AND 
	S.Posted = 'N' AND 
	S.Deleted='N' AND
	S.CustCode = A.AccCode AND
	S.SaleCatCode = 2 AND 
	S.HeaderNo IN (SELECT HeaderCode FROM GroupAllowedHeader WHERE Module=1 AND GroupCode = :ai_groupcode)
ORDER BY
	S.SaleInvCode,
	A.Name,
	A.AliasName"
  update="SaleLedger" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_groupcode", number))
)
