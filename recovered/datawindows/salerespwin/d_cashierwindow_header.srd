table(column=(type=long key=yes update=yes updatewhereclause=yes name=saleinvcode dbname="SaleLedger.SaleInvCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=invtotal dbname="SaleLedger.InvTotal"  )
column=(type=long updatewhereclause=yes initial="2" name=cashacccode dbname="CashAccCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=cashtendered dbname="SaleLedger.CashTendered"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=cashcharged dbname="SaleLedger.CashCharged"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=cashback dbname="SaleLedger.CashBack"  )
 retrieve="SELECT 
	SaleLedger.SaleInvCode,   
	SaleLedger.InvTotal,	
	CashAccCode=NULL,
	SaleLedger.CashTendered,   
	SaleLedger.CashCharged,   
	SaleLedger.CashBack  
FROM 
	SaleLedger  
WHERE 
	SaleLedger.SaleInvCode = :ai_invcode
		
"
  update="SaleLedger" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_invcode", number))
)
