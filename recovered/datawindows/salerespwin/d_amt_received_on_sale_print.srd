summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=3145 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=saleinvcode dbname="SaleLedger.SaleInvCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) update=yes updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(183) updatewhereclause=yes name=address dbname="Address"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="SaleLedger.Date"  )
column=(type=datetime update=yes updatewhereclause=yes name=amtdate dbname="SaleLedger.AmtDate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=amt dbname="SaleLedger.Amt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=invtotal dbname="SaleLedger.InvTotal"  )
column=(type=char(60) update=yes updatewhereclause=yes name=amtby dbname="AmtBy"  )
column=(type=char(20) update=yes updatewhereclause=yes name=amtreference dbname="SaleLedger.Amtreference"  )
column=(type=char(1) update=yes updatewhereclause=yes name=paymentmode dbname="SaleLedger.PaymentMode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=depositedto dbname="DepositedTo"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
 retrieve="SELECT
	S.SaleInvCode,
	AliasName=(SELECT AliasName FROM Accounts WHERE AccCode = S.CustCode),
	Customer=(SELECT Name FROM Accounts WHERE AccCode = S.CustCode),
	Address=(SELECT RTRIM(LTRIM(customer.Address1)) + ' ' + RTRIM(LTRIM(customer.Address2)) + ' ' + RTRIM(LTRIM(customer.city)) + ' ' + RTRIM(LTRIM(customer.country))
				 FROM customer WHERE customer.CustCode = S.CustCode),
	S.Date,
	S.AmtDate,
	S.Amt,
	S.InvTotal,
	AmtBy=(SELECT UserName FROM Users WHERE Users.UserCode = S.AmtBy),
	S.Amtreference,
	S.PaymentMode,
	DepositedTo=(SELECT Name FROM Accounts WHERE AccCode = S.PaymentAccCode),
	Posted=S.Posted
	
FROM
	SaleLedger S
WHERE
	S.Posted = 'N' AND
	S.AccountFor = 'Y' AND
	S.SaleInvCode = :ai_code
	
	"
  update="SaleLedger" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
