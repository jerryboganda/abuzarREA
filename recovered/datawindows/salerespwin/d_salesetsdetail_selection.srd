release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80269524 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=68 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=setcode dbname="SaleSetsOrigDetail.SetCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(200) update=yes updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="TotalStock"  )
column=(type=long updatewhereclause=yes name=parentrow dbname="ParentRow"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0" initial="0" name=saleprice dbname="SaleSetsOrigDetail.SalePrice"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >  0" initial="1" name=packunits dbname="SaleSetsOrigDetail.PackUnits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0" initial="0" name=itemflatdisc dbname="SaleSetsOrigDetail.ItemFlatDisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0 AND Real(GetText()) <= 100" initial="0" name=discperc dbname="SaleSetsOrigDetail.DiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0" initial="0" name=processcharge dbname="SaleSetsOrigDetail.ProcessCharge"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0 AND Real(GetText()) <= 100" initial="0" name=processchargeperc dbname="SaleSetsOrigDetail.ProcessChargePerc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >=  0" initial="1" name=qty dbname="Qty"  )
 retrieve="SELECT 
	FullCode=(SELECT Item.CustomICode FROM ITEM WHERE Item.ICode = SaleSetsOrigDetail.ICode),
	ItemName=(SELECT Item.Name FROM ITEM WHERE Item.ICode = SaleSetsOrigDetail.ICode),
	CurrListRow=0, 
	ItemCode=0,
	SaleSetsOrigDetail.SetCode,   
	ICode=SaleSetsOrigDetail.ICode,   
	Remarks=SaleSetsOrigDetail.Remarks,   
	TotalStock=0.0000,   
	ParentRow=0,
	SaleSetsOrigDetail.SalePrice,
	SaleSetsOrigDetail.PackUnits,
	SaleSetsOrigDetail.ItemFlatDisc,
	SaleSetsOrigDetail.DiscPerc,
	SaleSetsOrigDetail.ProcessCharge,
	SaleSetsOrigDetail.ProcessChargePerc,
	Qty=SaleSetsOrigDetail.Qty
FROM 
	SaleSetsOrigDetail
WHERE 
	SaleSetsOrigDetail.SetCode = :ai_code
ORDER BY
	ParentRow,
	SaleSetsOrigDetail.SetCode
	"
  update="SaleSetsOrigDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
