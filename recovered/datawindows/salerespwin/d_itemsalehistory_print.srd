table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="name"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="itemaliasname"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="name"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
column=(type=long updatewhereclause=yes name=usercode dbname="usercode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="Itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=long updatewhereclause=yes name=rowgroup dbname="rowgroup"  )
column=(type=char(12) updatewhereclause=yes name=customeraliasname dbname="customeraliasname"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="name"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
 retrieve="select  	
	item.name,
	itemaliasname=item.customicode,
	ItemPacking.name, 
	saleledger.saleinvcode,
	saleledger.custcode,
	saleledger.custrefno,
	saleledger.headerno,
	saleledger.headerinvno,
	usercode=saleledger.salesmancode,
	saleledger.remarks,
	invdiscperc=saleledger.discperc,
	saleledger.date,
	sd.looseqty,
	sd.bonusqty,
	sd.SalePrice, 
	sd.Itemflatdisc,
	sd.discperc,
	sd.batch, 
	sd.expiry,
	sd.gstperc,
	sd.unitsalestax,
	sd.rowgroup,
	customeraliasname=dbo.accounts.aliasname,	
	dbo.accounts.name,
	patientname = (select p.name from patient p where p.patientcode=saleledger.patientcode)
/* By M.USMAN
To optimize query for performance gain
*/
From   
	(Select icode,saleinvcode,looseqty,bonusqty,saleprice,itemflatdisc,discperc,batch,expiry,due,gstperc,unitsalestax,rowgroup From saledetail with (index(IDX_SaleDetail_ICode)) Where icode = :ar_icode) sd 
       Inner Loop join saleledger On sd.saleinvcode = saleledger.saleinvcode 
       Inner Join Accounts On SaleLedger.CustCode = Accounts.Acccode
       Inner Join Item On SD.Icode = Item.Icode 
       Left  Outer Join ItemPacking On Item.packcode = ItemPacking.PackCode  	
/*----END-------*/

UNION
/* Proforma Sales Invoice */
select  	
	item.name,
	itemaliasname=item.customicode,
	ItemPacking.name, 
	saleledger.saleinvcode,
	saleledger.custcode,
	saleledger.custrefno,
	saleledger.headerno,
	saleledger.headerinvno,
	usercode=saleledger.salesmancode,
	saleledger.remarks,
	invdiscperc=saleledger.discperc,
	saleledger.date,
	sd.looseqty,
	sd.bonusqty,
	sd.SalePrice, 
	sd.Itemflatdisc,
	sd.discperc,
	sd.batch, 
	sd.expiry,
	sd.gstperc,
	sd.unitsalestax,
	sd.rowgroup,
	customeraliasname=dbo.accounts.aliasname,	
	dbo.accounts.name,
	patientname = (select p.name from patient p where p.patientcode=saleledger.patientcode)
/* By M.USMAN
To optimize query for performance gain
*/
From   
	(Select icode,saleinvcode,looseqty,bonusqty,saleprice,itemflatdisc,discperc,batch,expiry,due=Null,gstperc,unitsalestax,rowgroup From saleinvdetail Where icode = :ar_icode) sd 
       Inner Loop join saleledger On sd.saleinvcode = saleledger.saleinvcode 
       Inner Join Accounts On SaleLedger.CustCode = Accounts.Acccode
       Inner Join Item On SD.Icode = Item.Icode 
       Left  Outer Join ItemPacking On Item.packcode = ItemPacking.PackCode  	
/*----END-------*/

UNION

select  	
	item.name,
	itemaliasname=item.customicode,
	ItemPacking.name, 
	saleledgermodified.saleinvcode,
	saleledgermodified.custcode,
	saleledgermodified.custrefno,
	saleledgermodified.headerno,
	saleledgermodified.headerinvno,
	usercode=saleledgermodified.salesmancode,
	saleledgermodified.remarks,
	invdiscperc=saleledgermodified.discperc,
	saleledgermodified.date,
	sd.looseqty,
	sd.bonusqty,
	sd.SalePrice, 
	sd.Itemflatdisc,
	sd.discperc,
	sd.batch, 
	sd.expiry,
	sd.gstperc,
	sd.unitsalestax,
	sd.rowgroup,
	customeraliasname=dbo.accounts.aliasname,	
	dbo.accounts.name,
	patientname = (select p.name from patient p where p.patientcode=saleledgermodified.patientcode)

From   
	(Select icode,saleinvcode,looseqty,bonusqty,saleprice,itemflatdisc,discperc,batch,expiry,due,gstperc,unitsalestax,rowgroup From saledetailmodified  Where icode = :ar_icode and saleinvcode not in (select saleinvcode from saleledger)) sd 
       Inner Loop join saleledgermodified On sd.saleinvcode = saleledgermodified.saleinvcode 
       Inner Join Accounts On saleledgermodified.CustCode = Accounts.Acccode
       Inner Join Item On SD.Icode = Item.Icode 
       Left  Outer Join ItemPacking On Item.packcode = ItemPacking.PackCode  	

UNION
select  	
	item.name,
	itemaliasname=item.customicode,
	ItemPacking.name, 
	saleledgerdump.saleinvcode,
	saleledgerdump.custcode,
	saleledgerdump.custrefno,
	saleledgerdump.headerno,
	saleledgerdump.headerinvno,
	usercode=saleledgerdump.salesmancode,
	saleledgerdump.remarks,
	invdiscperc=saleledgerdump.discperc,
	saleledgerdump.date,
	sd.looseqty,
	sd.bonusqty,
	sd.SalePrice, 
	sd.Itemflatdisc,
	sd.discperc,
	sd.batch, 
	sd.expiry,
	sd.gstperc,
	sd.unitsalestax,
	sd.rowgroup,
	customeraliasname=dbo.accounts.aliasname,	
	dbo.accounts.name,
	patientname = (select p.name from patient p where p.patientcode=saleledgerdump.patientcode)

From   (Select icode,saleinvcode,looseqty,bonusqty,saleprice,itemflatdisc,discperc,batch,expiry,due,gstperc,unitsalestax,rowgroup From saledetaildump with (index(IDX_SaleDetailDump_ICode)) Where icode = :ar_icode) sd 
       Inner Loop join saleledgerdump On sd.saleinvcode = saleledgerdump.saleinvcode 
       Inner Join Accounts On saleledgerdump.CustCode = Accounts.Acccode
       Inner Join Item On SD.Icode = Item.Icode 
       Left  Outer Join ItemPacking On Item.packcode = ItemPacking.PackCode  	
"
  arguments=(("ar_icode", number))
 sort="date D, itemname A, batch A, expiry A"
)
