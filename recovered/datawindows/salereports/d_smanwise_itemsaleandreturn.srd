table(column=(type=char(13) updatewhereclause=yes name=documentcode dbname="Accounts.documentcode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(12) updatewhereclause=yes name=customeraliasname dbname="CustomerAliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="ItemAliasName"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesMan"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Accounts.Date"  )
column=(type=long updatewhereclause=yes name=invcode dbname="Accounts.InvCode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="Accounts.CustCode"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Accounts.Type"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Accounts.Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Accounts.Bonus"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Accounts.Rate"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="Accounts.ItemDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="Accounts.ItemFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="Accounts.InvDiscPerc"  )
column=(type=decimal(6) updatewhereclause=yes name=tax dbname="Accounts.TAX"  )
 retrieve="SELECT
	documentcode,
	Customer=A.Name,
	CustomerAliasName=A.AliasName,
	Item=I.Name,
	ItemAliasName=I.CustomICode,
	SalesMan=(SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = :ar_SManCode),
	S.Date, 
	S.InvCode,
	S.CustCode,
	S.Type,
	S.Qty,
	S.Bonus,
	S.Rate,
	S.ItemDiscPerc,
	S.ItemFlatDisc,
	S.InvDiscPerc,
	S.TAX
FROM
	Accounts A,
	Item I,
	(SELECT
		documentcode = 'SV-' + LTRIM(RTRIM(STR(SL.SaleInvCode, 10))), 
		SL.Date, 
		InvCode=SL.SaleInvCode,
		SL.CustCode,
		Type='S',
		SD.ICode,
		Qty=SUM(SD.LooseQty),
		Bonus=SUM(SD.BonusQty),
		Rate=SD.SalePrice,
		ItemDiscPerc=SD.DiscPerc,
		SD.ItemFlatDisc,
		InvDiscPerc=SL.DiscPerc,
		TAX=SUM((SD.UnitSalesTax * (SD.LooseQty + SD.BonusQty)) + 
			(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * 
			(1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01) * SD.GSTPerc * 0.01))
	FROM
		SaleLedger SL, SaleDetail SD
	WHERE
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SManCode = :ar_SManCode AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = :ar_ICode
	GROUP BY
		SL.SaleInvCode,
		SD.ICode,
		SL.Date, 
		SL.SaleInvCode,
		SL.CustCode,
		SD.SalePrice,
		SD.DiscPerc,
		SD.ItemFlatDisc,
		SL.DiscPerc
	UNION ALL
	SELECT
		documentcode = 'SV-' + LTRIM(RTRIM(STR(SL.SaleInvCode, 10))), 
		SL.Date, 
		InvCode=SL.SaleInvCode,
		SL.CustCode,
		Type='S',
		SD.ICode,
		Qty=SUM(SD.LooseQty),
		Bonus=SUM(SD.BonusQty),
		Rate=SD.SalePrice,
		ItemDiscPerc=SD.DiscPerc,
		SD.ItemFlatDisc,
		InvDiscPerc=SL.DiscPerc,
		TAX=SUM((SD.UnitSalesTax * (SD.LooseQty + SD.BonusQty)) + 
			(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * 
			(1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01) * SD.GSTPerc * 0.01))
	FROM
		SaleLedger SL, SaleInvDetail SD
	WHERE
		SL.ImpactInventory = 'N' AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SManCode = :ar_SManCode AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = :ar_ICode
	GROUP BY
		SL.SaleInvCode,
		SD.ICode,
		SL.Date, 
		SL.SaleInvCode,
		SL.CustCode,
		SD.SalePrice,
		SD.DiscPerc,
		SD.ItemFlatDisc,
		SL.DiscPerc
	UNION ALL
	SELECT
		documentcode = 'SR-' + LTRIM(RTRIM(STR(SL.SRInvCode, 10))), 
		SL.Date, 
		InvCode=SL.SRInvCode,
		SL.CustCode,
		Type='R',
		SD.ICode,
		Qty=-SUM(SD.LooseQty),
		Bonus=-SUM(SD.BonusQty),
		Rate=SD.SRPrice,
		ItemDiscPerc=SD.DiscPerc,
		ItemFlatDisc=0,
		InvDiscPerc=SL.DiscPerc,
		TAX=-SUM((SD.UnitSalesTax * (SD.LooseQty + SD.BonusQty)) + 
			(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * .01) * 
			(1 - SL.DiscPerc * .01) * SD.GSTPerc * 0.01))
	FROM
		SRLedger SL, SRDetail SD
	WHERE
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SManCode = :ar_SManCode AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = :ar_ICode
	GROUP BY
		SL.SRInvCode,
		SD.ICode,
		SL.Date, 
		SL.CustCode,
		SD.SRPrice,
		SD.DiscPerc,
		SL.DiscPerc) S
WHERE
	S.ICode = I.ICode AND S.CustCode = A.AccCode
ORDER BY
	I.Name,
	S.Date,
	S.documentcode,
	S.InvCode,
	A.Name
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ar_SManCode", number), ("ar_ICode", number))
)
