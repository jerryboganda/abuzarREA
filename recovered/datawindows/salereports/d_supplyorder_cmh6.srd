release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=300 print.margin.top=0 print.margin.bottom=600 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2010 color="536870912" )
summary(height=41 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=subcategory dbname="SubCategory"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=long updatewhereclause=yes name=id dbname="ID"  )
column=(type=decimal(4) updatewhereclause=yes name=cumulativesum dbname="cumulativesum"  )
column=(type=decimal(4) updatewhereclause=yes name=cumulativesumfoot dbname="cumulativesumfoot"  )
 retrieve="SELECT 
	Date = CAST(CONVERT(VARCHAR(100), A.Date, 111) AS DATETIME),
	itemname = A.itemname, 
	SubCategory = (A.ItemClass),
	looseqty = Sum (A.looseqty),
	price = max(A.price),    
	ID = MAX(A.ID),
	cumulativesum = round(0.0000,2),
	cumulativesumfoot = round(0.0000,2)
FROM
	(SELECT
			 Date=CASE lower(:as_datetype) 
					 When 'originaldate' Then dbo.saleledger.originaldate 
					 When 'lastsavingdate' Then dbo.saleledger.date
					 When 'billingdate' Then dbo.saleledger.billingdate
				END,
			 itemname = item.name, 
			 icode=saledetail.icode,
			 ItemClass = (dbo.ItemClass.name),
			 looseqty = Sum (dbo.saledetail.looseqty),
			 price = max(dbo.saledetail.saleprice),    
			 ID = MAX(dbo.saledetail.RowId)/*,
			 cumulativesum = round(0.0000,2),
			 cumulativesumfoot = round(0.0000,2)*/
	FROM 	 dbo.saleledger, 
			 dbo.saledetail,
			 dbo.item,
			 dbo.Customer,
			 dbo.Accounts,
			 dbo.ItemClass 
	WHERE  
			 CASE lower(:as_datetype) 
					 When 'originaldate' Then dbo.saleledger.originaldate 
					 When 'lastsavingdate' Then dbo.saleledger.date
					 When 'billingdate' Then dbo.saleledger.billingdate
				END between :ad_StartDate and :ad_EndDate and
			 dbo.saleledger.custcode  IN ( :al_custcode ) AND
			 dbo.saleledger.salecatcode IN (1, 2, 3) AND
			 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
			 dbo.saledetail.icode = item.icode AND
			 dbo.saleledger.custcode = dbo.customer.custcode AND
			 dbo.customer.custcode = dbo.accounts.acccode AND
			 dbo.Item.ICCode = dbo.ItemClass.ICCode
	Group by 
			dbo.saleledger.originaldate,
			dbo.saleledger.date,
			dbo.saleledger.billingdate,
			dbo.saledetail.icode,
			dbo.item.name,
			dbo.ItemClass.name
	UNION ALL
	SELECT 
			Date=CASE lower(:as_datetype) 
					 When 'originaldate' Then dbo.saleledger.originaldate 
					 When 'lastsavingdate' Then dbo.saleledger.date
					 When 'billingdate' Then dbo.saleledger.billingdate
				END,
			itemname = item.name, 
			icode=saledetail.icode,
			ItemClass = (dbo.ItemClass.name),
			looseqty = Sum (saledetail.looseqty),
			price = max(saledetail.saleprice),    
			ID = MAX(saledetail.RowId)/*,
			cumulativesum = round(0.0000,2),
			cumulativesumfoot = round(0.0000,2)*/
	
	FROM 
			dbo.saleledger, 
			saleinvdetail saledetail,    
			dbo.item, 
			dbo.Customer,
			dbo.Accounts,
			dbo.ItemClass 
	WHERE  
			CASE lower(:as_datetype) 
					 When 'originaldate' Then dbo.saleledger.originaldate 
					 When 'lastsavingdate' Then dbo.saleledger.date
					 When 'billingdate' Then dbo.saleledger.billingdate
				END between :ad_StartDate and :ad_EndDate and
			dbo.saleledger.custcode  IN ( :al_custcode ) AND
			dbo.saleledger.ImpactInventory='N' AND
			dbo.saleledger.salecatcode IN (1, 2, 3) AND
			dbo.saleledger.saleinvcode = saledetail.saleinvcode AND
			saledetail.icode = item.icode AND 
			dbo.saleledger.custcode = dbo.customer.custcode AND
			dbo.customer.custcode = dbo.accounts.acccode AND
			dbo.Item.ICCode = dbo.ItemClass.ICCode
	Group by 
			dbo.saleledger.originaldate,
			dbo.saleledger.date,
			dbo.saleledger.billingdate,
			saledetail.icode,
			dbo.item.name,
			dbo.ItemClass.name) as A
GROUP BY
	CAST(CONVERT(VARCHAR(100), A.Date, 111) AS DATETIME),
	A.icode,
	A.itemname,
	A.ItemClass"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("as_city", string), ("as_cp", string), ("ai_suppress", number), ("as_datetype", string))
 sort="date A, itemname A"
)
