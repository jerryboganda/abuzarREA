release 12.5;
datawindow ( units=0 timer_interval=0 processing=4 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=1 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=400 color="536870912" )
header[2](height=128 color="536870912" )
summary(height=68 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=number updatewhereclause=yes name=netsale dbname="netsale"  )
 retrieve="SELECT
	ManfCode=M.ManfCode,
	Manufacturer=M.Name,
	SalesMan=S.Name,
	NetSale=ROUND(N.NetSale, 2)

FROM	(SELECT ManfCode, SManCode, SUM(NET) AS NetSale
	FROM (SELECT  SL.saleinvcode,
		SL.SManCode,
		I.ManfCode,
		Net=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc)))
		FROM    saleledger SL,	 
			saledetail SD,
			Item I
		WHERE   SL.Posted = 'Y' AND
			SL.DATE Between :ar_startdate AND :ar_enddate AND
			SL.SManCode IN (:ar_salesmancode) AND
			SL.SaleInvCode = SD.SaleInvcode AND SD.ICode = I.ICode
		GROUP BY 
			I.ManfCode,
			SL.saleinvcode,
			SL.SManCode
		UNION ALL
		SELECT  SL.saleinvcode,
		SL.SManCode,
		I.ManfCode,
		Net=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc)))
		FROM    saleledger SL,	 
			saleinvdetail SD,
			Item I
		WHERE SL.ImpactInventory='N' AND  SL.Posted = 'Y' AND
			SL.DATE Between :ar_startdate AND :ar_enddate AND
			SL.SManCode IN (:ar_salesmancode) AND
			SL.SaleInvCode = SD.SaleInvcode AND SD.ICode = I.ICode
		GROUP BY 
			I.ManfCode,
			SL.saleinvcode,
			SL.SManCode
		UNION ALL		
		SELECT  SL.Srinvcode,
			SL.SManCode,
			I.ManfCode,
			Net=-SUM((SD.looseqty*(SD.srprice)) *
				(1 - (.01 * SD.discperc)))
		FROM    srledger SL,	 
			srdetail SD,
			Item I
		WHERE   SL.Posted = 'Y' AND
			SL.DATE Between :ar_startdate AND :ar_enddate AND
			SL.SManCode IN (:ar_salesmancode) AND
			SL.SrInvCode = SD.SrInvcode AND SD.ICode = I.ICode
		GROUP BY I.ManfCode,
			SL.Srinvcode,
			SL.SManCode) S
	GROUP BY SManCode, ManfCode) N, 
	SalesMan S, 
	Manufacturer M

WHERE	N.SManCode = S.SalesManCode AND 
	N.ManfCode = M.ManfCode

ORDER BY
	S.Name,
	M.Name
"
  arguments=(("ar_salesmancode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
 sort="manufacturer A"
)
compute(name=compute_4 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="1573" y="20" height="64" width="1513" format="[GENERAL]" expression="'Page ' + page() + ':' + pageAcross() + ' of ' + pageCount() + ':' + pageCountAcross()" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
