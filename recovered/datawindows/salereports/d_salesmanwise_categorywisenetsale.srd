release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1239 color="536870912" )
summary(height=1833 color="536870912" )
footer(height=10 color="536870912" )
detail(height=208 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icatcode dbname="ItemCategory.Icatcode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="ItemCategory.Name"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=decimal(6) updatewhereclause=yes name=grossvalue dbname="grossvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=discvalue dbname="discvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="salevalue"  )
column=(type=decimal(4) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
column=(type=decimal(6) updatewhereclause=yes name=returnval dbname="returnval"  )
 retrieve="SELECT  IC.Icatcode, 
	Ic.Name,
	SaleQty = ROUND(SUM(CASE P.TYPE WHEN 'S' THEN P.Qty ELSE 0 END), 0),
	grossvalue = ROUND(SUM(
		CASE P.TYPE WHEN 'S' THEN
			P.grossvalue 
		ELSE 0 END), 0),
	discvalue = ROUND ( SUM ( 
		CASE P.TYPE WHEN 'S' THEN
			P.itemdiscvalue + P.invitemdiscvalue +
									P.flatdisc * ( P.itemvalue/
									CASE P.grossamt WHEN 0 THEN 1 
									ELSE P.grossamt END)
		ELSE 0 END), 0),
	salevalue=ROUND(SUM(
		CASE P.TYPE WHEN 'S' THEN
			P.itemvalue - (P.flatdisc *(P.itemvalue/
			CASE P.grossamt WHEN 0 THEN 1 
			ELSE P.grossamt END))
		ELSE 0 END), 0),
	ReturnQty = ROUND(SUM(CASE P.TYPE WHEN 'R' THEN P.Qty ELSE 0 END), 0),
	returnval=ROUND(SUM(
		CASE P.TYPE WHEN 'R' THEN
			P.itemvalue - (P.flatdisc*(P.itemvalue/
				CASE P.grossamt WHEN 0 THEN 1 
				ELSE P.grossamt END)) 
		ELSE 0 END), 0)
FROM 
(
SELECT
	saleledger.saleinvcode,
	saledetail.icode,
	Qty=SUM(saledetail.looseqty),
	GrossValue = SUM(saledetail.looseqty * saledetail.saleprice ) ,
	ItemDiscValue = SUM((saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc))*
						 (.01 * saledetail.discperc) + saledetail.itemflatdisc ),
	InvItemDiscValue = SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*
							(1 - (.01 * saledetail.discperc) ) *  (.01 * saleledger.discperc) ),
	ItemValue=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*
		(1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),
	GrossAmt=
		(SELECT SUM((sd.looseqty*(sd.saleprice - sd.itemflatdisc)) *
			(1 - (.01 * sd.discperc)) * (1- (.01 * sl.discperc)))
		FROM	saledetail sd, saleledger sl
		WHERE sl.saleinvcode=saleledger.saleinvcode and sl.saleinvcode=sd.saleinvcode
		GROUP BY sl.saleinvcode),
	saleledger.flatdisc,
	catcode=saleledger.salecatcode,
	type='S',
	usercode=saleledger.smancode

FROM
	saleledger,	 
	saledetail

WHERE
	saleledger.saleinvcode = saledetail.saleinvcode AND 
	saleledger.Date Between :ar_startdate AND :ar_enddate AND 
	saleledger.salecatcode IN (:ar_saletype) AND
	saleledger.smancode IN (:ar_smancode)

GROUP BY 
	 saleledger.saleinvcode,
	 saleledger.smancode,
	 saledetail.icode,
	 saleledger.salecatcode,
	 saleledger.discperc,
	 saleledger.flatdisc,
	 saleledger.invgstperc1,
	 saleledger.salecatcode
UNION ALL
SELECT
	saleledger.saleinvcode,
	saledetail.icode,
	Qty=SUM(saledetail.looseqty),
	GrossValue = SUM(saledetail.looseqty * saledetail.saleprice ) ,
	ItemDiscValue = SUM((saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc))*
						 (.01 * saledetail.discperc) + saledetail.itemflatdisc ),
	InvItemDiscValue = SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*
							(1 - (.01 * saledetail.discperc) ) *  (.01 * saleledger.discperc) ),
	ItemValue=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*
		(1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),
	GrossAmt=
		(SELECT SUM((sd.looseqty*(sd.saleprice - sd.itemflatdisc)) *
			(1 - (.01 * sd.discperc)) * (1- (.01 * sl.discperc)))
		FROM	saledetail sd, saleledger sl
		WHERE sl.saleinvcode=saleledger.saleinvcode and sl.saleinvcode=sd.saleinvcode
		GROUP BY sl.saleinvcode),
	saleledger.flatdisc,
	catcode=saleledger.salecatcode,
	type='S',
	usercode=saleledger.smancode

FROM
	saleledger,	 
	saleinvdetail saledetail

WHERE
	SaleLedger.impactinventory = 'N' AND
	saleledger.saleinvcode = saledetail.saleinvcode AND 
	saleledger.Date Between :ar_startdate AND :ar_enddate AND 
	saleledger.salecatcode IN (:ar_saletype) AND
	saleledger.smancode IN (:ar_smancode)

GROUP BY 
	 saleledger.saleinvcode,
	 saleledger.smancode,
	 saledetail.icode,
	 saleledger.salecatcode,
	 saleledger.discperc,
	 saleledger.flatdisc,
	 saleledger.invgstperc1,
	 saleledger.salecatcode
UNION ALL
SELECT
	srledger.srinvcode,
	srdetail.icode,
	Qty=SUM(srdetail.looseqty),
	GrossValue = SUM( srdetail.looseqty * srdetail.srprice ) ,
	ItemDiscValue = SUM((srdetail.looseqty * srdetail.srprice ) * (.01 * srdetail.discperc) ),
	InvItemDiscValue = SUM( ( (srdetail.looseqty * srdetail.srprice) *
								(1 - (.01 * srdetail.discperc) ) ) * (.01 * srledger.discperc) ),
	ItemValue=SUM((srdetail.looseqty * srdetail.srprice *
		(1 - (.01 * srdetail.discperc))) * (1 - (.01 * srledger.discperc))),
	GrossAmt=(SELECT SUM((sd.looseqty * sd.srprice *
			(1 - (.01 * sd.discperc))) * (1- (.01 * sl.discperc)))
		FROM	srdetail sd, srledger sl
		WHERE sl.srinvcode=srledger.srinvcode and sl.srinvcode=sd.srinvcode
		GROUP BY sl.srinvcode),
	srledger.flatdisc,
	catcode=srledger.srcatcode,
	type='R',
	usercode=srledger.smancode

FROM
	srledger,	 
	srdetail

WHERE
   srledger.srinvcode = srdetail.srinvcode  AND 
	srledger.date Between :ar_startdate AND :ar_enddate AND 
	srledger.srcatcode IN (:ar_saletype) AND
	srledger.smancode IN (:ar_smancode)

GROUP BY
	 srledger.srinvcode,
	 srledger.smancode,
	 srdetail.icode,
	 srledger.srcatcode,
	 srledger.discperc,
	 srledger.flatdisc,
	 srledger.invgstperc1,
	 srledger.srcatcode) P, ItemCategory IC, Item I

WHERE
	P.Icode = I.Icode AND 
	I.ICatCode = IC.ICatCode

GROUP BY 
	IC.Icatcode, 
	Ic.Name

ORDER BY 
	Ic.Name, 
	IC.Icatcode
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_smancode", numberlist), ("ar_saletype", numberlist), ("ar_salesmanlist", string))
)
