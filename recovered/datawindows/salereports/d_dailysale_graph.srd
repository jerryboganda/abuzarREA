release 12.5;
datawindow ( units=1 timer_interval=0 processing=3 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=24 print.margin.right=24 print.margin.top=24 print.margin.bottom=24 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=char(30) updatewhereclause=yes name=dayname dbname="DayName"  )
column=(type=long updatewhereclause=yes name=cinvcount dbname="InvCount"  )
column=(type=decimal(6) updatewhereclause=yes name=cinvvalue dbname="InvValue"  )
column=(type=char(6) updatewhereclause=yes name=csalecatgory dbname="SaleCatgory"  )
 retrieve="select DayName = datename(weekday, saleledger.date),  
		 InvCount= count(distinct saleledger.saleinvcode) , 
 		 InvValue=  Case When Round(Sum ( (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc)) *  (1 - dbo.saledetail.discperc /100) * (1 - dbo.saleledger.discperc /100) - flatdisc   +   misccharges), 2) IS NULL Then 0  Else Round(Sum ( (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc)) *  (1 - dbo.saledetail.discperc /100) * (1 - dbo.saleledger.discperc /100)) - flatdisc   +   misccharges, 2) End, 
		 SaleCatgory = Case saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit'  When 3 Then 'Cash'  End   														  
from   saleledger, saledetail  

where  saleledger.date >= :ad_StartDate and  
	 	 saleledger.date <= :ad_EndDate and   
	 	 saleledger.saleinvcode = saledetail.saleinvcode  

Group by datename(weekday, saleledger.date),
	      saleledger.salecatcode, 
			flatdisc, 
			misccharges,saleledger.discperc 
UNION ALL
select DayName = datename(weekday, saleledger.date),  
		 InvCount= count(distinct saleledger.saleinvcode) , 
 		 InvValue=  Case When Round(Sum ( (saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) *  (1 - saledetail.discperc /100) * (1 - dbo.saleledger.discperc /100) - flatdisc   +   misccharges), 2) IS NULL Then 0  Else Round(Sum ( (saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) *  (1 - saledetail.discperc /100) * (1 - dbo.saleledger.discperc /100)) - flatdisc   +   misccharges, 2) End, 
		 SaleCatgory = Case saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit'  When 3 Then 'Cash'  End   														  

from   saleledger, saleinvdetail saledetail  

where  SaleLedger.impactinventory = 'N' AND
		 saleledger.date >= :ad_StartDate and  
	 	 saleledger.date <= :ad_EndDate and   
	 	 saleledger.saleinvcode = saledetail.saleinvcode  

Group by datename(weekday, saleledger.date),
	      saleledger.salecatcode, 
			flatdisc, 
			misccharges,saleledger.discperc 




"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime))
)
