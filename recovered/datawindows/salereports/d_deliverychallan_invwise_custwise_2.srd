release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=300 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2114 color="536870912" )
summary(height=489 color="536870912" )
footer(height=0 color="536870912" )
detail(height=270 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Person"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
 retrieve="SELECT itemname = case when Max(saledetail.saleitemdescription) is null OR RTrim(LTrim(Max(saledetail.saleitemdescription))) = '' THEN item.name else Upper(Max(saledetail.saleitemdescription)) end ,
		 packingdesc = item.packingdesc,
		 looseqty = Sum(dbo.saledetail.looseqty), 
		 bonusqty = Sum(dbo.saledetail.bonusqty),
		 Person = dbo.accounts.name,
		 city = dbo.customer.city
		 
FROM 	 dbo.saleledger, dbo.saledetail, dbo.item,
		 dbo.accounts, dbo.customer

WHERE  dbo.saleledger.saleinvcode >= :ai_sinvcode and
		 dbo.saleledger.saleinvcode <= :ai_linvcode  and
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
		 dbo.saledetail.icode = item.icode and
		 dbo.saleledger.custcode = dbo.accounts.acccode and
		 dbo.accounts.acccode = dbo.customer.custcode and
		 dbo.saleledger.custcode = :al_custcode

Group By dbo.item.name,
			dbo.item.packingdesc, 
			dbo.accounts.name,
			dbo.customer.city"
  arguments=(("ai_sinvcode", number), ("ai_linvcode", number), ("al_custcode", number), ("as_term1", string), ("as_term2", string), ("as_caption", string))
 sort="itemname A"
)
