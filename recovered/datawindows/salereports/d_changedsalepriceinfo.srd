table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=decimal(4) updatewhereclause=yes name=quantity dbname="quantity"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=decimal(2) updatewhereclause=yes name=difference dbname="difference"  )
column=(type=decimal(6) updatewhereclause=yes name=differenceamount dbname="diffamount"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="ItemCategory.icatcode"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="category"  )
 retrieve="SELECT 
	invcode     = dbo.saleledger.saleinvcode, 
	date        = dbo.saleledger.date, 
	itemname    = dbo.item.name,
	dbo.accounts.name, 
	quantity = dbo.saledetail.looseqty,
	salesman = dbo.users.username,
	difference = dbo.saledetail.saleprice - dbo.saledetail.rate,
	diffamount = Round(( (dbo.saledetail.saleprice - dbo.saledetail.rate) * dbo.saledetail.looseqty),2) ,
	rate = dbo.saledetail.rate,
	saleprice=saledetail.saleprice,
	itemcategory.icatcode,
	category=itemcategory.name
FROM 
	dbo.saleledger, 
	dbo.saledetail,  
	dbo.item, 
	dbo.accounts,
	dbo.users,
	itemcategory  
WHERE
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and  
	( dbo.saledetail.saleprice <> dbo.saledetail.rate) and  
	( dbo.saleledger.date between :ar_StartDate and :ar_EndDate) and 
	( dbo.saledetail.icode = dbo.item.icode ) and
	( dbo.item.icatcode IN (:ar_icatcode)) and
	( dbo.item.icatcode=itemcategory.icatcode) and
	( dbo.saleledger.custcode = dbo.accounts.acccode ) and  
	( dbo.saleledger.salesmancode = dbo.users.usercode ) 
UNION ALL
SELECT 
	invcode     = dbo.saleledger.saleinvcode, 
	date        = dbo.saleledger.date, 
	itemname    = dbo.item.name,
	dbo.accounts.name, 
	quantity = sd.looseqty,
	salesman = dbo.users.username,
	difference = sd.saleprice - sd.rate,
	diffamount = Round(( (sd.saleprice - sd.rate) * sd.looseqty),2) ,
	rate = sd.rate,
	saleprice=sd.saleprice,
	itemcategory.icatcode,
	category=itemcategory.name
FROM 
	dbo.saleledger, 
	dbo.saleinvdetail sd,  
	dbo.item, 
	dbo.accounts,
	dbo.users,
	itemcategory  
WHERE 
	( dbo.saleledger.impactinventory ='N' ) AND
	( dbo.saleledger.saleinvcode = sd.saleinvcode ) and  
	( sd.saleprice <> sd.rate) and  
	( dbo.saleledger.date between :ar_StartDate and :ar_EndDate) and 
	( sd.icode = dbo.item.icode ) and
	( dbo.item.icatcode IN (:ar_icatcode)) and
	( dbo.item.icatcode=itemcategory.icatcode) and
	( dbo.saleledger.custcode = dbo.accounts.acccode ) and  
	( dbo.saleledger.salesmancode = dbo.users.usercode ) 
ORDER BY 
	dbo.itemcategory.name,
	dbo.itemcategory.icatcode,
	dbo.saleledger.saleinvcode,
	dbo.saleledger.date,
	dbo.item.name
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ar_icatcode", numberlist))
)
