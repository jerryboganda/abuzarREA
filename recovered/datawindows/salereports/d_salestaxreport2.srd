table(column=(type=char(50) updatewhereclause=yes name=buyerntn dbname="BuyerNTN"  )
column=(type=char(30) updatewhereclause=yes name=buyercnic dbname="BuyerCNIC"  )
column=(type=char(60) updatewhereclause=yes name=buyername dbname="BuyerName"  )
column=(type=char(30) updatewhereclause=yes name=buyertype dbname="BuyerType"  )
column=(type=long updatewhereclause=yes name=saleorigination dbname="SaleOrigination"  )
column=(type=char(2) updatewhereclause=yes name=documenttype dbname="DocumentType"  )
column=(type=long updatewhereclause=yes name=documentno dbname="DocumentNo"  )
column=(type=datetime updatewhereclause=yes name=documentdate dbname="DocumentDate"  )
column=(type=char(100) updatewhereclause=yes name=saletype dbname="SaleType"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=char(203) updatewhereclause=yes name=description dbname="Description"  )
column=(type=decimal(4) updatewhereclause=yes name=quantity dbname="Quantity"  )
column=(type=char(50) updatewhereclause=yes name=uom dbname="UOM"  )
column=(type=decimal(9) updatewhereclause=yes name=valueextax dbname="ValueExTax"  )
column=(type=decimal(6) updatewhereclause=yes name=fixedvalueonretail dbname="FixedValueOnRetail"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="SalesTax"  )
column=(type=long updatewhereclause=yes name=extratax dbname="ExtraTax"  )
column=(type=long updatewhereclause=yes name=stwithheldatsource dbname="STWithHeldAtSource"  )
column=(type=long updatewhereclause=yes name=srno dbname="SRNO"  )
column=(type=long updatewhereclause=yes name=itemsrno dbname="ItemSRNo"  )
column=(type=long updatewhereclause=yes name=furthertax dbname="FurtherTax"  )
column=(type=decimal(6) updatewhereclause=yes name=totalvalueofsales dbname="TotalValueOfSales"  )
 retrieve="SELECT 
	BuyerNTN = C.NTNNo,
	BuyerCNIC = C.NIC,
	BuyerName = A.Name,
	BuyerType = CC.Name,
	SaleOrigination=NULL,
	DocumentType='SI',
	DocumentNo = S.SaleInvCode,
	DocumentDate = S.Date,
	SaleType = STS.Name,
	Rate = STS.TaxPerc,
	Description = ISNULL(PCT.Description,'') + CASE WHEN LEN(ISNULL(PCT.Remarks,'')) > 0 THEN ' - ' + ISNULL(PCT.Remarks, '') ELSE '' END,
	Quantity = SUM(D.LooseQty + D.BonusQty),
	UOM = I.PackingDesc,
	ValueExTax = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)),
	FixedValueOnRetail = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01), 2) + SUM((D.LooseQty + D.Bonusqty) * D.UnitSalesTax),
	SalesTax = ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01), 2) + SUM((D.LooseQty + D.Bonusqty) * D.UnitSalesTax),
	ExtraTax = NULL,
	STWithHeldAtSource=NULL,
	SRNO = NULL,
	ItemSRNo=NULL,
	FurtherTax=NULL,
	TotalValueOfSales = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01), 2) + SUM((D.LooseQty + D.Bonusqty) * D.UnitSalesTax)
FROM 
	SaleLedger S, SaleDetail D, Customer C, Accounts A, Item I, CustomerCategory CC, SalesTaxSchedule STS, PCT
WHERE
	S.Posted='Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.SaleInvcode = D.SaleInvCode AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	C.CustCatCode = CC.CustCatCode AND
	D.ICode = I.ICode AND
	I.SalesTaxScheduleCode = STS.SalesTaxScheduleCode AND
	I.PCTCode = PCT.PCTCode
GROUP BY
	S.SaleInvCode,
	A.Name,
	S.Date,
	C.NTNNo,
	C.NIC,
	CC.Name,
	STS.Name,
	STS.TaxPerc,
	PCT.Description,
	PCT.Remarks,
	I.PackingDesc
UNION ALL
SELECT 
	BuyerNTN = C.NTNNo,
	BuyerCNIC = C.NIC,
	BuyerName = A.Name,
	BuyerType = CC.Name,
	SaleOrigination=NULL,
	DocumentType='SI',
	DocumentNo = S.SaleInvCode,
	DocumentDate = S.Date,
	SaleType = STS.Name,
	Rate = STS.TaxPerc,
	Description = ISNULL(PCT.Description,'') + CASE WHEN LEN(ISNULL(PCT.Remarks,'')) > 0 THEN ' - ' + ISNULL(PCT.Remarks, '') ELSE '' END,
	Quantity = SUM(D.LooseQty + D.BonusQty),
	UOM = I.PackingDesc,
	ValueExTax = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)),
	FixedValueOnRetail = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01), 2) + SUM((D.LooseQty + D.Bonusqty) * D.UnitSalesTax),
	SalesTax = ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01), 2) + SUM((D.LooseQty + D.Bonusqty) * D.UnitSalesTax),
	ExtraTax = NULL,
	STWithHeldAtSource=NULL,
	SRNO = NULL,
	ItemSRNo=NULL,
	FurtherTax=NULL,
	TotalValueOfSales = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01), 2) + SUM((D.LooseQty + D.Bonusqty) * D.UnitSalesTax)
FROM 
	CRS_SaleLedger S, CRS_SaleDetail D, Customer C, Accounts A, Item I, CustomerCategory CC, SalesTaxSchedule STS, PCT
WHERE
	S.ClientInstanceID = D.ClientInstanceID AND
	S.Posted='Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.SaleInvcode = D.SaleInvCode AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	C.CustCatCode = CC.CustCatCode AND
	D.ICode = I.ICode AND
	I.SalesTaxScheduleCode = STS.SalesTaxScheduleCode AND
	I.PCTCode = PCT.PCTCode
GROUP BY
	S.ClientInstanceID,
	S.SaleInvCode,
	A.Name,
	S.Date,
	C.NTNNo,
	C.NIC,
	CC.Name,
	STS.Name,
	STS.TaxPerc,
	PCT.Description,
	PCT.Remarks,
	I.PackingDesc
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="documentdate A, documentno A"
)
