release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=640 color="536870912" )
summary(height=216 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="ICatCode"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=saleamount dbname="SaleAmount"  )
column=(type=decimal(9) updatewhereclause=yes name=itemcost dbname="ItemCost"  )
column=(type=char(3) updatewhereclause=yes name=profitorloss dbname="ProfitOrLoss"  )
column=(type=decimal(6) updatewhereclause=yes name=margin dbname="Margin"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
 retrieve="SELECT
	ICatCode=C.ICatCode,
	Category=C.Name,
	I.ICode,
	AliasName=I.CustomICode,
	ItemName=I.Name,  
	Qty=ISNULL(SUM(D.saleqty), 0),
 	SaleAmount=ISNULL(SUM(CASE D.TYPE WHEN 'S' THEN +1 ELSE -1 END * 
		(D.itemvalue - (D.flatdisc * (D.itemvalue / CASE D.grossamt WHEN 0 THEN 1 ELSE D.grossamt END)))), 0),
	ItemCost=ISNULL(SUM(D.itemcost), 0),
	ProfitOrLoss=(Case when ISNULL(sum(D.itemcost), 0)<0 Then 'Los' Else 'Pft' end),
	Margin=ISNULL((ISNULL(SUM(CASE D.TYPE WHEN 'S' THEN +1 ELSE -1 END * 
		(D.itemvalue - (D.flatdisc * (D.itemvalue / CASE D.grossamt WHEN 0 THEN 1 ELSE D.grossamt END)))), 0) - 
		SUM(D.itemcost) ) * 100 / 
		Case ISNULL(SUM(CASE D.TYPE WHEN 'S' THEN +1 ELSE -1 END * 
				(D.itemvalue - (D.flatdisc * (D.itemvalue / CASE D.grossamt WHEN 0 THEN 1 ELSE D.grossamt END)))), 0) 
		WHEN 0 THEN 1 ELSE ISNULL(SUM(CASE D.TYPE WHEN 'S' THEN +1 ELSE -1 END * 
		(D.itemvalue - (D.flatdisc * (D.itemvalue / CASE D.grossamt WHEN 0 THEN 1 ELSE D.grossamt END)))), 0) END,  0),
	Bonus=ISNULL(SUM(D.bonus), 0)
FROM
	(SELECT ICatCode = M.ManfCode, Name=M.Name 
	FROM Manufacturer M 
	WHERE :as_group = 'M'
	UNION ALL
	SELECT ICatCode = C.ICatCode, Name=C.Name 
	FROM ItemCategory C 
	WHERE :as_group = 'C'
	UNION ALL
	SELECT ICatCode = L.ICCode, Name=L.Name 
	FROM ItemClass L 
	WHERE :as_group = 'L'
	UNION ALL
	SELECT ICatCode = P.PackCode, Name=P.Name 
	FROM ItemPacking P 
	WHERE :as_group = 'P') C,
	Item I
	LEFT OUTER JOIN 
 	(SELECT
		SL.saleinvcode,
		SD.icode,
		SaleQty=ISNULL(sum(SD.looseqty), 0) ,
		Bonus=ISNULL(sum(SD.bonusqty), 0) ,
		ItemCost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)), 2), 0),
		GrossValue = SUM(SD.looseqty * SD.saleprice ),
		ItemDiscValue = SUM((SD.looseqty * (SD.saleprice - SD.itemflatdisc))*
							 (.01 * SD.discperc) + SD.itemflatdisc ),
		InvItemDiscValue = SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*
								(1 - (.01 * SD.discperc) ) *  (.01 * SL.discperc) ),
		ItemValue=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*
			(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc)),
		GrossAmt=
			(SELECT SUM((SDD.looseqty*(SDD.saleprice - SDD.itemflatdisc)) *
				(1 - (.01 * SDD.discperc)) * (1- (.01 * SLL.discperc)))
			FROM	saledetail SDD, saleledger SLL
			WHERE SLL.saleinvcode=SL.saleinvcode and SLL.saleinvcode=SDD.saleinvcode
			GROUP BY SLL.saleinvcode),
		SL.flatdisc,
		catcode=SL.salecatcode,
		type='S'
	FROM
		saleledger SL,	 
		saledetail SD,
		item I
	WHERE 
		SD.icode=I.icode AND
		CASE :as_group 
			WHEN 'M' THEN I.ManfCode 
			WHEN 'C' THEN I.ICatCode 
			WHEN 'L' THEN I.ICCode 
			WHEN 'P' THEN I.PackCode 
		END IN (:ala_icatcode) AND
		SD.saleinvcode=SL.saleinvcode AND
		SL.date BETWEEN :adt_sdate AND :adt_ldate
	GROUP BY 
		 SL.saleinvcode,
		 SL.salesmancode,
		 SD.icode,
		 SL.salecatcode,
		 SL.discperc,
		 SL.flatdisc,
		 SL.invgstperc1,
		 SL.salecatcode
	UNION ALL
 	SELECT
		SL.saleinvcode,
		SD.icode,
		SaleQty=ISNULL(sum(SD.looseqty), 0) ,
		Bonus=ISNULL(sum(SD.bonusqty), 0) ,
		ItemCost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)), 2), 0),
		GrossValue = SUM(SD.looseqty * SD.saleprice ),
		ItemDiscValue = SUM((SD.looseqty * (SD.saleprice - SD.itemflatdisc))*
							 (.01 * SD.discperc) + SD.itemflatdisc ),
		InvItemDiscValue = SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*
								(1 - (.01 * SD.discperc) ) *  (.01 * SL.discperc) ),
		ItemValue=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*
			(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc)),
		GrossAmt=
			(SELECT SUM((SDD.looseqty*(SDD.saleprice - SDD.itemflatdisc)) *
				(1 - (.01 * SDD.discperc)) * (1- (.01 * SLL.discperc)))
			FROM	saleinvdetail SDD, saleledger SLL
			WHERE SLL.ImpactInventory = 'N' AND SLL.saleinvcode=SL.saleinvcode and SLL.saleinvcode=SDD.saleinvcode
			GROUP BY SLL.saleinvcode),
		SL.flatdisc,
		catcode=SL.salecatcode,
		type='S'
	FROM
		saleledger SL,	 
		saleinvdetail SD,
		item I
	WHERE	
		SL.ImpactInventory = 'N' AND 
		SD.icode=I.icode AND
		CASE :as_group 
			WHEN 'M' THEN I.ManfCode 
			WHEN 'C' THEN I.ICatCode 
			WHEN 'L' THEN I.ICCode 
			WHEN 'P' THEN I.PackCode 
		END IN (:ala_icatcode) AND
		SD.saleinvcode=SL.saleinvcode AND
		SL.date BETWEEN :adt_sdate AND :adt_ldate
	GROUP BY 
		 SL.saleinvcode,
		 SL.salesmancode,
		 SD.icode,
		 SL.salecatcode,
		 SL.discperc,
		 SL.flatdisc,
		 SL.invgstperc1,
		 SL.salecatcode
	UNION ALL
	SELECT
		SL.srinvcode,
		SD.icode,
		saleqty=-ISNULL(sum(SD.looseqty), 0) ,
		bonus=-ISNULL(sum(SD.bonusqty), 0) ,
		ItemCost=-ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)), 2), 0),
		GrossValue = SUM( SD.looseqty * SD.srprice ) ,
		ItemDiscValue = SUM((SD.looseqty * SD.srprice ) * (.01 * SD.discperc) ),
		InvItemDiscValue = SUM( ( (SD.looseqty * SD.srprice) *
									(1 - (.01 * SD.discperc) ) ) * (.01 * SL.discperc) ),
		ItemValue=SUM((SD.looseqty * SD.srprice *
			(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc))),
		GrossAmt=(SELECT SUM((SDD.looseqty * SDD.srprice *
				(1 - (.01 * SDD.discperc))) * (1- (.01 * SLL.discperc)))
			FROM	srdetail SDD, srledger SLL
			WHERE SLL.srinvcode=SL.srinvcode and SLL.srinvcode=SDD.srinvcode
			GROUP BY SLL.srinvcode),
		SL.flatdisc,
		catcode=SL.srcatcode,
		type='R'
	FROM
		SRLedger SL,	 
		SRDetail SD,
		Item I
	WHERE	
		SD.icode=I.icode AND
		CASE :as_group 
			WHEN 'M' THEN I.ManfCode 
			WHEN 'C' THEN I.ICatCode 
			WHEN 'L' THEN I.ICCode 
			WHEN 'P' THEN I.PackCode 
		END IN (:ala_icatcode) AND
		SD.srinvcode=SL.srinvcode AND
		SL.date BETWEEN :adt_sdate AND :adt_ldate
	GROUP BY
		 SL.srinvcode,
		 SL.salesmancode,
		 SD.icode,
		 SL.srcatcode,
		 SL.discperc,
		 SL.flatdisc,
		 SL.invgstperc1,
		 SL.srcatcode) AS D ON (I.ICode = D.ICode)
WHERE 
	CASE :as_group 
		WHEN 'M' THEN I.ManfCode 
		WHEN 'C' THEN I.ICatCode 
		WHEN 'L' THEN I.ICCode 
		WHEN 'P' THEN I.PackCode 
	END = C.ICatCode AND
	C.ICatCode IN (:ala_icatcode)
GROUP BY
	C.ICatCode,
	C.Name,
	I.ICode,
	I.CustomICode,
	I.name
ORDER BY
	C.Name,
	I.name

"
  arguments=(("as_group", string), ("ala_icatcode", numberlist), ("adt_sdate", datetime), ("adt_ldate", datetime))
 sort="category A, itemname A"
)
