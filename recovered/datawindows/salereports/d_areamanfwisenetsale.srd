release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=764 color="536870912" )
summary(height=120 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=decimal(6) updatewhereclause=yes name=netsale dbname="netsale"  )
column=(type=char(60) updatewhereclause=yes name=zone dbname="zone"  )
column=(type=char(60) updatewhereclause=yes name=areaname dbname="areaname"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(60) updatewhereclause=yes name=customeradd1 dbname="customeradd1"  )
column=(type=char(60) updatewhereclause=yes name=customeradd2 dbname="customeradd2"  )
column=(type=char(60) updatewhereclause=yes name=customercity dbname="customercity"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
 retrieve="SELECT netsale=isnull(sum(saleamount),0), 
		zone=(select name from zone where zonecode=:ar_zonecode),
		areaname=(select name from area where areacode=zoneareas.areacode),
		customer=(select name from accounts where acccode=customer.custcode),
		customeradd1=max(customer.address1),
		customeradd2=max(customer.address2),
		customercity=max(customer.city),
		manufacturer=(select name from manufacturer where manfcode=:ar_manfcode)
FROM

	zoneareas,
	customer 
	LEFT OUTER JOIN 
	(
		SELECT  
			custcode=SL.custcode,
			saleamount=(IsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2) * (1 - SL.discperc*0.01))  ,0))
		FROM
         saleledger SL,
    		saledetail SD
		WHERE
			SL.date>= :ar_sdate and SL.date<=:ar_ldate and
			SL.saleinvcode=SD.saleinvcode and
			SD.icode IN (select icode from item where manfcode=:ar_manfcode)
		Group by 
			SL.custcode,
			SL.saleinvcode

UNION ALL

		SELECT  
			custcode=SL.custcode,
			saleamount=(IsNull( sum(round(((SD.looseqty * SD.packunits) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2) * (1 - SL.discperc*0.01))  ,0))
		FROM
         saleledger SL,
    		saleinvdetail SD
		WHERE
			SL.ImpactInventory = 'N' AND
			SL.date>= :ar_sdate and SL.date<=:ar_ldate and
			SL.saleinvcode=SD.saleinvcode and
			SD.icode IN (select icode from item where manfcode=:ar_manfcode)
		Group by 
			SL.custcode,
			SL.saleinvcode

UNION ALL

	SELECT  
		custcode=SL.custcode,
		saleamount= (- 1)*(IsNull( sum(round(SD.srprice * ((SD.looseqty + SD.packqty * SD.packunits) - (.01 *  SD.discperc)),2)*(1 - SL.discperc*0.01))  ,0))

	FROM
    	srledger SL,
    	srdetail SD
	WHERE
		SL.date>= :ar_sdate and SL.date<=:ar_ldate and
		SL.srinvcode=SD.srinvcode and
		SD.icode IN (select icode from item where manfcode=:ar_manfcode)

	Group by 
		SL.custcode,
		SL.srinvcode
	) AS A ON (customer.custcode=A.custcode)

WHERE
	zoneareas.zonecode=:ar_zonecode and
	zoneareas.areacode=customer.areacode 
Group By
	zoneareas.zonecode,
	zoneareas.areacode,
	customer.custcode
Order By
	areaname,
	customer"
  arguments=(("ar_zonecode", number), ("ar_manfcode", number), ("ar_sdate", datetime), ("ar_ldate", datetime))
)
