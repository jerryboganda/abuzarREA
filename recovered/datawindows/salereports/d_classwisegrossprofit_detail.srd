release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=648 color="536870912" )
summary(height=276 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=class dbname="Class"  )
column=(type=long updatewhereclause=yes name=iccode dbname="ICCode"  )
column=(type=decimal(8) updatewhereclause=yes name=sales dbname="Sales"  )
column=(type=decimal(9) updatewhereclause=yes name=ret dbname="Ret"  )
column=(type=decimal(9) updatewhereclause=yes name=cgs dbname="CGS"  )
column=(type=decimal(9) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
 retrieve="SELECT	
	Class=R.Class,
	R.ICCode, 
	Sales=ROUND(SUM(R.Sales), 0),
	Ret=ROUND(SUM(R.Ret), 0),
	CGS=ROUND(SUM(R.CGS), 0),
	Stock=ROUND(SUM(R.Stock), 0),
	itemname=R.itemname

FROM
(SELECT	
	Class=IC.name,
	IC.ICCode,
	Sales=SUM(S.Value),
	Ret=0,
	CGS=-SUM(S.Cost),
	Stock=0,
	itemname=I.name
FROM	
	(SELECT	SD.ICode, 
	IsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2))  ,0) AS Value,
	SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice) AS Cost
	FROM	SaleLedger SL, SaleDetail SD
	WHERE	SL.SaleInvCode = SD.SaleInvCode AND
		SL.Date >= :ar_startdate AND SL.Date <= :ar_enddate
	GROUP BY SL.SaleInvCode, SD.ICode
	UNION ALL
	SELECT	SD.ICode, 
	IsNull( sum(round(((SD.looseqty) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2))  ,0) AS Value,
	SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice) AS Cost
	FROM	SaleLedger SL, SaleInvDetail SD
	WHERE	SL.ImpactInventory='N' AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SL.Date >= :ar_startdate AND SL.Date <= :ar_enddate
	GROUP BY SL.SaleInvCode, SD.ICode) S,
	Item I, ItemClass IC
WHERE	
	S.ICode = I.ICode AND
	I.ICCode = IC.ICCode AND
	IC.ICCode IN (:ar_class)
GROUP BY 
	I.name,
	IC.name,
	IC.ICCode
UNION ALL
SELECT	
	Class=IC.name,
	IC.ICCode,
	Sales=0,
	Ret=-SUM(S.Value),
	CGS=SUM(S.Cost),
	Stock=0,
	itemname=I.name
FROM	
	(SELECT	SD.ICode, 
	IsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * SD.srprice ) * (1 - (.01 *  SD.discperc)),2))  ,0) AS Value,
	SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice) AS Cost
	FROM	SRLedger SL, SRDetail SD
	WHERE	SL.SRInvCode = SD.SRInvCode AND
		SL.Date >= :ar_startdate AND SL.Date <= :ar_enddate
	GROUP BY SL.SRInvCode, SD.ICode) S,
	Item I, ItemClass IC
WHERE	
	S.ICode = I.ICode AND
	I.ICCode = IC.ICCode AND
	IC.ICCode IN (:ar_class)
GROUP BY 
	I.name,
	IC.name,
	IC.ICCode
UNION ALL
SELECT	
	Class=IC.name,
	IC.ICCode,
	Sales=0,
	Ret=0,
	CGS=0,
	Stock=SUM(S.CurrQty * I.AvgPrice),
	itemname=I.name
FROM	
	GodownDetail S,
	Item I, ItemClass IC
WHERE	
	S.ICode = I.ICode AND
	I.ICCode = IC.ICCode AND
	IC.ICCode IN (:ar_class)
GROUP BY 
	I.name,
	IC.name,
	IC.ICCode) R
GROUP BY 
	R.itemname,
	R.Class,
	R.ICCode
ORDER BY
	R.Class,
	R.itemname,
	R.ICCode
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_class", numberlist))
)
