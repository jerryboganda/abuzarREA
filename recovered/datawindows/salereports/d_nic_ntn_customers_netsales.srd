table(column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(30) updatewhereclause=yes name=cnic dbname="CNIC"  )
column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
column=(type=datetime updatewhereclause=yes name=invdate dbname="InvDate"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="Amount"  )
 retrieve="SELECT 
	GroupName,
	AliasName,
	AccountName,
	Address,
	CNIC,
	NTN,
	InvDate=MAX(InvDate),
	InvCode,
	Amount = SUM(Amount)
FROM
	(SELECT 
		GroupName=CASE :as_Grouping
			WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)
			WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)
			WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)
			ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
		AccCode=A.AccCode, 
		AliasName=A.AliasName,
		AccountName=A.Name,
		Address=C.Address1,
		CNIC = C.NIC,
		NTN = C.NTNNo,
		InvDate = S.Date,
		InvCode = S.SaleInvCode,
		Amount = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM 
		SaleLedger S, SaleDetail D, Item I, Customer C, Accounts A
	WHERE
		S.DATE BETWEEN :adt_startdate AND :adt_enddate AND
		S.SaleInvCode = D.SaleInvCode AND
		S.CustCode = C.CustCode AND 
		C.CustCode = A.AccCode AND
		(C.NIC IS NOT NULL OR C.NTNNo IS NOT NULL) AND
		D.ICode = I.ICode AND
		CASE :as_Grouping
			WHEN 'M' THEN I.MANFCODE
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PACKCODE 
		END IN (:ai_groupcode)
	GROUP BY
		A.AccCode, 
		A.AliasName,
		A.Name,
		C.Address1,
		C.NIC,
		C.NTNNo,
		S.Date,
		S.SaleInvCode,
		I.ManfCode,
		I.ICatCode,
		I.ICCode,
		I.PackCode
	UNION ALL
	SELECT 
		GroupName=CASE :as_Grouping
			WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)
			WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)
			WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)
			ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
		AccCode=A.AccCode, 
		AliasName=A.AliasName,
		AccountName=A.Name,
		Address=C.Address1,
		CNIC = C.NIC,
		NTN = C.NTNNo,
		InvDate = S.Date,
		InvCode = S.SaleInvCode,
		Amount = - SUM(D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM 
		SRLedger S, SRDetail D, Item I, Customer C, Accounts A
	WHERE
		S.DATE BETWEEN :adt_startdate AND :adt_enddate AND
		S.SRInvCode = D.SRInvCode AND
		S.CustCode = C.CustCode AND 
		C.CustCode = A.AccCode AND
		S.SaleInvCode > 0 AND
		(C.NIC IS NOT NULL OR C.NTNNo IS NOT NULL) AND
		D.ICode = I.ICode AND
		CASE :as_Grouping
			WHEN 'M' THEN I.MANFCODE
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PACKCODE 
		END IN (:ai_groupcode)
	GROUP BY
		A.AccCode, 
		A.AliasName,
		A.Name,
		C.Address1,
		C.NIC,
		C.NTNNo,
		S.Date,
		S.SaleInvCode,
		S.SRInvCode,
		I.ManfCode,
		I.ICatCode,
		I.ICCode,
		I.PackCode) T
GROUP BY
	GroupName,
	AccountName,
	AliasName,
	AccountName,
	Address,
	CNIC,
	NTN,
	InvCode
ORDER BY
	GroupName,
	AccountName,
	AliasName,
	Address,
	CNIC,
	NTN,
	InvCode
	
"
  arguments=(("as_Grouping", string), ("ai_groupcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="groupname A, invdate A, accountname A, invcode A"
)
