compute(name=compute_3 visible="1	0" band=trailer.1 font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="3218" y="10" height="197" width="750" format="[general]" expression="sum(grand_sum_value for group 1)" alignment="1" border="0" crosstab.repeat=no )
