compute(name=grand_sum_value visible="1	if( crosstabsum(1) =0,0,1)" band=detail font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" x="3218" y="11" height="177" width="750" format="###,###,###0.00" expression="crosstabsum(1)" alignment="1" border="0" crosstab.repeat=no )
