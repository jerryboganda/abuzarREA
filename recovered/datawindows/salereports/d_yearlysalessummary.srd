release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 grid.lines=1 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1072 color="536870912" )
header[2](height=354 color="536870912" )
summary(height=197 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=groupname dbname="groupname"  )
column=(type=number updatewhereclause=yes name=groupcode dbname="groupcode"  )
column=(type=number updatewhereclause=yes name=value dbname="value"  )
 retrieve="SELECT 
	YEAR=code1,
	GROUPCODE=CODE2,
	GROUPNAME=NAME1,
	VALUE=VALUE1
FROM REPORTDATA
ORDER BY
	NAME1,
	CODE1"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="groupname A, groupcode A"
)
group(level=1 header.height=0 trailer.height=0 by=("groupname"  ) header.color="536870912" trailer.color="536870912" )
compute(name=compute_76 moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="5437" y="52" height="166" width="1562" format="[GENERAL]" expression="'Page ' + page() + ':' + pageAcross() + ' of ' + pageCount() + ':' + pageCountAcross()" alignment="1" border="0" crosstab.repeat=no )
