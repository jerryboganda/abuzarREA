table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=char(60) updatewhereclause=yes name=country dbname="country"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=long updatewhereclause=yes name=issueinvcode dbname="issueinvcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=issueheader_recipientcode dbname="IssueHeader.recipientcode"  )
column=(type=char(50) updatewhereclause=yes name=issueheader_referenceno dbname="IssueHeader.referenceno"  )
column=(type=char(100) updatewhereclause=yes name=issueheader_remarks dbname="IssueHeader.remarks"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(5) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="itempacking"  )
column=(type=char(100) updatewhereclause=yes name=itemdescription dbname="itemdescription"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
 retrieve="SELECT 
	itemname= item.name,
	accname =  accounts.name,
	packingdesc=max(item.packingdesc),
	aliasname=max(item.customicode),
	address = max( customer.address1),
	city = max( customer.city),
	country = max( customer.country),
	salesperson = ( Select Name From SalesMan Where SalesManCode = Max( SaleLedger.SManCode) ),
	salesman =  users.username,  
	issueinvcode =  saleledger.issueinvcode, 
	headerno = max( saleledger.headerno),
	headerinvno = max( saleledger.headerinvno),  
	date =  saleledger.date,   
	saleledger.recipientcode,
	saleledger.referenceno,	
	saleledger.remarks,	
	gcode = saledetail.gcode,   
	icode = saledetail.icode,   
	batch = max(saledetail.batch),   
	expiry = max(saledetail.expiry),   
	qty = isnull(sum(saledetail.qty  ),0),
	looseqty = isnull(sum(saledetail.qty),0),
	packunits= max(saledetail.packunits),
	saleprice= max(saledetail.price),
	itempacking = max(itempacking.name),
	itemdescription = max(saledetail.itemdescription),	
	Godown =max(Godown.name),	
	Id       = max( saledetail.IDENTITYCOL) 
	
FROM  
	issueheader saleledger, 
	issuedetail saledetail, 
	accounts, 
	customer,
	Godown,
	users, 
	item LEFT OUTER JOIN ItemPacking ON (dbo.item.packcode = dbo.itempacking.packcode)
	
WHERE 
	(  saleledger.issueinvcode Between :ar_SInvCode And :ar_LInvCode) AND
	(  saleledger.issueinvcode =  saledetail.issueinvcode) AND
	(  saleledger.acccode =  accounts.acccode ) AND 
	(  customer.custcode =  accounts.acccode ) AND 
	(  saleledger.salesmancode =  users.usercode ) AND 
	(  saledetail.icode =  item.icode) and 
	(  saledetail.gcode =  godown.gcode)
	
GROUP BY 
	saleledger.issueinvcode, 
	saleledger.date, 
	saleledger.recipientcode, 
	saleledger.remarks,
	saleledger.referenceno, 
	saledetail.icode,
	saledetail.rowgroup, 
	saledetail.gcode, 
	item.name,
	item.icode,
	item.printable, 
	accounts.name,
	users.username
ORDER BY
	saleledger.issueinvcode, 
	item.name
"
  arguments=(("ar_SInvCode", number), ("ar_LInvCode", number), ("ar_printdate", string))
 sort="issueinvcode A, itemname A"
)
