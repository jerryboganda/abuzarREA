table(column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="icatcode"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="ItemAliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(6) updatewhereclause=yes name=grossvalue dbname="GrossValue"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(10) updatewhereclause=yes name=discvalue dbname="DiscValue"  )
column=(type=decimal(10) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(2) updatewhereclause=yes name=claimablediscperc dbname="ClaimAbleDiscPerc"  )
column=(type=decimal(10) updatewhereclause=yes name=claimvalue dbname="ClaimValue"  )
 retrieve="SELECT
	Manufacturer = M.Name,
	SaleInvCode = S.SaleInvCode,
	Date = S.Date,
	AliasName = A.AliasName,
	itemcategory=(select name from itemcategory where itemcategory.icatcode=I.icatcode),
	icatcode=I.icatcode,
	CustomerName = A.Name,
	ItemAliasName = I.CustomICode,
	ItemName = I.Name,
	Qty = SD.LooseQty,
	Bonus = SD.BonusQty,
	SalePrice = SD.SalePrice,
	GrossValue = Round(SD.LooseQty * SD.SalePrice, 2), 
	DiscPerc = SD.DiscPerc,
	DiscValue = ROUND(SD.LooseQty * SD.SalePrice * SD.DiscPerc * 0.01, 2),
	SaleValue = Round(SD.LooseQty * SD.SalePrice * (1 - SD.DiscPerc * 0.01), 2),
	ClaimAbleDiscPerc = SD.DiscPerc - CASE WHEN :d_unclaimeddiscperc > SD.DiscPerc THEN SD.DiscPerc ELSE :d_unclaimeddiscperc END,
	ClaimValue = ROUND(SD.LooseQty * SD.SalePrice * (SD.DiscPerc - CASE WHEN :d_unclaimeddiscperc > SD.DiscPerc THEN SD.DiscPerc ELSE :d_unclaimeddiscperc END) * 0.01, 2)
FROM
	SaleLedger S,
	SaleDetail SD,
	Accounts A,
	Item I,
	Manufacturer M
WHERE
	S.Date BETWEEN :ad_startdate AND :ad_enddate AND
	S.Posted = 'Y' AND
	S.SaleInvCode = SD.SaleInvCode AND
	S.CustCode = A.AccCode AND
	SD.DiscPerc BETWEEN :d_startdiscperc AND :d_enddiscperc AND
	SD.ICode = I.ICode AND
	I.ManfCode = M.ManfCode AND
	M.ManfCode IN (:ai_manfcode)
ORDER BY
	Manufacturer,
	SaleInvCode,
	Date,
	CustomerName,
	I.Name
"
  arguments=(("ai_manfcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime), ("d_startdiscperc", number), ("d_enddiscperc", number), ("d_unclaimeddiscperc", number))
 sort="manufacturer A, saleinvcode A, date A, customername A, itemname A"
)
