table(column=(type=char(60) updatewhereclause=yes name=salespercon dbname="SalesPercon"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="PacKing"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=netsaleqty dbname="NetSaleQty"  )
column=(type=decimal(6) updatewhereclause=yes name=netsalevalue dbname="NetSaleValue"  )
column=(type=decimal(6) updatewhereclause=yes name=incentivevalue dbname="IncentiveValue"  )
 retrieve="SELECT 
	SalesPercon = U.userName,
	Manufacturer = (SELECT M.NAME FROM Manufacturer M WHERE M.ManfCode = :ai_manfcode),
	PacKing = IP.Name,
	ItemName = I.Name, 
	NetSaleQty = SUM(S.Qty), 
	NetSaleValue = SUM(S.Value),
	IncentiveValue = (ISNULL(SUM(S.Value), 0) * :ai_incentiveperc) / 100
FROM  
	(SELECT 
		USerCode=SL.SalesManCode,
		ICode=SD.ICode, 
		Qty = SUM(SD.LooseQty), 
		Value = ROUND(SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ), 2)
	FROM 
		SaleLedger SL, SaleDetail SD, Item I
	WHERE 
		SL.DATE BETWEEN :adt_startdate AND :adt_enddate AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = :ai_manfcode AND
		SL.SalesManCode IN (:ai_smancode)
	GROUP BY
		SL.SalesManCode,
		SD.ICode
	UNION ALL
	SELECT 
		userCode=SL.SalesManCode,
		ICode=SD.ICode, 
		Qty = - SUM(SD.LooseQty), 
		Value = - ROUND(SUM(SD.LooseQty * SD.SRPrice* (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ), 2)
	FROM 
		SRLedger SL, SRDetail SD, Item I
	WHERE 
		SL.DATE BETWEEN :adt_startdate AND :adt_enddate AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = :ai_manfcode AND
		SL.SalesManCode IN (:ai_smancode)
	GROUP BY
		SL.SalesManCode,
		SD.ICode) S,
	Item I LEFT OUTER JOIN ItemPackIng AS IP ON (I.PackCode = IP.PackCode), 
	USERS U
WHERE
	S.ICode = I.ICode AND
	I.ManfCode = :ai_manfcode AND
	S.userCode = U.UserCode
GROUP BY
	U.UserName,
	IP.Name,
	I.Name"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_manfcode", number), ("ai_smancode", numberlist), ("ai_incentiveperc", number))
 sort="salespercon A, packing A"
)
