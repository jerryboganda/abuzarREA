release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2145 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=item dbname="item"  )
column=(type=long updatewhereclause=yes name=accode dbname="accode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="phone"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="custalias"  )
column=(type=char(60) updatewhereclause=yes name=addres1 dbname="addres1"  )
column=(type=char(60) updatewhereclause=yes name=subarea dbname="subarea"  )
 retrieve="SELECT item=(select name from item where item.icode=:ai_icode),
		accode=ACC.acccode,
		customer=ACC.name,
		phone=customer.phone,
		custalias=ACC.aliasname,
		addres1=customer.address1,
		subarea=SA.name
FROM 	Accounts ACC,
			SubArea SA,
			customer

WHERE
			customer.subareacode IN (:aa_subareacode) and
			Customer.custcode=ACC.acccode and
			customer.subareacode=SA.subareacode and
			customer.custcode not in (	select SL.custcode
												from saleledger SL,saledetail SD ,(	select 
																									custcode
																									from customer CUST
																									where 
																										CUST.subareacode in (:aa_subareacode) ) as C
												
													where 	SL.date>=:ad_sdate and
																SL.date<=:ad_edate and
																SL.custcode=C.custcode and
																SL.saleinvcode=SD.saleinvcode and
																SD.icode  = :ai_icode
												
												)

ORDER BY 	subarea,
	 			customer



"
  arguments=(("ad_sdate", datetime), ("ad_edate", datetime), ("aa_subareacode", numberlist), ("ai_icode", number))
)
