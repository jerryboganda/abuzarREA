table(column=(type=char(20) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(20) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=char(20) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(20) updatewhereclause=yes name=area dbname="area"  )
column=(type=decimal(0) updatewhereclause=yes name=netsaleqty dbname="netsaleqty"  )
column=(type=decimal(0) updatewhereclause=yes name=netsalevalue dbname="netsalevalue"  )
 retrieve="SELECT
	Manufacturer = M.Name,
	SalesPerson=SM.Name,
	Customer = A.Name,
	Area = AR.Name,
	ItemName=I.Name,
	NetSaleQty = SUM(S.Qty),
	NetSaleValue = SUM(S.Value)
FROM
	Accounts A,
	Customer C,
	Area AR,
	Item I,
	Manufacturer M,
	SalesMan SM,
	(SELECT
		ManfCode=:ai_manfcode,
		SManCode=1,
		CustCode=19,
		ICode,
		Qty = 0.0000,
		Value = 0.00
	FROM
		Item
	WHERE
		ManfCode = :ai_manfcode
	UNION ALL
	SELECT
		I.ManfCode,
		SL.SManCode,
		SL.CustCode,
		SD.ICode,
		Qty = SUM(SD.LooseQty),
		Value = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) )
	FROM
		SaleLedger SL, SaleDetail SD, Item I
	WHERE
		SL.Date >= :ad_startdate AND
		SL.Date <= :ad_enddate AND
		SL.SManCode IN (:ai_smancode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = :ai_manfcode
	GROUP BY 
		I.ManfCode,
		SL.SManCode,
		SL.CustCode,
		SD.ICode
	UNION ALL
	SELECT
		I.ManfCode,
		SL.SManCode,
		SL.CustCode,
		SD.ICode,
		Qty = SUM(SD.LooseQty),
		Value = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) )
	FROM
		SaleLedger SL, SaleInvDetail SD, Item I
	WHERE
		SL.ImpactInventory = 'N' AND
		SL.Date >= :ad_startdate AND
		SL.Date <= :ad_enddate AND
		SL.SManCode IN (:ai_smancode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = :ai_manfcode
	GROUP BY 
		I.ManfCode,
		SL.SManCode,
		SL.CustCode,
		SD.ICode
	UNION ALL
	SELECT
		I.ManfCode,
		SL.SManCode,
		SL.CustCode,
		SD.ICode,
		Qty = - SUM(SD.LooseQty),
		Value = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) )
	FROM
		SRLedger SL, SRDetail SD, Item I
	WHERE
		SL.Date >= :ad_startdate AND
		SL.Date <= :ad_enddate AND
		SL.SManCode IN (:ai_smancode) AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = :ai_manfcode
	GROUP BY 
		I.ManfCode,
		SL.SManCode,
		SL.CustCode,
		SD.ICode) S
WHERE
	I.ICode = S.ICode AND
	I.ManfCode = M.ManfCode AND
	M.ManfCode = :ai_manfcode AND
	S.SManCode = SM.SalesManCode AND
	SM.SalesmanCode IN (:ai_smancode) AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	C.AreaCode = AR.AreaCode
GROUP BY
	M.Name,
	I.ManfCode,
	SM.Name,
	A.Name,
	AR.Name,
	I.Name
ORDER BY
	SalesPerson,
	Manufacturer,
	Customer,
	ItemName
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_smancode", numberlist), ("ai_manfcode", number))
 sort="manufacturer A, salesperson A, customer A, area A"
)
