datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1302 color="536870912" )
summary(height=437 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=decimal(6) updatewhereclause=yes name=grossamt dbname="GrossAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=saleamt dbname="SaleAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=discountamt dbname="DiscountAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=returnamt dbname="ReturnAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=latereturnamt dbname="LateReturnAmt"  )
 retrieve="SELECT 
	Manufacturer,
	AreaCode,
	Area,
	GrossAmt = SUM(GrossAmt),
	SaleAmt = SUM(SaleAmt),
	DiscountAmt = SUM(DiscountAmt),
	ReturnAmt = SUM(CASE WHEN RetType IS NULL OR RetType = 'L' THEN 0 ELSE ReturnAmt END),
	LateReturnAmt = SUM(CASE WHEN RetType IS NULL OR RetType = 'N' THEN 0 ELSE ReturnAmt END)
FROM
	(SELECT
		RetType = NULL,
		Manufacturer=M.Name,
		AreaCode = AR.AreaCode,
		Area = AR.Name,
		GrossAmt = SUM(SD.LooseQty * SD.SalePrice),
		SaleAmt = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
		DiscountAmt = SUM(SD.LooseQty * SD.SalePrice) - SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
		ReturnAmt = 0.0000
	FROM
		SaleLedger SL, SaleDetail SD, Customer C, Accounts AC, Area AR, Item I, Manufacturer M
	WHERE
		SL.Date BETWEEN :adt_StartDate AND :adt_EndDate AND 
		SL.SaleInvCode = SD.SaleInvCode AND 
		SD.ICode = I.ICode AND 
		I.ManfCode = M.ManfCode AND 
		M.ManfCode IN (:ai_manfcode) AND
		SL.CustCode = C.CustCode AND
		C.CustCode = AC.AccCode AND
		C.AreaCode = AR.AreaCode AND
		AR.AreaCode IN (:ai_areacode)
	GROUP BY
		SL.SaleInvCode,
		SL.Date,
		SD.ICode,
		M.Name,
		AR.AreaCode,
		AR.Name
	UNION ALL
	SELECT
		RetType = NULL,
		Manufacturer=M.Name,
		AreaCode = AR.AreaCode,
		Area = AR.Name,
		GrossAmt = SUM(SD.LooseQty * SD.SalePrice),
		SaleAmt = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
		DiscountAmt = SUM(SD.LooseQty * SD.SalePrice) - SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
		ReturnAmt = 0.0000
	FROM
		SaleLedger SL, SaleInvDetail SD, Customer C, Accounts AC, Area AR, Item I, Manufacturer M
	WHERE
		SL.Date BETWEEN :adt_StartDate AND :adt_EndDate AND 
		SL.SaleInvCode = SD.SaleInvCode AND 
		SD.ICode = I.ICode AND 
		I.ManfCode = M.ManfCode AND 
		M.ManfCode IN (:ai_manfcode) AND
		SL.CustCode = C.CustCode AND
		C.CustCode = AC.AccCode AND
		C.AreaCode = AR.AreaCode AND
		AR.AreaCode IN (:ai_areacode)
	GROUP BY
		SL.SaleInvCode,
		SL.Date,
		SD.ICode,
		M.Name,
		AR.AreaCode,
		AR.Name
	UNION ALL
	SELECT
		RetType = 
			CASE 
				WHEN SaleInvCode > 0 THEN 
					CASE WHEN MONTH(SL.Date) <> (SELECT MONTH(S.Date) FROM SaleLedger S WHERE S.SaleInvCode = SL.SaleInvCode) THEN 'L' ELSE 'N' END
			ELSE 'N' END,
		Manufacturer=M.Name,
		AreaCode = AR.AreaCode,
		Area = AR.Name,
		GrossAmt = 0.0000,
		SaleAmt =  0.0000,
		DiscountAmt =  0.0000,
		ReturnAmt = SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))
	FROM
		SRLedger SL, SRDetail SD, Customer C, Accounts AC, Area AR, Item I, Manufacturer M
	WHERE
		SL.Date BETWEEN :adt_StartDate AND :adt_EndDate AND 
		SL.SRInvCode = SD.SRInvCode AND 
		SD.ICode = I.ICode AND 
		I.ManfCode = M.ManfCode AND 
		M.ManfCode IN (:ai_manfcode) AND
		SL.CustCode = C.CustCode AND
		C.CustCode = AC.AccCode AND
		C.AreaCode = AR.AreaCode AND
		AR.AreaCode IN (:ai_areacode)
	GROUP BY
		SL.SaleInvCode,
		SL.SRInvCode,
		SL.Date,
		SD.ICode,
		M.Name,
		AR.AreaCode,
		AR.Name) T
GROUP BY
	Manufacturer,
	AreaCode,
	Area
ORDER BY
	Manufacturer,
	Area
"
  arguments=(("ai_manfcode", numberlist), ("ai_areacode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
