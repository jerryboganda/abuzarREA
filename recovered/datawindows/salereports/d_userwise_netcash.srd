table(column=(type=long updatewhereclause=yes name=reporttype dbname="ReportType"  )
column=(type=char(21) updatewhereclause=yes name=reportgroup dbname="ReportGroup"  )
column=(type=long updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=char(60) updatewhereclause=yes name=description dbname="Description"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
 retrieve="SELECT  
	ReportType=1,
	ReportGroup='Sales Summary',
	RowID=1,
	Description= 'Total Sales',
	Amount = SUM(S.InvTotal),
	UserName=U.UserNAme
FROM 
	SaleLedger S, Users U
WHERE 
	S.SalesManCode=:ai_usercode AND
	S.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
	S.SalesManCode=U.UserCode
GROUP BY
	U.UserNAme
UNION ALL
SELECT 
	ReportType=1,
	ReportGroup='Sales Summary',
	RowID=2,
	Description= 'Credit Sales',
	Amount=-ISNULL(SUM(S.InvTotal), 0),
	UserName=U.UserNAme
FROM 
	SaleLedger S, Users U
WHERE 
	S.SalesManCode=:ai_usercode AND
	S.SaleCatCode <> 3 AND 
	S.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
	S.SalesManCode=U.UserCode
GROUP BY
	U.UserNAme
UNION ALL
SELECT 
	ReportType=1,
	ReportGroup='Sales Summary',
	RowID=3,
	Description= 'Partial Credit Sales',
	Amount = -ISNULL(SUM(S.InvTotal - S.CashCharged), 0),
	UserName=U.UserNAme
FROM 
	SaleLedger S, Users U
WHERE 
	S.SalesManCode=:ai_usercode AND
	S.CashCharged> 0 AND
	(S.CashCharged < S.InvTotal) AND 
	S.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
	S.SalesManCode=U.UserCode
GROUP BY
	U.UserNAme
UNION ALL
SELECT 
	ReportType=1,
	ReportGroup='Sales Summary',
	RowID=4,
	Description= 'Cash Returns',
	Amount = -ISNULL(SUM(S.Amt), 0),
	UserName=S.UserNAme
FROM
	(SELECT 
		amt=SUM(S.CashCharged), U.UserNAme
	FROM 
		SRLedger S, Users U
	WHERE 
		S.SalesManCode=:ai_usercode AND
		(S.CashCharged > 0) AND 
		S.Date BETWEEN :ar_StartDate AND :ar_EndDate	 AND
		S.SalesManCode=U.UserCode
	GROUP BY
		U.UserNAme
	UNION ALL
	SELECT 
		amt=SUM(S.InvTotal), U.UserNAme
	FROM 
		SRLedger S, Users U
	WHERE 
		S.SalesManCode=:ai_usercode AND
		(S.CashCharged = 0) AND 
		S.Date BETWEEN :ar_StartDate AND :ar_EndDate	 AND
		S.SalesManCode=U.UserCode AND
		S.SRCatCode IN (6,8)
	GROUP BY
		U.UserNAme	) s
GROUP BY
	S.UserNAme
UNION ALL
SELECT 
	ReportType=2,
	ReportGroup='Credit Customer Sales',
	RowID=1,
	Description= A.Name,
	Amount = ISNULL(SUM(S.InvTotal - S.CashCharged), 0),
	UserName=U.UserNAme
FROM 
	SaleLedger S, Users U, Accounts A
WHERE 
	S.SalesManCode=:ai_usercode AND
	((S.CashCharged > 0 AND S.CashCharged < S.InvTotal) OR (S.CashCharged=0)) AND
	S.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
	S.SalesManCode=U.UserCode AND
	S.CustCode=A.AccCode
GROUP BY
	S.Custcode,
	A.Name,
	U.UserNAme
UNION ALL
SELECT 
	ReportType=3,
	ReportGroup='Credit Cards Summary',
	RowID=1,
	Description= A.Name,
	Amount = SUM(CW.Amount),
	UserName=U.UserNAme
FROM 
	SaleLedger S, Users U, Accounts A, Cashierwindow CW
WHERE 
	S.SalesManCode=:ai_usercode AND
	S.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
	S.SalesManCode=U.UserCode AND
	S.SaleInvCode = CW.SaleInvCode AND
	CW.AccCode=A.AccCode
GROUP BY
	CW.AccCode,
	A.Name,
	U.UserNAme
ORDER BY
	ReportType, RowID"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ai_usercode", number))
 sort="reporttype A, rowid A"
)
