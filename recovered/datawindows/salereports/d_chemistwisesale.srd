release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(169) updatewhereclause=yes name=report dbname="REPORT"  )
 retrieve="SELECT
	REPORT=RTRIM(LTRIM(DISTCODE)) + ',' +
	RTRIM(LTRIM(CHEMCODE)) + ',' +
	RTRIM(LTRIM(CHEMTYPE)) + ',' +
	RTRIM(LTRIM(PRODCODE)) + ',' +
	RTRIM(LTRIM(STR(SALES))) + ',' +
	RTRIM(LTRIM(FRM)) + ',' +
	RTRIM(LTRIM(T))
FROM 
(SELECT
	DISTCODE=:AS_DISTCODE,
	CHEMCODE=RTRIM(LTRIM(A.ALIASNAME)),
	CHEMTYPE=CASE SOUNDEX(CT.NAME) 
			WHEN 'RETAILER' THEN 'R'
			WHEN 'WHOLE SALER' THEN 'W'
			WHEN 'INSTITUTE' THEN 'I'
			ELSE LEFT(CT.NAME, 1) END,
	PRODCODE=RTRIM(LTRIM(I.CUSTOMICODE)),
	SALES=SUM((SD.LOOSEQTY + SD.BONUSQTY)),
	FRM= LTRIM(STR(DATEPART(DAY, :ad_startdate))) + '/' + LTRIM(STR(DATEPART(MONTH, :ad_startdate))) + '/' + LTRIM(STR(DATEPART(YEAR, :ad_startdate))), 
	T=LTRIM(STR(DATEPART(DAY, :ad_enddate))) + '/' + LTRIM(STR(DATEPART(MONTH, :ad_enddate))) + '/' + LTRIM(STR(DATEPART(YEAR, :ad_enddate)))

FROM
	SALELEDGER SL, 
	MANUFACTURER MA, 
	SALEDETAIL SD,
	ITEM I, 
	CUSTOMER C, 
	CUSTOMERCATEGORY CT, 
	ACCOUNTS A

WHERE 
	SL.DATE BETWEEN GETDATE()-100 AND GETDATE() AND
	SL.SALEINVCODE = SD.SALEINVCODE AND
	SD.ICODE = I.ICODE AND
	I.MANFCODE = MA.MANFCODE AND
	MA.MANFCODE = :ai_ManfCode AND
	SL.CUSTCODE = C.CUSTCODE AND
	C.CUSTCODE = A.ACCCODE AND
	C.CUSTCATCODE = CT.CUSTCATCODE

GROUP BY 
	A.ALIASNAME,
	CT.NAME,
	I.CUSTOMICODE,
	I.ICODE

UNION ALL
SELECT
	DISTCODE=:AS_DISTCODE,
	CHEMCODE=RTRIM(LTRIM(A.ALIASNAME)),
	CHEMTYPE=CASE SOUNDEX(CT.NAME) 
			WHEN 'RETAILER' THEN 'R'
			WHEN 'WHOLE SALER' THEN 'W'
			WHEN 'INSTITUTE' THEN 'I'
			ELSE LEFT(CT.NAME, 1) END,
	PRODCODE=RTRIM(LTRIM(I.CUSTOMICODE)),
	SALES=-SUM((SD.LOOSEQTY + SD.BONUSQTY)),
	FRM= LTRIM(STR(DATEPART(DAY, :ad_startdate))) + '/' + LTRIM(STR(DATEPART(MONTH, :ad_startdate))) + '/' + LTRIM(STR(DATEPART(YEAR, :ad_startdate))), 
	T=LTRIM(STR(DATEPART(DAY, :ad_enddate))) + '/' + LTRIM(STR(DATEPART(MONTH, :ad_enddate))) + '/' + LTRIM(STR(DATEPART(YEAR, :ad_enddate)))

FROM
	SRLEDGER SL, 
	MANUFACTURER MA, 
	SRDETAIL SD,
	ITEM I, 
	CUSTOMER C, 
	CUSTOMERCATEGORY CT, 
	ACCOUNTS A

WHERE 
	SL.DATE BETWEEN :ad_startdate AND :ad_enddate AND
	SL.SRINVCODE = SD.SRINVCODE AND
	SD.ICODE = I.ICODE AND
	I.MANFCODE = MA.MANFCODE AND
	MA.MANFCODE = :ai_ManfCode AND
	SL.CUSTCODE = C.CUSTCODE AND
	C.CUSTCODE = A.ACCCODE AND
	C.CUSTCATCODE = CT.CUSTCATCODE

GROUP BY 
	A.ALIASNAME,
	CT.NAME,
	I.CUSTOMICODE,
	I.ICODE) T

ORDER BY
	DISTCODE,
	CHEMCODE, 
	CHEMTYPE, 
	PRODCODE"
  arguments=(("as_distcode", string), ("ai_manfcode", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
column(name=report visible="1" band=detail id=1 x="5" y="4" height="76" width="3063" color="0" border="0" alignment="0" format="[general]" html.valueishtml="0" edit.autohscroll=yes edit.autoselect=yes edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=169 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
