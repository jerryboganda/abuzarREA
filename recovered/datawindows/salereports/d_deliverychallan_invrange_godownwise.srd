release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1385 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
 retrieve="SELECT  
	itemname= item.name, 
	packingdesc=item.packingdesc,
	aliasname=item.customicode,
	icode = saledetail.icode,   
	expiry = saledetail.expiry,   
	qty = isnull( Sum(saledetail.looseqty + saledetail.bonusqty) ,0),
	Godown = Godown.name,	
	Id       = Min(dbo.saledetail.IDENTITYCOL)
FROM 
	saleledger, 
	saledetail, 
	Godown,
	Item LEFT OUTER JOIN ItemPacking ON (dbo.item.packcode = itempacking.packcode)
WHERE 
	( dbo.saleledger.saleinvcode Between :ar_SInvCode And :ar_LInvCode) And
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND
	( dbo.saledetail.icode = dbo.item.icode) and 
	( dbo.saledetail.gcode IN (:ar_gcode )  ) and
	( dbo.saledetail.gcode = godown.gcode)
Group By
	Godown.Name,
	SaleDetail.ICode,
	Item.Name,
	Item.PackingDesc,
	Item.CustomICode,
	SaleDetail.Expiry"
  arguments=(("ar_SInvCode", number), ("ar_LInvCode", number), ("ar_GCode", numberlist))
 sort="godown A, itemname A"
)
