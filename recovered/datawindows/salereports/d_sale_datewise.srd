release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1531 color="536870912" )
summary(height=260 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=day dbname="DAY"  )
column=(type=long updatewhereclause=yes name=invcount dbname="InvCount"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=long updatewhereclause=yes name=cashinvcount dbname="CashInvCount"  )
column=(type=long updatewhereclause=yes name=creditinvcount dbname="CreditInvCount"  )
column=(type=decimal(6) updatewhereclause=yes name=cashsale dbname="CashSale"  )
column=(type=decimal(6) updatewhereclause=yes name=creditsale dbname="CreditSale"  )
 retrieve="SELECT
	DAY=datepart(dd,date),
	InvCount= Count(SaleType), 
	SaleValue=sum(netamount),
	CashInvCount= SUM(CASE SaleType WHEN 'CASH' THEN 1 ELSE 0 END), 
	CreditInvCount= SUM(CASE SaleType WHEN 'CASH' THEN 0 ELSE 1 END),
	CashSale=sum(CASE SaleType WHEN 'Cash' THEN netamount ELSE 0 END),
	CreditSale=sum(CASE SaleType WHEN 'Cash' THEN 0 ELSE netamount END)
FROM 
	(SELECT
		date= S.date,
	        saletype = Case S.salecatcode 
				When 1 Then 'Cash' 
				When 2 Then 'Credit' 
				Else 'Cash' End, 
		NetAmount=Round(SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
				SUM(ROUND( (D.looseqty * (D.saleprice - D.itemflatdisc)) *
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
				ROUND( (SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
					(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) -
					S.flatdisc) * (S.invgstperc1 * .01), 2), 0) +
				Round(SUM((D.looseqty*(D.saleprice - D.itemflatdisc)) *
					(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) + 
					S.misccharges + S.salestax - S.flatdisc, 0)
	FROM 
		dbo.saleledger S, 
		dbo.saledetail D
	WHERE
		S.saleinvcode = D.saleinvcode and
		S.date between :ad_StartDate and :ad_EndDate
	GROUP BY S.saleinvcode,
		 S.salecatcode,
		 S.date,
		 S.discperc,
		 S.misccharges,
		 S.salestax,
		 S.flatdisc,
		 S.invgstperc1,
		 S.salesmancode
	UNION ALL
	SELECT
		date= S.date,
	        saletype = Case S.salecatcode 
				When 1 Then 'Cash' 
				When 2 Then 'Credit' 
				Else 'Cash' End, 
		NetAmount=Round(SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
				SUM(ROUND( (D.looseqty * (D.saleprice - D.itemflatdisc)) *
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
				ROUND( (SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
					(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) -
					S.flatdisc) * (S.invgstperc1 * .01), 2), 0) +
				Round(SUM((D.looseqty*(D.saleprice - D.itemflatdisc)) *
					(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) + 
					S.misccharges + S.salestax - S.flatdisc, 0)
	FROM 
		dbo.saleledger S, 
		dbo.saleinvdetail D
	WHERE
		S.ImpactInventory = 'N' AND
		S.saleinvcode = D.saleinvcode and
		S.date between :ad_StartDate and :ad_EndDate
	GROUP BY S.saleinvcode,
		 S.salecatcode,
		 S.date,
		 S.discperc,
		 S.misccharges,
		 S.salestax,
		 S.flatdisc,
		 S.invgstperc1,
		 S.salesmancode) AS a

GROUP BY
	datepart(dd,date)
ORDER BY
	datepart(dd,date) ASC  "
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
)
