release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=580 color="536870912" )
summary(height=108 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=usercode dbname="UserCode"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=long updatewhereclause=yes name=invcount dbname="InvCount"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(6) updatewhereclause=yes name=incentivevalue dbname="IncentiveValue"  )
 retrieve="select 
	UserCode = users.UserCode,  
	UserName = users.UserName,  
	InvCount = count(saleledger.saleinvcode),
	SaleValue= ISNULL(S.NetAmount, 0),
	IncentiveValue = Round(ISNULL(S.NetAmount, 0) * ISNULL(:ai_incentive_perc,0) * 0.01,2)
from   saleledger, Users, 
	(SELECT SalesmanCode, NetAmount=SUM(NetAmount) FROM
	(SELECT	S.Salesmancode, 
		NetAmount=Round(SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
				SUM(ROUND( (D.looseqty * (D.saleprice - D.itemflatdisc)) *
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
				ROUND( (SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
					(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) -
					S.flatdisc) * (S.invgstperc1 * .01), 2), 0) +
				Round(SUM((D.looseqty*(D.saleprice - D.itemflatdisc)) *
					(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) + 
					S.misccharges + S.salestax - S.flatdisc, 0)
	FROM saleledger S, saledetail D
	WHERE S.date >= :ad_StartDate and  
		S.date <= :ad_EndDate and 
		S.saleinvcode = D.saleinvcode
	GROUP BY S.saleinvcode,
		 S.custcode, 
		 S.salecatcode,
		 S.date,
		 S.discperc,
		 S.misccharges,
		 S.salestax,
		 S.flatdisc,
		 S.invgstperc1,
		 S.salesmancode
	UNION ALL
	SELECT	S.Salesmancode, 
		NetAmount=Round(SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
				SUM(ROUND( (D.looseqty * (D.saleprice - D.itemflatdisc)) *
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
				ROUND( (SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
					(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) -
					S.flatdisc) * (S.invgstperc1 * .01), 2), 0) +
				Round(SUM((D.looseqty*(D.saleprice - D.itemflatdisc)) *
					(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) + 
					S.misccharges + S.salestax - S.flatdisc, 0)
	FROM saleledger S, saleinvdetail D
	WHERE S.ImpactInventory = 'N' AND 
		S.date >= :ad_StartDate and  
		S.date <= :ad_EndDate and 
		S.saleinvcode = D.saleinvcode
	GROUP BY S.saleinvcode,
		 S.custcode, 
		 S.salecatcode,
		 S.date,
		 S.discperc,
		 S.misccharges,
		 S.salestax,
		 S.flatdisc,
		 S.invgstperc1,
		 S.salesmancode) AS SS
	GROUP BY SalesManCode) AS  S
where  saleledger.date >= :ad_StartDate and
	 	 saleledger.date <= :ad_EndDate and 
	 	 saleledger.salesmancode = Users.usercode and
		 Users.usercode = S.SalesManCode
Group by users.username, users.UserCode, S.NetAmount 
ORDER BY users.username"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_incentive_perc", number))
)
