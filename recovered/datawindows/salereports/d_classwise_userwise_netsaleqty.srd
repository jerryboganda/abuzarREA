table(column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=long updatewhereclause=yes name=icode dbname="Icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="Class"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="Salevalue"  )
column=(type=decimal(4) updatewhereclause=yes name=retqty dbname="RetQty"  )
column=(type=decimal(6) updatewhereclause=yes name=retvalue dbname="RetValue"  )
column=(type=decimal(6) updatewhereclause=yes name=discvalue dbname="DiscValue"  )
column=(type=decimal(6) updatewhereclause=yes name=netvalue dbname="NetValue"  )
 retrieve="SELECT
	UserName=(SELECT UserName FROM Users WHERE Users.UserCode=A.UserCode),
	Icode=A.Icode, 
	AliasName=(SELECT CustomICode FROM Item WHERE ICode=A.ICode),
	Item=ISNULL((SELECT Name FROM Item WHERE ICode=A.ICode), 'FLAT DISCOUNT TOTAL: '),
	Class=ISNULL((SELECT ItemClass.Name FROM ItemClass, Item WHERE ItemClass.ICCode=Item.ICCode and Item.ICode=A.ICode), 'zzz---- FLAT DISCOUNT ----zzz'),
	SaleQty=SUM (A.SaleQty), 
	Salevalue = SUM(A.SaleValue),
	RetQty=SUM(A.RetQty), 
	RetValue = SUM(A.RetValue),
	DiscValue=SUM(A.DiscVal),
	NetValue = SUM(A.SaleValue) - SUM(A.RetValue)
FROM
	(
/*-----------Sales------------*/
	SELECT 
		usercode=SL.salesmancode,
		icode=I.icode,
		saleqty=ISNULL(SUM(SD.looseqty),0),
		salevalue = ISNULL(SUM(SD.looseqty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc *0.01) * (1 - SL.DiscPerc *0.01)),0),
		retqty=0.0000,
		retvalue = 0.00,
		discval=0.00
	FROM 
		saleledger SL,
		saledetail SD,
		Item I
	WHERE 
		I.iccode IN (:aa_classcode) AND
		I.icode=SD.icode AND
		SD.saleinvcode=SL.saleinvcode AND
		SL.salesmancode IN (:ai_usercode) AND
		SL.SaleInvCode >= CASE :ai_invwise WHEN 1 THEN :ai_sinvcode ELSE 0 END AND
		SL.SaleInvCode <= CASE :ai_invwise WHEN 1 THEN :ai_linvcode ELSE 99999999 END AND
		SL.date >= CASE :ai_invwise WHEN 0 THEN :ad_startdate ELSE '01-01-1990' END AND
		SL.date <= CASE :ai_invwise WHEN 0 THEN :ad_enddate ELSE '01-01-9999' END
	GROUP BY 
		SL.salesmancode,
		I.icode
	UNION ALL
/*-----------ProformaSales------------*/
	SELECT 
		usercode=SL.salesmancode,
		icode=I.icode,
		saleqty=ISNULL(SUM(SD.looseqty),0),
		salevalue = ISNULL(SUM(SD.looseqty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc *0.01) * (1 - SL.DiscPerc *0.01)),0),
		retqty=0.0000,
		retvalue = 0.00,
		discval=0
	FROM 
		saleledger SL,
		saleinvdetail SD,
		Item I
	WHERE 
		SL.ImpactInventory= 'N' AND
		I.iccode IN (:aa_classcode) AND
		I.icode=SD.icode AND
		SD.saleinvcode=SL.saleinvcode AND
		SL.salesmancode IN (:ai_usercode) AND
		SL.SaleInvCode >= CASE :ai_invwise WHEN 1 THEN :ai_sinvcode ELSE 0 END AND
		SL.SaleInvCode <= CASE :ai_invwise WHEN 1 THEN :ai_linvcode ELSE 99999999 END AND
		SL.date >= CASE :ai_invwise WHEN 0 THEN :ad_startdate ELSE '01-01-1990' END AND
		SL.date <= CASE :ai_invwise WHEN 0 THEN :ad_enddate ELSE '01-01-9999' END
	GROUP BY 
		SL.salesmancode, I.icode
	UNION ALL
/*-----------SalesReturn------------*/
	SELECT 
		usercode=SRL.salesmancode,
		icode=I.icode,
		saleqty=0,
		salevalue=0.00,
		srqty= ISNULL(SUM(SRD.looseqty),0),
		retvalue = ISNULL(SUM(SRD.looseqty * SRD.SRPrice * (1 - SRD.DiscPerc *0.01) * (1 - SRL.DiscPerc *0.01)),0),
		discval= 0
	FROM 
		srledger SRL,
		srdetail SRD,
		item  I
	WHERE  
		SRL.saleinvcode IN 
			(SELECT saleinvcode from saleledger  SL
			WHERE SL.salesmancode IN (:ai_usercode) AND
				SL.SaleInvCode >= CASE :ai_invwise WHEN 1 THEN :ai_sinvcode ELSE 0 END AND
				SL.SaleInvCode <= CASE :ai_invwise WHEN 1 THEN :ai_linvcode ELSE 99999999 END AND
				SL.date >= CASE :ai_invwise WHEN 0 THEN :ad_startdate ELSE '01-01-1990' END AND
				SL.date <= CASE :ai_invwise WHEN 0 THEN :ad_enddate ELSE '01-01-9999' END) AND
		SRL.srinvcode=SRD.srinvcode AND
		I.icode=SRD.icode AND
		I.iccode IN (:aa_classcode)
	GROUP BY 
		SRL.salesmancode,I.icode, SRL.SaleInvCode
	UNION ALL
/*-----------discount value------------*/
	SELECT 
		usercode=SL.salesmancode,
		icode=I.icode,
		saleqty=0,
		salevalue=0.00,
		retqty=0,
		retvalue=0.00,
		discval=SUM(SD.looseqty*SD.itemflatdisc + 
			SD.looseqty*((SD.saleprice - SD.itemflatdisc )* SD.discperc*0.01)+
			SD.looseqty*(((SD.saleprice - SD.itemflatdisc) *(1 - SD.discperc*0.01)) * SL.discperc*0.01))
	FROM 
		saleledger SL,
		saledetail SD,
		Item I
	WHERE 
		I.iccode IN (:aa_classcode) AND
		I.icode=SD.icode AND
		SD.saleinvcode=SL.saleinvcode AND
		SL.salesmancode IN (:ai_usercode) AND
		SL.SaleInvCode >= CASE :ai_invwise WHEN 1 THEN :ai_sinvcode ELSE 0 END AND
		SL.SaleInvCode <= CASE :ai_invwise WHEN 1 THEN :ai_linvcode ELSE 99999999 END AND
		SL.date >= CASE :ai_invwise WHEN 0 THEN :ad_startdate ELSE '01-01-1990' END AND
		SL.date <= CASE :ai_invwise WHEN 0 THEN :ad_enddate ELSE '01-01-9999' END
	GROUP BY 
		SL.salesmancode, I.icode
	UNION ALL
	SELECT 
		usercode=SL.salesmancode,
		icode=I.icode,
		saleqty=0,
		salevalue=0.00,
		retqty=0,
		retvalue = 0.00,
		discval=SUM(SD.looseqty*SD.itemflatdisc + 
			SD.looseqty*((SD.saleprice - SD.itemflatdisc )* SD.discperc*0.01)+
			SD.looseqty*(((SD.saleprice - SD.itemflatdisc) *(1 - SD.discperc*0.01)) * SL.discperc*0.01))
	FROM 
		saleledger SL,
		saleinvdetail SD,
		Item I
	WHERE 
		SL.ImpactInventory='N' AND
		I.iccode IN (:aa_classcode) AND
		I.icode=SD.icode AND
		SD.saleinvcode=SL.saleinvcode AND
		SL.salesmancode IN (:ai_usercode) AND
		SL.SaleInvCode >= CASE :ai_invwise WHEN 1 THEN :ai_sinvcode ELSE 0 END AND
		SL.SaleInvCode <= CASE :ai_invwise WHEN 1 THEN :ai_linvcode ELSE 99999999 END AND
		SL.date >= CASE :ai_invwise WHEN 0 THEN :ad_startdate ELSE '01-01-1990' END AND
		SL.date <= CASE :ai_invwise WHEN 0 THEN :ad_enddate ELSE '01-01-9999' END
	GROUP BY 
		SL.salesmancode,
		I.icode
	UNION ALL
	SELECT 	
		usercode=SRL.salesmancode,
		icode=I.icode,
		saleqty=0,
		salevalue=0.00,
		srqty=0 ,
		retvalue = 0.00,
		discvalue= - 1*ISNULL(SUM(SRD.looseqty * (SRD.srprice * SRD.discperc*0.01)+  SRD.looseqty*((SRD.srprice*(1 - SRD.discperc*0.01))*SRL.discperc*0.01)),0)
	FROM 
		srledger SRL,
		srdetail SRD,
		item  I
	WHERE  
		SRL.saleinvcode IN 
			(SELECT saleinvcode FROM saleledger SL
			WHERE SL.salesmancode IN (:ai_usercode) AND
				SL.SaleInvCode >= CASE :ai_invwise WHEN 1 THEN :ai_sinvcode ELSE 0 END AND
				SL.SaleInvCode <= CASE :ai_invwise WHEN 1 THEN :ai_linvcode ELSE 99999999 END AND
				SL.date >= CASE :ai_invwise WHEN 0 THEN :ad_startdate ELSE '01-01-1990' END AND
				SL.date <= CASE :ai_invwise WHEN 0 THEN :ad_enddate ELSE '01-01-9999' END) AND
		SRL.srinvcode=SRD.srinvcode AND
		I.icode=SRD.icode AND
		I.iccode IN (:aa_classcode)
	GROUP BY 
		SRL.salesmancode,
		I.icode, SRL.SaleInvCode) AS A
GROUP BY 
	A.UserCode,
	A.icode
ORDER by
	UserName, 
	Class,
	Item

"
  arguments=(("ai_invwise", number), ("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_sinvcode", number), ("ai_linvcode", number), ("aa_classcode", numberlist), ("ai_usercode", numberlist))
 sort="username A, class A, item A"
)
