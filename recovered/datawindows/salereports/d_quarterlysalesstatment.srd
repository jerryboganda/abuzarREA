release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1333 color="536870912" )
summary(height=250 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(13) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(4) updatewhereclause=yes name=qty1 dbname="Qty1"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus1 dbname="Bonus1"  )
column=(type=decimal(6) updatewhereclause=yes name=value1 dbname="Value1"  )
column=(type=decimal(4) updatewhereclause=yes name=qty2 dbname="Qty2"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus2 dbname="Bonus2"  )
column=(type=decimal(6) updatewhereclause=yes name=value2 dbname="Value2"  )
column=(type=decimal(4) updatewhereclause=yes name=qty3 dbname="Qty3"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus3 dbname="Bonus3"  )
column=(type=decimal(6) updatewhereclause=yes name=value3 dbname="Value3"  )
 retrieve="SELECT
	Category=IC.Name,  
	Item=I.Name,
	AliasName=I.CustomICode, 
	Packing=I.PackingDesc, 
	Price=Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),
	Qty1=SUM(CASE S.SLOT WHEN 1 THEN S.Qty ELSE 0 END),
	Bonus1=SUM(CASE S.SLOT WHEN 1 THEN S.BonusQty ELSE 0 END),
	Value1=SUM(CASE S.SLOT WHEN 1 THEN CASE :ai_Price WHEN 1 THEN S.Value ELSE S.Qty * Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2) END ELSE 0 END),
	Qty2=SUM(CASE S.SLOT WHEN 2 THEN S.Qty ELSE 0 END), 
	Bonus2=SUM(CASE S.SLOT WHEN 2 THEN S.BonusQty ELSE 0 END), 
	Value2=SUM(CASE S.SLOT WHEN 2 THEN CASE :ai_Price WHEN 1 THEN S.Value ELSE S.Qty * Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2) END ELSE 0 END), 
	Qty3=SUM(CASE S.SLOT WHEN 3 THEN S.Qty ELSE 0 END),
	Bonus3=SUM(CASE S.SLOT WHEN 3 THEN S.BonusQty ELSE 0 END), 
	Value3=SUM(CASE S.SLOT WHEN 3 THEN CASE :ai_Price WHEN 1 THEN S.Value ELSE S.Qty * Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2) END ELSE 0 END)
FROM 
(SELECT
	MNO=MAX(MONTH(sl.DATE)),
	inv=sl.saleinvcode,
	sd.icode,
	i.icatcode,
	qty = SUM(sd.looseqty),
	bonusqty = SUM(sd.bonusqty),
	Value = SUM((sd.looseqty * (sd.saleprice - sd.itemflatdisc)) * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
	slot = CASE MAX(MONTH(sl.DATE)) 
		WHEN :ai_smonth then 1 
		WHEN CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END THEN 2
		ELSE 3 END
FROM
	saleledger sl,
	saledetail sd, 
	item i
WHERE
	( (month(sl.date) = :ai_smonth AND year(sl.date) = :ai_syear) OR 
	  (month(sl.date) = CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END AND
	   year(sl.date) = CASE WHEN (:ai_smonth + 1) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) OR
	  (month(sl.date) = CASE ((:ai_smonth + 2) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 2) % 12) END AND
	   year(sl.date) = CASE WHEN (:ai_smonth + 2) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) ) AND
	sl.saleinvcode = sd.saleinvcode and
	sd.icode = i.icode and
	i.icatcode in (:ai_icatcode)
GROUP BY 
	 sl.saleinvcode,
	 i.icatcode,
	 sd.icode
UNION ALL
SELECT
	MNO=MAX(MONTH(sl.DATE)),
	inv=sl.saleinvcode,
	sd.icode,
	i.icatcode,
	qty = SUM(sd.looseqty),
	bonusqty = SUM(sd.bonusqty),
	Value = SUM((sd.looseqty * (sd.saleprice - sd.itemflatdisc)) * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
	slot = CASE MAX(MONTH(sl.DATE)) 
		WHEN :ai_smonth then 1 
		WHEN CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END THEN 2
		ELSE 3 END
FROM
	saleledger sl,
	saleinvdetail sd, 
	item i
WHERE
	( sl.impactinventory = 'N' ) AND
	( (month(sl.date) = :ai_smonth AND year(sl.date) = :ai_syear) OR 
	  (month(sl.date) = CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END AND
	   year(sl.date) = CASE WHEN (:ai_smonth + 1) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) OR
	  (month(sl.date) = CASE ((:ai_smonth + 2) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 2) % 12) END AND
	   year(sl.date) = CASE WHEN (:ai_smonth + 2) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) ) AND
	sl.saleinvcode = sd.saleinvcode and
	sd.icode = i.icode and
	i.icatcode in (:ai_icatcode)
GROUP BY 
	 sl.saleinvcode,
	 i.icatcode,
	 sd.icode
UNION ALL
SELECT
	MNO=:ai_smonth,
	inv=0,
	i.icode,
	i.icatcode,
	qty = 0,
	bonusqty = 0,
	Value = 0,
	slot = 1
FROM
	item i
WHERE
	i.icatcode in (:ai_icatcode)
UNION ALL
SELECT
	MNO=MAX(MONTH(sl.DATE)),
	inv=sl.srinvcode,
	sd.icode,
	i.icatcode,
	qty = - SUM(sd.looseqty),
	bonusqty = - SUM(sd.bonusqty),
	Value = - SUM(sd.looseqty * sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
	slot = CASE MAX(MONTH(CASE :as_return WHEN 'A' THEN sl.DATE ELSE s.Date END)) 
		WHEN :ai_smonth then 1 
		WHEN CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END THEN 2
		ELSE 3 END
FROM
	srledger sl
	LEFT OUTER JOIN saleledger AS s ON (sl.saleinvcode = s.saleinvcode),
	srdetail sd, 
	item i
WHERE
	( (month(sl.date) = :ai_smonth AND year(sl.date) = :ai_syear) OR 
	  (month(sl.date) = CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END AND
	   year(sl.date) = CASE WHEN (:ai_smonth + 1) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) OR
	  (month(sl.date) = CASE ((:ai_smonth + 2) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 2) % 12) END AND
	   year(sl.date) = CASE WHEN (:ai_smonth + 2) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) ) AND
	sl.srinvcode = sd.srinvcode and
	sd.icode = i.icode and
	i.icatcode in (:ai_icatcode) AND
	IsNull(SL.saleinvcode,-1) IN (SELECT saleinvcode =
		CASE :as_return when 'A' THEN
			IsNull(SL.saleinvcode,-1) 
		ELSE
			(SELECT SaleLedger.SALEINVCODE FROM dbo.SaleLedger 
			WHERE ( (month(SaleLedger.date) = :ai_smonth AND year(SaleLedger.date) = :ai_syear) OR 
			  (month(SaleLedger.date) = CASE ((:ai_smonth + 1) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 1) % 12) END AND
				year(SaleLedger.date) = CASE WHEN (:ai_smonth + 1) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) OR
			  (month(SaleLedger.date) = CASE ((:ai_smonth + 2) % 12) WHEN 0 THEN 12 ELSE ((:ai_smonth + 2) % 12) END AND
				year(SaleLedger.date) = CASE WHEN (:ai_smonth + 2) > 12 THEN :ai_syear + 1 ELSE :ai_syear END) ) AND 
				SaleLedger.SALEINVCODE = sl.saleinvcode
			 
			)
		END
		)
GROUP BY 
	 sl.srinvcode,
	 sl.saleinvcode,
	 i.icatcode,
	 sd.icode) S, Item I, ItemCategory IC
WHERE S.ICode = I.ICode AND I.ICatCode = IC.ICatCode
GROUP BY 
	IC.Name, 
	I.Name, 
	I.CustomICode,
	I.PackingDesc,
	I.SalePrice,
	I.PackUnits,
	I.ICODE,
	I.ICATCODE
ORDER BY 
	IC.Name, 
	I.Name, 
	I.CustomICode"
  arguments=(("ai_smonth", number), ("ai_syear", number), ("ai_icatcode", numberlist), ("ai_price", number), ("as_return", string))
)
