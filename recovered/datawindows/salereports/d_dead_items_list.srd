table(column=(type=char(60) updatewhereclause=yes name=groupname dbname="groupname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=decimal(6) updatewhereclause=yes name=stockvalue dbname="stockvalue"  )
column=(type=datetime updatewhereclause=yes name=lastpurdate dbname="Lastpurdate"  )
column=(type=long updatewhereclause=yes name=lastpurcode dbname="Lastpurcode"  )
column=(type=datetime updatewhereclause=yes name=lastreceiptdate dbname="LastReceiptdate"  )
column=(type=long updatewhereclause=yes name=lastreceiptcode dbname="LastReceiptcode"  )
column=(type=datetime updatewhereclause=yes name=lastsaledate dbname="LastSaledate"  )
column=(type=long updatewhereclause=yes name=lastsaleinvcode dbname="LastsaleInvCode"  )
 retrieve="SELECT
	groupname=groupname,
	aliasname=I.aliasname,
	ItemName=I.itemname,
	Stock=I.stock,
	stockvalue=(case :ai_pricetype when 1 then I.saleprice  when 2 then I.purprice when 3 Then I.avgprice  else I.saleprice end)* I.stock,
	Lastpurdate=(	select max(PL.postdate) from purledger PL,purdetail PD 
						where PL.purinvcode=PD.purinvcode and PL.posted='Y' and PD.icode=I.icode),
	Lastpurcode=(select max(PL.purinvcode) from purledger PL, purdetail PD
					   where PL.posted='Y' and PL.purinvcode=PD.purinvcode and PD.icode=I.icode and
								PL.postdate IN 
									(select max(PL.postdate) from purledger PL,purdetail PD 
									where PL.purinvcode=PD.purinvcode and PL.posted='Y' and PD.icode=I.icode)),
	LastReceiptdate=(	select max(PL.postdate) from ReceiptHeader PL, Receiptdetail PD 
						where PL.Receiptinvcode=PD.Receiptinvcode and PL.posted='Y' and PD.icode=I.icode),
	LastReceiptcode=(select max(PL.Receiptinvcode) from ReceiptHeader PL, Receiptdetail PD
					   where PL.posted='Y' and PL.Receiptinvcode=PD.Receiptinvcode and PD.icode=I.icode and
								PL.postdate IN 
									(select max(PL.postdate) from ReceiptHeader PL,Receiptdetail PD 
									where PL.Receiptinvcode=PD.Receiptinvcode and PL.posted='Y' and PD.icode=I.icode)),
	LastSaledate=	(select SLL.date from saleledger SLL 
						where SLL.saleinvcode in
									(select max(SL.saleinvcode) from saleledger SL, saledetail SD
									where SL.saleinvcode=SD.saleinvcode and SD.icode=I.icode)),
	LastsaleInvCode=(select max(SL.saleinvcode) from saleledger SL, saledetail SD
						where SL.saleinvcode=SD.saleinvcode and SD.icode=I.icode)
FROM
	(select 
		icode=godowndetail.icode ,
		aliasname=item.customicode,
		itemname=item.name,
		stock=sum(currqty),
		saleprice=item.saleprice/(case item.packunits when 0 then 1 else item.packunits end),
		purprice=item.purprice/(case item.packunits when 0 then 1 else item.packunits end),
		avgprice=max(item.avgprice),
		groupname=CASE :as_group WHEN 'M' THEN max(Manufacturer.name) WHEN 'C' THEN max(itemcategory.name) WHEN 'P' THEN max(itemPacking.name) ELSE max(itemclass.name) END
	from item, godowndetail, itemclass, itempacking, itemcategory, manufacturer
	where case :as_group when 'P' THEN item.packcode
								when 'C' THEN item.icatcode
								when 'L' THEN item.iccode
								when 'M' THEN item.manfcode END IN (:ana_icatcode) AND 
		item.icode=godowndetail.icode and
		item.manfcode=manufacturer.manfcode and
		item.icatcode=itemcategory.icatcode and
		item.iccode=itemclass.iccode and
		item.packcode=itempacking.packcode 
	group by godowndetail.icode,
		item.customicode,
		item.name,
		item.saleprice,
		item.purprice,
		item.packunits) AS I
WHERE I.icode NOT IN 
		(select distinct(icode )
		from saleledger,saledetail
		where saleledger.date>=:ad_startdate and saleledger.date<=:ad_enddate and 
			saleledger.saleinvcode=saledetail.saleinvcode
		union
		select distinct(icode)
		from purledger,purdetail
		where purledger.postdate>=:ad_purdate and purledger.purinvcode=purdetail.purinvcode
		union
		select distinct(icode)
		from ReceiptHeader RH,Receiptdetail RD
		where RH.postdate >= :ad_receiptdate and RH.Receiptinvcode=RD.Receiptinvcode)
"
  arguments=(("ana_icatcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_pricetype", number), ("as_group", string), ("ad_purdate", datetime), ("ad_receiptdate", datetime))
 sort="groupname A, itemname A"
)
