table(column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="salevalue"  )
 retrieve="SELECT  
	ItemCategory=Ic.Name,
	date=max(p.date),
	salevalue=ROUND(SUM(CASE P.TYPE WHEN 'S' THEN +1 ELSE -1 END * P.itemvalue), 0)
FROM 
(
SELECT
	type='S',
	saleledger.saleinvcode,
	date=CAST(CONVERT(VARCHAR(100), saleledger.date, 101) AS DATETIME), 
	saledetail.icode,
	ItemValue=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),
	catcode=saleledger.salecatcode,
	day_of_year=DATEPART(y, saleledger.date)
FROM
	saleledger,	saledetail, item
WHERE
	saleledger.saleinvcode = saledetail.saleinvcode AND 
	saleledger.date between :adt_startdate AND :adt_enddate and
	saledetail.icode = item.icode and
	item.icatcode in (:ai_icatcode)
GROUP BY 
	 saleledger.saleinvcode,
	 saleledger.salesmancode,
	 saledetail.icode,
	 saleledger.salecatcode,
	 saleledger.discperc,
	 saleledger.flatdisc,
	 saleledger.invgstperc1,
	 saleledger.salecatcode,
	 DATEPART(y, saleledger.date),
	 CAST(CONVERT(VARCHAR(100), saleledger.date, 101) AS DATETIME)
UNION ALL
SELECT
	type='S',
	saleledger.saleinvcode,
	date=CAST(CONVERT(VARCHAR(100), saleledger.date, 101) AS DATETIME), 
	saledetail.icode,
	ItemValue=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),
	catcode=saleledger.salecatcode,
	day_of_year=DATEPART ( y , saleledger.date )
FROM
	saleledger,	saleinvdetail saledetail, item
WHERE
	saleledger.impactinventory='N' AND
	saleledger.saleinvcode = saledetail.saleinvcode AND 
	saleledger.date between :adt_startdate AND :adt_enddate and
	saledetail.icode = item.icode and
	item.icatcode in (:ai_icatcode)
GROUP BY 
	 saleledger.saleinvcode,
	 saleledger.salesmancode,
	 saledetail.icode,
	 saleledger.salecatcode,
	 saleledger.discperc,
	 saleledger.flatdisc,
	 saleledger.invgstperc1,
	 saleledger.salecatcode,
	 DATEPART(y, saleledger.date),
	 CAST(CONVERT(VARCHAR(100), saleledger.date, 101) AS DATETIME)
UNION ALL
SELECT
	type='R',
	srledger.srinvcode,
	date=CAST(CONVERT(VARCHAR(100), srledger.date, 101) AS DATETIME), 
	srdetail.icode,
	ItemValue=SUM((srdetail.looseqty * srdetail.srprice * (1 - (.01 * srdetail.discperc))) * (1 - (.01 * srledger.discperc))),
	catcode=srledger.srcatcode,
	day_of_year=DATEPART ( y , srledger.date )
FROM
	srledger,	 srdetail, item
WHERE
	srledger.srinvcode = srdetail.srinvcode  AND 
	srledger.date between :adt_startdate AND :adt_enddate and
	srdetail.icode = item.icode and
	item.icatcode in (:ai_icatcode)
GROUP BY
	 srledger.srinvcode,
	 srledger.salesmancode,
	 srdetail.icode,
	 srledger.srcatcode,
	 srledger.discperc,
	 srledger.flatdisc,
	 srledger.invgstperc1,
	 srledger.srcatcode,
	 DATEPART(y, srledger.date),
	 CAST(CONVERT(VARCHAR(100), srledger.date, 101) AS DATETIME)) P, ItemCategory IC, Item I
WHERE
	P.Icode = I.Icode AND 
	I.ICatCode = IC.ICatCode
GROUP BY 
	Ic.Name,
	day_of_year
ORDER BY 
	Ic.Name,
	day_of_year

"
  arguments=(("ai_icatcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="date A"
)
