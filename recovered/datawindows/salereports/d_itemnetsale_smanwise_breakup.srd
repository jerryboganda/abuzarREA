table(column=(type=char(20) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(20) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(20) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=number updatewhereclause=yes name=qty dbname="qty"  )
column=(type=number updatewhereclause=yes name=value dbname="value"  )
 retrieve="SELECT	
	SalePerson=Name1,
	Manufacturer= Name2,
	ManfCode = Code1,
	AliasName=Name3,
	ItemName=Name4,
	Value =Value1,
	Qty =Code2
FROM
	ReportData "
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime))
 sort="manufacturer A, itemname A, aliasname A"
)
group(level=1 header.height=187 trailer.height=197 by=("manufacturer"  ) header.color="536870912" trailer.color="536870912" )
group(level=2 header.height=0 trailer.height=0 by=("itemname"  ) header.color="536870912" trailer.color="536870912" )
