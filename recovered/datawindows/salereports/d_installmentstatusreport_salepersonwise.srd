table(column=(type=long updatewhereclause=yes name=installmentcode dbname="InstallmentCode"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(9) updatewhereclause=yes name=contractamt dbname="ContractAmt"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(255) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=advance dbname="Advance"  )
column=(type=decimal(2) updatewhereclause=yes name=installments dbname="Installments"  )
column=(type=long updatewhereclause=yes name=noofinstallments dbname="NoOfInstallments"  )
column=(type=char(1) updatewhereclause=yes name=approved dbname="Approved"  )
column=(type=char(60) updatewhereclause=yes name=approvedby dbname="ApprovedBy"  )
column=(type=char(60) updatewhereclause=yes name=saleperson dbname="SalePerson"  )
 retrieve="SELECT 
	InstallmentCode=IH.InstallmentCode,
	SaleInvCode = IH.SaleInvCode,
	Date = IH.Date,
	CustomerName = (SELECT A.Name FROM Accounts A WHERE IH.CustCode = A.AccCode),
	ItemName = (SELECT I.Name FROM Item I WHERE IH.ICode = I.ICode),
	Qty = IH.Qty,
	ContractAmt = Round(Round((IH.qty * (IH.saleprice - IH.itemflatdisc) ) * (1 - IH.discperc * 0.01), 2)  + IH.markupamt + IH.processingfee, 0),
	UserName =(SELECT U.UserName FROM Users U WHERE U.UserCode=IH.UserCode),
	Remarks=IH.Remarks,
	Advance = ISNULL(IH.DownPayment,0),
	Installments = ISNULL((SELECT SUM(ISD.Amount) FROM InstallmentDetail ISD WHERE ISD.InstallmentCode = IH.InstallmentCode),0),
	NoOfInstallments = IH.NoOfInstallments,
	Approved = IH.Approved,
	ApprovedBy = (SELECT U.UserName FROM Users U WHERE U.UserCode=IH.ApprovedBy),
	SalePerson = ISNULL((SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = IH.SManCode), '  <OTHERS> ')
FROM 
	InstallmentHeader IH
WHERE 
	IH.Date BETWEEN :adt_startdate AND :adt_enddate AND
	IH.SManCode IN (:ai_smancode) OR IH.SManCode IS NULL
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_smancode", numberlist))
 sort="saleperson A, installmentcode A"
)
