release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1614 color="536870912" )
summary(height=281 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(6) updatewhereclause=yes name=saleamount dbname="saleAmount"  )
 retrieve="Select	icode = ssh.seticode,
			I.Name,
			saleqty = Sum(ssh.qty), 
			saleAmount = Sum(ssh.qty * ssh.SalePrice)
From  	SaleLedger sl,	salesetsheader ssh, Item I
Where  	sl.Date Between :ar_sdate And :ar_edate And
			sl.saleinvcode = ssh.saleinvcode  And
			ssh.seticode = I.Icode
Group By	ssh.seticode, I.Name

Union All

Select	icode = sd.icode,
			I.Name,
			saleqty = Sum(sd.looseqty),
			SaleAmount = Sum(sd.looseqty * sd.SalePrice)
From  	SaleLedger sl, SaleDetail sd, Item I
Where  	sl.Date Between :ar_sdate And :ar_edate And
			sl.saleinvcode = sd.saleinvcode And
			sd.icode = I.Icode And
			sd.RowGroup Not In 	(
											Select 	SaleSetsDetail.RowGroup 
											From   	SaleSetsHeader, SaleSetsDetail
											Where  	SaleSetsHeader.SaleInvCode = sl.SaleInvCode And
														SaleSetsHeader.SetCode = SaleSetsDetail.SetCode And
														SaleSetsDetail.ICode = sd.icode And
														SaleSetsDetail.RowGroup = sd.RowGroup
										)
Group By sd.icode, I.Name
"
  arguments=(("ar_SDate", datetime), ("ar_EDate", datetime))
)
