table(column=(type=char(13) updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item.Item"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="ItemCategory.Category"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Item.Bonus"  )
column=(type=decimal(4) updatewhereclause=yes name=sales dbname="Item.Sales"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="Item.AvgPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Item.SalePrice"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Item.PackUnits"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="Item.PackingDesc"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Item.Type"  )
column=(type=long updatewhereclause=yes name=invcode dbname="Item.InvCode"  )
column=(type=datetime updatewhereclause=yes name=invdate dbname="Invdate"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="HeaderInvNo"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CustAlias"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
 retrieve="SELECT
	documentcode = S.DocumentCode, 
	AliasName=I.CustomICode, 
	I.Name as Item, 
	M.Name as Manufacturer,
	IC.Name as Category,
	S.Bonus,
	S.Sales,
	I.AvgPrice,
	I.SalePrice,
	I.PackUnits,
	I.PackingDesc,
	S.Type,
	S.InvCode,
	Invdate=S.Invdate,
	HeaderNo=S.HeaderNo,
	HeaderInvNo=S.HeaderInvNo,
	CustAlias=A.AliasName,
	Customer=A.Name
FROM
	Item I,
	Manufacturer M,
	ItemCategory IC,
	(SELECT
		documentcode = 'SV-' + LTRIM(RTRIM(STR(SL.SaleInvCode, 10))), 
		Type='S',
		InvCode=SL.SaleInvCode,
		InvDate=SL.Date,
		SL.HeaderNo,
		SL.CustCode,
		SL.HeaderInvNo,
		SD.ICode,
		SUM(SD.BonusQty) as Bonus,
		SUM(SD.LooseQty) as Sales
	FROM
		SaleLedger SL,
		SaleDetail SD,
		Item I
	WHERE
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SaleInvCode = SD.SaleInvCode AND 
		SD.ICode = I.ICode AND
		SD.BonusQty <> 0 AND
		I.ICatCode IN (:ar_icatcode)
	GROUP BY
		SL.SaleInvCode,
		SL.date,
		SL.HeaderNo,
		SL.CustCode,
		SL.HeaderInvNo,
		SD.ICode
	HAVING
		SUM(SD.BonusQty) <> 0
	UNION ALL
	SELECT
		documentcode = 'SV-' + LTRIM(RTRIM(STR(SL.SaleInvCode, 10))), 
		Type='S',
		InvCode=SL.SaleInvCode,
		InvDate=SL.Date,
		SL.HeaderNo,
		SL.CustCode,
		SL.HeaderInvNo,
		SD.ICode,
		SUM(SD.BonusQty) as Bonus,
		SUM(SD.LooseQty) as Sales
	FROM
		SaleLedger SL,
		SaleInvDetail SD,
		Item I
	WHERE
		SL.ImpactInventory = 'N' AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SaleInvCode = SD.SaleInvCode AND 
		SD.ICode = I.ICode AND
		SD.BonusQty <> 0 AND
		I.ICatCode IN (:ar_icatcode)
	GROUP BY
		SL.SaleInvCode,
		SL.Date,
		SL.HeaderNo,
		SL.CustCode,
		SL.HeaderInvNo,
		SD.ICode
	HAVING
		SUM(SD.BonusQty) <> 0
	UNION ALL
	SELECT
		documentcode = 'SR-' + LTRIM(RTRIM(STR(SL.SRInvCode, 10))), 
		Type='R',
		InvCode=SL.SRInvCode,
		InvDate=SL.date,
		SL.HeaderNo,
		SL.CustCode,
		SL.HeaderInvNo,
		SD.ICode,
		-SUM(SD.BonusQty) as Bonus,
		-SUM(SD.LooseQty) as Sales
	FROM
		SrLedger SL,
		SrDetail SD,
		Item I
	WHERE
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SrInvCode = SD.SrInvCode AND
		SD.ICode = I.ICode AND
		SD.BonusQty <> 0 AND
		I.ICatCode IN (:ar_icatcode)
	GROUP BY
		SL.SRInvCode,
		SL.Date,
		SL.HeaderNo,
		SL.CustCode,
		SL.HeaderInvNo,
		SD.ICode
	HAVING
		SUM(SD.BonusQty) <> 0) S,
	Accounts A
WHERE
	I.ICatCode IN (:ar_icatcode) AND
	I.ICatCode = IC.ICatCode AND
	S.ICode = I.ICode AND
	S.CustCode = A.AccCode AND
	I.ManfCode = M.ManfCode
ORDER BY
	M.Name,
	I.Name,
	S.Type DESC,
	HeaderNo,
	HeaderInvNo,
	InvCode,
	InvDate,
	S.Sales,
	S.Bonus"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ar_icatcode", numberlist))
 sort="category A, item A, type D, headerno A, headerinvno A, invcode A"
)
