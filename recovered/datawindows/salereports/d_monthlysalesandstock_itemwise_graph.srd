datawindow ( units=2 timer_interval=0 processing=3 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(100) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(100) updatewhereclause=yes name=type dbname="type"  )
column=(type=decimal(2) updatewhereclause=yes name=datavalue dbname="datavalue"  )
column=(type=datetime updatewhereclause=yes name=startdate dbname="startdate"  )
column=(type=datetime updatewhereclause=yes name=enddate dbname="enddate"  )
column=(type=char(20) updatewhereclause=yes name=period dbname="Period"  )
 retrieve="  SELECT AliasName=ReportData.name1,   
         Item=ReportData.name2,   
			type=ReportData.name3,   
         datavalue=ReportData.value1,   
			startdate=ReportData.date1,
			enddate=ReportData.date2,
         Period= LEFT(RTRIM(LTRIM(DATENAME(MONTH, ReportData.date1))), 3) + '~~r~~n ' + RIGHT(LTRIM(RTRIM(YEAR(ReportData.date1))), 2)
  FROM ReportData   
ORDER BY
			ReportData.date1,
			ReportData.date2,
			period,
			type
			
"
 )
