release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=1 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1052 color="536870912" )
header[2](height=354 color="536870912" )
summary(height=218 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=regionname dbname="regionname"  )
column=(type=char(20) updatewhereclause=yes name=groupname dbname="groupname"  )
column=(type=number updatewhereclause=yes name=netsales dbname="netsales"  )
 retrieve="SELECT
	AREACODE = Code2,
	REGIONCODE= Code3, 
	GroupCode=Code4,
	AreaShorName=Name2,
	RegionName=Name3,
	GroupName=Name4,
	NetSales = SUM(Value2)
FROM ReportData
WHERE 
	code3 = :ar_regcode and
	code4 in (:ar_icatcode)
GROUP BY
	Code2,
	Code3, 
	Code4,
	Name2,
	Name3,
	Name4
ORDER BY
	AreaShorName,
	RegionName,
	GroupName
"
  arguments=(("ar_regcode", number), ("ar_icatcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
 sort="regionname A, groupname A"
)
group(level=1 header.height=0 trailer.height=0 by=("regionname"  ) header.color="536870912" trailer.color="536870912" )
compute(name=compute_8 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-12" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" x="52" y="41" height="208" width="7718" format="[GENERAL]" expression="~"Area Wise Sales Summary Report~"" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
