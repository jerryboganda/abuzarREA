compute(name=compute_9 visible="1" moveable=1 band=background font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" x="52" y="875" height="166" width="7729" format="[GENERAL]" expression="~"Report Date:~" + STRING(day( today() )) + '/' + STRING(month( today() )) + '/' + STRING(year( today() )) + SPACE(10) + SPACE(5) + ~"From :~" +  STRING(day(ar_startdate )) + '/' + STRING(month(ar_startdate )) + '/' + STRING(year(ar_startdate )) + SPACE(10) + ~"To :~" +  STRING(day(ar_enddate)) + '/' + STRING(month(ar_enddate)) + '/' + STRING(year(ar_enddate)) + SPACE(10) + 'Region: ' + trim( regionname )" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
