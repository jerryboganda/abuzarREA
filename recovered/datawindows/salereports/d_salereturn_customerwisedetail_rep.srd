table(column=(type=long updatewhereclause=yes name=srinvcode dbname="srinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=char(30) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=person dbname="Person"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
column=(type=char(50) updatewhereclause=yes name=salestaxregno dbname="SalesTaxRegNo"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="rowid"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="invtotal"  )
 retrieve="SELECT 
	srinvcode = dbo.srledger.srinvcode, 
	date = dbo.srledger.date, 
	invdiscperc = dbo.srledger.discperc, 
	flatdisc = dbo.srledger.flatdisc, 
	misccharges = dbo.srledger.misccharges, 
	invgstperc1 = dbo.srledger.invgstperc1, 
	invsalestax = dbo.srledger.salestax,
	remarks = dbo.srledger.remarks,
	custcode = dbo.srledger.custcode,
	looseqty = dbo.srdetail.looseqty, 
	bonusqty = dbo.srdetail.bonusqty,
	packqty  = srdetail.packqty, 
	packing = case when dbo.item.packcode IS Null Then space(30) else dbo.itempacking.name end,
	price = dbo.srdetail.srprice, 
	itemdiscperc = dbo.srdetail.discperc, 
	packunits = dbo.srdetail.packunits, 
	unitsalestax = dbo.srdetail.unitsalestax, 
	gstperc = dbo.srdetail.gstperc, 
	batch = dbo.srdetail.batch, 
	expiry = dbo.srdetail.expiry, 
	salestax  = srdetail.salestax,
	itemname = item.name,
	datestring = Rtrim(LTrim(Str(DatePart(dd, srledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, srledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, srledger.date)))), 
	aliasname = dbo.accounts.aliasname, 
	Person = dbo.accounts.name,
	doctype = Case dbo.srledger.srcatcode When 6 Then 'Cash' When 7 Then 'Credit' Else 'Cash' End,
	NTN = customer.ntnno,
	SalesTaxRegNo = customer.SalesTaxRegNo,
	rowid=dbo.srdetail.rowid,
	invtotal = srledger.invtotal
FROM
	dbo.srledger, 
	dbo.srdetail,    
	dbo.item LEFT OUTER JOIN ItemPacking ON (dbo.item.packcode = dbo.itempacking.packcode),
	dbo.accounts,
	dbo.customer
WHERE  
	dbo.srledger.date BETWEEN :ad_StartDate and :ad_EndDate  and 
	dbo.srledger.custcode IN (:al_CustCode) and 
	dbo.srledger.srcatcode IN (6,7,8) and
	dbo.srledger.srinvcode = dbo.srdetail.srinvcode and  
	dbo.srdetail.icode = item.icode and 
	dbo.srledger.custcode = dbo.accounts.acccode and
	dbo.srledger.custcode = dbo.customer.custcode and 
	dbo.customer.custcode = dbo.accounts.acccode"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime))
 sort="person A, srinvcode A, rowid A"
)
