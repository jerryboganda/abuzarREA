table(column=(type=long updatewhereclause=yes name=grouping dbname="Grouping"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="Custcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="ManfCode"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=decimal(16) updatewhereclause=yes name=tpvalue dbname="TPValue"  )
column=(type=decimal(6) updatewhereclause=yes name=invvalue dbname="InvValue"  )
column=(type=decimal(6) updatewhereclause=yes name=diff dbname="Diff"  )
column=(type=decimal(6) updatewhereclause=yes name=discvalue dbname="DiscValue"  )
column=(type=decimal(6) updatewhereclause=yes name=claimamt dbname="ClaimAmt"  )
 retrieve="SELECT  
	Grouping=1, 
	InvCode=S.SaleInvCode,
	Custcode=S.CustCode,
	Date=S.Date,
	AliasName=A.AliasName,
	Customer=A.Name,	
	ManfCode= I.ManfCode,   
	Manufacturer= M.NAME,   
	TPValue= Round(SUM(S.LooseQty * S.TP), 2),
	InvValue = Round(SUM(S.LooseQty * (S.SalePrice - S.ItemFlatDisc) * (1 - S.DiscPerc * 0.01) * (1 - S.InvDiscPerc * 0.01)), 2),
	Diff= Round(SUM(S.LooseQty * S.TP), 2) - Round(SUM(S.LooseQty * (S.SalePrice - S.ItemFlatDisc) * (1 - S.DiscPerc * 0.01) * (1 - S.InvDiscPerc * 0.01)), 2),
	DiscValue= Round((Round(SUM(S.LooseQty * S.TP), 2) - Round(SUM(S.LooseQty * (S.SalePrice - S.ItemFlatDisc) * (1 - S.DiscPerc * 0.01) * (1 - S.InvDiscPerc * 0.01)), 2)) * (:ai_discperc * 0.01), 2),
	ClaimAmt= Round((Round(SUM(S.LooseQty * S.TP), 2) - Round(SUM(S.LooseQty * (S.SalePrice - S.ItemFlatDisc) * (1 - S.DiscPerc * 0.01) * (1 - S.InvDiscPerc * 0.01)), 2)) * (1 - :ai_discperc * 0.01), 2)

FROM
	Item I, Accounts A, Manufacturer M,
	(SELECT 
		S.SaleInvCode,
		S.CustCode,
		S.Date,
		D.ICode,
		D.LooseQty,
		D.BonusQty,
		D.ItemFlatDisc,
		D.DiscPerc,
		D.SalePrice,
		TP = Round(D.PackPrice / CASE D.PackUnits WHEN 0 THEN 1 ELSE D.PackUnits END, 2),
		InvDiscPerc=S.DiscPerc
	FROM
		SaleLedger S, SaleDetail D, Item I
	WHERE
		S.Posted = 'Y' AND
		S.Date >= :ad_startdate AND S.DATE <= :ad_enddate AND
		S.CustCode IN (:ai_custcode) AND
		S.SaleInvCode = D.SaleInvCode AND
		D.ICode = I.ICode AND
		I.ManfCode IN (:ai_manfcode)) S
	
WHERE 
	S.CustCode = A.AccCode AND
	S.ICode = I.ICode AND
	I.ManfCode IN (:ai_manfcode) AND M.ManfCode = I.ManfCode
GROUP BY
	S.SaleInvCode,
	S.CustCode,
	S.Date,
	A.Name,
	A.AliasName,
	I.ManfCode,
	M.Name
UNION ALL
SELECT 
	Grouping=2,
	InvCode=NULL,
	Custcode=NULL,
	Date=NULL,
	AliasName=NULL,
	Customer=C.Name,	
	ManfCode= NULL,   
	Manufacturer= NULL,   
	TPValue= Round(SUM(S.LooseQty * S.TP), 2),
	InvValue = Round(SUM(S.LooseQty * (S.SalePrice - S.ItemFlatDisc) * (1 - S.DiscPerc * 0.01) * (1 - S.InvDiscPerc * 0.01)), 2),
	Diff= Round(SUM(S.LooseQty * S.TP), 2) - Round(SUM(S.LooseQty * (S.SalePrice - S.ItemFlatDisc) * (1 - S.DiscPerc * 0.01) * (1 - S.InvDiscPerc * 0.01)), 2),
	DiscValue= Round((Round(SUM(S.LooseQty * S.TP), 2) - Round(SUM(S.LooseQty * (S.SalePrice - S.ItemFlatDisc) * (1 - S.DiscPerc * 0.01) * (1 - S.InvDiscPerc * 0.01)), 2)) * (:ai_discperc * 0.01), 2),
	ClaimAmt= Round((Round(SUM(S.LooseQty * S.TP), 2) - Round(SUM(S.LooseQty * (S.SalePrice - S.ItemFlatDisc) * (1 - S.DiscPerc * 0.01) * (1 - S.InvDiscPerc * 0.01)), 2)) * (1 - :ai_discperc * 0.01), 2)

FROM
	Item I, ItemCategory C,
	(SELECT 
		S.SaleInvCode,
		S.CustCode,
		S.Date,
		D.ICode,
		D.LooseQty,
		D.BonusQty,
		D.ItemFlatDisc,
		D.DiscPerc,
		D.SalePrice,
		TP = Round(D.PackPrice / CASE D.PackUnits WHEN 0 THEN 1 ELSE D.PackUnits END, 2),
		InvDiscPerc=S.DiscPerc
	FROM
		SaleLedger S, SaleDetail D, Item I
	WHERE
		S.Posted = 'Y' AND
		S.Date >= :ad_startdate AND S.DATE <= :ad_enddate AND
		S.CustCode IN (:ai_custcode) AND
		S.SaleInvCode = D.SaleInvCode AND
		D.ICode = I.ICode AND
		I.ManfCode IN (:ai_manfcode)) S
	
WHERE 
	S.ICode = I.ICode AND
	I.ICatCode = C.ICatCode
GROUP BY
	I.ICatCode,
	C.Name
ORDER BY
	Grouping,
	Manufacturer,
	Customer,
	AliasName,
	InvCode"
  arguments=(("ai_custcode", numberlist), ("ai_manfcode", numberlist), ("ai_discperc", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
