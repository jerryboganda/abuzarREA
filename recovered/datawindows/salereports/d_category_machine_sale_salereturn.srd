table(column=(type=number updatewhereclause=yes name=reportgroup dbname="reportgroup"  )
column=(type=char(20) updatewhereclause=yes name=category dbname="category"  )
column=(type=number updatewhereclause=yes name=salevalue dbname="salevalue"  )
column=(type=number updatewhereclause=yes name=salereturn dbname="salereturn"  )
 retrieve="SELECT
	ReportGroup = Code1,
	Category = Name1,
	MachineName = Name2,
	SaleValue = Value1,
	SaleReturn = Value2,
	StartDate = Date1,
	EndDate = Date2
FROM 
	ReportData
ORDER BY
	ReportGroup,
	Category,
	MachineName

"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="reportgroup A, category A"
)
group(level=1 header.height=0 trailer.height=0 by=("reportgroup"  ) header.color="536870912" trailer.color="536870912" )
