table(column=(type=char(13) updatewhereclause=yes name=type dbname="Type"  )
column=(type=char(31) updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="SalesMan"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=long updatewhereclause=yes name=smancode dbname="SMANCode"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(2) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
 retrieve="SELECT 
	Type = ' Sales',
	documentcode = 'SV-' + LTRIM(RTRIM(STR(S.SaleInvCode, 10))), 
	SalesMan = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = S.SManCode),
	AliasName = A.AliasName,
	CustomerName = A.Name,
	SMANCode=S.SManCode,
	InvCode=S.SaleInvCode, 
	Date = S.Date,
	SaleValue = S.InvTotal
FROM
	SaleLedger S, Accounts A
WHERE
	S.SManCode IN (:ai_smancode) AND
	S.Posted = 'Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND 
	S.CustCode = A.AccCode
UNION ALL
SELECT 
	Type = ' Sales Return',
	documentcode = 'SR-' + LTRIM(RTRIM(STR(S.SRInvCode, 10))), 
	SalesMan = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = S.SManCode),
	AliasName = A.AliasName,
	CustomerName = A.Name,
	SMANCode=S.SManCode,
	InvCode=S.SRInvCode,
	Date = S.Date,
	SaleValue = - S.InvTotal
FROM
	SRLedger S, Accounts A
WHERE
	S.SManCode IN (:ai_smancode) AND
	S.Posted = 'Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND 
	S.CustCode = A.AccCode
UNION ALL
SELECT 
	Type = 'Credit Note',
	documentcode = VC.ShortName + '-' + LTRIM(RTRIM(STR(H.GLVochCode, 10))), 
	SalesMan = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = H.SManCode),
	AliasName = A.AliasName,
	CustomerName = A.Name,
	SMANCode=H.SManCode,
	InvCode=H.GLVochCode,
	Date = H.Date,
	SaleValue = - D.Credit
FROM
	GLHeader H, GLDetail D, Accounts A, VocherCategory VC
WHERE
	H.VochCatCode IN (20,22) AND 
	H.SManCode IN (:ai_smancode) AND
	H.Posted = 'Y' AND
	H.Date BETWEEN :adt_startdate AND :adt_enddate AND 
	H.VochCatCode = VC.VochCatCode AND
	H.GLVochCode = D.GLVochCode AND
	D.AccCode = A.AccCode AND
	D.Credit > 0"
  arguments=(("ai_smancode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime), ("ad_incentiveperc", number), ("ai_pricetype", number))
 sort="salesman A, type A, date A, invcode A"
)
