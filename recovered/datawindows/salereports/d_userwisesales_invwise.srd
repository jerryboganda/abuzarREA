summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=long updatewhereclause=yes name=usercode dbname="usercode"  )
column=(type=decimal(6) updatewhereclause=yes name=creditamount dbname="Creditamount"  )
column=(type=long updatewhereclause=yes name=totalcreditinv dbname="totalcreditinv"  )
column=(type=decimal(6) updatewhereclause=yes name=retailamount dbname="Retailamount"  )
column=(type=long updatewhereclause=yes name=totalretailinv dbname="totalretailinv"  )
column=(type=decimal(6) updatewhereclause=yes name=creditretamount dbname="creditRetamount"  )
column=(type=long updatewhereclause=yes name=totalcreditretinv dbname="totalcreditretinv"  )
column=(type=decimal(6) updatewhereclause=yes name=retailretamount dbname="RetailRetamount"  )
column=(type=long updatewhereclause=yes name=totalretailretinv dbname="totalRetailretinv"  )
 retrieve="select UserName = users.username,  
		 usercode= users.usercode, 
		 Creditamount=(select ISNULL(sum (SL.invtot),0) 
							from (select users.usercode,
									invtot=Round(  Sum (  saledetail.looseqty *  saledetail.saleprice)    
			        				-  Round(Sum (Round((  saledetail.looseqty  * ( saledetail.saleprice -  saledetail.itemflatdisc) * ( saledetail.discperc * .01)) + ( saledetail.looseqty  *  saledetail.itemflatdisc),2)), 2)    
    		        				-  Sum ( Round( saledetail.looseqty   * ( saledetail.saleprice  -  saledetail.itemflatdisc) * (1 - ( saledetail.discperc * .01)),2)) * ( saleledger.discperc /100)
					 				+ misccharges - flatdisc,0)

 		 		 					from saleledger, saledetail, users
									where (saleledger.saleinvcode between :ai_sinvcode and :ai_linvcode)and
											(saleledger.salecatcode IN (1,2)) and
											(saleledger.salesmancode=users.usercode)and
											(saleledger.saleinvcode=saledetail.saleinvcode) 
									group by saleledger.saleinvcode,
											saleledger.flatdisc,
											saleledger.misccharges,
											saleledger.discperc,
											users.usercode
					           ) as SL	where SL.usercode=users.usercode
							),

		totalcreditinv= (select count(saleinvcode)
							  from saleledger
							  where (saleledger.saleinvcode between :ai_sinvcode and :ai_linvcode)and
									  (saleledger.salecatcode IN (1,2)) and
								     (saleledger.salesmancode=users.usercode)
							),
		Retailamount=(select  ISNULL(sum(SL.invtotal),0) 
						  from (select 
										invtotal=ISNull(Round(  Sum (  saledetail.looseqty *  saledetail.saleprice)    
			        					-  Round(Sum (Round((  saledetail.looseqty  * ( saledetail.saleprice -  saledetail.itemflatdisc) * ( saledetail.discperc * .01)) + ( saledetail.looseqty  *  saledetail.itemflatdisc),2)), 2)    
    		        					-  Sum ( Round( saledetail.looseqty   * ( saledetail.saleprice  -  saledetail.itemflatdisc) * (1 - ( saledetail.discperc * .01)),2)) * ( saleledger.discperc /100)
					 					+ misccharges - flatdisc,0),0)

 		 		 					from saleledger, saledetail
									where (saleledger.saleinvcode between :ai_sinvcode and :ai_linvcode)and
											(saleledger.salecatcode IN (3)) and
											(saleledger.salesmancode=users.usercode)and
											(saleledger.saleinvcode=saledetail.saleinvcode) 
									group by saleledger.saleinvcode,
											saleledger.flatdisc,
											saleledger.misccharges,
											saleledger.discperc
											
								) as SL  
						),

		totalretailinv= (select count(saleinvcode)
							  from saleledger
							  where (saleledger.saleinvcode between :ai_sinvcode and :ai_linvcode)and
									  (saleledger.salecatcode IN (3)) and
								     (saleledger.salesmancode=users.usercode)
							),

		creditRetamount=( select ISNULL(sum(SR.invtotal),0)
								from (select  users.usercode,
										invtotal=	ISNULL(Round(Sum ( dbo.srdetail.looseqty * dbo.srdetail.srprice), 2)    
													- Round(Sum (Round( dbo.srdetail.looseqty  * dbo.srdetail.srprice * (dbo.srdetail.discperc * .01),2)), 2)    
    												- Round(Sum (Round( (dbo.srdetail.looseqty  ) * dbo.srdetail.srprice * (1 - (dbo.srdetail.discperc * .01)),2)) * (dbo.srledger.discperc /100), 2)     
													+ misccharges - flatdisc,0)
										from srledger,srdetail,users
										where 	(srledger.srinvcode between :ai_sretinvcode and :ai_lretinvcode )and
													(srledger.srcatcode IN (6,7) )and
													(srledger.salesmancode=users.usercode) and
													(srledger.srinvcode=srdetail.srinvcode)
										group by srledger.srinvcode,
													srledger.misccharges,
													srledger.flatdisc,
													srledger.discperc,
													users.usercode
							       )as SR where SR.usercode=users.usercode
							)	,
		totalcreditretinv=(select count(srinvcode)
								 from srledger
								where 	(srledger.srinvcode between :ai_sretinvcode and :ai_lretinvcode )and
											(srledger.srcatcode IN (6,7) )and
											(srledger.salesmancode=users.usercode) 
								),


		
		RetailRetamount=( select 	ISNULL(sum(SR.invtotal),0)
								from ( select 
										 invtotal=ISNULL(Round(Sum ( dbo.srdetail.looseqty * dbo.srdetail.srprice), 2)    
													- Round(Sum (Round( dbo.srdetail.looseqty  * dbo.srdetail.srprice * (dbo.srdetail.discperc * .01),2)), 2)    
    												- Round(Sum (Round( (dbo.srdetail.looseqty  ) * dbo.srdetail.srprice * (1 - (dbo.srdetail.discperc * .01)),2)) * (dbo.srledger.discperc /100), 2)     
													+ misccharges - flatdisc,0)
										from srledger,srdetail
										where 	(srledger.srinvcode between :ai_sretinvcode and :ai_lretinvcode )and
													(srledger.srcatcode IN (8) )and
													(srledger.salesmancode=users.usercode) and
													(srledger.srinvcode=srdetail.srinvcode)
										group by srledger.srinvcode,
													srledger.misccharges,
													srledger.flatdisc,
													srledger.discperc
									)as SR
							)	,
		totalRetailretinv=(select count(srinvcode)
								 from srledger
								where 	(srledger.srinvcode between :ai_sretinvcode and :ai_lretinvcode )and
											(srledger.srcatcode IN (8) )and
											(srledger.salesmancode=users.usercode) 
								)


from    Users	



ORDER BY users.username  			
"
  arguments=(("ai_sinvcode", number), ("ai_linvcode", number), ("ai_sretinvcode", number), ("ai_lretinvcode", number))
)
