release 12.5;
datawindow ( units=0 timer_interval=0 processing=3 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=long updatewhereclause=yes name=day dbname="DAY"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="accountname"  )
column=(type=decimal(6) updatewhereclause=yes name=compute_0003 dbname="compute_0003"  )
 retrieve="  SELECT DAY=datepart(dd,date),
		   accountname=(SELECT	 name FROM accounts WHERE acccode=:ar_custcode), 
		   sum(saleamount) 

FROM

(SELECT 	date= dbo.saleledger.date,    
			saleamount=Round(sum(saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc) * (1 - (0.01 * saledetail.discperc))) * (1 - (0.01 * saleledger.discperc)) - saleledger.flatdisc + saleledger.misccharges,0)
 
FROM     dbo.saleledger, 
         dbo.saledetail   


WHERE ( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and  
      ( dbo.saleledger.custcode = :ar_custcode )and  
   	( dbo.saleledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY dbo.saleledger.saleinvcode ,
			dbo.saleledger.date ,
         dbo.saleledger.misccharges,   
         dbo.saleledger.flatdisc, 
			dbo.saleledger.discperc

     
UNION ALL

SELECT 	date= dbo.saleledger.date,    
			saleamount=Round(sum(sd.looseqty * (sd.saleprice - sd.itemflatdisc) * (1 - (0.01 * sd.discperc))) * (1 - (0.01 * saleledger.discperc)) - saleledger.flatdisc + saleledger.misccharges,0)
 
FROM     dbo.saleledger, 
         dbo.saleinvdetail sd


WHERE ( DBO.SaleLedger.impactinventory = 'N') AND 
		( dbo.saleledger.saleinvcode = sd.saleinvcode ) and  
      ( dbo.saleledger.custcode = :ar_custcode )and  
   	( dbo.saleledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY dbo.saleledger.saleinvcode ,
			dbo.saleledger.date ,
         dbo.saleledger.misccharges,   
         dbo.saleledger.flatdisc, 
			dbo.saleledger.discperc

     
UNION ALL

SELECT   date= dbo.srledger.date, 
			sramount= -1 * Round(sum((srdetail.looseqty * srdetail.srprice) * (1 - (0.01 * srdetail.discperc))) * (1 - (0.01 * srledger.discperc)) - srledger.flatdisc + srledger.misccharges,0)

FROM     dbo.srledger, 
         dbo.srdetail   


WHERE ( dbo.srledger.srinvcode = dbo.srdetail.srinvcode ) and  
      ( dbo.srledger.custcode = :ar_custcode )and 
  	   ( dbo.srledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY 
         dbo.srledger.srinvcode,
			dbo.srledger.date ,
			dbo.srledger.misccharges,   
         dbo.srledger.flatdisc,  
			dbo.srledger.discperc  
			
 )   as a

GROUP BY datepart(dd,date) 
ORDER BY       datepart(dd,date)
"
  arguments=(("ar_custcode", number), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
