table(column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="ICatCode"  )
column=(type=decimal(6) updatewhereclause=yes name=sales dbname="Sales"  )
column=(type=decimal(6) updatewhereclause=yes name=ret dbname="Ret"  )
column=(type=decimal(9) updatewhereclause=yes name=cgs dbname="CGS"  )
column=(type=decimal(6) updatewhereclause=yes name=gstvalue dbname="GSTValue"  )
column=(type=decimal(9) updatewhereclause=yes name=stock dbname="Stock"  )
 retrieve="SELECT	
	Category=R.Category,
	R.ICatCode,
	Sales=ROUND(SUM(R.Sales), 0),
	Ret=ROUND(SUM(R.Ret), 0),
	CGS=ROUND(SUM(R.CGS), 0),
	GSTValue = SUM(R.GSTValue),
	Stock=ROUND(SUM(R.Stock), 0)
FROM 
	(SELECT	
		Category=IC.name,
		IC.ICatCode,
		Sales=ROUND(SUM(
			CASE S.TYPE WHEN 'S' THEN 
				S.itemvalue - (S.flatdisc * (S.itemvalue/
					CASE S.grossamt WHEN 0 THEN 1 ELSE S.grossamt END))
			ELSE 0 END), 0),
		Ret=0,
		CGS=-SUM(S.Cost),
		GSTValue = SUM(S.GSTValue),
		Stock=0
	FROM	
		(SELECT
			SL.saleinvcode,
			SD.icode,
			Cost = SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice),
			GrossValue = SUM(SD.looseqty * SD.saleprice ) ,
			ItemDiscValue = SUM((SD.looseqty * (SD.saleprice - SD.itemflatdisc))*
								 (.01 * SD.discperc) + SD.itemflatdisc ),
			InvItemDiscValue = SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*
									(1 - (.01 * SD.discperc) ) *  (.01 * SL.discperc) ),
			ItemValue=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*
				(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc)),
			GrossAmt=
				isnull((SELECT ISNULL(SUM((SDD.looseqty*(SDD.saleprice - SDD.itemflatdisc)) *
					(1 - (.01 * SDD.discperc)) * (1- (.01 * SLL.discperc))), 0)
				FROM	saledetail SDD, saleledger SLL
				WHERE SLL.saleinvcode=SL.saleinvcode and SLL.saleinvcode=SDD.saleinvcode
				GROUP BY SLL.saleinvcode), 0),
			SL.flatdisc,
			catcode=SL.salecatcode,
			GSTValue = SUM((SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
				SUM(SD.looseqty * (SD.saleprice - SD.itemflatdisc) * (1 - (.01 * SD.discperc)) * SD.gstperc * 0.01),
			type='S'
		
		FROM
			saleledger SL,	 
			saledetail SD
		
		WHERE
			SL.headerno=:ar_headerno AND
			SL.SaleInvCode = SD.SaleInvCode AND
			SL.Date >= :ar_startdate AND SL.Date <= :ar_enddate AND
			SL.SaleCatCode IN (:ai_salecatcode)

		GROUP BY 
			 SL.saleinvcode,
			 SL.salesmancode,
			 SD.icode,
			 SL.salecatcode,
			 SL.discperc,
			 SL.flatdisc,
			 SL.invgstperc1,
			 SL.salecatcode
		UNION ALL
		SELECT
			SL.saleinvcode,
			SD.icode,
			Cost = SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice),
			GrossValue = SUM(SD.looseqty * SD.saleprice ) ,
			ItemDiscValue = SUM((SD.looseqty * (SD.saleprice - SD.itemflatdisc))*
								 (.01 * SD.discperc) + SD.itemflatdisc ),
			InvItemDiscValue = SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*
									(1 - (.01 * SD.discperc) ) *  (.01 * SL.discperc) ),
			ItemValue=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*
				(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc)),
			GrossAmt=
				isnull((SELECT ISNULL(SUM((SDD.looseqty*(SDD.saleprice - SDD.itemflatdisc)) *
					(1 - (.01 * SDD.discperc)) * (1- (.01 * SLL.discperc))), 0)
				FROM	saledetail SDD, saleledger SLL
				WHERE SLL.saleinvcode=SL.saleinvcode and SLL.saleinvcode=SDD.saleinvcode
				GROUP BY SLL.saleinvcode), 0),
			SL.flatdisc,
			catcode=SL.salecatcode,
			GSTValue = SUM((SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
				SUM(SD.looseqty * (SD.saleprice - SD.itemflatdisc) * (1 - (.01 * SD.discperc)) * SD.gstperc * 0.01),
			type='S'
		
		FROM
			saleledger SL,	 
			saleinvdetail SD
		
		WHERE
			SL.headerno=:ar_headerno AND
			SL.ImpactInventory = 'N' AND
			SL.SaleInvCode = SD.SaleInvCode AND
			SL.Date >= :ar_startdate AND SL.Date <= :ar_enddate AND
			SL.SaleCatCode IN (:ai_salecatcode)

		GROUP BY 
			 SL.saleinvcode,
			 SL.salesmancode,
			 SD.icode,
			 SL.salecatcode,
			 SL.discperc,
			 SL.flatdisc,
			 SL.invgstperc1,
			 SL.salecatcode) S,
		Item I, 
		(SELECT ICatCode = M.ManfCode, Name=M.Name 
		FROM Manufacturer M 
		WHERE :as_group = 'M'
		UNION ALL
		SELECT ICatCode = C.ICatCode, Name=C.Name 
		FROM ItemCategory C 
		WHERE :as_group = 'C'
		UNION ALL
		SELECT ICatCode = L.ICCode, Name=L.Name 
		FROM ItemClass L 
		WHERE :as_group = 'L'
		UNION ALL
		SELECT ICatCode = P.PackCode, Name=P.Name 
		FROM ItemPacking P 
		WHERE :as_group = 'P') IC
	WHERE	
		S.ICode = I.ICode AND
		CASE :as_group 
			WHEN 'M' THEN I.ManfCode 
			WHEN 'C' THEN I.ICatCode 
			WHEN 'L' THEN I.ICCode 
			WHEN 'P' THEN I.PackCode 
		END = IC.ICatCode
	GROUP BY 
		IC.name,
		IC.ICatCode
	UNION ALL
	SELECT	
		Category=IC.name,
		IC.ICatCode,
		Sales=0,
		Ret=-ROUND(SUM(
		CASE S.TYPE WHEN 'R' THEN
			S.itemvalue - (S.flatdisc*(S.itemvalue/
				CASE S.grossamt WHEN 0 THEN 1 
				ELSE S.grossamt END)) 
		ELSE 0 END), 0),
		CGS=SUM(S.Cost),
		GSTValue = SUM(S.GSTValue),
		Stock=0
	FROM	
		(SELECT
			SL.srinvcode,
			SD.icode,
			Cost = SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice),
			GrossValue = SUM( SD.looseqty * SD.srprice ) ,
			ItemDiscValue = SUM((SD.looseqty * SD.srprice ) * (.01 * SD.discperc) ),
			InvItemDiscValue = SUM( ( (SD.looseqty * SD.srprice) *
										(1 - (.01 * SD.discperc) ) ) * (.01 * SL.discperc) ),
			ItemValue=SUM((SD.looseqty * SD.srprice *
				(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc))),
			GrossAmt=ISNULL((SELECT SUM((SDD.looseqty * SDD.srprice *
					(1 - (.01 * SDD.discperc))) * (1- (.01 * SLL.discperc)))
				FROM	srdetail SDD, srledger SLL
				WHERE SLL.srinvcode=SL.srinvcode and SLL.srinvcode=SDD.srinvcode
				GROUP BY SLL.srinvcode), 0),
			SL.flatdisc,
			catcode=SL.srcatcode,
			GSTValue = - (SUM((SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
				SUM(SD.looseqty * SD.srprice * (1 - (.01 * SD.discperc)) * SD.gstperc * 0.01)),
			type='R'
		
		FROM
			srledger SL,	 
			srdetail SD
		
		WHERE
			SL.headerno=:ar_headerno AND
			SL.SRInvCode = SD.SRInvCode AND
			SL.Date >= :ar_startdate AND SL.Date <= :ar_enddate AND
			SL.SRCatCode IN (:ai_salecatcode)
		
		GROUP BY
			 SL.srinvcode,
			 SL.salesmancode,
			 SD.icode,
			 SL.srcatcode,
			 SL.discperc,
			 SL.flatdisc,
			 SL.invgstperc1,
			 SL.srcatcode) S,
		Item I, 
		(SELECT ICatCode = M.ManfCode, Name=M.Name 
		FROM Manufacturer M 
		WHERE :as_group = 'M'
		UNION ALL
		SELECT ICatCode = C.ICatCode, Name=C.Name 
		FROM ItemCategory C 
		WHERE :as_group = 'C'
		UNION ALL
		SELECT ICatCode = L.ICCode, Name=L.Name 
		FROM ItemClass L 
		WHERE :as_group = 'L'
		UNION ALL
		SELECT ICatCode = P.PackCode, Name=P.Name 
		FROM ItemPacking P 
		WHERE :as_group = 'P') IC
	WHERE	
		S.ICode = I.ICode AND
		CASE :as_group 
			WHEN 'M' THEN I.ManfCode 
			WHEN 'C' THEN I.ICatCode 
			WHEN 'L' THEN I.ICCode 
			WHEN 'P' THEN I.PackCode 
		END = IC.ICatCode
	GROUP BY 
		IC.name,
		IC.ICatCode
	UNION ALL
	SELECT	
		Category=IC.name,
		IC.ICatCode,
		Sales=0,
		Ret=0,
		CGS=0,
		GSTValue = 0.00,
		Stock=SUM(S.CurrQty * I.AvgPrice)
	FROM	
		GodownDetail S, 
		Item I, 
		(SELECT ICatCode = M.ManfCode, Name=M.Name 
		FROM Manufacturer M 
		WHERE :as_group = 'M'
		UNION ALL
		SELECT ICatCode = C.ICatCode, Name=C.Name 
		FROM ItemCategory C 
		WHERE :as_group = 'C'
		UNION ALL
		SELECT ICatCode = L.ICCode, Name=L.Name 
		FROM ItemClass L 
		WHERE :as_group = 'L'
		UNION ALL
		SELECT ICatCode = P.PackCode, Name=P.Name 
		FROM ItemPacking P 
		WHERE :as_group = 'P') IC
	WHERE	
		S.ICode = I.ICode AND
		CASE :as_group 
			WHEN 'M' THEN I.ManfCode 
			WHEN 'C' THEN I.ICatCode 
			WHEN 'L' THEN I.ICCode 
			WHEN 'P' THEN I.PackCode 
		END = IC.ICatCode
	GROUP BY 
		IC.name,
		IC.ICatCode) R
GROUP BY 
	R.Category,
	R.ICatCode
ORDER BY
	R.Category,
	R.ICatCode
"
  arguments=(("as_group", string), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ai_salecatcode", numberlist), ("ar_headerno", number))
)
