release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1916 color="536870912" )
summary(height=708 color="536870912" )
footer(height=437 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=char(60) updatewhereclause=yes name=wardname dbname="wardname"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
 retrieve="SELECT itemname = item.name,
		manufacturer=(select name from manufacturer where manufacturer.manfcode=Max(Item.manfcode)),
		 looseqty = Sum (dbo.saledetail.looseqty),
		 price = Max (dbo.saledetail.saleprice),
		wardname=(select name from ward where ward.wardcode=saleledger.wardcode),
		customer=(select name from accounts where accounts.acccode=:al_custcode)
FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item

WHERE  CASE lower(:as_datetype) 
		 	When 'originaldate' Then dbo.saleledger.originaldate 
			When 'lastsavingdate' Then dbo.saleledger.date
			When 'billingdate' Then dbo.saleledger.billingdate
  		 End Between :ad_startdate AND :ad_enddate AND
		 dbo.saleledger.custcode=:al_custcode AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.wardcode IN (:al_wardcode) AND
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		 dbo.saledetail.icode = item.icode 

Group by 
		dbo.saleledger.wardcode,
		dbo.saledetail.icode,
		dbo.item.name
UNION ALL
SELECT itemname = item.name,
		manufacturer=(select name from manufacturer where manufacturer.manfcode=Max(Item.manfcode)),
		 looseqty = Sum (sd.looseqty),
		 price = Max (sd.saleprice),
		wardname=(select name from ward where ward.wardcode=saleledger.wardcode),
		customer=(select name from accounts where accounts.acccode=:al_custcode)
		  
FROM 	 dbo.saleledger, 
		 dbo.saleinvdetail sd,    
		 dbo.item

WHERE  CASE lower(:as_datetype) 
		 	When 'originaldate' Then dbo.saleledger.originaldate 
			When 'lastsavingdate' Then dbo.saleledger.date
			When 'billingdate' Then dbo.saleledger.billingdate
  		 End Between :ad_startdate AND :ad_enddate AND
		  dbo.saleledger.custcode=:al_custcode AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.wardcode IN (:al_wardcode) AND
		 dbo.saleledger.saleinvcode = sd.saleinvcode AND
		 sd.icode = item.icode 

Group by 
		dbo.saleledger.wardcode,
		sd.icode,
		dbo.item.name
Order by wardname,
		     itemname




"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("al_wardcode", numberlist), ("as_datetype", string), ("al_custcode", number), ("as_supressheader", string), ("al_discperc", number))
)
