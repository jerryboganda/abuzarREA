table(column=(type=char(13) updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(9) updatewhereclause=yes name=discval dbname="discval"  )
column=(type=decimal(9) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=char(100) updatewhereclause=yes name=salestaxschedule dbname="SalesTaxSchedule"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(6) updatewhereclause=yes name=taxval dbname="taxval"  )
 retrieve="select 
	documentcode = 'SV-' + LTRIM(RTRIM(STR(SL.SaleInvCode, 10))), 
	invcode=SL.saleinvcode,
	itemname=(select name from item where item.icode=SD.icode),
	date=SL.date,
	rate=SD.saleprice,
	qty=SD.looseqty, 
	bonusqty=SD.bonusqty,
	discval=SD.looseqty*((SD.saleprice - SD.itemflatdisc)* SD.discperc*0.01)+(SD.looseqty*SD.itemflatdisc),
	amount=(SD.looseqty*(SD.saleprice - SD.itemflatdisc))*(1 - SD.discperc*0.01),
	SalesTaxSchedule=STS.Name,
	gstperc=STS.taxperc,
	taxval=((SD.bonusqty+SD.looseqty)*SD.unitsalestax )+( SD.looseqty*(SD.saleprice-SD.itemflatdisc)*(1 - SD.discperc*0.01))*SD.gstperc*0.01
from saledetail SD, saleledger SL, Item I, SalesTaxSchedule STS
where SL.date >=:ar_sdate and 
	SL.date<= :ar_edate and	
	SL.saleinvcode=SD.saleinvcode and
	SD.ICode=I.ICode AND
	I.SalesTaxScheduleCode=STS.SalesTaxScheduleCode
UNION ALL
select 
	documentcode = 'SR-' + LTRIM(RTRIM(STR(SL.SRInvCode, 10))), 
	invcode=SL.srinvcode,
	itemname=(select name from item where item.icode=SD.icode),
	date=SL.date,
	rate=(SD.srprice)* (-1),
	qty=SD.looseqty,
	bonusqty=SD.bonusqty,
	discval=(SD.looseqty*(SD.srprice* SD.discperc*0.01)) * (-1),
	amount=(SD.looseqty*(SD.srprice - SD.discperc * 0.01))* (-1),
	SalesTaxSchedule=STS.Name,
	gstperc=STS.taxperc,
	taxval=(((SD.bonusqty+SD.looseqty)*SD.unitsalestax)+( SD.looseqty*(SD.srprice - SD.discperc*0.01))*SD.gstperc*0.01)* (-1)
from srdetail SD, srledger SL, Item I, SalesTaxSchedule STS
where SL.date >=:ar_sdate and 
	SL.date<= :ar_edate and	
	SL.srinvcode=SD.srinvcode and
	SD.ICode=I.ICode AND
	I.SalesTaxScheduleCode=STS.SalesTaxScheduleCode
ORDER by date,
	 invcode,
	 itemname"
  arguments=(("ar_sdate", datetime), ("ar_edate", datetime))
)
