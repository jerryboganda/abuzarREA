table(column=(type=char(13) updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="SalesMan"  )
column=(type=long updatewhereclause=yes name=smancode dbname="SMANCode"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=invrate dbname="InvRate"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(13) updatewhereclause=yes name=incentiveprice dbname="IncentivePrice"  )
column=(type=decimal(6) updatewhereclause=yes name=incentivecost dbname="IncentiveCost"  )
column=(type=decimal(6) updatewhereclause=yes name=profit dbname="Profit"  )
column=(type=decimal(6) updatewhereclause=yes name=incentiveamount dbname="IncentiveAmount"  )
column=(type=decimal(6) updatewhereclause=yes name=flatincentive dbname="FlatIncentive"  )
 retrieve="SELECT 
	documentcode = 'SV-' + LTRIM(RTRIM(STR(S.SaleInvCode, 10))), 
	SalesMan = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = S.SManCode),
	SMANCode=S.SManCode,
	InvCode=S.SaleInvCode, 
	Date = S.Date,
	ICode=D.ICode,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	Qty = SUM(D.LooseQty),
	InvRate = Round( (SUM( (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * D.LooseQty) / CASE WHEN SUM(D.LooseQty) = 0 THEN 1 ELSE SUM(D.LooseQty) END), 2),
	SaleValue = Round( SUM((D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * D.LooseQty), 2),
	IncentivePrice = 
		ROUND(CASE WHEN :ai_pricetype=3 THEN I.AvgPrice 
		ELSE 
			CASE
				WHEN :ai_pricetype = 1 THEN I.SalePrice 
				WHEN :ai_pricetype = 2 THEN I.PurPrice 
				ELSE D.ALternatePurPrice 
			END / CASE WHEN I.PackUnits = 0 THEN 1 ELSE I.PackUnits END
		END, 2),
	IncentiveCost = SUM(D.LooseQty) *
		ROUND(CASE WHEN :ai_pricetype=3 THEN I.AvgPrice 
		ELSE 
			CASE
				WHEN :ai_pricetype = 1 THEN I.SalePrice 
				WHEN :ai_pricetype = 2 THEN I.PurPrice 
				ELSE D.ALternatePurPrice 
			END / CASE WHEN I.PackUnits = 0 THEN 1 ELSE I.PackUnits END
		END, 2),
	Profit =
		Round( SUM((D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * D.LooseQty), 2) -
		(SUM(D.LooseQty) *
			ROUND(CASE WHEN :ai_pricetype=3 THEN I.AvgPrice 
			ELSE 
				CASE
					WHEN :ai_pricetype = 1 THEN I.SalePrice 
					WHEN :ai_pricetype = 2 THEN I.PurPrice 
					ELSE D.ALternatePurPrice 
				END / CASE WHEN I.PackUnits = 0 THEN 1 ELSE I.PackUnits END
			END, 2)),
	IncentiveAmount=
		(Round( SUM((D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * D.LooseQty), 2) -
		(SUM(D.LooseQty) *
			ROUND(CASE WHEN :ai_pricetype=3 THEN I.AvgPrice 
			ELSE 
				CASE
					WHEN :ai_pricetype = 1 THEN I.SalePrice 
					WHEN :ai_pricetype = 2 THEN I.PurPrice 
					ELSE D.ALternatePurPrice 
				END / CASE WHEN I.PackUnits = 0 THEN 1 ELSE I.PackUnits END
			END, 2))) * :ad_incentiveperc * 0.01,
	FlatIncentive = SUM(D.LooseQty * I.CommissionPerUnit)
FROM
	SaleLedger S, SaleDetail D, Item I
WHERE
	S.SManCode IN (:ai_smancode) AND
	S.Posted = 'Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.SaleInvCode = D.SaleInvCode AND
	D.ICode = I.ICode
GROUP BY
	S.SaleInvCode, 
	S.SManCode,
	S.Date,
	D.ICode,
	I.CustomICode,
	I.Name,
	I.AvgPrice,
	I.SalePrice,
	I.PurPrice,
	D.AlternatePurPrice,
	I.PackUnits
UNION ALL
SELECT 
	documentcode = 'SR-' + LTRIM(RTRIM(STR(S.SRInvCode, 10))), 
	SalesMan = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = S.SManCode),
	SMANCode=S.SManCode,
	InvCode=S.SRInvCode,
	Date = S.Date,
	ICode=D.ICode,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	Qty = - SUM(D.LooseQty),
	InvRate =   Round( (SUM( D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * D.LooseQty) / CASE WHEN SUM(D.LooseQty) = 0 THEN 1 ELSE SUM(D.LooseQty) END), 2),
	SaleValue = - Round(  SUM(D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * D.LooseQty), 2),
	IncentivePrice = 
		ROUND(CASE WHEN :ai_pricetype=3 THEN I.AvgPrice 
		ELSE 
			CASE
				WHEN :ai_pricetype = 1 THEN I.SalePrice 
				WHEN :ai_pricetype = 2 THEN I.PurPrice 
				ELSE D.ALternatePurPrice 
			END / CASE WHEN I.PackUnits = 0 THEN 1 ELSE I.PackUnits END
		END, 2),
	IncentiveCost = - SUM(D.LooseQty) *
		ROUND(CASE WHEN :ai_pricetype=3 THEN I.AvgPrice 
		ELSE 
			CASE
				WHEN :ai_pricetype = 1 THEN I.SalePrice 
				WHEN :ai_pricetype = 2 THEN I.PurPrice 
				ELSE D.ALternatePurPrice 
			END / CASE WHEN I.PackUnits = 0 THEN 1 ELSE I.PackUnits END
		END, 2),
	Profit =
		- (Round( SUM(D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * D.LooseQty), 2) -
		(SUM(D.LooseQty) *
			ROUND(CASE WHEN :ai_pricetype=3 THEN I.AvgPrice 
			ELSE 
				CASE
					WHEN :ai_pricetype = 1 THEN I.SalePrice 
					WHEN :ai_pricetype = 2 THEN I.PurPrice 
					ELSE D.ALternatePurPrice 
				END / CASE WHEN I.PackUnits = 0 THEN 1 ELSE I.PackUnits END
			END, 2))),
	IncentiveAmount=
		- ((Round( SUM(D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * D.LooseQty), 2) -
		(SUM(D.LooseQty) *
			ROUND(CASE WHEN :ai_pricetype=3 THEN I.AvgPrice 
			ELSE 
				CASE
					WHEN :ai_pricetype = 1 THEN I.SalePrice 
					WHEN :ai_pricetype = 2 THEN I.PurPrice 
					ELSE D.ALternatePurPrice 
				END / CASE WHEN I.PackUnits = 0 THEN 1 ELSE I.PackUnits END
			END, 2))) * :ad_incentiveperc * 0.01),
	FlatIncentive = - SUM(D.LooseQty * I.CommissionPerUnit)
FROM
	SRLedger S, SRDetail D, Item I
WHERE
	S.SManCode IN (:ai_smancode) AND
	S.Posted = 'Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.SRInvCode = D.SRInvCode AND
	D.ICode = I.ICode
GROUP BY
	S.SRInvCode, 
	S.SManCode,
	S.Date,
	D.ICode,
	I.CustomICode,
	I.Name,
	I.AvgPrice,
	I.SalePrice,
	I.PurPrice,
	D.AlternatePurPrice,
	I.PackUnits
ORDER BY
	Date
"
  arguments=(("ai_smancode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime), ("ad_incentiveperc", number), ("ai_pricetype", number))
 sort="salesman A, date A, invcode A, itemname A, qty A"
)
