release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=508 color="536870912" )
summary(height=96 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=item dbname="Item.Item"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="ItemCategory.Category"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Item.Bonus"  )
column=(type=decimal(4) updatewhereclause=yes name=sales dbname="Item.Sales"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="Item.AvgPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Item.SalePrice"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Item.PackUnits"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="Item.PackingDesc"  )
 retrieve="SELECT
	I.Name as Item,
	M.Name as Manufacturer,
	IC.Name as Category,
	S.Bonus,
	S.Sales, 
	I.AvgPrice,
	I.SalePrice,  
	I.PackUnits,
	I.PackingDesc
FROM
	Item I,
	Manufacturer M,
	ItemCategory IC,
	(SELECT
		SD.ICode,
		SUM(SD.BonusQty) as Bonus,
		SUM(SD.LooseQty) as Sales
	FROM
		SaleLedger SL,
		SaleDetail SD
	WHERE
		SD.BonusQty <> 0 AND
		SL.SaleInvCode = SD.SaleInvCode AND SL.Date BETWEEN :ar_StartDate AND :ar_EndDate
	GROUP BY
		SD.ICode
	HAVING
		SUM(SD.BonusQty) <> 0
	UNION ALL
	SELECT
		SD.ICode,
		SUM(SD.BonusQty) as Bonus,
		SUM(SD.LooseQty) as Sales
	FROM
		SaleLedger SL,
		SaleInvDetail SD
	WHERE
		SL.ImpactInventory = 'N' AND
		SD.BonusQty <> 0 AND
		SL.SaleInvCode = SD.SaleInvCode AND SL.Date BETWEEN :ar_StartDate AND :ar_EndDate
	GROUP BY
		SD.ICode
	HAVING
		SUM(SD.BonusQty) <> 0
	UNION ALL
	SELECT
		SD.ICode,
		-SUM(SD.BonusQty) as Bonus,
		-SUM(SD.LooseQty) as Sales
	FROM
		SrLedger SL,
		SrDetail SD
	WHERE
		SD.BonusQty <> 0 AND
		SL.SrInvCode = SD.SrInvCode AND SL.Date BETWEEN :ar_StartDate AND :ar_EndDate
	GROUP BY
		SD.ICode
	HAVING
		SUM(SD.BonusQty) <> 0) S
WHERE
	S.ICode = I.ICode AND
	I.ManfCode = M.ManfCode AND
	I.ICatCode IN (:ar_icatcode) AND
	I.ICatCode = IC.ICatCode
ORDER BY
	M.Name,
	I.Name,
	S.Sales,
	S.Bonus"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ar_icatcode", numberlist))
)
