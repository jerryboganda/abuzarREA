header(height=1510 color="536870912" )
summary(height=281 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=smancode dbname="SaleLedger.smancode"  )
column=(type=char(60) updatewhereclause=yes name=salesman_name dbname="SalesMan.name"  )
column=(type=long updatewhereclause=yes name=invcount dbname="invcount"  )
column=(type=decimal(2) updatewhereclause=yes name=salevalue dbname="salevalue"  )
 retrieve="Select sl.smancode,
		 s.name, 
		 invcount = count(sl.saleinvcode),	
       salevalue = Sum(invtotal)
       
From saleledger sl, salesman s

Where 	sl.date between :adt_startdate and :adt_enddate and
			sl.smancode = s.salesmancode

Group By sl.smancode, s.name

Order By s.name
"
  arguments=(("adt_StartDate", datetime), ("adt_EndDate", datetime))
)
