table(column=(type=char(13) updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=long updatewhereclause=yes name=catcode dbname="CatCode"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="Item.ManfCode"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CustAlias"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=decimal(2) updatewhereclause=yes name=invoicerate dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Saledetail.Rate"  )
column=(type=decimal(6) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=decimal(6) updatewhereclause=yes name=gross dbname="Gross"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(6) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
 retrieve="SELECT
	documentcode = 'SV-' + LTRIM(RTRIM(STR(S.SaleInvCode, 10))), 
	CatCode=I.ICatCode,  
	Category=IC.Name,
	I.ManfCode,  
	Manufacturer=M.Name,
	AliasName=I.CustomICode, 
	Item=I.Name,
	InvCode=S.SaleInvCode, 
	Date=S.DATE, 
	CustAlias=A.AliasName, 
	Customer=A.Name,
	SalePrice=SD.SalePrice,
	SD.Rate,
	NetRate= MAX((SD.LooseQty * (SD.SalePrice - SD.itemflatdisc) * 
			(1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) / 
			(CASE SD.LOOSEQTY+SD.BonusQty 
				WHEN 0 THEN 1 
				ELSE SD.LOOSEQTY+SD.BonusQty END)),
	Gross = SUM(SD.LooseQty * SD.SalePrice),
	Discount = Round(Sum (( SD.Looseqty  * (SD.saleprice - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2)+
				Sum (Round( SD.looseqty   * (SD.saleprice  - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2)) * 
				(S.discperc /100),
	DiscPerc = 	Round(((Round(Sum (( SD.Looseqty  * (SD.saleprice - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2)+
				Sum (Round( SD.looseqty   * (SD.saleprice  - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2)) * 
				(S.discperc /100)) / 
					CASE SUM(SD.LooseQty * SD.SalePrice) 
					WHEN 0 THEN 1 
					ELSE SUM(SD.LooseQty * SD.SalePrice) END) * 100, 2) ,
	Qty=SUM(SD.LooseQty), 
	Bonus=SUM(SD.BonusQty)
FROM 
	Saleledger S,
	SaleDetail SD, 
	Item I,
	ItemCategory IC,
	Manufacturer M,
	Accounts A
WHERE 
	S.DATE >= :ad_startdate AND S.Date <= :ad_enddate AND
	S.SaleInvCode = SD.SaleInvCode AND
	SD.ICode = I.ICode AND
	I.ICatCode = IC.ICatCode AND
	I.Active = 1 AND 
	(SD.BONUSQTY > 0 OR SD.DiscPerc > 0 OR S.DiscPerc > 0 OR SD.ItemFlatDisc > 0 OR
	SD.saleprice <> SD.rate) AND
	I.ICatCode IN (:ai_icatcode) AND
	I.ManfCode=M.ManfCode AND
	S.CustCode = A.AccCode
GROUP BY 
	S.SaleInvCode, 
	IC.Name,
	I.ICatCode,
	M.Name,
	I.ManfCode, 
	I.Name,
	I.CustomICode, 
	S.DATE, 
	A.Name,
	A.AliasName, 
	SD.SalePrice,
	SD.Rate,
	S.DiscPerc
UNION ALL
SELECT
	documentcode = 'SV-' + LTRIM(RTRIM(STR(S.SaleInvCode, 10))), 
	CatCode=I.ICatCode,  
	Category=IC.Name,
	I.ManfCode, 
	Manufacturer=M.Name,
	AliasName=I.CustomICode, 
	Item=I.Name,
	InvCode=S.SaleInvCode, 
	Date=S.DATE, 
	CustAlias=A.AliasName, 
	Customer=A.Name,
	SalePrice=SD.SalePrice,
	SD.Rate,
	NetRate= MAX((SD.LooseQty * (SD.SalePrice - SD.itemflatdisc) * 
			(1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) / 
			(CASE SD.LOOSEQTY+SD.BonusQty 
				WHEN 0 THEN 1 
				ELSE SD.LOOSEQTY+SD.BonusQty END)),
	Gross = SUM(SD.LooseQty * SD.SalePrice),
	Discount = Round(Sum (( SD.Looseqty  * (SD.saleprice - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2)+
				Sum (Round( SD.looseqty   * (SD.saleprice  - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2)) * 
				(S.discperc /100),
	DiscPerc = 	Round(((Round(Sum (( SD.Looseqty  * (SD.saleprice - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2)+
				Sum (Round( SD.looseqty   * (SD.saleprice  - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2)) * 
				(S.discperc /100)) / 
					CASE SUM(SD.LooseQty * SD.SalePrice) 
					WHEN 0 THEN 1 
					ELSE SUM(SD.LooseQty * SD.SalePrice) END) * 100, 2) ,
	Qty=SUM(SD.LooseQty), 
	Bonus=SUM(SD.BonusQty)
FROM 
	Saleledger S,
	SaleInvDetail SD, 
	Item I,
	ItemCategory IC,
	Manufacturer M,
	Accounts A
WHERE 
	S.ImpactInventory = 'N' AND
	S.DATE >= :ad_startdate AND S.Date <= :ad_enddate AND
	S.SaleInvCode = SD.SaleInvCode AND
	SD.ICode = I.ICode AND
	I.ICatCode = IC.ICatCode AND
	I.Active = 1 AND 
	(SD.BONUSQTY > 0 OR SD.DiscPerc > 0 OR S.DiscPerc > 0 OR SD.ItemFlatDisc > 0 OR
	SD.saleprice <> SD.rate) AND
	I.ICatCode IN (:ai_icatcode) AND
	I.ManfCode=M.ManfCode AND
	S.CustCode = A.AccCode
GROUP BY 
	S.SaleInvCode, 
	IC.Name,
	I.ICatCode,
	M.Name,
	I.ManfCode, 
	I.Name,
	I.CustomICode, 
	S.DATE, 
	A.Name,
	A.AliasName, 
	SD.SalePrice,
	SD.Rate,
	S.DiscPerc
UNION ALL
SELECT
	documentcode = 'SR-' + LTRIM(RTRIM(STR(S.SRInvCode, 10))), 
	CatCode=I.ICatCode,  
	Category=IC.Name,
	I.ManfCode,  
	Manufacturer=M.Name,
	AliasName=I.CustomICode, 
	Item=I.Name,
	InvCode=S.SRInvCode, 
	Date=S.DATE, 
	CustAlias=A.AliasName, 
	Customer=A.Name,
	SalePrice=SD.SRPrice,
	Rate=SD.SRPrice,
	NetRate= -MAX((SD.LooseQty * SD.SRPrice * 
			(1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) / 
			(CASE SD.LOOSEQTY+SD.BonusQty 
				WHEN 0 THEN 1 
				ELSE SD.LOOSEQTY+SD.BonusQty END)),
	Gross = -SUM(SD.LooseQty * SD.SalePrice),
	Discount = -Round(Sum (( SD.Looseqty  * SD.srprice * (SD.discperc * .01))), 2)+
				Sum (Round( SD.looseqty   * SD.srprice * (1 - (SD.discperc * .01)),2)) * 
				(S.discperc /100),
	DiscPerc = 	- Round(((Round(Sum (( SD.Looseqty  * SD.srprice * (SD.discperc * .01))), 2)+
				Sum (Round( SD.looseqty   * SD.srprice * (1 - (SD.discperc * .01)),2)) * 
				(S.discperc /100)) / 
					CASE SUM(SD.LooseQty * SD.SrPrice) 
					WHEN 0 THEN 1 
					ELSE SUM(SD.LooseQty * SD.SrPrice) END) * 100, 2) ,
	Qty= - SUM(SD.LooseQty), 
	Bonus= - SUM(SD.BonusQty)
FROM 
	SRledger S,
	SRDetail SD, 
	Item I,
	ItemCategory IC,
	Manufacturer M,
	Accounts A
WHERE 
	S.DATE >= :ad_startdate AND S.Date <= :ad_enddate AND
	S.SRInvCode = SD.SRInvCode AND
	SD.ICode = I.ICode AND
	I.ICatCode = IC.ICatCode AND
	I.Active = 1 AND 
	(SD.BONUSQTY > 0 OR SD.DiscPerc > 0 OR S.DiscPerc > 0) AND
	I.ICatCode IN (:ai_icatcode) AND
	I.ManfCode=M.ManfCode AND
	S.CustCode = A.AccCode
GROUP BY 
	S.SRInvCode, 
	IC.Name,
	I.ICatCode,
	M.Name,
	I.ManfCode, 
	I.Name,
	I.CustomICode, 
	S.DATE, 
	A.Name,
	A.AliasName, 
	SD.SRPrice,
	S.DiscPerc
ORDER BY 
	IC.Name,
	I.ICatCode,
	I.Name,
	I.CustomICode, 
	M.Name,
	I.ManfCode, 
	S.DATE, 
	S.SaleInvCode, 
	A.AliasName, 
	A.Name,
	SD.SalePrice
"
  arguments=(("ai_icatcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="category A, catcode A, item A, aliasname A, manufacturer A, manfcode A, date A, invcode A, customer A, custalias A, invoicerate A"
)
