release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1468 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=catcode dbname="CatCode"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=long updatewhereclause=yes name=iccode dbname="ICCode"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass"  )
column=(type=long updatewhereclause=yes name=isizecode dbname="ISizeCode"  )
column=(type=char(60) updatewhereclause=yes name=itemsize dbname="ItemSize"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=decimal(6) updatewhereclause=yes name=sale dbname="Sale"  )
column=(type=decimal(7) updatewhereclause=yes name=salevolume dbname="SaleVolume"  )
column=(type=decimal(6) updatewhereclause=yes name=salereturn dbname="SaleReturn"  )
column=(type=decimal(7) updatewhereclause=yes name=salereturnvolume dbname="SaleReturnVolume"  )
column=(type=decimal(6) updatewhereclause=yes name=netsale dbname="NetSale"  )
column=(type=decimal(7) updatewhereclause=yes name=netsalevolume dbname="NetSaleVolume"  )
 retrieve="SELECT
	CatCode=IC.ICatCode,
	ItemCategory=IC.Name,
	ICCode=ICL.ICCode,
	ItemClass=ICL.Name,
	ISizeCode=ISZ.ISizeCode,
	ItemSize=ISZ.Name, 
	SaleQty = SUM(S.SaleQty),  
	Sale=Round(SUM(S.Sale), 2),
	SaleVolume=SUM(S.SaleVolume),
	SaleReturn=Round(SUM(S.SaleReturn), 2),
	SaleReturnVolume=SUM(S.SaleReturnVolume),
	NetSale=Round(SUM(S.Sale), 2) - Round(SUM(S.SaleReturn), 2),
	NetSaleVolume=SUM(S.SaleVolume - S.SaleReturnVolume)
FROM
	ItemClass ICL,
	ItemSize ISZ,
	ItemCategory IC, 
	Item I
	LEFT OUTER JOIN 
	(SELECT
		SD.ICode,
		SaleQty = SUM(SD.LooseQty), 
		Sale = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) ),
		SaleVolume = SUM(SD.LooseQty * I.PackingFactor),
		SaleReturn = 0.00,
		SaleReturnVolume = 0.00
	FROM
		SaleLedger S, SaleDetail SD, Item I
	WHERE 
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		S.SaleInvCode = SD.SaleInvCode AND 
		SD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)
	GROUP BY
		SD.ICode
	UNION ALL
	SELECT
		SD.ICode,
		SaleQty = SUM(SD.LooseQty), 
		Sale = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) ),
		SaleVolume = SUM(SD.LooseQty * I.PackingFactor),
		SaleReturn = 0.00,
		SaleReturnVolume = 0.00
	FROM
		SaleLedger S, SaleInvDetail SD, Item I
	WHERE 
		S.impactinventory = 'N' AND
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		S.SaleInvCode = SD.SaleInvCode AND 
		SD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)
	GROUP BY
		SD.ICode
	UNION ALL
	SELECT
		SD.ICode,
		SaleQty = - SUM(SD.LooseQty), 
		Sale = 0.00,
		SaleVolume = 0.00,
		SaleReturn = SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) ),
		SaleReturnVolume = SUM(SD.LooseQty * I.PackingFactor)
	FROM
		SRLedger S, SRDetail SD, Item I
	WHERE 
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		S.SRInvCode = SD.SRInvCode AND 
		SD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)
	GROUP BY
		SD.ICode) S ON (I.ICode = S.ICode)
WHERE
	IC.ICatCode IN (:ai_icatcode) AND
	IC.ICatCode = I.ICatCode AND
	I.ICCode = ICL.ICCode AND
	I.ISizeCode = ISZ.ISizeCode
GROUP BY
	IC.ICatCode,
	IC.Name,
	ICL.ICCode,
	ICL.Name,
	ISZ.ISizeCode,
	ISZ.Name
ORDER BY
	ItemCategory,
	ItemClass,
	ItemSize

"
  arguments=(("ai_icatcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="itemcategory A, itemclass A, itemsize A"
)
