release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=150 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=989 color="536870912" )
summary(height=281 color="536870912" )
footer(height=0 color="536870912" )
detail(height=208 color="536870912"  height.autosize=yes)
table(column=(type=char(100) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(12) updatewhereclause=yes name=accalias dbname="accalias"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
 retrieve="SELECT
	itemname= CASE SaleInvDetail.SaleItemDescription WHEN NULL THEN item.name ELSE SaleInvDetail.SaleItemDescription END,   
	aliasname=item.customicode,   
	packing=item.Packingdesc,   
	accalias = dbo.accounts.aliasname,     
	accname = dbo.accounts.name,   
	address = dbo.customer.address1,   
	address2= dbo.customer.address2,   
	saleinvcode = dbo.saleledger.saleinvcode,   
	headerno = dbo.saleledger.headerno,   
	date = dbo.saleledger.date,   
	invdiscperc = dbo.saleledger.discperc,   
	looseqty = SUM(SaleInvDetail.looseqty),   
	saleprice= MAX(SaleInvDetail.saleprice)
FROM 
	saleledger,   
	SaleInvDetail,   
	customer,
	accounts,   
	item  
WHERE 
	( dbo.saleledger.saleinvcode = :ar_SaleInvCode ) AND  
	( dbo.saleledger.saleinvcode = dbo.SaleInvDetail.saleinvcode) AND  
	( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  
	( dbo.customer.custcode = dbo.accounts.acccode ) AND  
	( dbo.SaleInvDetail.icode = dbo.item.icode)    
GROUP BY
	saleledger.saleinvcode,
	saleledger.headerno,
	saleledger.date,
	saleledger.discperc,
	saleinvdetail.icode,
	SaleInvDetail.SaleItemDescription,
	item.icode,
	item.name,
	item.Packingdesc,
	item.customicode,
	accounts.name,
	accounts.aliasname,
	customer.address1,
	customer.address2
	
ORDER BY 
	saleinvcode,
	itemname"
  arguments=(("ar_SaleInvCode", number))
)
