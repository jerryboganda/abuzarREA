header(height=218 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=156 color="536870912" )
table(column=(type=char(1) updatewhereclause=yes name=band dbname="Band"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
column=(type=char(60) updatewhereclause=yes name=zone dbname="Zone"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(2) updatewhereclause=yes name=tradeprice dbname="TradePrice"  )
column=(type=decimal(4) updatewhereclause=yes name=jan dbname="Jan"  )
column=(type=decimal(4) updatewhereclause=yes name=feb dbname="Feb"  )
column=(type=decimal(4) updatewhereclause=yes name=mar dbname="Mar"  )
column=(type=decimal(4) updatewhereclause=yes name=apr dbname="Apr"  )
column=(type=decimal(4) updatewhereclause=yes name=may dbname="May"  )
column=(type=decimal(4) updatewhereclause=yes name=jun dbname="Jun"  )
column=(type=decimal(4) updatewhereclause=yes name=jul dbname="Jul"  )
column=(type=decimal(4) updatewhereclause=yes name=aug dbname="Aug"  )
column=(type=decimal(4) updatewhereclause=yes name=sep dbname="Sep"  )
column=(type=decimal(4) updatewhereclause=yes name=oct dbname="Oct"  )
column=(type=decimal(4) updatewhereclause=yes name=nov dbname="Nov"  )
column=(type=decimal(4) updatewhereclause=yes name=dec dbname="Dec"  )
 retrieve="SELECT 
	Band = 'D',
	CustomerCategory=C.CustomerCategory,
	Zone=C.Zone, 
	Area = C.Area, 
	Customer = C.Customer,
	ItemCategory = I.ItemCategory,
	Manufacturer = I.Manufacturer,
	ItemName=I.Name,
	TradePrice = ISNULL(I.SalePrice, 0),
	Jan = ISNULL(SUM(CASE MONTH(S.Date) WHEN 1 THEN S.LooseQty ELSE 0 END), 0),
	Feb = ISNULL(SUM(CASE MONTH(S.Date) WHEN 2 THEN S.LooseQty ELSE 0 END), 0),
	Mar = ISNULL(SUM(CASE MONTH(S.Date) WHEN 3 THEN S.LooseQty ELSE 0 END), 0),
	Apr = ISNULL(SUM(CASE MONTH(S.Date) WHEN 4 THEN S.LooseQty ELSE 0 END), 0),
	May = ISNULL(SUM(CASE MONTH(S.Date) WHEN 5 THEN S.LooseQty ELSE 0 END), 0),
	Jun = ISNULL(SUM(CASE MONTH(S.Date) WHEN 6 THEN S.LooseQty ELSE 0 END), 0),
	Jul = ISNULL(SUM(CASE MONTH(S.Date) WHEN 7 THEN S.LooseQty ELSE 0 END), 0),
	Aug = ISNULL(SUM(CASE MONTH(S.Date) WHEN 8 THEN S.LooseQty ELSE 0 END), 0),
	Sep = ISNULL(SUM(CASE MONTH(S.Date) WHEN 9 THEN S.LooseQty ELSE 0 END), 0),
	Oct = ISNULL(SUM(CASE MONTH(S.Date) WHEN 10 THEN S.LooseQty ELSE 0 END), 0),
	Nov = ISNULL(SUM(CASE MONTH(S.Date) WHEN 11 THEN S.LooseQty ELSE 0 END), 0),
	Dec = ISNULL(SUM(CASE MONTH(S.Date) WHEN 12 THEN S.LooseQty ELSE 0 END), 0)
FROM
	(SELECT 
		S.Date, S.CustCode, D.ICode, LooseQty=SUM(D.LooseQty)
	FROM
		SaleLedger S,
		SaleDetail D
	WHERE
		S.Date >= :ad_startdate  AND S.Date <= :ad_enddate AND
		S.SaleInvCode = D.SaleInvCode AND
		D.ICode IN 
			(SELECT I.ICode
			FROM Item I
			WHERE I.ICatcode IN (:ai_icatcode))
	GROUP BY S.Date, S.CustCode, D.ICode
	UNION ALL
	SELECT 
		Date = :ad_enddate, 
		C.CustCode, 
		I.ICode, 
		LooseQty=0
	FROM 
		(SELECT I.ICode FROM Item I WHERE I.ICatcode IN (:ai_icatcode) ) I,
		(SELECT CustCode FROM Customer 
		WHERE AreaCode IN 
			(SELECT AreaCode FROM ZoneAreas WHERE ZoneCode = :ai_zonecode) ) C) S,

	(SELECT I.ICode, I.Name, I.SalePrice, I.ICatCode, ItemCategory=IC.Name, Manufacturer=M.Name
	FROM Item I, ItemCategory IC, Manufacturer M
	WHERE I.ICatcode IN (:ai_icatcode) AND I.ICatCode = IC.ICatCode AND I.ManfCode = M.ManfCode) I,

	(SELECT 
		C.CustCode, Customer=A.Name, 
		Z.ZoneCode, Zone=Z.Name, 
		C.AreaCode, Area=AR.Name, 
		CC.CustCatCode, CustomerCategory=CC.Name
	FROM Customer C, Accounts A, CustomerCategory CC, Area AR, Zone Z, ZoneAreas ZA
	WHERE 
		Z.ZoneCode = :ai_zonecode AND
		Z.ZoneCode = ZA.ZoneCode AND
		ZA.AreaCode = AR.AreaCode AND
		AR.AreaCode = C.AreaCode AND 
		C.CustCode = A.AccCode AND 
		C.CustCatCode = CC.CustCatcode) C
WHERE
	S.ICode = I.ICode AND
	S.CustCode = C.CustCode
GROUP BY
	C.CustomerCategory,
	C.Area,
	C.Zone,
	C.Customer,
	I.ItemCategory,
	I.Manufacturer,
	I.Name,
	I.SalePrice
UNION ALL
SELECT 
	Band = 'S',
	CustomerCategory=C.CustomerCategory,
	Zone=C.Zone, 
	Area = C.Area,
	Customer = NULL,
	ItemCategory = I.ItemCategory,
	Manufacturer = I.Manufacturer,
	ItemName=I.Name,
	TradePrice = ISNULL(I.SalePrice, 0),
	Jan = ISNULL(SUM(CASE MONTH(S.Date) WHEN 1 THEN S.LooseQty ELSE 0 END), 0),
	Feb = ISNULL(SUM(CASE MONTH(S.Date) WHEN 2 THEN S.LooseQty ELSE 0 END), 0),
	Mar = ISNULL(SUM(CASE MONTH(S.Date) WHEN 3 THEN S.LooseQty ELSE 0 END), 0),
	Apr = ISNULL(SUM(CASE MONTH(S.Date) WHEN 4 THEN S.LooseQty ELSE 0 END), 0),
	May = ISNULL(SUM(CASE MONTH(S.Date) WHEN 5 THEN S.LooseQty ELSE 0 END), 0),
	Jun = ISNULL(SUM(CASE MONTH(S.Date) WHEN 6 THEN S.LooseQty ELSE 0 END), 0),
	Jul = ISNULL(SUM(CASE MONTH(S.Date) WHEN 7 THEN S.LooseQty ELSE 0 END), 0),
	Aug = ISNULL(SUM(CASE MONTH(S.Date) WHEN 8 THEN S.LooseQty ELSE 0 END), 0),
	Sep = ISNULL(SUM(CASE MONTH(S.Date) WHEN 9 THEN S.LooseQty ELSE 0 END), 0),
	Oct = ISNULL(SUM(CASE MONTH(S.Date) WHEN 10 THEN S.LooseQty ELSE 0 END), 0),
	Nov = ISNULL(SUM(CASE MONTH(S.Date) WHEN 11 THEN S.LooseQty ELSE 0 END), 0),
	Dec = ISNULL(SUM(CASE MONTH(S.Date) WHEN 12 THEN S.LooseQty ELSE 0 END), 0)
FROM
	(SELECT 
		S.Date, S.CustCode, D.ICode, LooseQty=SUM(D.LooseQty)
	FROM
		SaleLedger S,
		SaleDetail D
	WHERE
		S.Date >= :ad_startdate  AND S.Date <= :ad_enddate AND
		S.SaleInvCode = D.SaleInvCode AND
		D.ICode IN 
			(SELECT I.ICode
			FROM Item I
			WHERE I.ICatcode IN (:ai_icatcode))
	GROUP BY S.Date, S.CustCode, D.ICode
	UNION ALL
	SELECT 
		Date = :ad_enddate, 
		C.CustCode, 
		I.ICode, 
		LooseQty=0
	FROM 
		(SELECT I.ICode FROM Item I WHERE I.ICatcode IN (:ai_icatcode) ) I,
		(SELECT CustCode FROM Customer 
		WHERE AreaCode IN 
			(SELECT AreaCode FROM ZoneAreas WHERE ZoneCode = :ai_zonecode) ) C) S,

	(SELECT I.ICode, I.Name, I.SalePrice, I.ICatCode, ItemCategory=IC.Name, Manufacturer=M.Name
	FROM Item I, ItemCategory IC, Manufacturer M
	WHERE I.ICatcode IN (:ai_icatcode) AND I.ICatCode = IC.ICatCode AND I.ManfCode = M.ManfCode) I,

	(SELECT 
		C.CustCode, Customer=A.Name, 
		Z.ZoneCode, Zone=Z.Name, 
		C.AreaCode, Area=AR.Name, 
		CC.CustCatCode, CustomerCategory=CC.Name
	FROM Customer C, Accounts A, CustomerCategory CC, Area AR, Zone Z, ZoneAreas ZA
	WHERE 
		Z.ZoneCode = :ai_zonecode AND
		Z.ZoneCode = ZA.ZoneCode AND
		ZA.AreaCode = AR.AreaCode AND
		AR.AreaCode = C.AreaCode AND 
		C.CustCode = A.AccCode AND 
		C.CustCatCode = CC.CustCatcode) C
WHERE
	S.ICode = I.ICode AND
	S.CustCode = C.CustCode
GROUP BY
	C.CustomerCategory,
	C.Area,
	C.Zone,
	I.ItemCategory,
	I.Manufacturer,
	I.Name,
	I.SalePrice
ORDER BY 
	Band,
	ItemCategory,
	Zone,
	Area,
	CustomerCategory,
	Customer,
	ItemName,
	TradePrice
"
  arguments=(("ai_zonecode", number), ("ai_icatcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="band A, itemcategory A, zone A, area A, customercategory A, customer A, itemname A"
 filter=" c_totunit <> 0"
 )
