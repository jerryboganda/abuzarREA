release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=648 color="536870912" )
summary(height=256 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(1) updatewhereclause=yes name=grouptype dbname="GroupType"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=decimal(8) updatewhereclause=yes name=sales dbname="Sales"  )
column=(type=decimal(9) updatewhereclause=yes name=ret dbname="Ret"  )
column=(type=decimal(9) updatewhereclause=yes name=cgs dbname="CGS"  )
column=(type=decimal(9) updatewhereclause=yes name=stock dbname="Stock"  )
 retrieve="SELECT	
	UserName = (SELECT U.UserName FROM Users U WHERE U.UserCode = S.SalesManCode),
	GroupType=:ar_group,
	GroupName= 
		CASE :ar_group
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,   
	ItemName=I.Name,
	AliasName = I.CustomICode,
	Sales=SUM(S.Sales),
	Ret=SUM(S.Ret),
	CGS=SUM(S.Cost),
	Stock=ISNULL((SELECT SUM(GD.CurrQty * IT.AvgPrice) FROM GodownDetail GD, Item IT WHERE GD.ICode = I.ICode AND GD.ICode=IT.ICode), 0)
FROM	
	(SELECT	
		TYPE='S', 
		SD.ICode, 
		SL.SalesManCode,
		Sales=IsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2))  ,0),
		Ret = 0.00,
		Cost= - SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice)
	FROM	SaleLedger SL, SaleDetail SD, Item I
	WHERE	SL.SaleInvCode = SD.SaleInvCode AND
		SL.Date BETWEEN :ar_startdate AND :ar_enddate AND
		SL.SalesManCode IN (:ar_usercode) AND
		SD.ICode = I.ICode AND
		CASE :ar_group
		WHEN 'M' THEN I.manfcode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END IN (:ar_groupcode)
	GROUP BY SL.SaleInvCode, SL.SalesManCode, SD.ICode
	UNION ALL
	SELECT	TYPE='S', SD.ICode, SL.SalesManCode, 
		Sales=IsNull( sum(round(((SD.looseqty) * (SD.saleprice - SD.itemflatdisc)) * (1 - (.01 *  SD.discperc)),2))  ,0),
		Ret = 0.00,
		Cost= - SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice)
	FROM	SaleLedger SL, SaleInvDetail SD, Item I
	WHERE	SL.ImpactInventory='N' AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SL.Date BETWEEN :ar_startdate AND :ar_enddate AND
		SL.SalesManCode IN (:ar_usercode) AND
		SD.ICode = I.ICode AND
		CASE :ar_group
		WHEN 'M' THEN I.manfcode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END IN (:ar_groupcode)
	GROUP BY SL.SaleInvCode, SL.SalesManCode, SD.ICode
	UNION ALL
	SELECT	TYPE='R', SD.ICode, SL.SalesManCode, 
		Sales = 0.00,
		Ret = - IsNull( sum(round(((SD.looseqty + SD.packqty * SD.packunits) * SD.srprice ) * (1 - (.01 *  SD.discperc)),2))  ,0),
		Cost = SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice)
	FROM	SRLedger SL, SRDetail SD, Item I
	WHERE	SL.SRInvCode = SD.SRInvCode AND
		SL.Date BETWEEN :ar_startdate AND :ar_enddate AND
		SL.SalesManCode IN (:ar_usercode) AND
		SD.ICode = I.ICode AND
		CASE :ar_group
		WHEN 'M' THEN I.manfcode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END IN (:ar_groupcode)
	GROUP BY SL.SRInvCode, SL.SalesManCode, SD.ICode) S,
	Item I
WHERE	
	S.ICode = I.ICode
GROUP BY
	S.SalesManCode, 
	I.ManfCode,
	I.ICatCode,
	I.ICCode,
	I.PackCode,
	I.name,
	I.customicode,
	I.Icode
ORDER BY
	UserName,
	GroupName,
	ItemName
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_usercode", numberlist), ("ar_group", string), ("ar_groupcode", numberlist))
)
