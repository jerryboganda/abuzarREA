table(column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="itempacking"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(6) updatewhereclause=yes name=total dbname="total"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscval dbname="itemdiscval"  )
column=(type=decimal(10) updatewhereclause=yes name=afteritemdisctotal dbname="AfterItemdisctotal"  )
column=(type=decimal(6) updatewhereclause=yes name=commissionperunit dbname="commissionperunit"  )
column=(type=decimal(6) updatewhereclause=yes name=commissionperc dbname="commissionperc"  )
column=(type=decimal(6) updatewhereclause=yes name=totalcommission dbname="totalcommission"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="invtotal"  )
column=(type=char(6) updatewhereclause=yes name=saletype dbname="saletype"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
 retrieve="select  username=(select username from users where users.usercode=SL.salesmancode),
	saleinvcode=SL.saleinvcode,
	date=max(SL.date),
	itemalias=Max(I.customicode),
	itemname=I.name,
	itempacking=(select name from itempacking where itempacking.packcode=Max(I.packcode)),
	saleprice=SD.saleprice, 
	looseqty=sum(SD.looseqty),
	total=Round(sum(SD.looseqty * SD.saleprice),2),
	itemdiscval=Round(sum(SD.looseqty*(SD.saleprice*0.01*SD.discperc) + (SD.looseqty*SD.itemflatdisc)),2),
	AfterItemdisctotal=Round(sum(SD.looseqty*(SD.saleprice - SD.saleprice*0.01*SD.discperc) - (SD.looseqty*SD.itemflatdisc)),2),
	commissionperunit=Round(sum(SD.commissionperunit*SD.looseqty),2),
	commissionperc=Round(sum((Round((SD.saleprice - SD.itemflatdisc)*(1 - 0.01*SD.discperc),2)*0.01*SD.commissionperc)*SD.looseqty),2),
	totalcommission=Round(sum(SD.commissionperunit*SD.looseqty),2)  +  Round(sum((Round((SD.saleprice - SD.itemflatdisc)*(1 - 0.01*SD.discperc),2)*0.01*SD.commissionperc)*SD.looseqty),2),
	invtotal=Max(SL.invtotal),
	saletype=(CASE max(SL.salecatcode) when 3 THEN 'Cash' ELSE 'Credit' END),
	posted=max(SL.posted)
from saleledger SL,
	saledetail SD,
	item I
where SL.date>=:ar_startdate   and
	SL.date<=:ar_enddate and
	SL.salesmancode IN (:ar_usercode) and
	SL.salecatcode IN (:aa_saletype) and
	SL.saleinvcode=SD.saleinvcode and
	SD.icode=I.icode
group by SL.salesmancode,
	 SL.saleinvcode,
	 I.icode,
	 I.name,
	 SD.saleprice,
	 SD.discperc,
	 SD.commissionperunit,
	 SD.commissionperc,
	 SD.discperc,
	 SD.itemflatdisc,
	 SD.gstperc,
	 SD.unitsalestax
order by username,
	 saleinvcode,
	 itemname
	 
	


/*select saleinvcode=SL.saleinvcode,
		commission=isnull(sum(commissionperunit*looseqty),0)+ isnull(sum(looseqty* (SD.saleprice*0.01*commissionperc)),0),
		username=(select username from users where users.usercode=SL.salesmancode),
		date=SL.date,
		saletype=(CASE SL.saleCatCode 
					WHEN 1 THEN 'Cash' 
					WHEN 3 THEN 'Cash' 
					ELSE 'Credit'
					END)
	
from saleledger SL,
	saledetail SD

where
	SL.date>=:ar_startdate AND 
	SL.date<=:ar_enddate and
	SL.saleinvcode=SD.saleinvcode AND
	SL.salesmancode IN(:ar_usercode) AND
	SL.salecatcode IN (:aa_saletype)

Group By
	SL.saleinvcode,
	SL.salecatcode,
	SL.date,
	SL.salesmancode
ORDER By 
	username,
	saleinvcode
*/"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_usercode", numberlist), ("aa_saletype", numberlist))
 sort="username A, saleinvcode A, itemname A"
)
