table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(150) updatewhereclause=yes name=genericname dbname="genericname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=manf dbname="manf"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=char(60) updatewhereclause=yes name=country dbname="country"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="phone"  )
column=(type=char(60) updatewhereclause=yes name=email dbname="email"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
column=(type=char(100) updatewhereclause=yes name=shipto dbname="shipto"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="invsalestax"  )
column=(type=long updatewhereclause=yes name=saleledger_custcode dbname="SaleLedger.custcode"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SaleLedger.remarks"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="itempacking"  )
column=(type=char(100) updatewhereclause=yes name=itemdescription dbname="itemdescription"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
 retrieve=" SELECT 
	itemname= item.name,
	accname = dbo.accounts.name,
	genericname=(select name from genericitem where genericitem.genericcode=max(item.genericcode)),
	packingdesc=max(item.packingdesc),
	aliasname=max(item.customicode),
	address = max(dbo.customer.address1),
	manf=(select name from  manufacturer where manufacturer.manfcode=max(item.manfcode)),
	city = max(dbo.customer.city),
	country = max(dbo.customer.country),
	phone = max(dbo.customer.phone),
	email = max(dbo.customer.email), 
	salesperson = ( Select Name From SalesMan Where SalesManCode = Max(dbo.SaleLedger.SManCode) ),
	salesman = dbo.users.username,  
	saleinvcode = dbo.saleledger.saleinvcode, 
	headerno = max(dbo.saleledger.headerno),
	headerinvno = max(dbo.saleledger.headerinvno),  
	 shipto=max(saleledger.shipto),
	date = dbo.saleledger.date,   
	invdiscperc = dbo.saleledger.discperc,   
	misccharges = dbo.saleledger.misccharges,   
	flatdisc = dbo.saleledger.flatdisc,   
	invsalestax = dbo.saleledger.salestax,   
	dbo.saleledger.custcode,
	custrefno=dbo.saleledger.custrefno,	
	dbo.saleledger.remarks,	
	gcode = saledetail.gcode,   
	icode = saledetail.icode,   
	batch = max(saledetail.batch),   
	expiry = max(saledetail.expiry),   
	qty = isnull(sum(saledetail.looseqty + saledetail.bonusqty ),0),
	looseqty = isnull(sum(saledetail.looseqty),0),
	packqty  = isnull(sum(saledetail.packqty),0),
	bonusqty  = isnull(sum(saledetail.bonusqty),0),
	packunits= max(saledetail.packunits),
	saleprice= max(saledetail.saleprice),
	discperc = max(saledetail.discperc),
	salestax =max( saledetail.salestax),
	itemflatdisc =max(saledetail.itemflatdisc), 
	itempacking = max(itempacking.name),
	itemdescription = max(saledetail.saleitemdescription),	
	Godown =max(Godown.name),	
	Id       = max(dbo.saledetail.IDENTITYCOL) 
FROM 
	saleledger, 
	saledetail, 
	accounts, 
	customer,
	Godown,
	users, 
	item LEFT OUTER JOIN ItemPacking ON (dbo.Item.PackCode = ItemPacking.PackCode)
WHERE 
	( dbo.saleledger.saleinvcode Between :ar_SInvCode And :ar_LInvCode) AND
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND
	( dbo.saleledger.custcode = dbo.accounts.acccode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( dbo.saleledger.salesmancode = dbo.users.usercode ) AND 
	( dbo.saledetail.icode = dbo.item.icode) and 
	( dbo.saledetail.gcode = dbo.godown.gcode)
GROUP BY 
	saleledger.saleinvcode, 
	saleledger.date, 
	/*saleledger.headerno,*/
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	saleledger.salestax, 
	saleledger.remarks,
	saleledger.custrefno, 
	saledetail.icode,
	saledetail.rowgroup, 
	saledetail.gcode, 
	item.name,
	item.icode,
	item.printable, 
	accounts.name,
	dbo.users.username
ORDER BY
	saleinvcode, 
	ID
"
  arguments=(("ar_SInvCode", number), ("ar_LInvCode", number), ("ar_printdate", string))
 sort="saleinvcode A, id A"
)
