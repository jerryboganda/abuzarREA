table(column=(type=char(60) updatewhereclause=yes name=name dbname="Item.name"  )
column=(type=long key=yes updatewhereclause=yes name=icode dbname="Item.icode"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="class"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(10) updatewhereclause=yes name=salediscount dbname="salediscount"  )
column=(type=decimal(6) updatewhereclause=yes name=saleamount dbname="saleAmount"  )
column=(type=decimal(4) updatewhereclause=yes name=srqty dbname="srqty"  )
column=(type=decimal(6) updatewhereclause=yes name=netsramount dbname="netsramount"  )
 retrieve="select  item.name,
   	item.icode,
	item.customicode,  
   class=(select name from itemclass where iccode=:ll_iccode),
	
	saleqty =IsNull(( SELECT  
		 	
		 					qty = Sum(dbo.saledetail.looseqty)
			

		 					FROM 	 dbo.saleledger, 
		 							dbo.saledetail    
		 	

		 					WHERE dbo.saleledger.date >= :ad_StartDate and
		 		 					dbo.saleledger.date <= :ad_EndDate  and
		 							/*dbo.saleledger.salecatcode IN (1, 2, 3) and*/
									dbo.saleledger.salecatcode IN (:aa_saletype) and
		 							dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
		 							dbo.saledetail.icode = item.icode 

		 					GROUP BY saledetail.icode ),0) 
					+
			IsNull(( SELECT  
		 	
		 					qty = Sum(sd.looseqty)
			

		 					FROM 	 dbo.saleledger, 
		 							dbo.saleinvdetail sd
		 	

		 					WHERE DBO.SaleLedger.impactinventory = 'N' AND 
									dbo.saleledger.date >= :ad_StartDate and
		 		 					dbo.saleledger.date <= :ad_EndDate  and
		 							/*dbo.saleledger.salecatcode IN (1, 2, 3) and*/
									dbo.saleledger.salecatcode IN (:aa_saletype) and
		 							dbo.saleledger.saleinvcode = sd.saleinvcode and  
		 							sd.icode = item.icode 

		 					GROUP BY sd.icode ),0),
	
	salediscount = IsNull(( SELECT 
		 	
		 							Round(Sum (Round( (dbo.saledetail.looseqty * ( dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc)) * (dbo.saledetail.discperc * .01 ) + (dbo.saledetail.looseqty * dbo.saledetail.itemflatdisc),2) ), 2)
			

		 							FROM 	 dbo.saleledger, 
		 									 dbo.saledetail    
		 	

		 							WHERE  dbo.saleledger.date >= :ad_StartDate and
		 									 dbo.saleledger.date <= :ad_EndDate  and
		 									 /*dbo.saleledger.salecatcode IN (1, 2, 3) and*/
											 dbo.saleledger.salecatcode IN (:aa_saletype) and
		 									 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
		 									 dbo.saledetail.icode = item.icode 

		 							GROUP BY saledetail.icode ),0)
								+
						IsNull(( SELECT 
		 	
		 							Round(Sum (Round( (sd.looseqty * ( sd.saleprice - sd.itemflatdisc)) * (sd.discperc * .01 ) + (sd.looseqty * sd.itemflatdisc),2) ), 2)
			

		 							FROM 	 dbo.saleledger, 
		 									 dbo.saleinvdetail sd

		 							WHERE  DBO.SaleLedger.impactinventory = 'N' AND 
											 dbo.saleledger.date >= :ad_StartDate and
		 									 dbo.saleledger.date <= :ad_EndDate  and
		 									 /*dbo.saleledger.salecatcode IN (1, 2, 3) and*/
											 dbo.saleledger.salecatcode IN (:aa_saletype) and
		 									 dbo.saleledger.saleinvcode = sd.saleinvcode and  
		 									 sd.icode = item.icode 

		 							GROUP BY sd.icode ),0),

	

	saleAmount=IsNull(( SELECT 
		 	
		 						Round(Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice), 2)
			

		 					 FROM 	 dbo.saleledger, 
		 								 dbo.saledetail    
		 	

		 					 WHERE  dbo.saleledger.date >= :ad_StartDate and
		 							  dbo.saleledger.date <= :ad_EndDate  and
		 							  /*dbo.saleledger.salecatcode IN (1, 2, 3) and*/
									  dbo.saleledger.salecatcode IN (:aa_saletype) and
		 							  dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
		 							  dbo.saledetail.icode = item.icode 

		 					 GROUP BY saledetail.icode ),0) + 
					IsNull(( SELECT 
		 	
		 						Round(Sum ( sd.looseqty * sd.saleprice), 2)
			

		 					 FROM 	 dbo.saleledger, 
		 								 dbo.saleinvdetail sd
		 	

		 					 WHERE  DBO.SaleLedger.impactinventory = 'N' AND 
									  dbo.saleledger.date >= :ad_StartDate and
		 							  dbo.saleledger.date <= :ad_EndDate  and
		 							  /*dbo.saleledger.salecatcode IN (1, 2, 3) and*/
									  dbo.saleledger.salecatcode IN (:aa_saletype) and
		 							  dbo.saleledger.saleinvcode = sd.saleinvcode and  
		 							  sd.icode = item.icode 

		 					 GROUP BY sd.icode ),0),


	srqty=IsNull(( SELECT 
		 	
		 				qty = Sum(dbo.srdetail.looseqty)
			

		 				FROM 	 dbo.srledger, 
		 						 dbo.srdetail    
		 	

		 				WHERE  dbo.srledger.date >= :ad_StartDate and
		 						 dbo.srledger.date <= :ad_EndDate  and
		 						 dbo.srledger.srcatcode IN (:aa_srtype) and
		 						 dbo.srledger.srinvcode = dbo.srdetail.srinvcode and  
		 						 dbo.srdetail.icode = item.icode 

		 				GROUP BY srdetail.icode ),0),

	netsramount=IsNull(( SELECT 
		 	
		 					Round(Sum ( dbo.srdetail.looseqty * dbo.srdetail.srprice), 2)
							- Round(Sum (Round( dbo.srdetail.looseqty * ( dbo.srdetail.srprice * dbo.srdetail.discperc * .01 ) ,2)),2)

		 					FROM 	 dbo.srledger, 
		 							 dbo.srdetail    
		 	

		 					WHERE  dbo.srledger.date >= :ad_StartDate and
		 							 dbo.srledger.date <= :ad_EndDate  and
		 							 dbo.srledger.srcatcode IN (:aa_srtype) and
		 							 dbo.srledger.srinvcode = dbo.srdetail.srinvcode and  
		 							 dbo.srdetail.icode = item.icode 

		 					GROUP BY srdetail.icode ),0)


from item
where item.iccode=:ll_iccode"
  update="item" updatewhere=0 updatekeyinplace=no
  arguments=(("ll_iccode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("aa_saletype", numberlist), ("aa_srtype", numberlist), ("as_cash", string), ("as_credit", string))
)
