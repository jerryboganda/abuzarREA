release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1406 color="536870912" )
summary(height=218 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="ManfCode"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="soldqty"  )
column=(type=decimal(4) updatewhereclause=yes name=soldbonus dbname="soldbonus"  )
column=(type=decimal(4) updatewhereclause=yes name=retqty dbname="retqty"  )
column=(type=decimal(4) updatewhereclause=yes name=retbonus dbname="retbonus"  )
column=(type=decimal(6) updatewhereclause=yes name=soldqtyvalue dbname="soldqtyvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=soldbonusvalue dbname="soldbonusvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=retqtyvalue dbname="retqtyvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=retbonusvalue dbname="retbonusvalue"  )
 retrieve="SELECT
	Manufacturer = m.Name,
	ManfCode = i.manfcode,
	Item = i.Name, 
	AliasName = i.customicode,
	soldqty= sum(st.soldqty),
	soldbonus= sum(st.soldbonus),
	retqty= sum(st.retqty),
	retbonus= sum(st.retbonus),
	soldqtyvalue= sum(st.soldqtyvalue),
	soldbonusvalue= sum(st.soldbonusvalue),
	retqtyvalue= sum(st.retqtyvalue),
	retbonusvalue= sum(st.retbonusvalue)
FROM
(SELECT	sd.icode,
	soldqty = sum(sd.looseqty + sd.packqty * sd.packunits),
	soldbonus= sum(sd.bonusqty),
	retqty = 0,
	retbonus= 0,
	soldqtyvalue = sum((sd.looseqty + sd.packqty * sd.packunits) *
		sd.saleprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
	soldbonusvalue = sum(sd.bonusqty * sd.saleprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
	retqtyvalue=0,
	retbonusvalue=0
FROM saleledger sl, saledetail sd
WHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND sl.SManCode = :ar_smancode AND
	sl.date >= :ar_startdate and sl.date <= :ar_enddate
GROUP BY sd.icode
HAVING sum(sd.bonusqty) > 0
UNION ALL
SELECT	sd.icode,
	soldqty = sum(sd.looseqty),
	soldbonus= sum(sd.bonusqty),
	retqty = 0,
	retbonus= 0,
	soldqtyvalue = sum((sd.looseqty) *
		sd.saleprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
	soldbonusvalue = sum(sd.bonusqty * sd.saleprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
	retqtyvalue=0,
	retbonusvalue=0
FROM saleledger sl, saleinvdetail sd
WHERE sl.impactinventory = 'N' and sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND sl.SManCode = :ar_smancode AND
	sl.date >= :ar_startdate and sl.date <= :ar_enddate
GROUP BY sd.icode
HAVING sum(sd.bonusqty) > 0
UNION ALL
SELECT	sd.icode,
	soldqty = 0,
	soldbonus= 0,
	retqty = sum(sd.looseqty + sd.packqty * sd.packunits),
	retbonus= sum(sd.bonusqty),
	soldqtyvalue = 0,
	soldbonusvalue = 0,
	retqtyvalue=sum((sd.looseqty + sd.packqty * sd.packunits) *
		sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
	retbonusvalue=sum(sd.bonusqty * sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01))
FROM srledger sl, srdetail sd
WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND sl.SManCode = :ar_smancode AND
	sl.date >= :ar_startdate and sl.date <= :ar_enddate
GROUP BY sd.icode
HAVING sum(sd.bonusqty) > 0) St, 
	Item i, Manufacturer M
WHERE st.icode = i.icode and i.manfcode = m.manfcode
GROUP BY m.Name, i.manfcode, i.name, i.customicode
ORDER BY m.name, i.manfcode, i.name, i.customicode

"
  arguments=(("ar_smancode", number), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
