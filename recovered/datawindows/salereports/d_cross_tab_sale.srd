release 12.5;
datawindow ( units=0 timer_interval=0 processing=4 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 grid.lines=1 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=0 color="536870912" )
header[2](height=76 color="536870912" )
summary(height=116 color="536870912" )
footer(height=0 color="536870912" )
detail(height=88 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=invdate dbname="invdate"  )
column=(type=char(20) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=number updatewhereclause=yes name=value dbname="value"  )
 retrieve="select 	category=itemcategory.name,
			A.itemname,
			A.icode,
			A.saleprice,
			A.looseqty,
			A.saleinvcode,
			A.rowid,
			A.invDate,
			value=(case when A.icatcode=itemcategory.icatcode THEN
					(A.looseqty*A.saleprice)
				      else
					0
					end )



from  itemcategory,

					(select SD.saleinvcode,
								rowid=max(SD.Rowid),
								I.icatcode,
								SD.icode,
								saleprice=max(SD.saleprice),
								looseqty=sum(SD.looseqty),
								itemname=max(I.name),
								invdate=max(SL.date)
		      
					from saledetail SD,
							saleledger SL,
	     					item I
					where SL.custcode=:ar_custcode and
							(SL.saleinvcode between :ar_sinvcode and :ar_linvcode)and
							(SL.saleinvcode = SD.saleinvcode) and
							SD.icode=I.icode
	
					Group by 
							SD.saleinvcode,
							I.icatcode,
							SD.icode ) as A


order by A.saleinvcode,A.rowid"
  arguments=(("ar_sinvcode", number), ("ar_linvcode", number), ("ar_custcode", number))
 sort="invdate A"
)
group(level=1 header.height=0 trailer.height=0 by=("invdate"  ) header.color="536870912" trailer.color="536870912" )
text(name=invdate_t band=header[2] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" alignment="0" border="0" x="9" y="4" height="64" width="457" text="Invdate" )
text(name=itemname_t band=header[2] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" alignment="0" border="0" x="475" y="4" height="64" width="503" text="Itemname" )
text(name=value_t band=header[2] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" alignment="0" border="0" x="987" y="4" height="64" width="343" text="@category" )
text(name=grand_sum_value_t band=header[2] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" alignment="0" border="0" x="1339" y="4" height="64" width="686" text="Grand Total " )
compute(name=compute_4 band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" x="9" y="4" height="76" width="457" format="[general]" expression="~"Grand Total~"" alignment="1" border="0" crosstab.repeat=no )
compute(name=compute_5 band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="987" y="4" height="76" width="343" format="[general]" expression="sum(value for all )" alignment="1" border="0" crosstab.repeat=no )
compute(name=compute_6 band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="1339" y="4" height="76" width="686" format="[general]" expression="sum(grand_sum_value for all )" alignment="1" border="0" crosstab.repeat=no )
column(name=invdate band=detail id=1 x="9" y="4" height="76" width="457" color="0" border="0" alignment="0" format="dd/mm/yy" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=yes edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
column(name=itemname band=detail id=2 x="475" y="4" height="76" width="503" color="0" border="0" alignment="0" format="[general]" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=no edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
column(name=value visible="1	if( value >0,1,0)" band=detail id=3 x="987" y="4" height="76" width="343" color="0" border="0" alignment="1" format="[general]" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=no edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=yes background.mode="1" background.color="536870912" font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
compute(name=grand_sum_value band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="1339" y="4" height="76" width="686" format="[general]" expression="crosstabsum(1)" alignment="1" border="0" crosstab.repeat=no )
crosstab(columns="category" rows="invdate, itemname" values="sum(value for crosstab)" sourcenames = "category, itemname, icode, saleprice, looseqty, saleinvcode, rowid, invdate, value" crosstabonly=yes  band=foreground )
sparse(names="invdate")
htmltable(border="0" cellPadding="1" cellSpacing="1" )
htmlgen(clientComputedFields="1" clientEvents="1" clientFormatting="0" clientScriptable="0" clientValidation="1" generateJavaScript="1" pagingMethod=0 )
