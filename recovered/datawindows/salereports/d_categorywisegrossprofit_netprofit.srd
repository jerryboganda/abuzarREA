compute(name=sumgprate visible="1	if((sum(sales + ret + cgs for all) / sum(sales + ret for all)) * 100=0,0,1)" band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="3049" y="20" height="64" width="256" format="###.##" expression="(sum(sales + ret + cgs for all) / sum(sales + ret for all)) * 100" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
