release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=568 color="536870912" )
summary(height=1464 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="ICatCode"  )
column=(type=decimal(6) updatewhereclause=yes name=sales dbname="Sales"  )
column=(type=decimal(6) updatewhereclause=yes name=ret dbname="Ret"  )
column=(type=decimal(9) updatewhereclause=yes name=cgs dbname="CGS"  )
column=(type=decimal(9) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=decimal(2) updatewhereclause=yes name=expenseamt dbname="ExpenseAmt"  )
 retrieve="SELECT	
	Category=R.Category,
	R.ICatCode,
	Sales=ROUND(SUM(R.Sales), 0),
	Ret=ROUND(SUM(R.Ret), 0),
	CGS=ROUND(SUM(R.CGS), 0),
	Stock=ROUND(SUM(R.Stock), 0),
	ExpenseAmt=MAX(EXP.ExpensesAmt)
FROM 
	(SELECT	
		Category=IC.name,
		IC.ICatCode,
		Sales=ROUND(SUM(
			CASE S.TYPE WHEN 'S' THEN 
				S.itemvalue - (S.flatdisc * (S.itemvalue/
					CASE S.grossamt WHEN 0 THEN 1 ELSE S.grossamt END))
			ELSE 0 END), 0),
		Ret=0,
		CGS=-SUM(S.Cost),
		Stock=0
	FROM	
		(SELECT
			SL.saleinvcode,
			SD.icode,
			Cost = SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice),
			GrossValue = SUM(SD.looseqty * SD.saleprice ) ,
			ItemDiscValue = SUM((SD.looseqty * (SD.saleprice - SD.itemflatdisc))*
								 (.01 * SD.discperc) + SD.itemflatdisc ),
			InvItemDiscValue = SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*
									(1 - (.01 * SD.discperc) ) *  (.01 * SL.discperc) ),
			ItemValue=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*
				(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc)),
			GrossAmt=
				isnull((SELECT ISNULL(SUM((SDD.looseqty*(SDD.saleprice - SDD.itemflatdisc)) *
					(1 - (.01 * SDD.discperc)) * (1- (.01 * SLL.discperc))), 0)
				FROM	saledetail SDD, saleledger SLL
				WHERE SLL.saleinvcode=SL.saleinvcode and SLL.saleinvcode=SDD.saleinvcode
				GROUP BY SLL.saleinvcode), 0),
			SL.flatdisc,
			catcode=SL.salecatcode,
			type='S'
		FROM
			saleledger SL,	 
			saledetail SD
		WHERE
			SL.SaleInvCode = SD.SaleInvCode AND
			SL.Date >= :ar_startdate AND SL.Date <= :ar_enddate AND
			SL.SaleCatCode IN (:ai_salecatcode)
		GROUP BY 
			 SL.saleinvcode,
			 SL.salesmancode,
			 SD.icode,
			 SL.salecatcode,
			 SL.discperc,
			 SL.flatdisc,
			 SL.invgstperc1,
			 SL.salecatcode
		UNION ALL
		SELECT
			SL.saleinvcode,
			SD.icode,
			Cost = SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice),
			GrossValue = SUM(SD.looseqty * SD.saleprice ) ,
			ItemDiscValue = SUM((SD.looseqty * (SD.saleprice - SD.itemflatdisc))*
								 (.01 * SD.discperc) + SD.itemflatdisc ),
			InvItemDiscValue = SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*
									(1 - (.01 * SD.discperc) ) *  (.01 * SL.discperc) ),
			ItemValue=SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc))*
				(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc)),
			GrossAmt=
				isnull((SELECT ISNULL(SUM((SDD.looseqty*(SDD.saleprice - SDD.itemflatdisc)) *
					(1 - (.01 * SDD.discperc)) * (1- (.01 * SLL.discperc))), 0)
				FROM	saledetail SDD, saleledger SLL
				WHERE SLL.saleinvcode=SL.saleinvcode and SLL.saleinvcode=SDD.saleinvcode
				GROUP BY SLL.saleinvcode), 0),
			SL.flatdisc,
			catcode=SL.salecatcode,
			type='S'
		FROM
			saleledger SL,	 
			saleinvdetail SD
		WHERE
			SL.ImpactInventory = 'N' AND
			SL.SaleInvCode = SD.SaleInvCode AND
			SL.Date >= :ar_startdate AND SL.Date <= :ar_enddate AND
			SL.SaleCatCode IN (:ai_salecatcode)
		GROUP BY 
			 SL.saleinvcode,
			 SL.salesmancode,
			 SD.icode,
			 SL.salecatcode,
			 SL.discperc,
			 SL.flatdisc,
			 SL.invgstperc1,
			 SL.salecatcode) S,
		Item I, 
		(SELECT ICatCode = M.ManfCode, Name=M.Name 
		FROM Manufacturer M 
		WHERE :as_group = 'M'
		UNION ALL
		SELECT ICatCode = C.ICatCode, Name=C.Name 
		FROM ItemCategory C 
		WHERE :as_group = 'C'
		UNION ALL
		SELECT ICatCode = L.ICCode, Name=L.Name 
		FROM ItemClass L 
		WHERE :as_group = 'L'
		UNION ALL
		SELECT ICatCode = P.PackCode, Name=P.Name 
		FROM ItemPacking P 
		WHERE :as_group = 'P') IC
	WHERE	
		S.ICode = I.ICode AND
		IC.ICatCode = 
			CASE :as_group 
				WHEN 'M' THEN I.ManfCode 
				WHEN 'C' THEN I.ICatCode 
				WHEN 'L' THEN I.ICCode 
				ELSE I.PackCode 
			END
	GROUP BY 
		IC.name,
		IC.ICatCode
	UNION ALL
	SELECT	
		Category=IC.name,
		IC.ICatCode,
		Sales=0,
		Ret=-ROUND(SUM(
		CASE S.TYPE WHEN 'R' THEN
			S.itemvalue - (S.flatdisc*(S.itemvalue/
				CASE S.grossamt WHEN 0 THEN 1 
				ELSE S.grossamt END)) 
		ELSE 0 END), 0),
		CGS=SUM(S.Cost),
		Stock=0
	FROM	
		(SELECT
			SL.srinvcode,
			SD.icode,
			Cost = SUM((SD.LooseQty+SD.BonusQty) * SD.AvgPrice),
			GrossValue = SUM( SD.looseqty * SD.srprice ) ,
			ItemDiscValue = SUM((SD.looseqty * SD.srprice ) * (.01 * SD.discperc) ),
			InvItemDiscValue = SUM( ( (SD.looseqty * SD.srprice) *
										(1 - (.01 * SD.discperc) ) ) * (.01 * SL.discperc) ),
			ItemValue=SUM((SD.looseqty * SD.srprice *
				(1 - (.01 * SD.discperc))) * (1 - (.01 * SL.discperc))),
			GrossAmt=ISNULL((SELECT SUM((SDD.looseqty * SDD.srprice *
					(1 - (.01 * SDD.discperc))) * (1- (.01 * SLL.discperc)))
				FROM	srdetail SDD, srledger SLL
				WHERE SLL.srinvcode=SL.srinvcode and SLL.srinvcode=SDD.srinvcode
				GROUP BY SLL.srinvcode), 0),
			SL.flatdisc,
			catcode=SL.srcatcode,
			type='R'
		
		FROM
			srledger SL,	 
			srdetail SD
		
		WHERE
			SL.SRInvCode = SD.SRInvCode AND
			SL.Date >= :ar_startdate AND SL.Date <= :ar_enddate AND
			SL.SRCatCode IN (:ai_salecatcode)
		
		GROUP BY
			 SL.srinvcode,
			 SL.salesmancode,
			 SD.icode,
			 SL.srcatcode,
			 SL.discperc,
			 SL.flatdisc,
			 SL.invgstperc1,
			 SL.srcatcode) S,
		Item I, 
		(SELECT ICatCode = M.ManfCode, Name=M.Name 
		FROM Manufacturer M 
		WHERE :as_group = 'M'
		UNION ALL
		SELECT ICatCode = C.ICatCode, Name=C.Name 
		FROM ItemCategory C 
		WHERE :as_group = 'C'
		UNION ALL
		SELECT ICatCode = L.ICCode, Name=L.Name 
		FROM ItemClass L 
		WHERE :as_group = 'L'
		UNION ALL
		SELECT ICatCode = P.PackCode, Name=P.Name 
		FROM ItemPacking P 
		WHERE :as_group = 'P') IC
	WHERE	
		S.ICode = I.ICode AND
		IC.ICatCode = 
			CASE :as_group 
				WHEN 'M' THEN I.ManfCode 
				WHEN 'C' THEN I.ICatCode 
				WHEN 'L' THEN I.ICCode 
				ELSE I.PackCode 
			END
	GROUP BY 
		IC.name,
		IC.ICatCode
	UNION ALL
	SELECT	
		Category=IC.name,
		IC.ICatCode,
		Sales=0,
		Ret=0,
		CGS=0,
		Stock=SUM(S.CurrQty * I.AvgPrice)
	FROM	
		GodownDetail S, 
		Item I, 
		(SELECT ICatCode = M.ManfCode, Name=M.Name 
		FROM Manufacturer M 
		WHERE :as_group = 'M'
		UNION ALL
		SELECT ICatCode = C.ICatCode, Name=C.Name 
		FROM ItemCategory C 
		WHERE :as_group = 'C'
		UNION ALL
		SELECT ICatCode = L.ICCode, Name=L.Name 
		FROM ItemClass L 
		WHERE :as_group = 'L'
		UNION ALL
		SELECT ICatCode = P.PackCode, Name=P.Name 
		FROM ItemPacking P 
		WHERE :as_group = 'P') IC
	WHERE	
		S.ICode = I.ICode AND
		IC.ICatCode = 
			CASE :as_group 
				WHEN 'M' THEN I.ManfCode 
				WHEN 'C' THEN I.ICatCode 
				WHEN 'L' THEN I.ICCode 
				ELSE I.PackCode 
			END
	GROUP BY 
		IC.name,
		IC.ICatCode) R,
	(SELECT ExpensesAmt=SUM(T.ExpensesAmt)
	FROM
		(SELECT 
			ExpensesAmt = 0.00
		UNION ALL
		SELECT 
			ExpensesAmt = SUM(GLD.Debit)
		FROM
			VocherCategory VC,
			GLHeader GLH,
			GLDetail GLD
		WHERE 
			GLH.GLVochCode = GLD.GLVochCode AND
			GLH.Date BETWEEN :ar_startdate AND :ar_enddate AND
			GLH.VochCatCode = VC.VochCatCode AND 
			VC.VochCatCode = :ai_vochcatcode) T
	) EXP
GROUP BY 
	R.Category,
	R.ICatCode
ORDER BY
	R.Category,
	R.ICatCode
"
  arguments=(("as_group", string), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ai_salecatcode", numberlist), ("ai_vochcatcode", number))
)
