footer(height=604 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=char(88) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=saleledger_date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_discperc dbname="SaleLedger.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_salestax dbname="SaleLedger.salestax"  )
column=(type=char(100) updatewhereclause=yes name=saleledger_remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=saleledger_custcode dbname="SaleLedger.custcode"  )
column=(type=char(30) updatewhereclause=yes name=saleledger_custrefno dbname="SaleLedger.custrefno"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=long updatewhereclause=yes name=compute_0025 dbname="compute_0025"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(1) updatewhereclause=yes name=printwaranty dbname="printwaranty"  )
column=(type=char(1) updatewhereclause=yes name=printbatch dbname="printbatch"  )
 retrieve="SELECT  
	itemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END,  
	aliasname=item.customicode,
	dbo.accounts.name, 
	packingdesc=item.packingdesc, 
	address = dbo.customer.address1,
	dbo.users.username, 
	headerno = dbo.saleledger.headerno,
	saleinvcode = dbo.saleledger.saleinvcode,   
	date = dbo.saleledger.date,   
	dbo.saleledger.discperc,   
	misccharges = dbo.saleledger.misccharges,   
	flatdisc = dbo.saleledger.flatdisc,   
	dbo.saleledger.salestax,   
	remarks = dbo.saleledger.remarks,   
	dbo.saleledger.custcode, 
	dbo.saleledger.custrefno,
	icode = saledetail.icode,   
	looseqty = SUM(saledetail.looseqty) - 
		(SELECT ISNULL(Sum(SRD.LooseQty), 0)
		FROM SRDetail SRD, SRLedger SRL
		WHERE SRL.SaleInvCode = dbo.saleledger.SaleInvCode AND
		      SRL.SRInvCode = SRD.SRInvCode AND
		      SRD.ICode = dbo.saledetail.ICode),
	bonusqty = SUM(saledetail.bonusqty) - 
		(SELECT ISNULL(Sum(SRD.BonusQty), 0)
		FROM SRDetail SRD, SRLedger SRL
		WHERE SRL.SaleInvCode = dbo.saleledger.SaleInvCode AND
		      SRL.SRInvCode = SRD.SRInvCode AND
		      SRD.ICode = dbo.saledetail.ICode),
	packunits= saledetail.packunits,
	saleprice= saledetail.saleprice,
	itemflatdisc=saledetail.itemflatdisc,  
	discperc = saledetail.discperc,
	salestax = saledetail.salestax,
	MAX(dbo.saledetail.IDENTITYCOL)  ,
	unitsalestax  = saledetail.unitsalestax,
	gstperc       = saledetail.gstperc,
	invgstperc    = saleledger.invgstperc1 ,
	printwaranty=dbo.saleledger.printwaranty,
	printbatch=dbo.saleledger.printbatch

FROM 
	saleledger, 
	saledetail, 
	accounts, 
	customer,
	users, 
	item  

WHERE 
	( dbo.saleledger.saleinvcode = :ar_SaleInvCode ) AND
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND
	( dbo.saleledger.custcode = dbo.accounts.acccode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( dbo.saleledger.salesmancode = dbo.users.usercode) AND 
	( dbo.saledetail.icode = dbo.item.icode)
GROUP BY
	dbo.saleledger.saleinvcode,
	dbo.saleledger.custcode, 
	dbo.saleledger.headerno,
	dbo.saleledger.date,   
	dbo.saleledger.discperc,   
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.salestax,   
	dbo.saleledger.remarks,   
	dbo.saleledger.invgstperc1 ,
	dbo.saleledger.printwaranty,
	dbo.saleledger.printbatch,
	dbo.accounts.name, 
	dbo.customer.address1,
	dbo.users.username, 
	item.name,
	item.customicode,
	item.packingdesc, 
	item.printable,
	saledetail.icode,   
	saledetail.packunits,
	saledetail.saleprice,
	saledetail.itemflatdisc,  
	saledetail.discperc,
	saledetail.salestax,
	saledetail.unitsalestax,
	dbo.saleledger.custrefno,
	saledetail.gstperc
HAVING
	SUM(saledetail.looseqty) - 
		(SELECT ISNULL(Sum(SRD.LooseQty), 0)
		FROM SRDetail SRD, SRLedger SRL
		WHERE SRL.SaleInvCode = dbo.saleledger.SaleInvCode AND
		      SRL.SRInvCode = SRD.SRInvCode AND
		      SRD.ICode = dbo.saledetail.ICode) > 0 OR
	SUM(saledetail.bonusqty) - 
		(SELECT ISNULL(Sum(SRD.BonusQty), 0)
		FROM SRDetail SRD, SRLedger SRL
		WHERE SRL.SaleInvCode = dbo.saleledger.SaleInvCode AND
		      SRL.SRInvCode = SRD.SRInvCode AND
		      SRD.ICode = dbo.saledetail.ICode) > 0
ORDER BY 
	dbo.saleledger.saleinvcode,
	MAX(dbo.saledetail.IDENTITYCOL )
"
  arguments=(("ar_SaleInvCode", number), ("ar_returnlist", string))
)
