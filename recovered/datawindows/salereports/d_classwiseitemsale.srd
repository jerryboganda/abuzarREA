release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=588 color="536870912" )
summary(height=96 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass.name"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=long updatewhereclause=yes name=piecesinpacking dbname="piecesinpacking"  )
column=(type=decimal(8) updatewhereclause=yes name=unitprice dbname="unitprice"  )
column=(type=decimal(4) updatewhereclause=yes name=netsaleqty dbname="netsaleqty"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(6) updatewhereclause=yes name=stockval dbname="stockval"  )
 retrieve="SELECT 
	itemname=item.name,
	itemclass.name, 
	itemcode=item.icode,
	aliasname=item.customicode,
	manufacturer=(select name from manufacturer where manfcode=item.manfcode),
	saleprice=item.saleprice,
	piecesinpacking=item.packunits,
	unitprice=round(saleprice/item.packunits,2),
	netsaleqty=((select isnull(sum(looseqty),0) 
		    from saleledger,saledetail
		    where saleledger.date>= :ad_StartDate and
		     	  saleledger.date<= :ad_enddate and
			  saleledger.saleinvcode=saledetail.saleinvcode and
			  saledetail.icode=item.icode)
			+
			(select isnull(sum(looseqty),0) 
		    from saleledger,saleinvdetail saledetail
		    where saleledger.impactinventory='N' AND 
					saleledger.date>= :ad_StartDate and
		    		saleledger.date<= :ad_enddate and
				 	saleledger.saleinvcode=saledetail.saleinvcode and
					saledetail.icode=item.icode)

		   -
		
		   (select isnull(sum(looseqty),0) 
		    from srledger,srdetail
		    where srledger.date>= :ad_StartDate and
		     	  srledger.date<= :ad_enddate and
			  srledger.srinvcode=srdetail.srinvcode and
			  srdetail.icode=item.icode
			 )),
		stock=(select isnull(sum(currqty),0) from godowndetail where icode=item.icode),
		stockval=(select isnull(sum(currqty),0) from godowndetail where icode=item.icode) * item.avgprice /*,
		

	netsalevalue=( (select IsNull( Round(((saledetail.looseqty + saledetail.packqty * saledetail.packunits) * (saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc)),2) * 0.01 * saleledger.discperc, 0)
 
		    from saleledger,saledetail
		    where saleledger.date>= '12/12/02 00:00:00' and
		     	  saleledger.date<= '12/12/02 00:00:00' and
			  saleledger.saleinvcode=saledetail.saleinvcode and
			  saledetail.icode=item.icode
		    group by  saleledger.saleinvcode,
			      saleledger.discperc)

		   -
		
		   (select IsNull( Round(((srdetail.looseqty + srdetail.packqty * srdetail.packunits) ) * (1 - (.01 * srdetail.discperc)),2) * 0.01 * srledger.discperc, 0)
		    from srledger,srdetail
		    where srledger.date>= '12/12/02 00:00:00' and
		     	  srledger.date<= '12/12/02 00:00:00' and
			  srledger.srinvcode=srdetail.srinvcode and
			  srdetail.icode=item.icode
		    group by
				srledger.srinvcode,
				srledger.discperc))*/


from item,itemclass 
where item.iccode in (:ar_classcode) and
		item.iccode=itemclass.iccode
order by itemclass.name,item.name
"
  arguments=(("ar_classcode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime))
)
