release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="SoldQty"  )
column=(type=decimal(4) updatewhereclause=yes name=soldbonus dbname="SoldBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(4) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
column=(type=decimal(4) updatewhereclause=yes name=returnbonus dbname="ReturnBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=returnvalue dbname="ReturnValue"  )
column=(type=decimal(4) updatewhereclause=yes name=netsaleqty dbname="NetSaleQty"  )
column=(type=decimal(4) updatewhereclause=yes name=netsalebonus dbname="NetSaleBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=netsalevalue dbname="NetSaleValue"  )
 retrieve="SELECT
	Manufacturer=(SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = :ar_ManfCode),
	Item=I.Name, 
	AliasName=I.CustomICode, 
	Area=(SELECT AR.Name FROM Area AR WHERE AR.AreaCode = S.AreaCode), 
	SoldQty=SUM(S.SoldQty), 
	SoldBonus=SUM(S.SoldBonus), 
	SaleValue=SUM(S.SaleValue), 
	ReturnQty=SUM(S.ReturnQty), 
	ReturnBonus=SUM(S.ReturnBonus), 
	ReturnValue=SUM(S.ReturnValue), 
	NetSaleQty=SUM(S.SoldQty - S.ReturnQty), 
	NetSaleBonus=SUM(S.SoldBonus - S.ReturnBonus), 
	NetSaleValue=SUM(S.SaleValue - S.ReturnValue)
FROM
	Item I,
	(SELECT
		SD.ICode, 
		SoldQty=SUM(SD.LooseQty),
		SoldBonus=SUM(SD.BonusQty),
		ReturnQty=0,
		ReturnBonus=0,
		SaleValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)),
		ReturnValue=0,
		C.AreaCode
	FROM
		SaleLedger SL, SaleDetail SD, Customer C, Item I
	WHERE
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.CustCode = C.CustCode AND
		C.AreaCode IN (:ar_AreaCode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = :ar_ManfCode
	GROUP BY
		C.AreaCode,
		SD.ICode
	UNION ALL
	SELECT
		SD.ICode, 
		SoldQty=SUM(SD.LooseQty),
		SoldBonus=SUM(SD.BonusQty),
		ReturnQty=0,
		ReturnBonus=0,
		SaleValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)),
		ReturnValue=0,
		C.AreaCode
	FROM
		SaleLedger SL, SaleInvDetail SD, Customer C, Item I
	WHERE
		SL.impactinventory = 'N' AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.CustCode = C.CustCode AND
		C.AreaCode IN (:ar_AreaCode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = :ar_ManfCode
	GROUP BY
		C.AreaCode,
		SD.ICode
	UNION ALL
	SELECT
		SD.ICode, 
		SoldQty=0,
		SoldBonus=0,
		ReturnQty=SUM(SD.LooseQty),
		ReturnBonus=SUM(SD.BonusQty),
		SaleValue =0,
		ReturnValue=SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)),
		C.AreaCode
	FROM
		SRLedger SL, SRDetail SD, Customer C, Item I
	WHERE
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.CustCode = C.CustCode AND
		C.AreaCode IN (:ar_AreaCode) AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = :ar_ManfCode
	GROUP BY
		C.AreaCode,
		SD.ICode) S
WHERE
	S.ICode = I.ICode
GROUP BY
	S.AreaCode,
	I.Name,
	I.CustomICode
ORDER BY
	Area,
	I.Name,
	I.CustomICode"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_manfcode", number), ("ar_areacode", numberlist))
 sort="area A, item A, aliasname A, soldqty A, soldbonus A, salevalue A, returnqty A"
)
