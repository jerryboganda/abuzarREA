header(height=2010 color="536870912" )
summary(height=41 color="536870912" )
footer(height=250 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(50) updatewhereclause=yes name=salestaxregno dbname="SalesTaxRegNo"  )
column=(type=char(60) updatewhereclause=yes name=ward dbname="Ward"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(60) updatewhereclause=yes name=manufacurer dbname="manufacurer"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=long updatewhereclause=yes name=id dbname="ID"  )
column=(type=decimal(4) updatewhereclause=yes name=cumulativesum dbname="cumulativesum"  )
column=(type=decimal(4) updatewhereclause=yes name=cumulativesumfoot dbname="cumulativesumfoot"  )
 retrieve="SELECT 
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),
	SalesTaxRegNo = MAX(Customer.SalesTaxRegNo),
	Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),
	itemname = item.name, 
	Packing = Item.PackingDesc,
	manufacurer = (dbo.manufacturer.name),
	looseqty = Sum (dbo.saledetail.looseqty),
	price = max(dbo.saledetail.saleprice),    
	ID = MAX(dbo.saledetail.RowId),
	cumulativesum = round(0.0000,2),
	cumulativesumfoot = round(0.0000,2)
FROM 	 
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item,  
	dbo.Customer,
	dbo.Accounts,
	dbo.Manufacturer 
WHERE  
	CASE lower(:as_datetype) 
				 When 'originaldate' Then dbo.saleledger.originaldate 
			    When 'lastsavingdate' Then dbo.saleledger.date
				 When 'billingdate' Then dbo.saleledger.billingdate
		   END between :ad_StartDate and :ad_EndDate and
	dbo.saleledger.custcode  IN ( :al_custcode ) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) AND
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	dbo.saledetail.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	SaleLedger.WardCode,
	dbo.saledetail.icode,
	dbo.item.name,
	Item.PackingDesc,
	dbo.manufacturer.name

UNION ALL

SELECT 
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),
	SalesTaxRegNo = MAX(Customer.SalesTaxRegNo),
	Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),
	itemname = item.name, 
	Packing = Item.PackingDesc,
	manufacurer = (dbo.manufacturer.name),
	looseqty = Sum (saledetail.looseqty),
	price = max(saledetail.saleprice),    
	ID = MAX(saledetail.RowId),
	cumulativesum = round(0.0000,2),
	cumulativesumfoot = round(0.0000,2)
FROM 	 
	dbo.saleledger, 
	saleinvdetail saledetail,    
	dbo.item, 
	dbo.Customer,
	dbo.Accounts,
	dbo.Manufacturer 
WHERE  
	CASE lower(:as_datetype) 
				 When 'originaldate' Then dbo.saleledger.originaldate 
			    When 'lastsavingdate' Then dbo.saleledger.date
				 When 'billingdate' Then dbo.saleledger.billingdate
		   END between :ad_StartDate and :ad_EndDate and
	dbo.saleledger.custcode  IN ( :al_custcode ) AND
	dbo.saleledger.ImpactInventory='N' AND
	dbo.saleledger.salecatcode IN (1, 2, 3) AND
	dbo.saleledger.saleinvcode = saledetail.saleinvcode AND
	saledetail.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	SaleLedger.WardCode,
	saledetail.icode,
	dbo.item.name,
	Item.PackingDesc,
	dbo.manufacturer.name

/*SELECT 
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),
	SalesTaxRegNo = MAX(Customer.SalesTaxRegNo),
	Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),
	itemname = item.name, 
	Packing = Item.PackingDesc,
	manufacurer = (dbo.manufacturer.name),
	looseqty = Sum (dbo.saledetail.looseqty),
	price = max(dbo.saledetail.saleprice),    
	ID = MAX(dbo.saledetail.RowId),
	cumulativesum = round(0.0000,2),
	cumulativesumfoot = round(0.0000,2)
FROM 	 
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item, 
	dbo.Customer,
	dbo.Accounts,
	dbo.Manufacturer 
WHERE  
	:as_datetype = 'originaldate' AND
	dbo.saleledger.originaldate >= :ad_StartDate AND
	dbo.saleledger.originaldate <= :ad_EndDate  AND 
	dbo.saleledger.custcode  IN ( :al_custcode ) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) AND
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	dbo.saledetail.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	SaleLedger.WardCode,
	dbo.saledetail.icode,
	dbo.item.name,
	Item.PackingDesc,
	dbo.manufacturer.name
UNION
SELECT 
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),
	SalesTaxRegNo = MAX(Customer.SalesTaxRegNo),
	Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),
	itemname = item.name, 
	Packing = Item.PackingDesc,
	manufacurer = (dbo.manufacturer.name),
	looseqty = Sum (dbo.saledetail.looseqty),
	price = max(dbo.saledetail.saleprice),    
	ID = MAX(dbo.saledetail.RowId),
	cumulativesum = round(0.0000,2),
	cumulativesumfoot = round(0.0000,2)
FROM 	 
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item, 
	dbo.Customer,
	dbo.Accounts,
	dbo.Manufacturer 
WHERE  
	:as_datetype = 'lastsavingdate' AND
	dbo.saleledger.date >= :ad_StartDate AND
	dbo.saleledger.date <= :ad_EndDate  AND 
	dbo.saleledger.custcode  IN ( :al_custcode ) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) AND
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	dbo.saledetail.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	Item.PackingDesc,
	SaleLedger.WardCode,
	dbo.saledetail.icode,
	dbo.item.name,
	dbo.manufacturer.name
UNION
SELECT 
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),
	SalesTaxRegNo = MAX(Customer.SalesTaxRegNo),
	Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),
	itemname = item.name, 
	Packing = Item.PackingDesc,
	manufacurer = (dbo.manufacturer.name),
	looseqty = Sum (dbo.saledetail.looseqty),
	price = max(dbo.saledetail.saleprice),    
	ID = MAX(dbo.saledetail.RowId),
	cumulativesum = round(0.0000,2),
	cumulativesumfoot = round(0.0000,2)
FROM 	 
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item, 
	dbo.Customer,
	dbo.Accounts,
	dbo.Manufacturer 
WHERE  
	:as_datetype = 'billingdate' AND
	dbo.saleledger.billingdate >= :ad_StartDate AND
	dbo.saleledger.billingdate <= :ad_EndDate  AND 
	dbo.saleledger.custcode  IN ( :al_custcode ) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) AND
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	dbo.saledetail.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	SaleLedger.WardCode,
	dbo.saledetail.icode,
	dbo.item.name,
	Item.PackingDesc,
	dbo.manufacturer.name*/"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("as_city", string), ("as_cp", string), ("ai_suppress", number), ("as_datetype", string))
 sort="ward A, itemname A"
)
