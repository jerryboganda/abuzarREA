table(column=(type=char(60) updatewhereclause=yes name=areaname dbname="AreaName"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=char(1) updatewhereclause=yes name=impactinventory dbname="impactinventory"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=rowid dbname="rowid"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="customeralias"  )
column=(type=char(60) updatewhereclause=yes name=cust_add1 dbname="cust_add1"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
 retrieve=" SELECT 
	AreaName = Area.Name,
	SalesPerson = SalesMan.Name,
	saleinvcode = saleledger.saleinvcode,
	impactinventory = saleledger.impactinventory,
	date = saleledger.date,
	invdiscperc = saleledger.discperc,    
	flatdisc = saleledger.flatdisc,    
	misccharges = saleledger.misccharges, 
	invsalestax = saleledger.salestax,
	invgstperc1 = saleledger.invgstperc1,
	posted = saleledger.posted,	
	rowid = saledetail.rowid,
	looseqty = saledetail.looseqty, 
	bonusqty = saledetail.bonusqty, 
	itemflatdisc=saledetail.itemflatdisc,
	price = saledetail.saleprice,    
	rate = saledetail.rate, 
	itemdiscperc = saledetail.discperc,    
	packunits = saledetail.packunits,    
	batch = saledetail.batch,    
	expiry = saledetail.expiry,    
	itemname = item.name,
	itemalias=item.customicode,
	unitsalestax = saledetail.unitsalestax ,    
	gstperc = saledetail.gstperc ,    
	Customer = accounts.name,
	customeralias=accounts.aliasname,
	cust_add1= Area.Name,
	manufacturer = manufacturer.Name
FROM
	saleledger, 
	saledetail,    
	SalesMan,
	customer,
	accounts,
	item, 
	manufacturer,
	area
WHERE  
	saleledger.date BETWEEN :ad_StartDate AND :ad_EndDate  AND
	posted = CASE :ai_postingstatus WHEN 1 THEN 'Y' WHEN 2 THEN 'N' ELSE saleledger.posted END AND
	saleledger.SManCode = :ai_smancode AND
	saleledger.SManCode = salesman.salesmancode AND
	saleledger.custcode = customer.custcode AND
	customer.areacode IN (:ai_areacode) AND
	customer.custcode  = accounts.acccode AND
	customer.areacode = area.areacode AND
	saleledger.saleinvcode = saledetail.saleinvcode AND
	saledetail.icode = item.icode AND
	item.manfcode = manufacturer.manfcode
UNION ALL
SELECT 
	AreaName = Area.Name,
	SalesPerson = SalesMan.Name,
	saleinvcode = saleledger.saleinvcode,
	impactinventory = 'N',
	date = saleledger.date,   
	invdiscperc = saleledger.discperc,    
	flatdisc = saleledger.flatdisc,    
	misccharges = saleledger.misccharges, 
	invsalestax = saleledger.salestax,
	invgstperc1 = saleledger.invgstperc1,
	posted = saleledger.posted,	
	rowid = saledetail.rowid,
	looseqty = saledetail.looseqty, 
	bonusqty = saledetail.bonusqty, 
	itemflatdisc=saledetail.itemflatdisc,
	price = saledetail.saleprice,    
	rate = saledetail.rate, 
	itemdiscperc = saledetail.discperc,    
	packunits = saledetail.packunits,    
	batch = saledetail.batch,    
	expiry = saledetail.expiry,    
	itemname = item.name,
	itemalias=item.customicode,
	unitsalestax = saledetail.unitsalestax ,    
	gstperc = saledetail.gstperc ,    
	Customer = accounts.name,
	customeralias=accounts.aliasname,
	cust_add1= Area.Name,
	manufacturer = manufacturer.Name
FROM
	saleledger, 
	saleinvdetail saledetail,    
	item, 
	manufacturer,
	accounts,
	customer,
	area,
	SalesMan
WHERE  
	saleledger.date BETWEEN :ad_StartDate AND :ad_EndDate  AND
	posted = CASE :ai_postingstatus WHEN 1 THEN 'Y' WHEN 2 THEN 'N' ELSE saleledger.posted END AND
	saleledger.SManCode = :ai_smancode AND
	saleledger.SManCode = salesman.salesmancode AND
	saleledger.custcode = customer.custcode AND
	customer.areacode IN (:ai_areacode) AND
	customer.custcode  = accounts.acccode AND
	customer.areacode = area.areacode AND
	saleledger.saleinvcode = saledetail.saleinvcode AND
	saledetail.icode = item.icode AND
	item.manfcode = manufacturer.manfcode
"
  arguments=(("ai_areacode", numberlist), ("ai_smancode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_postingstatus", number), ("ai_suppressbatch", number), ("ai_suppressmanf", number))
 sort="saleinvcode A, rowid A"
)
