table(column=(type=long updatewhereclause=yes name=saleledger_saleinvcode dbname="SaleLedger.saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=saleledger_date dbname="SaleLedger.date"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Saledetail.saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="Saledetail.discperc"  )
column=(type=char(8000) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=char(203) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=itemclass_name dbname="ItemClass.name"  )
 retrieve="select   saleledger.saleinvcode, 
			saleledger.date,
	 		qty = saledetail.looseqty,
			saledetail.saleprice,	
	 		saledetail.discperc,	
			fullcode=stuff('0000', 5 - datalength(ltrim(str(dbo.item.iccode))), datalength(ltrim(str(dbo.item.iccode))), ltrim(str(dbo.item.iccode))) + stuff('00', 3 - datalength(ltrim(str(dbo.item.icatcode))), datalength(ltrim(str(dbo.item.icatcode))), ltrim(str(dbo.item.icatcode)))+ stuff('000', 4 - datalength(ltrim(str(dbo.item.packcode))), datalength(ltrim(str(dbo.item.packcode))), ltrim(str(dbo.item.packcode)))+ stuff('000', 4 - datalength(ltrim(str(dbo.item.manfcode))), datalength(ltrim(str(dbo.item.manfcode))), ltrim(str(dbo.item.manfcode))), 
	 		itemname= itemclass.name	+' ' +itemcategory.name+' ' +itempacking.name+' '+manufacturer.name,  
			itemclass.name 

from  	saleledger ,  
			saledetail , 
			item,
		 	itemclass,
		 	itemcategory,
		 	itempacking,
		 	manufacturer 

where 	(saleledger.saleinvcode = saledetail.saleinvcode and	
			 saleledger.date  between :ar_stdate and :ar_enddate  and
			 saleledger.salecatcode = 1 OR saleledger.salecatcode = 2) and
	 		 (saledetail.icode = item.icode  ) and 
	 		 (item.iccode    = :ar_iccode  and 
			 item.iccode    = itemclass.iccode  and  
			 item.icatcode  = itemcategory.icatcode  and  
      	 item.packcode  = itempacking.packcode  and  
      	 item.manfcode  = manufacturer.manfcode )

order by date	
"
  arguments=(("ar_iccode", number), ("ar_stdate", datetime), ("ar_enddate", datetime))
)
