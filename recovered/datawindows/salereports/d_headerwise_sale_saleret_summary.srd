table(column=(type=decimal(2) updatewhereclause=yes name=sale dbname="sale"  )
column=(type=decimal(2) updatewhereclause=yes name=cashsale dbname="Cashsale"  )
column=(type=decimal(2) updatewhereclause=yes name=creditsale dbname="Creditsale"  )
column=(type=decimal(2) updatewhereclause=yes name=saleretrun dbname="saleretrun"  )
column=(type=decimal(2) updatewhereclause=yes name=cashsaleretrun dbname="Cashsaleretrun"  )
column=(type=decimal(2) updatewhereclause=yes name=creditsaleretrun dbname="Creditsaleretrun"  )
column=(type=decimal(2) updatewhereclause=yes name=netsale dbname="netsale"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
 retrieve="SELECT
		sale=(select ISNULL(sum(invtotal),0)
				from saleledger SL
				where 
			    	H.headerno=SL.headerno AND 
				SL.date BETWEEN :ar_StartDate AND :ar_EndDate),
		Cashsale=(select ISNULL(sum(Case SL.salecatcode When 1 Then SL.InvTotal When 2 Then 0 Else SL.InvTotal End),0)
				from saleledger SL
				where 
			    	H.headerno=SL.headerno AND 
				SL.date BETWEEN :ar_StartDate AND :ar_EndDate),
		Creditsale=(select ISNULL(sum(Case SL.salecatcode When 1 Then 0 When 2 Then SL.InvTotal Else 0 End),0)
				from saleledger SL
				where 
			    	H.headerno=SL.headerno AND 
				SL.date BETWEEN :ar_StartDate AND :ar_EndDate),
		saleretrun=(select ISNULL(sum(invtotal),0)
			    		from srledger SRL
			    		where 
			    			H.headerno=SRL.headerno AND
						SRL.date BETWEEN :ar_StartDate AND :ar_EndDate),
		Cashsaleretrun=(select ISNULL(sum(Case When SRL.srcatcode = 8 Then SRL.InvTotal Else 0 End),0)
			    		from srledger SRL
			    		where 
			    			H.headerno=SRL.headerno AND
						SRL.date BETWEEN :ar_StartDate AND :ar_EndDate),
		Creditsaleretrun=(select ISNULL(sum(Case When SRL.srcatcode = 8 Then 0 Else SRL.InvTotal End),0)
			    		from srledger SRL
			    		where 
			    			H.headerno=SRL.headerno AND
						SRL.date BETWEEN :ar_StartDate AND :ar_EndDate),
		netsale=(select ISNULL(sum(invtotal),0)
					from saleledger SL
					where 
			    		H.headerno=SL.headerno AND
					SL.date BETWEEN :ar_StartDate AND :ar_EndDate)  -  	
			(select ISNULL(sum(invtotal),0)
				from srledger SRL
				where 
			    	H.headerno=SRL.headerno AND
				SRL.date BETWEEN :ar_StartDate AND :ar_EndDate),
		headerno=headerno
FROM
	(select distinct(headercode) as headerno from _headertabmaxkey) H
ORDER BY H.headerno


"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
