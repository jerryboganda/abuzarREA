release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1291 color="536870912" )
summary(height=291 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=zone dbname="Zone"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="ItemCategory.Icatcode"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Item.Packunits"  )
column=(type=decimal(13) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(6) updatewhereclause=yes name=value dbname="Value"  )
 retrieve="SELECT 
	Zone=(SELECT Zone.Name FROM Zone WHERE Zone.ZoneCode=:ai_zonecode),
	IC.Icatcode, 
	Category=Ic.Name,
	AliasName=I.CustomICode, 
	Item=I.Name,
	Packing=I.PackingDesc,
	I.Packunits,
	Price=Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),
	Qty = SUM(S.qty), 
	Bonus = SUM(S.bonus), 
	Value = CASE :ai_pricetype WHEN 1 THEN Round(SUM(S.Value), 2) 
			ELSE SUM(S.qty * Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) END	
FROM 
(SELECT
	saledetail.icode,
	Qty = SUM(saledetail.looseqty),
	Bonus = SUM(saledetail.bonusqty),
	Value=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*
		(1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),
	item.icatcode
FROM
	saleledger,	 
	saledetail,
	item,
	zoneareas,
	customer
WHERE
	saleledger.saleinvcode = saledetail.saleinvcode AND 
	saleledger.date >= :ad_startdate AND saleledger.date <= :ad_enddate AND
	zoneareas.zonecode = :ai_zonecode AND
	zoneareas.areacode = customer.areacode AND
	saleledger.custcode = customer.custcode AND
	saledetail.icode = item.icode AND
	item.icatcode in (:ai_icatcode)
GROUP BY 
	 saledetail.icode,
	 saleledger.discperc,
	 saleledger.flatdisc,
	 item.icatcode
UNION ALL
SELECT
	saledetail.icode,
	Qty = SUM(saledetail.looseqty),
	Bonus = SUM(saledetail.bonusqty),
	Value=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*
		(1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),
	item.icatcode
FROM
	saleledger,	 
	saleinvdetail saledetail,
	item,
	zoneareas,
	customer
WHERE
	SaleLedger.impactinventory = 'N' AND
	saleledger.saleinvcode = saledetail.saleinvcode AND 
	saleledger.date >= :ad_startdate AND saleledger.date <= :ad_enddate AND
	zoneareas.zonecode = :ai_zonecode AND
	zoneareas.areacode = customer.areacode AND
	saleledger.custcode = customer.custcode AND
	saledetail.icode = item.icode AND
	item.icatcode in (:ai_icatcode)
GROUP BY 
	 saledetail.icode,
	 saleledger.discperc,
	 saleledger.flatdisc,
	 item.icatcode
UNION ALL
SELECT
	srdetail.icode,
	Qty = -SUM(srdetail.looseqty),
	Bonus = -SUM(srdetail.bonusqty),
	Value= -SUM((srdetail.looseqty * srdetail.srprice)*
		(1 - (.01 * srdetail.discperc))) * (1 - (.01 * srledger.discperc)),
	item.icatcode
FROM
	srledger,	 
	srdetail,
	item,
	zoneareas,
	customer
WHERE
	srledger.srinvcode = srdetail.srinvcode AND 
	srledger.date >= :ad_startdate AND srledger.date <= :ad_enddate AND
	zoneareas.zonecode = :ai_zonecode AND
	zoneareas.areacode = customer.areacode AND
	srledger.custcode = customer.custcode AND
	srdetail.icode = item.icode AND
	item.icatcode in (:ai_icatcode)
GROUP BY 
	 srdetail.icode,
	 srledger.discperc,
	 srledger.flatdisc,
	 item.icatcode) S, ItemCategory IC, Item I
WHERE
	S.Icode = I.Icode AND 
	I.ICatCode = IC.ICatCode
GROUP BY 
	IC.Icatcode, 
	Ic.Name,
	I.CustomICode, 
	I.Name,
	I.PackingDesc,
	I.Packunits,
	I.SalePrice
ORDER BY 
	Ic.Name, 
	IC.Icatcode,
	I.Name,
	I.CustomICode
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_zonecode", number), ("ai_icatcode", numberlist), ("ai_pricetype", number))
)
