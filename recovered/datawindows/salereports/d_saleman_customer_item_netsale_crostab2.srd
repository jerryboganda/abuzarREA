table(column=(type=char(20) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=number updatewhereclause=yes name=netsaleqty dbname="netsaleqty"  )
column=(type=number updatewhereclause=yes name=netsalevalue dbname="netsalevalue"  )
 retrieve="SELECT
	SalesPerson=SM.Name,
	Date = S.Date,
	ItemName=I.Name,
	NetSaleQty = SUM(S.Qty),
	NetSaleValue = SUM(S.Value)
FROM
	Item I,
	SalesMan SM,
	(SELECT
		SManCode=:ai_smancode,
		Date=:ad_startdate,
		ICode,
		Qty = 0.0000,
		Value = 0.00
	FROM
		Item
	WHERE
		ICode IN (:ai_icode)
	UNION ALL
	SELECT
		SL.SManCode,
		Date=CONVERT(DATETIME, CONVERT(VARCHAR(12), SL.Date, 101)),
		SD.ICode,
		Qty = SUM(SD.LooseQty),
		Value = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) )
	FROM
		SaleLedger SL, SaleDetail SD
	WHERE
		SL.Date >= :ad_startdate AND
		SL.Date <= :ad_enddate AND
		SL.SManCode = :ai_smancode AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode IN (:ai_icode)
	GROUP BY 
		SL.SManCode,
		SL.Date,
		SD.ICode
	UNION ALL
	SELECT
		SL.SManCode,
		Date=CONVERT(DATETIME, CONVERT(VARCHAR(12), SL.Date, 101)),
		SD.ICode,
		Qty = SUM(SD.LooseQty),
		Value = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) )
	FROM
		SaleLedger SL, SaleInvDetail SD
	WHERE
		SL.ImpactInventory = 'N' AND
		SL.Date >= :ad_startdate AND
		SL.Date <= :ad_enddate AND
		SL.SManCode = :ai_smancode AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode IN (:ai_icode)
	GROUP BY 
		SL.SManCode,
		SL.Date,
		SD.ICode
	UNION ALL
	SELECT
		SL.SManCode,
		Date=CONVERT(DATETIME, CONVERT(VARCHAR(12), SL.Date, 101)),
		SD.ICode,
		Qty = - SUM(SD.LooseQty),
		Value = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) )
	FROM
		SRLedger SL, SRDetail SD
	WHERE
		SL.Date >= :ad_startdate AND
		SL.Date <= :ad_enddate AND
		SL.SManCode = :ai_smancode AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode IN (:ai_icode)
	GROUP BY 
		SL.SManCode,
		SL.Date,
		SD.ICode) S
WHERE
	I.ICode = S.ICode AND
	S.SManCode = SM.SalesManCode
GROUP BY
	SM.Name,
	S.Date,
	I.Name
ORDER BY
	SalesPerson,
	Date,
	ItemName
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_smancode", number), ("ai_icode", numberlist))
 sort="salesperson A, date A"
)
