table(column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=gp dbname="gp"  )
column=(type=decimal(2) updatewhereclause=yes name=servicegp dbname="servicegp"  )
 retrieve="SELECT 
	Disease=S.Disease, 
	Date=S.Date,
	GP = SUM(S.Sales) - SUM(S.Cost),
	ServiceGP = SUM(S.ServiceSales) - SUM(S.ServiceCost)
FROM
	(SELECT 
		Disease=D.Name, Date=CAST(LTRIM(RTRIM(STR(MONTH(:adt_startdate)))) + '/01/' + LTRIM(RTRIM(STR(YEAR(:adt_startdate)))) AS DATETIME), 
		Sales=0.00, SaleInvCode=0, Cost=0.00, ServiceSales=0.00, ServiceInvCode=0, ServiceCost = 0.00
	FROM Disease D
	UNION ALL
	SELECT 
		Disease=D.Name, Date=CAST(LTRIM(RTRIM(STR(MONTH(S.Date)))) + '/01/' + LTRIM(RTRIM(STR(YEAR(S.Date)))) AS DATETIME), 
		Sales=SUM(S.InvTotal), S.SaleInvcode, Cost=ISNULL((SELECT SUM((D.LooseQty + D.BonusQty) * D.AvgPrice) FROM SaleDetail D WHERE S.SaleInvCode=D.SaleInvCode), 0), ServiceSales=0.00, ServiceInvCode=0, ServiceCost = 0.00
	FROM 
		SaleLedger S, Patient P, Disease D
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.PatientCode = P.PatientCode AND
		P.DiseaseCode = D.DiseaseCode AND
		D.DiseaseCode IN (:ai_diseasecode)
	GROUP BY 
		D.Name,
		S.Date, 
		S.SaleInvCode
	UNION ALL
	SELECT 
		Disease=D.Name, Date=CAST(LTRIM(RTRIM(STR(MONTH(S.Date)))) + '/01/' + LTRIM(RTRIM(STR(YEAR(S.Date)))) AS DATETIME), 
		Sales=0.00, SaleInvCode=0, Cost=0.00, ServiceSales=SUM(S.InvTotal), S.ServiceInvCode, ServiceCost=ISNULL((SELECT SUM(P.InvTotal) FROM ServicePurHeader P WHERE P.ServiceInvCode=S.ServiceInvCode), 0)
	FROM 
		ServiceHeader S, Patient P, Disease D
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.PatientCode = P.PatientCode AND
		P.DiseaseCode = D.DiseaseCode AND
		D.DiseaseCode IN (:ai_diseasecode)
	GROUP BY 
		D.Name,
		S.Date,
		S.ServiceInvCode) S
GROUP BY 
	S.Date,
	Disease"
  arguments=(("ai_diseasecode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="date A"
)
