release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=26 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1041 color="536870912" )
header[2](height=354 color="536870912" )
summary(height=197 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=zonename dbname="zonename"  )
column=(type=char(20) updatewhereclause=yes name=description dbname="description"  )
column=(type=number updatewhereclause=yes name=value dbname="value"  )
 retrieve="SELECT 
	ZoneCode=T.ZoneCode,
	ZoneName=T.ZoneName,
	Date = CONVERT(VARCHAR(100), T.Date, 106),
	Description=T.Description,
	Value = SUM(Value)
FROM
	(SELECT 
		ZoneCode=Z.ZoneCode,
		ZoneName=Z.Name,
		Date = CAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),
		Description= LTRIM(RTRIM(I.CustomICode)) + ' / ' + I.Name,
		Value = CASE :ai_column WHEN 1 THEN SUM(SD.LooseQty) ELSE SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)) END
	FROM
		Zone Z, ZoneAreas ZA, Customer C, Item I, SaleLedger SL, SaleDetail SD
	WHERE
		:ai_reporttype = 1 AND
		Z.ZoneCode IN (:ai_zonecode) AND
		Z.ZoneCode = ZA.ZoneCode AND
		ZA.AreaCode = C.AreaCode AND
		C.CustCode = SL.CustCode AND
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (SELECT ZM.ManfCode FROM ZONE ZM WHERE ZM.ZoneCode IN (:ai_zonecode))
	GROUP BY
		Z.ZoneCode,
		Z.Name,
		CAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),
		SD.ICode,
		I.CustomICode,
		I.Name
	UNION ALL
	SELECT 
		ZoneCode=Z.ZoneCode,
		ZoneName=Z.Name,
		Date = CAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),
		Description= LTRIM(RTRIM(I.CustomICode)) + ' / ' + I.Name,
		Value = - CASE :ai_column WHEN 1 THEN SUM(SD.LooseQty) ELSE SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)) END
	FROM
		Zone Z, ZoneAreas ZA, Customer C, Item I, SRLedger SL, SRDetail SD
	WHERE
		:ai_reporttype = 1 AND
		Z.ZoneCode IN (:ai_zonecode) AND
		Z.ZoneCode = ZA.ZoneCode AND
		ZA.AreaCode = C.AreaCode AND
		C.CustCode = SL.CustCode AND
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (SELECT ZM.ManfCode FROM ZONE ZM WHERE ZM.ZoneCode IN (:ai_zonecode))
	GROUP BY
		Z.ZoneCode,
		Z.Name,
		CAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),
		SD.ICode,
		I.CustomICode,
		I.Name
	UNION ALL
	SELECT 
		ZoneCode=Z.ZoneCode,
		ZoneName=Z.Name,
		Date = CAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),
		Description= IC.Name,
		Value = CASE :ai_column WHEN 1 THEN SUM(SD.LooseQty) ELSE SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)) END
	FROM
		Zone Z, ZoneAreas ZA, Customer C, Item I, SaleLedger SL, SaleDetail SD, ItemCategory IC
	WHERE
		:ai_reporttype = 2 AND
		Z.ZoneCode IN (:ai_zonecode) AND
		Z.ZoneCode = ZA.ZoneCode AND
		ZA.AreaCode = C.AreaCode AND
		C.CustCode = SL.CustCode AND
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (SELECT ZM.ManfCode FROM ZONE ZM WHERE ZM.ZoneCode IN (:ai_zonecode)) AND
		I.ICatCode = IC.ICatCode
	GROUP BY
		Z.ZoneCode,
		Z.Name,
		CAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),
		IC.Name
	UNION ALL
	SELECT 
		ZoneCode=Z.ZoneCode,
		ZoneName=Z.Name,
		Date = CAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),
		Description= IC.Name,
		Value = - CASE :ai_column WHEN 1 THEN SUM(SD.LooseQty) ELSE SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)) END
	FROM
		Zone Z, ZoneAreas ZA, Customer C, Item I, SRLedger SL, SRDetail SD, ItemCategory IC
	WHERE
		:ai_reporttype = 2 AND
		Z.ZoneCode IN (:ai_zonecode) AND
		Z.ZoneCode = ZA.ZoneCode AND
		ZA.AreaCode = C.AreaCode AND
		C.CustCode = SL.CustCode AND
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (SELECT ZM.ManfCode FROM ZONE ZM WHERE ZM.ZoneCode IN (:ai_zonecode)) AND
		I.ICatCode = IC.ICatCode
	GROUP BY
		Z.ZoneCode,
		Z.Name,
		CAST(CONVERT(VARCHAR(15), SL.Date, 101) AS DATETIME),
		IC.Name) T
GROUP BY
	T.ZoneCode,
	T.ZoneName,
	T.Date,
	T.Description
"
  arguments=(("ai_reporttype", number), ("ai_column", number), ("ai_zonecode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="zonename A, description A"
)
