table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="manfcode"  )
column=(type=char(60) updatewhereclause=yes name=manfname dbname="manfname"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(6) updatewhereclause=yes name=bonusamount dbname="bonusamount"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(8) updatewhereclause=yes name=discount dbname="discount"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="supplier"  )
 retrieve="SELECT 
	itemname = item.name,
	stock=(select isnull(sum(currqty),0) from godowndetail  where godowndetail.icode=item.icode),
	itemalias= item.customicode,
	manfcode = Manufacturer.manfcode, 
	manfname = Manufacturer.Name,
	qty      = ISNULL(Sum(S.qty), 0), 
	bonusamount   = ISNULL(Sum(S.bonusAmount), 0),
	bonusqty      = ISNULL(Sum(S.bonusqty), 0), 
	discount = ISNULL(SUM(S.Discount), 0),
	amount   = ISNULL(Sum(S.Amount), 0),
	supplier=
		(select a.name
		from 
			accounts a, itemsuppliers isp
		where 
			isp.icode = item.icode and 
			isp.suppcode = a.acccode and
			isp.priority in 
				(select p=min(ip.priority) 
				from itemsuppliers ip 
				where ip.icode = isp.icode))
FROM
	dbo.item
	LEFT OUTER JOIN 
	(SELECT 
		saledetail.icode,
		qty      = Sum(dbo.saledetail.looseqty),
		bonusqty=Sum(dbo.saledetail.bonusqty),
		bonusamount   = Round(Sum ( dbo.saledetail.bonusqty * dbo.saledetail.saleprice), 2),
		discount = Round(Sum ( (dbo.saledetail.looseqty * ((case when dbo.saledetail.saleprice = dbo.saledetail.rate then dbo.saledetail.saleprice else dbo.saledetail.rate end)  - (dbo.saledetail.itemflatdisc + dbo.saledetail.cloneitemflatdisc))) * (dbo.saledetail.discperc + dbo.saledetail.clonediscperc) * .01 + dbo.saledetail.looseqty * (dbo.saledetail.itemflatdisc + dbo.saledetail.cloneitemflatdisc)) , 2),
		amount   = Round(Sum ( dbo.saledetail.looseqty * (case when dbo.saledetail.saleprice = dbo.saledetail.rate then dbo.saledetail.saleprice else dbo.saledetail.rate end)), 2)
	FROM 	 
		dbo.saleledger, dbo.saledetail
	WHERE
		dbo.saleledger.date >= :ad_StartDate and
		dbo.saleledger.date <= :ad_EndDate  and
		dbo.saleledger.salecatcode IN (1, 2, 3) and
		dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
		dbo.saledetail.icode IN (SELECT item.icode FROM Item WHERE Item.ManfCode IN (:ll_manfcode) and item.active = 1)
	GROUP BY 
		saledetail.icode
	UNION ALL
	SELECT 
		sd.icode,
		qty      = Sum(sd.looseqty),
		bonusqty= Sum(sd.bonusqty),
		bonusamount   = Round(Sum ( sd.bonusqty * sd.saleprice), 2),
		discount = Round(Sum ( (sd.looseqty * (sd.saleprice - sd.itemflatdisc)) * (sd.discperc) * .01 + sd.looseqty * sd.itemflatdisc) , 2),
		amount   = Round(Sum ( sd.looseqty * sd.saleprice), 2)
	FROM 	 
		dbo.saleledger, dbo.saleinvdetail sd
	WHERE
		DBO.SaleLedger.impactinventory = 'N' AND
		dbo.saleledger.date >= :ad_StartDate and
		dbo.saleledger.date <= :ad_EndDate  and
		dbo.saleledger.salecatcode IN (1, 2, 3) and
		dbo.saleledger.saleinvcode = sd.saleinvcode and  
		sd.icode IN (SELECT item.icode FROM Item WHERE Item.ManfCode IN (:ll_manfcode) and item.active = 1)
	GROUP BY 
		sd.icode
	UNION ALL
	SELECT 
		srdetail.icode,
		qty      = -Sum(dbo.srdetail.looseqty),
		bonusqty      = -Sum(dbo.srdetail.bonusqty),
		bonusamount   = -Round(Sum ( dbo.srdetail.bonusqty * dbo.srdetail.srprice), 2),
		discount = -Round(Sum ( (dbo.srdetail.looseqty * dbo.srdetail.srprice) * (dbo.srdetail.discperc) * .01) , 2),
		amount   = -Round(Sum ( dbo.srdetail.looseqty * dbo.srdetail.srprice), 2)
	FROM 	 
		dbo.srledger, dbo.srdetail
	WHERE
		dbo.srledger.date >= :ad_StartDate and
		dbo.srledger.date <= :ad_EndDate  and
		dbo.srledger.srinvcode = dbo.srdetail.srinvcode and  
		dbo.srdetail.icode IN (SELECT item.icode FROM Item WHERE Item.ManfCode IN (:ll_manfcode) and item.active = 1) AND
		IsNull(srledger.saleinvcode,-1) IN (SELECT saleinvcode =
		CASE :as_return when 'A' THEN
			IsNull(srledger.saleinvcode,-1) 
		ELSE
			(SELECT SaleLedger.SALEINVCODE FROM dbo.SaleLedger 
			WHERE dbo.saleledger.date >= :ad_StartDate and dbo.saleledger.date <= :ad_EndDate  and
				SaleLedger.SALEINVCODE = srledger.saleinvcode)
		END
		)

GROUP BY 
	srdetail.icode) S ON (dbo.item.icode = S.icode), Manufacturer

WHERE
	dbo.item.manfcode in (:ll_manfcode) and
	dbo.item.active = 1 and
	dbo.item.manfcode = Manufacturer.manfcode 
GROUP BY 
	item.Icode,
	item.name,
	item.customicode,
	Manufacturer.manfcode,
	Manufacturer.Name
ORDER BY
	Manufacturer.Name,
	item.name

	"
  arguments=(("ll_manfcode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("as_return", string))
 sort="manfname A, itemname A"
)
