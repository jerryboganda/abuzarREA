 retrieve="SELECT 
	orderby=code2,
	groupcode=code5,
	groupname=name5,
	itemcode=code1, 
	aliasname=name2,  
	itemname=name1,
	TradePrice = I.SalePrice,
	packing=name3, 
	areacode=code3,
	area=name4,
	areaname1=c_name1,
	areaname2=c_name2,
	areaname3=c_name3,
	areaname4=c_name4,
	areaname5=c_name5,
	areaname6=c_name6,
	areaname7=c_name7,
	areaname8=c_name8,
	areaname9=c_name9,
	areaname10=c_name10,
	areaname11=c_name11,
	areaname12=c_name12,
	areaname13=c_name13,
	qty1=ISNULL(qty1, 0),
	qty2=ISNULL(qty2, 0),
	qty3=ISNULL(qty3, 0),
	qty4=ISNULL(qty4, 0),
	qty5=ISNULL(qty5, 0),
	qty6=ISNULL(qty6, 0),
	qty7=ISNULL(qty7, 0),
	qty8=ISNULL(qty8, 0),
	qty9=ISNULL(qty9, 0),
	qty10=ISNULL(qty10, 0),
	qty11=ISNULL(qty11, 0),
	qty12=ISNULL(qty12, 0),
	qty13=ISNULL(qty13, 0),

	value1=ISNULL(value1, 0),
	value2=ISNULL(value2, 0),
	value3=ISNULL(value3, 0),
	value4=ISNULL(value4, 0),
	value5=ISNULL(value5, 0),
	value6=ISNULL(value6, 0),
	value7=ISNULL(value7, 0),
	value8=ISNULL(value8, 0),
	value9=ISNULL(value9, 0),
	value10=ISNULL(value10, 0),
	value11=ISNULL(value11, 0),
	value12=ISNULL(value12, 0),
	value13=ISNULL(value13, 0),

	val1=ISNULL(val1, 0),
	val2=ISNULL(val2, 0),
	val3=ISNULL(val3, 0),
	val4=ISNULL(val4, 0),
	val5=ISNULL(val5, 0),
	val6=ISNULL(val6, 0),
	val7=ISNULL(val7, 0),
	val8=ISNULL(val8, 0),
	val9=ISNULL(val9, 0),
	val10=ISNULL(val10, 0),
	val11=ISNULL(val11, 0),
	val12=ISNULL(val12, 0),
	val13=ISNULL(val13, 0),

	totqty,
	totbonus = ISNULL(value15,0),
	totval

from 
	crosstab_reportdata , Item I
WHERE 
	I.ICode = crosstab_reportdata.Code1
order by 
	area, 
	groupname, 
	orderby, 
	itemname, 
	aliasname, 
	packing"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_mergebonus", number))
 sort="groupname A, orderby A, itemname A"
)
