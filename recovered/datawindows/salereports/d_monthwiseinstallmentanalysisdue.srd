table(column=(type=long updatewhereclause=yes name=installmentcode dbname="InstallmentCode"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=char(61) updatewhereclause=yes name=salemonth dbname="SaleMonth"  )
column=(type=datetime updatewhereclause=yes name=saledate dbname="SaleDate"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(100) updatewhereclause=yes name=cellno dbname="CellNo"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(2) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(9) updatewhereclause=yes name=costvalue dbname="CostValue"  )
column=(type=decimal(2) updatewhereclause=yes name=advance dbname="Advance"  )
column=(type=decimal(2) updatewhereclause=yes name=firstinstallment dbname="FirstInstallment"  )
column=(type=decimal(2) updatewhereclause=yes name=installmentcancelled dbname="InstallmentCancelled"  )
column=(type=decimal(2) updatewhereclause=yes name=lastreceived dbname="LastReceived"  )
column=(type=datetime updatewhereclause=yes name=lastreceivedon dbname="LastReceivedOn"  )
column=(type=decimal(2) updatewhereclause=yes name=totalreceipts dbname="TotalReceipts"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
 retrieve="SELECT 
	InstallmentCode=IH.InstallmentCode,
	SaleInvCode = S.SaleInvCode,
	SaleMonth = DATENAME(month, S.Date) + '-' + DATENAME(year, S.Date),
	SaleDate = S.Date,
	CustomerName = A.Name,
	CellNo = C.CellNo,
	ItemName = I.Name,
	SaleValue = ISNULL(S.InvTotal,0),
	CostValue = ISNULL(SUM(SD.LooseQty * SD.AvgPrice), 0),
	Advance = ISNULL(IH.DownPayment,0),
	FirstInstallment = ISNULL((SELECT SUM(ISD.Amount) FROM InstallmentDetail ISD WHERE ISD.InstallmentCode = IH.InstallmentCode),0),
	InstallmentCancelled = ISNULL((SELECT SUM(ISD.Amount) FROM InstallmentDetail ISD WHERE ISD.InstallmentCode = IH.InstallmentCode AND ISD.Cancelled='Y' AND ISD.CancelledOn <= :adt_enddate ),0),
	LastReceived = 
		(SELECT IR.AmtReceived + IR.Discount 
					FROM InstallmentReceipt IR 
					WHERE IR.SaleInvCode = IH.SaleInvCode AND IR.Date <= :adt_enddate AND 
						IR.ReceiptCode IN 
							(SELECT MAX(RR.ReceiptCode) 
							FROM InstallmentReceipt RR 
							WHERE RR.Date <= :adt_enddate AND RR.SaleInvCode = IH.SaleInvCode)),
	LastReceivedOn = (SELECT IR.Date 
					FROM InstallmentReceipt IR 
					WHERE IR.SaleInvCode = IH.SaleInvCode AND IR.Date <= :adt_enddate AND 
						IR.ReceiptCode IN 
							(SELECT MAX(RR.ReceiptCode) 
							FROM InstallmentReceipt RR 
							WHERE RR.Date <= :adt_enddate AND RR.SaleInvCode = IH.SaleInvCode) ),
	TotalReceipts = ISNULL((SELECT SUM(IR.AmtReceived) FROM InstallmentReceipt IR WHERE IR.SaleInvCode = IH.SaleInvCode AND IR.Date <= :adt_enddate), 0),
	Balance = ISNULL(S.InvTotal,0) - ISNULL(IH.DownPayment,0) - ISNULL((SELECT SUM(IR.AmtReceived + IR.Discount) FROM InstallmentReceipt IR WHERE IR.SaleInvCode = IH.SaleInvCode AND IR.Date <= :adt_enddate),0) - ISNULL((SELECT SUM(ISD.Amount) FROM InstallmentDetail ISD WHERE ISD.InstallmentCode = IH.InstallmentCode AND ISD.Cancelled='Y' AND ISD.CancelledOn <= :adt_enddate ),0)
FROM 
	InstallmentHeader IH, SaleLedger S, SaleDetail SD, Customer C, Accounts A, Item I
WHERE 
	IH.Posted = 'Y' AND 
	IH.PostDate BETWEEN :adt_startdate AND :adt_enddate AND
	IH.SaleInvCode = S.SaleInvCode AND 
	S.SaleInvCode = SD.SaleInvCode AND
	SD.ICode = I.ICode AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode
GROUP BY
	IH.InstallmentCode,
	S.SaleInvCode,
	S.date,
	A.Name,
	C.CellNo,
	I.Name,
	S.InvTotal,
	IH.DownPayment,
	IH.SaleInvCode"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="saledate A"
)
