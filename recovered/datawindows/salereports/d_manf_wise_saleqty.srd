table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(6) updatewhereclause=yes name=value dbname="value"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="manfcode"  )
 retrieve="SELECT
	itemname=I.name,
	itemalias=I.customicode,
	date=A.date,
	qty=ISNULL(A.qty,0),
	value=ISNULL(A.qty*Case :ai_pricetype 
								WHEN 2 THEN Round(I.purprice / I.PackUnits, 2)
                     	WHEN 1 THEN Round(I.Saleprice / I.PackUnits, 2)
                     	WHEN 3 THEN Round(I.avgprice, 2)
                     END,0),
	manufacturer=(select name from manufacturer where manfcode=I.manfcode),
	manfcode=I.manfcode
FROM 
	item I,
	(select 
		qty=ISNULL(sum(SD.looseqty + SD.bonusqty),0),
		date=convert(datetime,convert(varchar(15),SL.date,101)),
		icode=SD.icode
	 from saleledger SL, saledetail SD, Item I
	 where SL.date>=:ad_startdate and
	       SL.date<=:ad_enddate and
	       SL.saleinvcode=SD.saleinvcode and
	       SD.icode=I.icode and
	       I.manfcode IN (:aa_manfcode)
	 group by 
			convert(datetime,convert(varchar(15),SL.date,101)),
		  	SD.icode
	UNION ALL
	select 
		qty=ISNULL(sum(SD.looseqty + SD.bonusqty),0),
		date=convert(datetime,convert(varchar(15),SL.date,101)),
		icode=SD.icode
	 from saleledger SL, saleinvdetail SD, Item I
	 where SL.ImpactInventory = 'N' AND
			 SL.date>=:ad_startdate and
	       SL.date<=:ad_enddate and
	       SL.saleinvcode=SD.saleinvcode and
	       SD.icode=I.icode and
	       I.manfcode IN (:aa_manfcode)
	 group by 
			convert(datetime,convert(varchar(15),SL.date,101)),
		  	SD.icode) AS A
WHERE 
	I.manfcode IN (:aa_manfcode) AND
	I.icode=A.icode
ORDER by 
	manufacturer,
	A.date,
	itemname
"
  arguments=(("aa_manfcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_pricetype", number))
)
