 retrieve="SELECT 
	orderby=code2, 
	groupcode=code5,
	groupname=name5,
	itemcode=code1, 
	aliasname=name2, 
	itemname=name1, 
	packing=name3, 
	salespersoncode=code3,
	salesperson=name4,
	areaname1=c_name1,
	areaname2=c_name2,
	areaname3=c_name3,
	areaname4=c_name4,
	areaname5=c_name5,
	areaname6=c_name6,
	areaname7=c_name7,
	qty1,
	qty2,
	qty3,
	qty4,
	qty5,
	qty6,
	qty7,
	val1,
	val2,
	val3,
	val4,
	val5,
	val6,
	val7,
	totqty,
	totval

from 
	crosstab_reportdata 
order by 
	salesperson, 
	groupname, 
	orderby, 
	itemname, 
	aliasname, 
	packing"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="groupname A, orderby A, itemname A"
)
