datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1479 color="536870912" )
summary(height=718 color="536870912" )
footer(height=0 color="536870912" )
detail(height=166 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(150) updatewhereclause=yes name=genericname dbname="genericname"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="AvgPrice"  )
column=(type=decimal(13) updatewhereclause=yes name=purprice dbname="PurPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=purdiscperc dbname="PurDiscPerc"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="salevalue"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(4) updatewhereclause=yes name=returnqty dbname="returnqty"  )
column=(type=decimal(6) updatewhereclause=yes name=retval dbname="retval"  )
column=(type=decimal(4) updatewhereclause=yes name=netqty dbname="netqty"  )
column=(type=decimal(6) updatewhereclause=yes name=netval dbname="netval"  )
 retrieve="SELECT
	itemname=A.itemname,
	genericname=A.genericname,
	ItemCategory=A.ItemCategory,
	AvgPrice = MAX(A.AvgPrice),
	PurPrice = MAX(A.PurPrice),
	PurDiscPerc = MAX(A.PurDiscPerc),
	salevalue=sum(A.saleval),
	saleqty=sum(A.saleqty),
	returnqty=sum(A.retqty),
	retval=Sum(A.retval),
	netqty=sum(A.saleqty) - sum(A.retqty),
	netval= sum(A.saleval) - Sum(A.retval)
FROM
		(SELECT
			ICode=I.ICode,
			itemname=I.Name,
			genericname=(select name from genericitem where genericitem.genericcode=I.genericcode),
			ItemCategory=(select C.name from ItemCategory C where C.ICatCode=I.ICatcode),
			I.Avgprice,
			PurPrice = Round(I.PurPrice / CASE WHEN I.PackUnits = 0 THEN 1 WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END, 2),
			I.PurDiscPerc,
			saleqty=ISNULL(sum(SD.looseqty+SD.bonusqty),0),
			saleval=ISNULL(sum(SD.looseqty*(((SD.saleprice - SD.itemflatdisc)*(1 - SD.discperc*0.01))*(1 - SL.discperc*0.01))),0),
			retqty=0,
			retval=0
		FROM  	
			saleledger SL,
			saledetail SD,
			item I
		WHERE 
			SL.date>=:ar_startdate AND
			SL.date<=:ar_enddate AND
			SL.saleinvcode=SD.saleinvcode AND
			I.icode=SD.icode AND
			I.genericcode IN (:ai_genericitem)
		GROUP BY 
			 I.icode,
			 I.name,
			 I.GenericCode,
			 I.ICatCode,
			 I.Avgprice,
			 I.PurPrice,
			 I.PackUnits,
			 I.PurDiscPerc
		UNION ALL
		
		select 
			ICode=I.ICode,
			itemname=I.Name,
			genericname=(select name from genericitem where genericitem.genericcode=I.genericcode),
			ItemCategory=(select C.name from ItemCategory C where C.ICatCode=I.ICatcode),
			I.Avgprice,
			PurPrice = Round(I.PurPrice / CASE WHEN I.PackUnits = 0 THEN 1 WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END, 2),
			I.PurDiscPerc,
			saleqty=ISNULL(sum(SD.looseqty+SD.bonusqty),0),
			saleval=ISNULL(sum(SD.looseqty*(((SD.saleprice - SD.itemflatdisc)*(1 - SD.discperc*0.01))*(1 - SL.discperc*0.01))),0),
			retqty=0,
			retval=0
		
		FROM  
			saleledger SL,
			saleinvdetail SD,
			item I
		
		WHERE 
			SL.date>=:ar_startdate AND
			SL.date<=:ar_enddate AND
			SL.saleinvcode=SD.saleinvcode AND
			I.icode=SD.icode AND
			I.genericcode IN (:ai_genericitem)
		
		GROUP BY 
			I.icode,
			I.name,
			I.GenericCode,
			I.ICatCode,
			 I.Avgprice,
			 I.PurPrice,
			 I.PackUnits,
			 I.PurDiscPerc
		
		UNION ALL
		
		select 
			ICode=I.ICode,
			itemname=I.Name,
			genericname=(select name from genericitem where genericitem.genericcode=I.genericcode),
			ItemCategory=(select C.name from ItemCategory C where C.ICatCode=I.ICatcode),
			I.Avgprice,
			PurPrice = Round(I.PurPrice / CASE WHEN I.PackUnits = 0 THEN 1 WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END, 2),
			I.PurDiscPerc,
			saleqty=0,
			saleval=0,
			retqty=ISNULL(sum(SD.looseqty+SD.bonusqty),0),
			retval=ISNULL(sum(SD.looseqty*((SD.srprice *(1 - SD.discperc*0.01))*(1 - SL.discperc*0.01))),0)
		
		FROM  	
			srledger SL,
			srdetail SD,
			item I
		
		WHERE 
			SL.date>=:ar_startdate AND
			SL.date<=:ar_enddate AND
			SL.srinvcode=SD.srinvcode AND
			I.icode=SD.icode AND
			I.genericcode IN (:ai_genericitem)
		
		GROUP BY I.icode,
			I.name,
			I.GenericCode,
			I.ICatCode,
			 I.Avgprice,
			 I.PurPrice,
			 I.PackUnits,
			 I.PurDiscPerc
			 ) A

GROUP BY
	A.genericname,
	A.ItemCategory,
	A.itemname
ORDER BY
	A.genericname,
	A.ItemCategory,
	A.itemname

	
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ai_genericitem", numberlist))
)
