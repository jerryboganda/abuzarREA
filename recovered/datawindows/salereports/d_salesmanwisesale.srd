table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleLedger.saleinvcode"  )
column=(type=long updatewhereclause=yes name=salespersoncode dbname="SaleLedger.SmanCode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="salesman"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(30) updatewhereclause=yes name=ref dbname="ref"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
 retrieve="SELECT SL.saleinvcode,
		SL.SmanCode,
		salesman=(select name from salesman where salesman.salesmancode=SL.smancode),
		customer=(select name from accounts where accounts.acccode=MAX(SL.custcode)),
		date=MAX(SL.date),
		ref=max(SL.custrefno),
		amount=Round( 
			SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
			SL.misccharges + SL.salestax - SL.flatdisc, 0)+
			Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
			SUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
			ROUND( (SUM((SD.looseqty * 
				(SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
				SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0)

	FROM    saleledger SL,	 
		saledetail SD
	WHERE   SL.date Between :ar_startdate AND :ar_enddate AND
			  SL.SaleInvCode = SD.SaleInvcode AND
				SL.smancode IN (:aa_salesmancode)

	GROUP BY SL.saleinvcode,
		 SL.SmanCode,
		 SL.discperc,
		 SL.misccharges,
		 SL.salestax,
		 SL.flatdisc,
		 SL.invgstperc1
UNION ALL
SELECT SL.saleinvcode,
		SL.SmanCode,
		salesman=(select name from salesman where salesman.salesmancode=SL.smancode),
		customer=(select name from accounts where accounts.acccode=MAX(SL.custcode)),
		date=MAX(SL.date),
		ref=max(SL.custrefno),
		amount=Round(
			SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
			SL.misccharges + SL.salestax - SL.flatdisc, 0)+
			Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
			SUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
			ROUND( (SUM((SD.looseqty * 
				(SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
				SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0)

	FROM    saleledger SL,	 
		saleinvdetail SD
	WHERE   SL.ImpactInventory = 'N' AND 
				SL.date Between :ar_startdate AND :ar_enddate AND
			  SL.SaleInvCode = SD.SaleInvcode AND
				SL.smancode IN (:aa_salesmancode)

	GROUP BY SL.saleinvcode,
		 SL.SmanCode,
		 SL.discperc,
		 SL.misccharges,
		 SL.salestax,
		 SL.flatdisc,
		 SL.invgstperc1
ORDER BY salesman,
			SL.saleinvcode
"
  arguments=(("aa_salesmancode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
