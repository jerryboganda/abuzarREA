datawindow ( units=0 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=936 color="536870912" )
summary(height=88 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=maingroup dbname="MainGroup"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(60) updatewhereclause=yes name=item1 dbname="Item1"  )
column=(type=decimal(4) updatewhereclause=yes name=qty1 dbname="Qty1"  )
column=(type=char(60) updatewhereclause=yes name=item2 dbname="Item2"  )
column=(type=decimal(4) updatewhereclause=yes name=qty2 dbname="Qty2"  )
column=(type=char(60) updatewhereclause=yes name=item3 dbname="Item3"  )
column=(type=decimal(4) updatewhereclause=yes name=qty3 dbname="Qty3"  )
column=(type=char(60) updatewhereclause=yes name=item4 dbname="Item4"  )
column=(type=decimal(4) updatewhereclause=yes name=qty4 dbname="Qty4"  )
column=(type=char(60) updatewhereclause=yes name=item5 dbname="Item5"  )
column=(type=decimal(4) updatewhereclause=yes name=qty5 dbname="Qty5"  )
column=(type=char(60) updatewhereclause=yes name=item6 dbname="Item6"  )
column=(type=decimal(4) updatewhereclause=yes name=qty6 dbname="Qty6"  )
column=(type=char(60) updatewhereclause=yes name=item7 dbname="Item7"  )
column=(type=decimal(4) updatewhereclause=yes name=qty7 dbname="Qty7"  )
column=(type=char(60) updatewhereclause=yes name=item8 dbname="Item8"  )
column=(type=decimal(4) updatewhereclause=yes name=qty8 dbname="Qty8"  )
column=(type=char(60) updatewhereclause=yes name=item9 dbname="Item9"  )
column=(type=decimal(4) updatewhereclause=yes name=qty9 dbname="Qty9"  )
column=(type=char(60) updatewhereclause=yes name=item10 dbname="Item10"  )
column=(type=decimal(4) updatewhereclause=yes name=qty10 dbname="Qty10"  )
column=(type=decimal(6) updatewhereclause=yes name=totalvalue dbname="TotalValue"  )
 retrieve="SELECT
	MainGroup,
	GroupCode,
	GroupName, 
	Item1 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode1),
	Qty1 = SUM(CASE ICode WHEN :ai_icode1 THEN Qty ELSE 0 END),
	Item2 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode2),
	Qty2 = SUM(CASE ICode WHEN :ai_icode2 THEN Qty ELSE 0 END),
	Item3 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode3),
	Qty3 = SUM(CASE ICode WHEN :ai_icode3 THEN Qty ELSE 0 END),
	Item4 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode4),
	Qty4 = SUM(CASE ICode WHEN :ai_icode4 THEN Qty ELSE 0 END),
	Item5 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode5),
	Qty5 = SUM(CASE ICode WHEN :ai_icode5 THEN Qty ELSE 0 END),
	Item6 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode6),
	Qty6 = SUM(CASE ICode WHEN :ai_icode6 THEN Qty ELSE 0 END),
	Item7 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode7),
	Qty7 = SUM(CASE ICode WHEN :ai_icode7 THEN Qty ELSE 0 END),
	Item8 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode8),
	Qty8 = SUM(CASE ICode WHEN :ai_icode8 THEN Qty ELSE 0 END),
	Item9 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode9),
	Qty9 = SUM(CASE ICode WHEN :ai_icode9 THEN Qty ELSE 0 END),
	Item10 = (SELECT I.Name FROM Item I WHERE ICode=:ai_icode10),
	Qty10 = SUM(CASE ICode WHEN :ai_icode10 THEN Qty ELSE 0 END),
	TotalValue = SUM(Value)
FROM
	(SELECT 
		MainGroup = A.Name,
		GroupCode = AC.AccCode,
		GroupName = AC.Name,
		ICode = SD.ICode,
		Qty = Sum(SD.LooseQty),
		Value  = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM
		SaleLedger S, SaleDetail SD, Customer C, Area A, Accounts AC
	WHERE
		:as_group = 'A' AND
		A.AreaCode IN (:ai_groupcode) AND 
		A.AreaCode = C.AreaCode AND 
		C.CustCode = AC.AccCode AND
		C.CustCode = S.CustCode AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND 
		S.SaleInvCode = SD.SaleInvCode AND
		SD.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)
	GROUP BY
		A.Name,
		AC.AccCode,
		AC.Name,
		SD.ICode
	UNION ALL
	SELECT 
		MainGroup = A.Name,
		GroupCode = AC.AccCode,
		GroupName = AC.Name,
		ICode = SD.ICode,
		Qty = - Sum(SD.LooseQty),
		Value  = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM
		SRLedger S, SRDetail SD, Customer C, Area A, Accounts AC
	WHERE
		:as_group = 'A' AND
		A.AreaCode IN (:ai_groupcode) AND 
		A.AreaCode = C.AreaCode AND 
		C.CustCode = AC.AccCode AND
		C.CustCode = S.CustCode AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SRInvCode = SD.SRInvCode AND
		SD.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)
	GROUP BY
		A.Name,
		AC.AccCode,
		AC.Name,
		SD.ICode
	UNION ALL
	SELECT 
		MainGroup = (SELECT A.Name FROM Area A, Customer C, Accounts AC WHERE AC.AccCode IN ((SELECT MIN(AC.AccCode) FROM Area A, Customer C, Accounts AC WHERE A.AreaCode IN (:ai_groupcode) AND C.AreaCode = A.AreaCode AND C.CustCode = AC.AccCode)) AND C.AreaCode = A.AreaCode AND C.CustCode = AC.AccCode),
		GroupCode = (SELECT MIN(AC.AccCode) FROM Area A, Customer C, Accounts AC WHERE A.AreaCode IN (:ai_groupcode) AND C.AreaCode = A.AreaCode AND C.CustCode = AC.AccCode),
		GroupName = (SELECT AC.Name FROM Area A, Customer C, Accounts AC WHERE AC.AccCode IN ((SELECT MIN(AC.AccCode) FROM Area A, Customer C, Accounts AC WHERE A.AreaCode IN (:ai_groupcode) AND C.AreaCode = A.AreaCode AND C.CustCode = AC.AccCode)) AND C.AreaCode = A.AreaCode AND C.CustCode = AC.AccCode),
		ICode = I.ICode,
		Qty = 0.0000,
		Value  = 0.0000
	FROM
		Item I
	WHERE
		:as_group = 'A' AND
		I.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)
	GROUP BY
		I.ICode
	UNION ALL	
	SELECT 
		MainGroup = NULL,
		GroupCode = A.AccCode,
		GroupName = A.Name,
		ICode = SD.ICode,
		Qty = Sum(SD.LooseQty),
		Value  = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM
		SaleLedger S, SaleDetail SD, Customer C, Accounts A
	WHERE
		:as_group = 'C' AND
		A.AccCode IN (:ai_groupcode) AND 
		A.AccCode = C.CustCode AND 
		C.CustCode = S.CustCode AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND 
		S.SaleInvCode = SD.SaleInvCode AND
		SD.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)
	GROUP BY
		A.AccCode,
		A.Name,
		SD.ICode
	UNION ALL
	SELECT 
		MainGroup = NULL,
		GroupCode = A.AccCode,
		GroupName = A.Name,
		ICode = SD.ICode,
		Qty = - Sum(SD.LooseQty),
		Value  = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM
		SRLedger S, SRDetail SD, Customer C, Accounts A
	WHERE
		:as_group = 'C' AND
		A.AccCode IN (:ai_groupcode) AND 
		A.AccCode = C.CustCode AND 
		C.CustCode = S.CustCode AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SRInvCode = SD.SRInvCode AND
		SD.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)
	GROUP BY
		A.AccCode,
		A.Name,
		SD.ICode
	UNION ALL
	SELECT 
		MainGroup = Null,
		GroupCode = (SELECT MIN(A.AccCode) FROM Accounts A WHERE A.AccCode IN (:ai_groupcode)),
		GroupName = (SELECT A.Name FROM Accounts A WHERE A.AccCode IN ((SELECT MIN(A.AccCode) FROM Accounts A WHERE A.AccCode IN (:ai_groupcode)))),
		ICode = I.ICode,
		Qty = 0.0000,
		Value  = 0.0000
	FROM
		Item I
	WHERE
		:as_group = 'C' AND 
		I.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)
	GROUP BY
		I.ICode
	UNION ALL
	SELECT 
		MainGroup = A.Name,
		GroupCode = AC.AccCode,
		GroupName = AC.Name,
		ICode = SD.ICode,
		Qty = Sum(SD.LooseQty),
		Value  = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM
		SaleLedger S, SaleDetail SD, Customer C, SubArea A, Accounts AC
	WHERE
		:as_group = 'S' AND
		A.SubAreaCode IN (:ai_groupcode) AND 
		A.SubAreaCode = C.SubAreaCode AND 
		C.CustCode = AC.AccCode AND
		C.CustCode = S.CustCode AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND 
		S.SaleInvCode = SD.SaleInvCode AND
		SD.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)
	GROUP BY
		A.Name,
		AC.AccCode,
		AC.Name,
		SD.ICode
	UNION ALL
	SELECT 
		MainGroup = A.Name,
		GroupCode = AC.AccCode,
		GroupName = AC.Name,
		ICode = SD.ICode,
		Qty = - Sum(SD.LooseQty),
		Value  = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM
		SRLedger S, SRDetail SD, Customer C, SubArea A, Accounts AC
	WHERE
		:as_group = 'S' AND
		A.SubAreaCode IN (:ai_groupcode) AND 
		A.SubAreaCode = C.SubAreaCode AND 
		C.CustCode = AC.AccCode AND
		C.CustCode = S.CustCode AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SRInvCode = SD.SRInvCode AND
		SD.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)
	GROUP BY
		A.Name,
		AC.AccCode,
		AC.Name,
		SD.ICode
	UNION ALL
	SELECT 
		MainGroup = (SELECT A.Name FROM SubArea A, Customer C, Accounts AC WHERE AC.AccCode IN ((SELECT MIN(AC.AccCode) FROM SubArea A, Customer C, Accounts AC WHERE A.SubAreaCode IN (:ai_groupcode) AND C.SubAreaCode = A.SubAreaCode AND C.CustCode = AC.AccCode)) AND C.SubAreaCode = A.SubAreaCode AND C.CustCode = AC.AccCode),
		GroupCode = (SELECT MIN(AC.AccCode) FROM SubArea A, Customer C, Accounts AC WHERE A.SubAreaCode IN (:ai_groupcode) AND C.SubAreaCode = A.SubAreaCode AND C.CustCode = AC.AccCode),
		GroupName = (SELECT AC.Name FROM SubArea A, Customer C, Accounts AC WHERE AC.AccCode IN ((SELECT MIN(AC.AccCode) FROM SubArea A, Customer C, Accounts AC WHERE A.SubAreaCode IN (:ai_groupcode) AND C.SubAreaCode = A.SubAreaCode AND C.CustCode = AC.AccCode)) AND C.SubAreaCode = A.SubAreaCode AND C.CustCode = AC.AccCode),
		ICode = I.ICode,
		Qty = 0.0000,
		Value  = 0.0000
	FROM
		Item I
	WHERE
		:as_group = 'S' AND
		I.ICode IN (:ai_icode1,:ai_icode2,:ai_icode3,:ai_icode4,:ai_icode5,:ai_icode6,:ai_icode7,:ai_icode8,:ai_icode9,:ai_icode10)
	GROUP BY
		I.ICode) S
GROUP BY
	MainGroup,
	GroupCode,
	GroupName
ORDER BY
	MainGroup,
	GroupName"
  arguments=(("as_group", string), ("ai_groupcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_icode1", number), ("ai_icode2", number), ("ai_icode3", number), ("ai_icode4", number), ("ai_icode5", number), ("ai_icode6", number), ("ai_icode7", number), ("ai_icode8", number), ("ai_icode9", number), ("ai_icode10", number))
 sort="maingroup A, groupname A"
)
