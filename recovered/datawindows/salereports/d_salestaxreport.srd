table(column=(type=char(50) updatewhereclause=yes name=ntno dbname="NTNo"  )
column=(type=char(50) updatewhereclause=yes name=strno dbname="STRNO"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(100) updatewhereclause=yes name=refno dbname="RefNo"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(7) updatewhereclause=yes name=weight dbname="Weight"  )
column=(type=decimal(9) updatewhereclause=yes name=valueextax dbname="ValueExTax"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="SalesTax"  )
column=(type=decimal(6) updatewhereclause=yes name=extratax dbname="ExtraTax"  )
 retrieve="SELECT 
	NTNo=C.NTNNo,
	STRNO=C.SalestaxRegNo,
	AliasName = A.AliasName,
	Customer = A.Name,
	RefNo = S.CustRefNo,
	Date = S.Date,
	Rate = MAX(D.GSTPerc),
	Qty = SUM(D.LooseQty + D.BonusQty),
	Weight = SUM((D.LooseQty + D.BonusQty) * I.UnitWeight),
	ValueExTax = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)),
	SalesTax = ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01), 2),
	ExtraTax = SUM((D.LooseQty + D.Bonusqty) * D.UnitSalesTax)
FROM 
	SaleLedger S, SaleDetail D, Customer C, Accounts A, Item I
WHERE
	S.Posted='Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.SaleInvcode = D.SaleInvCode AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	D.ICode = I.ICode 
GROUP BY
	C.NTNNo,
	C.SalestaxRegNo,
	A.AliasName,
	A.Name,
	S.CustRefNo,
	S.SaleInvCode,
	S.Date
UNION ALL
SELECT 
	NTNo=C.NTNNo,
	STRNO=C.SalestaxRegNo,
	AliasName = A.AliasName,
	Customer = A.Name,
	RefNo = S.CustRefNo,
	Date = S.Date,
	Rate = MAX(D.GSTPerc),
	Qty = SUM(D.LooseQty + D.BonusQty),
	Weight = SUM((D.LooseQty + D.BonusQty) * I.UnitWeight),
	ValueExTax = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)),
	SalesTax = ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01), 2),
	ExtraTax = SUM((D.LooseQty + D.Bonusqty) * D.UnitSalesTax)
FROM 
	CRS_SaleLedger S, CRS_SaleDetail D, Customer C, Accounts A, Item I
WHERE
	S.ClientInstanceID = D.ClientInstanceID AND
	S.Posted='Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.SaleInvcode = D.SaleInvCode AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	D.ICode = I.ICode 
GROUP BY
	S.ClientInstanceID,
	C.NTNNo,
	C.SalestaxRegNo,
	A.AliasName,
	A.Name,
	S.CustRefNo,
	S.SaleInvCode,
	S.Date"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="refno A"
)
