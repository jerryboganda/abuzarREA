table(column=(type=char(20) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(20) updatewhereclause=yes name=areaname dbname="areaname"  )
column=(type=char(20) updatewhereclause=yes name=customeralias dbname="customeralias"  )
column=(type=char(20) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(20) updatewhereclause=yes name=address dbname="address"  )
column=(type=number updatewhereclause=yes name=netsale dbname="netsale"  )
column=(type=number updatewhereclause=yes name=netsalevolume dbname="netsalevolume"  )
 retrieve="SELECT
	Date=CONVERT(DATETIME, (LTRIM(RTRIM(STR(MONTH(S.Date)))) + '/01/' + LTRIM(RTRIM(STR(YEAR(S.Date)))))),
	Manufacturer=M.Name,
	AreaName=AR.Name,
	CustomerAlias=A.AliasName,
	Customer=A.Name,
	Address=C.Address1,
	NetSale=ISNULL(SUM(S.NetSale), 0),
	NetSaleVolume=ISNULL(SUM(S.NetSaleVolume), 0)
FROM
	Item I,
	Manufacturer M,
	Area AR, 
	Customer C,
	Accounts A,
	(SELECT
		C.CustCode,
		Date=:ad_enddate,
		ICode=(SELECT MIN(ICODE) FROM ITEM WHERE ManfCode IN (:ai_manfcode)),
		NetSale = 0,
		NetSaleVolume = 0
	FROM Customer C
	WHERE C.AreaCode IN (:ai_areacode)
	UNION ALL
	SELECT
		S.CustCode,
		Date=S.Date,
		ICode=SD.ICode,
		NetSale = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),
		NetSaleVolume = SUM(SD.LooseQty * I.PackingFactor)
	FROM
		SaleLedger S, SaleDetail SD, Item I, Customer C
	WHERE 
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		C.AreaCode IN (:ai_areacode) AND
		C.CustCode = S.CustCode AND
		S.SaleInvCode = SD.SaleInvCode AND 
		SD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode)
	GROUP BY
		S.CustCode,
		S.SaleInvCode,
		S.Date,
		SD.ICode
	UNION ALL
	SELECT
		S.CustCode,
		Date=S.Date,
		ICode=SD.ICode,
		NetSale = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),
		NetSaleVolume = SUM(SD.LooseQty * I.PackingFactor)
	FROM
		SaleLedger S, SaleInvDetail SD, Item I, Customer C
	WHERE 
		S.ImpactInventory = 'N' AND
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		C.AreaCode IN (:ai_areacode) AND
		C.CustCode = S.CustCode AND
		S.SaleInvCode = SD.SaleInvCode AND 
		SD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode)
	GROUP BY
		S.CustCode,
		S.SaleInvCode,
		S.Date,
		SD.ICode
	UNION ALL
	SELECT
		S.CustCode,
		Date=S.Date,
		ICode=SD.ICode,
		NetSale = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),
		NetSaleVolume = - SUM(SD.LooseQty * I.PackingFactor)
	FROM
		SRLedger S, SRDetail SD, Item I, Customer C
	WHERE 
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		C.AreaCode IN (:ai_areacode) AND
		C.CustCode = S.CustCode AND
		S.SRInvCode = SD.SRInvCode AND 
		SD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode)
	GROUP BY
		S.CustCode,
		S.SRInvCode,
		S.Date,
		SD.ICode) S
WHERE
	AR.AreaCode IN (:ai_areacode) AND
	AR.AreaCode = C.AreaCode AND
	C.CustCode = A.AccCode AND
	C.CustCode = S.CustCode AND
	S.ICode = I.ICode AND
	I.ManfCode IN (:ai_manfcode) AND
	I.ManfCode = M.ManfCode
GROUP BY
	M.Name,
	AR.AreaCode,
	AR.Name,
	A.Name,
	A.AliasName,
	C.Address1,
	CONVERT(DATETIME, (LTRIM(RTRIM(STR(MONTH(S.Date)))) + '/01/' + LTRIM(RTRIM(STR(YEAR(S.Date))))))
ORDER BY
	M.Name,
	AreaName,
	Customer
"
  arguments=(("ai_manfcode", numberlist), ("ai_areacode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="manufacturer A, areaname A, customer A, address A"
)
