table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ProspectiveCustomer.pptcustcode"  )
column=(type=char(12) update=yes updatewhereclause=yes name=aliasname dbname="ProspectiveCustomer.aliasname"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="ProspectiveCustomer.name"  )
column=(type=long update=yes updatewhereclause=yes name=custcatcode dbname="ProspectiveCustomer.custcatcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=areacode dbname="ProspectiveCustomer.areacode" 
 values=""  )
column=(type=char(60) update=yes updatewhereclause=yes name=designation dbname="ProspectiveCustomer.designation"  )
column=(type=char(60) update=yes updatewhereclause=yes name=cp dbname="ProspectiveCustomer.cp"  )
column=(type=char(60) update=yes updatewhereclause=yes name=address1 dbname="ProspectiveCustomer.address1"  )
column=(type=char(60) update=yes updatewhereclause=yes name=address2 dbname="ProspectiveCustomer.address2"  )
column=(type=char(30) update=yes updatewhereclause=yes name=city dbname="ProspectiveCustomer.city"  )
column=(type=char(30) update=yes updatewhereclause=yes initial="PAKISTAN" name=country dbname="ProspectiveCustomer.country"  )
column=(type=char(30) update=yes updatewhereclause=yes name=phone dbname="ProspectiveCustomer.phone"  )
column=(type=char(20) update=yes updatewhereclause=yes name=fax dbname="ProspectiveCustomer.fax"  )
column=(type=char(30) update=yes updatewhereclause=yes name=email dbname="ProspectiveCustomer.email"  )
column=(type=char(30) update=yes updatewhereclause=yes name=licenseno dbname="ProspectiveCustomer.licenseno"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=licenseexpiry dbname="ProspectiveCustomer.licenseexpiry"  )
column=(type=char(50) update=yes updatewhereclause=yes name=salestaxregno dbname="ProspectiveCustomer.SalesTaxRegNo"  )
column=(type=long update=yes updatewhereclause=yes name=messagecode dbname="ProspectiveCustomer.MessageCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=salesmancode dbname="ProspectiveCustomer.SalesmanCode" 
 values=""  )
column=(type=char(255) update=yes updatewhereclause=yes name=specialinstructions dbname="ProspectiveCustomer.SpecialInstructions"  )
column=(type=long update=yes updatewhereclause=yes name=subareacode dbname="ProspectiveCustomer.subareacode" 
 values=""  )
 retrieve="  SELECT   pc.pptcustcode ,
			  pc.aliasname,
			  pc.name,
			  pc.custcatcode ,
           pc.areacode ,
			  pc.designation ,
           pc.cp ,
           pc.address1 ,
  			  pc.address2 ,
	        pc.city ,
           pc.country ,
           pc.phone ,
           pc.fax ,
           pc.email ,
			  pc.licenseno ,
			  pc.licenseexpiry,
			  pc.SalesTaxRegNo,
			  pc.MessageCode,
			  pc.SalesmanCode,
			  pc.SpecialInstructions,
			  pc.subareacode
        FROM  prospectivecustomer pc
        WHERE ( pc.pptcustcode = :ra_AccCode ) "
  update="prospectivecustomer" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_AccCode", number))
)
