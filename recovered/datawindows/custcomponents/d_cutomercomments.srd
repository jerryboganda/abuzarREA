table(column=(type=long key=yes identity=yes update=yes updatewhereclause=yes name=commentcode dbname="CustomerComments.CommentCode"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="CustomerComments.CustCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="CustomerComments.Date"  )
column=(type=long update=yes updatewhereclause=yes initial="10" name=priority dbname="CustomerComments.Priority"  )
column=(type=long update=yes updatewhereclause=yes name=commentedby dbname="CustomerComments.CommentedBy"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=commentedon dbname="CustomerComments.CommentedOn"  )
column=(type=char(4000) update=yes updatewhereclause=yes name=comments dbname="CustomerComments.Comments"  )
 retrieve="SELECT 
	CustomerComments.CommentCode,
	CustomerComments.CustCode,
	CustomerComments.Date,   
	CustomerComments.Priority,   
	CustomerComments.CommentedBy,
	CustomerComments.CommentedOn,
	CustomerComments.Comments
FROM 
	CustomerComments  
WHERE 
	CustomerComments.CustCode = :ai_code
ORDER BY
	CustomerComments.CommentCode DESC


"
  update="CustomerComments" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
