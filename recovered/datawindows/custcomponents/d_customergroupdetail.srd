table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="CustomerGroupDetail.CustomerGroupCode"  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="CustomerGroupDetail.RowID"  )
column=(type=char(12) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=long updatewhereclause=yes name=currlistrow dbname="CurrListRow"  )
column=(type=long updatewhereclause=yes name=subcode dbname="Accounts.SubCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=custcode dbname="CustomerGroupDetail.CustCode"  )
column=(type=long updatewhereclause=yes name=acccode dbname="Accounts.AccCode"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="Accounts.Name"  )
column=(type=datetime updatewhereclause=yes name=openingdate dbname="Accounts.OpeningDate"  )
column=(type=long updatewhereclause=yes initial="1" name=areacode dbname="Customer.AreaCode" 
 values=""  )
column=(type=long updatewhereclause=yes initial="1" name=subareacode dbname="Customer.SubAreaCode" 
 values=""  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Customer.Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Customer.Address2"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=block dbname="Customer.Block" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=charges dbname="Customer.Charges"  )
column=(type=long updatewhereclause=yes name=countycode dbname="Customer.CountyCode" 
 values=""  )
 retrieve="SELECT 
	D.CustomerGroupCode, 
	D.RowID, 
	FullCode=A.AliasName, 
	CurrListRow = 0,
	A.SubCode,
	D.CustCode,
	A.AccCode,
	A.Name,
	A.OpeningDate,
	C.AreaCode,
	C.SubAreaCode,
	C.Address1,
	C.Address2,
	C.Block,
	C.Charges,
	C.CountyCode
FROM 
	CustomerGroupDetail D, Accounts A, Customer C
WHERE
	D.CustomerGroupCode = :ai_code AND 
	D.CustCode = A.AccCode AND
	A.Acccode = C.CustCode
ORDER BY
	D.CustomerGroupCode, 
	D.RowID"
  update="CustomerGroupDetail" updatewhere=0 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
