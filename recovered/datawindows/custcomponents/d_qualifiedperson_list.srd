	QualifiedPerson.Name,   
	QualifiedPerson.QualifiedPersonCode,   
	QualifiedPerson.NIC,   
	QualifiedPerson.FName,   
	QualifiedPerson.Gender,   
	QualifiedPerson.Address,   
	QualifiedPerson.PhoneNo,   
	QualifiedPerson.Mobile,   
	QualifiedPerson.Email,   
	QualifiedPerson.UserCode,   
	QualifiedPerson.Date  
FROM 
	QualifiedPerson  
"
  update="QualifiedPerson" updatewhere=1 updatekeyinplace=no
 )
