 retrieve="SELECT 
	SubArea.SubAreaCode,   
	SubArea.Areacode,
	weekday_1 = 0,
	weekday_2 = 0,
	weekday_3 = 0,
	weekday_4 = 0,
	weekday_5 = 0,
	weekday_6 = 0,
	weekday_7 = 0
FROM 
	SubArea, Area
WHERE
	SubArea.AreaCode = Area.AreaCode
ORDER BY 
	Area.Name,
	SubArea.Name
"
 )
