 retrieve="SELECT
	LoyaltyCardID,
	LoyaltyCardCode,
	LoyaltyPolicyCode,
	AliasName=(SELECT A.AliasName FROM Accounts A WHERE A.AccCode = LoyaltyCard.AccCode),
	AccCode,
	Account=(SELECT A.Name FROM Accounts A WHERE A.AccCode = LoyaltyCard.AccCode),
	Date,
	UserCode,
	ExpiryDate
FROM
	LoyaltyCard	
"
  update="LoyaltyCard" updatewhere=1 updatekeyinplace=no
 )
