table(column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Area.Name"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="Area.AreaCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=manager dbname="Area.Manager"  )
column=(type=long updatewhereclause=yes name=regioncode dbname="Area.RegionCode"  )
column=(type=char(60) updatewhereclause=yes name=region dbname="Region"  )
column=(type=char(14) updatewhereclause=yes name=shortname dbname="Area.ShortName"  )
 retrieve="  SELECT Area.Name,
			Area.AreaCode,              
         Area.Manager,
			Area.RegionCode,
			Region=Region.Name,
			Area.ShortName
    FROM Area, Region
WHERE area.regioncode = region.regioncode
"
 )
