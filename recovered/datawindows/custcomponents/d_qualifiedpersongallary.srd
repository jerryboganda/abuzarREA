detail(height=824 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="QualifiedPersonImage.QualifiedPersonCode"  )
column=(type=char(100) updatewhereclause=yes name=qualifiedpersonname dbname="QualifiedPersonName"  )
column=(type=char(100) updatewhereclause=yes name=imagedescription dbname="QualifiedPersonImage.ImageDescription"  )
column=(type=long updatewhereclause=yes name=rowid dbname="QualifiedPersonImage.ROWID"  )
column=(type=char(100) updatewhereclause=yes name=imagetype dbname="QualifiedPersonImage.ImageType"  )
 retrieve="SELECT 
	QualifiedPersonImage.QualifiedPersonCode,
	QualifiedPersonName = QualifiedPerson.Name,
	QualifiedPersonImage.ImageDescription,
	QualifiedPersonImage.ROWID,
	QualifiedPersonImage.ImageType
FROM 
	QualifiedPersonImage, QualifiedPerson
WHERE 
	QualifiedPersonImage.QualifiedPersonCode = :ai_code AND
	QualifiedPersonImage.QualifiedPersonCode = QualifiedPerson.QualifiedPersonCode
"
  arguments=(("ai_code", number))
)
