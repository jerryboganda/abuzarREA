table(column=(type=char(60) updatewhereclause=yes name=customer_name dbname="Accounts.Name"  )
column=(type=char(12) updatewhereclause=yes name=accounts_aliasname dbname="Accounts.AliasName"  )
column=(type=long updatewhereclause=yes name=alertcode dbname="Accounts.AlertCode"  )
column=(type=long updatewhereclause=yes name=alerttypecode dbname="AlertTypeCode"  )
column=(type=char(30) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=region dbname="Region"  )
column=(type=char(60) updatewhereclause=yes name=area_name dbname="Area.Name"  )
column=(type=char(60) updatewhereclause=yes name=subarea dbname="subarea"  )
column=(type=char(60) updatewhereclause=yes name=customer_address dbname="Customer.Address1"  )
column=(type=char(60) updatewhereclause=yes name=customer_address2 dbname="Customer.Address2"  )
column=(type=char(100) updatewhereclause=yes name=customer_phone dbname="Customer.phone"  )
column=(type=char(100) updatewhereclause=yes name=customer_fax dbname="Customer.fax"  )
column=(type=long updatewhereclause=yes name=accounts_acccode dbname="Accounts.AccCode"  )
column=(type=long updatewhereclause=yes name=code dbname="Customer.CustCode"  )
column=(type=long updatewhereclause=yes name=area_areacode dbname="Area.AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=customer_city dbname="Customer.city"  )
column=(type=char(20) updatewhereclause=yes name=customer_membershipid dbname="Customer.membershipid"  )
column=(type=char(30) updatewhereclause=yes name=customer_nic dbname="Customer.nic"  )
column=(type=char(100) updatewhereclause=yes name=customer_cellno dbname="Customer.cellno"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=char(100) updatewhereclause=yes name=customersector dbname="CustomerSector"  )
 retrieve="SELECT 
	accounts.Name,   
	accounts.AliasName,
	Accounts.AlertCode,
	AlertTypeCode=(SELECT Alert.AlertTypeCode FROM Alert WHERE Alert.AlertCode = Accounts.AlertCode),
	Category = (SELECT CustomerCategory.Name FROM CustomerCategory WHERE CustomerCategory.CustCatCode = Customer.CustCatCode),
	Region = (SELECT Region.Name FROM Region WHERE Region.RegionCode = Area.RegionCode),
	Area.Name,   
	subarea = (SELECT subarea.name FROM subarea WHERE subarea.subareaCode = Customer.subareaCode),
	customer.Address1,   
	customer.Address2,   
	customer.phone,
	customer.fax,
	accounts.AccCode,   
	customer.CustCode,   
	Area.AreaCode ,
	customer.city ,
	customer.membershipid,
	customer.nic,
	customer.cellno,
	salesperson = (SELECT salesman.name FROM salesman WHERE salesman.salesmanCode = Customer.salesmancode),
	CustomerSector = (SELECT cs.name FROM CustomerSector cs WHERE cs.CustomerSectorCode = Customer.CustomerSectorCode)
FROM 
	accounts,   
	customer,   
	Area  
WHERE 
	( Area.AreaCode = customer.AreaCode ) and  
	( accounts.AccCode = customer.CustCode ) and  
	( customer.custcode = accounts.acccode )    
"
 )
