column=(type=char(255) update=yes updatewhereclause=yes name=remarks dbname="SPO.Remarks"  )
 retrieve="SELECT 
	SPO.Name,   
	SPO.SPOCode,   
	SPO.Gender,   
	SPO.FatherName,   
	SPO.HusbandName,   
	SPO.Address,   
	SPO.Address2,   
	SPO.MobileNo,   
	SPO.Phone,   
	SPO.Fax,   
	SPO.Email,   
	SPO.Remarks  
FROM SPO
ORDER BY SPO.Name"
  update="SPO" updatewhere=1 updatekeyinplace=no
 )
