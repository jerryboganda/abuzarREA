 retrieve="SELECT 
	accounts.acccode, 
	accounts.localaccountname,
	accounts.subcode , 
	accounts.name ,
	accounts.aliasname,
	accounts.openingdate ,
	accounts.alertcode,
	alerttypecode = (SELECT alert.alerttypecode FROM Alert WHERE Alert.AlertCode = Accounts.AlertCode),
	customer.custcode ,
	customer.custcatcode ,
	customer.areacode ,
	customer.designation ,
	customer.cp ,
	customer.cp2,
	customer.gender,
	customer.dob,
	customer.nic,
	customer.occupation,
	customer.eduqualf,
	customer.address1 ,
	customer.address2 ,
	customer.city ,
	customer.countycode,
	customer.country ,
	customer.phone ,
	customer.postcode,
	customer.fax ,
	customer.email ,
	customer.crlimit ,
	customer.dayslimit ,
	customer.licenceno ,
	customer.licenceexpiry,
	accounts.active ,
	customer.SalesTaxRegNo,
	Customer.DefaultGST,
	Customer.MessageCode,
	Customer.SalesmanCode,
	Customer.InvDiscperc,
	Customer.DefaultSalePrice,
	Customer.defaultItemDiscperc,
	Customer.SchedForPosting,
	Customer.SpecialInstructions,
	Customer.subareacode,
	Customer.BankName,
	Customer.BankAdd,
	Customer.AllowSaleBelowAvgPrice,
	Customer.CollectionPolicyCode,
	Customer.AssociatedQuotationCode,
	Customer.POAssociatedQuotationCode,
	Customer.SaleTypeCode,
	Customer.Refno,
	Customer.ConsiderInPO,
	Customer.MemberShipID,
	Customer.NTNNo,
	Customer.PrintWaranty,
	Customer.GCCode,
	Customer.AssociatedServiceTemplateCode,
	Customer.PrintOutstandingServiceResult,
	Customer.PrintAmtOnServiceInv,
	Customer.PrintBalance,
	Customer.Block,
	Customer.Charges,
	Customer.FullName,
	Customer.Owner,
	Customer.Address,
	Customer.IssuedLicenseNo,
	Customer.MiscChargesPerc,
	Customer.AgeInYears,
	Customer.Married,
	Customer.NoOfDependents,
	Customer.MonthlyIncome,
	Customer.CellNo,
	Customer.AddressStatus,
	Customer.StayDuration,
	Customer.OffAddress,
	Customer.OffPhone,
	Customer.JobDuration,
	Customer.PastPurOnInst,
	Customer.DescOfPastInstGoods,
	Customer.PastInstCompany,
	Customer.CriticalLimit,
	Customer.ReportDiscPerc,
	Customer.CustomerSectorCode,
	Customer.TaxCategoryCode,
	Customer.SalesTaxExemption,
	Customer.PaymentAPI,
	Customer.FName,
	Customer.SiteCode
FROM accounts, customer
WHERE ( customer.custcode = accounts.acccode ) and 
	( ( customer.custcode = :ra_AccCode ) )  "
  update="accounts" updatewhere=0 updatekeyinplace=yes
  arguments=(("ra_AccCode", number))
)
