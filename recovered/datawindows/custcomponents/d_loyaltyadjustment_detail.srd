detail(height=1092 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="LoyaltyPointAdjustment.AdjustmentCode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=adjustmenttypecode dbname="LoyaltyPointAdjustment.AdjustmentTypeCode" 
 values="Increase	1/Decrease	2/"  )
column=(type=char(100) updatewhereclause=yes name=loyaltycardid dbname="LoyaltyCardID"  )
column=(type=long update=yes updatewhereclause=yes name=loyaltycardcode dbname="LoyaltyPointAdjustment.LoyaltyCardCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=long updatewhereclause=yes name=loyaltypolicycode dbname="LoyaltyPolicyCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="LoyaltyPointAdjustment.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="LoyaltyPointAdjustment.UserCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=pointsbalance dbname="LoyaltyPointAdjustment.PointsBalance"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=adjustedpoints dbname="LoyaltyPointAdjustment.AdjustedPoints"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid value'" initial="0" name=adjustmentvalue dbname="LoyaltyPointAdjustment.AdjustmentValue"  )
column=(type=char(255) update=yes updatewhereclause=yes name=remarks dbname="LoyaltyPointAdjustment.Remarks"  )
 retrieve="SELECT
	AdjustmentCode,
	AdjustmentTypeCode,
	LoyaltyCardID = (SELECT L.LoyaltyCardID FROM LoyaltyCard L WHERE LoyaltyPointAdjustment.LoyaltyCardCode = L.LoyaltyCardCode),
	LoyaltyCardCode,
	AliasName = (SELECT A.AliasName FROM Accounts A, LoyaltyCard L WHERE LoyaltyPointAdjustment.LoyaltyCardCode = L.LoyaltyCardCode AND L.AccCode = A.AccCode),
	AccountName = (SELECT A.Name FROM Accounts A, LoyaltyCard L WHERE LoyaltyPointAdjustment.LoyaltyCardCode = L.LoyaltyCardCode AND L.AccCode = A.AccCode),
	LoyaltyPolicyCode=(SELECT L.LoyaltyPolicyCode FROM LoyaltyCard L WHERE LoyaltyPointAdjustment.LoyaltyCardCode = L.LoyaltyCardCode),
	Date,
	UserCode,
	PointsBalance,
	AdjustedPoints,
	AdjustmentValue,
	Remarks
FROM
	LoyaltyPointAdjustment
WHERE
	AdjustmentCode = :ai_code
"
  update="LoyaltyPointAdjustment" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
