table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="LoyaltyRedemption.LoyaltyRedemptionCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="LoyaltyRedemption.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="LoyaltyRedemption.UserCode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=loyaltycardid dbname="LoyaltyCardID"  )
column=(type=long update=yes updatewhereclause=yes name=loyaltycardcode dbname="LoyaltyRedemption.LoyaltyCardCode"  )
column=(type=char(12) update=yes updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) update=yes updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=long update=yes updatewhereclause=yes name=pointsbalance dbname="LoyaltyRedemption.PointsBalance"  )
column=(type=long update=yes updatewhereclause=yes name=pointsredeemed dbname="LoyaltyRedemption.PointsRedeemed"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=pointsvalue dbname="LoyaltyRedemption.PointsValue"  )
column=(type=char(255) update=yes updatewhereclause=yes name=remarks dbname="LoyaltyRedemption.Remarks"  )
 retrieve="SELECT
	LoyaltyRedemptionCode,
	Date,
	UserCode,
	LoyaltyCardID = (SELECT L.LoyaltyCardID FROM LoyaltyCard L WHERE LoyaltyRedemption.LoyaltyCardCode = L.LoyaltyCardCode),
	LoyaltyCardCode,
	AliasName = (SELECT A.AliasName FROM Accounts A, LoyaltyCard L WHERE LoyaltyRedemption.LoyaltyCardCode = L.LoyaltyCardCode AND L.AccCode = A.AccCode),
	AccountName = (SELECT A.Name FROM Accounts A, LoyaltyCard L WHERE LoyaltyRedemption.LoyaltyCardCode = L.LoyaltyCardCode AND L.AccCode = A.AccCode),
	PointsBalance,
	PointsRedeemed,
	PointsValue,
	Remarks
FROM
	LoyaltyRedemption
"
  update="LoyaltyRedemption" updatewhere=1 updatekeyinplace=no
 )
