 retrieve="SELECT
	accounts.acccode, 
	accounts.subcode , 
	accounts.name ,
	accounts.aliasname,
	accounts.openingdate ,
	customer.custcode ,
	customer.custcatcode ,
	customer.areacode ,
	customer.designation ,
	customer.cp ,
	customer.address1 ,
	customer.address2 ,
	customer.city ,
	customer.country ,
	customer.phone ,
	customer.fax ,
	customer.email ,
	customer.crlimit ,
	customer.dayslimit ,
	customer.licenceno ,
	customer.licenceexpiry,
	accounts.active ,
	customer.SalesTaxRegNo,
	Customer.DefaultGST,
	Customer.MessageCode,
	Customer.SalesmanCode,
	Customer.InvDiscperc,
	Customer.DefaultSalePrice,
	Customer.defaultItemDiscperc,
	Customer.SchedForPosting,
	Customer.SpecialInstructions,
	Customer.subareacode,
	Customer.CollectionPolicyCode,
    Customer.PrintWaranty,
	Customer.Block,
	Customer.Charges,
	Customer.CriticalLimit,
	Customer.CountyCode,
	Customer.Owner,
	Customer.CustomerSectorCode

FROM accounts ,
	customer     
WHERE
	( customer.custcode = accounts.acccode ) and 
	( customer.custcatcode in (:aa_custcatCode ) )  and
	( customer.areacode in (:aa_AreaCode ) )
"
  update="accounts" updatewhere=1 updatekeyinplace=yes
  arguments=(("aa_areacode", numberlist), ("aa_custcatcode", numberlist))
)
