 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"CustLog~" ) COLUMN(NAME=~"CustLog.CustLogID~") COLUMN(NAME=~"CustLog.CustCode~") COLUMN(NAME=~"CustLog.ColumnName~") COLUMN(NAME=~"CustLog.LastValue~") COLUMN(NAME=~"CustLog.NewValue~") COLUMN(NAME=~"CustLog.Date~") COLUMN(NAME=~"CustLog.UserCode~")WHERE(    EXP1 =~"CustLog.CustCode~"   OP =~"=~"    EXP2 =~":ai_code~" ) ) ARG(NAME = ~"ai_code~" TYPE = number) "
  update="CustLog" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
