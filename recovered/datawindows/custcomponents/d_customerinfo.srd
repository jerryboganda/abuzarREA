table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="accounts.aliasname"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="customer.address1"  )
column=(type=char(60) updatewhereclause=yes name=areaname dbname="area.name"  )
 retrieve="SELECT 
	accounts.aliasname,   
	accounts.name,   
	customer.address1,   
	area.name  
FROM
	accounts,   
	customer,   
	area  
WHERE
	( customer.custcode = :code ) AND
	( customer.custcode = accounts.acccode ) AND 
	( area.areacode = customer.areacode )    
"
  arguments=(("code", number))
)
