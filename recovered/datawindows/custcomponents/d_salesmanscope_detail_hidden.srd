table(column=(type=long key=yes update=yes updatewhereclause=yes name=salesmancode dbname="SalesManScope.SalesManCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=manfcode dbname="SalesManScope.ManfCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=subareacode dbname="SalesManScope.SubAreaCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=weekdaycode dbname="SalesManScope.WeekDayCode"  )
 retrieve="SELECT 
	SalesManScope.SalesManCode,   
	SalesManScope.ManfCode,   
	SalesManScope.SubAreaCode,   
	SalesManScope.WeekDayCode  
FROM 
	SalesManScope  
WHERE 
	( SalesManScope.SalesManCode = :ai_salesmancode ) AND  
	( SalesManScope.ManfCode = :ai_manfcode )
"
  update="SalesManScope" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_salesmancode", number), ("ai_manfcode", number))
)
