table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="CustItemCatWiseSaleDiscount.CustCatCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icatcode dbname="CustItemCatWiseSaleDiscount.ICatCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) <= 100" validationmsg="'Enter Valid Discount %age.'" initial="0" name=discperc dbname="CustItemCatWiseSaleDiscount.DiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) <= 100" validationmsg="'Enter Valid Pre-Discount %age.'" initial="0" name=prediscperc dbname="CustItemCatWiseSaleDiscount.PreDiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Enter Valid Flat Discount/Unit'" initial="0" name=itemflatdisc dbname="CustItemCatWiseSaleDiscount.ItemFlatDisc"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="CustItemCatWiseSaleDiscount.RowID"  )
 retrieve="SELECT
	CustItemCatWiseSaleDiscount.CustCatCode,   
	CustItemCatWiseSaleDiscount.ICatCode,   
	CustItemCatWiseSaleDiscount.DiscPerc, 
	CustItemCatWiseSaleDiscount.PreDiscPerc, 
	CustItemCatWiseSaleDiscount.ItemFlatDisc, 
	CustItemCatWiseSaleDiscount.RowID 

FROM 
	CustItemCatWiseSaleDiscount

WHERE 
	CustItemCatWiseSaleDiscount.CustCatCode = :ai_code
ORDER BY
	CustItemCatWiseSaleDiscount.RowID"
  update="CustItemCatWiseSaleDiscount" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
