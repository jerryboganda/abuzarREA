table(column=(type=char(115) updatewhereclause=yes name=fullname dbname="FullName"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=datetime updatewhereclause=yes name=openingdate dbname="openingdate"  )
column=(type=long updatewhereclause=yes name=alertcode dbname="AlertCode"  )
column=(type=long updatewhereclause=yes name=alerttypecode dbname="AlertTypeCode"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=char(1000) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(100) updatewhereclause=yes name=owner dbname="Owner"  )
column=(type=char(100) updatewhereclause=yes name=issuedlicenseno dbname="IssuedLicenseNo"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(60) updatewhereclause=yes name=subarea dbname="SubArea"  )
column=(type=char(60) updatewhereclause=yes name=cp dbname="CP"  )
column=(type=char(60) updatewhereclause=yes name=cp2 dbname="CP2"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender"  )
column=(type=char(30) updatewhereclause=yes name=nic dbname="NIC"  )
column=(type=char(60) updatewhereclause=yes name=occupation dbname="Occupation"  )
column=(type=char(60) updatewhereclause=yes name=eduqualf dbname="eduqualf"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="phone"  )
column=(type=char(100) updatewhereclause=yes name=fax dbname="Fax"  )
column=(type=char(60) updatewhereclause=yes name=email dbname="Email"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
column=(type=char(50) updatewhereclause=yes name=salestaxregno dbname="SalesTaxRegNo"  )
column=(type=char(50) updatewhereclause=yes name=message dbname="Message"  )
column=(type=char(30) updatewhereclause=yes name=refno dbname="RefNo"  )
column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
 retrieve="SELECT 
	FullName=Customer.FullName + ' (' + accounts.aliasname + ')',
	AliasName=accounts.aliasname,
	openingdate =accounts.openingdate ,
	AlertCode=accounts.alertcode,
	AlertTypeCode = (SELECT alert.alerttypecode FROM Alert WHERE Alert.AlertCode = Accounts.AlertCode),
	Code=customer.custcode ,
	Address=Customer.Address,
	Owner=Customer.Owner,
	IssuedLicenseNo=Customer.IssuedLicenseNo,
	CustomerCategory=(SELECT CC.Name FROM CustomerCategory CC WHERE CC.CustCatCode = customer.custcatcode),
	Area=(SELECT AR.Name FROM AREA AR WHERE AR.AreaCode = customer.areacode),
	SubArea=(SELECT S.Name FROM SubArea S WHERE S.subareacode = Customer.subareacode),
	CP=customer.cp,
	CP2=customer.cp2,
	Gender=customer.gender,
	NIC=customer.nic,
	Occupation=customer.occupation,
	eduqualf=customer.eduqualf,
	phone =customer.phone ,
	Fax=customer.fax ,
	Email=customer.email ,
	Active=accounts.active ,
	SalesTaxRegNo=customer.SalesTaxRegNo,
	Message=(SELECT M.Description FROM Message M WHERE M.MessageCode = customer.MessageCode),
	RefNo=Customer.Refno,
	NTN=Customer.NTNNo
FROM 
	Accounts, Customer
WHERE
	Accounts.AccCode=Customer.CustCode
"
 )
