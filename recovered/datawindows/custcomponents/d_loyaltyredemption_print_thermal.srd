table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="LoyaltyRedemption.LoyaltyRedemptionCode"  )
column=(type=char(100) updatewhereclause=yes name=loyaltycardid dbname="LoyaltyCardID"  )
column=(type=long update=yes updatewhereclause=yes name=loyaltycardcode dbname="LoyaltyRedemption.LoyaltyCardCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=long updatewhereclause=yes name=loyaltypolicycode dbname="LoyaltyPolicyCode"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=pointsbalance dbname="LoyaltyRedemption.PointsBalance"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="LoyaltyRedemption.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="LoyaltyRedemption.UserCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=pointsredeemed dbname="LoyaltyRedemption.PointsRedeemed"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=pointsvalue dbname="LoyaltyRedemption.PointsValue"  )
column=(type=char(255) update=yes updatewhereclause=yes name=remarks dbname="LoyaltyRedemption.Remarks"  )
 retrieve="SELECT
	LoyaltyRedemptionCode,
	LoyaltyCardID = (SELECT L.LoyaltyCardID FROM LoyaltyCard L WHERE LoyaltyRedemption.LoyaltyCardCode = L.LoyaltyCardCode),
	LoyaltyCardCode,
	AliasName = (SELECT A.AliasName FROM Accounts A, LoyaltyCard L WHERE LoyaltyRedemption.LoyaltyCardCode = L.LoyaltyCardCode AND L.AccCode = A.AccCode),
	AccountName = (SELECT A.Name FROM Accounts A, LoyaltyCard L WHERE LoyaltyRedemption.LoyaltyCardCode = L.LoyaltyCardCode AND L.AccCode = A.AccCode),
	LoyaltyPolicyCode=(SELECT L.LoyaltyPolicyCode FROM LoyaltyCard L WHERE LoyaltyRedemption.LoyaltyCardCode = L.LoyaltyCardCode),
	PointsBalance,
	Date,
	UserCode,
	PointsRedeemed,
	PointsValue,
	Remarks
FROM
	LoyaltyRedemption
WHERE
	LoyaltyRedemptionCode = :ai_code
"
  update="LoyaltyRedemption" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
