table(column=(type=long key=yes update=yes updatewhereclause=yes name=zonecode dbname="ZoneAreas.ZoneCode"  )
column=(type=char(60) updatewhereclause=yes name=manager dbname="Area.Manager"  )
column=(type=long updatewhereclause=yes name=rowid dbname="ZoneAreas.RowID"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=areacode dbname="ZoneAreas.AreaCode" 
 values=""  )
 retrieve="SELECT 
	ZoneAreas.ZoneCode,   
	Area.Manager,
	ZoneAreas.RowID,
	ZoneAreas.AreaCode
FROM 
	ZoneAreas,   
	Area  
WHERE 
	( Area.AreaCode = ZoneAreas.AreaCode ) and  
	( ( ZoneAreas.ZoneCode = :zonecode ) )    
ORDER BY
	ZoneAreas.RowID"
  update="ZoneAreas" updatewhere=1 updatekeyinplace=yes
  arguments=(("zonecode", number))
)
