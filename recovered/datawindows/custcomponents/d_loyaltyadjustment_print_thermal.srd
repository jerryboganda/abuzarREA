table(column=(type=long key=yes updatewhereclause=yes name=adjustmentcode dbname="LoyaltyPointAdjustment.AdjustmentCode"  )
column=(type=long updatewhereclause=yes name=adjustmenttypecode dbname="LoyaltyPointAdjustment.AdjustmentTypeCode"  )
column=(type=char(8) updatewhereclause=yes name=adjustmenttype dbname="AdjustmentType"  )
column=(type=long updatewhereclause=yes name=loyaltycardcode dbname="LoyaltyPointAdjustment.LoyaltyCardCode"  )
column=(type=char(100) updatewhereclause=yes name=loyaltycardid dbname="LoyaltyCardID"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=long updatewhereclause=yes name=loyaltypolicycode dbname="LoyaltyPolicyCode"  )
column=(type=long updatewhereclause=yes name=pointsbalance dbname="LoyaltyPointAdjustment.PointsBalance"  )
column=(type=datetime updatewhereclause=yes name=date dbname="LoyaltyPointAdjustment.Date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="LoyaltyPointAdjustment.UserCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=adjustedpoints dbname="LoyaltyPointAdjustment.AdjustedPoints"  )
column=(type=long updatewhereclause=yes name=adjustmentvalue dbname="LoyaltyPointAdjustment.AdjustmentValue"  )
column=(type=char(255) updatewhereclause=yes name=remarks dbname="LoyaltyPointAdjustment.Remarks"  )
 retrieve="SELECT
	AdjustmentCode,
	AdjustmentTypeCode ,
	AdjustmentType = CASE WHEN AdjustmentTypeCode = 1 THEN 'Increase' ELSE 'Decrease' END,
	LoyaltyCardCode,
	LoyaltyCardID = (SELECT L.LoyaltyCardID FROM LoyaltyCard L WHERE LoyaltyPointAdjustment.LoyaltyCardCode = L.LoyaltyCardCode),
	AliasName = (SELECT A.AliasName FROM Accounts A, LoyaltyCard L WHERE LoyaltyPointAdjustment.LoyaltyCardCode = L.LoyaltyCardCode AND L.AccCode = A.AccCode),
	AccountName = (SELECT A.Name FROM Accounts A, LoyaltyCard L WHERE LoyaltyPointAdjustment.LoyaltyCardCode = L.LoyaltyCardCode AND L.AccCode = A.AccCode),
	LoyaltyPolicyCode=(SELECT L.LoyaltyPolicyCode FROM LoyaltyCard L WHERE LoyaltyPointAdjustment.LoyaltyCardCode = L.LoyaltyCardCode),
	PointsBalance,
	Date,
	UserCode,
	AdjustedPoints,
	AdjustmentValue,
	Remarks
FROM
	LoyaltyPointAdjustment
WHERE
	AdjustmentCode = :ai_code
"
  update="LoyaltyPointAdjustment" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
