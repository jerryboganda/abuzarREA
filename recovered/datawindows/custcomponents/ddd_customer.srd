release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=customer_name dbname="Accounts.Name"  )
column=(type=long updatewhereclause=yes name=accounts_acccode dbname="Accounts.AccCode"  )
column=(type=char(12) updatewhereclause=yes name=accounts_aliasname dbname="Accounts.AliasName"  )
column=(type=char(20) updatewhereclause=yes name=membershipid dbname="Customer.MemberShipid"  )
column=(type=char(60) updatewhereclause=yes name=customer_address1 dbname="Customer.Address1"  )
column=(type=char(60) updatewhereclause=yes name=customer_city dbname="Customer.City"  )
column=(type=char(115) updatewhereclause=yes name=summaryaccount dbname="SummaryAccount"  )
 retrieve="SELECT Accounts.Name,   
         Accounts.AccCode,
			Accounts.AliasName,
			Customer.MemberShipid,
         Customer.Address1, 
			Customer.City,
			SummaryAccount = 
				CASE 
				WHEN (SELECT Count(SD.AccCode) 
						FROM SummaryAccountDetail SD 
						WHERE SD.AccCode = dbo.Accounts.AccCode) = 0 THEN NULL 
				ELSE
					(SELECT MAX(SA.Name) + ' (' + MAX(SA.AliasName) + ')' 
					FROM SummaryAccount SA, SummaryAccountDetail SD 
					WHERE SD.AccCode = dbo.Accounts.AccCode AND 
						SD.SummaryAccCode = SA.SummaryAccCode)
				END

    FROM Accounts,   
         Customer  
   WHERE ( Customer.CustCode = Accounts.AccCode )   AND
			(Accounts.Active='Y')
ORDER BY Accounts.Name ASC   
"
 )
