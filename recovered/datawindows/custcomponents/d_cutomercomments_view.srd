release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=262 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=266 color="536870912" )
table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=long key=yes identity=yes update=yes updatewhereclause=yes name=commentcode dbname="CustomerComments.CommentCode"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="CustomerComments.CustCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="CustomerComments.Date"  )
column=(type=long update=yes updatewhereclause=yes initial="10" name=priority dbname="CustomerComments.Priority"  )
column=(type=long update=yes updatewhereclause=yes name=commentedby dbname="CustomerComments.CommentedBy" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=commentedon dbname="CustomerComments.CommentedOn"  )
column=(type=char(4000) update=yes updatewhereclause=yes name=comments dbname="CustomerComments.Comments"  )
 retrieve="SELECT 
	AliasName = (SELECT Accounts.AliasName FROM Accounts WHERE Accounts.AccCode = :ai_code),
	CustomerName = (SELECT Accounts.Name FROM Accounts WHERE Accounts.AccCode = :ai_code),
	CustomerComments.CommentCode,
	CustomerComments.CustCode,
	CustomerComments.Date,   
	CustomerComments.Priority,   
	CustomerComments.CommentedBy,
	CustomerComments.CommentedOn,
	CustomerComments.Comments
FROM 
	CustomerComments  
WHERE 
	CustomerComments.CustCode = :ai_code
ORDER BY
	CustomerComments.Priority,   
	CustomerComments.Date DESC,   
	CustomerComments.CommentCode DESC"
  update="CustomerComments" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
