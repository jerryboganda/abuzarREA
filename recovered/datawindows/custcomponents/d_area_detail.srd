table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Area.AreaCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Area.Name"  )
column=(type=char(60) update=yes updatewhereclause=yes name=manager dbname="Area.Manager"  )
column=(type=long update=yes updatewhereclause=yes name=regioncode dbname="Area.RegionCode" 
 values=""  )
column=(type=char(14) update=yes updatewhereclause=yes name=shortname dbname="Area.ShortName"  )
column=(type=char(14) updatewhereclause=yes name=shortname1 dbname="shortname1"  )
column=(type=char(14) updatewhereclause=yes name=shortname2 dbname="shortname2"  )
column=(type=char(20) update=yes updatewhereclause=yes name=tag dbname="Area.Tag"  )
 retrieve="  SELECT Area.AreaCode,   
         Area.Name,
         Area.Manager,
			Area.RegionCode,
			Area.ShortName,
			shortname1=LEFT(SHORTNAME, CASE WHEN charindex(char(13), shortname) > 0 THEN charindex(char(13), shortname) - 1 ELSE 6 END),
			shortname2=CASE WHEN charindex(char(13), shortname) > 0
							THEN SUBSTRING(SHORTNAME, charindex(char(13), shortname) + 2 , Len(SHORTNAME)) 
							ELSE SPACE(6) END,
			Area.Tag
    FROM Area  
   WHERE Area.AreaCode = :ar_areacode    
"
  update="Area" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_areacode", number))
)
