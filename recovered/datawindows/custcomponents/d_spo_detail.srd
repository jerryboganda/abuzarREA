column=(type=char(100) update=yes updatewhereclause=yes name=email dbname="SPO.Email"  )
column=(type=char(255) update=yes updatewhereclause=yes name=remarks dbname="SPO.Remarks"  )
 retrieve="SELECT SPO.SPOCode,   
	SPO.Name,   
	SPO.Gender,   
	SPO.FatherName,   
	SPO.HusbandName,   
	SPO.Address,   
	SPO.Address2,   
	SPO.MobileNo,   
	SPO.Phone,   
	SPO.Fax,   
	SPO.Email,   
	SPO.Remarks  
FROM SPO  
WHERE SPO.SPOCode = :ai_code    
"
  update="SPO" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
