table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SPO.SPOCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="SPO.Name"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="M" name=gender dbname="SPO.Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fathername dbname="SPO.FatherName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=husbandname dbname="SPO.HusbandName"  )
column=(type=char(255) update=yes updatewhereclause=yes name=address dbname="SPO.Address"  )
column=(type=char(255) update=yes updatewhereclause=yes name=address2 dbname="SPO.Address2"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mobileno dbname="SPO.MobileNo"  )
