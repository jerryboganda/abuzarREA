footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(16) updatewhereclause=yes name=module dbname="Module"  )
column=(type=char(23) updatewhereclause=yes name=purpose dbname="Purpose"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=char(255) updatewhereclause=yes name=description dbname="Description"  )
column=(type=char(16) updatewhereclause=yes name=columnname dbname="ColumnName"  )
column=(type=char(100) updatewhereclause=yes name=columnvalue dbname="ColumnValue"  )
 retrieve="SELECT 
	Module='Customer', 
	Purpose='Customer', 
	Code=C.CustCode, 
	Description=A.Name, 
	ColumnName = 'NIC', 
	ColumnValue=C.NIC
FROM Customer C, Accounts A 
WHERE C.CustCode=A.AccCode AND C.NIC LIKE :as_nic
UNION ALL
SELECT 
	Module='Supplier', 
	Purpose='Supplier', 
	Code=S.SuppCode, 
	Description=A.Name, 
	ColumnName = 'CNIC', 
	ColumnValue=S.CNIC
FROM Supplier S, Accounts A
WHERE S.SuppCode=A.AccCode AND S.CNIC LIKE :as_nic
UNION ALL
SELECT 
	Module='Sales Person', 
	Purpose='Sales Person', 
	Code=S.SalesManCode, 
	Description=S.Name, 
	ColumnName = 'NICNo', 
	ColumnValue=S.NICNo
FROM SalesMan S
WHERE S.NICNo LIKE :as_nic
UNION ALL
SELECT 
	Module='Guarantee Person', 
	Purpose='Guarantee Person', 
	Code=G.GuaranteePersonCode, 
	Description=G.Name, 
	ColumnName = 'NIC', 
	ColumnValue=G.NIC
FROM GuaranteePerson G
WHERE G.NIC LIKE :as_nic
UNION ALL
SELECT 
	Module='Employee', 
	Purpose='Employee', 
	Code=E.EmpCode, 
	Description=E.FullName, 
	ColumnName = 'CNICNo', 
	ColumnValue=E.CNICNo
FROM Emp_Employee E
WHERE E.CNICNo LIKE :as_nic
UNION ALL
SELECT 
	Module='Employee', 
	Purpose='Employee Father/Husband', 
	Code=E.EmpCode, 
	Description=E.FHNAme, 
	ColumnName = 'FHNICNo', 
	ColumnValue=E.FHNICNo
FROM Emp_Employee E
WHERE E.FHNICNo LIKE :as_nic
UNION ALL
SELECT 
	Module='Employee', 
	Purpose='Employee Refferer', 
	Code=E.EmpCode, 
	Description=E.RefferedBy, 
	ColumnName = 'RefferedByCNICNO', 
	ColumnValue=E.RefferedByCNICNO
FROM Emp_Employee E
WHERE E.RefferedByCNICNO LIKE :as_nic
UNION ALL
SELECT 
	Module='Student', 
	Purpose='Student Father', 
	Code=S.StudentCode, 
	Description=S.FName, 
	ColumnName = 'FNIC', 
	ColumnValue=S.FNIC
FROM Student S
WHERE S.FNIC LIKE :as_nic
UNION ALL
SELECT 
	Module='Student', 
	Purpose='Student Mother', 
	Code=S.StudentCode, 
	Description=S.MName, 
	ColumnName = 'MNIC', 
	ColumnValue=S.MNIC
FROM Student S
WHERE S.MNIC LIKE :as_nic"
  arguments=(("as_nic", string))
)
