table(column=(type=char(20) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
column=(type=decimal(0) updatewhereclause=yes name=prediscperc dbname="prediscperc"  )
column=(type=decimal(0) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(0) updatewhereclause=yes name=discperc dbname="discperc"  )
 retrieve="SELECT CustCategory=C.NAME, ItemCategory=I.Name, PreDiscPerc=D.PreDiscPerc, DiscPerc=D.DiscPerc, ItemFlatDisc=D.ItemFlatDisc
FROM 
	(SELECT 
		CUSTCATCODE, 
		ICATCODE, 
		DISCPERC = (SELECT D.DISCPERC 
					FROM CUSTITEMCATWISESALEDISCOUNT D
					WHERE D.CUSTCATCODE = CC.CUSTCATCODE AND
							D.ICATCODE = II.ICATCODE),
		PREDISCPERC = (SELECT D.PREDISCPERC 
					FROM CUSTITEMCATWISESALEDISCOUNT D
					WHERE D.CUSTCATCODE = CC.CUSTCATCODE AND
							D.ICATCODE = II.ICATCODE),
		ITEMFLATDISC = (SELECT D.ITEMFLATDISC
					FROM CUSTITEMCATWISESALEDISCOUNT D
					WHERE D.CUSTCATCODE = CC.CUSTCATCODE AND
							D.ICATCODE = II.ICATCODE)
	FROM CUSTOMERCATEGORY CC, ITEMCATEGORY II) D,
	CUSTOMERCATEGORY C,
	ITEMCATEGORY I
WHERE C.CUSTCATCODE = D.CUSTCATCODE AND
	I.ICATCODE = D.ICATCODE
ORDER BY C.Name, I.Name"
  sort="itemcategory A"
)
