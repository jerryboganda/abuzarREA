release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=5645 color="536870912" )
summary(height=0 color="536870912" )
footer(height=1739 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=char(100) updatewhereclause=yes name=name dbname="QualifiedPerson.Name"  )
column=(type=char(100) updatewhereclause=yes name=fname dbname="QualifiedPerson.FName"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="QualifiedPerson.Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(1000) updatewhereclause=yes name=address dbname="QualifiedPerson.Address"  )
column=(type=char(100) updatewhereclause=yes name=phoneno dbname="QualifiedPerson.PhoneNo"  )
column=(type=char(100) updatewhereclause=yes name=mobile dbname="QualifiedPerson.Mobile"  )
column=(type=char(100) updatewhereclause=yes name=email dbname="QualifiedPerson.Email"  )
column=(type=char(100) updatewhereclause=yes name=nic dbname="QualifiedPerson.NIC"  )
column=(type=long updatewhereclause=yes name=usercode dbname="QualifiedPerson.UserCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=date dbname="QualifiedPerson.Date"  )
column=(type=char(100) updatewhereclause=yes name=degree dbname="QualifiedPerson.Degree"  )
column=(type=char(100) updatewhereclause=yes name=institute dbname="QualifiedPerson.Institute"  )
column=(type=char(100) updatewhereclause=yes name=passingyear dbname="QualifiedPerson.PassingYear"  )
 retrieve="SELECT 
	Code=QualifiedPersonCode,
	Name,
	FName,
	Gender,
	Address,
	PhoneNo,
	Mobile,
	Email,
	NIC,
	UserCode,
	Date,
	Degree,
	Institute,
	PassingYear
FROM
	QualifiedPerson
WHERE 
	QualifiedPersonCode = :ai_code"
  arguments=(("ai_code", number))
)
