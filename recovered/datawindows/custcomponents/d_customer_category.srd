table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="CustomerCategory.CustCatCode"  )
column=(type=char(30) update=yes updatewhereclause=yes name=name dbname="CustomerCategory.Name"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=allowincashsale dbname="CustomerCategory.AllowInCashSale" 
 values="Allow In Cash Sale:	Y/Allow In Cash Sale:	N"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=allowincreditsale dbname="CustomerCategory.AllowInCreditSale" 
 values="Allow In Credit Sale:	Y/Allow In Credit Sale:	N"  )
column=(type=long update=yes updatewhereclause=yes name=customersegmentcode dbname="CustomerCategory.CustomerSegmentCode" 
 values=""  )
 retrieve="SELECT 
	CustomerCategory.CustCatCode,   
	CustomerCategory.Name,
	CustomerCategory.AllowInCashSale,
	CustomerCategory.AllowInCreditSale,
	CustomerCategory.CustomerSegmentCode
FROM 
	CustomerCategory  
WHERE 
	CustomerCategory.CustCatCode = :ar_custcat    
"
  update="CustomerCategory" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_custcat", number))
)
