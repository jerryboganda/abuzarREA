column=(type=long updatewhereclause=yes name=customer_gccode dbname="Customer.GCCode"  )
 retrieve="SELECT 
	accounts.acccode, 
	accounts.subcode , 
	accounts.name ,
	accounts.aliasname,
	accounts.openingdate ,
	customer.custcode ,
	customer.custcatcode ,
	customer.areacode ,
	customer.designation ,
	customer.cp ,
	customer.cp2,
	customer.gender,
	customer.dob,
	customer.nic,
	customer.occupation,
	customer.eduqualf,
	customer.address1 ,
	customer.address2 ,
	customer.city ,
	customer.countycode,
	customer.country ,
	customer.phone ,
	customer.postcode,
	customer.fax ,
	customer.email ,
	customer.crlimit ,
	customer.dayslimit ,
	customer.licenceno ,
	customer.licenceexpiry,
	accounts.active ,
	customer.SalesTaxRegNo,
	Customer.DefaultGST,
	Customer.MessageCode,
	Customer.SalesmanCode,
	Customer.InvDiscperc,
	Customer.DefaultSalePrice,
	Customer.defaultItemDiscperc,
	Customer.SchedForPosting,
	Customer.SpecialInstructions,
	Customer.subareacode,
	Customer.BankName,
	Customer.BankAdd,
	Customer.AllowSaleBelowAvgPrice,
	Customer.CollectionPolicyCode,
	Customer.AssociatedQuotationCode,
	Customer.POAssociatedQuotationCode,
	Customer.SaleTypeCode,
	Customer.Refno,
	Customer.ConsiderInPO,
	Customer.MemberShipID,
	Customer.NTNNo,
	Customer.PrintWaranty,
	Customer.GCCode
	
FROM accounts, customer
WHERE ( customer.custcode = accounts.acccode ) and 
	( ( customer.custcode = :ra_AccCode ) )  "
  update="accounts" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_AccCode", number))
)
