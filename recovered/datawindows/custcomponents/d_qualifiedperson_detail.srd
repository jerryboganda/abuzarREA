table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="QualifiedPerson.QualifiedPersonCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="QualifiedPerson.Name"  )
column=(type=char(100) update=yes updatewhereclause=yes name=nic dbname="QualifiedPerson.NIC"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fname dbname="QualifiedPerson.FName"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="M" name=gender dbname="QualifiedPerson.Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=address dbname="QualifiedPerson.Address"  )
column=(type=char(100) update=yes updatewhereclause=yes name=phoneno dbname="QualifiedPerson.PhoneNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mobile dbname="QualifiedPerson.Mobile"  )
column=(type=char(100) update=yes updatewhereclause=yes name=email dbname="QualifiedPerson.Email"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="QualifiedPerson.UserCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="QualifiedPerson.Date"  )
column=(type=char(100) update=yes updatewhereclause=yes name=degree dbname="QualifiedPerson.Degree"  )
column=(type=char(100) update=yes updatewhereclause=yes name=institute dbname="QualifiedPerson.Institute"  )
column=(type=char(100) update=yes updatewhereclause=yes name=passingyear dbname="QualifiedPerson.PassingYear"  )
 retrieve="SELECT 
	QualifiedPerson.QualifiedPersonCode,   
	QualifiedPerson.Name,   
	QualifiedPerson.NIC,   
	QualifiedPerson.FName,   
	QualifiedPerson.Gender,   
	QualifiedPerson.Address,   
	QualifiedPerson.PhoneNo,   
	QualifiedPerson.Mobile,   
	QualifiedPerson.Email,   
	QualifiedPerson.UserCode,   
	QualifiedPerson.Date ,
	Degree,
	Institute,
	PassingYear
FROM 
	QualifiedPerson  
WHERE 
	QualifiedPerson.QualifiedPersonCode = :ai_code
"
  update="QualifiedPerson" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
