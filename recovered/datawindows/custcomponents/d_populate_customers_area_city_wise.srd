summary(height=0 color="536870912" )
footer(height=72 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=icode dbname="CustCode"  )
column=(type=char(12) updatewhereclause=yes name=fullcode dbname="Aliasname"  )
column=(type=char(75) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=long update=yes updatewhereclause=yes name=transportroutecode dbname="TransportRouteCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=char(75) update=yes updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=charges dbname="Charges"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discperc dbname="DiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=serviceflatdisc dbname="ServiceFlatDisc"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=qty dbname="Qty"  )
 retrieve="SELECT
	CustCode=Customer.CustCode,
	Aliasname = Accounts.AliasName,
	itemname = Accounts.Name + ' (' + Accounts.AliasName + ')' ,
	CurrListRow = 0,
	TransportRouteCode=NULL,
	RowID=NULL,
	Remarks=Accounts.Name + ' (' + Accounts.AliasName + ')' ,
	Charges=Customer.Charges,
	DiscPerc=0.00,
	ServiceFlatDisc=0.00,
	Qty=1
FROM 
	Customer, Accounts, Area, County
WHERE 
	Customer.CustCode = Accounts.AccCode AND
	Accounts.Active = 'Y' AND
	Customer.AreaCode IN (:ai_areacode) AND
	Customer.CountyCode IN (:ai_countycode) AND
	Customer.AreaCode = Area.AreaCode AND
	Customer.CountyCode = County.CountyCode 
ORDER BY 
	itemname
"
  arguments=(("ai_areacode", numberlist), ("ai_countycode", numberlist))
)
