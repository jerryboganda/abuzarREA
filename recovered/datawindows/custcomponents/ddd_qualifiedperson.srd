column=(type=long update=yes updatewhereclause=yes name=usercode dbname="QualifiedPerson.UserCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="QualifiedPerson.Date"  )
 retrieve="SELECT 
	QualifiedPerson= QualifiedPerson.Name + ' (' + LTRIM(RTRIM(STR(QualifiedPerson.QualifiedPersonCode, 10)))+ ')',
	QualifiedPerson.Name,   
	QualifiedPerson.QualifiedPersonCode,   
	QualifiedPerson.NIC,   
	QualifiedPerson.FName,   
	QualifiedPerson.Gender,   
	QualifiedPerson.Address,   
	QualifiedPerson.PhoneNo,   
	QualifiedPerson.Mobile,   
	QualifiedPerson.Email,   
	QualifiedPerson.UserCode,   
	QualifiedPerson.Date  
FROM 
	QualifiedPerson  
"
  update="QualifiedPerson" updatewhere=1 updatekeyinplace=no
 )
