table(column=(type=long updatewhereclause=yes name=code dbname="ProspectiveCustomer.PptCustCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="ProspectiveCustomer.AliasName"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="ProspectiveCustomer.Name"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area.Name"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="ProspectiveCustomer.Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="ProspectiveCustomer.Address2"  )
column=(type=char(30) updatewhereclause=yes name=city dbname="ProspectiveCustomer.city"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="ProspectiveCustomer.phone"  )
column=(type=char(20) updatewhereclause=yes name=fax dbname="ProspectiveCustomer.fax"  )
 retrieve="  SELECT pc.PptCustCode,   
			pc.AliasName,   
			pc.Name,   
			Area.Name,   
         pc.Address1,   
         pc.Address2,   
			pc.city,
			pc.phone,
			pc.fax

    FROM prospectivecustomer pc,   
         Area  

   WHERE ( Area.AreaCode = pc.AreaCode ) 
"
 )
