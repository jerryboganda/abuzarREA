table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SalesMan.salesmancode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="SalesMan.name"  )
column=(type=char(100) update=yes updatewhereclause=yes name=address dbname="SalesMan.address"  )
column=(type=char(20) update=yes updatewhereclause=yes name=phone dbname="SalesMan.phone"  )
column=(type=char(100) update=yes updatewhereclause=yes name=nicno dbname="SalesMan.nicno"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=active dbname="SalesMan.active" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid outstanding amount'" initial="0" name=outstandinglimit dbname="SalesMan.OutstandingLimit"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=saleperson dbname="SalesMan.SalePerson" 
 values="Sales Person	Y/Sales Person	N"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=deliveryperson dbname="SalesMan.DeliveryPerson" 
 values="Delivery//Inquiry Person	Y/Delivery//Inquiry Person	N"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=recoveryperson dbname="SalesMan.RecoveryPerson" 
 values="Recovery Person	Y/Recovery Person	N"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid sale target amount'" initial="0" name=saletarget dbname="SalesMan.SaleTarget"  )
 retrieve="SELECT  
	salesman.salesmancode ,
	salesman.name ,
	salesman.address,
	salesman.phone,
	salesman.nicno,
	salesman.active,
	SalesMan.OutstandingLimit,
	SalePerson,
	DeliveryPerson,
	RecoveryPerson,
	SaleTarget
FROM 
	salesman      
WHERE 
	( salesman.salesmancode = :ra_salesmancode )   "
  update="salesman" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_salesmancode", number))
)
