table(column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="purinvcode"  )
column=(type=char(12) updatewhereclause=yes name=supplieralias dbname="supplieralias"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="supplier"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(6) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=decimal(2) updatewhereclause=yes name=ratediff dbname="RateDiff"  )
 retrieve=" Select 	
		date = PL.date, 
       	purinvcode = PL.purinvcode,
			supplieralias = accounts.aliasname, 
			supplier   = accounts.name, 
			icode      = item.icode, 
			aliasname  = item.customicode,
			itemname   = item.name,
			batch      = PD.batch,
			expiry     = PD.Expiry,
			qty        = (PD.Looseqty + PD.PackQty + PD.bonusqty),
			NetRate    = Round ( (PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
								     (1 - PD.DiscPerc * .01) * ( 1 - PL.discperc * .01 ) 
									+ 
						 	     (PD.unitsalestax * ( PD.Looseqty + PD.PackQty + PD.bonusqty )) +  
							     Round( PD.PurPrice * (PD.LooseQty + PD.PackQty) * (1 - PD.DiscPerc * .01) * 0.01 * PD.gstperc, 2) +
							 	  ( Round(( Round( Round(PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
										 	(1 - PD.DiscPerc * .01),2) * 
											(1 -  PL.discperc * 0.01),2) - PL.flatdisc) * 0.01 *  
					 			  PL.invgstperc1 ,2)) ) /
						     (PD.Looseqty + PD.PackQty + PD.bonusqty) , 2 ),
			RateDiff   = 0.00
From    	Purledger PL, Purdetail PD, Item, Accounts, Supplier
Where 	PL.Date Between :ad_startdate And :ad_enddate And
			PL.Posted     = 'Y' And
			PL.PurCatCode In (:al_purcategory) And
			PL.Suppcode   = Accounts.AccCode And
			Accounts.AccCode     = Supplier.SuppCode And
			PL.Purinvcode = PD.Purinvcode And
			PD.icode In ( :al_icode ) And 
			PD.icode = Item.icode 
"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("al_icode", numberlist), ("al_purcategory", numberlist))
 sort="itemname A, date A, purinvcode A, batch A, expiry A"
)
