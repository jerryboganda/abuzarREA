detail(height=191 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(4) updatewhereclause=yes name=openqty dbname="OpenQty"  )
column=(type=decimal(6) updatewhereclause=yes name=openvalue dbname="OpenValue"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalue dbname="PurValue"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(4) updatewhereclause=yes name=otherqty dbname="OtherQty"  )
column=(type=decimal(6) updatewhereclause=yes name=othervalue dbname="OtherValue"  )
column=(type=decimal(4) updatewhereclause=yes name=closingqty dbname="ClosingQty"  )
column=(type=decimal(6) updatewhereclause=yes name=closingvalue dbname="ClosingValue"  )
 retrieve="SELECT 
	Manufacturer=(SELECT M.Name FROM Manufacturer M WHERE M.ManfCode=TS.ManfCode),
	Date = TS.Date,
	OpenQty = SUM(TS.OpQty),
	OpenValue= SUM(TS.OpValue),
	PurQty = SUM(TS.PurQty),
	PurValue = SUM(TS.PurValue),
	SaleQty = SUM(TS.SaleQty),
	SaleValue = SUM(TS.SaleValue),
	OtherQty = SUM(TS.OtherQty),
	OtherValue = SUM(TS.OtherValue),
	ClosingQty = SUM(TS.OpQty + TS.PurQty - TS.SaleQty + TS.OtherQty),
	ClosingValue = SUM(TS.OpValue + TS.Cost)
FROM
	(SELECT 
		Date=T.Date,
		T.ManfCode,
		OpQty = ISNULL((SELECT
				Qty = SUM((D.PackQty + D.LooseQty + D.BonusQty) * CASE WHEN P.PurCatCode <= 2 THEN D.PackUnits ELSE 1 END)
			FROM
				PurLedger P, PurDetail D, Item I, Manufacturer M
			WHERE
				P.Posted = 'Y' AND
				P.Date < T.Date AND
				P.PurInvCode=D.PurInvCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT
				Qty = - SUM(D.PackQty + D.LooseQty + D.BonusQty)
			FROM
				PrLedger P, PrDetail D, Item I, Manufacturer M
			WHERE
				P.Date < T.Date AND
				P.PrInvCode=D.PrInvCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT
				Qty = - SUM(D.PackQty + D.LooseQty + D.BonusQty)
			FROM
				SaleLedger S, SaleDetail D, Item I, Manufacturer M
			WHERE
				S.Date < T.Date AND 
				S.SaleInvCode=D.SaleInvCode AND
				D.Due IS NULL AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT Qty = SUM(D.PackQty + D.LooseQty + D.BonusQty)
			FROM
				SRLedger S, SRDetail D, Item I, Manufacturer M
			WHERE
				S.Posted = 'Y' AND
				S.Date < T.Date AND 
				S.SRInvCode=D.SRInvCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT Qty = SUM(D.Qty)
			FROM
				ReceiptHeader S, ReceiptDetail D, Item I, Manufacturer M
			WHERE
				S.Posted = 'Y' AND
				S.Date < T.Date AND 
				S.ReceiptInvCode=D.ReceiptInvCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT Qty = - SUM(D.Qty)
			FROM
				IssueHeader S, IssueDetail D, Item I, Manufacturer M
			WHERE
				S.Date < T.Date AND 
				S.IssueInvCode=D.IssueInvCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT Qty = - SUM(D.DueSatisfyQty)
			FROM
				DueSatisfyHeader S, DueSatisfyDetail D, Item I, Manufacturer M
			WHERE
				S.DueSatisfyDate < T.Date AND 
				S.DueSatisfyCode=D.DueSatisfyCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT
				Qty = SUM(CASE S.AdjCatCode WHEN 1 THEN D.LooseQty ELSE -(D.LooseQty) END)
			FROM
				AdjHeader S, AdjDetail D, Item I, Manufacturer M
			WHERE
				S.Posted = 'Y' AND
				S.Date < T.Date AND
				S.AdjCode=D.AdjCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode),0),
		OpValue = ISNULL((SELECT
				Value = SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.PurPrice * (1 - D.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01)) 
			FROM
				PurLedger P, PurDetail D, Item I, Manufacturer M
			WHERE
				P.Posted = 'Y' AND
				P.Date < T.Date AND
				P.PurInvCode=D.PurInvCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT
				Value = - SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.PRPrice * (1 - D.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01)) 
			FROM
				PrLedger P, PrDetail D, Item I, Manufacturer M
			WHERE
				P.Date < T.Date AND
				P.PrInvCode=D.PrInvCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT
				Value = - SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.AvgPrice)
			FROM
				SaleLedger S, SaleDetail D, Item I, Manufacturer M
			WHERE
				S.Date < T.Date AND 
				S.SaleInvCode=D.SaleInvCode AND
				D.Due IS NULL AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT Value = SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.AvgPrice)
			FROM
				SRLedger S, SRDetail D, Item I, Manufacturer M
			WHERE
				S.Posted = 'Y' AND
				S.Date < T.Date AND 
				S.SRInvCode=D.SRInvCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT Value = SUM(D.Qty * D.AvgPrice)
			FROM
				ReceiptHeader S, ReceiptDetail D, Item I, Manufacturer M
			WHERE
				S.Posted = 'Y' AND
				S.Date < T.Date AND 
				S.ReceiptInvCode=D.ReceiptInvCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT Value = - SUM(D.Qty * D.AvgPrice)
			FROM
				IssueHeader S, IssueDetail D, Item I, Manufacturer M
			WHERE
				S.Date < T.Date AND 
				S.IssueInvCode=D.IssueInvCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT Value = - SUM(D.DueSatisfyQty * D.AvgPrice)
			FROM
				DueSatisfyHeader S, DueSatisfyDetail D, Item I, Manufacturer M
			WHERE
				S.DueSatisfyDate < T.Date AND 
				S.DueSatisfyCode=D.DueSatisfyCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode), 0) +
			ISNULL((SELECT
				Value = SUM(CASE S.AdjCatCode WHEN 1 THEN D.LooseQty ELSE -(D.LooseQty) END * D.AvgPrice)
			FROM
				AdjHeader S, AdjDetail D, Item I, Manufacturer M
			WHERE
				S.Posted = 'Y' AND
				S.Date < T.Date AND
				S.AdjCode=D.AdjCode AND
				D.ICode=I.ICode AND
				I.ManfCode = M.ManfCode AND
				M.ManfCode = T.ManfCode),0),
		PurQty = SUM(CASE T.Type WHEN 'PU' THEN T.Qty WHEN 'PR' THEN -(T.Qty) ELSE 0 END),
		PurValue = SUM(CASE T.Type WHEN 'PU' THEN Value WHEN 'PR' THEN -(T.Value) ELSE 0 END),
		SaleQty = SUM(CASE T.Type WHEN 'SA' THEN T.Qty WHEN 'SR' THEN -(T.Qty) ELSE 0 END),
		SaleValue = SUM(CASE T.Type WHEN 'SA' THEN T.Value WHEN 'SR' THEN -(T.Value) ELSE 0 END),
		OtherQty = SUM(CASE WHEN T.Type = 'PU' OR T.Type = 'PR' OR T.Type = 'SA' OR T.Type = 'SR' THEN 0 ELSE T.Qty END),
		OtherValue = SUM(CASE WHEN T.Type = 'PU' OR T.Type = 'PR' OR T.Type = 'SA' OR T.Type = 'SR' THEN 0 ELSE T.Value END),
		Cost = SUM(T.Cost)
	FROM
		(SELECT
			Type = 'PU',
			M.ManfCode,
			Date=CAST(LTRIM(RTRIM(STR(DATEPART(yy, P.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, P.Date)))) + '/01' AS DATETIME),
			Qty = SUM((D.PackQty + D.LooseQty + D.BonusQty) * CASE WHEN P.PurCatCode <= 2 THEN D.PackUnits ELSE 1 END),
			Value = SUM( (D.PackQty + D.LooseQty) * D.PurPrice * (1 - D.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01) ),
			Cost = SUM( (D.PackQty + D.LooseQty) * D.PurPrice * (1 - D.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01) )
		FROM
			PurLedger P, PurDetail D, Item I, Manufacturer M
		WHERE
			P.Posted='Y' AND
			P.Date BETWEEN :adt_startdate AND :adt_enddate AND
			P.PurInvCode=D.PurInvCode AND
			D.ICode=I.ICode AND
			I.ManfCode = M.ManfCode AND
			M.ManfCode IN (:ai_manfcode)
		GROUP BY M.ManfCode, CAST(LTRIM(RTRIM(STR(DATEPART(yy, P.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, P.Date)))) + '/01' AS DATETIME)
		UNION ALL
		SELECT
			Type = 'PR',
			M.ManfCode,
			Date=CAST(LTRIM(RTRIM(STR(DATEPART(yy, P.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, P.Date)))) + '/01' AS DATETIME),
			Qty = SUM(D.PackQty + D.LooseQty + D.BonusQty),
			Value = SUM( D.LooseQty * D.PrPrice * (1 - D.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01)),
			Cost = - SUM( D.LooseQty * D.PrPrice * (1 - D.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01))
		FROM
			PrLedger P, PrDetail D, Item I, Manufacturer M
		WHERE
			P.Date BETWEEN :adt_startdate AND :adt_enddate AND
			P.PrInvCode=D.PrInvCode AND
			D.ICode=I.ICode AND
			I.ManfCode = M.ManfCode AND
			M.ManfCode IN (:ai_manfcode)
		GROUP BY M.ManfCode, CAST(LTRIM(RTRIM(STR(DATEPART(yy, P.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, P.Date)))) + '/01' AS DATETIME)
		UNION ALL
		SELECT
			Type = 'SA',
			M.ManfCode,
			Date=CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME),
			Qty = SUM(D.PackQty + D.LooseQty + D.BonusQty),
			Value = SUM( (D.PackQty + D.LooseQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) ),
			Cost = - SUM( (D.PackQty + D.LooseQty + D.BonusQty) * D.AvgPrice ) 
		FROM
			SaleLedger S, SaleDetail D, Item I, Manufacturer M
		WHERE
			S.Date BETWEEN :adt_startdate AND :adt_enddate AND
			S.SaleInvCode=D.SaleInvCode AND
			D.ICode=I.ICode AND
			I.ManfCode = M.ManfCode AND
			M.ManfCode IN (:ai_manfcode)
		GROUP BY M.ManfCode, CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME)
		UNION ALL
		SELECT
			Type = 'SR',
			M.ManfCode,
			Date=CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME),
			Qty = SUM(D.PackQty + D.LooseQty + D.BonusQty),
			Value = SUM( (D.PackQty + D.LooseQty) * D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) ),
			Cost = SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.Avgprice)
		FROM
			SRLedger S, SRDetail D, Item I, Manufacturer M
		WHERE
			S.Posted='Y' AND
			S.Date BETWEEN :adt_startdate AND :adt_enddate AND
			S.SRInvCode=D.SRInvCode AND
			D.ICode=I.ICode AND
			I.ManfCode = M.ManfCode AND
			M.ManfCode IN (:ai_manfcode)
		GROUP BY M.ManfCode, CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME)
		UNION ALL
		SELECT
			Type = 'RC',
			M.ManfCode,
			Date=CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME),
			Qty = SUM(D.Qty),
			Value = SUM( D.Qty * D.AvgPrice ),
			Cost = SUM( D.Qty * D.AvgPrice )
		FROM
			ReceiptHeader S, ReceiptDetail D, Item I, Manufacturer M
		WHERE
			S.Posted='Y' AND
			S.Date BETWEEN :adt_startdate AND :adt_enddate AND
			S.ReceiptInvCode=D.ReceiptInvCode AND
			D.ICode=I.ICode AND
			I.ManfCode = M.ManfCode AND
			M.ManfCode IN (:ai_manfcode)
		GROUP BY M.ManfCode, CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME)
		UNION ALL
		SELECT
			Type = 'IS',
			M.ManfCode,
			Date=CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME),
			Qty = -SUM(D.Qty),
			Value = -SUM( D.Qty * D.AvgPrice ),
			Cost = - SUM( D.Qty * D.AvgPrice )
		FROM
			IssueHeader S, IssueDetail D, Item I, Manufacturer M
		WHERE
			S.Date BETWEEN :adt_startdate AND :adt_enddate AND
			S.IssueInvCode=D.IssueInvCode AND
			D.ICode=I.ICode AND
			I.ManfCode = M.ManfCode AND
			M.ManfCode IN (:ai_manfcode)
		GROUP BY M.ManfCode, CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME)
		UNION ALL
		SELECT
			Type = 'AD',
			M.ManfCode,
			Date=CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.DueSatisfyDate)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.DueSatisfyDate)))) + '/01' AS DATETIME),
			Qty = -SUM(D.DueSatisfyQty),
			Value = -SUM( D.DueSatisfyQty * D.AvgPrice ),
			Cost = - SUM( D.DueSatisfyQty * D.AvgPrice )
		FROM
			DueSatisfyHeader S, DueSatisfyDetail D, Item I, Manufacturer M
		WHERE
			S.DueSatisfyDate BETWEEN :adt_startdate AND :adt_enddate AND
			S.DueSatisfyCode=D.DueSatisfyCode AND
			D.ICode=I.ICode AND
			I.ManfCode = M.ManfCode AND
			M.ManfCode IN (:ai_manfcode)
		GROUP BY M.ManfCode, CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.DueSatisfyDate)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.DueSatisfyDate)))) + '/01' AS DATETIME)
		UNION ALL
		SELECT
			Type = 'AD',
			M.ManfCode,
			Date=CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME),
			Qty = SUM(CASE S.AdjCatCode WHEN 1 THEN D.LooseQty ELSE -(D.LooseQty) END),
			Value = SUM(CASE S.AdjCatCode WHEN 1 THEN D.LooseQty ELSE -(D.LooseQty) END * D.AvgPrice ),
			Cost = SUM( CASE S.AdjCatCode WHEN 1 THEN D.LooseQty ELSE -(D.LooseQty) END *  D.AvgPrice )
		FROM
			AdjHeader S, AdjDetail D, Item I, Manufacturer M
		WHERE
			S.Posted='Y' AND
			S.Date BETWEEN :adt_startdate AND :adt_enddate AND
			S.AdjCode=D.AdjCode AND
			D.ICode=I.ICode AND
			I.ManfCode = M.ManfCode AND
			M.ManfCode IN (:ai_manfcode)
		GROUP BY M.ManfCode, CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME)) AS T
	GROUP BY T.ManfCode, T.Date) AS TS
GROUP BY TS.ManfCode, TS.Date
"
  arguments=(("ai_manfcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="manufacturer A, date A"
)
group(level=1 header.height=208 trailer.height=200 by=("manufacturer"  ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.length="100" header.gradient.repetition.count="0" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.length="100" trailer.gradient.repetition.count="0" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" )
