column=(type=decimal(10) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=long updatewhereclause=yes name=purordercatcode dbname="PurOrderHeader.PurOrderCatCode"  )
column=(type=decimal(4) updatewhereclause=yes name=purprice dbname="PurPrice"  )
column=(type=decimal(4) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(4) updatewhereclause=yes name=rpp dbname="RPP"  )
column=(type=decimal(4) updatewhereclause=yes name=avgprice dbname="AvgPrice"  )
 retrieve="SELECT 
	GroupCode = 
		CASE :as_reportgrouping
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END,   
	GroupName= 
		CASE :as_reportgrouping
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,   
	I.name,
	itemalias=I.customicode,
	OH.POCode,  
	OH.Date,
	Acc.name,
	S.address1,
	S.address2,
	S.city,
	S.phone,
	S.fax,
	OH.remarks,
	OH.purorderterms1,
	OH.purorderterms2,
	OH.purorderterms3,
	OH.purorderterms4,
	OH.purorderterms5,
	OH.purorderterms6,
	OH.purorderterms7,
	OH.purorderterms8,
	OH.Discperc,
	I.packingdesc,
	OD.rate,
	OD.qty,
	OD.bonusqty,
	OD.discperc,
	OD.reorderqty,
	OD.OptimumQty,
	OD.Stock,
	OD.SoldQty,
	OD.ReturnQty,
	NetSaleQty= OD.SoldQty - OD.ReturnQty,
	amount= (OD.qty * OD.rate) * ( 1 - (OD.discperc * 0.01) ) ,
	OH.PurOrderCatCode,
	PurPrice=OD.PurPrice,
	SalePrice=OD.SalePrice,
	RPP=OD.RPP,
	AvgPrice=OD.PackAvgPrice
FROM 
	item I, 
	accounts Acc, 
	purorderheader OH, 
	purorderdetail OD , 
	Supplier S
WHERE 
	OH.pocode >= :ai_sPOCode AND
	OH.pocode <= :ai_lPOCode AND
	OH.pocode=OD.pocode AND
	OH.suppCode = S.SuppCode AND
	OH.suppcode=Acc.acccode AND
	OD.icode=I.icode
ORDER BY
	oh.pocode, groupname, groupcode, i.name"
  arguments=(("ai_sPOCode", number), ("ai_lPOCode", number), ("as_reportgrouping", string))
)
