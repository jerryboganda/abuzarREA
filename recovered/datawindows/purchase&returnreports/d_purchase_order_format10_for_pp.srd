release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(30) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=char(100) updatewhereclause=yes name=purtypename dbname="purtypename"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=itemcatname dbname="itemcatname"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=decimal(4) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=long updatewhereclause=yes name=purorderheader_pocode dbname="PurOrderHeader.POCode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.Date"  )
column=(type=long updatewhereclause=yes name=purorderdetail_icode dbname="PurOrderDetail.ICode"  )
column=(type=decimal(4) updatewhereclause=yes name=purorderdetail_qty dbname="PurOrderDetail.Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="reorderqty"  )
column=(type=decimal(4) updatewhereclause=yes name=netqty dbname="netqty"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=long identity=yes updatewhereclause=yes name=purorderdetail_porowid dbname="PurOrderDetail.PORowID"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=datetime updatewhereclause=yes name=startdate dbname="startdate"  )
column=(type=datetime updatewhereclause=yes name=enddate dbname="enddate"  )
column=(type=long updatewhereclause=yes name=projectiondays dbname="projectiondays"  )
column=(type=long updatewhereclause=yes name=purordercatcode dbname="purordercatcode"  )
 retrieve="  SELECT customername='abcdefghijklmnopqrstuvwxyzabcd'  ,   
			purtypename=(select name from purchasetype where purchasetype.purtypecode=PurOrderHeader.purtypecode),
			itemname= item.name,  
		itemcatname=(select name from itemcategory where itemcategory.icatcode=PurOrderHeader.icatcode),
		itemalias=item.customicode,
		saleprice=purorderdetail.saleprice,
		stock=purorderdetail.stock,
         PurOrderHeader.POCode,   
		remarks=PurOrderHeader.remarks,
         PurOrderHeader.Date,   
         PurOrderDetail.ICode,   
         PurOrderDetail.Qty,  
		bonusqty=PurOrderdetail.bonusqty,
		rate=purorderdetail.rate,
		reorderqty=purorderdetail.reorderqty,
		netqty= PurOrderdetail.bonusqty + PurOrderDetail.Qty,
         Accounts.Name,
			PurOrderDetail.PORowID,
			Manufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),
			startdate=PurOrderHeader.startdate,
			enddate=PurOrderHeader.enddate,
			projectiondays=PurOrderheader.Projectionperiod,
			purordercatcode=PurOrderHeader.purordercatcode
    FROM PurOrderDetail,    
         PurOrderHeader,   
         Accounts, 
         item 
   WHERE ( PurOrderHeader.POCode >= :ra_SPOCode )   AND
			PurOrderHeader.POCode <= :ra_EPOCode  AND
			( PurOrderHeader.POCode = PurOrderDetail.POCode ) and  
			( PurOrderDetail.icode = item.icode ) and  
         ( PurOrderHeader.SuppCode = Accounts.AccCode ) 
      	
ORDER BY

 PurOrderHeader.POCode,
 PurOrderDetail.PORowID
"
  arguments=(("ra_SPOCode", number), ("ra_EPOCode", number))
)
