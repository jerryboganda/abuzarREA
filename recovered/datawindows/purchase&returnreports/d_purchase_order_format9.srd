column=(type=char(30) updatewhereclause=yes name=phone dbname="Supplier.phone"  )
column=(type=char(16) updatewhereclause=yes name=fax dbname="Supplier.fax"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="PurOrderHeader.remarks"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms1 dbname="PurOrderHeader.purorderterms1"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms2 dbname="PurOrderHeader.purorderterms2"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms3 dbname="PurOrderHeader.purorderterms3"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms4 dbname="PurOrderHeader.purorderterms4"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms5 dbname="PurOrderHeader.purorderterms5"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms6 dbname="PurOrderHeader.purorderterms6"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms7 dbname="PurOrderHeader.purorderterms7"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms8 dbname="PurOrderHeader.purorderterms8"  )
column=(type=decimal(2) updatewhereclause=yes name=purorderheader_discperc dbname="PurOrderHeader.Discperc"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="Item.packingdesc"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="PurOrderDetail.rate"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="PurOrderDetail.qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="PurOrderDetail.bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="PurOrderDetail.discperc"  )
column=(type=decimal(10) updatewhereclause=yes name=amount dbname="amount"  )
 retrieve="SELECT  
		 aliasname=i.customicode,
		 I.name,
		 OH.POCode,
	    OH.Date,
       Acc.name,
		 S.address1,  
		 S.address2,
		 S.city,
		 S.phone,
		 S.fax,
		 OH.remarks,
		 OH.purorderterms1,
		 OH.purorderterms2,
		 OH.purorderterms3,
		 OH.purorderterms4,
		 OH.purorderterms5,
		 OH.purorderterms6,
		 OH.purorderterms7,
		 OH.purorderterms8,
		 OH.Discperc,
		 I.packingdesc,
       OD.rate,
       OD.qty,
		 OD.bonusqty,
		 OD.discperc,
       amount= (OD.qty * OD.rate) * ( 1 - (OD.discperc * 0.01) ) 


FROM item I, accounts Acc, purorderheader OH, purorderdetail OD , Supplier S

WHERE OH.pocode >= :ai_sPOCode AND
		OH.pocode <= :ai_lPOCode AND
      OH.pocode=OD.pocode AND
		OH.suppCode = S.SuppCode AND
      OH.suppcode=Acc.acccode AND
      OD.icode=I.icode

order by oh.pocode, i.name"
  arguments=(("ai_sPOCode", number), ("ai_lPOCode", number))
)
