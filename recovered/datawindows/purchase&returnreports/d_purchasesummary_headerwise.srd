table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=purledger_date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(7) updatewhereclause=yes name=invtype dbname="invtype"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Accounts.name"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(11) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsalestax dbname="itemsalestax"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(100) updatewhereclause=yes name=purchasetype dbname="Purchasetype"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="postdate"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=datetime updatewhereclause=yes name=suppinvdate dbname="suppinvdate"  )
column=(type=char(100) updatewhereclause=yes name=suppinvcode dbname="suppinvcode"  )
column=(type=char(100) updatewhereclause=yes name=grn dbname="grn"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=char(100) updatewhereclause=yes name=lcno dbname="lcno"  )
column=(type=char(100) updatewhereclause=yes name=puroderno dbname="puroderno"  )
 retrieve="SELECT
	invcode = dbo.purledger.purinvcode,    
	date = dbo.purledger.date,  
	flatdisc = dbo.purledger.flatdisc , 
	salestax= dbo.purledger.salestax ,       
	misccharges = dbo.purledger.misccharges , 
	invdiscperc = dbo.purledger.discperc , 
	invgstperc1 = dbo.purledger.invgstperc1 , 
	invtype = Case dbo.purledger.purcatcode 	When 1 Then 'Cash' 	When 2 Then 'Credit' When 7 Then 'Loose' When 8 Then 'Loose' Else 'Opening' End,  
	dbo.accounts.name, 
	amount =  Sum ((dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice),    
	itemdiscpercvalue = Sum ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (dbo.purdetail.discperc / 100)),    
	invdiscpercvalue = Sum ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (1 - dbo.purdetail.discperc / 100)) * (dbo.purledger.discperc / 100)    ,
	itemsalestax = Sum (Round ( (dbo.purdetail.looseqty + dbo.purdetail.packqty + dbo.purdetail.bonusqty) * dbo.purdetail.unitsalestax + Round ( Round ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (1 - dbo.purdetail.discperc * 0.01 ), 2 ) * dbo.purdetail.gstperc * 0.01 , 2 ) , 2 ) ) ,
	posted= dbo.purledger.posted,
	Purchasetype=dbo.purchasetype.name,
	postdate=purledger.postdate,
	headerno=max(purledger.headerno),
	suppinvdate=max(purledger.suppinvdate),
	suppinvcode=max(purledger.suppinvcode),
	grn=max(purledger.grn),
	username=max(users.username),
	lcno=max(purledger.lcno),
	puroderno=max(purledger.newpurchaseorderno)
FROM 
	dbo.purledger
	LEFT OUTER JOIN dbo.PurchaseType ON (dbo.purledger.purtypecode = dbo.purchasetype.purtypecode),
	dbo.purdetail,   
	dbo.accounts ,
	users 

WHERE 
	(dbo.purledger.headerno 	= :ar_headerno) and
	( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and  
	( dbo.purledger.suppcode = dbo.accounts.acccode )and  
	( dbo.purledger.salesmancode=users.usercode)and
	( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY
	dbo.accounts.name,   
	dbo.purledger.misccharges,   
	dbo.purledger.flatdisc,   
	dbo.purledger.date,
	dbo.purledger.postdate,   
	dbo.purledger.purinvcode, 
	dbo.purchasetype.name,  
	dbo.purledger.discperc,  
	dbo.purledger.invgstperc1,
	dbo.purledger.salestax,
	dbo.purledger.purcatcode,
	dbo.purledger.posted      
ORDER BY 
	dbo.purledger.purinvcode ASC,   
	dbo.purledger.date ASC   

"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ar_headerno", number))
)
