release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1708 color="536870912" )
summary(height=260 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes name=pocode dbname="PurOrderHeader.POCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.date"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="supplier"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="PurOrderDetail.rate"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="PurOrderDetail.qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="PurOrderDetail.bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="PurOrderDetail.discperc"  )
column=(type=decimal(10) updatewhereclause=yes name=amount dbname="amount"  )
 retrieve="SELECT I.name,
		 OH.POCode, 
		 OH.date,
		 customer = ( Select Name From Accounts , Customer Where Accounts.AccCode = OH.CustCode And Accounts.AccCode = Customer.CustCode ),
		 Address1 = ( Select Address1 From Customer Where CustCode = OH.CustCode),
		 City = ( Select City From Customer Where CustCode = OH.CustCode),
		 supplier = Acc.Name, 
		 manufacturer = m.name,
       OD.rate,
       OD.qty,
		 OD.bonusqty,
		 OD.discperc,
       amount= (OD.qty * OD.rate) * ( 1 - (od.discperc * 0.01) ) 

FROM item I, accounts Acc, purorderheader OH, purorderdetail OD, Supplier S, Manufacturer M

WHERE OH.PoCode In (:al_pocode) AND
			OH.pocode = OD.pocode AND
      		OH.suppcode = Acc.acccode AND
			OH.suppcode = S.Suppcode AND
      		OD.icode = I.icode AND
			I.manfcode = M.manfcode

"
  arguments=(("al_pocode", numberlist))
 sort="pocode A, itemname A"
)
