table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=decimal(4) updatewhereclause=yes name=purchaseqty dbname="PurchaseQty"  )
column=(type=decimal(6) updatewhereclause=yes name=purchasevalue dbname="PurchaseValue"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
 retrieve="SELECT 
	AliasName = dbo.accounts.aliasname,
	SupplierName = dbo.accounts.name,
	PurchaseQty = SUM( CASE WHEN dbo.purledger.purcatcode <=2 THEN ((dbo.purdetail.packqty + dbo.purdetail.bonusqty) * dbo.purdetail.PackUnits) ELSE (dbo.purdetail.looseqty + dbo.purdetail.bonusqty) END),
	PurchaseValue = SUM( (dbo.purdetail.looseqty + dbo.purdetail.packqty) * dbo.purdetail.purprice * (1 - dbo.purdetail.discperc * 0.01) * (1 - dbo.purledger.discperc * 0.01)),
	SaleValue=	SUM( CASE WHEN dbo.purledger.purcatcode <=2 THEN ((dbo.purdetail.packqty + dbo.purdetail.bonusqty) * dbo.purdetail.PackUnits) ELSE (dbo.purdetail.looseqty + dbo.purdetail.bonusqty) END * (purdetail.saleprice / case WHEN purdetail.packunits > 0 THEN purdetail.packunits ELSE 1 END))
FROM
	dbo.purledger, 
	dbo.purdetail,    
	dbo.accounts
WHERE
	dbo.purledger.date >= :ad_StartDate and
	dbo.purledger.date <= :ad_EndDate  and
	dbo.purledger.purcatcode IN (1, 2, 3, 7, 8) and
	dbo.purledger.suppcode IN (:aa_suppcode) and
	dbo.purledger.suppcode = dbo.accounts.acccode and
	dbo.purledger.purinvcode = dbo.purdetail.purinvcode
GROUP BY
	dbo.accounts.aliasname,
	dbo.accounts.name
ORDER BY
	SupplierName"
  arguments=(("aa_suppcode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime))
 sort="suppliername A"
)
