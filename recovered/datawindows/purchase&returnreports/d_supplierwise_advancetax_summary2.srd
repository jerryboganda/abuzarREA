table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=char(100) updatewhereclause=yes name=taxcategory dbname="TaxCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxperc dbname="AdvanceTaxPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxamt dbname="AdvanceTaxAmt"  )
 retrieve="SELECT 
	AliasName = A.AliasName,
	SupplierName=A.Name,
	NetAmount=SUM(ISNULL(P.InvTotal, 0)),
	TaxCategory = TC.Name,
	AdvanceTaxPerc = MAX(TC.TaxPerc),
	AdvanceTaxAmt = SUM(P.AdvanceTaxAmt)
FROM
	PurLedger P, Accounts A, Supplier S, TaxCategory TC
WHERE
	P.Posted = 'Y' AND
	P.Date BETWEEN :adt_startdate AND :adt_enddate AND
	P.SuppCode IN (:ai_suppcode) AND
	P.SuppCode = S.SuppCode AND
	P.TaxCategoryCode = TC.TaxCategoryCode AND
	S.SuppCode = A.AccCode 
GROUP BY 
	TC.Name,
	A.AliasName,
	A.Name
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_suppcode", numberlist))
 sort="suppliername A"
)
