table(column=(type=long updatewhereclause=yes name=pocode dbname="POCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(12) updatewhereclause=yes name=supplieraliasname dbname="SupplierAliasName"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="ItemAliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=decimal(4) updatewhereclause=yes name=poqty dbname="POQty"  )
column=(type=decimal(4) updatewhereclause=yes name=pobonus dbname="POBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(4) updatewhereclause=yes name=purbonus dbname="PurBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=netqty dbname="NetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=netbonus dbname="NetBonus"  )
 retrieve="SELECT
	POCode = Q.POCode,
	Date = Q.Date, 
	Remarks = Q.Remarks,
	SuppCode=Q.SuppCode,
	SupplierAliasName=A.AliasName,
	SupplierName=A.Name,
	ICode = I.ICode,
	ItemAliasName=I.CustomICode,
	ItemName=I.Name,
	Manufacturer=M.Name,
	POQty = ISNULL(SUM(Q.POQty), 0),
	POBonus = ISNULL(SUM(Q.POBonus), 0),
	PurQty = ISNULL(SUM(Q.PurQty), 0),
	PurBonus = ISNULL(SUM(Q.PurBonus), 0),
	NetQty = ISNULL(SUM(Q.POQty - Q.PurQty), 0),
	NetBonus = ISNULL(SUM(Q.POBonus - Q.PurBonus), 0)
FROM
	Item I,
	Manufacturer M,
	Accounts A,
	(SELECT 
		POCode = POH.POCode,
		Date = POH.Date,
		Remarks = POH.Remarks,
		SuppCode=POH.SuppCode,
		ICode = POD.ICode,
		POQty = ISNULL(SUM(POD.Qty), 0),
		POBonus = ISNULL(SUM(POD.BonusQty), 0),
		PurQty = ISNULL((SELECT SUM(PD.PackQty + PD.LooseQty) 
			FROM PurDetail PD, PurLedger PL 
			WHERE PL.POCode = POH.POCode AND
				PL.PurInvCode = PD.PurInvCode AND
				PD.ICode = POD.ICode), 0),
		PurBonus = ISNULL((SELECT SUM(PD.BonusQty) 
			FROM PurDetail PD, PurLedger PL 
			WHERE PL.POCode = POH.POCode AND
				PL.PurInvCode = PD.PurInvCode AND
				PD.ICode = POD.ICode), 0)
	FROM
		PurOrderDetail POD,
		PurOrderHeader POH
	WHERE
		POH.POCode IN (:ai_POcode) AND
		POH.POCode = POD.POCode
	GROUP BY
		POH.POCode,
		POH.Date,
		POH.Remarks,
		POH.SuppCode,
		POD.ICode
	UNION ALL
	SELECT 
		POCode = POH.POCode,
		Date = POH.Date,
		Remarks = POH.Remarks,
		SuppCode = POH.SuppCode,
		ICode = PD.ICode,
		POQty = 0.0000,
		POBonus = 0.0000,
		PurQty = ISNULL(SUM(PD.PackQty + PD.LooseQty), 0),
		PurBonus = ISNULL(SUM(PD.BonusQty), 0)
	FROM
		PurDetail PD,
		PurLedger PL, 
		PurOrderHeader POH
	WHERE
		POH.POCode IN (:ai_POcode) AND
		POH.POCode = PL.POCode AND
		PL.PurInvCode = PD.PurInvCode AND
		PD.ICode NOT IN (SELECT POD.ICode FROM PurOrderDetail POD WHERE POD.POCode = POH.POCode)
	GROUP BY
		POH.POCode,
		POH.Date,
		POH.Remarks,
		POH.SuppCode,
		PD.ICode) Q
WHERE
	(Q.POQty - Q.PurQty <> 0 OR Q.POBonus - Q.PurBonus <> 0) AND
	Q.ICode = I.ICode AND
	Q.SuppCode = A.AccCode AND
	I.ManfCode = M.ManfCode
GROUP BY
	Q.POCode,
	Q.Date,
	Q.Remarks,
	Q.SuppCode,
	A.AliasName,
	A.Name,
	Q.ICode,
	I.ICode,
	I.CustomICode,
	I.Name,
	M.Name
ORDER BY
	SupplierName,
	Q.POCode,
	I.Name
"
  arguments=(("ai_pocode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="suppliername A, pocode A, itemname A"
)
