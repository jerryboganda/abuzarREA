table(column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="purinvcode"  )
column=(type=char(12) updatewhereclause=yes name=supplieralias dbname="supplieralias"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="supplier"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=purcatcode dbname="Purledger.PurCatCode"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type"  )
column=(type=char(100) updatewhereclause=yes name=grn dbname="GRN"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(6) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=decimal(6) updatewhereclause=yes name=prevnetrate dbname="PrevNetRate"  )
 retrieve=" SELECT
	date = PL.date,
	purinvcode = PL.purinvcode,
	supplieralias = accounts.aliasname,
	supplier   = accounts.name,
	aliasname  = item.customicode,
	itemname   = item.name, 
	PL.PurCatCode,
	Type = CASE WHEN PL.PurCatCode > 2 THEN 'L' ELSE 'P' END,
	GRN    = PL.GRN,
	qty        = SUM(PD.Looseqty + PD.PackQty + PD.bonusqty),
	NetRate    = SUM(ISNULL(Round ( (PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
							  (1 - PD.DiscPerc * .01) * ( 1 - PL.discperc * .01 ) 
							+ 
						  (PD.unitsalestax * ( PD.Looseqty + PD.PackQty + PD.bonusqty )) +  
						  Round( PD.PurPrice * (PD.LooseQty + PD.PackQty) * (1 - PD.DiscPerc * .01) * 0.01 * PD.gstperc, 2) +
						  ( Round(( Round( Round(PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
									(1 - PD.DiscPerc * .01),2) * 
									(1 -  PL.discperc * 0.01),2) - PL.flatdisc) * 0.01 *  
						  PL.invgstperc1 ,2)) ) /
					  (PD.Looseqty + PD.PackQty + PD.bonusqty) , 2 ), 0)),
	PrevNetRate=
		ISNULL((SELECT MIN(Round ( (D.PurPrice * (D.LooseQty + D.PackQty) * 
											  (1 - D.DiscPerc * .01) * ( 1 - P.discperc * .01 ) + 
										  (D.unitsalestax * ( D.Looseqty + D.PackQty + D.bonusqty )) + 
										  Round( D.PurPrice * (D.LooseQty + D.PackQty) * (1 - D.DiscPerc * .01) * 0.01 * D.gstperc, 2) +
										  ( Round(( Round( Round(D.PurPrice * (D.LooseQty + D.PackQty) * 
													(1 - D.DiscPerc * .01),2) * 
													(1 -  P.discperc * 0.01),2) - P.flatdisc) * 0.01 *  
										  P.invgstperc1 ,2)) ) /
									  (D.Looseqty + D.PackQty + D.bonusqty) , 2 ))
		FROM Purledger P, Purdetail D
		WHERE 
			P.Date >= DATEADD(day, - (:al_projectiondays), :ad_startdate) And 
			P.Date < :ad_startdate And
			P.Posted     = 'Y' And
			P.Purinvcode = D.Purinvcode And
			P.PurCatCode = PL.PurCatCode AND
			D.ICODE = PD.ICODE), 0)
FROM
	Purledger PL, 
	Purdetail PD, 
	Item, 
	Accounts, 
	Supplier

WHERE
	PL.Date Between :ad_startdate And :ad_enddate And
	PL.Posted = 'Y' And
	PL.Suppcode = Accounts.AccCode And
	Accounts.AccCode = Supplier.SuppCode And
	PL.Purinvcode = PD.Purinvcode And
	PD.icode = Item.icode 
GROUP BY
	pd.icode,
	pd.batch,
	pd.expiry,
	item.customicode,
	item.name,
	PL.purinvcode,
	accounts.aliasname,
	accounts.name,
	PL.date,
	PL.PurCatCode,
	PL.GRN
ORDER BY ItemName, Date, PurInvCode"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("al_projectiondays", number))
 sort="itemname A, date A, purinvcode A"
)
