table(column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalue dbname="PurValue"  )
column=(type=decimal(4) updatewhereclause=yes name=retqty dbname="RetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=retbonus dbname="RetBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=retvalue dbname="RetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=netqty dbname="NetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=netbonus dbname="NetBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=netvalue dbname="NetValue"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
 retrieve="SELECT
	ItemCode=S.ItemCode, 
	AliasName=I.CustomICode, 
	Item=I.Name, 
	Qty=SUM(S.Qty),
	Bonus=SUM(S.Bonus),
	PurValue = ROUND(SUM(S.PurValue), 2),
	RetQty=SUM(S.RetQty),
	RetBonus=SUM(S.RetBonus),
	RetValue = ROUND(SUM(S.RetValue), 2),
	NetQty = SUM(S.Qty - S.RetQty),
	NetBonus = SUM(S.Bonus - S.RetBonus),
	NetValue = ROUND(SUM(S.PurValue), 2) - ROUND(SUM(S.RetValue), 2),
	Packing=I.PackingDesc
FROM 
	Item I,
	(SELECT
		ItemCode=SD.ICode, 
		Qty=SUM(SD.looseqty + SD.packqty * SD.packunits),
		Bonus=SUM(isnull(case SL.purcatcode 
			when 1 THEN SD.bonusqty * SD.packunits
			when 2 THEN SD.bonusqty * SD.packunits
			else SD.bonusqty
			end, 0)),
		PurValue = SUM(isnull(case SL.purcatcode 
			when 1 THEN (SD.packqty + SD.bonusqty)
			when 2 THEN (SD.packqty + SD.bonusqty)
			else SD.looseqty + SD.bonusqty 
			end, 0) * SD.purprice * (1 - SD.discperc * 0.01) * (1 - SL.discperc * 0.01)),
		RetQty=0,
		RetBonus=0,
		RetValue = 0.00
	FROM
		PurLedger SL, PurDetail SD
	WHERE
		:al_allitems = 0 AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.PurInvCode = SD.PurInvCode AND
		SL.SuppCode IN (:ai_suppcode) AND
		SD.ICode IN (:ar_ICode)
	GROUP BY
		SD.ICode
	UNION ALL
	SELECT
		ItemCode=SD.ICode, 
		Qty=SUM(SD.looseqty + SD.packqty * SD.packunits),
		Bonus=SUM(isnull(case SL.purcatcode 
			when 1 THEN SD.bonusqty * SD.packunits
			when 2 THEN SD.bonusqty * SD.packunits
			else SD.bonusqty
			end, 0)),
		PurValue = SUM(isnull(case SL.purcatcode 
			when 1 THEN (SD.packqty + SD.bonusqty)
			when 2 THEN (SD.packqty + SD.bonusqty)
			else SD.looseqty + SD.bonusqty 
			end, 0) * SD.purprice * (1 - SD.discperc * 0.01) * (1 - SL.discperc * 0.01)),
		RetQty=0,
		RetBonus=0,
		RetValue = 0.00
	FROM
		PurLedger SL, PurDetail SD
	WHERE
		:al_allitems = 1 AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.PurInvCode = SD.PurInvCode AND
		SL.SuppCode IN (:ai_suppcode)
	GROUP BY
		SD.ICode
	UNION ALL
	SELECT
		ItemCode=SD.ICode, 
		Qty=0,
		Bonus=0,
		PurValue = 0.00,
		RetQty=SUM(SD.looseqty + SD.packqty * SD.packunits),
		RetBonus=SUM(SD.bonusqty),
		RetValue = SUM(SD.looseqty * SD.prprice * (1 - SD.discperc * 0.01) * (1 - SL.discperc * 0.01))
	FROM
		PRLedger SL, PRDetail SD
	WHERE
		:al_allitems = 0 AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.PRInvCode = SD.PRInvCode AND
		SL.SuppCode IN (:ai_suppcode) AND
		SD.ICode IN (:ar_ICode)
	GROUP BY
		SD.ICode
	UNION ALL
	SELECT
		ItemCode=SD.ICode, 
		Qty=0,
		Bonus=0,
		PurValue = 0.00,
		RetQty=SUM(SD.looseqty + SD.packqty * SD.packunits),
		RetBonus=SUM(SD.bonusqty),
		RetValue = SUM(SD.looseqty * SD.prprice * (1 - SD.discperc * 0.01) * (1 - SL.discperc * 0.01))
	FROM
		PRLedger SL, PRDetail SD
	WHERE
		:al_allitems = 1 AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.PRInvCode = SD.PRInvCode AND
		SL.SuppCode IN (:ai_suppcode)
	GROUP BY
		SD.ICode) AS S
WHERE
	I.ICode = S.ItemCode
GROUP BY
	S.ItemCode,
	I.Name, 
	I.CustomICode,
	I.PackingDesc
ORDER BY
	Item, 
	AliasName"
  arguments=(("al_allitems", number), ("ar_icode", numberlist), ("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ai_suppcode", numberlist))
)
