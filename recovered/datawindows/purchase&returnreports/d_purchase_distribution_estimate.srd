release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1156 color="536870912" )
header[2](height=354 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(20) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=number updatewhereclause=yes name=purqty dbname="purqty"  )
column=(type=number updatewhereclause=yes name=quotedqty dbname="quotedqty"  )
 retrieve="SELECT
	PD.ICode, AliasName=I.CustomICode, ItemName=I.Name, 
	PurQty=PD.LooseQty + PD.PackQty + PD.BonusQty, 
	QuotedQty=QD.Qty, 
	CutAlias=(SELECT A.AliasName FROM Accounts A WHERE A.AccCode=QH.CustCode) + ' ' + LTRIM(RTRIM(STR(QH.QuotationCode)))
FROM 
	PurDetail PD, PurLedger P, Item I,
	PurOrderDetail POD, PurOrderHeader POH, 
	SaleOrderDetail SOD, 
	QuotationDetail QD, QuotationHeader QH
WHERE 
	P.PurInvCode=:ai_code AND 
	P.PurInvCode = PD.PurInvCode AND 
	PD.ICode=I.ICode AND
	P.POCode = POH.POCode AND 
	POH.POCode = POD.POCode AND
	PD.ICode = POD.ICode AND 
	POH.SaleOrderCode = SOD.SaleOrderCode AND
	SOD.ICode=POD.ICode AND SOD.QuotationRowID = QD.RowID AND
	QD.QuotationCode=QH.QuotationCode
UNION ALL
SELECT
	PD.ICode, AliasName=I.CustomICode, ItemName=I.Name, 
	PurQty=PD.LooseQty + PD.PackQty + PD.BonusQty, 
	QuotedQty=0.00, 
	CutAlias=NULL
FROM 
	PurDetail PD, PurLedger P, Item I
WHERE 
	P.PurInvCode=:ai_code AND 
	P.PurInvCode = PD.PurInvCode AND 
	PD.ICode=I.ICode AND
	I.ICode NOT IN 
		(SELECT
			DISTINCT PD.ICode
		FROM 
			PurDetail PD, PurLedger P, Item I,
			PurOrderDetail POD, PurOrderHeader POH, 
			SaleOrderDetail SOD, 
			QuotationDetail QD, QuotationHeader QH
		WHERE 
			P.PurInvCode=:ai_code AND 
			P.PurInvCode = PD.PurInvCode AND 
			PD.ICode=I.ICode AND
			P.POCode = POH.POCode AND 
			POH.POCode = POD.POCode AND
			PD.ICode = POD.ICode AND 
			POH.SaleOrderCode = SOD.SaleOrderCode AND
			SOD.ICode=POD.ICode AND SOD.QuotationRowID = QD.RowID AND
			QD.QuotationCode=QH.QuotationCode)
ORDER BY ItemName
"
  arguments=(("ai_code", number))
 sort="aliasname A, itemname A, purqty A"
)
group(level=1 header.height=0 trailer.height=0 by=("aliasname"  ) header.color="536870912" trailer.color="536870912" )
