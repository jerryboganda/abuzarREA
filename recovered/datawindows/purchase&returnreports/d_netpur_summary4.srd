table(column=(type=char(13) updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="Salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(2) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsalestax dbname="itemsalestax"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="Salesman"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
 retrieve="SELECT 
	documentcode = 'PV-' + LTRIM(RTRIM(STR(H.PURINVCODE, 10))), 
	invcode     = H.PurInvCode, 
	date        = H.date, 
	flatdisc    = H.flatdisc,
	Salestax    = H.Salestax, 
	misccharges = H.misccharges, 
	invdiscperc = H.discperc,
	invgstperc1 = H.invgstperc1 ,
	doctype = CASE WHEN PurCatCode < 3 THEN 'PP' WHEN PurCatCode = 3 THEN 'OP' ELSE 'LP' END, 
	SupplierName = A.name, 
	amount =  Round(Sum ( (D.looseqty + D.Packqty) * D.Purprice), 2),    
	itemdiscpercvalue = Round(Sum ((D.looseqty + D.Packqty) * D.Purprice * D.discperc * 0.01), 2),
	invdiscpercvalue = Sum (Round( (D.looseqty + D.Packqty) * D.Purprice * (1 - (D.discperc * 0.01)),2)) * (H.discperc * 0.01),
	itemsalestax = Sum (Round ((D.looseqty + D.Packqty) * D.unitSalestax + Round ( Round ((D.looseqty + D.Packqty) * D.Purprice * (1 - D.discperc * 0.01 ), 2 ) * D.gstperc * 0.01 , 2 ) , 2 ) ),
	Salesman = U.username,
	Discount = Round(Sum (( (D.looseqty + D.Packqty)  * D.Purprice * (D.discperc * .01))), 2)+
		Sum (Round( (D.looseqty + D.Packqty) * D.Purprice * (1 - (D.discperc * .01)),2)) * (H.discperc * 0.01) + 
		H.flatdisc,
	A.AliasName,
	headerno=max(H.headerno)
	
FROM 
	dbo.PurLedger H, 
	dbo.Purdetail D,   
	dbo.accounts A,
	dbo.users U 
WHERE 
	( H.PurInvCode = D.PurInvCode ) and  
	( H.SuppCode = A.acccode ) and  
	( H.Salesmancode = U.usercode ) and  
	( H.date between :ar_StartDate and :ar_EndDate)
	
GROUP BY 
	H.PurInvCode,   
	H.date,   
	H.misccharges,   
	H.flatdisc,   
	H.discperc,  
	H.Salestax, 
	H.invgstperc1,
	H.Purcatcode, 
	A.name,
	A.AliasName,
	U.username 
	
UNION ALL
	
SELECT 
	documentcode = 'PR-' + LTRIM(RTRIM(STR(H.PRINVCODE, 10))), 
	invcode     = H.PRInvCode,    
	date        = H.date,    
	flatdisc    = H.flatdisc, 
	Salestax    = H.Salestax,       
	misccharges = H.misccharges, 
	invdiscperc = H.discperc, 
	invgstperc1 = H.invgstperc1,
	doctype = 'PR', 
	SupplierName = A.name, 
	amount =  Round(Sum ( (D.looseqty + D.Packqty) * D.PRPrice), 2),    
	itemdiscpercvalue = Round(Sum ( (D.looseqty + D.Packqty)  * D.PRPrice * (D.discperc * .01)), 2),    
	invdiscpercvalue = Round(Sum ( ((D.looseqty + D.Packqty)  ) * D.PRPrice * (1 - (D.discperc * .01))) * (H.discperc /100), 2)     ,
	itemSalestax = Sum (Round ((D.looseqty + D.Packqty) * D.unitSalestax + Round ( Round ( (D.looseqty + D.Packqty) * D.PRPrice * (1 - D.discperc * 0.01 ), 2 ) * D.gstperc * 0.01 , 2 ) , 2 ) ),
	Salesman = U.username,
	Discount = Round(Sum ( (D.looseqty + D.Packqty)  * D.PRPrice * D.discperc * .01), 2) +
		Sum (Round( (D.looseqty + D.Packqty)   * D.PRPrice * (1 - (D.discperc * .01)), 2)) * (H.discperc * 0.01) + 
		H.flatdisc,
	A.AliasName,
	headerno=max(H.headerno)
	
FROM 
	dbo.PrLedger H, 
	dbo.PrDetail D,   
	dbo.Accounts A ,
	dbo.Users U
	
WHERE 
	( H.PRInvCode = D.PRInvCode ) and  
	( H.SuppCode = A.acccode ) and 
	( H.Salesmancode = U.usercode ) and  
	( H.date between :ar_StartDate and :ar_EndDate)
	
GROUP BY 
	H.PRInvCode,   
	H.date,   
	H.misccharges,   
	H.flatdisc,   
	H.discperc,  
	H.Salestax, 
	H.invgstperc1,
	H.PRCatCode, 
	A.name ,
	A.AliasName,
	U.username     
	
ORDER BY		
	H.date, H.PurInvCode ASC"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime))
 sort="date A, invcode A"
)
