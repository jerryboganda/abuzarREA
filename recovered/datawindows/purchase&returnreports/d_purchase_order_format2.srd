column=(type=char(60) updatewhereclause=yes name=custcity dbname="custcity"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="Item.packingdesc"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="PurOrderDetail.rate"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="PurOrderDetail.qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="PurOrderDetail.bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="PurOrderDetail.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=decimal(2) updatewhereclause=yes name=invflatdisc dbname="invflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(10) updatewhereclause=yes name=amount dbname="amount"  )
 retrieve="SELECT I.name,
		 itemalias=I.customicode,
		 OH.POCode, 
	    OH.Date,
       Acc.name,
		 S.address1,
		 S.address2,  
		 S.city,
		 S.phone,
		 S.fax,
		 S.specialinstructions,
		 OH.remarks,
		 OH.purorderterms1,
		 OH.purorderterms2,
		 OH.purorderterms3,
		 OH.purorderterms4,
		 OH.purorderterms5,
		 OH.purorderterms6,
		 OH.purorderterms7,
		 OH.purorderterms8,
		 OH.demanddraftno,
		 invdiscperc=OH.discperc,
		 OH.dated,
		 orderamount = OH.amount ,
		 customer = ( Select name From Accounts Where ACCcode = OH.custcode ) , 
		 custaddress1 = ( Select address1 From Customer Where Custcode = OH.custcode ) , 
		 custcity = ( Select city From Customer Where custcode = OH.custcode ) , 
		 I.packingdesc,
       OD.rate,
       OD.qty,
		 OD.bonusqty,
		 OD.discperc,
		invgstperc1=OH.invgstperc1,
		invflatdisc=OH.flatdisc,
		misccharges=OH.misccharges,
       amount= (OD.qty * OD.rate) * ( 1 - (od.discperc * 0.01) ) 


FROM item I, accounts Acc, purorderheader OH, purorderdetail OD , Supplier S 

WHERE OH.pocode >= :ai_sPOCode AND
		OH.pocode <= :ai_lPOCode AND
      OH.pocode = OD.pocode AND
		OH.suppCode = S.SuppCode AND
      OH.suppcode = Acc.acccode AND
      OD.icode = I.icode

order by oh.pocode, i.name"
  arguments=(("ai_sPOCode", number), ("ai_lPOCode", number))
)
