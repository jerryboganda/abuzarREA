release 12.5;
datawindow ( units=0 timer_interval=0 processing=3 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=long updatewhereclause=yes name=day dbname="day"  )
column=(type=decimal(6) updatewhereclause=yes name=daytotal dbname="daytotal"  )
column=(type=char(12) updatewhereclause=yes name=invtype dbname="invtype"  )
 retrieve="SELECT  day=datepart(dd,A.date),
		  daytotal=sum(A.netamount),
        A.invtype

FROM

(SELECT invcode = dbo.purledger.purinvcode,    
         date = dbo.purledger.date,    
         flatdisc = dbo.purledger.flatdisc, 
			salestax= dbo.purledger.salestax,       
         misccharges = dbo.purledger.misccharges, 
			invdiscperc = dbo.purledger.discperc, 
			invtype = Case dbo.purledger.purcatcode 	When 1 Then 'Cash' 	When 2 Then 'Credit' When 7 Then 'Loose Cash' When 8 Then 'Loose Credit' Else 'Opening' End,  
         dbo.accounts.name, 
         amount =  Sum ((dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice),    
			itemdiscpercvalue = Sum ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (dbo.purdetail.discperc / 100)),    
    		invdiscpercvalue = Sum ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (1 - dbo.purdetail.discperc / 100)) * (dbo.purledger.discperc / 100)    ,
			netamount=Round ( (Sum ((dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice) - Sum ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (dbo.purdetail.discperc / 100)) - Sum ( (dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (1 - dbo.purdetail.discperc / 100)) * (dbo.purledger.discperc / 100)  -  dbo.purledger.flatdisc   +   dbo.purledger.misccharges + dbo.purledger.salestax ),  ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))  
						 +
						 Round (
		   /*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( dbo.purdetail.looseqty + dbo.purdetail.packqty ) * dbo.purdetail.purprice * (1 - dbo.purdetail.discperc * 0.01 ) , 2 ) )
							  	       * ( 1 - dbo.purledger.discperc * 0.01 ) , 2 ) - dbo.purledger.flatdisc ) * dbo.purledger.invgstperc1 * 0.01  , 2 )
 		   /*items salestax*/		 + Sum (Round ( (dbo.purdetail.looseqty + dbo.purdetail.packqty + dbo.purdetail.bonusqty) * dbo.purdetail.unitsalestax + Round ( Round ( (dbo.purdetail.looseqty + dbo.purdetail.packqty) * dbo.purdetail.purprice * (1 - dbo.purdetail.discperc * 0.01 ), 2 ) * dbo.purdetail.gstperc * 0.01 , 2 ) , 2 ) )						 
										 , ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)) ,
         posted= dbo.purledger.posted

    FROM dbo.purledger,  
			dbo.purdetail,   
         dbo.accounts  

   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and  
         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  
     	   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY dbo.accounts.name,   
         dbo.purledger.misccharges,   
         dbo.purledger.flatdisc,   
         dbo.purledger.date,   
         dbo.purledger.purinvcode,   
			dbo.purledger.discperc,  
			dbo.purledger.invgstperc1,
			dbo.purledger.salestax,
			dbo.purledger.purcatcode,
         dbo.purledger.posted) AS A

GROUP BY  datepart(dd,A.date) ,
	  		 A.invtype   
ORDER BY  datepart(dd,A.date)
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime))
)
