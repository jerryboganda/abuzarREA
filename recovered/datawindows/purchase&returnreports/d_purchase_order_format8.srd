table(column=(type=char(60) updatewhereclause=yes name=supplier dbname="supplier"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=datetime updatewhereclause=yes name=orderdate dbname="OrderDate"  )
column=(type=long updatewhereclause=yes name=ordercode dbname="OrderCode"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted" 
 values="Yes	Y/No	N/"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="Itemalias"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(2) updatewhereclause=yes name=poprice dbname="POPrice"  )
column=(type=decimal(4) updatewhereclause=yes name=poqty dbname="POQty"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
 retrieve="SELECT 
	supplier=(select name from accounts where accounts.acccode=OH.suppcode),
	customer=(select name from accounts where accounts.acccode=OH.custcode),
	OrderDate=OH.date,
	OrderCode=OH.pocode,
	Posted = OH.Posted,
	Itemalias=I.customicode,
	itemname=I.name,
	POPrice=OD.rate,
	POQty=OD.qty,
	PurQty=(SELECT isnull(sum(PD.packqty),0) FROM purledger PL , purdetail PD WHERE PL.POCode=OH.pocode AND PL.PurInvCode = PD.PurInvCode)
FROM PurOrderHeader OH,
	PurOrderDetail OD,
	Item I	
WHERE OH.Date >= :ad_sdate AND
	OH.Date<=:ad_edate AND
	OH.Suppcode=:ai_suppcode AND
	OH.pocode=OD.pocode AND
	I.icode=OD.icode
Order By  OrderCode,
			 OD.PoRowid"
  arguments=(("ai_suppcode", number), ("ad_sdate", datetime), ("ad_edate", datetime))
)
