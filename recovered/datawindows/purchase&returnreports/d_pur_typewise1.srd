release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1468 color="536870912" )
summary(height=375 color="536870912" )
footer(height=0 color="536870912" )
detail(height=1208 color="536870912" )
table(column=(type=decimal(6) updatewhereclause=yes name=cashpur dbname="cashpur"  )
column=(type=decimal(6) updatewhereclause=yes name=cashpursalestax dbname="cashpursalestax"  )
column=(type=decimal(6) updatewhereclause=yes name=creditpur dbname="Creditpur"  )
column=(type=decimal(6) updatewhereclause=yes name=creditpursalestax dbname="Creditpursalestax"  )
column=(type=decimal(6) updatewhereclause=yes name=salereturn dbname="salereturn"  )
column=(type=decimal(6) updatewhereclause=yes name=salereturnsalestax dbname="salereturnsalestax"  )
column=(type=decimal(6) updatewhereclause=yes name=openingpur dbname="openingpur"  )
column=(type=decimal(6) updatewhereclause=yes name=openingpursalestax dbname="openingpursalestax"  )
 retrieve="SELECT 
	cashpur= 
		 (SELECT Isnull(sum ( A.invamount ) ,0)
		FROM 
			(SELECT invamount=Round(Sum (( dbo.purdetail.looseqty + purdetail.packqty ) * dbo.purdetail.purprice)
						- Sum (Round(((( dbo.purdetail.looseqty + purdetail.packqty ) * dbo.purdetail.purprice ) * (dbo.purdetail.discperc * .01)) ,2))
						- Sum ( Round( dbo.purdetail.purprice * (dbo.purdetail.looseqty + purdetail.packqty )    * (1 - (dbo.purdetail.discperc * .01)),2)) * (dbo.purledger.discperc /100) 
						+ dbo.purledger.misccharges - purledger.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))  
			FROM  dbo.purledger, dbo.purdetail, dbo.accounts
			WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and 
				( dbo.purledger.purcatcode IN (1,7 ))and
				( dbo.purledger.porb='N') and
				( dbo.purledger.suppcode = dbo.accounts.acccode )and  
				( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            
			GROUP BY 
				dbo.purledger.purinvcode,            
				dbo.purledger.misccharges,   
				dbo.purledger.flatdisc,   
				dbo.purledger.invgstperc1,	
				dbo.purledger.discperc,  
				dbo.purledger.salestax) as A),

cashpursalestax = 
       (select Isnull(sum ( AA.salestax ) ,0)
			from 

(
  SELECT salestax= Round (
			/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( Purdetail.looseqty + Purdetail.packqty ) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ) , 2 ) )
								  	       * ( 1 - PurLedger.discperc * 0.01 ) , 2 ) - PurLedger.flatdisc ) * PurLedger.invgstperc1 * 0.01  , 2 )
 			/*items salestax*/		 + Sum (Round ( (PurDetail.looseqty + PurDetail.packqty + PurDetail.bonusqty)* PurDetail.unitsalestax + Round ( Round ( (Purdetail.looseqty + Purdetail.packqty) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ), 2 ) * Purdetail.gstperc * 0.01 , 2 ) , 2 ) )
										 , ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)) 
	
   FROM  dbo.purledger,  
			dbo.purdetail,   
         dbo.accounts  

   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and 
 			( dbo.purledger.purcatcode IN (1,7 ))and
			( dbo.purledger.porb='N') and
         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  
     	   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            

	GROUP BY 
			dbo.purledger.purinvcode,            
			dbo.purledger.misccharges,   
         dbo.purledger.flatdisc,   
         dbo.purledger.invgstperc1,	
			dbo.purledger.discperc,  
			dbo.purledger.salestax
			
 ) as AA),

Creditpur=       (select ISNULL(sum(B.invamount),0)
			from 
(
  SELECT invamount=Round(Sum( ( dbo.purdetail.looseqty + purdetail.packqty) * dbo.purdetail.purprice)
						  - Sum (Round(((( dbo.purdetail.looseqty + purdetail.packqty ) * dbo.purdetail.purprice ) * (dbo.purdetail.discperc * .01)) ,2))
						  - Sum ( Round( dbo.purdetail.purprice * (dbo.purdetail.looseqty + purdetail.packqty )    * (1 - (dbo.purdetail.discperc * .01)),2)) * (dbo.purledger.discperc /100) 
					 	  + dbo.purledger.misccharges - purledger.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))  

    FROM dbo.purledger,  
			dbo.purdetail,   
         dbo.accounts  

   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and 
 			( dbo.purledger.purcatcode in (2,8 ))and
			( dbo.purledger.porb='N') and
         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  
     	   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY 
			dbo.purledger.purinvcode,   
			dbo.purledger.misccharges,   
         dbo.purledger.flatdisc,   
         dbo.purledger.discperc,
  			dbo.purledger.invgstperc1,
			dbo.purledger.salestax

   ) as B),

Creditpursalestax =  (select ISNULL(sum(BB.salestax),0)
			from 
(
  SELECT salestax = Round (
			/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( Purdetail.looseqty + Purdetail.packqty ) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ) , 2 ) )
								  	       * ( 1 - PurLedger.discperc * 0.01 ) , 2 ) - PurLedger.flatdisc ) * PurLedger.invgstperc1 * 0.01  , 2 )
 			/*items salestax*/		 + Sum (Round ( (PurDetail.looseqty + PurDetail.packqty + PurDetail.bonusqty)* PurDetail.unitsalestax + Round ( Round ( (Purdetail.looseqty + Purdetail.packqty) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ), 2 ) * Purdetail.gstperc * 0.01 , 2 ) , 2 ) )						 
										 , ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)) 
    FROM dbo.purledger,  
			dbo.purdetail,   
         dbo.accounts  

   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and 
 			( dbo.purledger.purcatcode in (2,8 ))and
			( dbo.purledger.porb='N') and
         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  
     	   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY 
			dbo.purledger.purinvcode,   
			dbo.purledger.misccharges,   
         dbo.purledger.flatdisc,   
         dbo.purledger.discperc,
  			dbo.purledger.invgstperc1,
			dbo.purledger.salestax

   ) as BB),

salereturn=(select ISNULL(SUM(C.invamount),0)
			 from 
              (


  SELECT invamount=Round(Sum ( (dbo.purdetail.looseqty + purdetail.packqty)* dbo.purdetail.purprice)
						- Sum (Round(((( dbo.purdetail.looseqty + purdetail.packqty ) * dbo.purdetail.purprice ) * (dbo.purdetail.discperc * .01)) ,2))
						- Sum ( Round( dbo.purdetail.purprice * (dbo.purdetail.looseqty + purdetail.packqty )    * (1 - (dbo.purdetail.discperc * .01)),2)) * (dbo.purledger.discperc /100) 
						+ dbo.purledger.misccharges - purledger.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))  

    FROM dbo.purledger,  
			dbo.purdetail,   
         dbo.accounts  

   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and 
 			( dbo.purledger.porb='Y') and
         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  
     	   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY 
         dbo.purledger.purinvcode,   
			dbo.purledger.misccharges,   
         dbo.purledger.flatdisc,   
			dbo.purledger.discperc,  
			dbo.purledger.invgstperc1,
			dbo.purledger.salestax			
  ) as C),

salereturnsalestax = (select ISNULL(SUM(CC.salestax),0)
			 from 
              (

  SELECT salestax = Round (
			/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( Purdetail.looseqty + Purdetail.packqty ) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ) , 2 ) )
								  	       * ( 1 - PurLedger.discperc * 0.01 ) , 2 ) - PurLedger.flatdisc ) * PurLedger.invgstperc1 * 0.01  , 2 )
 			/*items salestax*/		 + Sum (Round ( (PurDetail.looseqty + PurDetail.packqty + PurDetail.bonusqty)* PurDetail.unitsalestax + Round ( Round ( (Purdetail.looseqty + Purdetail.packqty) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ), 2 ) * Purdetail.gstperc * 0.01 , 2 ) , 2 ) )						 
										 , ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)) 
    FROM dbo.purledger,  
			dbo.purdetail,   
         dbo.accounts  

   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and 
 			( dbo.purledger.porb='Y') and
         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  
     	   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY 
			dbo.purledger.purinvcode,   
			dbo.purledger.misccharges,   
         dbo.purledger.flatdisc,   
         dbo.purledger.discperc,  
			dbo.purledger.invgstperc1,
			dbo.purledger.salestax			
  ) as CC ),

openingpur=(select ISNULL(SUM(D.invamount),0)
			 from 

              (

  SELECT invamount=Round(Sum ( (dbo.purdetail.looseqty + purdetail.packqty)* dbo.purdetail.purprice)
						- Sum (Round(((( dbo.purdetail.looseqty + purdetail.packqty ) * dbo.purdetail.purprice ) * (dbo.purdetail.discperc * .01)) ,2))
						- Sum ( Round( dbo.purdetail.purprice * (dbo.purdetail.looseqty + purdetail.packqty )    * (1 - (dbo.purdetail.discperc * .01)),2)) * (dbo.purledger.discperc /100) 
						+ dbo.purledger.misccharges - purledger.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))  

    FROM dbo.purledger,  
			dbo.purdetail,   
         dbo.accounts  

   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and 
 			( dbo.purledger.porb='N') and
			( dbo.purledger.purcatcode in (3 ))and
         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  
     	   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY 
         dbo.purledger.purinvcode,   
			dbo.purledger.misccharges,   
         dbo.purledger.flatdisc,   
			dbo.purledger.invgstperc1,
			dbo.purledger.discperc,  
			dbo.purledger.salestax
  ) as D) ,

openingpursalestax = (select ISNULL(SUM(DD.salestax),0)
			 from 

              (

  SELECT salestax = Round (
			/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( Purdetail.looseqty + Purdetail.packqty ) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ) , 2 ) )
								  	       * ( 1 - PurLedger.discperc * 0.01 ) , 2 ) - PurLedger.flatdisc ) * PurLedger.invgstperc1 * 0.01  , 2 )
 			/*items salestax*/		 + Sum (Round ( (PurDetail.looseqty + PurDetail.packqty + PurDetail.bonusqty)* PurDetail.unitsalestax + Round ( Round ( (Purdetail.looseqty + Purdetail.packqty) * Purdetail.purprice * (1 - Purdetail.discperc * 0.01 ), 2 ) * Purdetail.gstperc * 0.01 , 2 ) , 2 ) )						 
										 , ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)) 

    FROM dbo.purledger,  
			dbo.purdetail,   
         dbo.accounts  

   WHERE ( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and 
 			( dbo.purledger.porb='N') and
			( dbo.purledger.purcatcode in (3 ))and
         ( dbo.purledger.suppcode = dbo.accounts.acccode )and  
     	   ( dbo.purledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY 
         dbo.purledger.purinvcode, 
			dbo.purledger.misccharges,   
         dbo.purledger.flatdisc,   
			dbo.purledger.invgstperc1,
			dbo.purledger.discperc,  
			dbo.purledger.salestax
  ) as DD)
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
