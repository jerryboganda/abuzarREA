table(column=(type=datetime updatewhereclause=yes name=invdate dbname="InvDate"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(100) updatewhereclause=yes name=purchasetype dbname="PurchaseType"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=decimal(2) updatewhereclause=yes name=invamount dbname="InvAmount"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="OutstandingAmt"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="DueDate"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=diff dbname="Diff"  )
 retrieve="SELECT
	InvDate=H.Date,
	PurInvCode=H.PurInvCode,
	Posted=H.Posted,
	AliasName=A.AliasName,
	PurchaseType = (SELECT PT.Name FROM PurchaseType PT WHERE H.PurTypeCode = PT.PurTypeCode),
	SupplierName=A.Name,
	InvAmount=H.InvTotal,
	OutstandingAmt = H.OutstandingAmt,
	DueDate = DateAdd(dd, H.CreditDays, H.Date),
	Remarks = H.Remarks,
	Diff = H.InvTotal - H.SuppInvAmount
FROM
	PurLedger H, Accounts A
WHERE
	H.OutStandingAmt <> 0 AND
	DateAdd(dd, H.CreditDays, H.Date) <= :adt_duedate AND
	(H.PurTypeCode IN (:ai_purtypecode)) AND
	H.SuppCode = A.AccCode"
  arguments=(("adt_duedate", datetime), ("ai_purtypecode", numberlist))
 sort="purchasetype A, purinvcode A"
)
