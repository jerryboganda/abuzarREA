table(column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(12) updatewhereclause=yes name=accountaliasname dbname="AccountAliasName"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=decimal(4) updatewhereclause=yes name=totalqty dbname="TotalQty"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalueattp dbname="PurValueAtTP"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalueatsp dbname="PurValueAtSP"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalueatnp dbname="PurValueAtNP"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="SalesTax"  )
column=(type=decimal(6) updatewhereclause=yes name=avgtp dbname="AvgTP"  )
column=(type=decimal(6) updatewhereclause=yes name=avgsp dbname="AvgSP"  )
column=(type=decimal(6) updatewhereclause=yes name=avgnp dbname="AvgNP"  )
 retrieve="SELECT
	ItemCode = T.ICode,
	ItemName = I.Name,
	AliasName = I.CustomICode,
	AccountAliasName = A.AliasName,
	SupplierName = A.Name,
	Manufacturer = M.Name,
	TotalQty = SUM(T.Qty),
	PurValueAtTP = SUM(T.PurValueAtTP),
	PurValueAtSP = SUM(T.PurValueAtSP),
	PurValueAtNP = SUM(T.PurValueAtNP),
	SalesTax = SUM(T.SalesTax),
	AvgTP = SUM(T.PurValueAtTP) / CASE WHEN SUM(T.Qty) IS NULL OR SUM(T.Qty) = 0 THEN 1 ELSE SUM(T.Qty) END,
	AvgSP = SUM(T.PurValueAtSP) / CASE WHEN SUM(T.Qty) IS NULL OR SUM(T.Qty) = 0 THEN 1 ELSE SUM(T.Qty) END,
	AvgNP = SUM(T.PurValueAtNP) / CASE WHEN SUM(T.Qty) IS NULL OR SUM(T.Qty) = 0 THEN 1 ELSE SUM(T.Qty) END
FROM
	(SELECT 
		SuppCode = PL.SuppCode,
		ICode = PD.ICode,
		Qty = SUM(PD.LooseQty + PD.BonusQty),
		PurValueAtTP = SUM((PD.LooseQty + PD.BonusQty) * Round(PD.Rate / CASE WHEN PD.PackUnits IS NULL OR PD.PackUnits = 0 THEN 1 ELSE PD.PackUnits END, 2)),
		PurValueAtSP = SUM((PD.LooseQty + PD.BonusQty) * Round(PD.SalePriceForItem / CASE WHEN PD.PackUnits IS NULL OR PD.PackUnits = 0 THEN 1 ELSE PD.PackUnits END, 2)),
		PurValueAtNP = SUM((PD.LooseQty + PD.BonusQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * (1 - PL.DiscPerc * 0.01)),
		SalesTax = SUM((PD.LooseQty + PD.BonusQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * PD.GSTPerc * 0.01) + 
				SUM((PD.LooseQty + PD.BonusQty) * PD.UnitSalesTax)
	FROM
		PurLedger PL,
		PurDetail PD
	WHERE 
		:ai_allitem = 0 AND
		PL.PurCatCode NOT IN (1,2) AND
		PL.Posted = 'Y' AND
		PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		PL.SuppCode IN (:ai_suppcode) AND
		PL.PurInvCode = PD.PurInvCode AND
		PD.ICode IN (:ai_icode)
	GROUP BY
		PL.SuppCode,
		PD.ICode
	UNION ALL
	SELECT 
		SuppCode = PL.SuppCode,
		ICode = PD.ICode,
		Qty = SUM((PD.PackQty + PD.BonusQty) * PD.PackUnits) ,
		PurValueAtTP = SUM((PD.PackQty + PD.BonusQty) * PD.Rate),
		PurValueAtSP = SUM((PD.PackQty + PD.BonusQty) * PD.SalePriceForItem),
		PurValueAtNP = SUM((PD.PackQty + PD.BonusQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * (1 - PL.DiscPerc * 0.01)),
		SalesTax = SUM((PD.LooseQty + PD.BonusQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * PD.GSTPerc * 0.01) + 
				SUM((PD.LooseQty + PD.BonusQty) * PD.UnitSalesTax)
	FROM
		PurLedger PL,
		PurDetail PD
	WHERE 
		:ai_allitem = 0 AND
		PL.PurCatCode IN (1,2) AND
		PL.Posted = 'Y' AND
		PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		PL.SuppCode IN (:ai_suppcode) AND
		PL.PurInvCode = PD.PurInvCode AND
		PD.ICode IN (:ai_icode)
	GROUP BY
		PL.SuppCode,
		PD.ICode
	UNION ALL
	SELECT 
		SuppCode = PL.SuppCode,
		ICode = PD.ICode,
		Qty = SUM(PD.LooseQty + PD.BonusQty),
		PurValueAtTP = - SUM((PD.LooseQty + PD.BonusQty) * PD.PRPrice),
		PurValueAtSP = - SUM((PD.LooseQty + PD.BonusQty) * Round(PD.PackSalePrice / CASE WHEN PD.PackUnits IS NULL OR PD.PackUnits = 0 THEN 1 ELSE PD.PackUnits END, 2)),
		PurValueAtNP = - SUM((PD.LooseQty + PD.BonusQty) * PD.PRPrice * (1 - PD.DiscPerc * 0.01) * (1 - PL.DiscPerc * 0.01)),
		SalesTax = - SUM((PD.LooseQty + PD.BonusQty) * PD.PrPrice * (1 - PD.DiscPerc * 0.01) * PD.GSTPerc * 0.01) + 
				SUM((PD.LooseQty + PD.BonusQty) * PD.UnitSalesTax)
	FROM
		PrLedger PL,
		PrDetail PD
	WHERE 
		:ai_allitem = 0 AND
		PL.Posted = 'Y' AND
		PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		PL.SuppCode IN (:ai_suppcode) AND
		PL.PrInvCode = PD.PrInvCode AND
		PD.ICode IN (:ai_icode)
	GROUP BY
		PL.SuppCode,
		PD.ICode
	UNION ALL
	SELECT 
		SuppCode = PL.SuppCode,
		ICode = PD.ICode,
		Qty = SUM(PD.LooseQty + PD.BonusQty),
		PurValueAtTP = SUM((PD.LooseQty + PD.BonusQty) * Round(PD.Rate / CASE WHEN PD.PackUnits IS NULL OR PD.PackUnits = 0 THEN 1 ELSE PD.PackUnits END, 2)),
		PurValueAtSP = SUM((PD.LooseQty + PD.BonusQty) * Round(PD.SalePriceForItem / CASE WHEN PD.PackUnits IS NULL OR PD.PackUnits = 0 THEN 1 ELSE PD.PackUnits END, 2)),
		PurValueAtNP = SUM((PD.LooseQty + PD.BonusQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * (1 - PL.DiscPerc * 0.01)),
		SalesTax = SUM((PD.LooseQty + PD.BonusQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * PD.GSTPerc * 0.01) + 
				SUM((PD.LooseQty + PD.BonusQty) * PD.UnitSalesTax)
	FROM
		PurLedger PL,
		PurDetail PD
	WHERE 
		:ai_allitem = 1 AND
		PL.PurCatCode NOT IN (1,2) AND
		PL.Posted = 'Y' AND
		PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		PL.SuppCode IN (:ai_suppcode) AND
		PL.PurInvCode = PD.PurInvCode
	GROUP BY
		PL.SuppCode,
		PD.ICode
	UNION ALL
	SELECT 
		SuppCode = PL.SuppCode,
		ICode = PD.ICode,
		Qty = SUM((PD.PackQty + PD.BonusQty) * PD.PackUnits) ,
		PurValueAtTP = SUM((PD.PackQty + PD.BonusQty) * PD.Rate),
		PurValueAtSP = SUM((PD.PackQty + PD.BonusQty) * PD.SalePriceForItem),
		PurValueAtNP = SUM((PD.PackQty + PD.BonusQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * (1 - PL.DiscPerc * 0.01)),
		SalesTax = SUM((PD.LooseQty + PD.BonusQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * PD.GSTPerc * 0.01) + 
				SUM((PD.LooseQty + PD.BonusQty) * PD.UnitSalesTax)
	FROM
		PurLedger PL,
		PurDetail PD
	WHERE 
		:ai_allitem = 1 AND
		PL.PurCatCode IN (1,2) AND
		PL.Posted = 'Y' AND
		PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		PL.SuppCode IN (:ai_suppcode) AND
		PL.PurInvCode = PD.PurInvCode
	GROUP BY
		PL.SuppCode,
		PD.ICode
	UNION ALL
	SELECT 
		SuppCode = PL.SuppCode,
		ICode = PD.ICode,
		Qty = SUM(PD.LooseQty + PD.BonusQty),
		PurValueAtTP = - SUM((PD.LooseQty + PD.BonusQty) * PD.PRPrice),
		PurValueAtSP = - SUM((PD.LooseQty + PD.BonusQty) * Round(PD.PackSalePrice / CASE WHEN PD.PackUnits IS NULL OR PD.PackUnits = 0 THEN 1 ELSE PD.PackUnits END, 2)),
		PurValueAtNP = - SUM((PD.LooseQty + PD.BonusQty) * PD.PRPrice * (1 - PD.DiscPerc * 0.01) * (1 - PL.DiscPerc * 0.01)),
		SalesTax = - SUM((PD.LooseQty + PD.BonusQty) * PD.PrPrice * (1 - PD.DiscPerc * 0.01) * PD.GSTPerc * 0.01) + 
				SUM((PD.LooseQty + PD.BonusQty) * PD.UnitSalesTax)
	FROM
		PrLedger PL,
		PrDetail PD
	WHERE 
		:ai_allitem = 1 AND
		PL.Posted = 'Y' AND
		PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		PL.SuppCode IN (:ai_suppcode) AND
		PL.PrInvCode = PD.PrInvCode
	GROUP BY
		PL.SuppCode,
		PD.ICode) T,
	Item I,
	Manufacturer M,
	Accounts A
WHERE 
	T.ICode = I.ICode AND
	I.ManfCode = M.ManfCode AND
	T.SuppCode = A.AccCode
GROUP BY
	T.SuppCode,
	T.ICode,
	I.Name, 
	I.CustomICode,
	A.Name,
	A.AliasName,
	M.Name
ORDER BY
	ItemName,
	SupplierName
"
  arguments=(("ai_allitem", number), ("ai_icode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_suppcode", numberlist))
)
