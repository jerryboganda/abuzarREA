table(column=(type=char(100) updatewhereclause=yes name=suppliercategory dbname="SupplierCategory"  )
column=(type=char(12) updatewhereclause=yes name=supplieralias dbname="SupplierAlias"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=char(100) updatewhereclause=yes name=suppinvcode dbname="SuppInvCode"  )
column=(type=datetime updatewhereclause=yes name=suppdate dbname="SuppDate"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=salestaxschedule dbname="SalesTaxSchedule"  )
column=(type=decimal(2) updatewhereclause=yes name=taxperc dbname="TaxPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxamt dbname="AdvanceTaxAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=puramt dbname="PurAmt"  )
column=(type=decimal(10) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(6) updatewhereclause=yes name=taxamt dbname="TaxAmt"  )
column=(type=char(1) updatewhereclause=yes name=wht dbname="WHT"  )
column=(type=char(1) updatewhereclause=yes name=ntnstrn dbname="NTNSTRN"  )
column=(type=char(60) updatewhereclause=yes name=section dbname="Section"  )
 retrieve="SELECT 
	SupplierCategory=SC.Name,
	SupplierAlias = A.AliasName,
	Supplier = A.Name,
	NTN=CASE WHEN S.NTNNo IS NULL THEN S.CNIC ELSE S.NTNNo END,
	PurInvCode=P.PurInvCode,
	SuppInvCode = P.SuppInvCode,
	SuppDate = P.SuppInvDate,
	Date=P.Date,
	SalesTaxSchedule=ST.Name,
	TaxPerc=ST.TaxPerc,
	AdvanceTaxAmt=SUM(P.AdvanceTaxAmt),
	PurAmt=SUM(D.PurPrice * (D.PackQty + D.LooseQty)),
	Discount=SUM((D.PurPrice * (D.PackQty + D.LooseQty) * D.DiscPerc * 0.01)),
	TaxAmt =SUM((D.PurPrice * (D.PackQty + D.LooseQty) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + ((D.PackQty + D.LooseQty + D.BonusQty) * D.UnitSalesTax)),
	WHT = CASE WHEN S.WHPerc > 0 THEN 'Y' ELSE 'N' END,
	NTNSTRN = CASE WHEN (S.NTNno IS NULL OR S.NTNno='') AND (S.SalesTaxRegNo IS NULL OR S.SalesTaxRegNo='') THEN 'N' ELSE 'Y' END,
	Section = (SELECT C.Name FROM ItemCategory C WHERE P.ICatCode = C.ICatCode)
FROM 
	PurLedger P, 
	PurDetail D, 
	Supplier S, 
	SupplierCategory SC, 
	Accounts A, 
	Item I,
	SalesTaxSchedule ST
WHERE 
	SC.SuppCatCode IN (:ai_suppcatcode) AND
	SC.SuppCatCode = S.SuppCatCode AND
	S.SuppCode = A.AccCode AND
	S.SuppCode = P.SuppCode AND
	P.Date BETWEEN :adt_startdate AND :adt_enddate AND
	P.Posted = 'Y' AND
	P.PurInvCode = D.PurInvCode AND
	D.ICode = I.ICode AND
	I.SalesTaxScheduleCode = ST.SalesTaxScheduleCode
GROUP BY
	SC.Name,
	A.AliasName,
	A.Name,
	S.NTNNo,
	S.CNIC,
	S.WHPerc,
	S.NTNNo,
	S.SalesTaxRegNo,
	P.PurInvCode,
	P.ICatCode,
	P.SuppInvCode,
	P.SuppInvDate,
	P.Date,
	ST.Name,
	ST.TaxPerc

"
  arguments=(("ai_suppcatcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="suppliercategory A, purinvcode A, date A, salestaxschedule A"
)
