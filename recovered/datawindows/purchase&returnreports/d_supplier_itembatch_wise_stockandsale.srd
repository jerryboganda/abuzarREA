table(column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="ItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(6) updatewhereclause=yes name=purnetrate dbname="PurNetrate"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=decimal(10) updatewhereclause=yes name=salenetrate dbname="SaleNetRate"  )
column=(type=long updatewhereclause=yes name=type dbname="Type"  )
 retrieve=" SELECT
	PurInvCode=P.PurInvcode, 
	Date = P.Date,
	AliasName = A.AliasName,
	SupplierName = A.Name,
	SuppCode=P.SuppCode,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	Batch=PD.Batch,
	PurQty=SUM((PD.looseqty + PD.packqty + PD.bonusqty) * case when P.purcatcode <= 2 THEN PD.packunits ELSE 1 END),
	PurNetrate =MAX((PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
			(1 - PD.DiscPerc * .01) * ( 1 - P.discperc * .01 ) + 
			(PD.unitsalestax * ( PD.Looseqty + PD.PackQty + PD.bonusqty )) +  
		Round( PD.PurPrice * (PD.LooseQty + PD.PackQty) * (1 - PD.DiscPerc * .01) * 0.01 * PD.gstperc, 2) +
		( Round((Round(Round(PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
					(1 - PD.DiscPerc * .01),2) * 
			(1 -  P.discperc * 0.01),2) - P.flatdisc) * 0.01 *  P.invgstperc1 ,2)) ) /
			(PD.Looseqty + PD.PackQty*PD.packunits + PD.bonusqty * case when P.purcatcode <= 2 THEN PD.packunits ELSE 1 END)),
	SaleQty = SUM(S.SaleQty),
	BonusQty=SUM(S.BonusQty), 
	SaleNetRate = S.SaleNetRate,
	Type = S.Type
FROM
	PurLedger P, PurDetail PD, Item I, Accounts A,
	(SELECT 
		Type = 1,
		ICode=SD.ICode, 
		Batch=SD.Batch, 
		RowID = MAX(PLD.PurRowID),
		SaleQty=SUM(SD.LooseQty), 
		BonusQty=SUM(SD.BonusQty), 
		SaleNetRate=(SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)
	FROM 
		SaleLedger S, SaleDetail SD, PurLedger PL, PurDetail PLD
	WHERE
		PL.SuppCode IN ( :ai_suppcode) AND
		PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		PL.PurInvCode = PLD.PurInvCode AND
		S.Date >= PL.Date AND
		S.SaleInvCode = SD.SaleInvCode AND
		PLD.ICode = SD.ICode AND
		PLD.Batch = SD.Batch
	GROUP BY
		SD.ICode, 
		SD.Batch, 
		SD.SalePrice,
		SD.ItemFlatDisc,
		SD.DiscPerc,
		S.DiscPerc
	UNION ALL
	SELECT 
		Type=2,
		ICode=SD.ICode, 
		Batch=SD.Batch, 
		RowID = MAX(PLD.PurRowID),
		SaleQty= -SUM(SD.LooseQty), 
		BonusQty= -SUM(SD.BonusQty), 
		SaleNetRate= SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)
	FROM 
		SRLedger S, SRDetail SD, PurLedger PL, PurDetail PLD
	WHERE
		PL.SuppCode IN ( :ai_suppcode) AND
		PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		PL.PurInvCode = PLD.PurInvCode AND
		S.Date >= PL.Date AND
		S.SRInvCode = SD.SRInvCode AND
		PLD.ICode = SD.ICode AND
		PLD.Batch = SD.Batch
	GROUP BY
		SD.ICode, 
		SD.Batch, 
		SD.SRPrice,
		SD.DiscPerc,
		S.DiscPerc) S
WHERE
	P.SuppCode IN ( :ai_suppcode) AND
	P.SuppCode = A.AccCode AND
	P.Date BETWEEN :adt_startdate AND :adt_enddate AND
	P.PurInvCode = PD.PurInvCode AND
	PD.ICode = I.ICode AND
	PD.ICode = S.ICode AND
	PD.Batch = S.Batch AND
	PD.PurRowID = S.RowID
GROUP BY
	P.PurInvcode, 
	P.Date,
	A.AliasName,
	A.Name,
	P.SuppCode,
	I.CustomICode,
	I.Name,
	PD.Batch,
	S.SaleNetRate,
	S.Type
UNION ALL
SELECT 
	PurInvCode=P.PurInvcode, 
	Date = P.Date,
	AliasName = A.AliasName,
	SupplierName = A.Name,
	SuppCode=P.SuppCode,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	Batch=PD.Batch,
	PurQty=SUM((PD.looseqty + PD.packqty + PD.bonusqty) * case when P.purcatcode <= 2 THEN PD.packunits ELSE 1 END),
	PurNetrate =MAX((PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
			(1 - PD.DiscPerc * .01) * ( 1 - P.discperc * .01 ) + 
			(PD.unitsalestax * ( PD.Looseqty + PD.PackQty + PD.bonusqty )) +  
		Round( PD.PurPrice * (PD.LooseQty + PD.PackQty) * (1 - PD.DiscPerc * .01) * 0.01 * PD.gstperc, 2) +
		( Round((Round(Round(PD.PurPrice * (PD.LooseQty + PD.PackQty) * 
					(1 - PD.DiscPerc * .01),2) * 
			(1 -  P.discperc * 0.01),2) - P.flatdisc) * 0.01 *  P.invgstperc1 ,2)) ) /
			(PD.Looseqty + PD.PackQty*PD.packunits + PD.bonusqty * case when P.purcatcode <= 2 THEN PD.packunits ELSE 1 END)),
	SaleQty = NULL,
	BonusQty=NULL, 
	SaleNetRate = NULL,
	Type=1
FROM
	PurLedger P, PurDetail PD, Item I, Accounts A
WHERE
	P.SuppCode IN ( :ai_suppcode) AND
	P.SuppCode = A.AccCode AND
	P.Date BETWEEN :adt_startdate AND :adt_enddate AND
	P.PurInvCode = PD.PurInvCode AND
	PD.ICode = I.ICode AND
	STR(PD.ICode,10) + PD.Batch NOT IN 
		(SELECT DISTINCT STR(SD.ICode,10) + SD.Batch 
		FROM SaleDetail SD, SaleLedger SL 
		WHERE SL.Date >= P.Date AND SL.SaleInvCode=SD.SaleInvCode
		UNION
		SELECT DISTINCT STR(SD.ICode,10) + SD.Batch 
		FROM SRDetail SD, SRLedger SL 
		WHERE SL.Date >= P.Date AND SL.SRInvCode=SD.SRInvCode)
GROUP BY
	P.PurInvcode, 
	P.Date,
	A.AliasName,
	A.Name,
	P.SuppCode,
	I.CustomICode,
	I.Name,
	PD.Batch
"
  arguments=(("ai_suppcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="purinvcode A, itemname A, batch A, type A"
)
