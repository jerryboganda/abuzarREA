table(column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
column=(type=char(50) updatewhereclause=yes name=cnic dbname="CNIC"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(100) updatewhereclause=yes name=suppinvcode dbname="SuppInvCode"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=datetime updatewhereclause=yes name=purdate dbname="PurDate"  )
column=(type=datetime updatewhereclause=yes name=paymentdate dbname="PaymentDate"  )
column=(type=decimal(2) updatewhereclause=yes name=invoiceamt dbname="InvoiceAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=whtaxperc dbname="WhTaxPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=whtaxamt dbname="WhTaxAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="SalesTax"  )
 retrieve="SELECT 
	NTN = S.NTNNo,
	CNIC = S.CNIC,
	Supplier = A.Name,
	SuppInvCode=P.SuppInvCode,
	PurInvCode=P.PurInvCode,
	PurDate = P.Date,
	PaymentDate = PM.Date,
	InvoiceAmt = PM.OutstandingAmt,
	WhTaxPerc=PM.WhTaxPerc,
	WhTaxAmt = PM.WhTaxAmt,
	SalesTax=ST.SalesTax
FROM
	Accounts A,
	Supplier S,
	PurPayment PM,
	PurLedger P,
	(SELECT  PL.PurInvCode, 
			SalesTax = ROUND(
			ISNULL(SUM((PD.looseqty + PD.packqty + PD.bonusqty) *
				PD.unitsalestax),0) +
			ISNULL(SUM(ROUND((PD.looseqty + PD.packqty) * PD.purprice * 
				(1 - (.01 * PD.discperc)) * PD.gstperc * .01, 2)),0) +
			ROUND(ISNULL((SUM(((PD.looseqty + PD.packqty) * PD.purprice) * 
				(1 - (.01 * PD.discperc))) * 
				(1- (.01 * PL.discperc)) - PL.flatdisc) * 
				(PL.invgstperc1 * .01), 2),0), 0)
	FROM PurPayment PP, Purledger PL, PurDetail PD
	WHERE  
		PP.AccCode IN (:ai_suppcode) AND
		PP.Date BETWEEN :adt_startdate AND :adt_enddate AND
		PP.WhTaxAmt <> 0 AND
		PP.PurInvCode = Pl.PurInvCode AND
		PL.PurInvCode = PD.PurInvCode 
	GROUP BY	PL.PurInvCode,
		PL.flatdisc,
		PL.misccharges,
		PL.discperc,
		PL.invgstperc1,
		PL.salestax) ST
WHERE 
	PM.AccCode IN (:ai_suppcode) AND
	PM.AccCode = S.SuppCode AND
	S.SuppCode = A.AccCode AND
	PM.Date BETWEEN :adt_startdate AND :adt_enddate AND
	PM.WhTaxAmt <> 0 AND
	PM.PurInvCode = P.PurInvCode AND
	PM.PurInvCode = ST.PurInvCode AND
	P.PurInvCode= ST.PurInvCode
ORDER BY
	Supplier,
	PaymentDate"
  arguments=(("ai_suppcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="supplier A, purinvcode A"
)
