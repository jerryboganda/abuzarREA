table(column=(type=long updatewhereclause=yes name=prinvcode dbname="prinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(23) updatewhereclause=yes name=invtype dbname="invtype"  )
column=(type=char(100) updatewhereclause=yes name=purchasetype dbname="PurchaseType"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(4) updatewhereclause=yes name=quantity dbname="quantity"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=person dbname="Person"  )
column=(type=decimal(6) updatewhereclause=yes name=totalsalestax dbname="totalsalestax"  )
 retrieve=" SELECT 
	prinvcode = dbo.prledger.prinvcode, 
	date = dbo.prledger.date, 
	invdiscperc=dbo.prledger.discperc,
	flatdisc = dbo.prledger.flatdisc,
	misccharges = dbo.prledger.misccharges,
	invsalestax = dbo.prledger.salestax,
	invgstperc1 = dbo.prledger.invgstperc1,
	invtype = Case dbo.prledger.prcatcode 	When 4 Then 'Cash Purchase Return' 	When 5 Then 'Credit Purchase Return'  Else 'Opening Purchase Return' End,
	PurchaseType = (SELECT PT.Name FROM PurchaseType PT WHERE PT.PurTypeCode = dbo.prledger.PRTypeCode),
	looseqty = dbo.prdetail.looseqty, 
	packqty  = prdetail.packqty,  
	unitsalestax = dbo.prdetail.unitsalestax,
	gstperc = dbo.prdetail.gstperc,
	quantity = dbo.prdetail.looseqty + prdetail.packqty, 
	bonusqty  = prdetail.bonusqty, 	  
	price = dbo.prdetail.prprice,    
	avgprice = dbo.prdetail.avgprice, 
	itemdiscperc = dbo.prdetail.discperc,    
	packunits = dbo.prdetail.packunits,    
	packing= (select dbo.itempacking.name from dbo.itempacking where dbo.item.packcode = dbo.itempacking.packcode),
	remarks=prledger.remarks,
	batch = dbo.prdetail.batch,    
	expiry = dbo.prdetail.expiry,    
	itemname = item.name,
	datestring = Rtrim(LTrim(Str(DatePart(dd, prledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, prledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, prledger.date)))), 
	Person = dbo.accounts.name,
	/*	 invnettotalexctax=(select Round( sum(Round((PD.prprice * (PD.packqty + PD.looseqty) * (1 - PD.discperc * 0.01)),2) * (1 - PL.discperc * 0.01))
							+ PL.misccharges - PL.flatdisc,0)
				from prledger PL,
					  prdetail PD
				where PL.prinvcode=prledger.prinvcode and
						PD.prinvcode=PL.prinvcode
	
				group by
						PL.prinvcode,
						PL.flatdisc,
						PL.misccharges
			), */
	totalsalestax = (SELECT invtotalsalestax= 
								  Round (
	/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( PD.looseqty + PD.packqty ) * PD.prprice * (1 - PD.discperc * 0.01 ) , 2 ) )
								 * ( 1 - PL.discperc * 0.01 ) , 2 ) - PL.flatdisc ) * PL.invgstperc1 * 0.01  , 2 )
	/*items salestax*/		 + Sum (Round ( (PD.looseqty + PD.packqty + PD.bonusqty)* PD.unitsalestax + Round ( Round ( (PD.looseqty + PD.packqty) * PD.prprice * (1 - PD.discperc * 0.01 ), 2 ) * PD.gstperc * 0.01 , 2 ) , 2 ) )						 
								 , ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))
					 FROM dbo.Prledger PL , 
							dbo.Prdetail PD
	
					 WHERE  (PL.prinvcode = dbo.prledger.prinvcode )   and
							  (PL.prinvcode = PD.prinvcode )   
	
					 GROUP BY PL.prinvcode, 
								 PL.misccharges,   
								 PL.flatdisc,   
								 PL.invgstperc1, 
								 PL.discperc
					)
FROM 	 
	dbo.prledger, 
	dbo.prdetail,    
	dbo.item,
	dbo.accounts
WHERE  
	dbo.prledger.date >= :ad_StartDate and
	dbo.prledger.date <= :ad_EndDate  and
	dbo.prledger.prcatcode IN (4, 5, 6) and
	dbo.prledger.prinvcode = dbo.prdetail.prinvcode and  
	dbo.prdetail.icode = item.icode and 
	dbo.prledger.suppcode = dbo.accounts.acccode 
"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime))
)
