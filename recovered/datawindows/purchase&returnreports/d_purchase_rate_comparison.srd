table(column=(type=char(100) updatewhereclause=yes name=grouptype dbname="GroupType"  )
column=(type=char(100) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(4) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(100) updatewhereclause=yes name=itemalias dbname="ItemAlias"  )
column=(type=char(100) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(100) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=decimal(4) updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=decimal(2) updatewhereclause=yes name=utn dbname="UTN"  )
column=(type=decimal(4) updatewhereclause=yes name=invoicecode1 dbname="InvoiceCode1"  )
column=(type=decimal(2) updatewhereclause=yes name=rate1 dbname="Rate1"  )
column=(type=decimal(4) updatewhereclause=yes name=invoicecode2 dbname="InvoiceCode2"  )
column=(type=decimal(2) updatewhereclause=yes name=rate2 dbname="Rate2"  )
column=(type=decimal(4) updatewhereclause=yes name=invoicecode3 dbname="InvoiceCode3"  )
column=(type=decimal(2) updatewhereclause=yes name=rate3 dbname="Rate3"  )
column=(type=decimal(4) updatewhereclause=yes name=invoicecode4 dbname="InvoiceCode4"  )
column=(type=decimal(2) updatewhereclause=yes name=rate4 dbname="Rate4"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
 retrieve="select  
	GroupType=Name5,
	GroupName=Name4,
	date=date1, 
	Category=Code1,
	ItemAlias=Name1,
	Item=Name2, 
	Supplier=Name3,
	InvoiceCode=Code3, 
	Rate=Value1,
	Qty=Value2, 
	PackUnits=Value3, 
	UTN=Value4,
	InvoiceCode1=Code5,
	Rate1=Value5,
	InvoiceCode2=Code6,
	Rate2=Value6,
	InvoiceCode3=Code7,
	Rate3=Value7,
	InvoiceCode4=Code8,
	Rate4=Value8,
	SalePrice = (SELECT Round(Item.SalePrice / 
							CASE :ar_purchasetype 
								WHEN 'P' THEN 1 
								ELSE 
									CASE Item.PackUnits 
										WHEN 0 THEN 1 
										ELSE Item.PackUnits 
									END 
							END, 2) 
					FROM Item 
					WHERE Item.ICode=ReportData.Code2)
from reportdata
ORDER BY GroupName, Item, Date, InvoiceCode"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_purchasetype", string), ("ar_group", string))
)
