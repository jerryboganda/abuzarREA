table(column=(type=char(100) updatewhereclause=yes name=suppliercategory dbname="SupplierCategory"  )
column=(type=long key=yes updatewhereclause=yes name=icode dbname="Item.ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=netpurqty dbname="NetPurQty"  )
column=(type=decimal(6) updatewhereclause=yes name=netpurvalue dbname="NetPurValue"  )
column=(type=decimal(6) updatewhereclause=yes name=avgnetpurprice dbname="AvgNetPurPrice"  )
column=(type=decimal(4) updatewhereclause=yes name=netsaleqty dbname="NetSaleQty"  )
column=(type=decimal(6) updatewhereclause=yes name=netsalevalue dbname="NetSaleValue"  )
column=(type=decimal(6) updatewhereclause=yes name=avgnetsaleprice dbname="AvgNetSalePrice"  )
 retrieve="SELECT
	SupplierCategory = (SELECT SC.Name FROM SupplierCategory SC WHERE SC.SuppCatCode = 2 /*ai_suppcatcode*/),
	T.ICode,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	NetPurQty = SUM(CASE Type WHEN 'P' THEN T.Qty WHEN 'PR' THEN -(T.Qty) ELSE 0 END),
	NetPurValue = SUM(CASE Type WHEN 'P' THEN T.Value WHEN 'PR' THEN -(T.Value) ELSE 0 END),
	AvgNetPurPrice = SUM(CASE Type WHEN 'P' THEN T.Value WHEN 'PR' THEN -(T.Value) ELSE 0 END) / CASE WHEN SUM(CASE Type WHEN 'P' THEN T.Qty WHEN 'PR' THEN -(T.Qty) ELSE 0 END) = 0 THEN 1 ELSE SUM(CASE Type WHEN 'P' THEN T.Qty WHEN 'PR' THEN -(T.Qty) ELSE 0 END) END,
	NetSaleQty = SUM(CASE Type WHEN 'S' THEN T.Qty WHEN 'SR' THEN -(T.Qty) ELSE 0 END),
	NetSaleValue = SUM(CASE Type WHEN 'S' THEN T.Value WHEN 'SR' THEN -(T.Value) ELSE 0 END),
	AvgNetSalePrice = SUM(CASE Type WHEN 'S' THEN T.Value WHEN 'SR' THEN -(T.Value) ELSE 0 END) / CASE WHEN SUM(CASE Type WHEN 'S' THEN T.Qty WHEN 'SR' THEN -(T.Qty) ELSE 0 END) = 0 THEN 1 ELSE SUM(CASE Type WHEN 'S' THEN T.Qty WHEN 'SR' THEN -(T.Qty) ELSE 0 END) END
FROM
	(SELECT 
		Type = 'P',
		PD.ICode,
		Qty = SUM(CASE WHEN PL.PurCatCode <= 2 THEN (PD.PackQty + PD.BonusQty) * PD.PackUnits ELSE PD.LooseQty + PD.BonusQty END),
		Value = SUM( ((PD.LooseQty + PD.PackQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * (1 - PL.DiscPerc * 0.01)))
	FROM
		PurDetail PD, PurLedger PL, Supplier S
	WHERE  
		PL.Date BETWEEN :ad_StartDate AND :ad_EndDate AND
		PL.PurInvCode = PD.PurInvCode AND
		PL.SuppCode = S.SuppCode AND 
		S.SuppCatCode = :ai_suppcatcode
	GROUP BY
		S.SuppCatCode,
		PD.ICode
	UNION ALL
	SELECT 
		Type = 'PR',
		PD.ICode,
		Qty = SUM(PD.LooseQty + PD.BonusQty),
		Value = SUM( ((PD.LooseQty + PD.PackQty) * PD.PRPrice * (1 - PD.DiscPerc * 0.01) * (1 - PL.DiscPerc * 0.01)))
	FROM
		PRDetail PD, PRLedger PL, Supplier S
	WHERE  
		PL.Date BETWEEN :ad_StartDate AND :ad_EndDate AND
		PL.PRInvCode = PD.PRInvCode AND
		PL.SuppCode = S.SuppCode AND 
		S.SuppCatCode = :ai_suppcatcode
	GROUP BY
		S.SuppCatCode,
		PD.ICode
	UNION ALL
	SELECT 
		Type = 'S',
		SD.ICode,
		Qty = SUM(SD.LooseQty + SD.BonusQty),
		Value = SUM( (SD.LooseQty * SD.SalePrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)))
	FROM
		SaleDetail SD, SaleLedger SL
	WHERE  
		SL.Date BETWEEN :ad_StartDate AND :ad_EndDate AND
		SL.SaleInvCode = SD.SaleInvCode
	GROUP BY
		SD.ICode
	UNION ALL
	SELECT 
		Type = 'SR',
		SD.ICode,
		Qty = SUM(SD.LooseQty + SD.BonusQty),
		Value = SUM( (SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)))
	FROM
		SRDetail SD, SRLedger SL
	WHERE  
		SL.Date BETWEEN :ad_StartDate AND :ad_EndDate AND
		SL.SRInvCode = SD.SRInvCode
	GROUP BY
		SD.ICode) T,
	Item I
WHERE
	T.ICode = I.ICode
GROUP BY
	T.ICode,
	I.CustomICode,
	I.Name
HAVING 
	SUM(CASE Type WHEN 'P' THEN T.Qty WHEN 'PR' THEN -(T.Qty) ELSE 0 END) <> 0
ORDER BY
	ItemName
"
  update="Item" updatewhere=0 updatekeyinplace=no
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_SuppCatCode", number))
)
