header(height=1468 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=catcode dbname="CatCode"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=long updatewhereclause=yes name=iccode dbname="ICCode"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass"  )
column=(type=long updatewhereclause=yes name=isizecode dbname="ISizeCode"  )
column=(type=char(60) updatewhereclause=yes name=itemsize dbname="ItemSize"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(6) updatewhereclause=yes name=pur dbname="Pur"  )
column=(type=decimal(7) updatewhereclause=yes name=purvolume dbname="PurVolume"  )
column=(type=decimal(4) updatewhereclause=yes name=purreturnqty dbname="PurReturnQty"  )
column=(type=decimal(6) updatewhereclause=yes name=purreturn dbname="PurReturn"  )
column=(type=decimal(7) updatewhereclause=yes name=purreturnvolume dbname="PurReturnVolume"  )
column=(type=decimal(4) updatewhereclause=yes name=netpurqty dbname="NetPurQty"  )
column=(type=decimal(6) updatewhereclause=yes name=netpur dbname="NetPur"  )
column=(type=decimal(7) updatewhereclause=yes name=netpurvolume dbname="NetPurVolume"  )
 retrieve="SELECT
	CatCode=IC.ICatCode,
	ItemCategory=IC.Name,
	ICCode=ICL.ICCode, 
	ItemClass=ICL.Name,
	ISizeCode=ISZ.ISizeCode,
	ItemSize=ISZ.Name,
	PurQty = SUM(S.PurQty),
	Pur=Round(SUM(S.Pur), 2),
	PurVolume=SUM(S.PurVolume),
	PurReturnQty = SUM(S.PurReturnQty),
	PurReturn=Round(SUM(S.PurReturn), 2),
	PurReturnVolume=SUM(S.PurReturnVolume),
	NetPurQty = SUM(S.PurQty - S.PurReturnQty),
	NetPur=Round(SUM(S.Pur), 2) - Round(SUM(S.PurReturn), 2),
	NetPurVolume=SUM(S.PurVolume - S.PurReturnVolume)
FROM
	ItemClass ICL,
	ItemSize ISZ,
	ItemCategory IC, 
	Item I
	LEFT OUTER JOIN
	(SELECT
		PD.ICode,
		PurQty = SUM(PD.LooseQty+PD.PackQty),
		Pur = SUM((PD.LooseQty+PD.PackQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01) ),
		PurVolume = SUM((PD.LooseQty+PackQty) * I.PackingFactor),
		PurReturnQty = 0,
		PurReturn = 0.00,
		PurReturnVolume = 0.00
	FROM
		PurLedger P, PurDetail PD, Item I
	WHERE 
		P.Date >= :ad_startdate AND P.Date <= :ad_enddate AND
		P.PurInvCode = PD.PurInvCode AND 
		PD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)
	GROUP BY
		PD.ICode
	UNION ALL
	SELECT
		PD.ICode,
		PurQty = 0,
		Pur = 0.00,
		PurVolume = 0.00,
		PurReturnQty = SUM(PD.LooseQty),
		PurReturn = SUM(PD.LooseQty * PD.PrPrice * (1 - PD.DiscPerc * 0.01) * (1 - P.DiscPerc * 0.01) ),
		PurReturnVolume = SUM(PD.LooseQty * I.PackingFactor)
	FROM
		PRLedger P, PRDetail PD, Item I
	WHERE 
		P.Date >= :ad_startdate AND P.Date <= :ad_enddate AND
		P.PRInvCode = PD.PRInvCode AND 
		PD.ICode = I.ICode AND I.ICatCode IN (:ai_icatcode)
	GROUP BY
		PD.ICode) AS S ON (I.ICode = S.ICode)
WHERE
	IC.ICatCode IN (:ai_icatcode) AND
	IC.ICatCode = I.ICatCode AND
	I.ICCode = ICL.ICCode AND
	I.ISizeCode = ISZ.ISizeCode
GROUP BY
	IC.ICatCode,
	IC.Name,
	ICL.ICCode,
	ICL.Name,
	ISZ.ISizeCode,
	ISZ.Name
ORDER BY
	ItemCategory,
	ItemClass,
	ItemSize"
  arguments=(("ai_icatcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="itemcategory A, itemclass A, itemsize A"
)
