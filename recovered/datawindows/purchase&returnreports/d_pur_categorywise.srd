release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1333 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=2750 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=200 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsalestax dbname="itemsalestax"  )
column=(type=decimal(9) updatewhereclause=yes name=purchase dbname="purchase"  )
column=(type=decimal(9) updatewhereclause=yes name=preturn dbname="preturn"  )
column=(type=decimal(6) updatewhereclause=yes name=netpurchase dbname="NetPurchase"  )
column=(type=decimal(6) updatewhereclause=yes name=purchaseatsale dbname="purchaseatsale"  )
column=(type=decimal(6) updatewhereclause=yes name=preturnatsale dbname="preturnatsale"  )
column=(type=decimal(6) updatewhereclause=yes name=netpurchaseatsale dbname="netpurchaseatsale"  )
column=(type=decimal(2) updatewhereclause=yes name=totaldisc dbname="totaldisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharg dbname="misccharg"  )
column=(type=decimal(6) updatewhereclause=yes name=totalinvdiscperc dbname="totalinvdiscperc"  )
column=(type=decimal(6) updatewhereclause=yes name=diff dbname="diff"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="SalesTax"  )
 retrieve="SELECT
	GroupCode = A.GroupCode, 
	GroupName = A.GroupName,
	itemsalestax = (SELECT ISNULL( ROUND(SUM((PD.looseqty + PD.packqty + PD.bonusqty) * PD.unitsalestax) +
						SUM(ROUND((PD.looseqty + PD.packqty) * PD.purprice * (1 - (.01 * PD.discperc)) * 
						PD.gstperc * .01, 2)), 0) , 0)
		 FROM 
			purdetail PD, 
			purledger PL,
			(SELECT ICode, GroupCode = CASE :as_group WHEN 'M' THEN ManfCode WHEN 'C' THEN ICatCode WHEN 'L' THEN ICCode WHEN 'P' THEN PackCode END
			FROM Item) I
			WHERE 	PL.date between :ar_startdate and :ar_enddate and
					PL.purcatcode IN (:ar_purcatcode) AND
					PL.SalesManCode IN (:ar_usercode) AND
					PL.posted IN (:as_status) and
			       	PL.purinvcode=PD.purinvcode and
		 			PD.icode=I.icode AND
					A.GroupCode = I.GroupCode),
	purchase=ROUND((SELECT ISNULL( SUM(((PD.looseqty + PD.packqty ) * PD.purprice ) * 
			(1 - (.01 *  PD.discperc))), 0)
		 FROM 
			purdetail PD, 
			purledger PL, 
			(SELECT ICode, GroupCode = CASE :as_group WHEN 'M' THEN ManfCode WHEN 'C' THEN ICatCode WHEN 'L' THEN ICCode WHEN 'P' THEN PackCode END
			FROM Item) I
		 WHERE 	PL.date between :ar_startdate and :ar_enddate and
					PL.purcatcode IN (:ar_purcatcode) AND
			PL.SalesManCode IN (:ar_usercode) AND
			PL.posted IN (:as_status) and
       	PL.purinvcode=PD.purinvcode and
		 	PD.icode=I.icode AND
			A.GroupCode = I.GroupCode), 2),
	preturn =ROUND((SELECT ISNULL( SUM(((PRD.looseqty + PRD.packqty ) * PRD.prprice ) * 
			(1 - (.01 *  PRD.discperc))), 0)
		 FROM prdetail PRD, prledger PRL,
			(SELECT ICode, GroupCode = CASE :as_group WHEN 'M' THEN ManfCode WHEN 'C' THEN ICatCode WHEN 'L' THEN ICCode WHEN 'P' THEN PackCode END
			FROM Item) I
		 WHERE PRL.date between :ar_startdate and :ar_enddate and
			PRL.SalesManCode IN (:ar_usercode) AND
			PRL.posted IN (:as_status) and
  			PRL.prinvcode=PRD.prinvcode and
		 	PRD.icode=I.icode AND
			A.GroupCode = I.GroupCode), 2),
	NetPurchase=ROUND((SELECT ISNULL( SUM(((PD.looseqty + PD.packqty ) * PD.purprice ) * 
			(1 - (.01 *  PD.discperc))), 0) + 
			ISNULL( ROUND(SUM((PD.looseqty + PD.packqty + PD.bonusqty) * PD.unitsalestax) +
				SUM(ROUND((PD.looseqty + PD.packqty) * PD.purprice * (1 - (.01 * PD.discperc)) * 	PD.gstperc * .01, 2)) 
				/* + ROUND(SUM( ( ((PD.looseqty + PD.packqty) * PD.purprice) * (1 - (.01 * PD.discperc)) * (1 - (.01 * PL.discperc)) ) * 	(PL.invgstperc1 * .01) ) , 2) */ , 0) , 0)
		 FROM 
			purdetail PD, 
			purledger PL, 
			(SELECT ICode, GroupCode = CASE :as_group WHEN 'M' THEN ManfCode WHEN 'C' THEN ICatCode WHEN 'L' THEN ICCode WHEN 'P' THEN PackCode END
			FROM Item) I
		 WHERE 	PL.date between :ar_startdate and :ar_enddate and
			PL.purcatcode IN (:ar_purcatcode) AND
			PL.SalesManCode IN (:ar_usercode) AND
			PL.posted IN (:as_status) and
	       	PL.purinvcode=PD.purinvcode and
		 	PD.icode=I.icode AND
			A.GroupCode = I.GroupCode), 2)  -
		 ROUND((SELECT ISNULL( SUM(((PRD.looseqty + PRD.packqty ) * PRD.prprice ) * 
			(1 - (.01 *  PRD.discperc))), 0)
		 FROM 
			prdetail PRD, 
			prledger PRL, 
			(SELECT ICode, GroupCode = CASE :as_group WHEN 'M' THEN ManfCode WHEN 'C' THEN ICatCode WHEN 'L' THEN ICCode WHEN 'P' THEN PackCode END
			FROM Item) I
		 WHERE PRL.date between :ar_startdate and :ar_enddate and
			PRL.SalesManCode IN (:ar_usercode) AND
			PRL.posted IN (:as_status) and
	       	PRL.prinvcode=PRD.prinvcode and
		 	PRD.icode=I.icode AND
			A.GroupCode = I.GroupCode), 2),
	purchaseatsale=ROUND((SELECT ISNULL( SUM((( CASE WHEN PD.PACKQTY > 0 THEN ((PD.packqty + PD.BonusQty) * PD.packunits) ELSE (PD.looseqty + PD.BonusQty) END ) *
			(PD.saleprice / 
				CASE PD.packunits WHEN 0 THEN 1 ELSE PD.packunits END))), 0)
		 FROM 
			purdetail PD, 
			purledger PL, 
			(SELECT ICode, GroupCode = CASE :as_group WHEN 'M' THEN ManfCode WHEN 'C' THEN ICatCode WHEN 'L' THEN ICCode WHEN 'P' THEN PackCode END
			FROM Item) I
		 WHERE 	PL.date between :ar_startdate and :ar_enddate and
			PL.purcatcode IN (:ar_purcatcode) AND
			PL.SalesManCode IN (:ar_usercode) AND
			PL.posted IN (:as_status) and
	   		PL.purinvcode=PD.purinvcode and
		 	PD.icode=I.icode AND
			A.GroupCode = I.GroupCode), 2),
	preturnatsale =ROUND((SELECT ISNULL( SUM((( CASE WHEN PRD.PACKQTY > 0 THEN ((PRD.packqty + PRD.BonusQty) * PRD.packunits) ELSE (PRD.looseqty + PRD.BonusQty) END ) * 
			(PRD.packsaleprice / 
				CASE PRD.packunits WHEN 0 THEN 1 ELSE PRD.packunits END))), 0)
		 FROM 
			prdetail PRD, 
			prledger PRL, 
			(SELECT ICode, GroupCode = CASE :as_group WHEN 'M' THEN ManfCode WHEN 'C' THEN ICatCode WHEN 'L' THEN ICCode WHEN 'P' THEN PackCode END
			FROM Item) I
		 WHERE 
			PRL.date between :ar_startdate and :ar_enddate and
			PRL.SalesManCode IN (:ar_usercode) AND
			PRL.posted IN (:as_status) and
       			PRL.prinvcode=PRD.prinvcode and
		 	PRD.icode=I.icode AND
			A.GroupCode = I.GroupCode), 2),
	netpurchaseatsale=ROUND((SELECT ISNULL( SUM((( CASE WHEN PD.PACKQTY > 0 THEN ((PD.packqty + PD.BonusQty) * PD.packunits) ELSE (PD.looseqty + PD.BonusQty) END ) *
			(PD.saleprice / 
				CASE PD.packunits WHEN 0 THEN 1 ELSE PD.packunits END))), 0)
		 FROM 
			purdetail PD, 
			purledger PL, 
			(SELECT ICode, GroupCode = CASE :as_group WHEN 'M' THEN ManfCode WHEN 'C' THEN ICatCode WHEN 'L' THEN ICCode WHEN 'P' THEN PackCode END
			FROM Item) I
		 WHERE
		 	PL.date between :ar_startdate and :ar_enddate and
			PL.purcatcode IN (:ar_purcatcode) AND
			PL.SalesManCode IN (:ar_usercode) AND
			PL.posted IN (:as_status) and
	       	PL.purinvcode=PD.purinvcode and
		 	PD.icode=I.icode AND
			A.GroupCode = I.GroupCode), 2) -
		 ROUND((SELECT ISNULL( SUM((( CASE WHEN PRD.PACKQTY > 0 THEN ((PRD.packqty + PRD.BonusQty) * PRD.packunits) ELSE (PRD.looseqty + PRD.BonusQty) END ) * 
			(PRD.packsaleprice / 
				CASE PRD.packunits WHEN 0 THEN 1 ELSE PRD.packunits END))), 0)
		 FROM prdetail PRD, prledger PRL, 
			(SELECT ICode, GroupCode = CASE :as_group WHEN 'M' THEN ManfCode WHEN 'C' THEN ICatCode WHEN 'L' THEN ICCode WHEN 'P' THEN PackCode END
			FROM Item) I
		 WHERE 
			PRL.date between :ar_startdate and :ar_enddate and
			PRL.SalesManCode IN (:ar_usercode) AND
			PRL.posted IN (:as_status) and
   			PRL.prinvcode=PRD.prinvcode and
		 	PRD.icode=I.icode AND
			A.GroupCode = I.GroupCode), 2),
	totaldisc = (SELECT SUM(flatdisc) FROM purledger p
				    WHERE  p.date between :ar_startdate and :ar_enddate and
						P.purcatcode IN (:ar_purcatcode) AND 
						P.SalesManCode IN (:ar_usercode) AND
						p.posted IN (:as_status)),
	misccharg= (SELECT SUM(misccharges) FROM  purledger p
				   WHERE p.date between :ar_startdate and :ar_enddate and 
							P.purcatcode IN (:ar_purcatcode) AND
							P.SalesManCode IN (:ar_usercode) AND
							p.posted IN (:as_status)),
	totalinvdiscperc= (SELECT SUM(ISNULL(B.invdiscperc,0))
		     	   FROM
				  (SELECT invdiscperc = IsNull(SUM(Round(((d.looseqty + d.packqty ) * 
							d.purprice) * (1 - (.01 * d.discperc)),2)) * 0.01 * p.discperc, 0)
		 		  FROM     purledger p, purdetail d
		   	  WHERE	 (p.date between :ar_startdate and :ar_enddate) AND
							  P.purcatcode IN (:ar_purcatcode) AND
							  P.SalesManCode IN (:ar_usercode) AND
							  p.posted IN (:as_status) and p.purinvcode = d.purinvcode
				  GROUP BY p.purinvcode, p.discperc) AS  B),
	diff=(select Round(sum ( ISNULL(A.diff,0)), 2)
	      from
		(SELECT p.purinvcode, Diff=ROUND(SUM((d.looseqty + d.packqty) * d.purprice * 
				(1 - (.01 * d.discperc))) * (1- (.01 * p.discperc)) + 
				p.misccharges + p.salestax - p.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)) - 
				(SUM((d.looseqty + d.packqty) * d.purprice * 
				(1 - (.01 * d.discperc))) * (1- (.01 * p.discperc)) + 
				p.misccharges + p.salestax - p.flatdisc)
		FROM purledger p, purdetail d
		WHERE	(p.purinvcode = d.purinvcode) and p.posted IN (:as_status) and 
			P.purcatcode IN (:ar_purcatcode) AND
			P.SalesManCode IN (:ar_usercode) AND
			(p.date between :ar_startdate and :ar_enddate)
		GROUP BY p.purinvcode, p.suppcode, p.purcatcode, p.postdate, p.discperc,
			 p.misccharges, p.salestax, p.flatdisc, p.InvGSTPerc1) as A),
	SalesTax = 
		(SELECT ISNULL(Sum (ISNull(S.SaleTax,0)),0)
		FROM  (SELECT	
			SaleTax=ROUND(SUM((d.looseqty + d.packqty + d.bonusqty) * d.unitsalestax) +
			SUM(ROUND((d.looseqty + d.packqty) * d.purprice * (1 - (.01 * d.discperc)) * 
				d.gstperc * .01, 2)) +
			ROUND((SUM(((d.looseqty + d.packqty) * d.purprice) * 
				(1 - (.01 * d.discperc))) * (1 - (.01 * p.discperc)) - p.flatdisc) * 
				(p.invgstperc1 * .01), 2), ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0))
		FROM dbo.Purledger P, dbo.Purdetail D
		WHERE  (P.date between :ar_startdate and :ar_enddate)  And
			P.purcatcode IN (:ar_purcatcode) AND
			P.SalesManCode IN (:ar_usercode) AND
			P.posted IN (:as_status) and P.purinvcode = D.purinvcode
		GROUP BY P.purinvcode, 
			 P.invgstperc1, 
			 P.misccharges,   
			 P.flatdisc,
			 P.discperc) AS S)	

FROM
	(SELECT GroupCode = NULL, GroupName = 'NONE'
	WHERE :as_group = 'P' 
	UNION ALL
	SELECT GroupCode = ManfCode, GroupName = Name
	FROM Manufacturer
	WHERE :as_group = 'M' 
	UNION ALL
	SELECT GroupCode = ICatCode, GroupName = Name
	FROM ItemCategory
	WHERE :as_group = 'C' 
	UNION ALL
	SELECT GroupCode = ICCode, GroupName = Name
	FROM ItemClass
	WHERE :as_group = 'L' 
	UNION ALL
	SELECT GroupCode = PackCode, GroupName = Name
	FROM ItemPacking
	WHERE :as_group = 'P' ) A



/*

SELECT	A.icatcode,
	catname =(SELECT name FROM itemcategory WHERE icatcode=A.icatcode),
	itemsalestax=(SELECT ISNULL( ROUND(SUM((PD.looseqty + PD.packqty + PD.bonusqty) * PD.unitsalestax) +
						SUM(ROUND((PD.looseqty + PD.packqty) * PD.purprice * (1 - (.01 * PD.discperc)) * 
						PD.gstperc * .01, 2)) /* +
						ROUND(SUM( ( ((PD.looseqty + PD.packqty) * PD.purprice) * 
								(1 - (.01 * PD.discperc)) * (1 - (.01 * PL.discperc)) ) * 
								(PL.invgstperc1 * .01) ) , 2) */ , 0) , 0)
		 FROM purdetail PD, purledger PL, item I
		 WHERE 	PL.date between :ar_startdate and :ar_enddate and
					PL.purcatcode IN (:ar_purcatcode) AND
					PL.SalesManCode IN (:ar_usercode) AND
					PL.posted IN (:as_status) and
		       	PL.purinvcode=PD.purinvcode and
		 			PD.icode=I.icode AND
		 			I.icatcode=A.icatcode),
	purchase=ROUND((SELECT ISNULL( SUM(((PD.looseqty + PD.packqty ) * PD.purprice ) * 
			(1 - (.01 *  PD.discperc))), 0)
		 FROM purdetail PD, purledger PL, item I
		 WHERE 	PL.date between :ar_startdate and :ar_enddate and
					PL.purcatcode IN (:ar_purcatcode) AND
			PL.SalesManCode IN (:ar_usercode) AND
			PL.posted IN (:as_status) and
       	PL.purinvcode=PD.purinvcode and
		 	PD.icode=I.icode AND
		 	I.icatcode=A.icatcode), 2),
	preturn =ROUND((SELECT ISNULL( SUM(((PRD.looseqty + PRD.packqty ) * PRD.prprice ) * 
			(1 - (.01 *  PRD.discperc))), 0)
		 FROM prdetail PRD, prledger PRL, item I
		 WHERE PRL.date between :ar_startdate and :ar_enddate and
			PRL.SalesManCode IN (:ar_usercode) AND
			PRL.posted IN (:as_status) and
  			PRL.prinvcode=PRD.prinvcode and
		 	PRD.icode=I.icode AND
		 	I.icatcode=A.icatcode), 2),
	NetPurchase=ROUND((SELECT ISNULL( SUM(((PD.looseqty + PD.packqty ) * PD.purprice ) * 
			(1 - (.01 *  PD.discperc))), 0) + 
			ISNULL( ROUND(SUM((PD.looseqty + PD.packqty + PD.bonusqty) * PD.unitsalestax) +
				SUM(ROUND((PD.looseqty + PD.packqty) * PD.purprice * (1 - (.01 * PD.discperc)) * 	PD.gstperc * .01, 2)) 
				/* + ROUND(SUM( ( ((PD.looseqty + PD.packqty) * PD.purprice) * (1 - (.01 * PD.discperc)) * (1 - (.01 * PL.discperc)) ) * 	(PL.invgstperc1 * .01) ) , 2) */ , 0) , 0)
		 FROM purdetail PD, purledger PL, item I
		 WHERE 	PL.date between :ar_startdate and :ar_enddate and
			PL.purcatcode IN (:ar_purcatcode) AND
			PL.SalesManCode IN (:ar_usercode) AND
			PL.posted IN (:as_status) and
       	PL.purinvcode=PD.purinvcode and
		 	PD.icode=I.icode AND
		 	I.icatcode=A.icatcode), 2)  -
		 ROUND((SELECT ISNULL( SUM(((PRD.looseqty + PRD.packqty ) * PRD.prprice ) * 
			(1 - (.01 *  PRD.discperc))), 0)
		 FROM prdetail PRD, prledger PRL, item I
		 WHERE PRL.date between :ar_startdate and :ar_enddate and
			PRL.SalesManCode IN (:ar_usercode) AND
			PRL.posted IN (:as_status) and
       	PRL.prinvcode=PRD.prinvcode and
		 	PRD.icode=I.icode AND
		 	I.icatcode=A.icatcode), 2),
	purchaseatsale=ROUND((SELECT ISNULL( SUM((( CASE WHEN PD.PACKQTY > 0 THEN ((PD.packqty + PD.BonusQty) * PD.packunits) ELSE (PD.looseqty + PD.BonusQty) END ) *
			(PD.saleprice / 
				CASE PD.packunits WHEN 0 THEN 1 ELSE PD.packunits END))), 0)
		 FROM purdetail PD, purledger PL, item I
		 WHERE 	PL.date between :ar_startdate and :ar_enddate and
			PL.purcatcode IN (:ar_purcatcode) AND
			PL.SalesManCode IN (:ar_usercode) AND
			PL.posted IN (:as_status) and
   		PL.purinvcode=PD.purinvcode and
		 	PD.icode=I.icode AND
		 	I.icatcode=A.icatcode), 2),
	preturnatsale =ROUND((SELECT ISNULL( SUM((( CASE WHEN PRD.PACKQTY > 0 THEN ((PRD.packqty + PRD.BonusQty) * PRD.packunits) ELSE (PRD.looseqty + PRD.BonusQty) END ) * 
			(PRD.packsaleprice / 
				CASE PRD.packunits WHEN 0 THEN 1 ELSE PRD.packunits END))), 0)
		 FROM prdetail PRD, prledger PRL, item I
		 WHERE 
			PRL.date between :ar_startdate and :ar_enddate and
			PRL.SalesManCode IN (:ar_usercode) AND
			PRL.posted IN (:as_status) and
       			PRL.prinvcode=PRD.prinvcode and
		 	PRD.icode=I.icode AND
		 	I.icatcode=A.icatcode), 2),
	netpurchaseatsale=ROUND((SELECT ISNULL( SUM((( CASE WHEN PD.PACKQTY > 0 THEN ((PD.packqty + PD.BonusQty) * PD.packunits) ELSE (PD.looseqty + PD.BonusQty) END ) *
			(PD.saleprice / 
				CASE PD.packunits WHEN 0 THEN 1 ELSE PD.packunits END))), 0)
		 FROM purdetail PD, purledger PL, item I
		 WHERE
		 	PL.date between :ar_startdate and :ar_enddate and
			PL.purcatcode IN (:ar_purcatcode) AND
			PL.SalesManCode IN (:ar_usercode) AND
			PL.posted IN (:as_status) and
       	PL.purinvcode=PD.purinvcode and
		 	PD.icode=I.icode AND
		 	I.icatcode=A.icatcode), 2) -
		 ROUND((SELECT ISNULL( SUM((( CASE WHEN PRD.PACKQTY > 0 THEN ((PRD.packqty + PRD.BonusQty) * PRD.packunits) ELSE (PRD.looseqty + PRD.BonusQty) END ) * 
			(PRD.packsaleprice / 
				CASE PRD.packunits WHEN 0 THEN 1 ELSE PRD.packunits END))), 0)
		 FROM prdetail PRD, prledger PRL, item I
		 WHERE 
			PRL.date between :ar_startdate and :ar_enddate and
			PRL.SalesManCode IN (:ar_usercode) AND
			PRL.posted IN (:as_status) and
       			PRL.prinvcode=PRD.prinvcode and
		 	PRD.icode=I.icode AND
		 	I.icatcode=A.icatcode), 2),
	totaldisc = (SELECT SUM(flatdisc) FROM purledger p
				    WHERE  p.date between :ar_startdate and :ar_enddate and
						P.purcatcode IN (:ar_purcatcode) AND 
						P.SalesManCode IN (:ar_usercode) AND
						p.posted IN (:as_status)),
	misccharg= (SELECT SUM(misccharges) FROM  purledger p
				   WHERE p.date between :ar_startdate and :ar_enddate and 
							P.purcatcode IN (:ar_purcatcode) AND
							P.SalesManCode IN (:ar_usercode) AND
							p.posted IN (:as_status)),
	totalinvdiscperc= (SELECT SUM(ISNULL(B.invdiscperc,0))
		     	   FROM
				  (SELECT invdiscperc = IsNull(SUM(Round(((d.looseqty + d.packqty ) * 
							d.purprice) * (1 - (.01 * d.discperc)),2)) * 0.01 * p.discperc, 0)
		 		  FROM     purledger p, purdetail d
		   	  WHERE	 (p.date between :ar_startdate and :ar_enddate) AND
							  P.purcatcode IN (:ar_purcatcode) AND
							  P.SalesManCode IN (:ar_usercode) AND
							  p.posted IN (:as_status) and p.purinvcode = d.purinvcode
				  GROUP BY p.purinvcode, p.discperc) AS  B),
	diff=(select Round(sum ( ISNULL(A.diff,0)), 2)
	      from
		(SELECT p.purinvcode, Diff=ROUND(SUM((d.looseqty + d.packqty) * d.purprice * 
				(1 - (.01 * d.discperc))) * (1- (.01 * p.discperc)) + 
				p.misccharges + p.salestax - p.flatdisc, 0) - 
				(SUM((d.looseqty + d.packqty) * d.purprice * 
				(1 - (.01 * d.discperc))) * (1- (.01 * p.discperc)) + 
				p.misccharges + p.salestax - p.flatdisc)
		FROM purledger p, purdetail d
		WHERE	(p.purinvcode = d.purinvcode) and p.posted IN (:as_status) and 
			P.purcatcode IN (:ar_purcatcode) AND
			P.SalesManCode IN (:ar_usercode) AND
			(p.date between :ar_startdate and :ar_enddate)
		GROUP BY p.purinvcode, p.suppcode, p.purcatcode, p.postdate, p.discperc,
			 p.misccharges, p.salestax, p.flatdisc, p.InvGSTPerc1) as A),
	SalesTax = 
		(SELECT ISNULL(Sum (ISNull(S.SaleTax,0)),0)
		FROM  (SELECT	
			SaleTax=ROUND(SUM((d.looseqty + d.packqty + d.bonusqty) * d.unitsalestax) +
			SUM(ROUND((d.looseqty + d.packqty) * d.purprice * (1 - (.01 * d.discperc)) * 
				d.gstperc * .01, 2)) +
			ROUND((SUM(((d.looseqty + d.packqty) * d.purprice) * 
				(1 - (.01 * d.discperc))) * (1 - (.01 * p.discperc)) - p.flatdisc) * 
				(p.invgstperc1 * .01), 2), 0)
		FROM dbo.Purledger P, dbo.Purdetail D
		WHERE  (P.date between :ar_startdate and :ar_enddate)  And
			P.purcatcode IN (:ar_purcatcode) AND
			P.SalesManCode IN (:ar_usercode) AND
			P.posted IN (:as_status) and P.purinvcode = D.purinvcode
		GROUP BY P.purinvcode, 
			 P.invgstperc1, 
			 P.misccharges,   
			 P.flatdisc,
			 P.discperc) AS S)	

FROM 	(SELECT DISTINCT (item.icatcode) AS icatcode 
	FROM purdetail, purledger, item 
	WHERE purledger.date between :ar_startdate and :ar_enddate and
		 purledger.purcatcode IN (:ar_purcatcode) AND
		 purledger.SalesManCode IN (:ar_usercode) AND
	    purledger.purinvcode=purdetail.purinvcode and
	    purdetail.icode=item.icode   
	UNION
	SELECT DISTINCT (item.icatcode) as icatcode 
	FROM prdetail,prledger,item 
   WHERE 
		prledger.date between :ar_startdate and :ar_enddate and
		prledger.SalesManCode IN (:ar_usercode) AND
	   prledger.prinvcode=prdetail.prinvcode and
	   prdetail.icode=item.icode) as A

*/"
  arguments=(("as_group", string), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_usercode", numberlist), ("ar_userlist", string), ("ar_purcatcode", numberlist), ("ar_categoryname", string), ("as_status", stringlist))
)
