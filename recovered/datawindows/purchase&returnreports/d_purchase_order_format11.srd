release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1458 color="536870912" )
summary(height=229 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=pocode dbname="pocode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=datetime updatewhereclause=yes name=startdate dbname="startdate"  )
column=(type=datetime updatewhereclause=yes name=enddate dbname="enddate"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="supplier"  )
column=(type=char(12) updatewhereclause=yes name=supplieralias dbname="supplieralias"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=decimal(4) updatewhereclause=yes name=openqty dbname="openqty"  )
column=(type=decimal(6) updatewhereclause=yes name=openvalue dbname="openvalue"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalue dbname="PurValue"  )
column=(type=decimal(4) updatewhereclause=yes name=pretqty dbname="PRetQty"  )
column=(type=decimal(6) updatewhereclause=yes name=pretvalue dbname="PRetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(4) updatewhereclause=yes name=sretqty dbname="SRetQty"  )
column=(type=decimal(6) updatewhereclause=yes name=sretvalue dbname="SRetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=issueqty dbname="IssueQty"  )
column=(type=decimal(6) updatewhereclause=yes name=issuevalue dbname="IssueValue"  )
column=(type=decimal(4) updatewhereclause=yes name=duesatisfyqty dbname="DueSatisfyQty"  )
column=(type=decimal(6) updatewhereclause=yes name=duesatisfyvalue dbname="DueSatisfyValue"  )
column=(type=decimal(4) updatewhereclause=yes name=receiptqty dbname="ReceiptQty"  )
column=(type=decimal(6) updatewhereclause=yes name=receiptvalue dbname="ReceiptValue"  )
column=(type=decimal(4) updatewhereclause=yes name=adjqty dbname="AdjQty"  )
column=(type=decimal(6) updatewhereclause=yes name=adjvalue dbname="AdjValue"  )
column=(type=decimal(4) updatewhereclause=yes name=orderqty dbname="OrderQty"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
 retrieve="SELECT
	pocode=o.pocode,
	date=o.date,
	startdate=isnull(o.startdate, o.date), 
	enddate=isnull(o.enddate, getdate()),
	supplier=a.name,
	supplieralias = a.aliasname,
	username=u.username,
	ICode=St.Icode,
	AliasName= i.customicode,
	Item = i.name,
	Code = i.icatcode,
	packingdesc=max(i.packingdesc),
	Name = ic.Name,
	Manufacturer = M.Name,
	openqty	  =SUM(CASE WHEN st.type='OP' THEN st.qty ELSE 0 END),
	openvalue =SUM(CASE WHEN st.type='OP' THEN st.value ELSE 0 END),
	PurQty 	  =SUM(CASE WHEN st.type='PV' THEN st.qty ELSE 0 END),
	PurValue  =SUM(CASE WHEN st.type='PV' THEN st.value ELSE 0 END),
	PRetQty	  =SUM(CASE WHEN st.type='PR' THEN st.qty ELSE 0 END),
	PRetValue =SUM(CASE WHEN st.type='PR' THEN st.value ELSE 0 END),
	SaleQty	  =SUM(CASE WHEN st.type='SV' THEN st.qty ELSE 0 END),
	SaleValue =SUM(CASE WHEN st.type='SV' THEN st.value ELSE 0 END),
	SRetQty	  =SUM(CASE WHEN st.type='SR' THEN st.qty ELSE 0 END),
	SRetValue =SUM(CASE WHEN st.type='SR' THEN st.value ELSE 0 END),
	IssueQty  =SUM(CASE WHEN st.type='IV' THEN st.qty ELSE 0 END),
	IssueValue=SUM(CASE WHEN st.type='IV' THEN st.value ELSE 0 END),
	DueSatisfyQty  =SUM(CASE WHEN st.type='DS' THEN st.qty ELSE 0 END),
	DueSatisfyValue=SUM(CASE WHEN st.type='DS' THEN st.value ELSE 0 END),
	ReceiptQty=SUM(CASE WHEN st.type='RV' THEN st.qty ELSE 0 END),
	ReceiptValue=SUM(CASE WHEN st.type='RV' THEN st.value ELSE 0 END),
	AdjQty	  =SUM(CASE WHEN st.type='AI' THEN st.qty WHEN type='AD' THEN -st.qty ELSE 0 END),
	AdjValue  =SUM(CASE  WHEN st.type='AI' THEN st.value WHEN type='AD' THEN -st.value ELSE 0 END),
	OrderQty = SUM(od.Qty),
	Rate = max(od.rate),
	DiscPerc = max(od.DiscPerc),
	BonusQty = SUM(od.BonusQty)
FROM
	Item i, 
	itemcategory ic,
	Manufacturer M,
	purorderheader o, 
	purorderdetail od,
	supplier s,
	accounts a,
	users u,
	(SELECT type='OP', a.icode, qty = sum(a.qty), value=0
	FROM	(select	pd.icode, qty = sum(isnull(case pl.purcatcode 
			when 1 THEN (packqty + bonusqty) * packunits
			when 2 THEN (packqty + bonusqty) * packunits
			else looseqty + bonusqty end, 0))
	FROM purledger pl, purdetail pd, 
		(select o.pocode, startdate=isnull(o.startdate, o.date), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND 
		pd.icode = po.icode and pl.date < po.startdate
	Group By pd.icode
	UNION ALL
	select	pd.icode,
		qty  = - sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits)
	FROM prledger pl, prdetail pd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE /*pl.posted = 'Y' AND*/ pl.prinvcode = pd.prinvcode AND 
		pd.icode = po.icode and pl.date < po.startdate
	Group By pd.icode
	UNION ALL
	select	sd.icode,
		qty  = -sum(sd.looseqty + sd.bonusqty)
	FROM saleledger sl, saledetail sd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE /*sl.posted = 'Y' AND*/ sl.saleinvcode = sd.saleinvcode AND 
		sd.icode = po.icode and sl.date < po.startdate AND sd.Due IS NULL
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = sum(sd.looseqty + sd.bonusqty)
	FROM srledger sl, srdetail sd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND 
		sd.icode = po.icode and sl.date < po.startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = -sum(sd.qty)
	FROM issueheader sl, issuedetail sd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE /*sl.posted = 'Y' AND*/ sl.issueinvcode = sd.issueinvcode AND
		sd.icode = po.icode and sl.date < po.startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = sum(sd.qty)
	FROM receiptheader sl, receiptdetail sd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
		sd.icode = po.icode and sl.date < po.startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty = sum(sd.looseqty)
	FROM Adjheader sl, Adjdetail sd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		sd.icode = po.icode and sl.date < po.startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty = -sum(sd.looseqty)
	FROM Adjheader sl, Adjdetail sd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		sd.icode = po.icode and sl.date < po.startdate
	Group By sd.icode
	UNION ALL
	select	d.icode,
		qty = -sum(d.duesatisfyqty)
	FROM duesatisfyheader h, duesatisfydetail d,
		(select o.pocode, startdate=isnull(o.startdate, o.date), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE h.duesatisfycode=d.duesatisfycode AND
		d.icode = po.icode and h.duesatisfydate < po.startdate
	Group By d.icode) A
	GROUP BY icode
	UNION ALL
	select	type='PV',
		pd.icode,
		qty = sum(case pl.purcatcode when 1 THEN (packqty + bonusqty) * packunits
				when 2 THEN (packqty + bonusqty) * packunits
				else (looseqty + bonusqty) end),
		value = sum(isnull(case pl.purcatcode 
			when 1 THEN (packqty + bonusqty)
			when 2 THEN (packqty + bonusqty)
			else looseqty + bonusqty 
			end, 0) * pd.purprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01))
	FROM purledger pl, purdetail pd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), enddate=isnull(o.enddate, getdate()), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND 
		pd.icode = po.icode and pl.date BETWEEN po.startdate and po.enddate 
	Group By pd.icode
	UNION ALL
	select	type='PR',
		pd.icode,
		qty = sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits),
		value = sum((pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits) *
			pd.prprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01))
	FROM prledger pl, prdetail pd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), enddate=isnull(o.enddate, getdate()), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE /*pl.posted = 'Y' AND*/ pl.prinvcode = pd.prinvcode AND
		pd.icode = po.icode and pl.date BETWEEN po.startdate and po.enddate 
	Group By pd.icode
	UNION ALL
	select	type='SV',
		sd.icode,
		qty = sum(sd.looseqty + sd.bonusqty + sd.packqty * sd.packunits),
		value = sum((sd.looseqty + sd.bonusqty + sd.packqty * sd.packunits) *
			sd.saleprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01))
	FROM saleledger sl, saledetail sd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), enddate=isnull(o.enddate, getdate()), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE /*sl.posted = 'Y' AND */ sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
		sd.icode = po.icode and sl.date BETWEEN po.startdate and po.enddate 
	Group By sd.icode
	UNION ALL
	select	type='SR',
		sd.icode,
		qty = sum(sd.looseqty + sd.bonusqty + sd.packqty * sd.packunits),
		value = sum((sd.looseqty + sd.bonusqty + sd.packqty * sd.packunits) *
			sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01))
	FROM srledger sl, srdetail sd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), enddate=isnull(o.enddate, getdate()), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
		sd.icode = po.icode and sl.date BETWEEN po.startdate and po.enddate 
	Group By sd.icode
	UNION ALL
	select	type='IV',
		sd.icode,
		qty = sum(sd.qty),
		value = sum(sd.qty * sd.saleprice)
	FROM issueheader sl, issuedetail sd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), enddate=isnull(o.enddate, getdate()), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE /*sl.posted = 'Y' AND */ sl.issueinvcode = sd.issueinvcode AND
		sd.icode = po.icode and sl.date BETWEEN po.startdate and po.enddate 
	Group By sd.icode
	UNION ALL
	select	type='DS',
		d.icode,
		qty = sum(d.duesatisfyqty),
		value = sum(d.duesatisfyqty * (d.packsaleprice / case d.packunits when 0 then 1 else d.packunits end))
	FROM duesatisfyheader h, duesatisfydetail d,
		(select o.pocode, startdate=isnull(o.startdate, o.date), enddate=isnull(o.enddate, getdate()), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE h.duesatisfycode = d.duesatisfycode AND
		d.icode = po.icode and h.duesatisfydate BETWEEN po.startdate and po.enddate 
	Group By d.icode
	UNION ALL
	select	type='RV',
		sd.icode,
		qty = sum(sd.qty),
		value = sum(sd.qty * sd.saleprice)
	FROM receiptheader sl, receiptdetail sd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), enddate=isnull(o.enddate, getdate()), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
		sd.icode = po.icode and sl.date BETWEEN po.startdate and po.enddate 
	Group By sd.icode
	UNION ALL
	select	type='AI',
		sd.icode,
		qty = sum(sd.looseqty),
		value = sum(sd.looseqty * sd.price)
	FROM Adjheader sl, Adjdetail sd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), enddate=isnull(o.enddate, getdate()), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		sd.icode = po.icode and sl.date BETWEEN po.startdate and po.enddate 
	Group By sd.icode
	UNION ALL
	select	type='AD',
		sd.icode,
		qty = sum(sd.looseqty),
		value = sum(sd.looseqty * sd.price)
	FROM Adjheader sl, Adjdetail sd,
		(select o.pocode, startdate=isnull(o.startdate, o.date), enddate=isnull(o.enddate, getdate()), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		sd.icode = po.icode and sl.date BETWEEN po.startdate and po.enddate 
	Group By sd.icode
	UNION ALL
	SELECT type='OP', item.icode, qty = 0, value=0 
	FROM ITEM,
		(select o.pocode, startdate=isnull(o.startdate, o.date), enddate=isnull(o.enddate, getdate()), od.icode
		from purorderheader o, purorderdetail od
		where o.POCode = :ai_code and o.pocode = od.pocode) po
	WHERE PO.Icode = Item.ICode) St
WHERE 
	o.POCode = :ai_code and
	o.suppcode = s.suppcode and
	s.suppcode = a.acccode and
	o.salesmancode = u.usercode and 
	o.pocode = od.pocode and
	st.icode = i.icode and
	i.icatcode = ic.icatcode AND
	i.manfcode = M.ManfCode and
	i.icode = od.icode
GROUP BY 
	o.pocode, o.date, o.startdate, o.enddate, a.name, a.aliasname, u.username, St.icode, i.name, i.customicode, i.icatcode, 
	ic.Name, M.Name, i.saleprice, i.packunits
ORDER BY 
	ic.name, i.name, M.Name
"
  arguments=(("ai_code", number))
 sort="name A, item A"
)
group(level=1 header.height=187 trailer.height=260 by=("name"  ) header.color="536870912" trailer.color="536870912" )
text(name=t_16 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" alignment="2" border="0" x="52" y="52" height="156" width="7979" text="Purchase Order Report" html.valueishtml="0" )
compute(name=compute_1 visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="437" y="62" height="156" width="1395" format="dd/mm/yyyy hh:mm:ss" expression="today()" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
text(name=t_17 visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="0" border="0" x="52" y="62" height="156" width="343" text="Date: " html.valueishtml="0" )
compute(name=compute_2 visible="1" band=header font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="6395" y="52" height="166" width="1635" format="[general]" expression="'Page ' + page() + ' of ' + pageCount()" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_companyname visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="52" y="250" height="156" width="7979" format="[general]" expression="f_ReportHeaderInfo('clientname')" alignment="2" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_address1 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="52" y="437" height="156" width="7979" format="[general]" expression="f_ReportHeaderInfo('address1')" alignment="2" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_address2 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="52" y="625" height="156" width="7979" format="[general]" expression="f_ReportHeaderInfo('address2')" alignment="2" border="0" html.valueishtml="0" crosstab.repeat=no )
line(name=l_2 visible="1" band=header background.mode="2" background.color="16777215" pen.style="0" pen.width="10" pen.color="0" x1="52" y1="1437" x2="8031" y2="1437" )
text(name=item_t visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="2" border="0" x="52" y="1239" height="166" width="1864" text="Item Name" html.valueishtml="0" )
text(name=c_netpurqty_t visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="2" border="0" x="4364" y="1239" height="166" width="750" text="Net Purchased" html.valueishtml="0" )
text(name=netsale_t visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="1" border="0" x="5145" y="1239" height="166" width="729" text="Net Sold" html.valueishtml="0" )
