table(column=(type=char(13) updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type"  )
column=(type=char(100) updatewhereclause=yes name=suppliercategory dbname="SupplierCategory"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
 retrieve="SELECT 
	documentcode = 'PV-' + LTRIM(RTRIM(STR(PL.PURINVCODE, 10))), 
	Type = 'P', 
	SupplierCategory = SC.Name,
	InvCode=PL.PurInvCode, 
	Date=PL.Date, 
	SuppCode=PL.SuppCode, 
	AliasName = AC.AliasName,
	SupplierName=AC.Name, 
	Address1=S.Address1, 
	Address2=S.Address2, 
	Amount = PL.InvTotal
FROM 
	SupplierCategory SC, PurLedger PL, Accounts AC, Supplier S
WHERE
	PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
	PL.SuppCode = AC.AccCode AND
	AC.AccCode = S.SuppCode AND
	S.SuppCatCode = SC.SuppCatCode AND
	SC.SuppCatCode IN (:ai_suppcatcode)
UNION ALL
SELECT 
	documentcode = 'PR-' + LTRIM(RTRIM(STR(PL.PRINVCODE, 10))), 
	Type = 'R',
	SupplierCategory = SC.Name,
	InvCode=PL.PrInvCode, 
	Date=PL.Date, 
	SuppCode=PL.SuppCode, 
	AliasName = AC.AliasName,
	SupplierName=AC.Name, 
	Address1=S.Address1, 
	Address2=S.Address2, 
	Amount = -(PL.InvTotal)
FROM 
	SupplierCategory SC, PrLedger PL, Accounts AC, Supplier S
WHERE
	PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
	PL.SuppCode = AC.AccCode AND
	AC.AccCode = S.SuppCode AND
	S.SuppCatCode = SC.SuppCatCode AND
	SC.SuppCatCode IN (:ai_suppcatcode)
ORDER BY 
	SupplierCategory,
	SupplierName, 
	Date, 
	Type,
	InvCode"
  arguments=(("ai_suppcatcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
