release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1270 color="536870912" )
summary(height=218 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(20) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=decimal(6) update=yes updatewhereclause=yes name=purvalueattp dbname="PurValueAtTP"  )
column=(type=decimal(6) update=yes updatewhereclause=yes name=purvalueatsp dbname="PurValueAtSP"  )
column=(type=decimal(6) update=yes updatewhereclause=yes name=purvalueatnp dbname="PurValueAtNP"  )
column=(type=decimal(6) update=yes updatewhereclause=yes name=salestax dbname="SalesTax"  )
 retrieve="SELECT 
	GroupCode=T.GroupCode,
	GroupName= 
		CASE :as_group 
			WHEN 'M' THEN 
				(SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = T.GroupCode) 
			WHEN 'C' THEN 
				(SELECT C.Name FROM ItemCategory C WHERE C.ICatCode = T.GroupCode) 
			WHEN 'L' THEN 
				(SELECT L.Name FROM ItemClass L WHERE L.ICCode = T.GroupCode) 
			ELSE 
				(SELECT P.Name FROM ItemPacking P WHERE P.PackCode = T.GroupCode) 
		END,
	PurValueAtTP = SUM(T.PurValueAtTP),
	PurValueAtSP = SUM(T.PurValueAtSP),
	PurValueAtNP = SUM(T.PurValueAtNP),
	SalesTax = SUM(T.SalesTax)
FROM
	(SELECT 
		GroupCode = CASE :as_group WHEN 'M' THEN I.ManfCode WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PackCode END,
		PurValueAtTP = SUM((PD.LooseQty + PD.BonusQty) * Round(PD.Rate / CASE WHEN PD.PackUnits IS NULL OR PD.PackUnits = 0 THEN 1 ELSE PD.PackUnits END, 2)),
		PurValueAtSP = SUM((PD.LooseQty + PD.BonusQty) * Round(PD.SalePriceForItem / CASE WHEN PD.PackUnits IS NULL OR PD.PackUnits = 0 THEN 1 ELSE PD.PackUnits END, 2)),
		PurValueAtNP = SUM((PD.LooseQty + PD.BonusQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * (1 - PL.DiscPerc * 0.01)),
		SalesTax = SUM((PD.LooseQty + PD.BonusQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * PD.GSTPerc * 0.01) + 
				SUM((PD.LooseQty + PD.BonusQty) * PD.UnitSalesTax)
	FROM
		PurLedger PL,
		PurDetail PD,
		Item I
	WHERE 
		PL.PurCatCode NOT IN (1,2) AND
		PL.Posted = 'Y' AND
		PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		PL.PurInvCode = PD.PurInvCode AND
		PD.ICode = I.ICode AND
		CASE :as_group WHEN 'M' THEN I.ManfCode WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PackCode END IN (:ai_groupcode)
	GROUP BY
		I.ManfCode,
		I.ICatCode,
		I.ICCode,
		I.PackCode
	UNION ALL
	SELECT 
		GroupCode = CASE :as_group WHEN 'M' THEN I.ManfCode WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PackCode END,
		PurValueAtTP = SUM((PD.PackQty + PD.BonusQty) * PD.Rate),
		PurValueAtSP = SUM((PD.PackQty + PD.BonusQty) * PD.SalePriceForItem),
		PurValueAtNP = SUM((PD.PackQty + PD.BonusQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * (1 - PL.DiscPerc * 0.01)),
		SalesTax = SUM((PD.LooseQty + PD.BonusQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01) * PD.GSTPerc * 0.01) + 
				SUM((PD.LooseQty + PD.BonusQty) * PD.UnitSalesTax)
	FROM
		PurLedger PL,
		PurDetail PD,
		Item I
	WHERE 
		PL.PurCatCode IN (1,2) AND
		PL.Posted = 'Y' AND
		PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		PL.PurInvCode = PD.PurInvCode AND
		PD.ICode = I.ICode AND
		CASE :as_group WHEN 'M' THEN I.ManfCode WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PackCode END IN (:ai_groupcode)
	GROUP BY
		I.ManfCode,
		I.ICatCode,
		I.ICCode,
		I.PackCode
	UNION ALL
	SELECT 
		GroupCode = CASE :as_group WHEN 'M' THEN I.ManfCode WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PackCode END,
		PurValueAtTP = - SUM((PD.LooseQty + PD.BonusQty) * PD.PRPrice),
		PurValueAtSP = - SUM((PD.LooseQty + PD.BonusQty) * Round(PD.PackSalePrice / CASE WHEN PD.PackUnits IS NULL OR PD.PackUnits = 0 THEN 1 ELSE PD.PackUnits END, 2)),
		PurValueAtNP = - SUM((PD.LooseQty + PD.BonusQty) * PD.PRPrice * (1 - PD.DiscPerc * 0.01) * (1 - PL.DiscPerc * 0.01)),
		SalesTax = - SUM((PD.LooseQty + PD.BonusQty) * PD.PrPrice * (1 - PD.DiscPerc * 0.01) * PD.GSTPerc * 0.01) + 
				SUM((PD.LooseQty + PD.BonusQty) * PD.UnitSalesTax)
	FROM
		PrLedger PL,
		PrDetail PD,
		Item I
	WHERE 
		PL.Posted = 'Y' AND
		PL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		PL.PrInvCode = PD.PrInvCode AND
		PD.ICode = I.ICode AND
		CASE :as_group WHEN 'M' THEN I.ManfCode WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PackCode END IN (:ai_groupcode)
	GROUP BY
		I.ManfCode,
		I.ICatCode,
		I.ICCode,
		I.PackCode) T
GROUP BY
	T.GroupCode
"
  arguments=(("as_group", string), ("ai_groupcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="groupname A"
)
