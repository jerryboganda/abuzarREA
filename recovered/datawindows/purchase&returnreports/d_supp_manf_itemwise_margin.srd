release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=564 color="536870912" )
summary(height=140 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(60) updatewhereclause=yes name=manf dbname="Manf"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(13) updatewhereclause=yes name=avgpurprice dbname="avgpurprice"  )
column=(type=decimal(13) updatewhereclause=yes name=avgsaleprice dbname="avgSalePrice"  )
 retrieve="SELECT Supplier=A.name,
	Manf=M.name,
	Item=I.name, 
	qty=Sum(PD.looseqty+PD.PackQty*PD.packunits),
	avgpurprice=avg(CASE  when PL.purcatcode IN (3,7,8)THEN PD.Purprice ELSE PD.purprice/(case PD.packunits when 0 then 1 else PD.packunits end) END),
	avgSalePrice=avg(PD.Saleprice/(case PD.packunits when 0 then 1 else PD.packunits end))
FROM 
	Accounts A,
	PurLedger PL,
	Purdetail PD,
	Manufacturer M,
	Item I

WHERE 
	PL.date>= :ad_StartDate AND PL.date<=:ad_EndDate AND
	PL.suppcode IN (:aa_suppcode) AND
	PL.purinvcode=PD.purinvcode AND
	PL.suppcode=A.acccode AND
	PD.icode=I.icode AND
	I.manfcode IN (:aa_manfcode) AND
	I.manfcode=M.manfcode
GROUP BY
	
	A.name,
	M.name,
	I.name
ORDER BY
	Supplier,
	Manf,
	Item
"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("aa_suppcode", numberlist), ("aa_manfcode", numberlist))
)
