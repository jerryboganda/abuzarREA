header(height=3000 color="536870912" )
summary(height=0 color="536870912" )
footer(height=10 color="536870912" )
detail(height=239 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.name"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=long updatewhereclause=yes name=pocode dbname="PurOrderHeader.POCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.Date"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Supplier.address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Supplier.address2"  )
column=(type=char(30) updatewhereclause=yes name=city dbname="Supplier.city"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Supplier.phone"  )
column=(type=char(16) updatewhereclause=yes name=fax dbname="Supplier.fax"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="PurOrderHeader.remarks"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms1 dbname="PurOrderHeader.purorderterms1"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms2 dbname="PurOrderHeader.purorderterms2"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms3 dbname="PurOrderHeader.purorderterms3"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms4 dbname="PurOrderHeader.purorderterms4"  )
