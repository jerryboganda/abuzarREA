table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=datetime updatewhereclause=yes name=requireddate dbname="RequiredDate"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(50) updatewhereclause=yes name=ordercategory dbname="ordercategory"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Accounts.name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.aliasname"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(12) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(7) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsalestax dbname="itemsalestax"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="postdate"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(1) updatewhereclause=yes name=marked dbname="Marked"  )
 retrieve="SELECT 
	invcode = H.POCode,    
	date = H.date,    
	RequiredDate=H.RequiredDate,
	flatdisc = H.flatdisc,
	misccharges = H.misccharges , 
	invdiscperc = H.discperc , 
	invgstperc1 = H.invgstperc1 , 
	ordercategory=C.name,
	accounts.name, 
	accounts.aliasname, 
	amount =  Sum (D.Qty * D.Rate), 
	itemdiscpercvalue = Sum ( D.Qty * D.Rate * (D.discperc / 100)),    
	invdiscpercvalue = Sum ( D.Qty * D.Rate * (1 - D.discperc / 100)) * (H.discperc / 100)    ,
	itemsalestax = Sum (Round ( (D.Qty + D.bonusqty) * D.PackSalesTax + Round ( Round ( D.Qty * D.Rate * (1 - D.discperc * 0.01 ), 2 ) * D.gstperc * 0.01 , 2 ) , 2 ) ) ,
	posted= H.posted,
	postdate=H.postdate,
	Remarks=H.Remarks,
	Marked=H.Marked
FROM 
	PurOrderHeader H, PurOrderDetail D, Accounts, PurOrderCategory C
WHERE 
	H.POCode = D.POCode AND
	H.PurOrderCatCode = C.PurOrderCatCode AND
	H.suppcode = accounts.acccode AND
	H.date between :ar_StartDate and :ar_EndDate
GROUP BY 
	accounts.name,   
	accounts.aliasname,   
	H.misccharges,   
	H.flatdisc,   
	H.date,
	H.RequiredDate,
	H.postdate,   
	H.POCode, 
	C.name,  
	H.discperc,  
	H.invgstperc1,
	H.PurOrderCatCode,
	H.posted,
	H.Remarks,
	H.Marked
ORDER BY 
	H.POCode ASC,   
	H.date ASC   

"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
