table(column=(type=long updatewhereclause=yes name=pocode dbname="POCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(12) updatewhereclause=yes name=suppaliasname dbname="SuppAliasName"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=decimal(4) updatewhereclause=yes name=poqty dbname="POQty"  )
column=(type=decimal(4) updatewhereclause=yes name=pobonus dbname="POBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(4) updatewhereclause=yes name=purbonus dbname="PurBonus"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="PurPrice"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	POCode = H.POCode,
	Date = H.Date,
	Remarks = H.Remarks,
	SuppCode = H.SuppCode,
	SuppAliasName = A.AliasName,
	SupplierName = A.Name,
	ICode = D.ICode,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	Manufacturer = M.Name,
	POQty = ISNULL(SUM(D.Qty), 0),
	POBonus = ISNULL(SUM(D.BonusQty), 0),
	PurQty = ISNULL((SELECT SUM(PD.PackQty + PD.LooseQty) FROM PurDetail PD , PurLedger PL 
		WHERE PL.POCode = H.POCode AND PL.PurInvCode = PD.PurInvCode AND PD.ICode=D.ICode),0),
	PurBonus = ISNULL((SELECT SUM(PD.BonusQty) FROM PurDetail PD , PurLedger PL 
		WHERE PL.POCode = H.POCode AND PL.PurInvCode = PD.PurInvCode AND PD.ICode=D.ICode),0),
	PurPrice = D.Rate,
	Posted = H.Posted
FROM
	PurOrderDetail D,
	PurOrderHeader H,
	Supplier S,
	Accounts A,
	Item I,
	Manufacturer M
WHERE
	H.POCode IN (:ai_pocode) AND
	H.SuppCode = S.SuppCode AND
	S.SuppCode = A.AccCode AND
	H.POCode = D.POCode AND
	D.ICode=I.ICode AND
	I.ManfCode = M.ManfCode
GROUP BY
	H.POCode,
	A.AliasName,
	A.Name,
	H.Date,
	H.Posted,
	H.Remarks,
	H.SuppCode,
	D.ICode,
	D.Rate,
	D.PurPrice,
	I.CustomICode,
	I.Name,
	M.Name
"
  arguments=(("ai_pocode", numberlist))
 sort="suppliername A, pocode A, itemname A"
 filter="( poqty - purqty ) <> 0 OR  (pobonus - purbonus <> 0)"
 )
