table(column=(type=long updatewhereclause=yes name=purinvcode dbname="purinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(7) updatewhereclause=yes name=invtype dbname="invtype"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(4) updatewhereclause=yes name=quantity dbname="quantity"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(8) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(13) updatewhereclause=yes name=loosesaleprice dbname="loosesaleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=packsaleprice dbname="packsaleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(30) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=person dbname="Person"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
 retrieve="SELECT 
	purinvcode = dbo.purledger.purinvcode,    
	date = dbo.purledger.date, 
	invdiscperc = dbo.purledger.discperc, 
	invgstperc1 = dbo.purledger.invgstperc1,
	flatdisc = dbo.purledger.flatdisc,    
	misccharges = dbo.purledger.misccharges, 
	invsalestax = dbo.purledger.salestax, 
	aliasname=item.customicode,
	invtype = Case dbo.purledger.purcatcode 	When 1 Then 'Pack' 	
														When 2 Then 'Pack' 
														When 7 Then 'Loose '
														When 8 Then 'Loose '
														Else 'Opening' End,  	   
	looseqty = dbo.purdetail.looseqty, 
	packqty  = purdetail.packqty, 
	quantity = dbo.purdetail.looseqty + purdetail.packqty, 
	bonusqty  = purdetail.bonusqty, 	  
	unitsalestax  = purdetail.unitsalestax, 
	gstperc = purdetail.gstperc,	
	saleprice = CASE purledger.purcatcode When 1 Then purdetail.saleprice
													When 2 Then purdetail.saleprice
													When 3 Then Round(purdetail.saleprice / purdetail.packunits, 2)
													When 7 Then Round(purdetail.saleprice / purdetail.packunits, 2)
													When 8 Then Round(purdetail.saleprice / purdetail.packunits, 2)
	
				 END	,
	loosesaleprice=(item.saleprice/(Case when item.packunits=0 then 1 else item.packunits end)),
	packsaleprice=item.saleprice,
	price = dbo.purdetail.purprice,    
	itemdiscperc = dbo.purdetail.discperc,    
	packunits = dbo.purdetail.packunits,    
	packing=  case when (dbo.item.packcode is null) then space(30)
				 else  dbo.itempacking.name
			  end,
	batch = dbo.purdetail.batch,    
	expiry = dbo.purdetail.expiry,    
	itemname = item.name,
	datestring = Rtrim(LTrim(Str(DatePart(dd, purledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, purledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, purledger.date)))), 
	Person = dbo.accounts.name,
	Posted=dbo.purledger.posted
	/* invnettotalexctax=(select Round( sum(Round((PD.purprice * (PD.packqty + PD.looseqty) * (1 - PD.discperc * 0.01)),2) * (1 - PL.discperc * 0.01))
							+ PL.misccharges - PL.flatdisc,0)
				from purledger PL,
					  purdetail PD
				where PL.purinvcode=purledger.purinvcode and
						PD.purinvcode=PL.purinvcode
	
				group by
						PL.purinvcode,
						PL.flatdisc,
						PL.misccharges
			),
	totalsalestax = (SELECT invtotalsalestax= 
								  Round (
	/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( PD.looseqty + PD.packqty ) * PD.purprice * (1 - PD.discperc * 0.01 ) , 2 ) )
								 * ( 1 - PL.discperc * 0.01 ) , 2 ) - PL.flatdisc ) * PL.invgstperc1 * 0.01  , 2 )
	/*items salestax*/		 + Sum (Round ( (PD.looseqty + PD.packqty + PD.bonusqty)* PD.unitsalestax + Round ( Round ( (PD.looseqty + PD.packqty) * PD.purprice * (1 - PD.discperc * 0.01 ), 2 ) * PD.gstperc * 0.01 , 2 ) , 2 ) )						 
								 , 0 )
					 FROM dbo.Purledger PL , 
							dbo.Purdetail PD
	
					 WHERE  (PL.purinvcode = dbo.purledger.purinvcode )   and
							  (PL.purinvcode = PD.purinvcode )   
	
					 GROUP BY PL.purinvcode, 
								 PL.invgstperc1, 
								 PL.misccharges,   
								 PL.flatdisc,
								 PL.discperc
					)*/
							
FROM
	dbo.purledger, 
	dbo.purdetail,    
	dbo.item
	LEFT OUTER JOIN itempacking ON (dbo.item.packcode = dbo.itempacking.packcode),
	dbo.accounts
WHERE  
	dbo.purledger.purinvcode >= :ai_sinvcode and
	dbo.purledger.purinvcode <= :ai_linvcode  and
	dbo.purledger.purcatcode IN (1, 2, 3, 7, 8) and
	dbo.purledger.purinvcode = dbo.purdetail.purinvcode and  
	dbo.purdetail.icode = item.icode and 
	dbo.purledger.suppcode = dbo.accounts.acccode 
order by
	item.name
"
  arguments=(("ai_sinvcode", number), ("ai_linvcode", number))
)
