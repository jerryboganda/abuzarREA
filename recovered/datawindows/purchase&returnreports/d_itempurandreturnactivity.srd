table(column=(type=char(13) updatewhereclause=yes name=doctype dbname="Doctype"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(1) updatewhereclause=yes name=purchasecategory dbname="PurchaseCategory"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="purinvcode"  )
column=(type=char(100) updatewhereclause=yes name=suppinvcode dbname="suppinvcode"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="supplier"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdisc dbname="ItemDisc"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="bonus"  )
 retrieve=" SELECT
	Doctype = 'PV-' + LTRIM(RTRIM(STR(dbo.purledger.PURINVCODE, 10))), 
	Type='P', 
	itemname 	= dbo.item.name, 
	aliasname 	= dbo.item.customicode,
	icode = dbo.item.icode,
	date 		= dbo.purledger.date,	
	PurchaseCategory = CASE WHEN dbo.purledger.PurCatCode <=2 THEN 'P' ELSE 'L' END,
	purinvcode = dbo.purledger.purinvcode,
	suppinvcode= dbo.purledger.suppinvcode, 		
	supplier 	= dbo.accounts.name,
	packing    = dbo.item.packingdesc,
	Batch 	 	= dbo.purdetail.batch,	
	Expiry	 	= dbo.purdetail.expiry,
	rate       = dbo.purdetail.purprice, 
	discperc	= dbo.purdetail.discperc,
	unitsalestax = dbo.purdetail.unitsalestax,
	gstperc    = dbo.purdetail.gstperc,
	ItemDisc	= ((dbo.purdetail.looseqty + dbo.purdetail.packqty) * dbo.purdetail.purprice) * (dbo.purdetail.discperc * .01),
	qty 		 	= dbo.purdetail.looseqty + dbo.purdetail.packqty,
	bonus		= dbo.purdetail.bonusqty
FROM
	dbo.purledger, 
	dbo.purdetail,
	dbo.item,    
	dbo.accounts
WHERE
	:ai_allitems = 0 AND
	dbo.purledger.date BETWEEN :ad_StartDate and :ad_EndDate  and
	dbo.purledger.purinvcode = dbo.purdetail.purinvcode and  
	dbo.purledger.suppcode = dbo.accounts.acccode and  
	dbo.purdetail.icode IN (:al_icode) AND
	dbo.purdetail.icode = dbo.item.icode
UNION ALL
 SELECT
	Doctype = 'PR-' + LTRIM(RTRIM(STR(dbo.prledger.PRINVCODE, 10))), 
	Type='R',
	itemname 	= dbo.item.name, 
	aliasname 	= dbo.item.customicode,
	icode = dbo.item.icode,
	date 		= dbo.prledger.date,	
	PurchaseCategory = 'L',
	purinvcode = dbo.prledger.prinvcode,
	suppinvcode= NULL, 		
	supplier 	= dbo.accounts.name,
	packing    = dbo.item.packingdesc,
	Batch 	 	= dbo.prdetail.batch,	
	Expiry	 	= dbo.prdetail.expiry,
	rate       = dbo.prdetail.prprice, 
	discperc	= dbo.prdetail.discperc,
	unitsalestax = dbo.prdetail.unitsalestax,
	gstperc    = dbo.prdetail.gstperc,
	ItemDisc	= ((dbo.prdetail.looseqty + dbo.prdetail.packqty) * dbo.prdetail.prprice) * (dbo.prdetail.discperc * .01),
	qty 		 = -(dbo.prdetail.looseqty + dbo.prdetail.packqty),
	bonus		=  - dbo.prdetail.bonusqty
FROM
	dbo.prledger, 
	dbo.prdetail,
	dbo.item,    
	dbo.accounts
WHERE
	:ai_allitems = 0 AND
	dbo.prledger.date BETWEEN :ad_StartDate and :ad_EndDate  and
	dbo.prledger.prinvcode = dbo.prdetail.prinvcode and  
	dbo.prledger.suppcode = dbo.accounts.acccode and  
	dbo.prdetail.icode IN (:al_icode) AND
	dbo.prdetail.icode = dbo.item.icode
UNION ALL
SELECT
	Doctype = 'PV-' + LTRIM(RTRIM(STR(dbo.purledger.PURINVCODE, 10))), 
	Type='P', 
	itemname 	= dbo.item.name, 
	aliasname 	= dbo.item.customicode,
	icode = dbo.item.icode,
	date 		= dbo.purledger.date,	
	PurchaseCategory = CASE WHEN dbo.purledger.PurCatCode <=2 THEN 'P' ELSE 'L' END,
	purinvcode = dbo.purledger.purinvcode,
	suppinvcode= dbo.purledger.suppinvcode, 		
	supplier 	= dbo.accounts.name,
	packing    = dbo.item.packingdesc,
	Batch 	 	= dbo.purdetail.batch,	
	Expiry	 	= dbo.purdetail.expiry,
	rate       = dbo.purdetail.purprice, 
	discperc	= dbo.purdetail.discperc,
	unitsalestax = dbo.purdetail.unitsalestax,
	gstperc    = dbo.purdetail.gstperc,
	ItemDisc	= ((dbo.purdetail.looseqty + dbo.purdetail.packqty) * dbo.purdetail.purprice) * (dbo.purdetail.discperc * .01),
	qty 		 	= dbo.purdetail.looseqty + dbo.purdetail.packqty,
	bonus		= dbo.purdetail.bonusqty
FROM
	dbo.purledger, 
	dbo.purdetail,
	dbo.item,    
	dbo.accounts
WHERE
	:ai_allitems = 1 AND
	dbo.purledger.date BETWEEN :ad_StartDate and :ad_EndDate  and
	dbo.purledger.purinvcode = dbo.purdetail.purinvcode and  
	dbo.purledger.suppcode = dbo.accounts.acccode and  
	dbo.purdetail.icode = dbo.item.icode
UNION ALL
SELECT
	Doctype = 'PR-' + LTRIM(RTRIM(STR(dbo.prledger.PRINVCODE, 10))), 
	Type='R',
	itemname 	= dbo.item.name, 
	aliasname 	= dbo.item.customicode,
	icode = dbo.item.icode,
	date 		= dbo.prledger.date,	
	PurchaseCategory = 'L',
	purinvcode = dbo.prledger.prinvcode,
	suppinvcode= NULL, 		
	supplier 	= dbo.accounts.name,
	packing    = dbo.item.packingdesc,
	Batch 	 	= dbo.prdetail.batch,	
	Expiry	 	= dbo.prdetail.expiry,
	rate       = dbo.prdetail.prprice, 
	discperc	= dbo.prdetail.discperc,
	unitsalestax = dbo.prdetail.unitsalestax,
	gstperc    = dbo.prdetail.gstperc,
	ItemDisc	= ((dbo.prdetail.looseqty + dbo.prdetail.packqty) * dbo.prdetail.prprice) * (dbo.prdetail.discperc * .01),
	qty 		 = -(dbo.prdetail.looseqty + dbo.prdetail.packqty),
	bonus		=  - dbo.prdetail.bonusqty
FROM
	dbo.prledger, 
	dbo.prdetail,
	dbo.item,    
	dbo.accounts
WHERE
	:ai_allitems = 1 AND
	dbo.prledger.date BETWEEN :ad_StartDate and :ad_EndDate  and
	dbo.prledger.prinvcode = dbo.prdetail.prinvcode and  
	dbo.prledger.suppcode = dbo.accounts.acccode and  
	dbo.prdetail.icode = dbo.item.icode
"
  arguments=(("ai_allitems", number), ("al_icode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime))
 sort="itemname A, date A, type A, purinvcode A"
)
