summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=4958 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(30) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(60) updatewhereclause=yes name=cp dbname="CP"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(100) updatewhereclause=yes name=fax dbname="Fax"  )
 retrieve="SELECT 
	Area=Ar.name, 
	Category=CC.name,
	AliasName=A.AliasName,
	AccCode=A.AccCode,
	CP=C.CP,
	Name=A.Name,
	Address1=C.Address1,
	Address2=C.Address2,
	City=C.City,
	Phone=C.Phone,
	Fax = C.Fax
FROM
	Accounts A, Customer C, Area Ar, CustomerCategory CC
WHERE
	C.CustCode IN (:ai_custcode) AND
	A.AccCode = C.CustCode AND
	C.AreaCode = Ar.AreaCode and
	C.CustCatCode = CC.CustCatCode
ORDER BY
	Area, 
	Category,
	A.Name,
	A.AliasName,
	A.AccCode
"
  arguments=(("ai_custcode", numberlist))
)
