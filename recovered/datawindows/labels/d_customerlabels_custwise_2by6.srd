release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no rows_per_detail=2)
header(height=572 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=1656 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(30) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(60) updatewhereclause=yes name=cp dbname="CP"  )
column=(type=char(60) updatewhereclause=yes name=company dbname="company"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(105) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(100) updatewhereclause=yes name=fax dbname="Fax"  )
 retrieve="SELECT 
	Area=Ar.name, 
	Category=CC.name,
	AliasName = A.AliasName,
	AccCode = A.AccCode,
	CP = C.CP,
	company = A.Name,
	Address1 = C.Address1,
	Address2 = C.Address2,
	City = C.City,
	Phone=CASE WHEN C.Phone IS NULL OR C.Phone = '' THEN SPACE(100) ELSE 'Ph.: ' + C.Phone END,
	Fax = C.fax

FROM
	Accounts A, Customer C, Area Ar, CustomerCategory CC

WHERE
	C.CustCode IN (:ai_custcode) AND
	A.AccCode = C.CustCode AND
	C.AreaCode = Ar.AreaCode and
	C.CustCatCode = CC.CustCatCode
ORDER BY
	Area, 
	Category,
	A.Name,
	A.AliasName,
	A.AccCode"
  arguments=(("ai_custcode", numberlist))
)
