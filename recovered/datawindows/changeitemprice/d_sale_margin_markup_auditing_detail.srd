table(column=(type=char(75) updatewhereclause=yes name=item_customicode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.name"  )
column=(type=long key=yes updatewhereclause=yes name=code dbname="Item.icode"  )
column=(type=long updatewhereclause=yes validation="Real( GetText() ) > 0" name=item_packunits dbname="Item.PackUnits"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=decimal(5) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real( GetText() ) >= 0" name=item_saleprice dbname="SalePrice"  )
column=(type=decimal(18) updatewhereclause=yes name=margin dbname="Margin"  )
column=(type=decimal(15) updatewhereclause=yes name=markup dbname="Markup"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Item.SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=item_recentpurprice dbname="Item.RecentPurPrice"  )
column=(type=decimal(15) updatewhereclause=yes name=itemmargin dbname="ItemMargin"  )
column=(type=decimal(15) updatewhereclause=yes name=itemmarkup dbname="ItemMarkUp"  )
column=(type=decimal(2) updatewhereclause=yes name=item_recentpurprice2 dbname="Item.RecentPurPrice2"  )
column=(type=decimal(2) updatewhereclause=yes name=item_recentpurprice3 dbname="Item.RecentPurPrice3"  )
column=(type=decimal(2) updatewhereclause=yes name=item_recentpurprice4 dbname="Item.RecentPurPrice4"  )
column=(type=decimal(2) updatewhereclause=yes name=item_recentpurprice5 dbname="Item.RecentPurPrice5"  )
column=(type=long updatewhereclause=yes name=item_active dbname="Item.Active" 
 values="Yes	1/No	0/"  )
column=(type=long updatewhereclause=yes name=item_icatcode dbname="Item.icatcode" 
 values=""  )
column=(type=long updatewhereclause=yes name=item_iccode dbname="Item.iccode" 
 values=""  )
column=(type=long updatewhereclause=yes name=item_packcode dbname="Item.packcode" 
 values=""  )
column=(type=long updatewhereclause=yes name=item_manfcode dbname="Item.manfcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=item_usercode dbname="Item.usercode"  )
column=(type=datetime update=yes updatewhereclause=yes name=item_lastupdate dbname="Item.lastupdate"  )
column=(type=char(100) update=yes updatewhereclause=yes name=changereason dbname="Item.ChangeReason"  )
column=(type=char(100) update=yes updatewhereclause=yes name=module dbname="Item.Module"  )
 retrieve="SELECT		
	item.customicode,
	item.name ,
	item.icode,
	item.PackUnits, 
	PurInvCode=P.PurInvCode,
	Date=P.Date,
	Supplier=A.Name,
	Qty = D.PackQty + D.LooseQty,
	BonusQty = D.BonusQty,
	NetRate = D.NetRate,
	SalePrice=D.SalePrice,
	Margin = Round(((D.SalePrice - D.NetRate) / CASE WHEN D.SalePrice > 0 THEN D.SalePrice ELSE 1 END) * 100, 2),
	Markup = Round(((D.SalePrice - D.NetRate) / CASE WHEN D.NetRate > 0 THEN D.NetRate ELSE 1 END) * 100, 2),
	item.SalePrice,
	Item.RecentPurPrice,
	ItemMargin = Round(((Item.SalePrice - Item.RecentPurPrice) / CASE WHEN Item.SalePrice > 0 THEN Item.SalePrice ELSE 1 END) * 100, 2),
	ItemMarkUp = Round(((Item.SalePrice - Item.RecentPurPrice) / CASE WHEN Item.RecentPurPrice > 0 THEN Item.RecentPurPrice ELSE 1 END) * 100,2),
	Item.RecentPurPrice2,
	Item.RecentPurPrice3,
	Item.RecentPurPrice4,
	Item.RecentPurPrice5,
	item.Active ,
	item.icatcode,
	item.iccode,
	item.packcode,
	item.manfcode,
	item.usercode,
	item.lastupdate,
	Item.ChangeReason,
	Item.Module
FROM 
	item ,
	manufacturer,
	purledger p,
	purdetail d,
	Accounts A
WHERE 
	p.date between :adt_startdate and :adt_enddate and
	p.purinvcode = d.purinvcode and
	CASE WHEN :as_criteria = 'G' THEN 
		Round(((D.SalePrice - D.NetRate) / CASE WHEN D.SalePrice > 0 THEN D.SalePrice ELSE 1 END) * 100, 2)
	ELSE
		Round(((D.SalePrice - D.NetRate) / CASE WHEN D.NetRate > 0 THEN D.NetRate ELSE 1 END) * 100, 2)
	END BETWEEN :ad_minperc AND :ad_maxperc AND
	p.suppcode = a.acccode and
	d.icode = item.icode and
	manufacturer.manfcode = item.manfcode
"
  update="item" updatewhere=0 updatekeyinplace=yes
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("as_criteria", string), ("ad_minperc", number), ("ad_maxperc", number))
 sort="purinvcode A, date A, item_name A, qty A, netrate A"
)
