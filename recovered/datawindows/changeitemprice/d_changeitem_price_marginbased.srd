table(column=(type=long key=yes updatewhereclause=yes name=code dbname="Code"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes initial="1" name=margintype dbname="MarginType" 
 values="Avg. Price	1/Purchase Price	2/"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=startingmarginperc dbname="StartingMarginPerc"  )
column=(type=decimal(2) updatewhereclause=yes initial="100" name=endingmarginperc dbname="EndingMarginPerc"  )
 retrieve="SELECT  
	Code=ItemType.ItemTypeCode,
	Name=ItemType.Name,
	MarginType = 1,
	StartingMarginPerc=0.00,
	EndingMarginPerc=100.00
FROM
	ItemType
WHERE ItemType.ItemTypeCode=1"
  update="ItemType" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_manfcode", number))
)
