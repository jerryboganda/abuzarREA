 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100" validationmsg="~"Please enter valid redemption discount percentage [0-100]~"" initial="0" name=item_redemptiondiscperc dbname="Item.RedemptionDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Please enter valid Sale/Retail Price. It must be greater than 0~"" initial="0" name=saleretail dbname="SaleRetail"  )
column=(type=decimal(5) updatewhereclause=yes name=item_avgprice dbname="Item.AvgPrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100" validationmsg="~"Please enter valid sale price change margin [0-100]~"" initial="0" name=item_salepricechangemargin dbname="Item.SalePriceChangeMargin"  )
column=(type=long update=yes updatewhereclause=yes validation="Real( GetText() ) >= 0" validationmsg="~"Please enter valid upper sale qty limit~"" initial="0" name=item_uppersaleqtylimit dbname="Item.UpperSaleQtyLimit"  )
column=(type=char(100) update=yes updatewhereclause=yes name=changereason dbname="Item.ChangeReason"  )
column=(type=char(100) update=yes updatewhereclause=yes name=module dbname="Item.Module"  )
 retrieve="SELECT	
	item.name ,
	item.saleprice ,
	item.icode,
	item.Packcode, 
	item.SalePrice,
	item.PurPrice, 
	item.SaleDiscPerc,
	item.MaxSaleDiscPerc,
	item.PurDiscPerc, 
	item.ReorderQty, 
	item.OptimumQty, 
	item.PackUnits, 
	item.Active ,
	item.Prescribed ,
	item.icatcode,
	item.Refrigrated ,
	item.saleprice2,
	item.saleprice3,
	item.Printable ,
	item.iccode,
	item.RetailPrice,
	item.Taxable,
	item.packSalestax,
	item.GSTPerc1,
	item.GSTPerc2,
	item.printexpiry,
	item.packcode,
	item.manfcode,
	item.usercode,
	item.lastupdate,
	item.packingcost,
	item.minqty,
	item.greorderqty,
	item.goptimumqty,
	item.saleprice4,
	item.saleprice5,
	item.alternatepurprice,
	item.minsaleprice,
	item.purflatdisc,
	item.itemalertcode,
	item.SalesTaxScheduleCode,
	item.PCTCode,
	item.RedemptionDiscPerc,
	SaleRetail=item.saleprice,
	Item.AvgPrice,
	Item.SalePriceChangeMargin,
	Item.UpperSaleQtyLimit,
	Item.ChangeReason,
	Item.Module

FROM 
	item ,
	itemcategory     
WHERE 
	( itemcategory.icatcode = item.icatcode ) and          
	( item.icatcode = :ar_icatcode ) AND 
	( item.Active=1 )"
  update="item" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_icatcode", number))
 sort="item_name A"
)
