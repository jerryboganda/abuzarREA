column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Please enter valid Sale/Retail Price. It must be greater than 0~"" initial="0" name=saleretail dbname="SaleRetail"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100" validationmsg="~"Please enter valid sale price change margin [0-100]~"" initial="0" name=item_salepricechangemargin dbname="Item.SalePriceChangeMargin"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Please enter valid upper Sale Qty Limit~"" initial="0" name=item_uppersaleqtylimit dbname="Item.UpperSaleQtyLimit"  )
column=(type=char(100) update=yes updatewhereclause=yes name=changereason dbname="Item.ChangeReason"  )
column=(type=char(100) update=yes updatewhereclause=yes name=module dbname="Item.Module"  )
 retrieve="SELECT		
	item.customicode,
	item.name ,
	item.saleprice ,
	item.icode,
	item.Packcode, 
	item.SalePrice,
	item.PurPrice, 
	Item.AvgPrice,
	item.SaleDiscPerc,
	item.maxsalediscperc, 
	item.PurDiscPerc, 
	item.ReorderQty, 
	item.OptimumQty,
	item.greorderqty,
	item.goptimumqty, 
	item.PackUnits, 
	item.Active ,
	item.Prescribed ,
	item.icatcode,
	item.Refrigrated ,
	item.saleprice2,
	item.saleprice3,
	item.Printable ,
	item.iccode,
	item.retailprice,
	item.taxable,
	item.packSalestax,
	item.GSTPerc1,
	item.GSTPerc2,
	item.printexpiry,
	item.packcode,
	item.manfcode,
	item.usercode,
	item.lastupdate,
	item.packingcost,
	item.minqty,
	item.saleprice4,
	item.saleprice5,
	item.alternatepurprice,
	item.minsaleprice,
	item.purflatdisc,
	item.itemalertcode,
	item.salestaxschedulecode,
	item.PCTCode,
	item.RedemptionDiscPerc,
	SaleRetail=Item.SalePrice,
	Item.SalePriceChangeMargin,
	Item.UpperSaleQtyLimit,
	Item.ChangeReason,
	Item.Module
FROM 
	item
WHERE 
	item.Active=1 AND
	CASE WHEN :ai_margintype = 1 THEN 
		(((Item.SalePrice / CASE WHEN Item.PackUnits <> 0 THEN Item.PackUnits ELSE 1 END) - Item.AvgPrice) / CASE WHEN Item.AvgPrice <> 0 THEN Item.AvgPrice ELSE 1 END) * 100
	ELSE 
		((Item.SalePrice - Item.PurPrice) / CASE WHEN Item.PurPrice <> 0 THEN Item.PurPrice ELSE 1 END) * 100
	END BETWEEN :ai_startmargin AND :ai_endmargin
"
  update="item" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_margintype", number), ("ai_startmargin", number), ("ai_endmargin", number))
 sort="item_margin A"
)
