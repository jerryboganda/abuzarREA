column=(type=decimal(5) updatewhereclause=yes name=item_avgprice dbname="Item.AvgPrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100" validationmsg="~"Please enter valid sale price change margin [0-100]~"" initial="0" name=item_salepricechangemargin dbname="Item.SalePriceChangeMargin"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Please enter valid Upper Sale Qty Limit~"" initial="0" name=item_uppersaleqtylimit dbname="Item.UpperSaleQtyLimit"  )
column=(type=char(100) update=yes updatewhereclause=yes name=changereason dbname="Item.ChangeReason"  )
column=(type=char(100) update=yes updatewhereclause=yes name=module dbname="Item.Module"  )
 retrieve="SELECT 
	item.customicode,
	item.name ,
	item.saleprice ,
	item.icode, 
	item.Packcode, 
	item.AreaVolume,
	item.SalePrice,
	item.PurPrice, 
	item.SaleDiscPerc,
	item.maxsalediscperc, 
	item.PurDiscPerc, 
	item.ReorderQty, 
	item.OptimumQty,
	item.greorderqty,
	item.goptimumqty, 
	item.PackUnits, 
	item.Active ,
	item.Prescribed ,
	item.icatcode,
	item.Refrigrated ,
	item.saleprice2,
	item.saleprice3,
	item.Printable ,
	item.iccode,
	item.packSalestax,
	item.GSTPerc1,
	item.GSTPerc2,
	item.printexpiry,
	item.packcode,
	item.manfcode,
	item.usercode,
	item.lastupdate,
	item.packingcost,
	item.minqty,
	Item.AlternatePurPrice,
	Item.MinSalePrice,
	item.purflatdisc,
	item.saleprice4,
	item.saleprice5,
	item.itemalertcode,
	item.salestaxschedulecode,
	item.PCTCode,
	item.RedemptionDiscPerc,
	Item.RetailPrice,
	item.taxable,
	SaleRetail=Item.SalePrice,
	Item.AvgPrice,
	Item.SalePriceChangeMargin,
	Item.UpperSaleQtyLimit,
	Item.ChangeReason,
	Item.Module

FROM 
	item
WHERE 
	(item.icatcode = CASE WHEN :ar_icatcode IS NULL THEN item.icatcode ELSE :ar_icatcode END ) AND 
	(item.packcode = CASE WHEN :ar_packcode IS NULL THEN item.packcode ELSE :ar_packcode END ) AND 
	(item.manfcode = CASE WHEN :ar_manfcode IS NULL THEN item.manfcode ELSE :ar_manfcode END ) AND 
	(item.iccode = CASE WHEN :ar_iccode IS NULL THEN item.iccode ELSE :ar_iccode END ) AND 
	(item.Active=1)"
  update="item" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_icatcode", number), ("ar_packcode", number), ("ar_manfcode", number), ("ar_iccode", number))
 sort="item_name A"
)
