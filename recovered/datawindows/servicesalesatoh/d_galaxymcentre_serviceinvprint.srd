table(column=(type=long updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=balance dbname="balance"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=srbufferinvcode dbname="SrBufferInvCode"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="serviceinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ServiceHeader.date"  )
column=(type=long updatewhereclause=yes name=custcode dbname="ServiceHeader.custcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ServiceHeader.remarks"  )
column=(type=char(60) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=servicecatcode dbname="servicecatcode"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=long updatewhereclause=yes name=reprintcounter dbname="reprintcounter"  )
column=(type=char(100) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(60) updatewhereclause=yes name=age dbname="Age"  )
 retrieve="SELECT 
	AliasName = NULL,
	reprintdate=getdate(),
	users.username,  
	accounts.name, 
	headerno = 1,
	posted=h.posted,
	balance=0,
	saleinvcode=h.saleinvcode, 
	SrBufferInvCode=NULL,
	serviceinvcode = h.serviceinvcode,
	h.date,   
	h.custcode,   
	h.remarks,
	custrefno=h.ref1,	
	gcode=NULL,
	servicecatcode=h.servicecatcode,
	customername='                                  '  ,
	reprintcounter=h.reprintingcounter,
	patient=FullPatientName,
	Gender=PatientSex,
	Age=PatientAge
FROM 
	dbo.serviceheader h,
	customer, 
	accounts,
	users
WHERE 
	( h.serviceinvcode = :ra_InvCode ) AND
	( h.custcode = customer.custcode ) AND 
	( customer.custcode = accounts.acccode ) AND 
	( h.salesmancode = users.usercode )
"
  arguments=(("ra_InvCode", number))
)
