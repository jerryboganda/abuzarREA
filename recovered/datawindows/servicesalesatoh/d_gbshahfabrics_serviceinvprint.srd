table(column=(type=long updatewhereclause=yes name=medicinesale dbname="MedicineSale"  )
column=(type=long updatewhereclause=yes name=saletype dbname="SaleType"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="username"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="name"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=decimal(5) updatewhereclause=yes name=balance dbname="balance"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=srbufferinvcode dbname="srbufferinvcode"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="serviceinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_discperc dbname="saleledger_discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=salecatcode dbname="salecatcode"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(2) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_discperc dbname="saledetail_discperc"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=long updatewhereclause=yes name=reprintcounter dbname="reprintcounter"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="doctor"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="patientregno"  )
column=(type=long updatewhereclause=yes name=locationcode dbname="locationcode"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=decimal(2) updatewhereclause=yes name=cashtendered dbname="CashTendered"  )
column=(type=decimal(2) updatewhereclause=yes name=cashcharged dbname="CashCharged"  )
column=(type=decimal(2) updatewhereclause=yes name=cashback dbname="CashBack"  )
column=(type=decimal(2) updatewhereclause=yes name=cardscharged dbname="CardsCharged"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="DueDate"  )
 retrieve="SELECT 
	MedicineSale = 1,
	SaleType = 1,
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale' else item.name end,
	AliasName = item.customicode,
	reprintdate=getdate(),
	users.username,  
	accounts.name, 
	headerno =max(saleledger.headerno),
	posted=max(saleledger.posted),
	balance=isnull(max(balance),0),
	dbo.saleledger.saleinvcode,   
	srbufferinvcode=dbo.saleledger.srbufferinvcode,
	serviceinvcode = :ra_InvCode,
	dbo.saleledger.date,   
	saleledger_discperc=dbo.saleledger.discperc, 
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.salestax,   
	dbo.saleledger.custcode,   
	dbo.saleledger.remarks,
	dbo.saleledger.custrefno,	
	dbo.saledetail.icode,   
	dbo.saledetail.gcode,
	salecatcode=max(saleledger.salecatcode),
	Id        = MAX(dbo.saledetail.IDENTITYCOL),     
	looseqty  = sum(saledetail.looseqty), 
	packqty   = sum(saledetail.packqty), 
	packunits = max(saledetail.packunits), 
	saleprice = max(saledetail.saleprice), 
	rate      = max(saledetail.rate),
	salestax  = max(saledetail.salestax),   
	saledetail_discperc  = max(saledetail.discperc), 
	customername='                                  '  ,
	itemflatdisc  = max(saledetail.itemflatdisc),
	unitsalestax  = max(saledetail.unitsalestax),
	gstperc       = max(saledetail.gstperc),
	invgstperc    = max(saleledger.invgstperc1),
	reprintcounter=max(saleledger.reprintingcounter),
	patient=max(patient.name),
	doctor=max(doctors.name),
	patientregno=max(patient.regno),
	locationcode=max(patient.locationcode),
	InvTotal = ISNULL(DBO.fn_GetSaleInvTotal(saleledger.saleinvcode), 0),
	CashTendered = max(S.CashTendered),
	CashCharged = max(S.CashCharged),
	CashBack = max(S.CashBack),
	CardsCharged=ISNULL((SELECT SUM(CW.Amount) FROM MasterCashWin CW WHERE CW.DocumentCode = :ra_InvCode AND CW.DocumentType = 'RS'), 0),
	DueDate=S.DueDate
FROM 
	(Select SH.* FROM ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode) S,
	dbo.saleledger 
	LEFT OUTER JOIN Patient ON (saleledger.patientcode = patient.patientcode)
	LEFT OUTER JOIN doctors ON ( saleledger.doctCode = doctors.doctcode),
	dbo.saledetail,  
	item, 
	customer, 
	accounts,
	users 
	
WHERE 
	( dbo.saleledger.saleinvcode = S.SaleinvCode ) AND
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND 
	( dbo.saleledger.custcode = dbo.customer.custcode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( dbo.saleledger.salesmancode = dbo.users.usercode ) AND
	( saledetail.icode = item.icode )  and
	( saleledger.admissioncode IS NULL) 	
GROUP BY 
	saleledger.saleinvcode, 
	dbo.saleledger.srbufferinvcode,
	saleledger.date, 
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	saleledger.salestax, 
	saleledger.remarks,
	saleledger.custrefno, 
	saledetail.icode, 
	saledetail.rowgroup,
	saledetail.gcode, 
	item.name,
	item.customicode,
	item.icode,
	item.printable, 
	accounts.name,
	dbo.users.username,
	S.DueDate
UNION ALL
SELECT 
	MedicineSale = 1,
	SaleType = 2,
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale' else item.name end,
	AliasName = item.customicode,
	reprintdate=getdate(),
	users.username,  
	accounts.name, 
	headerno =max(dbo.srbufferledger.headerno),
	posted=max(dbo.srbufferledger.posted),
	balance=0,
	saleinvcode = S.SaleInvCode,   
	srbufferinvcode=dbo.srbufferledger.srbufferinvcode,
	serviceinvcode = :ra_InvCode,
	dbo.srbufferledger.date,   
	saleledger_discperc=dbo.srbufferledger.discperc, 
	dbo.srbufferledger.misccharges,   
	dbo.srbufferledger.flatdisc,   
	dbo.srbufferledger.salestax,   
	dbo.srbufferledger.custcode,   
	dbo.srbufferledger.remarks,
	dbo.srbufferledger.custrefno,	
	dbo.srbufferdetail.icode,   
	dbo.srbufferdetail.gcode,
	salecatcode=max(srbufferledger.srcatcode),
	Id        = MAX(dbo.srbufferdetail.IDENTITYCOL),     
	looseqty  = sum(srbufferdetail.looseqty), 
	packqty   = 0, 
	packunits = max(srbufferdetail.packunits), 
	saleprice = max(srbufferdetail.srprice), 
	rate      = 0,
	salestax  = max(srbufferdetail.salestax),   
	saledetail_discperc  = max(srbufferdetail.discperc), 
	customername='                                  '  ,
	itemflatdisc  = 0.00,
	unitsalestax  = max(srbufferdetail.unitsalestax),
	gstperc       = max(srbufferdetail.gstperc),
	invgstperc    = max(srbufferledger.invgstperc1),
	reprintcounter=NULL,
	patient=max(patient.name),
	doctor=NULL,
	patientregno=max(patient.regno),
	locationcode=max(patient.locationcode),
	InvTotal = ISNULL(DBO.fn_GetSRBufferInvTotal(srbufferledger.srbufferinvcode), 0),
	CashTendered = max(S.CashTendered),
	CashCharged = max(S.CashCharged),
	CashBack = max(S.CashBack),
	CardsCharged=ISNULL((SELECT SUM(CW.Amount) FROM MasterCashWin CW WHERE CW.DocumentCode = :ra_InvCode AND CW.DocumentType = 'RS'), 0),
	DueDate=NULL
FROM 
	(SELECT SL.SaleInvCode, SL.SRBufferInvCode, SS.ServiceInvCode, SS.CashTendered, SS.CashCharged, SS.CashBack
	FROM SaleLedger SL, ServiceHeader SS 
	WHERE SS.ServiceInvCode= :ra_InvCode AND SS.SaleInvCode >= 0 AND 
		SS.SaleInvCode = SL.SaleInvCode) S,
	dbo.srbufferledger
	LEFT OUTER JOIN Patient ON (srbufferledger.patientcode = patient.patientcode),   
	dbo.srbufferdetail,  
	item, 
	customer, 
	accounts,
	users
	
WHERE 
	( dbo.srbufferledger.srbufferinvcode = S.srbufferinvcode ) AND
	( dbo.srbufferledger.srbufferinvcode  = dbo.srbufferdetail.srbufferinvcode ) AND 
	( dbo.srbufferledger.custcode = dbo.customer.custcode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( dbo.srbufferledger.salesmancode = dbo.users.usercode ) AND
	( srbufferdetail.icode = item.icode )  and
	( srbufferledger.admissioncode IS NULL)
GROUP BY 
	srbufferledger.srbufferinvcode, 
	srbufferledger.saleinvcode, 
	s.saleinvcode, 
	srbufferledger.date, 
	srbufferledger.custcode, 
	srbufferledger.discperc, 
	srbufferledger.flatdisc, 
	srbufferledger.misccharges, 
	srbufferledger.salestax, 
	srbufferledger.remarks,
	srbufferledger.custrefno, 
	srbufferdetail.icode, 
	srbufferdetail.gcode, 
	item.name,
	item.customicode,
	item.icode,
	item.printable, 
	accounts.name,
	dbo.users.username
UNION ALL
SELECT 
	MedicineSale = 0,
	SaleType = 0,
	itemname = service.name,
	AliasName = NULL,
	reprintdate=getdate(),
	users.username,  
	accounts.name, 
	headerno = 1,
	posted=max(h.posted),
	balance=0,
	saleinvcode=h.saleinvcode, 
	SrBufferInvCode=NULL,
	serviceinvcode = h.serviceinvcode,
	h.date,   
	saleledger_discperc=h.discperc, 
	h.misccharges,   
	h.flatdisc,   
	salestax=0.00,
	h.custcode,   
	h.remarks,
	custrefno=h.ref1,	
	d.servicecode,   
	gcode=NULL,
	servicecatcode=max(h.servicecatcode),
	Id        = MAX(d.IDENTITYCOL),     
	looseqty  = sum(d.qty), 
	packqty   = 0, 
	packunits = 1, 
	saleprice = max(d.price), 
	rate      = max(d.price),
	salestax  = 0,   
	saledetail_discperc  = max(d.discperc), 
	customername='                                  '  ,
	itemflatdisc  = max(d.serviceflatdisc),
	unitsalestax  = 0.00,
	gstperc       = 0.00,
	invgstperc    = 0.00,
	reprintcounter=max(h.reprintingcounter),
	patient=max(patient.name),
	doctor=max(doctors.name),
	patientregno=max(patient.regno),
	locationcode=max(patient.locationcode),
	InvTotal = ISNULL(DBO.fn_GetServiceInvTotal(h.serviceinvcode), 0),
	CashTendered = max(h.CashTendered),
	CashCharged = max(h.CashCharged),
	CashBack = max(h.CashBack),
	CardsCharged=ISNULL((SELECT SUM(CW.Amount) FROM MasterCashWin CW WHERE CW.DocumentCode = h.ServiceInvCode AND CW.DocumentType = 'RS'), 0),
	DueDate=h.DueDate
FROM 
	dbo.serviceheader h
	LEFT OUTER JOIN Patient ON (h.patientcode = patient.patientcode)
	LEFT OUTER JOIN Doctors ON (h.doctCode = doctors.doctcode),
	dbo.servicedetail d, 
	service, 
	customer, 
	accounts,
	users
	
WHERE 
	( h.serviceinvcode = :ra_InvCode ) AND
	( h.serviceinvcode = d.serviceinvcode ) AND 
	( h.custcode = customer.custcode ) AND 
	( customer.custcode = accounts.acccode ) AND 
	( h.salesmancode = users.usercode ) AND
	( d.servicecode = service.servicecode )  and
	( h.admissioncode IS NULL)
GROUP BY 
	h.serviceinvcode,
	h.saleinvcode, 
	h.date, 
	h.custcode, 
	h.discperc, 
	h.flatdisc, 
	h.misccharges, 
	h.remarks,
	h.ref1,
	d.servicecode, 
	service.name,
	service.servicecode,
	accounts.name,
	dbo.users.username,
	h.DueDate
ORDER BY 
	MedicineSale, SaleType, ID
"
  arguments=(("ra_InvCode", number))
)
