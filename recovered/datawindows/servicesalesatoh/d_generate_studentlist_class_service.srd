release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80269524 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=72 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=classcode dbname="ClassCode"  )
column=(type=char(100) updatewhereclause=yes name=classname dbname="ClassName"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=long updatewhereclause=yes name=rollno dbname="RollNo"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="ServiceCode"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid class fee amount'" initial="0" name=fee dbname="Fee"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid class fee discount'" initial="0" name=flatdiscount dbname="FlatDiscount"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="'Please enter valid discount percentage [Range 0-100]'" initial="0" name=discperc dbname="DiscPerc"  )
column=(type=char(1) updatewhereclause=yes name=omitspecialcharges dbname="OmitSpecialCharges"  )
column=(type=char(1) updatewhereclause=yes initial="Y" name=selected dbname="SELECTED" 
 values="	Y/	N"  )
 retrieve="SELECT 
	ClassCode = SC.ClassCode,
	ClassName = C.Name,
	StudentCode = SC.StudentCode,
	RegNo = S.RegNo,
	StudentName = S.Name,
	RollNo = SC.RollNo,
	ServiceCode = :ai_servicecode,
	ServiceName = (SELECT SV.Name FROM Service SV WHERE SV.ServiceCode = :ai_servicecode),
	Fee = (SELECT SV.Price FROM Service SV WHERE SV.ServiceCode = :ai_servicecode),
	FlatDiscount = (SELECT SV.ServiceFlatDisc FROM Service SV WHERE SV.ServiceCode = :ai_servicecode), 
	DiscPerc = 0.00,
	OmitSpecialCharges=S.OmitSpecialCharges,
	SELECTED='Y'
FROM
	Student S, StudentClass SC, Class C
WHERE 
	C.ClassCode IN (:ai_classcode) AND
	C.ClassCode = SC.ClassCode AND
	SC.StudentCode = S.StudentCode AND
	SC.PromotionRowID IS NULL AND
	SC.GraduationRowID IS NULL

"
  arguments=(("ai_classcode", numberlist), ("ai_servicecode", number))
 sort="classname A, servicename A, rollno A, servicename A"
)
