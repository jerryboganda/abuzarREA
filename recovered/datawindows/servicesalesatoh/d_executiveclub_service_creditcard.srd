table(column=(type=decimal(2) updatewhereclause=yes name=amont dbname="amont"  )
column=(type=char(100) updatewhereclause=yes name=remrks dbname="remrks"  )
 retrieve="select 
		amont=mastercashwin.amount,
		remrks=mastercashwin.remarks

from mastercashwin
where mastercashwin.documenttype='RS' and
		 mastercashwin.documentcode=:al_serviceinvcode"
  arguments=(("al_serviceinvcode", number), ("al_balance", number))
)
