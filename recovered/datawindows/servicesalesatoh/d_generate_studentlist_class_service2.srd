table(column=(type=long updatewhereclause=yes name=tuitionfee dbname="TuitionFee"  )
column=(type=char(100) updatewhereclause=no name=grade dbname="Grade"  )
column=(type=decimal(2) updatewhereclause=yes name=numericgrade dbname="NumericGrade"  )
column=(type=long updatewhereclause=yes name=classcode dbname="ClassCode"  )
column=(type=char(100) updatewhereclause=yes name=classname dbname="ClassName"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=char(40) updatewhereclause=yes name=rollno dbname="RollNo"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="ServiceCode"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid class fee amount'" initial="0" name=fee dbname="Fee"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid class fee discount'" initial="0" name=flatdiscount dbname="FlatDiscount"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="'Please enter valid discount percentage [Range 0-100]'" initial="0" name=discperc dbname="DiscPerc"  )
column=(type=datetime updatewhereclause=yes name=feepaiduptill dbname="Student.FeePaidUptill"  )
column=(type=datetime updatewhereclause=yes initial="today" name=duedate dbname="duedate"  )
column=(type=char(1) updatewhereclause=yes initial="Y" name=selected dbname="SELECTED" 
 values="	Y/	N"  )
 retrieve="SELECT 
	TuitionFee=1,
	Grade = (SELECT Grade.Name FROM Grade WHERE Grade.GradeCode=C.GradeCode),
	NumericGrade = (SELECT Grade.NumericalFactor FROM Grade WHERE Grade.GradeCode=C.GradeCode),
	ClassCode = SC.ClassCode,
	ClassName = C.Name,
	StudentCode = SC.StudentCode,
	RegNo = S.RegNo,
	StudentName = S.Name,
	RollNo = SC.RollNo,
	ServiceCode = C.ServiceForTuitionFee,
	ServiceName = (SELECT SV.Name FROM Service SV WHERE SV.ServiceCode = C.ServiceForTuitionFee),
	Fee = CASE WHEN S.FeePaidUptill > GETDATE() THEN 0.00 ELSE C.Fee END, 
	FlatDiscount = CASE WHEN S.FeePaidUptill > GETDATE() THEN 0.00 ELSE S.FlatDisc END, 
	DiscPerc = CASE WHEN S.FeePaidUptill > GETDATE() THEN 0.00 ELSE S.DiscPerc END, 
	S.FeePaidUptill,
	duedate = :ad_duedate,
	SELECTED='Y'
FROM
	Student S, StudentClass SC, Class C
WHERE 
	C.Active = 'Y' AND
	C.ClassCode IN (:ai_classcode) AND
	SC.PromotionRowID IS NULL AND
	SC.GraduationRowID IS NULL AND
	C.ClassCode = SC.ClassCode AND
	SC.StudentCode = S.StudentCode
UNION
SELECT 
	TuitionFee=0,
	Grade = (SELECT Grade.Name FROM Grade WHERE Grade.GradeCode=C.GradeCode),
	NumericGrade = (SELECT Grade.NumericalFactor FROM Grade WHERE Grade.GradeCode=C.GradeCode),
	ClassCode = SC.ClassCode,
	ClassName = C.Name,
	StudentCode = SC.StudentCode,
	RegNo = S.RegNo,
	StudentName = S.Name,
	RollNo = SC.RollNo,
	ServiceCode = SVC.ServiceCode,
	ServiceName = SVC.Name,
	Fee = SVC.Price, 
	FlatDiscount = 0.00, 
	DiscPerc = 0.00, 
	FeePaidUptill=NULL,
	duedate = :ad_duedate,
	SELECTED='Y'
FROM
	Student S, StudentClass SC, Class C,
	(SELECT SV.Servicecode, SV.Name, SV.Price
	FROM Service SV 
	WHERE SV.ServiceCode IN (:ai_servicecode)) SVC
WHERE 
	C.Active = 'Y' AND
	C.ClassCode IN (:ai_classcode) AND
	SC.PromotionRowID IS NULL AND
	SC.GraduationRowID IS NULL AND
	C.ClassCode = SC.ClassCode AND
	SC.StudentCode = S.StudentCode
"
  arguments=(("ai_classcode", numberlist), ("ad_duedate", datetime), ("ai_servicecode", numberlist), ("ai_fee", decimallist))
 sort="numericgrade A, classname A, rollno A, studentname A, tuitionfee D, servicename A"
)
