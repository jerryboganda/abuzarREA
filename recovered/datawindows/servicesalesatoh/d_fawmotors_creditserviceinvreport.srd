header(height=3625 color="536870912" )
summary(height=725 color="536870912" )
footer(height=200 color="536870912" )
detail(height=158 color="536870912" )
table(column=(type=long updatewhereclause=yes name=invtype dbname="invtype"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=servicecatcode dbname="servicecatcode"  )
column=(type=char(100) updatewhereclause=yes name=serviceremarks dbname="serviceremarks"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=long updatewhereclause=yes name=reprintcount dbname="reprintcount"  )
column=(type=long updatewhereclause=yes name=serviceheader_serviceinvcode dbname="ServiceHeader.serviceinvcode"  )
column=(type=long updatewhereclause=yes name=serviceocode dbname="serviceocode"  )
column=(type=datetime updatewhereclause=yes name=serviceheader_date dbname="ServiceHeader.date"  )
column=(type=long updatewhereclause=yes name=headerno dbname="ServiceHeader.headerno"  )
column=(type=decimal(2) updatewhereclause=yes name=invdisc dbname="invdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=invflatdisc dbname="invflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharged dbname="misccharged"  )
column=(type=long updatewhereclause=yes name=serviceheader_custcode dbname="ServiceHeader.custcode"  )
column=(type=char(100) updatewhereclause=yes name=serviceheader_remarks dbname="ServiceHeader.remarks"  )
column=(type=long updatewhereclause=yes name=service_servicecode dbname="Service.servicecode"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=long updatewhereclause=yes name=tokenno dbname="tokenno"  )
column=(type=char(60) updatewhereclause=yes name=patientage dbname="patientage"  )
column=(type=char(100) updatewhereclause=yes name=patientfullname dbname="patientfullname"  )
column=(type=char(60) updatewhereclause=yes name=ref1 dbname="ref1"  )
column=(type=char(100) updatewhereclause=yes name=ref2 dbname="ref2"  )
column=(type=char(100) updatewhereclause=yes name=patientrefby dbname="patientrefby"  )
column=(type=decimal(2) updatewhereclause=yes name=servinvtotal dbname="servinvtotal"  )
column=(type=decimal(2) updatewhereclause=yes name=cashcharged dbname="cashcharged"  )
column=(type=decimal(2) updatewhereclause=yes name=cardscharged dbname="CardsCharged"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="rowid"  )
 retrieve="SELECT 
	invtype=1,
	itemname = service.name,
	servicecatcode=serviceheader.servicecatcode,
	serviceremarks=servicedetail.remarks,
	users.username,  
	accounts.name, 
	reprintdate = getDate(),
	reprintcount = dbo.ServiceHeader.ReprintingCounter,
	dbo.serviceheader.serviceinvcode, 
	serviceocode=serviceheader.serviceocode,  
	dbo.serviceheader.date,  
	dbo.serviceheader.headerno, 
	invdisc=dbo.serviceheader.discperc,  
	invflatdisc=dbo.serviceheader.flatdisc,	 
	misccharged=dbo.serviceheader.misccharges,   
	dbo.serviceheader.custcode,   
	dbo.serviceheader.remarks,
	dbo.service.servicecode,   
	price = dbo.servicedetail.price, 
	itemflatdisc=dbo.servicedetail.serviceflatdisc, 
	Qty = dbo.servicedetail.qty,
	itemdiscperc = dbo.servicedetail.discperc, 
	customername='                                  '  ,
	tokenno = dbo.serviceheader.tokenno,
	patientage=serviceheader.patientage,
	patientfullname=serviceheader.fullpatientname,
	ref1=serviceheader.ref1,
	ref2=serviceheader.ref2,
	patientrefby=serviceheader.patientrefby,
	servinvtotal=dbo.fn_getserviceinvtotal(dbo.serviceheader.serviceinvcode),
	cashcharged=serviceheader.cashcharged,
	CardsCharged=ISNULL((SELECT SUM(CW.Amount) FROM MasterCashWin CW WHERE CW.DocumentCode = serviceheader.ServiceInvCode AND CW.DocumentType = 'RS'), 0),
	rowid=srvrowid
FROM 
	dbo.serviceheader,   
	dbo.servicedetail,  
	service, 
	customer, 
	accounts,
	users 
WHERE 
	( dbo.serviceheader.serviceinvcode = :ra_InvCode ) AND
	( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND 
	( dbo.serviceheader.custcode = dbo.customer.custcode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND
	( servicedetail.servicecode = service.servicecode )  

union

SELECT 
	type=2,
	itemname = item.name,
	servicecatcode=max(serviceheader.servicecatcode),
	itemdesc=max(saledetail.saleitemdescription),
	username=users.username,  
	customer=accounts.name, 
	reprintdate = getDate(),
	reprintcount = max(saleledger.ReprintingCounter),
	saleledger.saleinvcode,
	serviceocode=0,
	saleledger.date,  
	headerno=max(saleledger.headerno), 
	saleledger.discperc,  
	saleledger.flatdisc,	 
	saleledger.misccharges,   
	saleledger.custcode,   
	saleledger.remarks,
	saleinvcode=saleledger.saleinvcode,   
	price = max(saledetail.saleprice), 
	itemflatdisc=max(saledetail.itemflatdisc), 
	Qty = sum(saledetail.looseqty),
	itemdiscperc = max(saledetail.discperc), 
	customername='                                  '  ,
	tokenno = 0,
	patientage='',
	patientfullname='',
	ref1=saleledger.custrefno,
	ref2=max(saleledger.custrefno2),
	patientrefby='',
	saleinvtotal=dbo.fn_getsaleinvtotal(saleledger.saleinvcode),
	cashcharged=max(serviceheader.cashcharged),
	CardsCharged=ISNULL((SELECT SUM(CW.Amount) FROM MasterCashWin CW WHERE CW.DocumentCode = max(serviceheader.ServiceInvCode) AND CW.DocumentType = 'RS'), 0),
	rowid=min(saledetail.rowid)

FROM 
	serviceheader,
	saleledger,   
	saledetail,  
	item,
	customer, 
	accounts,
	users 
WHERE 
	( serviceheader.serviceinvcode = :ra_InvCode ) AND
	(serviceheader.saleinvcode=saleledger.saleinvcode) AND
	( saleledger.saleinvcode = saledetail.saleinvcode ) AND 
	( saleledger.custcode = dbo.customer.custcode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( saleledger.salesmancode = dbo.users.usercode ) AND
	( saledetail.icode = item.icode )  
GROUP BY saleledger.saleinvcode, 
			saleledger.date, 
			/*saleledger.headerno,*/
			saleledger.custcode, 
			saleledger.discperc, 
			saleledger.flatdisc, 
			saleledger.misccharges, 
			saleledger.salestax, 
			saleledger.remarks,
			saleledger.custrefno, 
			saledetail.icode,
			saledetail.rowgroup, 
			saledetail.gcode, 
			item.name,
			item.icode,
			item.printable, 
			accounts.name,
			dbo.users.username



order by invtype,rowid"
  arguments=(("ra_InvCode", number))
)
