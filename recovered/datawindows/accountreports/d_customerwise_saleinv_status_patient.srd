table(column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=long updatewhereclause=yes name=altersaleinvcode dbname="AlterSaleInvCode"  )
column=(type=long updatewhereclause=yes name=headerinvcode dbname="HeaderInvCode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(121) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(60) updatewhereclause=yes name=country dbname="Country"  )
column=(type=decimal(2) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=receivedoninv dbname="ReceivedOnInv"  )
column=(type=decimal(2) updatewhereclause=yes name=debits dbname="Debits"  )
column=(type=decimal(2) updatewhereclause=yes name=otherreceipts dbname="OtherReceipts"  )
column=(type=decimal(2) updatewhereclause=yes name=chequesreceived dbname="ChequesReceived"  )
column=(type=decimal(2) updatewhereclause=yes name=allocatedreturns dbname="AllocatedReturns"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="AccountFor"  )
column=(type=char(30) updatewhereclause=yes name=refno dbname="RefNo"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
 retrieve="SELECT  
	InvoiceCode=S.SaleInvCode,
	AlterSaleInvCode=S.AlterSaleInvCode,
	HeaderInvCode=S.HeaderInvNo,
	HeaderNo=S.HeaderNo,
	Date=Date,
	Customer=A.Name,
	AliasName=A.AliasName,
	Address= RTRIM(LTRIM(C.Address1)) + ' ' + RTRIM(LTRIM(C.Address2)),
	City=C.CITY, 
	Country=C.Country,
	NetAmt=InvTotal,
	ReceivedOnInv=isnull(Amt, 0) + isnull(CashCharged, 0) + ISNULL((SELECT SUM(CW.Amount) FROM CashierWindow CW WHERE CW.SaleInvCode=S.SaleInvCode), 0),
	Debits=ISNULL((SELECT debit=SUM(debit) FROM GLdetail D, GLHeader H 
			WHERE  H.GLVochCode = D.GLVochCode AND 
					D.InvoiceCode = S.SaleInvCode AND 
					H.VochCatCode IN (SELECT V.VochCatCode FROM VocherCategory V
					WHERE V.InvoiceBased=1 AND V.InvoiceType=1)),0),
	OtherReceipts=ISNULL((SELECT credit=SUM(credit) FROM GLdetail D, GLHeader H 
			WHERE  H.GLVochCode = D.GLVochCode AND 
					D.InvoiceCode = S.SaleInvCode AND 
					H.VochCatCode IN (SELECT V.VochCatCode FROM VocherCategory V
					WHERE V.InvoiceBased=1 AND V.InvoiceType=1)),0),
	ChequesReceived=ISNULL((SELECT Amt=SUM(D.Amt) FROM Notesdetail D, Notes H 
			WHERE  D.InvoiceCode = S.SaleInvCode AND H.NoteCatCode=1 AND H.NoteCode = D.NoteCode), 0),
	AllocatedReturns=ISNULL((SELECT Amt=SUM(D.Amt) FROM SRAllocationdetail D, SRAllocationHeader H 
			WHERE  D.SaleInvCode = S.SaleInvCode AND H.SRAllocationCode = D.SRAllocationCode), 0),
	Balance=OutstandingAmt,
	Posted=S.Posted,
	AccountFor=S.AccountFor,
	RefNo=S.CustRefNo,
	RegNo = (SELECT RegNo FROM Patient WHERE Patient.PatientCode = S.PatientCode),
	PatientName = (SELECT Name FROM Patient WHERE Patient.PatientCode = S.PatientCode)

FROM SaleLedger S, Accounts A, Customer C
WHERE
	S.AccountFor = 'Y' AND
	S.Marked = 'N' AND
	S.Date >= :ad_startdate AND S.DATE <= :ad_enddate AND
	S.SaleCatCode IN (2) AND
	S.CustCode = A.AccCode AND
	A.AccCode = C.CustCode
ORDER BY
	Customer,
	SaleInvCode,
	Date




"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="customer A, patientname A, regno A, invoicecode A, date A"
)
