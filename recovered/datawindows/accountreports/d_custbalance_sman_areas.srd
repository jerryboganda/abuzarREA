release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=560 color="536870912" )
summary(height=88 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=decimal(2) updatewhereclause=yes name=drbalance dbname="DrBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=crbalance dbname="CrBalance"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
 retrieve="SELECT 
	Customer, 
	DrBalance=CASE WHEN Balance > 0 THEN Balance ELSE 0 END, 
	CrBalance=CASE WHEN Balance < 0 THEN ABS(Balance) ELSE 0 END, 
	AliasName, 
	SalesPerson, 
	Area,  
	AreaCode

FROM

(SELECT 
	A.AliasName, 
	Customer=A.Name, 
	Balance=Sum(Debit - Credit), 
	SalesPerson=SM.Name, 
	Area=Ar.Name, 
	AreaCode=Ar.AreaCode
FROM VirtualGL V,
	  Accounts A,
	  Customer C,
	  Salesman SM,
	  Area Ar
WHERE 
	V.Date <= :ar_Date AND 
	V.AccCode = A.AccCode AND 
	(A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'Y' END OR
	A.Restricted = CASE WHEN  :ar_restricted = 0 THEN 'N' ELSE 'N' END) AND
	A.AccCode = C.CustCode AND 
	C.SalesManCode = SM.SalesManCode AND
	SM.SalesManCode IN (:ar_SMan) AND 
	C.AreaCode IN (:ar_Areas) AND 
	C.AreaCode = Ar.AreaCode
GROUP BY A.AccCode, A.Name, A.AliasName, Ar.Name, Ar.AreaCode, SM.Name) A
ORDER BY Area, SalesPerson, Customer, AliasName"
  arguments=(("ar_restricted", number), ("ar_date", datetime), ("ar_sman", numberlist), ("ar_areas", numberlist))
 sort="salesperson A, area A, customer A, aliasname A"
)
