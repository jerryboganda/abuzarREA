detail(height=77 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes name=status dbname="Status"  )
column=(type=long updatewhereclause=yes name=code dbname="code1"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date1"  )
column=(type=char(32) updatewhereclause=yes name=type dbname="name2"  )
column=(type=char(60) updatewhereclause=yes name=account dbname="name1"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="name5"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="value1"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="value2"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="name3"  )
column=(type=char(60) updatewhereclause=yes name=subaccount dbname="name4"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=long identity=yes updatewhereclause=yes name=vrow dbname="Vrow"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="OpenBalance"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="vouchercode"  )
 retrieve="SELECT 
	Status=0,
	code1 = H.AccCode, 
	date1 = H.date, 
	name2 = VC.ShortName + '-' + RTrim(LTrim(convert(char(10), H.GlVochCode))), 
	name1 = (SELECT AA.name FROM Accounts AA WHERE H.AccCode = AA.AccCode),
	name5 = (SELECT AA.aliasname FROM Accounts AA WHERE H.AccCode = AA.AccCode),
	value1= D.Credit,
	value2= D.Debit,
	name3 = CASE WHEN D.Remarks IS NULL OR LEN(D.Remarks)=0 THEN A.name ELSE D.Remarks END ,
	name4 = S.name, 
	CheckNo = D.ChkNo,
	Vrow=D.GLRowID,
	OpenBalance=
		(SELECT isnull(sum(debit-credit), 0) 
		FROM virtualgl 
		WHERE virtualgl.acccode=H.AccCode and 
			virtualgl.date < :startdate),
	vouchercode=H.vouchercode
FROM 
   GLHeader H, GLDetail D, VocherCategory VC, Accounts A, SubAccounts S
WHERE
	H.Date BETWEEN :startdate and :enddate AND
	H.GlVochCode = D.GlVochCode AND
	H.VochCatCode = VC.VochCatCode AND
	CASE WHEN VC.JournalVoucher=0 THEN H.AccCode ELSE D.AccCode END IN (:acccode) AND
	H.AccCode <> D.AccCode AND
	D.AccCode = A.AccCode AND
	A.SubCode = S.SubAccCode
UNION ALL
SELECT 
	Status=0,
	code1 = V.AccCode, 
	date1 = V.date, 
	name2 = V.documenttype + '-' + RTrim(LTrim(convert(char(10), V.documentcode))), 
	name1 = A.name,		
	name5 = A.aliasname,		
	value1= V.Debit,
	value2= V.Credit,
	name3 = V.Remarks,
	name4 = S.name, 
	CheckNo = V.CheckNo,
	V.VRow,
	OpenBalance=
		(SELECT isnull(sum(debit-credit), 0) 
		FROM virtualgl 
		WHERE virtualgl.acccode=V.AccCode and 
			virtualgl.date < :startdate),
	V.vouchercode
FROM 
     VirtualGL V, Accounts A, SubAccounts S
WHERE
	V.AccCode IN (:acccode) and
	V.AccCode = A.AccCode AND
	V.Date BETWEEN :startdate and :enddate AND
	A.SubCode = S.SubAccCode AND
	STR(V.DocumentCode, 10) + STR(V.CatCode, 10)  NOT IN
		(SELECT DISTINCT STR(G.GlVochCode, 10) + STR(G.VochCatCode, 10)
		FROM 
			GLHeader G, GLDetail GD
		WHERE
			G.Date BETWEEN :startdate and :enddate AND
			G.GlVochCode = GD.GlVochCode AND
			G.AccCode IN (:acccode))
UNION ALL
SELECT 
	Status=1,
	code1 = V.AccCode, 
	date1 = V.date, 
	name2 = '*' + V.documenttype + '-' + RTrim(LTrim(convert(char(10), V.documentcode))), 
	name1 = A.name,		
	name5 = A.aliasname,		
	value1= V.Debit,
	value2= V.Credit,
	name3 = V.Remarks,
	name4 = S.name,
	CheckNo = V.CheckNo,
	V.VRow,
	OpenBalance=
		(SELECT isnull(sum(debit-credit), 0) 
		FROM virtualgl 
		WHERE virtualgl.acccode=V.AccCode and 
			virtualgl.date < :startdate),
	V.vouchercode
FROM 
	(SELECT * FROM Dbo.Fn_GetUnposted_AccTrans()) AS V, 
	Accounts A, SubAccounts S
WHERE
	V.AccCode IN (:acccode) and
	V.AccCode = A.AccCode AND
	A.SubCode = S.SubAccCode
ORDER BY
	name1, name5, status, date, name2, V.VRow



/*
SELECT 
	Status=0,
	code1 = H.AccCode, 
	date1 = H.date, 
	name2 = VC.ShortName + '-' + RTrim(LTrim(convert(char(10), H.GlVochCode))), 
	name1 = (SELECT AA.name FROM Accounts AA WHERE H.AccCode = AA.AccCode),
	name5 = (SELECT AA.aliasname FROM Accounts AA WHERE H.AccCode = AA.AccCode),
	value1= D.Credit,
	value2= D.Debit,
	name3 = CASE WHEN D.Remarks IS NULL OR LEN(D.Remarks)=0 THEN A.name ELSE D.Remarks END ,
	name4 = S.name, 
	CheckNo = D.ChkNo,
	Vrow=D.GLRowID,
	OpenBalance=
		(SELECT isnull(sum(debit-credit), 0) 
		FROM virtualgl 
		WHERE virtualgl.acccode=H.AccCode and 
			virtualgl.date < :startdate),
	vouchercode=H.vouchercode
FROM 
   GLHeader H, GLDetail D, VocherCategory VC, Accounts A, SubAccounts S
WHERE
	H.Date BETWEEN :startdate and :enddate AND
	H.GlVochCode = D.GlVochCode AND
	H.VochCatCode = VC.VochCatCode AND
	H.AccCode IN (:acccode) AND
	H.AccCode <> D.AccCode AND
	D.AccCode = A.AccCode AND
	A.SubCode = S.SubAccCode
UNION ALL
SELECT 
	Status=0,
	code1 = V.AccCode, 
	date1 = V.date, 
	name2 = V.documenttype + '-' + RTrim(LTrim(convert(char(10), V.documentcode))), 
	name1 = A.name,		
	name5 = A.aliasname,		
	value1= V.Debit,
	value2= V.Credit,
	name3 = V.Remarks,
	name4 = S.name, 
	CheckNo = V.CheckNo,
	V.VRow,
	OpenBalance=
		(SELECT isnull(sum(debit-credit), 0) 
		FROM virtualgl 
		WHERE virtualgl.acccode=V.AccCode and 
			virtualgl.date < :startdate),
	V.vouchercode
FROM 
     VirtualGL V, Accounts A, SubAccounts S
WHERE
	V.AccCode IN (:acccode) and
	V.AccCode = A.AccCode AND
	V.Date BETWEEN :startdate and :enddate AND
	A.SubCode = S.SubAccCode AND
	STR(V.DocumentCode, 10) + STR(V.CatCode, 10)  NOT IN
		(SELECT DISTINCT STR(G.GlVochCode, 10) + STR(G.VochCatCode, 10)
		FROM 
			GLHeader G, GLDetail GD
		WHERE
			G.Date BETWEEN :startdate and :enddate AND
			G.GlVochCode = GD.GlVochCode AND
			G.AccCode IN (:acccode))
UNION ALL
SELECT 
	Status=1,
	code1 = V.AccCode, 
	date1 = V.date, 
	name2 = '*' + V.documenttype + '-' + RTrim(LTrim(convert(char(10), V.documentcode))), 
	name1 = A.name,		
	name5 = A.aliasname,		
	value1= V.Debit,
	value2= V.Credit,
	name3 = V.Remarks,
	name4 = S.name,
	CheckNo = V.CheckNo,
	V.VRow,
	OpenBalance=
		(SELECT isnull(sum(debit-credit), 0) 
		FROM virtualgl 
		WHERE virtualgl.acccode=V.AccCode and 
			virtualgl.date < :startdate),
	V.vouchercode
FROM 
	(SELECT * FROM Dbo.Fn_GetUnposted_AccTrans()) AS V, 
	Accounts A, SubAccounts S
WHERE
	V.AccCode IN (:acccode) and
	V.AccCode = A.AccCode AND
	A.SubCode = S.SubAccCode
ORDER BY
	name1, name5, status, date, name2, V.VRow
*/"
  arguments=(("AccCode", numberlist), ("StartDate", datetime), ("EndDate", datetime))
)
