release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=435 color="536870912" )
summary(height=80 color="536870912" )
footer(height=0 color="536870912" )
detail(height=70 color="536870912" )
table(column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(60) updatewhereclause=yes name=cashaccount dbname="CashAccount"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
 retrieve="SELECT 
	AccCode=GLDetail.AccCode,
	CashAccount = (SELECT A.Name FROM Accounts A WHERE A.AccCode= Glheader.AccCode),
	AccountName = Accounts.Name,
	Amount = SUM(GLDetail.Credit - GLDetail.Debit)
FROM 
	GLDetail,   
	Glheader,   
	Accounts  
WHERE 
	( GLHeader.Posted = 'Y' ) AND
	( GLHeader.Date BETWEEN :adt_startdate AND :adt_enddate) AND
	( Glheader.GLVochCode = GLDetail.GLVochCode ) AND  
	( Accounts.AccCode = GLDetail.AccCode ) AND  
	( Glheader.AccCode <> GlDetail.AccCode ) AND 
	( Glheader.AccCode IN 
		(SELECT G.CashAccCode 
		FROM Groupcashaccount G 
		WHERE G.GroupCode IN 
			(SELECT GroupCode FROM UserGroups WHERE UserCode=:ai_usercode)))
GROUP BY
	Glheader.AccCode,
	GLDetail.AccCode,
	Accounts.Name
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_usercode", number))
 sort="cashaccount A, accountname A"
)
