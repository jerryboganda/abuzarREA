table(column=(type=char(60) updatewhereclause=yes name=customer dbname="name1"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=decimal(2) updatewhereclause=yes name=postedbalance dbname="PostedBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=unpostedbalance dbname="UnpostedBalance"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
 retrieve="SELECT
	name1, 
	Address,
	PostedBalance = Value1, 
	UnpostedBalance = Value2, 
	AliasName, 
	Area, 
	AreaCode

FROM
(SELECT 
	A.Name AS name1, 
	C.Address1 AS Address,
	Sum(V.BALANCE) AS value1, 
	Sum(V2.BALANCE) AS value2, 
	A.AliasName, 
	Area=Area.Name, 
	AreaCode=Area.AreaCode
FROM 
	Accounts A
	LEFT OUTER JOIN 
		(SELECT T.AccCode, Sum(T.Debit - T.Credit) AS Balance 
		FROM VirtualGL T 
		WHERE T.Date <= :ar_Date
		GROUP BY T.AccCode) AS V
		ON (A.AccCode = V.AccCode)
	LEFT OUTER JOIN 
		(SELECT T.AccCode, Sum(T.Debit - T.Credit) AS Balance 
		FROM DBO.Fn_GetUnposted_AccTrans() AS T 
		WHERE T.Date <= :ar_Date
		GROUP BY T.AccCode) AS V2
		ON (A.AccCode = V2.AccCode),
	Customer C,
	SubAccounts S,
	Area
WHERE 
	A.AccCode = C.CustCode AND
	C.AreaCode IN (:ar_Areas) AND 
	C.AreaCode = Area.AreaCode AND
	A.SubCode = S.SubAccCode AND 
	S.SubAccCode = 3 AND 
	(A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'Y' END OR
	A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'N' END)
GROUP BY A.AccCode, A.Name, A.AliasName, Area.Name, Area.AreaCode, C.Address1) A
"
  arguments=(("ar_Date", datetime), ("ar_Areas", numberlist), ("ar_Restricted", number))
 sort="area A, customer A, aliasname A"
)
