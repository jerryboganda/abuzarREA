table(column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=char(27) updatewhereclause=yes name=doccode dbname="type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="openbalance"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VoucherCode"  )
 retrieve="SELECT
	Customer=A.name,
	AliasName=A.aliasname,
	Address=C.Address1,
	documentcode=V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Debit,
	credit= V.Credit,
	remarks = V.Remarks,
	openbalance=(SELECT isnull(sum(vv.debit-vv.credit), 0) FROM virtualgl vv 
					WHERE vv.acccode=A.acccode and vv.date < :ar_startdate),
	AreaCode=Ar.AreaCode,
	Area=Ar.Name,
	V.CheckNo,
	V.VRow,
	V.VoucherCode
FROM
	(SELECT * FROM VirtualGL 
	WHERE date >= :ar_startdate and date <= :ar_enddate) V,
	Accounts A, 
	Customer C, 
	Area Ar
WHERE
	C.AreaCode IN (:ar_areacode) and
	C.AreaCode = Ar.AreaCode and
	C.CustCode = A.AccCode and
	(V.AccCode = A.AccCode OR V.AlternateAccCode = A.AccCode ) and
	V.date >= :ar_startdate and V.date <= :ar_enddate
UNION ALL
SELECT
	Customer=A.name,
	AliasName=A.aliasname,
	Address=C.Address1,
	documentcode=V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Credit,
	credit= V.Debit,
	remarks = Case debit 
			When 0 then 'Cash Paid Against Sale Ret. # '
			Else 'Cash Received Against Sales Inv. # '
			End + RTrim(LTrim(convert(char(6), V.documentcode))),
	openbalance=(SELECT isnull(sum(vv.debit-vv.credit), 0) 
					FROM virtualgl vv 
					WHERE vv.acccode=A.acccode and vv.date < :ar_startdate),
	AreaCode=Ar.AreaCode,
	Area=Ar.Name,
	V.CheckNo,
	V.VRow,
	V.VoucherCode
FROM 
	(SELECT * FROM VirtualGL WHERE date >= :ar_startdate and date <= :ar_enddate) V,
	Accounts A, 
	Customer C, 
	Area Ar
WHERE
	V.AlternateAccCode = A.AccCode and
	C.CustCode = A.AccCode and
	C.AreaCode IN (:ar_areacode) and
	C.AreaCode = Ar.AreaCode and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
ORDER BY
	A.name, 
	A.aliasname, 
	date, 
	type, 
	VRow
"
  arguments=(("ar_areacode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
