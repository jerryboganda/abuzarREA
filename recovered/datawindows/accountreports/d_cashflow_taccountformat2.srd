release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=808 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=208 color="536870912"  height.autosize=yes)
table(column=(type=datetime updatewhereclause=yes initial="today" name=startdate dbname="StartDate"  )
column=(type=datetime updatewhereclause=yes initial="today" name=enddate dbname="EndDate"  )
column=(type=long updatewhereclause=yes initial="0" name=cashbank dbname="Cashbank"  )
column=(type=long updatewhereclause=yes initial="0" name=transacconly dbname="Transacconly"  )
column=(type=long updatewhereclause=yes initial="-1" name=acccode dbname="AccCode"  )
column=(type=char(100) updatewhereclause=yes name=account dbname="Account"  )
column=(type=long updatewhereclause=yes name=subcode dbname="SubCode"  )
column=(type=char(1000) updatewhereclause=yes name=debitsource dbname="DebitSource"  )
column=(type=char(100) updatewhereclause=yes name=debitremarks dbname="DebitRemarks"  )
column=(type=long updatewhereclause=yes name=debitsubamount dbname="DebitSubAmount"  )
column=(type=long updatewhereclause=yes initial="0" name=debitamount dbname="DebitAmount"  )
