column=(type=char(100) updatewhereclause=yes name=debitcheckno dbname="DebitCheckNo"  )
column=(type=long updatewhereclause=yes name=debitid dbname="DebitID"  )
column=(type=char(1000) updatewhereclause=yes name=creditsource dbname="CreditSource"  )
column=(type=char(100) updatewhereclause=yes name=creditremarks dbname="CreditRemarks"  )
column=(type=long updatewhereclause=yes name=creditsubamount dbname="CreditSubAmount"  )
column=(type=long updatewhereclause=yes initial="0" name=creditamount dbname="CreditAmount"  )
column=(type=char(100) updatewhereclause=yes name=credittype dbname="CreditType"  )
column=(type=char(100) updatewhereclause=yes name=creditcheckno dbname="CreditCheckNo"  )
column=(type=long updatewhereclause=yes name=creditid dbname="CreditID"  )
column=(type=long updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=long updatewhereclause=yes name=usercode dbname="Usercode" 
 values=""  )
 retrieve="SELECT
	StartDate=GETDATE(),
	EndDate=GETDATE(),
	Cashbank=0,
	Transacconly=0,
	AccCode=-1,
	Account=SPACE(100),
	SubCode =-1,
	DebitSource=SPACE(1000),
	DebitRemarks=SPACE(100),
	DebitSubAmount=0,
	DebitAmount=0,
	DebitType=SPACE(100),
	DebitCheckNo=SPACE(100),
	DebitID=-1,
	CreditSource=SPACE(1000),
	CreditRemarks=SPACE(100),
	CreditSubAmount=0,
	CreditAmount=0,
	CreditType=SPACE(100),
	CreditCheckNo=SPACE(100),
	CreditID=-1,
	RowID=0,
	Usercode=NULL
"
  sort="account A, rowid A"
 filter="trim(lower( debitsource )) <> 'opening balance -' OR trim(lower( creditsource )) <> 'opening balance -'"
 )
