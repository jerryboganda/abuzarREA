table(column=(type=datetime updatewhereclause=yes name=date dbname="DATE"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="AMOUNT"  )
column=(type=long updatewhereclause=yes name=vouchers dbname="TOTALVOUCHERS"  )
column=(type=char(30) updatewhereclause=yes name=day dbname="DAY"  )
column=(type=char(30) updatewhereclause=yes name=vocuhercategory dbname="VocuherCategory"  )
 retrieve="SELECT
	DATE=CONVERT(DATETIME, DATE),
	AMOUNT=SUM(AMOUNT), 
	TOTALVOUCHERS=SUM(CNT),
	DAY=DATENAME(DW, DATE),
	VocuherCategory=(SELECT Name FROM VocherCategory WHERE VochCatCode = :ar_VoucherCatCode)
FROM
	(SELECT
		Date=RTRIM(LTRIM(STR(DATEPART(month, H.Date)))) + '-' +
			RTRIM(LTRIM(STR(DATEPART(day, H.Date)))) + '-' +
			RTRIM(LTRIM(STR(DATEPART(year, H.Date)))),
		Amount=ISNULL((SELECT SUM(D.Debit) 
				FROM GLDetail D 
				WHERE H.GLVochCode = D.GLVochCode), 0),
		Cnt=COUNT(H.GLvochCode)
	FROM
		GLHeader H
	WHERE
		H.Date BETWEEN :ar_startdate AND :ar_enddate AND
		H.VochCatCode = :ar_VoucherCatCode
	GROUP BY
		H.GLVochCode, H.Date) D
GROUP BY
	D.DATE
ORDER BY
	DATE"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ar_VoucherCatCode", number))
)
