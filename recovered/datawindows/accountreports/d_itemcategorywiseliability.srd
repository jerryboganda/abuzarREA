release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1500 color="536870912" )
summary(height=291 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=decimal(5) updatewhereclause=yes name=stockvalue dbname="stockvalue"  )
column=(type=char(100) updatewhereclause=yes name=suppliercategory dbname="SupplierCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
 retrieve="SELECT	ItemCategory=IC.Name,
	stockvalue=Isnull(Round(sum(ST.currqty * I.AvgPrice), 2), 0),
	SupplierCategory=Isnull((SELECT Name FROM suppliercategory where suppcatcode = IC.IcatCode), ''),
	Balance=Isnull((SELECT SUM(v.debit - v.credit) as balance 
		from 	virtualgl v, supplier s, suppliercategory sc
		where 	v.acccode = s.suppcode and 
			s.suppcatcode = sc.suppcatcode and 
			sc.suppcatcode = IC.IcatCode
		GROUP BY sc.suppcatcode), 0)
FROM	
	(SELECT G.icode, sum(G.currqty) as currqty
	FROM GodownDetail G
	GROUP By G.Icode
	UNION ALL
	SELECT It.icode, 0 as currqty
	FROM Item It
	WHERE It.Icode NOT IN (SELECT DISTINCT icode from godowndetail)) ST, 
	ItemCategory IC, 
	Item I
WHERE	I.Icode = ST.Icode AND 
	I.IcatCode=IC.IcatCode
GROUP BY IC.Name, IC.ICatCode
ORDER BY IC.Name"
 )
