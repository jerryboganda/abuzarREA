table(column=(type=char(60) updatewhereclause=yes name=name1 dbname="name1"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
 retrieve="SELECT
	name1, 
	debit = CASE WHEN Value1 > 0 THEN Value1 ELSE 0 END, 
	credit = CASE WHEN Value1 < 0 THEN Abs(Value1) ELSE 0 END, 
	AliasName, 
	Area, 
	AreaCode

FROM

(SELECT 
	A.Name AS name1, 
	Sum(V.BALANCE) AS value1, 
	A.AliasName, 
	Area=Area.Name, 
	AreaCode=Area.AreaCode
FROM 
	Accounts A
	LEFT OUTER JOIN 
		(SELECT T.AccCode, Sum(T.Debit - T.Credit) AS Balance 
		FROM VirtualGL T 
		WHERE T.Date <= :ar_Date
		GROUP BY T.AccCode) AS V
		ON (A.AccCode = V.AccCode),
	Customer C,
	SubAccounts S,
	Area
WHERE 
	A.AccCode = C.CustCode AND
	C.AreaCode IN (:ar_Areas) AND 
	C.AreaCode = Area.AreaCode AND
	A.SubCode = S.SubAccCode AND 
	S.SubAccCode = 3 AND 
	(A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'Y' END OR
	A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'N' END)
GROUP BY A.AccCode, A.Name, A.AliasName, Area.Name, Area.AreaCode) A
ORDER BY Area, NAME1, AliasName"
  arguments=(("ar_Date", datetime), ("ar_Areas", numberlist), ("ar_Restricted", number))
)
