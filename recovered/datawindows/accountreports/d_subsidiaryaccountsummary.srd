footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=subaccounts_subacccode dbname="SubAccounts.SubAccCode"  )
column=(type=long updatewhereclause=yes name=accounts_acccode dbname="Accounts.AccCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="Accounts.name1"  )
column=(type=char(60) updatewhereclause=yes name=accountsgroupname dbname="SubAccounts.Name2"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="OpenBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=debits dbname="debits"  )
column=(type=decimal(2) updatewhereclause=yes name=credits dbname="Credits"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="balance"  )
 retrieve="SELECT S.SubAccCode, 
		 A.AccCode, 
		 A.AliasName,
		 A.Name AS name1, 
		 S.Name AS Name2, 
		 OpenBalance= ISNULL((SELECT SUM(GL.Debit - GL.Credit)
							FROM VirtualGl GL 
							WHERE GL.ACCCODE = A.ACCCODE AND
									GL.date < :ad_StartDate), 0),
		 ISNULL(Sum(Debit), 0) AS debits,
		 ISNULL(Sum(Credit), 0) AS Credits,
		 ISNULL(Sum(Debit - Credit), 0) AS balance
FROM 
	SubAccounts S,
	Accounts A
		LEFT OUTER JOIN 
			(SELECT VirtualGL.* FROM VirtualGL
			WHERE VirtualGL.date BETWEEN :ad_StartDate AND :ad_EndDate) AS V ON (A.AccCode = V.AccCode)
WHERE S.SubAccCode IN (:aa_SubAccCode) AND
		S.SubAccCode = A.SubCode
GROUP BY S.SubAccCode, A.AliasName, A.AccCode, A.Name, S.Name
ORDER BY S.Name, A.Name
   
"
  arguments=(("aa_subacccode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime))
)
