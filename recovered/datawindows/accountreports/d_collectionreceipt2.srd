table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleLedger.saleinvcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="SaleLedger.HeaderNo"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="SaleLedger.HeaderInvNo"  )
column=(type=long updatewhereclause=yes name=custcode dbname="Custcode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=decimal(2) updatewhereclause=yes name=net dbname="Net"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
 retrieve="SELECT
	SL.saleinvcode,
	SL.HeaderNo,
	SL.HeaderInvNo, 
	Custcode=A.AccCode,
	AliasName=A.AliasName,
	Customer=A.Name,
	Net=SL.InvTotal,
	Balance=
		Isnull((SELECT Balance=Sum(V.debit-V.credit) 
					From VirtualGL V 
					WHERE V.AccCode = A.AccCode OR V.AlternateAccCode = A.AccCode), 0),
	Address=C.Address1,
	Area=Area.Name

FROM
	saleledger SL,	 
	saledetail SD,
	Customer C,
	Area,
	Accounts A

WHERE SL.Posted = 'N' AND SL.SaleCatCode IN (1,2) AND
		SL.SaleInvCode Between :ai_SinvCode AND :ai_LinvCode AND
		SL.SaleInvCode = SD.SaleInvcode AND
		SL.CustCode IN (:ai_CustCode) AND
		SL.Custcode = C.Custcode AND
		C.CustCode= A.Acccode AND
		C.AreaCode = Area.AreaCode

GROUP BY SL.saleinvcode,
	 A.AccCode,
	 A.Name,
	 SL.date,
	 C.Address1,
	 Area.Name,
	 SL.HeaderNo,
	 SL.HeaderInvNo,
	 SL.InvTotal,
	 A.AliasName
Order BY 
	Customer,
	AliasName,
 	Custcode,
	SL.SaleInvCode"
  arguments=(("ai_custcode", numberlist), ("ai_sinvcode", number), ("ai_linvcode", number))
)
