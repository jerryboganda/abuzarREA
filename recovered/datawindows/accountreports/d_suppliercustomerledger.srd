table(column=(type=long updatewhereclause=yes name=documentcode dbname="VirtualGl.documentcode"  )
column=(type=char(27) updatewhereclause=yes name=type dbname="type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remark"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="name"  )
column=(type=char(60) updatewhereclause=yes name=name2 dbname="name2"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="cash"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="VirtualGl.checkno"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VirtualGl.vouchercode"  )
 retrieve="select   V.documentcode, 
	 		type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
			date = V.date, 
	 		debit = V.Debit,
	 		credit= V.Credit,
			remark = V.Remarks,
			name = (Select name from accounts where acccode = :ar_custcode),		
			name2 = (Select name from accounts where acccode = :ar_suppcode),		
			cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
			v.checkno,
			V.vouchercode

from     VirtualGL V	

where    (V.AccCode =  :ar_custcode OR V.AlternateAccCode = :ar_custcode OR 
			 V.AccCode =  :ar_suppcode OR V.AlternateAccCode = :ar_suppcode) and
			V.date     >= :ar_startdate and
			V.date     <= :ar_enddate	 	
union all
select   V.documentcode, 
	 		type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
			date = V.date, 
	 		debit = V.Credit,
	 		credit= V.Debit,
			remark = Case debit 
						When 0 then 
							Case V.DocumentType 
							When 'SR' THEN 'Cash Paid Against Sale Ret. # '
							Else 'Cash Paid Against Purchase Inv. # ' End
						Else 
							Case V.DocumentType 
							When 'SV' THEN 'Cash Received Against Sales Inv. # '
							Else 'Cash Received Against Purchase Return # ' End
			End + RTrim(LTrim(convert(char(6), V.documentcode))),
			name = (Select name from accounts where acccode = :ar_custcode),		
			name2 = (Select name from accounts where acccode = :ar_suppcode),		
			cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
			v.checkno,
			V.vouchercode

from     VirtualGL V	

where    (V.AlternateAccCode = :ar_custcode) and
			V.date     >= :ar_startdate and
			V.date     <= :ar_enddate	 	
order by   date, type, debit, credit
"
  arguments=(("ar_suppcode", number), ("ar_custcode", number), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_opnebalance", number))
 sort="date A"
)
