table(column=(type=long updatewhereclause=yes name=glvochcode dbname="Glheader.GlVochCode"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="Glheader.VoucherCode"  )
column=(type=char(30) updatewhereclause=yes name=vouchertype dbname="VoucherType"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Glheader.Date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="Users.UserCode"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Glheader.Posted"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="Glheader.PostDate"  )
column=(type=long updatewhereclause=yes name=acccode dbname="GLDetail.AccCode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="GLDetail.Remarks"  )
column=(type=char(20) updatewhereclause=yes name=cheque dbname="Cheque"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="GLDetail.Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="GLDetail.Credit"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowId"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=long updatewhereclause=yes name=invoicebased dbname="InvoiceBased"  )
 retrieve="SELECT
	H.GlVochCode,
	H.VoucherCode, 
	VoucherType=V.Name,
	H.Date,
	U.UserCode,
	Username=U.UserName,
	H.Posted,
	H.PostDate,
	D.AccCode,
	D.Remarks,
	Cheque=D.Chkno,
	D.Debit,
	D.Credit,
	AccountName=A.Name,
	AliasName=A.AliasName,
	RowId=D.Identitycol,
	InvoiceCode=D.InvoiceCode,
	InvoiceBased=V.InvoiceBased

FROM
	GlDetail D, 
	GlHeader H,
	VocherCategory V,
	Users U,
	Accounts A

WHERE
	H.GlVochCode = D.GlVochCode AND
	H.VochCatCode IN (:ar_VoucherType) AND
	H.VochCatCode = V.VochCatCode AND
	H.VoucherCode >= :ar_StartCode AND 
	H.VoucherCode <= :ar_EndCode AND
	H.DATE >= :ar_StartDate AND 
	H.DATE <= :ar_EndDate AND
	H.SalesManCode = U.UserCODE AND
	D.AccCode = A.AccCode

ORDER BY
	VoucherType,
	H.VoucherCode,
	D.Identitycol,
	A.Name,
	A.AliasName"
  arguments=(("ar_vouchertype", numberlist), ("ar_StartCode", number), ("ar_EndCode", number), ("ar_StartDate", datetime), ("ar_EndDate", datetime))
 sort="vouchertype A, vouchercode A, rowid A, accountname A, aliasname A"
)
