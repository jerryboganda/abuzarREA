release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=1 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=822 color="536870912" )
header[2](height=354 color="536870912" )
summary(height=177 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=date1 dbname="date1"  )
column=(type=char(20) updatewhereclause=yes name=name3 dbname="name3"  )
column=(type=number updatewhereclause=yes name=value1 dbname="value1"  )
 retrieve="SELECT Code1, Code2, Code3, Code4, Date1, Date2, Name1, Name2, Name3, Name4, Value1, Value2, Value3, Value4
FROM ReportData
WHERE Code3 <> 2 AND Code4 IS NULL
ORDER BY
	Name1, 
	Name2, 
	Name3,
	Value1"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("as_functionalarea", string))
 sort="date1 A, name3 A"
)
group(level=1 header.height=0 trailer.height=0 by=("date1"  ) header.color="536870912" trailer.color="536870912" )
text(name=t_reportname visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-11" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" alignment="0" border="0" x="31" y="31" height="187" width="7302" text="Daily Income Statement" html.valueishtml="0" )
compute(name=compute_19 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="4458" y="31" height="166" width="2875" format="[GENERAL]" expression="'Page ' + page() + ':' + pageAcross() + ' of ' + pageCount() + ':' + pageCountAcross()" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_companyname visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" x="31" y="250" height="166" width="7302" format="[GENERAL]" expression="f_ReportHeaderInfo('clientname')" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_7 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="31" y="645" height="166" width="7302" format="[GENERAL]" expression="'Functional Area:' +  case(as_functionalarea  when 'S' then 'Store' when 'H' then 'Hospital' else 'All') + '   From: ' + String( ad_startdate, 'dd/mm/yyyy hh:mm:ss' ) + '  To: ' + String( ad_enddate, 'dd/mm/yyyy hh:mm:ss' ) + ~"     Report Date:~" + string(today(),  'dd/mm/yyyy hh:mm:ss' )" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_address2 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" x="31" y="447" height="166" width="7302" format="[GENERAL]" expression="f_ReportHeaderInfo('address2')" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
text(name=value1_t visible="1	if( name3 = 'Expenses' ,0,1)" band=header[2] font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="1" border="0" x="1187" y="10" height="333" width="614" text="@name2" html.valueishtml="0" )
text(name=grand_sum_value1_t visible="1" band=header[2] font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" alignment="1" border="0" x="1822" y="10" height="333" width="635" text="Grand
Total " html.valueishtml="0" )
text(name=name3_t visible="1" band=header[2] font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="2" border="0" x="666" y="10" height="166" width="500" text="Remarks" html.valueishtml="0" )
text(name=date1_t visible="1" band=header[2] font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="2" border="0" x="20" y="10" height="166" width="625" text="Date" html.valueishtml="0" )
compute(name=compute_5 visible="1" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" x="1187" y="10" height="156" width="614" format="[general]" expression="sum(value1 for all )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_6 visible="1" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" x="1822" y="10" height="156" width="635" format="[general]" expression="sum(grand_sum_value1 for all )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_4 visible="1" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="20" y="10" height="156" width="625" format="[general]" expression="~"Total~"" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
column(name=value1 visible="1" band=detail id=3 x="1187" y="11" height="156" width="614" color="33554432" border="0" alignment="1" format="[general]" html.valueishtml="0" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=no edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=yes background.mode="1" background.color="536870912" font.charset="0" font.face="Times New Roman" font.family="2" font.height="-9" font.pitch="2" font.weight="400" tabsequence=0 )
column(name=name3 visible="1" band=detail id=2 x="666" y="11" height="156" width="500" color="33554432" border="0" alignment="0" format="[general]" html.valueishtml="0" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=no edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=100 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Times New Roman" font.family="2" font.height="-9" font.pitch="2" font.weight="400" tabsequence=0 )
column(name=date1 visible="1" band=detail id=1 x="20" y="11" height="156" width="625" color="33554432" border="0" alignment="0" format="dd/mm/yyyy" html.valueishtml="0" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=no edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Times New Roman" font.family="2" font.height="-9" font.pitch="2" font.weight="400" tabsequence=0 )
compute(name=grand_sum_value1 visible="1" band=detail font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" x="1822" y="11" height="156" width="635" format="[general]" expression="crosstabsum(1)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
crosstab(columns="name2" rows="date1, name3" values="sum(value1 for crosstab)" sourcenames = "code1, code2, code3, code4, date1, date2, name1, name2, name3, name4, value1, value2, value3, value4" crosstabonly=yes  band=foreground )
compute(name=compute_1 visible="0" band=trailer.1 font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="20" y="10" height="197" width="625" format="[general]" expression="date1 + ~" Total~"" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_2 visible="0" band=trailer.1 font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="1187" y="10" height="197" width="614" format="[general]" expression="sum(value1 for group 1)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_3 visible="0" band=trailer.1 font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="1822" y="10" height="197" width="635" format="[general]" expression="sum(grand_sum_value1 for group 1)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
sparse(names="date1")
htmltable(border="0" cellPadding="1" cellSpacing="1" )
