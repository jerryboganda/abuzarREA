release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=576 color="536870912" )
summary(height=76 color="536870912" )
footer(height=0 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=service dbname="Service"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=decimal(6) updatewhereclause=yes name=netrevenue dbname="NetRevenue"  )
column=(type=decimal(2) updatewhereclause=yes name=collection dbname="Collection"  )
 retrieve="SELECT 	
	Service=SV.Name, 
	StudentCode=S.StudentCode, 
	RegNo = S.RegNo,
	StudentName=S.Name, 
	NetRevenue=SUM(RC.NetRevenue),
	Collection=SUM(RC.Collection)
FROM
	Student S, Service SV, 
	(SELECT 
		SD.ServiceCode,
		SH.ServiceinvCode,
		SH.StudentCode,
		NetRevenue = SUM(SD.Qty * (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SH.DiscPerc * 0.01)),
		Collection=0
	FROM
		ServiceHeader SH, ServiceDetail SD
	WHERE
		SH.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SH.StudentCode IS NOT NULL AND
		SH.ServiceInvCode = SD.ServiceInvCode AND
		SD.ServiceCode IN (:ai_servicecode)
	GROUP BY
		SH.ServiceinvCode,
		SH.StudentCode,
		SD.ServiceCode
	UNION ALL
	SELECT 
		SD.ServiceCode,
		SH.ServiceinvCode,
		SH.StudentCode,
		NetRevenue = -SUM(SD.Qty * (SD.ServicePrice - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SH.DiscPerc * 0.01)),
		Collection=0
	FROM
		ServiceRHeader SH, ServiceRDetail SD
	WHERE
		SH.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SH.StudentCode IS NOT NULL AND
		SH.ServiceRInvCode = SD.ServiceRInvCode AND
		SD.ServiceCode IN (:ai_servicecode)
	GROUP BY
		SH.ServiceinvCode,
		SH.StudentCode,
		SD.ServiceCode
	UNION ALL
	SELECT 
		ServiceCode=D.ServiceCode,
		V.InvoiceCode,
		V.StudentCode,
		NetRevenue = 0,
		Collection=SUM(CASE WHEN Credit > 0 THEN V.Credit ELSE 0 END)
	FROM
		VirtualGL V, ServiceDetail D, ServiceHeader S
	WHERE
		V.Date BETWEEN :adt_startdate AND :adt_enddate AND
		V.StudentCode IS NOT NULL AND
		V.Credit > 0 AND
		V.InvoiceCode > 0 AND
		(V.AccCode IN (SELECT A.AccCode FROM Accounts A WHERE A.SubCode = 3) OR
		ISNULL(V.AlternateAccCode,-1) IN (SELECT A.AccCode FROM Accounts A WHERE A.SubCode = 3)) AND
		(V.DocumentType IN ('RS') OR
		V.DocumentType IN (SELECT VC.ShortName FROM VocherCategory VC WHERE VC.InvoiceType=3)) AND
		V.InvoiceCode = S.ServiceInvCode AND
		V.InvoiceCode = D.ServiceInvCode AND
		S.ServiceInvCode = D.ServiceInvCode AND 
		S.Outstandingamt = 0 AND
		D.ServiceCode IN (:ai_servicecode)
	GROUP BY
		V.InvoiceCode,
		V.StudentCode,
		D.ServiceCode) RC
WHERE
	S.StudentCode = RC.StudentCode AND
	SV.ServiceCode = RC.ServiceCode
GROUP BY
	SV.Name, 
	S.StudentCode, 
	S.RegNo,
	S.Name
ORDER BY
	Service,
	StudentName
"
  arguments=(("ai_servicecode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
