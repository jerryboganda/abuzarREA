release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=593 color="536870912" )
summary(height=208 color="536870912" )
footer(height=0 color="536870912" )
detail(height=156 color="536870912"  height.autosize=yes)
table(column=(type=char(60) updatewhereclause=yes name=account dbname="Account"  )
column=(type=char(100) updatewhereclause=yes name=schoolbranch dbname="SchoolBranch"  )
column=(type=char(100) updatewhereclause=yes name=classname dbname="ClassName"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=name dbname="Name"  )
column=(type=decimal(2) updatewhereclause=yes name=collection dbname="Collection"  )
 retrieve="SELECT 
	Account = (SELECT A.Name FROM Accounts A WHERE A.AccCode = T.AccCode),
	S.SchoolBranch,
	S.ClassName,
	S.RegNo,
	S.Name,
	Collection=SUM(T.Collection)
FROM
	(SELECT S.StudentCode, S.RegNo, S.Name, S.CurrentClass,  ClassName=C.Name, B.SchoolBranchCode, SchoolBranch=B.Name
	FROM 
		Student S, SchoolBranch B, Class C
	WHERE 
		B.SchoolBranchCode = C.SchoolBranchCode AND
		C.ClassCode = S.CurrentClass) S,
	(SELECT /*Transaction Details debit=credit and credit=debit*/
		h.acccode,
		d.studentcode,
		Collection=d.credit - d.debit
	FROM
		glheader h,
		gldetail d,
		vochercategory vc,
		accounts a
	WHERE
		h.posted = 'Y' and
		h.glvochcode = d.glvochcode and
		h.vochcatcode = vc.vochcatcode and
		vc.journalvoucher = 0 and
		h.acccode in (:ai_acccode) and
		h.acccode <> d.acccode and 
		d.acccode = a.acccode and
		h.date BETWEEN :ad_StartDate and :ad_endDate
	UNION ALL
	SELECT /*transaction involving cash in detail but not a cash voucher category*/
		h.acccode,
		d.studentcode,
		Collection=d.debit - d.credit
	FROM
		glheader h,
		gldetail d,
		vochercategory vc,
		accounts a
	WHERE
		h.posted = 'Y' and
		h.glvochcode = d.glvochcode and
		h.vochcatcode = vc.vochcatcode and
		vc.journalvoucher = 0 and
		h.acccode not in (:ai_acccode) and
		d.acccode in (:ai_acccode) and
		d.acccode = a.acccode and
		h.date BETWEEN :ad_StartDate and :ad_endDate
	UNION ALL
	SELECT /*transaction involving cash deposited in a cash a/c from another cash a/c*/
		h.acccode,
		d.studentcode,
		Collection=d.debit - d.credit
	FROM
		glheader h,
		gldetail d,
		vochercategory vc,
		accounts a
	WHERE
		h.posted = 'Y' and
		h.glvochcode = d.glvochcode and
		h.vochcatcode = vc.vochcatcode and
		vc.journalvoucher = 0 and
		h.acccode in (:ai_acccode) and
		d.acccode in (:ai_acccode) and
		h.acccode <> d.acccode and
		d.acccode = a.acccode and
		h.date BETWEEN :ad_StartDate and :ad_endDate
	UNION ALL
	SELECT /*debit/credit adjustment for cash/bank accounts using JVs*/
		acc=d.acccode,
		d.studentcode,
		Collection=d.debit - d.credit
	FROM
		glheader h,
		gldetail d,
		vochercategory vc
	WHERE
		h.posted = 'Y' and
		h.glvochcode = d.glvochcode and
		h.vochcatcode = vc.vochcatcode and
		vc.journalvoucher = 1 and
	 	d.acccode IN (:ai_acccode) and 
		h.date BETWEEN :ad_StartDate and :ad_endDate
	UNION ALL
	SELECT 
		acccode=s.paymentacccode ,
		s.studentcode,
		Collection = ISNULL(SUM(S.Amt), 0)
	FROM
		(SELECT h.paymentacccode, h.studentcode, amt=ISNULL(Round(SUM(d.looseqty * d.unitsalestax) + 
				SUM(ROUND( (d.looseqty * 
					(d.saleprice - d.itemflatdisc)) *
					(1 - (.01 * d.discperc)) * 
					d.gstperc * .01, 2)) +
				ROUND( (SUM((d.looseqty * 
					(d.saleprice - d.itemflatdisc)) *
					(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) -
					h.flatdisc) * (h.invgstperc1 * .01), 2), 0) +
				Round( SUM((d.looseqty * (d.saleprice - d.itemflatdisc)) *
					(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + 
					h.misccharges + h.salestax - h.flatdisc, 0), 0)
		FROM
			saleledger h,
			saledetail d
		WHERE
			h.saleinvcode = d.saleinvcode and
			h.salecatcode = 3 and
			h.paymentacccode IN (:ai_acccode) AND
			h.posted = 'Y' and 
			h.accountfor='Y' and
			h.date BETWEEN :ad_StartDate and :ad_endDate
		GROUP BY 
			 h.paymentacccode, h.studentcode,
			 h.saleinvcode,
			 h.salecatcode, 
			 h.date,
			 h.discperc,
			 h.misccharges,
			 h.salestax,
			 h.InvGSTPerc1,
			 h.flatdisc) S 
	GROUP BY
		s.paymentacccode ,
		s.studentcode
	HAVING SUM(S.Amt) <> 0
	UNION ALL
	SELECT 
		acccode=s.paymentacccode ,
		s.studentcode,
		Collection = ISNULL(SUM(S.Amt), 0)
	FROM
		(SELECT h.paymentacccode, h.studentcode, amt=ISNULL(Round(SUM(d.looseqty * d.unitsalestax) + 
				SUM(ROUND( (d.looseqty * 
					(d.saleprice - d.itemflatdisc)) *
					(1 - (.01 * d.discperc)) * 
					d.gstperc * .01, 2)) +
				ROUND( (SUM((d.looseqty * 
					(d.saleprice - d.itemflatdisc)) *
					(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) -
					h.flatdisc) * (h.invgstperc1 * .01), 2), 0) +
				Round( SUM((d.looseqty * (d.saleprice - d.itemflatdisc)) *
					(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + 
					h.misccharges + h.salestax - h.flatdisc, 0), 0)
		FROM
			saleledger h,
			saledetail d
		WHERE
			h.saleinvcode = d.saleinvcode and
			h.salecatcode = 1 and
			h.paymentacccode IN (:ai_acccode) AND
			h.posted = 'Y' and 
			h.accountfor='Y' and
			h.date BETWEEN :ad_StartDate and :ad_endDate
		GROUP BY h.paymentacccode, h.studentcode, h.saleinvcode,
			 h.salecatcode, 
			 h.date,
			 h.discperc,
			 h.misccharges,
			 h.salestax,
			 h.InvGSTPerc1,
			 h.flatdisc) S 
	GROUP BY
		s.paymentacccode ,
		s.studentcode
	HAVING SUM(S.Amt) > 0
	UNION ALL
	SELECT 
		acccode=s.paymentacccode ,
		s.studentcode,
		Collection = - ISNULL(SUM(S.Amt), 0)
	FROM
		(SELECT h.paymentacccode, h.studentcode, amt=ISNULL(sum(amt), 0)
		FROM
			saleledger h
		WHERE
			h.salecatcode IN (1, 2) and
			h.amt <> 0 and
			h.posted = 'Y' and 
			h.accountfor='Y' and
			h.date BETWEEN :ad_StartDate and :ad_endDate AND
			h.paymentacccode in (:ai_acccode)
		GROUP BY h.paymentacccode, h.studentcode) S
	GROUP BY
		s.paymentacccode ,
		s.studentcode
	HAVING SUM(S.Amt) > 0
	UNION ALL
	SELECT 
		acccode=s.paymentacccode,
		s.studentcode, 
		Collection = - ISNULL(SUM(S.Amt), 0)
	FROM
		(SELECT h.paymentacccode, h.studentcode, amt=ISNULL(Round(SUM(d.looseqty * d.unitsalestax) + 
				SUM(ROUND( (d.looseqty * d.srprice) * (1 - (.01 * d.discperc)) * d.gstperc * .01, 2)) +
				ROUND( (SUM((d.looseqty * d.srprice) * 	(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) - h.flatdisc) * (h.invgstperc1 * .01), 2), 0) +
				Round( SUM((d.looseqty * d.srprice) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges + h.salestax - h.flatdisc, 0), 0)
		FROM
			srledger h,
			srdetail d
		WHERE
			h.srinvcode = d.srinvcode and
			h.srcatcode = 8 and
			h.paymentacccode IN (:ai_acccode) AND
			h.posted = 'Y' and
			h.accountfor = 'Y' and
			h.date BETWEEN :ad_StartDate and :ad_endDate
		GROUP BY h.srinvcode, h.paymentacccode, h.studentcode, 
			 h.srcatcode, 
			 h.date,
			 h.discperc,
			 h.misccharges,
			 h.salestax,
			 h.InvGSTPerc1,
			 h.flatdisc) S 
	GROUP BY
		s.paymentacccode ,
		s.studentcode
	HAVING SUM(S.Amt) > 0
	UNION ALL
	SELECT 
		acccode=s.paymentacccode, s.studentcode, 
		Collection = - ISNULL(SUM(S.Amt), 0)
	FROM
		(SELECT h.paymentacccode, h.studentcode, amt=ISNULL(Round(SUM(d.looseqty * d.unitsalestax) + 
				SUM(ROUND( (d.looseqty * d.srprice) * (1 - (.01 * d.discperc)) * d.gstperc * .01, 2)) +
				ROUND( (SUM((d.looseqty * d.srprice) * 	(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) - h.flatdisc) * (h.invgstperc1 * .01), 2), 0) +
				Round( SUM((d.looseqty * d.srprice) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges + h.salestax - h.flatdisc, 0), 0)
		FROM
			srledger h,
			srdetail d
		WHERE
			h.srinvcode = d.srinvcode and
			h.srcatcode = 6 and
			h.paymentacccode IN (:ai_acccode) AND
			h.posted = 'Y' and 
			h.accountfor='Y' and
			h.date BETWEEN :ad_StartDate and :ad_endDate
		GROUP BY h.paymentacccode, h.studentcode, h.srinvcode,
			 h.srcatcode, 
			 h.date,
			 h.discperc,
			 h.misccharges,
			 h.salestax,
			 h.InvGSTPerc1,
			 h.flatdisc) S 
	GROUP BY
		s.paymentacccode ,
		s.studentcode
	HAVING SUM(S.Amt) > 0
	UNION ALL
	SELECT 
		acccode=s.paymentacccode, 
		s.studentcode, 
		Collection = - ISNULL(SUM(S.Amt), 0)
	FROM
		(SELECT h.paymentacccode, h.studentcode, amt=ISNULL(SUM(h.amt), 0)
		FROM
			srledger h
		WHERE
			h.srcatcode IN (6,7) and
			h.posted = 'Y' and 
			h.accountfor='Y' and
			h.date BETWEEN :ad_StartDate and :ad_endDate AND
			h.paymentacccode in (:ai_acccode)
		GROUP BY h.paymentacccode, h.studentcode) S
	GROUP BY
		s.paymentacccode ,
		s.studentcode
	HAVING SUM(S.Amt) > 0
	UNION ALL
	SELECT 
		acccode=h.CashAccCode, 
		h.studentcode, 
		Collection = CASE WHEN H.ServiceCatCode = 10 THEN H.InvTotal ELSE H.CashCharged END
	FROM
		serviceheader h
	WHERE
		(h.CashCharged > 0 OR H.ServiceCatCode = 10) and
		h.cashacccode in (:ai_acccode) AND
		h.posted = 'Y' and
		h.date BETWEEN :ad_StartDate and :ad_endDate
	UNION ALL
	SELECT 
		acccode=h.CashAccCode, 
		h.studentcode, 
		Collection = CASE WHEN H.ServiceRCatCode = 13 THEN H.InvTotal ELSE H.CashCharged END
	FROM
		servicerheader h
	WHERE
		(h.CashCharged > 0 OR H.ServiceRCatCode = 13) and
		h.cashacccode in (:ai_acccode) AND
		h.posted = 'Y' and
		h.date BETWEEN :ad_StartDate and :ad_endDate) T
WHERE
	S.StudentCode = T.StudentCode
GROUP BY
	T.AccCode,
	S.StudentCode,
	S.RegNo,
	S.Name,
	S.ClassName,
	S.SchoolBranch
ORDER BY 
	Account,
	S.SchoolBranch,
	S.ClassName,
	S.Name,
	S.RegNo
"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_acccode", numberlist))
 sort="account A, schoolbranch A, classname A, name A, regno A"
)
