release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=183 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=char(28) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=description dbname="Remark"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Name"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="Cash"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="OpenBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=closingbalance dbname="ClosingBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=otherdebit dbname="OtherDebit"  )
column=(type=decimal(2) updatewhereclause=yes name=othercredit dbname="OtherCredit"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=decimal(0) updatewhereclause=yes name=vrow dbname="VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="vouchercode"  )
column=(type=long updatewhereclause=yes name=header dbname="Header"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(6) updatewhereclause=yes name=grossvalue dbname="GrossValue"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsaletax dbname="ItemSaleTax"  )
column=(type=decimal(6) updatewhereclause=yes name=itemvalue dbname="ItemValue"  )
column=(type=decimal(6) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(6) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=decimal(6) updatewhereclause=yes name=others dbname="Others"  )
column=(type=decimal(2) updatewhereclause=yes name=receivedoninv dbname="ReceivedOnInv"  )
column=(type=decimal(2) updatewhereclause=yes name=paidonreturns dbname="PaidOnReturns"  )
 retrieve="SELECT
	DocumentCode=NULL, 
	Type = NULL, 
	Date = NULL, 
	Remark = NULL,
	c.Name,
	Cash = NULL, 
	C.AliasName,
	Address=c.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	Virtualgl.AccCode=C.AccCode and 
				VirtualGL.Date < :ar_startdate),
	ClosingBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_enddate),
	OtherDebit=(SELECT ISNULL(SUM(VirtualGL.Debit), 0) FROM VirtualGL 
			WHERE 
				VirtualGL.DocumentType NOT IN ('SV', 'SR') AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date BETWEEN :ar_startdate AND :ar_enddate),
	OtherCredit=(SELECT ISNULL(SUM(VirtualGL.Credit), 0) FROM VirtualGL 
			WHERE 
				VirtualGL.DocumentType NOT IN ('SR','SV') AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date BETWEEN :ar_startdate AND :ar_enddate),
	C.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=NULL,
	vouchercode=NULL,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvSaleTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit = 0,
	Credit= 0,
	Others=0,
	ReceivedOnInv=ISNULL((SELECT SUM(SL.Amt) FROM SaleLedger SL WHERE SL.Posted = 'Y' AND SL.AccountFor = 'Y' AND SL.CustCode = C.AccCode AND SL.Amtdate BETWEEN :ar_startdate AND :ar_enddate AND SL.Amt <> 0 AND SL.SaleCatcode = 2), 0),
	PaidOnReturns= ISNULL((SELECT SUM(R.Amt) FROM SRLedger R WHERE R.Posted = 'Y' AND R.AccountFor = 'Y' AND R.CustCode = C.AccCode AND R.Amtdate BETWEEN :ar_startdate AND :ar_enddate AND R.Amt <> 0 AND R.SRCatCode = 7), 0)
FROM 
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE	
		A.AccCode NOT IN 
			(SELECT DISTINCT SL.CustCode FROM SaleLedger SL WHERE SL.Date BETWEEN :ar_startdate and :ar_enddate 
			UNION 
			SELECT DISTINCT SL.CustCode FROM SRLedger SL WHERE SL.Date BETWEEN :ar_startdate and :ar_enddate ) AND
		A.AccCode = CT.CustCode and 
		AR.AreaCode=CT.AreaCode) C
UNION ALL
SELECT
	DocumentCode=S.SaleInvCode,
	Type='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Name=c.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	C.AliasName, 
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	ClosingBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_enddate),
	OtherDebit=(SELECT ISNULL(SUM(VirtualGL.Debit), 0) FROM VirtualGL 
			WHERE 
				VirtualGL.DocumentType NOT IN ('SV', 'SR') AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date BETWEEN :ar_startdate AND :ar_enddate),
	OtherCredit=(SELECT ISNULL(SUM(VirtualGL.Credit), 0) FROM VirtualGL 
			WHERE 
				VirtualGL.DocumentType NOT IN ('SR','SV') AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date BETWEEN :ar_startdate AND :ar_enddate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.RowID),
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=SUM(D.LooseQty),
	Bonus=SUM(D.BonusQty),
	Rate=MAX(D.SalePrice),
	GrossValue=SUM(D.LooseQty * D.SalePrice),
	Discount=
		SUM(D.looseqty*D.itemflatdisc) +
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) + 
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * 
			(1-(.01*D.discperc)) * (.01 * S.discperc)),
	ItemSaleTax=SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
	ItemValue=SUM(D.LooseQty * D.SalePrice) - 
		SUM((D.looseqty*D.itemflatdisc) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (1-(.01*D.discperc)) * 
				(.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleInvDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleInvDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN CASE S.SaleCatCode WHEN 2 THEN 0 ELSE T.NetAmt END ELSE 0 END,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleInvDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	ReceivedOnInv=ISNULL((SELECT SUM(SL.Amt) FROM SaleLedger SL WHERE SL.Posted = 'Y' AND SL.AccountFor = 'Y' AND SL.CustCode = C.AccCode AND SL.Amtdate BETWEEN :ar_startdate AND :ar_enddate AND SL.Amt <> 0 AND SL.SaleCatcode = 2), 0),
	PaidOnReturns= ISNULL((SELECT SUM(R.Amt) FROM SRLedger R WHERE R.Posted = 'Y' AND R.AccountFor = 'Y' AND R.CustCode = C.AccCode AND R.Amtdate BETWEEN :ar_startdate AND :ar_enddate AND R.Amt <> 0 AND R.SRCatCode = 7), 0)
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	SaleLedger S,	 
	SaleInvDetail D,
	(SELECT 
		SS.SaleInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc),
		InvSaleTax=	ROUND((SUM((DD.looseqty * 
			(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM SaleLedger SS, SaleInvDetail DD,
			(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
			UNION ALL
			SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT
	WHERE 
		SS.Posted = 'Y' AND SS.AccountFor = 'Y' AND
		SS.ImpactInventory='N' AND
		SS.SaleInvCode = DD.SaleInvCode AND
		SS.CustCode = CT.CustCode AND
		SS.date BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		SS.SaleInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.ImpactInventory='N' AND
	S.SaleInvCode = D.SaleInvCode AND S.SaleInvCode = T.SaleInvCode AND
	S.CustCode IN (:ai_custcode) AND
	S.CustCode = C.AccCode AND
	S.date BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	S.SaleInvCode,
	S.SaleCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	D.ICode,
	D.RowGroup,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	C.AreaCode,
	C.Area,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	DocumentCode=S.SaleInvCode,
	Type='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Name=c.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	ClosingBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_enddate),
	OtherDebit=(SELECT ISNULL(SUM(VirtualGL.Debit), 0) FROM VirtualGL 
			WHERE 
				VirtualGL.DocumentType NOT IN ('SV', 'SR') AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date BETWEEN :ar_startdate AND :ar_enddate),
	OtherCredit=(SELECT ISNULL(SUM(VirtualGL.Credit), 0) FROM VirtualGL 
			WHERE 
				VirtualGL.DocumentType NOT IN ('SR','SV') AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date BETWEEN :ar_startdate AND :ar_enddate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.RowID),
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=SUM(D.LooseQty),
	Bonus=SUM(D.BonusQty),
	Rate=MAX(D.SalePrice),
	GrossValue=SUM(D.LooseQty * D.SalePrice),
	Discount=
		SUM(D.looseqty*D.itemflatdisc) +
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) + 
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * 
			(1-(.01*D.discperc)) * (.01 * S.discperc)),
	ItemSaleTax=SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
	ItemValue=SUM(D.LooseQty * D.SalePrice) - 
		SUM((D.looseqty*D.itemflatdisc) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (1-(.01*D.discperc)) * 
				(.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN CASE S.SaleCatCode WHEN 2 THEN 0 ELSE T.NetAmt END ELSE 0 END,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	ReceivedOnInv=ISNULL((SELECT SUM(SL.Amt) FROM SaleLedger SL WHERE SL.Posted = 'Y' AND SL.AccountFor = 'Y' AND SL.CustCode = C.AccCode AND SL.Amtdate BETWEEN :ar_startdate AND :ar_enddate AND SL.Amt <> 0 AND SL.SaleCatcode = 2), 0),
	PaidOnReturns= ISNULL((SELECT SUM(R.Amt) FROM SRLedger R WHERE R.Posted = 'Y' AND R.AccountFor = 'Y' AND R.CustCode = C.AccCode AND R.Amtdate BETWEEN :ar_startdate AND :ar_enddate AND R.Amt <> 0 AND R.SRCatCode = 7), 0)
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE
		A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	SaleLedger S,	 
	SaleDetail D,
	(SELECT 
		SS.SaleInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc),
		InvSaleTax=	ROUND((SUM((DD.looseqty * 
			(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM SaleLedger SS, SaleDetail DD,
			(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
			UNION ALL
			SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT
	WHERE 
		SS.Posted = 'Y' AND SS.AccountFor = 'Y' AND
		SS.SaleInvCode = DD.SaleInvCode AND
		SS.CustCode = CT.CustCode AND
		SS.date BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		SS.SaleInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.SaleInvCode = D.SaleInvCode AND S.SaleInvCode = T.SaleInvCode AND
	S.CustCode = C.AccCode AND
	S.date BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	S.SaleInvCode,
	S.SaleCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	D.ICode,
	D.RowGroup,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	C.AreaCode,
	C.Area,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	DocumentCode=S.SRInvCode,
	Type='SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Date = S.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Name=c.Name,
	Cash = CASE S.SRCatCode WHEN 7 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	ClosingBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_enddate),
	OtherDebit=(SELECT ISNULL(SUM(VirtualGL.Debit), 0) FROM VirtualGL 
			WHERE 
				VirtualGL.DocumentType NOT IN ('SV', 'SR') AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date BETWEEN :ar_startdate AND :ar_enddate),
	OtherCredit=(SELECT ISNULL(SUM(VirtualGL.Credit), 0) FROM VirtualGL 
			WHERE 
				VirtualGL.DocumentType NOT IN ('SR','SV') AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date BETWEEN :ar_startdate AND :ar_enddate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.SRUTN),
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=-SUM(D.LooseQty),
	Bonus=-SUM(D.BonusQty),
	Rate=MAX(D.SRPrice),
	GrossValue=-SUM(D.LooseQty * D.SRPrice),
	Discount= -1 *
		(SUM(D.looseqty * D.SRPrice * (.01 * D.discperc)) + 
		SUM(D.looseqty * D.SRPrice * 
			(1-(.01*D.discperc)) * (.01 * S.discperc))),
	ItemSaleTax= -1 * (SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * D.SRPrice) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01)),
	ItemValue= -1 * (SUM(D.LooseQty * D.SRPrice) - 
		SUM((D.looseqty * D.SRPrice * .01 * D.discperc) +
				(D.looseqty * D.SRPrice * (1-(.01*D.discperc)) * (.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * D.SRPrice * (1 - (.01 * D.discperc)) * D.gstperc * .01))),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) FROM SRDetail SD 
		WHERE SD.SRInvCode=S.SRInvCode) THEN CASE S.SRCatCode WHEN 7 THEN 0 ELSE T.NetAmt END ELSE 0 END,
	Credit= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) FROM SRDetail SD WHERE SD.SRInvCode=S.SRInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) 
		FROM SRDetail SD 
		WHERE SD.SRInvCode=S.SRInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	ReceivedOnInv=ISNULL((SELECT SUM(SL.Amt) FROM SaleLedger SL WHERE SL.Posted = 'Y' AND SL.AccountFor = 'Y' AND SL.CustCode = C.AccCode AND SL.Amtdate BETWEEN :ar_startdate AND :ar_enddate AND SL.Amt <> 0 AND SL.SaleCatcode = 2), 0),
	PaidOnReturns= ISNULL((SELECT SUM(R.Amt) FROM SRLedger R WHERE R.Posted = 'Y' AND R.AccountFor = 'Y' AND R.CustCode = C.AccCode AND R.Amtdate BETWEEN :ar_startdate AND :ar_enddate AND R.Amt <> 0 AND R.SRCatCode = 7), 0)
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE
		A.AccCode = CT.CustCode and 
		AR.AreaCode=CT.AreaCode) C,
	SRLedger S,	 
	SRDetail D,
	(SELECT 
		SS.SRInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * DD.SRPrice) *

				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty * DD.SRPrice *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc)),
		InvSaleTax=	ROUND((SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM SRLedger SS, SRDetail DD,
			(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
			UNION ALL
			SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT
	WHERE 
		SS.Posted = 'Y' AND SS.AccountFor = 'Y' AND
		SS.CustCode = CT.CustCode AND
		SS.SRInvCode = DD.SRInvCode AND
		SS.date BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		SS.SRInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.SRInvCode = D.SRInvCode AND S.SRInvCode = T.SRInvCode AND
	S.CustCode = C.AccCode AND
	S.date BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	S.SRInvCode,
	S.SRCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	D.ICode,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	C.AreaCode,
	C.Area,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT
	V.DocumentCode, 
	Type = V.DocumentType + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), V.DocumentCode))), 
	Date = V.Date, 
	Remark = CASE debit 
			WHEN 0 THEN 'Cash Paid Against Sale Ret. # '
			ELSE 'Cash Received Against Sales Inv. # '
			END + RTRIM(LTRIM(CONVERT(CHAR(6), V.DocumentCode))),
	c.Name,
	Cash = CASE ISNULL(v.AlternateAccCode, -1) WHEN -1 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	Address=c.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	Virtualgl.AccCode=C.AccCode and 
				VirtualGL.Date < :ar_startdate),
	ClosingBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_enddate),
	OtherDebit=(SELECT ISNULL(SUM(VirtualGL.Debit), 0) FROM VirtualGL 
			WHERE 
				VirtualGL.DocumentType NOT IN ('SV', 'SR') AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date BETWEEN :ar_startdate AND :ar_enddate),
	OtherCredit=(SELECT ISNULL(SUM(VirtualGL.Credit), 0) FROM VirtualGL 
			WHERE 
				VirtualGL.DocumentType NOT IN ('SR','SV') AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date BETWEEN :ar_startdate AND :ar_enddate),
	C.AreaCode,
	c.Area,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvSaleTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit = V.Credit,
	Credit= V.Debit,
	Others=0,
	ReceivedOnInv=ISNULL((SELECT SUM(SL.Amt) FROM SaleLedger SL WHERE SL.Posted = 'Y' AND SL.AccountFor = 'Y' AND SL.CustCode = C.AccCode AND SL.Amtdate BETWEEN :ar_startdate AND :ar_enddate AND SL.Amt <> 0 AND SL.SaleCatcode = 2), 0),
	PaidOnReturns= ISNULL((SELECT SUM(R.Amt) FROM SRLedger R WHERE R.Posted = 'Y' AND R.AccountFor = 'Y' AND R.CustCode = C.AccCode AND R.Amtdate BETWEEN :ar_startdate AND :ar_enddate AND R.Amt <> 0 AND R.SRCatCode = 7), 0)
FROM 
	VirtualGL V,
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE	
		A.AccCode = CT.CustCode and 
		AR.AreaCode=CT.AreaCode) C
WHERE   
	V.DocumentType NOT IN ('SV', 'SR') AND
	(V.AlternateAccCode = C.AccCode ) and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
ORDER BY
	Name, 
	AliasName, 
	VRow"
  arguments=(("ai_custcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime), ("as_comment1", string), ("as_comment2", string), ("as_comment3", string), ("as_comment4", string), ("ai_allcustomers", number))
 sort="customer A, date A, vrow A"
 filter="abs( closingbalance ) <> 0"
 )
