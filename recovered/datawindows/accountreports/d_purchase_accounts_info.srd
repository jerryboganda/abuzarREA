table(column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=decimal(2) updatewhereclause=yes name=openingbalance dbname="OpeningBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=purchase dbname="Purchase"  )
column=(type=decimal(2) updatewhereclause=yes name=purchasereturn dbname="PurchaseReturn"  )
column=(type=decimal(2) updatewhereclause=yes name=netpurchase dbname="NetPurchase"  )
column=(type=decimal(2) updatewhereclause=yes name=paid dbname="Paid"  )
column=(type=decimal(2) updatewhereclause=yes name=debits dbname="Debits"  )
column=(type=decimal(2) updatewhereclause=yes name=credits dbname="Credits"  )
column=(type=decimal(2) updatewhereclause=yes name=closingbalance dbname="ClosingBalance"  )
 retrieve="SELECT
	Supplier=accounts.name, 
	AliasName=accounts.aliasname, 
	OpeningBalance=sstatus.opbalance, 
	Purchase=sstatus.purchase, 
	PurchaseReturn=sstatus.preturn, 
	NetPurchase=sstatus.Purchase - sstatus.preturn, 
	Paid=sstatus.paid, 
	Debits=sstatus.dradj, 
	Credits=sstatus.cradj,
	ClosingBalance=sstatus.opbalance-sstatus.purchase+sstatus.preturn+sstatus.paid+sstatus.dradj-sstatus.cradj
FROM Supplier ac, accounts,  
(SELECT acccode, sum(opbalance) as opbalance, 
		sum(purchase) as purchase, 
		sum(preturn) as preturn,
		sum(paid) as paid, 
		sum(dradj) as dradj, 
		sum(cradj) as cradj
FROM
	(select acccode, opbalance = sum(debit - credit), Purchase=0, preturn=0, paid=0, dradj=0, cradj=0
	from virtualgl
	where date < :ad_sdate and acccode in (select acccode from accounts where acccode IN (:ai_suppcode))
	group by acccode
	union all
	select acccode, opbalance =0, Purchase=sum(credit), preturn=0, paid=0, dradj=0, cradj=0
	from virtualgl
	where documenttype in ('PV') AND date >= :ad_sdate and date <= :ad_ldate and 
		acccode in (select acccode from accounts where acccode IN (:ai_suppcode))
	group by acccode
	union all
	select acccode, opbalance =0, Purchase=0, preturn=sum(debit), paid=0, dradj=0, cradj=0
	from virtualgl
	where documenttype in ('PR') AND date >= :ad_sdate and date <= :ad_ldate and 
		acccode in (select acccode from accounts where acccode IN (:ai_suppcode))
	group by acccode
	union all
	select acccode, opbalance =0, Purchase=0, preturn=0, paid=sum(debit-credit), dradj=0, cradj=0
	from virtualgl
	where documenttype in ('CR', 'BR', 'CP', 'CRSALE', 'BRSALE', 'CPPUR', 'BPPUR', 'BP') AND date >= :ad_sdate and date <= :ad_ldate and 
		acccode in (select acccode from accounts where acccode IN (:ai_suppcode))
	group by acccode
	union all
	select acccode=suppcode, opbalance =0, Purchase=0, preturn=0, paid=sum(amt), dradj=0, cradj=0
	from purledger
	where amt <> 0 AND date >= :ad_sdate and date <= :ad_ldate and accountfor='Y' and posted='Y'
	group by suppcode
	union all
	select acccode, opbalance =0, Purchase=0, preturn=0, paid=0, dradj=sum(debit), cradj=sum(credit)
	from virtualgl
	where documenttype NOT IN ('CR', 'BR', 'CP', 'BP', 'CRSALE', 'BRSALE', 'CPPUR', 'BPPUR', 'SV', 'SR', 'PV', 'PR', 'RS', 'RR') AND  date >= :ad_sdate and date <= :ad_ldate and 
		acccode in (select acccode from accounts where acccode IN (:ai_suppcode))
	group by acccode) a
group by 
	a.acccode) sstatus
where
	ac.suppcode IN (:ai_suppcode) and
	ac.SuppCode = accounts.acccode and 
	accounts.acccode = sstatus.acccode
ORDER BY 
	Supplier, 
	AliasName
         "
  arguments=(("ad_sdate", datetime), ("ad_ldate", datetime), ("ai_suppcode", numberlist))
)
