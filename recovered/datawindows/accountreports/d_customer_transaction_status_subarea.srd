table(column=(type=long updatewhereclause=yes name=code1 dbname="code1"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="name1"  )
column=(type=char(12) updatewhereclause=yes name=alianame dbname="alianame"  )
column=(type=decimal(2) updatewhereclause=yes name=value1 dbname="value1"  )
column=(type=decimal(2) updatewhereclause=yes name=value2 dbname="value2"  )
column=(type=decimal(2) updatewhereclause=yes name=value3 dbname="value3"  )
column=(type=decimal(2) updatewhereclause=yes name=value4 dbname="value4"  )
column=(type=long updatewhereclause=yes name=areacode dbname="areacode"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="area"  )
 retrieve="select  	code1=cstatus.acccode, 
			name1=ac.name,  
			alianame=ac.aliasname, 
			value1=cstatus.opbalance, 
			value2=cstatus.debits, 
			value3=cstatus.credits,
			value4 = cstatus.sr,
			areacode=ar.subareacode,
			area=ar.name 
from accounts ac, customer c, subarea ar,
(select acccode, sum(opbalance) as opbalance, sum(debits) as debits, 
	sum(credits) as credits, sum(sr) as sr, sum(clbalance) as clbalance
	from 
		(select 
			acccode, 
			opbalance = sum(debit - credit), 
			debits = 0, 
			credits = 0, 
			sr=0, 
			clbalance = 0
		from virtualgl
		where date < :ar_startdate and acccode in (select acccode from accounts where subcode = 3)
		group by acccode
		union all
		select 
			acccode, 
			opbalance =0, 
			debits=sum(debit), 
			credits=sum(case when documenttype = 'SR' THEN 0 ELSE credit  END), 
			sr =SUM(case when documenttype = 'SR' THEN credit ELSE 0 END), 
			clbalance=0
		from virtualgl
		where date >= :ar_startdate and date <= :ar_enddate and acccode in (select acccode from accounts where subcode = 3)
		group by acccode
		union all
		select 
			acccode, 
			opbalance=0, 
			debits=0, 
			credits=0, 
			sr=0, 
			clbalance = sum(debit - credit)
		from virtualgl
		where date <= :ar_enddate and acccode in (select acccode from accounts where subcode = 3)
		group by acccode) a
group by a.acccode) cstatus
where ac.subcode = 3 and ac.acccode = cstatus.acccode and 
		ac.acccode = c.custcode and 
		c.subareacode in (:ar_subareas) and
		c.subareacode=ar.subareacode
ORDER BY ar.name, ar.subareacode, name1, code1"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_subareas", numberlist))
)
