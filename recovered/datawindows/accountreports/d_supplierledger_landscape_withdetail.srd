table(column=(type=long updatewhereclause=yes name=documentcode dbname="VirtualGl.documentcode"  )
column=(type=char(27) updatewhereclause=yes name=type dbname="type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(216) updatewhereclause=yes name=remarks dbname="remark"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="cash"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="VirtualGl.aliasname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="openbalance"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="VirtualGl.CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VirtualGl.VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VirtualGl.vouchercode"  )
column=(type=char(100) updatewhereclause=yes name=grn dbname="GRN"  )
column=(type=char(100) updatewhereclause=yes name=vehicle dbname="Vehicle"  )
column=(type=char(60) updatewhereclause=yes name=agency dbname="Agency"  )
column=(type=char(100) updatewhereclause=yes name=shipto dbname="ShipTo"  )
column=(type=decimal(2) updatewhereclause=yes name=freight dbname="Freight"  )
column=(type=long updatewhereclause=yes name=pendingcheque dbname="PendingCheque"  )
 retrieve="select 
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Debit,
	credit= V.Credit,
	remark = CASE V.documenttype
				WHEN 'PV' THEN
					(SELECT	RTRIM(LTRIM(P.SuppInvCode)) + 
								CASE WHEN LEN(RTRIM(LTRIM(P.SuppInvCode))) > 0 THEN ', ' ELSE '' END + 
								RTRIM(LTRIM(CONVERT(Varchar(12), SuppInvDate))) + 
								CASE WHEN LEN(RTRIM(LTRIM(CONVERT(Varchar(12), SuppInvDate)))) > 0 THEN ', ' ELSE '' END + 
								RTRIM(LTRIM(P.Remarks))
					FROM PurLedger P
					WHERE P.PurinvCode = V.DocumentCode)
				WHEN 'PR' THEN
					(SELECT RTRIM(LTRIM(P.Remarks))
					FROM PrLedger P
					WHERE P.PurinvCode = V.DocumentCode) ELSE V.Remarks END,
	Supplier=S.name,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	S.aliasname,
	address=S.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=S.acccode and 
				virtualgl.date < :ar_startdate),
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	GRN = V.GRN,
	Vehicle = V.Vehicle,
	Agency = (SELECT GC.Name FROM GoodsCompany GC WHERE GC.GCCode = V.GCCode),
	ShipTo = V.ShipTo,
	Freight = CASE WHEN V.documenttype = 'PV' AND V.Credit > 0 THEN (SELECT P.FlatDisc FROM PurLedger P WHERE P.PurInvCode = V.DocumentCode) ELSE 0 END,
	PendingCheque=0
FROM 
	VirtualGL V,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode) S

WHERE 	
	(V.AccCode = S.AccCode OR V.AlternateAccCode = S.AccCode ) and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
UNION ALL
SELECT 
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Credit,
	credit= V.Debit,
	remark = Case debit 
				When 0 then 'Cash Paid Against Purchase Inv. # '
				Else 'Cash Received Against Purchase Return # '
				End + RTrim(LTrim(convert(char(6), V.documentcode))),
	S.name,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	S.aliasname,
	address=S.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=S.acccode and 
				virtualgl.date < :ar_startdate),
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	GRN = V.GRN,
	Vehicle = V.Vehicle,
	Agency = (SELECT GC.Name FROM GoodsCompany GC WHERE GC.GCCode = V.GCCode),
	ShipTo = V.ShipTo,
	Freight = 0,
	PendingCheque=0
FROM 
	VirtualGL V,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode) S

WHERE 
	(V.AlternateAccCode = S.AccCode ) and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
UNION ALL
SELECT
	documentcode = N.NoteCode, 
	Type = Case N.NoteCatCode When 1 Then '*NR' Else '*NP' End + '-' + RTrim(LTrim(convert(char(6), N.NoteCode))),  
	date = N.duedate, 
	debit = Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = S.AccCode THEN 0 ELSE N.Amount END ELSE CASE WHEN N.AccCode = S.AccCode THEN N.Amount ELSE 0 END END,
	credit= Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = S.AccCode THEN N.Amount ELSE 0 END ELSE CASE WHEN N.AccCode = S.AccCode THEN 0 ELSE N.Amount END END,
	remark = N.Remarks,
	S.name,
	cash = 'N',
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=S.AccCode AND 
				VirtualGL.date < :ar_startdate),
	CheckNo = LEFT(N.DocumentNumber, 20),
	VRow=999999,
	VoucherCode=N.vouchercode,
	GRN = NULL,
	Vehicle = NULL,
	Agency = NULL,
	ShipTo = NULL,
	Freight = 0,
	PendingCheque=1
FROM
	Notes N,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1,sp.address2,sp.city
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_Suppcode) and 
			a.acccode = sp.suppcode) S
WHERE   
	(N.AccCode = S.AccCode OR N.BankAccCode = S.AccCode ) and
	N.Posted = 'N' AND N.Finalized = 'Y'
UNION ALL
SELECT 
	documentcode=NULL, 
	type = NULL, 
	date = :ar_enddate, 
	debit = 0,
	credit= 0,
	remark = 'OPENING BALANCE',
	S.name,
	cash = 'N',
	S.aliasname,
	address=S.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=S.acccode and 
				virtualgl.date < :ar_startdate),
	CheckNo=NULL,
	VRow=0,
	vouchercode=NULL,
	GRN = NULL,
	Vehicle = NULL,
	Agency = NULL,
	ShipTo = NULL,
	Freight = 0,
	PendingCheque=0
FROM 
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode AND 
			a.acccode NOT IN 
			(SELECT DISTINCT VGL.AccCode 
			FROM VirtualGL VGL 
			WHERE VGL.Date BETWEEN :ar_startdate AND :ar_enddate AND 
				VGL.AccCode IN (:ar_Suppcode)
			UNION ALL
			SELECT DISTINCT N.AccCode 
			FROM Notes N
			WHERE N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN (:ar_Suppcode)
			UNION ALL
			SELECT DISTINCT N.BankAccCode 
			FROM Notes N
			WHERE N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN (:ar_Suppcode)) ) S
ORDER BY 
	name, aliasname, date, type, VRow
"
  arguments=(("ar_suppcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
