table(column=(type=long updatewhereclause=yes name=reportgroup dbname="ReportGroup"  )
column=(type=long updatewhereclause=yes name=salespersoncode dbname="SalesPersonCode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="balance"  )
column=(type=char(12) updatewhereclause=yes name=accountaliasname dbname="AccountAliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=decimal(2) updatewhereclause=yes name=sales dbname="Sales"  )
column=(type=decimal(2) updatewhereclause=yes name=receipts dbname="Receipts"  )
column=(type=decimal(2) updatewhereclause=yes name=salereturns dbname="SaleReturns"  )
column=(type=decimal(2) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(2) updatewhereclause=yes name=expenses dbname="Expenses"  )
 retrieve="SELECT
	ReportGroup = T.ReportGroup,
	SalesPersonCode=SM.SalesManCode,
	SalesPerson=SM.Name,
	AccCode=A.AccCode,
	balance=(select isnull(sum(v.debit - v.credit), 0) from virtualgl v
				where v.acccode=A.acccode group by v.acccode), 
	AccountAliasName=A.AliasName,
	AccountName=A.Name,
	Sales = SUM(CASE T.Type WHEN 'SAL' THEN Amount ELSE 0 END),
	Receipts = SUM(CASE T.Type WHEN 'REC' THEN Amount ELSE 0 END),
	SaleReturns = SUM(CASE T.Type WHEN 'RET' THEN Amount ELSE 0 END),
	Discount = SUM(CASE T.Type WHEN 'DIS' THEN Amount ELSE 0 END),
	Expenses = SUM(CASE T.Type WHEN 'EXP' THEN Amount ELSE 0 END)
FROM
	SalesMan SM,
	Accounts A,
	(SELECT 
		ReportGroup = 1,
		Type = 'REC',
		SalesManCode = GH.SManCode,
		AccCode=GD.AccCode,
		Amount = SUM(GD.Credit)
	FROM
		GlHeader GH, GLDetail GD, VocherCategory VC
	WHERE
		GH.SManCode IN (:ai_smancode) AND
		GH.Date >= :ad_startdate AND GH.Date <= :ad_enddate AND
		GH.Posted = 'Y' AND
		GH.VochCatCode = VC.VochCatCode AND
		VC.SHORTNAME <> 'SALEDISC' AND
		GH.GLVochCode = GD.GLVochCode AND
		GD.AccCode IN (SELECT A.AccCode FROM Accounts A WHERE A.SubCode = 3)
	GROUP BY
		GH.SManCode,
		GD.AccCode
	UNION ALL
	SELECT 
		ReportGroup = 1,
		Type = 'SAL',
		SalesManCode = S.SManCode,
		AccCode=S.CustCode,
		Amount = SUM(dbo.fn_getsaleinvtotal(S.SaleInvCode) )
	FROM
		SaleLedger S
	WHERE
		S.SManCode IN (:ai_smancode) AND
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		S.Posted = 'Y'
	GROUP BY
		S.SManCode,
		S.CustCode
	UNION ALL
	SELECT 
		ReportGroup = 1,
		Type = 'RET',
		SalesManCode = S.SManCode,
		AccCode=S.CustCode,
		Amount = SUM(dbo.fn_getsrinvtotal(S.SRInvCode) )
	FROM
		SRLedger S
	WHERE
		S.SManCode IN (:ai_smancode) AND
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		S.Posted = 'Y'
	GROUP BY
		S.SManCode,
		S.CustCode
	UNION ALL
	SELECT 
		ReportGroup = 1,
		Type = 'DIS',
		SalesManCode = S.SManCode,
		AccCode=S.CustCode,
		Amount = 
			SUM( 
				(D.LooseQty * D.ItemFlatDisc) + 
				(D.LooseQty * (SalePrice - D.ItemFlatDisc) * D.DiscPerc * 0.01 ) +
				(D.LooseQty * (SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * S.DiscPerc * 0.01 )
			) + ISNULL(S.FlatDisc,0)
	FROM
		SaleLedger S, SaleDetail D
	WHERE
		S.SManCode IN (:ai_smancode) AND
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		S.Posted = 'Y' AND
		S.SaleInvCode = D.SaleInvCode
	GROUP BY
		S.SManCode,
		S.CustCode,
		S.SaleInvCode,
		S.FlatDisc
	UNION ALL
	SELECT 
		ReportGroup = 1,
		Type = 'DIS',
		SalesManCode = GH.SManCode,
		AccCode=GD.AccCode,
		Amount = SUM(GD.Credit)
	FROM
		GlHeader GH, GLDetail GD, VocherCategory VC
	WHERE
		GH.SManCode IN (:ai_smancode) AND
		GH.Date >= :ad_startdate AND GH.Date <= :ad_enddate AND
		GH.Posted = 'Y' AND
		GH.VochCatCode = VC.VochCatCode AND
		VC.SHORTNAME = 'SALEDISC' AND
		GH.GLVochCode = GD.GLVochCode AND
		GD.AccCode IN 
			(SELECT A.AccCode 
			FROM Accounts A, SubAccounts SA, CategoryAccounts CA, MainAccounts M
			WHERE 
				M.MainAccCode = CA.MainAccCode AND
				CA.CatAccCode = SA.CatAccCode AND
				SA.SubAccCode = A.SubCode AND
				A.SubCode = 3)
	GROUP BY
		GH.SManCode,
		GD.AccCode
	UNION ALL
	SELECT 
		ReportGroup = 2,
		Type = 'EXP',
		SalesManCode = GH.SManCode,
		AccCode=GD.AccCode,
		Amount = SUM(GD.Debit)
	FROM
		GlHeader GH, GLDetail GD
	WHERE
		GH.SManCode IN (:ai_smancode) AND
		GH.Date >= :ad_startdate AND GH.Date <= :ad_enddate AND
		GH.Posted = 'Y' AND
		GH.GLVochCode = GD.GLVochCode AND
		GD.AccCode IN 
			(SELECT A.AccCode 
			FROM Accounts A, SubAccounts SA, CategoryAccounts CA, MainAccounts M
			WHERE M.MainAccCode = 5 AND 
				M.MainAccCode = CA.MainAccCode AND
				CA.CatAccCode = SA.CatAccCode AND
				SA.SubAccCode = A.SubCode)
	GROUP BY
		GH.SManCode,
		GD.AccCode) T
WHERE
	SM.SalesManCode IN (:ai_smancode) AND
	SM.SalesManCode = T.SalesManCode AND
	T.AccCode = A.AccCode
GROUP BY
	T.ReportGroup,
	SM.SalesManCode,
	SM.Name,
	A.AccCode,
	A.AliasName,
	A.Name
ORDER BY
	SM.Name,
	ReportGroup,
	A.Name
"
  arguments=(("ai_smancode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="salesperson A, reportgroup A, accountname A"
)
