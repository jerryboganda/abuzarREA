release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=572 color="536870912" )
summary(height=84 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912"  height.autosize=yes)
table(column=(type=char(60) updatewhereclause=yes name=name1 dbname="name1"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
 retrieve="SELECT
	name1, 
	debit = CASE WHEN Value1 > 0 THEN Value1 ELSE 0 END, 
	credit = CASE WHEN Value1 < 0 THEN Abs(Value1) ELSE 0 END, 
	AliasName, 
	Area, 
	AreaCode
FROM

(SELECT 
	A.Name AS name1, 
	Sum(V.Balance) AS value1, 
	A.AliasName, 
	Area=Area.Name, 
	AreaCode=Area.AreaCode
FROM Accounts A
	LEFT OUTER JOIN 
		(SELECT T.AccCode, Sum(T.Debit - T.Credit) AS Balance 
		FROM VirtualGL T 
		WHERE T.Date <= :ar_Date
		GROUP BY T.AccCode) AS V
	ON (A.AccCode = V.AccCode),
	Customer C,
	SubAccounts S,
	Area
WHERE 
	A.AccCode = C.CustCode AND
	A.SubCode = S.SubAccCode AND 
	S.SubAccCode = 3 AND 
	(A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'Y' END OR
	A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'N' END) AND
	C.AreaCode IN (:ar_Areas) AND 
	C.AreaCode = Area.AreaCode
GROUP BY A.AccCode, A.Name, A.AliasName, Area.Name, Area.AreaCode) A
ORDER BY Area, NAME1, AliasName"
  arguments=(("ar_Date", datetime), ("ar_Areas", numberlist), ("ar_Restricted", number))
)
