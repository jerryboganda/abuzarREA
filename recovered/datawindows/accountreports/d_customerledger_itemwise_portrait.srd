release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1441 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=166 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes name=status dbname="Status"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=char(28) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=description dbname="Remark"  )
column=(type=char(100) updatewhereclause=no name=remark2 dbname="Remark2"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Name"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="Cash"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="SaleLedger.AliasName"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="OpenBalance"  )
column=(type=long updatewhereclause=yes name=areacode dbname="SaleLedger.AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="SaleLedger.Area"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=decimal(0) updatewhereclause=yes name=vrow dbname="VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VoucherCode"  )
column=(type=long updatewhereclause=yes name=header dbname="Header"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(4) updatewhereclause=yes name=grossvalue dbname="GrossValue"  )
column=(type=decimal(4) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(4) updatewhereclause=yes name=itemsaletax dbname="ItemSaleTax"  )
column=(type=decimal(4) updatewhereclause=yes name=itemvalue dbname="ItemValue"  )
column=(type=decimal(4) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=decimal(4) updatewhereclause=yes name=others dbname="Others"  )
column=(type=long updatewhereclause=yes name=pendingcheque dbname="PendingCheque"  )
 retrieve="SELECT  
	Status=CASE WHEN S.Posted='Y' THEN 0 ELSE 1 END,
	DocumentCode=S.SaleInvCode,
	Type='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Remark2 = MAX(D.SaleItemDescription),
	Name=c.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.RowID),
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=SUM(D.LooseQty),
	Bonus=SUM(D.BonusQty),
	Rate=MAX(D.SalePrice),
	GrossValue=SUM(D.LooseQty * D.SalePrice),
	Discount=
		SUM(D.looseqty*D.itemflatdisc) +
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) + 
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * 
			(1-(.01*D.discperc)) * (.01 * S.discperc)),
	ItemSaleTax=SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
	ItemValue=SUM(D.LooseQty * D.SalePrice) - 
		SUM((D.looseqty*D.itemflatdisc) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (1-(.01*D.discperc)) * 
				(.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN CASE WHEN ISNULL(S.CashCharged,0) > 0 OR ISNULL((SELECT SUM(M.Amount) FROM CashierWindow M WHERE M.SaleInvCode = S.SaleInvCode), 0) > 0 THEN ISNULL(S.CashCharged, 0) + ISNULL((SELECT SUM(M.Amount) FROM CashierWindow M WHERE M.SaleInvcode = S.SaleInvCode), 0) ELSE CASE WHEN S.SaleCatCode = 2 THEN 0 ELSE T.NetAmt END  END ELSE 0 END,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	SaleLedger S,	 
	SaleDetail D,
	(SELECT 
		SS.SaleInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT))) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT))) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc),
		InvSaleTax=	ROUND((SUM((DD.looseqty * 
			(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT))) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT)))
	FROM SaleLedger SS, SaleDetail DD,
			(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
			UNION ALL
			SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT
	WHERE 
		SS.AccountFor = 'Y' AND
		SS.SaleInvCode = DD.SaleInvCode AND
		SS.CustCode = CT.CustCode AND
		SS.date  BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		SS.SaleInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	S.AccountFor = 'Y' AND
	S.SaleInvCode = D.SaleInvCode AND S.SaleInvCode = T.SaleInvCode AND
	S.CustCode = C.AccCode AND
	S.date  BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	S.SaleInvCode,
	S.SaleCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	D.ICode,
	D.RowGroup,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.CashCharged,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	S.Posted,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	C.AreaCode,
	C.Area,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT 
	Status=CASE WHEN S.Posted='Y' THEN 0 ELSE 1 END,
	DocumentCode=S.SaleInvCode,
	Type='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Remark2 = MAX(D.SaleItemDescription),
	Name=c.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	C.AliasName, 
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.RowID),
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=SUM(D.LooseQty),
	Bonus=SUM(D.BonusQty),
	Rate=MAX(D.SalePrice),
	GrossValue=SUM(D.LooseQty * D.SalePrice),
	Discount=
		SUM(D.looseqty*D.itemflatdisc) +
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) + 
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * 
			(1-(.01*D.discperc)) * (.01 * S.discperc)),
	ItemSaleTax=SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
	ItemValue=SUM(D.LooseQty * D.SalePrice) - 
		SUM((D.looseqty*D.itemflatdisc) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (1-(.01*D.discperc)) * 
				(.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleInvDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleInvDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN CASE WHEN ISNULL(S.CashCharged,0) > 0 OR ISNULL((SELECT SUM(M.Amount) FROM CashierWindow M WHERE M.SaleInvCode = S.SaleInvCode), 0) > 0 THEN ISNULL(S.CashCharged, 0) + ISNULL((SELECT SUM(M.Amount) FROM CashierWindow M WHERE M.SaleInvcode = S.SaleInvCode), 0) ELSE CASE WHEN S.SaleCatCode = 2 THEN 0 ELSE T.NetAmt END  END ELSE 0 END,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleInvDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	SaleLedger S,	 
	SaleInvDetail D,
	(SELECT 
		SS.SaleInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT))) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT))) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc),
		InvSaleTax=	ROUND((SUM((DD.looseqty * 
			(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT))) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT)))
	FROM SaleLedger SS, SaleInvDetail DD,
			(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
			UNION ALL
			SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT
	WHERE 
		SS.AccountFor = 'Y' AND
		SS.ImpactInventory='N' AND
		SS.SaleInvCode = DD.SaleInvCode AND
		SS.CustCode = CT.CustCode AND
		SS.date  BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		SS.SaleInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	S.AccountFor = 'Y' AND
	S.ImpactInventory='N' AND
	S.SaleInvCode = D.SaleInvCode AND S.SaleInvCode = T.SaleInvCode AND
	S.CustCode = C.AccCode AND
	S.date  BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	S.SaleInvCode,
	S.SaleCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	D.ICode,
	D.RowGroup,
	S.CustCode, 
	S.Date,
	S.CashCharged,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	S.Posted,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	C.AreaCode,
	C.Area,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	Status=CASE WHEN S.Posted='Y' THEN 0 ELSE 1 END,
	DocumentCode=S.SaleInvCode,
	Type='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.AmtDate, 
	Remark = 'Cash Recvd. During Sale #:' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Remark2 = NULL,
	Name=c.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=S.AmtReference,
	VRow=9999999,
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = 0,
	Credit= S.Amt,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	SaleLedger S
WHERE   
	S.AccountFor = 'Y' AND
	S.CustCode = C.AccCode AND
	S.AmtDate  BETWEEN :ar_startdate AND :ar_enddate AND
	S.Amt <> 0 AND S.SaleCatcode = 2
UNION ALL
SELECT  
	Status=CASE WHEN S.Posted='Y' THEN 0 ELSE 1 END,
	DocumentCode=S.SRInvCode,
	Type='SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Date = S.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Remark2 = MAX(D.ReturnItemDescription),
	Name=c.Name,
	Cash = CASE S.SRCatCode WHEN 7 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.SRUTN),
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=-SUM(D.LooseQty),
	Bonus=-SUM(D.BonusQty),
	Rate=MAX(D.SRPrice),
	GrossValue=-SUM(D.LooseQty * D.SRPrice),
	Discount= -1 *
		(SUM(D.looseqty * D.SRPrice * (.01 * D.discperc)) + 
		SUM(D.looseqty * D.SRPrice * 
			(1-(.01*D.discperc)) * (.01 * S.discperc))),
	ItemSaleTax= -1 * (SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * D.SRPrice) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01)),
	ItemValue= -1 * (SUM(D.LooseQty * D.SRPrice) - 
		SUM((D.looseqty * D.SRPrice * .01 * D.discperc) +
				(D.looseqty * D.SRPrice * (1-(.01*D.discperc)) * (.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * D.SRPrice * (1 - (.01 * D.discperc)) * D.gstperc * .01))),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) FROM SRDetail SD 
		WHERE SD.SRInvCode=S.SRInvCode) THEN CASE WHEN ISNULL(S.CashCharged,0) > 0 OR ISNULL((SELECT SUM(M.Amount) FROM MasterCashWin M WHERE M.DocumentType = 'SR' AND M.DocumentCode = S.SRInvCode), 0) > 0 THEN ISNULL(S.CashCharged,0) + ISNULL((SELECT SUM(M.Amount) FROM MasterCashWin M WHERE M.DocumentType = 'SR' AND M.DocumentCode = S.SRInvCode), 0) ELSE CASE WHEN S.SRCatCode = 7 THEN 0 ELSE T.NetAmt END END ELSE 0 END,
	Credit= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) FROM SRDetail SD WHERE SD.SRInvCode=S.SRInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) 
		FROM SRDetail SD 
		WHERE SD.SRInvCode=S.SRInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	SRLedger S,	 
	SRDetail D,
	(SELECT 
		SS.SRInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), (SELECT CAST(DBO.fn_GetPreference('roundsalereturninvon') AS INT))) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, (SELECT CAST(DBO.fn_GetPreference('roundsalereturninvon') AS INT))) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * DD.SRPrice) * (1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty * DD.SRPrice *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc)),
		InvSaleTax=	ROUND((SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), (SELECT CAST(DBO.fn_GetPreference('roundsalereturninvon') AS INT))) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, (SELECT CAST(DBO.fn_GetPreference('roundsalereturninvon') AS INT)))
	FROM SRLedger SS, SRDetail DD,
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT
	WHERE 
		SS.AccountFor = 'Y' AND
		SS.CustCode = CT.CustCode AND
		SS.SRInvCode = DD.SRInvCode AND
		SS.date  BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		SS.SRInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	S.AccountFor = 'Y' AND
	S.SRInvCode = D.SRInvCode AND S.SRInvCode = T.SRInvCode AND
	S.CustCode = C.AccCode AND
	S.date  BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	S.SRInvCode,
	S.SRCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	D.ICode,
	S.CustCode, 
	S.Date,
	S.CashCharged,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	S.Posted,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	C.AreaCode,
	C.Area,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	Status=CASE WHEN S.Posted='Y' THEN 0 ELSE 1 END,
	DocumentCode=S.SRInvCode,
	Type='SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Date = S.AmtDate, 
	Remark = 'Cash Paid During S/Return #:' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Remark2 = NULL,
	Name=c.Name,
	Cash = CASE S.SRCatCode WHEN 7 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=S.AmtReference,
	VRow=9999999,
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = S.Amt,
	Credit= 0,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	SRLedger S
WHERE   
	S.AccountFor = 'Y' AND
	S.CustCode = C.AccCode AND
	S.AmtDate  BETWEEN :ar_startdate AND :ar_enddate AND
	S.Amt <> 0 AND S.SRCatCode = 7
UNION ALL
SELECT 
	Status=CASE WHEN S.Posted='Y' THEN 0 ELSE 1 END,
	DocumentCode=S.ServiceInvCode,
	Type='RS-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceInvCode))),
	Date = S.Date, 
	Remark = (SELECT S.NAME FROM Service S WHERE S.ServiceCODE = D.ServiceCode),
	Remark2 = NULL,
	Name=c.Name,
	Cash = CASE S.ServiceCatCode WHEN 11 THEN 'N' ELSE 'Y' END,
	C.AliasName, 
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.SrvRowID),
	VoucherCode=NULL,
	Header=S.HeaderNo,
	Qty=SUM(D.Qty),
	Bonus=0,
	Rate=MAX(D.Price),
	GrossValue=SUM(D.Qty * D.Price),
	Discount=
		SUM(D.qty * D.ServiceFlatDisc) +
		SUM(D.qty * (D.price - D.ServiceFlatDisc) * (.01 * D.discperc)) + 
		SUM(D.qty * (D.price - D.ServiceFlatDisc) * 
			(1-(.01*D.discperc)) * (.01 * S.discperc)),
	ItemSaleTax=SUM( D.qty * D.ServiceFlatTax) + 
		Sum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc ) +
		Round((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - S.discperc * 0.01)) - flatdisc ) * 0.01 * S.serviceinvgstperc, 2),
	ItemValue=SUM(D.Qty * D.Price) - 
		(SUM(D.qty * D.ServiceFlatDisc) +
		SUM(D.qty * (D.price - D.ServiceFlatDisc) * (.01 * D.discperc)) + 
		SUM(D.qty * (D.price - D.ServiceFlatDisc) * 
			(1-(.01*D.discperc)) * (.01 * S.discperc))) +
		(SUM( D.qty * D.ServiceFlatTax) + 
				Sum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc ) +
				Round((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - S.discperc * 0.01)) - flatdisc ) * 0.01 * S.serviceinvgstperc, 2)),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.SrvRowID) WHEN (SELECT MAX(SD.SrvROWID) 
		FROM ServiceDetail SD 
		WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.SrvRowID) WHEN (SELECT MAX(SD.SRVROWID) 
		FROM ServiceDetail SD 
		WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN CASE WHEN S.CashCharged > 0 OR ISNULL((SELECT SUM(M.Amount) FROM MasterCashWin M WHERE DocumentType='RS' AND DocumentCode = S.ServiceInvCode), 0) > 0 THEN ISNULL(S.CashCharged, 0) + ISNULL((SELECT SUM(M.Amount) FROM MasterCashWin M WHERE DocumentType='RS' AND DocumentCode = S.ServiceInvCode), 0) ELSE CASE WHEN S.ServiceCatCode = 11 THEN 0 ELSE T.NetAmt END END ELSE 0 END,
	Others= CASE MAX(D.SrvRowID) WHEN (SELECT MAX(SD.SrvRowID) 
		FROM ServiceDetail SD 
		WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	ServiceHeader S,	 
	ServiceDetail D,
	(SELECT 
		SS.ServiceInvCode, 
		RoundingDiff=
			Round(Sum(DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc + SS.misccharges, 0) +
						Round(
							Sum(DD.qty * DD.serviceflattax ) +
							Sum((DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01)) * 0.01*DD.servicegstPerc ) +
							Round((Sum(DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc )*0.01*SS.serviceinvgstperc, 2)
							,0) -
			(Sum(DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc + SS.misccharges +
							Sum(DD.qty * DD.serviceflattax ) +
							Sum((DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01)) * 0.01*DD.servicegstPerc ) +
							Round((Sum(DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc )*0.01*SS.serviceinvgstperc, 2)),
		InvSaleTax=	
			Round(
				Sum(DD.qty * DD.serviceflattax ) +
				Sum((DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01)) * 0.01*DD.servicegstPerc ) +
				Round((Sum(DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc )*0.01*SS.serviceinvgstperc, 2)
				,0),
		NetAmt=Round(Sum(DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc + SS.misccharges, 0) +
			Round(
				Sum(DD.qty * DD.serviceflattax ) +
				Sum((DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01)) * 0.01*DD.servicegstPerc ) +
				Round((Sum(DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc )*0.01*SS.serviceinvgstperc, 2)
				,0)
	FROM ServiceHeader SS, ServiceDetail DD, 
			(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
			UNION ALL
			SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT
	WHERE 
		SS.ServiceInvCode = DD.ServiceInvCode AND
		SS.CustCode = CT.CustCode AND
		SS.date  BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		SS.ServiceInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.ServiceInvGSTPerc,
		SS.DiscPerc,
		SS.MiscCharges) T
WHERE   
	S.ServiceInvCode = D.ServiceInvCode AND S.ServiceInvCode = T.ServiceInvCode AND
	S.CustCode = C.AccCode AND
	S.date  BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	S.ServiceInvCode,
	S.ServiceCatCode,
	S.HeaderNo,
	D.ServiceCode,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.CashCharged,
	S.MiscCharges,
	S.FlatDisc,
	S.ServiceInvGSTPerc,
	S.Posted,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	C.AreaCode,
	C.Area,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT 
	Status=CASE WHEN S.Posted='Y' THEN 0 ELSE 1 END,
	DocumentCode=S.ServiceRInvCode,
	Type='RR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceRInvCode))),
	Date = S.Date, 
	Remark = (SELECT S.NAME FROM Service S WHERE S.ServiceCODE = D.ServiceCode),
	Remark2 = NULL,
	Name=c.Name,
	Cash = CASE S.ServiceRCatCode WHEN 14 THEN 'N' ELSE 'Y' END,
	C.AliasName, 
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.SrvRRowID),
	VoucherCode=NULL,
	Header=S.HeaderNo,
	Qty= - SUM(D.Qty),
	Bonus=0,
	Rate=MAX(D.ServicePrice),
	GrossValue= - SUM(D.Qty * D.ServicePrice),
	Discount= -1 *
		(SUM(D.qty * D.ServiceFlatDisc) +
		SUM(D.qty * (D.ServicePrice - D.ServiceFlatDisc) * (.01 * D.discperc)) + 
		SUM(D.qty * (D.ServicePrice - D.ServiceFlatDisc) * 
			(1-(.01*D.discperc)) * (.01 * S.discperc))),
	ItemSaleTax= -1 * (SUM( D.qty * D.ServiceFlatTax) + 
		Sum((D.qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc ) +
		Round((Sum(D.qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - S.discperc * 0.01)) - flatdisc ) * 0.01 * S.serviceinvgstperc, 2)),
	ItemValue=-1 * (SUM(D.Qty * D.ServicePrice) - 
		(SUM(D.qty * D.ServiceFlatDisc) +
		SUM(D.qty * (D.ServicePrice - D.ServiceFlatDisc) * (.01 * D.discperc)) + 
		SUM(D.qty * (D.ServicePrice - D.ServiceFlatDisc) * 
			(1-(.01*D.discperc)) * (.01 * S.discperc))) +
		(SUM( D.qty * D.ServiceFlatTax) + 
				Sum((D.qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc ) +
				Round((Sum(D.qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - S.discperc * 0.01)) - flatdisc ) * 0.01 * S.serviceinvgstperc, 2))),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SRVRROWID) 
		FROM ServiceRDetail SD 
		WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN CASE WHEN ISNULL(S.CashCharged,0) > 0 OR ISNULL((SELECT SUM(M.Amount) FROM MasterCashWin M WHERE DocumentType='RR' AND DocumentCode = S.ServiceRInvCode), 0) > 0 THEN ISNULL(S.CashCharged, 0) + ISNULL((SELECT SUM(M.Amount) FROM MasterCashWin M WHERE DocumentType='RR' AND DocumentCode = S.ServiceRInvCode), 0) ELSE 0 END ELSE 0 END,
	Credit= CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SrvRROWID) 
		FROM ServiceRDetail SD 
		WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN T.NetAmt  ELSE 0 END,
	Others= CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SrvRRowID) 
		FROM ServiceRDetail SD 
		WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	ServiceRHeader S,	 
	ServiceRDetail D,
	(SELECT 
		SS.ServiceRInvCode, 
		RoundingDiff=
			Round(Sum(DD.qty * (DD.ServicePrice - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc + SS.misccharges, 0) +
						Round(
							Sum(DD.qty * DD.serviceflattax ) +
							Sum((DD.qty * (DD.ServicePrice - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01)) * 0.01*DD.servicegstPerc ) +
							Round((Sum(DD.qty * (DD.ServicePrice - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc )*0.01*SS.serviceinvgstperc, 2)
							,0) -
			(Sum(DD.qty * (DD.ServicePrice - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc + SS.misccharges +
							Sum(DD.qty * DD.serviceflattax ) +
							Sum((DD.qty * (DD.ServicePrice - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01)) * 0.01*DD.servicegstPerc ) +
							Round((Sum(DD.qty * (DD.ServicePrice - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc )*0.01*SS.serviceinvgstperc, 2)),
		InvSaleTax=	
			Round(
				Sum(DD.qty * DD.serviceflattax ) +
				Sum((DD.qty * (DD.ServicePrice - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01)) * 0.01*DD.servicegstPerc ) +
				Round((Sum(DD.qty * (DD.ServicePrice - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc )*0.01*SS.serviceinvgstperc, 2)
				,0),
		NetAmt=Round(Sum(DD.qty * (DD.ServicePrice - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc + SS.misccharges, 0) +
			Round(
				Sum(DD.qty * DD.serviceflattax ) +
				Sum((DD.qty * (DD.ServicePrice - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01)) * 0.01*DD.servicegstPerc ) +
				Round((Sum(DD.qty * (DD.ServicePrice - DD.ServiceFlatDisc) * (1 - DD.discperc * 0.01) * (1 - SS.discperc * 0.01)) - SS.flatdisc )*0.01*SS.serviceinvgstperc, 2)
				,0)
	FROM ServiceRHeader SS, ServiceRDetail DD,
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT 
	WHERE 
		SS.ServiceRInvCode = DD.ServiceRInvCode AND
		SS.CustCode = CT.CustCode AND
		SS.date  BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		SS.ServiceRInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.ServiceInvGSTPerc,
		SS.DiscPerc,
		SS.MiscCharges) T
WHERE   
	S.ServiceRInvCode = D.ServiceRInvCode AND S.ServiceRInvCode = T.ServiceRInvCode AND
	S.CustCode = C.AccCode AND
	S.date  BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	S.ServiceRInvCode,
	S.ServiceRCatCode,
	S.HeaderNo,
	D.ServiceCode,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.CashCharged,
	S.MiscCharges,
	S.FlatDisc,
	S.ServiceInvGSTPerc,
	S.Posted,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	C.AreaCode,
	C.Area,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	Status=0,
	DocumentCode=P.PurInvCode,
	Type='PV-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Date = P.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Remark2 =MAX(D.ItemDescription),
	Name=C.Name,
	Cash = CASE P.PurCatCode WHEN 1 THEN 'Y' WHEN 7 THEN 'Y' ELSE 'N' END,
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.PurRowID),
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=SUM(D.LooseQty+PackQty),
	Bonus=SUM(D.BonusQty),
	Rate=MAX(D.PurPrice),
	GrossValue=SUM((D.LooseQty + D.PackQty) * D.PurPrice),
	Discount=
		SUM((D.looseqty+D.PackQty) * D.Purprice * (.01 * D.discperc)) + 
		SUM((D.looseqty+D.PackQty) * D.Purprice * (1-(.01*D.discperc)) * (.01 * P.discperc)),
	ItemSaleTax=SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Purprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01),
	ItemValue=SUM((D.PackQty + D.LooseQty) * D.PurPrice) - 
		SUM((D.looseqty + D.PackQty) * D.Purprice * (.01 * D.discperc) +
				((D.looseqty + D.PackQty) * D.Purprice * (1-(.01*D.discperc)) * (.01 * P.discperc))) +  
		SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM( (D.PackQty + D.looseqty) * D.Purprice * (1 - (.01 * D.discperc)) * D.gstperc * .01),
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.PurRowID) WHEN (SELECT MAX(PD.PurROWID) 
		FROM PurDetail PD 
		WHERE PD.PurInvCode=P.PurInvCode) THEN CASE P.PurCatCode WHEN 1 THEN T.NetAmt WHEN 7 THEN T.NetAmt ELSE 0 END ELSE 0 END,
	Credit= CASE MAX(D.PurRowID) WHEN (SELECT MAX(PD.PurROWID) 
		FROM PurDetail PD 
		WHERE PD.PurInvCode=P.PurInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.PurRowID) WHEN (SELECT MAX(PD.PurROWID) 
		FROM PurDetail PD 
		WHERE PD.PurInvCode=P.PurInvCode) THEN ISNULL(P.MiscCharges, 0) - ISNULL(P.FlatDisc, 0) + ISNULL(T.InvPurTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	PurLedger p,	 
	PurDetail D,
	(SELECT 
		P.PurInvCode, 
		RoundingDiff=
		ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.purprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.purprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0) -
		(SUM((D.looseqty + D.packqty + D.bonusqty) * D.unitsalestax) +
		SUM((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc)) * D.gstperc * .01) +
			ROUND( (SUM(((D.looseqty + D.packqty) * D.Purprice) *
				(1 - (.01 * D.discperc))) * (1- (.01 * P.Discperc)) -
				P.flatdisc) * (P.invgstperc1 * .01), 2) + 
		SUM( ((D.looseqty + D.packqty) * D.Purprice) * 
				 (1 - (.01 * D.discperc))) * (1- (.01 * P.discperc)) + 
			P.misccharges + P.salestax - P.flatdisc),
		InvPurTax=ROUND(SUM((D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Purprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01), 2),
		NetAmt=ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.purprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.purprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0)
	FROM PurLedger P, PurDetail D,
			(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
			UNION ALL
			SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT
	WHERE 
		P.AccountFor = 'Y' AND
		P.PurInvCode = D.PurInvCode AND
		P.CustCode = CT.Custcode AND
		P.date  BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		P.PurInvCode,
		P.CustCode,
		P.DiscPerc,
		P.FlatDisc,
		P.InvGSTPerc1,
		P.DiscPerc,
		P.MiscCharges,
		P.SalesTax) T
WHERE   
	P.AccountFor = 'Y' AND
	P.PurInvCode = D.PurInvCode AND P.PurInvCode = T.PurInvCode AND
	P.CustCode = C.AccCode AND
	P.date BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	P.PurInvCode,
	P.PurCatCode,
	P.HeaderInvNo,
	P.HeaderNo,
	D.ICode,
	P.SuppCode, 
	P.CustCode,
	c.AreaCode,
	c.Area,
	P.Date,
	P.DiscPerc,
	P.MiscCharges,
	P.SalesTax,
	P.FlatDisc,
	P.InvGstPerc1,
	P.SuppInvCode,
	P.SuppInvDate,
	P.GRN,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	T.InvPurTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	Status=0,
	DocumentCode=P.PurInvCode,
	Type='PV-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Date = P.AmtDate, 
	Remark = 'Cash Paid During Pur #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Remark2 =NULL,
	Name=C.Name,
	Cash = CASE P.PurCatCode WHEN 1 THEN 'Y' WHEN 7 THEN 'Y' ELSE 'N' END,
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = P.Amt,
	Credit= 0,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	PurLedger P
WHERE   
	P.AccountFor = 'Y' AND
	P.CustCode = C.AccCode AND
	P.Amtdate BETWEEN :ar_startdate AND :ar_enddate AND
	P.Amt <> 0 AND P.PurCatcode NOT IN (1,7)
UNION ALL
SELECT  
	Status=0,
	DocumentCode=P.PurInvCode,
	Type='PV-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Date = P.AmtDate, 
	Remark = ISNULL(M.Remarks, 'Amount Paid on Pur #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode)))),
	Remark2 =NULL,
	Name=C.Name,
	Cash = CASE P.PurCatCode WHEN 1 THEN 'Y' WHEN 7 THEN 'Y' ELSE 'N' END,
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = M.Amount,
	Credit= 0,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	PurLedger P, MasterCashWin M
WHERE   
	M.DocumentType = 'PV' AND
	M.DocumentCode = P.PurInvCode AND
	M.Amount > 0 AND
	P.AccountFor = 'Y' AND
	P.CustCode = C.AccCode AND
	M.Date BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT  
	Status=0,
	DocumentCode=P.PrInvCode,
	Type='PR-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Date = P.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Remark2 =MAX(D.ItemDescription),
	Name=C.Name,
	Cash = CASE P.PrCatCode WHEN 4 THEN 'Y' ELSE 'N' END,
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.PRUTN),
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=-SUM(D.LooseQty+PackQty),
	Bonus=-SUM(D.BonusQty),
	Rate=MAX(D.PrPrice),
	GrossValue=-SUM((D.LooseQty + D.PackQty) * D.PRPrice),
	Discount= -1 *
		(SUM((D.looseqty+D.PackQty) * D.Prprice * (.01 * D.discperc)) + 
		SUM((D.looseqty+D.PackQty) * D.Prprice * (1-(.01*D.discperc)) * (.01 * P.discperc))),
	ItemSaleTax= -1 * (SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Prprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01)),
	ItemValue= -1 * (SUM((D.PackQty + D.LooseQty) * D.PrPrice) - 
		SUM((D.looseqty + D.PackQty) * D.Prprice * (.01 * D.discperc) +
				((D.looseqty + D.PackQty) * D.Prprice * (1-(.01*D.discperc)) * (.01 * P.discperc))) +  
		SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM( (D.PackQty + D.looseqty) * D.Prprice * (1 - (.01 * D.discperc)) * D.gstperc * .01)),
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.PRUTN) WHEN (SELECT MAX(PD.PRUTN) 
		FROM PrDetail PD 
		WHERE PD.PrInvCode=P.PrInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.PRUTN) WHEN (SELECT MAX(PD.PRUTN) 
		FROM PrDetail PD 
		WHERE PD.PrInvCode=P.PrInvCode) THEN CASE P.PrCatCode WHEN 4 THEN T.NetAmt ELSE 0 END ELSE 0 END,
	Others= CASE MAX(D.PRUTN) WHEN (SELECT MAX(PD.PRUTN) 
		FROM PrDetail PD 
		WHERE PD.PrInvCode=P.PrInvCode) THEN ISNULL(P.MiscCharges, 0) - ISNULL(P.FlatDisc, 0) + ISNULL(T.InvPurTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	PrLedger p,	 
	PrDetail D,
	(SELECT 
		P.PrInvCode, 
		RoundingDiff=
		ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.prprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.prprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0) -
		(SUM((D.looseqty + D.packqty + D.bonusqty) * D.unitsalestax) +
		SUM((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc)) * D.gstperc * .01) +
			ROUND( (SUM(((D.looseqty + D.packqty) * D.Prprice) *
				(1 - (.01 * D.discperc))) * (1- (.01 * P.Discperc)) -
				P.flatdisc) * (P.invgstperc1 * .01), 2) + 
		SUM( ((D.looseqty + D.packqty) * D.Prprice) * 
				 (1 - (.01 * D.discperc))) * (1- (.01 * P.discperc)) + 
			P.misccharges + P.salestax - P.flatdisc),
		InvPurTax=ROUND(SUM((D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Prprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01), 2),
		NetAmt=ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.prprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.prprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0)
	FROM PrLedger P, PrDetail D,
			(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
			UNION ALL
			SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT
	WHERE 
		P.Posted = 'Y' AND P.AccountFor = 'Y' AND
		P.PrInvCode = D.PrInvCode AND
		P.CustCode = CT.CustCode AND
		P.date     >= :ar_startdate AND
		P.date     <= :ar_enddate
	GROUP BY
		P.PrInvCode,
		P.DiscPerc,
		P.FlatDisc,
		P.InvGSTPerc1,
		P.DiscPerc,
		P.MiscCharges,
		P.SalesTax) T
WHERE   
	P.AccountFor = 'Y' AND
	P.PrInvCode = D.PrInvCode AND P.PrInvCode = T.PrInvCode AND
	P.CustCode = C.AccCode AND
	P.date BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	P.PrInvCode,
	P.PrCatCode,
	P.HeaderInvNo,
	P.HeaderNo,
	D.ICode,
	P.SuppCode, 
	P.CustCode,
	c.AreaCode,
	c.Area,
	P.Date,
	P.DiscPerc,
	P.MiscCharges,
	P.SalesTax,
	P.FlatDisc,
	P.InvGstPerc1,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	T.InvPurTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	Status=0,
	DocumentCode=P.PrInvCode,
	Type='PR-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Date = P.AmtDate, 
	Remark = 'Cash Recvd. During P/Ret #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Remark2 =NULL,
	Name=C.Name,
	Cash = CASE P.PrCatCode WHEN 4 THEN 'Y' ELSE 'N' END,
	C.AliasName,
