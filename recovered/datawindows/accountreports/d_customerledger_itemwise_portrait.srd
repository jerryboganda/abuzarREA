	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = P.Amt,
	Credit= 0,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE	A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	PrLedger P
WHERE   
	P.AccountFor = 'Y' AND
	P.CustCode = C.AccCode AND
	P.Amtdate BETWEEN :ar_startdate AND :ar_enddate AND
	P.Amt <> 0
UNION ALL
SELECT  
	Status=0,
	DocumentCode=P.PurInvCode,
	Type='PR-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Date = P.AmtDate, 
	Remark = ISNULL(M.Remarks, 'Amt Received on P/R #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode)))),
	Remark2 =NULL,
	Name=C.Name,
	Cash = 'N',
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = 0,
	Credit= M.Amount,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE	A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	PrLedger P, MasterCashWin M
WHERE   
	M.DocumentType = 'PR' AND
	M.DocumentCode = P.PrInvCode AND
	M.Amount > 0 AND
	P.AccountFor = 'Y' AND
	P.CustCode = C.AccCode AND
	M.Date BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT
	Status=0,
	V.documentcode, 
	Type = V.documenttype + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), V.documentcode))), 
	Date = V.Date, 
	Remark = V.Remarks,
	Remark2 = NULL,
	Name=C.Name,
	Cash = CASE ISNULL(V.AlternateAccCode, -1) WHEN -1 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	V.CheckNo,
	V.VRow,
	V.VoucherCode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvSaleTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit=V.Debit,
	Credit=V.Credit,
	Others= 0,
	PendingCheque=0
FROM
  VirtualGL V,
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE	A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C
WHERE   
	V.DocumentType NOT IN ('SV','SR','RS','RR','PV','PR') AND
	(V.AccCode = C.AccCode OR V.AlternateAccCode = C.AccCode ) and
	V.date  BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT
	Status=CASE WHEN N.Posted='Y' THEN 0 ELSE 1 END,
	documentcode = N.NoteCode, 
	Type = Case N.NoteCatCode When 1 Then '*NR' Else '*NP' End + '-' + RTrim(LTrim(convert(char(6), N.NoteCode))),  
	date = N.duedate, 
	Remark = N.Remarks,
	Remark2 = NULL,
	Name=C.Name,
	Cash = 'N',
	C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo = LEFT(N.DocumentNumber, 20),
	VRow=999999,
	VoucherCode=N.vouchercode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvSaleTax=0
	RoundingDiff=0*/
	NetAmt=0,
	debit = Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = C.AccCode THEN 0 ELSE N.Amount END ELSE CASE WHEN N.AccCode = C.AccCode THEN N.Amount ELSE 0 END END,
	credit= Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = C.AccCode THEN N.Amount ELSE 0 END ELSE CASE WHEN N.AccCode = C.AccCode THEN 0 ELSE N.Amount END END,
	Others= 0,
	PendingCheque=1
FROM
	Notes N,
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE	A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C
WHERE   
	(N.AccCode = C.AccCode OR N.BankAccCode = C.AccCode ) and
	N.Posted = 'N' AND N.Finalized = 'Y'
UNION ALL
SELECT
	Status=0,
	V.DocumentCode, 
	Type = V.DocumentType + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), V.DocumentCode))), 
	Date = V.Date, 
	Remark = CASE debit 
			WHEN 0 THEN 'Cash Paid Against Sale Ret. # '
			ELSE 'Cash Received Against Sales Inv. # '
			END + RTRIM(LTRIM(CONVERT(CHAR(6), V.DocumentCode))),
	Remark2 = NULL,
	c.Name,
	Cash = CASE ISNULL(v.AlternateAccCode, -1) WHEN -1 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	Address=c.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	Virtualgl.AccCode=C.AccCode and 
				VirtualGL.Date < :ar_startdate),
	C.AreaCode,
	c.Area,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvSaleTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit = V.Credit,
	Credit= V.Debit,
	Others=0,
	PendingCheque=0
FROM 
	VirtualGL V,
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		Area AR
	WHERE	A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C
WHERE   
	V.DocumentType NOT IN ('SV','SR','RS','RR') AND
	(V.AlternateAccCode = C.AccCode ) and
	V.date  BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT
	Status=0,
	DocumentCode=NULL, 
	Type = NULL, 
	Date = :ar_enddate, 
	remark = 'OPENING BALANCE',
	Remark2 = NULL,
	c.name,
	cash = 'N',
	c.aliasname,
	address=c.address1,
	openbalance=ISNULL((select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=C.acccode and 
				virtualgl.date < :ar_startdate), 0),
	c.areacode,
	c.area,
	CheckNo=NULL,
	VRow=0,
	vouchercode=NULL,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvSaleTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit = 0,
	Credit= 0,
	Others=0,
	PendingCheque=0
from
   (SELECT a.aliasname, a.acccode, a.name, ct.address1, ct.areacode, area=ar.name
	FROM	accounts a, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)) CT, 
		area ar
	WHERE	a.acccode = ct.custcode and 
			ar.areacode=ct.areacode AND 
			a.acccode NOT IN 
			(SELECT DISTINCT VGL.AccCode 
			FROM VirtualGL VGL 
			WHERE VGL.Date BETWEEN :ar_startdate AND :ar_enddate AND 
				VGL.AccCode IN
					(SELECT CT.CustCode FROM Customer CT WHERE :ai_allcustomers = 1
					UNION ALL
					SELECT CT.CustCode FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode))
			UNION ALL
			SELECT DISTINCT N.AccCode 
			FROM Notes N
			WHERE N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN
					(SELECT CT.CustCode FROM Customer CT WHERE :ai_allcustomers = 1
					UNION ALL
					SELECT CT.CustCode FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode))
			UNION ALL
			SELECT DISTINCT N.BankAccCode 
			FROM Notes N
			WHERE N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN 	
					(SELECT CT.CustCode FROM Customer CT WHERE :ai_allcustomers = 1
					UNION ALL
					SELECT CT.CustCode FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ai_custcode)))) C
ORDER BY
	Name, 
	AliasName, 
	Status,
	Date, 
	Type, 
	VRow"
  arguments=(("ai_custcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ai_allcustomers", number))
)
