table(column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=long updatewhereclause=yes name=headerinvcode dbname="HeaderInvCode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=invoiceage dbname="InvoiceAge"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(121) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(60) updatewhereclause=yes name=country dbname="Country"  )
column=(type=decimal(2) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=received dbname="Received"  )
column=(type=decimal(2) updatewhereclause=yes name=creditnotes dbname="CreditNotes"  )
column=(type=datetime updatewhereclause=yes name=lastreceiveddate dbname="LastReceivedDate"  )
column=(type=decimal(2) updatewhereclause=yes name=receivedoninv dbname="ReceivedOnInv"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
 retrieve="SELECT
	InvoiceCode=S.SaleInvCode,
	HeaderInvCode=S.HeaderInvNo,
	HeaderNo=S.HeaderNo,
	Date=S.Date,
	InvoiceAge = datediff(dd, date, getdate()),
	Customer=A.Name,
	AliasName=A.AliasName,
	Address= RTRIM(LTRIM(C.Address1)) + ' ' + RTRIM(LTRIM(C.Address2)),
	SalesPerson = ISNULL((SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = S.SManCode), '  <Others> '),
	City=C.CITY, 
	Country=C.Country,
	NetAmt=InvTotal,
	Received=R.Received,
	CreditNotes	=R.CreditNotes,
	LastReceivedDate=R.PostDate,
	ReceivedOnInv= 0.00, ---isnull(Amt, 0) + isnull(CashCharged, 0) + ISNULL((SELECT SUM(CW.Amount) FROM CashierWindow CW WHERE CW.SaleInvCode=S.SaleInvCode), 0),
	Balance=OutstandingAmt
FROM SaleLedger S, Accounts A, Customer C,
	(SELECT H.SmanCode, PostDate=Max(H.PostDate), D.InvoiceCode, 
		Received=SUM(CASE WHEN H.VochCatCode = 22 THEN 0.00 ELSE D.Credit END) , 
		CreditNotes=SUM(CASE WHEN H.VochCatCode = 22 THEN D.Credit ELSE 0.00 END)
	FROM GLdetail D, GLHeader H 
	WHERE  H.GLVochCode = D.GLVochCode AND 
		H.PostDate >= :ad_startdate AND H.PostDATE <= :ad_enddate AND
		D.InvoiceCode > 0 AND 
		D.Credit > 0 AND 
		(H.SManCode IN (:ai_smancode) OR H.SmanCode IS NULL) AND
		H.VochCatCode IN (SELECT V.VochCatCode FROM VocherCategory V WHERE V.InvoiceBased=1 AND V.InvoiceType=1)
	GROUP BY H.SmanCode, D.InvoiceCode) R
WHERE
	S.AccountFor = 'Y' AND
	S.Marked = 'N' AND
	S.SaleCatCode IN (2) AND
	S.CustCode = A.AccCode AND
	A.AccCode = C.CustCode AND
	S.SaleInvCode = R.InvoiceCode




"
  arguments=(("ai_smancode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="salesperson A, invoicecode A, date A"
)
