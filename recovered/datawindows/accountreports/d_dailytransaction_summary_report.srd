table(column=(type=long updatewhereclause=yes name=grouptype dbname="GroupType"  )
column=(type=char(22) updatewhereclause=no name=transactiontype dbname="TransactionType"  )
column=(type=char(100) updatewhereclause=no name=transactionsubtype dbname="TransactionSubType"  )
column=(type=long updatewhereclause=yes name=postedcount dbname="PostedCount"  )
column=(type=long updatewhereclause=yes name=unpostedcount dbname="UnPostedCount"  )
column=(type=decimal(2) updatewhereclause=yes name=postedvalue dbname="PostedValue"  )
column=(type=decimal(2) updatewhereclause=yes name=unpostedvalue dbname="UnPostedValue"  )
 retrieve="SELECT 
	GroupType=1,
	TransactionType = 'SALES',
	TransactionSubType = CASE WHEN S.SaleCatCode = 3 THEN 'CASH SALES' ELSE 'CREDIT SALES' END,
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN S.InvTotal ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE S.InvTotal  END)
FROM
	SaleLedger S
WHERE S.Date BETWEEN :adt_startdate AND :adt_enddate
GROUP BY S.SaleCatCode
UNION ALL
SELECT 
	GroupType=2,
	TransactionType = 'S/R',
	TransactionSubType = CASE WHEN S.SRCatCode = 8 THEN 'CASH S/R' ELSE 'CREDIT S/R' END,
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN S.InvTotal ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE S.InvTotal END)
FROM
	SRLedger S
WHERE S.PostDate BETWEEN :adt_startdate AND :adt_enddate
GROUP BY S.SRCatCode
UNION ALL
SELECT 
	GroupType=3,
	TransactionType = 'PURCHASES',
	TransactionSubType = CASE WHEN S.PurCatCode <= 2 THEN 'PACK PURCHASE' WHEN S.PurCatCode = 3 THEN 'OPENING PURCHASE' ELSE 'LOOSE PURCHASE' END,
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN S.InvTotal ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE S.InvTotal END)
FROM
	PURLedger S
WHERE S.PostDate BETWEEN :adt_startdate AND :adt_enddate
GROUP BY S.PurCatCode
UNION ALL
SELECT 
	GroupType=4,
	TransactionType = 'P/R',
	TransactionSubType = 'P/R',
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN S.InvTotal ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE S.InvTotal END)
FROM
	PRLedger S
WHERE S.Date BETWEEN :adt_startdate AND :adt_enddate
GROUP BY S.PRCatCode
UNION ALL
SELECT 
	GroupType=5,
	TransactionType = 'Receipts',
	TransactionSubType = RC.Name,
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN (D.Price * D.Qty) ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE (D.Price * D.Qty) END)
FROM
	ReceiptHeader S, ReceiptDetail D, ReceiptCategory RC
WHERE 
	S.PostDate BETWEEN :adt_startdate AND :adt_enddate AND S.ReceiptInvCode=D.ReceiptInvCode AND
	S.ReceiptCategoryCode = RC.ReceiptCategoryCode
GROUP BY RC.Name
UNION ALL
SELECT 
	GroupType=6,
	TransactionType = 'Issue',
	TransactionSubType = IC.Name,
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN (D.Price * D.Qty) ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE (D.Price * D.Qty) END)
FROM
	IssueHeader S, IssueDetail D, IssueCategory IC
WHERE 
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND S.IssueInvCode=D.IssueInvCode AND
	S.IssueCategoryCode = IC.IssueCategoryCode
GROUP BY IC.Name
UNION ALL
SELECT 
	GroupType=7,
	TransactionType = 'INTER-GODOWN TRANSFERS',
	TransactionSubType = TT.Name,
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN (D.SalePrice * D.Qty) ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE (D.SalePrice * D.Qty) END)
FROM
	THeader S, TDetail D, TransactionType TT
WHERE 
	S.PostDate BETWEEN :adt_startdate AND :adt_enddate AND S.TransCode=D.TransCode AND
	S.TTCode = TT.TransactionTypeCode
GROUP BY TT.Name
UNION ALL
SELECT 
	GroupType=8,
	TransactionType = 'STOCK ADJUSTMENTS',
	TransactionSubType = AC.Name,
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN (D.Price * D.LooseQty) ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE (D.Price * D.LooseQty) END)
FROM
	AdjHeader S, AdjDetail D, AdjCategory AC
WHERE 
	S.PostedDate BETWEEN :adt_startdate AND :adt_enddate AND S.AdjCode=D.AdjCode AND
	S.AdjCatCode = AC.AdjCatCode
GROUP BY AC.Name
UNION ALL
SELECT 
	GroupType=9,
	TransactionType = 'NOTES DOCUMENTS',
	TransactionSubType = NC.Name,
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN S.Amount ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE S.Amount END)
FROM
	Notes S, NotesCategory NC
WHERE 
	S.PostDate BETWEEN :adt_startdate AND :adt_enddate AND S.NoteCatCode = NC.NoteCatCode
GROUP BY NC.Name
UNION ALL
SELECT 
	GroupType=10,
	TransactionType = 'SALE OF SERVICES',
	TransactionSubType = CASE WHEN S.ServiceCatCode=10 THEN 'CASH SERVICE' ELSE 'CREDIT SERVICE' END,
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN S.InvTotal ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE S.InvTotal END)
FROM
	ServiceHeader S
WHERE 
	S.Date BETWEEN :adt_startdate AND :adt_enddate
GROUP BY S.ServiceCatCode
UNION ALL
SELECT 
	GroupType=11,
	TransactionType = 'S/R OF SERVICES',
	TransactionSubType = CASE WHEN S.ServiceRCatCode=13 THEN 'CASH SERVICE RETURN' ELSE 'CREDIT SERVICE RETURN' END,
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN S.InvTotal ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE S.InvTotal END)
FROM
	ServiceRHeader S
WHERE 
	S.Date BETWEEN :adt_startdate AND :adt_enddate
GROUP BY S.ServiceRCatCode
UNION ALL
SELECT 
	GroupType=12,
	TransactionType = 'PURCHASE OF SERVICES',
	TransactionSubType = 'PURCHASE OF SERVICES',
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN S.InvTotal ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE S.InvTotal END)
FROM
	ServicePurHeader S
WHERE 
	S.Date BETWEEN :adt_startdate AND :adt_enddate
UNION ALL
SELECT 
	GroupType=13,
	TransactionType = 'P/R OF SERVICES',
	TransactionSubType = 'PURCHASE OF SERVICES',
	PostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN S.InvTotal ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN S.Posted = 'Y' THEN 0 ELSE S.InvTotal END)
FROM
	ServicePRHeader S
WHERE 
	S.Date BETWEEN :adt_startdate AND :adt_enddate
UNION ALL
SELECT 
	GroupType=14,
	TransactionType = 'ACCOUNTING VOUCHERS',
	TransactionSubType = VC.Name,
	PostedCount = SUM(CASE WHEN H.Posted = 'Y' THEN 1 ELSE 0 END),
	UnPostedCount = SUM(CASE WHEN H.Posted = 'Y' THEN 0 ELSE 1 END),
	PostedValue = SUM(CASE WHEN H.Posted = 'Y' THEN D.Debit ELSE 0 END),
	UnPostedValue = SUM(CASE WHEN H.Posted = 'Y' THEN 0 ELSE D.DEBIT END)
FROM
	GLHeader H, GLDetail D, VocherCategory VC
WHERE 
	H.PostDate BETWEEN :adt_startdate AND :adt_enddate AND H.GLVochCode = D.GLVochCode AND
	H.VochCatCode = VC.VochCAtCode
GROUP BY VC.Name
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="grouptype A, transactiontype A, transactionsubtype A"
 filter="(postedcount + unpostedcount) <> 0"
 )
