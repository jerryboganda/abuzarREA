table(column=(type=long updatewhereclause=yes name=custcode dbname="Custcode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=saleperson dbname="Saleperson"  )
 retrieve="SELECT  Custcode=C.Custcode,
	AliasName=A.AliasName,
	Customer=A.Name, 
	Balance=MAX(Isnull(B.Balance, 0)),
	Address=C.Address1,
	Area = Ar.Name,
	AreaCode=C.AreaCode,
	Saleperson=ISNULL((SELECT Salesman.name From Salesman WHERE Salesman.Salesmancode = C.SalesmanCode), '')

FROM    (SELECT  Acccode,
		Balance=Sum(debit-credit)
	From VirtualGL
	Where Acccode IN (select custcode from customer where areacode in (:ar_AreaCode) and
				custcode not in (select distinct custcode from saleledger where posted='N'))
	Group By Acccode) B,
	Customer C,
	Accounts A,
	Area Ar

WHERE   C.AreaCode IN (:ar_AreaCode) AND 
	C.AreaCode = Ar.AreaCode AND
	C.CustCode=A.Acccode AND
	A.Acccode = B.Acccode

GROUP BY C.CustCode,
	 A.Name,
	 C.Address1,
	 A.AliasName,
	 Ar.Name,
	 C.AreaCode,
	 C.SalesmanCode
Order BY 
	 Ar.Name,
	 C.AreaCode,
	 A.AliasName,
	 Customer
"
  arguments=(("ar_AreaCode", numberlist))
)
