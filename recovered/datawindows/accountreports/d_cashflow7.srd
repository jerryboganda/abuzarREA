release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1341 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=183 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=long updatewhereclause=yes name=reportorder dbname="ReportOrder"  )
column=(type=long updatewhereclause=yes name=suborder dbname="SubOrder"  )
column=(type=char(29) updatewhereclause=yes name=reportgroup dbname="ReportGroup"  )
column=(type=char(75) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=decimal(2) updatewhereclause=yes name=cashamount dbname="CashAmount"  )
 retrieve="SELECT
	ReportOrder,
	SubOrder, 
	ReportGroup,
	Remarks,
	Amount = ISNULL(SUM(Amount), 0),
	CashAmount = ISNULL(SUM(CashAmount), 0)
FROM
	(SELECT 
		ReportOrder = 1,
		SubOrder = 1,
		ReportGroup = 'Opening Balances',
		Remarks = A.Name,
		Amount = 0.00,
		CashAmount = ISNULL((SELECT SUM(V.Debit - V.Credit) FROM VirtualGL V WHERE V.AccCode = A.AccCode AND V.Date < :adt_StartDate), 0)
	FROM 
		Accounts A
	WHERE SubCode IN 
		(SELECT Code FROM Global WHERE Name = 'GT_CashSub')
	UNION ALL
	SELECT 
		ReportOrder = 2,
		SubOrder = 1,
		ReportGroup = 'Sales',
		Remarks = 'Cash Sales' + ISNULL(' (' + LTRIM(RTRIM(STR(COUNT(SL.SaleInvCode)))) + ')',''),
		Amount = ISNULL(SUM(SL.InvTotal),0),
		CashAmount = ISNULL(SUM(SL.InvTotal),0)
	FROM 
		SaleLedger SL
	WHERE 
		SL.SaleCatCode IN (1,3) AND 
		SL.Posted = 'Y' AND
		SL.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 2,
		SubOrder = 2,
		ReportGroup = 'Sales',
		Remarks = 'Credit Sales' + ISNULL(' (' + (SELECT LTRIM(RTRIM(STR(COUNT(S.SaleInvCode))))  FROM SaleLedger S WHERE S.SaleCatCode NOT IN (1,3) AND S.Date BETWEEN :adt_StartDate AND :adt_EndDate) + ')',''),
		Amount = ISNULL(SUM(SL.InvTotal), 0),
		CashAmount = ISNULL(SUM(SL.CashCharged), 0) +
			ISNULL(
				(SELECT SUM(S.Amt)
				FROM SaleLedger S 
				WHERE 
					S.Amt > 0 AND 
					S.PaymentAccCode IN 
						(SELECT AA.AccCode 
						FROM Accounts AA
						WHERE AA.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
					S.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0) +
			ISNULL(
				(SELECT SUM(S.Amt)
				FROM SaleLedger S, CashierWindow CW
				WHERE 
					S.SaleInvCode =CW.SaleInvCode AND 
					CW.AccCode IN 
						(SELECT AA.AccCode 
						FROM Accounts AA
						WHERE AA.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
					S.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0)
	FROM 
		SaleLedger SL
	WHERE 
		SL.SaleCatCode NOT IN (1,3) AND
		SL.Posted = 'Y' AND
		SL.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 3,
		SubOrder = 1,
		ReportGroup = 'Sales Return',
		Remarks = 'Cash Sales Return' + ISNULL(' (' + LTRIM(RTRIM(STR(COUNT(SL.SRInvCode)))) + ')',''),
		Amount = ISNULL(SUM(SL.InvTotal), 0),
		CashAmount = - ISNULL(SUM(SL.InvTotal), 0)
	FROM 
		SRLedger SL
	WHERE 
		SL.SRCatCode IN (6,8) AND
		SL.Posted = 'Y' AND
		SL.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 3,
		SubOrder = 2,
		ReportGroup = 'Sales Return',
		Remarks = 'Credit Sales Return' + ISNULL(' (' + LTRIM(RTRIM(STR(COUNT(SL.SRInvCode)))) + ')',''),
		Amount = ISNULL(SUM(SL.InvTotal), 0),
		CashAmount = - ( ISNULL(SUM(SL.CashCharged), 0) +
			ISNULL(
				(SELECT SUM(S.Amt)
				FROM SRLedger S 
				WHERE 
					S.Amt > 0 AND 
					S.PaymentAccCode IN 
						(SELECT AA.AccCode 
						FROM Accounts AA
						WHERE AA.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
					S.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0) +
			ISNULL(
				(SELECT SUM(S.Amt)
				FROM SRLedger S, MasterCashWin CW
				WHERE 
					CW.DocumentType = 'SR' AND 
					CW.DocumentCode = S.SRInvCode AND 
					CW.AccCode IN 
						(SELECT AA.AccCode 
						FROM Accounts AA
						WHERE AA.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
					CW.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0) )
	FROM 
		SRLedger SL
	WHERE 
		SL.SRCatCode NOT IN (6,8) AND
		SL.Posted = 'Y' AND
		SL.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 4,
		SubOrder = 1,
		ReportGroup = 'Purchases',
		Remarks = 'Purchases' + ISNULL(' (' + LTRIM(RTRIM(STR(COUNT(PL.PurInvCode)))) + ')',''),
		Amount = ISNULL(SUM(PL.InvTotal), 0),
		CashAmount = - 
			ISNULL(
				(SELECT SUM(S.Amt)
				FROM PurLedger S 
				WHERE 
					S.Amt > 0 AND 
					S.PaymentAccCode IN 
						(SELECT AA.AccCode 
						FROM Accounts AA
						WHERE AA.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
					S.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0)
	FROM 
		PurLedger PL
	WHERE
		PL.Posted = 'Y' AND
		PL.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 5,
		SubOrder = 1,
		ReportGroup = 'Purchases Return',
		Remarks = 'Purchases Return' + ISNULL(' (' + LTRIM(RTRIM(STR(COUNT(PL.PRInvCode)))) + ')',''),
		Amount = ISNULL(SUM(PL.InvTotal), 0),
		CashAmount = ISNULL(
			(SELECT SUM(S.Amt)
			FROM PRLedger S 
			WHERE 
				S.Amt > 0 AND 
				S.PaymentAccCode IN 
					(SELECT AA.AccCode 
					FROM Accounts AA
					WHERE AA.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
				S.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0)
	FROM 
		PRLedger PL
	WHERE
		PL.Posted = 'Y' AND
		PL.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 6,
		SubOrder = 1,
		ReportGroup = 'Services',
		Remarks = 'Cash Services' + ISNULL(' (' + LTRIM(RTRIM(STR(COUNT(S.ServiceInvCode)))) + ')',''),
		Amount = ISNULL(SUM(dbo.fn_GetServiceInvTotal(S.ServiceInvCode)), 0),
		CashAmount = ISNULL(SUM(dbo.fn_GetServiceInvTotal(S.ServiceInvCode)), 0)
	FROM 
		ServiceHeader S
	WHERE 
		S.Posted = 'Y' AND
		S.ServiceCatCode IN (10) AND
		S.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 6,
		SubOrder = 2,
		ReportGroup = 'Services',
		Remarks = 'Credit Services' + ISNULL(' (' + LTRIM(RTRIM(STR(COUNT(S.ServiceInvCode)))) + ')',''),
		Amount = ISNULL(SUM(dbo.fn_GetServiceInvTotal(S.ServiceInvCode)), 0),
		CashAmount = ISNULL(SUM(S.CashCharged), 0) +
			ISNULL(
				(SELECT SUM(CW.Amount)
				FROM ServiceHeader SS, MasterCashWin CW
				WHERE 
					CW.DocumentType = 'RS' AND 
					CW.DocumentCode = SS.ServiceInvCode AND 
					CW.AccCode IN 
						(SELECT AA.AccCode 
						FROM Accounts AA
						WHERE AA.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
					CW.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0)
	FROM 
		ServiceHeader S
	WHERE 
		S.Posted = 'Y' AND
		S.ServiceCatCode NOT IN (10) AND
		S.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 7,
		SubOrder = 1,
		ReportGroup = 'Service Return',
		Remarks = 'Cash Service Return' + ISNULL(' (' + LTRIM(RTRIM(STR(COUNT(S.ServiceRInvCode)))) + ')',''),
		Amount = ISNULL(SUM(dbo.fn_GetServiceReturnInvTotal(S.ServiceRInvCode)), 0),
		CashAmount = - ISNULL(SUM(dbo.fn_GetServiceReturnInvTotal(S.ServiceRInvCode)), 0)
	FROM 
		ServiceRHeader S
	WHERE 
		S.Posted = 'Y' AND
		S.ServiceRCatCode IN (13) AND
		S.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 7,
		SubOrder = 2,
		ReportGroup = 'Service Return',
		Remarks = 'Credit Service Return' + ISNULL(' (' + LTRIM(RTRIM(STR(COUNT(S.ServiceRInvCode)))) + ')',''),
		Amount = ISNULL(SUM(dbo.fn_GetServiceReturnInvTotal(S.ServiceRInvCode)), 0),
		CashAmount = -1 * (ISNULL(SUM(S.CashCharged), 0) +
			ISNULL(
				(SELECT SUM(CW.Amount)
				FROM ServiceRHeader SS, MasterCashWin CW
				WHERE 
					CW.DocumentType = 'RR' AND 
					CW.DocumentCode = SS.ServiceRInvCode AND 
					CW.AccCode IN 
						(SELECT AA.AccCode 
						FROM Accounts AA
						WHERE AA.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
					CW.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0))
	FROM 
		ServiceRHeader S
	WHERE 
		S.Posted = 'Y' AND
		S.ServiceRCatCode NOT IN (13) AND
		S.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 8,
		SubOrder = 1,
		ReportGroup = 'Patient Registration',
		Remarks = 'Patients Registered ' + ISNULL(' (' + LTRIM(RTRIM(STR(COUNT(P.PatientCode)))) + ')',''),
		Amount = ISNULL(SUM(P.CashCharged), 0) +
			ISNULL(
				(SELECT SUM(CW.Amount)
				FROM Patient PP, MasterCashWin CW
				WHERE 
					CW.DocumentType = 'PG' AND CW.DocumentCode = PP.PatientCode AND 
					CW.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0),
		CashAmount = ISNULL(SUM(P.CashCharged), 0) +
			ISNULL(
				(SELECT SUM(CW.Amount)
				FROM Patient PP, MasterCashWin CW
				WHERE 
					CW.DocumentType = 'PG' AND 
					CW.DocumentCode = PP.PatientCode AND 
					CW.AccCode IN 
						(SELECT AA.AccCode 
						FROM Accounts AA
						WHERE AA.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
					CW.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0)
	FROM 
		Patient P
	WHERE 
		P.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 9,
		SubOrder = 1,
		ReportGroup = 'Patient Admission',
		Remarks = 'Patients Admitted ' + ISNULL(' (' + LTRIM(RTRIM(STR(COUNT(P.AdmissionCode)))) + ')',''),
		Amount = ISNULL(SUM(P.CashCharged), 0) +
			ISNULL(
				(SELECT SUM(CW.Amount)
				FROM PatientAdmission PP, MasterCashWin CW
				WHERE 
					CW.DocumentType = 'PG' AND CW.DocumentCode = PP.AdmissionCode AND 
					CW.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0),
		CashAmount = ISNULL(SUM(P.CashCharged), 0) +
			ISNULL(
				(SELECT SUM(CW.Amount)
				FROM Patient PP, MasterCashWin CW
				WHERE 
					CW.DocumentType = 'PG' AND 
					CW.DocumentCode = PP.PatientCode AND 
					CW.AccCode IN 
						(SELECT AA.AccCode 
						FROM Accounts AA
						WHERE AA.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
					CW.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0)
	FROM 
		PatientAdmission P
	WHERE 
		P.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 10,
		SubOrder = 1,
		ReportGroup = 'Transaction Window - Receipts',
		Remarks = TT.Name + ISNULL(' - (' + LTRIM(RTRIM(STR(COUNT(T.DocumentCode)))) + ')',''),
		Amount = ISNULL(SUM(T.CashCharged), 0) + 
			ISNULL(
				(SELECT SUM(D.Amount)
				FROM TransactionHeader TH, TransactionDetail D, TransactionType TTP
				WHERE 
					TH.TransactionTypeCode = T.TransactionTypeCode AND 
					TH.TransactionTypeCode = TTP.TransactionTypeCode AND 
					TH.DocumentCode = D.DocumentCode AND 
					TH.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0),
		CashAmount = ISNULL(SUM(T.CashCharged), 0) + 
			ISNULL(
				(SELECT SUM(D.Amount)
				FROM TransactionHeader TH, TransactionDetail D, TransactionType TTP
				WHERE 
					TH.TransactionTypeCode = T.TransactionTypeCode AND 
					TH.TransactionTypeCode = TTP.TransactionTypeCode AND 
					TH.DocumentCode = D.DocumentCode AND 
					D.AccCode IN 
						(SELECT AA.AccCode 
						FROM Accounts AA
						WHERE AA.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
					TH.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0)
	FROM 
		TransactionHeader T, TransactionType TT
	WHERE 
		T.Posted = 'Y' AND
		T.Date BETWEEN :adt_StartDate AND :adt_EndDate AND
		T.TransactionTypeCode = TT.TransactionTypeCode AND
		TT.TransactionCatCode = 1
	GROUP BY
		T.TransactionTypeCode,
		TT.Name
	UNION ALL
	SELECT 
		ReportOrder = 11,
		SubOrder = 1,
		ReportGroup = 'Transaction Window - Payments',
		Remarks = TT.Name + ISNULL(' - (' + LTRIM(RTRIM(STR(COUNT(T.DocumentCode)))) + ')',''),
		Amount = - (ISNULL(SUM(T.CashCharged), 0) + 
			ISNULL(
				(SELECT SUM(D.Amount)
				FROM TransactionHeader TH, TransactionDetail D, TransactionType TTP
				WHERE 
					TH.TransactionTypeCode = T.TransactionTypeCode AND 
					TH.TransactionTypeCode = TTP.TransactionTypeCode AND 
					TH.DocumentCode = D.DocumentCode AND 
					TH.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0)),
		CashAmount = - (ISNULL(SUM(T.CashCharged), 0) + 
			ISNULL(
				(SELECT SUM(D.Amount)
				FROM TransactionHeader TH, TransactionDetail D, TransactionType TTP
				WHERE 
					TH.TransactionTypeCode = T.TransactionTypeCode AND 
					TH.TransactionTypeCode = TTP.TransactionTypeCode AND 
					TH.DocumentCode = D.DocumentCode AND 
					D.AccCode IN 
						(SELECT AA.AccCode 
						FROM Accounts AA
						WHERE AA.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
					TH.Date BETWEEN :adt_StartDate AND :adt_EndDate), 0))
	FROM 
		TransactionHeader T, TransactionType TT
	WHERE 
		T.Posted = 'Y' AND
		T.Date BETWEEN :adt_StartDate AND :adt_EndDate AND
		T.TransactionTypeCode = TT.TransactionTypeCode AND
		TT.TransactionCatCode = 2
	GROUP BY
		T.TransactionTypeCode,
		TT.Name
	UNION ALL
	SELECT 
		ReportOrder = 16,
		SubOrder = 1,
		ReportGroup = 'Others',
		Remarks = 'Cash Receipts',
		Amount = ISNULL(SUM(V.Debit), 0),
		CashAmount = ISNULL(SUM(V.Debit), 0)
	FROM 
		VirtualGL V
	WHERE
		V.DocumentType NOT IN ('SV','SR', 'PV','PR','RS','RR','PG','PA') AND
		V.DocumentType NOT IN (SELECT DISTINCT TT.ShortName FROM TransactionType TT WHERE TT.Posted='Y') AND
		V.AccCode IN 
			(SELECT A.AccCode 
			FROM Accounts A
			WHERE A.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
		V.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 16,
		SubOrder = 2,
		ReportGroup = 'Others',
		Remarks = 'Cash Payments',
		Amount = ISNULL(SUM(V.Credit), 0),
		CashAmount = - ISNULL(SUM(V.Credit), 0)
	FROM 
		VirtualGL V
	WHERE
		V.DocumentType NOT IN ('SV','SR', 'PV','PR','RS','RR','PG','PA') AND
		V.DocumentType NOT IN (SELECT DISTINCT TT.ShortName FROM TransactionType TT WHERE TT.Posted='Y') AND
		V.AccCode IN 
			(SELECT A.AccCode 
			FROM Accounts A
			WHERE A.SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub')) AND
		V.Date BETWEEN :adt_StartDate AND :adt_EndDate
	UNION ALL
	SELECT 
		ReportOrder = 18,
		SubOrder = 1,
		ReportGroup = 'Closing Balances',
		Remarks = A.Name,
		Amount = 0.00,
		CashAmount = ISNULL((SELECT SUM(V.Debit - V.Credit) FROM VirtualGL V WHERE V.AccCode = A.AccCode AND V.Date <= :adt_EndDate), 0)
	FROM 
		Accounts A
	WHERE SubCode IN 
		(SELECT Code FROM Global WHERE Name = 'GT_CashSub')) T
GROUP BY
	ReportOrder,
	SubOrder,
	ReportGroup,
	Remarks
ORDER BY
	ReportOrder,
	SubOrder,
	ReportGroup,
	Remarks"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 filter="NOT (amount = 0 AND  cashamount = 0)"
 )
group(level=1 header.height=208 trailer.height=208 by=("reportgroup"  ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.length="100" header.gradient.repetition.count="0" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.length="100" trailer.gradient.repetition.count="0" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" )
text(name=t_3 visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" tooltip.enabled="0" tooltip.isbubble="0" tooltip.textcolor="134217751" tooltip.backcolor="134217752" tooltip.icon="0" tooltip.maxwidth="0" tooltip.transparency="0" tooltip.delay.visible="32000" tooltip.delay.initial="0" tooltip.hasclosebutton="0" transparency="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.length="100" background.gradient.repetition.count="0" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" color="0" alignment="2" border="0" x="91" y="83" height="166" width="7608" text="Cash Activity/Flow Summary Report" html.valueishtml="0" )
compute(name=c_companyname visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" tooltip.enabled="0" tooltip.isbubble="0" tooltip.textcolor="134217751" tooltip.backcolor="134217752" tooltip.icon="0" tooltip.maxwidth="0" tooltip.transparency="0" tooltip.delay.visible="32000" tooltip.delay.initial="0" tooltip.hasclosebutton="0" transparency="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.length="100" background.gradient.repetition.count="0" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" color="0" x="91" y="283" height="150" width="7608" format="[general]" expression="f_ReportHeaderInfo('clientname')" alignment="2" border="0" html.valueishtml="0" crosstab.repeat=no )
