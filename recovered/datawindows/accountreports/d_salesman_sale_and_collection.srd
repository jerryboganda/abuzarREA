datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1270 color="536870912" )
summary(height=218 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=salesmancode dbname="SalesManCode"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="SalesMan"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=decimal(2) updatewhereclause=yes name=accountbalance dbname="AccountBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=overduebalance dbname="OverDueBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=amtcollected dbname="AmtCollected"  )
column=(type=datetime updatewhereclause=yes name=lastcollectiondate dbname="LastCollectionDate"  )
column=(type=decimal(2) updatewhereclause=yes name=netsale dbname="NetSale"  )
column=(type=decimal(7) updatewhereclause=yes name=netsalevolume dbname="NetSaleVolume"  )
column=(type=datetime updatewhereclause=yes name=lastinvdate dbname="LastInvDate"  )
 retrieve="SELECT 
	SalesManCode=C.SalesManCode,
	SalesMan=S.Name,
	AccCode=A.AccCode,
	AliasName=A.AliasName,
	Customer=A.Name, 
	Address1=C.Address1,
	AccountBalance=ISNULL(SUM(NS.Balance), 0),
	OverDueBalance=ISNULL(SUM(NS.ODBalance), 0),
	AmtCollected= ISNULL(SUM(NS.Collection), 0),
	LastCollectionDate=MAX(NS.CollectionDate),
	NetSale=ISNULL(Sum(NS.NetSale), 0),
	NetSaleVolume=ISNULL(Sum(NS.Volume), 0),
	LastInvDate = NS.SaleDate
FROM 
	SalesMan S, 
	Customer C,
	Accounts A
	LEFT OUTER JOIN  
	(SELECT
		S.CustCode,
		SaleDate=Max(S.Date),
		NetSale=SUM(S.Sale),
		Volume=SUM(S.Volume),
		Balance = SUM(S.Balance),
		ODBalance= SUM(S.ODBalance),
		Collection = SUM(S.Collection),
		CollectionDate = MAX(S.CollectionDate)
	FROM
		(SELECT
			S.CustCode,
			InvCode=Max(S.SaleInvCode),
			Date=Max(S.Date),
			Volume = 0,
			Sale=SUM(S.InvTotal),
			Balance = 0.00,
			ODBalance=0,
			Collection=0,
			CollectionDate=NULL
		FROM
			SaleLedger S, Customer C
		WHERE 
			S.Date BETWEEN :ad_startdate AND :ad_enddate AND
			S.CustCode = C.CustCode AND
			C.SalesManCode IN (:ai_salesmancode)
		GROUP BY
			S.CustCode
		UNION ALL
		SELECT
			S.CustCode,
			InvCode=Max(S.SaleInvCode),
			Date=Max(S.Date),
			Volume = 0,
			Sale=-SUM(S.InvTotal),
			Balance = 0.00,
			ODBalance=0,
			Collection=0,
			CollectionDate=NULL
		FROM
			SRLedger S, Customer C
		WHERE 
			S.Date BETWEEN :ad_startdate AND :ad_enddate AND
			S.CustCode = C.CustCode AND
			C.SalesManCode IN (:ai_salesmancode)
		GROUP BY
			S.CustCode
		UNION ALL
		SELECT
			S.CustCode,
			InvCode=NULL,
			Date=Null,
			Volume = SUM(SD.LooseQty * I.PackingFactor),
			Sale=0,
			Balance = 0.00,
			ODBalance=0,
			Collection=0,
			CollectionDate=NULL
		FROM
			SaleLedger S, SaleDetail SD, Customer C, Item I
		WHERE 
			S.Date BETWEEN :ad_startdate AND :ad_enddate AND
			S.SaleInvCode = SD.SaleInvCode AND
			SD.ICode = I.ICode AND
			S.CustCode = C.CustCode AND
			C.SalesManCode IN (:ai_salesmancode)
		GROUP BY
			S.CustCode
		UNION ALL
		SELECT
			S.CustCode,
			InvCode=NULL,
			Date=Null,
			Volume = - SUM(SD.LooseQty * I.PackingFactor),
			Sale=0,
			Balance = 0.00,
			ODBalance=0,
			Collection=0,
			CollectionDate=NULL
		FROM
			SRLedger S, SRDetail SD, Customer C, Item I
		WHERE 
			S.Date BETWEEN :ad_startdate AND :ad_enddate AND
			S.SRInvCode = SD.SRInvCode AND 
			SD.ICode = I.ICode AND
			S.CustCode = C.CustCode AND
			C.SalesManCode IN (:ai_salesmancode)
		GROUP BY
			S.CustCode
		UNION ALL
		SELECT 
			CustCode=C.CustCode, 
			InvCode= NULL,
			Date = NULL,
			Volume=0,
			Sale = 0,
			Balance=ISNULL(SUM(V.Debit - V.Credit),0),
			ODBalance=0,
			Collection=0,
			CollectionDate=NULL
		FROM 
			Customer C
			LEFT OUTER JOIN VirtualGl AS V ON (C.CustCode = V.AccCode)
		WHERE 
			C.SalesManCode IN (:ai_salesmancode) AND
			V.Date <= :ad_enddate
		GROUP BY 
			C.CustCode
		UNION ALL
		SELECT 
			CustCode=C.CustCode, 
			InvCode= NULL,
			Date = NULL,
			Volume=0,
			Sale = 0,
			Balance=0,
			ODBalance=ISNULL((SELECT SUM(R.Value1) FROM ReportData R WHERE R.Code1 = C.CustCode), 0),
			Collection=0,
			CollectionDate=NULL
		FROM 
			Customer C
		WHERE 
			C.SalesManCode IN (:ai_salesmancode)
		UNION ALL
		SELECT 
			CustCode=C.CustCode, 
			InvCode= NULL,
			Date = NULL,
			Volume=0,
			Sale = 0,
			Balance=0,
			ODBalance=0,
			Collection=SUM(GG.Credit),
			CollectionDate=MAX(CASE WHEN GL.VochCatCode = 2 THEN GL.Date ELSE NULL END)
		FROM 
			GLDetail GG, GLHeader GL, Customer C
		WHERE 
			C.SalesManCode IN (:ai_salesmancode) AND
			GG.AccCode = C.CustCode AND
			GG.Credit <> 0 AND
			GL.Posted = 'Y' AND 
			GL.Date BETWEEN :ad_startdate AND :ad_enddate AND 
			GG.GLVochcode = GL.GLVochCode
		GROUP BY 
			C.CustCode) S
	GROUP BY S.CustCode) NS ON (A.AccCode = NS.CustCode)
WHERE 
	S.SalesManCode IN (:ai_salesmancode) AND
	S.SalesManCode = C.SalesManCode AND
	C.CustCode = A.AccCode
GROUP BY
	C.SalesManCode,
	S.Name,
	A.AccCode,
	A.AliasName,
	A.Name,
	C.Address1,
	NS.SaleDate
ORDER BY salesman, customer"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_overduedays", number), ("ai_salesmancode", numberlist))
 sort="salesman A, customer A, aliasname A"
)
