detail(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(100) updatewhereclause=yes name=category dbname="Category"  )
column=(type=long updatewhereclause=yes name=count dbname="Count"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
 retrieve="SELECT 
	Category = VC.Name,
	Count = COUNT(H.GLVochCode),
	Amount = SUM(D.Debit)
FROM 
	GLHeader H, GLDetail D, VocherCategory VC
WHERE
	:as_category = 'A/c Vouchers' AND
	H.Posted = 'Y' AND
	H.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE() AND
	H.GLVochCode=D.GLVochCode AND
	H.VochCatCode = VC.VochCatCode
GROUP BY VC.Name
UNION ALL
SELECT 
	Category = CASE WHEN H.SaleCatCode=3 THEN 'Cash Sales' ELSE 'Credit Sales' END,
	Count = COUNT(H.SaleInvCode),
	Amount = SUM(H.InvTotal)
FROM 
	SaleLedger H
WHERE
	:as_category = 'Sales' AND
	H.Posted = 'Y' AND
	H.Date BETWEEN GETDATE() - :ai_days AND GETDATE()
GROUP BY H.SaleCatCode
UNION ALL
SELECT 
	Category = CASE WHEN H.SRCatCode=7 THEN 'Cash S/R' ELSE 'Credit S/R' END,
	Count = COUNT(H.SRInvCode),
	Amount = SUM(H.InvTotal)
FROM 
	SRLedger H
WHERE
	:as_category = 'S/R' AND
	H.Posted = 'Y' AND
	H.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE()
GROUP BY H.SRCatCode
UNION ALL
SELECT 
	Category = CASE WHEN H.PurTypeCode IS NULL THEN 'Un-Defined' ELSE (SELECT PT.Name FROM PurchaseType PT WHERE PT.PurTypeCode=H.PurTypeCode) END,
	Count = COUNT(H.PurInvCode),
	Amount = SUM(H.InvTotal)
FROM 
	PurLedger H
WHERE
	:as_category = 'Purchases' AND
	H.Posted = 'Y' AND
	H.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE()
GROUP BY H.PurTypeCode
UNION ALL
SELECT 
	Category = CASE WHEN H.PRTypeCode IS NULL THEN 'Un-Defined' ELSE (SELECT PT.Name FROM PurchaseType PT WHERE PT.PurTypeCode=H.PrTypeCode) END,
	Count = COUNT(H.PRInvCode),
	Amount = SUM(H.InvTotal)
FROM 
	PRLedger H
WHERE
	:as_category = 'P/R' AND
	H.Posted = 'Y' AND
	H.Date BETWEEN GETDATE() - :ai_days AND GETDATE()
GROUP BY H.PrTypeCode
UNION ALL
SELECT 
	Category = (SELECT C.Name FROM ReceiptCategory C WHERE C.ReceiptCategoryCode=H.ReceiptCategoryCode),
	Count = COUNT(H.ReceiptInvCode),
	Amount = SUM(D.Qty * D.Price)
FROM 
	ReceiptHeader H, ReceiptDetail D
WHERE
	:as_category = 'Receipts' AND
	H.Posted = 'Y' AND
	H.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE() AND
	H.ReceiptInvCode = D.ReceiptInvCode
GROUP BY H.ReceiptCategoryCode
UNION ALL
SELECT 
	Category = (SELECT C.Name FROM IssueCategory C WHERE C.IssueCategoryCode=H.IssueCategoryCode),
	Count = COUNT(H.IssueInvCode),
	Amount = SUM(D.Qty * D.Price)
FROM 
	IssueHeader H, IssueDetail D
WHERE
	:as_category = 'Issue' AND
	H.Posted = 'Y' AND
	H.Date BETWEEN GETDATE() - :ai_days AND GETDATE() AND
	H.IssueInvCode = D.IssueInvCode
GROUP BY H.IssueCategoryCode
UNION ALL
SELECT 
	Category = (SELECT T.Name FROM TransferType T WHERE T.TTCode=H.TTCode),
	Count = COUNT(H.TransCode),
	Amount = SUM(D.Qty * D.SalePrice)
FROM 
	THeader H, TDetail D
WHERE
	:as_category = 'G/Transfers' AND
	H.Posted = 'Y' AND
	H.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE() AND
	H.TransCode = D.TransCode 
GROUP BY H.TTCode
UNION ALL
SELECT 
	Category = ISNULL((SELECT A.Name FROM Accounts A WHERE A.AccCode=H.AccCode), 'Un-Defined'),
	Count = COUNT(H.AdjCode),
	Amount = SUM(D.LooseQty * D.Price)
FROM 	
	AdjHeader H, AdjDetail D
WHERE
	:as_category = 'Adj. Increase' AND
	H.Posted = 'Y' AND
	H.AdjCatCode=1 AND
	H.PostedDate BETWEEN GETDATE() - :ai_days AND GETDATE() AND
	H.AdjCode = D.AdjCode
GROUP BY H.AccCode
UNION ALL
SELECT 
	Category = ISNULL((SELECT A.Name FROM Accounts A WHERE A.AccCode=H.AccCode), 'Un-Defined'),
	Count = COUNT(H.AdjCode),
	Amount = SUM(D.LooseQty * D.Price)
FROM 	
	AdjHeader H, AdjDetail D
WHERE
	:as_category = 'Adj. Decrease' AND
	H.Posted = 'Y' AND
	H.AdjCatCode=2 AND
	H.Date BETWEEN GETDATE() - :ai_days AND GETDATE() AND
	H.AdjCode = D.AdjCode
GROUP BY H.AccCode
UNION ALL
SELECT 
	Category = (SELECT A.Name FROM Accounts A WHERE A.AccCode=H.BankAccCode),
	Count = COUNT(H.NoteCode),
	Amount = SUM(H.Amount)
FROM 	
	Notes H
WHERE
	:as_category = 'Chq/Receivables' AND
	H.Posted = 'Y' AND
	H.NoteCatCode=1 AND
	H.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE()
GROUP BY
	H.BankAccCode
UNION ALL
SELECT 
	Category = (SELECT A.Name FROM Accounts A WHERE A.AccCode=H.BankAccCode),
	Count = COUNT(H.NoteCode),
	Amount = SUM(H.Amount)
FROM 	
	Notes H
WHERE
	:as_category = 'Chq/Payables' AND
	H.Posted = 'Y' AND
	H.NoteCatCode=2 AND
	H.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE()
GROUP BY
	H.BankAccCode
UNION ALL
SELECT 
	Category = CASE WHEN H.ServiceCatCode=10 THEN 'Cash Service' ELSE 'Credit Service' END,
	Count = COUNT(H.ServiceInvCode),
	Amount = SUM(H.InvTotal)
FROM 
	ServiceHeader H
WHERE
	:as_category = 'Serivces Sale' AND
	H.Posted = 'Y' AND
	H.Date BETWEEN GETDATE() - :ai_days AND GETDATE()
GROUP BY H.ServiceCatCode
UNION ALL
SELECT 
	Category = CASE WHEN H.ServiceRCatCode=13 THEN 'Cash S/R' ELSE 'Credit S/R' END,
	Count = COUNT(H.ServiceRInvCode),
	Amount = SUM(H.InvTotal)
FROM 
	ServiceRHeader H
WHERE
	:as_category = 'Serivces S/R' AND
	H.Posted = 'Y' AND
	H.Date BETWEEN GETDATE() - :ai_days AND GETDATE()
GROUP BY H.ServiceRCatCode
UNION ALL
SELECT 
	Category = SC.Name,
	Count = COUNT(H.ServicePurInvCode),
	Amount = SUM(H.InvTotal)
FROM 
	ServicePurHeader H, Supplier S, SupplierCategory SC
WHERE
	:as_category = 'Serivces Pur' AND
	H.Posted = 'Y' AND
	H.Date BETWEEN GETDATE() - :ai_days AND GETDATE() AND
	H.SuppCode = S.SuppCode AND
	S.SuppCatCode = SC.SuppCatCode
GROUP BY SC.Name
UNION ALL
SELECT 
	Category = SC.Name,
	Count = COUNT(H.ServicePRInvCode),
	Amount = SUM(H.InvTotal)
FROM 
	ServicePRHeader H, Supplier S, SupplierCategory SC
WHERE
	:as_category = 'Serivces P/R' AND
	H.Posted = 'Y' AND
	H.Date BETWEEN GETDATE() - :ai_days AND GETDATE() AND
	H.SuppCode = S.SuppCode AND
	S.SuppCatCode = SC.SuppCatCode
GROUP BY SC.Name"
  arguments=(("as_Category", string), ("ai_days", number))
)
