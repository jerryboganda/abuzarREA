table(column=(type=char(15) updatewhereclause=yes name=transactiontype dbname="TransactionType"  )
column=(type=long updatewhereclause=yes name=transactioncount dbname="TransactionCount"  )
column=(type=decimal(2) updatewhereclause=yes name=transactionvalue dbname="TransactionValue"  )
 retrieve="SELECT 
	TransactionType = 'Sales',
	TransactionCount = COUNT(S.SaleInvCode),
	TransactionValue = SUM(S.InvTotal)
FROM
	SaleLedger S
WHERE 
	S.Posted='Y' AND S.Date BETWEEN GETDATE() - :ai_days AND GETDATE()
UNION ALL
SELECT 
	TransactionType = 'S/R',
	TransactionCount = COUNT(S.SRInvCode),
	TransactionValue = SUM(S.InvTotal)
FROM
	SRLedger S
WHERE 
	S.Posted='Y' AND S.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE()
UNION ALL
SELECT 
	TransactionType = 'Purchases',
	TransactionCount = COUNT(S.PURInvCode),
	TransactionValue = SUM(S.InvTotal)
FROM
	PURLedger S
WHERE 
	S.Posted='Y' AND S.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE()
UNION ALL
SELECT 
	TransactionType = 'P/R',
	TransactionCount = COUNT(S.PRInvCode),
	TransactionValue = SUM(S.InvTotal)
FROM
	PRLedger S
WHERE 
	S.Posted='Y' AND S.Date BETWEEN GETDATE() - :ai_days AND GETDATE()
UNION ALL
SELECT 
	TransactionType = 'Receipts',
	TransactionCount = COUNT(H.ReceiptInvCode),
	TransactionValue = SUM(D.Qty * D.Price)
FROM
	ReceiptHeader H, ReceiptDetail D 
WHERE 
	H.Posted='Y' AND H.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE() AND H.ReceiptInvCode=D.ReceiptInvCode
UNION ALL
SELECT 
	TransactionType = 'Issue',
	TransactionCount = COUNT(H.IssueInvCode),
	TransactionValue = SUM(D.Qty * D.Price)
FROM
	IssueHeader H, IssueDetail D
WHERE 
	H.Posted='Y' AND H.Date BETWEEN GETDATE() - :ai_days AND GETDATE() AND H.IssueInvCode=D.IssueInvCode
UNION ALL
SELECT 
	TransactionType = 'G/Transfers',
	TransactionCount = COUNT(H.TransCode),
	TransactionValue = SUM(D.Qty * D.SalePrice)
FROM
	THeader H, TDetail D
WHERE 
	H.Posted='Y' AND H.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE() AND H.TransCode=D.TransCode
UNION ALL
SELECT 
	TransactionType = 'Adj. Increase',
	TransactionCount = COUNT(H.AdjCode),
	TransactionValue = SUM(D.LooseQty * D.Price)
FROM
	AdjHeader H, AdjDetail D
WHERE 
	H.AdjCatCode=1 AND H.Posted='Y' AND H.PostedDate BETWEEN GETDATE() - :ai_days AND GETDATE() AND H.AdjCode=D.AdjCode
UNION ALL
SELECT 
	TransactionType = 'Adj. Decrease',
	TransactionCount = COUNT(H.AdjCode),
	TransactionValue = SUM(D.LooseQty * D.Price)
FROM
	AdjHeader H, AdjDetail D
WHERE 
	H.AdjCatCode=2 AND H.Posted='Y' AND H.PostedDate BETWEEN GETDATE() - :ai_days AND GETDATE() AND H.AdjCode=D.AdjCode
UNION ALL
SELECT 
	TransactionType = 'Chq/Receivables',
	TransactionCount = COUNT(H.NoteCode),
	TransactionValue = SUM(H.Amount)
FROM
	Notes H
WHERE 
	H.NoteCatCode=1 AND H.Posted='Y' AND H.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE()
UNION ALL
SELECT 
	TransactionType = 'Chq/Payables',
	TransactionCount = COUNT(H.NoteCode),
	TransactionValue = SUM(H.Amount)
FROM
	Notes H
WHERE 
	H.NoteCatCode=2 AND H.Posted='Y' AND H.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE()
UNION ALL
SELECT 
	TransactionType = 'Serivces Sale',
	TransactionCount = COUNT(H.ServiceInvCode),
	TransactionValue = SUM(H.InvTotal)
FROM
	ServiceHeader H
WHERE 
	H.Posted='Y' AND H.Date BETWEEN GETDATE() - :ai_days AND GETDATE()
UNION ALL
SELECT 
	TransactionType = 'Serivces S/R',
	TransactionCount = COUNT(H.ServiceRInvCode),
	TransactionValue = SUM(H.InvTotal)
FROM
	ServiceRHeader H
WHERE 
	H.Posted='Y' AND H.Date BETWEEN GETDATE() - :ai_days AND GETDATE()
UNION ALL
SELECT 
	TransactionType = 'Serivces Pur',
	TransactionCount = COUNT(H.ServicePurInvCode),
	TransactionValue = SUM(H.InvTotal)
FROM
	ServicePurHeader H
WHERE 
	H.Posted='Y' AND H.Date BETWEEN GETDATE() - :ai_days AND GETDATE()
UNION ALL
SELECT 
	TransactionType = 'Serivces P/R',
	TransactionCount = COUNT(H.ServicePRInvCode),
	TransactionValue = SUM(H.InvTotal)
FROM
	ServicePRHeader H
WHERE 
	H.Posted='Y' AND H.Date BETWEEN GETDATE() - :ai_days AND GETDATE()
UNION ALL
SELECT 
	TransactionType = 'A/c Vouchers',
	TransactionCount = COUNT(H.GLVochCode),
	TransactionValue = SUM(D.Debit)
FROM
	GLHeader H, GLDetail D
WHERE 
	H.Posted='Y' AND H.PostDate BETWEEN GETDATE() - :ai_days AND GETDATE() AND H.GLVochCode = D.GLVochCode
"
  arguments=(("ai_days", number))
)
