table(column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(6) updatewhereclause=yes name=value dbname="Value"  )
 retrieve="SELECT 
	Date = CAST(CONVERT(VARCHAR(100), H.Date, 101) AS DATETIME),
	Value = SUM(D.Qty * D.SalePrice)
FROM THeader H, TDetail D, Godown G
WHERE 
	H.TransCode = D.TransCode AND
	H.Date BETWEEN GETDATE() - :ai_days AND GETDATE() AND
	H.SGCode = G.GCode AND
	G.Name = :ai_category
GROUP BY
	CAST(CONVERT(VARCHAR(100), H.Date, 101) AS DATETIME)"
  arguments=(("ai_category", string), ("ai_days", number))
)
