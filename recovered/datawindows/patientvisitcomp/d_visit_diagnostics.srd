release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="VisitDiagnostics.VisitCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=diagnosticitemcode dbname="VisitDiagnostics.DiagnosticItemCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(1) updatewhereclause=yes name=selected dbname="Selected" 
 values="	Y/	N"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="VisitDiagnostics.RowID"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=diagnosticvalue dbname="VisitDiagnostics.DiagnosticValue"  )
column=(type=char(400) update=yes updatewhereclause=yes name=details dbname="VisitDiagnostics.Details"  )
 retrieve="SELECT 
	VisitCode, 
	DiagnosticItemCode, 
	Name = (SELECT Name FROM DiagnosticItem WHERE DiagnosticItem.DiagnosticItemCode = VisitDiagnostics.DiagnosticItemCode),
	Selected='Y',
	RowID,
	DiagnosticValue,
	Details
FROM 
	VisitDiagnostics
WHERE 	VisitDiagnostics.VisitCode = :ai_code
UNION ALL
SELECT 
	VisitCode=:ai_code, 
	DiagnosticItemCode, 
	Name,
	Selected='N',
	RowID=0,
	DiagnosticValue=0,
	Details=NULL

FROM 
	DiagnosticItem
WHERE 	DiagnosticItem.DiagnosticItemCode NOT IN (SELECT VisitDiagnostics.DiagnosticItemCode FROM VisitDiagnostics WHERE VisitDiagnostics.DiagnosticItemCode = :ai_code)
"
  update="VisitDiagnostics" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
 sort="name A"
)
