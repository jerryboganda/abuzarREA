 retrieve="SELECT 
	PatientCode,
	VisitCode,
	AdmissionCode,
	Date,
	Liver_Size,
	Liver_Parenchyma,
	Liver_Details,
	
	BileDuct_Size,
	BileDuct_PortalVein,
	BileDuct_Details,
	
	GB_Size,
	GB_Wall,
	GB_Details,
	
	Spleen_Size,
	Spleen_Parenchyma,
	Spleen_Details,
	
	Pancreas_Size,
	Pancreas_Parenchyma,
	Pancreas_PancreaticDuct,
	Pancreas_Details,
	
	LeftKidney_Size,
	LeftKidney_Parenchyma,
	LeftKidney_Details,
	
	RightKidney_Size,
	RightKidney_Parenchyma,
	RightKidney_Details,
	
	UrinaryBladder_Size,
	UrinaryBladder_Wall,
	UrinaryBladder_Details,
	
	GeneralFindings_Ascites,
	GeneralFindings_LMP,
	GeneralFindings_PER,
	GeneralFindings_PEL,
	GeneralFindings_Details,
	Comments
FROM
	DBO.ABD_US
WHERE VisitCode=:ai_code"
  update="DBO.ABD_US" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
