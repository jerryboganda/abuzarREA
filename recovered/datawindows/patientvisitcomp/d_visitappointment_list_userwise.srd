header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="VisitAppointment.AppointmentCode"  )
column=(type=long update=yes updatewhereclause=yes name=doctcode dbname="VisitAppointment.DoctCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="VisitAppointment.Date"  )
column=(type=long update=yes updatewhereclause=yes name=tokenno dbname="VisitAppointment.TokenNo"  )
column=(type=long update=yes updatewhereclause=yes name=appointmentmethodcode dbname="VisitAppointment.AppointmentMethodCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=appointmentstatuscode dbname="VisitAppointment.AppointmentStatusCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=colorvalue dbname="ColorValue"  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="Regno"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="VisitAppointment.PatientCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=referredby dbname="VisitAppointment.ReferredBy"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="VisitAppointment.Posted"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="VisitAppointment.UserCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="VisitAppointment.DueDate"  )
 retrieve="SELECT 
	PatientName = ISNULL((SELECT Patient.Name FROM Patient WHERE Patient.PatientCode = VisitAppointment.PatientCode), PatientDetails),
	AppointmentCode,
	DoctCode,
	Date,
	TokenNo,
	AppointmentMethodCode,
	AppointmentStatusCode,
	ColorValue = (SELECT APS.ColorValue FROM AppointmentStatus APS WHERE APS.AppointmentStatusCode = VisitAppointment.AppointmentStatusCode),
	Regno = (SELECT Patient.RegNo FROM Patient WHERE Patient.PatientCode = VisitAppointment.PatientCode),
	PatientCode,
	ReferredBy,
	Posted,
	UserCode,
	DueDate
FROM
	DBO.VisitAppointment
WHERE
	Posted = 'N' AND
	UserCode IN
		(Select 	Distinct U.usercode
		From   	Users U, UserGroups UG, GroupAllowedGroups GAG
		Where  	U.UserCode = UG.UserCode And UG.GroupCode = GAG.AllowedGroupCode And 
					GAG.GroupCode IN (SELECT UGS.GroupCode FROM UserGroups UGS WHERE UserCode =  :ai_usercode) And GAG.Module = 19
		Union 
		Select   U.Usercode
		From     Users U, UserGroups UG
		Where    U.usercode = UG.usercode And UG.GroupCode IN (SELECT UGS.GroupCode FROM UserGroups UGS WHERE UserCode =  :ai_usercode))
"
  update="DBO.VisitAppointment" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_usercode", number))
)
