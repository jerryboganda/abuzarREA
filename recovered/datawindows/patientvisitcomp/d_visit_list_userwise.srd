release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=code dbname="Visit.VisitCode"  )
column=(type=long updatewhereclause=yes name=appointmentcode dbname="AppointmentCode"  )
column=(type=long updatewhereclause=yes name=doctcode dbname="Visit.DoctCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=tokenno dbname="TokenNo"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Visit.Date"  )
column=(type=long updatewhereclause=yes name=visittypecode dbname="Visit.VisitTypeCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=visitstatuscode dbname="Visit.VisitStatusCode" 
 values=""  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="Regno"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="Visit.PatientCode"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Visit.Posted"  )
column=(type=long updatewhereclause=yes name=usercode dbname="Visit.UserCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=appointmentstatuscode dbname="AppointmentStatusCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=colorvalue dbname="ColorValue"  )
 retrieve="SELECT 
	VisitCode,
	AppointmentCode=AppointmentCode,
	DoctCode,
	TokenNo=(SELECT AP.TokenNo FROM VisitAppointment AP WHERE AP.AppointmentCode = Visit.AppointmentCode),
	Date,
	VisitTypeCode,
	VisitStatusCode,
	Regno = (SELECT Patient.RegNo FROM Patient WHERE Patient.PatientCode = Visit.PatientCode),
	PatientName = ISNULL((SELECT Patient.Name FROM Patient WHERE Patient.PatientCode = Visit.PatientCode), PatientDetails),
	PatientCode,
	Posted,
	UserCode,
	AppointmentStatusCode=(SELECT AP.AppointmentStatusCode FROM VisitAppointment AP WHERE AP.AppointmentCode = Visit.AppointmentCode),
	ColorValue = (SELECT APS.ColorValue  FROM VisitAppointment AP, AppointmentStatus APS  WHERE AP.AppointmentCode = Visit.AppointmentCode AND APS.AppointmentStatusCode = AP.AppointmentStatusCode)
FROM
	DBO.Visit
WHERE
	Visit.Date > :ad_visitdate AND
	UserCode IN
		(Select 	Distinct U.usercode
		From   	Users U, UserGroups UG, GroupAllowedGroups GAG
		Where  	U.UserCode = UG.UserCode And UG.GroupCode = GAG.AllowedGroupCode And 
					GAG.GroupCode IN (SELECT UGS.GroupCode FROM UserGroups UGS WHERE UserCode =  :ai_usercode) And GAG.Module = 20
		Union 
		Select   U.Usercode
		From     Users U, UserGroups UG
		Where    U.usercode = UG.usercode And UG.GroupCode IN (SELECT UGS.GroupCode FROM UserGroups UGS WHERE UserCode =  :ai_usercode))
"
  update="DBO.Visit" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_usercode", number), ("ad_visitdate", datetime))
)
