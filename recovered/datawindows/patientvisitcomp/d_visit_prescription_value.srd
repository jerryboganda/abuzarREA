release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=211 color="536870912" )
summary(height=64 color="536870912" )
footer(height=0 color="536870912" )
detail(height=70 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="VisitPrescription.VisitCode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="VisitPrescription.ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="VisitPrescription.Date"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=duration dbname="VisitPrescription.Duration"  )
column=(type=long update=yes updatewhereclause=yes name=diseasecode dbname="VisitPrescription.DiseaseCode"  )
column=(type=long update=yes updatewhereclause=yes name=dosagecode dbname="VisitPrescription.DosageCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=dosagefactor dbname="VisitPrescription.DosageFactor"  )
column=(type=long update=yes updatewhereclause=yes name=routecode dbname="VisitPrescription.RouteCode"  )
column=(type=long update=yes updatewhereclause=yes name=inscode dbname="VisitPrescription.InsCode"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="VisitPrescription.RowID"  )
column=(type=char(400) update=yes updatewhereclause=yes name=details dbname="VisitPrescription.Details"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=qty dbname="VisitPrescription.Qty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=bsa dbname="BSA"  )
column=(type=long updatewhereclause=yes initial="0" name=manualchangeintotqty dbname="ManualChangeInTotQty"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=dosageunitcode dbname="VisitPrescription.DosageUnitCode" 
 values=""  )
column=(type=char(60) update=yes updatewhereclause=yes initial="." name=dosagestrength dbname="VisitPrescription.DosageStrength"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=totalqty dbname="VisitPrescription.TotalQty"  )
 retrieve="SELECT 
	VisitPrescription.VisitCode,   
	VisitPrescription.ICode,   
	ItemName = (SELECT Item.Name FROM Item WHERE Item.ICode = VisitPrescription.ICode),
	VisitPrescription.Date,
	VisitPrescription.Duration,
	VisitPrescription.DiseaseCode,
	VisitPrescription.DosageCode,
	VisitPrescription.DosageFactor,
	VisitPrescription.RouteCode,
	VisitPrescription.InsCode,
	VisitPrescription.RowID,   
	VisitPrescription.Details,
	VisitPrescription.Qty,
	BSA= (SELECT VV.BSA FROM VisitVitals VV WHERE VV.VisitCode=:ai_code),
	ManualChangeInTotQty = 0,
	VisitPrescription.DosageUnitCode,
	VisitPrescription.DosageStrength,
	Rate = 0.00,
	VisitPrescription.TotalQty
FROM 
	VisitPrescription  
WHERE 
	VisitPrescription.VisitCode = :ai_code
ORDER BY 
	VisitPrescription.VisitCode ASC,   
	VisitPrescription.RowID ASC"
  update="VisitPrescription" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
