column=(type=long update=yes updatewhereclause=yes name=inscode dbname="VisitPrescription.InsCode"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="VisitPrescription.RowID"  )
column=(type=char(400) update=yes updatewhereclause=yes name=details dbname="VisitPrescription.Details"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=qty dbname="VisitPrescription.Qty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=bsa dbname="BSA"  )
column=(type=long updatewhereclause=yes initial="0" name=manualchangeintotqty dbname="ManualChangeInTotQty"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=dosageunitcode dbname="VisitPrescription.DosageUnitCode" 
 values=""  )
column=(type=char(60) update=yes updatewhereclause=yes initial="." name=dosagestrength dbname="VisitPrescription.DosageStrength"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=totalqty dbname="VisitPrescription.TotalQty"  )
 retrieve="SELECT 
	VisitPrescription.VisitCode,   
	VisitDate=Visit.Date,
	Diagnosis=Visit.Diagnosis,
	PatientName=(SELECT P.Name + '(' + P.RegNo + ')' FROM Patient P WHERE P.PatientCode=:ai_code),
	PreviousDiagnosis=Visit.PreviousDiagnosis,
	Recommendations=Visit.Recommendations,
	VisitPrescription.ICode,   
	ItemName = (SELECT Item.Name FROM Item WHERE Item.ICode = VisitPrescription.ICode),
	PrescriptionDate=VisitPrescription.Date,
	VisitPrescription.Duration,
	VisitPrescription.DiseaseCode,
	VisitPrescription.DosageCode,
	VisitPrescription.DosageFactor,
	VisitPrescription.RouteCode,
	VisitPrescription.InsCode,
	VisitPrescription.RowID,   
	VisitPrescription.Details,
	VisitPrescription.Qty,
	BSA= (SELECT VV.BSA FROM VisitVitals VV WHERE VV.VisitCode=Visit.VisitCode),
	ManualChangeInTotQty = 0,
	VisitPrescription.DosageUnitCode,
	VisitPrescription.DosageStrength,
	VisitPrescription.TotalQty
FROM 
	VisitPrescription, Visit
WHERE 
	Visit.PatientCode = :ai_code AND
	Visit.VisitCode = VisitPrescription.VisitCode
"
  arguments=(("ai_code", number))
 sort="code A, visitdate A, rowid A"
)
