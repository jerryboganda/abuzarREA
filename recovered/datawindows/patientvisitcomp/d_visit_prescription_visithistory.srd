table(column=(type=long update=yes updatewhereclause=yes name=code dbname="VisitPrescription.VisitCode"  )
column=(type=datetime updatewhereclause=yes name=visitdate dbname="VisitDate"  )
column=(type=char(400) updatewhereclause=yes name=diagnosis dbname="Diagnosis"  )
column=(type=char(112) updatewhereclause=yes name=patientname dbname="PatientName"  )
