table(column=(type=long updatewhereclause=yes name=visitcode dbname="VisitCode"  )
column=(type=datetime updatewhereclause=yes name=visitdate dbname="VisitDate"  )
column=(type=char(60) updatewhereclause=yes name=visittype dbname="VisitType"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=char(113) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(1) updatewhereclause=yes name=patientgender dbname="PatientGender" 
 values="Male	M/Female	F/"  )
column=(type=char(30) updatewhereclause=yes name=patientphone dbname="PatientPhone"  )
column=(type=long updatewhereclause=yes name=age dbname="Age"  )
column=(type=char(33) updatewhereclause=yes name=height dbname="Height"  )
column=(type=char(33) updatewhereclause=yes name=weight dbname="Weight"  )
column=(type=char(10) updatewhereclause=yes name=pulserate dbname="PulseRate"  )
column=(type=char(10) updatewhereclause=yes name=respirationrate dbname="RespirationRate"  )
column=(type=char(100) updatewhereclause=yes name=spo2 dbname="SPO2"  )
column=(type=char(16) updatewhereclause=yes name=temperature dbname="Temperature"  )
column=(type=char(21) updatewhereclause=yes name=bp dbname="BP"  )
column=(type=char(400) updatewhereclause=yes name=previousdiagnosis dbname="PreviousDiagnosis"  )
column=(type=long updatewhereclause=yes name=doctorcode dbname="DoctorCode"  )
column=(type=char(400) updatewhereclause=yes name=diagnosis dbname="Diagnosis"  )
column=(type=char(400) updatewhereclause=yes name=recommendations dbname="Recommendations"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=datetime updatewhereclause=yes name=followupdate dbname="FollowUpDate"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=char(100) updatewhereclause=yes name=title1 dbname="Title1"  )
column=(type=char(100) updatewhereclause=yes name=title2 dbname="Title2"  )
column=(type=char(100) updatewhereclause=yes name=title3 dbname="Title3"  )
column=(type=char(100) updatewhereclause=yes name=title4 dbname="Title4"  )
column=(type=char(100) updatewhereclause=yes name=footer1 dbname="Footer1"  )
column=(type=char(100) updatewhereclause=yes name=footer2 dbname="Footer2"  )
column=(type=char(100) updatewhereclause=yes name=footer3 dbname="Footer3"  )
column=(type=char(100) updatewhereclause=yes name=footer4 dbname="Footer4"  )
column=(type=long updatewhereclause=yes name=dm dbname="DM" 
 values="DM	1/DM	0/"  )
column=(type=long updatewhereclause=yes name=htn dbname="HTN" 
 values="HTN	1/HTN	0/"  )
column=(type=long updatewhereclause=yes name=smoking dbname="Smoking" 
 values="Smoking	1/Smoking	0/"  )
column=(type=long updatewhereclause=yes name=obesity dbname="Obesity" 
 values="Obesity	1/Obesity	0/"  )
column=(type=long updatewhereclause=yes name=familyhistory dbname="FamilyHistory" 
 values="Family History	1/Family History	0/"  )
column=(type=long updatewhereclause=yes name=copd dbname="COPD" 
 values="COPD	1/COPD	0/"  )
column=(type=long updatewhereclause=yes name=asthma dbname="ASTHMA" 
 values="Asthma	1/Asthma	0/"  )
column=(type=long updatewhereclause=yes name=cua dbname="CUA" 
 values="CVA	1/CVA	0/"  )
column=(type=long updatewhereclause=yes name=ckd dbname="CKD" 
 values="CKD	1/CKD	0/"  )
column=(type=long updatewhereclause=yes name=alergy dbname="Alergy" 
 values="Alergy	1/Alergy	0/"  )
column=(type=blob updatewhereclause=yes name=blob_1 dbname="Signature"  )
 retrieve="SELECT 
	VisitCode = V.VisitCode,
	VisitDate = V.Date, 
	VisitType = (SELECT VT.Name FROM VisitType VT WHERE VT.VisitTypeCode = V.VisitTypeCode),
	PatientRegNo = P.RegNo,
	PatientName = CASE V.PatientCode WHEN NULL THEN V.PatientDetails ELSE LTRIM(RTRIM(P.Name)) + ' (' + LTRIM(RTRIM(P.RegNo)) + ')' END,
	PatientGender = P.Gender,
	PatientPhone = P.Phone,
	Age = DATEDIFF(YYYY, P.DOB, V.Date),
	Height = LTRIM(RTRIM(STR(VV.Height1))) + ' ' + VV.HeightUnit1 + ' ' + LTRIM(RTRIM(STR(ISNULL(VV.Height2,'0')))) + ' ' + VV.HeightUnit2,
	Weight = LTRIM(RTRIM(STR(VV.Weight1))) + ' ' + VV.WeightUnit1 + ' ' + LTRIM(RTRIM(STR(ISNULL(VV.Weight2, '0')))) + ' ' + VV.WeightUnit2,
	PulseRate = LTRIM(RTRIM(STR(VV.PulseRate))),
	RespirationRate = LTRIM(RTRIM(STR(VV.Respiration))),
	SPO2 = VV.SPO2,
	Temperature = LTRIM(RTRIM(STR(VV.TemperatureValue))) + ' ' + LTRIM(RTRIM(VV.TemperatureUnit)),
	BP = LTRIM(RTRIM(STR(VV.BloodPressureSysTolic))) + '/' + LTRIM(RTRIM(STR(VV.BloodPressureDiaSTolic))),
	PreviousDiagnosis = V.PreviousDiagnosis,
	DoctorCode = V.DoctCode,
	Diagnosis = V.Diagnosis,
	Recommendations = V.Recommendations,
	Remarks = V.Remarks,
	FollowUpDate = V.Date + V.FollowUpDays,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = V.DoctCode),
	Title1 = (SELECT D.Title1 FROM Doctors D WHERE D.DoctCode = V.DoctCode),
	Title2 = (SELECT D.Title2 FROM Doctors D WHERE D.DoctCode = V.DoctCode),
	Title3 = (SELECT D.Title3 FROM Doctors D WHERE D.DoctCode = V.DoctCode),
	Title4 = (SELECT D.Title4 FROM Doctors D WHERE D.DoctCode = V.DoctCode),
	Footer1 = (SELECT D.Footer1 FROM Doctors D WHERE D.DoctCode = V.DoctCode),
	Footer2 = (SELECT D.Footer2 FROM Doctors D WHERE D.DoctCode = V.DoctCode),
	Footer3 = (SELECT D.Footer3 FROM Doctors D WHERE D.DoctCode = V.DoctCode),
	Footer4 = (SELECT D.Footer4 FROM Doctors D WHERE D.DoctCode = V.DoctCode),
	DM = ISNULL((SELECT 1 FROM VisitPrecaution VP WHERE VP.VisitCode = V.VisitCode AND VP.PrecautionCode = 1), 0),
	HTN = ISNULL((SELECT 1 FROM VisitPrecaution VP WHERE VP.VisitCode = V.VisitCode AND VP.PrecautionCode = 2), 0),
	Smoking = ISNULL((SELECT 1 FROM VisitPrecaution VP WHERE VP.VisitCode = V.VisitCode AND VP.PrecautionCode = 3), 0),
	Obesity = ISNULL((SELECT 1 FROM VisitPrecaution VP WHERE VP.VisitCode = V.VisitCode AND VP.PrecautionCode = 4), 0),
	FamilyHistory = ISNULL((SELECT 1 FROM VisitPrecaution VP WHERE VP.VisitCode = V.VisitCode AND VP.PrecautionCode = 5), 0),

	COPD = ISNULL((SELECT 1 FROM VisitPrecaution VP WHERE VP.VisitCode = V.VisitCode AND VP.PrecautionCode = 6), 0),
	ASTHMA = ISNULL((SELECT 1 FROM VisitPrecaution VP WHERE VP.VisitCode = V.VisitCode AND VP.PrecautionCode = 7), 0),
	CUA = ISNULL((SELECT 1 FROM VisitPrecaution VP WHERE VP.VisitCode = V.VisitCode AND VP.PrecautionCode = 8), 0),
	CKD = ISNULL((SELECT 1 FROM VisitPrecaution VP WHERE VP.VisitCode = V.VisitCode AND VP.PrecautionCode = 9), 0),
	Alergy = ISNULL((SELECT 1 FROM VisitPrecaution VP WHERE VP.VisitCode = V.VisitCode AND VP.PrecautionCode = 10), 0)
FROM
	Visit V
	LEFT OUTER JOIN Patient AS P ON (V.PatientCode = P.PatientCode),
	VisitVitals VV
WHERE
	V.VisitCode = :ai_code AND
	V.VisitCode = VV.VisitCode"
  arguments=(("ai_code", number))
)
