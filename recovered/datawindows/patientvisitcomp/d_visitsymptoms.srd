header(height=68 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=280 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="VisitSymptoms.VisitCode"  )
column=(type=long update=yes updatewhereclause=yes name=symptomcode dbname="VisitSymptoms.SymptomCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=severitylevelcode dbname="VisitSymptoms.SeverityLevelCode" 
 values=""  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="VisitSymptoms.RowID"  )
column=(type=char(255) update=yes updatewhereclause=yes name=details dbname="VisitSymptoms.Details"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=duration dbname="VisitSymptoms.Duration"  )
 retrieve="SELECT 
	VisitSymptoms.VisitCode,   
	VisitSymptoms.SymptomCode,   
	ItemName = (SELECT Symptom.Name FROM Symptom WHERE Symptom.SymptomCode = VisitSymptoms.SymptomCode),
	VisitSymptoms.SeverityLevelCode,
	VisitSymptoms.RowID,   
	VisitSymptoms.Details,   
	VisitSymptoms.Duration
FROM 
	VisitSymptoms  
WHERE 
	VisitSymptoms.VisitCode = :ai_code
ORDER BY 
	VisitSymptoms.VisitCode ASC,   
	VisitSymptoms.RowID ASC
"
  update="VisitSymptoms" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
