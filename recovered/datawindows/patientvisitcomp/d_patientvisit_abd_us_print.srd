column=(type=char(1000) update=yes updatewhereclause=yes initial="Normal Abdominal Ultrasound Report " name=comments dbname="ABD_US.Comments"  )
 retrieve="SELECT 
	PatientCode,
	VisitCode,
	AdmissionCode,

	PatientRegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = ABD_US.PatientCode),
	PatientName = (SELECT P.Name + ' (' + P.RegNo + ')' FROM Patient P WHERE P.PatientCode = ABD_US.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(DATEDIFF(YYYY, P.DOB, ABD_US.Date),10))) + 'Y/' + P.Gender FROM Patient P WHERE P.PatientCode = ABD_US.PatientCode),

	Date,
	Liver_Size,
	Liver_Parenchyma,
	Liver_Details,
	
	BileDuct_Size,
	BileDuct_PortalVein,
	BileDuct_Details,
	
	GB_Size,
	GB_Wall,
	GB_Details,
	
	Spleen_Size,
	Spleen_Parenchyma,
	Spleen_Details,
	
	Pancreas_Size,
	Pancreas_Parenchyma,
	Pancreas_PancreaticDuct,
	Pancreas_Details,
	
	LeftKidney_Size,
	LeftKidney_Parenchyma,
	LeftKidney_Details,
	
	RightKidney_Size,
	RightKidney_Parenchyma,
	RightKidney_Details,
	
	UrinaryBladder_Size,
	UrinaryBladder_Wall,
	UrinaryBladder_Details,
	
	GeneralFindings_Ascites,
	GeneralFindings_LMP,
	GeneralFindings_PER,
	GeneralFindings_PEL,
	GeneralFindings_Details,
	Comments
FROM
	DBO.ABD_US
WHERE VisitCode=:ai_code"
  arguments=(("ai_code", number))
)
