column=(type=char(500) update=yes updatewhereclause=yes initial="Normal Bile Duct and Portal Vein" name=bileduct_details dbname="ABD_US.BileDuct_Details"  )
column=(type=char(60) update=yes updatewhereclause=yes initial="Normal" name=gb_size dbname="ABD_US.GB_Size"  )
