column=(type=char(60) update=yes updatewhereclause=yes initial="Normal" name=rightkidney_parenchyma dbname="ABD_US.RightKidney_Parenchyma"  )
column=(type=char(500) update=yes updatewhereclause=yes initial="Right Kidney Normal (No stone, hydronephrosis OR focal lesion seen)" name=rightkidney_details dbname="ABD_US.RightKidney_Details"  )
