column=(type=char(60) update=yes updatewhereclause=yes initial="NIL" name=generalfindings_per dbname="ABD_US.GeneralFindings_PER"  )
column=(type=char(60) update=yes updatewhereclause=yes initial="NIL" name=generalfindings_pel dbname="ABD_US.GeneralFindings_PEL"  )
