 retrieve="SELECT 
	PatientCode,
	VisitCode,
	AdmissionCode,
	Date,
	
	Uterus_Size_L,
	Uterus_Size_W,
	Uterus_Size_T,
	Uterus_Detail,
	Uterus_Appearance,
	Uterus_Endometrium,
	Uterus_Fibroid,
	Uterus_Details,
	
	RtOv_Size_L,
	RtOv_Size_W,
	RtOv_Size_T,
	RtOv_Size,
	RtOv_Appearance,
	RtOv_Details,
	
	LtOv_Size_L,
	LtOv_Size_W,
	LtOv_Size_T,
	LtOv_Size,
	LtOv_Appearance,
	LtOv_Details,
	
	POD,
	OTHER,
	Comments
FROM
	DBO.GYN_US
WHERE VisitCode=:ai_code"
  update="DBO.GYN_US" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
