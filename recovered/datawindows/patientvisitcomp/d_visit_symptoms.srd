header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="VisitSymptoms.VisitCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=symptomcode dbname="VisitSymptoms.SymptomCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(1) updatewhereclause=yes name=selected dbname="Selected" 
 values="	Y/	N"  )
column=(type=long update=yes updatewhereclause=yes name=severitylevelcode dbname="VisitSymptoms.SeverityLevelCode" 
 values=""  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="VisitSymptoms.RowID"  )
column=(type=long update=yes updatewhereclause=yes name=duration dbname="VisitSymptoms.Duration"  )
column=(type=char(400) update=yes updatewhereclause=yes name=details dbname="VisitSymptoms.Details"  )
 retrieve="SELECT 
	VisitCode, 
	SymptomCode, 
	Name = (SELECT Name FROM Symptom WHERE Symptom.SymptomCode = VisitSymptoms.SymptomCode),
	Selected = 'Y',
	SeverityLevelCode, 
	RowID, 
	Duration, 
	Details 
FROM 
	VisitSymptoms
WHERE 
	VisitSymptoms.VisitCode = :ai_code
UNION ALL
SELECT 
	VisitCode=:ai_code, 
	SymptomCode, 
	Name,
	Selected = 'N',
	SeverityLevelCode=1, 
	RowID=0, 
	Duration=1, 
	Details=NULL 
FROM 
	Symptom
WHERE 
	Symptom.SymptomCode NOT IN (SELECT VisitSymptoms.SymptomCode FROM VisitSymptoms WHERE VisitSymptoms.VisitCode = :ai_code)
ORDER BY Name"
  update="VisitSymptoms" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
 sort="name A"
)
