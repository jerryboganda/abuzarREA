release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1385 color="536870912" )
summary(height=218 color="536870912" )
footer(height=1062 color="536870912" )
detail(height=1656 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=datetime updatewhereclause=yes initial="today" name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=long updatewhereclause=yes name=tokenno dbname="TokenNo"  )
column=(type=char(100) updatewhereclause=yes name=patientdetails dbname="PatientDetails"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(400) updatewhereclause=yes name=comments dbname="Comments"  )
column=(type=char(100) updatewhereclause=yes name=referredby dbname="ReferredBy"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Regno"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(1) updatewhereclause=yes initial="M" name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(60) updatewhereclause=yes name=fname dbname="Fname"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode" 
 values=""  )
column=(type=long updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Please Enter Valid Age'" name=age dbname="Age"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="DueDate"  )
 retrieve="SELECT  
	Code = VA.AppointmentCode,
	Date=VA.date,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = VA.DoctCode),
	TokenNo=VA.TokenNo,
	PatientDetails=VA.PatientDetails,
	Remarks = VA.Remarks,
	Comments = VA.Comments,
	ReferredBy = VA.ReferredBy,
	UserCode=VA.Usercode,
	PatientCode = P.Patientcode,
	Regno = P.Regno,
	Name = P.name ,
	Gender = P.gender,
	Fname = P.fname,
	custcode=P.custcode,
	Age=DATEDIFF(YYYY, DOB, GETDATE()),
	DueDate = VA.DueDate
FROM visitappointment VA LEFT OUTER JOIN patient AS P ON (VA.PatientCode = P.PatientCode)
WHERE 
	VA.AppointmentCode = :ra_code
	"
  arguments=(("ra_code", number))
)
