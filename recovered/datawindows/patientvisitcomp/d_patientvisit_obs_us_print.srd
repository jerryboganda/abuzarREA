column=(type=char(1000) update=yes updatewhereclause=yes initial="Normal" name=comments dbname="OBS_US.Comments"  )
 retrieve="SELECT
	OBS_US.PatientCode,
	OBS_US.VisitCode, 
	OBS_US.AdmissionCode,   
	OBS_US.Date,   

	PatientRegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = OBS_US.PatientCode),
	PatientName = (SELECT P.Name + ' (' + P.RegNo + ')' FROM Patient P WHERE P.PatientCode = OBS_US.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(DATEDIFF(YYYY, P.DOB, OBS_US.Date),10))) + 'Y/' + P.Gender FROM Patient P WHERE P.PatientCode = OBS_US.PatientCode),

	OBS_US.LMP,   
	OBS_US.LMPDetails,   
	OBS_US.EDD,   
	OBS_US.Gestation,   
	OBS_US.Viability_Seen_FH,   
	OBS_US.Viability_Seen_FM,   
	OBS_US.Viability_NotSeen_FH,   
	OBS_US.Viability_NotSeen_FM,   
	OBS_US.Presentation,   
	OBS_US.Lie,   
	OBS_US.Placenta,   
	OBS_US.Previa_Type,   
	OBS_US.AmnioticFluid,   
	OBS_US.FetalMorph_CNS_POC,   
	OBS_US.FetalMorph_CNS_POO,   
	OBS_US.FetalMorph_CNS_NormalSpine,   
	OBS_US.FetalMorph_Chest_FCV,   
	OBS_US.FetalMorph_Chest_AOA,   
	OBS_US.FetalMorph_Chest_CM,   
	OBS_US.FetalMorph_Abdomen_Stomach,   
	OBS_US.FetalMorph_Abdomen_Kidneys,   
	OBS_US.FetalMorph_Abdomen_Bladder,   
	OBS_US.FetalMorph_UmbilicalCord,   
	OBS_US.Biometry_DOGS,   
	OBS_US.Biometry_BPD,   
	OBS_US.Biometry_GestationAge,   
	OBS_US.Biometry_CRL,   
	OBS_US.Biometry_FemurLength,   
	OBS_US.Biometry_Details,   
	OBS_US.Comments  
FROM OBS_US
WHERE 
	OBS_US.VisitCode = :ai_code"
  arguments=(("ai_code", number))
)
