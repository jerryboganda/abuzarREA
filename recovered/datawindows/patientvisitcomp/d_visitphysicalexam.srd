footer(height=0 color="536870912" )
detail(height=272 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="VisitPhysicalExam.VisitCode"  )
column=(type=long update=yes updatewhereclause=yes name=physicalexamcode dbname="VisitPhysicalExam.PhysicalExamCode"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="VisitPhysicalExam.RowID"  )
column=(type=char(255) update=yes updatewhereclause=yes name=details dbname="VisitPhysicalExam.Details"  )
column=(type=char(73) updatewhereclause=yes name=itemname dbname="ItemName"  )
 retrieve="  SELECT VisitPhysicalExam.VisitCode,   
         VisitPhysicalExam.PhysicalExamCode,   
         VisitPhysicalExam.RowID,
         VisitPhysicalExam.Details,
			ItemName = (SELECT PhysicalExam.Name + ' (' + ltrim(rtrim(str(PhysicalExam.PhysicalExamCode))) + ')' FROM PhysicalExam WHERE PhysicalExam.PhysicalExamCode = VisitPhysicalExam.PhysicalExamCode)
    FROM VisitPhysicalExam  
   WHERE VisitPhysicalExam.VisitCode = :ai_code   
ORDER BY  VisitPhysicalExam.RowID
"
  update="VisitPhysicalExam" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
