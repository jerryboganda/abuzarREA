 values=""  )
column=(type=char(60) update=yes updatewhereclause=yes name=dosagestrength dbname="DosageStrength"  )
column=(type=char(100) update=yes updatewhereclause=yes name=details dbname="Details"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=long updatewhereclause=yes name=manualchangeintotqty dbname="ManualChangeInTotQty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="REAL(GetText()) > 0" validationmsg="'Please enter valid total qty'" initial="1" name=totalqty dbname="TotalQty"  )
 retrieve="SELECT 
	DiseaseTreatmentTempDetail.DiseaseTreatmentTempCode,   
	DiseaseTreatmentTempDetail.ICode,   
	ItemCode = 0,
	fullcode = item.customicode,
	itemname = item.name,
	currlistrow = 0,
	stock     = 0.0000,
	totalstock= isnull((select sum(gd.currqty) from godowndetail gd where gd.icode=item.icode), 0), 
	Qty = DiseaseTreatmentTempDetail.Qty,   
	DosageCode=DiseaseTreatmentTempDetail.DosageCode,   
	DosageFactor=DiseaseTreatmentTempDetail.DosageFactor,   
	RouteCode=DiseaseTreatmentTempDetail.RouteCode,   
	Duration=DiseaseTreatmentTempDetail.Duration,   
	InsCode=DiseaseTreatmentTempDetail.InsCode,   
	DosageUnitCode=DiseaseTreatmentTempDetail.DosageUnitCode,   
	DosageStrength=DiseaseTreatmentTempDetail.DosageStrength,   
	Details=DiseaseTreatmentTempDetail.Details,   
	RowID = DiseaseTreatmentTempDetail.RowID,
	ManualChangeInTotQty = 0,
	TotalQty=DiseaseTreatmentTempDetail.TotalQty
FROM 
	DiseaseTreatmentTempDetail, Item
WHERE 
	DiseaseTreatmentTempDetail.DiseaseTreatmentTempCode = :ai_code AND
	DiseaseTreatmentTempDetail.ICode = Item.ICode
ORDER BY 
	DiseaseTreatmentTempDetail.DiseaseTreatmentTempCode ASC,   
	DiseaseTreatmentTempDetail.RowID ASC   
"
  update="DiseaseTreatmentTempDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
