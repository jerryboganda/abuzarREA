table(column=(type=long updatewhereclause=yes name=type dbname="TYPE"  )
column=(type=char(20) updatewhereclause=no name=typedesc dbname="TypeDesc"  )
column=(type=long updatewhereclause=yes name=visitcode dbname="VisitCode"  )
column=(type=char(274) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=dosageqty dbname="DosageQty"  )
column=(type=char(400) updatewhereclause=yes name=dosageunit dbname="DosageUnit"  )
column=(type=long updatewhereclause=yes name=localdosageunit dbname="LocalDosageUnit"  )
column=(type=char(60) updatewhereclause=yes name=dosagestrength dbname="DosageStrength"  )
column=(type=char(60) updatewhereclause=yes name=dosagefreq dbname="DosageFreq"  )
column=(type=char(499) updatewhereclause=yes name=localdosage dbname="LocalDosage"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=long updatewhereclause=yes name=duration dbname="Duration"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=char(60) updatewhereclause=no name=disease dbname="Disease"  )
column=(type=char(400) updatewhereclause=yes name=details dbname="Details"  )
 retrieve="SELECT 
	TYPE = 1,
	TypeDesc = 'Drug Name and Dosage',
	VisitCode = V.VisitCode,
	ItemName = LTRIM(RTRIM(ISNULL((SELECT DU.Name FROM DosageUnit DU WHERE DU.DosageUnitCode = VP.DosageUnitCode),'') + ' ' + (SELECT I.Name + ' (' + GI.Name + ')' FROM Item I, GenericItem GI WHERE VP.ICode = I.ICode AND GI.GenericCode = I.GenericCode))),
	DosageQty = VP.Qty,
	DosageUnit = NULL,
	LocalDosageUnit = NULL,/*(SELECT DU.LocalDosageUnit FROM DosageUnit DU WHERE DU.DosageUnitCode = VP.DosageUnitCode),*/
	DosageStrength = VP.DosageStrength,
	DosageFreq = (SELECT D.Name FROM Dosage D WHERE D.DosageCode = VP.DosageCode),
	LocalDosage = (SELECT D.LocalDosage FROM Dosage D WHERE D.DosageCode = VP.DosageCode),
	RowID = VP.RowID,
	Duration = VP.Duration,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = V.DoctCode),
	Disease = (SELECT D.Name FROM Disease D WHERE D.DiseaseCode = VP.DiseaseCode),
	Details = VP.Details 
FROM
	Visit V
	LEFT OUTER JOIN VisitPrescription AS VP ON (V.VisitCode = VP.VisitCode)
WHERE
	V.VisitCode = :ai_code
UNION ALL
SELECT 
	TYPE = 2,
	TypeDesc = 'Precausions',
	VisitCode = VisitPrecaution.VisitCode,
	ItemName = Precaution.Name,
	DosageQty = 0,
	DosageUnit = NULL,
	LocalDosageUnit = NULL,   
	DosageStrength = NULL,
	DosageFreq = NULL,
	LocalDosage = Precaution.LocalPrecaution, 
	RowID = NULL,
	Duration = NULL,
	Doctor = NULL,
	Disease = NULL,
	Details = NULL
FROM Precaution,   
	VisitPrecaution  
WHERE ( VisitPrecaution.PrecautionCode = Precaution.PrecautionCode ) and  
	( VisitPrecaution.VisitCode = :ai_code )
UNION ALL
SELECT 
	TYPE = 3,
	TypeDesc = 'Test Recommedations',
	VisitCode = VisitDiagnostics.VisitCode,
	ItemName = DiagnosticItem.Name,
	DosageQty = 0,
	DosageUnit = (SELECT MAX(Visit.Recommendations) FROM Visit WHERE Visit.VisitCode = :ai_code),
	LocalDosageUnit = NULL,   
	DosageStrength = NULL,
	DosageFreq = NULL,
	LocalDosage = NULL,
	RowID = NULL,
	Duration = NULL,
	Doctor = NULL,
	Disease = NULL,
	Details = NULL
FROM DiagnosticItem,   
	VisitDiagnostics
WHERE VisitDiagnostics.DiagnosticItemCode = DiagnosticItem.DiagnosticItemCode  AND 
	VisitDiagnostics.VisitCode = :ai_code
UNION ALL
SELECT 
	TYPE = 4,
	TypeDesc = 'Clinical Diagnosis',
	VisitCode = VS.VisitCode,
	ItemName = S.Name,
	DosageQty = 0,
	DosageUnit = NULL,
	LocalDosageUnit = NULL,   
	DosageStrength = NULL,
	DosageFreq = NULL,
	LocalDosage = (SELECT SL.Name FROM SeverityLevel SL WHERE VS.SeverityLevelCode = SL.SeverityLevelCode) + ' - ' + VS.Details,
	RowID = VS.RowID, 
	Duration = VS.Duration,
	Doctor = NULL,
	Disease = NULL,
	Details = NULL
FROM 
	VisitSymptoms VS, Symptom S
WHERE 
	VS.VisitCode = :ai_code AND
	S.SymptomCode = VS.SymptomCode
UNION ALL
SELECT 
	TYPE = 5,
	TypeDesc = 'Physical Examination',
	VisitCode = VP.VisitCode,
	ItemName = PE.Name,
	DosageQty = 0,
	DosageUnit = NULL,
	LocalDosageUnit = NULL,   
	DosageStrength = NULL,
	DosageFreq = NULL,
	LocalDosage = VP.Details,
	RowID = VP.RowID, 
	Duration = NULL,
	Doctor = NULL,
	Disease = NULL,
	Details = NULL
FROM 
	VisitPhysicalExam VP, PhysicalExam PE
WHERE 
	VP.VisitCode = :ai_code AND
	VP.PhysicalExamCode = PE.PhysicalExamCode
"
  arguments=(("ai_code", number))
 sort="type A, rowid A"
)
