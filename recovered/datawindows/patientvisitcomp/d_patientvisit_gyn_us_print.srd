 values=""  )
column=(type=char(1000) update=yes updatewhereclause=yes initial="Normal" name=ltov_details dbname="GYN_US.LtOv_Details"  )
column=(type=char(1000) update=yes updatewhereclause=yes initial="Clear" name=pod dbname="GYN_US.POD"  )
column=(type=char(1000) update=yes updatewhereclause=yes initial="Normal" name=other dbname="GYN_US.OTHER"  )
column=(type=char(1000) update=yes updatewhereclause=yes initial="Normal Study" name=comments dbname="GYN_US.Comments"  )
 retrieve="SELECT 
	PatientCode,
	VisitCode,
	AdmissionCode,
	Date,

	PatientRegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = GYN_US.PatientCode),
	PatientName = (SELECT P.Name + ' (' + P.RegNo + ')' FROM Patient P WHERE P.PatientCode = GYN_US.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(DATEDIFF(YYYY, P.DOB, GYN_US.Date),10))) + 'Y/' + P.Gender FROM Patient P WHERE P.PatientCode = GYN_US.PatientCode),
	
	Uterus_Size_L,
	Uterus_Size_W,
	Uterus_Size_T,
	Uterus_Detail,
	Uterus_Appearance,
	Uterus_Endometrium,
	Uterus_Fibroid,
	Uterus_Details,
	
	RtOv_Size_L,
	RtOv_Size_W,
	RtOv_Size_T,
	RtOv_Size,
	RtOv_Appearance,
	RtOv_Details,
	
	LtOv_Size_L,
	LtOv_Size_W,
	LtOv_Size_T,
	LtOv_Size,
	LtOv_Appearance,
	LtOv_Details,
	
	POD,
	OTHER,
	Comments
FROM
	DBO.GYN_US
WHERE VisitCode=:ai_code"
  arguments=(("ai_code", number))
)
