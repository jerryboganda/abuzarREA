release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=1 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=92 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(500) updatewhereclause=yes name=localprecaution dbname="LocalPrecaution"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=precautioncode dbname="PrecautionCode"  )
 retrieve="SELECT 
	LocalPrecaution=Precaution.LocalPrecaution,   
	Code=VisitPrecaution.VisitCode,   
	PrecautionCode=VisitPrecaution.PrecautionCode
FROM Precaution,   
	VisitPrecaution  
WHERE ( VisitPrecaution.PrecautionCode = Precaution.PrecautionCode ) and  
	( ( VisitPrecaution.VisitCode = :ai_code ) )   
ORDER BY Precaution.LocalPrecaution ASC   
"
  arguments=(("ai_code", number))
)
text(name=localprecaution_t visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-12" font.pitch="2" font.weight="700" font.underline="1" background.mode="1" background.color="536870912" color="33554432" alignment="1" border="0" x="9" y="8" height="80" width="3008" text="Precautions" html.valueishtml="0" )
column(name=localprecaution visible="1" band=detail id=1 x="9" y="4" height="76" width="3008" color="33554432" border="0" alignment="1" format="[general]" html.valueishtml="0" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=yes edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=500 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Times New Roman" font.family="2" font.height="-12" font.pitch="2" font.weight="700" tabsequence=0 )
compute(name=compute_1 visible="1" band=detail font.charset="0" font.face="Times New Roman" font.family="1" font.height="-12" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="3026" y="4" height="76" width="178" format="[General]" expression="'-' + trim(string(getrow()))" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
