table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=dailycounter dbname="dailycounter"  )
column=(type=long updatewhereclause=yes name=monthlycounter dbname="monthlycounter"  )
column=(type=char(30) updatewhereclause=yes name=monthofinv dbname="monthofinv"  )
column=(type=char(20) updatewhereclause=yes name=packingname dbname="ItemPacking.name"  )
column=(type=char(60) updatewhereclause=yes name=itemcatname dbname="itemcatname"  )
