datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1010 color="536870912" )
summary(height=1093 color="536870912" )
footer(height=0 color="536870912" )
detail(height=2229 color="536870912" )
table(column=(type=long updatewhereclause=yes name=purinvcode dbname="Purledger.PurinvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Purledger.Date"  )
column=(type=char(100) updatewhereclause=yes name=suppinvcode dbname="Purledger.SuppinvCode"  )
column=(type=datetime updatewhereclause=yes name=suppinvdate dbname="Purledger.SuppInvDate"  )
column=(type=decimal(2) updatewhereclause=yes name=suppinvamount dbname="SuppInvAmount"  )
column=(type=long updatewhereclause=yes name=purtypecode dbname="PurTypeCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=creditdays dbname="CreditDays"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Purledger.Posted"  )
column=(type=decimal(6) updatewhereclause=yes name=saletax dbname="SaleTax"  )
column=(type=decimal(6) updatewhereclause=yes name=gross dbname="Gross"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Purledger.Remarks"  )
 retrieve="SELECT
	H.PurinvCode,
	H.Date, 
	H.SuppinvCode,
	H.SuppInvDate,
	SuppInvAmount=H.SuppInvAmount,
	PurTypeCode=H.PurTypeCode,
	CreditDays=H.CreditDays,
	AliasName = A.aliasname,
	Supplier = A.name,
	H.Posted, 
	SaleTax=ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.purprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.purprice) * 
				(1 - (.01 * D.discperc))) * 
				(1- (.01 * H.discperc)) - H.flatdisc) * 
				(H.invgstperc1 * .01), 2), ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)),
	Gross=  ROUND(SUM((D.looseqty + D.packqty) * D.purprice * 
			(1 - (.01 * D.discperc))) * (1- (.01 * H.discperc)) + 
			H.misccharges + H.salestax - H.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)),
	H.Remarks	
FROM 
	Purledger H, Purdetail D, Accounts A
WHERE 
	H.PurInvCode = :ai_invcode AND
	H.Purinvcode = D.Purinvcode AND
	H.SuppCode = A.AccCode
GROUP BY
	H.PurinvCode,
	H.Date,
	H.SuppinvCode,
	H.SuppInvDate,
	H.Posted,
	H.DiscPerc,
	H.FlatDisc,
	H.InvGSTPerc1,
	H.SalesTax,
	H.MiscCharges,
	H.Remarks,
	H.SuppInvAmount,
	H.PurTypeCode,
	H.CreditDays,
	A.AliasName,
	A.name"
  arguments=(("ai_invcode", number))
)
