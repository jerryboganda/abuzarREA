column=(type=long updatewhereclause=yes name=dueqty dbname="DueQty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=char(100) updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=char(1) updatewhereclause=yes name=claimable dbname="claimable"  )
column=(type=decimal(2) updatewhereclause=yes name=claimablediscperc dbname="claimablediscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="retailprice"  )
column=(type=decimal(5) updatewhereclause=yes name=packprice dbname="packprice"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(4) updatewhereclause=yes name=packqtyforsale dbname="packqtyforsale"  )
column=(type=decimal(4) updatewhereclause=yes name=bonuspackqtyforsale dbname="bonuspackqtyforsale"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=char(200) updatewhereclause=yes name=viewsaleinvmarginpreviewon dbname="viewsaleinvmarginpreviewon"  )
 retrieve="SELECT
	item.customicode,  
	itemname= item.name, 
	locksaleprice = dbo.item.locksaleprice,
	lockdiscperc = dbo.item.lockdiscperc,
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= 0.0000, 
	purprice=max(saledetail.purunitrate),
	rppunitrate=max(saledetail.rppunitrate),
	avgprice=max(ROUND(Item.purprice / CASE WHEN item.packunits <= 0 THEN 1 ELSE item.packunits END, 2)),
	itemtotalval=space(30),
	qtysale=item.saleqty,
	bonus=item.bonusqty,
	assgcode  = 1, 
	updatesaleprice = 'N',
	saledetail.saleinvcode,   
	saledetail.icode,   
	saledetail.gcode,
	Itemflatdisc = max(Saledetail.itemflatdisc),
	Id        = max(saledetail.IDENTITYCOL),
	packunits = max(saledetail.packunits),
	saleprice = max(saledetail.saleprice),
	rate      = max(saledetail.rate),
	salestax  = max(saledetail.salestax),  
	Due       = max(Due),
	SatisfiedDate = max(SatisfiedDate),
	DueQty    = 0,
	packqty   = sum(saledetail.packqty),
	SaleItemDescription =  max( saledetail.SaleItemDescription),
	claimable= max(saledetail.claimable),
	claimablediscperc= max(saledetail.claimablediscperc),
	discperc  = max(saledetail.discperc),
	itemcode = 0,
	retailprice=item.retailprice,
	packprice = max(saledetail.packprice),
	unitsalestax=max(saledetail.unitsalestax),
	gstperc=max(saledetail.gstperc),
	packqtyforsale = Max(saledetail.packqtyforsale) ,
	bonuspackqtyforsale = Max(saledetail.bonuspackqtyforsale),
	bonusqty  = sum(saledetail.bonusqty),
	looseqty  = sum(saledetail.looseqty),
	invdiscperc= ISNULL( (select dbo.saleledger.discperc from dbo.saleledger where dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode), 0),
	viewsaleinvmarginpreviewon = (SELECT DBO.Fn_GetPreference('viewsaleinvmarginpreview'))
FROM 
	saledetail, item
WHERE 
	( dbo.saledetail.saleinvcode = :ar_SaleInvCode )    AND
	( saledetail.icode = item.icode )
GROUP BY 
	saledetail.saleinvcode, 
	saledetail.icode, 
	saledetail.rowgroup,
	saledetail.gcode, 
	item.customicode, 
	item.saleqty,
	item.bonusqty,
	item.name,
	item.locksaleprice,
	item.lockdiscperc,
	item.retailprice
ORDER BY 
	MIN(saledetail.IDENTITYCOL)
"
  arguments=(("ar_SaleInvCode", number))
)
