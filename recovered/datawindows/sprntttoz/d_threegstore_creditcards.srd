release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=2177 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(60) updatewhereclause=yes name=accoutnname dbname="AccoutnName"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
 retrieve=" SELECT 
	SaleInvCode=CashierWindow.SaleInvCode,   
	AccCode=CashierWindow.AccCode,   
	AccoutnName=Accounts.Name,   
	Amount=CashierWindow.Amount  
FROM 
	CashierWindow,   
	Accounts  
WHERE 
	Accounts.AccCode = CashierWindow.AccCode and  
	CashierWindow.SaleInvCode = :ai_code
UNION ALL
SELECT 
	SaleInvCode=:ai_code,   
	AccCode=NULL,   
	AccoutnName=Null,   
	Amount=0.00
FROM
	(SELECT a=1) A
WHERE 
	:ai_code NOT IN 
		(SELECT DISTINCT CashierWindow.SaleInvCode FROM CashierWindow WHERE CashierWindow.SaleInvCode = :ai_code)
	
"
  arguments=(("ai_code", number), ("ai_balance", number), ("as_username", string), ("as_machine", string))
 sort="accoutnname A"
)
