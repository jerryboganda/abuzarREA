release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1697 color="536870912" )
summary(height=2708 color="536870912" )
footer(height=0 color="536870912" )
detail(height=156 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saletype dbname="SaleType"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long updatewhereclause=yes name=salecat dbname="salecat"  )
column=(type=long updatewhereclause=yes name=saleledger_custcode dbname="SaleLedger.custcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleLedger.saleinvcode"  )
column=(type=long updatewhereclause=yes name=altersaleinvcode dbname="altersaleinvcode"  )
column=(type=datetime updatewhereclause=yes name=saleledger_date dbname="SaleLedger.date"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_discperc dbname="SaleLedger.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_misccharges dbname="SaleLedger.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_flatdisc dbname="SaleLedger.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_salestax dbname="SaleLedger.salestax"  )
column=(type=long updatewhereclause=yes name=custcode dbname="SaleLedger.custcode"  )
column=(type=char(100) updatewhereclause=yes name=saleledger_remarks dbname="SaleLedger.remarks"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Saledetail.icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=decimal(2) updatewhereclause=yes name=cashreceived dbname="cashreceived"  )
column=(type=decimal(2) updatewhereclause=yes name=cardscharged dbname="CardsCharged"  )
column=(type=decimal(0) updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(3) updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_discperc dbname="discperc"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(21) updatewhereclause=yes name=machinename dbname="machinename"  )
column=(type=long updatewhereclause=yes name=reprintcounter dbname="reprintcounter"  )
column=(type=long updatewhereclause=yes name=srbufferinvcode dbname="SrBufferInvCode"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=decimal(2) updatewhereclause=yes name=associatedamt dbname="associatedamt"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="balance"  )
 retrieve="  SELECT  
	SaleType = 1,
	itemname =max(item.Name),
	users.username, 
	salecat=max(saleledger.salecatcode),
	saleledger.custcode,
	headerno = dbo.saleledger.headerno,
	customer=(select name from accounts where acccode=saleledger.custcode),
	dbo.saleledger.saleinvcode,   
	altersaleinvcode=dbo.saleledger.altersaleinvcode,
	dbo.saleledger.date,   
	dbo.saleledger.discperc,   
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.salestax,   
	dbo.saleledger.custcode,   
	dbo.saleledger.remarks,   
	posted= dbo.saleledger.posted,
	dbo.saledetail.icode,   
	gcode=max(dbo.saledetail.gcode), 
	/*cashtendered=saleledger.cashtendered,
	cashreceived=saleledger.cashcharged,
	cashback=saleledger.cashback,*/
	cashreceived=max(saleledger.cashreceived),
	CardsCharged=ISNULL((select isnull(sum(CW.amount),0) from cashierwindow CW where CW.saleinvcode=saleledger.saleinvcode), 0),
	Id        = MAX(dbo.saledetail.IDENTITYCOL),  
	looseqty  = sum(saledetail.looseqty), 
	packqty   = sum(saledetail.packqty), 
	packunits = saledetail.packunits, 
	saleprice = saledetail.saleprice, 
	rate      = max(saledetail.rate),
	salestax  = max(saledetail.salestax),   
	discperc  = saledetail.discperc, 
	customername='                                  '  ,
	itemflatdisc  = max(saledetail.itemflatdisc),
	aliasname=item.customicode,
	machinename=',' +  max(saleledger.machinename),
	reprintcounter=max(dbo.saleledger.reprintingcounter),
	SrBufferInvCode=dbo.saleledger.SRBufferInvCode,
	InvTotal = dbo.saleledger.InvTotal,
	associatedamt= 0.00,
	balance=0.00
FROM 
	dbo.saleledger,   
	dbo.saledetail,  
	item,
	Users 
WHERE 
	( dbo.saleledger.saleinvcode = :ra_InvCode ) AND
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND 
	( saleLedger.SalesManCode = users.userCode ) and
	( saledetail.icode = item.icode )
GROUP BY 
	saleledger.saleinvcode, 
	saleledger.srbufferinvcode,
	dbo.saleledger.altersaleinvcode,
	saleledger.date, 
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	saleledger.headerno,
	saleledger.salestax, 
	saleledger.remarks, 
	dbo.saleledger.posted,
	dbo.saleledger.InvTotal,
	dbo.saleledger.altersaleinvcode,
	saleledger.cashcharged,
	saleledger.cashtendered,
	saleledger.cashback,
	saledetail.icode,
	saledetail.packunits, 
	saledetail.saleprice, 
	saledetail.discperc, 
	item.name,
	item.icode,
	item.printable,
	item.customicode,
	users.username
UNION ALL
SELECT	 
	SaleType = 1,
	itemname = ISNULL((SELECT '*' + MachineName FROM SaleLedger WHERE SaleInvCode = AssocSaleInvCode) + ' (' + LTRIM(RTRIM(STR(AssocSaleInvCode))) + ')', ''),
	users.username, 
	salecat=saleledger.salecatcode,
	saleledger.custcode,
	headerno = dbo.saleledger.headerno,
	customer=(select name from accounts where acccode=saleledger.custcode),
	dbo.saleledger.saleinvcode,   
	altersaleinvcode=dbo.saleledger.altersaleinvcode,
	dbo.saleledger.date,   
	dbo.saleledger.discperc,   
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.salestax,   
	dbo.saleledger.custcode,   
	dbo.saleledger.remarks,   
	posted= dbo.saleledger.posted,
	icode=NULL,   
	gcode=NULL, 
	/*cashtendered=saleledger.cashtendered,
	cashreceived=saleledger.cashcharged,
	cashback=saleledger.cashback,*/
	cashreceived=saleledger.cashreceived,
	CardsCharged=ISNULL((select isnull(sum(CW.amount),0) from cashierwindow CW where CW.saleinvcode=saleledger.saleinvcode), 0),
	Id        = 999999999999,  
	looseqty  = 0, 
	packqty   = 0, 
	packunits = 0, 
	saleprice = 0, 
	rate      = 0,
	salestax  = 0,   
	discperc  = 0, 
	customername='                                  '  ,
	itemflatdisc  = 0,
	aliasname=NULL,
	machinename=',' + saleledger.machinename,
	reprintcounter=dbo.saleledger.reprintingcounter,
	SrBufferInvCode=dbo.saleledger.SRBufferInvCode,
	InvTotal = dbo.saleledger.InvTotal,
	
	associatedamt= DBO.fn_GetSaleInvTotal(L.AssocSaleInvCode),
	balance=0.00
FROM 
	dbo.saleledger,   
	AssocSaleInvList L, 
	Users
WHERE 
	( dbo.saleledger.saleinvcode = :ra_InvCode ) AND
	( dbo.saleledger.saleinvcode = L.saleinvcode ) AND 
	( saleLedger.SalesManCode = users.userCode )
UNION ALL
SELECT  
	SaleType = 2,
	itemname =max(item.Name),
	/*itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, */
	users.username, 
	/*salecat=max(srbufferledger.srcatcode),*/
	salecat=max(saleledger.salecatcode),
	srbufferledger.custcode,
	headerno = dbo.srbufferledger.headerno,
	customer=(select name from accounts where acccode=srbufferledger.custcode),
	dbo.saleledger.saleinvcode,   
	altersaleinvcode=dbo.saleledger.altersaleinvcode,
	dbo.srbufferledger.date,   
	dbo.srbufferledger.discperc,   
	dbo.srbufferledger.misccharges,   
	dbo.srbufferledger.flatdisc,   
	dbo.srbufferledger.salestax,   
	dbo.srbufferledger.custcode,   
	dbo.srbufferledger.remarks,   
	posted= dbo.srbufferledger.posted,
	dbo.srbufferdetail.icode,   
	dbo.srbufferdetail.gcode, 
	/*cashtendered=saleledger.cashtendered,
	cashreceived=saleledger.cashcharged,
	cashback=saleledger.cashback,*/
	cashreceived=max(saleledger.cashreceived),
	CardsCharged=ISNULL((select isnull(sum(CW.amount),0) from cashierwindow CW where CW.saleinvcode=saleledger.saleinvcode), 0),
	Id        = MAX(dbo.srbufferdetail.IDENTITYCOL),  
	/*looseqty  = - sum(srbufferdetail.looseqty), */
	looseqty  =  sum(srbufferdetail.looseqty),
	packqty   = 0.000, 
	packunits = max(srbufferdetail.packunits), 
	saleprice = max(srbufferdetail.srprice), 
	rate      = max(srbufferdetail.srprice),
	salestax  = max(srbufferdetail.salestax),   
	discperc  = max(srbufferdetail.discperc), 
	customername='                                  '  ,
	itemflatdisc  = 0.00,
	aliasname=item.customicode,
	machinename=',' +  max(saleledger.machinename),
	reprintcounter=0,
	SrBufferInvCode=dbo.srbufferledger.SRBufferInvCode,
	InvTotal = dbo.srbufferledger.InvTotal,
	
	associatedamt= 0.00,
	balance=0.00
FROM 
	dbo.saleledger,
	dbo.srbufferledger,   
	dbo.srbufferdetail,  
	item,
	Users 
WHERE 
	( dbo.saleledger.saleinvcode = :ra_InvCode ) AND
	( dbo.saleledger.srbufferinvcode = dbo.srbufferLedger.srbufferinvcode ) AND
	( dbo.srbufferledger.srbufferinvcode = dbo.srbufferdetail.srbufferinvcode ) AND 
	( dbo.srbufferLedger.SalesManCode = users.userCode ) and
	( dbo.srbufferdetail.icode = item.icode )
GROUP BY 
	dbo.srbufferledger.srbufferinvcode,
	dbo.srbufferledger.saleinvcode, 
	dbo.saleledger.saleinvcode,
	dbo.saleledger.altersaleinvcode,
	srbufferledger.date, 
	srbufferledger.custcode, 
	srbufferledger.discperc, 
	srbufferledger.flatdisc, 
	srbufferledger.misccharges, 
	srbufferledger.headerno,
	srbufferledger.salestax, 
	srbufferledger.remarks, 
	srbufferledger.posted,
	srbufferdetail.icode,
	srbufferdetail.gcode, 
	dbo.srbufferledger.InvTotal,
	dbo.saleledger.altersaleinvcode,
	saleledger.cashtendered,
	saleledger.cashcharged,
	saleledger.cashback,
	item.icode,
	item.printable,
	item.customicode,
	users.username
ORDER BY 
	SaleType,
	ID
"
  arguments=(("ra_InvCode", number))
 sort="id A"
)
group(level=1 header.height=239 trailer.height=708 by=("saletype"  ) header.color="536870912" trailer.color="536870912" )
