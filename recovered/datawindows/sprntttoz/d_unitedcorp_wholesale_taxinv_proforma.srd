column=(type=char(1) updatewhereclause=yes name=printwaranty dbname="SaleLedger.printwaranty"  )
column=(type=char(1) updatewhereclause=yes name=printbatch dbname="SaleLedger.printbatch"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(50) updatewhereclause=yes name=message dbname="Message"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CUSTALIAS"  )
 retrieve="  SELECT itemname= Case When saledetail.saleitemdescription IS Null OR RTrim(LTrim(saledetail.saleitemdescription)) = '' THEN item.name Else saledetail.saleitemdescription END, 
         aliasname=item.customicode,   
			itemclass=(select name from itemclass where iccode=item.iccode),
			itemcategory=(select name from itemcategory where icatcode=item.icatcode),
			saletype=(select name from saletype where saleledger.saletypecode=saletype.saletypecode),
			refno2=dbo.saleledger.custrefno2,
         packingdesc=item.packingdesc,
         accname = dbo.accounts.name,   
         address = dbo.customer.address1,   
         address2= dbo.customer.address2, 
			customerphone=dbo.customer.phone,  
         city= dbo.customer.city,   
         licenceno= dbo.customer.licenceno,   
         username= dbo.users.username,   
         saleinvcode = dbo.saleledger.saleinvcode, 
			headerinvcode=dbo.saleledger.headerinvno,  
         headerno = dbo.saleledger.headerno,   
         date = saleledger.date, 
         invdiscperc = dbo.saleledger.discperc,   
         misccharges = dbo.saleledger.misccharges,   
         flatdisc = dbo.saleledger.flatdisc,   
         invsalestax = dbo.saleledger.salestax,   
         gcode = saledetail.gcode,   
         icode = saledetail.icode,   
         batch = saledetail.batch,   
         expiry = saledetail.expiry,   
         looseqty = saledetail.looseqty,   
         bonusqty = saledetail.bonusqty,   
 
         packunits= saledetail.packunits,   
         saleprice= saledetail.saleprice,   
         discperc = saledetail.discperc,   
         
			itemflatdisc=saledetail.itemflatdisc,   
         Id = saledetail.IDENTITYCOL,   
         posted=saleledger.posted,   
         balance=0,   
         unitsalestax = saledetail.unitsalestax,   
         gstperc = saledetail.gstperc,   
         invgstperc = saleledger.invgstperc1,   
         custTaxRegno=customer.salestaxregno  ,
		dbo.saleledger.custrefno,	
		dbo.saleledger.remarks,
		dbo.saleledger.printwaranty,
		dbo.saleledger.printbatch,
		salesman=(SELECT salesman.name FROM Salesman WHERE salesman.salesmancode=dbo.saleledger.smancode),
		Message=(SELECT Message.description FROM Message WHERE Message.Messagecode=dbo.saleledger.messagecode),
		CUSTALIAS=ACCOUNTS.ALIASNAME

    FROM saleledger,   
         saleinvdetail saledetail,   
         accounts,   
         customer,   
         users,   
         item  

   WHERE ( dbo.saleledger.saleinvcode= :ar_SInvCode  ) AND  
         ( dbo.saleledger.saleinvcode = saledetail.saleinvcode) AND 
			( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  
         ( dbo.customer.custcode = dbo.accounts.acccode ) AND  
         ( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  
         ( saledetail.icode = dbo.item.icode)    

ORDER BY saledetail.saleinvcode,
			saledetail.IDENTITYCOL"
  arguments=(("ar_SInvCode", number))
)
