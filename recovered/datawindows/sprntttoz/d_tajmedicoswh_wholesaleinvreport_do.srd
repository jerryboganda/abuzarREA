table(column=(type=char(88) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=saletyp dbname="saletyp"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="itemclass"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="invsalestax"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=datetime updatewhereclause=yes name=orderdate dbname="orderdate"  )
column=(type=decimal(4) updatewhereclause=yes name=totalqty dbname="totalqty"  )
column=(type=decimal(15) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=char(1) updatewhereclause=yes name=packorloose dbname="packorloose"  )
column=(type=decimal(15) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=char(1) updatewhereclause=yes name=bonuspackorloose dbname="bonuspackorloose"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=packsaleprice dbname="packsaleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="salestax"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=balance dbname="balance"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(50) updatewhereclause=yes name=custtaxregno dbname="custTaxRegno"  )
column=(type=char(100) updatewhereclause=yes name=saleledger_custrefno dbname="SaleLedger.custrefno"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SaleLedger.remarks"  )
column=(type=char(1) updatewhereclause=yes name=printwaranty dbname="SaleLedger.printwaranty"  )
column=(type=char(1) updatewhereclause=yes name=printbatch dbname="SaleLedger.printbatch"  )
column=(type=long updatewhereclause=yes name=reprintcount dbname="reprintcount"  )
column=(type=datetime updatewhereclause=yes name=serverdate dbname="serverdate"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=char(50) updatewhereclause=yes name=messages dbname="messages"  )
 retrieve="SELECT 
		itemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END, 
         aliasname=item.customicode,   
		saletyp=(select name from saletype where saletype.saletypecode=saleledger.saletypecode),
         packingdesc=item.packingdesc,   
         accname = dbo.accounts.name,   
		itemclass=(select name from itemclass where itemclass.iccode=item.iccode),
         address = dbo.customer.address1,   
         address2= dbo.customer.address2,    
         salesman = dbo.users.username,   
         saleinvcode = dbo.saleledger.saleinvcode,   
         headerno = dbo.saleledger.headerno,   
         date = dbo.saleledger.date,   
         invdiscperc = dbo.saleledger.discperc,   
         misccharges = dbo.saleledger.misccharges,   
         flatdisc = dbo.saleledger.flatdisc,   
         invsalestax = dbo.saleledger.salestax,   
         gcode = saledetail.gcode,   
         icode = saledetail.icode,   
         batch = saledetail.batch,   
         expiry = saledetail.expiry,   
		orderdate=saleledger.billingdate,
        /* looseqty = saledetail.looseqty,   
		 bonusqty = saledetail.bonusqty,   */
		totalqty=saledetail.looseqty + saledetail.bonusqty,
		looseqty =(Case ( CAST(saledetail.looseqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end)AS INT) - (saledetail.looseqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end)) ) When 0 Then (saledetail.looseqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end)) Else saledetail.looseqty End),
      	packorloose = (Case ( CAST(saledetail.looseqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end) AS INT) - (saledetail.looseqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end)) ) When 0 Then '' Else 'L' End),  
		bonusqty = (Case ( CAST(saledetail.bonusqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end) AS INT) - (saledetail.bonusqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end)) ) When 0 Then (saledetail.bonusqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end)) Else saledetail.bonusqty End), 
	   	bonuspackorloose = (Case ( CAST(saledetail.bonusqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end) AS INT) - (saledetail.bonusqty /(case saledetail.packunits when 0 then 1 else saledetail.packunits end)) ) When 0 Then '' Else 'L' End),
         packqty = saledetail.packqty,   
         packunits= saledetail.packunits,   
        /* saleprice= saledetail.saleprice, */
		saleprice=(Case ( CAST(saledetail.looseqty /(case saledetail.packunits when 0 then 1 else saledetail.packunits end) AS INT) - (saledetail.looseqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end)) ) When 0 Then (saledetail.saleprice * saledetail.packunits) Else saledetail.saleprice End),
		packsaleprice=(Case ( CAST(saledetail.looseqty /(case saledetail.packunits when 0 then 1 else saledetail.packunits end) AS INT) - (saledetail.looseqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end)) ) When 0 Then (saledetail.rate * saledetail.packunits) Else saledetail.rate End),
         discperc = saledetail.discperc,  
		/*	itemflatdisc=saledetail.itemflatdisc,   */
		itemflatdisc=(Case ( CAST(saledetail.looseqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end)AS INT) - (saledetail.looseqty / (case saledetail.packunits when 0 then 1 else saledetail.packunits end)) ) When 0 Then (saledetail.packunits * saledetail.itemflatdisc) Else saledetail.itemflatdisc End ),
         salestax = saledetail.salestax,   
         Id = dbo.saledetail.IDENTITYCOL,   
         posted=saleledger.posted,   
         balance=0,   
         unitsalestax = saledetail.unitsalestax,   
         gstperc = saledetail.gstperc,   
         invgstperc = saleledger.invgstperc1,   
         custTaxRegno=customer.salestaxregno  ,
			dbo.saleledger.custrefno,	
			dbo.saleledger.remarks,
			dbo.saleledger.printwaranty,
			dbo.saleledger.printbatch,
			reprintcount=saleledger.Reprintingcounter,
			serverdate=getdate(),
			custcode=dbo.saleledger.custcode,
			salesperson=(select name from salesman where salesmancode=saleledger.smancode),
			messages=(select description from message where messagecode=saleledger.messagecode)

    FROM saleledger,   
         saledetail,   
         accounts,   
         customer,   
         users,   
         item  

   WHERE 
		 ( dbo.saleledger.saleinvcode = :ar_SInvCode ) AND  
		 
         ( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND  
         ( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  
         ( dbo.customer.custcode = dbo.accounts.acccode ) AND  
         ( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  
         ( dbo.saledetail.icode = dbo.item.icode)    

ORDER BY dbo.saledetail.saleinvcode,
			saledetail.rowid"
  arguments=(("ar_SInvCode", number))
)
