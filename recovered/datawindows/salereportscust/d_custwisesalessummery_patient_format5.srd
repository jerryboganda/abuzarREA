release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=500 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2489 color="536870912" )
summary(height=302 color="536870912" )
footer(height=708 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=purledger_date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=char(60) updatewhereclause=yes name=relation dbname="relation"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(30) updatewhereclause=yes name=refno dbname="refno"  )
column=(type=char(100) updatewhereclause=yes name=refno2 dbname="refno2"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=cp dbname="Customer.cp"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Customer.address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Customer.address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="Customer.city"  )
column=(type=decimal(6) updatewhereclause=yes name=invtotal dbname="invtotal"  )
 retrieve="  SELECT invcode = dbo.saleledger.saleinvcode, 
         date        = dbo.saleledger.date, 
         flatdisc    = dbo.saleledger.flatdisc, 
			salestax    = dbo.saleledger.salestax,
			relation		= (select name from relation where relation.relationcode=max(saleledger.relationcode)), 
         misccharges = dbo.saleledger.misccharges, 
			invdiscperc = dbo.saleledger.discperc, 
			invgstperc1 = dbo.saleledger.invgstperc1,
			refno=dbo.saleledger.custrefno,
			refno2=max(dbo.saleledger.custrefno2),
			remarks=dbo.saleledger.remarks,
			doctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
         dbo.accounts.name, 
			dbo.customer.cp,
			dbo.customer.address1,
			dbo.customer.address2,
			dbo.customer.city,
			invtotal= /*-------gross------*/
			Round(
			SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) *
			(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) + 
			saleledger.misccharges + saleledger.salestax - saleledger.flatdisc, 0)
			+ /*-----sales tax-------*/
			Round(
			SUM( (saledetail.looseqty + saledetail.bonusqty) * saledetail.unitsalestax) + 
			SUM(ROUND( (saledetail.looseqty * 
			(saledetail.saleprice - saledetail.itemflatdisc)) *
			(1 - (.01 * saledetail.discperc)) * saledetail.gstperc * .01, 2)) +
			ROUND( (SUM((saledetail.looseqty * 
			(saledetail.saleprice - saledetail.itemflatdisc)) *
			(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) -
			saleledger.flatdisc) * (saleledger.invgstperc1 * .01), 2), 0)/*,


			regno = (Select dbo.patient.regno From dbo.Patient Where dbo.saleledger.patientcode = dbo.patient.patientcode ),
			patientname = (Select dbo.patient.name From dbo.Patient Where dbo.saleledger.patientcode = dbo.patient.patientcode ),
			designation = (Select dbo.rank.name From dbo.Patient, dbo.Rank Where dbo.saleledger.patientcode = dbo.patient.patientcode AND dbo.patient.rankcode = dbo.rank.rankcode),
         department = (Select dbo.unit.name From dbo.Patient, dbo.Unit Where dbo.saleledger.patientcode = dbo.patient.patientcode AND dbo.patient.unitcode = dbo.unit.unitcode)
			*/
    FROM dbo.saleledger, 
         dbo.saledetail,   
         dbo.accounts, 
			dbo.customer	

   WHERE dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
			dbo.saleledger.date Between :ad_StartDate and :ad_EndDate and
			dbo.saleledger.salecatcode IN (1, 2, 3) and
			dbo.saleledger.custcode  = :al_CustCode and 
         dbo.saleledger.custcode = dbo.accounts.acccode and	
         dbo.customer.custcode = dbo.saleledger.custcode 


GROUP BY dbo.saleledger.saleinvcode,   
			dbo.saleledger.date,   
			dbo.saleledger.misccharges,   
         dbo.saleledger.flatdisc,   
         dbo.saleledger.discperc,  
			dbo.saleledger.salestax, 
			dbo.saleledger.invgstperc1,
			dbo.saleledger.salecatcode, 
			dbo.saleledger.patientcode,
			dbo.saleledger.custrefno,	 
			dbo.saleledger.remarks,
			dbo.accounts.name,	
			dbo.customer.cp,
			dbo.customer.address1,
			dbo.customer.address2,
			dbo.customer.city
UNION ALL
  SELECT invcode     = dbo.saleledger.saleinvcode, 
         date        = dbo.saleledger.date, 
         flatdisc    = dbo.saleledger.flatdisc, 
			salestax    = dbo.saleledger.salestax,
			relation		= (select name from relation where relation.relationcode=max(saleledger.relationcode)), 
         misccharges = dbo.saleledger.misccharges, 
			invdiscperc = dbo.saleledger.discperc, 
			invgstperc1 = dbo.saleledger.invgstperc1,
			refno=dbo.saleledger.custrefno,
			refno2=max(dbo.saleledger.custrefno2),
			remarks=dbo.saleledger.remarks,
			doctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
         dbo.accounts.name, 
			dbo.customer.cp,
			dbo.customer.address1,
			dbo.customer.address2,
			dbo.customer.city,
			invtotal= /*-------gross------*/
			Round(
			SUM((sd.looseqty*(sd.saleprice - sd.itemflatdisc)) *
			(1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) + 
			saleledger.misccharges + saleledger.salestax - saleledger.flatdisc, 0)
			+ /*-----sales tax-------*/
			Round(
			SUM( (sd.looseqty + sd.bonusqty) * sd.unitsalestax) + 
			SUM(ROUND( (sd.looseqty * 
			(sd.saleprice - sd.itemflatdisc)) *
			(1 - (.01 * sd.discperc)) * sd.gstperc * .01, 2)) +
			ROUND( (SUM((sd.looseqty * 
			(sd.saleprice - sd.itemflatdisc)) *
			(1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) -
			saleledger.flatdisc) * (saleledger.invgstperc1 * .01), 2), 0)/*,


			regno = (Select dbo.patient.regno From dbo.Patient Where dbo.saleledger.patientcode = dbo.patient.patientcode ),
			patientname = (Select dbo.patient.name From dbo.Patient Where dbo.saleledger.patientcode = dbo.patient.patientcode ),
			designation = (Select dbo.rank.name From dbo.Patient, dbo.Rank Where dbo.saleledger.patientcode = dbo.patient.patientcode AND dbo.patient.rankcode = dbo.rank.rankcode),
         department = (Select dbo.unit.name From dbo.Patient, dbo.Unit Where dbo.saleledger.patientcode = dbo.patient.patientcode AND dbo.patient.unitcode = dbo.unit.unitcode)
			*/
    FROM dbo.saleledger, 
         dbo.saleinvdetail sd,   
         dbo.accounts, 
			dbo.customer	

   WHERE DBO.SaleLedger.impactinventory = 'N' AND 
			dbo.saleledger.saleinvcode = sd.saleinvcode and  
			dbo.saleledger.date Between :ad_StartDate and :ad_EndDate and
			dbo.saleledger.salecatcode IN (1, 2, 3) and
			dbo.saleledger.custcode  = :al_CustCode and 
         dbo.saleledger.custcode = dbo.accounts.acccode and	
         dbo.customer.custcode = dbo.saleledger.custcode 


GROUP BY dbo.saleledger.saleinvcode,   
			dbo.saleledger.date,   
			dbo.saleledger.misccharges,   
         dbo.saleledger.flatdisc,   
         dbo.saleledger.discperc,  
			dbo.saleledger.salestax, 
			dbo.saleledger.invgstperc1,
			dbo.saleledger.salecatcode, 
			dbo.saleledger.patientcode,
			dbo.saleledger.custrefno,	 
			dbo.saleledger.remarks,
			dbo.accounts.name,	
			dbo.customer.cp,
			dbo.customer.address1,
			dbo.customer.address2,
			dbo.customer.city         

ORDER BY dbo.saleledger.saleinvcode ASC,   
         dbo.saleledger.date ASC   

"
  arguments=(("al_Custcode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("as_caption", string), ("as_caption2", string))
 sort="custname A, invcode A"
)
