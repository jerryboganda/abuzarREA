release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1468 color="536870912" )
summary(height=208 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="CustomerAlias"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=decimal(2) updatewhereclause=yes name=sale dbname="Sale"  )
column=(type=decimal(7) updatewhereclause=yes name=salevolume dbname="SaleVolume"  )
column=(type=decimal(2) updatewhereclause=yes name=salereturn dbname="SaleReturn"  )
column=(type=decimal(7) updatewhereclause=yes name=salereturnvolume dbname="SaleReturnVolume"  )
column=(type=decimal(2) updatewhereclause=yes name=netsale dbname="NetSale"  )
column=(type=decimal(7) updatewhereclause=yes name=netsalevolume dbname="NetSaleVolume"  )
 retrieve="SELECT
	CustomerCategory=CC.Name,
	CustomerAlias=A.AliasName,
	Customer=A.Name,
	Sale=SUM(S.Sale), 
	SaleVolume=SUM(S.SaleVolume),
	SaleReturn=SUM(S.SaleReturn),
	SaleReturnVolume=SUM(S.SaleReturnVolume),
	NetSale=SUM(S.Sale - S.SaleReturn),
	NetSaleVolume=SUM(S.SaleVolume - S.SaleReturnVolume)
FROM
	CustomerCategory CC, 
	Customer C, 
	Accounts A,
	(SELECT
		S.CustCode,
		Sale = S.InvTotal,
		SaleVolume = SUM(SD.LooseQty * I.PackingFactor),
		SaleReturn = 0.00,
		SaleReturnVolume = 0.00
	FROM
		(SELECT CustCode FROM Customer WHERE CustCatCode IN (:ai_custcatcode)) C,
		SaleLedger S, SaleDetail SD, Item I
	WHERE 
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		S.SaleInvCode = SD.SaleInvCode AND S.CustCode = C.CustCode AND
		SD.ICode = I.ICode
	GROUP BY
		S.CustCode,
		S.SaleInvCode,
		S.InvTotal
	UNION ALL
	SELECT
		S.CustCode,
		Sale = S.InvTotal,
		SaleVolume = SUM(SD.LooseQty * I.PackingFactor),
		SaleReturn = 0.00,
		SaleReturnVolume = 0.00
	FROM
		(SELECT CustCode FROM Customer WHERE CustCatCode IN (:ai_custcatcode)) C,
		SaleLedger S, SaleInvDetail SD, Item I
	WHERE 
		S.ImpactInventory='N' AND
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		S.SaleInvCode = SD.SaleInvCode AND S.CustCode = C.CustCode AND
		SD.ICode = I.ICode
	GROUP BY
		S.CustCode,
		S.SaleInvCode,
		S.InvTotal
	UNION ALL
	SELECT
		S.CustCode,
		Sale = 0.00,
		SaleVolume = 0.00,
		SaleReturn = S.InvTotal,
		SaleReturnVolume = SUM(SD.LooseQty * I.PackingFactor)
	FROM
		(SELECT CustCode FROM Customer WHERE CustCatCode IN (:ai_custcatcode)) C,
		SRLedger S, SRDetail SD, Item I
	WHERE 
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		S.SRInvCode = SD.SRInvCode AND S.CustCode = C.CustCode AND
		SD.ICode = I.ICode
	GROUP BY
		S.CustCode,
		S.SRInvCode,
		S.InvTotal) S
WHERE
	CC.CustCatCode IN (:ai_custcatcode) AND
	CC.CustCatCode = C.CustCatCode AND
	C.CustCode = A.AccCode AND
	S.CustCode = C.CustCode
GROUP BY
	CC.Name,
	A.Name,
	A.AliasName
ORDER BY
	CustomerCategory,
	Customer
"
  arguments=(("ai_custcatcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="customercategory A, customer A"
)
