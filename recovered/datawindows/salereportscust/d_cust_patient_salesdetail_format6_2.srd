	unittax=max(sd.unitsalestax),
	taxamount= max(sd.unitsalestax) * sum(sd.looseqty),
	itemdiscperc = max(sd.discperc),    
	packunits = max(sd.packunits),    
	batch = max(sd.batch),    
	expiry = max(sd.expiry),    
	salestax  = 0,
	rowid     = sd.rowid,
	itemname = item.name,
	/*datestring = max((Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))))), */
	Person = (dbo.accounts.name),
	contactperson=(dbo.customer.cp),
	manufacurer = (dbo.manufacturer.name),
	address = (dbo.customer.address1),
	city = (dbo.customer.city),
	RegNo = dbo.patient.regno,
	PatientName = dbo.patient.name,
	Rank = (SELECT R.Name FROM dbo.Rank R WHERE R.RankCode=Patient.Rankcode),
	Relation = (SELECT R.Name FROM dbo.Relation R WHERE R.RelationCode=Patient.RelationCode),
	Wing = (SELECT U.Name FROM dbo.Unit U WHERE U.UnitCode=Patient.UnitCode)
FROM 	 
	dbo.saleledger, 
	dbo.saleinvdetail sd, 
	dbo.item, 
	dbo.patient,
	dbo.accounts,
	dbo.Customer,
	dbo.Manufacturer 
WHERE  
	:ai_datetype = 3 AND
	DBO.SaleLedger.impactinventory = 'N' AND 
	dbo.saleledger.billingdate >= :ad_StartDate and
	dbo.saleledger.billingdate <= :ad_EndDate  and 
	(dbo.saleledger.custcode >= ( Case :al_CustCode When 0 Then 10 Else :al_CustCode End) and 
	dbo.saleledger.custcode  <= ( Case :al_CustCode When 0 THEN (Select max(custcode) From Customer) Else :al_CustCode End )) and
	dbo.saleledger.salecatcode IN (1, 2, 3) and
	/*dbo.saleledger.saleinvcode NOT IN (select distinct srledger.saleinvcode from srledger where srledger.originaldate between :ad_StartDate and :ad_EndDate and srledger.saleinvcode IS NOT NULL) and*/
	dbo.saleledger.saleinvcode = sd.saleinvcode and  
	sd.icode = item.icode and 
	dbo.saleledger.custcode = dbo.accounts.acccode and
	dbo.saleledger.custcode = dbo.customer.custcode and
	dbo.Item.manfcode = dbo.manufacturer.manfcode and
	dbo.saleledger.patientcode = dbo.patient.patientcode
GROUP BY
	saleledger.saleinvcode,
	sd.icode,
	item.name,
	dbo.accounts.name,
	dbo.manufacturer.name,
	dbo.customer.cp,
	dbo.customer.address1,
	dbo.customer.city,
	dbo.patient.regno,
	dbo.patient.name,
	Patient.Rankcode,
	Patient.RelationCode,
	Patient.UnitCode,
	dbo.saleledger.remarks,
	sd.rowid

"
  arguments=(("al_CustCode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_line1", string), ("as_line2", string), ("ad_date", string), ("ai_datetype", number))
 sort="saleinvcode A, rowid A"
)
