	dbo.customer.city,
	dbo.patient.regno,
	dbo.patient.name,
	Patient.Rankcode,
	Patient.RelationCode,
	Patient.UnitCode,
	dbo.saleledger.remarks,
	saledetail.rowid
UNION ALL
SELECT 
	saleinvcode = (dbo.saleledger.saleinvcode),    
	/* CustomerRef = max(convert(int ,rtrim(ltrim(IsNull(dbo.saleledger.CustRefNo, '0'))))), */
	date = max(dbo.saleledger.date), 
