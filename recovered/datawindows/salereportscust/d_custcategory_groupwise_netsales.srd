release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=534 color="536870912" )
summary(height=77 color="536870912" )
footer(height=0 color="536870912" )
detail(height=70 color="536870912" )
table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(60) updatewhereclause=yes name=customeraddress dbname="CustomerAddress"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
 retrieve="SELECT
	GroupCode=T.GroupCode,   
	GroupName=CASE :as_GroupType
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = T.GroupCode)
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = T.GroupCode)
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = T.GroupCode)
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = T.GroupCode) END,
	CustomerCategory=CC.Name,
	AliasName = A.AliasName,
	CustomerName = A.Name,
	CustomerAddress = C.Address1,
	SaleValue = SUM(T.SaleValue)
FROM
	(SELECT 
		C.CustCatCode,
		C.CustCode,
		D.ICode,
		GroupCode=CASE :as_GroupType 
			WHEN 'M' THEN I.ManfCode
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PackCode END,
		SaleValue=SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM
		SaleLedger S,
		SaleDetail D,
		Customer C,
		Item I
	WHERE
		S.SaleInvCode=D.SaleInvCode AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.CustCode = C.CustCode AND
		C.CustCatCode IN (:ai_CustCatCode) AND
		D.ICode = I.ICode AND
		CASE :as_GroupType 
			WHEN 'M' THEN I.ManfCode
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PackCode END IN (:ai_GroupCode)
	GROUP BY
		C.CustCatCode,
		C.CustCode,
		D.ICode,
		I.ManfCode,
		I.ICatCode,
		I.ICCode,
		I.PackCode
	UNION ALL
	SELECT 
		C.CustCatCode,
		C.CustCode,
		D.ICode,
		GroupCode=CASE :as_GroupType 
			WHEN 'M' THEN I.ManfCode
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PackCode END,
		SaleValue=SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM
		SaleLedger S,
		SaleInvDetail D,
		Customer C,
		Item I
	WHERE
		S.SaleInvCode=D.SaleInvCode AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.CustCode = C.CustCode AND
		C.CustCatCode IN (:ai_CustCatCode) AND
		D.ICode = I.ICode AND
		CASE :as_GroupType WHEN 'M' THEN I.ManfCode
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PackCode END IN (:ai_GroupCode)
	GROUP BY
		C.CustCatCode,
		C.CustCode,
		D.ICode,
		I.ManfCode,
		I.ICatCode,
		I.ICCode,
		I.PackCode
	UNION ALL
	SELECT 
		C.CustCatCode,
		C.CustCode,
		D.ICode,
		GroupCode=CASE :as_GroupType 
			WHEN 'M' THEN I.ManfCode
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PackCode END,
		SaleValue= - SUM(D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM
		SRLedger S,
		SRDetail D,
		Customer C,
		Item I
	WHERE
		S.SRInvCode=D.SRInvCode AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.CustCode = C.CustCode AND
		C.CustCatCode IN (:ai_CustCatCode) AND
		D.ICode = I.ICode AND
		CASE :as_GroupType WHEN 'M' THEN I.ManfCode
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PackCode END IN (:ai_GroupCode)
	GROUP BY
		C.CustCatCode,
		C.CustCode,
		D.ICode,
		I.ManfCode,
		I.ICatCode,
		I.ICCode,
		I.PackCode) T,
	Accounts A,
	Customer C,
	CustomerCategory CC,
	Item I
WHERE
	T.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	C.CustCatCode = CC.CustCatCode AND
	CC.CustCatCode IN (:ai_CustCatCode) AND
	T.GroupCode IN (:ai_GroupCode) AND
	T.ICode = I.ICode
GROUP BY 
	CC.Name,
	A.AliasName,
	A.Name,
	C.Address1,
	T.GroupCode"
  arguments=(("ai_custcatcode", numberlist), ("as_grouptype", string), ("ai_groupcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="groupname A, customercategory A, customername A, aliasname A"
)
