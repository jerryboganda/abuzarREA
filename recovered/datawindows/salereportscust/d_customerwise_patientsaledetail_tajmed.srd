release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=300 print.margin.top=0 print.margin.bottom=500 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1656 color="536870912" )
summary(height=718 color="536870912" )
footer(height=416 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(60) updatewhereclause=yes name=contactperson dbname="contactperson"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=char(30) updatewhereclause=yes name=cardno dbname="cardno"  )
column=(type=char(100) updatewhereclause=yes name=bookno dbname="bookno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=decimal(2) updatewhereclause=yes name=cumulativesum dbname="cumulativesum"  )
column=(type=decimal(2) updatewhereclause=yes name=cumulativesumfoot dbname="cumulativesumfoot"  )
 retrieve="SELECT 
	invcode = dbo.saleledger.saleinvcode,
	customer =max( dbo.accounts.name),
	contactperson=max(dbo.customer.cp), 
	address = max(dbo.customer.address1),
	city = max(dbo.customer.city), 
	cardno =max( dbo.saleledger.custrefno),
	bookno = dbo.saleledger.remarks,
	date = max(dbo.saleledger.originaldate),
	regno =max( dbo.patient.regno),
	patient = max(dbo.patient.name),
	itemname = item.name,
	ItemCategory = ItemCategory.Name,
	looseqty = sum(dbo.saledetail.looseqty),
	RowID= max(dbo.saledetail.rowid),
	rate =max( dbo.saledetail.saleprice),
	NetAmount = DBO.Fn_GetSaleInvTotal(dbo.saleledger.saleinvcode),
	cumulativesum = round(0.00,2),
	cumulativesumfoot = round(0.00,2)
FROM
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item, 
	dbo.ItemCategory,
	dbo.Customer,
	dbo.Patient,
	dbo.Accounts
WHERE  
	dbo.saleledger.originaldate >= :ad_startdate AND
	dbo.saleledger.originaldate <= :ad_enddate  AND 
	dbo.saleledger.custcode  IN ( :al_custcode ) AND
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	dbo.saledetail.icode = item.icode AND
	item.icatcode = 	dbo.ItemCategory.icatcode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.saleledger.patientcode = dbo.patient.patientcode
GROUP BY saleledger.saleinvcode, 
			saleledger.date, 
			saleledger.custcode,  
			saleledger.discperc, 
			saleledger.flatdisc, 
			saleledger.misccharges, 
			saleledger.headerno,
			saleledger.salestax, 
			saleledger.remarks, 
			saledetail.icode, 
			saledetail.saleprice,
			saledetail.itemflatdisc,
			saledetail.discperc,
			saledetail.gstperc,
			saledetail.unitsalestax,
			item.name,
			item.icode,
			item.printable,
			item.customicode,
			ItemCategory.Name
UNION ALL
SELECT 
	invcode = dbo.saleledger.saleinvcode,
	customer = max(dbo.accounts.name),
	contactperson=max(dbo.customer.cp), 
	address = max(dbo.customer.address1),
	city = max(dbo.customer.city), 
	formno = max(dbo.saleledger.custrefno),
	bookno = max(dbo.saleledger.remarks),
	date =max( dbo.saleledger.originaldate),
	regno =max(dbo.patient.regno),
	patient = max(dbo.patient.name),
	itemname = item.name,
	ItemCategory = ItemCategory.Name,
	looseqty =sum( sd.looseqty),
	RowID= max(sd.rowid),
	rate = sd.saleprice,
	NetAmount =max(saleledger.invtotal),
	cumulativesum = round(0.00,2),
	cumulativesumfoot = round(0.00,2)
FROM
	dbo.saleledger, 
	dbo.saleinvdetail sd, 
	dbo.item, 
	dbo.ItemCategory,
	dbo.Customer,
	dbo.Patient,
	dbo.Accounts
WHERE  
	DBO.SaleLedger.impactinventory = 'N' AND
	dbo.saleledger.originaldate >= :ad_startdate AND
	dbo.saleledger.originaldate <= :ad_enddate  AND 
	dbo.saleledger.custcode  IN ( :al_custcode ) AND
	dbo.saleledger.saleinvcode = sd.saleinvcode AND
	sd.icode = item.icode AND
	item.icatcode = 	dbo.ItemCategory.icatcode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.saleledger.patientcode = dbo.patient.patientcode
GROUP BY saleledger.saleinvcode, 
			saleledger.date, 
			saleledger.custcode, 
			saleledger.discperc, 
			saleledger.flatdisc, 
			saleledger.misccharges, 
			saleledger.headerno,
			saleledger.salestax, 
			saleledger.remarks, 
			sd.icode, 
			sd.saleprice,
			sd.itemflatdisc,
			sd.discperc,
			sd.gstperc,
			sd.unitsalestax,
			item.name,
			item.icode,
			item.printable,
			item.customicode,
			ItemCategory.Name
ORDER BY
	customer,
	invcode,
	RowID"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_caption", string))
 sort="customer A, invcode A, rowid A"
)
