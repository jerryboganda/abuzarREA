release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1020 color="536870912" )
header[2](height=354 color="536870912" )
summary(height=187 color="536870912" )
footer(height=0 color="536870912" )
detail(height=208 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(20) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(20) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=number updatewhereclause=yes name=salevalue dbname="salevalue"  )
 retrieve="SELECT 
	Manufacturer=M.Name,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	SalesMan = S.Name,
	SaleValue = SUM(T.SaleValue)
FROM
	Manufacturer M,
	Item I,
	Salesman S,
	(SELECT 
		I.ManfCode,
		S.SalesManCode,
		I.ICode,
		SS.SubAreaCode,
		SL.CustCode,
		SaleValue = SUM(SD.LooseQty + SD.BonusQty)
	FROM
		SaleLedger SL,
		SaleDetail SD,
		Item I,
		SalesMan S,
		Customer C,
		(SELECT DISTINCT ManfCode, SalesManCode, SubAreaCode FROM SalesManScope) SS
	WHERE
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.CustCode = C.CustCode AND
		C.SubAreaCode = SS.SubAreaCode AND
		SS.SalesManCode = S.SalesManCode AND
		S.SalesManCode IN (:ai_salesmancode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (:ai_manfcode) AND
		I.ManfCode = SS.ManfCode
	GROUP BY 
		I.ManfCode,
		S.SalesManCode,
		I.ICode,
		SS.SubAreaCode,
		SL.CustCode
	UNION ALL
	SELECT 
		I.ManfCode,
		S.SalesManCode,
		I.ICode,
		SS.SubAreaCode,
		SL.CustCode,
		SaleValue = SUM(SD.LooseQty + SD.BonusQty)
	FROM
		SaleLedger SL,
		SaleInvDetail SD,
		Item I,
		SalesMan S,
		Customer C,
		(SELECT DISTINCT ManfCode, SalesManCode, SubAreaCode FROM SalesManScope) SS
	WHERE
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.CustCode = C.CustCode AND
		C.SubAreaCode = SS.SubAreaCode AND
		SS.SalesManCode = S.SalesManCode AND
		S.SalesManCode IN (:ai_salesmancode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (:ai_manfcode) AND
		I.ManfCode = SS.ManfCode
	GROUP BY 
		I.ManfCode,
		S.SalesManCode,
		I.ICode,
		SS.SubAreaCode,
		SL.CustCode
	UNION ALL
	SELECT 
		I.ManfCode,
		S.SalesManCode,
		I.ICode,
		SS.SubAreaCode,
		SL.CustCode,
		SaleValue = - SUM(SD.LooseQty + SD.BonusQty)
	FROM
		SRLedger SL,
		SRDetail SD,
		Item I,
		SalesMan S,
		Customer C,
		(SELECT DISTINCT ManfCode, SalesManCode, SubAreaCode FROM SalesManScope) SS
	WHERE
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.CustCode = C.CustCode AND
		C.SubAreaCode = SS.SubAreaCode AND
		SS.SalesManCode = S.SalesManCode AND
		S.SalesManCode IN (:ai_salesmancode) AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (:ai_manfcode) AND
		I.ManfCode = SS.ManfCode
	GROUP BY 
		I.ManfCode,
		S.SalesManCode,
		I.ICode,
		SS.SubAreaCode,
		SL.CustCode) T
WHERE
	T.ManfCode = M.ManfCode AND
	T.ICode = I.ICode AND
	T.SalesManCode = S.SalesManCode
GROUP BY
	M.Name,
	I.CustomICode,
	I.Name,
	S.Name
"
  arguments=(("ai_salesmancode", numberlist), ("ai_manfcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="manufacturer A, itemname A, aliasname A"
)
