table(column=(type=char(11) updatewhereclause=yes name=invtype dbname="invtype"  )
column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="patientcode"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=cp dbname="Customer.cp"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Customer.address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Customer.address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="Customer.city"  )
column=(type=decimal(6) updatewhereclause=yes name=netamount dbname="netamount"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
column=(type=char(60) updatewhereclause=yes name=rank dbname="Rank"  )
column=(type=char(60) updatewhereclause=yes name=relation dbname="Relation"  )
 retrieve="SELECT 
	invtype='Sale',
	invcode     = dbo.saleledger.saleinvcode,    
	date        = dbo.saleledger.date,
	patientcode = Max(dbo.saleledger.patientcode),
	dbo.accounts.name, 
	dbo.customer.cp, 
	dbo.customer.address1,
	dbo.customer.address2, 
	dbo.customer.city,
	netamount = 
		Round(
			SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) *
			(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) + 
				saleledger.misccharges + saleledger.salestax - saleledger.flatdisc, 0) +
		Round(
			SUM( (saledetail.looseqty + saledetail.bonusqty) * saledetail.unitsalestax) + 
			SUM(ROUND( (saledetail.looseqty * 
			  (saledetail.saleprice - saledetail.itemflatdisc)) *
			  (1 - (.01 * saledetail.discperc)) * saledetail.gstperc * .01, 2)) +
			ROUND( (SUM((saledetail.looseqty * 
				(saledetail.saleprice - saledetail.itemflatdisc)) *
				(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) -
				saleledger.flatdisc) * (saleledger.invgstperc1 * .01), 2), 0),
	regno = dbo.Patient.RegNo,
	patientname = Patient.name,
	Rank = (Select dbo.rank.name From dbo.Rank Where dbo.patient.rankcode = dbo.rank.rankcode),
	Relation = (Select dbo.relation.name From dbo.Relation Where dbo.saleledger.relationcode = dbo.relation.relationcode)

FROM 
	dbo.saleledger, 
	dbo.saledetail,   
	dbo.accounts, 
	dbo.customer,
	dbo.Patient	

WHERE 
	dbo.saleledger.custcode  = :al_CustCode and 
	dbo.saleledger.date Between :ad_StartDate and :ad_EndDate and
	dbo.saleledger.salecatcode IN (1, 2, 3) and
	dbo.saleledger.saleinvcode IN (:ai_saleinvno) AND
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
	dbo.saleledger.custcode = dbo.accounts.acccode and	
	dbo.customer.custcode = dbo.saleledger.custcode and
	dbo.saleledger.patientcode = dbo.patient.patientcode

GROUP BY 
	dbo.saleledger.saleinvcode,   
	dbo.saleledger.date,
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.discperc,  
	dbo.saleledger.salestax, 
	dbo.saleledger.invgstperc1,
	dbo.saleledger.salecatcode, 
	dbo.saleledger.patientcode,
	dbo.Patient.RegNo,
	dbo.Patient.Name,
	dbo.saleledger.custrefno,	 
	dbo.saleledger.remarks,
	dbo.patient.rankcode,
	dbo.saleledger.relationcode,
	dbo.accounts.name,	
	dbo.customer.cp,
	dbo.customer.address1,
	dbo.customer.address2,
	dbo.customer.city
UNION ALL
SELECT 
	invtype='Sale',
	invcode     = dbo.saleledger.saleinvcode,    
	date        = dbo.saleledger.date,
	patientcode = Max(dbo.saleledger.patientcode),
	dbo.accounts.name, 
	dbo.customer.cp, 
	dbo.customer.address1,
	dbo.customer.address2,
	dbo.customer.city,
	netamount = 
		Round(
			SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) *
			(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) + 
				saleledger.misccharges + saleledger.salestax - saleledger.flatdisc, 0) +
		Round(
			SUM( (saledetail.looseqty + saledetail.bonusqty) * saledetail.unitsalestax) + 
			SUM(ROUND( (saledetail.looseqty * 
			  (saledetail.saleprice - saledetail.itemflatdisc)) *
			  (1 - (.01 * saledetail.discperc)) * saledetail.gstperc * .01, 2)) +
			ROUND( (SUM((saledetail.looseqty * 
				(saledetail.saleprice - saledetail.itemflatdisc)) *
				(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) -
				saleledger.flatdisc) * (saleledger.invgstperc1 * .01), 2), 0),
	regno = dbo.Patient.RegNo,
	patientname = Patient.name,
	Rank = (Select dbo.rank.name From dbo.Rank Where dbo.patient.rankcode = dbo.rank.rankcode),
	Relation = (Select dbo.relation.name From dbo.Relation Where dbo.saleledger.relationcode = dbo.relation.relationcode)

FROM 
	dbo.saleledger, 
	dbo.saleinvdetail saledetail, 
	dbo.accounts, 
	dbo.customer,
	dbo.Patient	

WHERE 
	DBO.SaleLedger.impactinventory = 'N' AND
	dbo.saleledger.custcode  = :al_CustCode and 
	dbo.saleledger.date Between :ad_StartDate and :ad_EndDate and
	dbo.saleledger.salecatcode IN (1, 2, 3) and
	dbo.saleledger.saleinvcode IN (:ai_saleinvno) AND
	dbo.saleledger.saleinvcode = saledetail.saleinvcode and  
	dbo.saleledger.custcode = dbo.accounts.acccode and	
	dbo.customer.custcode = dbo.saleledger.custcode and
	dbo.saleledger.patientcode = dbo.patient.patientcode

GROUP BY 
	dbo.saleledger.saleinvcode,   
	dbo.saleledger.date,
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.discperc,  
	dbo.saleledger.salestax, 
	dbo.saleledger.invgstperc1,
	dbo.saleledger.salecatcode, 
	dbo.saleledger.patientcode,
	dbo.Patient.RegNo,
	dbo.Patient.Name,
	dbo.saleledger.custrefno,	 
	dbo.saleledger.remarks,
	dbo.patient.rankcode,
	dbo.saleledger.relationcode,
	dbo.accounts.name,	
	dbo.customer.cp,
	dbo.customer.address1,
	dbo.customer.address2,
	dbo.customer.city
	
UNION ALL
SELECT 
	invtype='Sale Return',
	invcode     =  srledger.srinvcode,    
	date        =  srledger.date,
	patientcode = Max( srledger.patientcode),
	 accounts.name, 
	 customer.cp, 
	 customer.address1,
	 customer.address2, 
	 customer.city,
	netamount = dbo.fn_getsrinvtotal(srledger.srinvcode),
	regno =  Patient.RegNo,
	patientname = Patient.name,
	Rank = (Select  rank.name From  Rank Where  patient.rankcode =  rank.rankcode),
	Relation = (Select  relation.name From  Relation Where Patient.relationcode =  relation.relationcode)

FROM 
	 srledger, 
	 srdetail,   
	 accounts, 
	 customer,
	 Patient	

WHERE 
	 srledger.custcode  = :al_CustCode and 
	 srledger.date Between :ad_StartDate and :ad_EndDate and
	/* srledger.srinvcode IN (:ai_saleinvno) AND*/
	 srledger.srinvcode =  srdetail.srinvcode and  
	 srledger.custcode =  accounts.acccode and	
	 customer.custcode =  srledger.custcode and
	 srledger.patientcode =  patient.patientcode

GROUP BY 
	 srledger.srinvcode,   
	 srledger.date,
	 srledger.misccharges,   
	 srledger.flatdisc,   
	 srledger.discperc,  
	 srledger.salestax, 
	 srledger.invgstperc1,
	 srledger.srcatcode, 
	 srledger.patientcode,
	 Patient.RegNo,
	 Patient.Name,
	 srledger.custrefno,	 
	 srledger.remarks,
	 patient.rankcode,
	 patient.relationcode,
	 accounts.name,	
	 customer.cp,
	 customer.address1,
	 customer.address2,
	 customer.city


ORDER BY
	RegNo,
	invtype,
	Relation,
	Date,
	InvCode
"
  arguments=(("al_Custcode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_saleinvno", numberlist))
 sort="regno A, invtype A, if(isNumber( regno ), long( regno ), 0) A, relation A, date A, invcode A"
)
