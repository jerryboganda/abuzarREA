table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=invoiceage dbname="InvoiceAge"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=char(100) updatewhereclause=yes name=custrefno2 dbname="custrefno2"  )
column=(type=char(100) updatewhereclause=yes name=custrefno3 dbname="custrefno3"  )
column=(type=char(100) updatewhereclause=yes name=custrefno4 dbname="custrefno4"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(60) updatewhereclause=yes name=saletype dbname="saletype"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="invtotal"  )
column=(type=decimal(2) updatewhereclause=yes name=returnamt dbname="ReturnAmt"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="accountfor"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="doctor"  )
column=(type=char(1) updatewhereclause=yes name=impactinventory dbname="impactinventory"  )
 retrieve="SELECT
	invcode = SL.saleinvcode,    
	Type     = 'S', 
	date       = SL.date,    
	InvoiceAge = ISNULL(DATEDIFF(dd, SL.date, :ar_EndDate), 0),
	custrefno = SL.custrefno,
	custrefno2 = SL.custrefno2,
	custrefno3 = SL.custrefno3,
	custrefno4 = SL.custrefno4,
	remarks = SL.remarks,
	saletype = (Select name from saletype where saletypecode = SL.saletypecode ),
	doctype 	= Case SL.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
	/*invtotal = dbo.fn_getsaleinvtotal(SL.saleinvcode),*/
	invtotal = SL.invtotal,
	ReturnAmt = ISNULL((SELECT SUM(SR.InvTotal) FROM SRLedger SR WHERE SR.SaleInvCode = SL.SaleInvcode), 0),
	AliasName=AC.aliasname,
	CustomerName=AC.name,
	Address1 = C.Address1,
	Address2 = C.Address2,
	City = C.City,
	accountfor=SL.accountfor,
	doctor=(select name from doctors where doctors.doctcode=SL.doctcode),
	impactinventory=SL.impactinventory
FROM DBO.SaleLedger SL, DBO.Accounts AC, DBO.Users U, Customer C
WHERE 
	( SL.custcode = :ai_custcode ) and  
	( SL.date between :ar_StartDate and :ar_EndDate)  And
	( SL.custcode = AC.acccode ) and  
	( AC.AccCode = C.CustCode ) AND
	( SL.salesmancode = U.usercode )
"
  arguments=(("ai_custcode", number), ("ar_StartDate", datetime), ("ar_EndDate", datetime))
 sort="type D, invcode A"
)
