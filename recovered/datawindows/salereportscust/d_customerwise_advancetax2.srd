table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=char(100) updatewhereclause=yes name=taxcategory dbname="TaxCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxperc dbname="AdvanceTaxPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxamt dbname="AdvanceTaxAmt"  )
 retrieve="SELECT
	AliasName = T.AliasName,
	CustomerName=T.CustomerName,
	NTN = T.NTN,
	NetAmount=SUM(T.NetAmount),
	TaxCategory = T.TaxCategory,
	AdvanceTaxPerc = T.AdvanceTaxPerc,
	AdvanceTaxAmt = SUM(T.AdvanceTaxAmt)
FROM
	(SELECT 
		TType='Sales',
		Date=P.Date,
		InvoiceCode='SV-' + LTRIM(RTRIM(STR(P.SaleInvCode, 10))),
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		NetAmount=P.InvTotal,
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		AdvanceTaxAmt = P.AdvanceTaxAmt
	FROM
		SaleLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust=0 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode IN (:ai_Custcode) AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	UNION ALL
	SELECT 
		TType='Sales Return',
		Date=P.Date,
		InvoiceCode='SR-' + LTRIM(RTRIM(STR(P.SRInvCode, 10))),
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		NetAmount= - P.InvTotal,
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		AdvanceTaxAmt = - P.AdvanceTaxAmt
	FROM
		SRLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust=0 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode IN (:ai_Custcode) AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	UNION ALL
	SELECT 
		TType='Sales',
		Date=P.Date,
		InvoiceCode='SV-' + LTRIM(RTRIM(STR(P.SaleInvCode, 10))),
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		NetAmount=P.InvTotal,
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		AdvanceTaxAmt = P.AdvanceTaxAmt
	FROM
		CRS_SaleLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust=0 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode IN (:ai_Custcode) AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	UNION ALL
	SELECT 
		TType='Sales Return',
		Date=P.Date,
		InvoiceCode='SR-' + LTRIM(RTRIM(STR(P.SRInvCode, 10))),
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		NetAmount= - P.InvTotal,
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		AdvanceTaxAmt = - P.AdvanceTaxAmt
	FROM
		CRS_SRLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust=0 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode IN (:ai_Custcode) AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	UNION ALL
	SELECT 
		TType='Sales',
		Date=P.Date,
		InvoiceCode='SV-' + LTRIM(RTRIM(STR(P.SaleInvCode, 10))),
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		NetAmount=P.InvTotal,
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		AdvanceTaxAmt = P.AdvanceTaxAmt
	FROM
		SaleLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust=1 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	UNION ALL
	SELECT 
		TType='Sales Return',
		Date=P.Date,
		InvoiceCode='SR-' + LTRIM(RTRIM(STR(P.SRInvCode, 10))),
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		NetAmount= - P.InvTotal,
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		AdvanceTaxAmt = - P.AdvanceTaxAmt
	FROM
		SRLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust=1 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	UNION ALL
	SELECT 
		TType='Sales',
		Date=P.Date,
		InvoiceCode='SV-' + LTRIM(RTRIM(STR(P.SaleInvCode, 10))),
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		NetAmount=P.InvTotal,
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		AdvanceTaxAmt = P.AdvanceTaxAmt
	FROM
		CRS_SaleLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust=1 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	UNION ALL
	SELECT 
		TType='Sales Return',
		Date=P.Date,
		InvoiceCode='SR-' + LTRIM(RTRIM(STR(P.SRInvCode, 10))),
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		NetAmount= - P.InvTotal,
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		AdvanceTaxAmt = - P.AdvanceTaxAmt
	FROM
		CRS_SRLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust=1 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode) T
GROUP BY
	T.AliasName,
	T.CustomerName,
	T.NTN,
	T.TaxCategory,
	T.AdvanceTaxPerc"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_custcode", numberlist), ("ai_allcust", number))
 sort="customername A"
)
