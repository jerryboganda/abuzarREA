footer(height=239 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=grouping dbname="grouping"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(30) updatewhereclause=yes name=refno dbname="refNo"  )
column=(type=char(60) updatewhereclause=yes name=ward dbname="Ward"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="class"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(0) updatewhereclause=yes name=utn dbname="utn"  )
 retrieve="SELECT  
		 grouping=1,
		 Date = CAST(CONVERT(VARCHAR(100), dbo.saleledger.Date, 111) AS DATETIME),
		 refNo = dbo.saleledger.custrefno,
		 Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode=dbo.saleledger.wardcode),
		 itemname = item.name,
		 packing = dbo.item.packingdesc,
		 class = dbo.itemclass.name,
		 looseqty = Sum (dbo.saledetail.looseqty),
		 price = max(dbo.saledetail.saleprice),
		 utn = max(dbo.saledetail.saleutn)
FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item, 
		 dbo.Customer,
		 dbo.Accounts,
		 dbo.ItemClass
WHERE  
		 :as_doctype = 'originaldate' AND
		 dbo.saleledger.originaldate >= :ad_StartDate AND
		 dbo.saleledger.originaldate <= :ad_EndDate  AND 
		 dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		 dbo.saledetail.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode AND
		 dbo.Item.iccode = dbo.itemclass.iccode
Group by 
		dbo.saleledger.Date, 
		dbo.saleledger.custrefno,
		dbo.saleledger.wardcode,
		dbo.saledetail.icode,
		dbo.item.name,
		dbo.item.packingdesc,
		dbo.itemclass.name
UNION ALL
SELECT 
		 grouping=1,
		 Date = CAST(CONVERT(VARCHAR(100), dbo.saleledger.Date, 111) AS DATETIME),
		 refNo = dbo.saleledger.custrefno,
		 Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode=dbo.saleledger.wardcode),
		 itemname = item.name,
		 packing = dbo.item.packingdesc,
		 class = dbo.itemclass.name,
		 looseqty = Sum (sd.looseqty),
		 price = max(sd.saleprice),
		 utn = max(sd.saleutn)
FROM 	 dbo.saleledger, 
		 dbo.saleinvdetail sd,    
		 dbo.item, 
		 dbo.Customer,
		 dbo.Accounts,
		 dbo.ItemClass 
WHERE  DBO.SaleLedger.impactinventory = 'N' AND
		 :as_doctype = 'originaldate' AND
		 dbo.saleledger.originaldate >= :ad_StartDate AND
		 dbo.saleledger.originaldate <= :ad_EndDate  AND 
		 dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = sd.saleinvcode AND
		 sd.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode AND
		 dbo.Item.iccode = dbo.itemclass.iccode
Group by 
		dbo.saleledger.Date, 
		dbo.saleledger.custrefno,
		dbo.saleledger.wardcode,
		sd.icode,
		dbo.item.name,
		dbo.item.packingdesc,
		dbo.itemclass.name
UNION
SELECT 
		 grouping=1,
		 Date = CAST(CONVERT(VARCHAR(100), dbo.saleledger.Date, 111) AS DATETIME),
		 refNo = dbo.saleledger.custrefno,
		 Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode=dbo.saleledger.wardcode),
		 itemname = item.name,
		 packing = dbo.item.packingdesc,
		 class = dbo.itemclass.name,
		 looseqty = Sum (dbo.saledetail.looseqty),
		 price = max(dbo.saledetail.saleprice),
		 utn = max(dbo.saledetail.saleutn)
FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item, 
		 dbo.Customer,
		 dbo.Accounts,
		 dbo.itemclass
WHERE  
		 :as_doctype = 'billingdate' AND
		 dbo.saleledger.billingdate >= :ad_StartDate AND
		 dbo.saleledger.billingdate <= :ad_EndDate  AND 
		 dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		 dbo.saledetail.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode AND
		 dbo.Item.iccode = dbo.itemclass.iccode
Group by 
		dbo.saleledger.Date, 
		dbo.saleledger.custrefno,
		dbo.saleledger.wardcode,
		dbo.saledetail.icode,
		dbo.item.name,
		dbo.item.packingdesc,
		dbo.itemclass.name
UNION ALL
SELECT 
		 grouping=1,
		 Date = CAST(CONVERT(VARCHAR(100), dbo.saleledger.Date, 111) AS DATETIME),
		 refNo = dbo.saleledger.custrefno,
		 Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode=dbo.saleledger.wardcode),
		 itemname = item.name,
		 packing = dbo.item.packingdesc,
		 class = dbo.itemclass.name,
		 looseqty = Sum (sd.looseqty),
		 price = max(sd.saleprice),
