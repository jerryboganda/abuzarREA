release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1072 color="536870912" )
header[2](height=354 color="536870912" )
summary(height=197 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
column=(type=number updatewhereclause=yes name=value dbname="value"  )
 retrieve="SELECT 
	Customer = A.Name,
	Date = S.Date,
	ItemCategory = IC.Name,
	Value = SUM(S.Value)
FROM
	Customer C,
	Accounts A,
	ItemCategory IC,
	(SELECT 
		S.CustCode, 
		Date = CAST(STR(DATEPART(mm, S.Date)) +'-01-' +STR(DATEPART(yy, S.Date)) AS DATETIME),
		I.ICatCode, 
		Value = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM 
		SaleLedger S, SaleDetail D, Item I
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SaleInvCode = D.SaleInvCode AND
		S.CustCode IN (:ai_custcode) AND
		D.ICode = I.ICode AND
		I.ICatCode IN (:ai_icatcode)
	GROUP BY
		S.CustCode, 
		S.Date,
		I.ICatCode
	UNION ALL
	SELECT 
		S.CustCode, 
		Date = CAST(STR(DATEPART(mm, S.Date)) +'-01-' +STR(DATEPART(yy, S.Date)) AS DATETIME),
		I.ICatCode, 
		Value = - SUM(D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM 
		SRLedger S, SRDetail D, Item I
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SRInvCode = D.SRInvCode AND
		S.CustCode IN (:ai_custcode) AND
		D.ICode = I.ICode AND
		I.ICatCode IN (:ai_icatcode)
	GROUP BY
		S.CustCode, 
		S.Date,
		I.ICatCode
	UNION ALL
	SELECT 
		C.CustCode, 
		Date = CAST(STR(DATEPART(mm, :adt_startdate)) +'-01-' +STR(DATEPART(yy, :adt_startdate)) AS DATETIME),
		I.ICatCode, 
		Value = NULL
	FROM 
		Customer C, Item I
	WHERE
		C.CustCode IN (:ai_custcode) AND
		I.ICatCode IN (:ai_icatcode)) S
WHERE
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	S.ICatCode = IC.ICatCode
GROuP BY
	A.Name,
	IC.Name,
	S.Date
"
  arguments=(("ai_custcode", numberlist), ("ai_icatcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="itemcategory A"
)
