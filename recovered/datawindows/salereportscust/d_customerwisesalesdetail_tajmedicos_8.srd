header(height=0 )
summary(height=0 color="536870912" )
footer(height=1016 color="536870912" )
detail(height=183 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=manufacurer dbname="manufacurer"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="itempacking"  )
column=(type=char(1) updatewhereclause=yes name=claim dbname="claim"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=char(50) updatewhereclause=yes name=taxregno dbname="taxregno"  )
column=(type=char(20) updatewhereclause=yes name=custpostcode dbname="custpostcode"  )
column=(type=char(60) updatewhereclause=yes name=custdesignation dbname="custdesignation"  )
column=(type=long updatewhereclause=yes name=id dbname="ID"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=char(60) updatewhereclause=yes name=custadd dbname="custadd"  )
column=(type=char(60) updatewhereclause=yes name=custadd2 dbname="custadd2"  )
column=(type=char(100) updatewhereclause=yes name=custphone dbname="custphone"  )
column=(type=char(100) updatewhereclause=yes name=custfax dbname="custfax"  )
column=(type=char(60) updatewhereclause=yes name=custemail dbname="custemail"  )
 retrieve="SELECT 
		saleinvcode=saleledger.saleinvcode,
		remarks=saleledger.remarks,
		date=max(saleledger.date),
		headerno=max(saleledger.headerno),	
		itemname = item.name, 
		 manufacurer = max(dbo.manufacturer.name),
		 itempacking = max(dbo.itempacking.name),
		 claim = Max(dbo.saledetail.claimable),	 		
		 looseqty = Sum (dbo.saledetail.looseqty),
		 price = Max (dbo.saledetail.saleprice),
		 taxregno=max(customer.salestaxregno),
		 custpostcode=max(customer.postcode),
		 custdesignation=max(customer.designation),
		 ID = MAX(dbo.saledetail.rowid),
		 customername=accounts.name,
		 custadd=max(customer.address1),
		 custadd2=max(customer.address2),
		custphone=max(customer.phone),
		custfax=max(customer.fax),
		custemail=max(customer.email)
			
		
FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item, 
		 dbo.itempacking,
		 dbo.Customer,
		 dbo.Manufacturer ,
		 accounts
WHERE saleledger.saleinvcode>= :al_sinvcode AND
			saleledger.saleinvcode<= :al_linvcode AND
			dbo.saleledger.custcode = :al_custcode AND
		 saleledger.custcode=accounts.acccode AND
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		 dbo.saledetail.icode = item.icode AND
		 dbo.item.packcode = dbo.itempacking.packcode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.Item.manfcode = dbo.manufacturer.manfcode
GROUP BY saleledger.saleinvcode, 
			saleledger.date, 
			/*saleledger.headerno,*/
			saleledger.custcode, 
			saleledger.discperc, 
			saleledger.flatdisc, 
			saleledger.misccharges, 
			saleledger.salestax, 
			saleledger.remarks,
			saleledger.custrefno, 
			saledetail.icode,
			saledetail.rowgroup, 
			saledetail.gcode, 
			item.name,
			item.icode,
			item.printable, 
			accounts.name
			
ORDER BY 
			saleledger.saleinvcode,
			MAX(dbo.saledetail.IDENTITYCOL)


"
  arguments=(("al_CustCode", number), ("al_sinvcode", number), ("al_linvcode", number), ("ad_discperc", number), ("as_caption1", string), ("as_caption2", string), ("as_caption3", string))
)
