release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=500 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2041 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(15) updatewhereclause=yes name=type dbname="type"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CUSTOMERNAME"  )
column=(type=char(12) updatewhereclause=yes name=custaliasname dbname="custaliasname"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="area"  )
 retrieve="select 
	B.date, 
	B.type,
	B.custcode,
	CUSTOMERNAME=(select name from accounts where acccode=B.custcode),
	custaliasname=(select aliasname from accounts where acccode=B.custcode),
	area=(select name from area,customer where  customer.custcode=B.custcode and Customer.areacode=area.areacode)

from (	

	SELECT A.DATE,
		A.CUSTCODE,
		A.TYPE
	FROM customer C,
			(select  distinct(custcode),
				type='S-'+ convert(varchar(12),saleinvcode),
				date=date
			from saleledger
			where date<:ad_StartDate
			union all
			select  distinct(custcode),
				type='SR-'+ convert(varchar(12),srinvcode),
				date=date
			from srledger
			where date<:ad_StartDate 

			) AS A


	WHERE A.custcode NOT IN

				(

					select  distinct(custcode)
					from saleledger
					where date>=:ad_StartDate and
						date<=:ad_EndDate
					union all
					select  distinct(custcode)
					from srledger
					where date>=:ad_StartDate and
						date<=:ad_EndDate

					) AND

 		A.custcode=C.custcode AND
     		C.areacode IN (:aa_areacode)


	) AS B









where B. date IN (select max(K.date) from  (
					   SELECT A.DATE,
						A.CUSTCODE,
						A.TYPE
					   FROM customer C,
							(select  distinct(custcode),
									type='S-'+ convert(varchar(12),saleinvcode),
									date=date
							from saleledger
							where date<:ad_StartDate
							union all
							select  distinct(custcode),
								type='SR-'+ convert(varchar(12),saleinvcode),
								date=date
							from srledger
							where date<:ad_StartDate 

							) AS A


					WHERE A.custcode NOT IN

								(

								select  distinct(custcode)
	
								from saleledger
								where date>=:ad_StartDate and
									date<=:ad_EndDate
								union all
								select  distinct(custcode)
								from srledger
								where date>=:ad_StartDate and
								date<=:ad_EndDate

							)

						AND A.custcode=C.custcode AND
    					 	    C.areacode IN (:aa_areacode)

						) AS K
				GROUP BY K.custcode
			)
ORDER BY 
	area,
	customername
"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("aa_areacode", numberlist))
)
