table(column=(type=char(20) updatewhereclause=yes name=customercategory dbname="customercategory"  )
column=(type=char(20) updatewhereclause=yes name=customeralias dbname="customeralias"  )
column=(type=char(20) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(20) updatewhereclause=yes name=saletype dbname="saletype"  )
column=(type=decimal(0) updatewhereclause=yes name=discount dbname="discount"  )
column=(type=decimal(0) updatewhereclause=yes name=netsale dbname="netsale"  )
 retrieve="SELECT 
	CustomerCategory=Name1, 
	CustomerAlias=Name2, 
	Customer=Name3, 
	SaleType=Name4,
	Date=Date1, 
	NetSale=Value1,	
	Discount=Value2
FROM 
	ReportData
ORDER BY 
	Name1, Name2, Name3, Date1"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="customercategory A, customeralias A, customer A, saletype A, discount A"
)
