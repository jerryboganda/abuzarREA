table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=char(100) updatewhereclause=yes name=customerref dbname="CustomerRef"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(60) updatewhereclause=no name=doctor dbname="doctor"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=char(30) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=long updatewhereclause=yes name=rowid dbname="rowid"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=person dbname="Person"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="phone"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="invtotal"  )
column=(type=decimal(6) updatewhereclause=yes name=invnettotal dbname="invnettotal"  )
 retrieve="SELECT 
	saleinvcode = dbo.saleledger.saleinvcode,
	CustomerRef = dbo.saleledger.CustRefNo, 
	date        = CASE lower(:as_datetype)  
								When 'originaldate' Then dbo.saleledger.originaldate 
								When 'lastsavingdate' Then dbo.saleledger.date
								When 'billingdate' Then dbo.saleledger.billingdate
						  End ,    
	invdiscperc = dbo.saleledger.discperc,    
	flatdisc = dbo.saleledger.flatdisc,    
	misccharges = dbo.saleledger.misccharges, 
	invsalestax = dbo.saleledger.salestax,
	remarks = dbo.saleledger.remarks,
	custcode = dbo.saleledger.custcode,
	doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode=dbo.saleledger.doctcode),
	manufacturer = max(dbo.manufacturer.name),
	looseqty = sum(dbo.saledetail.looseqty), 
	bonusqty = sum(dbo.saledetail.bonusqty), 
	itemflatdisc=max(dbo.saledetail.itemflatdisc),
	unitsalestax = max(dbo.saledetail.unitsalestax),
	gstperc = max(dbo.saledetail.gstperc),
	packqty  = sum(saledetail.packqty),  
	packing = case when dbo.item.packcode IS null Then space(30) else max(dbo.itempacking.name) end,
	 price =max( dbo.saledetail.saleprice),    
	 itemdiscperc = max(dbo.saledetail.discperc),    
	 packunits = max(dbo.saledetail.packunits),    
	 batch = max(dbo.saledetail.batch),    
	 expiry = max(dbo.saledetail.expiry),    
	 salestax  =max( saledetail.salestax),
	 rowid     = max(saledetail.rowid),
	 itemname = CASE max(SaleDetail.Claimable) When 'Y' THEN max(dbo.itempacking.name) Else item.name END,
	 itemalias = max(item.customicode),
	 datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), 
	 Person = dbo.accounts.name ,
	 address1 =max( dbo.customer.address1),
	 address2 = max(dbo.customer.address2),
	 city = max(dbo.customer.city),
	 phone = max(dbo.customer.phone), 	
	doctype = Case max(dbo.saleledger.salecatcode) When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End,
	invtotal = max(dbo.saleledger.invtotal),
	 invnettotal= (SELECT 
					  amountfg = Round( 
											 Sum (  SD.looseqty *  SD.saleprice)    
											 -  Round(Sum (Round((  SD.looseqty  * ( SD.saleprice -  SD.itemflatdisc) * ( SD.discperc * .01)) + ( SD.looseqty  *  SD.itemflatdisc),2)), 2)    
											 - Round(Sum (  SD.looseqty   * ( SD.saleprice  -  SD.itemflatdisc) * (1 - ( SD.discperc * .01))) * ( SL.discperc /100), 2)
											 + misccharges - flatdisc,0)
		
			 FROM dbo.saleledger SL , 
					dbo.saledetail SD

			 WHERE  (SL.saleinvcode = dbo.saleledger.saleinvcode )   and
					  (SL.saleinvcode = SD.saleinvcode )   
		
			 GROUP BY SL.saleinvcode,   
						 SL.misccharges,   
						 SL.flatdisc,   
						 SL.discperc,  
						 SL.salestax 
		)


FROM 	 
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item LEFT OUTER JOIN dbo.itempacking  ON (dbo.item.packcode = dbo.itempacking.packcode), 
	dbo.manufacturer,
	dbo.accounts,
	dbo.customer
WHERE 
	CASE lower(:as_datetype) 
		When 'originaldate' Then dbo.saleledger.originaldate 
		When 'lastsavingdate' Then dbo.saleledger.date
		When 'billingdate' Then dbo.saleledger.billingdate
	End Between :ad_startdate AND :ad_enddate AND
	dbo.saleledger.custcode IN (:al_custcode) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) and
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
	dbo.saledetail.icode = item.icode and 
	item.manfcode = manufacturer.manfcode and
	dbo.saleledger.custcode = dbo.accounts.acccode and
	dbo.accounts.acccode = dbo.customer.custcode
GROUP BY 
	saleledger.saleinvcode, 
	saleledger.date, 
	saleledger.originaldate,
	saleledger.billingdate,
	/*saleledger.headerno,*/
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	dbo.saleledger.doctcode,
	saleledger.salestax, 
	saleledger.remarks,
	saleledger.custrefno, 
	saledetail.icode,
	saledetail.rowgroup, 
	saledetail.gcode, 
	item.name,
	item.packcode,
	item.icode,
	item.printable, 
	accounts.name
UNION ALL
SELECT 
	saleinvcode = dbo.saleledger.saleinvcode,
	CustomerRef = dbo.saleledger.CustRefNo, 
	date        = CASE lower(:as_datetype)  
								When 'originaldate' Then dbo.saleledger.originaldate 
								When 'lastsavingdate' Then dbo.saleledger.date
								When 'billingdate' Then dbo.saleledger.billingdate
						  End ,    
	invdiscperc = dbo.saleledger.discperc,    
	flatdisc = dbo.saleledger.flatdisc,    
	misccharges = dbo.saleledger.misccharges, 
	invsalestax = dbo.saleledger.salestax,
	remarks = dbo.saleledger.remarks,
	custcode = dbo.saleledger.custcode,
	doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode=dbo.saleledger.doctcode),
	manufacturer = max(dbo.manufacturer.name),
	looseqty = sum(saledetail.looseqty), 
	bonusqty = sum(saledetail.bonusqty), 
	itemflatdisc=max(saledetail.itemflatdisc),
	unitsalestax = max(saledetail.unitsalestax),
	gstperc = max(saledetail.gstperc),
	packqty  = 0,  
	packing = case when dbo.item.packcode IS null Then space(30) else max(dbo.itempacking.name) end,
	price =max( saledetail.saleprice),    
	itemdiscperc = max(saledetail.discperc),    
	packunits = max(saledetail.packunits),    
	batch = max(saledetail.batch),    
	expiry = max(saledetail.expiry),    
	salestax  =0,
	rowid     = max(saledetail.rowid),
	itemname = item.name,
	itemalias = max(item.customicode),
	datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), 
	Person = dbo.accounts.name ,
	address1 =max( dbo.customer.address1),
	address2 = max(dbo.customer.address2),
	city = max(dbo.customer.city),
	phone = max(dbo.customer.phone), 	
	doctype = Case max(dbo.saleledger.salecatcode) When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End,
	invtotal = max(dbo.saleledger.invtotal),
	invnettotal= (SELECT 
					  amountfg = Round( 
											 Sum (  SD.looseqty *  SD.saleprice)    
											 -  Round(Sum (Round((  SD.looseqty  * ( SD.saleprice -  SD.itemflatdisc) * ( SD.discperc * .01)) + ( SD.looseqty  *  SD.itemflatdisc),2)), 2)    
											 - Round(Sum (  SD.looseqty   * ( SD.saleprice  -  SD.itemflatdisc) * (1 - ( SD.discperc * .01))) * ( SL.discperc /100), 2)
											 + misccharges - flatdisc,0)
		
			 FROM dbo.saleledger SL , 
					dbo.saleinvdetail SD

			 WHERE  (SL.saleinvcode = dbo.saleledger.saleinvcode )   and
					  (SL.saleinvcode = SD.saleinvcode )   
		
			 GROUP BY SL.saleinvcode,   
						 SL.misccharges,   
						 SL.flatdisc,   
						 SL.discperc,  
						 SL.salestax 
		)
FROM
	dbo.saleledger, 
	dbo.saleinvdetail saledetail,    
	dbo.item LEFT OUTER JOIN dbo.itempacking  ON (dbo.item.packcode = dbo.itempacking.packcode), 
	dbo.manufacturer,
	dbo.accounts,
	dbo.customer
WHERE  
	DBO.SaleLedger.impactinventory = 'N' AND 
	CASE lower(:as_datetype) 
		When 'originaldate' Then dbo.saleledger.originaldate 
		When 'lastsavingdate' Then dbo.saleledger.date
		When 'billingdate' Then dbo.saleledger.billingdate
	End Between :ad_startdate AND :ad_enddate AND
	dbo.saleledger.custcode IN (:al_custcode) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) and
	dbo.saleledger.saleinvcode = saledetail.saleinvcode and  
	saledetail.icode = item.icode and 
	item.manfcode = manufacturer.manfcode and
	dbo.saleledger.custcode = dbo.accounts.acccode and
	dbo.accounts.acccode = dbo.customer.custcode
GROUP BY 
	saleledger.saleinvcode,       
	saleledger.date, 
	saleledger.originaldate,
	saleledger.billingdate,
	/*saleledger.headerno,*/
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	dbo.saleledger.doctcode,
	saleledger.salestax, 
	saleledger.remarks,
	saleledger.custrefno, 
	saledetail.icode,
	saledetail.rowgroup, 
	saledetail.gcode, 
	item.name,
	item.packcode,
	item.icode,
	item.printable, 
	accounts.name
ORDER BY 	
	person,
	saleinvcode,
	rowid"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("ai_suppressheader", number), ("as_caption", string), ("as_term1", string), ("as_term2", string), ("as_datetype", string))
 sort="person A, saleinvcode A, rowid A"
)
