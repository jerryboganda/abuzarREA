release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=500 print.margin.right=0 print.margin.top=0 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1072 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(12) updatewhereclause=yes name=custalia dbname="custalia"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=decimal(6) updatewhereclause=yes name=invtotal dbname="invtotal"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="customercategory"  )
 retrieve="select
	custalia=A.custalias,
	customer=A.customer,
	invtotal=ISNULL(sum(A.netamount),0),
	customercategory=(select name from customercategory where custcatcode=A.Custcatcode)
from

(
	SELECT  	saleinvcode=SL.saleinvcode,
				customer=(select name from accounts where acccode=C.custCode),
				CustAlias=(select aliasname from accounts where acccode=C.custCode),
				custcode=C.custcode,
				Custcatcode=max(C.CustCatCode),
				netamount =  Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc   +   misccharges, 2) 
								+
								Round(Sum (Round (  (SD.looseqty + SD.bonusqty)*   SD.unitsalestax + Round ( Round (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc ) * (1 -   SD.discperc * 0.01 ), 2 ) *   SD.gstperc * 0.01 , 2 ) , 2 ) )
				 				+  
								( (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc ,2) ) * SL.invgstperc1 * 0.01 ), 2)

	FROM Saleledger SL, Saledetail SD, Customer C

	WHERE C.custcatcode IN (:al_custcatcode) AND
			SL.CustCode =C.custcode AND
			SL.date>=:ad_startdate AND SL.date<=:ad_enddate AND
			SL.saleinvcode = SD.saleinvcode 
	GROUP BY	SL.saleinvcode,
			C.custCode,
			SL.flatdisc,
			SL.misccharges,
			SL.discperc,
			SL.invgstperc1) AS A

group by 
	 A.CustCatCode,
	 A.custcode,
	 A.customer,
	 A.custalias
UNION ALL
select
	custalia=A.custalias,
	customer=A.customer,
	invtotal=ISNULL(sum(A.netamount),0),
	customercategory=(select name from customercategory where custcatcode=A.Custcatcode)
from

(
	SELECT  	saleinvcode=SL.saleinvcode,
				customer=(select name from accounts where acccode=C.custCode),
				CustAlias=(select aliasname from accounts where acccode=C.custCode),
				custcode=C.custcode,
				Custcatcode=max(C.CustCatCode),
				netamount =  Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc   +   misccharges, 2) 
								+
								Round(Sum (Round (  (SD.looseqty + SD.bonusqty)*   SD.unitsalestax + Round ( Round (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc ) * (1 -   SD.discperc * 0.01 ), 2 ) *   SD.gstperc * 0.01 , 2 ) , 2 ) )
				 				+  
								( (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc ,2) ) * SL.invgstperc1 * 0.01 ), 2)

	FROM Saleledger SL, Saleinvdetail SD, Customer C

	WHERE C.custcatcode IN (:al_custcatcode) AND
			SL.CustCode =C.custcode AND
			SL.date>=:ad_startdate AND SL.date<=:ad_enddate AND
			SL.saleinvcode = SD.saleinvcode 
	GROUP BY	SL.saleinvcode,
			C.custCode,
			SL.flatdisc,
			SL.misccharges,
			SL.discperc,
			SL.invgstperc1) AS A

group by 
	 A.CustCatCode,
	 A.custcode,
	 A.customer,
	 A.custalias

Order by CustomerCategory, 
	     A.customer






/*select
	custalia=A.custalias,
	customer=A.customer,
	invtotal=ISNULL(sum(A.netamount),0),
	customercategory=(select name from customercategory where custcatcode=A.Custcatcode)
from

(
	SELECT  	saleinvcode=SL.saleinvcode,
				customer=(select name from accounts where acccode=C.custCode),
				CustAlias=(select aliasname from accounts where acccode=C.custCode),
				custcode=C.custcode,
				Custcatcode=max(C.CustCatCode),
				netamount =  Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc   +   misccharges, 2) 
								+
								Round(Sum (Round (  (SD.looseqty + SD.bonusqty)*   SD.unitsalestax + Round ( Round (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc ) * (1 -   SD.discperc * 0.01 ), 2 ) *   SD.gstperc * 0.01 , 2 ) , 2 ) )
				 				+  
								( (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc ,2) ) * SL.invgstperc1 * 0.01 ), 2)

	FROM Saleledger SL, Saledetail SD, Customer C

	WHERE C.custcatcode IN (:al_custcatcode) AND
			SL.CustCode =C.custcode AND
			SL.date>=:ad_startdate AND SL.date<=:ad_enddate AND
			SL.saleinvcode = SD.saleinvcode 
	GROUP BY	SL.saleinvcode,
			C.custCode,
			SL.flatdisc,
			SL.misccharges,
			SL.discperc,
			SL.invgstperc1) AS A

group by 
	 A.CustCatCode,
	 A.custcode,
	 A.customer,
	 A.custalias
Order by CustomerCategory, 
	     A.customer

*/
"
  arguments=(("al_Custcatcode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_caption", string), ("as_term1", string), ("as_term2", string))
)
