release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=640 color="536870912" )
summary(height=152 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=char(60) updatewhereclause=yes name=manfname dbname="manfname"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="customercategory"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(4) updatewhereclause=yes name=returnqty dbname="returnqty"  )
column=(type=decimal(6) updatewhereclause=yes name=netamount dbname="netamount"  )
column=(type=decimal(4) updatewhereclause=yes name=salebonusqty dbname="salebonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=retbonusqty dbname="retbonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
 retrieve="SELECT
	itemname=I.name, 
	itemalias=I.customicode, 
	manfname=M.name,
	customercategory=(Select CC.Name FROM CustomerCategory CC Where CC.custcatcode = :ll_CustcatCode),
	qty=Sum(A.qty),
	returnqty=Sum(A.returnqty),
	netamount=Sum(A.amount),
	salebonusqty=sum(A.salebonusqty),
	retbonusqty=sum(A.retbonusqty),
	Stock=(select isnull(sum(godowndetail.currqty), 0) from godowndetail where godowndetail.icode=I.icode)
FROM
	Item I,
	Manufacturer M,
	(SELECT dbo.saledetail.icode,
		qty= Sum(dbo.saledetail.looseqty),
		returnqty=0,
		salebonusqty=sum(dbo.saledetail.bonusqty),
		retbonusqty=0,
		amount = Round(Sum ( (dbo.saledetail.looseqty + dbo.saledetail.bonusqty) * dbo.saledetail.saleprice), 2),
		dbo.customer.custcatcode
	FROM dbo.saleledger, 
	 	dbo.saledetail, 
		dbo.customer,
	 	dbo.item
	WHERE dbo.saleledger.date >= :ad_StartDate and
	 	dbo.saleledger.date <= :ad_EndDate and
	 	dbo.saleledger.salecatcode IN (1, 2, 3) and
		dbo.customer.custcode = dbo.saleledger.custcode and
		dbo.customer.custcatcode = :ll_custcatcode and
	 	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
	 	dbo.item.manfcode = :ll_manfcode and 
	 	dbo.saledetail.icode = item.icode
	GROUP BY
		saledetail.icode,
		dbo.customer.custcatcode
	UNION ALL
	SELECT sd.icode,
		qty= Sum(sd.looseqty),
		returnqty=0,
		salebonusqty=sum(sd.bonusqty),
		retbonusqty=0,
		amount = Round(Sum ( (sd.looseqty + sd.bonusqty) * sd.saleprice), 2),
		dbo.customer.custcatcode
	FROM dbo.saleledger, 
	 	dbo.saleinvdetail sd, 
		dbo.customer,
	 	dbo.item
	WHERE 
		dbo.saleledger.impactinventory = 'N' AND
		dbo.saleledger.date >= :ad_StartDate and
	 	dbo.saleledger.date <= :ad_EndDate and
	 	dbo.saleledger.salecatcode IN (1, 2, 3) and
		dbo.customer.custcode = dbo.saleledger.custcode and
		dbo.customer.custcatcode = :ll_custcatcode and
	 	dbo.saleledger.saleinvcode = sd.saleinvcode and  
	 	dbo.item.manfcode = :ll_manfcode and 
	 	sd.icode = item.icode
	GROUP BY
		sd.icode,
		dbo.customer.custcatcode
	UNION ALL
	SELECT dbo.srdetail.icode,
	 	qty = 0,
		returnqty=(-1 * Sum(dbo.srdetail.looseqty)),
		salebonusqty=0,
		retbonusqty=(-1 * sum(dbo.srdetail.bonusqty)),
		amount   = (-1 * Round(Sum ( (dbo.srdetail.looseqty + dbo.srdetail.bonusqty) * dbo.srdetail.srprice), 2)),
		dbo.customer.custcatcode
	FROM dbo.srledger, 
		dbo.srdetail,    
		dbo.customer,
		dbo.item
	WHERE dbo.srledger.date >= :ad_StartDate and
		dbo.srledger.date <= :ad_EndDate and
		dbo.srledger.srcatcode IN (6, 7, 8) and
		dbo.customer.custcode = dbo.srledger.custcode and
		dbo.customer.custcatcode = :ll_custcatcode and
		dbo.srledger.srinvcode = dbo.srdetail.srinvcode and  
		dbo.item.manfcode = :ll_manfcode and 
		dbo.srdetail.icode = item.icode 
	GROUP BY 
		srdetail.icode, 
		dbo.customer.custcatcode) AS A
WHERE
	A.icode = I.icode AND I.ManfCode = M.ManfCode
GROUP BY 
	M.name,
	I.name,
	I.customicode,
	I.Icode
ORDER BY
	M.name,
	I.name,
	I.Icode"
  arguments=(("ll_CustCatCode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ll_manfcode", number))
)
