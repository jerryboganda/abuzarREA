release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=300 print.margin.top=0 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1645 color="536870912" )
summary(height=1291 color="536870912" )
footer(height=364 color="536870912" )
detail(height=208 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(60) updatewhereclause=yes name=subcategory dbname="subcategory"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=long updatewhereclause=yes name=id dbname="id"  )
column=(type=decimal(2) updatewhereclause=yes name=cumulativesum dbname="cumulativesum"  )
column=(type=decimal(2) updatewhereclause=yes name=cumulativesumfoot dbname="cumulativesumfoot"  )
 retrieve="SELECT
	date = CAST(CONVERT(VARCHAR(100), A.Date, 111) AS DATETIME),
	itemname=A.itemname,
	packing=A.packing,
	subcategory=A.itemclass,
	looseqty=Sum(A.looseqty),
	price=max(A.price),
	id=max(A.id),
	cumulativesum = round(0.00,2),
	cumulativesumfoot = round(0.00,2)
	
	FROM

	(	SELECT
					 date = 	CASE lower(:as_doctype) 
							When 'originaldate' Then dbo.saleledger.originaldate 
							When 'lastsavingdate' Then dbo.saleledger.date
							When 'billingdate' Then dbo.saleledger.billingdate END,
					 itemname = item.name, 
					 packing = dbo.item.packingdesc,
					 itemclass = (dbo.itemclass.name),
					 looseqty = Sum (dbo.saledetail.looseqty),
					 price = max(dbo.saledetail.saleprice), 
					 id = max(dbo.saledetail.rowid),
					icode=saledetail.icode
					
			FROM dbo.saleledger, 
					 dbo.saledetail,    
					 dbo.item, 
					 dbo.Customer,
					 dbo.Accounts,
					 dbo.itemclass 
			WHERE  
					CASE lower(:as_doctype) 
							When 'originaldate' Then dbo.saleledger.originaldate 
							When 'lastsavingdate' Then dbo.saleledger.date
							When 'billingdate' Then dbo.saleledger.billingdate END >= :ad_StartDate AND
					 CASE lower(:as_doctype) 
							When 'originaldate' Then dbo.saleledger.originaldate 
							When 'lastsavingdate' Then dbo.saleledger.date
							When 'billingdate' Then dbo.saleledger.billingdate  END  <= :ad_EndDate  AND 
					 dbo.saleledger.custcode IN ( :al_custcode ) AND
					 dbo.saleledger.salecatcode IN (1, 2, 3) AND
					 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
					 dbo.saledetail.icode = item.icode AND
					 dbo.saleledger.custcode = dbo.customer.custcode AND
					 dbo.customer.custcode = dbo.accounts.acccode AND
					 dbo.Item.iccode= dbo.itemclass.iccode
			Group by 
					dbo.saleledger.originaldate,
					dbo.saleledger.date ,
					dbo.saleledger.billingdate,
					dbo.saledetail.icode,
					dbo.item.name,
					dbo.item.packingdesc,
					dbo.itemclass.name
			UNION ALL
			SELECT 
					 date = 	CASE lower(:as_doctype) 
							When 'originaldate' Then dbo.saleledger.originaldate 
							When 'lastsavingdate' Then dbo.saleledger.date
							When 'billingdate' Then dbo.saleledger.billingdate END,
					 itemname = item.name,
					 packing = dbo.item.packingdesc,
					 itemclass = (dbo.itemclass.name),
					 looseqty = Sum (sd.looseqty),
					 price = max(sd.saleprice),    
					 id = max(sd.rowid),
					icode=sd.icode
					
			FROM 	 dbo.saleledger, 
					 dbo.saleinvdetail sd,    
					 dbo.item, 
					 dbo.Customer,
					 dbo.Accounts,
					 dbo.itemclass 
			WHERE  
					
					dbo.saleledger.impactinventory = 'N' AND
					CASE lower(:as_doctype) 
							When 'originaldate' Then dbo.saleledger.originaldate 
							When 'lastsavingdate' Then dbo.saleledger.date
							When 'billingdate' Then dbo.saleledger.billingdate END >= :ad_StartDate AND
					 CASE lower(:as_doctype) 
							When 'originaldate' Then dbo.saleledger.originaldate 
							When 'lastsavingdate' Then dbo.saleledger.date
							When 'billingdate' Then dbo.saleledger.billingdate  END  <= :ad_EndDate  AND 
					 dbo.saleledger.custcode IN ( :al_custcode ) AND
					 dbo.saleledger.salecatcode IN (1, 2, 3) AND
					 dbo.saleledger.saleinvcode = sd.saleinvcode AND
					 sd.icode = item.icode AND
					 dbo.saleledger.custcode = dbo.customer.custcode AND
					 dbo.customer.custcode = dbo.accounts.acccode AND
					 dbo.Item.iccode = dbo.itemclass.iccode
			Group by 
					dbo.saleledger.originaldate,
					dbo.saleledger.date ,
					dbo.saleledger.billingdate,
					sd.icode,
					dbo.item.name,
					dbo.item.packingdesc,
					dbo.itemclass.name )AS A
			

GROUP BY
			CAST(CONVERT(VARCHAR(100), A.Date, 111) AS DATETIME),
			A.icode,
			A.itemname,
			A.packing,
			A.itemclass"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_city", string), ("as_doctype", string), ("as_caption1", string))
 sort="date A, itemname A"
)
