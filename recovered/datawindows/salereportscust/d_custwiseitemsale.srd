release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=588 color="536870912" )
summary(height=96 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=decimal(8) updatewhereclause=yes name=unitprice dbname="unitprice"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="soldqty"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="salevalue"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
 retrieve="SELECT aliasname=item.customicode,
	itemname=item.name,
	manufacturer=(select name from manufacturer where manufacturer.manfcode=item.manfcode),
	unitprice=item.saleprice/item.packunits,
	soldqty=A.saleqty, 
	salevalue=A.saleqty  * item.saleprice/item.packunits,
	customer=(select name from accounts where accounts.acccode=:ai_custcode)
FROM Item,
	(select itemcode=saledetail.icode,
		saleqty=sum(looseqty)
	from saleledger,saledetail
	where saleledger.custcode=:ai_custcode and
      		saleledger.originaldate>=:ad_startdate and 
				saleledger.originaldate<=:ad_enddate  and
				saleledger.saleinvcode=saledetail.saleinvcode
	group by icode
	UNION ALL
	select itemcode=saledetail.icode,
		saleqty=sum(looseqty)
	from saleledger,saleinvdetail saledetail
	where saleledger.custcode=:ai_custcode and
			SaleLedger.impactinventory = 'N' AND
      	saleledger.originaldate>=:ad_startdate and 
			saleledger.originaldate<=:ad_enddate  and
			saleledger.saleinvcode=saledetail.saleinvcode
	group by icode) AS A
WHERE Item.icode=A.itemcode
ORDER BY item.name


"
  arguments=(("ai_custcode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime))
)
