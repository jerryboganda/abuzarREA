table(column=(type=long updatewhereclause=yes name=grouping dbname="Grouping"  )
column=(type=char(100) updatewhereclause=yes name=datestring dbname="DateString"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleLedger.Date"  )
column=(type=long updatewhereclause=yes name=invno dbname="InvNo"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(30) updatewhereclause=yes name=refno dbname="RefNo"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="CustRefNo"  )
column=(type=char(75) updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="Packqty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=long updatewhereclause=yes name=id dbname="ID"  )
 retrieve="SELECT 
	Grouping=1,
	DateString = convert(varchar(100), dbo.saleledger.Date, 103),
	dbo.saleledger.Date,
	InvNo = dbo.saleledger.SaleInvCode,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),
	RefNo = (SELECT C.refno FROM Customer C WHERE C.CustCode = min(saleledger.custcode)),
	CustRefNo = dbo.saleledger.CustRefNo,
	ItemCode = item.CustomICode,  
	itemname = item.name,  
	Manufacturer = dbo.Manufacturer.Name,
	packingdesc = dbo.item.packingdesc,
	Packqty = Sum (dbo.saledetail.looseqty), 
	saleprice = dbo.saledetail.saleprice,
	PackUnits = dbo.saledetail.PackUnits,
	ID = MAX(dbo.saledetail.rowid)
FROM 	 
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item, 
	dbo.Customer,
	dbo.Manufacturer 
WHERE  
	CASE lower(:as_datetype) 
		When 'originaldate' Then dbo.saleledger.originaldate 
		When 'lastsavingdate' Then dbo.saleledger.date
		When 'billingdate' Then dbo.saleledger.billingdate
	 End Between :ad_startdate AND :ad_enddate AND
	 dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
	 dbo.saleledger.salecatcode IN (1, 2, 3) AND
	 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	 dbo.saledetail.icode = item.icode AND
	 dbo.saleledger.custcode = dbo.customer.custcode AND
	 dbo.Item.manfcode = dbo.manufacturer.manfcode AND
	 dbo.saleledger.ImpactInventory = 'Y'
Group by 
	dbo.saleledger.SaleInvCode,
	dbo.saleledger.Date,
	dbo.saledetail.icode,
	dbo.saleledger.CustRefNo,
	item.CustomICode,  
	dbo.item.name,
	dbo.item.packingdesc,
	dbo.saledetail.packunits,
	dbo.saledetail.saleprice,
	dbo.Manufacturer.Name
UNION ALL
SELECT 
	Grouping=1,
	DateString = convert(varchar(100), dbo.saleledger.Date, 103),
	dbo.saleledger.Date,
	InvNo = dbo.saleledger.SaleInvCode,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),
	RefNo = (SELECT C.refno FROM Customer C WHERE C.CustCode = min(saleledger.custcode)),
	CustRefNo = dbo.saleledger.CustRefNo,
	ItemCode = item.CustomICode,  
	itemname = item.name,  
	Manufacturer = dbo.Manufacturer.Name,
	packingdesc = dbo.item.packingdesc,
	Packqty = Sum (saledetail.looseqty), 
	saleprice = saledetail.saleprice,
	PackUnits = saledetail.PackUnits,
	ID = MAX(saledetail.rowid)
FROM 	 
	dbo.saleledger, 
	dbo.saleinvdetail saledetail,    
	dbo.item, 
	dbo.Customer,
	dbo.Manufacturer 
WHERE  
	CASE lower(:as_datetype) 
		When 'originaldate' Then dbo.saleledger.originaldate 
		When 'lastsavingdate' Then dbo.saleledger.date
		When 'billingdate' Then dbo.saleledger.billingdate
	 End Between :ad_startdate AND :ad_enddate AND
	 dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
	 dbo.saleledger.salecatcode IN (1, 2, 3) AND
	 dbo.saleledger.saleinvcode = saledetail.saleinvcode AND
	 saledetail.icode = item.icode AND
	 dbo.saleledger.custcode = dbo.customer.custcode AND
	 dbo.Item.manfcode = dbo.manufacturer.manfcode AND
	 dbo.saleledger.ImpactInventory = 'N'
Group by 
	dbo.saleledger.SaleInvCode,
	dbo.saleledger.Date,
	saledetail.icode,
	dbo.saleledger.CustRefNo,
	item.CustomICode,  
	dbo.item.name,
	dbo.item.packingdesc,
	saledetail.packunits,
	saledetail.saleprice,
	dbo.Manufacturer.Name"
  arguments=(("as_CustCode", string), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_datetype", string), ("as_line1", string))
 sort="datestring A, customer A, long(custrefno) A, itemname A"
)
