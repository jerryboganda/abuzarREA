table(column=(type=char(6) updatewhereclause=yes name=section dbname="Section"  )
column=(type=char(100) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
column=(type=char(30) updatewhereclause=yes name=cnic dbname="CNIC"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(1000) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(10) updatewhereclause=yes name=status dbname="Status"  )
column=(type=char(60) updatewhereclause=yes name=business dbname="Business"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=char(100) updatewhereclause=yes name=taxcategory dbname="TaxCategory"  )
column=(type=decimal(6) updatewhereclause=yes name=taxableamount dbname="TaxableAmount"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxperc dbname="AdvanceTaxPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxamt dbname="AdvanceTaxAmt"  )
 retrieve="SELECT 
		Section='236H/2',
		CustomerName=T.CustomerName,
		NTN = T.NTN,
		CNIC=T.CNIC,
		City=T.City,
		Address=T.Address,
		Status=T.Status,
		Business = T.Business,
		NetAmount=SUM(T.NetAmount),
		TaxCategory = T.TaxCategory,
		TaxableAmount = ROUND(SUM(T.TaxableAmount),0),
		AdvanceTaxPerc = MAX(T.AdvanceTaxPerc),
		AdvanceTaxAmt = ROUND(SUM(T.AdvanceTaxAmt),0)
FROM 
	(SELECT 
		TType='Sales',
		AliasName = A.AliasName,
		CustomerName=S.Owner,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = A.Name,
		NetAmount=SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SaleDetail D, Item I WHERE D.SaleInvCode=P.SaleInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = SUM(P.AdvanceTaxAmt)
	FROM
		SaleLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 0 AND 
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode IN (:ai_Custcode) AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.SaleInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.Address,
		S.Owner,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales Return',
		AliasName = A.AliasName,
		CustomerName=S.Owner,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = A.Name,
		NetAmount= - SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * D.SRPrice  * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SRDetail D, Item I WHERE D.SRInvCode=P.SRInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = - SUM(P.AdvanceTaxAmt)
	FROM
		SRLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 0 AND 
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode IN (:ai_Custcode) AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.SRInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.Address,
		S.Owner,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales',
		AliasName = A.AliasName,
		CustomerName=S.Owner,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = A.Name,
		NetAmount=SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SaleDetail D, Item I WHERE D.SaleInvCode=P.SaleInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = SUM(P.AdvanceTaxAmt)
	FROM
		CRS_SaleLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 0 AND 
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode IN (:ai_Custcode) AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.ClientInstanceID,
		P.SaleInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.Address,
		S.Owner,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales Return',
		AliasName = A.AliasName,
		CustomerName=S.Owner,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = A.Name,
		NetAmount= - SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * D.SRPrice  * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SRDetail D, Item I WHERE D.SRInvCode=P.SRInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = - SUM(P.AdvanceTaxAmt)
	FROM
		CRS_SRLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 0 AND 
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode IN (:ai_Custcode) AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.ClientInstanceID,
		P.SRInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.Address,
		S.Owner,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales',
		AliasName = A.AliasName,
		CustomerName=S.Owner,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = A.Name,
		NetAmount=SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SaleDetail D, Item I WHERE D.SaleInvCode=P.SaleInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = SUM(P.AdvanceTaxAmt)
	FROM
		SaleLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 1 AND 
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.SaleInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.Address,
		S.Owner,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales Return',
		AliasName = A.AliasName,
		CustomerName=S.Owner,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = A.Name,
		NetAmount= - SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * D.SRPrice  * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SRDetail D, Item I WHERE D.SRInvCode=P.SRInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = - SUM(P.AdvanceTaxAmt)
	FROM
		SRLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 1 AND 
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.SRInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.Address,
		S.Owner,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales',
		AliasName = A.AliasName,
		CustomerName=S.Owner,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = A.Name,
		NetAmount=SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SaleDetail D, Item I WHERE D.SaleInvCode=P.SaleInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = SUM(P.AdvanceTaxAmt)
	FROM
		CRS_SaleLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 1 AND 
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.ClientInstanceID,
		P.SaleInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.Address,
		S.Owner,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales Return',
		AliasName = A.AliasName,
		CustomerName=S.Owner,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = A.Name,
		NetAmount= - SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * D.SRPrice  * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SRDetail D, Item I WHERE D.SRInvCode=P.SRInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = - SUM(P.AdvanceTaxAmt)
	FROM
		CRS_SRLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 1 AND 
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.ClientInstanceID,
		P.SRInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.Address,
		S.Owner,
		TC.Name,
		TC.TaxPerc) T
GROUP BY 
		T.AliasName,
		T.CustomerName,
		T.NTN,
		T.CNIC,
		T.City,
		T.Address,
		T.Status,
		T.Business,
		T.TaxCategory
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_custcode", numberlist), ("ai_allcust", number))
 sort="customername A"
)
