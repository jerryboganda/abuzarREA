table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(13) updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=char(75) updatewhereclause=yes name=alisaname dbname="alisaname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=datetime updatewhereclause=yes name=invdate dbname="invdate"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="bonus"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=char(60) updatewhereclause=yes name=manf dbname="manf"  )
column=(type=decimal(2) updatewhereclause=yes name=claimablediscperc dbname="claimablediscperc"  )
 retrieve="SELECT 
	GroupCode = CASE :as_reportgrouping 
								WHEN 'M' THEN I.ManfCode 
								WHEN 'P' THEN I.PackCode 
								WHEN 'L' THEN I.ICCode 
								ELSE I.ICatCode END,
	GroupName = CASE :as_reportgrouping 
								WHEN 'M' THEN M.Name
								WHEN 'P' THEN P.Name
								WHEN 'L' THEN L.Name
								ELSE C.Name END,
	itemcode=SD.icode,
	invcode='SV-' + LTRIM(RTRIM(STR(SD.saleinvcode,10))),
	alisaname=I.customicode,
	itemname=I.name,
	invdate=SL.date,
	invdiscperc=MAX(SL.discperc),
/*	qty=SUM(SD.looseqty) - ISNULL((SELECT SUM(SRD.LooseQty) FROM SRLedger SR, SRDetail SRD WHERE SR.SaleInvCode = SL.SaleInvCode AND SR.SRInvCode = SRD.SRInvCode AND SRD.ICode = SD.ICode), 0),*/
	qty=SUM(SD.looseqty),
	bonus=SUM(SD.bonusqty),
	price=MAX(SD.saleprice),
	discperc=MAX(SD.discperc),
	customername=A.name,
	manf=M.name,
	claimablediscperc=MAX(SD.claimablediscperc)
FROM 
	saledetail SD,
	saleledger SL,
	Item I,
	Accounts A,
	Manufacturer M, 
	ItemCategory C, 
	ItemClass L,
	ItemPacking P
WHERE
	SL.date BETWEEN :ar_sdate and :ar_ldate AND
	SD.claimable = 'Y' and
	SL.saleinvcode = SD.saleinvcode and
	SL.custcode = A.acccode and
	A.acccode in (:aa_custcode) and
	SD.icode=I.icode and
	I.ManfCode = M.ManfCode AND
	I.ICatCode = C.ICatCode AND
	I.ICCode = L.ICCode AND
	I.PackCode = P.PackCode AND
	CASE :as_reportgrouping 
		WHEN 'M' THEN I.ManfCode 
		WHEN 'P' THEN I.PackCode 
		WHEN 'L' THEN I.ICCode 
		ELSE I.ICatCode END IN (:aa_groupcode)
GROUP BY
	SD.icode,
	SL.saleinvcode,
	SD.saleinvcode,
	I.customicode,
	I.name,
	SL.date,
	A.name,
	I.ManfCode, 
	I.PackCode,
	I.ICCode,
	I.ICatCode,
	M.Name,
	P.Name,
	L.Name,
	C.Name
UNION ALL
SELECT 
	GroupCode = CASE :as_reportgrouping 
								WHEN 'M' THEN I.ManfCode 
								WHEN 'P' THEN I.PackCode 
								WHEN 'L' THEN I.ICCode 
								ELSE I.ICatCode END,
	GroupName = CASE :as_reportgrouping 
								WHEN 'M' THEN M.Name
								WHEN 'P' THEN P.Name
								WHEN 'L' THEN L.Name
								ELSE C.Name END,
	itemcode=SD.icode,
	invcode='SR-' + LTRIM(RTRIM(STR(SD.srinvcode,10))),
	alisaname=I.customicode,
	itemname=I.name,
	invdate=SL.date,
	invdiscperc=MAX(SL.discperc),
	qty= - SUM(SD.looseqty) ,
	bonus= - SUM(SD.bonusqty),
	price=MAX(SD.srprice),
	discperc=MAX(SD.discperc),
	customername=A.name,
	manf=M.name,
	claimablediscperc=MAX(SD.claimablediscperc)
FROM 
	srdetail SD,
	srledger SL,
	Item I,
	Accounts A,
	Manufacturer M, 
	ItemCategory C, 
	ItemClass L,
	ItemPacking P
WHERE
	SL.date BETWEEN :ar_sdate and :ar_ldate AND
	SD.claimable = 'Y' and
	SL.srinvcode = SD.srinvcode and
	SL.custcode = A.acccode and
	A.acccode in (:aa_custcode) and
	SD.icode=I.icode and
	I.ManfCode = M.ManfCode AND
	I.ICatCode = C.ICatCode AND
	I.ICCode = L.ICCode AND
	I.PackCode = P.PackCode AND
	CASE :as_reportgrouping 
		WHEN 'M' THEN I.ManfCode 
		WHEN 'P' THEN I.PackCode 
		WHEN 'L' THEN I.ICCode 
		ELSE I.ICatCode END IN (:aa_groupcode)
GROUP BY
	SD.icode,
	SL.srinvcode,
	SD.srinvcode,
	I.customicode,
	I.name,
	SL.date,
	A.name,
	I.ManfCode, 
	I.PackCode,
	I.ICCode,
	I.ICatCode,
	M.Name,
	P.Name,
	L.Name,
	C.Name


"
  arguments=(("ar_SDate", datetime), ("ar_lDate", datetime), ("aa_custcode", numberlist), ("as_reportgrouping", string), ("aa_groupcode", numberlist))
 sort="customername A, invdate A, invcode A"
)
