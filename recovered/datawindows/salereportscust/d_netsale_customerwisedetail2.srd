	dbo.saleledger.saleinvcode = sd.saleinvcode and  
	sd.icode = item.icode and 
	dbo.saleledger.custcode=accounts.acccode
ORDER BY 
	SaleInvCode"
  arguments=(("ar_custcode", numberlist), ("ai_one_or_all", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime))
)
