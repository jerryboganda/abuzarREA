table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="CustRefNo"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=char(30) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=person dbname="Person"  )
column=(type=decimal(10) updatewhereclause=yes name=netrate dbname="netrate"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(6) updatewhereclause=yes name=margin dbname="margin"  )
column=(type=char(6) updatewhereclause=yes name=invtype dbname="invtype"  )
 retrieve="SELECT 
	saleinvcode = dbo.saleledger.saleinvcode, 
	date = dbo.saleledger.date, 
	invdiscperc = dbo.saleledger.discperc, 
	flatdisc = dbo.saleledger.flatdisc, 
	misccharges = dbo.saleledger.misccharges,
	invsalestax = dbo.saleledger.salestax,
	CustRefNo   = dbo.saleledger.CustRefNo,
	Remarks   = dbo.saleledger.Remarks,
	looseqty = dbo.saledetail.looseqty,
	bonusqty=dbo.saledetail.bonusqty,
	qty=saledetail.looseqty, 
	packing=case
				when dbo.item.packcode=null then space(30) 
				else dbo.itempacking.name
			end,
	itemflatdisc=saledetail.itemflatdisc,
	packqty  = 0,  
	price = dbo.saledetail.saleprice,    
	itemdiscperc = dbo.saledetail.discperc,    
	packunits = dbo.saledetail.packunits,    
	batch = dbo.saledetail.batch,    
	expiry = dbo.saledetail.expiry,    
	salestax  = ROUND(saledetail.LooseQty * (saledetail.SalePrice - saledetail.ItemFlatDisc) * (1 - saledetail.DiscPerc * 0.01) * saledetail.GSTPerc * 0.01, 2) + ((saledetail.LooseQty + saledetail.Bonusqty) * saledetail.UnitSalesTax),
	aliasname = item.customicode,
	itemname = item.name,
	datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), 
	Person = accounts.name,
	/* netrate=Round(((((saledetail.looseqty + (saledetail.packqty * saledetail.packunits)) * (saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)))/(saledetail.packqty * saledetail.packunits + saledetail.looseqty) ,2),*/
	netrate=Round(((saledetail.saleprice - saledetail.itemflatdisc) * (1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) ,2),
	avgprice=saledetail.avgprice+item.packingcost,
	/*margin=Round(((((((saledetail.looseqty + saledetail.packqty * saledetail.packunits) * (saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) / (saledetail.packqty * saledetail.packunits + saledetail.looseqty)) - saledetail.avgprice) * 100) / saledetail.avgprice,2),		 */
	/*margin=Round(((((((saledetail.saleprice - saledetail.itemflatdisc) * (1 - .01 * saledetail.discperc)) * (1- .01 * saleledger.discperc)) - Round(saledetail.avgprice,2)) * 100) / Round(((saledetail.saleprice - saledetail.itemflatdisc) * (1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) ,2)) ,2),*/
	margin=Round(((Round((((saledetail.saleprice - saledetail.itemflatdisc) * (1 - .01 * saledetail.discperc)) * (1- .01 * saleledger.discperc)) + ROUND(saledetail.LooseQty * (saledetail.SalePrice - saledetail.ItemFlatDisc) * (1 - saledetail.DiscPerc * 0.01) * saledetail.GSTPerc * 0.01, 2) + ((saledetail.LooseQty + saledetail.Bonusqty) * saledetail.UnitSalesTax),2) - Round(saledetail.avgprice,2)) * 100) / CASE WHEN Round(((saledetail.saleprice - saledetail.itemflatdisc) * (1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) + ROUND(saledetail.LooseQty * (saledetail.SalePrice - saledetail.ItemFlatDisc) * (1 - saledetail.DiscPerc * 0.01) * saledetail.GSTPerc * 0.01, 2) + ((saledetail.LooseQty + saledetail.Bonusqty) * saledetail.UnitSalesTax),2) > 0 THEN Round(((saledetail.saleprice - saledetail.itemflatdisc) * (1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) + ROUND(saledetail.LooseQty * (saledetail.SalePrice - saledetail.ItemFlatDisc) * (1 - saledetail.DiscPerc * 0.01) * saledetail.GSTPerc * 0.01, 2) + ((saledetail.LooseQty + saledetail.Bonusqty) * saledetail.UnitSalesTax), 2) ELSE 1 END, 2) ,
	invtype=Case dbo.saleledger.salecatcode 	When 1 Then 'Cash' 	
														When 2 Then 'Credit' 
														When 3 Then 'Cash'
														End  	
FROM 	 
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item LEFT OUTER JOIN dbo.itempacking ON ( dbo.item.packcode = dbo.itempacking.packcode),
	dbo.accounts
	
WHERE
	:ai_one_or_all = 0 AND
	dbo.saleledger.date BETWEEN :ad_StartDate and :ad_EndDate  and
	dbo.saleledger.salecatcode IN (1, 2, 3) and
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
	dbo.saledetail.icode = item.icode and 
	dbo.saleledger.custcode IN (:ar_custcode)and
	dbo.saleledger.custcode=accounts.acccode
UNION ALL
SELECT 
	saleinvcode = dbo.saleledger.saleinvcode, 
	date = dbo.saleledger.date, 
	invdiscperc = dbo.saleledger.discperc, 
	flatdisc = dbo.saleledger.flatdisc, 
	misccharges = dbo.saleledger.misccharges,
	invsalestax = dbo.saleledger.salestax,
	CustRefNo   = dbo.saleledger.CustRefNo,
	Remarks   = dbo.saleledger.Remarks,
	looseqty = sd.looseqty,
	bonusqty =sd.bonusqty,
	qty=sd.looseqty, 
	packing=case
				when dbo.item.packcode=null then space(30) 
				else dbo.itempacking.name
			end,
	itemflatdisc=sd.itemflatdisc,
	packqty  = 0,  
	price = sd.saleprice,    
	itemdiscperc = sd.discperc,    
	packunits = sd.packunits,    
	batch = sd.batch,    
	expiry = sd.expiry,    
	salestax  = ROUND(sd.LooseQty * (sd.SalePrice - sd.ItemFlatDisc) * (1 - sd.DiscPerc * 0.01) * sd.GSTPerc * 0.01, 2) + ((sd.LooseQty + sd.Bonusqty) * sd.UnitSalesTax),
	aliasname = item.customicode,
	itemname = item.name,
	datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), 
	Person = accounts.name,
	/* netrate=Round(((((sd.looseqty + (sd.packqty * sd.packunits)) * (sd.saleprice - sd.itemflatdisc)) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)))/(sd.packqty * sd.packunits + sd.looseqty) ,2),*/
	netrate=Round(((sd.saleprice - sd.itemflatdisc) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) ,2),
	avgprice=sd.avgprice+item.packingcost,
	/*margin=Round(((((((sd.looseqty + sd.packqty * sd.packunits) * (sd.saleprice - sd.itemflatdisc)) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) / (sd.packqty * sd.packunits + sd.looseqty)) - sd.avgprice) * 100) / sd.avgprice,2),		 */
	/*margin=Round(((((((sd.saleprice - sd.itemflatdisc) * (1 - .01 * sd.discperc)) * (1- .01 * saleledger.discperc)) - Round(sd.avgprice,2)) * 100) / Round(((sd.saleprice - sd.itemflatdisc) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) ,2)) ,2),*/
	margin=Round(((Round((((sd.saleprice - sd.itemflatdisc) * (1 - .01 * sd.discperc)) * (1- .01 * saleledger.discperc)) + ROUND(sd.LooseQty * (sd.SalePrice - sd.ItemFlatDisc) * (1 - sd.DiscPerc * 0.01) * sd.GSTPerc * 0.01, 2) + ((sd.LooseQty + sd.Bonusqty) * sd.UnitSalesTax),2) - Round(sd.avgprice,2)) * 100) / CASE WHEN Round(((sd.saleprice - sd.itemflatdisc) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) + ROUND(sd.LooseQty * (sd.SalePrice - sd.ItemFlatDisc) * (1 - sd.DiscPerc * 0.01) * sd.GSTPerc * 0.01, 2) + ((sd.LooseQty + sd.Bonusqty) * sd.UnitSalesTax),2) > 0 THEN Round(((sd.saleprice - sd.itemflatdisc) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) + ROUND(sd.LooseQty * (sd.SalePrice - sd.ItemFlatDisc) * (1 - sd.DiscPerc * 0.01) * sd.GSTPerc * 0.01, 2) + ((sd.LooseQty + sd.Bonusqty) * sd.UnitSalesTax), 2) ELSE 1 END, 2) ,
	invtype=Case dbo.saleledger.salecatcode 	When 1 Then 'Cash' 	
														When 2 Then 'Credit' 
														When 3 Then 'Cash'
														End  	
FROM
	dbo.saleledger, 
	dbo.saleinvdetail sd,    
	dbo.item LEFT OUTER JOIN dbo.itempacking ON ( dbo.item.packcode = dbo.itempacking.packcode),
	dbo.accounts	
WHERE  
	:ai_one_or_all = 0 AND
	DBO.SaleLedger.impactinventory = 'N' AND 
	dbo.saleledger.date BETWEEN :ad_StartDate and :ad_EndDate  and
	dbo.saleledger.salecatcode IN (1, 2, 3) and
	dbo.saleledger.saleinvcode = sd.saleinvcode and  
	sd.icode = item.icode and 
	dbo.saleledger.custcode IN (:ar_custcode)and
	dbo.saleledger.custcode=accounts.acccode
UNION ALL
