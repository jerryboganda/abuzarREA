	dbo.saledetail,    
	dbo.item LEFT OUTER JOIN dbo.itempacking ON ( dbo.item.packcode = dbo.itempacking.packcode),
	dbo.accounts
	
WHERE
	:ai_one_or_all = 1 AND
	dbo.saleledger.date BETWEEN :ad_StartDate and :ad_EndDate  and
	dbo.saleledger.salecatcode IN (1, 2, 3) and
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
	dbo.saledetail.icode = item.icode and 
	dbo.saleledger.custcode=accounts.acccode
UNION ALL
SELECT 
	saleinvcode = dbo.saleledger.saleinvcode, 
	date = dbo.saleledger.date, 
	invdiscperc = dbo.saleledger.discperc, 
	flatdisc = dbo.saleledger.flatdisc, 
	misccharges = dbo.saleledger.misccharges,
	invsalestax = dbo.saleledger.salestax,
	CustRefNo   = dbo.saleledger.CustRefNo,
	Remarks   = dbo.saleledger.Remarks,
	looseqty = sd.looseqty,
	bonusqty =sd.bonusqty,
	qty=sd.looseqty, 
	packing=case
				when dbo.item.packcode=null then space(30) 
				else dbo.itempacking.name
			end,
	itemflatdisc=sd.itemflatdisc,
	packqty  = 0,  
	price = sd.saleprice,    
	itemdiscperc = sd.discperc,    
	packunits = sd.packunits,    
	batch = sd.batch,    
	expiry = sd.expiry,    
	salestax  = ROUND(sd.LooseQty * (sd.SalePrice - sd.ItemFlatDisc) * (1 - sd.DiscPerc * 0.01) * sd.GSTPerc * 0.01, 2) + ((sd.LooseQty + sd.Bonusqty) * sd.UnitSalesTax),
	aliasname = item.customicode,
	itemname = item.name,
	datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), 
	Person = accounts.name,
	/* netrate=Round(((((sd.looseqty + (sd.packqty * sd.packunits)) * (sd.saleprice - sd.itemflatdisc)) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)))/(sd.packqty * sd.packunits + sd.looseqty) ,2),*/
	netrate=Round(((sd.saleprice - sd.itemflatdisc) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) ,2),
	avgprice=sd.avgprice+item.packingcost,
	/*margin=Round(((((((sd.looseqty + sd.packqty * sd.packunits) * (sd.saleprice - sd.itemflatdisc)) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) / (sd.packqty * sd.packunits + sd.looseqty)) - sd.avgprice) * 100) / sd.avgprice,2),		 */
	/*margin=Round(((((((sd.saleprice - sd.itemflatdisc) * (1 - .01 * sd.discperc)) * (1- .01 * saleledger.discperc)) - Round(sd.avgprice,2)) * 100) / Round(((sd.saleprice - sd.itemflatdisc) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) ,2)) ,2),*/
	margin=Round(((Round((((sd.saleprice - sd.itemflatdisc) * (1 - .01 * sd.discperc)) * (1- .01 * saleledger.discperc)) + ROUND(sd.LooseQty * (sd.SalePrice - sd.ItemFlatDisc) * (1 - sd.DiscPerc * 0.01) * sd.GSTPerc * 0.01, 2) + ((sd.LooseQty + sd.Bonusqty) * sd.UnitSalesTax),2) - Round(sd.avgprice,2)) * 100) / CASE WHEN Round(((sd.saleprice - sd.itemflatdisc) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) + ROUND(sd.LooseQty * (sd.SalePrice - sd.ItemFlatDisc) * (1 - sd.DiscPerc * 0.01) * sd.GSTPerc * 0.01, 2) + ((sd.LooseQty + sd.Bonusqty) * sd.UnitSalesTax),2) > 0 THEN Round(((sd.saleprice - sd.itemflatdisc) * (1 - (.01 * sd.discperc))) * (1- (.01 * saleledger.discperc)) + ROUND(sd.LooseQty * (sd.SalePrice - sd.ItemFlatDisc) * (1 - sd.DiscPerc * 0.01) * sd.GSTPerc * 0.01, 2) + ((sd.LooseQty + sd.Bonusqty) * sd.UnitSalesTax), 2) ELSE 1 END, 2) ,
