release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=300 print.margin.top=0 print.margin.bottom=500 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2000 color="536870912" )
summary(height=989 color="536870912" )
footer(height=260 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(60) updatewhereclause=yes name=manufacurer dbname="manufacurer"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=cumulativesum dbname="cumulativesum"  )
column=(type=decimal(2) updatewhereclause=yes name=cumulativesumfoot dbname="cumulativesumfoot"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
 retrieve="SELECT itemname = item.name, 
		 packing = dbo.item.packingdesc, 
		 manufacurer = (dbo.manufacturer.name), 
		 looseqty = Sum (dbo.saledetail.looseqty), 
		 price = max(dbo.saledetail.saleprice),  
 		 cumulativesum = round(0.00,2), 
 		 cumulativesumfoot = round(0.00,2),
		customer=Accounts.name
FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item, 
		 dbo.Customer,
		 dbo.Accounts,
		 dbo.Manufacturer 
WHERE  dbo.saleledger.originaldate >= :ad_StartDate AND
		 dbo.saleledger.originaldate <= :ad_EndDate  AND 
		 dbo.saleledger.custcode IN ( :al_custcode ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		 dbo.saledetail.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode AND
		 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
		Accounts.name,
		dbo.saledetail.icode,
		dbo.item.name,
		dbo.item.packingdesc,
		dbo.manufacturer.name
ORDER BY
		Accounts.name,
		Item.name"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("as_line1", string), ("as_line2", string), ("as_line3", string), ("as_line4", string), ("as_unit", string), ("as_sta", string))
)
