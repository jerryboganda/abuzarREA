datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1468 color="536870912" )
summary(height=635 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=char(30) updatewhereclause=yes name=customerref dbname="CustomerRef"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=char(100) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
 retrieve="SELECT 
	saleinvcode = dbo.saleledger.saleinvcode, 
	CustomerRef = dbo.saleledger.CustRefNo, 
	date = dbo.saleledger.date, 
	invdiscperc = dbo.saleledger.discperc, 
	flatdisc = dbo.saleledger.flatdisc, 
	misccharges = dbo.saleledger.misccharges, 
	invsalestax = dbo.saleledger.salestax,
	remarks = dbo.saleledger.remarks,
	looseqty = dbo.saledetail.looseqty, 
	packqty  = saledetail.packqty,   
	price = dbo.saledetail.saleprice, 
	itemdiscperc = dbo.saledetail.discperc, 
	packunits = dbo.saledetail.packunits, 
	batch = dbo.saledetail.batch, 
	expiry = dbo.saledetail.expiry, 
	salestax  = saledetail.salestax,
	itemname = CASE WHEN saledetail.saleitemdescription IS NULL THEN item.name ELSE saledetail.saleitemdescription END,
	datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), 
	customer = dbo.accounts.name 
FROM
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item, 
	dbo.accounts 
WHERE
	dbo.saleledger.date >= :ad_StartDate and
	dbo.saleledger.date <= :ad_EndDate  and 
	dbo.saleledger.custcode = :al_CustCode  and 
	dbo.saleledger.salecatcode IN (1, 2, 3) and
	dbo.saleledger.saleinvcode NOT IN (select distinct srledger.saleinvcode from srledger where srledger.date between :ad_StartDate and :ad_EndDate and srledger.saleinvcode IS NOT NULL) and
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
	dbo.saledetail.icode = item.icode and 
	dbo.saleledger.custcode = dbo.accounts.acccode 
UNION ALL
SELECT 
	saleinvcode = dbo.saleledger.saleinvcode, 
	CustomerRef = dbo.saleledger.CustRefNo, 
	date = dbo.saleledger.date, 
	invdiscperc = dbo.saleledger.discperc, 
	flatdisc = dbo.saleledger.flatdisc, 
	misccharges = dbo.saleledger.misccharges, 
	invsalestax = dbo.saleledger.salestax,
	remarks = dbo.saleledger.remarks,
	looseqty = sd.looseqty, 
	packqty  = 0,  
	price = sd.saleprice, 
	itemdiscperc = sd.discperc, 
	packunits = sd.packunits, 
	batch = sd.batch, 
	expiry = sd.expiry, 
	salestax  = 0,
	itemname = CASE WHEN sd.saleitemdescription IS NULL THEN item.name ELSE sd.saleitemdescription END,
	datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), 
	customer = dbo.accounts.name 
FROM
	dbo.saleledger, 
	dbo.saleinvdetail sd,    
	dbo.item, 
	dbo.accounts 
WHERE  
	DBO.SaleLedger.impactinventory = 'N' AND 
	dbo.saleledger.date >= :ad_StartDate and
	dbo.saleledger.date <= :ad_EndDate  and 
	dbo.saleledger.custcode = :al_CustCode  and 
	dbo.saleledger.salecatcode IN (1, 2, 3) and
	dbo.saleledger.saleinvcode NOT IN (select distinct srledger.saleinvcode from srledger where srledger.date between :ad_StartDate and :ad_EndDate and srledger.saleinvcode IS NOT NULL) and
	dbo.saleledger.saleinvcode = sd.saleinvcode and  
	sd.icode = item.icode and 
	dbo.saleledger.custcode = dbo.accounts.acccode 
"
  arguments=(("al_CustCode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_discperc", number))
 sort="date A, saleinvcode A"
)
