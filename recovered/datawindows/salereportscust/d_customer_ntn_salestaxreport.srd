table(column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=datetime updatewhereclause=yes name=invoicedate dbname="InvoiceDate"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=exemptedsale dbname="ExemptedSale"  )
column=(type=decimal(6) updatewhereclause=yes name=taxablesale dbname="TaxableSale"  )
column=(type=decimal(6) updatewhereclause=yes name=gstamount dbname="GSTAmount"  )
 retrieve="SELECT 
	NTN = C.NTNNO,
	CustomerName = A.Name,
	InvoiceCode = S.SaleInvCode,
	InvoiceDate = S.Date,
	Qty = SUM(D.LooseQty),
	ExemptedSale = ROUND(SUM(CASE WHEN D.GSTPerc = 0 AND D.UnitSalesTax = 0 THEN (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) ELSE 0.00 END), 2),
	TaxableSale = ROUND(SUM(CASE WHEN D.GSTPerc = 0 AND D.UnitSalesTax = 0 THEN 0.00 ELSE (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) END), 2),
	GSTAmount = ROUND(SUM( (D.LooseQty + D.BonusQty) * D.UnitSalesTax ), 2) + 
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01)), 2) +
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * S.InvGSTPerc1 * 0.01)), 2)
FROM
	SaleLedger S,
	SaleDetail D,
	Accounts A,
	Customer C
WHERE
	:ai_allcust = 0 AND
	S.Posted = 'Y' AND
	S.SaleInvCode = D.SaleInvCode AND
	S.Date BETWEEN :ad_startdate AND :ad_enddate AND 
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	A.AccCode IN (:ai_custcode)
GROUP BY
	S.SaleInvCode,
	S.Date,
	A.AliasName,
	A.Name,
	C.NTNNO
UNION ALL
SELECT 
	NTN = C.NTNNO,
	CustomerName = A.Name,
	InvoiceCode = S.SaleInvCode,
	InvoiceDate = S.Date,
	Qty = SUM(D.LooseQty),
	ExemptedSale = ROUND(SUM(CASE WHEN D.GSTPerc = 0 AND D.UnitSalesTax = 0 THEN (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) ELSE 0.00 END), 2),
	TaxableSale = ROUND(SUM(CASE WHEN D.GSTPerc = 0 AND D.UnitSalesTax = 0 THEN 0.00 ELSE (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) END), 2),
	GSTAmount = ROUND(SUM( (D.LooseQty + D.BonusQty) * D.UnitSalesTax ), 2) + 
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01)), 2) +
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * S.InvGSTPerc1 * 0.01)), 2)
FROM
	CRS_SaleLedger S,
	CRS_SaleDetail D,
	Accounts A,
	Customer C
WHERE
	:ai_allcust = 0 AND
	S.ClientInstanceID = D.ClientInstanceID AND 
	S.Posted = 'Y' AND
	S.SaleInvCode = D.SaleInvCode AND
	S.Date BETWEEN :ad_startdate AND :ad_enddate AND 
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	A.AccCode IN (:ai_custcode)
GROUP BY
	S.SaleInvCode,
	S.Date,
	A.AliasName,
	A.Name,
	C.NTNNO
UNION ALL
SELECT 
	NTN = C.NTNNO,
	CustomerName = A.Name,
	InvoiceCode = S.SaleInvCode,
	InvoiceDate = S.Date,
	Qty = SUM(D.LooseQty),
	ExemptedSale = ROUND(SUM(CASE WHEN D.GSTPerc = 0 AND D.UnitSalesTax = 0 THEN (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) ELSE 0.00 END), 2),
	TaxableSale = ROUND(SUM(CASE WHEN D.GSTPerc = 0 AND D.UnitSalesTax = 0 THEN 0.00 ELSE (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) END), 2),
	GSTAmount = ROUND(SUM( (D.LooseQty + D.BonusQty) * D.UnitSalesTax ), 2) + 
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01)), 2) +
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * S.InvGSTPerc1 * 0.01)), 2)
FROM
	SaleLedger S,
	SaleDetail D,
	Accounts A,
	Customer C
WHERE
	:ai_allcust = 1 AND
	S.Posted = 'Y' AND
	S.SaleInvCode = D.SaleInvCode AND
	S.Date BETWEEN :ad_startdate AND :ad_enddate AND 
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode
GROUP BY
	S.SaleInvCode,
	S.Date,
	A.AliasName,
	A.Name,
	C.NTNNO
UNION ALL
SELECT 
	NTN = C.NTNNO,
	CustomerName = A.Name,
	InvoiceCode = S.SaleInvCode,
	InvoiceDate = S.Date,
	Qty = SUM(D.LooseQty),
	ExemptedSale = ROUND(SUM(CASE WHEN D.GSTPerc = 0 AND D.UnitSalesTax = 0 THEN (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) ELSE 0.00 END), 2),
	TaxableSale = ROUND(SUM(CASE WHEN D.GSTPerc = 0 AND D.UnitSalesTax = 0 THEN 0.00 ELSE (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) END), 2),
	GSTAmount = ROUND(SUM( (D.LooseQty + D.BonusQty) * D.UnitSalesTax ), 2) + 
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01)), 2) +
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * S.InvGSTPerc1 * 0.01)), 2)
FROM
	CRS_SaleLedger S,
	CRS_SaleDetail D,
	Accounts A,
	Customer C
WHERE
	:ai_allcust = 1 AND
	S.ClientInstanceID = D.ClientInstanceID AND 
	S.Posted = 'Y' AND
	S.SaleInvCode = D.SaleInvCode AND
	S.Date BETWEEN :ad_startdate AND :ad_enddate AND 
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode
GROUP BY
	S.SaleInvCode,
	S.Date,
	A.AliasName,
	A.Name,
	C.NTNNO"
  arguments=(("ai_custcode", numberlist), ("ai_allcust", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="customername A, ntn A, invoicecode A, invoicedate A"
)
