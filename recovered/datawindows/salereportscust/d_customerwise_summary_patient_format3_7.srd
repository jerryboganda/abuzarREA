table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=char(1) updatewhereclause=yes name=invtype dbname="invtype"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="patientcode"  )
column=(type=char(60) updatewhereclause=yes name=saletype dbname="saletype"  )
column=(type=long updatewhereclause=yes name=saletypeinvno dbname="saletypeInvNo"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=cp dbname="Customer.cp"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Customer.address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Customer.address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="Customer.city"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="netamount"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(60) updatewhereclause=yes name=rank dbname="Rank"  )
 retrieve="SELECT 
	invcode = SL.saleinvcode,    
	invtype = 'S', 
	date      = SL.date,    
	patientcode = SL.patientcode,
	saletype = (Select ST.Name FROM SaleType ST WHERE ST.SaleTypeCode = SL.SaleTypeCode),
	saletypeInvNo = SL.SaleTypeInvNo,
	AC.name, 
	CU.cp,
	CU.address1,
	CU.address2,
	CU.city,
	netamount = ISNULL(SL.InvTotal, 0),
	regno = PA.RegNo,
	patientname = PA.name,
	Remarks = SL.Remarks,
	Rank = (SELECT R.Name FROM Rank R WHERE R.RankCode=PA.RankCode)
FROM 
	SaleLedger SL, 
	SaleDetail SD,   
	Accounts AC, 
	Customer CU,
	Patient PA
WHERE 
	SL.saleinvcode = SD.saleinvcode and  
	SL.date Between :ad_StartDate and :ad_EndDate and
	SL.custcode  = :al_CustCode and 
	SL.custcode = AC.acccode and	
	CU.custcode = SL.custcode and
	SL.patientcode = PA.patientcode
Group By 
	SL.saleinvcode,
	SL.patientcode,
	SL.remarks,
	SL.invtotal,
	SL.date,
	SL.saletypecode,
	SL.custcode,
	SL.saletypeinvno,
	AC.name,
	CU.cp,
	CU.address1,
	CU.address2,
	CU.city,
	PA.regno,
	PA.name,
	PA.RankCode
UNION ALL
SELECT 
	invcode = SL.saleinvcode,    
	invtype = 'S',
	date      = SL.date,    
	patientcode = SL.patientcode,
	saletype = (Select ST.Name FROM SaleType ST WHERE ST.SaleTypeCode = SL.SaleTypeCode),
	saletypeInvNo = SL.SaleTypeInvNo,
	AC.name, 
	CU.cp,
	CU.address1,
	CU.address2,
	CU.city,
	netamount = ISNULL(SL.InvTotal, 0),
	regno = PA.RegNo,
	patientname = PA.name,
	Remarks = SL.Remarks,
	Rank = (SELECT R.Name FROM Rank R WHERE R.RankCode=PA.RankCode)
FROM 
	SaleLedger SL, 
	dbo.saleinvdetail sd,   
	Accounts AC, 
	Customer CU,
	Patient PA	
WHERE 
	SL.impactinventory = 'N' AND
	SL.saleinvcode = sd.saleinvcode and  
	SL.date Between :ad_StartDate and :ad_EndDate and
	SL.custcode  = :al_CustCode and 
	SL.custcode = AC.acccode and	
	CU.custcode = SL.custcode and
	SL.patientcode = PA.patientcode
Group By 
	SL.saleinvcode,
	SL.patientcode,
	SL.remarks,
	SL.invtotal,
	SL.date,
	SL.saletypecode,
	SL.custcode,
	SL.saletypeinvno,
	AC.name,
	CU.cp,
	CU.address1,
	CU.address2,
	CU.city,
	PA.regno,
	PA.name,
	PA.RankCode"
  arguments=(("al_Custcode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number))
 sort="patientname A, date A"
)
