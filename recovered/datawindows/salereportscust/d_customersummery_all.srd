release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=770 color="536870912" )
summary(height=291 color="536870912" )
footer(height=0 color="536870912" )
detail(height=10 color="536870912" )
table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=purledger_date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=decimal(6) updatewhereclause=yes name=totaldiscount dbname="totaldiscount"  )
column=(type=decimal(15) updatewhereclause=yes name=realamount dbname="realamount"  )
column=(type=decimal(6) updatewhereclause=yes name=totaltax dbname="totaltax"  )
column=(type=decimal(6) updatewhereclause=yes name=retamount dbname="retamount"  )
 retrieve="  SELECT invcode     = dbo.saleledger.saleinvcode,    
         date        = dbo.saleledger.date,     
         flatdisc    = dbo.saleledger.flatdisc, 
			salestax    = dbo.saleledger.salestax,       
         misccharges = dbo.saleledger.misccharges, 
			invdiscperc = dbo.saleledger.discperc, 
			doctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
         dbo.accounts.name, 
         amount =  Round(Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice), 2),    
			itemdiscpercvalue = Round(Sum (( dbo.saledetail.looseqty  * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01)) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc)), 2),    
    		invdiscpercvalue =Sum (Round( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01)),2)) * (dbo.saleledger.discperc /100), 
			salesman = dbo.users.username ,
			totaldiscount= dbo.saleledger.flatdisc + Round(Sum (( dbo.saledetail.looseqty  * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01)) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc)), 2)  + Round(Sum ( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01))) * (dbo.saleledger.discperc /100), 2),
			realamount=sum(Round(saledetail.packprice/ISNULL(saledetail.packunits ,1),2) * saledetail.looseqty),
			
			
								 		/* invoice level salestax*/
			totaltax=Round(	Round ( (Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice) 
											 -   Round(Sum (Round(( dbo.saledetail.looseqty  * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01)) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc),2)), 2) 
											 -  Sum (Round( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01)),2)) * (dbo.saleledger.discperc /100)
											 - saleledger.flatdisc ) * saleledger.invgstperc1 * 0.01 , 2	)
							+	/*Add item level salestax*/
							
							Sum (Round (dbo.saledetail.looseqty * dbo.saledetail.unitsalestax + Round ( Round (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc ) * (1 - dbo.saledetail.discperc * 0.01 ), 2 ) * dbo.saledetail.gstperc * 0.01 , 2 ) , 2 ) )		
							,0),
			retamount=0
							
    FROM dbo.saleledger, 
         dbo.saledetail,   
         dbo.accounts,
			dbo.users  

   WHERE ( dbo.saleledger.Date between :ar_SDate and :ar_lDate)and
			( dbo.saleledger.salecatcode IN (2)) and
			( dbo.saleledger.salesmancode = :ai_usercode) and
			( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and  
         ( dbo.saleledger.custcode = dbo.accounts.acccode )and  
			( dbo.saleledger.salesmancode = dbo.users.usercode )  
     	               

GROUP BY dbo.saleledger.misccharges,   
         dbo.saleledger.flatdisc,   
         dbo.saleledger.date,   
         dbo.saleledger.saleinvcode,   
			dbo.saleledger.discperc,  
			dbo.saleledger.salestax, 
			dbo.saleledger.salecatcode,
			dbo.saleledger.invgstperc1, 
			dbo.accounts.name,
			dbo.users.username 
         
/*ORDER BY dbo.accounts.name   */


/*--------------*/
UNION ALL

SELECT invcode     = dbo.saleledger.saleinvcode,    
         date        = dbo.saleledger.date,    
         flatdisc    = dbo.saleledger.flatdisc, 
			salestax    = dbo.saleledger.salestax,       
         misccharges = dbo.saleledger.misccharges, 
			invdiscperc = dbo.saleledger.discperc, 
			doctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
         dbo.accounts.name, 
         amount =  Round(Sum ( sd.looseqty * sd.saleprice), 2),    
			itemdiscpercvalue = Round(Sum (( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc)), 2),    
    		invdiscpercvalue =Sum (Round( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01)),2)) * (dbo.saleledger.discperc /100), 
			salesman = dbo.users.username ,
			totaldiscount= dbo.saleledger.flatdisc + Round(Sum (( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc)), 2)  + Round(Sum ( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01))) * (dbo.saleledger.discperc /100), 2),
			realamount=sum(Round(sd.packprice/ISNULL(sd.packunits ,1),2) * sd.looseqty),
			
			
								 		/* invoice level salestax*/
			totaltax=Round(	Round ( (Sum ( sd.looseqty * sd.saleprice) 
											 -   Round(Sum (Round(( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc),2)), 2) 
											 -  Sum (Round( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01)),2)) * (dbo.saleledger.discperc /100)
											 - saleledger.flatdisc ) * saleledger.invgstperc1 * 0.01 , 2	)
							+	/*Add item level salestax*/
							
							Sum (Round (sd.looseqty * sd.unitsalestax + Round ( Round (sd.looseqty * (sd.saleprice - sd.itemflatdisc ) * (1 - sd.discperc * 0.01 ), 2 ) * sd.gstperc * 0.01 , 2 ) , 2 ) )		
							,0),
			retamount=0
							
    FROM dbo.saleledger, 
         dbo.saleinvdetail sd,   
         dbo.accounts,
			dbo.users  

   WHERE ( dbo.saleledger.impactinventory = 'N' ) AND
			( dbo.saleledger.Date between :ar_SDate and :ar_lDate)and
			( dbo.saleledger.salecatcode IN (2)) and
			( dbo.saleledger.salesmancode = :ai_usercode) and
			( dbo.saleledger.saleinvcode = sd.saleinvcode ) and  
         ( dbo.saleledger.custcode = dbo.accounts.acccode )and  
			( dbo.saleledger.salesmancode = dbo.users.usercode )  
     	               

GROUP BY dbo.saleledger.misccharges,   
         dbo.saleledger.flatdisc,   
         dbo.saleledger.date,   
         dbo.saleledger.saleinvcode,   
			dbo.saleledger.discperc,  
			dbo.saleledger.salestax, 
			dbo.saleledger.salecatcode,
			dbo.saleledger.invgstperc1, 
			dbo.accounts.name,
			dbo.users.username 
         
/*ORDER BY dbo.accounts.name   */


/*--------------*/
UNION ALL


  SELECT invcode     = dbo.srledger.srinvcode, 
			getdate(),
			0,
			0,
			0,
			0,
			'',   
         dbo.accounts.name,
			0,
			0,
			0,
			' ',
			0,
			0,
			0, 			 /* Sales Tax Calculation*/
         returnamount=ISNULL(Round(	Round ( (Sum ( dbo.srdetail.looseqty * dbo.srdetail.srprice) 
											 -   Round(Sum (Round(( dbo.srdetail.looseqty  * dbo.srdetail.srprice  * (dbo.srdetail.discperc * .01)),2)), 2) 
											 -  Sum (Round( dbo.srdetail.looseqty   * dbo.srdetail.srprice   * (1 - (dbo.srdetail.discperc * .01)),2)) * (dbo.srledger.discperc /100)
											 - srledger.flatdisc ) * srledger.invgstperc1 * 0.01 , 2	)
							+	
							
							Sum (Round (dbo.srdetail.looseqty * dbo.srdetail.unitsalestax + Round ( Round (dbo.srdetail.looseqty * dbo.srdetail.srprice  * (1 - dbo.srdetail.discperc * 0.01 ), 2 ) * dbo.srdetail.gstperc * 0.01 , 2 ) , 2 ) )		
							,0)
								/* end of salestax calculation*/
							+
							/* inv amount Exclude salestax*/
							Round( (Sum(Round((dbo.srdetail.srprice * dbo.srdetail.looseqty * (1 - dbo.srdetail.discperc * 0.01)),2))) * ( 1 - (dbo.srledger.discperc * 0.01)) - dbo.srledger.flatdisc + dbo.srledger.misccharges,0)
						   ,0) /* end of ISNUll function)*/ 
    FROM dbo.srledger, 
         dbo.srdetail,   
         dbo.accounts

   WHERE ( dbo.srledger.srinvcode = dbo.srdetail.srinvcode ) and  
         ( dbo.srledger.custcode = dbo.accounts.acccode )and 
			( dbo.srledger.srcatcode=7)and 
			( dbo.srledger.date between :ar_SDate and :ar_lDate)            

GROUP BY dbo.srledger.misccharges,   
         dbo.srledger.flatdisc,   
         dbo.srledger.date,   
         dbo.srledger.srinvcode,   
			dbo.srledger.discperc,  
			dbo.srledger.salestax, 
			dbo.srledger.srcatcode, 
			dbo.srledger.invgstperc1, 
			dbo.accounts.name
			  

ORDER BY dbo.accounts.name   
/*ORDER BY dbo.srledger.srinvcode ASC, 
			dbo.srledger.date ASC */  





"
  arguments=(("ar_SDate", datetime), ("ar_lDate", datetime), ("ai_usercode", number))
)
