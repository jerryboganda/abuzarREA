table(column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=long updatewhereclause=yes name=saleledger_custcode dbname="CustCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=decimal(9) updatewhereclause=yes name=value dbname="Value"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscount dbname="InvDiscount"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="FlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="GSTPERC"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
 retrieve="SELECT  
	InvCode=SL.SaleInvCode,
	CustCode=SL.CustCode,
	Date=SL.Date, 
	Customer=A.Name,
	AliasName=A.AliasName,
	RegNo=C.SalesTaxRegNo,
	Value=SUM(SD.LooseQty * (SD.SalePrice + (SD.SalePrice * sd.GSTPerc * 0.01) ) ),
	InvDiscount = SUM(
		(SD.LooseQty * (SD.SalePrice + 
			(SD.SalePrice * sd.GSTPerc * 0.01) ) ) * SL.DiscPerc * 0.01),
	FlatDisc=SL.FlatDisc,
	GSTPERC=MAX(SD.GSTPerc),
	CustomerCategory = (SELECT CC.Name FROM CustomerCategory CC WHERE CC.CustCatCode = C.CustCatCode)
FROM
	SaleLedger SL, SaleDetail SD, Customer C, Accounts A
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.Date BETWEEN :ar_Sdate AND :ar_Ldate AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode IN (:ai_custcatcode) AND
	C.CustCode = A.AccCode
GROUP BY
	SL.SaleInvCode,
	SL.CustCode,
	SL.Date,
	C.SalesTaxRegNo,
	A.Name,
	A.AliasName,
	C.CustCatCode,
	SL.FlatDisc
UNION ALL
SELECT 
	InvCode=SL.SaleInvCode,
	CustCode=SL.CustCode,
	Date=SL.Date, 
	Customer=A.Name,
	AliasName=A.AliasName,
	RegNo=C.SalesTaxRegNo,
	Value=SUM(SD.LooseQty * (SD.SalePrice + (SD.SalePrice * sd.GSTPerc * 0.01) ) ),
	InvDiscount = SUM(
		(SD.LooseQty * (SD.SalePrice + 
			(SD.SalePrice * sd.GSTPerc * 0.01) ) ) * SL.DiscPerc * 0.01),
	FlatDisc=SL.FlatDisc,
	GSTPERC=MAX(SD.GSTPerc),
	CustomerCategory = (SELECT CC.Name FROM CustomerCategory CC WHERE CC.CustCatCode = C.CustCatCode)
FROM
	SaleLedger SL, SaleInvDetail SD, Customer C, Accounts A
WHERE
	SL.ImpactInventory='N' AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.Date BETWEEN :ar_Sdate AND :ar_Ldate AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode IN (:ai_custcatcode) AND
	C.CustCode = A.AccCode
GROUP BY
	SL.SaleInvCode,
	SL.CustCode,
	SL.Date,
	C.SalesTaxRegNo,
	A.Name,
	A.AliasName,
	C.CustCatCode,
	SL.FlatDisc"
  arguments=(("ar_Sdate", datetime), ("ar_Ldate", datetime), ("ai_custcatcode", numberlist))
 sort="invcode A"
)
