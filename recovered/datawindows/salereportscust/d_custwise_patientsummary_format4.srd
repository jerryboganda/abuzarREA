release 12.5;
datawindow ( units=0 timer_interval=0 processing=4 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 grid.lines=2 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=616 color="536870912" )
header[2](height=76 color="536870912" )
summary(height=112 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=number updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(20) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(20) updatewhereclause=yes name=designation dbname="designation"  )
column=(type=char(20) updatewhereclause=yes name=division dbname="division"  )
column=(type=number updatewhereclause=yes name=invtotal dbname="invtotal"  )
 retrieve=" SELECT  documentcode = saleledger.saleinvcode,
		division=max(custrefno2),
		customer=(select name from accounts where accounts.acccode=:ai_custcode),
		relation=ISNULL((select name from relation where relationcode=saleledger.relationcode),'None'),
		patient=(select name from patient where patient.patientcode=saleledger.patientcode),
		Designation=(select rank.name from rank,patient where patient.patientcode=saleledger.patientcode and patient.rankcode=rank.rankcode),
		
		AlternateAccCode = CASE saleledger.saleCatCode
				WHEN 1 THEN saleledger.custcode  /* Cash Sale */
				WHEN 3 THEN saleledger.custcode  /* Cash Sale */
				ELSE Null
				END,
		Date    = saleledger.date,
		
		invtotal= /*-------gross------*/
			Round(
			SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) *
			(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) + 
			saleledger.misccharges + saleledger.salestax - saleledger.flatdisc, 0)
			+ /*-----sales tax-------*/
			Round(
			SUM( (saledetail.looseqty + saledetail.bonusqty) * saledetail.unitsalestax) + 
			SUM(ROUND( (saledetail.looseqty * 
			(saledetail.saleprice - saledetail.itemflatdisc)) *
			(1 - (.01 * saledetail.discperc)) * saledetail.gstperc * .01, 2)) +
			ROUND( (SUM((saledetail.looseqty * 
			(saledetail.saleprice - saledetail.itemflatdisc)) *
			(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) -
			saleledger.flatdisc) * (saleledger.invgstperc1 * .01), 2), 0)

		
		
	FROM    saleledger,	 
			  saledetail		
	WHERE saleledger.custcode IN (:ai_custcode) AND
			saleledger.date>=:ad_sdate AND saleledger.date<=:ad_ldate AND
			saleledger.saleinvcode = saledetail.saleinvcode 
	GROUP BY saleledger.saleinvcode,
		 saleledger.custcode, 
		 saleledger.salecatcode,
		 saleledger.date,
		 saleledger.discperc,
		 saleledger.misccharges,
		 saleledger.salestax,
		 saleledger.flatdisc,
		 saleledger.invgstperc1,
		 saleledger.relationcode,
		 saleledger.patientcode
UNION ALL
 SELECT  documentcode = saleledger.saleinvcode,
		division=max(custrefno2),
		customer=(select name from accounts where accounts.acccode=:ai_custcode),
		relation=ISNULL((select name from relation where relationcode=saleledger.relationcode),'None'),
		patient=(select name from patient where patient.patientcode=saleledger.patientcode),
		Designation=(select rank.name from rank,patient where patient.patientcode=saleledger.patientcode and patient.rankcode=rank.rankcode),
		
		AlternateAccCode = CASE saleledger.saleCatCode
				WHEN 1 THEN saleledger.custcode  /* Cash Sale */
				WHEN 3 THEN saleledger.custcode  /* Cash Sale */
				ELSE Null
				END,
		Date    = saleledger.date,
		
		invtotal= /*-------gross------*/
			Round(
			SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) *
			(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) + 
			saleledger.misccharges + saleledger.salestax - saleledger.flatdisc, 0)
			+ /*-----sales tax-------*/
			Round(
			SUM( (saledetail.looseqty + saledetail.bonusqty) * saledetail.unitsalestax) + 
			SUM(ROUND( (saledetail.looseqty * 
			(saledetail.saleprice - saledetail.itemflatdisc)) *
			(1 - (.01 * saledetail.discperc)) * saledetail.gstperc * .01, 2)) +
			ROUND( (SUM((saledetail.looseqty * 
			(saledetail.saleprice - saledetail.itemflatdisc)) *
			(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) -
			saleledger.flatdisc) * (saleledger.invgstperc1 * .01), 2), 0)

		
		
	FROM    saleledger,	 
			  saleinvdetail saledetail		
	WHERE saleledger.custcode IN (:ai_custcode) AND
			saleledger.date>=:ad_sdate AND saleledger.date<=:ad_ldate AND
			saleledger.saleinvcode = saledetail.saleinvcode 
	GROUP BY saleledger.saleinvcode,
		 saleledger.custcode, 
		 saleledger.salecatcode,
		 saleledger.date,
		 saleledger.discperc,
		 saleledger.misccharges,
		 saleledger.salestax,
		 saleledger.flatdisc,
		 saleledger.invgstperc1,
		 saleledger.relationcode,
		 saleledger.patientcode
  ORDER BY saleledger.saleinvcode"
  arguments=(("ad_sdate", datetime), ("ad_ldate", datetime), ("ai_custcode", number))
 sort="customer A, documentcode A, date A, patient A, designation A, division A"
)
