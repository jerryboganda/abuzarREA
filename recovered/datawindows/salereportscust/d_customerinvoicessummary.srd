release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=632 color="536870912" )
summary(height=124 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long updatewhereclause=yes name=invoices dbname="Invoices"  )
column=(type=decimal(6) updatewhereclause=yes name=invoicesvalue dbname="InvoicesValue"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
 retrieve="SELECT
	S.CustCode,
	A.AliasName, 
	A.Name As Customer,
	COUNT(S.saleinvcode) as Invoices,
	SUM(S.Net) AS InvoicesValue,
	Balance=ISNULL(B.Balance, 0)

FROM	
	(SELECT 
		SL.saleinvcode,
		SL.Custcode,
		Net=Round(
			SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
			SL.misccharges + SL.salestax - SL.flatdisc, 0)+
			Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
			SUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
			ROUND( (SUM((SD.looseqty * 
				(SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
				SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0)
	FROM    saleledger SL, saledetail SD
	WHERE   SL.Posted = 'Y' AND
		SL.SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND
		SL.SaleInvCode = SD.SaleInvcode
	GROUP BY SL.saleinvcode,
		 SL.CustCode,
		 SL.discperc,
		 SL.misccharges,
		 SL.salestax,
		 SL.flatdisc,
		 SL.invgstperc1
	UNION ALL
	SELECT SL.saleinvcode,
		SL.Custcode,
		Net=Round(
			SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
			SL.misccharges + SL.salestax - SL.flatdisc, 0)+
			Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
			SUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
			ROUND( (SUM((SD.looseqty * 
				(SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
				SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0)
	FROM saleledger SL,	 
		saleinvdetail SD
	WHERE SL.Posted = 'Y' AND ImpactInventory='N' AND
		SL.SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND
		SL.SaleInvCode = SD.SaleInvcode
	GROUP BY SL.saleinvcode,
		 SL.CustCode,
		 SL.discperc,
		 SL.misccharges,
		 SL.salestax,
		 SL.flatdisc,
		 SL.invgstperc1) AS S 
	LEFT OUTER JOIN  
	(SELECT  Acccode,
		Balance=Sum(debit-credit)
	From VirtualGL
	Where Acccode IN (select custcode from customer)
	Group By Acccode) AS B ON (S.CustCode = B.AccCode),
	Accounts A

WHERE
	S.CustCode = A.AccCode
GROUP BY
	S.CustCode,
	A.Name,
	A.AliasName,
	B.Balance
ORDER BY
	A.Name,
	A.AliasName,
	S.CustCode,
	B.Balance
"
  arguments=(("ar_SinvCode", number), ("ar_LinvCode", number))
)
