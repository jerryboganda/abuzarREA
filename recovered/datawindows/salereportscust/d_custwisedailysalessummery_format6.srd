release 12.5;
datawindow ( units=0 timer_interval=0 processing=4 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 grid.lines=2 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=388 color="536870912" )
header[2](height=68 color="536870912" )
summary(height=116 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=invdate dbname="invdate"  )
column=(type=char(20) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=number updatewhereclause=yes name=value dbname="value"  )
 retrieve="   select 	category=(select name from itemcategory where icatcode=IC.icatcode),
			A.itemname,
			A.icode,
			A.saleprice,
			A.looseqty,
			A.saleinvcode,
			A.rowid,
			A.invDate,
			value=(case when A.icatcode=IC.icatcode THEN
					(A.looseqty*A.saleprice)
				      else
					0
					end )



from 			(select distinct(itemcategory.icatcode)
						 
	   		from 	saledetail,item,itemcategory
   			where (saledetail.saleinvcode between :ar_sinvcode and :ar_linvcode)and
						saledetail.icode=item.icode and
						item.icatcode=itemcategory.icatcode) AS IC,

					(select SD.saleinvcode,
								rowid=max(SD.Rowid),
								I.icatcode,
								SD.icode,
								saleprice=max(SD.saleprice),
								looseqty=sum(SD.looseqty),
								itemname=max(I.name),
								invdate=max(SL.date)
		      
					from saledetail SD,
							saleledger SL,
	     					item I
					where SL.custcode=:ar_custcode and
							(SL.saleinvcode between :ar_sinvcode and :ar_linvcode)and
							(SL.saleinvcode = SD.saleinvcode) and
							SD.icode=I.icode
	
					Group by 
							SD.saleinvcode,
							I.icatcode,
							SD.icode 
					UNION ALL
					select SD.saleinvcode,
								rowid=max(SD.Rowid),
								I.icatcode,
								SD.icode,
								saleprice=max(SD.saleprice),
								looseqty=sum(SD.looseqty),
								itemname=max(I.name),
								invdate=max(SL.date)
		      
					from saleinvdetail SD,
							saleledger SL,
	     					item I
					where SL.custcode=:ar_custcode and
							SL.ImpactInventory='N' AND 
							(SL.saleinvcode between :ar_sinvcode and :ar_linvcode)and
							(SL.saleinvcode = SD.saleinvcode) and
							SD.icode=I.icode
	
					Group by 
							SD.saleinvcode,
							I.icatcode,
							SD.icode ) as A


order by A.saleinvcode,A.rowid"
  arguments=(("ar_sinvcode", number), ("ar_linvcode", number), ("ar_custcode", number))
 sort="invdate A, itemname A"
)
compute(name=date_1 band=header[1] font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="9" y="8" height="76" width="494" format="[general]" expression="today()" alignment="0" border="0" crosstab.repeat=no )
compute(name=page_1 band=header[1] font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="9" y="96" height="60" width="494" format="[general]" expression="'Page ' + page() + ' of ' + pageCount()" alignment="0" border="0" crosstab.repeat=no )
compute(name=compute_1 band=header[1] font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" x="9" y="184" height="60" width="494" format="[GENERAL]" expression="'Start :  ' + string(ar_sinvcode)" alignment="0" border="0" crosstab.repeat=no )
compute(name=compute_2 band=header[1] font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" x="9" y="256" height="64" width="494" format="[GENERAL]" expression="'End :  ' + string(ar_linvcode)" alignment="0" border="0" crosstab.repeat=no )
compute(name=compute_3 band=header[1] font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" x="507" y="8" height="64" width="677" format="[GENERAL]" expression="f_ReportHeaderInfo('clientname')" alignment="0" border="0" crosstab.repeat=no )
text(name=invdate_t band=header[2] font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" alignment="0" border="0" x="9" y="4" height="64" width="489" text="Inv. Date" )
text(name=itemname_t band=header[2] font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" alignment="0" border="0" x="507" y="4" height="64" width="677" text="Itemname" )
text(name=value_t band=header[2] font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" alignment="1" border="0" x="1193" y="4" height="64" width="302" text="@category" )
text(name=grand_sum_value_t band=header[2] font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" alignment="1" border="0" x="1504" y="4" height="64" width="315" text="Grand Total " )
compute(name=compute_4 band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="9" y="4" height="76" width="489" format="[general]" expression="~"Grand Total~"" alignment="1" border="0" crosstab.repeat=no )
compute(name=compute_5 band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="1193" y="8" height="76" width="302" format="####0.00" expression="sum(value for all )" alignment="1" border="0" crosstab.repeat=no )
compute(name=compute_6 band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="1504" y="4" height="76" width="315" format="####0.00" expression="sum(grand_sum_value for all )" alignment="1" border="0" crosstab.repeat=no )
column(name=invdate band=detail id=1 x="9" y="4" height="76" width="489" color="0" border="0" alignment="0" format="dd/mm/yy hh:mm:ss" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=no edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
column(name=itemname band=detail id=2 x="507" y="4" height="76" width="677" color="0" border="0" alignment="0" format="[general]" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=no edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
column(name=value visible="1	if(  value >0,1,0)" band=detail id=3 x="1193" y="4" height="76" width="302" color="0" border="0" alignment="1" format="####0.00" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=no edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=yes background.mode="1" background.color="536870912" font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
compute(name=grand_sum_value band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="1504" y="4" height="76" width="315" format="####0.00" expression="crosstabsum(1)" alignment="1" border="0" crosstab.repeat=no )
crosstab(columns="category" rows="invdate, itemname" values="sum(value for crosstab)" sourcenames = "category, itemname, icode, saleprice, looseqty, saleinvcode, rowid, invdate, value" crosstabonly=yes  band=foreground )
sparse(names="invdate")
htmltable(border="0" cellPadding="1" cellSpacing="1" )
