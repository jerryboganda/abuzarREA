table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=char(1) updatewhereclause=yes name=invtype dbname="invtype"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="patientcode"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=cp dbname="Customer.cp"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Customer.address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Customer.address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="Customer.city"  )
column=(type=decimal(6) updatewhereclause=yes name=netamount dbname="netamount"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
 retrieve="SELECT 
	invcode = SL.saleinvcode,    
	invtype = 'S',
	date      =  
		CASE lower(:as_datetype)  
			When 'originaldate' Then SL.originaldate 
			When 'lastsavingdate' Then SL.date
			When 'billingdate' Then SL.billingdate
		END	,    
	patientcode = Max(SL.patientcode),
	AC.name, 
	CU.cp,
	CU.address1,
	CU.address2,
	CU.city,
	netamount = 
			Round(
			SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc) *
				(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
					SL.misccharges + SL.salestax - SL.flatdisc), 0)
			+
			Round(
			SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
			SUM(ROUND( (SD.looseqty * 
						  (SD.saleprice - SD.itemflatdisc)) *
						  (1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
				 ROUND( (SUM((SD.looseqty * 
						(SD.saleprice - SD.itemflatdisc)) *
						(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
						SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0),
	regno = PA.RegNo,
	patientname = PA.name
FROM 
	SaleLedger SL, 
	SaleDetail SD,   
	Accounts AC, 
	Customer CU,
	Patient PA
WHERE 
	SL.saleinvcode = SD.saleinvcode and  
	CASE lower(:as_datetype) 
		When 'originaldate' Then SL.originaldate 
		When 'lastsavingdate' Then SL.date
		When 'billingdate' Then SL.billingdate
	END
		Between :ad_StartDate and :ad_EndDate and
	SL.salecatcode IN (1, 2, 3) and
	SL.custcode  = :al_CustCode and 
	SL.custcode = AC.acccode and	
	CU.custcode = SL.custcode and
	SL.patientcode = PA.patientcode
GROUP BY 
	SL.saleinvcode,   
	CASE lower(:as_datetype) 
		When 'originaldate' Then SL.originaldate 
		When 'lastsavingdate' Then SL.date
		When 'billingdate' Then SL.billingdate
	END,   
	SL.misccharges,   
	SL.flatdisc,   
	SL.discperc,  
	SL.salestax, 
	SL.invgstperc1,
	SL.salecatcode, 
	SL.patientcode,
	PA.RegNo,
	PA.Name,
	SL.custrefno,	 
	SL.remarks,
	AC.name,	
	CU.cp,
	CU.address1,
	CU.address2,
	CU.city
UNION ALL
SELECT 
	invcode = SL.saleinvcode,    
	invtype = 'S',
	date      = 
		CASE lower(:as_datetype)  
			When 'originaldate' Then SL.originaldate 
			When 'lastsavingdate' Then SL.date
			When 'billingdate' Then SL.billingdate
		END	,    
	patientcode = Max(SL.patientcode),
	AC.name, 
	CU.cp,
	CU.address1,
	CU.address2,
	CU.city,
	netamount = 
			Round(
			SUM((sd.looseqty*(sd.saleprice - sd.itemflatdisc)) *
				(1 - (.01 * sd.discperc))) * (1- (.01 * SL.discperc)) + 
					SL.misccharges + SL.salestax - SL.flatdisc, 0)
			+
			Round(
			SUM( (sd.looseqty + sd.bonusqty) * sd.unitsalestax) + 
			SUM(ROUND( (sd.looseqty * 
						  (sd.saleprice - sd.itemflatdisc)) *
						  (1 - (.01 * sd.discperc)) * sd.gstperc * .01, 2)) +
				 ROUND( (SUM((sd.looseqty * 
						(sd.saleprice - sd.itemflatdisc)) *
						(1 - (.01 * sd.discperc))) * (1- (.01 * SL.discperc)) -
						SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0),
	regno = PA.RegNo,
	patientname = PA.name
FROM 
	SaleLedger SL, 
	dbo.saleinvdetail sd,   
	Accounts AC, 
	Customer CU,
	Patient PA	
WHERE 
	SL.impactinventory = 'N' AND
	SL.saleinvcode = sd.saleinvcode and  
	CASE lower(:as_datetype) 
		When 'originaldate' Then SL.originaldate 
		When 'lastsavingdate' Then SL.date
		When 'billingdate' Then SL.billingdate
	END Between :ad_StartDate and :ad_EndDate and
	SL.salecatcode IN (1, 2, 3) and
	SL.custcode  = :al_CustCode and 
	SL.custcode = AC.acccode and	
	CU.custcode = SL.custcode and
	SL.patientcode = PA.patientcode
GROUP BY 
	SL.saleinvcode,   
	CASE lower(:as_datetype) 
		When 'originaldate' Then SL.originaldate 
		When 'lastsavingdate' Then SL.date
		When 'billingdate' Then SL.billingdate
	END,   
	SL.misccharges,   
	SL.flatdisc,   
	SL.discperc,  
	SL.salestax, 
	SL.invgstperc1,
	SL.salecatcode, 
	SL.patientcode,
	PA.RegNo,
	PA.Name,
	SL.custrefno,	 
	SL.remarks,
	AC.name,	
	CU.cp,
	CU.address1,
	CU.address2,
	CU.city
UNION ALL
SELECT 
	invcode = SR.srinvcode,    
	invtype = 'R',
	date      = SR.date,    
	patientcode = Max(SR.patientcode),
	AC.name, 
	CU.cp,
	CU.address1,
	CU.address2,
	CU.city,
	netamount = -
			(Round(
			SUM(SRD.looseqty * SRD.srprice *
				(1 - (.01 * SRD.discperc)) * (1- (.01 * SR.discperc))) + 
					SR.misccharges + SR.salestax - SR.flatdisc, 0)
			+
			Round(
			SUM( (SRD.looseqty + SRD.bonusqty) * SRD.unitsalestax) + 
			SUM(ROUND( (SRD.looseqty * SRD.srprice *
						  (1 - (.01 * SRD.discperc)) * SRD.gstperc * .01), 2)) +
				 ROUND( (SUM((SRD.looseqty * SRD.srprice *
						(1 - (.01 * SRD.discperc)) * (1- (.01 * SR.discperc))) -
						SR.flatdisc) * (SR.invgstperc1 * .01)), 2), 0)),
	regno = PA.RegNo,
	patientname = PA.name
FROM 
	SRLedger SR,
	SRDetail SRD,
	Accounts AC, 
	Customer CU,
	Patient PA
WHERE 
	SR.srinvcode = SRD.srinvcode and  
	SR.date Between :ad_StartDate and :ad_EndDate and
	SR.custcode  = :al_CustCode and 
	SR.custcode = AC.acccode and	
	CU.custcode = SR.custcode and
	SR.patientcode = PA.patientcode
GROUP BY 
	SR.SRInvcode,   
	SR.date,   
	SR.misccharges,   
	SR.flatdisc,   
	SR.discperc,  
	SR.salestax, 
	SR.invgstperc1,
	SR.patientcode,
	PA.RegNo,
	PA.Name,
	SR.custrefno,	 
	SR.remarks,
	AC.name,	
	CU.cp,
	CU.address1,
	CU.address2,
	CU.city
ORDER BY 
	invcode ASC,   
	date ASC
"
  arguments=(("al_Custcode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_caption", string), ("as_datetype", string), ("ai_supressheader", number))
 sort="patientname A, date A"
)
