table(column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CustAlias"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="Item.ManfCode"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=long updatewhereclause=yes name=icode dbname="Item.ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=grosssales dbname="GrossSales"  )
column=(type=decimal(6) updatewhereclause=yes name=saleamount dbname="SaleAmount"  )
column=(type=decimal(9) updatewhereclause=yes name=itemcost dbname="ItemCost"  )
column=(type=char(6) updatewhereclause=yes name=profitorloss dbname="ProfitOrLoss"  )
column=(type=decimal(6) updatewhereclause=yes name=margin dbname="Margin"  )
column=(type=decimal(6) updatewhereclause=yes name=discmargin dbname="DiscMargin"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
 retrieve="SELECT
	Area = AR.Name,
	Customer=A.Name,
	CustAlias=A.AliasName,
	I.ManfCode,  
	Manufacturer=M.Name,
	I.ICode, 
	ItemName=I.Name,
	Qty=ISNULL(sum(D.saleqty), 0),
	GrossSales = ISNULL(sum(D.GrossSales), 0),
	SaleAmount=ISNULL(sum(D.salevalue), 0),
	ItemCost=ISNULL(sum(D.itemcost), 0),
	ProfitOrLoss=(Case when ISNULL(sum(D.itemcost), 0)<0 Then 'Loss' Else 'Profit' end),
	Margin=ISNULL((sum(D.salevalue) - sum(D.itemcost) ) * 100 / 
			Case sum(D.salevalue) WHEN 0 THEN 1 ELSE sum(D.salevalue) END, 0),
	DiscMargin=ISNULL((sum(D.GrossSales) - sum(D.salevalue) ) / 
			Case sum(D.GrossSales) WHEN 0 THEN 1 ELSE sum(D.GrossSales) END, 0) * 100,
	Bonus=ISNULL(sum(D.bonus), 0)
FROM
	Area AR, Accounts A, Customer C, Manufacturer M, Item I,
	(SELECT 
		SL.CustCode,
		saleqty=ISNULL(sum(SD.looseqty), 0) ,
		bonus=ISNULL(sum(SD.bonusqty), 0) ,
		GrossSales = IsNull( Sum ( SD.Rate * SD.looseqty) , 0 ),
		salevalue=ISNULL(round(sum((SD.looseqty * (SD.saleprice - itemflatdisc)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01), 2), 0),
     	I.ICode,
     	itemcost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)), 2), 0)
	FROM		
		saleledger SL,
		saledetail SD,
		item I
	WHERE
		SL.date BETWEEN :adt_sdate AND :adt_ldate AND
		SL.custcode IN (:ai_custcode) and
		SL.salecatcode IN (:aa_salecatcode) and
		SD.saleinvcode=SL.saleinvcode AND
		SD.icode=I.icode AND
		I.manfcode IN (:ala_manfcode)
	GROUP BY 
		SL.CustCode,
      SD.icode,
 		I.ICode,
      SL.saleinvcode,
      SL.discperc
	UNION ALL
	SELECT 
		SL.CustCode,
		saleqty=ISNULL(sum(SD.looseqty), 0) ,
		bonus=ISNULL(sum(SD.bonusqty), 0) ,
		GrossSales = IsNull( Sum ( SD.Rate * SD.looseqty) , 0 ),
		salevalue=ISNULL(round(sum((SD.looseqty * (SD.saleprice - itemflatdisc)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01), 2), 0),
     	I.ICode,
     	itemcost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)), 2), 0)
	FROM		
		saleledger SL,
		saleinvdetail SD,
		item I
	WHERE
		SL.ImpactInventory='N' AND
		SL.date BETWEEN :adt_sdate AND :adt_ldate AND
		SL.custcode IN (:ai_custcode) and
		SL.salecatcode IN (:aa_salecatcode) and
		SD.saleinvcode=SL.saleinvcode AND
		SD.icode=I.icode AND
		I.manfcode IN (:ala_manfcode)
	GROUP BY 
		SL.CustCode,
      SD.icode,
 		I.ICode,
      SL.saleinvcode,
      SL.discperc
	UNION ALL
	SELECT
		SL.CustCode,
		saleqty=-ISNULL(sum(SD.looseqty), 0),
		bonus=-ISNULL(sum(SD.bonusqty), 0),
		GrossSales = -1 * ( IsNull ( Sum ( SD.SalePrice * SD.LooseQty) , 0 )  ),
		salevalue=-ISNULL(round(sum((SD.looseqty * (SD.srprice)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01), 2), 0),
		I.ICode,
		itemcost=-ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)), 2), 0)
	FROM
		srledger SL,
		srdetail SD,
		item I
	WHERE
		SL.date BETWEEN :adt_sdate AND :adt_ldate AND
		SL.custcode IN (:ai_custcode) and
		SL.srcatcode IN (:aa_srcatcode) AND
		SD.srinvcode=SL.srinvcode AND
		SD.icode=I.icode AND
		I.manfcode IN (:ala_manfcode)
	GROUP BY
		SL.CustCode,
		SD.icode,
		I.ICode,
		SL.srinvcode,
		SL.discperc) AS D
WHERE 
	I.manfcode IN (:ala_manfcode) AND
	I.ManfCode = M.ManfCode AND
	D.CustCode = A.AccCode AND
	A.AccCode = C.CustCode AND 
	C.AreaCode = AR.AreaCode AND 
	D.ICode = I.ICode
GROUP BY
	AR.Name,
	A.Name,
	A.AliasName,
	I.ManfCode,
	M.Name,
	I.ICode,
	I.name
ORDER BY
	A.Name,
	M.Name,
	I.name"
  arguments=(("ala_manfcode", numberlist), ("adt_SDate", datetime), ("adt_LDate", datetime), ("aa_salecatcode", numberlist), ("aa_srcatcode", numberlist), ("ai_custcode", numberlist))
)
