table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=cp dbname="Customer.cp"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Customer.address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Customer.address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="Customer.city"  )
column=(type=long updatewhereclause=yes name=salereturn dbname="salereturn"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsalestax dbname="itemsalestax"  )
column=(type=decimal(6) updatewhereclause=yes name=totaldisc dbname="totaldisc"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
 retrieve="  SELECT invcode     = dbo.saleledger.saleinvcode,    
         date        = CASE lower(:as_datetype) 
									When 'originaldate' Then dbo.saleledger.originaldate 
									When 'lastsavingdate' Then dbo.saleledger.date
									When 'billingdate' Then dbo.saleledger.billingdate
							  End ,     
         flatdisc    = dbo.saleledger.flatdisc,  
			salestax    = dbo.saleledger.salestax,       
         misccharges = dbo.saleledger.misccharges, 
			invdiscperc = dbo.saleledger.discperc, 
			invgstperc1 = dbo.saleledger.invgstperc1,
			doctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
         dbo.accounts.name, 
			dbo.customer.cp,
			dbo.customer.address1,
			dbo.customer.address2,
			dbo.customer.city,
			salereturn = (Select count(*) From SrLedger Where dbo.saleledger.saleinvcode = dbo.srledger.saleinvcode ),
         amount =  Round(Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice), 2),    
			itemdiscpercvalue = Round(Sum ( dbo.saledetail.looseqty  * ( dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc)), 2),    
    		invdiscpercvalue = Round(Sum ( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01))) * (dbo.saleledger.discperc /100), 2),
			itemsalestax = Sum (Round (dbo.saledetail.looseqty * dbo.saledetail.unitsalestax + Round ( Round (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc ) * (1 - dbo.saledetail.discperc * 0.01 ), 2 ) * dbo.saledetail.gstperc * 0.01 , 2 ) , 2 ) ) ,
			totaldisc=Round(Sum ( dbo.saledetail.looseqty  * ( dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc)), 2)
						 +
						 Round(Sum ( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01))) * (dbo.saleledger.discperc /100), 2)
						 +
						 saleledger.flatdisc,
			/*
			amount =  Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice),    
			itemdiscpercvalue = Sum ( dbo.saledetail.looseqty  * ( dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc)),    
    		invdiscpercvalue = Round(Sum ( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01))) * (dbo.saleledger.discperc /100), 2),
			itemsalestax = Sum (Round (dbo.saledetail.looseqty * dbo.saledetail.unitsalestax + Round ( Round (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc ) * (1 - dbo.saledetail.discperc * 0.01 ), 2 ) * dbo.saledetail.gstperc * 0.01 , 2 ) , 2 ) ) ,
			*/
			custrefno = dbo.saleledger.custrefno,	       
			remarks = dbo.saleledger.remarks
			
    FROM dbo.saleledger, 
         dbo.saledetail,   
         dbo.accounts, 
			dbo.customer

   WHERE dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
			CASE lower(:as_datetype) 
					When 'originaldate' Then dbo.saleledger.originaldate 
					When 'lastsavingdate' Then dbo.saleledger.date
					When 'billingdate' Then dbo.saleledger.billingdate
			End Between :ad_startdate AND :ad_enddate AND
			dbo.saleledger.salecatcode IN (1, 2, 3) and
			dbo.saleledger.custcode = :al_CustCode and
         dbo.saleledger.custcode = dbo.accounts.acccode and	
         dbo.saleledger.custcode = dbo.customer.custcode 

GROUP BY dbo.saleledger.saleinvcode,   
			CASE lower(:as_datetype) 
				When 'originaldate' Then dbo.saleledger.originaldate 
				When 'lastsavingdate' Then dbo.saleledger.date
				When 'billingdate' Then dbo.saleledger.billingdate
		   End ,    
			dbo.saleledger.misccharges,   
         dbo.saleledger.flatdisc,   
   		dbo.saleledger.discperc,  
			dbo.saleledger.salestax, 
			dbo.saleledger.invgstperc1,
			dbo.saleledger.salecatcode, 
			dbo.accounts.name,	
			dbo.saleledger.custrefno,	 
			dbo.saleledger.remarks,
			dbo.customer.cp,
			dbo.customer.address1,
			dbo.customer.address2,
			dbo.customer.city
UNION ALL
  SELECT invcode     = dbo.saleledger.saleinvcode,    
         date        = CASE lower(:as_datetype) 
									When 'originaldate' Then dbo.saleledger.originaldate 
									When 'lastsavingdate' Then dbo.saleledger.date
									When 'billingdate' Then dbo.saleledger.billingdate
							  End ,     
         flatdisc    = dbo.saleledger.flatdisc, 
			salestax    = dbo.saleledger.salestax,       
         misccharges = dbo.saleledger.misccharges, 
			invdiscperc = dbo.saleledger.discperc, 
			invgstperc1 = dbo.saleledger.invgstperc1,
			doctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
         dbo.accounts.name, 
			dbo.customer.cp,
			dbo.customer.address1,
			dbo.customer.address2,
			dbo.customer.city,
			salereturn = (Select count(*) From SrLedger Where dbo.saleledger.saleinvcode = dbo.srledger.saleinvcode ),
         amount =  Round(Sum ( sd.looseqty * sd.saleprice), 2),    
			itemdiscpercvalue = Round(Sum ( sd.looseqty  * ( sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01) + (sd.looseqty  * sd.itemflatdisc)), 2),    
    		invdiscpercvalue = Round(Sum ( sd.looseqty   * (sd.saleprice - sd.itemflatdisc) * (1 - (sd.discperc * .01))) * (dbo.saleledger.discperc /100), 2),
			totalDiscount = Round(Sum ( sd.looseqty  * ( sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01) + (sd.looseqty  * sd.itemflatdisc)), 2)
								+
								 Round(Sum ( sd.looseqty   * (sd.saleprice - sd.itemflatdisc) * (1 - (sd.discperc * .01))) * (dbo.saleledger.discperc /100), 2)
								+
								saleledger.flatdisc,
			itemsalestax = Sum (Round (sd.looseqty * sd.unitsalestax + Round ( Round (sd.looseqty * (sd.saleprice - sd.itemflatdisc ) * (1 - sd.discperc * 0.01 ), 2 ) * sd.gstperc * 0.01 , 2 ) , 2 ) ) ,
			custrefno = dbo.saleledger.custrefno,	       
			remarks = dbo.saleledger.remarks
			
    FROM dbo.saleledger, 
         dbo.saleinvdetail sd,   
         dbo.accounts, 
			dbo.customer

   WHERE DBO.SaleLedger.impactinventory = 'N' AND 
			dbo.saleledger.saleinvcode = sd.saleinvcode and  
			CASE lower(:as_datetype) 
					When 'originaldate' Then dbo.saleledger.originaldate 
					When 'lastsavingdate' Then dbo.saleledger.date
					When 'billingdate' Then dbo.saleledger.billingdate
			End Between :ad_startdate AND :ad_enddate AND
			dbo.saleledger.salecatcode IN (1, 2, 3) and
			dbo.saleledger.custcode = :al_CustCode and
         dbo.saleledger.custcode = dbo.accounts.acccode and	
         dbo.saleledger.custcode = dbo.customer.custcode 

GROUP BY dbo.saleledger.saleinvcode,   
			CASE lower(:as_datetype) 
				When 'originaldate' Then dbo.saleledger.originaldate 
				When 'lastsavingdate' Then dbo.saleledger.date
				When 'billingdate' Then dbo.saleledger.billingdate
		   End ,    
			dbo.saleledger.misccharges,   
         dbo.saleledger.flatdisc,   
   		dbo.saleledger.discperc,  
			dbo.saleledger.salestax, 
			dbo.saleledger.invgstperc1,
			dbo.saleledger.salecatcode, 
			dbo.accounts.name,	
			dbo.saleledger.custrefno,	 
			dbo.saleledger.remarks,
			dbo.customer.cp,
			dbo.customer.address1,
			dbo.customer.address2,
			dbo.customer.city         
ORDER BY 
	invcode ASC,   
	date ASC   

"
  arguments=(("al_Custcode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_caption", string), ("as_term1", string), ("as_term2", string), ("ai_suppressheader", number), ("as_datetype", string))
 sort="custname A, invcode A"
)
