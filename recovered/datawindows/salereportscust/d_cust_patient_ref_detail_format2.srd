table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(60) updatewhereclause=yes name=contactperson dbname="contactperson"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=datetime updatewhereclause=yes name=orderdate dbname="OrderDate"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="CustRefNo"  )
column=(type=char(100) updatewhereclause=yes name=custrefno2 dbname="CustRefNo2"  )
column=(type=char(100) updatewhereclause=yes name=custrefno3 dbname="CustRefNo3"  )
column=(type=char(100) updatewhereclause=yes name=custrefno4 dbname="CustRefNo4"  )
 retrieve="SELECT 
	invcode = dbo.saleledger.saleinvcode,
	customer = dbo.accounts.name,
	contactperson=(dbo.customer.cp), 
	address = (dbo.customer.address1),
	city = (dbo.customer.city), 
	date =	CASE lower(:as_datetype)
		When 'originaldate' Then dbo.saleledger.originaldate 
		When 'lastsavingdate' Then dbo.saleledger.date
		When 'date' Then dbo.saleledger.date
		When 'billingdate' Then dbo.saleledger.billingdate
		End,
	regno = dbo.patient.regno,
	patient = dbo.patient.name,
	itemname = item.name,
	looseqty = SUM(dbo.saledetail.looseqty),
	saleprice = MAX(dbo.saledetail.saleprice),
	OrderDate  = dbo.saleledger.billingdate,
	CustRefNo  = dbo.saleledger.CustRefNo,
	CustRefNo2 = dbo.saleledger.CustRefNo2,
	CustRefNo3 = dbo.saleledger.CustRefNo3,
	CustRefNo4 = dbo.saleledger.CustRefNo4
FROM 	 
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item, 
	dbo.Customer,
	dbo.Patient,
	dbo.Accounts
WHERE  
	CASE 
	WHEN lower(:as_datetype)  = 'originaldate' THEN dbo.saleledger.originaldate 
	WHEN lower(:as_datetype)  = 'lastsavingdate' THEN dbo.saleledger.date 
	WHEN lower(:as_datetype)  = 'billingdate' THEN dbo.saleledger.billingdate 
	ELSE dbo.saleledger.date 
	End Between :adt_startdate AND :adt_enddate AND
	dbo.saleledger.custcode = :al_custcode AND
	ISNULL(dbo.saleledger.custrefno, '')  = ISNULL(CASE WHEN lower(:as_datetype)  = 'date' THEN :as_refno ELSE dbo.saleledger.custrefno END, '') AND
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	dbo.saledetail.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.saleledger.patientcode = dbo.patient.patientcode
GROUP BY
	dbo.saleledger.saleinvcode,
	dbo.accounts.name,
	dbo.customer.cp, 
	dbo.customer.address1,
	dbo.customer.city, 
	dbo.saleledger.custrefno,
	dbo.saleledger.originaldate,
	dbo.saleledger.date,
	dbo.patient.regno,
	dbo.patient.name,
	item.name,
	dbo.saleledger.billingdate,
	dbo.saleledger.CustRefNo,
	dbo.saleledger.CustRefNo2,
	dbo.saleledger.CustRefNo3,
	dbo.saleledger.CustRefNo4
UNION ALL
SELECT
	invcode = dbo.saleledger.saleinvcode,
	customer = dbo.accounts.name,
	contactperson=(dbo.customer.cp), 
	address = (dbo.customer.address1),
	city = (dbo.customer.city), 
	date =	CASE lower(:as_datetype)
		When 'originaldate' Then dbo.saleledger.originaldate 
		When 'lastsavingdate' Then dbo.saleledger.date
		When 'date' Then dbo.saleledger.date
		When 'billingdate' Then dbo.saleledger.billingdate
		End,
	regno = dbo.patient.regno,
	patient = dbo.patient.name,
	itemname = item.name,
	looseqty = SUM(saledetail.looseqty),
	saleprice = MAX(saledetail.saleprice),
	OrderDate  = dbo.saleledger.billingdate,
	CustRefNo  = dbo.saleledger.CustRefNo,
	CustRefNo2 = dbo.saleledger.CustRefNo2,
	CustRefNo3 = dbo.saleledger.CustRefNo3,
	CustRefNo4 = dbo.saleledger.CustRefNo4
FROM 	 
	dbo.saleledger, 
	dbo.saleinvdetail saledetail, 
	dbo.item, 
	dbo.Customer,
	dbo.Patient,
	dbo.Accounts
WHERE  
	CASE 
	WHEN lower(:as_datetype)  = 'originaldate' THEN dbo.saleledger.originaldate 
	WHEN lower(:as_datetype)  = 'lastsavingdate' THEN dbo.saleledger.date 
	WHEN lower(:as_datetype)  = 'billingdate' THEN dbo.saleledger.billingdate 
	ELSE dbo.saleledger.date 
	End Between :adt_startdate AND :adt_enddate AND
	dbo.saleledger.custcode = :al_custcode AND
	ISNULL(dbo.saleledger.custrefno, '')  = ISNULL(CASE WHEN lower(:as_datetype)  = 'date' THEN :as_refno ELSE dbo.saleledger.custrefno END, '') AND
	dbo.saleledger.saleinvcode = saledetail.saleinvcode AND
	saledetail.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.saleledger.patientcode = dbo.patient.patientcode
GROUP BY
	dbo.saleledger.saleinvcode,
	dbo.accounts.name,
	dbo.customer.cp, 
	dbo.customer.address1,
	dbo.customer.city, 
	dbo.saleledger.custrefno,
	dbo.saleledger.originaldate,
	dbo.saleledger.date,
	dbo.patient.regno,
	dbo.patient.name,
	item.name,
	dbo.saleledger.billingdate,
	dbo.saleledger.CustRefNo,
	dbo.saleledger.CustRefNo2,
	dbo.saleledger.CustRefNo3,
	dbo.saleledger.CustRefNo4
ORDER BY
	OrderDate,
	RegNo,
	Patient,
	Date,
	Invcode"
  arguments=(("al_CustCode", number), ("as_datetype", string), ("adt_startdate", datetime), ("adt_enddate", datetime), ("as_refno", string), ("as_caption", string), ("as_caption2", string), ("ad_discperc", number), ("as_term1", string), ("as_term2", string))
 sort="invcode D, itemname A"
)
