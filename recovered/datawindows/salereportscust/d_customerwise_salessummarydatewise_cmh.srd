header(height=2187 color="536870912" )
summary(height=958 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(15) updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(6) updatewhereclause=yes name=amout dbname="amout"  )
 retrieve="SELECT date = Convert(varchar(15), CASE lower(:as_datetype) 
											  When 'originaldate' Then dbo.saleledger.originaldate 
											  When 'lastsavingdate' Then dbo.saleledger.date
 											  When 'billingdate' Then dbo.saleledger.billingdate
											  End ,   
							 101), 
		 amout = Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice ) 
		  
FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item, 
		 dbo.Customer

WHERE  DBO.SaleLedger.impactinventory = 'N' AND
		 CASE lower(:as_datetype) 
		 	When 'originaldate'   Then dbo.saleledger.originaldate 
			When 'lastsavingdate' Then dbo.saleledger.date
 			When 'billingdate'    Then dbo.saleledger.billingdate
	  	 End Between :ad_StartDate AND :ad_EndDate AND
		 dbo.saleledger.custcode IN (:al_custcode) AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		 dbo.saledetail.icode = item.icode 

Group by Convert(varchar(15), CASE lower(:as_datetype) 
									 		When 'originaldate'   Then dbo.saleledger.originaldate 
											When 'lastsavingdate' Then dbo.saleledger.date
								 			When 'billingdate'    Then dbo.saleledger.billingdate
									  	End,
					 101)

UNION ALL
SELECT date = Convert(varchar(15), CASE lower(:as_datetype) 
											  When 'originaldate' Then dbo.saleledger.originaldate 
											  When 'lastsavingdate' Then dbo.saleledger.date
 											  When 'billingdate' Then dbo.saleledger.billingdate
											  End ,   
							 101),
		 amout = Sum ( sd.looseqty * sd.saleprice ) 
		  
FROM 	 dbo.saleledger, 
		 dbo.saleinvdetail sd,
		 dbo.item, 
		 dbo.Customer

WHERE  CASE lower(:as_datetype) 
		 	When 'originaldate'   Then dbo.saleledger.originaldate 
			When 'lastsavingdate' Then dbo.saleledger.date
 			When 'billingdate'    Then dbo.saleledger.billingdate
	  	 End Between :ad_StartDate AND :ad_EndDate AND
		 dbo.saleledger.custcode IN (:al_custcode) AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = sd.saleinvcode AND
		 sd.icode = item.icode 

Group by Convert(varchar(15), CASE lower(:as_datetype) 
									 		When 'originaldate'   Then dbo.saleledger.originaldate 
											When 'lastsavingdate' Then dbo.saleledger.date
								 			When 'billingdate'    Then dbo.saleledger.billingdate
									  	End,
					 101)





"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_line1", string), ("as_line2", string), ("as_datetype", string))
 sort="date A"
)
