release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=100 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="manfcode"  )
column=(type=char(60) updatewhereclause=yes name=manfname dbname="manfname"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(10) updatewhereclause=yes name=discount dbname="discount"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="supplier"  )
 retrieve="SELECT 
	itemname = item.name,
	itemalias= item.customicode,
	manfcode = Manufacturer.manfcode, 
	manfname = Manufacturer.Name,
	qty      = ISNULL(Sum(S.qty), 0), 
	discount = ISNULL(SUM(S.Discount), 0),
	amount   = ISNULL(Sum(S.Amount), 0),
	supplier=
		(select a.name
		from 
			accounts a, itemsuppliers isp
		where 
			isp.icode = item.icode and 
			isp.suppcode = a.acccode and
			isp.priority in 
				(select p=min(ip.priority) 
				from itemsuppliers ip 
				where ip.icode = isp.icode))
FROM
	dbo.item,
	(SELECT 
		Client=CL.Name,
		crs_saledetail.icode,
		qty      = Sum(dbo.crs_saledetail.looseqty),
		discount = Round(Sum ( (dbo.crs_saledetail.looseqty * (dbo.crs_saledetail.saleprice - dbo.crs_saledetail.itemflatdisc)) * (dbo.crs_saledetail.discperc) * .01 + dbo.crs_saledetail.looseqty * dbo.crs_saledetail.itemflatdisc) , 2),
		amount   = Round(Sum ( dbo.crs_saledetail.looseqty * dbo.crs_saledetail.saleprice), 2)
	FROM 	 
		CRS_ClientInstance CI, 
		CRS_ClientList CL,
		dbo.crs_saleledger, dbo.crs_saledetail
	WHERE
		CL.ClientID = CI.ClientID AND 
		CI.ClientInstanceID = dbo.crs_saleledger.ClientInstanceID AND
		dbo.crs_saleledger.ClientInstanceID = dbo.crs_saledetail.ClientInstanceID AND
		dbo.crs_saleledger.saleinvcode = dbo.crs_saledetail.saleinvcode and  
		dbo.crs_saleledger.date BETWEEN :ad_StartDate and :ad_EndDate  and
		dbo.crs_saleledger.salecatcode IN (1, 2, 3) and
		dbo.crs_saledetail.icode IN (SELECT item.icode FROM Item WHERE Item.ManfCode IN (:ll_manfcode) and item.active = 1)
	GROUP BY 
		CL.Name,
		crs_saledetail.icode
	UNION ALL
	SELECT 
		Client=CL.Name,
		crs_srdetail.icode,
		qty      = -Sum(dbo.crs_srdetail.looseqty),
		discount = -Round(Sum ( (dbo.crs_srdetail.looseqty * dbo.crs_srdetail.srprice) * (dbo.crs_srdetail.discperc) * .01) , 2),
		amount   = -Round(Sum ( dbo.crs_srdetail.looseqty * dbo.crs_srdetail.srprice), 2)
	FROM 	 
		CRS_ClientInstance CI, 
		CRS_ClientList CL,
		dbo.crs_srledger, dbo.crs_srdetail
	WHERE
		CL.ClientID = CI.ClientID AND 
		CI.ClientInstanceID = dbo.crs_srledger.ClientInstanceID AND
		dbo.crs_srledger.ClientInstanceID = dbo.crs_srdetail.ClientInstanceID AND
		dbo.crs_srledger.srinvcode = dbo.crs_srdetail.srinvcode and  
		dbo.crs_srledger.date BETWEEN :ad_StartDate and :ad_EndDate  and
		dbo.crs_srdetail.icode IN (SELECT item.icode FROM Item WHERE Item.ManfCode IN (:ll_manfcode) and item.active = 1) AND
		IsNull(crs_srledger.saleinvcode,-1) IN (SELECT saleinvcode =
		CASE :as_return when 'A' THEN
			IsNull(crs_srledger.saleinvcode,-1) 
		ELSE
			(SELECT crs_saleledger.SALEINVCODE FROM dbo.crs_saleledger 
			WHERE dbo.crs_saleledger.date >= :ad_StartDate and dbo.crs_saleledger.date <= :ad_EndDate  and
				crs_saleledger.SALEINVCODE = crs_srledger.saleinvcode)
		END)

GROUP BY 
	CL.Name,
	crs_srdetail.icode) S, Manufacturer
WHERE
	dbo.item.manfcode in (:ll_manfcode) and
	dbo.item.active = 1 and
	dbo.item.manfcode = Manufacturer.manfcode AND
	dbo.item.icode = S.icode
GROUP BY 
	item.Icode,
	item.name,
	item.customicode,
	Manufacturer.manfcode,
	Manufacturer.Name
ORDER BY
	Manufacturer.Name,
	item.name"
  arguments=(("ll_manfcode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("as_return", string))
 sort="manfname A, itemname A"
)
