release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1447 color="536870912" )
summary(height=260 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=clientname dbname="ClientName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="CRS_SaleLedger.DATE"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="CustomerAlias"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(4) updatewhereclause=yes name=retqty dbname="RetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=retbonus dbname="RetBonus"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=decimal(13) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=decimal(6) updatewhereclause=yes name=discval dbname="discval"  )
 retrieve="SELECT 
	ClientName=CL.Name,
	SL.DATE,
	Type='S', 
	InvCode=SL.SaleInvCode,
	ItemCode=SD.ICode, 
	AliasName=I.CustomICode, 
	Item=I.Name, 
	CustomerAlias=A.AliasName,
	Customer=A.Name,
	Qty=SUM(SD.LooseQty),
	Bonus=SUM(SD.BonusQty),
	RetQty=0,
	RetBonus=0,
	Area=AR.Name,
	Rate = ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),
	Packing=I.PackingDesc,
	price= max(SD.saleprice),
	username=(select username from users where users.usercode=max(SL.salesmancode)),
	discval= Round(Sum (Round(( SD.looseqty  * (SD.saleprice - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc),2)), 2) + Round(Sum ( SD.looseqty   * (SD.saleprice  - SD.itemflatdisc) * (1 - (SD.discperc * .01))) * (max(SL.discperc) /100), 2)
FROM
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	crs_saleledger SL, crs_saledetail SD, 
	Accounts A, Customer C, Area AR, Item I
WHERE
	CL.ClientID = CI.ClientID AND 
	CI.ClientInstanceID = SL.ClientInstanceID AND
	SL.ClientInstanceID = SD.ClientInstanceID AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
	SL.CustCode = C.CustCode AND 
	C.CustCode = A.AccCode AND
	SD.ICode IN (:ar_ICode) AND
	SD.ICode =  I.ICode AND
	C.AreaCode = AR.AreaCode
GROUP BY
	CL.Name,
	SL.SaleInvCode,
	SD.ICode, 
	I.Name, 
	I.CustomICode,
	SD.SalePrice,
	I.SalePrice,
	I.PackUnits,
	I.PackingDesc,
	SL.DATE,
	A.AliasName,
	A.Name, 
	AR.Name
UNION ALL
SELECT
	ClientName=CL.Name,
	SL.DATE,
	Type='R',
	InvCode=SL.SRInvCode,
	ItemCode=SD.ICode, 
	AliasName=I.CustomICode, 
	Item=I.Name, 
	CustomerAliasName=A.AliasName,
	Customer=A.Name,
	Qty=0,
	Bonus=0,
	RetQty=SUM(SD.LooseQty),
	RetBonus=SUM(SD.BonusQty),
	AREA=AR.Name,
	Rate = ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),
	Packing=I.PackingDesc,
	price=max(SD.srprice),
	username=(select username from users where users.usercode=max(SL.salesmancode)),
	discval=Round(Sum (Round( SD.looseqty  * SD.srprice * (SD.discperc * .01),2)), 2)
				+Round(Sum (Round( (SD.looseqty  ) * SD.srprice * (1 - (SD.discperc * .01)),2)) * (max(SL.discperc) /100), 2)
FROM
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	crs_srledger SL, crs_srdetail SD, 
	Accounts A, Customer C, Area AR, Item I
WHERE
	CL.ClientID = CI.ClientID AND 
	CI.ClientInstanceID = SL.ClientInstanceID AND
	SL.ClientInstanceID = SD.ClientInstanceID AND
	SL.SRInvCode = SD.SRInvCode AND
	SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
	SL.CustCode = C.CustCode AND 
	C.CustCode = A.AccCode AND
	SD.ICode IN (:ar_ICode) AND
	SD.ICode =  I.ICode AND
	C.AreaCode = AR.AreaCode
GROUP BY
	CL.Name,
	SL.SRInvCode,
	SD.ICode, 
	I.Name, 
	I.CustomICode,
	SD.SRPrice,
	I.SalePrice,
	I.PackUnits,
	I.PackingDesc,
	SL.DATE,
	A.AliasName,
	A.Name, 
	AR.Name
ORDER BY
	I.Name, 
	I.CustomICode,
	DATE,
	InvCode,
	A.AliasName,
	A.Name, 
	AR.Name
"
  arguments=(("ar_icode", numberlist), ("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
