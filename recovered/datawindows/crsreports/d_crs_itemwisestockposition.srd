table(column=(type=char(100) updatewhereclause=yes name=crs_clientname dbname="CRS_ClientName"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(16) updatewhereclause=yes name=value dbname="Value"  )
 retrieve="SELECT 
	CRS_ClientName=CL.Name,
	Manufacturer = (SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = I.MANFCODE),
	AliasName = I.CustomICode,
	ItemName = I.Name,
	Qty = SUM(G.CurrQty),
	Value = SUM(G.CurrQty * ROUND(I.SalePrice / CASE WHEN I.PackUnits <= 0 THEN 1 ELSE I.PackUnits END, 2))
FROM 
	Item I,
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	CRS_GodownDetail G
WHERE 
	CL.ClientID = CI.ClientID AND
	CI.ClientInstanceID = G.ClientInstanceID AND
	I.ICode = G.ICode AND
	I.ICode IN (:ai_icode)
GROUP BY
	CL.Name, I.CustomICode, I.Name, I.MANFCODE
ORDER BY
	ItemName,
	CRS_ClientName
	"
  arguments=(("ai_icode", numberlist))
)
