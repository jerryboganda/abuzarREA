table(column=(type=char(100) updatewhereclause=yes name=crs_clientname dbname="CRS_ClientName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(16) updatewhereclause=yes name=value dbname="Value"  )
 retrieve="SELECT 
	CRS_ClientName=CL.Name,
	Qty = SUM(G.CurrQty),
	Value = SUM(G.CurrQty * ROUND(I.SalePrice / CASE WHEN I.PackUnits <= 0 THEN 1 ELSE I.PackUnits END, 2))
FROM 
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	Manufacturer,   
	Item I
	LEFT OUTER JOIN itemclass ON (I.ICCode = itemclass.ICCode)
	LEFT OUTER JOIN itempacking ON (I.PackCode = itempacking.PackCode),
	ItemCategory,
	CRS_GodownDetail G
WHERE 
	CASE :as_grouptype
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode 
		WHEN 'P' THEN I.PackCode 
		ELSE I.ICCode END IN (:ai_groupcode) and
	Manufacturer.manfcode = I.ManfCode and
	I.icatcode=itemcategory.icatcode and
	I.active=1 AND
	CL.ClientID = CI.ClientID AND
	CI.ClientInstanceID = G.ClientInstanceID AND
	I.ICode = G.ICode
GROUP BY
	CL.Name
ORDER BY
	CRS_ClientName"
  arguments=(("as_grouptype", string), ("ai_groupcode", numberlist))
)
