release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1108 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=183 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes name=clientinstanceid dbname="ClientInstanceID"  )
column=(type=char(100) updatewhereclause=no name=client dbname="Client"  )
column=(type=char(100) updatewhereclause=no name=customergroup dbname="customergroup"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=char(28) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=description dbname="Remark"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="Cash"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Aliasname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="OpenBalance"  )
column=(type=long updatewhereclause=yes name=c_areacode dbname="CRS_SaleLedger.AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=c_area dbname="CRS_SaleLedger.Area"  )
column=(type=char(100) updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=decimal(0) updatewhereclause=yes name=vrow dbname="VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VoucherCode"  )
column=(type=long updatewhereclause=yes name=header dbname="Header"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(6) updatewhereclause=yes name=grossvalue dbname="GrossValue"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsaletax dbname="ItemSaleTax"  )
column=(type=decimal(6) updatewhereclause=yes name=itemvalue dbname="ItemValue"  )
column=(type=decimal(6) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=decimal(6) updatewhereclause=yes name=others dbname="Others"  )
column=(type=long updatewhereclause=yes name=pendingcheque dbname="PendingCheque"  )
 retrieve="SELECT  
	ClientInstanceID=S.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=S.ClientInstanceID AND CI.ClientID=CL.ClientID),
	customergroup = (select cg.name from CustomerGroup CG WHERE customerGroupcode=:ar_custgroupcode),
	DocumentCode=S.SaleInvCode,
	Type='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Customer=c.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	Aliasname=C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM CRS_VirtualGL VirtualGL
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.RowID),
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=SUM(D.LooseQty),
	Bonus=SUM(D.BonusQty),
	Rate=MAX(D.SalePrice),
	GrossValue=SUM(D.LooseQty * D.SalePrice),
	Discount=
		SUM(D.looseqty*D.itemflatdisc) +
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) + 
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * 
			(1-(.01*D.discperc)) * (.01 * S.discperc)),
	ItemSaleTax=SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
	ItemValue=SUM(D.LooseQty * D.SalePrice) - 
		SUM((D.looseqty*D.itemflatdisc) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (1-(.01*D.discperc)) * 
				(.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM CRS_SaleDetail SD 
		WHERE SD.ClientInstanceID = S.ClientInstanceID AND SD.SaleInvCode=S.SaleInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM CRS_SaleDetail SD 
		WHERE SD.ClientInstanceID = S.ClientInstanceID AND SD.SaleInvCode=S.SaleInvCode) THEN CASE WHEN ISNULL(S.CashCharged,0) > 0 OR ISNULL((SELECT SUM(M.Amount) FROM CashierWindow M WHERE M.SaleInvCode = S.SaleInvCode), 0) > 0 THEN ISNULL(S.CashCharged, 0) + ISNULL((SELECT SUM(M.Amount) FROM CashierWindow M WHERE M.SaleInvcode = S.SaleInvCode), 0) ELSE CASE WHEN S.SaleCatCode = 2 THEN 0 ELSE T.NetAmt END  END ELSE 0 END,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM CRS_SaleDetail SD 
		WHERE SD.ClientInstanceID = S.ClientInstanceID AND SD.SaleInvCode=S.SaleInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode)) CT, 
		Area AR
	WHERE	A.AccCode = CT.CustCode and 
			AR.AreaCode=CT.AreaCode) C,
	CRS_SaleLedger S,	 
	CRS_SaleDetail D,
	(SELECT 
		SS.ClientInstanceID,
		SS.SaleInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT))) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT))) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc),
		InvSaleTax=	ROUND((SUM((DD.looseqty * 
			(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT))) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT)))
	FROM CRS_SaleLedger SS, CRS_SaleDetail DD ,
		(SELECT CT.* 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode)) CT
	WHERE 
		(SS.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE SS.Clientinstanceid END) AND
		SS.ClientInstanceID = DD.ClientInstanceID AND
		SS.Posted = 'Y' AND SS.AccountFor = 'Y' AND
		SS.SaleInvCode = DD.SaleInvCode AND
		SS.CustCode = CT.CustCode AND
		SS.date  BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		SS.ClientInstanceID,
		SS.SaleInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	(S.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE S.Clientinstanceid END) AND
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.ClientInstanceID = D.ClientInstanceID AND
	S.SaleInvCode = D.SaleInvCode AND 
	S.ClientInstanceID = T.ClientInstanceID AND S.SaleInvCode = T.SaleInvCode AND
	S.CustCode = C.AccCode AND
	S.date  BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	S.ClientInstanceID,
	S.SaleInvCode,
	S.SaleCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	D.ICode,
	D.RowGroup,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.CashCharged,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	C.AreaCode,
	C.Area,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT 
	ClientInstanceID=S.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=S.ClientInstanceID AND CI.ClientID=CL.ClientID),
	customergroup = (select cg.name from CustomerGroup CG WHERE customerGroupcode=:ar_custgroupcode),
	DocumentCode=S.SaleInvCode,
	Type='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Customer=c.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	AliasName=C.AliasName, 
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM CRS_VirtualGL VirtualGL
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.RowID),
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=SUM(D.LooseQty),
	Bonus=SUM(D.BonusQty),
	Rate=MAX(D.SalePrice),
	GrossValue=SUM(D.LooseQty * D.SalePrice),
	Discount=
		SUM(D.looseqty*D.itemflatdisc) +
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) + 
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * 
			(1-(.01*D.discperc)) * (.01 * S.discperc)),
	ItemSaleTax=SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
	ItemValue=SUM(D.LooseQty * D.SalePrice) - 
		SUM((D.looseqty*D.itemflatdisc) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (1-(.01*D.discperc)) * 
				(.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM CRS_SaleInvDetail SD 
		WHERE SD.ClientInstanceID = S.ClientInstanceID AND SD.SaleInvCode=S.SaleInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM CRS_SaleInvDetail SD 
		WHERE SD.ClientInstanceID = S.ClientInstanceID AND SD.SaleInvCode=S.SaleInvCode) THEN CASE WHEN ISNULL(S.CashCharged,0) > 0 OR ISNULL((SELECT SUM(M.Amount) FROM CRS_CashierWindow M WHERE M.SaleInvCode = S.SaleInvCode), 0) > 0 THEN ISNULL(S.CashCharged, 0) + ISNULL((SELECT SUM(M.Amount) FROM CashierWindow M WHERE M.SaleInvcode = S.SaleInvCode), 0) ELSE CASE WHEN S.SaleCatCode = 2 THEN 0 ELSE T.NetAmt END  END ELSE 0 END,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM CRS_SaleInvDetail SD 
		WHERE SD.ClientInstanceID = S.ClientInstanceID AND SD.SaleInvCode=S.SaleInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode)) CT, 
			Area AR
	WHERE	A.AccCode = CT.CustCode and 
			AR.AreaCode=CT.AreaCode) C,
	CRS_SaleLedger S,	 
	CRS_SaleInvDetail D,
	(SELECT 
		SS.ClientInstanceID, 
		SS.SaleInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT))) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT))) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc),
		InvSaleTax=	ROUND((SUM((DD.looseqty * 
			(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT))) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, (SELECT CAST(DBO.fn_GetPreference('roundsaleinvon') AS INT)))
	FROM CRS_SaleLedger SS, CRS_SaleInvDetail DD, 
		(SELECT CT.* 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode)) CT
	WHERE 
		(SS.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE SS.Clientinstanceid END) AND
		SS.ClientInstanceID = DD.ClientInstanceID AND 
		SS.Posted = 'Y' AND SS.AccountFor = 'Y' AND
		SS.ImpactInventory='N' AND
		SS.SaleInvCode = DD.SaleInvCode AND
		SS.CustCode = CT.CustCode AND
		SS.date  BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		SS.ClientInstanceID,
		SS.SaleInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	(S.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE S.Clientinstanceid END) AND
	S.ClientInstanceID = D.ClientInstanceID AND 
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.ImpactInventory='N' AND
	S.SaleInvCode = D.SaleInvCode AND 
	S.ClientInstanceID = T.ClientInstanceID AND  S.SaleInvCode = T.SaleInvCode AND
	S.CustCode = C.AccCode AND
	S.date  BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	S.ClientInstanceID, 
	S.SaleInvCode,
	S.SaleCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	D.ICode,
	D.RowGroup,
	S.CustCode, 
	S.Date,
	S.CashCharged,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	C.AreaCode,
	C.Area,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	ClientInstanceID=S.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=S.ClientInstanceID AND CI.ClientID=CL.ClientID),
	customergroup = (select cg.name from CustomerGroup CG WHERE customerGroupcode=:ar_custgroupcode),
	DocumentCode=S.SaleInvCode,
	Type='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.AmtDate, 
	Remark = 'Cash Recvd. During Sale #:' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Customer=c.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	AliasName=C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM CRS_VirtualGL VirtualGL
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=S.AmtReference,
	VRow=9999999,
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = 0,
	Credit= S.Amt,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode)) CT, 
			Area AR
	WHERE	A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	CRS_SaleLedger S
WHERE   
	(S.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE S.Clientinstanceid END) AND
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.CustCode = C.AccCode AND
	S.AmtDate  BETWEEN :ar_startdate AND :ar_enddate AND
	S.Amt <> 0 AND S.SaleCatcode = 2
UNION ALL
SELECT  
	ClientInstanceID=S.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=S.ClientInstanceID AND CI.ClientID=CL.ClientID),
	customergroup = (select cg.name from CustomerGroup CG WHERE customerGroupcode=:ar_custgroupcode),
	DocumentCode=S.SRInvCode,
	Type='SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Date = S.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Customer=c.Name,
	Cash = CASE S.SRCatCode WHEN 7 THEN 'N' ELSE 'Y' END,
	AliasName=C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM CRS_VirtualGL VirtualGL
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=NULL,
	VRow=MAX(D.SRUTN),
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=-SUM(D.LooseQty),
	Bonus=-SUM(D.BonusQty),
	Rate=MAX(D.SRPrice),
	GrossValue=-SUM(D.LooseQty * D.SRPrice),
	Discount= -1 *
		(SUM(D.looseqty * D.SRPrice * (.01 * D.discperc)) + 
		SUM(D.looseqty * D.SRPrice * 
			(1-(.01*D.discperc)) * (.01 * S.discperc))),
	ItemSaleTax= -1 * (SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * D.SRPrice) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01)),
	ItemValue= -1 * (SUM(D.LooseQty * D.SRPrice) - 
		SUM((D.looseqty * D.SRPrice * .01 * D.discperc) +
				(D.looseqty * D.SRPrice * (1-(.01*D.discperc)) * (.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * D.SRPrice * (1 - (.01 * D.discperc)) * D.gstperc * .01))),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) FROM CRS_SRDetail SD 
		WHERE S.ClientInstanceID = SD.ClientInstanceID AND SD.SRInvCode=S.SRInvCode) THEN CASE WHEN ISNULL(S.CashCharged,0) > 0 OR ISNULL((SELECT SUM(M.Amount) FROM MasterCashWin M WHERE M.DocumentType = 'SR' AND M.DocumentCode = S.SRInvCode), 0) > 0 THEN ISNULL(S.CashCharged,0) + ISNULL((SELECT SUM(M.Amount) FROM CRS_MasterCashWin M WHERE M.DocumentType = 'SR' AND M.DocumentCode = S.SRInvCode), 0) ELSE CASE WHEN S.SRCatCode = 7 THEN 0 ELSE T.NetAmt END END ELSE 0 END,
	Credit= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) FROM CRS_SRDetail SD WHERE S.ClientInstanceID = SD.ClientInstanceID AND SD.SRInvCode=S.SRInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) 
		FROM CRS_SRDetail SD 
		WHERE S.ClientInstanceID = SD.ClientInstanceID AND SD.SRInvCode=S.SRInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A,
		(SELECT CT.* 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode)) CT, 
		Area AR
	WHERE	A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	CRS_SRLedger S,	 
	CRS_SRDetail D,
	(SELECT 
		SS.ClientInstanceID,
		SS.SRInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), (SELECT CAST(DBO.fn_GetPreference('roundsalereturninvon') AS INT))) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, (SELECT CAST(DBO.fn_GetPreference('roundsalereturninvon') AS INT))) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * DD.SRPrice) * (1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty * DD.SRPrice *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc)),
		InvSaleTax=	ROUND((SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), (SELECT CAST(DBO.fn_GetPreference('roundsalereturninvon') AS INT))) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, (SELECT CAST(DBO.fn_GetPreference('roundsalereturninvon') AS INT)))
	FROM CRS_SRLedger SS, CRS_SRDetail DD,
		(SELECT CT.* 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode)) CT
	WHERE 
		(SS.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE SS.Clientinstanceid END) AND
		SS.ClientInstanceID = DD.ClientInstanceID AND 
		SS.Posted = 'Y' AND SS.AccountFor = 'Y' AND
		SS.CustCode = CT.CustCode AND
		SS.SRInvCode = DD.SRInvCode AND
		SS.date  BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		SS.ClientInstanceID,
		SS.SRInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE 
	(S.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE S.Clientinstanceid END) AND
	S.ClientInstanceID = D.ClientInstanceID AND   
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.SRInvCode = D.SRInvCode AND S.SRInvCode = T.SRInvCode AND
	S.CustCode = C.AccCode AND
	S.date  BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	S.ClientInstanceID,
	S.SRInvCode,
	S.SRCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	D.ICode,
	S.CustCode, 
	S.Date,
	S.CashCharged,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	C.AccCode,
	C.AliasName,
	C.Name,
	C.Address1,
	C.AreaCode,
	C.Area,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	ClientInstanceID=S.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=S.ClientInstanceID AND CI.ClientID=CL.ClientID),
	customergroup = (select cg.name from CustomerGroup CG WHERE customerGroupcode=:ar_custgroupcode),
	DocumentCode=S.SRInvCode,
	Type='SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Date = S.AmtDate, 
	Remark = 'Cash Paid During S/Return #:' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Customer=c.Name,
	Cash = CASE S.SRCatCode WHEN 7 THEN 'N' ELSE 'Y' END,
	AliasName=C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM CRS_VirtualGL VirtualGL 
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo=S.AmtReference,
	VRow=9999999,
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = S.Amt,
	Credit= 0,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A,
		(SELECT CT.* 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode)) CT, 
		Area AR
	WHERE	A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C,
	CRS_SRLedger S
WHERE   
	(S.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE S.Clientinstanceid END) AND
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode) AND
	S.CustCode = C.AccCode AND
	S.AmtDate  BETWEEN :ar_startdate AND :ar_enddate AND
	S.Amt <> 0 AND S.SRCatCode = 7
UNION ALL
SELECT
	ClientInstanceID=V.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=V.ClientInstanceID AND CI.ClientID=CL.ClientID),
	customergroup = (select cg.name from CustomerGroup CG WHERE customerGroupcode=:ar_custgroupcode),
	V.documentcode, 
	Type = V.documenttype + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), V.documentcode))), 
	Date = V.Date, 
	Remark = V.Remarks,
	Customer=C.Name,
	Cash = CASE ISNULL(V.AlternateAccCode, -1) WHEN -1 THEN 'N' ELSE 'Y' END,
	AliasName=C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM CRS_VirtualGL VirtualGL 
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	V.CheckNo,
	V.VRow,
	V.VoucherCode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvSaleTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit=V.Debit,
	Credit=V.Credit,
	Others= 0,
	PendingCheque=0
FROM
	CRS_VirtualGL V,
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode)) CT, 
		Area AR
	WHERE	A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C
WHERE   
	(V.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE V.Clientinstanceid END) AND
	V.DocumentType NOT IN ('SV','SR','RS','RR') AND
	(V.AccCode = C.AccCode OR V.AlternateAccCode = C.AccCode ) and
	V.date  BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT
	ClientInstanceID=N.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=N.ClientInstanceID AND CI.ClientID=CL.ClientID),
	customergroup = (select cg.name from CustomerGroup CG WHERE customerGroupcode=:ar_custgroupcode),
	documentcode = N.NoteCode, 
	Type = Case N.NoteCatCode When 1 Then '*NR' Else '*NP' End + '-' + RTrim(LTrim(convert(char(6), N.NoteCode))),  
	date = N.duedate, 
	Remark = N.Remarks,
	Customer=C.Name,
	Cash = 'N',
	AliasName=C.AliasName,
	Address=C.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM CRS_VirtualGL VirtualGL
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				VirtualGL.AccCode=C.AccCode AND 
				VirtualGL.date < :ar_startdate),
	c.AreaCode,
	c.Area,
	CheckNo = LEFT(N.DocumentNumber, 20),
	VRow=999999,
	VoucherCode=N.vouchercode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvSaleTax=0
	RoundingDiff=0*/
	NetAmt=0,
	debit = Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = C.AccCode THEN 0 ELSE N.Amount END ELSE CASE WHEN N.AccCode = C.AccCode THEN N.Amount ELSE 0 END END,
	credit= Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = C.AccCode THEN N.Amount ELSE 0 END ELSE CASE WHEN N.AccCode = C.AccCode THEN 0 ELSE N.Amount END END,
	Others= 0,
	PendingCheque=1
FROM
	CRS_Notes N,
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode)) CT, 
		Area AR
	WHERE	A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C
WHERE   
	(N.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE N.Clientinstanceid END) AND
	(N.AccCode = C.AccCode OR N.BankAccCode = C.AccCode ) and
	N.Posted = 'N' AND N.Finalized = 'Y'
UNION ALL
SELECT
	ClientInstanceID=V.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=V.ClientInstanceID AND CI.ClientID=CL.ClientID),
	customergroup = (select cg.name from CustomerGroup CG WHERE customerGroupcode=:ar_custgroupcode),
	V.DocumentCode, 
	Type = V.DocumentType + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), V.DocumentCode))), 
	Date = V.Date, 
	Remark = CASE debit 
			WHEN 0 THEN 'Cash Paid Against Sale Ret. # '
			ELSE 'Cash Received Against Sales Inv. # '
			END + RTRIM(LTRIM(CONVERT(CHAR(6), V.DocumentCode))),
	Customer=c.Name,
	Cash = CASE ISNULL(v.AlternateAccCode, -1) WHEN -1 THEN 'N' ELSE 'Y' END,
	AliasName=C.AliasName,
	Address=c.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM CRS_VirtualGL VirtualGL
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				Virtualgl.AccCode=C.AccCode and 
				VirtualGL.Date < :ar_startdate),
	C.AreaCode,
	c.Area,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvSaleTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit = V.Credit,
	Credit= V.Debit,
	Others=0,
	PendingCheque=0
FROM 
	CRS_VirtualGL V,
	(SELECT	A.AliasName, A.AccCode, A.Name, CT.Address1, CT.AreaCode, Area=AR.Name
	FROM	Accounts A, 
		(SELECT CT.* 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode)) CT, 
		Area AR
	WHERE	A.AccCode = CT.CustCode and AR.AreaCode=CT.AreaCode) C
WHERE   
	(V.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE V.Clientinstanceid END) AND
	V.DocumentType NOT IN ('SV','SR','RS','RR') AND
	(V.AlternateAccCode = C.AccCode ) and
	V.date  BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT
	ClientInstanceID=NULL,
	Client=NULL,
	customergroup = (select cg.name from CustomerGroup CG WHERE customerGroupcode=:ar_custgroupcode),
	DocumentCode=NULL, 
	Type = NULL, 
	Date = :ar_enddate, 
	remark = 'OPENING BALANCE',
	Customer=c.name,
	cash = 'N',
	AliasName=c.aliasname,
	address=c.address1,
	openbalance=ISNULL((select isnull(sum(debit-credit), 0) from CRS_VirtualGL virtualgl 
			where	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				virtualgl.acccode=C.acccode and 
				virtualgl.date < :ar_startdate), 0),
	c.areacode,
	c.area,
	CheckNo=NULL,
	VRow=0,
	vouchercode=NULL,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvSaleTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit = 0,
	Credit= 0,
	Others=0,
	PendingCheque=0
from
   (SELECT a.aliasname, a.acccode, a.name, ct.address1, ct.areacode, area=ar.name
	FROM	accounts a, 
			(SELECT CT.* 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode)) CT, 
			area ar
	WHERE	a.acccode = ct.custcode and 
			ar.areacode=ct.areacode AND 
			a.acccode NOT IN 
			(SELECT DISTINCT VGL.AccCode 
			FROM CRS_VirtualGL VGL 
			WHERE 
				(VGL.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE VGL.Clientinstanceid END) AND
				VGL.Date BETWEEN :ar_startdate AND :ar_enddate AND 
				VGL.AccCode IN 
					(SELECT CT.Custcode 	FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode))
			UNION ALL
			SELECT DISTINCT N.AccCode 
			FROM CRS_Notes N
			WHERE 
				(N.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE N.Clientinstanceid END) AND
				N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN 
					(SELECT CT.custcode FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode))
			UNION ALL
			SELECT DISTINCT N.BankAccCode 
			FROM CRS_Notes N
			WHERE 
				(N.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE N.Clientinstanceid END) AND
				N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN 
					(SELECT CT.custcode FROM Customer CT WHERE CT.CustCode IN (select custcode from customergroupdetail where customergroupcode=:ar_custgroupcode))) ) C
ORDER BY
	Customer, 
	AliasName, 
	Date, 
	Type, 
	VRow"
  arguments=(("ai_clientinstanceid", number), ("ar_custgroupcode", number), ("ar_startdate", datetime), ("ar_enddate", datetime))
