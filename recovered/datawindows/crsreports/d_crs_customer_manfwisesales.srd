release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=560 color="536870912" )
summary(height=160 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="CustomerAlias"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(121) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(4) updatewhereclause=yes name=returnqty dbname="returnqty"  )
column=(type=decimal(6) updatewhereclause=yes name=saleamount dbname="saleamount"  )
column=(type=decimal(6) updatewhereclause=yes name=saleretamount dbname="saleretamount"  )
column=(type=decimal(6) updatewhereclause=yes name=netamount dbname="netamount"  )
column=(type=decimal(4) updatewhereclause=yes name=salebonusqty dbname="salebonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=retbonusqty dbname="retbonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
 retrieve="SELECT  
	itemname=I.name, 
	itemalias=I.customicode, 
	GroupName= 
		CASE :as_reportgrouping
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,   
	CustomerAlias=(Select Ac.AliasName FROM accounts Ac Where Ac.Acccode = A.CustCode),
	customer=(Select Ac.Name FROM accounts Ac Where Ac.Acccode = A.CustCode),
	Address=(Select RTRIM(LTRIM(isnull(C.Address1,''))) + ' ' + RTRIM(LTRIM(isnull(C.Address2,''))) FROM Customer C Where C.CustCode = A.CustCode),
	City=(Select isnull(C.CITY,'') FROM Customer C Where C.CustCode = A.CustCode),
	qty=Sum(A.qty),
	returnqty=Sum(A.returnqty),
	saleamount=Sum(A.saleamount),
	saleretamount=Sum(A.saleretamount),
	netamount=Sum(A.amount),
	salebonusqty=sum(A.salebonusqty),
	retbonusqty=sum(A.retbonusqty),
	Stock=(select isnull(sum(godowndetail.currqty), 0) from godowndetail 
			where godowndetail.icode=I.icode and gcode IN 
				(select case :as_AllGodown WHEN 'Y' THEN gcode ELSE :ai_gcode end from godown))
FROM
	Item I,
	(SELECT	
		Client=CL.Name,
		dbo.crs_saledetail.icode,
		qty= Sum(dbo.crs_saledetail.looseqty),
		returnqty=0,
		salebonusqty=sum(dbo.crs_saledetail.bonusqty),
		retbonusqty=0,
		amount   = Round(Sum ( (dbo.crs_saledetail.looseqty + dbo.crs_saledetail.bonusqty) * dbo.crs_saledetail.saleprice), 2),
		saleamount=Round(Sum ( (dbo.crs_saledetail.looseqty + dbo.crs_saledetail.bonusqty) * dbo.crs_saledetail.saleprice), 2),
		saleretamount=0,
		dbo.crs_saleledger.custcode
	FROM 	
		CRS_ClientInstance CI, 
		CRS_ClientList CL,
		dbo.crs_saleledger, 
	 	dbo.crs_saledetail, 
	 	dbo.item
	WHERE	
		CL.ClientID = CI.ClientID AND 
		CI.ClientInstanceID = dbo.crs_saleledger.ClientInstanceID AND
		dbo.crs_saleledger.ClientInstanceID = dbo.crs_saledetail.ClientInstanceID AND
		dbo.crs_saleledger.SaleInvCode = dbo.crs_saledetail.SaleInvCode AND
		dbo.crs_saleledger.date BETWEEN :ad_StartDate and :ad_EndDate  and
	 	dbo.crs_saleledger.custcode IN (:ll_custcode) and
	 	dbo.crs_saleledger.saleinvcode = dbo.crs_saledetail.saleinvcode and  
		CASE :as_reportgrouping
		WHEN 'M' THEN dbo.item.manfcode
		WHEN 'C' THEN dbo.item.ICatCode
		WHEN 'L' THEN dbo.item.ICCode
		ELSE dbo.item.PACKCODE END IN (:ll_groupcode) and
	 	dbo.crs_saledetail.icode = item.icode 
	GROUP BY
		CL.Name,
		crs_saledetail.icode,
		dbo.crs_saleledger.custcode
	UNION ALL
	SELECT 	
		Client=CL.Name,
		dbo.crs_srdetail.icode,
	 	qty      = 0,
		returnqty=(-1 * Sum(dbo.crs_srdetail.looseqty)),
		salebonusqty=0,
		retbonusqty=(-1 * sum(dbo.crs_srdetail.bonusqty)),
		amount   = (-1 * Round(Sum ( (dbo.crs_srdetail.looseqty + dbo.crs_srdetail.bonusqty) * dbo.crs_srdetail.srprice), 2)),
		saleamount=0,
		saleretamount=Round(Sum ( (dbo.crs_srdetail.looseqty + dbo.crs_srdetail.bonusqty) * dbo.crs_srdetail.srprice), 2),
		dbo.crs_srledger.custcode
	FROM
		CRS_ClientInstance CI, 
		CRS_ClientList CL,
		dbo.crs_srledger, 
		dbo.crs_srdetail,    
		dbo.item
	WHERE
		CL.ClientID = CI.ClientID AND 
		CI.ClientInstanceID = dbo.crs_srledger.ClientInstanceID AND
		dbo.crs_srledger.ClientInstanceID = dbo.crs_srdetail.ClientInstanceID AND
		dbo.crs_srledger.SRInvCode = dbo.crs_srdetail.SRInvCode AND
		dbo.crs_srledger.date BETWEEN :ad_StartDate and :ad_EndDate and
	 	dbo.crs_srledger.custcode IN (:ll_custcode) and
		dbo.crs_srledger.srinvcode = dbo.crs_srdetail.srinvcode and  
		CASE :as_reportgrouping
		WHEN 'M' THEN dbo.item.manfcode
		WHEN 'C' THEN dbo.item.ICatCode
		WHEN 'L' THEN dbo.item.ICCode
		ELSE dbo.item.PACKCODE END IN (:ll_groupcode) and
		dbo.crs_srdetail.icode = item.icode 
	GROUP BY 
		CL.Name,
		crs_srdetail.icode, 
		dbo.crs_srledger.custcode) AS A
WHERE
	A.icode = I.icode
GROUP BY 
	A.CustCode,
	I.ManfCode,
	I.ICatCode,
	I.ICCode,
	I.PackCode,
	I.name,
	I.customicode,
	I.Icode
ORDER BY
	Customer,
	GroupName,
	I.name,
	I.Icode
"
  arguments=(("ll_groupcode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ll_CustCode", numberlist), ("as_AllGodown", string), ("ai_gcode", number), ("as_reportgrouping", string))
)
