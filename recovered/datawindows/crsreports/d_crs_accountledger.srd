table(column=(type=long updatewhereclause=yes name=status dbname="Status"  )
column=(type=long updatewhereclause=yes name=clientinstanceid dbname="ClientInstanceID"  )
column=(type=char(100) updatewhereclause=no name=client dbname="Client"  )
column=(type=long updatewhereclause=yes name=code dbname="code1"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date1"  )
column=(type=char(27) updatewhereclause=yes name=type dbname="name2"  )
column=(type=char(60) updatewhereclause=yes name=account dbname="name1"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="name5"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="value1"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="value2"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="name3"  )
column=(type=char(60) updatewhereclause=yes name=subaccount dbname="name4"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="Vrow"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="OpenBalance"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="vouchercode"  )
 retrieve="SELECT 
	Status=0,
	ClientInstanceID=V.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=V.ClientInstanceID AND CI.ClientID=CL.ClientID),
	code1 = V.AccCode, 
	date1 = V.date, 
	name2 = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	name1 = A.name,		
	name5 = A.aliasname,		
	value1= V.Debit,
	value2= V.Credit,
	name3 = V.Remarks,
	name4 = S.name, 
	CheckNo = V.CheckNo,
	Vrow=V.VRow,
	OpenBalance=
			ISNULL((select isnull(sum(virtualgl.debit - virtualgl.credit), 0) from crs_virtualgl virtualgl
			where	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=V.acccode) and 
				virtualgl.date < :startdate), 0),
	vouchercode=V.vouchercode
FROM 
     CRS_VirtualGL V, Accounts A, SubAccounts S
WHERE
	(V.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE V.Clientinstanceid END) AND
	V.AccCode IN (:acccode) and
	V.AccCode = A.AccCode AND
	V.Date BETWEEN :startdate and :enddate AND
	A.SubCode = S.SubAccCode
ORDER BY
	name1, name5, status, date, name2, V.VRow
"
  arguments=(("ai_clientinstanceid", number), ("AccCode", numberlist), ("StartDate", datetime), ("EndDate", datetime))
)
