table(column=(type=long updatewhereclause=yes name=clientinstanceid dbname="ClientInstanceID"  )
column=(type=char(12) updatewhereclause=no name=client dbname="Client"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="name1"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="value1"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="value2"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(30) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=char(100) updatewhereclause=yes name=custphoneno dbname="custphoneno"  )
 retrieve="SELECT
	ClientInstanceID=:ai_clientinstanceid,
	Client=CASE WHEN :ai_clientinstanceid <= 0 THEN 'CONSOLIDATED' ELSE (SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=:ai_clientinstanceid AND CI.ClientID=CL.ClientID) END,
	name1, 
	value1=CASE WHEN Value1 > 0 THEN Value1 ELSE 0 END, 
	value2=CASE WHEN Value1 < 0 THEN ABS(Value1) ELSE 0 END, 
	AliasName, 
	Category, 
	Area, 
	AreaCode,
	salesperson=(select name from salesman S where S.salesmancode=A.SalesManCode),
	custphoneno
FROM
	(SELECT 
		A.Name AS name1, 
		Sum(V.Balance) AS value1, 
		A.AliasName, 
		Category=CC.Name, 
		Area=Area.Name, 
		AreaCode=Area.AreaCode,
		salesmancode=max(C.SalesManCode),
		custphoneno=max(C.phone)
	FROM 
		Accounts A
		LEFT OUTER JOIN 
		(SELECT T.AccCode, Sum(T.Debit - T.Credit) AS Balance 
		FROM CRS_VirtualGL T 
		WHERE 
			(T.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE T.Clientinstanceid END) AND
			T.Date <= :ar_Date
		GROUP BY T.AccCode) AS V ON (A.AccCode = V.AccCode),
		SubAccounts S,
		Customer C,
		CustomerCategory CC,
		Area
	WHERE 
		A.SubCode = S.SubAccCode AND 
		S.SubAccCode = 3 AND 
		(A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'Y' END OR
		A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'N' END) AND
		A.AccCode = C.CustCode AND 
		C.CustCatCode = CC.CustCatCode AND
		C.AreaCode IN (:ar_Areas) AND 
		CC.CustCatCode IN (:ar_CustCat) AND 
		C.AreaCode = Area.AreaCode
	GROUP BY 
		A.AccCode, A.Name, A.AliasName, Area.Name, Area.AreaCode, CC.Name) A
ORDER BY 
	Area, Category, NAME1, AliasName"
  arguments=(("ai_clientinstanceid", number), ("ar_areas", numberlist), ("ar_custcat", numberlist), ("ar_date", datetime), ("ar_restricted", number))
)
