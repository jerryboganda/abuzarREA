header(height=488 color="536870912" )
summary(height=112 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=crs_clientname dbname="CRS_ClientName"  )
column=(type=decimal(2) updatewhereclause=yes name=purchase dbname="Purchase"  )
column=(type=decimal(2) updatewhereclause=yes name=preturns dbname="PReturns"  )
 retrieve="SELECT 
	CRS_ClientName=CL.Name,
	Purchase = SUM(S.Purchase),
	PReturns = SUM(S.PReturns)
FROM 
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	(SELECT 
		S.ClientInstanceID,
		Purchase = SUM(S.InvTotal),
		PReturns = 0.00
	FROM CRS_PurLedger S
	WHERE S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		S.ClientInstanceID
	UNION ALL
	SELECT 
		S.ClientInstanceID,
		Purchase = 0.00,
		PReturns = SUM(S.InvTotal)
	FROM CRS_PRLedger S
	WHERE S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		S.ClientInstanceID
	UNION ALL
	SELECT
		ClientInstanceID,
		Purchase = 0.00,
		PReturns = 0.00
	FROM CRS_ClientInstance) S
WHERE 
	CL.ClientID = CI.ClientID AND
	CI.ClientInstanceID = S.ClientInstanceID
GROUP BY
	CL.Name"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="crs_clientname A"
)
