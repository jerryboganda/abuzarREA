 retrieve="SELECT 
	orderby=code2,
	groupcode=code5,
	groupname=name5,
	itemcode=code1, 
	aliasname=name2,  
	itemname=name1,
	TradePrice = I.SalePrice,
	packing=name3, 
	areacode=code3,
	area=name4,
	areaname1=c_name1,
	areaname2=c_name2,
	areaname3=c_name3,
	areaname4=c_name4,
	areaname5=c_name5,
	areaname6=c_name6,
	areaname7=c_name7,
	areaname8=c_name8,
	areaname9=c_name9,
	areaname10=c_name10,
	areaname11=c_name11,
	areaname12=c_name12,
	areaname13=c_name13,
	qty1,
	qty2,
	qty3,
	qty4,
	qty5,
	qty6,
	qty7,
	qty8,
	qty9,
	qty10,
	qty11,
	qty12,
	qty13,
	val1,
	val2,
	val3,
	val4,
	val5,
	val6,
	val7,
	val8,
	val9,
	val10,
	val11,
	val12,
	val13,
	totqty,
	totval

from 
	crosstab_reportdata , Item I
WHERE 
	I.ICode = crosstab_reportdata.Code1
order by 
	area, 
	groupname, 
	orderby, 
	itemname, 
	aliasname, 
	packing"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="groupname A, orderby A, itemname A"
)
