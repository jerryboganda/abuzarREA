release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1270 color="536870912" )
summary(height=302 color="536870912" )
footer(height=10 color="536870912" )
detail(height=208 color="536870912" )
table(column=(type=long updatewhereclause=yes name=manfcode dbname="Manufacturer.ManfCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Manufacturer.Name"  )
column=(type=decimal(6) updatewhereclause=yes name=grossvalue dbname="grossvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=discvalue dbname="discvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="salevalue"  )
column=(type=decimal(6) updatewhereclause=yes name=returnval dbname="returnval"  )
 retrieve="SELECT  
	M.ManfCode, 
	M.Name, 
	grossvalue = ROUND(SUM(
		CASE P.TYPE WHEN 'S' THEN
			P.grossvalue
		ELSE 0 END), 0),
	discvalue = ROUND ( SUM ( 
		CASE P.TYPE WHEN 'S' THEN
			P.itemdiscvalue + P.invitemdiscvalue +
									P.flatdisc * ( P.itemvalue/
									CASE P.grossamt WHEN 0 THEN 1 
									ELSE P.grossamt END)
		ELSE 0 END), 0),
	salevalue=ROUND(SUM(
		CASE P.TYPE WHEN 'S' THEN
			P.itemvalue - (P.flatdisc *(P.itemvalue/
			CASE P.grossamt WHEN 0 THEN 1 
			ELSE P.grossamt END))
		ELSE 0 END), 0),
	returnval=ROUND(SUM(
		CASE P.TYPE WHEN 'R' THEN
			P.itemvalue - (P.flatdisc*(P.itemvalue/
				CASE P.grossamt WHEN 0 THEN 1 
				ELSE P.grossamt END)) 
		ELSE 0 END), 0)
FROM 
(
SELECT
	Client=CL.Name,
	crs_saleledger.saleinvcode,
	crs_saledetail.icode,
	GrossValue = SUM(crs_saledetail.looseqty * crs_saledetail.saleprice ) ,
	ItemDiscValue = SUM((crs_saledetail.looseqty * (crs_saledetail.saleprice - crs_saledetail.itemflatdisc))*
						 (.01 * crs_saledetail.discperc) + crs_saledetail.itemflatdisc ),
	InvItemDiscValue = SUM((crs_saledetail.looseqty*(crs_saledetail.saleprice - crs_saledetail.itemflatdisc))*
							(1 - (.01 * crs_saledetail.discperc) ) *  (.01 * crs_saleledger.discperc) ),
	ItemValue=SUM((crs_saledetail.looseqty*(crs_saledetail.saleprice - crs_saledetail.itemflatdisc))*
		(1 - (.01 * crs_saledetail.discperc))) * (1 - (.01 * crs_saleledger.discperc)),
	GrossAmt=
		(SELECT SUM((sd.looseqty*(sd.saleprice - sd.itemflatdisc)) *
			(1 - (.01 * sd.discperc)) * (1- (.01 * sl.discperc)))
		FROM	crs_saledetail sd, crs_saleledger sl
		WHERE sl.saleinvcode=crs_saleledger.saleinvcode and sl.saleinvcode=sd.saleinvcode
		GROUP BY sl.saleinvcode),
	crs_saleledger.flatdisc,
	catcode=crs_saleledger.salecatcode,
	type='S',
	usercode=crs_saleledger.salesmancode
FROM
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	crs_saleledger,	 
	crs_saledetail
WHERE
	CL.ClientID = CI.ClientID AND CI.ClientInstanceID = crs_saleledger.ClientInstanceID AND
	crs_saleledger.ClientInstanceID = crs_saledetail.ClientInstanceID AND
	crs_saleledger.saleinvcode = crs_saledetail.saleinvcode AND 
	crs_saleledger.date BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	CL.Name,
	 crs_saleledger.saleinvcode,
	 crs_saleledger.salesmancode,
	 crs_saledetail.icode,
	 crs_saleledger.salecatcode,
	 crs_saleledger.discperc,
	 crs_saleledger.flatdisc,
	 crs_saleledger.invgstperc1,
	 crs_saleledger.salecatcode
UNION ALL
SELECT
	Client=CL.Name,
	crs_srledger.srinvcode,
	crs_srdetail.icode,
	GrossValue = SUM( crs_srdetail.looseqty * crs_srdetail.srprice ) ,
	ItemDiscValue = SUM((crs_srdetail.looseqty * crs_srdetail.srprice ) * (.01 * crs_srdetail.discperc) ),
	InvItemDiscValue = SUM( ( (crs_srdetail.looseqty * crs_srdetail.srprice) *
								(1 - (.01 * crs_srdetail.discperc) ) ) * (.01 * crs_srledger.discperc) ),
	ItemValue=SUM((crs_srdetail.looseqty * crs_srdetail.srprice *
		(1 - (.01 * crs_srdetail.discperc))) * (1 - (.01 * crs_srledger.discperc))),
	GrossAmt=(SELECT SUM((sd.looseqty * sd.srprice *
			(1 - (.01 * sd.discperc))) * (1- (.01 * sl.discperc)))
		FROM	crs_srdetail sd, crs_srledger sl
		WHERE sl.srinvcode=crs_srledger.srinvcode and sl.srinvcode=sd.srinvcode
		GROUP BY sl.srinvcode),
	crs_srledger.flatdisc,
	catcode=crs_srledger.srcatcode,
	type='R',
	usercode=crs_srledger.salesmancode

FROM
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	crs_srledger,	 
	crs_srdetail
WHERE
	CL.ClientID = CI.ClientID AND CI.ClientInstanceID = crs_srledger.ClientInstanceID AND
	crs_srledger.ClientInstanceID = crs_srdetail.ClientInstanceID AND
	crs_srledger.srinvcode = crs_srdetail.srinvcode AND 
	crs_srledger.date BETWEEN :ar_startdate AND :ar_enddate
GROUP BY
	CL.Name,
	crs_srledger.srinvcode,
	crs_srledger.salesmancode,
	crs_srdetail.icode,
	crs_srledger.srcatcode,
	crs_srledger.discperc,
	crs_srledger.flatdisc,
	crs_srledger.invgstperc1,
	crs_srledger.srcatcode) P, Manufacturer M, Item I
WHERE
	P.Icode = I.Icode AND 
	I.ManfCode = M.ManfCode
GROUP BY 
	M.ManfCode,
	M.Name
ORDER BY 
	M.Name,
	M.ManfCode"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime))
)
