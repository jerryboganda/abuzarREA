table(column=(type=long updatewhereclause=yes name=clientinstanceid dbname="ClientInstanceID"  )
column=(type=char(100) updatewhereclause=no name=client dbname="Client"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="CRS_VirtualGl.documentcode"  )
column=(type=char(27) updatewhereclause=yes name=type dbname="type"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="invoicecode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remark"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="cash"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="CRS_VirtualGl.aliasname"  )
column=(type=char(152) updatewhereclause=yes name=address dbname="address"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="openbalance"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VoucherCode"  )
column=(type=long updatewhereclause=yes name=pendingcheque dbname="PendingCheque"  )
 retrieve="select
	ClientInstanceID=V.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=V.ClientInstanceID AND CI.ClientID=CL.ClientID),
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	invoicecode = v.invoicecode,
	date = V.date, 
	debit = V.Debit,
	credit= V.Credit,
	remark = V.Remarks,
	Supplier=S.name,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	S.aliasname,
	address=S.address1+' '+S.address2+' '+S.city,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	CheckNo = V.CheckNo,
	VRow=V.VRow,
	VoucherCode=V.VoucherCode,
	PendingCheque=0
from
	CRS_VirtualGL V,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1,sp.address2,sp.city
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode) S
where   
	(V.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE V.Clientinstanceid END) AND
	(V.AccCode = S.AccCode OR V.AlternateAccCode = S.AccCode ) and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
union all
select	
	ClientInstanceID=V.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=V.ClientInstanceID AND CI.ClientID=CL.ClientID),
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	invoicecode = v.invoicecode,
	date = V.date, 
	debit = V.Credit,
	credit= V.Debit,
	remark = Case debit 
				When 0 then 'Cash Paid Against Purchase Inv. # '
				Else 'Cash Received Against Purchase Return # '
				End + RTrim(LTrim(convert(char(6), V.documentcode))),
	S.name,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	S.aliasname,
	address=S.address1+' '+S.address2+' '+S.city,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	V.CheckNo,
	V.VRow,
	V.VoucherCode,
	PendingCheque=0
from
	CRS_VirtualGL V,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1,sp.address2,sp.city
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode) S
where   
	(V.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE V.Clientinstanceid END) AND
	(V.AlternateAccCode = S.AccCode ) and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
UNION ALL
SELECT 
	ClientInstanceID=N.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=N.ClientInstanceID AND CI.ClientID=CL.ClientID),
	documentcode = N.NoteCode, 
	Type = Case N.NoteCatCode When 1 Then '*NR' Else '*NP' End + '-' + RTrim(LTrim(convert(char(6), N.NoteCode))),  
	invoicecode = NULL,
	date = N.duedate, 
	debit = Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = S.AccCode THEN 0 ELSE N.Amount END ELSE CASE WHEN N.AccCode = S.AccCode THEN N.Amount ELSE 0 END END,
	credit= Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = S.AccCode THEN N.Amount ELSE 0 END ELSE CASE WHEN N.AccCode = S.AccCode THEN 0 ELSE N.Amount END END,
	remark = N.Remarks,
	S.name,
	cash = 'N',
	S.aliasname,
	address=S.address1+' '+S.address2+' '+S.city,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	CheckNo = LEFT(N.DocumentNumber, 20),
	VRow=999999,
	VoucherCode=N.vouchercode,
	PendingCheque=1
from 
	CRS_Notes N,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1,sp.address2,sp.city
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode) S
where   
	(N.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE N.Clientinstanceid END) AND
	(N.AccCode = S.AccCode OR N.BankAccCode = S.AccCode ) and
	N.Posted = 'N' AND N.Finalized = 'Y'
UNION ALL
select	
	ClientInstanceID=NULL,
	Client=NULL,
	documentcode=NULL, 
	type = NULL, 
	invoicecode = NULL,
	date = :ar_enddate, 
	debit = 0,
	credit= 0,
	remark = 'OPENING BALANCE',
	S.name,
	cash = 'N',
	S.aliasname,
	address=S.address1+' '+S.address2+' '+S.city,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	CheckNo=NULL,
	VRow=0,
	vouchercode=NULL,
	PendingCheque=0
from
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1,sp.address2,sp.city
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode AND 
			a.acccode NOT IN 
			(SELECT DISTINCT VGL.AccCode 
			FROM CRS_VirtualGL VGL 
			WHERE (VGL.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE VGL.Clientinstanceid END) AND 
				VGL.Date BETWEEN :ar_startdate AND :ar_enddate)) S
order by 
	name, aliasname, date, type, VRow"
  arguments=(("ai_clientinstanceid", number), ("ar_suppcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
