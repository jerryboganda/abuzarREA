release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1447 color="536870912" )
summary(height=302 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(4) updatewhereclause=yes name=retqty dbname="RetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=retbonus dbname="RetBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=retvalue dbname="RetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=netqty dbname="NetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=netbonus dbname="NetBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=netvalue dbname="NetValue"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
 retrieve="SELECT 
	ItemCode=S.ItemCode, 
	AliasName=I.CustomICode, 
	Item=I.Name, 
	Qty=SUM(S.Qty),
	Bonus=SUM(S.Bonus),
	SaleValue = ROUND(SUM(S.SaleValue), 2),
	RetQty=SUM(S.RetQty),
	RetBonus=SUM(S.RetBonus),
	RetValue = ROUND(SUM(S.RetValue), 2), 
	NetQty = SUM(S.Qty - S.RetQty),
	NetBonus = SUM(S.Bonus - S.RetBonus),
	NetValue = ROUND(SUM(S.SaleValue), 2) - ROUND(SUM(S.RetValue), 2),
	Packing=I.PackingDesc
FROM
	Item I
	LEFT OUTER JOIN 
	(SELECT
		Client=CL.Name,
		ItemCode=SD.ICode, 
		Qty=SUM(SD.LooseQty),
		Bonus=SUM(SD.BonusQty),
		SaleValue = SUM(SD.LooseQty * (SD.saleprice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ) ,
		RetQty=0,
		RetBonus=0,
		RetValue = 0.00
	FROM
		CRS_ClientInstance CI, 
		CRS_ClientList CL,
		crs_saleledger SL, crs_saledetail SD
	WHERE
		CL.ClientID = CI.ClientID AND 
		CI.ClientInstanceID = SL.ClientInstanceID AND
		SL.ClientInstanceID = SD.ClientInstanceID AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SD.ICode IN (:ar_ICode)
	GROUP BY
		CL.Name,
		SD.ICode
	UNION ALL
	SELECT
		Client=CL.Name,
		ItemCode=SD.ICode, 
		Qty=0,
		Bonus=0,
		SaleValue = 0.00,
		RetQty=SUM(SD.LooseQty),
		RetBonus=SUM(SD.BonusQty),
		RetValue = SUM(SD.LooseQty * SD.srprice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) )
	FROM
		CRS_ClientInstance CI, 
		CRS_ClientList CL,
		crs_srledger SL, crs_srdetail SD
	WHERE
		CL.ClientID = CI.ClientID AND 
		CI.ClientInstanceID = SL.ClientInstanceID AND
		SL.ClientInstanceID = SD.ClientInstanceID AND
		SL.SRInvCode = SD.SRInvCode AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SD.ICode IN (:ar_ICode)
	GROUP BY
		CL.Name,
		SD.ICode) S ON (I.ICode = S.ItemCode)
WHERE
	I.ICode IN (:ar_icode)
GROUP BY
	S.ItemCode,
	I.Name, 
	I.CustomICode,
	I.PackingDesc
ORDER BY
	Item, 
	AliasName"
  arguments=(("ar_icode", numberlist), ("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
