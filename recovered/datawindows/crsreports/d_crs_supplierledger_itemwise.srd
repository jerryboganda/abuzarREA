release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1091 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=166 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes name=clientinstanceid dbname="ClientInstanceID"  )
column=(type=char(100) updatewhereclause=no name=client dbname="Client"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=char(100) updatewhereclause=yes name=suppinvcode dbname="SuppInvCode"  )
column=(type=datetime updatewhereclause=yes name=suppinvdate dbname="SuppInvDate"  )
column=(type=char(100) updatewhereclause=yes name=grn dbname="GRN"  )
column=(type=char(28) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=description dbname="Remark"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Name"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="Cash"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="openbalance"  )
column=(type=char(100) updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=decimal(0) updatewhereclause=yes name=vrow dbname="VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VoucherCode"  )
column=(type=long updatewhereclause=yes name=header dbname="Header"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(6) updatewhereclause=yes name=grossvalue dbname="GrossValue"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(6) updatewhereclause=yes name=itempurtax dbname="ItemPurTax"  )
column=(type=decimal(6) updatewhereclause=yes name=itemvalue dbname="ItemValue"  )
column=(type=decimal(6) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(6) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=decimal(6) updatewhereclause=yes name=others dbname="Others"  )
column=(type=long updatewhereclause=yes name=pendingcheque dbname="PendingCheque"  )
 retrieve="SELECT  
	ClientInstanceID=P.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=P.ClientInstanceID AND CI.ClientID=CL.ClientID),
	DocumentCode=P.PurInvCode,
	SuppInvCode=P.SuppInvCode,
	SuppInvDate=P.SuppInvDate, 
	GRN=P.GRN, 
	Type='PV-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Date = P.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Name=S.Name,
	Cash = CASE P.PurCatCode WHEN 1 THEN 'Y' WHEN 7 THEN 'Y' ELSE 'N' END,
	AliasName=S.AliasName, 
	Address=S.Address1,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	CheckNo=NULL,
	VRow=MAX(D.PurRowID),
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=SUM(D.LooseQty+PackQty),
	Bonus=SUM(D.BonusQty),
	Rate=MAX(D.PurPrice),
	GrossValue=SUM((D.LooseQty + D.PackQty) * D.PurPrice),
	Discount=
		SUM((D.looseqty+D.PackQty) * D.Purprice * (.01 * D.discperc)) + 
		SUM((D.looseqty+D.PackQty) * D.Purprice * (1-(.01*D.discperc)) * (.01 * P.discperc)),
	ItemPurTax=SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Purprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01),
	ItemValue=SUM((D.PackQty + D.LooseQty) * D.PurPrice) - 
		SUM((D.looseqty + D.PackQty) * D.Purprice * (.01 * D.discperc) +
				((D.looseqty + D.PackQty) * D.Purprice * (1-(.01*D.discperc)) * (.01 * P.discperc))) +  
		SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM( (D.PackQty + D.looseqty) * D.Purprice * (1 - (.01 * D.discperc)) * D.gstperc * .01),
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.PurRowID) WHEN (SELECT MAX(PD.PurROWID) 
		FROM CRS_PurDetail PD 
		WHERE PD.ClientInstanceID=P.ClientInstanceID AND PD.PurInvCode=P.PurInvCode) THEN CASE P.PurCatCode WHEN 1 THEN T.NetAmt WHEN 7 THEN T.NetAmt ELSE 0 END ELSE 0 END,
	Credit= CASE MAX(D.PurRowID) WHEN (SELECT MAX(PD.PurROWID) 
		FROM CRS_PurDetail PD 
		WHERE PD.ClientInstanceID=P.ClientInstanceID AND PD.PurInvCode=P.PurInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.PurRowID) WHEN (SELECT MAX(PD.PurROWID) 
		FROM CRS_PurDetail PD 
		WHERE PD.ClientInstanceID=P.ClientInstanceID AND PD.PurInvCode=P.PurInvCode) THEN ISNULL(P.MiscCharges, 0) - ISNULL(P.FlatDisc, 0) + ISNULL(T.InvPurTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	CRS_PurLedger p,	 
	CRS_PurDetail D,
	(SELECT 
		P.ClientInstanceID,
		P.PurInvCode, 
		RoundingDiff=
		ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.purprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.purprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0) -
		(SUM((D.looseqty + D.packqty + D.bonusqty) * D.unitsalestax) +
		SUM((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc)) * D.gstperc * .01) +
			ROUND( (SUM(((D.looseqty + D.packqty) * D.Purprice) *
				(1 - (.01 * D.discperc))) * (1- (.01 * P.Discperc)) -
				P.flatdisc) * (P.invgstperc1 * .01), 2) + 
		SUM( ((D.looseqty + D.packqty) * D.Purprice) * 
				 (1 - (.01 * D.discperc))) * (1- (.01 * P.discperc)) + 
			P.misccharges + P.salestax - P.flatdisc),
		InvPurTax=ROUND(SUM((D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Purprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01), 2),
		NetAmt=ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.purprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.purprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0)
	FROM CRS_PurLedger P, CRS_PurDetail D
	WHERE 
		P.ClientInstanceID=D.ClientInstanceID AND 
		P.Posted = 'Y' AND P.AccountFor = 'Y' AND
		P.PurInvCode = D.PurInvCode AND
		P.SuppCode IN (:ai_Suppcode) AND
		P.date     >= :ar_startdate AND
		P.date     <= :ar_enddate
	GROUP BY
		P.ClientInstanceID,
		P.PurInvCode,
		P.DiscPerc,
		P.FlatDisc,
		P.InvGSTPerc1,
		P.DiscPerc,
		P.MiscCharges,
		P.SalesTax) T
WHERE   
	(P.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE P.Clientinstanceid END) AND
	P.ClientInstanceID=D.ClientInstanceID AND 
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.PurInvCode = D.PurInvCode AND 
	P.ClientInstanceID=T.ClientInstanceID AND 
	P.PurInvCode = T.PurInvCode AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	P.date     >= :ar_startdate AND
	P.date     <= :ar_enddate
GROUP BY 
	P.ClientInstanceID,
	P.PurInvCode,
	P.PurCatCode,
	P.HeaderInvNo,
	P.HeaderNo,
	D.ICode,
	P.SuppCode, 
	P.Date,
	P.DiscPerc,
	P.MiscCharges,
	P.SalesTax,
	P.FlatDisc,
	P.InvGstPerc1,
	P.SuppInvCode,
	P.SuppInvDate,
	P.GRN,
	S.AccCode,
	S.AliasName,
	S.Name,
	S.Address1,
	T.InvPurTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	ClientInstanceID=P.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=P.ClientInstanceID AND CI.ClientID=CL.ClientID),
	DocumentCode=P.PurInvCode,
	SuppInvCode=P.SuppInvCode,
	SuppInvDate=P.SuppInvDate,
	GRN=P.GRN,
	Type='PV-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Date = P.AmtDate, 
	Remark = 'Cash Paid During Pur #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Name=S.Name,
	Cash = CASE P.PurCatCode WHEN 1 THEN 'Y' WHEN 7 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	Address=S.Address1,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = P.Amt,
	Credit= 0,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	CRS_PurLedger P
WHERE   
	(P.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE P.Clientinstanceid END) AND
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	P.Amtdate     >= :ar_startdate AND
	P.Amtdate     <= :ar_enddate AND
	P.Amt <> 0 AND P.PurCatcode NOT IN (1,7)
UNION ALL
SELECT  
	ClientInstanceID=P.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=P.ClientInstanceID AND CI.ClientID=CL.ClientID),
	DocumentCode=P.PurInvCode,
	SuppInvCode=P.SuppInvCode,
	SuppInvDate=P.SuppInvDate,
	GRN=P.GRN,
	Type='PV-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Date = P.AmtDate, 
	Remark = ISNULL(M.Remarks, 'Amount Paid on Pur #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode)))),
	Name=S.Name,
	Cash = CASE P.PurCatCode WHEN 1 THEN 'Y' WHEN 7 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	Address=S.Address1,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = M.Amount,
	Credit= 0,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	CRS_PurLedger P, CRS_MasterCashWin M
WHERE   
	(P.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE P.Clientinstanceid END) AND
	P.ClientInstanceID=M.ClientInstanceID AND 
	M.DocumentType = 'PV' AND
	M.DocumentCode = P.PurInvCode AND
	M.Amount > 0 AND
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	M.Date BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT  
	ClientInstanceID=P.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=P.ClientInstanceID AND CI.ClientID=CL.ClientID),
	DocumentCode=P.PrInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='PR-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Date = P.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Name=S.Name,
	Cash = CASE P.PrCatCode WHEN 4 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	Address=S.Address1,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	CheckNo=NULL,
	VRow=MAX(D.PRUTN),
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=-SUM(D.LooseQty+PackQty),
	Bonus=-SUM(D.BonusQty),
	Rate=MAX(D.PrPrice),
	GrossValue=-SUM((D.LooseQty + D.PackQty) * D.PRPrice),
	Discount= -1 *
		(SUM((D.looseqty+D.PackQty) * D.Prprice * (.01 * D.discperc)) + 
		SUM((D.looseqty+D.PackQty) * D.Prprice * (1-(.01*D.discperc)) * (.01 * P.discperc))),
	ItemPurTax= -1 * (SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Prprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01)),
	ItemValue= -1 * (SUM((D.PackQty + D.LooseQty) * D.PrPrice) - 
		SUM((D.looseqty + D.PackQty) * D.Prprice * (.01 * D.discperc) +
				((D.looseqty + D.PackQty) * D.Prprice * (1-(.01*D.discperc)) * (.01 * P.discperc))) +  
		SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM( (D.PackQty + D.looseqty) * D.Prprice * (1 - (.01 * D.discperc)) * D.gstperc * .01)),
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.PRUTN) WHEN (SELECT MAX(PD.PRUTN) 
		FROM CRS_PrDetail PD 
		WHERE PD.ClientInstanceID=P.ClientInstanceID AND PD.PrInvCode=P.PrInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.PRUTN) WHEN (SELECT MAX(PD.PRUTN) 
		FROM CRS_PrDetail PD 
		WHERE PD.ClientInstanceID=P.ClientInstanceID AND PD.PrInvCode=P.PrInvCode) THEN CASE P.PrCatCode WHEN 4 THEN T.NetAmt ELSE 0 END ELSE 0 END,
	Others= CASE MAX(D.PRUTN) WHEN (SELECT MAX(PD.PRUTN) 
		FROM CRS_PrDetail PD 
		WHERE PD.ClientInstanceID=P.ClientInstanceID AND PD.PrInvCode=P.PrInvCode) THEN ISNULL(P.MiscCharges, 0) - ISNULL(P.FlatDisc, 0) + ISNULL(T.InvPurTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	CRS_PrLedger P,	 
	CRS_PrDetail D,
	(SELECT 
		P.ClientInstanceID,
		P.PrInvCode, 
		RoundingDiff=
		ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.prprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.prprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0) -
		(SUM((D.looseqty + D.packqty + D.bonusqty) * D.unitsalestax) +
		SUM((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc)) * D.gstperc * .01) +
			ROUND( (SUM(((D.looseqty + D.packqty) * D.Prprice) *
				(1 - (.01 * D.discperc))) * (1- (.01 * P.Discperc)) -
				P.flatdisc) * (P.invgstperc1 * .01), 2) + 
		SUM( ((D.looseqty + D.packqty) * D.Prprice) * 
				 (1 - (.01 * D.discperc))) * (1- (.01 * P.discperc)) + 
			P.misccharges + P.salestax - P.flatdisc),
		InvPurTax=ROUND(SUM((D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Prprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01), 2),
		NetAmt=ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.prprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.prprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0)
	FROM CRS_PrLedger P, CRS_PrDetail D
	WHERE 
		P.ClientInstanceID=D.ClientInstanceID AND 
		P.Posted = 'Y' AND P.AccountFor = 'Y' AND
		P.PrInvCode = D.PrInvCode AND
		P.SuppCode IN (:ai_Suppcode) AND
		P.date     >= :ar_startdate AND
		P.date     <= :ar_enddate
	GROUP BY
		P.ClientInstanceID,
		P.PrInvCode,
		P.DiscPerc,
		P.FlatDisc,
		P.InvGSTPerc1,
		P.DiscPerc,
		P.MiscCharges,
		P.SalesTax) T
WHERE   
	(P.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE P.Clientinstanceid END) AND
	P.ClientInstanceID=D.ClientInstanceID AND 
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.PrInvCode = D.PrInvCode AND 
	P.ClientInstanceID=T.ClientInstanceID AND P.PrInvCode = T.PrInvCode AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	P.date     >= :ar_startdate AND
	P.date     <= :ar_enddate
GROUP BY 
	P.ClientInstanceID, 
	P.PrInvCode,
	P.PrCatCode,
	P.HeaderInvNo,
	P.HeaderNo,
	D.ICode,
	P.SuppCode, 
	P.Date,
	P.DiscPerc,
	P.MiscCharges,
	P.SalesTax,
	P.FlatDisc,
	P.InvGstPerc1,
	S.AccCode,
	S.AliasName,
	S.Name,
	S.Address1,
	T.InvPurTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	ClientInstanceID=P.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=P.ClientInstanceID AND CI.ClientID=CL.ClientID),
	DocumentCode=P.PrInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='PR-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Date = P.AmtDate, 
	Remark = 'Cash Recvd. During P/Ret #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Name=S.Name,
	Cash = CASE P.PrCatCode WHEN 4 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	Address=S.Address1,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = 0,
	Credit= P.Amt,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	CRS_PrLedger P
WHERE   
	(P.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE P.Clientinstanceid END) AND
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	P.Amtdate     >= :ar_startdate AND
	P.Amtdate     <= :ar_enddate AND
	P.Amt <> 0 AND P.PrCatcode NOT IN (4)
UNION ALL
SELECT  
	ClientInstanceID=P.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=P.ClientInstanceID AND CI.ClientID=CL.ClientID),
	DocumentCode=P.PrInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='PR-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Date = P.AmtDate, 
	Remark = ISNULL(M.Remarks, 'Amt Received on P/R #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode)))),
	Name=S.Name,
	Cash = 'N',
	S.AliasName,
	Address=S.Address1,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = 0,
	Credit= M.Amount,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	CRS_PrLedger P, CRS_MasterCashWin M
WHERE   
	(P.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE P.Clientinstanceid END) AND
	P.ClientInstanceID=M.ClientInstanceID AND 
	M.DocumentType = 'PR' AND
	M.DocumentCode = P.PrInvCode AND
	M.Amount > 0 AND
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	M.Date BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT
	ClientInstanceID=V.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=V.ClientInstanceID AND CI.ClientID=CL.ClientID),
	V.documentcode, 
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type = V.documenttype + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), V.documentcode))), 
	Date = V.Date, 
	Remark = V.Remarks,
	Name=S.Name,
	Cash = CASE ISNULL(V.AlternateAccCode, -1) WHEN -1 THEN 'N' ELSE 'Y' END,
	S.AliasName,
	Address=S.Address1,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	V.CheckNo,
	V.VRow,
	V.VoucherCode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvPurTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit=V.Debit,
	Credit=V.Credit,
	Others= 0,
	PendingCheque=0
FROM
	CRS_VirtualGL V,
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S
WHERE   
	(V.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE V.Clientinstanceid END) AND
	V.DocumentType NOT IN ('PV', 'PR','SP', 'RP') AND
	(V.AccCode = S.AccCode OR V.AlternateAccCode = S.AccCode ) and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
UNION ALL
SELECT
	ClientInstanceID=V.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=V.ClientInstanceID AND CI.ClientID=CL.ClientID),
	V.DocumentCode, 
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type = V.DocumentType + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), V.DocumentCode))), 
	Date = V.Date, 
	Remark = CASE debit 
			WHEN 0 THEN 'Cash Received Against Pur Ret. # '
			ELSE 'Cash Paid Against Pur. Inv. # '
			END + RTRIM(LTRIM(CONVERT(CHAR(7), V.DocumentCode))),
	S.Name,
	Cash = CASE ISNULL(v.AlternateAccCode, -1) WHEN -1 THEN 'N' ELSE 'Y' END,
	S.AliasName,
	Address=S.Address1,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvPurTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit = V.Credit,
	Credit= V.Debit,
	Others=0,
	PendingCheque=0
FROM 
	CRS_VirtualGL V,
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S
WHERE   
	(V.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE V.Clientinstanceid END) AND
	(V.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE V.Clientinstanceid END) AND
	V.DocumentType NOT IN ('PV', 'PR','SP','RP') AND
	(V.AlternateAccCode = S.AccCode ) AND
	V.date     >= :ar_startdate AND
	V.date     <= :ar_enddate
UNION ALL
SELECT
	ClientInstanceID=N.ClientInstanceID,
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=N.ClientInstanceID AND CI.ClientID=CL.ClientID),
	documentcode = N.NoteCode, 
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type = Case N.NoteCatCode When 1 Then '*NR' Else '*NP' End + '-' + RTrim(LTrim(convert(char(6), N.NoteCode))),  
	date = N.duedate, 
	remark = N.Remarks,
	S.name,
	cash = 'N',
	S.AliasName,
	Address=S.Address1,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	CheckNo = LEFT(N.DocumentNumber, 20),
	VRow=999999,
	VoucherCode=N.vouchercode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvPurTax=0
	RoundingDiff=0*/
	NetAmt=0,
	debit = Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = S.AccCode THEN 0 ELSE N.Amount END ELSE CASE WHEN N.AccCode = S.AccCode THEN N.Amount ELSE 0 END END,
	credit= Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = S.AccCode THEN N.Amount ELSE 0 END ELSE CASE WHEN N.AccCode = S.AccCode THEN 0 ELSE N.Amount END END,
	Others= 0,
	PendingCheque=1
FROM
	CRS_Notes N,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1,sp.address2,sp.city
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ai_Suppcode) and 
			a.acccode = sp.suppcode) S
WHERE   
	(N.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE N.Clientinstanceid END) AND
	(N.AccCode = S.AccCode OR N.BankAccCode = S.AccCode ) and
	N.Posted = 'N' AND N.Finalized = 'Y'
UNION ALL
SELECT
	ClientInstanceID=NULL,
	Client=NULL,
	DocumentCode=NULL,
	SuppInvCode=NULL, 
	SuppInvDate=NULL, 
	GRN=NULL,
	Type = NULL,
	Date = :ar_enddate, 
	remark = 'OPENING BALANCE',
	S.Name,
	Cash = 'N',
	S.AliasName,
	Address=S.Address1,
	openbalance=
			ISNULL((SELECT isnull(sum(virtualgl.debit - virtualgl.credit), 0) FROM CRS_virtualgl Virtualgl
			WHERE	
				(Virtualgl.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE Virtualgl.Clientinstanceid END) AND
				(virtualgl.acccode=S.acccode) and 
				virtualgl.date < :ar_startdate), 0),
	CheckNo=NULL,
	VRow=NULL,
	VoucherCode=NULL,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvPurTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit = 0,
	Credit= 0,
	Others=0,
	PendingCheque=0
from
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ai_Suppcode) and 
			a.acccode = sp.suppcode AND 
			a.acccode NOT IN 
			(SELECT DISTINCT VGL.AccCode 
			FROM CRS_VirtualGL VGL 
			WHERE (VGL.Clientinstanceid = CASE WHEN :ai_clientinstanceid > 0 THEN :ai_clientinstanceid ELSE VGL.Clientinstanceid END) AND 
				VGL.Date BETWEEN :ar_startdate AND :ar_enddate)) S
ORDER BY
	Name, 
	AliasName, 
	Date, 
	Type, 
	VRow"
  arguments=(("ai_clientinstanceid", number), ("ai_Suppcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
