table(column=(type=long updatewhereclause=yes name=id dbname="ID"  )
column=(type=char(300) updatewhereclause=yes name=databasename dbname="DatabaseName"  )
column=(type=char(200) updatewhereclause=yes name=computername dbname="ComputerName"  )
column=(type=long updatewhereclause=yes name=connection dbname="Connection"  )
column=(type=long updatewhereclause=yes name=username dbname="UserName" 
 values=""  )
column=(type=long updatewhereclause=yes name=mysession dbname="MySession"  )
column=(type=char(127) updatewhereclause=yes name=program dbname="Program"  )
column=(type=datetime updatewhereclause=yes name=startedon dbname="StartedOn"  )
column=(type=char(127) updatewhereclause=yes name=domainname dbname="DomainName"  )
column=(type=char(127) updatewhereclause=yes name=osusername dbname="OSUserName"  )
 retrieve="SELECT 
	ID=S.ID, 
	DatabaseName=S.sys, 
	ComputerName=S.CN, 
	Connection=S.CC, 
	UserName = S.cc,
	MySession=:ai_mysessionid, 
	Program=(SELECT MIN(P.Program_Name) FROM master.dbo.sysprocesses P, master.dbo.sysdatabases D WHERE D.Name = :as_db AND P.DBID=D.DBID AND Lower(P.Program_Name) = 'waseela (' + LTRIM(RTRIM(STR(S.ID))) +')'), 
	StartedOn=(SELECT MIN(P.Login_Time) FROM master.dbo.sysprocesses P, master.dbo.sysdatabases D WHERE D.Name = :as_db AND P.DBID=D.DBID AND Lower(P.Program_Name) = 'waseela (' + LTRIM(RTRIM(STR(S.ID))) +')'), 
	DomainName=(SELECT MIN(P.NT_Domain) FROM master.dbo.sysprocesses P, master.dbo.sysdatabases D WHERE D.Name = :as_db AND P.DBID=D.DBID AND Lower(P.Program_Name) = 'waseela (' + LTRIM(RTRIM(STR(S.ID))) +')'), 
	OSUserName=(SELECT MIN(P.NT_UserName) FROM master.dbo.sysprocesses P, master.dbo.sysdatabases D WHERE D.Name = :as_db AND P.DBID=D.DBID AND Lower(P.Program_Name) = 'waseela (' + LTRIM(RTRIM(STR(S.ID))) +')')
FROM TempDB.DBO.SysIsolaation S
WHERE sys = :as_db
ORDER BY ID
"
  arguments=(("as_db", string), ("ai_mysessionid", number))
)
