release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=processid dbname="ProcessID"  )
column=(type=long updatewhereclause=yes name=ecid dbname="ECID"  )
column=(type=long updatewhereclause=yes name=databaseid dbname="DatabaseID"  )
column=(type=char(128) updatewhereclause=yes name=dbname dbname="DBName"  )
column=(type=datetime updatewhereclause=yes name=startedon dbname="StartedOn"  )
column=(type=char(30) updatewhereclause=yes name=status dbname="Status"  )
column=(type=char(128) updatewhereclause=yes name=machinename dbname="MachineName"  )
column=(type=char(128) updatewhereclause=yes name=programname dbname="ProgramName"  )
column=(type=char(8) updatewhereclause=yes name=hostprocess dbname="HostProcess"  )
column=(type=char(16) updatewhereclause=yes name=taskinprogress dbname="TaskInProgress"  )
column=(type=char(128) updatewhereclause=yes name=domainname dbname="DomainName"  )
column=(type=char(128) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=long updatewhereclause=yes name=myprocess dbname="MyProcess"  )
 retrieve="SELECT 
	ProcessID=P.SPID, 
	ECID=P.ECID, 
	DatabaseID=P.DBID, 
	DBName=D.Name,
	StartedOn=P.Login_Time,
	Status = P.Status,
	MachineName=P.HostName,
	ProgramName=P.Program_Name,
	HostProcess=P.HostProcess,
	TaskInProgress=P.CMD,
	DomainName=P.NT_Domain,
	UserName=NT_UserName,
	MyProcess=:ai_thisprocess
FROM master.dbo.sysprocesses P, master.dbo.sysdatabases D
WHERE P.DBID=D.DBID AND Lower(P.Program_Name) = 'waseela (' + LTRIM(RTRIM(STR(:ai_thisprocess))) +')'
ORDER BY
	ProcessID, 
	ECID, 
	TaskInProgress"
  arguments=(("ai_thisprocess", number))
)
