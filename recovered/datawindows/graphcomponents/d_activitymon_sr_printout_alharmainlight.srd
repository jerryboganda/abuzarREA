table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) updatewhereclause=yes name=saleitemdesc dbname="saleitemdesc"  )
column=(type=long updatewhereclause=yes name=salecatcode dbname="salecatcode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=char(30) updatewhereclause=yes name=licenceno dbname="licenceno"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="invoicecode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="invsalestax"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=balance dbname="balance"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(50) updatewhereclause=yes name=custtaxregno dbname="custTaxRegno"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="SRLedger.custrefno"  )
column=(type=char(100) updatewhereclause=yes name=custref2 dbname="custref2"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SRLedger.remarks"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CUSTALIAS"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
column=(type=char(100) updatewhereclause=yes name=patientaddress dbname="patientaddress"  )
column=(type=decimal(2) updatewhereclause=yes name=cashpaid dbname="cashpaid"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="godown"  )
column=(type=decimal(4) updatewhereclause=yes name=packcapacity dbname="PackCapacity"  )
column=(type=decimal(8) updatewhereclause=yes name=areavolume dbname="AreaVolume"  )
column=(type=decimal(6) updatewhereclause=yes name=pcs dbname="PCS"  )
column=(type=char(17) updatewhereclause=yes name=cartons dbname="Cartons"  )
 retrieve="SELECT 
	itemname= item.name, 
	saleitemdesc= max(srdetail.returnitemdescription),
	salecatcode=srledger.srcatcode,   
	aliasname=item.customicode,   
	packingdesc=item.packingdesc, 
	accname =dbo.accounts.name,   
	address = dbo.customer.address1,
	address2= dbo.customer.address2,   
	city= dbo.customer.city,
	licenceno= dbo.customer.licenceno,   
	username= dbo.users.username,   
	saleinvcode = dbo.srledger.srinvcode,   
	invoicecode=srledger.saleinvcode,
	headerno = dbo.srledger.headerno, 
	headerinvno=srledger.headerinvno,  
	date = dbo.srledger.date,   
	invdiscperc = dbo.srledger.discperc,   
	misccharges = dbo.srledger.misccharges,   
	flatdisc = dbo.srledger.flatdisc,   
	invsalestax = dbo.srledger.salestax,   
	gcode = srdetail.gcode,   
	icode = srdetail.icode,   
	looseqty = sum(srdetail.looseqty),   
	bonusqty = sum(srdetail.bonusqty),   
	packqty = 0.0000,   
	packunits= srdetail.packunits,   
	saleprice= srdetail.srprice,   
	discperc = srdetail.discperc,   
	salestax = max(srdetail.salestax),  
	itemflatdisc=0.00,   
	Id = MAX(dbo.srdetail.IDENTITYCOL),   
	posted=srledger.posted,   
	balance=0,   
	unitsalestax = max(srdetail.unitsalestax),
	gstperc = max(srdetail.gstperc),   
	invgstperc = srledger.invgstperc1,   
	custTaxRegno=customer.salestaxregno  ,
	dbo.srledger.custrefno,	
	custref2=srledger.custrefno2,
	dbo.srledger.remarks,
	salesman=ltrim(rtrim(dbo.salesman.name)),
	manufacturer=(select name from manufacturer where manfcode=item.manfcode),
	CUSTALIAS=ACCOUNTS.ALIASNAME,
	patientname=(select name from patient where patientcode=srledger.patientcode),
	patientaddress=(select address1 from patient where patientcode=srledger.patientcode),
	cashpaid=ISNULL(srledger.amt, 0) + ISNULL(srledger.CashCharged, 0)  + ISNULL((SELECT ISNULL(SUM(Amount),0) FROM MasterCashWin MCW WHERE MCW.DocumentType = 'SR' AND MCW.DocumentCode = srledger.SRInvCode), 0),
	godown=(select name from godown where godown.gcode=srdetail.gcode),
	PackCapacity = item.PackCapacity,
	AreaVolume = item.AreaVolume,
	PCS=ROUND(SUM(srdetail.looseqty) / CASE WHEN item.AreaVolume IS NULL OR item.AreaVolume <= 0 THEN 1 ELSE item.AreaVolume END, 6),
	Cartons= LTRIM(RTRIM(STR(CAST(((ROUND(SUM(srdetail.looseqty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6)) / CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END) AS INT), 7, 0))) + ' : ' +
		LTRIM(RTRIM(STR(((CAST(ROUND(SUM(srdetail.looseqty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6) AS INT)) % CAST(CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END AS INT)), 7, 0)))
FROM 
	srledger
	LEFT OUTER JOIN Salesman ON ( dbo.srledger.smancode = dbo.salesman.salesmancode),
	srdetail,   
	accounts,   
	customer,   
	users,   
	item 
WHERE 
	( dbo.srledger.srinvcode IN 
		(SELECT DocumentCode=MAX(AM.DocumentCode)
		FROM ActivityMonitor AM
		WHERE AM.DocumentType IN ('SR') AND 
			AM.DocRowID IN (:ar_docrowid) ) ) AND
	( dbo.srledger.srinvcode=srdetail.srinvcode) AND
	( dbo.srledger.custcode = dbo.accounts.acccode ) AND  
	( dbo.customer.custcode = dbo.accounts.acccode ) AND  
	( dbo.srledger.salesmancode = dbo.users.usercode ) AND  
	( dbo.srdetail.icode = dbo.item.icode)
GROUP BY
	srdetail.srinvcode,
	item.name,
	srledger.saleinvcode,
	srledger.srcatcode,   
	item.customicode,   
	item.packingdesc, 
	dbo.accounts.name,   
	dbo.customer.address1,
	dbo.customer.address2,   
	dbo.customer.city,   
	dbo.customer.licenceno,   
	dbo.users.username,   
	dbo.srledger.srinvcode,   
	dbo.srledger.headerno, 
	srledger.headerinvno,  
	dbo.srledger.date,   
	dbo.srledger.discperc,   
	dbo.srledger.misccharges,   
	dbo.srledger.flatdisc,   
	dbo.srledger.salestax,   
	srdetail.gcode,   
	srdetail.icode,   
	srdetail.packunits,   
	srdetail.srprice,   
	srdetail.discperc,   
	srledger.posted,   
	srledger.invgstperc1,   
	customer.salestaxregno  ,
	dbo.srledger.custrefno,	
	srledger.custrefno2,
	dbo.srledger.remarks,
	dbo.salesman.name,
	item.manfcode,
	item.PackCapacity,
	item.AreaVolume,
	ACCOUNTS.ALIASNAME,
	srledger.patientcode,
	srledger.amt,
	srledger.cashcharged
ORDER BY 
	dbo.srdetail.srinvcode,
	godown,
	ID
"
  arguments=(("ar_docrowid", numberlist))
)
