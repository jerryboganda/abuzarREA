release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=88 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long identity=yes updatewhereclause=yes name=docrowid dbname="ActivityMonitor.DocRowId"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=documentcode dbname="ActivityMonitor.DocumentCode"  )
column=(type=char(2) key=yes update=yes updatewhereclause=yes name=documenttype dbname="ActivityMonitor.DocumentType"  )
column=(type=long update=yes updatewhereclause=yes name=doccatcode dbname="ActivityMonitor.DocCatCode"  )
column=(type=char(100) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(1) update=yes updatewhereclause=yes name=partytype dbname="ActivityMonitor.PartyType" 
 values="Customer	C/Supplier	S/Department	D/Sales Person	P/Others	O/Account	A/Godown	G/"  )
column=(type=long update=yes updatewhereclause=yes name=partycode dbname="ActivityMonitor.PartyCode"  )
column=(type=char(60) updatewhereclause=yes name=partyname dbname="PartyName"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="ActivityMonitor.UserCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=amount dbname="ActivityMonitor.Amount"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ActivityMonitor.Remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes name=printed dbname="ActivityMonitor.Printed" 
 values="Yes	Y/No	N/"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="ActivityMonitor.Date"  )
column=(type=char(20) updatewhereclause=yes name=machinename dbname="ActivityMonitor.MachineName"  )
 retrieve="SELECT
	DocRowId,
	DocumentCode,   
	DocumentType,   
	DocCatCode,
	Category = Category,
	PartyType,   
	PartyCode,
	PartyName = 
		CASE 
			WHEN PartyType='G' THEN (SELECT Godown.Name FROM Godown WHERE Godown.GCode = ActivityMonitor.PartyCode) 
			WHEN PartyType='P' THEN (SELECT SalesMan.Name FROM SalesMan WHERE SalesMan.SalesManCode = ActivityMonitor.PartyCode) 
			WHEN PartyType IN ('C','S','A') THEN (SELECT A.Name FROM Accounts A WHERE A.AccCode = PartyCode)
		ELSE '' END,
	UserCode,   
	Amount, 
	Remarks,   
	Printed,   
	Date,
	MachineName
FROM ActivityMonitor  
WHERE DocumentType IN (:as_doctype) AND 
	Date >= CASE :ai_min WHEN -1 THEN :ad_startdate ELSE DATEADD(mi, -1 * :ai_min, GETDATE()) END AND Date <= GETDATE() AND
	(SELECT DISTINCT D.GCode 
	FROM SaleDetail D 
	WHERE SaleInvCode = ActivityMonitor.DocumentCode AND 
		ActivityMonitor.DocumentType IN ('SC','ST')
	UNION
	SELECT DISTINCT G.GCode 
	FROM Godown G
	WHERE ActivityMonitor.DocumentType NOT IN ('SC','ST'))
	IN
	(SELECT DISTINCT GCode 
	FROM GroupAllowedGodown 
	WHERE Module = 1 AND
		GroupCode = :ai_groupcode
	UNION
	SELECT DISTINCT G.GCode 
	FROM Godown G
	WHERE ActivityMonitor.DocumentType NOT IN ('SC','ST'))
ORDER BY Date DESC

"
  update="ActivityMonitor" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_min", number), ("ad_startdate", datetime), ("ai_groupcode", number), ("as_doctype", stringlist))
)
