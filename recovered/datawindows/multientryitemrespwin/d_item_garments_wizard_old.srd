 retrieve="SELECT
	Item.ICode,   
	Item.CustomICode,   
	Item.Name,   
	Item.ICCode,   
	Item.ICatCode,   
	Item.Packcode,   
	Item.ManfCode,   
	Item.SalePrice,   
	Item.PurPrice,   
	Item.RetailPrice,   
	Item.AvgPrice,   
	Item.SaleDiscPerc,   
	Item.PurDiscPerc,   
	Item.SalesTax,   
	Item.ReorderQty,   
	Item.OptimumQty,   
	Item.PackUnits,   
	Item.Active,   
	Item.Prescribed,   
	Item.Refrigrated,   
	Item.Printable,   
	Item.Location1,   
	Item.Remarks1,   
	Item.Location,   
	Item.Remarks,   
	Item.Gcode,   
	Item.saleprice2,
	Item.saleprice3,
	Item.RecentPurPrice,
	Item.GReorderQty,
	Item.GOptimumQty ,
	Item.AntiNorCotix,
	Item.Restricted,
	item.PackSalesTax,
	item.GSTPerc1,
	item.GSTPerc2,
	item.packingdesc,
	item.saleqty,
	item.bonusqty,
	Item.PrintExpiry,
	Item.UserCode,
	Item.LastUpdate,
	Item.locksaleprice,
	Item.lockdiscperc,
	Item.flatdisc,
	stock=(select isnull(sum(currqty),0) from godowndetail where godowndetail.icode=item.icode),
	item.salediscperc2,
	item.salediscperc3,
	item.salediscperc4,
	item.isizecode,
	item.istylecode,
	item.icolourcode,
	item.isleevecode,
	item.iyarncode,
	item.ifabriccode,
	item.ibrandcode,
	item.saleprice4,
	item.saleprice5,
	item.salediscperc5,
	item.minqty,
	item.IPartCode,
	item.OldPartCode,
	item.ItemYear,
	item.RemarksForPurchase,
	item.SizeDescription,
	item.ModelDescription,
	item.TypeDescription,
	item.GenericCode,
	item.TransitStock,
	item.PackingFactor,
	item.itemtypecode,
	item.itemalertcode,
	item.DiscountedSalePrice,
	item.DiscountedPurPrice,
	item.SalePriceChangeMargin,
	item.GeneratePO,
	item.QtyUsed,
	item.MeasureUnitCode,
	item.MaxSaleDiscPerc,
	item.BonusPolicyCode,
	item.DiscountPolicyCode,
	Item.ItemDesignCode
FROM
	Item  
WHERE 
	Item.ICode = :ar_icode

"
  update="Item" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_icode", number))
)
