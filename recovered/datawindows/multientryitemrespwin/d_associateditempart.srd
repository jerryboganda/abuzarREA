table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="AssociatedItemPart.IPartCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=associatedipartcode dbname="AssociatedItemPart.AssociatedIPartCode" 
 values=""  )
 retrieve="SELECT
	AssociatedItemPart.IPartCode,
	AssociatedItemPart.AssociatedIPartCode
FROM
	AssociatedItemPart
WHERE
	AssociatedItemPart.IPartCode = :Code
"
  update="AssociatedItemPart" updatewhere=1 updatekeyinplace=yes
  arguments=(("code", number))
)
