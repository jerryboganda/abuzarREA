release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="AlternateItemAliasRequest.ItemRegReqCode"  )
column=(type=char(75) key=yes update=yes updatewhereclause=yes name=customicode dbname="CustomICode"  )
column=(type=char(50) update=yes updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) > 0" validationmsg="~"Please enter valid units~"" initial="1" name=qty dbname="Qty"  )
column=(type=decimal(18) updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Unit Purchase Price~"" initial="0" name=unitpurprice dbname="UnitPurPrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Purchase Price~"" initial="0" name=purprice dbname="PurPrice"  )
column=(type=decimal(18) updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Unit Sale Price~"" initial="0" name=unitsaleprice dbname="UnitSalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Sale Price~"" initial="0" name=saleprice dbname="SalePrice"  )
 retrieve="SELECT 
	ItemRegReqCode,   
	CustomICode=AlternateItemAliasRequest.CustomICode,
	PackingDesc=AlternateItemAliasRequest.PackingDesc,
	Qty = AlternateItemAliasRequest.Qty,
	UnitPurPrice=AlternateItemAliasRequest.PurPrice / CASE WHEN AlternateItemAliasRequest.Qty > 0 THEN AlternateItemAliasRequest.Qty ELSE 1 END,
	PurPrice=AlternateItemAliasRequest.PurPrice,
	UnitSalePrice=AlternateItemAliasRequest.SalePrice / CASE WHEN AlternateItemAliasRequest.Qty > 0 THEN AlternateItemAliasRequest.Qty ELSE 1 END,
	SalePrice=AlternateItemAliasRequest.SalePrice
FROM 
	AlternateItemAliasRequest
WHERE 
	AlternateItemAliasRequest.ItemRegReqCode = :ai_code"
  update="AlternateItemAliasRequest" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
