compute(name=c_margin_markup visible="0" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" tooltip.enabled="0" tooltip.isbubble="0" tooltip.textcolor="134217751" tooltip.backcolor="134217752" tooltip.icon="0" tooltip.maxwidth="0" tooltip.transparency="0" tooltip.delay.visible="32000" tooltip.delay.initial="0" tooltip.hasclosebutton="0" transparency="0" background.mode="2" background.color="67108864" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.length="100" background.gradient.repetition.count="0" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" color="0" x="1313" y="4970" height="58" width="1562" format="[GENERAL]" expression="'Margin: ' +  string((( saleprice - purprice) / if(saleprice=0, 1, saleprice)) * 100, '###,##0.00') + '%' + SPACE(1) +  ', Net Margin: ' +  string((( (saleprice - flatdisc * (1 - salediscperc * 0.01)) - purprice) / if( (saleprice - flatdisc * (1 - salediscperc * 0.01)) = 0, 1, (saleprice - flatdisc * (1 - salediscperc * 0.01)))) * 100, '###,##0.00') + '%' + SPACE(1) + ', Mark-Up: ' +  string((((saleprice - flatdisc * (1 - salediscperc * 0.01)) - purprice) / if( purprice = 0, 1, purprice)) * 100, '###,##0.00') + '%' " alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
