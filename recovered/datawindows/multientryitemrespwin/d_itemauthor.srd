release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ItemAuthor.ICode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=authorcode dbname="ItemAuthor.AuthorCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=rowid dbname="ItemAuthor.ROWID"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=priority dbname="ItemAuthor.Priority"  )
 retrieve="  SELECT ItemAuthor.ICode,   
         ItemAuthor.AuthorCode,   
         ItemAuthor.ROWID,
         ItemAuthor.Priority
    FROM ItemAuthor  
   WHERE ItemAuthor.ICode = :ai_code    
"
  update="ItemAuthor" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
text(name=authorcode_t visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="2" border="6" x="9" y="8" height="64" width="1216" text="Author" html.valueishtml="0" )
