datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=74 color="536870912" )
summary(height=0 color="536870912" )
footer(height=67 color="536870912" )
detail(height=67 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(1) updatewhereclause=yes name=locksaleprice dbname="locksaleprice"  )
column=(type=char(1) updatewhereclause=yes name=lockdiscperc dbname="lockdiscperc"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes name=qtysale dbname="qtysale"  )
column=(type=long updatewhereclause=yes name=bonus dbname="bonus"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=recentpurprice dbname="recentpurprice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=updatesaleprice dbname="updatesaleprice"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SaleInvDetail.saleinvcode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="SaleInvDetail.icode"  )
column=(type=long update=yes updatewhereclause=yes name=gcode dbname="SaleInvDetail.gcode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes initial="." name=batch dbname="SaleInvDetail.batch"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=expiry dbname="SaleInvDetail.expiry"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=saleutn dbname="SaleInvDetail.saleutn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Item flat Disc should be greater than zero~"" name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="SaleInvDetail.RowID"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=rate dbname="rate"  )
column=(type=char(100) update=yes updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=long update=yes updatewhereclause=yes name=descicode dbname="DescICode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=0 and Real(GetText()) < 100" validationmsg="'Discount % value should be between 0 and 100'" name=discperc dbname="discperc"  )
column=(type=long update=yes updatewhereclause=yes name=salerowid dbname="SaleInvDetail.salerowid"  )
column=(type=long update=yes updatewhereclause=yes name=issuerowid dbname="SaleInvDetail.issuerowid"  )
column=(type=long update=yes updatewhereclause=yes name=sourcesaleinvcode dbname="SaleInvDetail.sourcesaleinvcode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="retailprice"  )
column=(type=long update=yes updatewhereclause=yes name=rowgroup dbname="rowgroup"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=packprice dbname="packprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=alternatepurprice dbname="alternatepurprice"  )
column=(type=decimal(3) updatewhereclause=yes name=unitweight dbname="UnitWeight"  )
column=(type=decimal(3) updatewhereclause=yes name=packingfactor dbname="PackingFactor"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=claimable dbname="Claimable" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100" validationmsg="'Claimable Discount % value should be between 0 and 100'" initial="0" name=claimablediscperc dbname="ClaimableDiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" name=gstperc dbname="gstperc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Pack Qty should be greater than or equal to zero'" initial="0" name=packqtyforsale dbname="packqtyforsale"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Bonus Qty should be greater than or equal to zero'" initial="0" name=bonuspackqtyforsale dbname="bonuspackqtyforsale"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Qty should be greater than or equal to zero'" initial="0" name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Bonus Qty should be greater than or equal to zero'" initial="1" name=looseqty dbname="looseqty"  )
 retrieve="SELECT 
	item.customicode, 
	itemname= item.name, 
	locksaleprice = dbo.item.locksaleprice,
	lockdiscperc = dbo.item.lockdiscperc,
	currlistrow = 0,
	stock     = 0.0000, 
	packingdesc=item.packingdesc,
	qtysale=item.saleqty,
	bonus=item.bonusqty,
	totalstock= 0.0000, 
	purprice=0.00,
	recentpurprice=0.00,
	avgprice=saleinvdetail.avgprice,
	itemtotalval=space(30),
	assgcode  = 1, 
	updatesaleprice = 'N',
	saleinvdetail.saleinvcode,   
	saleinvdetail.icode,   
	saleinvdetail.gcode,
	saleinvdetail.batch,
	saleinvdetail.expiry,
	saleinvdetail.saleutn,
	itemflatdisc = saleinvdetail.itemflatdisc,
	saleinvdetail.IDENTITYCOL, 
	packunits = saleinvdetail.packunits,
	saleprice = saleinvdetail.saleprice,
	rate      = saleinvdetail.rate,
	SaleItemDescription =  saleinvdetail.SaleItemDescription,
	DescICode =  saleinvdetail.DescICode,
	discperc  = saleinvdetail.discperc,
	saleinvdetail.salerowid,
	saleinvdetail.issuerowid,
	saleinvdetail.sourcesaleinvcode,
	itemcode = 0,
	retailprice=item.retailprice,
	rowgroup=saleinvdetail.rowgroup,
	packprice = saleinvdetail.packprice,
	unitsalestax=saleinvdetail.unitsalestax,
	alternatepurprice=saleinvdetail.alternatepurprice,
	UnitWeight = item.UnitWeight,
	PackingFactor = item.PackingFactor,
	Claimable = SaleInvDetail.Claimable,
	ClaimableDiscPerc = SaleInvDetail.ClaimableDiscPerc,
	gstperc=saleinvdetail.gstperc,
	packqtyforsale = saleinvdetail.packqtyforsale, 
	bonuspackqtyforsale = saleinvdetail.bonuspackqtyforsale,
	bonusqty=saleinvdetail.bonusqty,
	looseqty= saleinvdetail.looseqty 

FROM  saleinvdetail,   
		item 

WHERE ( dbo.saleinvdetail.saleinvcode = :ar_SaleInvCode ) AND
		( saleinvdetail.icode = item.icode )
	  
ORDER BY saleinvdetail.IDENTITYCOL"
  update="saleinvdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_SaleInvCode", number))
)
