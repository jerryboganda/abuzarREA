compute(name=c_sumlooseqty visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="2181" y="3" height="61" width="338" format="	f_SetColumnFormat('Qty')" expression="sum(looseqty for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumbonusqty visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="2834" y="3" height="61" width="219" format="	f_SetColumnFormat('Qty')" expression="sum(bonusqty for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumitemflatdisc visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="3447" y="3" height="61" width="256" format="###0.00" expression="sum(itemflatdisc*looseqty for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumitemdiscval visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="3712" y="3" height="61" width="256" format="###0.00" expression="sum( round(((saleprice - itemflatdisc)*discperc*0.01)*looseqty,2) for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_detaildwtotal visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="6053" y="3" height="61" width="352" format="##,###,##0.00" expression="sum( ( ( looseqty *  (saleprice -  itemflatdisc )) ) *  ( 1-  (  discperc  *  .01 )  )  for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumtaxval visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="6747" y="3" height="61" width="242" format="###0.00" expression="sum( round( unitsalestax  * (Bonusqty + looseqty) ,2)  for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumgstval visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="7250" y="3" height="61" width="242" format="###0.00" expression="sum( round( c_itemtotal  *  gstperc * 0.01,2)  for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumfinalitemval visible="1	0" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="7502" y="3" height="61" width="416" format="##,###,##0.00" expression="sum( c_finalitemval  for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_3 visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="7927" y="3" height="61" width="448" format="###,##0.000" expression="sum( unitweight for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_4 visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="8384" y="3" height="61" width="462" format="###,##0.000" expression="sum( (looseqty + bonusqty) * unitweight for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_5 visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="8855" y="3" height="61" width="457" format="###,##0.000" expression="sum( packingfactor for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_6 visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="9321" y="3" height="61" width="448" format="###,##0.000" expression="sum( (looseqty + bonusqty) * packingfactor for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
