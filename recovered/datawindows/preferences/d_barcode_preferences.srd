 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=barcodeleninprint dbname="Preferences.BarCodeLenInPrint"  )
 retrieve="SELECT
	Preferences.UserId,
	Preferences.BarCodePriceStartsWith,
	Preferences.BarCodePriceEndsWith,
	Preferences.ShowHeaderInBarCodeModule,
	Preferences.ShowStartsEndsInBarCodeModule,
	Preferences.BarCodeLenInPrint

FROM Preferences
"
  update="Preferences" updatewhere=1 updatekeyinplace=yes
 )
