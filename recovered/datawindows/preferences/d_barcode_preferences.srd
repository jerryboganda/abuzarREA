table(column=(type=long key=yes update=yes updatewhereclause=yes name=userid dbname="Preferences.UserId"  )
column=(type=char(3) update=yes updatewhereclause=yes initial=" " name=barcodepricestartswith dbname="Preferences.BarCodePriceStartsWith"  )
column=(type=char(3) update=yes updatewhereclause=yes initial=" " name=barcodepriceendswith dbname="Preferences.BarCodePriceEndsWith"  )
