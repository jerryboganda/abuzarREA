	Preferences.UserId,
	Preferences.HeaderOnadjustmentInv,
	Preferences.AskUserPwdInAdjustment,
	Preferences.UpdAvgPriceInAdjInc,
	Preferences.ShowUpdAvgPriceInAdjInc
	IncAdjInActMonitor
 FROM Preferences"
  update="Preferences" updatewhere=1 updatekeyinplace=yes
 )
