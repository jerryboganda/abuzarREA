release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2083 color="536870912" )
summary(height=1625 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=servicepurinvcode dbname="ServicePurInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(12) updatewhereclause=yes name=supplieralias dbname="SupplierAlias"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=char(60) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=char(60) updatewhereclause=yes name=ref1 dbname="Ref1"  )
column=(type=char(60) updatewhereclause=yes name=ref2 dbname="Ref2"  )
column=(type=char(60) updatewhereclause=yes name=ref3 dbname="Ref3"  )
column=(type=char(60) updatewhereclause=yes name=ref4 dbname="Ref4"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="ServiceFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowId"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="InvDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdiscount dbname="FlatDiscount"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="MiscCharges"  )
column=(type=decimal(2) updatewhereclause=yes name=cashpaid dbname="CashPaid"  )
column=(type=decimal(2) updatewhereclause=yes name=otherpaid dbname="OtherPaid"  )
 retrieve="SELECT 
	ServicePurInvCode=H.ServicePurInvCode,
	Date = H.Date,
	SupplierAlias=A.AliasName,
	SupplierName=A.Name,
	UserName=U.UserName,
	HeaderNo = H.HeaderNo,
	AliasName = SV.AliasName,
	ServiceName=SV.Name,
	Ref1 = H.Ref1,
	Ref2 = H.Ref2,
	Ref3 = H.Ref3,
	Ref4 = H.Ref4,
	Remarks=H.Remarks,
	Qty =D.Qty,
	Price=D.Price,
	ServiceFlatDisc=D.ServiceFlatDisc,
	DiscPerc=D.DiscPerc,
	RowId=D.RowID,
	InvDiscPerc=H.DiscPerc,
	FlatDiscount=H.FlatDisc,
	MiscCharges=H.MiscCharges,
	CashPaid = H.CashCharged,
	OtherPaid = ISNULL((SELECT SUM(M.Amount) FROM MasterCashWin M WHERE M.DocumentCode = :ai_code AND DocumentType='SP'), 0)
FROM ServicePurHeader H, ServicePurDetail D, Supplier S, Accounts A, Users U, Service SV
WHERE H.ServicePurInvCode = :ai_Code AND 
	H.ServicePurInvCode=D.ServicePurInvCode AND
	H.SuppCode=S.SuppCode AND
	S.SuppCode=A.AccCode AND
	H.UserCode = U.UserCode AND
	D.ServiceCode=SV.ServiceCode
ORDER BY
	D.RowID
	"
  arguments=(("ai_code", number))
)
