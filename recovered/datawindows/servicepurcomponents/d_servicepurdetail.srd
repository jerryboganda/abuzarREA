header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=68 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="ServicePurDetail.Servicecode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServicePurDetail.ServicePurInvCode"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="ServicePurDetail.RowID"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) > 0" initial="1" name=qty dbname="ServicePurDetail.qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" name=price dbname="ServicePurDetail.price"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Flat Discount Value~"" initial="0" name=serviceflatdisc dbname="ServicePurDetail.Serviceflatdisc"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=allowsaleindecimal dbname="AllowSaleInDecimal"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ServicePurDetail.Remarks"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid discount percentage.~"" initial="0" name=discperc dbname="ServicePurDetail.discperc"  )
 retrieve="SELECT 
	fullcode=Service.aliasname,
	itemname= Service.name, 
	ServicePurDetail.Servicecode,
	itemcode = ServicePurDetail.Servicecode,
	currlistrow = 0,
	ServicePurDetail.ServicePurInvCode,   
	ServicePurDetail.RowID,
	ServicePurDetail.qty,
	ServicePurDetail.price,
	ServicePurDetail.Serviceflatdisc,
	AllowSaleInDecimal=Service.AllowSaleInDecimal,
	ServicePurDetail.Remarks,
	ServicePurDetail.discperc
FROM 
	ServicePurDetail, Service 
WHERE 
	ServicePurDetail.ServicePurInvCode = :ai_Code AND 
	ServicePurDetail.ServiceCode = Service.ServiceCode"
  update="ServicePurDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_Code", number))
)
