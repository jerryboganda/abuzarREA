footer(height=0 color="536870912" )
detail(height=104 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=serviceprinvcode dbname="ServicePRHeader.serviceprinvcode"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) >= 0 and real(gettext()) <= 100" validationmsg="~"Please Enter Valid Discount %age Value~"" initial="0" name=discperc dbname="ServicePRHeader.discperc"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please Enter Valid Flat Discount Value~"" initial="0" name=flatdisc dbname="ServicePRHeader.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please Enter Valid Misc. Charges Value~"" initial="0" name=misccharges dbname="ServicePRHeader.misccharges"  )
column=(type=long updatewhereclause=yes initial="0" name=icode dbname="icode"  )
column=(type=long updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=long updatewhereclause=yes initial="0" name=retableqty dbname="retableqty"  )
column=(type=long updatewhereclause=yes initial="0" name=saleqty dbname="saleqty"  )
column=(type=decimal(1) updatewhereclause=yes initial="0" name=total dbname="total"  )
 retrieve="SELECT 
	SVCRH.serviceprinvcode,   
	SVCRH.discperc,   
	SVCRH.flatdisc,   
	SVCRH.misccharges,
	icode = 0, 
	stock = 0, 
	retableqty = 0,
	saleqty = 0 ,
	total = 0.0
FROM serviceprheader SVCRH  
WHERE SVCRH.serviceprinvcode =:ai_serviceprinvcode   
"
  update="serviceprheader" updatewhere=0 updatekeyinplace=no
  arguments=(("ai_serviceprinvcode", number))
)
