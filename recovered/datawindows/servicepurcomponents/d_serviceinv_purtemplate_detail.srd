release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=72 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceInvPurTempDetail.ServiceInvCode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=currlistrow dbname="currlistrow"  )
column=(type=char(9) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=long update=yes updatewhereclause=yes name=srvrowid dbname="ServiceInvPurTempDetail.SRVRowID"  )
column=(type=char(60) updatewhereclause=yes name=servicetopurchase dbname="ServiceToPurchase"  )
column=(type=decimal(6) updatewhereclause=yes initial="0" name=serviceprice dbname="ServicePrice"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="ServiceInvPurTempDetail.ServiceCode"  )
column=(type=long update=yes updatewhereclause=yes initial="18" name=suppcode dbname="ServiceInvPurTempDetail.SuppCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real ( GetText() ) > 0" initial="1" name=qty dbname="ServiceInvPurTempDetail.Qty"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=pricerule dbname="ServiceInvPurTempDetail.PriceRule" 
 values="Relative	1/Absolute	2/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real ( GetText() ) >= 0" initial="0" name=saleprice dbname="ServiceInvPurTempDetail.SalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) <= 100" validationmsg="'Sale Price (%) must be between 0 and 100'" initial="0" name=salepriceperc dbname="ServiceInvPurTempDetail.SalePricePerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real ( GetText() ) >= 0" validationmsg="'Please enter valid service purchase price'" initial="0" name=purprice dbname="ServiceInvPurTempDetail.PurPrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real ( GetText() ) >= 0" validationmsg="'Please enter valid service flat discount'" initial="0" name=serviceflatdisc dbname="ServiceInvPurTempDetail.ServiceFlatDisc"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=allowsaleindecimal dbname="AllowSaleInDecimal"  )
column=(type=char(1) updatewhereclause=yes initial="1" name=servicestatus dbname="ServiceStatus"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="ServiceInvPurTempDetail.ROWID"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) <= 100" validationmsg="'Service Discount (%) must be between 0 and 100'" initial="0" name=discperc dbname="ServiceInvPurTempDetail.Discperc"  )
 retrieve="SELECT 
	ServiceInvPurTempDetail.ServiceInvCode,
	itemcode = ServiceInvPurTempDetail.ServiceCode,
	itemname= service.name, 
	currlistrow = 0,
	fullcode = '         ',
	ServiceInvPurTempDetail.SRVRowID,
	ServiceToPurchase=(SELECT SV.Name FROM Service SV, ServiceDetail SD WHERE SD.ServiceInvCode=:ai_code AND SD.SrvRowID=ServiceInvPurTempDetail.SrvRowID AND SD.ServiceCode=SV.ServiceCode),
	ServicePrice=(SELECT Price=MAX(ROUND((SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01), 2)) FROM Service SV, ServiceDetail SD WHERE SD.ServiceInvCode=:ai_code AND SD.SrvRowID=ServiceInvPurTempDetail.SrvRowID AND SD.ServiceCode=SV.ServiceCode),
	ServiceInvPurTempDetail.ServiceCode,
	ServiceInvPurTempDetail.SuppCode,
	ServiceInvPurTempDetail.Qty,
	ServiceInvPurTempDetail.PriceRule,
	ServiceInvPurTempDetail.SalePrice,
	ServiceInvPurTempDetail.SalePricePerc,
	ServiceInvPurTempDetail.PurPrice,
	ServiceInvPurTempDetail.ServiceFlatDisc,
	AllowSaleInDecimal=Service.AllowSaleInDecimal,
	ServiceStatus = 'N',
	ServiceInvPurTempDetail.IDentityCOL,
	ServiceInvPurTempDetail.Discperc
FROM ServiceInvPurTempDetail, Service
WHERE ( ServiceInvPurTempDetail.ServiceInvCode = :ai_code )    AND
	( ServiceInvPurTempDetail.ServiceCode = Service.ServiceCode )
	"
  update="ServiceInvPurTempDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
 sort="code A, srvrowid A, servicetopurchase A, rowid A"
)
