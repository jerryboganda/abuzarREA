column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=marked dbname="ServicePRHeader.Marked"  )
 retrieve="SELECT
	SVCRH.serviceprinvcode ,
	SVCRH.ServicePurInvCode ,
	SVCRH.date ,
	SVCRH.Suppcode ,
	SVCRH.usercode ,
	SVCRH.discperc ,
	SVCRH.flatdisc ,
	SVCRH.misccharges ,
	users.username ,
	SVCH.date ,
	SVCRH.headerno ,
	SVCRH.headerinvno ,
	SVCRH.posted ,
	SVCRH.postdate ,
	accounts.aliasname ,
	accounts.name ,
	Supplier.address1 ,
	Supplier.city ,
	Supplier.phone,
	SVCRH.originaldate,
	SVCRH.modifiedby,
	SVCRH.postedby,	   
	SVCRH.remarks ,
	SVCRH.Ref1,
	SVCRH.Ref2,
	SVCRH.Ref3,
	SVCRH.Ref4,
	SVCRH.CashAccCode,
	SVCRH.CashTendered,
	SVCRH.CashCharged,
	SVCRH.CashBack,
	SVCRH.InvTotal,
	SVCRH.OutstandingAmt,
	SVCRH.Marked
FROM
	accounts ,
	Supplier ,
	servicepurheader SVCH,
	users ,
	serviceprheader SVCRH
WHERE 
	( SVCRH.serviceprinvcode = :ai_serviceprinvcode ) and
	( SVCRH.ServicePurInvCode = SVCH.ServicePurInvCode ) and   
	( SVCH.Suppcode = Supplier.Suppcode ) and          
	( SVCRH.usercode = users.usercode ) and          
	( SVCH.Suppcode = accounts.acccode )
"
  update="serviceprheader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_serviceprinvcode", number))
)
