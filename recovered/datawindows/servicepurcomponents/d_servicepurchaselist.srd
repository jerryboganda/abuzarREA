summary(height=67 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="ServicePurHeader.ServicePurInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ServicePurHeader.Date"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ServicePurHeader.Remarks"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=char(60) updatewhereclause=yes name=ref1 dbname="Ref1"  )
column=(type=char(60) updatewhereclause=yes name=ref2 dbname="Ref2"  )
column=(type=char(60) updatewhereclause=yes name=ref3 dbname="Ref3"  )
column=(type=char(60) updatewhereclause=yes name=ref4 dbname="Ref4"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=long updatewhereclause=yes name=expacccode dbname="ExpAccCode"  )
column=(type=char(60) updatewhereclause=yes name=expaccount dbname="ExpAccount"  )
 retrieve="SELECT  
	ServicePurHeader.ServicePurInvCode , 
	ServicePurHeader.Date , 
	InvTotal = ServicePurHeader.InvTotal,
	ServicePurHeader.Remarks , 
	SuppCode=ServicePurHeader.SuppCode,
	SupplierName=accounts.name,
	posted = ServicePurHeader.posted,
	PostedBy = IsNull((Select username from users 
				where dbo.ServicePurHeader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
				where dbo.ServicePurHeader.modifiedby = dbo.users.usercode), '') ,
	Ref1=Ref1,
	Ref2=Ref2,
	Ref3=Ref3,
	Ref4=Ref4,
	Remarks=ServicePurHeader.Remarks,
	HeaderNo=ServicePurHeader.HeaderNo,
	ExpAccCode=ServicePurHeader.ExpAccCode,
	ExpAccount = (SELECT AC.Name FROM Accounts AC WHERE AC.AccCode=ServicePurHeader.ExpAccCode)
FROM
	accounts , 
	ServicePurHeader
WHERE 
	(dbo.ServicePurHeader.date > :ad_invdate) and
	( ServicePurHeader.SuppCode = accounts.acccode ) and 
	( Posted IN (:as_Posted))"
  arguments=(("as_Posted", stringlist), ("ad_invdate", datetime))
)
