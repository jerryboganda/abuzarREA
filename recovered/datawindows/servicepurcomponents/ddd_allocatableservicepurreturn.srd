detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=serviceprinvcode dbname="ServicePRInvCode"  )
column=(type=long updatewhereclause=yes name=servicepurinvcode dbname="ServicePurInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="OutstandingAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve="SELECT 
	ServicePRInvCode,   
	ServicePurInvCode,   
	Date,   
	SuppCode,   
	Supplier,
	AliasName,
	OutstandingAmt,
	InvTotal
FROM 
	(SELECT 
		ServicePRHeader.ServicePRInvCode,   
		ServicePRHeader.ServicePurInvCode,   
		ServicePRHeader.Date,   
		ServicePRHeader.SuppCode,   
		Supplier=Accounts.Name,
		AliasName=Accounts.AliasName,
		OutstandingAmt = ServicePRHeader.OutstandingAmt + 
			ISNULL((SELECT ServicePRAllocationHeader.ServicePRInvCode FROM ServicePRAllocationHeader 
				WHERE ServicePRAllocationHeader.ServicePRAllocationCode = :Code AND 
					ServicePRAllocationHeader.ServicePRInvCode = ServicePRHeader.ServicePRInvCode), 0),
		ServicePRHeader.InvTotal
	
	FROM 
		ServicePRHeader, Accounts
	WHERE
		ServicePRHeader.Marked = 'N' AND
		ServicePRHeader.Posted ='Y' AND
		ServicePRHeader.SuppCode = Accounts.AccCode) PR
WHERE 
	OutstandingAmt > 0
ORDER BY
	Date,   
	ServicePRInvCode"
  arguments=(("code", number))
)
