detail(height=172 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=code dbname="ServicePurHeader.ServicePurInvCode"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Invoice Level Flat Discount can not be negative'" initial="0" name=flatdisc dbname="ServicePurHeader.FlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Invoice Level Misc. Charges can not be negative'" initial="0" name=misccharges dbname="ServicePurHeader.MiscCharges"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Invoice Level Discount %age can not be negative'" initial="0" name=invdiscperc dbname="ServicePurHeader.DiscPerc"  )
column=(type=long updatewhereclause=yes initial="99999" name=icode dbname="Icode"  )
column=(type=long updatewhereclause=yes initial="0" name=stock dbname="Stock"  )
column=(type=long updatewhereclause=yes initial="0" name=totalstock dbname="TotalStock"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Invoice total can not be negative'" initial="0" name=total dbname="Total"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=purdiscperc dbname="purdiscperc"  )
 retrieve="SELECT 
	ServicePurHeader.ServicePurInvCode ,   
	ServicePurHeader.FlatDisc,   
	ServicePurHeader.MiscCharges,   
	ServicePurHeader.DiscPerc,
	Icode = 0, 
	Stock = 0,
	TotalStock = 0,
	Total = 0.00,
	purdiscperc = 0.00
FROM 
	ServicePurHeader  
WHERE 
	ServicePurHeader.ServicePurInvCode = :ar_invcode
"
  update="ServicePurHeader" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_invcode", number))
)
