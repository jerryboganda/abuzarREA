table(column=(type=char(60) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=long update=yes updatewhereclause=yes name=servicecode dbname="Service.servicecode" 
 values=""  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=serviceqty dbname="ServiceQty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="1" name=qty dbname="ServicePRDetail.qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=price dbname="ServicePRDetail.Price"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=serviceflatdisc dbname="ServicePRDetail.ServiceFlatDisc"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=allowsaleindecimal dbname="AllowSaleInDecimal"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServicePRDetail.serviceprinvcode"  )
column=(type=long update=yes updatewhereclause=yes name=srvrowid dbname="ServicePRDetail.srvrowid"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="ServicePRDetail.rowid"  )
column=(type=long updatewhereclause=yes initial="0" name=retqty dbname="retqty"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ServicePRDetail.remarks"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discperc dbname="ServicePRDetail.discperc"  )
 retrieve="SELECT 
	fullcode=service.aliasname,
	service.servicecode,
	ServiceQty=SVCRD.qty,
	SVCRD.qty,
	SVCRD.Price,
	SVCRD.ServiceFlatDisc,
	AllowSaleInDecimal=Service.AllowSaleInDecimal,
	currlistrow = 0,
	SVCRD.serviceprinvcode,
	SVCRD.srvrowid,
	SVCRD.rowid,
	retqty = 0,
	SVCRD.remarks,
	SVCRD.discperc
FROM 
	serviceprdetail SVCRD,
	service  
WHERE 
	( SVCRD.servicecode = service.servicecode ) and  
	( SVCRD.serviceprinvcode = :ra_invno )
"
  update="serviceprdetail" updatewhere=1 updatekeyinplace=no
  arguments=(("ra_invno", number))
)
