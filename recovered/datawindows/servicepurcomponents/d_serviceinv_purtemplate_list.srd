table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceInvPurTempHeader.ServiceInvCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="ServiceInvPurTempHeader.Date"  )
column=(type=char(60) update=yes updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="ServiceInvPurTempHeader.Posted" 
 values="Yes	Y/No	N/"  )
column=(type=char(60) update=yes updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="ServiceInvPurTempHeader.PostDate"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ServiceInvPurTempHeader.Remarks"  )
 retrieve="SELECT 
	ServiceInvCode, 
	Date, 
	UserName=(SELECT U.UserName FROM Users U WHERE U.UserCode=ServiceInvPurTempHeader.UserCode),
	Posted, 
	PostedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=ServiceInvPurTempHeader.PostedBy), 
	PostDate, 
	Remarks 
FROM 
	ServiceInvPurTempHeader"
  update="ServiceInvPurTempHeader" updatewhere=1 updatekeyinplace=no
 )
