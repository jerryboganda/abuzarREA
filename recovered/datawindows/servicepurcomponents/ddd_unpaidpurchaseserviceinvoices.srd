footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=servicepurinvcode dbname="ServicePurInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="OutstandingAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve="SELECT 
	ServicePurInvCode,
	Date,
	SuppCode,
	Supplier,
	AliasName,
	OutstandingAmt,
	InvTotal
FROM
(SELECT 
	ServicePurHeader.ServicePurInvCode,
	ServicePurHeader.Date,
	ServicePurHeader.SuppCode,
	Supplier=Accounts.Name,
	AliasName=Accounts.AliasName,
	OutstandingAmt = ServicePurHeader.OutstandingAmt + 
		CASE :module
		WHEN 'PRA' THEN 
			ISNULL((SELECT SUM(Amt) FROM ServicePRAllocationDetail 
			Where ServicePRAllocationCode = :Code AND ServicePRAllocationDetail.ServicePurInvCode = ServicePurHeader.ServicePurInvCode), 0)
		ELSE 
			ISNULL((SELECT SUM(D.Debit - D.Credit) 
			FROM GLDetail D, GLHeader H, VocherCategory C
			Where D.GlVochCode = :Code AND D.InvoiceCode = ServicePurHeader.ServicePurInvCode AND 
				D.GLVochCode=H.GLVochCode AND H.VochCatCode = C.VochCatCode AND C.InvoiceType=4), 0)
		END,
	ServicePurHeader.InvTotal
FROM 
	ServicePurHeader, Accounts
WHERE
	ServicePurHeader.Marked = 'N' AND
	ServicePurHeader.Posted ='Y' AND
	ServicePurHeader.SuppCode = :suppcode AND
	ServicePurHeader.SuppCode = Accounts.AccCode) P
WHERE
	OutstandingAmt > 0
ORDER BY
	Date,   
	ServicePurInvCode"
  arguments=(("suppcode", number), ("code", number), ("module", string))
)
