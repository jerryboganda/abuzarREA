detail(height=80 color="536870912" )
table(column=(type=char(60) update=yes updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServicePurTempHeader.ServicePurTempCode"  )
column=(type=long update=yes updatewhereclause=yes name=servicecode dbname="ServicePurTempHeader.ServiceCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="ServicePurTempHeader.Date"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ServicePurTempHeader.Remarks"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
 retrieve="SELECT 
	ServiceName=(SELECT SV.Name FROM Service SV WHERE SV.ServiceCode=ServicePurTempHeader.ServiceCode),
	ServicePurTempHeader.ServicePurTempCode,   
	ServicePurTempHeader.ServiceCode,   
	ServicePurTempHeader.Date,   
	ServicePurTempHeader.Remarks,   
	UserName=(SELECT U.UserName FROM Users U WHERE U.UserCode=ServicePurTempHeader.UserCode)
FROM 
	ServicePurTempHeader  
"
  update="ServicePurTempHeader" updatewhere=1 updatekeyinplace=no
 )
