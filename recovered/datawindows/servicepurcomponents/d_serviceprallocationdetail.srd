table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServicePRAllocationDetail.ServicePRAllocationCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=servicepurinvcode dbname="ServicePRAllocationDetail.ServicePurInvCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes initial="today" name=purdate dbname="ServicePurHeader.Date"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=netamt dbname="ServicePurHeader.InvTotal"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=outstandingamt dbname="ServicePRAllocationDetail.OutstandingAmt"  )
column=(type=long updatewhereclause=yes name=rowid dbname="ServicePRAllocationDetail.ROWID"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=utn dbname="ServicePRAllocationDetail.UTN"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) > 0" initial="0" name=amt dbname="ServicePRAllocationDetail.Amt"  )
 retrieve="SELECT
	ServicePRAllocationDetail.ServicePRAllocationCode,
	ServicePRAllocationDetail.ServicePurInvCode,
	ServicePurHeader.Date,
	ServicePurHeader.InvTotal,
	ServicePRAllocationDetail.OutstandingAmt,
	ServicePRAllocationDetail.IDENTITYCOL,
	ServicePRAllocationDetail.UTN,
	ServicePRAllocationDetail.Amt
FROM
	ServicePRAllocationDetail,
	ServicePRAllocationHeader,
	ServicePurHeader
WHERE
	( ServicePRAllocationHeader.ServicePRAllocationCode = :Code ) AND
	( ServicePRAllocationHeader.ServicePRAllocationCode = ServicePRAllocationDetail.ServicePRAllocationCode ) and  
	( ServicePRAllocationDetail.ServicePurInvCode = ServicePurHeader.ServicePurInvCode )
ORDER BY
	ServicePRAllocationDetail.ServicePRAllocationCode,   
	ServicePRAllocationDetail.IDENTITYCOL,
	ServicePRAllocationDetail.ServicePurInvCode
"
  update="ServicePRAllocationDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("code", number))
)
