table(column=(type=long updatewhereclause=yes name=code dbname="ServicePRAllocationHeader.ServicePRAllocationCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ServicePRAllocationHeader.Date"  )
column=(type=long updatewhereclause=yes name=serviceprinvcode dbname="ServicePRAllocationHeader.ServicePRInvCode"  )
column=(type=datetime updatewhereclause=yes name=returndate dbname="ReturnDate"  )
column=(type=decimal(2) updatewhereclause=yes name=returnamt dbname="ReturnAmt"  )
column=(type=long updatewhereclause=yes name=servicepurinvcode dbname="ServicePRHeader.ServicePurInvCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.Name"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.UserName"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="ServicePRAllocationHeader.Posted" 
 values="Yes	Y/No	N/"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="ServicePRAllocationHeader.PostDate"  )
 retrieve="SELECT
	ServicePRAllocationHeader.ServicePRAllocationCode,   
	ServicePRAllocationHeader.Date,   
	ServicePRAllocationHeader.ServicePRInvCode,   
	ReturnDate=ServicePRHeader.Date, 
	ReturnAmt=ServicePRHeader.InvTotal,
	ServicePRHeader.ServicePurInvCode, 
	Accounts.AliasName, 
	Accounts.Name,
	Users.UserName,
	ServicePRAllocationHeader.Posted, 
	ServicePRAllocationHeader.PostDate

FROM 
	ServicePRAllocationHeader, ServicePRHeader, Accounts, Supplier, Users

WHERE
	ServicePRAllocationHeader.ServicePRInvCode = ServicePRHeader.ServicePRInvCode AND
	ServicePRHeader.SuppCode = Supplier.SuppCode AND
	Supplier.SuppCode = Accounts.AccCode AND
	ServicePRAllocationHeader.UserCode = Users.UserCode

ORDER BY
	ServicePRAllocationHeader.ServicePRAllocationCode"
 )
