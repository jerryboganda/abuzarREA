header(height=76 color="536870912" )
summary(height=60 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SampleDetail.SampleCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=servicerowid dbname="SampleDetail.ServiceRowID" 
 values=""  )
column=(type=long key=yes update=yes updatewhereclause=yes name=sampletypecode dbname="SampleDetail.SampleTypeCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=servicedate dbname="ServiceDate"  )
column=(type=datetime updatewhereclause=yes name=deliverydate dbname="DeliveryDate"  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="SampleDetail.RowID"  )
column=(type=char(100) update=yes updatewhereclause=yes name=color dbname="SampleDetail.Color"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="SampleDetail.Remarks"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=volume dbname="SampleDetail.Volume"  )
 retrieve="SELECT 
	SampleCode,
	ServiceRowID,
	SampleTypeCode,
	ServiceDate=GETDATE(),
	DeliveryDate=GETDATE(),
	RowID,
	Color,
	Remarks,
	Volume
FROM
	SampleDetail
WHERE
	SampleCode = :ai_code
ORDER BY
	RowID
"
  update="SampleDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
 sort="sampletypecode A, servicerowid A"
)
