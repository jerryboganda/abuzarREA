 values=""  )
 retrieve="SELECT 
	ServiceTemplateHeader.ServiceTemplateCode,   
	ServiceTemplateHeader.Name,   
	ServiceTemplateHeader.Date,   
	ServiceTemplateHeader.UserCode  
FROM ServiceTemplateHeader   
WHERE ServiceTemplateHeader.ServiceTemplateCode = :ai_code
"
  update="ServiceTemplateHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
