table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceBreakUp.ServiceCode"  )
column=(type=long updatewhereclause=yes name=rowid dbname="ServiceBreakUp.ROWID"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=servicecomponentcode dbname="ServiceBreakUp.ServiceComponentCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=servicecomponentunitcode dbname="ServiceComponentUnitCode"  )
column=(type=char(1) updatewhereclause=yes name=valuetype dbname="ValueType"  )
column=(type=long updatewhereclause=yes name=servicecomponenttypecode dbname="ServiceComponentTypeCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=servicehead dbname="ServiceBreakUp.ServiceHead"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid service cost'" initial="0" name=costprice dbname="ServiceBreakUp.CostPrice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid service price'" initial="0" name=saleprice dbname="ServiceBreakUp.SalePrice"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" initial="1" name=priority dbname="ServiceBreakUp.Priority"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=printonreport dbname="ServiceBreakUp.PrintOnReport" 
 values="	Y/	N"  )
 retrieve="SELECT 
	ServiceBreakUp.ServiceCode,   
	ServiceBreakUp.ROWID,   
	ServiceBreakUp.ServiceComponentCode,   
	ServiceComponentUnitCode= (SELECT S.ServiceComponentUnitCode FROM ServiceComponent S WHERE S.ServiceComponentCode = ServiceBreakUp.ServiceComponentCode),
	ValueType = (SELECT U.ValueType FROM ServiceComponentUnit U WHERE U.ServiceComponentUnitCode IN (SELECT S.ServiceComponentUnitCode FROM ServiceComponent S WHERE S.ServiceComponentCode = ServiceBreakUp.ServiceComponentCode)),
	ServiceComponentTypeCode= (SELECT S.ServiceComponentTypeCode FROM ServiceComponent S WHERE S.ServiceComponentCode = ServiceBreakUp.ServiceComponentCode),
	ServiceBreakUp.ServiceHead,   
	ServiceBreakUp.CostPrice,   
	ServiceBreakUp.SalePrice,
	ServiceBreakUp.Priority,
	ServiceBreakUp.PrintOnReport
FROM 
	ServiceBreakUp
WHERE 
	ServiceBreakUp.ServiceCode = :ai_code
ORDER BY 
	ServiceBreakUp.ServiceHead,
	RowID"
  update="ServiceBreakUp" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
 sort="priority A, servicehead A, rowid A"
)
