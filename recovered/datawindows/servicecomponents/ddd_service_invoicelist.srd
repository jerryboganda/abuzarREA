release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=79146959 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=118 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=77 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Service.name"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="ServiceDetail.servicecode"  )
column=(type=long updatewhereclause=yes name=smancode dbname="ServiceDetail.smancode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesMan.name"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="ServiceDetail.qty"  )
column=(type=decimal(2) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceprice dbname="ServiceDetail.price"  )
column=(type=char(1) updatewhereclause=yes name=allowsaleindecimal dbname="AllowSaleInDecimal"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="ServiceDetail.ServiceFlatDisc"  )
column=(type=decimal(5) updatewhereclause=yes initial="0.00" name=costprice dbname="ServiceDetail.costprice"  )
column=(type=long identity=yes updatewhereclause=yes name=srvrowid dbname="ServiceDetail.srvrowid"  )
column=(type=decimal(2) updatewhereclause=yes name=commission dbname="ServiceDetail.Commission"  )
column=(type=decimal(2) updatewhereclause=yes name=shareperc dbname="ServiceDetail.SharePerc"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflattax dbname="ServiceDetail.ServiceFlatTax"  )
column=(type=decimal(2) updatewhereclause=yes name=servicegstperc dbname="ServiceDetail.ServiceGstPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="ServiceDetail.DiscPerc"  )
 retrieve="SELECT 
	fullcode=service.aliasname,
	service.name,
	SVCD.servicecode,
	SVCD.smancode,
	salesman.name,	
	SVCD.qty,
	ReturnQty = ( Select IsNull(Sum(qty),0 ) 
			From   ServiceRHeader srh ,ServiceRDetail srd
			Where  srh.serviceinvcode = :ai_serviceinvcode AND 
					 srh.servicerinvcode = srd.servicerinvcode AND
					 srd.servicecode = SVCD.servicecode AND
					 srd.srvrowid = SVCD.srvrowid),
	SVCD.price,
	AllowSaleInDecimal=Service.AllowSaleInDecimal,
	SVCD.ServiceFlatDisc,
	SVCD.costprice,
	SVCD.srvrowid,
	SVCD.Commission,
	SVCD.SharePerc,
	SVCD.ServiceFlatTax,
	SVCD.ServiceGstPerc,
	SVCD.DiscPerc
FROM   
	ServiceDetail SVCD
	LEFT OUTER JOIN salesman ON (SVCD.smancode = salesman.salesmancode),
	Service
WHERE  
	SVCD.servicecode=service.servicecode AND
	SVCD.serviceinvcode=:ai_serviceinvcode
UNION ALL
SELECT 
	fullcode=service.aliasname,
	service.name,
	servicecode=Service.servicecode,
	SManCode=NULL,
	NULL,	
	qty=99999,
	ReturnQty = 0,
	price=service.price,
	AllowSaleInDecimal=Service.AllowSaleInDecimal,
	ServiceFlatDisc=0,
	costprice=Service.CostPrice,
	srvrowid=NULL,
	Commission=Service.Commission,
	SharePerc=Service.SharePerc,
	ServiceFlatTax=Service.ServiceFlatTax,
	ServiceGstPerc=Service.ServiceGstPerc,
	DiscPerc=0.00
FROM   
	Service
WHERE  
	:ai_serviceinvcode IS NULL
"
  arguments=(("ai_serviceinvcode", number))
)
