table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceTemplateDetail.servicetemplatecode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=char(9) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="ServiceTemplateDetail.servicecode"  )
column=(type=long update=yes updatewhereclause=yes name=smancode dbname="ServiceTemplateDetail.smancode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real ( GetText() ) > 0" initial="1" name=qty dbname="ServiceTemplateDetail.qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" name=saleprice dbname="ServiceTemplateDetail.saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="~"Please enter valid service flat discount~"" initial="0" name=serviceflatdisc dbname="ServiceTemplateDetail.serviceflatdisc"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="ServiceTemplateDetail.RowId"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=allowsaleindecimal dbname="AllowSaleInDecimal"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=servicestatus dbname="ServiceStatus"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) < 100" validationmsg="'Discount (%) must be between 0 and 100'" initial="0" name=discperc dbname="ServiceTemplateDetail.discperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="~"Please enter valid value for commission~"" initial="0" name=commission dbname="ServiceTemplateDetail.commission"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) <= 100" validationmsg="'Share (%) must be between 0 and 100'" initial="0" name=shareperc dbname="ServiceTemplateDetail.Shareperc"  )
 retrieve="SELECT 
	servicetemplatedetail.servicetemplatecode,
	itemcode = servicetemplatedetail.servicecode,
	itemname= service.name, 
	currlistrow = 0,
	fullcode = '         ',
	servicetemplatedetail.servicecode,
	servicetemplatedetail.smancode,
	servicetemplatedetail.qty,
	servicetemplatedetail.saleprice,
	servicetemplatedetail.serviceflatdisc,
	servicetemplatedetail.IDentityCOL,
	AllowSaleInDecimal=Service.AllowSaleInDecimal,
	ServiceStatus = 'N',
	servicetemplatedetail.discperc,
	servicetemplatedetail.commission,
	servicetemplatedetail.Shareperc
FROM servicetemplatedetail,service
WHERE ( servicetemplatedetail.servicetemplatecode = :ai_code )    AND
	( servicetemplatedetail.servicecode = service.servicecode )
	"
  update="servicetemplatedetail" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
