 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ServiceTemplateDetail~" )  TABLE(NAME=~"ServiceTemplateHeader~" ) COLUMN(NAME=~"ServiceTemplateHeader.ServiceTemplateCode~") COLUMN(NAME=~"ServiceTemplateHeader.Name~") COLUMN(NAME=~"ServiceTemplateHeader.Date~") COLUMN(NAME=~"ServiceTemplateHeader.UserCode~") COLUMN(NAME=~"ServiceTemplateDetail.ServiceCode~") COLUMN(NAME=~"ServiceTemplateDetail.Qty~") COLUMN(NAME=~"ServiceTemplateDetail.SalePrice~") COLUMN(NAME=~"ServiceTemplateDetail.DiscPerc~") COLUMN(NAME=~"ServiceTemplateDetail.SManCode~") COLUMN(NAME=~"ServiceTemplateDetail.ServiceFlatDisc~") COLUMN(NAME=~"ServiceTemplateDetail.Commission~")    JOIN (LEFT=~"ServiceTemplateHeader.ServiceTemplateCode~"    OP =~"=~"RIGHT=~"ServiceTemplateDetail.ServiceTemplateCode~" )WHERE(    EXP1 =~"ServiceTemplateDetail.ServiceTemplateCode~"   OP =~"=~"    EXP2 =~":ai_code~" ) ) ARG(NAME = ~"ai_code~" TYPE = number) "
  arguments=(("ai_code", number))
)
