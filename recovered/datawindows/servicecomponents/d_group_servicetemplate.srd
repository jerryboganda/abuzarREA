datawindow ( units=0 timer_interval=0 processing=1 color=80269524 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="ServiceTemplateHeader.ServiceTemplateCode"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="ServiceTemplateDetail.ServiceCode"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="ServiceTemplateDetail.Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="ServiceTemplateDetail.SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="ServiceTemplateDetail.ServiceFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="ServiceTemplateDetail.DiscPerc"  )
column=(type=long updatewhereclause=yes name=smancode dbname="ServiceTemplateDetail.SManCode"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="ServiceTemplateDetail.RowID"  )
 retrieve="SELECT 
	H.ServiceTemplateCode, 
	D.ServiceCode, 
	ServiceName = S.Name,
	D.Qty, 
	D.SalePrice, 
	D.ServiceFlatDisc,
	D.DiscPerc, 
	D.SManCode, 
	D.RowID
FROM 
	ServiceTemplateHeader H, ServiceTemplateDetail D, Service S
WHERE 
	H.ServiceTemplateCode IN 
		(SELECT DefaultServiceTemplateCode FROM Groups WHERE GroupCode = :ai_groupcode) AND
	H.ServiceTemplateCode = D.ServiceTemplateCode AND
	D.ServiceCode = S.ServiceCode
ORDER BY D.RowID"
  arguments=(("ai_groupcode", number))
)
