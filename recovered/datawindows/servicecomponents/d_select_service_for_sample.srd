release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(1) updatewhereclause=yes name=selected dbname="Selected" 
 values="	Y/	N"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="ServiceCode"  )
column=(type=long identity=yes updatewhereclause=yes name=srvrowid dbname="SrvRowID"  )
column=(type=char(78) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=datetime updatewhereclause=yes name=deliverydate dbname="DeliveryDate"  )
column=(type=char(1) updatewhereclause=yes name=status dbname="Status" 
 values="	Y/	N"  )
 retrieve="SELECT 
	Selected='N',
	ServiceCode=SD.ServiceCode, 
	SrvRowID=SD.SrvRowID,
	ServiceName= LTRIM(RTRIM(SV.Name)) + ' (' + LTRIM(RTRIM(CAST(SD.SrvRowID AS VARCHAR(15)))) + ')',
	DeliveryDate=SD.DeliveryDate,
	Status = CASE WHEN (SELECT MAX(ServiceRowId) FROM SampleDetail SMD WHERE SMD.ServiceRowID = SD.SrvRowID) > 0 THEN 'Y' ELSE 'N' END
FROM 
	ServiceHeader SH,
	ServiceDetail SD,
	Service SV
WHERE
	SH.ServiceInvCode = :ai_serviceinvcode AND
	SH.ServiceInvCode = SD.ServiceInvCode AND
	SH.Posted = 'Y' AND
	SD.ServiceCode = SV.ServiceCode AND
	SV.ResultRequired='Y'
ORDER BY
	ServiceName,
	SD.SrvRowID"
  arguments=(("ai_serviceinvcode", number))
)
