release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=serviceinvcode dbname="Samples.ServiceInvCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Samples.SampleCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=sampledate dbname="Samples.SampleDate"  )
column=(type=char(1) update=yes updatewhereclause=yes name=processed dbname="Samples.Processed"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="Samples.Posted"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="Samples.UserCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="Samples.PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="Samples.PostedBY" 
 values=""  )
column=(type=char(113) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(1) updatewhereclause=yes name=finalized dbname="Samples.Finalized"  )
 retrieve="SELECT 
	Samples.ServiceInvCode, 
	Samples.SampleCode, 
	Samples.SampleDate,   
	Samples.Processed,   
	Samples.Posted,   
	Samples.UserCode,   
	Samples.PostDate,   
	Samples.PostedBY, 
	Patient=
		(SELECT P.Name + ' ('  + P.RegNo + ')' 
		FROM Patient P, ServiceHeader H
		WHERE H.ServiceInvCode = Samples.ServiceInvCode AND 
			ISNULL(H.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=H.AdmissionCode)) = P.PatientCode), 
	Samples.Finalized  
FROM 
	Samples

"
  update="Samples" updatewhere=1 updatekeyinplace=no
 )
