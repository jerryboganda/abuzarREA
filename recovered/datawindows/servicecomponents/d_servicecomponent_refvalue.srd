 values=""  )
column=(type=long key=yes update=yes updatewhereclause=yes initial="1" name=loweragelimit dbname="ServiceComponentRefValue.LowerAgeLimit"  )
column=(type=long key=yes update=yes updatewhereclause=yes initial="1" name=upperagelimit dbname="ServiceComponentRefValue.UpperAgeLimit"  )
column=(type=char(100) update=yes updatewhereclause=yes name=lowerreferencevalue dbname="ServiceComponentRefValue.LowerReferenceValue"  )
column=(type=char(100) update=yes updatewhereclause=yes name=upperreferencevalue dbname="ServiceComponentRefValue.UpperReferenceValue"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=lowerreferencevalue2 dbname="LowerReferenceValue2"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=upperreferencevalue2 dbname="UpperReferenceValue2"  )
 retrieve="SELECT 
	ServiceComponentCode,
	RowID,
	Gender,
	AgeUnit,
	GestationCode,
	TestMachineCode,
	LowerAgeLimit,
	UpperAgeLimit,
	LowerReferenceValue,
	UpperReferenceValue,
	LowerReferenceValue2=00000000.0000,
	UpperReferenceValue2=00000000.0000
FROM
	ServiceComponentRefValue
WHERE 
	ServiceComponentCode = :ai_code
ORDER BY RowID"
  update="ServiceComponentRefValue" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
