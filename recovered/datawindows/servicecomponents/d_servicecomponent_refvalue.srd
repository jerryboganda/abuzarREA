column=(type=char(1) key=yes update=yes updatewhereclause=yes initial="M" name=gender dbname="ServiceComponentRefValue.Gender" 
 values="Male	M/FeMale	F/"  )
column=(type=char(1) key=yes update=yes updatewhereclause=yes initial="Y" name=ageunit dbname="ServiceComponentRefValue.AgeUnit" 
 values="Year	Y/Month	M/Day	D/"  )
