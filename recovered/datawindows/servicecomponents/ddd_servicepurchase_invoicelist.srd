header(height=68 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Service.name"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="ServicePurDetail.servicecode"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="ServicePurDetail.qty"  )
column=(type=decimal(2) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="ServicePurDetail.price"  )
column=(type=char(1) updatewhereclause=yes name=allowsaleindecimal dbname="AllowSaleInDecimal"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="ServicePurDetail.ServiceFlatDisc"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="ServicePurDetail.rowid"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="ServicePurDetail.DiscPerc"  )
 retrieve="SELECT 
	fullcode=service.aliasname,
	service.name,
	SVCD.servicecode,
	SVCD.qty,
	ReturnQty = ( Select IsNull(Sum(d.qty),0 ) 
			From   ServicePRHeader h ,ServicePRDetail d
			Where  h.servicepurinvcode = :ai_servicepurinvcode AND 
					 h.serviceprinvcode = d.serviceprinvcode AND
					 d.servicecode = SVCD.servicecode AND
					 D.SRVRowID = SVCD.RowID),
	SVCD.price,
	AllowSaleInDecimal=Service.AllowSaleInDecimal,
	SVCD.ServiceFlatDisc,
	SVCD.rowid,
	SVCD.DiscPerc
FROM   
	ServicePurDetail SVCD,	Service
WHERE  
	SVCD.servicecode=service.servicecode AND
	SVCD.servicepurinvcode=:ai_servicepurinvcode
"
  arguments=(("ai_servicepurinvcode", number))
)
