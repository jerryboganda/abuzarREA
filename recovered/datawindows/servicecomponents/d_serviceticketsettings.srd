table(column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter no. of ticket to be generated'" initial="1" name=ticketstogenerate dbname="TicketsToGenerate"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter ticket interval (in days) between generated tickets'" initial="1" name=ticketintervalindays dbname="TicketIntervalInDays"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter expiry days for each generated tickets'" initial="1" name=ticketexpiryindays dbname="TicketExpiryInDays"  )
 retrieve="SELECT 
	TicketsToGenerate = :ai_tickets,   
	TicketIntervalInDays  = :ai_interval,   
	TicketExpiryInDays = :ai_expiry 
"
  arguments=(("ai_tickets", number), ("ai_interval", number), ("ai_expiry", number))
)
