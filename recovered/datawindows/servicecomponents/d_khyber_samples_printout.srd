header(height=2479 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=code dbname="SampleCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=sampledate dbname="SampleDate"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=servicedate dbname="ServiceDate"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=datetime updatewhereclause=yes name=dob dbname="DOB"  )
column=(type=long updatewhereclause=yes initial="0" name=ageyears dbname="AgeYears"  )
column=(type=long updatewhereclause=yes initial="0" name=agemonths dbname="AgeMonths"  )
column=(type=long updatewhereclause=yes initial="0" name=agedays dbname="AgeDays"  )
column=(type=char(1) updatewhereclause=yes initial="M" name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=long updatewhereclause=yes name=locationcode dbname="LocationCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=char(1000) update=yes updatewhereclause=yes name=comments dbname="Comments"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=processed dbname="Processed" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=posted dbname="Posted"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=postdate dbname="PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="PostedBY"  )
column=(type=datetime update=yes updatewhereclause=yes name=processeddate dbname="ProcessedDate"  )
column=(type=long update=yes updatewhereclause=yes name=processedby dbname="ProcessedBy"  )
column=(type=char(1) update=yes updatewhereclause=yes name=finalized dbname="Finalized"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=long updatewhereclause=yes name=sampletypecode dbname="SampleTypeCode"  )
column=(type=char(100) updatewhereclause=yes name=sampetype dbname="SampeType"  )
column=(type=char(100) updatewhereclause=yes name=color dbname="Color"  )
column=(type=decimal(5) updatewhereclause=yes name=volume dbname="Volume"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
 retrieve="SELECT 
	SampleCode=S.SampleCode,
	SampleDate=S.SampleDate,
	ServiceInvCode = S.ServiceInvCode,
	ServiceDate = SH.Date,
	PatientRegNo= 
		(SELECT P.RegNo 
		FROM Patient P 
		WHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),
	PatientCode = 
		(SELECT P.PatientCode 
		FROM Patient P 
		WHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),
	AdmissionCode= SH.AdmissionCode,
	DOB=(SELECT P.DOB 
		FROM Patient P 
		WHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),
	AgeYears = (SELECT DATEDIFF(yyyy, P.DOB, GETDATE()) FROM Patient P WHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),
	AgeMonths = (SELECT (DATEDIFF(dd, P.DOB, GETDATE()) % 360) / 30 FROM Patient P WHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),
	AgeDays = (SELECT (DATEDIFF(dd, P.DOB, GETDATE()) % 360) % 30 FROM Patient P WHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),
	Gender= (SELECT P.Gender FROM Patient P WHERE P.PatientCode = ISNULL(SH.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode=SH.AdmissionCode))),
	LocationCode= (SELECT PA.LocationCode
		FROM PatientAdmission PA 
		WHERE SH.AdmissionCode = PA.AdmissionCode),
	UserCode=S.UserCode,
	Comments=S.Comments,
	Processed=S.Processed,
	Posted=S.Posted,
	PostDate=S.PostDate,
	PostedBY=S.PostedBY,
	ProcessedDate=S.ProcessedDate,
	ProcessedBy=S.ProcessedBy,
	Finalized=S.Finalized,
	ServiceName = (SELECT SV.Name FROM Service SV WHERE SV.ServiceCode IN (SELECT SVD.ServiceCode FROM ServiceDetail SVD WHERE SVD.SrvRowID = SD.ServiceRowID) ),
	SampleTypeCode=SD.SampleTypeCode,
	SampeType = ST.Name,
	Color = SD.Color,
	Volume = SD.Volume,
	Remarks = SD.Remarks
FROM 
	Samples S, sampledetail SD, ServiceHeader SH, SampleType ST
WHERE 
	S.SampleCode = :ai_code AND
	S.SampleCode = SD.SampleCode AND
	S.ServiceInvCode = SH.ServiceInvCode AND
	ST.SampleTypeCode = SD.SampleTypeCode
ORDER BY
	S.SampleCode,
	ST.Name,
	SD.RowID
"
  arguments=(("ai_code", number))
)
