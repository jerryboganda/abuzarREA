header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=samplecode dbname="SampleCode"  )
column=(type=long update=yes updatewhereclause=yes name=sampletypecode dbname="SampleTypeCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=sampledate dbname="SampleDate"  )
column=(type=long update=yes updatewhereclause=yes name=servicerowid dbname="ServiceRowID"  )
 retrieve="SELECT 
	SampleCode=NULL,   
	SampleTypeCode=NULL,   
	SampleDate=NULL,   
	ServiceRowID=NULL
UNION ALL
SELECT 
	Samples.SampleCode,   
	SampleDetail.SampleTypeCode,   
	Samples.SampleDate,   
	SampleDetail.ServiceRowID
FROM
	Samples, SampleDetail
WHERE 
	Samples.Processed = 'Y' AND Posted='Y' AND Finalized='N' AND Samples.SampleCode = SampleDetail.SampleCode
ORDER BY
	SampleCode
"
 )
