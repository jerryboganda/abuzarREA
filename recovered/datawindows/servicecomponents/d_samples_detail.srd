detail(height=672 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Samples.SampleCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=sampledate dbname="Samples.SampleDate"  )
column=(type=long update=yes updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=servicedate dbname="ServiceDate"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=datetime updatewhereclause=yes name=dob dbname="DOB"  )
column=(type=long updatewhereclause=yes initial="0" name=ageyears dbname="AgeYears"  )
column=(type=long updatewhereclause=yes initial="0" name=agemonths dbname="AgeMonths"  )
column=(type=long updatewhereclause=yes initial="0" name=agedays dbname="AgeDays"  )
column=(type=char(1) updatewhereclause=yes initial="M" name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=long updatewhereclause=yes name=locationcode dbname="LocationCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="Samples.UserCode" 
 values=""  )
column=(type=char(1000) update=yes updatewhereclause=yes name=comments dbname="Samples.Comments"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=processed dbname="Samples.Processed" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=posted dbname="Samples.Posted"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=postdate dbname="Samples.PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="Samples.PostedBY"  )
column=(type=datetime update=yes updatewhereclause=yes name=processeddate dbname="Samples.ProcessedDate"  )
column=(type=long update=yes updatewhereclause=yes name=processedby dbname="Samples.ProcessedBy"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=finalized dbname="Samples.Finalized"  )
 retrieve="SELECT 
	Samples.SampleCode,   
	Samples.SampleDate,   
	ServiceInvCode = Samples.ServiceInvCode,
	ServiceDate = (SELECT SH.Date FROM ServiceHeader SH WHERE SH.ServiceInvCode = Samples.ServiceInvCode),
	PatientRegNo= (SELECT P.RegNo FROM ServiceHeader SH, Patient P WHERE SH.ServiceInvCode = Samples.ServiceInvCode AND SH.PatientCode = P.PatientCode),
	PatientCode = (SELECT SH.PatientCode FROM ServiceHeader SH WHERE SH.ServiceInvCode = Samples.ServiceInvCode),
	AdmissionCode= (SELECT SH.AdmissionCode FROM ServiceHeader SH WHERE SH.ServiceInvCode = Samples.ServiceInvCode),
	DOB= (SELECT P.DOB FROM ServiceHeader SH, Patient P WHERE SH.ServiceInvCode = Samples.ServiceInvCode AND SH.PatientCode = P.PatientCode),
	AgeYears = 0,
	AgeMonths = 0,
	AgeDays = 0,
	Gender= (SELECT P.Gender FROM ServiceHeader SH, Patient P WHERE SH.ServiceInvCode = Samples.ServiceInvCode AND SH.PatientCode = P.PatientCode),
	LocationCode= 0,
	Samples.UserCode,
	Samples.Comments,
	Samples.Processed,
	Samples.Posted,
	Samples.PostDate,
	Samples.PostedBY,
	Samples.ProcessedDate,
	Samples.ProcessedBy,
	Samples.Finalized
FROM 
	Samples  
WHERE 
	Samples.SampleCode = :ai_code    
"
  update="Samples" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
