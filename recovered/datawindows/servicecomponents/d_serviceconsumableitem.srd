detail(height=70 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=servicecode dbname="ServiceConsumableItem.ServiceCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ServiceConsumableItem.ICode" 
 values=""  )
column=(type=long updatewhereclause=yes name=rowid dbname="ServiceConsumableItem.ROWID"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" initial="1" name=qty dbname="ServiceConsumableItem.Qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid processing charges~"" initial="0" name=processcharge dbname="ServiceConsumableItem.ProcessCharge"  )
 retrieve="SELECT 
	ServiceConsumableItem.ServiceCode,   
	ServiceConsumableItem.ICode,   
	ServiceConsumableItem.ROWID,
	ServiceConsumableItem.Qty,
	ServiceConsumableItem.ProcessCharge
FROM 
	ServiceConsumableItem
WHERE 
	ServiceConsumableItem.ServiceCode = :ai_code
ORDER BY
	ServiceConsumableItem.ROWID"
  update="ServiceConsumableItem" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
