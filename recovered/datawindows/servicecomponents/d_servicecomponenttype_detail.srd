table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceComponentType.ServiceComponentTypeCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="ServiceComponentType.Name"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=askunit dbname="ServiceComponentType.AskUnit" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=askrefrange dbname="ServiceComponentType.AskRefRange" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=askoptions dbname="ServiceComponentType.AskOptions" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=askcutoff dbname="ServiceComponentType.AskCutOff" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=askcomments dbname="ServiceComponentType.AskComments" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	ServiceComponentType.ServiceComponentTypeCode,   
	ServiceComponentType.Name,
	ServiceComponentType.AskUnit,
	ServiceComponentType.AskRefRange,
	ServiceComponentType.AskOptions,
	ServiceComponentType.AskCutOff,
	ServiceComponentType.AskComments
FROM 
	ServiceComponentType  
WHERE 
	ServiceComponentType.ServiceComponentTypeCode = :ai_code   
"
  update="ServiceComponentType" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
