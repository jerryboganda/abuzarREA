table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Service.ServiceCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Service.Name"  )
column=(type=char(60) update=yes updatewhereclause=yes name=aliasname dbname="Service.AliasName"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="'Please enter valid service Price'" initial="0" name=price dbname="Service.Price"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=servicecatcode dbname="Service.ServiceCatCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="'Please enter valid service commission'" initial="0" name=commission dbname="Service.Commission"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=description dbname="Service.Description"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="'Please enter valid service cost'" initial="0" name=costprice dbname="Service.CostPrice"  )
column=(type=long update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="'Please enter valid days'" initial="0" name=processdays dbname="Service.ProcessDays"  )
column=(type=long update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0 AND Real ( GetText() ) <= 24" validationmsg="'Please enter valid hours [0-23]'" initial="0" name=processhours dbname="Service.ProcessHours"  )
column=(type=long update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0 AND Real ( GetText() ) <= 60" validationmsg="'Please enter valid minutes [0-59]'" initial="0" name=processmin dbname="Service.ProcessMin"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=resultrequired dbname="Service.ResultRequired" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=printonnewpage dbname="Service.PrintOnNewPage" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=serviceresulttemplate dbname="Service.ServiceResultTemplate"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=printable dbname="Service.Printable" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=ticketrequired dbname="Service.TicketRequired" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=servicepricepolicycode dbname="Service.ServicePricePolicyCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=serviceresultstylecode dbname="Service.ServiceResultStyleCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="'Please enter valid service flat discount'" initial="0" name=serviceflatdisc dbname="Service.ServiceFlatDisc"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=allowsaleindecimal dbname="Service.AllowSaleInDecimal" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=servicetypecode dbname="Service.ServiceTypeCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=lockprice dbname="Service.LockPrice" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=lockdiscperc dbname="Service.LockDiscPerc" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=lockserviceflatdisc dbname="Service.LockServiceFlatDisc" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" initial="0" name=serviceflattax dbname="Service.ServiceFlatTax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0 AND Real ( GetText() ) <= 100" initial="0" name=servicegstperc dbname="Service.ServiceGSTPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0 AND Real ( GetText() ) <= 100" validationmsg="'Please enter valid share percentage'" initial="0" name=shareperc dbname="Service.SharePerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="'Please enter valid additional charges'" initial="0" name=additionalcharges dbname="Service.AdditionalCharges"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=active dbname="Service.Active" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="'Please enter valid minimum service Price'" initial="0" name=minprice dbname="Service.MinPrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="'Please enter valid maximum service Price'" initial="0" name=maxprice dbname="Service.MaxPrice"  )
column=(type=long update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="'Please enter valid no. of tickets to generate'" initial="1" name=ticketstogenerate dbname="Service.TicketsToGenerate"  )
column=(type=long update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="'Please enter inerval for each ticket'" initial="1" name=ticketintervalindays dbname="Service.TicketIntervalInDays"  )
column=(type=long update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" validationmsg="'Please enter valid ticket expiry days'" initial="1" name=ticketexpiryindays dbname="Service.TicketExpiryInDays"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=tokenable dbname="Service.Tokenable" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	Service.ServiceCode,   
	Service.Name,   
	Service.AliasName,
	Service.Price, 
	Service.ServiceCatCode,
	Service.Commission,
	Service.Description,
	Service.CostPrice,
	Service.ProcessDays,
	Service.ProcessHours,
	Service.ProcessMin,
	Service.ResultRequired,
	Service.PrintOnNewPage,
	Service.ServiceResultTemplate,
	Service.Printable,
	Service.TicketRequired,
	Service.ServicePricePolicyCode,
	Service.ServiceResultStyleCode,
	Service.ServiceFlatDisc,
	Service.AllowSaleInDecimal,
	Service.ServiceTypeCode,
	Service.LockPrice,
	Service.LockDiscPerc,
	Service.LockServiceFlatDisc,
	Service.ServiceFlatTax,
	Service.ServiceGSTPerc,
	Service.SharePerc,
	Service.AdditionalCharges,
	Service.Active,
	Service.MinPrice,
	Service.MaxPrice,
	Service.TicketsToGenerate,
	Service.TicketIntervalInDays,
	Service.TicketExpiryInDays,
	Service.Tokenable
FROM 
	Service   
Where 
	Service.ServiceCode = :ar_sCode"
  update="Service" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_sCode", number))
)
