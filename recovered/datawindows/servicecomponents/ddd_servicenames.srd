table(column=(type=long updatewhereclause=yes name=icode dbname="Service.servicecode"  )
column=(type=char(60) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Service.name"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(5) updatewhereclause=yes name=costprice dbname="Service.costprice"  )
column=(type=char(0) updatewhereclause=yes name=location dbname="location"  )
column=(type=char(0) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes name=servicecatcode dbname="Service.ServiceCatCode" 
 values=""  )
 retrieve="SELECT 
	dbo.service.servicecode,
	fullcode =dbo.service.aliasname,
	dbo.service.name,
	saleprice=
		CASE 
		WHEN (SELECT PrefValue FROM SoftwarePreferences WHERE Name='FetchServicePriceFromPricePolicy')='N' THEN dbo.service.price
		ELSE
			(SELECT ISNULL(D.Price, dbo.Service.Price)
			FROM ServicePricePolicyDetail D
			WHERE 
				D.ServicePricePolicyCode IN 
					(SELECT MAX(ServicePricePolicyCode) 
					FROM ServicePricePolicy 
					WHERE GetDate() BETWEEN StartDate AND EndDate AND ServiceCode = Service.ServiceCode) AND
				D.WeekDayCode = DatePart(dw, GetDate()))
		END,
	dbo.service.costprice,
	location='',
	packingdesc='',
	dbo.service.ServiceCatCode

FROM dbo.service, dbo.servicecategory
WHERE
	dbo.service.active = 'Y' AND
	dbo.service.ServiceCatCode = dbo.servicecategory.ServiceCatCode
ORDER BY dbo.service.name
"
 )
