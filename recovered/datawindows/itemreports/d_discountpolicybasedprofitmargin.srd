table(column=(type=char(60) updatewhereclause=yes name=policyname dbname="PolicyName"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=qtylimit dbname="QtyLimit"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="ItemFlatDisc"  )
column=(type=datetime updatewhereclause=yes name=expirydate dbname="ExpiryDate"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="AvgPrice"  )
column=(type=decimal(17) updatewhereclause=yes name=profit dbname="Profit"  )
column=(type=decimal(6) updatewhereclause=yes name=profitperc dbname="ProfitPerc"  )
 retrieve="SELECT
	PolicyName=T.Name,
	Code=T.Code,
	QtyLimit=T.QtyLimit,
	DiscPerc=T.DiscPerc,
	ItemFlatDisc=T.ItemFlatDisc,
	ExpiryDate=T.ExpiryDate,
	ICode = I.ICode,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	SalePrice = ROUND(I.SalePrice / CASE WHEN I.PackUnits = 0 OR I.PackUnits IS NULL THEN 1 ELSE I.PackUnits END, 2),
	AvgPrice = I.AvgPrice,
	Profit = ((ROUND(I.SalePrice / CASE WHEN I.PackUnits = 0 OR I.PackUnits IS NULL THEN 1 ELSE I.PackUnits END, 2) - I.AvgPrice) - T.ItemFlatDisc) * (1 - T.DiscPerc * 0.01),
	ProfitPerc = (((ROUND(I.SalePrice / CASE WHEN I.PackUnits = 0 OR I.PackUnits IS NULL THEN 1 ELSE I.PackUnits END, 2) - I.AvgPrice) - T.ItemFlatDisc) * (1 - T.DiscPerc * 0.01) / CASE WHEN ROUND(I.SalePrice / CASE WHEN I.PackUnits = 0 OR I.PackUnits IS NULL THEN 1 ELSE I.PackUnits END, 2) IS NULL OR ROUND(I.SalePrice / CASE WHEN I.PackUnits = 0 OR I.PackUnits IS NULL THEN 1 ELSE I.PackUnits END, 2) = 0 THEN 1 ELSE ROUND(I.SalePrice / CASE WHEN I.PackUnits = 0 OR I.PackUnits IS NULL THEN 1 ELSE I.PackUnits END, 2) END) * 100
FROM
	Item I,
	(SELECT 
		Name = (SELECT D.Name FROM DiscountPolicy D WHERE D.DiscountPolicyCode=DD.DiscountPolicyCode),
		Code=DD.DiscountPolicyCode,   
		QtyLimit=DD.QtyLimit,   
		DiscPerc=DD.DiscPerc,
		ItemFlatDisc=DD.ItemFlatDisc,
		ExpiryDate=DD.ExpiryDate
	FROM 
		DiscountPolicyDetail DD
	WHERE DD.DiscountPolicyCode = :ai_discountpolicycode) T
WHERE 
	I.DiscountPolicyCode = T.Code
"
  arguments=(("ai_discountpolicycode", number))
 sort="policyname A, itemname A, qtylimit A"
)
