detail(height=1718 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(2) updatewhereclause=yes name=marketprice dbname="marketprice"  )
column=(type=char(19) updatewhereclause=yes name=storeprice dbname="storeprice"  )
 retrieve="SELECT itemname=item.name,
			marketprice=item.saleprice2, 
			storeprice='RS' +'  '+ Convert(varchar(15),saleprice )
FROM
		Item
WHERE Icode IN (:aa_icode)"
  arguments=(("aa_icode", numberlist))
)
