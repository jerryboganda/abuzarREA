release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1468 color="536870912" )
summary(height=270 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=decimal(13) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(60) updatewhereclause=yes name=saleperson dbname="SalePerson"  )
column=(type=decimal(4) updatewhereclause=yes name=qtysold dbname="QtySold"  )
column=(type=decimal(4) updatewhereclause=yes name=bonussold dbname="BonusSold"  )
column=(type=decimal(4) updatewhereclause=yes name=qtyreturned dbname="QtyReturned"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusreturned dbname="BonusReturned"  )
 retrieve="SELECT 
	AliasName=(SELECT I.CustomICode FROM ITEM I WHERE I.ICODE = :ai_ICode), 
	Item=(SELECT I.Name FROM ITEM I WHERE I.ICODE = :ai_ICode),
	Rate = (SELECT ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2) FROM ITEM I WHERE I.ICODE = :ai_ICode),
	Packing=(SELECT I.PackingDesc FROM ITEM I WHERE I.ICODE = :ai_ICode),
	SalePerson=SM.Name,
	QtySold = ISNULL(SUM(QTYSOLD), 0),
	BonusSold = ISNULL(SUM(BONUSSOLD), 0),  
	QtyReturned = ISNULL(SUM(QTYReturned), 0),
	BonusReturned = ISNULL(SUM(BONUSReturned), 0)
FROM 
	Salesman SM
	LEFT OUTER JOIN
	(SELECT
		SMANCODE=SL.SMANCODE,
		InvCode=SL.SaleInvCode,
		ICode=SD.ICode, 
		QtySold=SUM(SD.LooseQty),
		BonusSold=SUM(SD.BonusQty),
		QtyReturned=0,
		BonusReturned=0
	FROM
		SaleLedger SL, SaleDetail SD
	WHERE
		SL.Date BETWEEN :ad_StartDate AND :ad_EndDate AND
		SD.ICode = :ai_ICode AND
		SL.SMANCODE IN (:ai_SManCode) AND
		SL.SaleInvCode = SD.SaleInvCode
	GROUP BY
		SL.SaleInvCode,
		SL.SManCode,
		SD.ICode
	UNION ALL
	SELECT
		SMANCODE=SL.SMANCODE,
		InvCode=SL.SaleInvCode,
		ICode=SD.ICode, 
		QtySold=SUM(SD.LooseQty),
		BonusSold=SUM(SD.BonusQty),
		QtyReturned=0,
		BonusReturned=0
	FROM
		SaleLedger SL, SaleInvDetail SD
	WHERE
		SL.ImpactInventory = 'N' AND
		SL.Date BETWEEN :ad_StartDate AND :ad_EndDate AND
		SD.ICode = :ai_ICode AND
		SL.SMANCODE IN (:ai_SManCode) AND
		SL.SaleInvCode = SD.SaleInvCode
	GROUP BY
		SL.SaleInvCode,
		SL.SManCode,
		SD.ICode
	UNION ALL
	SELECT
		SMANCODE=SL.SMANCODE,
		InvCode=SL.SRInvCode,
		ICode=SD.ICode, 
		QtySold=0,
		BonusSold=0,
		QtyReturned=SUM(SD.LooseQty),
		BonusReturned=SUM(SD.BonusQty)
	FROM
		SRLedger SL, SRDetail SD
	WHERE
		SL.Date BETWEEN :ad_StartDate AND :ad_EndDate AND
		SD.ICode = :ai_ICode AND
		SL.SMANCODE IN (:ai_SManCode) AND
		SL.SRInvCode = SD.SRInvCode
	GROUP BY
		SL.SRInvCode,
		SL.SMANCODE,
		SD.ICode) S ON (SM.SalesManCode = S.SMANCODE)
WHERE
	SM.SalesManCode IN (:ai_SManCode)
GROUP BY
	SM.Name, S.ICode
ORDER BY
	SalePerson"
  arguments=(("ai_icode", number), ("ai_smancode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="saleperson A, item A, aliasname A, rate A, packing A"
)
