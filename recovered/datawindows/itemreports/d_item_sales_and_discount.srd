release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1010 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=decimal(4) updatewhereclause=yes name=totalsaleqty dbname="TotalSaleQty"  )
column=(type=decimal(16) updatewhereclause=yes name=totalsalevalue dbname="TotalSaleValue"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqtyattp dbname="SaleQtyAtTP"  )
column=(type=decimal(16) updatewhereclause=yes name=salevalueattp dbname="SaleValueAtTP"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqtyatdisc dbname="SaleQtyAtDisc"  )
column=(type=decimal(16) updatewhereclause=yes name=salevalueatdisc dbname="SaleValueAtDisc"  )
column=(type=decimal(6) updatewhereclause=yes name=discvalue dbname="DiscValue"  )
 retrieve="SELECT
	AliasName=I.CustomICode,
	ItemName=I.Name,
	SalePrice = ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),
	Packing=I.PackingDesc,
	GroupCode=
		CASE :as_reportgrouping
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END,
	GroupName= 
		CASE :as_reportgrouping 
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,   
	TotalSaleQty = SUM(S.LooseQty + S.BonusQty),
	TotalSaleValue = Round(SUM(S.LooseQty * ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2) ), 2),
	SaleQtyAtTP= SUM(CASE S.ItemFlatDisc + S.DiscPerc + S.InvDiscPerc + (S.TP - S.SalePrice)
		WHEN 0 THEN S.LooseQty + S.BonusQty ELSE 0 END),
	SaleValueAtTP= Round(SUM(CASE S.ItemFlatDisc + S.DiscPerc + S.InvDiscPerc + (S.TP - S.SalePrice)
		WHEN 0 THEN (S.LooseQty * ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) ELSE 0 END), 2),
	SaleQtyAtDisc= SUM(CASE S.ItemFlatDisc + S.DiscPerc + S.InvDiscPerc + (S.TP - S.SalePrice)
		WHEN 0 THEN 0 ELSE S.LooseQty + S.BonusQty END),
	SaleValueAtDisc= Round(SUM(CASE S.ItemFlatDisc + S.DiscPerc + S.InvDiscPerc + (S.TP - S.SalePrice)
		WHEN 0 THEN 0 ELSE (S.LooseQty * ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) END), 2),
	DiscValue= Round(SUM((S.ItemFlatDisc * S.LooseQty) + 
		(S.LooseQty * (S.SalePrice - S.ItemFlatDisc) * S.DiscPerc * 0.01) +
		(S.LooseQty * (S.SalePrice - S.ItemFlatDisc) * (1 - S.DiscPerc * 0.01) * S.InvDiscPerc * 0.01) + 
		CASE S.TP - S.SalePrice WHEN 0 THEN 0 ELSE (S.TP - S.SalePrice) * S.LooseQty END), 2)

FROM
	Item I,
	(SELECT 
		D.ICode,
		D.LooseQty,
		D.BonusQty,
		D.ItemFlatDisc,
		D.DiscPerc,
		D.SalePrice,
		TP = Round(D.PackPrice / CASE D.PackUnits WHEN 0 THEN 1 ELSE D.PackUnits END, 2),
		InvDiscPerc=S.DiscPerc
	FROM
		SaleLedger S, SaleDetail D, Item I
	WHERE
		:as_saletype IN (1,2) AND
		S.SaleInvCode = D.SaleInvCode AND
		S.Posted = 'Y' AND
		S.Date >= :ad_startdate AND S.DATE <= :ad_enddate AND
		D.ICode = I.ICode AND
		CASE :as_reportgrouping
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END IN (:ai_groupcode)
	UNION ALL
	SELECT 
		D.ICode,
		D.LooseQty,
		D.BonusQty,
		D.ItemFlatDisc,
		D.DiscPerc,
		D.SalePrice,
		TP = Round(D.PackPrice / CASE D.PackUnits WHEN 0 THEN 1 ELSE D.PackUnits END, 2),
		InvDiscPerc=S.DiscPerc
	FROM
		SaleLedger S, SaleInvDetail D, Item I
	WHERE
		:as_saletype IN (1,3) AND
		S.impactinventory = 'N' AND
		S.SaleInvCode = D.SaleInvCode AND
		S.Posted = 'Y' AND
		S.Date >= :ad_startdate AND S.DATE <= :ad_enddate AND
		D.ICode = I.ICode AND
		CASE :as_reportgrouping
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END IN (:ai_groupcode)) S
WHERE 
	I.ICode = S.ICode AND
		CASE :as_reportgrouping
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END IN (:ai_groupcode)
GROUP BY
	I.Name,
	I.CustomICode,
	I.SalePrice,
	I.PackUnits,
	I.PackingDesc,
	I.ManfCode,
	I.ICatCode,
	I.ICCode,
	I.Packcode
ORDER BY
	GroupName,
	ItemName,
	AliasName"
  arguments=(("as_reportgrouping", string), ("ai_groupcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime), ("as_saletype", number))
)
