table(column=(type=char(60) updatewhereclause=yes name=zone dbname="Zone"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="ItemAliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(12) updatewhereclause=yes name=customeraliasname dbname="CustomerAliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=char(1) updatewhereclause=yes name=show dbname="SHOW"  )
 retrieve="SELECT
	Zone = (SELECT Z.Name FROM Zone Z WHERE Z.ZoneCode=:ai_zonecode),
	ICode=I.ICode,
	ItemAliasName = I.CustomICode,
	ItemName = I.Name,
	Area = (SELECT AR.Name FROM Area AR, Customer C WHERE A.AccCode = C.CustCode AND C.AreaCode = AR.AreaCode),
	CustCode = A.AccCode,
	CustomerAliasName = A.AliasName,
	CustomerName = A.Name,
	Qty = SUM(S.QTY), 
	Amount = SUM(S.Amount), 
	SHOW='N' 
FROM
	Item I,
	Accounts A,
	(SELECT
		SL.CustCode,
		SD.ICode,
		Qty = SUM(LooseQty),
		Amount = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))
	FROM SaleLedger SL, SaleDetail SD, Customer C, 	
		(SELECT Area.AreaCode FROM Area WHERE Area.AreaCode IN (SELECT AreaCode FROM ZoneAreas WHERE ZoneCode=:ai_zonecode)) A
	WHERE
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode IN (SELECT ICode FROM Zone Z, Item IT WHERE Z.ZoneCode = :ai_zonecode AND Z.ManfCode = IT.ManfCode) AND
		SL.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SL.CustCode = C.CustCode AND
		C.AreaCode = A.AreaCode
	GROUP BY
		SL.CustCode,
		SD.ICode
	UNION ALL
	SELECT
		SL.CustCode,
		SD.ICode,
		Qty = - SUM(LooseQty),
		Amount = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))
	FROM SRLedger SL, SRDetail SD, Customer C, 	
		(SELECT Area.AreaCode FROM Area WHERE Area.AreaCode IN (SELECT AreaCode FROM ZoneAreas WHERE ZoneCode=:ai_zonecode)) A
	WHERE
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode IN (SELECT ICode FROM Zone Z, Item IT WHERE Z.ZoneCode = :ai_zonecode AND Z.ManfCode = IT.ManfCode) AND
		SL.Date >= :ad_startdate AND SL.Date <= :ad_enddate AND
		SL.CustCode = C.CustCode AND
		C.AreaCode = A.AreaCode
	GROUP BY
		SL.CustCode,
		SD.ICode) S
WHERE
	S.CustCode = A.AccCode AND
	S.ICode = I.ICode
GROUP BY
	I.ICode,
	I.CustomICode,
	I.Name,
	A.AccCode,
	A.AliasName,
	A.Name
ORDER BY
	ItemName,
	Qty DESC
"
  arguments=(("ai_zonecode", number), ("ad_startdate", datetime), ("ad_enddate", datetime), ("al_top_n_customer", number))
 sort="itemname A, qty D"
 filter=" show = 'Y'"
 )
