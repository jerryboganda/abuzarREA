detail(height=1020 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=name dbname="Item.name"  )
column=(type=char(85) updatewhereclause=yes name=customicode dbname="customicode"  )
column=(type=char(14) updatewhereclause=yes name=saleprice dbname="saleprice"  )
 retrieve="Select 
	name,
	customicode='Code: ( ' +customicode+' )',
	saleprice='Rs: ' +convert(varchar(10),cast(saleprice as int))
from item
where icode in (:aa_icode)
order by name"
  arguments=(("aa_icode", numberlist))
)
