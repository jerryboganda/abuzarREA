table(column=(type=char(13) updatewhereclause=yes name=doctype dbname="Doctype"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleLedger.DATE"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type"  )
column=(type=char(12) updatewhereclause=yes name=customeraliasname dbname="CustomerAliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Saledetail.ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="Item.CustomICode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(6) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=decimal(9) updatewhereclause=yes name=cgs dbname="CGS"  )
column=(type=char(60) updatewhereclause=yes name=salepreson dbname="SalePreson"  )
 retrieve="SELECT
	Doctype = 'SV-' + LTRIM(RTRIM(STR(SL.SALEINVCODE, 10))), 
	SL.DATE,
	InvCode=SL.SaleInvCode,
	Type='S',
	CustomerAliasName=A.AliasName,
	Customer=A.Name,
	SD.ICode,
	I.Name,
	I.CustomICode,
	Batch = SD.Batch, 
	Qty=SUM(SD.LooseQty),
	Bonus=SUM(SD.BonusQty),
	NetRate = MAX((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * 
			(1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)) / (SD.LooseQty + SD.BonusQty)),
	CGS=SUM((SD.LooseQty + SD.BonusQty) * SD.AVGPRICE), 
	SalePreson=SM.Name
FROM
	SaleLedger SL, SaleDetail SD, Accounts A, Item I, SalesMan SM,
	(SELECT IT.ICode 	FROM Item IT WHERE :ar_AllItems=0 AND IT.ICode IN (:ar_ICode) 
	UNION 
	SELECT IT.ICode FROM Item IT WHERE :ar_AllItems=1)  T
WHERE
	SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
	SL.CustCode IN (:ar_CustCode) AND
	SL.CustCode = A.AccCode AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SD.ICode = I.ICode AND
	I.ICode = T.ICode AND
	SL.SManCode = SM.SalesManCode
GROUP BY
	SL.DATE,
	SL.SaleInvCode,
	SD.ICode, 
	I.Name, 
	I.CustomICode,
	SD.Batch,
	SD.SalePrice,
	A.AliasName,
	A.Name, 
	SM.Name
UNION ALL
SELECT
	Doctype = 'SV-' + LTRIM(RTRIM(STR(SL.SALEINVCODE, 10))), 
	SL.DATE,
	InvCode=SL.SaleInvCode,
	Type='S',
	CustomerAliasName=A.AliasName,
	Customer=A.Name,
	SD.ICode,
	I.Name,
	I.CustomICode,
	Batch = SD.Batch,
	Qty=SUM(SD.LooseQty),
	Bonus=SUM(SD.BonusQty),
	NetRate = MAX((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * 
			(1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)) / (SD.LooseQty + SD.BonusQty)),
	CGS=SUM((SD.LooseQty + SD.BonusQty) * SD.AVGPRICE), 
	SalePreson=SM.Name
FROM
	SaleLedger SL, SaleInvDetail SD, Accounts A, Item I, SalesMan SM,
	(SELECT IT.ICode 	FROM Item IT WHERE :ar_AllItems=0 AND IT.ICode IN (:ar_ICode) 
	UNION 
	SELECT IT.ICode FROM Item IT WHERE :ar_AllItems=1)  T
WHERE
	SL.ImpactInventory = 'N' AND
	SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
	SL.CustCode IN (:ar_CustCode) AND
	SL.CustCode = A.AccCode AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SD.ICode = I.ICode AND
	I.ICode = T.ICode AND
	SL.SManCode = SM.SalesManCode
GROUP BY
	SL.DATE,
	SL.SaleInvCode,
	SD.ICode, 
	I.Name, 
	I.CustomICode,
	SD.Batch,
	SD.SalePrice,
	A.AliasName,
	A.Name, 
	SM.Name
UNION ALL
SELECT
	Doctype = 'SR-' + LTRIM(RTRIM(STR(SL.SRINVCODE, 10))), 
	SL.DATE,
	InvCode=SL.SRInvCode,
	Type='R',
	CustomerAliasName=A.AliasName,
	Customer=A.Name,
	SD.ICode, 
	I.Name, 
	I.CustomICode, 
	Batch = SD.Batch,
	Qty=-SUM(SD.LooseQty),
	Bonus=-SUM(SD.BonusQty),
	NetRate = MAX((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * .01) * 
			(1 - SL.DiscPerc * .01)) / (SD.LooseQty + SD.BonusQty)),
	CGS=-SUM((SD.LooseQty + SD.BonusQty) * SD.AVGPRICE), 
	SalePreson=SM.Name
FROM
	SRLedger SL
	LEFT OUTER JOIN SalesMan SM ON (SL.SManCode = SM.SalesManCode),
	SRDetail SD, Accounts A, Item I, 
	(SELECT IT.ICode 	FROM Item IT WHERE :ar_AllItems=0 AND IT.ICode IN (:ar_ICode) 
	UNION 
	SELECT IT.ICode FROM Item IT WHERE :ar_AllItems=1)  T
WHERE
	SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
	SL.CustCode IN (:ar_CustCode) AND
	SL.CustCode = A.AccCode AND
	SL.SRInvCode = SD.SRInvCode AND
	SD.ICode = I.ICode AND
	I.ICode = T.ICode

GROUP BY
	SL.DATE,
	SL.SRInvCode,
	SD.ICode, 
	I.Name, 
	I.CustomICode,
	SD.Batch,
	SD.SRPrice,
	A.AliasName,
	A.Name, 
	SM.Name
ORDER BY
	I.Name, 
	I.CustomICode,
	DATE,
	InvCode,
	SD.Batch,
	NetRate,
	A.AliasName,
	A.Name, 
	SM.Name
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ar_CustCode", numberlist), ("ar_AllItems", number), ("ar_icode", numberlist))
)
