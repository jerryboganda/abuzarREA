release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=568 color="536870912" )
summary(height=92 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=value dbname="Value"  )
 retrieve="SELECT
	ICode=T.ICode,
	AliasName=T.AliasName,
	ItemName = T.ItemName,
	Doctor = T.Doctor,
	Qty = SUM(T.Qty),
	Value = SUM(T.Value)
FROM
	(SELECT 
		ICode=I.ICode,
		AliasName=I.CustomICode,
		ItemName = I.Name,
		Doctor = D.Name,
		Qty = SUM(SD.LooseQty + SD.BonusQty),
		Value = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM 
		SaleLedger S,SaleDetail SD, Doctors D, Item I
	WHERE 
		S.ImpactInventory = 'Y' AND
		S.DoctCode IS NOT NULL AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SaleInvCode = SD.SaleInvCode AND 
		SD.ICode IN (:ai_icode) AND
		SD.ICode = I.ICode AND
		S.DoctCode = D.DoctCode
	GROUP BY
		I.ICode,
		I.CustomICode,
		I.Name,
		D.Name
	UNION ALL
	SELECT 
		ICode=I.ICode,
		AliasName=I.CustomICode,
		ItemName = I.Name,
		Doctor = D.Name,
		Qty = SUM(SD.LooseQty + SD.BonusQty),
		Value = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM 
		SaleLedger S,SaleInvDetail SD, Doctors D, Item I
	WHERE 
		S.ImpactInventory = 'N' AND
		S.DoctCode IS NOT NULL AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SaleInvCode = SD.SaleInvCode AND 
		SD.ICode IN (:ai_icode) AND
		SD.ICode = I.ICode AND
		S.DoctCode = D.DoctCode
	GROUP BY
		I.ICode,
		I.CustomICode,
		I.Name,
		D.Name
	UNION ALL
	SELECT 
		ICode=I.ICode,
		AliasName=I.CustomICode,
		ItemName = I.Name,
		Doctor = D.Name,
		Qty = -SUM(SD.LooseQty + SD.BonusQty),
		Value = SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM 
		SRLedger S, SRDetail SD, Doctors D, Item I
	WHERE 
		S.DoctCode IS NOT NULL AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SRInvCode = SD.SRInvCode AND 
		SD.ICode IN (:ai_icode) AND
		SD.ICode = I.ICode AND
		S.DoctCode = D.DoctCode
	GROUP BY
		I.ICode,
		I.CustomICode,
		I.Name,
		D.Name) T
GROUP BY
	T.ICode,
	T.AliasName,
	T.ItemName,
	T.Doctor
"
  arguments=(("ai_icode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="itemname A, doctor A"
)
