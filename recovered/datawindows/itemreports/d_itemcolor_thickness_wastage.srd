table(column=(type=char(60) updatewhereclause=yes name=issuefrom dbname="IssueFrom"  )
column=(type=char(60) updatewhereclause=yes name=receiptto dbname="ReceiptTo"  )
column=(type=char(60) updatewhereclause=yes name=colour dbname="Colour"  )
column=(type=char(100) updatewhereclause=yes name=thickness dbname="Thickness"  )
column=(type=decimal(12) updatewhereclause=yes name=issue dbname="Issue"  )
column=(type=decimal(12) updatewhereclause=yes name=receipt dbname="Receipt"  )
column=(type=decimal(12) updatewhereclause=yes name=wastage dbname="Wastage"  )
column=(type=decimal(6) updatewhereclause=yes name=wastageperc dbname="WastagePerc"  )
 retrieve="SELECT 
	IssueFrom = (SELECT GG.Name FROM GodownGroup GG WHERE GodownGroupCode = :ai_issuegodowngroup),
	ReceiptTo = (SELECT GG.Name FROM GodownGroup GG WHERE GodownGroupCode = :ai_receiptgodowngroup),
	Colour = T.Colour,
	Thickness = T.Thickness,
	Issue = SUM(T.Issue),
	Receipt = SUM(T.Receipt),
	Wastage = SUM(T.Issue) - SUM(T.Receipt),
	WastagePerc = ((SUM(T.Issue) - SUM(T.Receipt)) / CASE WHEN SUM(T.Issue) > 0 THEN SUM(T.Issue) ELSE 1 END) * 100
FROM
	(SELECT 
		Colour=C.Name,
		Thickness=T.Name,
		Issue = ROUND(SUM(D.Qty * I.AreaVolume), 8),
		Receipt = 0.0000
	FROM
		GodownGroup GG,
		Godown G,
		IssueHeader H,
		IssueDetail D,
		ProdNote PN,
		Item I,
		ItemColour C,
		ItemThickness T
	WHERE
		H.Posted = 'Y' AND
		H.Date BETWEEN :adt_startdate AND :adt_enddate AND
		H.IssueInvCode = PN.IssueInvCode AND
		H.IssueInvCode = D.IssueInvCode AND
		D.ICode = I.ICode AND
		I.IColourCode = C.IColourCode  AND
		I.ItemThicknessCode = T.ItemThicknessCode AND
		GG.GodownGroupCode = :ai_issuegodowngroup AND
		GG.GodownGroupCode = G.GodownGroupCode AND
		D.GCode = G.GCode
	GROUP BY
		C.Name,
		T.Name
	UNION ALL
	SELECT 
		Colour=C.Name,
		Thickness=T.Name,
		Issue = 0.0000,
		Receipt = ROUND(SUM(D.Qty * I.AreaVolume) + 
			SUM(CASE WHEN I.ItemThicknessCode2 > 0 AND I.ItemColourCode2 > 0 THEN 
				CASE WHEN I.ItemColourCode2 = I.IColourCode THEN (D.Qty * I.AreaVolume) ELSE 0 END
			ELSE 0 END), 8)
	FROM
		GodownGroup GG,
		Godown G,
		ReceiptHeader H,
		ReceiptDetail D,
		ProdNote PN,
		Item I,
		ItemColour C,
		ItemThickness T
	WHERE
		H.Posted = 'Y' AND
		H.Date BETWEEN :adt_startdate AND :adt_enddate AND
		H.ReceiptInvCode = PN.ReceiptInvCode AND
		H.ReceiptInvCode = D.ReceiptInvCode AND
		D.ICode = I.ICode AND
		I.IColourCode = C.IColourCode  AND
		I.ItemThicknessCode = T.ItemThicknessCode AND
		GG.GodownGroupCode = :ai_receiptgodowngroup AND
		GG.GodownGroupCode = G.GodownGroupCode AND
		D.GCode = G.GCode
	GROUP BY
		C.Name,
		T.Name)T
GROUP BY
	T.Colour,
	T.Thickness

"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_issuegodowngroup", number), ("ai_receiptgodowngroup", number))
 sort="colour A, thickness A"
)
