table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(0) updatewhereclause=yes name=itemrowid dbname="ItemRowId"  )
column=(type=datetime updatewhereclause=yes name=lastupdate dbname="lastupdate"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=salediscperc dbname="salediscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(17) updatewhereclause=yes name=unitprice dbname="unitprice"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=long updatewhereclause=yes name=displayrow dbname="DisplayRow"  )
column=(type=char(100) updatewhereclause=yes name=changereason dbname="ChangeReason"  )
column=(type=char(100) updatewhereclause=yes name=module dbname="Module"  )
 retrieve="SELECT
	AliasName = (SELECT item.customicode from item where item.icode = :code),
	ItemName = (SELECT item.name from item where item.icode = :code),
	ItemRowId=ItemLog.ItemRowId,
	lastupdate=ItemLog.LogDate,
	saleprice=ItemLog.saleprice,
	salediscperc=ItemLog.salediscperc, 
	packunits=ItemLog.packunits, 
	unitprice= Round((ItemLog.saleprice * (1 - ItemLog.salediscperc * 0.01) / case ItemLog.packunits when 0 then 1 else ItemLog.packunits end), 2),
	username = (select users.username from users where users.usercode = itemlog.usercode),
	DisplayRow=1,
	ChangeReason=ItemLog.ChangeReason,
	Module =ItemLog.Module
FROM 
	ItemLog 
WHERE 
	ICode=:Code
UNION ALL
SELECT 
	AliasName = item.customicode,
	ItemName = item.name,
	itemrowid=999999999,
	lastupdate=Item.lastupdate,
	saleprice=Item.saleprice,
	salediscperc=Item.salediscperc,
	packunits=Item.packunits,
	unitprice= Round((Item.saleprice * (1 - Item.salediscperc * 0.01) / case Item.packunits when 0 then 1 else Item.packunits end), 2),
	username = (select users.username from users where users.usercode = item.usercode),
	DisplayRow=1,
	ChangeReason=Item.ChangeReason,
	Module =Item.Module
FROM 
	Item
WHERE	icode=:Code
ORDER BY 
	itemrowid"
  arguments=(("code", number))
 sort="itemrowid A"
 filter=" displayrow =1"
 )
