UNION ALL
SELECT
	Doctype = 'SR-' + LTRIM(RTRIM(STR(SL.SRINVCODE, 10))), 
	SL.DATE,
	Type='R',
	InvCode=SL.SRInvCode,
	ItemCode=SD.ICode, 
	AliasName=I.CustomICode, 
	Item=I.Name, 
	packingfactor=I.packingfactor,
	CustomerAliasName=A.AliasName,
	Customer=A.Name,
	Qty=0,
	Bonus=0,
	RetQty=SUM(SD.LooseQty),
	RetBonus=SUM(SD.BonusQty),
	AREA=AR.Name,
	Rate = ROUND(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),
	Packing=I.PackingDesc,
	price=max(SD.srprice),
	username=(select username from users where users.usercode=max(SL.salesmancode)),
	discval=Round(Sum (Round( SD.looseqty  * SD.srprice * (SD.discperc * .01),2)), 2)
				+Round(Sum (Round( (SD.looseqty  ) * SD.srprice * (1 - (SD.discperc * .01)),2)) * (max(SL.discperc) /100), 2)
FROM
	SRLedger SL, SRDetail SD, Accounts A, Customer C, Area AR, Item I
WHERE
	:ai_allitems = 1 AND
	SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
	SL.SRInvCode = SD.SRInvCode AND
	SL.CustCode = C.CustCode AND 
	C.CustCode = A.AccCode AND
	SD.ICode =  I.ICode AND
	C.AreaCode = AR.AreaCode
GROUP BY
	SL.SRInvCode,
	SD.ICode, 
	I.Name, 
	I.packingfactor,
	I.CustomICode,
	SD.SRPrice,
	I.SalePrice,
	I.PackUnits,
	I.PackingDesc,
	SL.DATE,
	A.AliasName,
	A.Name, 
	AR.Name
ORDER BY
	I.Name, 
	I.CustomICode,
	DATE,
	InvCode,
	A.AliasName,
	A.Name, 
	AR.Name
"
  arguments=(("ai_allitems", number), ("ar_icode", numberlist), ("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
