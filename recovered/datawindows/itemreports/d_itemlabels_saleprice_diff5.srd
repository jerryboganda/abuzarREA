table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(2) updatewhereclause=yes name=oldsaleprice dbname="oldsaleprice"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="name"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
column=(type=long updatewhereclause=yes name=saleprice dbname="saleprice"  )
 retrieve=" SELECT 
	itemname=Itemlog.Name, 
	oldsaleprice = saleprice, 
	name=(select name from item where item.icode=itemlog.icode),
	itemcategory=(select name from itemcategory where itemcategory.icatcode=itemlog.icatcode),
	saleprice = convert(int,newsaleprice)

FROM itemlog, 
	(SELECT L.ICode, MaxID=MAX(L.ItemRowID)
	FROM itemlog L
	WHERE L.logdate >= :ar_startdate AND 
		L.logdate <= :ar_enddate AND 
		L.icatcode in (:aa_icatcode) AND 
		(L.saleprice <> L.newsaleprice)
	GROUP BY L.ICode) T
WHERE
	ItemLog.ItemRowId = T.MaxID
ORDER BY 
	itemcategory, 
	Name
	


/*SELECT Name,
		saleprice=convert(int,saleprice),
		itemclass=(select name from itemclass where itemclass.iccode=item.iccode)
from item
where item.iccode IN (:aa_icatcode)
order by itemclass,
			name*/
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("aa_icatcode", numberlist))
)
