table(column=(type=char(13) updatewhereclause=yes name=doctype dbname="Doctype"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="AREA"  )
column=(type=long updatewhereclause=yes name=invcode dbname="INVCODE"  )
column=(type=datetime updatewhereclause=yes name=date dbname="DATE"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CUSTALIAS"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="CUSTOMER"  )
column=(type=char(60) updatewhereclause=yes name=customeradd1 dbname="customeradd1"  )
column=(type=char(60) updatewhereclause=yes name=customeradd2 dbname="customeradd2"  )
column=(type=char(100) updatewhereclause=yes name=customerphone dbname="customerphone"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="ALIASNAME"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="ITEM"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="TYPE"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="QTY"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="BONUS"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="BATCH"  )
column=(type=decimal(2) updatewhereclause=yes name=invoicerate dbname="PRICE"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(6) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=decimal(6) updatewhereclause=yes name=gross dbname="Gross"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(6) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
 retrieve="SELECT 
	Doctype = 'SV-' + LTRIM(RTRIM(STR(S.SALEINVCODE, 10))), 
	AREA = AR.NAME,  
	INVCODE=S.SALEINVCODE, 
	DATE=S.DATE, 
	CUSTALIAS=A.ALIASNAME, 
	CUSTOMER=A.NAME,
	customeradd1=max(C.address1),
	customeradd2=max(C.address2),
	customerphone=max(C.phone),
	ALIASNAME=I.CUSTOMICODE, 
	ITEM=I.NAME,
	TYPE='S',
	QTY=SUM(SD.LOOSEQTY), 
	BONUS=SUM(SD.BONUSQTY),
	BATCH = SD.Batch, 
	PRICE=SD.SALEPRICE,
	SalePrice=SD.Rate,
	NetRate= MAX((SD.LooseQty * (SD.SalePrice - SD.itemflatdisc) * 
			(1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) / 
			(CASE SD.LOOSEQTY+SD.BonusQty 
				WHEN 0 THEN 1 
				ELSE SD.LOOSEQTY+SD.BonusQty END)),
	Gross = SUM(SD.LooseQty * SD.SalePrice),
	Discount = Round(Sum (( SD.Looseqty  * (SD.saleprice - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2) +
				Sum (Round( SD.looseqty   * (SD.saleprice  - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2) * (S.discperc /100)),
	DiscPerc = 	Round(((Round(Sum (( SD.Looseqty  * (SD.saleprice - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2) +
				Sum (Round( SD.looseqty   * (SD.saleprice  - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2) * (S.discperc /100))) / 
					CASE SUM(SD.LooseQty * SD.SalePrice) 
					WHEN 0 THEN 1 
					ELSE SUM(SD.LooseQty * SD.SalePrice) END) * 100, 2)
FROM 
	SALELEDGER S, 
	ACCOUNTS A, 
	CUSTOMER C,
	ITEM I,
	SALEDETAIL SD,
	AREA AR
WHERE 
	:AI_ALLITEMS = 0 AND
	SD.ICODE IN (:AI_ICODE) AND
	S.SALEINVCODE = SD.SALEINVCODE AND
	S.DATE >= :AD_STARTDATE AND S.DATE<= :AD_ENDDATE AND
	S.CUSTCODE = A.ACCCODE AND
	A.ACCCODE = C.CUSTCODE AND 
	C.AREACODE = AR.AREACODE AND
	SD.ICODE = I.ICODE
GROUP BY
	I.NAME,
	I.CUSTOMICODE, 
	SD.Batch,
	AR.Name,
	A.NAME,
	A.ALIASNAME, 
	S.SALEINVCODE, 
	S.DATE, 
	SD.SALEPRICE,
	SD.Rate
UNION ALL
SELECT 
	Doctype = 'SV-' + LTRIM(RTRIM(STR(S.SALEINVCODE, 10))), 
	AREA = AR.NAME,  
	INVCODE=S.SALEINVCODE, 
	DATE=S.DATE, 
	CUSTALIAS=A.ALIASNAME, 
	CUSTOMER=A.NAME,
	customeradd1=max(C.address1),
	customeradd2=max(C.address2),
	customerphone=max(C.phone),
	ALIASNAME=I.CUSTOMICODE, 
	ITEM=I.NAME,
	TYPE='S',
	QTY=SUM(SD.LOOSEQTY), 
	BONUS=SUM(SD.BONUSQTY),
	BATCH = SD.Batch,
	PRICE=SD.SALEPRICE,
	SalePrice=SD.Rate,
	NetRate= MAX((SD.LooseQty * (SD.SalePrice - SD.itemflatdisc) * 
			(1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) / 
			(CASE SD.LOOSEQTY+SD.BonusQty 
				WHEN 0 THEN 1 
				ELSE SD.LOOSEQTY+SD.BonusQty END)),
	Gross = SUM(SD.LooseQty * SD.SalePrice),
	Discount = Round(Sum (( SD.Looseqty  * (SD.saleprice - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2) +
				Sum (Round( SD.looseqty   * (SD.saleprice  - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2) * (S.discperc /100)),
	DiscPerc = 	Round(((Round(Sum (( SD.Looseqty  * (SD.saleprice - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2) +
				Sum (Round( SD.looseqty   * (SD.saleprice  - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2) * (S.discperc /100))) / 
					CASE SUM(SD.LooseQty * SD.SalePrice) 
					WHEN 0 THEN 1 
					ELSE SUM(SD.LooseQty * SD.SalePrice) END) * 100, 2)
FROM 
	SALELEDGER S, 
	ACCOUNTS A, 
	CUSTOMER C,
	ITEM I,
	SALEINVDETAIL SD,
	AREA AR
WHERE 
	:AI_ALLITEMS = 0 AND
	SD.ICODE IN (:AI_ICODE) AND
	S.ImpactInventory ='N' AND
	S.SALEINVCODE = SD.SALEINVCODE AND
	S.DATE >= :AD_STARTDATE AND S.DATE<= :AD_ENDDATE AND
	S.CUSTCODE = A.ACCCODE AND
	A.ACCCODE = C.CUSTCODE AND 
	C.AREACODE = AR.AREACODE AND
	SD.ICODE = I.ICODE
GROUP BY
	I.NAME,
	I.CUSTOMICODE, 
	SD.Batch,
	AR.Name,
	A.NAME,
	A.ALIASNAME, 
	S.SALEINVCODE, 
	S.DATE, 
	SD.SALEPRICE,
	SD.Rate
UNION ALL
SELECT 
	Doctype = 'SR-' + LTRIM(RTRIM(STR(S.SRINVCODE, 10))), 
	AREA = AR.NAME,
	INVCODE=S.SRINVCODE, 
	DATE=S.DATE, 
	CUSTALIAS=A.ALIASNAME, 
	CUSTOMER=A.NAME,
	customeradd1=max(C.address1),
	customeradd2=max(C.address2),
	customerphone=max(C.phone),
	ALIASNAME=I.CUSTOMICODE, 
	ITEM=I.NAME,
	TYPE='R',
	QTY=-SUM(SD.LOOSEQTY), 
	BONUS=-SUM(SD.BONUSQTY),
	BATCH = SD.Batch,
	PRICE=SD.SRPRICE,
	SALEPRICE=SD.SALEPRICE,
	NetRate= MAX((SD.LooseQty * SD.SRPrice * 
			(1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) / 
			(CASE SD.LOOSEQTY+SD.BonusQty 
				WHEN 0 THEN 1 
				ELSE SD.LOOSEQTY+SD.BonusQty END)),
	Gross = SUM(SD.LooseQty * SD.SRPrice),
	Discount =- Round(Sum (( SD.Looseqty  * SD.srprice * (SD.discperc * .01))), 2)+
				Sum (Round( SD.looseqty * SD.srprice * (1 - (SD.discperc * .01)), 2) * (S.discperc /100)),
	DiscPerc =-	Round(((Round(Sum (( SD.Looseqty  * SD.srprice * (SD.discperc * .01))), 2)+
				Sum (Round( SD.looseqty * SD.srprice * (1 - (SD.discperc * .01)), 2) * (S.discperc /100))) / 
					CASE SUM(SD.LooseQty * SD.SrPrice) 
					WHEN 0 THEN 1 
					ELSE SUM(SD.LooseQty * SD.SrPrice) END) * 100, 2)

FROM 
	SRLEDGER S, 
	ACCOUNTS A, 
	CUSTOMER C,
	ITEM I,
	SRDETAIL SD,
	AREA AR
WHERE 
	:AI_ALLITEMS = 0 AND
	SD.ICODE IN (:AI_ICODE) AND
	S.SRINVCODE = SD.SRINVCODE AND
	S.DATE >= :AD_STARTDATE AND S.DATE<= :AD_ENDDATE AND 
	S.CUSTCODE = A.ACCCODE AND
	A.ACCCODE = C.CUSTCODE AND 
	C.AREACODE = AR.AREACODE AND
	SD.ICODE = I.ICODE
GROUP BY
	I.NAME,
	I.CUSTOMICODE, 
	SD.Batch,
	AR.Name,
	A.NAME,
	A.ALIASNAME, 
	S.SRINVCODE, 
	S.DATE, 
	SD.SRPRICE,
	SD.SALEPRICE
UNION ALL
