table(column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(50) updatewhereclause=yes name=machinename dbname="MachineName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="ItemFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="UnitSalesTax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="GSTPerc"  )
 retrieve="SELECT 
	UserName=U.UserName, 
	SaleInvCode=DSI.SaleInvCode,
	Date = DSI.Date, 
	MachineName=DSI.MachineName,
	AliasName = I.CustomICode, 
	ItemName = I.Name, 
	Qty = DSI.Qty, 
	BonusQty=DSI.BonusQty,
	SalePrice=DSI.SalePrice,
	ItemFlatDisc=DSI.ItemFlatDisc,
	DiscPerc=DSI.DiscPerc,
	UnitSalesTax=DSI.UnitSalesTax,
	GSTPerc=DSI.GSTPerc
FROM DeletedSaleItem dsi, item i , Users U
WHERE DSI.Date BETWEEN :adt_startdate AND :adt_enddate AND
dsi.icode = i.icode AND dsi.usercode=u.usercode
ORDER BY UserName, Date
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
)
