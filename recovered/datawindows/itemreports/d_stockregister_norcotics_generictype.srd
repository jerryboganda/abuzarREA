table(column=(type=char(100) updatewhereclause=yes name=genericitemtype dbname="GenericItemType"  )
column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=char(4) updatewhereclause=yes name=type dbname="type"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="AccName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(100) updatewhereclause=yes name=ref dbname="ref"  )
column=(type=decimal(10) updatewhereclause=yes name=stockatsale dbname="stockatsale"  )
column=(type=char(1) updatewhereclause=yes name=balanceloosepack dbname="balanceloosepack"  )
column=(type=decimal(15) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=char(1) updatewhereclause=yes name=loosepack dbname="loosepack"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=decimal(0) updatewhereclause=yes name=utn dbname="utn"  )
 retrieve="select  	
	GenericItemType=GIT.Name,
	invcode=SL.saleinvcode, 
	type= 'Sale',
	AccName = A.Name,
	itemname=I.name, 
	remarks=SL.remarks,
	ref=SL.custrefno,
	stockatsale = CASE ( (SD.godownbalancestock / SD.PackUnits) - CAST(SD.godownbalancestock / SD.PackUnits AS INT ) ) When 0 Then (SD.godownbalancestock / SD.PackUnits) Else SD.godownbalancestock End ,
	balanceloosepack = CASE ( (SD.godownbalancestock / SD.PackUnits) - CAST(SD.godownbalancestock / SD.PackUnits AS INT ) ) When 0 Then ' ' Else 'L' End ,
	qty= CASE ( ((SD.looseqty + SD.bonusqty) / SD.PackUnits) - CAST( (SD.looseqty + SD.bonusqty) / SD.PackUnits AS INT) ) When 0 THEN ((SD.looseqty + SD.bonusqty) / SD.PackUnits ) ELSE (SD.looseqty + SD.bonusqty) END,
	loosepack= CASE ( ((SD.looseqty + SD.bonusqty) / SD.PackUnits) - CAST( (SD.looseqty + SD.bonusqty) / SD.PackUnits AS INT) ) When 0 THEN ' ' ELSE 'L' END,
	date=SL.date,
	batch=SD.batch,
	expiry=SD.expiry,
	username=U.username,
	manufacturer=M.name,
	ItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = I.ICatCode),
	utn = SD.saleutn
From 	
	saleledger SL,
	saledetail  SD,
	Users U,
	Item I,
	GenericItem GI,
	GenericItemType GIT,
	Manufacturer M,
	Accounts A

Where 
	(SL.date BETWEEN :ar_stdate AND :ar_enddate) AND
	(SL.salesmancode=U.usercode) and 
	(SL.saleinvcode=SD.saleinvcode)  and
	(SL.custcode = A.AccCode ) And
	(I.icode=SD.icode) and
	(I.antinorcotix='Y') and
	(I.manfcode=M.manfcode) AND
	(I.GenericCode=GI.GenericCode) AND
	(GI.GenericItemTypeCode = GIT.GenericItemTypeCode) AND
	(GIT.GenericItemTypeCode IN (:ai_generictypecode))
Union All 
select  	
	GenericItemType=GIT.Name,
	invcode=SL.srinvcode,
	type= 'S/R',
	AccName = A.Name,
	itemname=I.name,
	remarks=SL.remarks,
	ref=SL.custrefno,
	stockatsale= null ,
	balanceloosepack=' ',
	qty= CASE ( ((SD.looseqty + SD.bonusqty) / SD.PackUnits) - CAST( (SD.looseqty + SD.bonusqty) / SD.PackUnits AS INT) ) When 0 THEN ((SD.looseqty + SD.bonusqty) / SD.PackUnits ) ELSE (SD.looseqty + SD.bonusqty) END,
	loosepack= CASE ( ((SD.looseqty + SD.bonusqty) / SD.PackUnits) - CAST( (SD.looseqty + SD.bonusqty) / SD.PackUnits AS INT) ) When 0 THEN ' ' ELSE 'L' END,
	date=SL.date,
	batch=SD.batch,
	expiry=SD.expiry,
	username=U.username,
	manufacturer=M.name,
	ItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = I.ICatCode),
	utn = SD.srutn

From 	
	SRledger SL,
	SRDetail  SD,
	Users U,
	Item I,
	GenericItem GI,
	GenericItemType GIT,
	Manufacturer M,
	Accounts A
Where 
	(SL.date BETWEEN :ar_stdate AND :ar_enddate) and
	(SL.salesmancode=U.usercode)and
	(SL.srinvcode=SD.srinvcode)  and
	(SL.custcode = A.AccCode ) And
	(I.icode=SD.icode)and
	(I.antinorcotix='Y')and
	(I.manfcode=M.manfcode)  AND
	(I.GenericCode=GI.GenericCode) AND
	(GI.GenericItemTypeCode = GIT.GenericItemTypeCode) AND
	(GIT.GenericItemTypeCode IN (:ai_generictypecode))

union all
select  	
	GenericItemType=GIT.Name,
	invcode=PL.purinvcode,
	type= 'Pur',
	AccName = A.Name,
	itemname=I.name,
	remarks=PL.remarks,
	ref=' ',
	stockatpur = CASE ( ( (PD.currstock + ((PD.LooseQty + PD.PackQty + PD.BonusQty) * CASE When PL.purcatcode in (1,2) Then PD.PackUnits ELSE 1 END)) / PD.PackUnits) - CAST(  (PD.currstock+ ((PD.LooseQty + PD.PackQty + PD.BonusQty) * CASE When PL.purcatcode in (1,2) Then PD.PackUnits ELSE 1 END)) / PD.PackUnits AS INT) ) When 0 Then ( (PD.currstock + ((PD.LooseQty + PD.PackQty + PD.BonusQty) * CASE When PL.purcatcode in (1,2) Then PD.PackUnits ELSE 1 END)) / PD.PackUnits) Else (PD.currstock + ((PD.LooseQty + PD.PackQty + PD.BonusQty) * CASE When PL.purcatcode in (1,2) Then PD.PackUnits ELSE 1 END) ) End ,
	balanceloosepack = CASE ( (PD.currstock / PD.PackUnits) - CAST( PD.currstock / PD.PackUnits AS INT) ) When 0 Then ' ' Else 'L' End ,
	qty = Case When PL.purcatcode in (1,2) Then 
						(PD.PackQty + PD.BonusQty)
					Else
						CASE ( ( (PD.looseqty + PD.bonusqty) / PD.PackUnits) - CAST( (PD.looseqty + PD.bonusqty) / PD.PackUnits AS INT) ) WHEN 0 THEN ((PD.looseqty + PD.bonusqty) / PD.PackUnits ) ELSE (PD.looseqty + PD.bonusqty) END
					End,
	loosepack = Case When PL.purcatcode in (1,2) Then 
						' '
					Else
						CASE ( ( (PD.looseqty + PD.bonusqty) / PD.PackUnits) - CAST( (PD.looseqty + PD.bonusqty) / PD.PackUnits AS INT) ) When 0 THEN ' ' ELSE 'L' END
					End,
	date=PL.date,
	batch=PD.batch,
	expiry=PD.expiry,
	username=U.username,
	Manufacturer=M.name,
	ItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = I.ICatCode),
	utn = PD.purutn

from 	
	purledger PL,
	purdetail  PD,
	Users U,
	Item I,
	GenericItem GI,
	GenericItemType GIT,
	Manufacturer M,
	Accounts A

where 
	(PL.date BETWEEN :ar_stdate AND :ar_enddate) and 
	(PL.posted='Y')and
	(PL.salesmancode=U.usercode)and
	(PL.purinvcode=PD.purinvcode) and
	(PL.Suppcode = A.AccCode ) And
	(I.icode=PD.icode) and
	(I.antinorcotix='Y')and
	(I.manfcode=M.manfcode) AND
	(I.GenericCode=GI.GenericCode) AND
	(GI.GenericItemTypeCode = GIT.GenericItemTypeCode) AND
	(GIT.GenericItemTypeCode IN (:ai_generictypecode))

Union All
select  	
	GenericItemType=GIT.Name,
	invcode=PL.prinvcode,
	type= 'P/R',
	AccName = A.Name,
	itemname=I.name,
	remarks=PL.remarks,
	ref=' ',
	stockatpr= null,
	balanceloosepack = '',
	qty= CASE ( ( (PD.looseqty + PD.bonusqty) / PD.PackUnits) - CAST( (PD.looseqty + PD.bonusqty) / PD.PackUnits AS INT) ) When 0 THEN ((PD.looseqty + PD.bonusqty) / PD.PackUnits ) ELSE (PD.looseqty + PD.bonusqty) END,
	loosepack= CASE ( ( (PD.looseqty + PD.bonusqty) / PD.PackUnits) - CAST( (PD.looseqty + PD.bonusqty) / PD.PackUnits AS INT) ) When 0 THEN ' ' ELSE 'L' END,
	date=PL.date,
	batch=PD.batch,
	expiry=PD.expiry,
	username=U.username,
	Manufacturer=M.name,
	ItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = I.ICatCode),
	utn = PD.prutn

from  
	prledger PL,
	prdetail  PD,
	Users U,
	Item I,
	GenericItem GI,
	GenericItemType GIT,
	Manufacturer M,
	Accounts A
where 
	(PL.date BETWEEN :ar_stdate and :ar_enddate) and
	(PL.posted='Y')and
	(PL.salesmancode=U.usercode)and
	(PL.prinvcode=PD.prinvcode) and
	(PL.Suppcode = A.AccCode ) And
	(I.icode=PD.icode) and
	(I.antinorcotix='Y')and
	(I.manfcode=M.manfcode) AND
	(I.GenericCode=GI.GenericCode) AND
	(GI.GenericItemTypeCode = GIT.GenericItemTypeCode) AND
	(GIT.GenericItemTypeCode IN (:ai_generictypecode))
"
  arguments=(("ai_generictypecode", numberlist), ("ar_stdate", datetime), ("ar_enddate", datetime))
 sort="genericitemtype A, itemname A, utn A"
)
