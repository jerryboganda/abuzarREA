table(column=(type=char(13) updatewhereclause=yes name=doctype dbname="Doctype"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="AREA"  )
column=(type=long updatewhereclause=yes name=invcode dbname="INVCODE"  )
column=(type=datetime updatewhereclause=yes name=date dbname="DATE"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CUSTALIAS"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="CUSTOMER"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="ALIASNAME"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="ITEM"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="TYPE"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="QTY"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="BONUS"  )
column=(type=decimal(13) updatewhereclause=yes name=invoicerate dbname="PRICE"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(6) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=decimal(16) updatewhereclause=yes name=gross dbname="Gross"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(6) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
 retrieve="SELECT 
	Doctype = 'SV-' + LTRIM(RTRIM(STR(S.SALEINVCODE, 10))), 
	AREA = (SELECT AREA.NAME FROM AREA WHERE AREA.AREACODE = :AI_AREACODE),
	INVCODE=S.SALEINVCODE, 
	DATE=S.DATE,  
	CUSTALIAS=A.ALIASNAME, 
	CUSTOMER=A.NAME,
	ALIASNAME=I.CUSTOMICODE, 
	ITEM=I.NAME, 
	TYPE='S', 
	QTY=SUM(SD.LOOSEQTY), 
	BONUS=SUM(SD.BONUSQTY),
	PRICE=CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END,
	SalePrice=CASE :AI_PRICETYPE WHEN 1 THEN SD.Rate ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END,
	NetRate= MAX((SD.LooseQty * (SD.SalePrice - SD.itemflatdisc) * 
			(1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) / 
			(CASE SD.LOOSEQTY+SD.BonusQty 
				WHEN 0 THEN 1 
				ELSE SD.LOOSEQTY+SD.BonusQty END)),
	Gross = SUM(SD.LooseQty * CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END),
	Discount = Round(Sum (( SD.Looseqty  * (CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2) +
				Sum (Round( SD.looseqty   * (CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END  - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2) * (S.discperc /100)),
	DiscPerc = 	Round(((Round(Sum (( SD.Looseqty  * (CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2) +
				Sum (Round( SD.looseqty   * (CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2) * (S.discperc /100))) / 
					CASE SUM(SD.LooseQty * CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END) 
					WHEN 0 THEN 1 
					ELSE SUM(SD.LooseQty * CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END) END) * 100, 2)
FROM 
	SALELEDGER S, 
	ACCOUNTS A, 
	CUSTOMER C,
	ITEM I,
	SALEDETAIL SD
WHERE 
	SD.ICODE IN (:AI_ICODE) AND
	S.SALEINVCODE = SD.SALEINVCODE AND
	S.DATE >= :AD_STARTDATE AND S.DATE<= :AD_ENDDATE AND
	S.CUSTCODE = A.ACCCODE AND
	A.ACCCODE = C.CUSTCODE AND 
	C.AREACODE = :AI_AREACODE AND
	SD.ICODE = I.ICODE
GROUP BY
	S.SALEINVCODE, 
	S.DATE, 
	A.ALIASNAME, 
	A.NAME,
	I.CUSTOMICODE, 
	I.NAME,
	SD.SALEPRICE,
	SD.Rate,
	I.SalePrice,
	I.PackUnits
UNION ALL
SELECT 
	Doctype = 'SV-' + LTRIM(RTRIM(STR(S.SALEINVCODE, 10))), 
	AREA = (SELECT AREA.NAME FROM AREA WHERE AREA.AREACODE = :AI_AREACODE),
	INVCODE=S.SALEINVCODE, 
	DATE=S.DATE, 
	CUSTALIAS=A.ALIASNAME, 
	CUSTOMER=A.NAME,
	ALIASNAME=I.CUSTOMICODE, 
	ITEM=I.NAME, 
	TYPE='S', 
	QTY=SUM(SD.LOOSEQTY), 
	BONUS=SUM(SD.BONUSQTY),
	PRICE=CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END,
	SalePrice=CASE :AI_PRICETYPE WHEN 1 THEN SD.Rate ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END,
	NetRate= MAX((SD.LooseQty * (SD.SalePrice - SD.itemflatdisc) * 
			(1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) / 
			(CASE SD.LOOSEQTY+SD.BonusQty 
				WHEN 0 THEN 1 
				ELSE SD.LOOSEQTY+SD.BonusQty END)),
	Gross = SUM(SD.LooseQty * CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END),
	Discount = Round(Sum (( SD.Looseqty  * (CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2) +
				Sum (Round( SD.looseqty   * (CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END  - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2) * (S.discperc /100)),
	DiscPerc = 	Round(((Round(Sum (( SD.Looseqty  * (CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2) +
				Sum (Round( SD.looseqty   * (CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2) * (S.discperc /100))) / 
					CASE SUM(SD.LooseQty * CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END) 
					WHEN 0 THEN 1 
					ELSE SUM(SD.LooseQty * CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END) END) * 100, 2)
FROM 
	SALELEDGER S, 
	ACCOUNTS A, 
	CUSTOMER C,
	ITEM I,
	SALEINVDETAIL SD
WHERE 
	S.ImpactInventory = 'N' AND
	SD.ICODE IN (:AI_ICODE) AND
	S.SALEINVCODE = SD.SALEINVCODE AND
	S.DATE >= :AD_STARTDATE AND S.DATE<= :AD_ENDDATE AND
	S.CUSTCODE = A.ACCCODE AND
	A.ACCCODE = C.CUSTCODE AND 
	C.AREACODE = :AI_AREACODE AND
	SD.ICODE = I.ICODE
GROUP BY
	S.SALEINVCODE, 
	S.DATE, 
	A.ALIASNAME, 
	A.NAME,
	I.CUSTOMICODE, 
	I.NAME,
	SD.SALEPRICE,
	SD.Rate,
	I.SalePrice,
	I.PackUnits
UNION ALL
SELECT 
	Doctype = 'SR-' + LTRIM(RTRIM(STR(S.SRINVCODE, 10))), 
	AREA = (SELECT AREA.NAME FROM AREA WHERE AREA.AREACODE = :AI_AREACODE),
	INVCODE=S.SRINVCODE, 
	DATE=S.DATE, 
	CUSTALIAS=A.ALIASNAME, 
	CUSTOMER=A.NAME,
	ALIASNAME=I.CUSTOMICODE, 
	ITEM=I.NAME,
	TYPE='R',
	QTY=-SUM(SD.LOOSEQTY), 
	BONUS=-SUM(SD.BONUSQTY),
	PRICE=CASE :AI_PRICETYPE WHEN 1 THEN SD.SRPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END,
	SALEPRICE=CASE :AI_PRICETYPE WHEN 1 THEN SD.SALEPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END,
	NetRate= MAX((SD.LooseQty * CASE :AI_PRICETYPE WHEN 1 THEN SD.SRPrice ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END * 
			(1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)) / 
			(CASE SD.LOOSEQTY+SD.BonusQty 
				WHEN 0 THEN 1 
				ELSE SD.LOOSEQTY+SD.BonusQty END)),
	Gross = SUM(SD.LooseQty * CASE :AI_PRICETYPE WHEN 1 THEN SD.SRPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END),
	Discount =- Round(Sum (( SD.Looseqty  * CASE :AI_PRICETYPE WHEN 1 THEN SD.SRPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END * (SD.discperc * .01))), 2)+
				Sum (Round( SD.looseqty * CASE :AI_PRICETYPE WHEN 1 THEN SD.SRPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END * (1 - (SD.discperc * .01)), 2) * (S.discperc /100)),
	DiscPerc =-	Round(((Round(Sum (( SD.Looseqty  * CASE :AI_PRICETYPE WHEN 1 THEN SD.SRPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END * (SD.discperc * .01))), 2)+
				Sum (Round( SD.looseqty * CASE :AI_PRICETYPE WHEN 1 THEN SD.SRPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END * (1 - (SD.discperc * .01)), 2) * (S.discperc /100))) / 
					CASE SUM(SD.LooseQty * CASE :AI_PRICETYPE WHEN 1 THEN SD.SRPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END) 
					WHEN 0 THEN 1 
					ELSE SUM(SD.LooseQty * CASE :AI_PRICETYPE WHEN 1 THEN SD.SRPRICE ELSE ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) END) END) * 100, 2)
FROM 
	SRLEDGER S, 
	ACCOUNTS A, 
	CUSTOMER C,
	ITEM I,
	SRDETAIL SD
WHERE 
	SD.ICODE IN (:AI_ICODE) AND
	S.SRINVCODE = SD.SRINVCODE AND
	S.DATE >= :AD_STARTDATE AND S.DATE<= :AD_ENDDATE AND 
	S.CUSTCODE = A.ACCCODE AND
	A.ACCCODE = C.CUSTCODE AND 
	C.AREACODE = :AI_AREACODE AND
	SD.ICODE = I.ICODE
GROUP BY
	S.SRINVCODE, 
	S.DATE, 
	A.ALIASNAME, 
	A.NAME,
	I.CUSTOMICODE, 
	I.NAME,
	SD.SRPRICE,
	SD.SALEPRICE,
	I.SalePrice,
	I.PackUnits
ORDER BY
	AREA,
	ITEM,
	ALIASNAME, 
	DATE, 
	TYPE DESC,
	INVCODE, 
	CUSTOMER,
	CUSTALIAS 

"
  arguments=(("AI_ICODE", numberlist), ("AI_AREACODE", number), ("AD_STARTDATE", datetime), ("AD_ENDDATE", datetime), ("AI_PRICETYPE", number))
 sort="area A, item A, aliasname A, date A, type D, invcode A, customer A"
)
