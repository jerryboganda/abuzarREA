table(column=(type=long key=yes updatewhereclause=yes name=code dbname="AdjBufferHeader.adjbuffercode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="AdjBufferHeader.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=adjinccode dbname="AdjIncCode"  )
column=(type=long updatewhereclause=yes name=adjdeccode dbname="AdjDecCode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="AdjBufferHeader.remarks"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
 retrieve="SELECT 
	adjbufferheader.adjbuffercode , 
	adjbufferheader.date , 
	posted = adjbufferheader.posted,
	AdjIncCode = adjbufferheader.AdjIncCode,
	AdjDecCode = adjbufferheader.AdjDecCode,
	adjbufferheader.remarks,
	PostedBy = IsNull((Select username from users where dbo.adjbufferheader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users where dbo.adjbufferheader.modifiedby = dbo.users.usercode), '') 
FROM 
	adjbufferheader     
WHERE 
	Posted IN (:as_Posted)"
  update="adjbufferheader" updatewhere=0 updatekeyinplace=no
  arguments=(("as_Posted", stringlist), ("ai_GroupCode", number), ("ai_Module", number))
)
