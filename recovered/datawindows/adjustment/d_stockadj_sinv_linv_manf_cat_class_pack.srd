release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=97 print.margin.bottom=97 print.paper.size=2 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=480 color="536870912" )
summary(height=84 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
column=(type=decimal(4) updatewhereclause=yes name=stockinhand dbname="StockInHand"  )
column=(type=decimal(4) updatewhereclause=yes name=stockonshelf dbname="StockOnShelf"  )
column=(type=decimal(16) updatewhereclause=yes name=stockonshelfvalue dbname="StockOnShelfValue"  )
 retrieve="SELECT 	
	GroupCode = 
		CASE :as_grouping
			WHEN 'M' THEN Item.ManfCode
			WHEN 'C' THEN Item.ICatCode
			WHEN 'L' THEN Item.ICCode
			WHEN 'P' THEN Item.PackCode 
		END, 
	GroupName = 
		CASE :as_grouping
			WHEN 'M' THEN (SELECT M.Name FROM Manufacturer M WHERE Item.ManfCode = M.ManfCode)
			WHEN 'C' THEN (SELECT C.Name FROM ItemCategory C WHERE Item.ICatCode = C.ICatCode)
			WHEN 'L' THEN (SELECT C.Name FROM ItemClass C WHERE Item.ICCode = C.ICCode)
			ELSE (SELECT P.Name FROM ItemPacking P WHERE Item.PackCode = P.PackCode)
		END,
	Item.Name,  
	aliasname=item.customicode, 
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	PackUnits=Item.PackUnits,   
	UnitPrice = Case :ai_pricetype
		WHEN 2 THEN Round(Item.purprice /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
		WHEN 1 THEN Round(max(Item.Saleprice) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
		WHEN 3 THEN max(Item.avgprice)
		END,
	StockInHand = SUM(D.StockInHand),
	StockOnShelf = SUM(D.StockOnShelf),
	StockOnShelfValue = 
		SUM(D.StockOnShelf *
			Case :ai_pricetype
			WHEN 2 THEN Round(Item.purprice /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
			WHEN 1 THEN Round(Item.Saleprice /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
			WHEN 3 THEN Item.avgprice
			END)
FROM 	
	AdjBufferHeader H,
	AdjBufferDetail D,
	Item
WHERE 
	H.AdjBufferCode BETWEEN :ai_sinvcode AND :ai_linvcode AND
	H.AdjBufferCode = D.AdjBufferCode AND
	D.ICode = Item.ICode
GROUP BY 
	Item.name,
	item.customicode, 
	Item.Active, 
	Item.purprice, 
	Item.SalePrice, 
	Item.PackUnits,
	Item.ManfCode,
	Item.ICatCode,
	Item.ICCode,
	Item.PackCode 
"
  arguments=(("as_grouping", string), ("ai_sinvcode", number), ("ai_linvcode", number), ("ai_pricetype", number))
 sort="groupname A, itemname A"
 filter="NOT (stockonshelf = 0 AND stockinhand =0)"
 )
