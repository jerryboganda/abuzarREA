release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=2 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=688 color="536870912" )
summary(height=88 color="536870912" )
footer(height=132 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=adjbuffercode dbname="AdjBufferHeader.adjbuffercode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="AdjBufferHeader.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="AdjBufferHeader.posted"  )
column=(type=long updatewhereclause=yes name=adjbufferheader_usercode dbname="AdjBufferHeader.Usercode"  )
column=(type=char(100) updatewhereclause=yes name=adjbufferheader_remarks dbname="AdjBufferHeader.Remarks"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=stockinhand dbname="AdjBufferDetail.stockinhand"  )
column=(type=decimal(4) updatewhereclause=yes name=stockonshelf dbname="AdjBufferDetail.stockonshelf"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="godown"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="itemclass"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="ReOrderQty"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=decimal(4) updatewhereclause=yes name=difference dbname="difference"  )
 retrieve="SELECT	dbo.adjBufferHeader.adjbuffercode,  
			dbo.adjBufferheader.date, 
			dbo.adjBufferHeader.posted,
			dbo.adjBufferHeader.Usercode,
			dbo.adjBufferHeader.Remarks,
			dbo.users.username,
			aliasname = dbo.item.customicode,
			itemname = dbo.item.name,
			dbo.adjbufferdetail.stockinhand,
			dbo.adjbufferdetail.stockonshelf,
			godown=(select name from godown where godown.gcode=adjbufferheader.gcode),
			itemclass=(select name from itemclass where itemclass.iccode=item.iccode),
			ReOrderQty=item.ReOrderQty,
			SalePrice=Item.SalePrice/(CASE item.packunits when 0 then 1 else Item.packunits end),
			manufacturer=(select name from manufacturer where manufacturer.manfcode=item.manfcode),
			difference=adjbufferdetail.stockinhand -  adjbufferdetail.stockonshelf

FROM  dbo.adjbufferHeader,
		 dbo.adjbufferDetail,
		 dbo.users, 
		 dbo.item

WHERE 	dbo.adjBufferHeader.adjbuffercode = :ai_adjcode and 
			dbo.adjBufferHeader.adjbuffercode = adjBufferDetail.adjbuffercode and 
			dbo.adjBufferHeader.usercode = dbo.users.usercode and
			dbo.adjBufferDetail.icode = dbo.item.icode

ORDER BY itemclass,
			 itemname"
  arguments=(("ai_adjcode", number))
 sort="itemname A"
)
