table(column=(type=long updatewhereclause=yes name=adjcode dbname="AdjHeader.adjcode"  )
column=(type=char(13) updatewhereclause=no name=doctype dbname="doctype"  )
column=(type=char(8) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="AdjHeader.date"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=decimal(6) updatewhereclause=yes name=adjustmentcost dbname="AdjustmentCost"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(6) updatewhereclause=yes name=purchasevalue dbname="PurchaseValue"  )
column=(type=long updatewhereclause=yes name=adjheader_usercode dbname="AdjHeader.Usercode"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=adjheader_posted dbname="AdjHeader.posted"  )
 retrieve="SELECT	h.adjcode, 
	doctype = Case h.adjcatcode WHEN 1 THEN 'AI-' ELSE 'AD-' END + LTRIM(RTRIM(STR(h.AdjCode, 10))), 
	Type=Case h.adjcatcode WHEN 1 THEN 'INCREASE' ELSE 'DECREASE' END, 
	h.date, 
	Round(sum(d.looseqty * price * Case h.adjcatcode WHEN 1 THEN 1 ELSE -1 END), 0) as Amount, 
	Round(sum(d.looseqty * avgprice * Case h.adjcatcode WHEN 1 THEN 1 ELSE -1 END), 0) as AdjustmentCost,
	Round(sum(d.looseqty * (saleprice/packunits) * Case h.adjcatcode WHEN 1 THEN 1 ELSE -1 END), 0) as SaleValue,
	Round(sum(d.looseqty * (purprice/packunits) * Case h.adjcatcode WHEN 1 THEN 1 ELSE -1 END), 0) as PurchaseValue,
	h.Usercode,
	u.username,
	h.posted
FROM 	adjheader h, adjdetail d, users u
WHERE 	
	h.adjcode >= :ar_scode and
	h.adjcode<= :ar_lcode and
	h.adjcode = d.adjcode and 
	h.adjcatcode IN (:aa_adjtype) and
	h.usercode = u.usercode
GROUP BY h.AdjCode, h.adjcatcode, h.date, h.Usercode, u.username, h.posted
ORDER BY H.ADJCODE"
  arguments=(("ar_scode", number), ("ar_lcode", number), ("aa_adjtype", numberlist))
)
