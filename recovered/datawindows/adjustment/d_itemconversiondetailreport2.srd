release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=200 print.margin.right=200 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1500 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=roworder dbname="RowOrder"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=long updatewhereclause=yes name=itemconversioneffectcode dbname="ItemConversionEffectCode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(60) updatewhereclause=yes name=convertfromgodown dbname="ConvertFromGodown"  )
column=(type=char(60) updatewhereclause=yes name=convertfromitem dbname="ConvertFromItem"  )
column=(type=decimal(4) updatewhereclause=yes name=convertfromqty dbname="ConvertFromQty"  )
column=(type=char(100) updatewhereclause=yes name=convertfromdesc dbname="ConvertFromDesc"  )
column=(type=char(75) updatewhereclause=yes name=convertfromitemalias dbname="ConvertFromItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=converttogodown dbname="ConvertToGodown"  )
column=(type=char(60) updatewhereclause=yes name=converttoitem dbname="ConvertToItem"  )
column=(type=decimal(4) updatewhereclause=yes name=converttoqty dbname="ConvertToQty"  )
column=(type=char(100) updatewhereclause=yes name=converttodesc dbname="ConvertToDesc"  )
column=(type=char(75) updatewhereclause=yes name=converttoitemalias dbname="ConvertToItemAlias"  )
column=(type=long updatewhereclause=yes name=adjincreasecode dbname="AdjIncreaseCode"  )
column=(type=long updatewhereclause=yes name=adjdecreasecode dbname="AdjDecreaseCode"  )
 retrieve="SELECT 
	RowOrder = CASE H.ItemConversionEffectCode WHEN 1 THEN 1 ELSE 0 END,
	Code=H.ItemConversionCode,
	Date=H.Date, 
	Posted=H.Posted,
	UserName=(SELECT U.UserName FROM Users U WHERE U.UserCode = H.UserCode),
	ItemConversionEffectCode=H.ItemConversionEffectCode,
	Remarks=H.Remarks,
	ConvertFromGodown = (SELECT G.Name FROM Godown G WHERE G.GCode IN (CASE H.ItemConversionEffectCode WHEN 1 THEN NULL ELSE H.GCode END)),
	ConvertFromItem = CASE H.ItemConversionEffectCode WHEN 1 THEN NULL ELSE SI.Name END,
	ConvertFromQty = CASE H.ItemConversionEffectCode WHEN 1 THEN 0 ELSE H.Qty END, 
	ConvertFromDesc = CASE H.ItemConversionEffectCode WHEN 1 THEN NULL ELSE SI.Remarks END,
	ConvertFromItemAlias = CASE H.ItemConversionEffectCode WHEN 1 THEN NULL ELSE SI.CustomICode END,
	ConvertToGodown     = (SELECT G.Name FROM Godown G WHERE G.GCode IN (CASE H.ItemConversionEffectCode WHEN 1 THEN H.GCode ELSE NULL END)),
	ConvertToItem = CASE H.ItemConversionEffectCode WHEN 1 THEN SI.Name ELSE NULL END,
	ConvertToQty = CASE H.ItemConversionEffectCode WHEN 1 THEN H.Qty ELSE 0 END,
	ConvertToDesc = CASE H.ItemConversionEffectCode WHEN 1 THEN SI.Remarks ELSE NULL END,
	ConvertToItemAlias = CASE H.ItemConversionEffectCode WHEN 1 THEN SI.CustomICode ELSE NULL END,
	AdjIncreaseCode = H.AdjIncreaseCode,
	AdjDecreaseCode = H.AdjDecreaseCode
FROM 
	ItemConversionHeader H, Item SI
WHERE 
	H.Date BETWEEN :adt_startdate AND :adt_enddate AND
	H.ICode = SI.ICode
UNION 
SELECT 
	RowOrder = CASE H.ItemConversionEffectCode WHEN 1 THEN 0 ELSE 1 END,
	Code=H.ItemConversionCode,
	Date=H.Date,
	Posted=H.Posted,
	UserName=(SELECT U.UserName FROM Users U WHERE U.UserCode = H.UserCode),
	ItemConversionEffectCode=H.ItemConversionEffectCode,
	Remarks=H.Remarks,
	ConvertFromGodown = (SELECT G.Name FROM Godown G WHERE G.GCode IN (CASE H.ItemConversionEffectCode WHEN 1 THEN D.GCode ELSE NULL END)),
	ConvertFromItem = CASE H.ItemConversionEffectCode WHEN 1 THEN I.Name ELSE NULL END,
	ConvertFromQty = CASE H.ItemConversionEffectCode WHEN 1 THEN D.Qty ELSE 0 END, 
	ConvertFromDesc = CASE H.ItemConversionEffectCode WHEN 1 THEN I.Remarks ELSE NULL END,
	ConvertFromItemAlias = CASE H.ItemConversionEffectCode WHEN 1 THEN I.CustomICode ELSE NULL END,
	ConvertToGodown     = (SELECT G.Name FROM Godown G WHERE G.GCode IN (CASE H.ItemConversionEffectCode WHEN 1 THEN NULL ELSE D.GCode END)),
	ConvertToItem = CASE H.ItemConversionEffectCode WHEN 1 THEN NULL ELSE I.Name END,
	ConvertToQty = CASE H.ItemConversionEffectCode WHEN 1 THEN 0 ELSE D.Qty END,
	ConvertToDesc = CASE H.ItemConversionEffectCode WHEN 1 THEN NULL ELSE I.Remarks END,
	ConvertToItemAlias = CASE H.ItemConversionEffectCode WHEN 1 THEN NULL ELSE I.CustomICode END,
	AdjIncreaseCode = H.AdjIncreaseCode,
	AdjDecreaseCode = H.AdjDecreaseCode
FROM 
	ItemConversionHeader H, ItemConversionDetail D, Item I
WHERE 
	H.Date BETWEEN :adt_startdate AND :adt_enddate AND
	H.ItemConversionCode = D.ItemConversionCode AND 
	D.ICode = I.ICode"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="code A, date A, roworder A, convertfromgodown A, convertfromitem A, convertfromqty A, converttogodown A, converttoitem A"
)
