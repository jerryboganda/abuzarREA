table(column=(type=long updatewhereclause=yes name=adjcode dbname="AdjHeader.adjcode"  )
column=(type=char(13) updatewhereclause=no name=documentcode dbname="DocumentCode"  )
column=(type=char(8) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="AdjHeader.date"  )
column=(type=long updatewhereclause=yes name=icode dbname="AdjDetail.icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="item"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="AdjDetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="AdjDetail.expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="AdjDetail.looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="AdjDetail.price"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="AdjDetail.avgprice"  )
column=(type=decimal(2) updatewhereclause=yes name=adjdetail_saleprice dbname="AdjDetail.saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="AdjDetail.purprice"  )
column=(type=long updatewhereclause=yes name=usercode dbname="AdjHeader.Usercode"  )
column=(type=char(60) updatewhereclause=yes name=user dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="AdjHeader.posted"  )
 retrieve="SELECT	h.adjcode, 
	DocumentCode=Case h.adjcatcode WHEN 1 THEN 'AI-' ELSE 'AD-' END + LTRIM(RTRIM(STR(h.adjcode,10))),
	Type=Case h.adjcatcode WHEN 1 THEN 'INCREASE' ELSE 'DECREASE' END, 
	h.date, 
	d.icode,
	aliasname=i.customicode,
	item=i.name,
	d.batch,
	d.expiry, 
	d.looseqty,
	d.price,
	d.avgprice,
	d.saleprice,
	d.purprice,
	h.Usercode,
	u.username,
	h.posted
FROM adjheader h, adjdetail d, users u, item i
WHERE 	
	h.adjcode >= :ar_scode and 
	h.adjcode <= :ar_lcode and
	h.adjcode = d.adjcode and 
	h.adjcatcode IN (:aa_adjtype)and
	h.usercode = u.usercode and
	d.icode = i.icode
ORDER BY h.adjcode, d.adjutn, i.name, i.customicode, d.batch, d.expiry
"
  arguments=(("ar_scode", number), ("ar_lcode", number), ("aa_adjtype", numberlist))
)
