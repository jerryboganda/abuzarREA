table(column=(type=char(13) updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="AdjHeader.Date"  )
column=(type=long updatewhereclause=yes name=adjcode dbname="AdjHeader.AdjCode"  )
column=(type=char(60) updatewhereclause=yes name=user dbname="Users.UserName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=decimal(8) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(4) updatewhereclause=yes name=increaseqty dbname="IncreaseQty"  )
column=(type=decimal(4) updatewhereclause=yes name=decreaseqty dbname="DecreaseQty"  )
column=(type=decimal(12) updatewhereclause=yes name=increasevalue dbname="IncreaseValue"  )
column=(type=decimal(12) updatewhereclause=yes name=decreasevalue dbname="DecreaseValue"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
 retrieve="SELECT 
	documentcode = Case h.adjcatcode WHEN 1 THEN 'AI-' ELSE 'AD-' END + LTRIM(RTRIM(STR(h.AdjCode, 10))), 
	H.Date,
	H.AdjCode, 
	U.UserName,
	ItemName=I.name,
	AliasName=I.CustomICode,
	Price=Case :ai_pricetype
		WHEN 2 THEN Round(D.purprice / D.PackUnits, 2)
		WHEN 1 THEN Round(D.Saleprice / D.PackUnits, 2)
		WHEN 3 THEN Round(D.avgprice, 2)
		END,
	IncreaseQty = ISNULL(SUM(CASE H.AdjCatCode WHEN 1 THEN looseqty ELSE 0 END), 0),
	DecreaseQty = ISNULL(SUM(CASE H.AdjCatCode WHEN 2 THEN looseqty ELSE 0 END), 0),
	IncreaseValue = ISNULL(SUM(CASE H.AdjCatCode WHEN 1 THEN looseqty * 
		Case :ai_pricetype
			WHEN 2 THEN Round(D.purprice / D.PackUnits, 2)
			WHEN 1 THEN Round(D.Saleprice / D.PackUnits, 2)
			WHEN 3 THEN Round(D.avgprice, 2)
			END ELSE 0 END), 0),
	DecreaseValue = ISNULL(SUM(CASE H.AdjCatCode WHEN 2 THEN looseqty * 
		Case :ai_pricetype
			WHEN 2 THEN Round(D.purprice / D.PackUnits, 2)
			WHEN 1 THEN Round(D.Saleprice / D.PackUnits, 2)
			WHEN 3 THEN Round(D.avgprice, 2)
			END ELSE 0 END), 0),
	Godown=G.Name

FROM
	AdjHeader H, 
	AdjDetail D,
	Item I,
	Users U,
	Godown G
WHERE
	H.AdjCode = D.AdjCode AND
	H.Date >= :ad_startdate AND H.Date <= :ad_enddate AND
	D.ICode = :ai_icode AND
	D.ICode = I.ICode AND
	D.GCode = G.GCode AND
	H.UserCode = U.UserCode
GROUP BY
	H.Date,
	H.AdjCode,
	h.adjcatcode,
	U.UserName,
	I.name,
	I.CustomICode,
	D.PurPrice,
	D.SalePrice,
	D.AvgPrice,
	D.Packunits,
	G.Name
Order By
	H.Date,
	H.AdjCode,
	U.UserName,
	I.name,
	I.CustomICode
	

"
  arguments=(("ai_icode", number), ("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_pricetype", number))
 sort="date A, adjcode A, user A, itemname A, aliasname A"
)
