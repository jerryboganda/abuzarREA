table(column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="itemaliasname"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=char(8) updatewhereclause=yes name=type dbname="type"  )
column=(type=char(100) updatewhereclause=yes name=purdetail_batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted" 
 values="Yes	Y/No	N/"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
 retrieve="SELECT
	item.Name,
	itemaliasname=item.Customicode,
	Item.PackUnits,
	Code=adjheader.Adjcode, 
	remarks=adjheader.remarks,
	Date=adjheader.Date,
	Qty = adjdetail.LooseQty,
	Rate=adjdetail.Price,
	type=CASE 
		when adjheader.adjcatcode = 1 THEN 'INCREASE'
		ELSE 'DECREASE' END,
	batch=adjdetail.batch,
	expiry=adjdetail.expiry,
	Posted=adjheader.Posted,
	UserName = (select u.username from users u where u.usercode=adjheader.usercode)
FROM
	Item,
	adjheader,
	adjdetail
WHERE 
	(Item.icode = :ar_icode ) and
	(dbo.adjdetail.icode = :ar_icode) and 
	(dbo.adjdetail.icode = Item.icode ) and 
    (dbo.adjdetail.Adjcode=dbo.adjheader.Adjcode)
ORDER BY
	date desc,
	adjheader.Adjcode,
	adjdetail.batch,
	adjdetail.expiry"
  arguments=(("ar_icode", number))
)
