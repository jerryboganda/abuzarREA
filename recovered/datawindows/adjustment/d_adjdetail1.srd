release 12.5;
datawindow ( units=0 timer_interval=60000 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=68 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(75) update=yes updatewhereclause=yes name=alternatecustomicode dbname="AdjDetail.alternatecustomicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="AdjDetail.adjcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="AdjDetail.icode"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="AdjDetail.batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes name=expiry dbname="AdjDetail.expiry"  )
column=(type=long key=yes update=yes updatewhereclause=yes initial="1" name=gcode dbname="AdjDetail.gcode"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) > 0 " validationmsg="~"Quantity should be greater than zero~"" initial="1" name=looseqty dbname="AdjDetail.looseqty"  )
column=(type=long update=yes updatewhereclause=yes name=packunits dbname="AdjDetail.packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=price dbname="AdjDetail.price"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=recentpurprice dbname="Recentpurprice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=avgprice dbname="AdjDetail.avgprice"  )
column=(type=long update=yes updatewhereclause=yes name=priority dbname="priority"  )
column=(type=decimal(0) key=yes update=yes updatewhereclause=yes name=adjutn dbname="adjutn"  )
 retrieve="SELECT 
	item.customicode,
	dbo.adjdetail.alternatecustomicode,
	item.name,  
	currlistrow = 0,
	dbo.adjdetail.adjcode,   
	dbo.adjdetail.icode,
	dbo.adjdetail.batch,
	dbo.adjdetail.expiry,
	dbo.adjdetail.gcode,
	dbo.adjdetail.looseqty,   
	dbo.adjdetail.packunits,   
	dbo.adjdetail.price,
	purprice=dbo.adjdetail.purprice,
	saleprice=dbo.adjdetail.saleprice,
	Recentpurprice=dbo.adjdetail.Recentpurprice,
	dbo.adjdetail.avgprice,
	priority=dbo.adjdetail.priority,
	adjutn=dbo.adjdetail.adjutn
FROM
	dbo.adjdetail , 
	dbo.item
WHERE
	( dbo.adjdetail.adjcode = :r_InvCode   ) AND
	( dbo.adjdetail.icode = dbo.item.icode )
	"
  update="adjdetail" updatewhere=0 updatekeyinplace=no
  arguments=(("r_InvCode", number))
)
