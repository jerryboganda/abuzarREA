 values=""  )
column=(type=long update=yes updatewhereclause=yes name=headerinvno dbname="AdjHeader.HeaderInvNo"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="AdjHeader.AccCode" 
 values=""  )
 retrieve="SELECT 
	AdjHeader.AdjCode,   
	AdjHeader.AdjCatCode,   
	AdjHeader.UserCode,   
	AdjHeader.Remarks,   
	AdjHeader.Date,   
	AdjHeader.ModifiedDate,   
	AdjHeader.ModifiedBy,   
	AdjHeader.Posted,   
	AdjHeader.PostedDate,   
	AdjHeader.PostedBy,
	gcode=0,
	AdjHeader.HeaderNo,   
	AdjHeader.HeaderInvNo,
	AdjHeader.AccCode
FROM 
	AdjHeader   
where 
	AdjHeader.AdjCode = :ar_code
"
  update="AdjHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_code", number))
)
