table(column=(type=char(13) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=adjcode dbname="AdjCode"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=decimal(8) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
 retrieve="SELECT
	doctype = Case h.adjcatcode WHEN 1 THEN 'AI-' ELSE 'AD-' END + LTRIM(RTRIM(STR(h.AdjCode, 10))), 
	Date = H.Date,
	AdjCode = H.AdjCode,
	Type = CASE H.AdjCatCode WHEN 1 THEN 'I' ELSE 'D' END,
	UserName = U.UserName,
	GroupCode=CASE :as_groupby
		WHEN 'M' THEN I.MANFCODE
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END,
	GroupName=CASE :as_groupby
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	ItemName = I.name,
	AliasName = I.CustomICode,
	Price = Case :ai_pricetype
		WHEN 2 THEN Round(D.purprice / D.PackUnits, 2)
		WHEN 1 THEN Round(D.Saleprice / D.PackUnits, 2)
		WHEN 3 THEN Round(D.avgprice, 2)
		WHEN 4 THEN Round(D.RecentPurPrice / D.PackUnits, 2)
		END,
	Qty = D.looseqty * CASE H.AdjCatCode WHEN 1 THEN 1 ELSE -1 END, 
	Godown = G.Name
FROM
	AdjHeader H, 
	AdjDetail D,
	Item I,
	Users U,
	Godown G
WHERE
	H.AdjCode = D.AdjCode AND
	H.Date >= :ad_startdate AND H.Date <= :ad_enddate AND
	D.ICode = I.ICode AND
	D.GCode = G.GCode AND
	H.UserCode = U.UserCode AND
	CASE :as_groupby
		WHEN 'M' THEN I.MANFCODE
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END IN (:ai_groupcode)

Order By
	GroupName,
	H.Date,
	I.name,
	I.CustomICode,
	H.AdjCode,
	U.UserName

"
  arguments=(("as_groupby", string), ("ai_groupcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_pricetype", number))
)
