 retrieve="SELECT 
	ItemConversionHeader.ItemConversionCode,   
	ItemConversionHeader.Date,   
	ItemConversionHeader.Posted,   
	ItemConversionHeader.PostedBy,   
	ItemConversionHeader.PostDate,   
	ItemConversionHeader.UserCode,   
	ItemConversionHeader.AdjIncreaseCode,   
	ItemConversionHeader.AdjDecreaseCode,   
	ItemConversionHeader.ItemConversionEffectCode,
	ItemConversionHeader.Remarks
FROM 
	ItemConversionHeader  
ORDER BY 
	ItemConversionHeader.ItemConversionCode ASC
"
  update="ItemConversionHeader" updatewhere=1 updatekeyinplace=no
 )
