table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=decimal(4) updatewhereclause=yes name=increaseqty dbname="IncreaseQty"  )
column=(type=decimal(12) updatewhereclause=yes name=increasevalue dbname="IncreaseValue"  )
column=(type=decimal(4) updatewhereclause=yes name=decreaseqty dbname="DecreaseQty"  )
column=(type=decimal(12) updatewhereclause=yes name=decreasevalue dbname="DecreaseValue"  )
 retrieve="SELECT
	GroupCode=GroupCode,
	GroupName=GroupName,
	IncreaseQty = SUM(IncreaseQty),
	IncreaseValue = SUM(IncreaseValue),
	DecreaseQty = SUM(DecreaseQty),
	DecreaseValue = SUM(DecreaseValue)
FROM  
	(SELECT
		GroupCode=CASE :as_groupby
			WHEN 'M' THEN I.MANFCODE
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PACKCODE END,
		GroupName=CASE :as_groupby
			WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)
			WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)
			WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)
			ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
		ICode = D.ICode,
		IncreaseQty = SUM(CASE H.AdjCatCode WHEN 1 THEN D.looseqty ELSE 0 END),
		IncreaseValue = SUM(CASE H.AdjCatCode WHEN 1 THEN D.looseqty ELSE 0 END * Case :ai_pricetype WHEN 2 THEN Round(D.purprice / D.PackUnits, 2) WHEN 1 THEN Round(D.Saleprice / D.PackUnits, 2) WHEN 3 THEN Round(D.avgprice, 2) WHEN 4 THEN Round(D.RecentPurPrice / D.PackUnits, 2) END),
		DecreaseQty = SUM(CASE H.AdjCatCode WHEN 2 THEN D.looseqty ELSE 0 END),
		DecreaseValue = SUM(CASE H.AdjCatCode WHEN 2 THEN D.looseqty ELSE 0 END * Case :ai_pricetype WHEN 2 THEN Round(D.purprice / D.PackUnits, 2) WHEN 1 THEN Round(D.Saleprice / D.PackUnits, 2) WHEN 3 THEN Round(D.avgprice, 2) WHEN 4 THEN Round(D.RecentPurPrice / D.PackUnits, 2) END)
	FROM
		AdjHeader H, 
		AdjDetail D,
		Item I
	WHERE
		H.AdjCode = D.AdjCode AND
		H.Date >= :ad_startdate AND H.Date <= :ad_enddate AND
		D.ICode = I.ICode AND
			CASE :as_groupby
				WHEN 'M' THEN I.MANFCODE
				WHEN 'C' THEN I.ICatCode
				WHEN 'L' THEN I.ICCode
				ELSE I.PACKCODE END IN (:ai_groupcode)
	GROUP BY
		D.ICode, I.MANFCODE, I.ICatCode, I.ICCode, I.PACKCODE) T
GROUP BY
	T.GroupCode,
	T.GroupName
Order By
	T.GroupName
"
  arguments=(("as_groupby", string), ("ai_groupcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_pricetype", number))
)
