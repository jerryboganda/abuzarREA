table(column=(type=char(13) updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=long updatewhereclause=yes name=adjcode dbname="AdjHeader.adjcode"  )
column=(type=char(8) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="AdjHeader.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="AdjHeader.posted"  )
column=(type=long updatewhereclause=yes name=usercode dbname="AdjHeader.Usercode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="AdjHeader.Remarks"  )
column=(type=char(60) updatewhereclause=yes name=user dbname="Users.username"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=icode dbname="AdjDetail.icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="AdjDetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="AdjDetail.expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="AdjDetail.looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="AdjDetail.price"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="AdjDetail.avgprice"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="AdjDetail.purprice"  )
 retrieve="SELECT
	DocumentCode=Case adjHeader.adjcatcode WHEN 1 THEN 'AI-' ELSE 'AD-' END + LTRIM(RTRIM(STR(adjHeader.adjcode,10))),
	dbo.adjHeader.adjcode, 
	Type = Case dbo.adjHeader.adjcatcode WHEN 1 THEN 'INCREASE' ELSE 'DECREASE' END, 
	dbo.adjheader.date, 
	dbo.adjHeader.posted,
	dbo.adjHeader.Usercode,
	dbo.adjHeader.Remarks,
	dbo.users.username,
	aliasname = dbo.item.customicode,
	itemname = dbo.item.name,
	dbo.adjDetail.icode,
	dbo.adjDetail.batch,
	dbo.adjDetail.expiry,
	dbo.adjDetail.looseqty,
	dbo.adjDetail.price,
	dbo.adjDetail.avgprice,
	saleprice=Round(dbo.adjDetail.saleprice/(case adjdetail.packunits when 0 then 1 else adjdetail.packunits end),2),
	dbo.adjDetail.purprice
FROM 
	dbo.adjHeader,
	dbo.adjDetail,
	dbo.users, 
	dbo.item
WHERE 	
	dbo.adjHeader.adjcode = :ai_adjcode and 
	dbo.adjHeader.adjcode = adjDetail.adjcode and 
	dbo.adjHeader.usercode = dbo.users.usercode and
	dbo.adjDetail.icode = dbo.item.icode
ORDER BY 
	adjutn, itemname, aliasname , batch, expiry"
  arguments=(("ai_adjcode", number))
)
