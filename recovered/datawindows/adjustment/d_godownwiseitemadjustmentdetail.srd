release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1614 color="536870912" )
summary(height=260 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="godown"  )
column=(type=decimal(4) updatewhereclause=yes name=increaseqty dbname="increaseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=decreaseqty dbname="decreaseqty"  )
column=(type=decimal(12) updatewhereclause=yes name=increasevalue dbname="increasevalue"  )
column=(type=decimal(12) updatewhereclause=yes name=decreasevalue dbname="decreasevalue"  )
 retrieve="Select 
	aliasname = item.customicode,	
 	itemname = item.name,
	godown = Godown.name, 
	increaseqty = IsNull (Sum (CASE AdjHeader.AdjCatCode When 1 Then adjdetail.looseqty ELSE 0 END ) , 0 ),
	decreaseqty = IsNull (Sum (CASE AdjHeader.AdjCatCode When 2 Then adjdetail.looseqty ELSE 0 END ) , 0 ),
	increasevalue = IsNull (Round (Sum (CASE AdjHeader.AdjCatCode When 1 Then adjdetail.looseqty 
									*		
									Round(CASE :ai_pricetype WHEN 1 THEN AdjDetail.saleprice / AdjDetail.PackUnits WHEN 2 THEN AdjDetail.purprice / AdjDetail.PackUnits ELSE AdjDetail.avgprice END, 2)
									Else 0
									END
											) , 2 ), 0 ),
	decreasevalue = IsNull (Round (Sum (CASE AdjHeader.AdjCatCode When 2 Then adjdetail.looseqty 
									*		
									Round(CASE :ai_pricetype WHEN 1 THEN AdjDetail.saleprice / AdjDetail.PackUnits WHEN 2 THEN AdjDetail.purprice / AdjDetail.PackUnits ELSE AdjDetail.avgprice END, 2)
									Else 0
									END
											) , 2 ), 0 )

From Item , AdjHeader , AdjDetail , Godown

Where AdjHeader.AdjCode = AdjDetail.AdjCode AND
      AdjDetail.icode  = Item.Icode AND
      AdjDetail.gcode = :ai_gcode AND
		AdjDetail.gcode = Godown.Gcode AND
		AdjHeader.Date >= :ad_startdate AND AdjHeader.Date <= :ad_enddate

Group By 
			Item.Name , 
			Item.customicode,
			Godown.Name

Order By itemname




"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_pricetype", number), ("ai_gcode", number))
 sort="itemname A, aliasname A"
)
