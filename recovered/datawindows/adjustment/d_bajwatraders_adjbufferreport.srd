release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=750 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1843 color="536870912" )
summary(height=812 color="536870912" )
footer(height=260 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="AdjBufferHeader.adjbuffercode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="AdjBufferHeader.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="AdjBufferHeader.posted"  )
column=(type=long updatewhereclause=yes name=usercode dbname="AdjBufferHeader.Usercode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="AdjBufferHeader.Remarks"  )
column=(type=char(60) updatewhereclause=yes name=user dbname="Users.username"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=stockinhand dbname="AdjBufferDetail.stockinhand"  )
column=(type=decimal(4) updatewhereclause=yes name=stockonshelf dbname="AdjBufferDetail.stockonshelf"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="godown"  )
 retrieve="SELECT	dbo.adjBufferHeader.adjbuffercode, 
			dbo.adjBufferheader.date, 
			dbo.adjBufferHeader.posted,
			dbo.adjBufferHeader.Usercode,
			dbo.adjBufferHeader.Remarks,
			dbo.users.username,
			aliasname = dbo.item.customicode,
			itemname = dbo.item.name,
			dbo.adjbufferdetail.stockinhand,
			dbo.adjbufferdetail.stockonshelf,
			godown=(select name from godown where godown.gcode=adjbufferheader.gcode)

FROM 	 dbo.adjbufferHeader,
		 dbo.adjbufferDetail,
		 dbo.users, 
		 dbo.item

WHERE 	dbo.adjBufferHeader.adjbuffercode = :ai_adjcode and 
			dbo.adjBufferHeader.adjbuffercode = adjBufferDetail.adjbuffercode and 
			dbo.adjBufferHeader.usercode = dbo.users.usercode and
			dbo.adjBufferDetail.icode = dbo.item.icode

ORDER BY rowid"
  arguments=(("ai_adjcode", number))
)
