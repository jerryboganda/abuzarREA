table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(75) update=yes updatewhereclause=yes name=alternatecustomicode dbname="ItemConversionDetail.alternatecustomicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ItemConversionDetail.ItemConversionCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=gcode dbname="ItemConversionDetail.gcode" 
 values=""  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ItemConversionDetail.icode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=saleprice dbname="ItemConversionDetail.SalePrice"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="ItemConversionDetail.packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" initial="0" name=unitprice dbname="ItemConversionDetail.UnitPrice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=stock dbname="ItemConversionDetail.GodownStock"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=totalstock dbname="ItemConversionDetail.TotalStock"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="ItemConversionDetail.RowID"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) > 0" initial="1" name=qty dbname="ItemConversionDetail.qty"  )
 retrieve="SELECT 	
	item.customicode,
	dbo.ItemConversionDetail.alternatecustomicode,
	item.name, 
	currlistrow = 0,
	dbo.ItemConversionDetail.ItemConversionCode,
	dbo.ItemConversionDetail.gcode,
	dbo.ItemConversionDetail.icode,
	dbo.ItemConversionDetail.SalePrice,
	dbo.ItemConversionDetail.packunits,      
	dbo.ItemConversionDetail.UnitPrice,
	dbo.ItemConversionDetail.GodownStock,
	dbo.ItemConversionDetail.TotalStock,
	dbo.ItemConversionDetail.RowID,
	dbo.ItemConversionDetail.qty
FROM 
	dbo.ItemConversionDetail, 
	dbo.item
WHERE 
	( dbo.ItemConversionDetail.ItemConversionCode = :r_InvCode )   and
	( dbo.ItemConversionDetail.icode = dbo.item.icode )"
  update="ItemConversionDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("r_InvCode", number))
)
