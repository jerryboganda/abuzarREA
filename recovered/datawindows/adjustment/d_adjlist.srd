detail(height=72 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=code dbname="AdjHeader.adjcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="AdjHeader.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=char(60) updatewhereclause=yes name=account dbname="Account"  )
 retrieve="SELECT adjheader.adjcode , 
	adjheader.date , 
	posted = adjheader.posted,
	Remarks=adjheader.Remarks,
	PostedBy = IsNull((Select username from users 
				where dbo.adjheader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
				where dbo.adjheader.modifiedby = dbo.users.usercode), ''),
	Account = (SELECT A.Name FROM Accounts A WHERE A.AccCode = adjheader.AccCode)
FROM  
	adjheader  
WHERE  
	(  adjheader.adjcatcode = 2 ) AND  
	( Posted IN (:as_Posted)) AND 
	( adjheader.headerno IS NULL OR 
		adjheader.headerno in 
				(SELECT headercode FROM GroupAllowedHeader 
				WHERE GroupCode = :ai_groupcode and module = :ai_module))"
  update="adjheader" updatewhere=0 updatekeyinplace=no
  arguments=(("as_Posted", stringlist), ("ai_groupcode", number), ("ai_module", number))
)
