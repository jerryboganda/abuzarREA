table(column=(type=long key=yes updatewhereclause=yes name=servicerinvcode dbname="ServiceRHeader.ServiceRInvCode"  )
column=(type=long update=yes updatewhereclause=yes name=custcode dbname="ServiceRHeader.CustCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=originaldate dbname="ServiceRHeader.OriginalDate"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ServiceRHeader.Date"  )
column=(type=long updatewhereclause=yes name=headerno dbname="ServiceRHeader.HeaderNo"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="ServiceRHeader.HeaderInvNo"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="ServiceRHeader.InvTotal"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="ServiceRHeader.OutStandingAmt"  )
column=(type=long updatewhereclause=yes name=salesmancode dbname="ServiceRHeader.SalesmanCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=servicercatcode dbname="ServiceRHeader.ServiceRCatCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ServiceRHeader.Remarks"  )
column=(type=long update=yes updatewhereclause=yes name=doctcode dbname="ServiceRHeader.DoctCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="ServiceRHeader.PatientCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=guestcode dbname="ServiceRHeader.GuestCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=studentcode dbname="ServiceRHeader.StudentCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes name=marked dbname="ServiceRHeader.Marked" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=motorvehiclecode dbname="ServiceRHeader.MotorVehicleCode" 
 values=""  )
 retrieve="SELECT 
	ServiceRInvCode, 
	CustCode, 
	OriginalDate, 
	Date, 
	HeaderNo,
	HeaderInvNo,
	InvTotal, 
	OutStandingAmt,
	SalesmanCode, 
	ServiceRCatCode, 
	Remarks,
	DoctCode, 
	PatientCode, 
	GuestCode, 
	StudentCode, 
	Marked,
	MotorVehicleCode
FROM 	ServiceRHeader
WHERE 
	ServiceRHeader.custcode = CASE :ai_all WHEN 0 THEN :al_custcode ELSE ServiceRHeader.custcode END AND
	ServiceRHeader.originaldate BETWEEN :ad_sdate AND :ad_edate
"
  update="ServiceRHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_all", number), ("al_custcode", number), ("ad_sdate", datetime), ("ad_edate", datetime))
)
