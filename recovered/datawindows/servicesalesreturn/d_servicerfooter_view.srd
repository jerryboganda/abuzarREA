table(column=(type=long key=yes updatewhereclause=yes name=code dbname="ServiceRHeader.servicerinvcode"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0 AND Real (GetText()) <= 100" validationmsg="'Value should be between 0 and 100'" initial="0.00" name=discperc dbname="ServiceRHeader.discperc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=flatdisc dbname="ServiceRHeader.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=misccharges dbname="ServiceRHeader.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0 AND Real (GetText()) <= 100" validationmsg="'Value should be between 0 and 100'" initial="0" name=serviceinvgstperc dbname="ServiceRHeader.ServiceInvGstPerc"  )
column=(type=long updatewhereclause=yes initial="0" name=icode dbname="icode"  )
column=(type=long updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=long updatewhereclause=yes initial="0" name=retableqty dbname="retableqty"  )
column=(type=long updatewhereclause=yes initial="0" name=saleqty dbname="saleqty"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=total dbname="total"  )
 retrieve="SELECT
	SVCRH.servicerinvcode,   
	SVCRH.discperc,   
	SVCRH.flatdisc,   
	SVCRH.misccharges,
	SVCRH.ServiceInvGstPerc,
	icode = 0, 
	stock = 0, 
	retableqty = 0,
	saleqty = 0 ,
	total = SVCRH.InvTotal
FROM 
	servicerheader SVCRH  
WHERE 
	SVCRH.servicerinvcode =:ai_servicerinvcode   
"
  update="servicerheader" updatewhere=0 updatekeyinplace=no
  arguments=(("ai_servicerinvcode", number))
)
