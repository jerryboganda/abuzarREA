summary(height=72 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceSRAllocationDetail.ServiceSRAllocationCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=serviceinvcode dbname="ServiceSRAllocationDetail.ServiceInvCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes initial="today" name=saledate dbname="ServiceHeader.Date"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=netamt dbname="ServiceHeader.InvTotal"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=outstandingamt dbname="ServiceSRAllocationDetail.OutstandingAmt"  )
column=(type=long updatewhereclause=yes name=rowid dbname="ServiceSRAllocationDetail.ROWID"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=utn dbname="ServiceSRAllocationDetail.UTN"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) > 0" initial="0" name=amt dbname="ServiceSRAllocationDetail.Amt"  )
 retrieve="SELECT
	ServiceSRAllocationDetail.ServiceSRAllocationCode,
	ServiceSRAllocationDetail.ServiceInvCode,
	ServiceHeader.Date,
	ServiceHeader.InvTotal,
	ServiceSRAllocationDetail.OutstandingAmt,
	ServiceSRAllocationDetail.IDENTITYCOL,
	ServiceSRAllocationDetail.UTN,
	ServiceSRAllocationDetail.Amt
FROM
	ServiceSRAllocationDetail,
	ServiceSRAllocationHeader,
	ServiceHeader
WHERE
	( ServiceSRAllocationHeader.ServiceSRAllocationCode = :Code ) AND
	( ServiceSRAllocationHeader.ServiceSRAllocationCode = ServiceSRAllocationDetail.ServiceSRAllocationCode ) and  
	( ServiceSRAllocationDetail.ServiceInvCode = ServiceHeader.ServiceInvCode )
ORDER BY
	ServiceSRAllocationDetail.ServiceSRAllocationCode,   
	ServiceSRAllocationDetail.IDENTITYCOL,
	ServiceSRAllocationDetail.ServiceInvCode
"
  update="ServiceSRAllocationDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("Code", number))
)
