footer(height=67 color="536870912" )
detail(height=67 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=servicecode dbname="Service.servicecode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=smancode dbname="ServiceRDetail.smancode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real( GetText() ) > 0" validationmsg="'Value should not be negative'" initial="1" name=qty dbname="ServiceRDetail.qty"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceqty dbname="ServiceQty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="'Value should not be negative'" name=serviceprice dbname="ServiceRDetail.ServicePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="'Value should not be negative'" initial="0" name=serviceflatdisc dbname="ServiceRDetail.ServiceFlatDisc"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=allowsaleindecimal dbname="AllowSaleInDecimal"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceRDetail.servicerinvcode"  )
column=(type=long key=yes updatewhereclause=yes name=srvrrowid dbname="ServiceRDetail.srvrrowid"  )
column=(type=long update=yes updatewhereclause=yes name=srvrowid dbname="ServiceRDetail.srvrowid"  )
column=(type=long updatewhereclause=yes name=retqty dbname="retqty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="'Value should not be negative'" initial="0.00" name=commission dbname="ServiceRDetail.commission"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0 AND Real (GetText()) <= 100" validationmsg="'Value should be between 0 and 100'" initial="0.00" name=shareperc dbname="ServiceRDetail.SharePerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="'Value should not be negative'" initial="0" name=serviceflattax dbname="ServiceRDetail.ServiceFlatTax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0 AND Real (GetText()) <= 100" validationmsg="'Value should be between 0 and 100'" initial="0" name=servicegstperc dbname="ServiceRDetail.ServiceGstPerc"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0.00" name=costprice dbname="ServiceRDetail.CostPrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0 AND Real (GetText()) <= 100" validationmsg="'Value should be between 0 and 100'" initial="0.00" name=discperc dbname="ServiceRDetail.discperc"  )
 retrieve="SELECT 
	fullcode=service.aliasname,
	service.servicecode,
	SVCRD.smancode,   
	SVCRD.qty,
	ServiceQty = SVCRD.qty,
	SVCRD.ServicePrice,
	SVCRD.ServiceFlatDisc,
	AllowSaleInDecimal=Service.AllowSaleInDecimal,
	currlistrow = 0,
	SVCRD.servicerinvcode,
	SVCRD.srvrrowid,
	SVCRD.srvrowid,
	retqty = 0,
	SVCRD.commission,
	SVCRD.SharePerc,
	SVCRD.ServiceFlatTax,
	SVCRD.ServiceGstPerc,
	SVCRD.CostPrice,
	SVCRD.discperc
FROM 
	servicerdetail SVCRD,
	service  
WHERE 
	( SVCRD.servicecode = service.servicecode ) and  
	( SVCRD.servicerinvcode = :ra_salesretinvno )
"
  update="servicerdetail" updatewhere=0 updatekeyinplace=yes
  arguments=(("ra_salesretinvno", number))
)
