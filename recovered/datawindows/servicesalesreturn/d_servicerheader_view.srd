column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=outstandingamt dbname="ServiceRHeader.OutstandingAmt"  )
 retrieve="SELECT
	SVCRH.servicerinvcode ,
	SVCRH.serviceinvcode ,
	SVCRH.date ,
	SVCRH.servicercatcode ,
	SVCRH.custcode ,
	SVCRH.doctcode ,
	SVCRH.salesmancode ,
	SVCRH.discperc ,
	SVCRH.flatdisc ,
	SVCRH.misccharges ,
	users.username ,
	SVCH.date ,
	SVCRH.headerno ,
	SVCRH.posted ,
	SVCRH.postdate ,
	SVCRH.remarks ,
	accounts.aliasname ,
	accounts.name ,
	customer.address1 ,
	customer.city ,
	customer.phone,
	SVCRH.originaldate,
	SVCRH.modifiedby,
	SVCRH.postedby,	   
	doctors.name,
	patientregno=space(50),
	SVCRH.patientcode,
	SVCRH.admissioncode,
	GuestRegNo=(SELECT G.RegNo FROM Guest G WHERE G.GuestCode=SVCRH.GuestCode),
	SVCRH.GuestCode,
	SVCRH.GuestCheckInCode,
	StudentRegNo=(SELECT ST.RegNo FROM Student ST WHERE ST.StudentCode=SVCRH.StudentCode),
	SVCRH.StudentCode,
	SVCRH.ServiceInvGstPerc,
	SVCRH.CashAccCode,
	SVCRH.CashTendered,
	SVCRH.CashCharged,
	SVCRH.CashBack,
	SVCRH.InvTotal,
	SVCRH.OutstandingAmt
	
FROM
	accounts ,
	customer ,
	serviceheader SVCH LEFT OUTER JOIN Doctors ON (SVCH.doctcode = doctors.doctcode),
	users ,
	servicerheader SVCRH
WHERE 
	( SVCRH.servicerinvcode = :ai_servicerinvcode ) and
/*	( SVCRH.serviceinvcode = SVCH.serviceinvcode ) and   */
   ( SVCH.custcode = customer.custcode ) and          
	( SVCRH.salesmancode = users.usercode ) and          
	( SVCH.custcode = accounts.acccode )
"
  arguments=(("ai_servicerinvcode", number))
)
