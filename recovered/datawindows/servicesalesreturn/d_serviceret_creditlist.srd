header(height=80 color="536870912" )
summary(height=76 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="ServiceRHeader.servicerinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ServiceRHeader.date"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ServiceRHeader.remarks"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceRHeader.serviceinvcode"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
 retrieve="SELECT  
	servicerheader.servicerinvcode , 
	servicerheader.date , 
	InvTotal = ServiceRHeader.InvTotal,
	servicerheader.remarks , 
	servicerheader.serviceinvcode,
	accounts.name,
	posted = servicerheader.posted,
	PostedBy = IsNull((Select username from users where dbo.servicerheader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users where dbo.servicerheader.modifiedby = dbo.users.usercode), '') 
FROM
	accounts,
	servicerheader
WHERE  
	( servicerheader.custcode = accounts.acccode ) and 
	( dbo.servicerheader.servicercatcode = 14 or 
	dbo.servicerheader.servicercatcode = 15 )   and
	( dbo.servicerheader.admissioncode is null ) and
	( Posted IN (:as_Posted))"
  arguments=(("ai_ServiceRCatCode", number), ("as_Posted", stringlist))
)
