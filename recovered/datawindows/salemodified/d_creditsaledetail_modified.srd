table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="." name=batch dbname="batch"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=expiry dbname="expiry"  )
column=(type=char(1) updatewhereclause=yes name=locksaleprice dbname="locksaleprice"  )
column=(type=char(1) updatewhereclause=yes name=lockdiscperc dbname="lockdiscperc"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=long updatewhereclause=yes name=qtysale dbname="qtysale"  )
column=(type=long updatewhereclause=yes name=bonus dbname="bonus"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=recentpurprice dbname="recentpurprice"  )
column=(type=decimal(3) update=yes updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=updatesaleprice dbname="updatesaleprice"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SaleDetailModified.saleinvcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=gcode dbname="gcode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Item flat Disc should be greater than zero~"" name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="RowId"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=rate dbname="rate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=salestax dbname="salestax"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=balancestock dbname="balancestock"  )
column=(type=char(1) update=yes updatewhereclause=yes name=due dbname="Due"  )
column=(type=datetime update=yes updatewhereclause=yes name=satisfieddate dbname="SatisfiedDate"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=dueqty dbname="DueQty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Qty should be greater than zero'" initial="0" name=packqty dbname="packqty"  )
column=(type=char(100) update=yes updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=claimable dbname="claimable" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=0 and Real(GetText()) < 100" validationmsg="'Dsicount % value should be between 0 and 100'" name=discperc dbname="discperc"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="retailprice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=packprice dbname="packprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=bonusqty dbname="bonusqty"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=rowgroup dbname="SaleDetailModified.rowgroup"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=looseqty dbname="looseqty"  )
 retrieve="   SELECT item.customicode,
			itemname= item.name,
			batch = saledetailmodified.batch,
			expiry = saledetailmodified.expiry, 
			locksaleprice = dbo.item.locksaleprice,
			lockdiscperc = dbo.item.lockdiscperc,
			currlistrow = 0,
			stock     = 0.0000 , 
			qtysale=item.saleqty,
			bonus=item.bonusqty,
			totalstock= 0.0000 , 
			purprice=0.00,
			recentpurprice=0.00,
			avgprice=0.000,
			itemtotalval=space(30),
			assgcode  = 1, 
			updatesaleprice = 'N',
         saledetailmodified.saleinvcode,   
         icode = saledetailmodified.icode,   
         gcode = saledetailmodified.gcode,
			itemflatdisc = saledetailmodified.itemflatdisc,
			RowId     = saledetailmodified.IDENTITYCOL, 
			packunits = saledetailmodified.packunits,
	 		saleprice = saledetailmodified.saleprice,
	 		rate      = saledetailmodified.rate,
         salestax  = saledetailmodified.salestax, 
         balancestock  = saledetailmodified.balancestock , 
         Due       = Due,
			SatisfiedDate = SatisfiedDate,
			DueQty    = 0.0000,
			packqty   = saledetailmodified.packqty,
         SaleItemDescription =  saledetailmodified.SaleItemDescription,
			claimable = saledetailmodified.claimable,
			discperc  = saledetailmodified.discperc,
			itemcode = 0,
			retailprice=item.retailprice,
			packprice = saledetailmodified.packprice,
			unitsalestax = saledetailmodified.unitsalestax,
			gstperc = saledetailmodified.gstperc,
			bonusqty = saledetailmodified.bonusqty,
			saledetailmodified.rowgroup,
			looseqty  = saledetailmodified.looseqty 

    FROM saledetailmodified,   
         item 

   WHERE ( dbo.saledetailmodified.saleinvcode = :ar_SaleInvCode )    AND
		   ( saledetailmodified.icode = item.icode )
         
ORDER BY saledetailmodified.IDENTITYCOL"
  update="saledetailmodified" updatewhere=0 updatekeyinplace=yes
  arguments=(("ar_SaleInvCode", number))
)
