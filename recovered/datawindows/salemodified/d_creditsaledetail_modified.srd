compute(name=c_detaildwtotal visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="5513" y="4" height="60" width="352" format="###,##,##,##0.00" expression="sum((  ( looseqty *  (saleprice -  itemflatdisc ))  +   ( packqty * (saleprice -  itemflatdisc )  * packunits ) ) *  ( 1-  (  discperc  *  .01 )  )  for all) " alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
