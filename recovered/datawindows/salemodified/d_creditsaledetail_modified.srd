compute(name=c_sumgstval visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="6711" y="8" height="60" width="238" format="###0.00" expression="sum( round( c_itemtotal  *  gstperc * 0.01,2)  for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
