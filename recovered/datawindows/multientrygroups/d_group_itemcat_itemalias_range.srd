release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80269524 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=72 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=long updatewhereclause=yes name=itemcount dbname="ItemCount"  )
column=(type=char(75) updatewhereclause=yes name=minimum dbname="MINIMUM"  )
column=(type=char(75) updatewhereclause=yes name=maximum dbname="MAXIMUM"  )
 retrieve="SELECT 
	Code=C.ICatCode, 
	Category=C.Name, 
	ItemCount=Count(I.CustomICode), 
	MINIMUM=MIN(I.CustomICode), 
	MAXIMUM=MAX(I.CustomICode)
FROM 
	ITEMCATEGORY C, 
	ITEM I, 
	GROUPS G, 
	ITEMSGROUPCATEGORY IGC
WHERE 
	G.GroupCode = :ai_groupcode AND
	G.GroupCode = IGC.GroupCode AND
	IGC.ItemsCategoryCode = I.ICatCode AND
	I.ICatCode = C.ICatCode	AND
	(SELECT A=DBO.Fn_GetPreference('GroupCategoryRights')) = 'Y'
GROUP BY C.ICatCode, C.Name
UNION ALL
SELECT 
	Code=C.ICatCode, 
	Category=C.Name, 
	ItemCount=Count(I.CustomICode), 
	MINIMUM=MIN(I.CustomICode), 
	MAXIMUM=MAX(I.CustomICode)
FROM 
	ITEMCATEGORY C, 
	ITEM I
WHERE 
	I.ICatCode = C.ICatCode	AND
	(SELECT A=DBO.Fn_GetPreference('GroupCategoryRights')) = 'N'
GROUP BY C.ICatCode, C.Name
ORDER BY Category"
  arguments=(("ai_groupcode", number))
)
