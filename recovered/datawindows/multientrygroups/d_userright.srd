 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"userrights~" ) COLUMN(NAME=~"userrights.UserCode~") COLUMN(NAME=~"userrights.RightCode~") COLUMN(NAME=~"userrights.Status~")WHERE(    EXP1 =~"userrights.UserCode~"   OP =~"=~"    EXP2 =~":Ucode~" ) ) ARG(NAME = ~"Ucode~" TYPE = number) "
  update="userrights" updatewhere=0 updatekeyinplace=yes
  arguments=(("Ucode", number))
)
