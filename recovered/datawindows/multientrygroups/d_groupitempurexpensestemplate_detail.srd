 retrieve="SELECT 
	GroupCode=GroupCode,
	QExp1_Caption=QExp1_Caption,
	QExp1_AccCode=QExp1_AccCode,
	QExp1_CrAccCode=QExp1_CrAccCode,
	QExp2_Caption=QExp2_Caption,
	QExp2_AccCode=QExp2_AccCode,
	QExp2_CrAccCode=QExp2_CrAccCode,
	QExp3_Caption=QExp3_Caption,
	QExp3_AccCode=QExp3_AccCode,
	QExp3_CrAccCode=QExp3_CrAccCode,
	QExp4_Caption=QExp4_Caption,
	QExp4_AccCode=QExp4_AccCode,
	QExp4_CrAccCode=QExp4_CrAccCode,
	QExp5_Caption=QExp5_Caption,
	QExp5_AccCode=QExp5_AccCode,
	QExp5_CrAccCode=QExp5_CrAccCode,
	WExp1_Caption=WExp1_Caption,
	WExp1_AccCode=WExp1_AccCode,
	WExp1_CrAccCode=WExp1_CrAccCode,
	WExp2_Caption=WExp2_Caption,
	WExp2_AccCode=WExp2_AccCode,
	WExp2_CrAccCode=WExp2_CrAccCode,
	WExp3_Caption=WExp3_Caption,
	WExp3_AccCode=WExp3_AccCode,
	WExp3_CrAccCode=WExp3_CrAccCode,
	WExp4_Caption=WExp4_Caption,
	WExp4_AccCode=WExp4_AccCode,
	WExp4_CrAccCode=WExp4_CrAccCode,
	WExp5_Caption=WExp5_Caption,
	WExp5_AccCode=WExp5_AccCode,
	WExp5_CrAccCode=WExp5_CrAccCode
FROM
	ItemPurExpTemplate
WHERE 
	GroupCode = :ai_code"
  update="ItemPurExpTemplate" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
