table(column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.UserName"  )
column=(type=char(100) updatewhereclause=yes name=users_address dbname="Users.Address"  )
column=(type=long key=yes updatewhereclause=yes name=code dbname="Users.UserCode"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active" 
 values="Yes	Y/No	N/"  )
 retrieve="Select    Users.UserName,
		    Users.Address, 
   		    Users.UserCode, 
			Active=Users.Active
  FROM Users
  Where Users.Usercode In ( Select Distinct UserCode From UserGroups Where GroupCode <> 2 )
Union
SELECT Users.UserName,   
	         Users.Address,   
   		    Users.UserCode, 
			Active=Users.Active
  FROM Users
  Where Users.Usercode In ( Select Distinct UserCode From UserGroups Where GroupCode = :al_usergroup )
Union
SELECT Users.UserName,   
	         Users.Address,   
   		    Users.UserCode, 
			Active=Users.Active
  FROM Users
  Where Users.Usercode Not In ( Select Distinct UserCode From UserGroups )
"
  update="Users" updatewhere=0 updatekeyinplace=no
  arguments=(("al_usergroup", number))
)
