table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Groups.groupcode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=groupname dbname="Groups.groupname"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Groups.remarks"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=saleitemdiscperc dbname="Groups.saleitemdiscperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=saleinvflatdisc dbname="Groups.saleinvflatdisc"  )
column=(type=long update=yes updatewhereclause=yes name=defaultservicetemplatecode dbname="Groups.DefaultServiceTemplateCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=autorefreshitemlist dbname="Groups.AutoRefreshItemList" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" initial="0" name=autorefreshitemlisttime dbname="Groups.AutoRefreshItemListTime"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" initial="0" name=accumulateddiscperc dbname="Groups.AccumulatedDiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100 AND real(gettext()) <= accumulateddiscperc" validationmsg="~"Please enter valid accumulated discount percentage caution limit~"" initial="0" name=accumdiscperccaution dbname="Groups.AccumDiscPercCaution"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid service discount percentage limit~"" initial="0" name=servicediscperclimit dbname="Groups.ServiceDiscPercLimit"  )
column=(type=datetime update=yes updatewhereclause=yes initial="now" name=servicedeliverytime dbname="Groups.ServiceDeliveryTime"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid service flat discount amount~"" initial="0" name=maxserviceflatdisc dbname="Groups.MaxServiceFlatDisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid service invoice flat discount amount~"" initial="0" name=maxserviceinvflatdisc dbname="Groups.MaxServiceInvFlatDisc"  )
column=(type=long update=yes updatewhereclause=yes name=saletypecode dbname="Groups.SaleTypeCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=salepriceinitemlist dbname="Groups.SalePriceInItemList" 
 values="Sale Price	1/Sale Price 2	2/Sale Price 3	3/Sale Price 4	4/Sale Price 5	5/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=consideralldiscountsonitem dbname="Groups.ConsiderAllDiscountsOnItem" 
 values="Consider All sorts of Discounts on Item	Y/Consider All sorts of Discounts on Item	N"  )
 retrieve="SELECT 
	groupcode,   
	groupname,   
	remarks ,
	saleitemdiscperc,
	saleinvflatdisc,
	DefaultServiceTemplateCode,
	AutoRefreshItemList,
	AutoRefreshItemListTime,
	AccumulatedDiscPerc,
	AccumDiscPercCaution,
	ServiceDiscPercLimit,
	ServiceDeliveryTime,
	MaxServiceFlatDisc,
	MaxServiceInvFlatDisc,
	SaleTypeCode,
	SalePriceInItemList,
	ConsiderAllDiscountsOnItem
FROM 
	dbo.groups  
WHERE 
	dbo.groups.groupcode = :code    
"
  update="groups" updatewhere=1 updatekeyinplace=yes
  arguments=(("code", number))
)
