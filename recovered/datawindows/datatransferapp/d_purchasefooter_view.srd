table(column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=invgstperc1 dbname="Purledger.invgstperc1"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=purinvcode dbname="Purledger.purinvcode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0  AND Real(GetText()) <=100" initial="0" name=discperc dbname="Purledger.discperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=flatdisc dbname="Purledger.flatdisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=misccharges dbname="Purledger.misccharges"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=salestax dbname="Purledger.salestax"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(3) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="Itemtotalval"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=total dbname="total"  )
 retrieve="  SELECT dbo.purledger.invgstperc1,
			dbo.purledger.purinvcode,   
         dbo.purledger.discperc,   
         dbo.purledger.flatdisc,   
         dbo.purledger.misccharges,   
         dbo.purledger.salestax,  
			icode=0,
			stock=0.0000,
			totalstock=0.000,
			Itemtotalval=space(30),
			total=dbo.purledger.invtotal
  FROM   dbo.purledger   
  WHERE 	dbo.purledger.PurInvCode = :al_PurInvCode
"
  update="purledger" updatewhere=1 updatekeyinplace=no
  arguments=(("al_PurInvCode", number))
)
