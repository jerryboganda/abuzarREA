footer(height=0 color="536870912" )
detail(height=212 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=transcode dbname="Theader.TransCode"  )
column=(type=long update=yes updatewhereclause=yes name=sgcode dbname="Theader.SGCode"  )
column=(type=long update=yes updatewhereclause=yes name=dgcode dbname="Theader.DGCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Theader.Date"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Theader.Remarks"  )
column=(type=long update=yes updatewhereclause=yes name=salesmancode dbname="Theader.Salesmancode"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="Theader.Posted"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="Theader.PostDate"  )
column=(type=datetime update=yes updatewhereclause=yes name=startdate dbname="Theader.StartDate"  )
column=(type=datetime update=yes updatewhereclause=yes name=enddate dbname="Theader.EndDate"  )
column=(type=long update=yes updatewhereclause=yes name=ttcode dbname="Theader.TTCode"  )
column=(type=long update=yes updatewhereclause=yes name=headerno dbname="Theader.HeaderNo"  )
column=(type=long update=yes updatewhereclause=yes name=headerinvno dbname="Theader.HeaderInvNo"  )
 retrieve="  SELECT Theader.TransCode,   
         Theader.SGCode,   
         Theader.DGCode,   
         Theader.Date ,
			Theader.Remarks,
			Theader.Salesmancode,
			Theader.Posted,
			Theader.PostDate,
			Theader.StartDate,
			Theader.EndDate,
			Theader.TTCode,
			Theader.HeaderNo,
			Theader.HeaderInvNo
    FROM Theader
   WHERE (Theader.TransCode = :ar_tcode)"
  update="Theader" updatewhere=1 updatekeyinplace=no
  arguments=(("ar_tcode", number))
)
