release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80269524 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=132 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=invoicecode dbname="Theader.TransCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Theader.Date"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="Theader.SGCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="SourceGodown"  )
column=(type=char(60) updatewhereclause=yes name=aliasname dbname="TargetGodown"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=netamt dbname="NetAmt"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="Theader.Posted" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes name=oldtransferable dbname="OldTransferable"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=transfered dbname="Theader.Transfered" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=transferedby dbname="Theader.TransferedBy" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=transferable dbname="Theader.Transferable" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	Theader.TransCode,
	Theader.Date,
	Theader.SGCode,
	SourceGodown= (SELECT name from Godown WHERE gcode = Theader.SGCode),
	TargetGodown= (SELECT name from Godown WHERE gcode = Theader.DGCode),
	NetAmt=SUM(TDetail.Qty * TDetail.SalePrice),
	Theader.Posted,
	OldTransferable=Theader.Transferable,
	Theader.Transfered,
	Theader.TransferedBy,
	Theader.Transferable
FROM 
	Theader, TDetail
WHERE
	THeader.TransCode IN (:ia_invoices) AND
	Theader.TransCode = TDetail.TransCode
GROUP BY
	Theader.TransCode,
	Theader.Date,
	Theader.SGCode,
	Theader.DGCode,
	Theader.Posted,
	Theader.Transferable,
	Theader.Transfered,
	Theader.TransferedBy"
  update="Theader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ia_invoices", numberlist))
)
