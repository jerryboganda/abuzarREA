column=(type=char(1) updatewhereclause=yes name=oldtransferable dbname="OldTransferable"  )
column=(type=char(1) update=yes updatewhereclause=yes name=transfered dbname="Transfered" 
 values="	Y/	N"  )
column=(type=long update=yes updatewhereclause=yes name=transferedby dbname="TransferedBy" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes name=transferable dbname="Transferable" 
 values="	Y/	N"  )
 retrieve="SELECT
	Invoicecode=dbo.glheader.glvochcode ,
	glvochcode=dbo.glheader.glvochcode ,
	VochCatCode=GLHeader.VochCatCode,
	VoucherCode=dbo.glheader.vouchercode ,
	Date=dbo.glheader.date ,
	AliasName=dbo.accounts.aliasname ,
	dbo.glheader.acccode,
	Name=dbo.accounts.name ,
	Posted=dbo.glheader.posted,
	PostDate=dbo.glheader.postdate,
	salesmancode=dbo.glheader.salesmancode,
	Remarks=glheader.remarks,
	OldTransferable=glheader.Transferable,
	Transfered=glheader.Transfered,
	TransferedBy=glheader.TransferedBy,
	Transferable=glheader.Transferable
FROM
	dbo.glheader,
	dbo.accounts     
WHERE 
	dbo.glheader.acccode = dbo.accounts.acccode
"
  update="glheader" updatewhere=2 updatekeyinplace=yes
 )
