table(column=(type=long key=yes update=yes updatewhereclause=yes name=transferlogid dbname="DataTransferLog.TRANSFERLOGID"  )
column=(type=datetime update=yes updatewhereclause=yes name=logdate dbname="DataTransferLog.LOGDATE"  )
column=(type=long update=yes updatewhereclause=yes name=transferedby dbname="DataTransferLog.TRANSFEREDBY" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=invoicecode dbname="DataTransferLog.INVOICECODE"  )
column=(type=long update=yes updatewhereclause=yes name=invoicetype dbname="DataTransferLog.INVOICETYPE" 
 values="Sale	1/Sale Return	2/Purchase	3/Purchase Return	4/Transfer	8/A//c Voucher	0/"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="DataTransferLog.DATE"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="DataTransferLog.ACCCODE" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=sgcode dbname="DataTransferLog.SGCODE" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=dgcode dbname="DataTransferLog.DGCODE" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=status dbname="DataTransferLog.STATUS" 
 values="Failure	0/Success	1/"  )
 retrieve="SELECT 
		DataTransferLog.TRANSFERLOGID,   
		DataTransferLog.LOGDATE,   
		DataTransferLog.TRANSFEREDBY,   
		DataTransferLog.INVOICECODE,   
		DataTransferLog.INVOICETYPE,   
		DataTransferLog.DATE,   
		DataTransferLog.ACCCODE,   
		DataTransferLog.SGCODE,   
		DataTransferLog.DGCODE,  
		DataTransferLog.STATUS  
FROM 	DataTransferLog   
WHERE DataTransferLog.TRANSFERLOGID IN (:ia_logid)
ORDER BY DataTransferLog.TRANSFERLOGID, 
		DataTransferLog.INVOICETYPE,
		DataTransferLog.INVOICECODE   

"
  update="DataTransferLog" updatewhere=1 updatekeyinplace=yes
  arguments=(("ia_logid", numberlist))
)
