release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=140 color="536870912" )
summary(height=0 color="536870912" )
footer(height=68 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="Tdetail.transcode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="Tdetail.icode"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="." name=batch dbname="Tdetail.batch"  )
column=(type=datetime update=yes updatewhereclause=yes name=expiry dbname="Tdetail.expiry"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long update=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=transferutn dbname="Tdetail.transferutn"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=avgprice dbname="Tdetail.avgprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="Tdetail.saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=purprice dbname="Tdetail.purprice"  )
column=(type=long update=yes updatewhereclause=yes name=packunits dbname="Tdetail.packunits"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=requiredqty dbname="requiredqty"  )
column=(type=long update=yes updatewhereclause=yes name=reorderqty dbname="reorderqty"  )
column=(type=long update=yes updatewhereclause=yes name=optimumqty dbname="optimumqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=targetstk dbname="Tdetail.targetstock"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=sourcestk dbname="Tdetail.sourcestock"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) > 0" validationmsg="~"Quantity should be greater than zero~"" initial="1" name=qty dbname="qty"  )
 retrieve="SELECT 
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= 0.0000, 
	tdetail.transcode,
	tdetail.icode, 
	tdetail.batch, 
	tdetail.expiry,  
	item.customicode, 
	itemname = item.name, 
	Id   = max(tdetail.IDENTITYCOL),
	tdetail.transferutn,
	tdetail.avgprice,
	tdetail.saleprice,
	tdetail.purprice,
	tdetail.packunits,
	requiredqty = tdetail.requiredqty,
	reorderqty = tdetail.reorderqty,
	optimumqty = tdetail.optimumqty,
	tdetail.targetstock,
	tdetail.sourcestock,
	aliasname='            ',
	qty  = sum(tdetail.qty)
FROM 
	tdetail, item 
WHERE 
	( dbo.tdetail.transcode = :ar_tCode )    AND
	( tdetail.icode = item.icode )
GROUP BY 
	tdetail.transcode, 
	tdetail.icode, 
	tdetail.batch,
	tdetail.expiry,  
	item.customicode, 
	tdetail.transferutn,
	item.name,
	tdetail.avgprice,
	tdetail.purprice,
	tdetail.saleprice,
	tdetail.packunits,
	tdetail.requiredqty,
	tdetail.optimumqty,
	tdetail.reorderqty,
	tdetail.sourcestock,
	tdetail.targetstock
ORDER BY 
	Id
	
	
	
"
  arguments=(("ar_tCode", number))
)
