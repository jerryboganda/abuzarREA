release 12.5;
datawindow ( units=0 timer_interval=60000 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=68 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=64 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="Purdetail.icode"  )
column=(type=char(100) update=yes updatewhereclause=yes validation="gettext()<>''" validationmsg="'Please type batch number'" initial="." name=batch dbname="Purdetail.batch"  )
column=(type=datetime update=yes updatewhereclause=yes initial="12/12/2010" name=expiry dbname="Purdetail.expiry"  )
column=(type=long update=yes updatewhereclause=yes name=gcode dbname="Purdetail.gcode" 
 values=""  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="'Qty should be greater then zero'" initial="1" name=packqty dbname="packqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=looseqty dbname="Purdetail.looseqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=bonusqty dbname="Purdetail.bonusqty"  )
column=(type=long update=yes updatewhereclause=yes validation="Real (GetText()) > 0" name=packunits dbname="Purdetail.packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=purprice dbname="Purdetail.purprice"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="Purdetail.purinvcode"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=avgprice dbname="Purdetail.avgprice"  )
column=(type=long identity=yes updatewhereclause=yes name=purrowid dbname="Purdetail.PurRowId"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=newavgprice dbname="Purdetail.newavgprice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=currstock dbname="Purdetail.currstock"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=purutn dbname="Purdetail.purutn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=gstperc dbname="Purdetail.gstperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=unitsalestax dbname="Purdetail.unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="Purdetail.saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=rate dbname="Purdetail.rate"  )
column=(type=char(100) update=yes updatewhereclause=yes name=itemdescription dbname="Purdetail.itemdescription"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <=100" initial="0" name=discperc dbname="Purdetail.discperc"  )
 retrieve="SELECT 	
	item.customicode,
	item.name, 
	currlistrow = 0,
	totalstock=0.0000,
	stock=0.0000, 
	itemtotalval=space(30),
	dbo.purdetail.icode,
	dbo.purdetail.batch,
	dbo.purdetail.expiry,
	dbo.purdetail.gcode, 
	packqty=dbo.purdetail.packqty+dbo.purdetail.looseqty,   
	dbo.purdetail.looseqty,
	dbo.purdetail.bonusqty,
	dbo.purdetail.packunits,      
	dbo.purdetail.purprice,   
	dbo.purdetail.purinvcode,
	dbo.purdetail.avgprice,
	dbo.purdetail.IDENTITYCOL,
	dbo.purdetail.newavgprice,
	dbo.purdetail.currstock,
	dbo.purdetail.purutn ,
	dbo.purdetail.gstperc,
	dbo.purdetail.unitsalestax,
	dbo.purdetail.saleprice,
	dbo.purdetail.rate,
	dbo.purdetail.itemdescription,
	dbo.purdetail.discperc

FROM 
	dbo.purdetail , 
	dbo.item
WHERE 
	( dbo.purdetail.purinvcode = :r_InvCode )   and
	( dbo.purdetail.icode = dbo.item.icode ) 
"
  arguments=(("r_InvCode", number))
 sort="purrowid A"
)
