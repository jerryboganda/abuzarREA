release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=code dbname="Theader.TransCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Theader.Date"  )
column=(type=char(60) updatewhereclause=yes name=sourcegodown dbname="SourceGodown"  )
column=(type=char(60) updatewhereclause=yes name=targetgodown dbname="TargetGodown"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="Theader.Posted"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="Theader.PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=salesmancode dbname="Theader.SalesManCode"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.UserName"  )
 retrieve="  SELECT Theader.TransCode,   
         Theader.Date,   
	 		SourceGodown= (SELECT name from Godown WHERE gcode = Theader.SGCode),
			TargetGodown= (SELECT name from Godown WHERE gcode = Theader.DGCode),
         Theader.Posted,   
         Theader.PostDate,   
         Theader.SalesManCode,   
         Users.UserName
    FROM Theader,   
         Users
   WHERE ( Users.UserCode = Theader.SalesManCode ) and  
         ( ( Theader.SalesManCode = Users.UserCode ) )   AND
			( dbo.THeader.HeaderNo IS NULL OR
			( dbo.THeader.HeaderNo IN 
				(SELECT HeaderCode FROM GroupAllowedHeader 
				WHERE GroupCode = :ai_GroupCode AND Module=:ai_Module)))
"
  arguments=(("ai_groupcode", number), ("ai_module", number))
 sort="code A"
)
