table(column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ContactCard.ContactCardCode"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="ContactCard.AccCode"  )
column=(type=char(50) update=yes updatewhereclause=yes name=title dbname="ContactCard.Title"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="ContactCard.Name"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=address dbname="ContactCard.Address"  )
column=(type=char(100) update=yes updatewhereclause=yes name=phone dbname="ContactCard.Phone"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fax dbname="ContactCard.Fax"  )
column=(type=char(100) update=yes updatewhereclause=yes name=email dbname="ContactCard.Email"  )
column=(type=char(255) update=yes updatewhereclause=yes name=mobile dbname="ContactCard.Mobile"  )
column=(type=char(1) update=yes updatewhereclause=yes name=useforsms dbname="ContactCard.UseForSMS" 
 values="Yes	Y/No	N/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=web dbname="ContactCard.Web"  )
 retrieve="SELECT 
	AccountName = (SELECT A.Name FROM Accounts A WHERE A.AccCode=ContactCard.AccCode),
	ContactCard.ContactCardCode,   
	ContactCard.AccCode,   
	ContactCard.Title,   
	ContactCard.Name,   
	ContactCard.Address,   
	ContactCard.Phone, 
	ContactCard.Fax,   
	ContactCard.Email,   
	ContactCard.Mobile,   
	ContactCard.UseForSMS,   
	ContactCard.Web  
FROM 
	ContactCard   
"
  update="ContactCard" updatewhere=1 updatekeyinplace=no
 )
