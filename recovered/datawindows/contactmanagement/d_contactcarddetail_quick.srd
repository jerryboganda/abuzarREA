table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ContactCard.ContactCardCode"  )
column=(type=long update=yes updatewhereclause=yes initial="19" name=acccode dbname="ContactCard.AccCode"  )
column=(type=char(50) update=yes updatewhereclause=yes initial="Mr." name=title dbname="ContactCard.Title" 
 values="Mr.	Mr./Miss	Miss/Mrs.	Mrs./M//S	M//S/C//O	C//O/Dr.	Dr./Prof.	Prof./H//Dr.	H//Dr./"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="ContactCard.Name"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=address dbname="ContactCard.Address"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="92" name=phone dbname="ContactCard.Phone"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="92" name=fax dbname="ContactCard.Fax"  )
column=(type=char(100) update=yes updatewhereclause=yes name=email dbname="ContactCard.Email"  )
column=(type=char(255) update=yes updatewhereclause=yes initial="923" name=mobile dbname="ContactCard.Mobile"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=useforsms dbname="ContactCard.UseForSMS" 
 values="Yes	Y/No	N/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=web dbname="ContactCard.Web"  )
 retrieve="SELECT 
	ContactCard.ContactCardCode,   
	ContactCard.AccCode,   
	ContactCard.Title,   
	ContactCard.Name,   
	ContactCard.Address,   
	ContactCard.Phone,   
	ContactCard.Fax,   
	ContactCard.Email,   
	ContactCard.Mobile,   
	ContactCard.UseForSMS,   
	ContactCard.Web  
FROM 
	ContactCard 
WHERE 
	ContactCard.ContactCardCode = :ai_code"
  update="ContactCard" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
