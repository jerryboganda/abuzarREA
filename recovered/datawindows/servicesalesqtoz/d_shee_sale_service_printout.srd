table(column=(type=long updatewhereclause=yes name=rowtype dbname="RowType"  )
column=(type=char(8) updatewhereclause=yes name=rowclass dbname="RowClass"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=char(100) updatewhereclause=yes name=custref dbname="custref"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="serviceinvcode"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=altersaleinvcode dbname="altersaleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=long updatewhereclause=yes name=saleledger_custcode dbname="custcode"  )
column=(type=char(100) updatewhereclause=yes name=saleledger_remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=headerinv dbname="headerinv"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="GCode"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="ID"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_saleprice dbname="saleprice"  )
column=(type=decimal(4) updatewhereclause=yes name=saledetail_rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=long updatewhereclause=yes name=reprintcounter dbname="reprintcounter"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve="SELECT 
	RowType = 2,
	RowClass = 'Services',
	itemname = service.name,
	users.username,  
	headerno=serviceheader.headerno,
	customername=(select name from accounts where acccode=serviceheader.custcode),
	custref=SPACE(100),
	serviceinvcode = dbo.serviceheader.serviceinvcode,   
	saleinvcode = dbo.serviceheader.saleinvcode,   
	altersaleinvcode=NULL,
	date = dbo.serviceheader.date,   
	invdiscperc=dbo.serviceheader.discperc,
	misccharges=dbo.serviceheader.misccharges,   
	flatdisc=dbo.serviceheader.flatdisc,   
	invsalestax=0.00,
	custcode=dbo.serviceheader.custcode,   
	remarks=dbo.serviceheader.remarks,
	headerinv=null,  
	Icode=dbo.service.servicecode,   
	GCode = NULL,
	ID = dbo.servicedetail.srvrowid,
	looseqty = servicedetail.qty,
	packqty = 0.0000,
	packunits = 1,
	saleprice = servicedetail.price, 
	rate      = 0.0000,
	salestax  = 0.00,   
	discperc  = servicedetail.discperc,
	itemflatdisc  = servicedetail.serviceflatdisc,
	unitsalestax  = 0.00,
	gstperc       = 0.00,
	invgstperc    = 0.00,
	reprintcounter=serviceheader.reprintingcounter,
	InvTotal = serviceheader.InvTotal
FROM 
	dbo.serviceheader,   
	dbo.servicedetail,  
	service, 
	users 
WHERE ( dbo.serviceheader.serviceinvcode = :ra_InvCode ) AND
	( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND 
	( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND
	( servicedetail.servicecode = service.servicecode )  
UNION ALL
SELECT 
	RowType = 1,
	RowClass = 'Medicine',
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, 
	users.username, 
	headerno = dbo.saleledger.headerno,
	customername=(select name from accounts where acccode=saleledger.custcode)  ,
	custref=max(dbo.saleledger.custrefno),
	serviceinvcode = S.serviceinvcode,   
	saleinvcode=dbo.saleledger.saleinvcode,   
	altersaleinvcode=dbo.saleledger.altersaleinvcode,
	date=dbo.saleledger.date,   
	invdiscperc=dbo.saleledger.discperc,   
	misccharges=dbo.saleledger.misccharges,   
	flatdisc=dbo.saleledger.flatdisc,   
	invsalestax=dbo.saleledger.salestax,   
	custcode=dbo.saleledger.custcode,   
	remarks=dbo.saleledger.remarks, 
	headerinv=max(dbo.saleledger.headerinvno),  
	icode=dbo.saledetail.icode,   
	gcode=dbo.saledetail.gcode, 
	Id        = max(dbo.saledetail.IDENTITYCOL),  
	looseqty  = sum(saledetail.looseqty), 
	packqty   = sum(saledetail.packqty), 
	packunits = max(saledetail.packunits), 
	saleprice = max(saledetail.saleprice), 
	rate      = max(saledetail.rate),
	salestax  = max(saledetail.salestax),   
	discperc  = max(saledetail.discperc), 
	itemflatdisc  = max(saledetail.itemflatdisc),
	unitsalestax  = max(saledetail.unitsalestax),
	gstperc       = max(saledetail.gstperc),
	invgstperc    = max(saleledger.invgstperc1),
	reprintcounter=max(saleledger.reprintingcounter),
	InvTotal = MAX(saleledger.InvTotal)
FROM 
	(SELECT SH.ServiceInvCode, SH.SaleInvCode FROM ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode AND SH.SaleInvCode > 0) S,
	dbo.saleledger,   
	dbo.saledetail,  
	item,
	Users 
WHERE 
	( S.SaleInvCode = dbo.saleledger.SaleInvCode ) AND
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND 
	( saleLedger.SalesManCode = users.userCode ) and
	( saledetail.icode = item.icode )
GROUP BY 
	S.serviceinvcode,
	saleledger.saleinvcode, 
	saleledger.altersaleinvcode,
	saleledger.date, 
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	saleledger.headerno,
	saleledger.salestax, 
	saleledger.remarks, 
	saledetail.icode, 
	saledetail.rowgroup,
	saledetail.gcode, 
	item.name,
	item.icode,
	item.printable,
	users.username
ORDER BY 
	RowType, ID
"
  arguments=(("ra_InvCode", number))
 sort="id A"
)
