table(column=(type=long updatewhereclause=yes name=serviceticketcode dbname="ServiceTicketCode"  )
column=(type=char(12) updatewhereclause=yes name=serviceticketbarcode dbname="ServiceTicketBarCode"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=issuedon dbname="IssuedOn"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(50) updatewhereclause=no name=regno dbname="regno"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(60) updatewhereclause=no name=patient dbname="patient"  )
column=(type=char(100) updatewhereclause=no name=address dbname="Address"  )
column=(type=datetime updatewhereclause=yes name=dob dbname="DOB"  )
column=(type=char(16) updatewhereclause=no name=age dbname="Age"  )
column=(type=char(1) updatewhereclause=no name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(100) updatewhereclause=no name=mobileno dbname="MobileNo"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(60) updatewhereclause=no name=doctor dbname="Doctor"  )
column=(type=datetime updatewhereclause=yes name=expireson dbname="ExpiresOn"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=char(60) updatewhereclause=yes name=servicecategory dbname="ServiceCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
 retrieve="SELECT 
	ServiceTicketCode=ServiceTicket.ServiceTicketCode,   
	ServiceTicketBarCode= '*' + LTRIM(RTRIM(STR(ServiceTicket.ServiceTicketCode, 10))) + '*',
	ServiceInvCode=ServiceTicket.ServiceInvCode,
	IssuedOn = ServiceHeader.Date,
	Date=ServiceTicket.Date,
	regno=(SELECT patient.regno FROM Patient WHERE ServiceHeader.PatientCode = Patient.PatientCode),
	PatientCode = (SELECT Patient.PatientCode FROM Patient WHERE ServiceHeader.PatientCode = Patient.PatientCode),
	patient=(SELECT patient.name FROM Patient WHERE ServiceHeader.PatientCode = Patient.PatientCode), 
	Address = (SELECT patient.address1 FROM Patient WHERE ServiceHeader.PatientCode = Patient.PatientCode), 
	DOB=(SELECT patient.DOB  FROM Patient WHERE ServiceHeader.PatientCode = Patient.PatientCode), 
	Age=(SELECT LTRIM(RTRIM(STR(DATEDIFF(yy, patient.DOB, getdate())))) + ' Years'  FROM Patient WHERE ServiceHeader.PatientCode = Patient.PatientCode), 
	Gender = (SELECT patient.gender  FROM Patient WHERE ServiceHeader.PatientCode = Patient.PatientCode),
	MobileNo = (SELECT patient.MobileNo1 FROM Patient WHERE ServiceHeader.PatientCode = Patient.PatientCode),
	UserName=(SELECT U.UserName FROM Users U WHERE U.UserCode=ServiceTicket.UserCode),
	Doctor=(SELECT Doctors.Name FROM Doctors WHERE ServiceHeader.DoctCode = Doctors.DoctCode),
	ExpiresOn=ServiceTicket.ExpiresOn,   
	ServiceName=Service.Name,   
	ServiceCategory=ServiceCategory.Name,
	Price =  ServiceTicket.Price,
	DiscPerc=ServiceTicket.DiscPerc
FROM 
	Service,   
	ServiceHeader,
	ServiceCategory,   
	ServiceTicket  
WHERE 
	ServiceHeader.ServiceInvCode = :ai_serviceinvcode AND 
	ServiceTicket.ServiceInvCode = :ai_serviceinvcode AND 
	ServiceHeader.ServiceInvCode = ServiceTicket.ServiceInvCode AND
	ServiceTicket.TicketUsed = 'N' AND 
	ServiceTicket.ExpiresOn >= GetDate() AND 
	ServiceTicket.ServiceCode = Service.ServiceCode AND 
	Service.ServiceCatCode = ServiceCategory.ServiceCatCode AND 
	Service.TicketRequired = 'Y'
ORDER BY 
	ServiceTicketCode"
  arguments=(("ai_serviceinvcode", number))
)
