datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=132 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Purledger.purinvcode"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="Accounts.name"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Purledger.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
 retrieve="  SELECT  dbo.purledger.purinvcode , 
          dbo.accounts.name , 
         dbo.purledger.date, 
			 posted = purledger.posted,
			PostedBy = IsNull((Select username from users 
							where dbo.purledger.postedby = dbo.users.usercode), ''),
			ModifiedBy = IsNull((Select username from users 
							where dbo.purledger.modifiedby = dbo.users.usercode), '')       
	 FROM  dbo.purledger , 
          dbo.accounts     
   WHERE  ( dbo.purledger.suppcode = dbo.accounts.acccode ) and 
          ( dbo.purledger.purcatcode <> 6 ) and
			 ( Posted IN (:as_Posted)) "
  arguments=(("as_Posted", stringlist))
)
