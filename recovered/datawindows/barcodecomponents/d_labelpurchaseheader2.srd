table(column=(type=char(100) updatewhereclause=yes name=suppinvcode dbname="Purledger.suppinvcode"  )
column=(type=datetime updatewhereclause=yes name=suppinvdate dbname="Purledger.suppinvdate"  )
column=(type=char(100) updatewhereclause=yes name=grn dbname="Purledger.grn"  )
column=(type=long updatewhereclause=yes name=code dbname="Purledger.purinvcode"  )
column=(type=long updatewhereclause=yes initial="3" name=purcatcode dbname="Purledger.purcatcode" 
 values=""  )
column=(type=long updatewhereclause=yes initial="18" name=suppcode dbname="Purledger.suppcode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=char(100) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(100) updatewhereclause=yes name=doctorname dbname="DoctorName"  )
column=(type=long updatewhereclause=yes initial="1" name=salesmancode dbname="Purledger.salesmancode"  )
column=(type=datetime updatewhereclause=yes initial="today" name=date dbname="Purledger.date"  )
column=(type=long updatewhereclause=yes validation="Integer( GetText() ) > 0" initial="1" name=headerno dbname="Purledger.headerno" 
 values=""  )
column=(type=long updatewhereclause=yes name=pocode dbname="Purledger.pocode"  )
column=(type=decimal(2) updatewhereclause=yes validation=" discperc >=0  AND discperc <=100" initial="0" name=discperc dbname="Purledger.discperc"  )
column=(type=decimal(2) updatewhereclause=yes validation=" flatdisc >= 0" initial="0" name=flatdisc dbname="Purledger.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes validation=" misccharges >= 0" initial="0" name=misccharges dbname="Purledger.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes validation=" salestax >= 0" initial="0" name=salestax dbname="Purledger.salestax"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=posted dbname="Purledger.posted"  )
column=(type=datetime updatewhereclause=yes initial="today" name=postdate dbname="Purledger.postdate"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Purledger.remarks"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.username"  )
column=(type=datetime updatewhereclause=yes initial="today" name=originaldate dbname="Purledger.originaldate"  )
column=(type=long updatewhereclause=yes name=modifiedby dbname="Purledger.modifiedby"  )
column=(type=long updatewhereclause=yes name=postedby dbname="Purledger.postedby"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=porb dbname="Purledger.porb" 
 values="YES	Y/NO	N/"  )
column=(type=char(1) updatewhereclause=yes initial="1" name=labelformat dbname="labelformat" 
 values=""  )
column=(type=long updatewhereclause=yes initial="1" name=loosepack dbname="LoosePack" 
 values="Loose	1/Pack	2/"  )
column=(type=char(200) updatewhereclause=yes name=barcodeprinter dbname="BarCodePrinter" 
 values=""  )
 retrieve="SELECT  
	dbo.purledger.suppinvcode ,
	dbo.purledger.suppinvdate,
	dbo.purledger.grn,
	dbo.purledger.purinvcode ,
	dbo.purledger.purcatcode ,
	dbo.purledger.suppcode ,
	AliasName = (SELECT Accounts.AliasName FROM Accounts WHERE Accounts.AccCode = dbo.purledger.suppcode),
	SupplierName = (SELECT Accounts.Name FROM Accounts WHERE Accounts.AccCode = dbo.purledger.suppcode),
	PatientName = SPACE(100),
	DoctorName = SPACE(100),
	dbo.purledger.salesmancode ,
	dbo.purledger.date ,
	dbo.purledger.headerno,
	dbo.purledger.pocode ,
	dbo.purledger.discperc ,
	dbo.purledger.flatdisc ,
	dbo.purledger.misccharges ,
	dbo.purledger.salestax ,
	dbo.purledger.posted ,
	dbo.purledger.postdate ,
	dbo.purledger.remarks ,
	dbo.users.username,
	purledger.originaldate,
	purledger.modifiedby,
	purledger.postedby ,
	purledger.porb,
	labelformat = '1',
	LoosePack=1,
	BarCodePrinter = DBO.fn_GetPreference('')
	
	FROM dbo.purledger ,
	 dbo.users     
	
	WHERE ( dbo.purledger.salesmancode = dbo.users.usercode ) and 
		( ( dbo.purledger.purinvcode = :r_InvCode ) )  "
  arguments=(("r_InvCode", number))
)
