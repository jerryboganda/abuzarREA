table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(75) updatewhereclause=yes name=alternatecustomicode dbname="Purdetail.alternatecustomicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes name=itemcodetype dbname="itemcodetype"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=char(12) updatewhereclause=yes name=suppcode dbname="suppcode"  )
column=(type=char(40) updatewhereclause=yes name=manufshortname dbname="ManufShortName"  )
column=(type=char(60) updatewhereclause=yes name=manufaddress dbname="ManufAddress"  )
column=(type=char(30) updatewhereclause=yes name=manufphone dbname="ManufPhone"  )
column=(type=long updatewhereclause=yes name=icode dbname="Purdetail.icode"  )
column=(type=char(100) updatewhereclause=yes initial="." name=batch dbname="Purdetail.batch"  )
column=(type=datetime updatewhereclause=yes initial="today" name=manfdate dbname="Purdetail.manfdate"  )
column=(type=datetime updatewhereclause=yes validationmsg="~"expiry must be greater tlhan today's date~"" initial="12/12/2010" name=expiry dbname="Purdetail.expiry"  )
column=(type=long updatewhereclause=yes name=gcode dbname="Purdetail.gcode"  )
column=(type=decimal(4) updatewhereclause=yes name=purdetail_packqty dbname="Purdetail.packqty"  )
column=(type=decimal(4) updatewhereclause=yes name=purdetail_looseqty dbname="Purdetail.looseqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=bonusqty dbname="Purdetail.bonusqty"  )
column=(type=long updatewhereclause=yes validation="Real(GetText()) > 0" name=packunits dbname="Purdetail.packunits"  )
column=(type=long updatewhereclause=yes name=code dbname="Purdetail.purinvcode"  )
column=(type=char(10) updatewhereclause=yes name=mrp dbname="MRP"  )
column=(type=decimal(5) updatewhereclause=yes initial="0" name=avgprice dbname="avgprice"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="~"Please enter valid retail price~"" initial="0" name=retailprice dbname="retailprice"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="~"Please enter valid sales tax~"" initial="0" name=salestax dbname="salestax"  )
column=(type=decimal(5) updatewhereclause=yes name=netrate dbname="Purdetail.netrate"  )
column=(type=long updatewhereclause=yes name=inscode dbname="InsCode"  )
column=(type=char(100) updatewhereclause=yes name=design dbname="Design"  )
column=(type=decimal(13) updatewhereclause=yes name=salepriceforitem dbname="salepriceforitem"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(60) updatewhereclause=yes name=size dbname="Size"  )
column=(type=char(100) updatewhereclause=yes name=sizedescription dbname="SizeDescription"  )
column=(type=char(100) updatewhereclause=yes name=modeldescription dbname="ModelDescription"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
column=(type=long identity=yes updatewhereclause=yes name=purrowid dbname="Purdetail.PurRowId"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=purprice dbname="Purdetail.purprice"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <=100" initial="0" name=discperc dbname="Purdetail.discperc"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Item.remarks"  )
column=(type=char(100) updatewhereclause=yes name=location dbname="location"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(4) updatewhereclause=yes name=prefferedsaleqty dbname="PrefferedSaleQty"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=saleprice dbname="saleprice"  )
column=(type=decimal(4) updatewhereclause=yes validation="Real(GetText()) >=  0" initial="1" name=qty dbname="qty"  )
 retrieve="SELECT 
	item.customicode,
	purdetail.alternatecustomicode,
	item.name, 
	itemcodetype = 0,
	currlistrow = 0,
	stock=0.0000, 
	suppcode = dbo.accounts.aliasname ,
	ManufShortName = (SELECT M.ShortName FROM Manufacturer M WHERE M.ManfCode = Item.ManfCode),
	ManufAddress = (SELECT M.Address1 FROM Manufacturer M WHERE M.ManfCode = Item.ManfCode),
	ManufPhone = (SELECT M.Phone FROM Manufacturer M WHERE M.ManfCode = Item.ManfCode),
	dbo.purdetail.icode,
	dbo.purdetail.batch,
	dbo.purdetail.manfdate,
	dbo.purdetail.expiry,
	dbo.purdetail.gcode,
	dbo.purdetail.packqty,
	dbo.purdetail.looseqty,
	dbo.purdetail.bonusqty,
	dbo.purdetail.packunits,      
	dbo.purdetail.purinvcode,
	MRP = STR(ISNULL((SELECT MAX(D.PurinvCode) FROM PurDetail D WHERE D.PurUtn IN (SELECT MAX(DD.PurUTN) FROM PurDetail DD WHERE DD.ICode=Item.ICode)), dbo.purdetail.purinvcode), 10),
	avgprice=dbo.item.avgprice,
	retailprice=dbo.item.retailprice,
	salestax=dbo.purdetail.unitsalestax,
	dbo.purdetail.netrate,
	InsCode=NULL,
	Design = (SELECT NAME FROM ItemDesign WHERE dbo.item.itemdesigncode = itemdesign.itemdesigncode),
	salepriceforitem=Round(dbo.purdetail.salepriceforitem /(case dbo.purdetail.packunits when 0 then 1 else dbo.purdetail.packunits end) , 2 ), 
	manufacturer=(SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = Item.ManfCode),
	packing=(SELECT P.Name FROM ItemPacking P WHERE P.PackCode = Item.PackCode),
	Size=(SELECT S.Name FROM ItemSize S WHERE S.ISizeCode = Item.ISizeCode),
	SizeDescription=Item.SizeDescription,
	ModelDescription = Item.ModelDescription,
	PackingDesc=Item.PackingDesc,
	dbo.purdetail.IDENTITYCOL,
	dbo.purdetail.purprice    ,
	dbo.purdetail.discperc ,
	item.remarks,
	location = item.location,
	flatdisc=item.flatdisc,
	PrefferedSaleQty = Item.PrefferedSaleQty,
	saleprice = CAST(CASE dbo.fn_GetPreference('printsalepricefrombasicdata') 
		WHEN 'N' THEN ISNULL(Round(dbo.purdetail.salepriceforitem /(case dbo.purdetail.packunits when 0 then 1 else dbo.purdetail.packunits end) , 2 ), 0) 
		ELSE Round(dbo.item.saleprice /(case dbo.purdetail.packunits when 0 then 1 else dbo.item.packunits end) , 2 ) END AS NUMERIC(12,2)), 
	qty = CASE When (dbo.purledger.purcatcode = 1 Or dbo.purledger.purcatcode = 2) Then
				(dbo.purdetail.packqty + dbo.purdetail.bonusqty) * dbo.purdetail.packunits
			Else
				dbo.purdetail.looseqty + dbo.purdetail.bonusqty
			End
FROM 
	dbo.purdetail ,
	dbo.purledger,
	dbo.Accounts,
	dbo.Supplier,
	dbo.item
WHERE 
	( dbo.purledger.purinvcode = :r_InvCode ) and
	( dbo.purledger.purinvcode = dbo.purdetail.purinvcode )   and
	( dbo.purledger.SuppCode = dbo.Accounts.AccCode ) and
	( dbo.Accounts.AccCode = dbo.Supplier.SuppCode ) and
	( dbo.purdetail.icode = dbo.item.icode )  
"
  arguments=(("r_InvCode", number))
 sort="purrowid A"
)
