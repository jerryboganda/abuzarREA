table(column=(type=char(60) updatewhereclause=yes name=name dbname="Item.Name"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="Item.CustomICode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(77) updatewhereclause=yes name=custicode dbname="CUSTICODE"  )
column=(type=char(12) updatewhereclause=yes name=price dbname="Price"  )
column=(type=char(255) updatewhereclause=yes name=clientname dbname="ClientName"  )
column=(type=char(1) updatewhereclause=yes name=cr dbname="CR"  )
column=(type=char(100) updatewhereclause=yes name=mrp dbname="MRP"  )
column=(type=char(100) updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(100) updatewhereclause=yes name=sizedescription dbname="SizeDescription"  )
column=(type=char(100) updatewhereclause=yes name=modeldescription dbname="ModelDescription"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(100) updatewhereclause=yes name=location dbname="Location"  )
column=(type=char(100) updatewhereclause=yes name=size dbname="Size"  )
column=(type=char(10) updatewhereclause=yes name=prefferedsaleqty dbname="PrefferedSaleQty"  )
 retrieve="SELECT 
	Item.Name,
	PackingDesc=Item.PackingDesc,
	Item.CustomICode,
	Date = GetDate(),
	CUSTICODE ='*' + LTRIM(RTRIM(Item.CustomICode)) + '*',
	Price = 'Rs:' + STR(Round(Item.Saleprice / CASE WHEN item.packunits > 0 THEN item.packunits ELSE 1 END, 2), 9, 2),
	ClientName=SPACE(255),
	CR = '®',
	MRP=SPACE(100),
	SuppCode=SPACE(100),
	SizeDescription=SPACE(100),
	ModelDescription=SPACE(100),
	Remarks = SPACE(100),
	Location=SPACE(100),
	Size=SPACE(100),
	PrefferedSaleQty=RTRIM(LTRIM(STR(Item.PrefferedSaleQty, 10)))
FROM 
	Item 
WHERE 
	icode = 4
"
 )
