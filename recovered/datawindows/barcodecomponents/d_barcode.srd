release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=name dbname="Item.name"  )
column=(type=long updatewhereclause=yes initial="1" name=qty dbname="qty"  )
column=(type=char(1) updatewhereclause=yes initial="Y" name=yes dbname="yes" 
 values="	Y/	N"  )
column=(type=char(75) updatewhereclause=yes name=custicode dbname="custicode"  )
column=(type=char(12) updatewhereclause=yes name=price dbname="price"  )
 retrieve="select name, 
			qty=1, 
			yes='N', 
			custicode=customicode, 
			price='Rs:' + STR(round(item.saleprice/case when item.packunits > 0 then item.packunits else 1 end, 2), 9, 2)
from item"
 )
text(name=name_t band=header font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="2" border="6" x="485" y="8" height="60" width="1742" text="Name" )
