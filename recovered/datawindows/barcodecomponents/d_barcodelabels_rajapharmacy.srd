release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=200 print.margin.right=0 print.margin.top=300 print.margin.bottom=0 print.paper.size=9 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no rows_per_detail=5)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=1104 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=name dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="Item.CustomICode"  )
column=(type=char(77) updatewhereclause=yes name=custicode dbname="CUSTICODE"  )
column=(type=char(12) updatewhereclause=yes name=price dbname="Price"  )
column=(type=char(23) updatewhereclause=yes name=clientname dbname="ClientName"  )
 retrieve="SELECT Item.Name,   
		 Item.CustomICode,
       CUSTICODE = ~"*~" + LTRIM(RTRIM(Item.CustomICode)) + ~"*~",
		 Price = 'Rs:' + STR(Round(Item.Saleprice / CASE WHEN item.packunits > 0 THEN item.packunits ELSE 1 END, 2), 9, 2),
		 ClientName=~"RAHAT BAKERS AND SWEETS~"
FROM Item 
WHERE icode <20
"
 )
