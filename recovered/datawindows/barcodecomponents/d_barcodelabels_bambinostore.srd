table(column=(type=char(60) updatewhereclause=yes name=name dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="Item.CustomICode"  )
column=(type=char(77) updatewhereclause=yes name=custicode dbname="CUSTICODE"  )
column=(type=char(12) updatewhereclause=yes name=price dbname="Price"  )
column=(type=char(7) updatewhereclause=yes name=clientname dbname="ClientName"  )
column=(type=char(100) updatewhereclause=yes name=suppalias dbname="SuppAlias"  )
column=(type=char(100) updatewhereclause=yes name=date dbname="date"  )
column=(type=char(105) updatewhereclause=yes name=manfdate dbname="ManfDate"  )
column=(type=char(17) updatewhereclause=yes name=expiry dbname="Expiry"  )
 retrieve="SELECT 
	Item.Name,   
	Item.CustomICode,
	CUSTICODE = ~"*~" + LTRIM(RTRIM(Item.CustomICode)) + ~"*~",
	Price = 'Rs:' + STR(Round(Item.Saleprice / CASE WHEN item.packunits > 0 THEN item.packunits ELSE 1 END, 2), 9, 2),
	ClientName='BAMBINO',
	SuppAlias = SPACE(100),
	date = LTRIM(RTRIM(convert(varchar(100), getdate(), 112))),
	ManfDate = 'Mfg.:' + SPACE(100),
	Expiry = 'Exp.:' + CONVERT(VARCHAR(12), GETDATE(), 103)
FROM Item 
WHERE icode < 100
"
 )
