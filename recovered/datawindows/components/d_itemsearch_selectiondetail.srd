column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="Item.RetailPrice"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="Item.AvgPrice"  )
column=(type=long updatewhereclause=yes name=oldpartcode dbname="Item.OldPartCode" 
 values=""  )
 retrieve="SELECT 
	Item.ICode,   
	Item.TypeDescription,   
	Item.ModelDescription,   
	Item.SizeDescription,   
	Item.RemarksForPurchase,   
	Item.ItemYear,   
	Item.RetailPrice,   
	Item.AvgPrice,   
	Item.OldPartCode  
FROM Item   
WHERE Item.Icode = :ai_icode
"
  update="Item" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_icode", number))
)
