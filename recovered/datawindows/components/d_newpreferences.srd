 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=multigodown dbname="Preferences.Multigodown" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=saleposting dbname="Preferences.Saleposting"  )
 retrieve="SELECT  Preferences.UserId ,
           Preferences.Terms ,
           Preferences.PageSize ,
           Preferences.HeaderNo ,
           Preferences.POFooter ,
           Preferences.ItemDiscPerc ,
           Preferences.InvDiscPerc ,
           Preferences.Batch ,
           Preferences.Expiry ,
           Preferences.UpdateSalePrice ,
           Preferences.UpdatePurPrice ,
           Preferences.ReorderLevel ,
           Preferences.OptimumLevel ,
           Preferences.Priority ,
           Preferences.Act1 ,
           Preferences.Act2 ,
           Preferences.Act3 ,
           Preferences.DefaultGCode ,
           Preferences.SaleGodownOption ,
           Preferences.PurchaseGodownOption,
			  Preferences.Salesalesmanwindow,
	     	  Preferences.InSaleCustomerBalance,
			  Preferences.ItemFlatDisc,
			  Preferences.Multigodown,
			  Preferences.Saleposting 
        FROM Preferences    "
  update="Preferences" updatewhere=1 updatekeyinplace=yes
 )
