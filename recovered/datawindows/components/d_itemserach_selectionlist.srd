summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="unitprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="Packingdesc"  )
column=(type=char(1) updatewhereclause=yes name=restricted dbname="Restricted"  )
column=(type=char(100) updatewhereclause=yes name=location dbname="location"  )
column=(type=char(100) updatewhereclause=yes name=typedescription dbname="typedescription"  )
column=(type=char(100) updatewhereclause=yes name=modeldescription dbname="modeldescription"  )
column=(type=char(100) updatewhereclause=yes name=sizedescription dbname="sizedescription"  )
column=(type=char(100) updatewhereclause=yes name=remarksforpurchase dbname="remarksforpurchase"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="retailprice"  )
column=(type=char(15) updatewhereclause=yes name=itemyear dbname="itemyear"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=itempart dbname="ItemPart"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=sstock dbname="sstock"  )
column=(type=decimal(4) updatewhereclause=yes name=pstock dbname="pstock"  )
column=(type=long updatewhereclause=yes name=ipartcode dbname="Manufacturer.ipartcode"  )
column=(type=long updatewhereclause=yes name=oldpartcode dbname="Manufacturer.oldpartcode"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="Manufacturer.manfcode"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="Manufacturer.icatcode"  )
column=(type=long updatewhereclause=yes name=iccode dbname="Manufacturer.iccode"  )
column=(type=long updatewhereclause=yes name=packcode dbname="Manufacturer.packcode"  )
 retrieve="SELECT 
	icode=item.icode, 
	aliasname=item.customicode,
	itemname=item.name,
	packunits=item.packunits,
	unitprice=Round(item.saleprice / case item.packunits when 0 then 1 else item.packunits end, 2),
	saleprice=item.saleprice,
	Packingdesc=item.packingdesc,
	Restricted=item.restricted,
	location=item.location,
	typedescription=item.typedescription,
	modeldescription=item.modeldescription,
	sizedescription=item.sizedescription,
	remarksforpurchase=item.remarksforpurchase,
	avgprice=item.avgprice,
	retailprice=item.retailprice,
	itemyear=item.itemyear,
	manufacturer=dbo.Manufacturer.name,
	ItemPart = dbo.itempart.name,
	stock = (select	sum(dbo.godowndetail.currqty)
			from	dbo.godowndetail 
			where	dbo.godowndetail.icode = item.icode),
	sstock = (select	sum(dbo.godowndetail.currqty)
		from	dbo.godowndetail 
		where	dbo.godowndetail.icode = item.icode and
			dbo.godowndetail.gcode IN 
			(SELECT Godown.GCode
			FROM Godown
			WHERE GCode IN
				(CASE (SELECT salegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)
				WHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = Godown.GCode)
				ELSE (SELECT DISTINCT GCode From GroupAllowedGodown
					WHERE	GroupAllowedGodown.GroupCode = :ai_groupcode AND
						GroupAllowedGodown.Module = 1 AND
						GroupAllowedGodown.GCode = Godown.GCode) END))),
	pstock=	(select	sum(dbo.godowndetail.currqty)
		from	dbo.godowndetail 
		where	dbo.godowndetail.icode = item.icode and
			dbo.godowndetail.gcode IN 
			(SELECT Godown.GCode
			FROM Godown
			WHERE GCode IN
				(CASE (SELECT purchasegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)
				WHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = Godown.GCode)
				ELSE (SELECT DISTINCT GCode From GroupAllowedGodown
					WHERE	GroupAllowedGodown.GroupCode = :ai_groupcode AND
						GroupAllowedGodown.Module = 3 AND
						GroupAllowedGodown.GCode = Godown.GCode) END))),
	item.ipartcode,
	item.oldpartcode,
	item.manfcode,
	item.icatcode,
	item.iccode,
	item.packcode
FROM
	dbo.Manufacturer,
	dbo.itempart,
	(SELECT * FROM ITEM
	WHERE item.Active = 1 and ((:as_searchon = 'itemname' and name like :as_searchcriteria) OR
			(:as_searchon = 'modeldescription' and modeldescription like :as_searchcriteria) OR
			(:as_searchon = 'sizedescription' and sizedescription like :as_searchcriteria) OR
			(:as_searchon = 'typedescription' and typedescription like :as_searchcriteria) OR
			(:as_searchon = 'manufacturer' and manfcode in (select manfcode from manufacturer where name like :as_searchcriteria)) OR
			(:as_searchon = 'itempart' and ipartcode in (select ipartcode from itempart where name like :as_searchcriteria)) OR
			(:as_searchon = 'oldpartno' and oldpartcode in (select ipartcode from itempart where name like :as_searchcriteria)))) Item
WHERE	
	dbo.Manufacturer.manfcode = item.manfcode and
	dbo.ItemPart.IPartCode = item.ipartcode and
		(Case (Select Upper(DBO.Fn_GetPreference('GroupCategoryRights')) ) When 'Y' Then item.icatcode Else 0 End in (:ai_catlist))
ORDER BY 
	ItemPart, item.name"
  arguments=(("ai_groupcode", number), ("ai_catlist", numberlist), ("as_searchon", string), ("as_searchcriteria", string))
)
