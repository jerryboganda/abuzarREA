table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(6) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=documentnolen dbname="DOCUMENTNOLEN"  )
column=(type=char(12) updatewhereclause=yes name=documentno dbname="DOCUMENTNO"  )
column=(type=long updatewhereclause=yes name=docdatelen dbname="DOCDATELEN"  )
column=(type=char(10) updatewhereclause=yes name=docdate dbname="DOCDATE"  )
column=(type=long updatewhereclause=yes name=custidlen dbname="CUSTIDLEN"  )
column=(type=char(10) updatewhereclause=yes name=custid dbname="CUSTID"  )
column=(type=long updatewhereclause=yes name=townidlen dbname="TOWNIDLEN"  )
column=(type=char(16) updatewhereclause=yes name=townid dbname="TOWNID"  )
column=(type=long updatewhereclause=yes name=prdidlen dbname="PRDIDLEN"  )
column=(type=char(9) updatewhereclause=yes name=prdid dbname="PRDID"  )
column=(type=long updatewhereclause=yes name=prdlen dbname="PRDLEN"  )
column=(type=char(50) updatewhereclause=yes name=prd dbname="PRD"  )
column=(type=long updatewhereclause=yes name=batchnolen dbname="BatchNoLEN"  )
column=(type=char(10) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=long updatewhereclause=yes name=pricelen dbname="PriceLEN"  )
column=(type=char(12) updatewhereclause=yes name=price dbname="Price"  )
column=(type=long updatewhereclause=yes name=qtylen dbname="QtyLEN"  )
column=(type=char(12) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=long updatewhereclause=yes name=bonuslen dbname="BonusLEN"  )
column=(type=char(12) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=long updatewhereclause=yes name=discountlen dbname="DISCOUNTLEN"  )
column=(type=char(12) updatewhereclause=yes name=discount dbname="DISCOUNT"  )
column=(type=long updatewhereclause=yes name=netamountlen dbname="NETAMOUNTLEN"  )
column=(type=char(14) updatewhereclause=yes name=netamount dbname="NETAMOUNT"  )
column=(type=long updatewhereclause=yes name=reasonlen dbname="REASONLEN"  )
column=(type=char(1) updatewhereclause=yes name=reason dbname="REASON"  )
 retrieve="SELECT  
	DSTBIDLEN=6,
	DSTBID=LEFT(LTRIM(RTRIM(AR.TAG)), 6),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = STR(SL.SaleInvCode, 12),
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103), 
	CUSTIDLEN=10, 
	CUSTID = STR(SL.CustCode, 10),
	TOWNIDLEN=16,
	TOWNID=STR(AR.AREACODE, 16),
	PRDIDLEN=9,
	PRDID=STR(SD.ICode, 9),
	PRDLEN=50,
	PRD=SUBSTRING(I.Name, 1, 50),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	PriceLEN=12,
	Price=STR(SD.SalePrice, 12, 2),
	QtyLEN=12,
	Qty=STR(SD.LooseQty, 12),
	BonusLEN=12,
	Bonus=STR(SD.BonusQty, 12),
	DISCOUNTLEN=12,
	DISCOUNT=STR(Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2), 12, 2),
	NETAMOUNTLEN=14,
	NETAMOUNT=STR(Round((SD.LooseQty * SD.SalePrice * (1 - SD.DiscPerc * 0.01)), 2), 14, 2),
	REASONLEN=1,
	REASON='S'
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	CustomerCategory CC,
	Item I,
	Area Ar
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = Ar.AreaCode
UNION ALL
SELECT 
	DSTBIDLEN=6,
	DSTBID=LEFT(LTRIM(RTRIM(AR.TAG)), 6),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = STR(SL.SRInvCode, 12),
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103), 
	CUSTIDLEN=10,
	CUSTID = STR(SL.CustCode, 10),
	TOWNIDLEN=16,
	TOWNID=STR(AR.AREACODE, 16),
	PRDIDLEN=9,
	PRDID=STR(SD.ICode, 9),
	PRDLEN=50,
	PRD=SUBSTRING(I.Name, 1, 50),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	PriceLEN=12,
	Price=STR(SD.SRPrice, 12, 2),
	QtyLEN=12,
	Qty=STR(SD.LooseQty, 12),
	BonusLEN=12,
	Bonus=STR(SD.BonusQty, 12),
	DISCOUNTLEN=12,
	DISCOUNT=STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2),
	NETAMOUNTLEN=14,
	NETAMOUNT=STR(Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 14, 2),
	REASONLEN=1,
	REASON='R'
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	CustomerCategory CC,
	Item I,
	Area AR

WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode"
  arguments=(("manfcode", number), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
