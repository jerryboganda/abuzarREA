summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=custidlen dbname="CUSTIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=custid dbname="CUSTID"  )
column=(type=long updatewhereclause=yes name=salestypelen dbname="SALESTYPELEN"  )
column=(type=char(8000) updatewhereclause=yes name=salestype dbname="SALESTYPE"  )
column=(type=long updatewhereclause=yes name=custnamelen dbname="CUSTNAMELEN"  )
column=(type=char(8000) updatewhereclause=yes name=custname dbname="CUSTNAME"  )
column=(type=long updatewhereclause=yes name=addresslen dbname="ADDRESSLEN"  )
column=(type=char(8000) updatewhereclause=yes name=address dbname="ADDRESS"  )
column=(type=long updatewhereclause=yes name=citylen dbname="CityLEN"  )
column=(type=char(8000) updatewhereclause=yes name=city dbname="City"  )
column=(type=long updatewhereclause=yes name=brickidlen dbname="BrickIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=brickid dbname="BrickID"  )
column=(type=long updatewhereclause=yes name=bricklen dbname="BrickLEN"  )
column=(type=char(8000) updatewhereclause=yes name=brick dbname="Brick"  )
 retrieve="SELECT 
	DSTBIDLEN=6,
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	CUSTIDLEN=12,
	CUSTID = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),
	SALESTYPELEN=10,
	SALESTYPE=SPACE(8) + REPLICATE('0', 2 - LEN(LTRIM(RTRIM(STR(C.CustCatCode))))) + LTRIM(RTRIM(STR(C.CustCatCode))),
	CUSTNAMELEN=60,
	CUSTNAME = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))))),
	ADDRESSLEN=60,
	ADDRESS = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))))),
/*
	CITYLEN=30,
	CITY = LTRIM(RTRIM(SUBSTRING(C.CITY, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(C.CITY, 1, 30))))),
*/
	CityLEN=60,
	City = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 60))))),
	BrickIDLEN=9,
	BrickID=REPLICATE('0', 4 - LEN(LTRIM(RTRIM(STR(SAR.SUBAREACODE))))) + LTRIM(RTRIM(STR(SAR.SUBAREACODE))) + SPACE(5),
	BrickLEN=60,
	Brick = LTRIM(RTRIM(SUBSTRING(SAR.NAME, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(SAR.NAME, 1, 60)))))
FROM Customer C, Accounts A, Area AR, SubArea SAR
WHERE C.CustCode = A.AccCode AND C.AreaCode = AR.AreaCode AND C.SubAreaCode = SAR.SubAreaCode"
  arguments=(("as_dstcode", string))
)
