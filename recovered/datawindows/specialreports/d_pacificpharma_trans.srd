table(column=(type=char(11) updatewhereclause=yes name=distcode dbname="DistCode"  )
column=(type=char(61) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(12) updatewhereclause=yes name=docdate dbname="DocDate"  )
column=(type=long updatewhereclause=yes name=docno dbname="DocNo"  )
column=(type=char(2) updatewhereclause=yes name=doctype dbname="DocType"  )
column=(type=char(100) updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(50) updatewhereclause=yes name=packsize dbname="PackSize"  )
column=(type=char(60) updatewhereclause=yes name=team dbname="Team"  )
column=(type=decimal(2) updatewhereclause=yes name=tradeprice dbname="TradePrice"  )
column=(type=char(100) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=long updatewhereclause=yes name=territory dbname="Territory"  )
column=(type=long updatewhereclause=yes name=brick dbname="Brick"  )
column=(type=char(12) updatewhereclause=yes name=chemist dbname="Chemist"  )
 retrieve="SELECT
	DistCode=LTRIM(RTRIM(:as_distcode + SPACE(10))), 
	City = LTRIM(RTRIM(:as_city  + SPACE(60))), 
	DocDate=CONVERT(VARCHAR(12), H.Date, 103),
	DocNo=H.SaleInvCode, 
	DocType='SA',
	ItemCode=I.Remarks, 
	ItemName=I.Name, 
	PackSize=I.PackingDesc, 
	Team=IC.Name, 
	TradePrice=D.SalePrice,
	BatchNo=D.Batch, 
	Qty = D.LooseQty,
	Territory=C.AreaCode, 
	Brick=C.SubAreaCode, 
	Chemist = A.AliasName
FROM 
	SaleLedger H, SaleDetail D, Item I, ItemCategory IC, Customer C, Accounts A
WHERE 
	H.Date BETWEEN :adt_StartDate AND :adt_EndDate AND
	H.Posted = 'Y' AND
	H.SaleInvCode = D.SaleInvCode AND
	D.ICode = I.ICode AND
	I.ManfCode = :ai_manfcode AND 
	I.ICatCode=IC.ICatCode AND 
	H.CustCode = C.CustCode AND
	C.CustCode = A.Acccode
UNION ALL
SELECT 
	DistCode=LTRIM(RTRIM(:as_distcode + SPACE(10))), 
	City = LTRIM(RTRIM(:as_city  + SPACE(60))), 
	DocDate=CONVERT(VARCHAR(12), H.Date, 103),
	DocNo=H.SRInvCode, 
	DocType='SR',
	ItemCode=I.Remarks, 
	ItemName=I.Name, 
	PackSize=I.PackingDesc, 
	Team=IC.Name, 
	TradePrice=D.SRPrice,
	BatchNo=D.Batch, 
	Qty = D.LooseQty, Territory=C.AreaCode, Brick=C.SubAreaCode, Chemist = A.AliasName
FROM 
	SRLedger H, SRDetail D, Item I, ItemCategory IC, Customer C, Accounts A
WHERE 
	H.Date BETWEEN :adt_StartDate AND :adt_EndDate AND
	H.Posted = 'Y' AND
	H.SRInvCode = D.SRInvCode AND
	D.ICode = I.ICode AND
	I.ManfCode = :ai_manfcode AND 
	I.ICatCode=IC.ICatCode AND 
	H.CustCode = C.CustCode AND
	C.CustCode = A.Acccode
UNION ALL
SELECT 
	DistCode=LTRIM(RTRIM(:as_distcode + SPACE(10))), 
	City = LTRIM(RTRIM(:as_city  + SPACE(60))), 
	DocDate=CONVERT(VARCHAR(12), H.Date, 103),
	DocNo=H.PurInvCode, 
	DocType='PU',
	ItemCode=I.Remarks, 
	ItemName=I.Name, 
	PackSize=I.PackingDesc, 
	Team=IC.Name, 
	TradePrice=D.PurPrice,
	BatchNo=D.Batch, 
	Qty = D.LooseQty + (D.PackQty * D.PackUnits), 
	Territory=NULL, 
	Brick=NULL, 
	Chemist = NULL
FROM 
	PurLedger H, PurDetail D, Item I, ItemCategory IC, Supplier S, Accounts A
WHERE 
	H.Date BETWEEN :adt_StartDate AND :adt_EndDate AND
	H.Posted = 'Y' AND
	H.PurInvCode = D.PurInvCode AND
	D.ICode = I.ICode AND
	I.ManfCode = :ai_manfcode AND 
	I.ICatCode=IC.ICatCode AND
	H.SuppCode = S.SuppCode AND
	S.SuppCode = A.AccCode
UNION ALL
SELECT 
	DistCode=LTRIM(RTRIM(:as_distcode + SPACE(10))), 
	City = LTRIM(RTRIM(:as_city  + SPACE(60))), 
	DocDate=CONVERT(VARCHAR(12), H.Date, 103),
	DocNo=H.PrInvCode, 
	DocType='PR',
	ItemCode=I.Remarks, 
	ItemName=I.Name, 
	PackSize=I.PackingDesc, 
	Team=IC.Name, 
	TradePrice=D.PrPrice,
	BatchNo=D.Batch, 
	Qty = D.LooseQty, 
	Territory=NULL, 
	Brick=NULL, 
	Chemist = NULL
FROM 
	PrLedger H, PrDetail D, Item I, ItemCategory IC, Supplier S, Accounts A
WHERE 
	H.Date BETWEEN :adt_StartDate AND :adt_EndDate AND
	H.Posted = 'Y' AND
	H.PrInvCode = D.PrInvCode AND
	D.ICode = I.ICode AND
	I.ManfCode = :ai_manfcode AND 
	I.ICatCode=IC.ICatCode AND
	H.SuppCode = S.SuppCode AND
	S.SuppCode = A.AccCode
ORDER BY
	DocDate, DocType, DocNo, ItemName, BatchNo"
  arguments=(("as_distcode", string), ("as_city", string), ("ai_manfcode", number), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
