header(height=136 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=distidlen dbname="DistIDLen"  )
column=(type=char(5) updatewhereclause=yes name=distid dbname="DistID"  )
column=(type=long updatewhereclause=yes name=custcodelen dbname="CustCodeLen"  )
column=(type=char(6) updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=long updatewhereclause=yes name=typelen dbname="TypeLen"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type"  )
column=(type=long updatewhereclause=yes name=prodcodelen dbname="ProdCodeLen"  )
column=(type=char(6) updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=long updatewhereclause=yes name=saleqtylen dbname="SaleQtyLen"  )
column=(type=char(6) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=long updatewhereclause=yes name=fromdatelen dbname="FromDateLen"  )
column=(type=char(12) updatewhereclause=yes name=fromdate dbname="FromDate"  )
column=(type=long updatewhereclause=yes name=todatelen dbname="ToDateLen"  )
column=(type=char(28) updatewhereclause=yes name=todate dbname="ToDate"  )
 retrieve="SELECT
	DistIDLen = 5,
	DistID = LEFT(ISNULL(:as_distcode, (SELECT DBO.Fn_GetPreference('MerckDistCode'))) + SPACE(20), 5),
	CustCodeLen = 6,
	CustCode = LEFT(A.AliasName, 6),
	TypeLen=1,
	Type=LEFT(CC.Name, 1),
	ProdCodeLen=6, 
	ProdCode=LEFT(LTRIM(RTRIM(I.CustomICode)), 6),
	SaleQtyLen=6,
	SaleQty=STR(SUM(D.LooseQty), 6, 0),
	FromDateLen=10,
	FromDate=  
		CASE WHEN DatePart(dd, :ad_startdate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(dd, :ad_startdate), 2))) + '-' +
		CASE WHEN DatePart(mm, :ad_startdate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(mm, :ad_startdate), 2))) + '-' +
		LTRIM(RTRIM(STR(DatePart(yyyy, :ad_startdate), 4))),
	ToDateLen=10,
	ToDate= 
		CASE WHEN DatePart(dd, :ad_enddate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(dd, :ad_enddate)))) + '-' +
		CASE WHEN DatePart(mm, :ad_enddate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(mm, :ad_enddate)))) + '-' +
		LTRIM(RTRIM(STR(DatePart(yyyy, :ad_enddate), 4)))
FROM
	SaleLedger S,
	SaleDetail D,
	Item I,
	Customer C,
	Accounts A,
	CustomerCategory CC
WHERE
	S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
	S.SaleInvCode = D.SaleInvCode AND 
	D.ICode = I.ICode AND
	I.ManfCode IN (:ai_manfcode) AND
	S.CustCode = C.CustCode AND 
	C.CustCode = A.AccCode AND
	C.CustCatCode = CC.CustCatCode
GROUP BY
	A.AliasName, CC.Name, I.CustomICode
UNION ALL
SELECT 
	DistIDLen = 5,
	DistID = LEFT(ISNULL(:as_distcode, (SELECT DBO.Fn_GetPreference('MerckDistCode'))) + SPACE(20), 5),
	CustCodeLen = 6,
	CustCode = LEFT(A.AliasName, 6),
	TypeLen=1,
	Type=LEFT(CC.Name, 1),
	ProdCodeLen=6,
	ProdCode=LEFT(LTRIM(RTRIM(I.CustomICode)), 6),
	SaleQtyLen=6,
	SaleQty=STR(-SUM(D.LooseQty), 6, 0),
	FromDateLen=10,
	FromDate=  
		CASE WHEN DatePart(dd, :ad_startdate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(dd, :ad_startdate), 2))) + '-' +
		CASE WHEN DatePart(mm, :ad_startdate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(mm, :ad_startdate), 2))) + '-' +
		LTRIM(RTRIM(STR(DatePart(yyyy, :ad_startdate), 4))),
	ToDateLen=10,
	ToDate= 
		CASE WHEN DatePart(dd, :ad_enddate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(dd, :ad_enddate)))) + '-' +
		CASE WHEN DatePart(mm, :ad_enddate) > 9 THEN '' ELSE '0' END + LTRIM(RTRIM(STR(DatePart(mm, :ad_enddate)))) + '-' +
		LTRIM(RTRIM(STR(DatePart(yyyy, :ad_enddate), 4)))
FROM
	SRLedger S,
	SRDetail D,
	Item I,
	Customer C,
	Accounts A,
	CustomerCategory CC
WHERE
	S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
	S.SRInvCode = D.SRInvCode AND 
	D.ICode = I.ICode AND
	I.ManfCode IN (:ai_manfcode) AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	C.CustCatCode = CC.CustCatCode
GROUP BY
	A.AliasName, CC.Name, I.CustomICode
ORDER BY
	CustCode, Type, ProdCode
"
  arguments=(("as_distcode", string), ("ai_manfcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
