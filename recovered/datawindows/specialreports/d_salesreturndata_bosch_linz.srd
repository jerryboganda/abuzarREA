table(column=(type=char(40) updatewhereclause=yes name=mfg_cust_code dbname="Mfg_Cust_Code"  )
column=(type=char(8000) updatewhereclause=yes name=dist_code dbname="Dist_Code"  )
column=(type=char(5) updatewhereclause=yes name=mfg_loc dbname="Mfg_loc"  )
column=(type=long updatewhereclause=yes name=invoice_no dbname="Invoice_No"  )
column=(type=char(10) updatewhereclause=yes name=invoice_date dbname="Invoice_Date"  )
column=(type=char(12) updatewhereclause=yes name=customer_code dbname="Customer_Code"  )
column=(type=char(60) updatewhereclause=yes name=customer_name dbname="Customer_Name"  )
column=(type=long updatewhereclause=yes name=dist_brick_code dbname="Dist_Brick_Code"  )
column=(type=char(60) updatewhereclause=yes name=dist_brick_name dbname="Dist_Brick_Name"  )
column=(type=char(100) updatewhereclause=yes name=mfg_product_code dbname="Mfg_Product_Code"  )
column=(type=char(75) updatewhereclause=yes name=product_code dbname="Product_Code"  )
column=(type=long updatewhereclause=yes name=dist_team_code dbname="Dist_Team_Code"  )
column=(type=char(60) updatewhereclause=yes name=dist_team_name dbname="Dist_Team_Name"  )
column=(type=char(100) updatewhereclause=yes name=batch_no dbname="Batch_No"  )
column=(type=decimal(4) updatewhereclause=yes name=issue_quantity dbname="Issue_Quantity"  )
column=(type=decimal(4) updatewhereclause=yes name=receive_quantity dbname="Receive_Quantity"  )
column=(type=decimal(2) updatewhereclause=yes name=tp_rate dbname="TP_Rate"  )
column=(type=decimal(2) updatewhereclause=yes name=discount_per dbname="Discount_Per"  )
column=(type=decimal(2) updatewhereclause=yes name=mfg_discount dbname="Mfg_Discount"  )
column=(type=decimal(2) updatewhereclause=yes name=dist_discount dbname="Dist_Discount"  )
column=(type=long updatewhereclause=yes name=returntype dbname="ReturnType"  )
column=(type=char(30) updatewhereclause=yes name=customertype dbname="CustomerType"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus_qty dbname="Bonus_Qty"  )
 retrieve="SELECT 
	Mfg_Cust_Code = (SELECT M.ShortName FROM Manufacturer M WHERE ManfCode=I.ManfCode),
	Dist_Code=ISNULL(LTRIM(RTRIM(:as_distcode + REPLICATE(' ', 10 - LEN(:as_distcode)))), ''),
	Mfg_loc = (SELECT M.AliasName FROM Manufacturer M WHERE ManfCode=I.ManfCode),
	Invoice_No = SL.SRInvCode,
	Invoice_Date=Convert(varchar(10), SL.DATE, 103),
	Customer_Code  = LTRIM(RTRIM(A.AliasName)),
	Customer_Name = A.Name,
	Dist_Brick_Code = (SELECT AR.AreaCode FROM Area AR WHERE AR.AreaCode=C.AreaCode),
	Dist_Brick_Name = (SELECT AR.Name FROM Area AR WHERE AR.AreaCode=C.AreaCode),
	Mfg_Product_Code=I.Remarks,
	Product_Code=I.CustomICode,
	Dist_Team_Code = (SELECT SM.SalesManCode FROM SalesMan SM WHERE SM.SalesManCode=SL.SManCode),
	Dist_Team_Name = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode=SL.SManCode),
	Batch_No=SD.Batch, 
	Issue_Quantity=0.0000,
	Receive_Quantity=SD.LooseQty,
	TP_Rate = SD.SalePrice,
	Discount_Per = SD.DiscPerc,
	Mfg_Discount = SD.ClaimableDiscPerc,
	Dist_Discount = SD.DiscPerc,
	ReturnType = NULL,
	CustomerType = CC.Name,
	Bonus_Qty=SD.BonusQty
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I

WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:ai_manfcode) AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
"
  arguments=(("ai_manfcode", numberlist), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
