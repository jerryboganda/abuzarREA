footer(height=0 color="536870912" )
detail(height=88 color="536870912" )
table(column=(type=long updatewhereclause=yes name=codelen dbname="CodeLEN"  )
column=(type=char(10) updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=namelen dbname="NameLEN"  )
column=(type=char(50) updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes name=typelen dbname="TypeLEN"  )
column=(type=char(10) updatewhereclause=yes name=type dbname="Type"  )
column=(type=long updatewhereclause=yes name=compcodelen dbname="CompCodeLEN"  )
column=(type=char(10) updatewhereclause=yes name=compcode dbname="CompCode"  )
column=(type=long updatewhereclause=yes name=imiscodelen dbname="IMiscodeLEN"  )
column=(type=char(8000) updatewhereclause=yes name=imiscode dbname="IMiscode"  )
 retrieve="SELECT 
	CodeLEN=10,
	Code=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 10),
	NameLEN=50,
	Name=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	TypeLEN=10,
	Type=SPACE(10),
	CompCodeLEN=10,
	CompCode=STR(I.ManfCode, 10),
	IMiscodeLEN=10,
	IMiscode=:as_distcode + REPLICATE(' ', 10 - LEN(:as_distcode))
FROM
	Item I
WHERE
	I.ManfCode = :manfcode"
  arguments=(("manfcode", number), ("as_distcode", string))
)
