 retrieve="SELECT 
	DSTBIDLEN=6,
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	INVOICENOLEN=10,
	INVOICENO = STR(SL.SaleInvCode, 10),
	INVOICEDATELEN=11,
	INVOICEDATE=LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(11), SL.Date, 103), '/', '-')))),
	CUSTIDLEN=12,
	CUSTID = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),
	BrickIDLEN=9,
	BrickID=REPLICATE('0', 4 - LEN(LTRIM(RTRIM(STR(SAR.SUBAREACODE))))) + LTRIM(RTRIM(STR(SAR.SUBAREACODE))) + SPACE(5),
	PRODUCTIDLEN=12,
	PRODUCTID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 12),
	PRODUCTNAMELEN=60,
	PRODUCTNAME=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 60),
	BatchLEN=100,
	Batch=SUBSTRING(SD.Batch, 1, 100),
	RateLEN=12,
	Rate=STR(SD.SalePrice, 12, 2),
	QUANTITYLEN=12,
	QUANTITY=STR(SD.LooseQty, 12),
	BonusLEN=12,
	Bonus=STR(SD.BonusQty, 12),
	DiscountLEN=12,
	Discount=STR(
			Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + 
			(SD.LooseQty * SD.ItemFlatDisc), 12, 2),
	NetAmountLEN=12,
	NetAmount=STR(
			Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2),
	REASONLen=7,
	REASON=SPACE(6) + 'S',
	COMPANY_PRODUCT_CODELen=60,
	COMPANY_PRODUCT_CODE=SUBSTRING(LTRIM(RTRIM(I.Remarks)), 1, 60)
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	Area AR,
	SubArea SAR,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	:ai_scope=1 AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode AND
	C.SubAreaCode = SAR.SubAreaCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6,
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	INVOICENOLEN=10,
	INVOICENO = STR(SL.SRInvCode, 10),
	INVOICEDATELEN=11,
	INVOICEDATE=LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(11), SL.Date, 103), '/', '-')))),
	CUSTIDLEN=12,
	CUSTID = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),
	BrickIDLEN=9,
	BrickID=REPLICATE('0', 4 - LEN(LTRIM(RTRIM(STR(SAR.SUBAREACODE))))) + LTRIM(RTRIM(STR(SAR.SUBAREACODE))) + SPACE(5),
	PRODUCTIDLEN=12,
	PRODUCTID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 12),
	PRODUCTNAMELEN=60,
	PRODUCTNAME=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 60),
	BatchLEN=100,
	Batch=SUBSTRING(SD.Batch, 1, 100),
	RateLEN=12,
	Rate=STR(SD.SRPrice, 12, 2),
	QUANTITYLEN=12,
	QUANTITY=STR(SD.LooseQty, 12),
	BonusLEN=12,
	Bonus=STR(SD.BonusQty, 12),
	DiscountLEN=12,
	Discount=STR(
			Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2),
	NetAmountLEN=12,
	NetAmount=STR(
			Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2),
	REASONLen=7,
	REASON=SPACE(6) + 'R',
	COMPANY_PRODUCT_CODELen=60,
	COMPANY_PRODUCT_CODE=SUBSTRING(LTRIM(RTRIM(I.Remarks)), 1, 60)
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Area AR,
	SubArea SAR,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	:ai_scope=1 AND
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode AND
	C.SubAreaCode = SAR.SubAreaCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6,
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	INVOICENOLEN=10,
	INVOICENO = STR(SL.SaleInvCode, 10),
	INVOICEDATELEN=11,
	INVOICEDATE=LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(11), SL.Date, 103), '/', '-')))),
	CUSTIDLEN=12,
	CUSTID = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),
	BrickIDLEN=9,
	BrickID=REPLICATE('0', 4 - LEN(LTRIM(RTRIM(STR(SAR.SUBAREACODE))))) + LTRIM(RTRIM(STR(SAR.SUBAREACODE))) + SPACE(5),
	PRODUCTIDLEN=12,
	PRODUCTID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 12),
	PRODUCTNAMELEN=60,
	PRODUCTNAME=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 60),
	BatchLEN=100,
	Batch=SUBSTRING(SD.Batch, 1, 100),
	RateLEN=12,
	Rate=STR(SD.SalePrice, 12, 2),
	QUANTITYLEN=12,
	QUANTITY=STR(SD.LooseQty, 12),
	BonusLEN=12,
	Bonus=STR(SD.BonusQty, 12),
	DiscountLEN=12,
	Discount=STR(
			Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + 
			(SD.LooseQty * SD.ItemFlatDisc), 12, 2),
	NetAmountLEN=12,
	NetAmount=STR(
			Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2),
	REASONLen=7,
	REASON=SPACE(6) + 'S',
	COMPANY_PRODUCT_CODELen=60,
	COMPANY_PRODUCT_CODE=SUBSTRING(LTRIM(RTRIM(I.Remarks)), 1, 60)
FROM
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	CRS_SaleLedger SL,
	CRS_SaleDetail SD,
	Customer C,
	Area AR,
	SubArea SAR,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	:ai_scope=2 AND
	CL.ClientID = CI.ClientID AND CI.ClientInstanceID = SL.ClientInstanceID AND
	SL.ClientInstanceID = SD.ClientInstanceID AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode AND
	C.SubAreaCode = SAR.SubAreaCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6,
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	INVOICENOLEN=10,
	INVOICENO = STR(SL.SRInvCode, 10),
	INVOICEDATELEN=11,
	INVOICEDATE=LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(11), SL.Date, 103), '/', '-')))),
	CUSTIDLEN=12,
	CUSTID = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),
	BrickIDLEN=9,
	BrickID=REPLICATE('0', 4 - LEN(LTRIM(RTRIM(STR(SAR.SUBAREACODE))))) + LTRIM(RTRIM(STR(SAR.SUBAREACODE))) + SPACE(5),
	PRODUCTIDLEN=12,
	PRODUCTID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 12),
	PRODUCTNAMELEN=60,
	PRODUCTNAME=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 60),
	BatchLEN=100,
	Batch=SUBSTRING(SD.Batch, 1, 100),
	RateLEN=12,
	Rate=STR(SD.SRPrice, 12, 2),
	QUANTITYLEN=12,
	QUANTITY=STR(SD.LooseQty, 12),
	BonusLEN=12,
	Bonus=STR(SD.BonusQty, 12),
	DiscountLEN=12,
	Discount=STR(
			Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2),
	NetAmountLEN=12,
	NetAmount=STR(
			Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2),
	REASONLen=7,
	REASON=SPACE(6) + 'R',
	COMPANY_PRODUCT_CODELen=60,
	COMPANY_PRODUCT_CODE=SUBSTRING(LTRIM(RTRIM(I.Remarks)), 1, 60)
FROM
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	CRS_SRLedger SL,
	CRS_SRDetail SD,
	Customer C,
	Area AR,
	SubArea SAR,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	:ai_scope=2 AND
	CL.ClientID = CI.ClientID AND CI.ClientInstanceID = SL.ClientInstanceID AND
	SL.ClientInstanceID = SD.ClientInstanceID AND
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode AND
	C.SubAreaCode = SAR.SubAreaCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate"
  arguments=(("as_dstcode", string), ("manfcode", number), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ai_scope", number))
)
