release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=codelen dbname="CodeLen"  )
column=(type=char(10) updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=namelen dbname="NameLen"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes name=address1len dbname="Address1Len"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=long updatewhereclause=yes name=address2len dbname="Address2Len"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=long updatewhereclause=yes name=contactnolen dbname="ContactNoLen"  )
column=(type=char(100) updatewhereclause=yes name=contactno dbname="ContactNo"  )
column=(type=long updatewhereclause=yes name=licensenolen dbname="LicenseNoLen"  )
column=(type=char(30) updatewhereclause=yes name=licenseno dbname="LicenseNo"  )
column=(type=long updatewhereclause=yes name=regioncodelen dbname="RegionCodeLen"  )
column=(type=char(5) updatewhereclause=yes name=regioncode dbname="RegionCode"  )
column=(type=long updatewhereclause=yes name=regionnamelen dbname="RegionNameLen"  )
column=(type=char(60) updatewhereclause=yes name=regionname dbname="RegionName"  )
column=(type=long updatewhereclause=yes name=typelen dbname="TypeLen"  )
column=(type=char(30) updatewhereclause=yes name=type dbname="Type"  )
column=(type=long updatewhereclause=yes name=dscodelen dbname="DsCodeLen"  )
column=(type=char(100) updatewhereclause=yes name=dscode dbname="DsCode"  )
 retrieve="SELECT 
	CodeLen=10,
	Code=STR(C.CustCode, 10),
	NameLen=100,
	Name=A.Name,
	Address1Len=100,
	Address1=C.Address1,
	Address2Len=100,
	Address2=C.Address2,
	ContactNoLen=100,
	ContactNo=C.Phone,
	LicenseNoLen=100,
	LicenseNo=C.LicenceNo,
	RegionCodeLen=5,
	RegionCode=STR(AR.AreaCode, 5),
	RegionNameLen=100,
	RegionName=AR.Name,
	TypeLen=100,
	Type=CC.Name,
	DsCodeLen=100,
	DsCode=CONVERT(VARCHAR(100), :as_dscode)
FROM
	Accounts A, Customer C, Area AR, CustomerCategory CC
WHERE
	A.AccCode = C.CustCode AND C.AreaCode = AR.AreaCode AND
	C.CustCatCode = CC.CustCatCode
ORDER BY
	CustCode
"
  arguments=(("as_dscode", string))
)
