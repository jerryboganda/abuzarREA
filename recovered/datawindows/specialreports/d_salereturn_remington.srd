header(height=1458 color="536870912" )
summary(height=208 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=areacode dbname="AREACODE"  )
column=(type=char(60) updatewhereclause=yes name=areaname dbname="AREANAME"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CUSTCODE"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="CUSTNAME"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="ITEMCODE"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ITEMNAME"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="PACKING"  )
column=(type=long updatewhereclause=yes name=invcode dbname="INVCODE"  )
column=(type=char(12) updatewhereclause=yes name=date dbname="Item.DATE"  )
column=(type=decimal(4) updatewhereclause=yes name=quantity dbname="QUANTITY"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BONUSQTY"  )
column=(type=decimal(2) updatewhereclause=yes name=discount dbname="DISCOUNT"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="RATE"  )
column=(type=decimal(6) updatewhereclause=yes name=value dbname="VALUE"  )
 retrieve="SELECT
	AREACODE=A.AREACODE,
	AREANAME=A.NAME, 
	CUSTCODE=C.CUSTCODE, 
	CUSTNAME=AC.NAME,
	ITEMCODE=S.ITEMCODE, 
	ITEMNAME=I.NAME, 
	PACKING=I.PACKINGDESC,  
	INVCODE=S.INVCODE, 
	DATE, 
	QUANTITY=SUM(ISNULL(S.QUANTITY,0)), 
	BONUSQTY=SUM(ISNULL(S.BONUSQTY,0)),
	DISCOUNT=MAX(ISNULL(S.DISCOUNT,0)), 
	RATE=MAX(ISNULL(S.RATE,0)),
	VALUE=ROUND(SUM(ISNULL(S.QUANTITY * S.RATE * (1 - S.Discount * 0.01),0)), 2)

FROM
	(SELECT 
		TYPE='R',
		DATE=CONVERT(VARCHAR(12), SL.DATE,103), 
		INVCODE=SL.SRINVCODE, 
		CUSTCODE=SL.CUSTCODE, 
		ITEMCODE=SD.ICODE, 
		QUANTITY=SUM(SD.LOOSEQTY), 
		BONUSQTY=SUM(SD.BONUSQTY),
		DISCOUNT=MAX(SD.DISCPERC), 
		RATE=MAX(SD.SRPRICE)
	FROM 
		ITEM I, 
		SRLEDGER SL, 
		SRDETAIL SD
	WHERE
		SL.SRINVCODE = SD.SRINVCODE AND 
		SL.DATE BETWEEN :ad_startdate AND :ad_enddate AND
		SL.POSTED='Y' AND
		I.MANFCODE = :ai_manfcode AND 
		I.ICODE = SD.ICODE
	GROUP BY 
		SL.SRINVCODE, 
		SL.CUSTCODE, 
		CONVERT(VARCHAR(12), SL.DATE,103),
		SD.ICODE) S,
	ITEM I,
	CUSTOMER C,
	AREA A,
	ACCOUNTS AC

WHERE
	S.ITEMCODE = I.ICODE AND
	S.CUSTCODE = C.CUSTCODE AND
	C.CUSTCODE = AC.ACCCODE AND
	C.AREACODE = A.AREACODE
GROUP BY 
	S.TYPE,
	S.INVCODE, 
	S.ITEMCODE, 
	S.DATE,
	C.CUSTCODE, 
	AC.NAME, 
	A.AREACODE, 
	A.NAME, 
	I.NAME, 
	I.PACKINGDESC

ORDER BY DATE, INVCODE, TYPE, ITEMCODE
"
  arguments=(("ai_manfcode", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
