column=(type=char(16) updatewhereclause=yes name=townid dbname="TOWNID"  )
column=(type=long updatewhereclause=yes name=townlen dbname="TOWNLEN"  )
column=(type=char(8000) updatewhereclause=yes name=town dbname="TOWN"  )
column=(type=long updatewhereclause=yes name=ptclnolen dbname="PTCLNoLen"  )
column=(type=char(12) updatewhereclause=no name=ptclno dbname="PTCLNo"  )
column=(type=long updatewhereclause=yes name=mobileno1len dbname="MobileNo1Len"  )
column=(type=char(12) updatewhereclause=no name=mobileno1 dbname="MobileNo1"  )
column=(type=long updatewhereclause=yes name=mobileno2len dbname="MobileNo2Len"  )
column=(type=char(12) updatewhereclause=no name=mobileno2 dbname="MobileNo2"  )
