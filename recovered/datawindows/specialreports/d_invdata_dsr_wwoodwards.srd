footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(10) updatewhereclause=yes name=invoiceno dbname="InvoiceNo"  )
column=(type=char(10) updatewhereclause=yes name=invoicedate dbname="InvoiceDate"  )
column=(type=char(60) updatewhereclause=yes name=shopname dbname="ShopName"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(60) updatewhereclause=yes name=productname dbname="ProductName"  )
column=(type=char(10) updatewhereclause=yes name=territorycode dbname="TerritoryCode"  )
column=(type=char(12) updatewhereclause=yes name=quantitysale dbname="QuantitySale"  )
column=(type=char(12) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=char(100) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=char(12) updatewhereclause=yes name=extradiscount dbname="ExtraDiscount"  )
column=(type=char(60) updatewhereclause=yes name=spo dbname="SPO"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type"  )
 retrieve="SELECT 
	InvoiceNo = LTRIM(RTRIM(STR(SL.SaleInvCode, 10))),
	InvoiceDate=Convert(varchar(10), SL.DATE, 103),
	ShopName = A.Name,
	Address = C.Address1,
	ProductName=I.Name,
	TerritoryCode=LTRIM(RTRIM(STR(C.AREACODE,10))),
	QuantitySale = LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	Bonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	BatchNo=SD.Batch,
	ExtraDiscount=LTRIM(RTRIM(STR(
			Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) + 
			(SD.LooseQty * SD.ItemFlatDisc), 12, 2))),
	SPO=(SELECT SM.NAME FROM SALESMAN SM WHERE SM.SALESMANCODE = C.SALESMANCODE),
	Type='S'
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
UNION ALL
SELECT 
	InvoiceNo = LTRIM(RTRIM(STR(SL.SRInvCode, 10))),
	InvoiceDate=Convert(varchar(10), SL.DATE, 103),
	ShopName = A.Name,
	Address = C.Address1,
	ProductName=I.Name,
	TerritoryCode=LTRIM(RTRIM(STR(C.AREACODE,10))),
	QuantitySale = LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	Bonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	BatchNo=SD.Batch,
	ExtraDiscount=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	SPO=(SELECT SM.NAME FROM SALESMAN SM WHERE SM.SALESMANCODE = C.SALESMANCODE),
	Type='R'
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
"
  arguments=(("manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
