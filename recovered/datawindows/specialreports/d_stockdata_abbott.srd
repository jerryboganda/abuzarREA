table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=prdidlen dbname="PRDIDLEN"  )
column=(type=char(9) updatewhereclause=yes name=prdid dbname="PRDID"  )
column=(type=long updatewhereclause=yes name=prdlen dbname="PRDLEN"  )
column=(type=char(50) updatewhereclause=yes name=prd dbname="PRD"  )
column=(type=long updatewhereclause=yes name=cldatelen dbname="CLDATELEN"  )
column=(type=char(10) updatewhereclause=yes name=cldate dbname="CLDATE"  )
column=(type=long updatewhereclause=yes name=batchnolen dbname="BATCHNOLEN"  )
column=(type=char(100) updatewhereclause=yes name=batchno dbname="BATCHNO"  )
column=(type=long updatewhereclause=yes name=closinglen dbname="CLOSINGLEN"  )
column=(type=char(12) updatewhereclause=yes name=closing dbname="CLOSING"  )
column=(type=long updatewhereclause=yes name=ebatchlen dbname="EBatchLEN"  )
column=(type=char(10) updatewhereclause=yes name=ebatch dbname="EBatch"  )
 retrieve="SELECT  
	DSTBIDLEN=6,
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	PRDIDLEN=9, 
	PRDID=SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	CLDATELEN=10,
	CLDATE=Convert(varchar(10), :adt_enddate, 103), 
	BATCHNOLEN=10,
	BATCHNO=GD.Batch, 
	CLOSINGLEN=12,
	CLOSING=STR(ISNULL(GD.CurrQty, 0), 12),
	EBatchLEN=10,
	EBatch=Convert(varchar(10), GD.Expiry, 103)
FROM
	Item I LEFT OUTER JOIN GodownDetail AS GD ON (I.ICode = GD.ICode)
WHERE
	:ai_scope = 1 AND
	I.ManfCode = :manfcode
UNION ALL
SELECT  
	DSTBIDLEN=6,
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	PRDIDLEN=9, 
	PRDID=SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	CLDATELEN=10,
	CLDATE=Convert(varchar(10), :adt_enddate, 103), 
	BATCHNOLEN=10,
	BATCHNO=GD.Batch, 
	CLOSINGLEN=12,
	CLOSING=STR(ISNULL(GD.CurrQty, 0), 12),
	EBatchLEN=10,
	EBatch=Convert(varchar(10), GD.Expiry, 103)
FROM
	Item I LEFT OUTER JOIN CRS_GodownDetail AS GD ON (I.ICode = GD.ICode)
WHERE
	:ai_scope = 2 AND
	I.ManfCode = :manfcode
"
  arguments=(("as_distcode", string), ("manfcode", number), ("adt_enddate", datetime), ("ai_scope", number))
)
