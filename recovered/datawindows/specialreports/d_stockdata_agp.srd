release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=long updatewhereclause=yes name=prodcodelen dbname="ProdCodeLen"  )
column=(type=char(10) updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=long updatewhereclause=yes name=batchnolen dbname="BatchNoLen"  )
column=(type=char(10) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=long updatewhereclause=yes name=openingstocklen dbname="OpeningStockLen"  )
column=(type=char(13) updatewhereclause=yes name=openingstock dbname="OpeningStock"  )
column=(type=long updatewhereclause=yes name=openingbonuslen dbname="OpeningBonusLen"  )
column=(type=char(13) updatewhereclause=yes name=openingbonus dbname="OpeningBonus"  )
column=(type=long updatewhereclause=yes name=purchaseqtylen dbname="PurchaseQtyLen"  )
column=(type=char(13) updatewhereclause=yes name=purchaseqty dbname="PurchaseQty"  )
column=(type=long updatewhereclause=yes name=purchasebonuslen dbname="PurchaseBonusLen"  )
column=(type=char(13) updatewhereclause=yes name=purchasebonus dbname="PurchaseBonus"  )
column=(type=long updatewhereclause=yes name=salelen dbname="SaleLen"  )
column=(type=char(13) updatewhereclause=yes name=sale dbname="Sale"  )
column=(type=long updatewhereclause=yes name=salebonuslen dbname="SaleBonusLen"  )
column=(type=char(13) updatewhereclause=yes name=salebonus dbname="SaleBonus"  )
column=(type=long updatewhereclause=yes name=breakagelen dbname="BreakageLen"  )
column=(type=char(13) updatewhereclause=yes name=breakage dbname="Breakage"  )
column=(type=long updatewhereclause=yes name=expiredqtylen dbname="ExpiredQtyLen"  )
column=(type=char(13) updatewhereclause=yes name=expiredqty dbname="ExpiredQty"  )
column=(type=long updatewhereclause=yes name=adjustmentinlen dbname="AdjustmentINLen"  )
column=(type=char(13) updatewhereclause=yes name=adjustmentin dbname="AdjustmentIN"  )
column=(type=long updatewhereclause=yes name=adjustmentoutlen dbname="AdjustmentOutLen"  )
column=(type=char(13) updatewhereclause=yes name=adjustmentout dbname="AdjustmentOut"  )
column=(type=long updatewhereclause=yes name=closingstocklen dbname="ClosingStockLen"  )
column=(type=char(13) updatewhereclause=yes name=closingstock dbname="ClosingStock"  )
column=(type=long updatewhereclause=yes name=datelen dbname="DateLen"  )
column=(type=char(8000) updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=dscodelen dbname="DsCodeLen"  )
column=(type=char(100) updatewhereclause=yes name=dscode dbname="DsCode"  )
 retrieve="SELECT
	ProdCodeLen=10,
	ProdCode=STR(ST.ICode, 10),
	BatchNoLen=10,
	BatchNo=SUBSTRING(St.Batch,1,10),
	OpeningStockLen=13,
	OpeningStock=STR(SUM(CASE WHEN type='OP' THEN st.qty ELSE 0 END), 13),
	OpeningBonusLen=13,
	OpeningBonus=STR(SUM(CASE WHEN type='OP' THEN st.bonus ELSE 0 END), 13),
	PurchaseQtyLen=13,
	PurchaseQty=STR(SUM(CASE TYPE WHEN 'PV' THEN st.qty ELSE 0 END), 13),
	PurchaseBonusLen=13,
	PurchaseBonus=STR(SUM(CASE TYPE WHEN 'PV' THEN st.bonus ELSE 0 END), 13),
	SaleLen=13,
	Sale=STR(SUM(CASE TYPE WHEN 'SV' THEN st.qty WHEN 'SR' THEN -(st.qty) ELSE 0 END), 13),
	SaleBonusLen=13,
	SaleBonus=STR(SUM(CASE TYPE WHEN 'SV' THEN st.bonus WHEN 'SR' THEN -(st.Bonus) ELSE 0 END), 13),
	BreakageLen=13,
	Breakage=STR(SUM(CASE TYPE  WHEN 'PR' THEN  CASE WHEN st.Expiry <= GETDATE() THEN 0 ELSE (st.qty + st.bonus) END ELSE 0 END), 13),
	ExpiredQtyLen=13,
	ExpiredQty=STR(SUM(CASE TYPE  WHEN 'PR' THEN  CASE WHEN st.Expiry <= GETDATE() THEN (st.qty + st.bonus) ELSE 0 END ELSE 0 END), 13),
	AdjustmentINLen=13,
	AdjustmentIN=STR(SUM(CASE TYPE  WHEN 'AI' THEN  (st.qty + st.bonus) ELSE 0 END), 13),
	AdjustmentOutLen=13,
	AdjustmentOut=STR(SUM(CASE TYPE  WHEN 'AD' THEN  (st.qty + st.bonus) ELSE 0 END), 13),
	ClosingStockLen=13,
	ClosingStock=STR(SUM(
		CASE WHEN TYPE = 'OP' OR TYPE = 'PV' OR TYPE = 'SR' OR TYPE = 'RV' OR TYPE = 'AI' THEN +1 
		ELSE -1 END * (st.qty + st.Bonus) ), 13),
	DateLen=9,
	Date=UPPER(REPLACE( SUBSTRING(CONVERT(VARCHAR(100), GetDate(), 106), 1, 7), ' ', '-')) + STR(RIGHT(YEAR(GetDate()), 2), 2),
	DsCodeLen=100,
	DsCode=CONVERT(VARCHAR(100), :as_dscode)
FROM
	(SELECT type='OP', icode, batch,expiry, qty = sum(qty), bonus = sum(bonus)
	FROM	
		(select pd.icode, pd.batch, pd.expiry,
			qty = sum(isnull(
				case pl.purcatcode 
				when 1 THEN (pd.packqty * pd.packunits)
				when 2 THEN (pd.packqty * pd.packunits)
				else pd.looseqty end, 0)), 
			bonus = sum(isnull(
				case pl.purcatcode 
				when 1 THEN (pd.bonusqty * pd.packunits)
				when 2 THEN (pd.bonusqty * pd.packunits)
				else pd.bonusqty end, 0))
		FROM purledger pl, purdetail pd, item i
		WHERE pl.posted = 'Y' AND 
			pl.purinvcode = pd.purinvcode AND
			pl.postdate < :ar_startdate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode, pd.batch,pd.expiry
		UNION ALL
		select	pd.icode, pd.batch,pd.expiry,
			qty  = - sum(pd.looseqty),
			bonus = - sum(pd.bonusqty)
		FROM prledger pl, prdetail pd, item i
		WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
			pl.date < :ar_startdate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode, pd.batch,pd.expiry
		UNION ALL
		select	sd.icode, sd.batch,sd.expiry,
			qty  = -sum(sd.looseqty),
			bonus  = -sum(sd.bonusqty)
		FROM saleledger sl, saledetail sd, item i
		WHERE sl.saleinvcode = sd.saleinvcode AND
			  sl.posted = 'Y' AND 
		      sl.date < :ar_startdate AND sd.Due IS NULL AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch,sd.expiry,
			qty  = sum(sd.looseqty),
			bonus = sum(sd.bonusqty)
		FROM srledger sl, srdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
			  sl.posted = 'Y' AND 
		      sl.postdate < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch, sd.expiry,qty  = -sum(sd.qty), bonus = 0
		FROM issueheader sl, issuedetail sd, item i
		WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch, sd.expiry,qty  = sum(sd.qty), bonus=0
		FROM receiptheader sl, receiptdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
		      sl.postdate < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch,sd.expiry, qty = sum(sd.looseqty), bonus=0
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		      sl.posteddate < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch,sd.expiry, qty = -sum(sd.looseqty), bonus=0
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		      sl.posteddate < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	d.icode, d.batch, d.expiry, qty = -sum(d.duesatisfyqty), bonus=0
		FROM duesatisfyheader h, duesatisfydetail d, item i
		WHERE h.duesatisfycode=d.duesatisfycode AND
		      h.duesatisfydate < :ar_startdate AND
			d.icode=i.icode and i.manfcode in (:manfcode)
		Group By d.icode, d.batch,d.expiry) A
	GROUP BY icode, batch,expiry
	UNION ALL
	select	type='PV',
		pd.icode, pd.batch,pd.expiry,
		qty = sum(pd.looseqty + pd.packqty * pd.packunits),
		bonus = sum(isnull(case pl.purcatcode 
			when 1 THEN pd.bonusqty * pd.packunits
			when 2 THEN pd.bonusqty * pd.packunits
			else pd.bonusqty
			end, 0))
	FROM purledger pl, purdetail pd, item i
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pl.postdate BETWEEN :ar_startdate and :ar_enddate AND
		pd.icode=i.icode and i.manfcode in (:manfcode)
	Group By pd.icode, pd.batch,pd.expiry
	UNION ALL
	select	type='PR',
		pd.icode,
		pd.batch,pd.expiry,
		qty = sum(pd.looseqty),
		bonus = sum(pd.bonusqty)
	FROM prledger pl, prdetail pd, item i
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
	      pl.date BETWEEN :ar_startdate and :ar_enddate AND
		pd.icode=i.icode and i.manfcode in (:manfcode)
	Group By pd.icode, pd.batch,pd.expiry
	UNION ALL
	select	type='SV',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = sum(sd.bonusqty)
	FROM saleledger sl, saledetail sd, item i
	WHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
		sl.date BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='SR',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = sum(sd.bonusqty)
	FROM srledger sl, srdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
	      sl.postdate BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='IV',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.qty),
		bonus = 0
	FROM issueheader sl, issuedetail sd, item i
	WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
	      sl.date BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='DS',
		d.icode, d.batch,d.expiry,
		qty = sum(d.duesatisfyqty),
		bonus = 0
	FROM duesatisfyheader h, duesatisfydetail d, item i
	WHERE h.duesatisfycode = d.duesatisfycode AND
	      h.duesatisfydate BETWEEN :ar_startdate and :ar_enddate AND
		d.icode=i.icode and i.manfcode in (:manfcode)
	Group By d.icode, d.batch,d.expiry
	UNION ALL
	select	type='RV',
		sd.icode, sd.batch, sd.expiry, 
		qty = sum(sd.qty),
		bonus = 0
	FROM receiptheader sl, receiptdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	      sl.postdate BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='AI',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = 0
	FROM Adjheader sl, Adjdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		sl.posteddate BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='AD',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = 0
	FROM Adjheader sl, Adjdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		sl.date BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry) St, 
	Item i
WHERE st.icode = i.icode
GROUP BY st.icode, i.name, st.batch
ORDER BY st.icode
"
  arguments=(("manfcode", numberlist), ("as_dscode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
 filter=" integer(trim(openingstock)) <> 0 OR  integer(trim(openingbonus)) <> 0 OR integer(trim( purchaseqty )) <> 0 OR integer(trim( purchasebonus )) <> 0 OR integer(trim( sale )) <> 0 OR integer(trim( salebonus )) <> 0 OR  integer(trim( breakage )) <> 0 OR integer(trim( expiredqty)) <> 0 OR integer(trim( adjustmentin )) <> 0 OR  integer(trim( adjustmentout )) <> 0 OR integer(trim( closingstock )) <> 0"
 )
