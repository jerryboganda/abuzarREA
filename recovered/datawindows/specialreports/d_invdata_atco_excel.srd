footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=documentno dbname="DOCUMENTNO"  )
column=(type=char(10) updatewhereclause=yes name=docdate dbname="DOCDATE"  )
column=(type=long updatewhereclause=yes name=custid dbname="CUSTID"  )
column=(type=long updatewhereclause=yes name=townid dbname="TOWNID"  )
column=(type=long updatewhereclause=yes name=prdid dbname="PRDID"  )
column=(type=char(60) updatewhereclause=yes name=prd dbname="PRD"  )
column=(type=char(100) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(10) updatewhereclause=yes name=discount dbname="DISCOUNT"  )
column=(type=decimal(10) updatewhereclause=yes name=netamount dbname="NETAMOUNT"  )
column=(type=char(1) updatewhereclause=yes name=reason dbname="REASON"  )
 retrieve="SELECT  
	DSTBID=AR.TAG,
	DOCUMENTNO = SL.SaleInvCode,
	DOCDATE=Convert(varchar(10), SL.DATE, 103), 
	CUSTID = SL.CustCode,
	TOWNID=AR.AREACODE,
	PRDID=SD.ICode, 
	PRD=I.Name,
	BatchNo=SD.Batch, 
	Price=SD.SalePrice, 
	Qty=SD.LooseQty, 
	Bonus=SD.BonusQty, 
	DISCOUNT=Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2),
	NETAMOUNT=Round((SD.LooseQty * SD.SalePrice * (1 - SD.DiscPerc * 0.01)), 2),
	REASON='S'
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	CustomerCategory CC,
	Item I,
	Area Ar
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = Ar.AreaCode
UNION ALL
SELECT 
	DSTBID=AR.TAG,
	DOCUMENTNO = SL.SRInvCode,
	DOCDATE=Convert(varchar(10), SL.DATE, 103), 
	CUSTID = SL.CustCode,
	TOWNID=AR.AREACODE,
	PRDID=SD.ICode,
	PRD=I.Name, 
	BatchNo=SD.Batch, 
	Price=SD.SRPrice,
	Qty=SD.LooseQty, 
	Bonus=SD.BonusQty, 
	DISCOUNT=Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 
	NETAMOUNT=Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 
	REASON='R'
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	CustomerCategory CC,
	Item I,
	Area AR

WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode"
  arguments=(("manfcode", number), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
