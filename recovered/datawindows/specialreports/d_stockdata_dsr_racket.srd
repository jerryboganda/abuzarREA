table(column=(type=char(4) updatewhereclause=yes name=fiscalyear dbname="FiscalYear"  )
column=(type=char(2) updatewhereclause=yes name=period dbname="Period"  )
column=(type=char(2) updatewhereclause=yes name=tradesector dbname="TradeSector"  )
column=(type=char(101) updatewhereclause=yes name=distributorcode dbname="DistributorCode"  )
column=(type=char(101) updatewhereclause=yes name=warehousecode dbname="WareHouseCode"  )
column=(type=char(75) updatewhereclause=yes name=skucode dbname="SKUCode"  )
column=(type=char(100) updatewhereclause=yes name=batchcode dbname="BatchCode"  )
column=(type=char(10) updatewhereclause=yes name=closingdate dbname="ClosingDate"  )
column=(type=char(12) updatewhereclause=yes name=deliveredstockqty dbname="DeliveredStockQty"  )
column=(type=char(2) updatewhereclause=yes name=deliveredstockunit dbname="DeliveredStockUnit"  )
column=(type=char(12) updatewhereclause=yes name=deliveredstockvalue dbname="DeliveredStockValue"  )
column=(type=char(12) updatewhereclause=yes name=damagedstockqty dbname="DamagedStockQty"  )
column=(type=char(2) updatewhereclause=yes name=damagedstockunit dbname="DamagedStockUnit"  )
column=(type=char(12) updatewhereclause=yes name=damagedstockvalue dbname="DamagedStockValue"  )
column=(type=char(12) updatewhereclause=yes name=expiredstockqty dbname="ExpiredStockQty"  )
column=(type=char(2) updatewhereclause=yes name=expiredstockunit dbname="ExpiredStockUnit"  )
column=(type=char(12) updatewhereclause=yes name=expiredstockvalue dbname="ExpiredStockValue"  )
 retrieve="SELECT
	FiscalYear=STR(Year(:ar_startdate), 4),
	Period=STR(Month(:ar_startdate), 2),
	TradeSector = 'PH',
	DistributorCode=LTRIM(RTRIM(:as_distcode + SPACE(100))),
	WareHouseCode=LTRIM(RTRIM(:as_distcode + SPACE(100))),
	SKUCode=LTRIM(RTRIM(LTRIM(RTRIM(I.CustomICode)))),
	BatchCode=GD.Batch,
	ClosingDate=CONVERT(VARCHAR(10), :ar_enddate, 104),
	DeliveredStockQty = LTRIM(RTRIM(STR(SUM(GD.CurrQty), 12))),
	DeliveredStockUnit = 'EA',
	DeliveredStockValue	= LTRIM(RTRIM(STR(SUM(ROUND(GD.CurrQty * I.PurPrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END, 2)), 12))),
	DamagedStockQty = '           0',
	DamagedStockUnit = 'EA',
	DamagedStockValue = '           0',
	ExpiredStockQty = '           0',
	ExpiredStockUnit = 'EA',
	ExpiredStockValue = '           0'
FROM
	GodownDetail GD, Item I
WHERE I.ManfCode = :ai_manfcode AND GD.ICode = I.ICode
GROUP BY I.CustomICode, GD.Batch
ORDER BY I.CustomICode, GD.Batch
"
  arguments=(("ai_manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
