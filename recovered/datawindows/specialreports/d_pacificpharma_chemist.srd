footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(12) updatewhereclause=yes name=chemistcode dbname="ChemistCode"  )
column=(type=char(60) updatewhereclause=yes name=chemistname dbname="ChemistName"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(60) updatewhereclause=yes name=territory dbname="Territory"  )
column=(type=char(60) updatewhereclause=yes name=brick dbname="Brick"  )
 retrieve="SELECT ChemistCode=A.AliasName, ChemistName=A.Name, Address1=C.Address1, Address2=C.Address2, City=C.City, Territory = AR.Name, Brick=SA.Name
FROM Customer C, Accounts A, Area AR, SubArea SA
WHERE C.CustCode=A.AccCode AND 
	C.AreaCode = AR.AreaCode AND
	C.SubAreaCode = SA.SubAreaCode
ORDER BY Territory, Brick, ChemistName, ChemistCode
"
 )
