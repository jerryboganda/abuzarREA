release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=prodcodelen dbname="PRODCODELEN"  )
column=(type=char(10) updatewhereclause=yes name=prodcode dbname="PRODCODE"  )
column=(type=long updatewhereclause=yes name=prodnamelen dbname="ProdNameLen"  )
column=(type=char(60) updatewhereclause=yes name=prodname dbname="ProdName"  )
column=(type=long updatewhereclause=yes name=proddesclen dbname="ProdDescLen"  )
column=(type=char(100) updatewhereclause=yes name=proddesc dbname="ProdDesc"  )
column=(type=long updatewhereclause=yes name=packlen dbname="PackLen"  )
column=(type=char(50) updatewhereclause=yes name=pack dbname="Pack"  )
column=(type=long updatewhereclause=yes name=pricelen dbname="PriceLEN"  )
column=(type=char(12) updatewhereclause=yes name=price dbname="Price"  )
column=(type=long updatewhereclause=yes name=compcodelen dbname="CompCodeLen"  )
column=(type=char(5) updatewhereclause=yes name=compcode dbname="CompCode"  )
column=(type=long updatewhereclause=yes name=dscodelen dbname="DsCodeLen"  )
column=(type=char(100) updatewhereclause=yes name=dscode dbname="DsCode"  )
 retrieve="SELECT 
	PRODCODELEN=10,
	PRODCODE=STR(I.ICode, 10),
	ProdNameLen=100,
	ProdName=I.Name,
	ProdDescLen=100,
	ProdDesc=I.Remarks,
	PackLen=100,
	Pack=I.PackingDesc,
	PriceLEN=12,
	Price=STR(ISNULL(I.SalePrice, 0), 12, 2),
	CompCodeLen=5,
	CompCode=M.ALIASNAME,
	DsCodeLen=100,
	DsCode=CONVERT(VARCHAR(100), :as_dscode)
FROM
	Item I, Manufacturer M
WHERE
	I.ManfCode = M.ManfCode AND M.ManfCode IN (:ai_manfcode)
ORDER BY
	PRODCODE"
  arguments=(("ai_manfcode", numberlist), ("as_dscode", string))
)
