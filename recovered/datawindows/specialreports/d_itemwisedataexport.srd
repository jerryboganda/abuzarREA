release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=141 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=74 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=product dbname="Product"  )
column=(type=char(100) updatewhereclause=yes name=distributername dbname="DistributerName"  )
column=(type=char(60) updatewhereclause=yes name=branchname dbname="BranchName"  )
column=(type=long updatewhereclause=yes name=invoiceno dbname="InvoiceNo"  )
column=(type=char(12) updatewhereclause=yes name=customercode dbname="CustomerCode"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(30) updatewhereclause=yes name=customercategorycode dbname="CustomerCategoryCode"  )
column=(type=datetime updatewhereclause=yes name=dateofinvoice dbname="DateofInvoice"  )
column=(type=char(100) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=decimal(4) updatewhereclause=yes name=quantity dbname="Quantity"  )
column=(type=char(3) updatewhereclause=yes name=invoicereceivingstatus dbname="InvoiceReceivingStatus"  )
column=(type=char(100) updatewhereclause=yes name=popcontactnumber dbname="POPContactNumber"  )
column=(type=char(0) updatewhereclause=yes name=filerefno dbname="FileRefNo"  )
 retrieve="SELECT 
	Product = I.Name,
	DistributerName=SPACE(100),
	BranchName = (SELECT AR.Name FROM Area AR WHERE AR.AreaCode=C.AreaCode),
	InvoiceNo=SL.SaleInvCode,
	CustomerCode=AC.AliasName,
	CustomerName=AC.Name,
	Address = C.Address1,
	CustomerCategoryCode=CC.Name,
	DateofInvoice = SL.Date,
	BatchNo=SD.Batch,
	Quantity=SD.LooseQty,
	InvoiceReceivingStatus='Yes',
	POPContactNumber=C.Phone,
	FileRefNo = ''	
FROM 
	SaleLedger SL, SaleDetail SD, Item I, Customer C, Accounts AC, CustomerCategory CC, SubArea SA
WHERE 
	SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SD.ICode = I.ICOde AND
	I.ICode IN (:ai_icode) AND
	SL.CustCode = C.CustCode AND
	C.CustCode = AC.AccCode AND
	C.SubAreaCode = SA.SubAreaCode AND
	C.CustCatCode = CC.CustCatCode
UNION ALL
SELECT 
	Product = I.Name,
	DistributerName=SPACE(100),
	BranchName = (SELECT AR.Name FROM Area AR WHERE AR.AreaCode=C.AreaCode),
	InvoiceNo=SL.SRInvCode,
	CustomerCode=AC.AliasName,
	CustomerName=AC.Name,
	Address = C.Address1,
	CustomerCategoryCode=CC.Name,
	DateofInvoice = SL.Date,
	BatchNo=SD.Batch,
	Quantity= - SD.LooseQty,
	InvoiceReceivingStatus='Yes',
	POPContactNumber=C.Phone,
	FileRefNo = ''	
FROM 
	SRLedger SL, SRDetail SD, Item I, Customer C, Accounts AC, CustomerCategory CC, SubArea SA
WHERE 
	SL.PostDate BETWEEN :adt_startdate AND :adt_enddate AND
	SL.SRInvCode = SD.SRInvCode AND
	SD.ICode = I.ICOde AND
	I.ICode IN (:ai_icode) AND
	SL.CustCode = C.CustCode AND
	C.CustCode = AC.AccCode AND
	C.SubAreaCode = SA.SubAreaCode AND
	C.CustCatCode = CC.CustCatCode
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_icode", numberlist))
 sort="product A, dateofinvoice A"
)
