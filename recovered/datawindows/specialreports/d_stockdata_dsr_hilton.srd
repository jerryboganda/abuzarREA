release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=88 color="536870912" )
table(column=(type=long updatewhereclause=yes name=prodcodelen dbname="ProdCodeLEN"  )
column=(type=char(9) updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=long updatewhereclause=yes name=datelen dbname="DateLen"  )
column=(type=char(10) updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=unitslen dbname="UnitsLEN"  )
column=(type=char(12) updatewhereclause=yes name=units dbname="Units"  )
column=(type=long updatewhereclause=yes name=dscodelen dbname="DSCodeLEN"  )
column=(type=char(6) updatewhereclause=yes name=dscode dbname="DSCode"  )
 retrieve="SELECT
	ProdCodeLEN=9,
	ProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	DateLen=10,
	Date=CONVERT(VARCHAR(10), GETDATE(), 103),
	UnitsLEN=12,
	Units=STR(SUM(ISNULL(GD.CurrQty, 0)), 12, 2),
	DSCodeLEN=6,
	DSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode))
FROM
	Item I LEFT OUTER JOIN GodownDetail AS GD ON (I.ICode = GD.ICode)
WHERE
	I.ManfCode = :manfcode
GROUP BY
	I.ICode, I.Name, I.CustomICode"
  arguments=(("manfcode", number), ("as_distcode", string))
)
