table(column=(type=long updatewhereclause=yes name=depotidlen dbname="DEPOTIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=depotid dbname="DEPOTID"  )
column=(type=long updatewhereclause=yes name=brickidlen dbname="BRICKIDLEN"  )
column=(type=char(8) updatewhereclause=yes name=brickid dbname="BRICKID"  )
column=(type=long updatewhereclause=yes name=chemistidlen dbname="CHEMISTIDLEN"  )
column=(type=char(8) updatewhereclause=yes name=chemistid dbname="CHEMISTID"  )
