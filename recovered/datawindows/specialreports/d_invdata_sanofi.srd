column=(type=char(10) updatewhereclause=yes name=invoiceno dbname="InvoiceNO"  )
column=(type=long updatewhereclause=yes name=datelen dbname="DateLEN"  )
column=(type=char(8000) updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=productionidlen dbname="PRODUCTIONIDLEN"  )
column=(type=char(9) updatewhereclause=yes name=productionid dbname="PRODUCTIONID"  )
