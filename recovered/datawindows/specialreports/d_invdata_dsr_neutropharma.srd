table(column=(type=char(40) updatewhereclause=yes name=invoice dbname="Invoice"  )
column=(type=char(10) updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(12) updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(75) updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=char(12) updatewhereclause=yes name=units dbname="Units"  )
column=(type=char(12) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=char(12) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=char(12) updatewhereclause=yes name=netvalue dbname="NetValue"  )
column=(type=char(1) updatewhereclause=yes name=flag dbname="Flag"  )
column=(type=char(8000) updatewhereclause=yes name=dscode dbname="DSCode"  )
 retrieve="SELECT 
	Invoice = LTRIM(RTRIM(STR(SL.SaleInvCode, 40))),
	Date=Convert(varchar(10), SL.DATE, 103),
	CustCode  = LTRIM(RTRIM(A.AliasName)),
	ProdCode=LTRIM(RTRIM(I.CustomICode)),
	Batch=SD.Batch, 
	Units=LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	Bonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	Discount=LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) + 	(SD.LooseQty * SD.ItemFlatDisc), 12, 2))),
	NetValue=LTRIM(RTRIM(STR(
			Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2))),
	Flag='S',
	DSCode=LTRIM(RTRIM(:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode))))
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
UNION ALL
SELECT 
	Invoice = LTRIM(RTRIM(STR(SL.SRInvCode, 40))),
	Date=Convert(varchar(10), SL.DATE, 103),
	CustCode  = LTRIM(RTRIM(A.AliasName)),
	ProdCode=LTRIM(RTRIM(I.CustomICode)), 
	Batch=SD.Batch, 
	Units=LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	Bonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	Discount=
		LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	NetValue=LTRIM(RTRIM(STR(
			Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2))),
	Flag='R',
	DSCode=LTRIM(RTRIM(:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode))))
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
	
"
  arguments=(("manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
