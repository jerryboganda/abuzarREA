table(column=(type=char(101) updatewhereclause=yes name=distributorcode dbname="DistributorCode"  )
column=(type=char(100) updatewhereclause=yes name=distributorname dbname="DistributorName"  )
column=(type=char(12) updatewhereclause=yes name=customercode dbname="CustomerCode"  )
column=(type=char(60) updatewhereclause=yes name=customertitle dbname="CustomerTitle"  )
column=(type=char(60) updatewhereclause=yes name=customeraddress dbname="CustomerAddress"  )
column=(type=char(100) updatewhereclause=yes name=customerphone dbname="CustomerPhone"  )
column=(type=char(100) updatewhereclause=yes name=customerfax dbname="CustomerFax"  )
column=(type=char(60) updatewhereclause=yes name=customeremailaddress dbname="CustomerEmailAddress"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
column=(type=long updatewhereclause=yes name=customertowncode dbname="CustomerTownCode"  )
 retrieve="SELECT 
	DistributorCode=RTRIM(LTRIM(:as_distcode+SPACE(100))),
	DistributorName = SPACE(100),
	CustomerCode=AC.AliasName,
	CustomerTitle=AC.Name,
	CustomerAddress=C.Address1,
	CustomerPhone=C.Phone,
	CustomerFax=C.Fax,
	CustomerEmailAddress=C.Email,
	CustomerCategory=CC.Name,
	CustomerTownCode=A.AreaCode
FROM 
	Area A, Customer C, Accounts AC, CustomerCategory CC
WHERE 
	A.AreaCode = C.AreaCode AND
	C.CustCode = AC.AccCode AND
	C.CustCatCode = CC.CustCatCode
ORDER BY
	CustomerTitle,
	CustomerCode"
  arguments=(("as_distcode", string))
)
