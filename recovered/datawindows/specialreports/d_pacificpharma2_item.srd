table(column=(type=char(75) updatewhereclause=yes name=productcode dbname="ProductCode"  )
column=(type=char(60) updatewhereclause=yes name=productname dbname="ProductName"  )
column=(type=char(50) updatewhereclause=yes name=productdescription dbname="ProductDescription"  )
column=(type=decimal(2) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
column=(type=char(11) updatewhereclause=yes name=distcode dbname="DistCode"  )
 retrieve="SELECT 
	ProductCode=I.CustomICode, 
	ProductName=I.Name, 
	ProductDescription=I.PackingDesc, 
	UnitPrice=I.SalePrice, 
	DistCode=LTRIM(RTRIM(:as_distcode + SPACE(10))) 
FROM Item I, ItemCategory IC
WHERE I.ManfCode = :ai_manfcode AND I.ICatCode=IC.ICatCode
ORDER BY ProductCode, ProductName"
  arguments=(("as_distcode", string), ("ai_manfcode", number))
)
