footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=codelen dbname="CodeLen"  )
column=(type=char(10) updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=namelen dbname="NameLen"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes name=address1len dbname="Address1Len"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=long updatewhereclause=yes name=address2len dbname="Address2Len"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=long updatewhereclause=yes name=phonelen dbname="PhoneLen"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=long updatewhereclause=yes name=licenselen dbname="LicenseLen"  )
column=(type=char(30) updatewhereclause=yes name=license dbname="License"  )
column=(type=long updatewhereclause=yes name=areacodelen dbname="AreaCodeLen"  )
column=(type=char(5) updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=long updatewhereclause=yes name=areanamelen dbname="AreaNameLen"  )
column=(type=char(60) updatewhereclause=yes name=areaname dbname="AreaName"  )
column=(type=long updatewhereclause=yes name=citynamelen dbname="CityNameLen"  )
column=(type=char(60) updatewhereclause=yes name=cityname dbname="CityName"  )
column=(type=long updatewhereclause=yes name=custtypelen dbname="CustTypeLen"  )
column=(type=char(30) updatewhereclause=yes name=custtype dbname="CustType"  )
column=(type=long updatewhereclause=yes name=dscodelen dbname="DsCodeLen"  )
column=(type=char(100) updatewhereclause=yes name=dscode dbname="DsCode"  )
 retrieve="SELECT 
	CodeLen=10,
	Code=STR(C.CustCode, 10),
	NameLen=100,
	Name=A.Name,
	Address1Len=100,
	Address1=C.Address1,
	Address2Len=100,
	Address2=C.Address2,
	PhoneLen=100,
	Phone=C.Phone,
	LicenseLen=100,
	License=C.LicenceNo,
	AreaCodeLen=5,
	AreaCode=STR(AR.AreaCode, 5),
	AreaNameLen=100,
	AreaName=AR.Name,
	CityNameLen=100,
	CityName=C.City,
	CustTypeLen=100,
	CustType=CC.Name,
	DsCodeLen=100,
	DsCode=CONVERT(VARCHAR(100), :as_dscode)
FROM
	Accounts A, Customer C, Area AR, CustomerCategory CC
WHERE
	A.AccCode = C.CustCode AND C.AreaCode = AR.AreaCode AND
	C.CustCatCode = CC.CustCatCode
ORDER BY
	CustCode
"
  arguments=(("as_dscode", string))
)
