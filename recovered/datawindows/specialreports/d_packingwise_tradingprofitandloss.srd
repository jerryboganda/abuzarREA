compute(name=c_companyname moveable=1 band=foreground font.charset="0" font.face="Times New Roman" font.family="1" font.height="-12" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="208" y="500" height="197" width="9906" format="[GENERAL]" expression="f_ReportHeaderInfo('clientname')" alignment="2" border="0" crosstab.repeat=no )
