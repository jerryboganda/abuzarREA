release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1364 color="536870912" )
header[2](height=364 color="536870912" )
summary(height=416 color="536870912" )
footer(height=10 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=maintype dbname="maintype"  )
column=(type=number updatewhereclause=yes name=type dbname="type"  )
column=(type=char(20) updatewhereclause=yes name=particulars dbname="particulars"  )
column=(type=number updatewhereclause=yes name=amt dbname="amt"  )
 retrieve="SELECT
	Particulars=ISNULL(T.Particulars, 'Sales'),
	MainType= ISNULL(MAINTYPE, 'Gross Profit'),
	Type=ISNULL(T.Type, 1),
	Packing=IP.Name,
	AMT=ROUND(ISNULL(SUM(T.AMT), 0), 2)
FROM
	ItemPacking IP
	LEFT OUTER JOIN 
	(SELECT  
		Particulars='Sales',
		MainType= 'Gross Profit',
		Type = 1 /*1 stands for sales*/,
		I.PackCode,
		Amt= SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * (1 - D.discperc * .01) * (1 - S.discperc * .01))
	FROM    
		saleledger S, saledetail D, Item I
	WHERE
		S.saleinvcode = D.saleinvcode AND
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		D.ICode = I.ICode
	GROUP BY 
		I.PackCode
	UNION ALL
	SELECT  
		Particulars='Sales',
		MainType= 'Gross Profit',
		Type = 1 /*1 stands for sales returns*/,
		I.PackCode,
		Amt= - (SUM(D.looseqty * D.srprice * (1 - D.discperc * .01) * (1 - S.discperc * .01)))
	FROM    
		srledger S, srdetail D, Item I
	WHERE
		S.srinvcode = D.srinvcode AND
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		D.ICode = I.ICode
	GROUP BY 
		I.PackCode
	UNION ALL
	SELECT 
		Particulars='Opening Stock',
		MainType= 'Gross Profit',
		TYPE=2/* 2 Stands for Opening Stock*/,
		T.PackCode,
		Amt= - (ISNULL(SUM(T.Stock), 0))
	FROM
		(SELECT 
			S.ICode,
			I.PackCode,
			Stock=ISNULL(SUM(ISNULL(S.NewAvgPrice * S.NewStock, 0)), 0)
		FROM StockLedger S, Item I
		WHERE 
			S.ICode = I.ICode AND
			date < :ad_startdate AND
			CONVERT(VARCHAR(10), S.ICode) + ' ' + CONVERT(VARCHAR(20), utn) IN
					(SELECT 
							CONVERT(VARCHAR(10), icode) + ' ' + CONVERT(VARCHAR(20), MAX(utn))
					FROM StockLedger
					WHERE date < :ad_startdate
					GROUP BY icode)
		GROUP BY 
			S.ICode, 
			I.PackCode) T
	GROUP BY 
		T.PackCode
	UNION ALL
	SELECT  
		Particulars='Purchases',
		MainType= 'Gross Profit',
		Type = 3 /*3 stands for Purchase*/,
		I.PackCode,
		Amt = - (SUM( (D.looseqty + D.PackQty * D.PackUnits) * D.Purprice * (1 - D.discperc * .01) * (1 - P.discperc * .01)))
	FROM    
		purledger P, Purdetail D, Item I
	WHERE
		P.Purinvcode = D.PurInvCode AND
		P.Date >= :ad_startdate AND P.Date <= :ad_enddate AND
		D.ICode = I.ICode
	GROUP BY 
		I.PackCode
	UNION ALL
	SELECT  
		Particulars='Purchases',
		MainType= 'Gross Profit',
		Type = 3/*3 stands for Purchase return*/,
		I.PackCode,
		Amt = SUM( (D.looseqty + D.PackQty * D.PackUnits) * D.PrPrice * (1 - D.discperc * .01) * (1 - P.discperc * .01))
	FROM    
		prledger P, Prdetail D, Item I
	WHERE
		P.Prinvcode = D.PrInvCode AND
		P.Date >= :ad_startdate AND P.Date <= :ad_enddate AND
		D.ICode = I.ICode
	GROUP BY 
		I.PackCode
	UNION ALL
	SELECT 
		Particulars='Closing Stock',
		MainType= 'Gross Profit',
		TYPE=5/* 5 Stands for Closing Stock*/,
		T.PackCode,
		Amt=ISNULL(SUM(T.Stock), 0)
	FROM
		(SELECT 
			S.ICode,
			I.PackCode,
			Stock=ISNULL(SUM(ISNULL(S.NewAvgPrice * S.NewStock, 0)), 0)
		FROM StockLedger S, Item I
		WHERE 
			S.ICode = I.ICode AND
			date <= :ad_enddate AND
			CONVERT(VARCHAR(10), S.ICode) + ' ' + CONVERT(VARCHAR(20), utn) IN
					(SELECT 
							CONVERT(VARCHAR(10), icode) + ' ' + CONVERT(VARCHAR(20), MAX(utn))
					FROM StockLedger
					WHERE date <= :ad_enddate
					GROUP BY icode)
		GROUP BY 
			S.ICode, 
			I.PackCode) T
	GROUP BY 
		T.PackCode
	UNION ALL
	SELECT  
		Particulars=A.Name,
		MainType= 'Gross Profit',
		Type = 4 /*4 stands for direct expenses*/,
		PackCode=(SELECT MIN(PACKCode) FROM ItemPacking),
		Amt= ISNULL(SUM(D.CREDIT - D.DEBIT), 0)
	FROM    
		GLHeader H, 
		GLDetail D, 
		(SELECT ACCCODE, Name, AliasName
		FROM ACCOUNTS WHERE SUBCODE IN
			(SELECT SUBACCCODE FROM SUBACCOUNTS WHERE CATACCCODE IN 
					(SELECT CODE FROM GLOBAL WHERE TableName='CategoryAccounts' AND 
					NAME = 'GT_DirectExpensesCat')) AND
			ACCCODE NOT IN 
					(SELECT CODE FROM GLOBAL WHERE TableName='Accounts' AND NAME IN
								('GT_PurchaseAccount', 'GT_PurchaseReturnsAccount'))) A
	WHERE
		H.GLVochCode = D.GLVochCode AND
		H.Date >= :ad_startdate AND H.Date <= :ad_enddate AND
		D.AccCode = A.AccCode
	GROUP BY 
		D.AccCode,
		A.Name
	UNION ALL
	SELECT  
		Particulars=A.Name,
		MainType= 'Operating Profit',
		Type = 10/*10 stands for Operating expenses*/,
		PackCode=(SELECT MIN(PACKCode) FROM ItemPacking),
		Amt= ISNULL(SUM(D.CREDIT - D.DEBIT), 0)
	FROM    
		GLHeader H, 
		GLDetail D, 
		(SELECT ACCCODE, Name, AliasName
		FROM ACCOUNTS WHERE SUBCODE IN
			(SELECT SUBACCCODE FROM SUBACCOUNTS WHERE CATACCCODE IN 
					(SELECT CODE FROM GLOBAL WHERE TableName='CategoryAccounts' AND 
					NAME = 'GT_OperatingExpensesCat'))) A
	WHERE
		H.GLVochCode = D.GLVochCode AND
		H.Date >= :ad_startdate AND H.Date <= :ad_enddate AND
		D.AccCode = A.AccCode
	GROUP BY 
		D.AccCode, 
		A.Name
	UNION ALL
	SELECT  
		Particulars='Sales Tax On Purchases',
		MainType= 'Sales Tax',
		Type = 11 /*11 stands for SalesTax*/,
		I.PackCode,
		Amt = SUM((D.looseqty + D.packqty + D.bonusqty) * D.unitsalestax) +
					SUM(ROUND((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc)) * D.gstperc * .01, 2))
	FROM    
		purledger P, Purdetail D, Item I
	WHERE
		P.Purinvcode = D.PurInvCode AND
		P.Date >= :ad_startdate AND P.Date <= :ad_enddate AND
		D.ICode = I.ICode
	GROUP BY 
		I.PackCode
	UNION ALL
	SELECT  
		Particulars='Sales Tax On Purchases',
		MainType= 'Sales Tax',
		Type = 11 /*11 stands for SalesTax*/,
		I.PackCode,
		Amt = - (SUM((D.looseqty + D.packqty + D.bonusqty) * D.unitsalestax) +
					SUM(ROUND((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc)) * D.gstperc * .01, 2)))
	FROM    
		prledger P, Prdetail D, Item I
	WHERE
		P.Prinvcode = D.PrInvCode AND
		P.Date >= :ad_startdate AND P.Date <= :ad_enddate AND
		D.ICode = I.ICode
	GROUP BY 
		I.PackCode
	UNION ALL
	SELECT  
		Particulars='Sales Tax On Sales',
		MainType= 'Sales Tax',
		Type = 12 /*12 stands for SalesTax on Sales*/,
		I.PackCode,
		Amt = SUM((D.looseqty + D.packqty + D.bonusqty) * D.unitsalestax) +
					SUM(ROUND((D.looseqty + D.packqty) * (D.Saleprice - D.ItemFlatDisc) * (1 - (.01 * D.discperc)) * D.gstperc * .01, 2))
	FROM    
		saleledger P, saledetail D, Item I
	WHERE
		P.SaleInvCode = D.SaleInvCode AND
		P.Date >= :ad_startdate AND P.Date <= :ad_enddate AND
		D.ICode = I.ICode
	GROUP BY 
		I.PackCode
	UNION ALL
	SELECT  
		Particulars='Sales Tax On Sales',
		MainType= 'Sales Tax',
		Type = 12 /*12 stands for SalesTax on Sales*/,
		I.PackCode,
		Amt = - (SUM((D.looseqty + D.packqty + D.bonusqty) * D.unitsalestax) +
					SUM(ROUND((D.looseqty + D.packqty) * D.srprice * (1 - (.01 * D.discperc)) * D.gstperc * .01, 2)))
	FROM    
		srledger P, srdetail D, Item I
	WHERE
		P.Srinvcode = D.SrInvCode AND
		P.Date >= :ad_startdate AND P.Date <= :ad_enddate AND
		D.ICode = I.ICode
	GROUP BY 
		I.PackCode) AS T ON (IP.PackCode = T.PackCode)
GROUP BY 
	IP.Name,
	MainType,
	T.Type,
	T.Particulars
ORDER BY 
	MainType, 
	TYPE, 
	Particulars"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="maintype A, type A, particulars A"
)
group(level=1 header.height=0 trailer.height=583 by=("maintype"  ) header.color="536870912" trailer.color="536870912" )
group(level=2 header.height=0 trailer.height=0 by=("type"  ) header.color="536870912" trailer.color="536870912" )
