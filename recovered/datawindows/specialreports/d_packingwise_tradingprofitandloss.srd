compute(name=compute_14 visible="1	if( maintype = 'Gross Profit', 1,0)" band=trailer.1 font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" x="83" y="406" height="166" width="2520" format="[GENERAL]" expression="trim( maintype ) + ' Ratio'" alignment="0" border="0" crosstab.repeat=no )
compute(name=compute_15 visible="1	if( maintype = 'Gross Profit', 1,0)" band=trailer.1 font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="2625" y="406" height="166" width="781" format="#,###,##0.00;(#,###,##0.00)" expression="(cumulativesum(amt for group 1) / if(sum(if( TYPE=1, AMT, 0 ) for group 1)=0,1, sum(if( TYPE=1, AMT, 0 ) for group 1))) * 100" alignment="1" border="0" crosstab.repeat=no )
compute(name=compute_16 visible="1	if( maintype = 'Gross Profit', 1,0)" band=trailer.1 font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="3427" y="406" height="166" width="833" format="#,###,##0.00;(#,###,##0.00)" expression="(cumulativesum(grand_sum_amt for group 1) / if(sum(if( TYPE=1, grand_sum_amt, 0 ) for group 1)=0,1, sum(if( TYPE=1, grand_sum_amt, 0 ) for group 1))) * 100" alignment="1" border="0" crosstab.repeat=no )
compute(name=compute_18 visible="1	if( Left(maintype, 9) = 'Operating', 1, 0)" band=trailer.1 font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" x="2625" y="10" height="166" width="781" format="#,###,##0.00;(#,###,##0.00)" expression="Sum( amt for group 1)" alignment="1" border="0" crosstab.repeat=no )
