crosstab(columns="packing" rows="maintype, type, particulars" values="sum(amt for crosstab)" sourcenames = "particulars, maintype, type, packing, amt" crosstabonly=yes  band=foreground )
compute(name=compute_4 visible="1	0" band=trailer.1 font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" x="20" y="10" height="166" width="10" format="[general]" expression="maintype + ~" Total~"" alignment="1" border="0" crosstab.repeat=no )
