table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(6) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=prdidlen dbname="PRDIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=prdid dbname="PRDID"  )
column=(type=long updatewhereclause=yes name=prdlen dbname="PRDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=prd dbname="PRD"  )
column=(type=long updatewhereclause=yes name=batchnolen dbname="BatchNoLEN"  )
column=(type=char(8000) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=long updatewhereclause=yes name=cldatelen dbname="CLDATELEN"  )
column=(type=char(10) updatewhereclause=yes name=cldate dbname="CLDATE"  )
column=(type=long updatewhereclause=yes name=clqtylen dbname="CLQTYLEN"  )
column=(type=char(12) updatewhereclause=yes name=clqty dbname="CLQTY"  )
column=(type=long updatewhereclause=yes name=trnqtylen dbname="TRNQTYLEN"  )
column=(type=char(12) updatewhereclause=yes name=trnqty dbname="TRNQTY"  )
column=(type=long updatewhereclause=yes name=expirylen dbname="ExpiryLEN"  )
column=(type=char(7) updatewhereclause=yes name=expiry dbname="Expiry"  )
 retrieve="SELECT
	DSTBIDLEN=6,
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9) + REPLICATE(' ', 9 - LEN(LTRIM(RTRIM(SUBSTRING(I.CustomICode, 1, 9))))),
	PRDLEN=50,
	PRD = LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))))),
	BatchNoLEN=10,
	BatchNo= ISNULL(GD.Batch, '.') + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(ISNULL(GD.Batch, '.'), 1, 10))))),
	CLDATELEN=10,
	CLDATE=Convert(varchar(10), :ar_enddate, 103),
	CLQTYLEN=12,
	CLQTY=STR(SUM(ISNULL(GD.CurrQty, 0)), 12),
	TRNQTYLEN=12,
	TRNQTY=STR(0, 12),
	ExpiryLEN=7,
	Expiry= RIGHT(Convert(varchar(10), GD.Expiry, 103), 7)
FROM
	Item I LEFT OUTER JOIN GodownDetail AS GD ON (I.ICode = GD.ICode)
WHERE
	I.ManfCode = :manfcode
GROUP BY
	I.ICode,
	I.Name,
	I.CustomICode,
	GD.Batch,
	GD.Expiry
ORDER BY
	PRDID"
  arguments=(("manfcode", number), ("as_distcode", string), ("ar_enddate", datetime))
)
