summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=customeridlen dbname="CustomerIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=customerid dbname="CustomerID"  )
column=(type=long updatewhereclause=yes name=customernamelen dbname="CustomerNameLEN"  )
column=(type=char(8000) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=long updatewhereclause=yes name=ctlen dbname="CTLEN"  )
column=(type=char(2) updatewhereclause=yes name=ct dbname="CT"  )
column=(type=long updatewhereclause=yes name=townidlen dbname="TOWNIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=townid dbname="TOWNID"  )
column=(type=long updatewhereclause=yes name=phonenbrlen dbname="PhoneNBRLen"  )
column=(type=char(8000) updatewhereclause=yes name=phonenbr dbname="PhoneNBR"  )
column=(type=long updatewhereclause=yes name=mobilenbrlen dbname="MobileNBRLen"  )
column=(type=char(8000) updatewhereclause=yes name=mobilenbr dbname="MobileNBR"  )
column=(type=long updatewhereclause=yes name=addresslen dbname="ADDRESSLEN"  )
column=(type=char(8000) updatewhereclause=yes name=address dbname="ADDRESS"  )
 retrieve="SELECT
	CustomerIDLEN=10,
	CustomerID = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(A.AliasName)))),
	CustomerNameLEN=50,
	CustomerName = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))))),
	CTLEN=2,
	CT=CASE 
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN 'W '
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN 'R '
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN 'I '
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN 'D '
		ELSE 'O ' END,
	TOWNIDLEN=10,
	TOWNID=SUBSTRING(LTRIM(RTRIM(AR.AreaCode)), 1, 10) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(CAST(AR.AreaCode AS VARCHAR(10)), 1, 10))))),
	PhoneNBRLen=20,
	PhoneNBR = LTRIM(RTRIM(SUBSTRING(C.Phone, 1, 20))) + REPLICATE(' ', 20 - LEN(LTRIM(RTRIM(SUBSTRING(C.Phone, 1, 20))))),
	MobileNBRLen=20,
	MobileNBR = LTRIM(RTRIM(SUBSTRING(C.Fax, 1, 20))) + REPLICATE(' ', 20 - LEN(LTRIM(RTRIM(SUBSTRING(C.Fax, 1, 20))))),
	ADDRESSLEN=50,
	ADDRESS = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 50)))))
FROM Customer C, Accounts A, Area AR
WHERE C.CustCode = A.AccCode AND C.AreaCode = AR.AreaCode
"
 )
