table(column=(type=char(10) updatewhereclause=yes name=invoice dbname="Invoice"  )
column=(type=char(10) updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(8000) updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(9) updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=char(10) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=char(12) updatewhereclause=yes name=tradeprice dbname="TradePrice"  )
column=(type=char(12) updatewhereclause=yes name=units dbname="Units"  )
column=(type=char(12) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=char(12) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=char(12) updatewhereclause=yes name=netvalue dbname="NetValue"  )
column=(type=char(1) updatewhereclause=yes name=flag dbname="Flag"  )
column=(type=char(8000) updatewhereclause=yes name=dscode dbname="DSCode"  )
 retrieve="SELECT 
	Invoice = LTRIM(RTRIM(STR(SL.SaleInvCode, 10))),
	Date=Convert(varchar(10), SL.DATE, 103),
	CustCode  = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),
	ProdCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9))),
	Batch=LTRIM(RTRIM(SUBSTRING(SD.Batch, 1, 10))),
	TradePrice=LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))),
	Units=LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	Bonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	Discount=LTRIM(RTRIM(STR(
			Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + 
			(SD.LooseQty * SD.ItemFlatDisc), 12, 2))),
	NetValue=LTRIM(RTRIM(STR(SD.LooseQty * SD.SalePrice, 12, 2))),
	Flag='S',
	DSCode=LTRIM(RTRIM(:as_distcode))  + REPLICATE(' ', 6 - LEN(:as_distcode))
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	A.Active = 'Y' AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
UNION ALL
SELECT 
	Invoice = LTRIM(RTRIM(STR(SL.SRInvCode, 10))),
	Date=Convert(varchar(10), SL.DATE, 103),
	CustCode  = LTRIM(RTRIM(A.AliasName)),
	ProdCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9))),
	Batch=LTRIM(RTRIM(SUBSTRING(SD.Batch, 1, 10))),
	TradePrice=LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))),
	Units=LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	Bonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	Discount=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	NetValue=LTRIM(RTRIM(STR(
			Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2))),
	Flag='R',
	DSCode=LTRIM(RTRIM(:as_distcode))  + REPLICATE(' ', 6 - LEN(:as_distcode))
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	A.Active = 'Y' AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
UNION ALL
SELECT 
	Invoice = LTRIM(RTRIM(STR(PL.PurInvCode, 10))),
	Date=Convert(varchar(10), PL.DATE, 103),
	CustCode  = LTRIM(RTRIM(A.AliasName)),
	ProdCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9))),
	Batch=LTRIM(RTRIM(SUBSTRING(PD.Batch, 1, 10))),
	TradePrice=LTRIM(RTRIM(STR(PD.PurPrice, 12, 2))),
	Units=LTRIM(RTRIM(STR(PD.PackQty + PD.LooseQty, 12))),
	Bonus=LTRIM(RTRIM(STR(PD.BonusQty, 12))),
	Discount=LTRIM(RTRIM(STR(
			Round(((PD.PackQty + PD.LooseQty) * PD.PurPrice * (PD.DiscPerc * 0.01)), 2), 12, 2))),
	NetValue=LTRIM(RTRIM(STR(
			Round(((PD.PackQty + PD.LooseQty) * PD.PurPrice * (1 - PD.DiscPerc * 0.01)), 2), 12, 2))),
	Flag='P',
	DSCode=LTRIM(RTRIM(:as_distcode))  + REPLICATE(' ', 6 - LEN(:as_distcode))
FROM
	PurLedger PL,
	PurDetail PD,
	Supplier S,
	Accounts A,
	Item I
WHERE
	PL.PurInvCode = PD.PurInvCode AND
	PL.POSTED = 'Y' AND
	PD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	PL.SuppCode = S.SuppCode AND
	S.SuppCode = A.AccCode AND 
	A.Active = 'Y' AND
	PL.DATE >= :ar_startdate AND PL.DATE <= :ar_enddate
UNION ALL
SELECT 
	Invoice = LTRIM(RTRIM(STR(PL.PrInvCode, 10))),
	Date=Convert(varchar(10), PL.DATE, 103),
	CustCode  = LTRIM(RTRIM(A.AliasName)),
	ProdCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9))),
	Batch=LTRIM(RTRIM(SUBSTRING(PD.Batch, 1, 10))),
	Units=LTRIM(RTRIM(STR(PD.PackQty + PD.LooseQty, 12))),
	TradePrice=LTRIM(RTRIM(STR(PD.PrPrice, 12, 2))),
	Bonus=LTRIM(RTRIM(STR(PD.BonusQty, 12))),
	Discount=LTRIM(RTRIM(STR(
			Round(((PD.PackQty + PD.LooseQty) * PD.PrPrice * (PD.DiscPerc * 0.01)), 2), 12, 2))),
	NetValue=LTRIM(RTRIM(STR(
			Round(((PD.PackQty + PD.LooseQty) * PD.PrPrice * (1 - PD.DiscPerc * 0.01)), 2), 12, 2))),
	Flag= CASE LEFT(LTRIM(RTRIM(PT.Name)), 1) WHEN 'E' THEN 'E' WHEN 'D' THEN 'D' ELSE 'G' END,
	DSCode=LTRIM(RTRIM(:as_distcode))  + REPLICATE(' ', 6 - LEN(:as_distcode))
FROM
	PrLedger PL
	LEFT OUTER JOIN 
	PurchaseType AS PT ON(PL.PrTypeCode = PT.PurTypeCode) ,
	PrDetail PD,
	Supplier S,
	Accounts A,
	Item I
WHERE
	PL.PrInvCode = PD.PrInvCode AND
	PL.POSTED = 'Y' AND
	PD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	PL.SuppCode = S.SuppCode AND
	S.SuppCode = A.AccCode AND 
	A.Active = 'Y' AND
	PL.DATE >= :ar_startdate AND PL.DATE <= :ar_enddate
"
  arguments=(("manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
