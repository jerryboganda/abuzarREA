header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=team dbname="Team"  )
column=(type=char(50) updatewhereclause=yes name=size dbname="Size"  )
column=(type=decimal(2) updatewhereclause=yes name=tradeprice dbname="TradePrice"  )
 retrieve="SELECT ItemCode=I.Remarks, ItemName=I.Name, Team=IC.Name, Size=I.PackingDesc, TradePrice=I.SalePrice
FROM Item I, ItemCategory IC
WHERE I.ManfCode = :ai_manfcode AND I.ICatCode=IC.ICatCode
ORDER BY Team, ItemName, ItemCode"
  arguments=(("ai_manfcode", number))
)
