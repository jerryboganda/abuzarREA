table(column=(type=char(15) updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=char(2) updatewhereclause=yes name=documenttype dbname="DocumentType"  )
column=(type=char(10) updatewhereclause=yes name=documentdate dbname="DocumentDate"  )
column=(type=char(9) updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=char(12) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=char(10) updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=char(12) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=char(12) updatewhereclause=yes name=units dbname="Units"  )
column=(type=char(12) updatewhereclause=yes name=grossamount dbname="GrossAmount"  )
column=(type=char(5) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=char(12) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=char(1) updatewhereclause=yes name=saletaxtype dbname="SaleTaxType"  )
column=(type=char(12) updatewhereclause=yes name=saletax dbname="SaleTax"  )
column=(type=char(12) updatewhereclause=yes name=saletaxamount dbname="SaleTaxAmount"  )
column=(type=char(12) updatewhereclause=yes name=netamount dbname="NetAmount"  )
 retrieve="SELECT 
	DocumentCode = LTRIM(RTRIM(STR(SL.SaleInvCode, 15))),
	DocumentType= 'SI',
	DocumentDate=Convert(varchar(10), SL.DATE, 103),
	ItemCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9))),
	Batch=SD.Batch, 
	SalePrice = LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))),
	Expiry=Convert(varchar(10), SD.Expiry, 103),
	Bonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	Units=LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	GrossAmount=LTRIM(RTRIM(STR(Round(SD.LooseQty * SD.SalePrice, 2), 12, 2))),
	DiscPerc=LTRIM(RTRIM(STR(SD.DiscPerc, 5, 2))),
	Discount=LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) + (SD.LooseQty * SD.ItemFlatDisc), 12, 2))),
	SaleTaxType = CASE WHEN SD.GSTPerc > 0 THEN 'P' WHEN SD.UnitSalesTax > 0 THEN 'V' ELSE 'N' END,
	SaleTax = LTRIM(RTRIM(STR(CASE WHEN SD.GSTPerc > 0 THEN SD.GSTPerc WHEN SD.UnitSalesTax > 0 THEN SD.UnitSalesTax ELSE 0.00 END, 12, 2))),
	SaleTaxAmount=LTRIM(RTRIM(STR(Round(((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) * SD.GSTPerc * 0.01), 2) + ROUND(((SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax), 2), 12, 2))),
	NetAmount=LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2)))
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	DocumentCode = LTRIM(RTRIM(STR(SL.SRInvCode, 15))),
	DocumentType= 'SR',
	DocumentDate=Convert(varchar(10), SL.DATE, 103),
	ItemCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9))),
	Batch=SD.Batch,
	SalePrice = LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))),
	Expiry=Convert(varchar(10), SD.Expiry, 103),
	Bonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	Units=LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	GrossAmount=LTRIM(RTRIM(STR(Round(SD.LooseQty * SD.SRPrice, 2), 12, 2))),
	DiscPerc=LTRIM(RTRIM(STR(SD.DiscPerc, 5, 2))),
	Discount=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	SaleTaxType = CASE WHEN SD.GSTPerc > 0 THEN 'P' WHEN SD.UnitSalesTax > 0 THEN 'V' ELSE 'N' END,
	SaleTax = LTRIM(RTRIM(STR(CASE WHEN SD.GSTPerc > 0 THEN SD.GSTPerc WHEN SD.UnitSalesTax > 0 THEN SD.UnitSalesTax ELSE 0.00 END, 12, 2))),
	SaleTaxAmount=LTRIM(RTRIM(STR(Round(((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)) * SD.GSTPerc * 0.01), 2) + ROUND(((SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax), 2), 12, 2))),
	NetAmount=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2)))
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT
	DocumentCode = LTRIM(RTRIM(STR(SL.PurInvCode, 15))),
	DocumentType= 'PI',
	DocumentDate=Convert(varchar(10), SL.DATE, 103),
	ItemCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9))),
	Batch=SD.Batch, 
	SalePrice = LTRIM(RTRIM(STR(SD.PurPrice, 12, 2))),
	Expiry=Convert(varchar(10), SD.Expiry, 103),
	Bonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	Units=LTRIM(RTRIM(STR(SD.PackQty + SD.LooseQty, 12))),
	GrossAmount=LTRIM(RTRIM(STR(Round((SD.PackQty + SD.LooseQty) * SD.PurPrice, 2), 12, 2))),
	DiscPerc=LTRIM(RTRIM(STR(SD.DiscPerc, 5, 2))),
	Discount=LTRIM(RTRIM(STR(Round(((SD.PackQty + SD.LooseQty) * SD.PurPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	SaleTaxType = CASE WHEN SD.GSTPerc > 0 THEN 'P' WHEN SD.UnitSalesTax > 0 THEN 'V' ELSE 'N' END,
	SaleTax = LTRIM(RTRIM(LTRIM(RTRIM(STR(CASE WHEN SD.GSTPerc > 0 THEN SD.GSTPerc WHEN SD.UnitSalesTax > 0 THEN SD.UnitSalesTax ELSE 0.00 END, 12, 2))))),
	SaleTaxAmount=LTRIM(RTRIM(STR(Round((((SD.PackQty + SD.LooseQty) * SD.PurPrice * (1 - SD.DiscPerc * 0.01)) * SD.GSTPerc * 0.01), 2) + ROUND(((SD.PackQty + SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax), 2), 12, 2))),
	NetAmount=LTRIM(RTRIM(STR(Round(((SD.PackQty + SD.LooseQty) * SD.PurPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2)))
FROM
	PurLedger SL,
	PurDetail SD,
	Supplier S,
	Accounts A,
	Item I
WHERE
	SL.PurInvCode = SD.PurInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.SuppCode = S.SuppCode AND
	S.SuppCode = A.AccCode AND 
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT
	DocumentCode = LTRIM(RTRIM(STR(SL.PrInvCode, 15))),
	DocumentType= 'PR',
	DocumentDate=Convert(varchar(10), SL.DATE, 103),
	ItemCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9))),
	Batch=SD.Batch,
	SalePrice = LTRIM(RTRIM(STR(SD.PrPrice, 12, 2))),
	Expiry=Convert(varchar(10), SD.Expiry, 103),
	Bonus=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	Units=LTRIM(RTRIM(STR(SD.PackQty + SD.LooseQty, 12))),
	GrossAmount=LTRIM(RTRIM(STR(Round((SD.PackQty + SD.LooseQty) * SD.PrPrice, 2), 12, 2))),
	DiscPerc=LTRIM(RTRIM(STR(SD.DiscPerc, 5, 2))),
	Discount=LTRIM(RTRIM(STR(Round(((SD.PackQty + SD.LooseQty) * SD.PrPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	SaleTaxType = CASE WHEN SD.GSTPerc > 0 THEN 'P' WHEN SD.UnitSalesTax > 0 THEN 'V' ELSE 'N' END,
	SaleTax = LTRIM(RTRIM(STR(CASE WHEN SD.GSTPerc > 0 THEN SD.GSTPerc WHEN SD.UnitSalesTax > 0 THEN SD.UnitSalesTax ELSE 0.00 END, 12, 2))),
	SaleTaxAmount=LTRIM(RTRIM(STR(Round((((SD.PackQty + SD.LooseQty) * SD.PrPrice * (1 - SD.DiscPerc * 0.01)) * SD.GSTPerc * 0.01), 2) + ROUND(((SD.PackQty + SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax), 2), 12, 2))),
	NetAmount=LTRIM(RTRIM(STR(Round(((SD.PackQty + SD.LooseQty) * SD.PrPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2)))
FROM
	PrLedger SL,
	PrDetail SD,
	Supplier S,
	Accounts A,
	Item I
WHERE
	SL.PrInvCode = SD.PrInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.SuppCode = S.SuppCode AND
	S.SuppCode = A.AccCode AND 
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT
	DocumentCode = LTRIM(RTRIM(STR(SL.AdjCode, 15))),
	DocumentType= CASE WHEN SL.AdjCatCode = 1 THEN 'TI' ELSE 'TO' END,
	DocumentDate=Convert(varchar(10), SL.DATE, 103),
	ItemCode=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(I.ICode)), 1, 9))),
	Batch=SD.Batch, 
	SalePrice = LTRIM(RTRIM(STR(SD.Price, 12, 2))),
	Expiry=Convert(varchar(10), SD.Expiry, 103),
	Bonus='0',
	Units=LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	GrossAmount=LTRIM(RTRIM(STR(Round(SD.LooseQty * SD.Price, 2), 12, 2))),
	DiscPerc='0.00',
	Discount='0.00',
	SaleTaxType = 'N',
	SaleTax = '0.00',
	SaleTaxAmount='0.00',
	NetAmount=LTRIM(RTRIM(STR(Round(SD.LooseQty * SD.Price, 2), 12, 2)))
FROM
	AdjHeader SL,
	AdjDetail SD,
	Item I
WHERE
	SL.AdjCode = SD.AdjCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
"
  arguments=(("manfcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
