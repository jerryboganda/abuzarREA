release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1447 color="536870912" )
summary(height=1635 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=long updatewhereclause=yes name=purinvcode dbname="Item.PurInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Item.Date"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="ItemPacking"  )
column=(type=long updatewhereclause=yes name=ipackcode dbname="IPackCode"  )
column=(type=decimal(6) updatewhereclause=yes name=salestaxamt dbname="SalesTaxAmt"  )
column=(type=decimal(9) updatewhereclause=yes name=purvalue dbname="PurValue"  )
column=(type=decimal(2) updatewhereclause=yes name=totaldisc dbname="totaldisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharg dbname="misccharg"  )
column=(type=decimal(6) updatewhereclause=yes name=totalinvdiscperc dbname="totalinvdiscperc"  )
column=(type=decimal(6) updatewhereclause=yes name=diff dbname="diff"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="SalesTax"  )
 retrieve="SELECT
	P.PurInvCode,
	P.Date,
	Supplier = A.Name ,
	ItemPacking = IP.name,
	IPackCode = IP.PackCode,
	SalesTaxAmt = sum(SalesTaxAmt),
	PurValue = ROUND(SUM(P.itemvalue),2),
	totaldisc = (SELECT SUM(flatdisc) FROM purledger p
				    WHERE  p.date between :ar_startdate and :ar_enddate),
	misccharg= (SELECT SUM(misccharges) FROM  purledger p
				   WHERE p.date between :ar_startdate and :ar_enddate),
	totalinvdiscperc= 
		(SELECT SUM(ISNULL(B.invdiscperc,0))
		    FROM
				(SELECT invdiscperc = IsNull(SUM(Round(((d.looseqty + d.packqty ) * 
								d.purprice) * (1 - (.01 * d.discperc)),2)) * 0.01 * p.discperc, 0)
				FROM     purledger p, purdetail d
					WHERE	
					p.date between :ar_startdate and :ar_enddate and 
					p.purinvcode = d.purinvcode
				GROUP BY p.purinvcode, p.discperc) AS  B),
	diff=(select Round(sum ( ISNULL(A.diff,0)), 2)
	      from
		(SELECT p.purinvcode, Diff=ROUND(SUM((d.looseqty + d.packqty) * d.purprice * 
				(1 - (.01 * d.discperc))) * (1- (.01 * p.discperc)) + 
				p.misccharges + p.salestax - p.flatdisc, 0) - 
				(SUM((d.looseqty + d.packqty) * d.purprice * 
				(1 - (.01 * d.discperc))) * (1- (.01 * p.discperc)) + 
				p.misccharges + p.salestax - p.flatdisc)
		FROM purledger p, purdetail d
		WHERE
			p.purinvcode = d.purinvcode AND
			p.date between :ar_startdate and :ar_enddate
		GROUP BY p.purinvcode, p.suppcode, p.purcatcode, p.postdate, p.discperc,
			 p.misccharges, p.salestax, p.flatdisc, p.InvGSTPerc1) as A),
	SalesTax = 
		(SELECT ISNULL(Sum (ISNull(S.SaleTax,0)),0)
		FROM  (SELECT	
			SaleTax=ROUND(SUM((d.looseqty + d.packqty + d.bonusqty) * d.unitsalestax) +
			SUM(ROUND((d.looseqty + d.packqty) * d.purprice * (1 - (.01 * d.discperc)) * 
				d.gstperc * .01, 2)) +
			ROUND((SUM(((d.looseqty + d.packqty) * d.purprice) * 
				(1 - (.01 * d.discperc))) * (1 - (.01 * p.discperc)) - p.flatdisc) * 
				(p.invgstperc1 * .01), 2), 0)
		FROM dbo.Purledger P, dbo.Purdetail D
		WHERE  (P.date between :ar_startdate and :ar_enddate)  And
			P.purinvcode = D.purinvcode
		GROUP BY P.purinvcode, 
			 P.invgstperc1, 
			 P.misccharges,   
			 P.flatdisc,
			 P.discperc) AS S)	
FROM	
	(SELECT
		PL.purinvcode,
		PL.Date,
		PL.SuppCode,
		PD.icode,
		ItemValue=SUM( ( (PD.looseqty + PD.PackQty) * PD.PURPrice ) *
			(1 - (.01 * PD.discperc))),
		SalesTaxAmt = SUM((PD.looseqty + PD.packqty + PD.bonusqty) * PD.unitsalestax) +
				SUM(ROUND((PD.looseqty + PD.packqty) * PD.purprice * (1 - (.01 * PD.discperc)) * PD.gstperc * .01, 2))
	FROM
		Purledger PL Inner Join Purdetail PD On
		PL.PurInvCode = PD.PurInvcode 
	Where   PL.Date Between :ar_startdate And :ar_enddate
	GROUP BY 
		 PL.purinvcode,
		 PL.Date,
		 PL.SuppCode,
		 PL.salesmancode,
		 PD.icode,
		 PL.discperc,
		 PL.flatdisc,
		 PL.invgstperc1
	) P,
	Item I, 
	ItemPacking IP,
	Supplier S,
	Accounts A
Where
	P.Icode 	= I.Icode And
	I.PackCode 	= IP.PackCode And
	IP.PackCode	IN (:ar_packcode) And
	P.SuppCode	= S.SuppCode And
	S.SuppCode	= A.AccCode
Group By 
	P.PurInvCode,
	P.Date,
	A.Name ,
	IP.PackCode,
	IP.name
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_packcode", numberlist))
 sort="itempacking A, date A"
)
