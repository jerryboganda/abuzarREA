table(column=(type=long updatewhereclause=yes name=codelen dbname="CodeLEN"  )
column=(type=char(8000) updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=namelen dbname="NameLEN"  )
column=(type=char(8000) updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes name=address1len dbname="ADDRESS1LEN"  )
column=(type=char(8000) updatewhereclause=yes name=address1 dbname="ADDRESS1"  )
column=(type=long updatewhereclause=yes name=address2len dbname="ADDRESS2LEN"  )
column=(type=char(8000) updatewhereclause=yes name=address2 dbname="ADDRESS2"  )
column=(type=long updatewhereclause=yes name=phonelen dbname="PhoneLen"  )
column=(type=char(8000) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=long updatewhereclause=yes name=licenselen dbname="LicenseLen"  )
column=(type=char(8000) updatewhereclause=yes name=license dbname="License"  )
column=(type=long updatewhereclause=yes name=areacodelen dbname="AreaCodeLEN"  )
column=(type=char(3) updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=long updatewhereclause=yes name=areanamelen dbname="AreaNameLEN"  )
column=(type=char(8000) updatewhereclause=yes name=areaname dbname="AreaName"  )
column=(type=long updatewhereclause=yes name=custtypelen dbname="CustTypeLEN"  )
column=(type=char(30) updatewhereclause=yes name=custtype dbname="CustType"  )
column=(type=long updatewhereclause=yes name=dscodelen dbname="DsCodeLEN"  )
column=(type=char(8000) updatewhereclause=yes name=dscode dbname="DsCode"  )
 retrieve="SELECT
	CodeLEN=12,
	Code = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),
	NameLEN=60,
	Name = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))))),
	ADDRESS1LEN=60,
	ADDRESS1 = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))))),
	ADDRESS2LEN=60,
	ADDRESS2 = LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 60))))),
	PhoneLen=100,
	Phone = LTRIM(RTRIM(SUBSTRING(C.Phone, 1, 100))) + REPLICATE(' ', 100 - LEN(LTRIM(RTRIM(SUBSTRING(C.Phone, 1, 100))))),
	LicenseLen=30,
	License = LTRIM(RTRIM(SUBSTRING(C.LicenceNo, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(C.LicenceNo, 1, 30))))),
	AreaCodeLEN=3,
	AreaCode=STR(AR.SUBAREACODE, 3),
	AreaNameLEN=60,
	AreaName = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 60))))),
	CustTypeLEN=60,
	CustType=(SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE),
	DsCodeLEN=6,
	DsCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode))
FROM Customer C, Accounts A, SubArea AR
WHERE C.CustCode = A.AccCode AND C.SubAreaCode = AR.SubAreaCode
"
  arguments=(("as_distcode", string))
)
