footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=documentnolen dbname="DOCUMENTNOLEN"  )
column=(type=char(12) updatewhereclause=yes name=documentno dbname="DOCUMENTNO"  )
column=(type=long updatewhereclause=yes name=docdtlen dbname="DOCDTLEN"  )
column=(type=char(10) updatewhereclause=yes name=docdt dbname="DOCDT"  )
column=(type=long updatewhereclause=yes name=prdidlen dbname="PRDIDLEN"  )
column=(type=char(9) updatewhereclause=yes name=prdid dbname="PRDID"  )
column=(type=long updatewhereclause=yes name=prdlen dbname="PRDLEN"  )
column=(type=char(50) updatewhereclause=yes name=prd dbname="PRD"  )
column=(type=long updatewhereclause=yes name=purchaseslen dbname="PurchasesLen"  )
column=(type=char(12) updatewhereclause=yes name=purchases dbname="Purchases"  )
column=(type=long updatewhereclause=yes name=transferinlen dbname="TransferInLen"  )
column=(type=char(12) updatewhereclause=yes name=transferin dbname="TransferIn"  )
column=(type=long updatewhereclause=yes name=transferoutlen dbname="TransferOutLen"  )
column=(type=char(12) updatewhereclause=yes name=transferout dbname="TransferOut"  )
column=(type=long updatewhereclause=yes name=dmginstorelen dbname="DmgInStoreLen"  )
column=(type=char(12) updatewhereclause=yes name=dmginstore dbname="DmgInStore"  )
 retrieve="SELECT 
	DSTBIDLEN=6, 
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(PL.PurInvCode, 12))), 1, 12), 
	DOCDTLEN=10,
	DOCDT=Convert(varchar(10), PL.DATE, 103),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	PurchasesLen=12,
	Purchases=SUBSTRING(LTRIM(RTRIM(STR(PD.LooseQty + PD.PackQty + PD.BonusQty, 12, 2))), 1, 12),
	TransferInLen=12,
	TransferIn=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	TransferOutLen=12,
	TransferOut=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	DmgInStoreLen=12,
	DmgInStore=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12)
FROM
	PurLedger PL,
	PurDetail PD,
	Item I
WHERE
	:ai_scope=1 AND
	PL.PurInvCode = PD.PurInvCode AND
	PL.POSTED = 'Y' AND
	PD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	PL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6, 
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(PL.PRInvCode, 12))), 1, 12), 
	DOCDTLEN=10,
	DOCDT=Convert(varchar(10), PL.DATE, 103),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	PurchasesLen=12,
	Purchases=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	TransferInLen=12,
	TransferIn=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	TransferOutLen=12,
	TransferOut=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	DmgInStoreLen=12,
	DmgInStore=SUBSTRING(LTRIM(RTRIM(STR(PD.LooseQty + PD.BonusQty, 12, 2))), 1, 12)
FROM
	PRLedger PL,
	PRDetail PD,
	Item I
WHERE
	:ai_scope=1 AND
	PL.PRInvCode = PD.PRInvCode AND
	PL.POSTED = 'Y' AND
	PD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	PL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6, 
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(PL.PurInvCode, 12))), 1, 12), 
	DOCDTLEN=10,
	DOCDT=Convert(varchar(10), PL.DATE, 103),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	PurchasesLen=12,
	Purchases=SUBSTRING(LTRIM(RTRIM(STR(PD.LooseQty + PD.BonusQty, 12, 2))), 1, 12),
	TransferInLen=12,
	TransferIn=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	TransferOutLen=12,
	TransferOut=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	DmgInStoreLen=12,
	DmgInStore=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12)
FROM
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	CRS_PurLedger PL,
	CRS_PurDetail PD,
	Item I
WHERE
	:ai_scope=2 AND
	CL.ClientID = CI.ClientID AND CI.ClientInstanceID = PL.ClientInstanceID AND
	PL.ClientInstanceID = PD.ClientInstanceID AND
	PL.PurInvCode = PD.PurInvCode AND
	PL.POSTED = 'Y' AND
	PD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	PL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6, 
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(PL.PRInvCode, 12))), 1, 12), 
	DOCDTLEN=10,
	DOCDT=Convert(varchar(10), PL.DATE, 103),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	PurchasesLen=12,
	Purchases=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	TransferInLen=12,
	TransferIn=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	TransferOutLen=12,
	TransferOut=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	DmgInStoreLen=12,
	DmgInStore=SUBSTRING(LTRIM(RTRIM(STR(PD.LooseQty + PD.BonusQty, 12, 2))), 1, 12)
FROM
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	CRS_PRLedger PL,
	CRS_PRDetail PD,
	Item I
WHERE
	:ai_scope=2 AND
	CL.ClientID = CI.ClientID AND CI.ClientInstanceID = PL.ClientInstanceID AND
	PL.ClientInstanceID = PD.ClientInstanceID AND
	PL.PRInvCode = PD.PRInvCode AND
	PL.POSTED = 'Y' AND
	PD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	PL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6, 
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(PL.ReceiptInvCode, 12))), 1, 12), 
	DOCDTLEN=10,
	DOCDT=Convert(varchar(10), PL.DATE, 103),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	PurchasesLen=12,
	Purchases=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	TransferInLen=12,
	TransferIn=SUBSTRING(LTRIM(RTRIM(STR(PD.Qty, 12, 2))), 1, 12),
	TransferOutLen=12,
	TransferOut=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	DmgInStoreLen=12,
	DmgInStore=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12)
FROM
	ReceiptHeader PL,
	ReceiptDetail PD,
	Item I
WHERE
	:ai_scope=1 AND
	PL.ReceiptInvCode = PD.ReceiptInvCode AND
	PL.POSTED = 'Y' AND
	PD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	PL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6, 
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(PL.IssueInvCode, 12))), 1, 12), 
	DOCDTLEN=10,
	DOCDT=Convert(varchar(10), PL.DATE, 103),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	PurchasesLen=12,
	Purchases=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	TransferInLen=12,
	TransferIn=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	TransferOutLen=12,
	TransferOut=SUBSTRING(LTRIM(RTRIM(STR(PD.Qty, 12, 2))), 1, 12),
	DmgInStoreLen=12,
	DmgInStore=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12)
FROM
	IssueHeader PL,
	IssueDetail PD,
	Item I
WHERE
	:ai_scope=1 AND
	PL.IssueInvCode = PD.IssueInvCode AND
	PL.POSTED = 'Y' AND
	PD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	PL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6, 
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(PL.AdjCode, 12))), 1, 12), 
	DOCDTLEN=10,
	DOCDT=Convert(varchar(10), PL.DATE, 103),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	PurchasesLen=12,
	Purchases=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	TransferInLen=12,
	TransferIn=SUBSTRING(LTRIM(RTRIM(STR(CASE WHEN PL.AdjCatCode=1 THEN PD.LooseQty ELSE 0 END, 12, 2))), 1, 12),
	TransferOutLen=12,
	TransferOut=SUBSTRING(LTRIM(RTRIM(STR(CASE WHEN PL.AdjCatCode=2 THEN PD.LooseQty ELSE 0 END, 12, 2))), 1, 12),
	DmgInStoreLen=12,
	DmgInStore=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12)
FROM
	AdjHeader PL,
	AdjDetail PD,
	Item I
WHERE
	:ai_scope=1 AND
	PL.AdjCode = PD.AdjCode AND
	PL.POSTED = 'Y' AND
	PD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	PL.DATE BETWEEN :ar_startdate AND :ar_enddate
"
  arguments=(("as_dstcode", string), ("manfcode", number), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ai_scope", number))
)
