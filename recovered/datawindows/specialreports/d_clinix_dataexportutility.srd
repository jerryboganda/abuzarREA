table(column=(type=char(50) updatewhereclause=yes name=branch_location dbname="Branch_Location"  )
column=(type=char(3) updatewhereclause=yes name=vr_type dbname="VR_Type"  )
column=(type=char(6) updatewhereclause=yes name=tr_type dbname="TR_Type"  )
column=(type=datetime updatewhereclause=yes name=vr_date dbname="VR_Date"  )
column=(type=long updatewhereclause=yes name=vr_no dbname="VR_No"  )
column=(type=long updatewhereclause=yes name=sub_account dbname="Sub_Account"  )
column=(type=long updatewhereclause=yes name=nominal_account dbname="Nominal_Account"  )
column=(type=long updatewhereclause=yes name=party_id dbname="Party_ID"  )
column=(type=char(60) updatewhereclause=yes name=party_name dbname="Party_Name"  )
column=(type=char(100) updatewhereclause=yes name=party_cell_no dbname="Party_Cell_No"  )
column=(type=char(40) updatewhereclause=yes name=bill_no dbname="Bill_No"  )
column=(type=datetime updatewhereclause=yes name=bill_date dbname="Bill_Date"  )
column=(type=datetime updatewhereclause=yes name=bill_due_date dbname="Bill_Due_Date"  )
column=(type=long updatewhereclause=yes name=payment_on_sale dbname="Payment_On_Sale"  )
column=(type=decimal(6) updatewhereclause=yes name=gross_amount dbname="Gross_Amount"  )
column=(type=decimal(6) updatewhereclause=yes name=discount_amount dbname="Discount_Amount"  )
column=(type=decimal(6) updatewhereclause=yes name=tax_amount dbname="Tax_Amount"  )
column=(type=decimal(2) updatewhereclause=yes name=service_charges dbname="Service_Charges"  )
column=(type=decimal(2) updatewhereclause=yes name=incometax dbname="IncomeTax"  )
column=(type=decimal(6) updatewhereclause=yes name=net_amount dbname="Net_Amount"  )
column=(type=long updatewhereclause=yes name=employee_id dbname="Employee_ID"  )
column=(type=char(1) updatewhereclause=yes name=post_fis dbname="Post_FIS"  )
column=(type=datetime updatewhereclause=yes name=post_fis_date dbname="Post_FIS_Date"  )
column=(type=long updatewhereclause=yes name=post_user dbname="Post_User"  )
column=(type=char(12) updatewhereclause=yes name=post_time dbname="Post_Time"  )
 retrieve="SELECT 
	Branch_Location = LEFT(dbo.fn_getpreference('BusinessShortName'), 50),
	VR_Type = 'SSV',
	TR_Type = CASE WHEN S.SaleCatCode = 3 THEN 'CASH' ELSE 'CREDIT' END,
	VR_Date = S.Date,
	VR_No = S.SaleInvCode,
	Sub_Account = NULL,
	Nominal_Account=NULL,
	Party_ID = S.CustCode,
	Party_Name = A.Name,
	Party_Cell_No = C.Phone,
	Bill_No = NULL,
	Bill_Date = NULL,
	Bill_Due_Date = S.DueDate,
	Payment_On_Sale=NULL,
	Gross_Amount = ROUND(SUM(D.LooseQty * D.SalePrice), 0),
	Discount_Amount = ROUND(SUM( (D.LooseQty * D.ItemFlatDisc) +
		(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * D.DiscPerc * 0.01) + 
		(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * S.DiscPerc * 0.01)), 0),
	Tax_Amount = ROUND(SUM( ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) +
		(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPErc * 0.01)) + 
		SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * S.InvGstPerc1 * 0.01), 0),
	Service_Charges = S.MiscCharges - ISNULL(S.AdvanceTaxAmt, 0),
	IncomeTax = ISNULL(S.AdvanceTaxAmt, 0),
	Net_Amount = S.InvTotal,
	Employee_ID = S.SalesmanCode,
	Post_FIS = S.Posted,
	Post_FIS_Date = S.PostDate,
	Post_User = S.PostedBy,
	Post_Time = CONVERT(VARCHAR(12), S.PostDate, 108)
FROM
	SaleLedger S,
	SaleDetail D,
	Customer C,
	Accounts A
WHERE 
	S.Posted = 'Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.SaleInvCode = D.SaleInvCode AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode
GROUP BY
	S.SaleCatCode,
	S.Date,
	S.SaleInvCode,
	S.CustCode,
	A.Name,
	C.Phone,
	S.DueDate,
	S.MiscCharges,
	S.AdvanceTaxAmt, 
	S.InvTotal,
	S.SalesmanCode,
	S.Posted,
	S.PostDate,
	S.PostedBy
UNION ALL
SELECT 
	Branch_Location = LEFT(dbo.fn_getpreference('BusinessShortName'), 50),
	VR_Type = 'SSR',
	TR_Type = CASE WHEN S.SRCatCode = 8 THEN 'CASH' ELSE 'CREDIT' END,
	VR_Date = S.Date,
	VR_No = S.SRInvCode,
	Sub_Account = NULL,
	Nominal_Account=NULL,
	Party_ID = S.CustCode,
	Party_Name = A.Name,
	Party_Cell_No = C.Phone,
	Bill_No = NULL,
	BillDate = NULL,
	Bill_Due_Date = NULL,
	Payment_On_Sale=NULL,
	Gross_Amount = ROUND(SUM(D.LooseQty * D.SRPrice), 0),
	Discount_Amount = ROUND(SUM( (D.LooseQty * D.SRPrice * D.DiscPerc * 0.01) + 
		(D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01) * S.DiscPerc * 0.01)),0),
	Tax_Amount = ROUND(SUM( ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) +
		(D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01) * D.GSTPErc * 0.01)) + 
		SUM(D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * S.InvGstPerc1 * 0.01), 0),
	Service_Charges = S.MiscCharges,
	IncomeTax = 0.00,
	Net_Amount = S.InvTotal,
	Employee_ID = S.SalesmanCode,
	Post_FIS = S.Posted,
	Post_FIS_Date = S.PostDate,
	Post_User = S.PostedBy,
	PostTime = CONVERT(VARCHAR(12), S.PostDate, 108)
FROM
	SRLedger S,
	SRDetail D,
	Customer C,
	Accounts A
WHERE 
	S.Posted = 'Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.SRInvCode = D.SRInvCode AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode
GROUP BY
	S.SRCatCode,
	S.Date,
	S.SRInvCode,
	S.CustCode,
	A.Name,
	C.Phone,
	S.MiscCharges,
	S.InvTotal,
	S.SalesmanCode,
	S.Posted,
	S.PostDate,
	S.PostedBy
UNION ALL
SELECT 
	Branch_Location = LEFT(dbo.fn_getpreference('BusinessShortName'), 50),
	VR_Type = 'SPV',
	TR_Type = 'CREDIT',
	VR_Date = S.Date,
	VR_No = S.PURInvCode,
	Sub_Account = NULL,
	Nominal_Account=NULL,
	Party_ID = S.SuppCode,
	Party_Name = A.Name,
	Party_Cell_No = C.Phone,
	Bill_No = LEFT(S.SuppInvCode,40),
	BillDate = S.SuppInvDate,
	Bill_Due_Date = S.Date + S.CreditDays,
	Payment_On_Sale=NULL,
	Gross_Amount = ROUND(SUM(D.LooseQty * D.PURPrice), 0),
	Discount_Amount = ROUND(SUM( (D.LooseQty * D.PURPrice * D.DiscPerc * 0.01) + 
		(D.LooseQty * D.PURPrice * (1 - D.DiscPerc * 0.01) * S.DiscPerc * 0.01)), 0),
	Tax_Amount = ROUND(SUM( ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) +
		(D.LooseQty * D.PURPrice * (1 - D.DiscPerc * 0.01) * D.GSTPErc * 0.01)) + 
		SUM(D.LooseQty * D.PURPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * S.InvGstPerc1 * 0.01), 0),
	Service_Charges = 0.00,
	IncomeTax = ISNULL(S.AdvanceTaxAmt, 0),
	Net_Amount = S.InvTotal,
	Employee_ID = S.SalesmanCode,
	Post_FIS = S.Posted,
	Post_FIS_Date = S.PostDate,
	Post_User = S.PostedBy,
	PostTime = CONVERT(VARCHAR(12), S.PostDate, 108)
FROM
	PURLedger S,
	PURDetail D,
	Supplier C,
	Accounts A
WHERE 
	S.Posted = 'Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.PURInvCode = D.PURInvCode AND
	S.SuppCode = C.SuppCode AND
	C.SuppCode = A.AccCode
GROUP BY
	S.PURInvCode,
	S.Date,
	S.CreditDays,
	S.SuppCode,
	A.Name,
	C.Phone,
	S.MiscCharges,
	S.AdvanceTaxAmt,
	S.InvTotal,
	S.SalesmanCode,
	S.SuppInvCode,
	S.SuppInvDate,
	S.Posted,
	S.PostDate,
	S.PostedBy
UNION ALL
SELECT 
	Branch_Location = LEFT(dbo.fn_getpreference('BusinessShortName'), 50),
	VR_Type = 'SPR',
	TR_Type = 'CREDIT',
	VR_Date = S.Date,
	VR_No = S.PRInvCode,
	Sub_Account = NULL,
	Nominal_Account=NULL,
	Party_ID = S.SuppCode,
	Party_Name = A.Name,
	Party_Cell_No = C.Phone,
	Bill_No = NULL,
	BillDate = NULL,
	Bill_Due_Date = NULL,
	Payment_On_Sale=NULL,
	Gross_Amount = ROUND(SUM(D.LooseQty * D.PRPrice), 0),
	Discount_Amount = ROUND(SUM( (D.LooseQty * D.PRPrice * D.DiscPerc * 0.01) + 
		(D.LooseQty * D.PRPrice * (1 - D.DiscPerc * 0.01) * S.DiscPerc * 0.01)), 0),
	Tax_Amount = ROUND(SUM( ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) +
		(D.LooseQty * D.PRPrice * (1 - D.DiscPerc * 0.01) * D.GSTPErc * 0.01)) + 
		SUM(D.LooseQty * D.PRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) * S.InvGstPerc1 * 0.01), 0),
	Service_Charges = 0.00,
	IncomeTax = 0.00,
	Net_Amount = S.InvTotal,
	Employee_ID = S.SalesmanCode,
	Post_FIS = S.Posted,
	Post_FIS_Date = S.PostDate,
	Post_User = S.PostedBy,
	PostTime = CONVERT(VARCHAR(12), S.PostDate, 108)
FROM
	PRLedger S,
	PRDetail D,
	Supplier C,
	Accounts A
WHERE 
	S.Posted = 'Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.PRInvCode = D.PRInvCode AND
	S.SuppCode = C.SuppCode AND
	C.SuppCode = A.AccCode
GROUP BY
	S.Date,
	S.PRInvCode,
	S.SuppCode,
	A.Name,
	C.Phone,
	S.MiscCharges,
	S.InvTotal,
	S.SalesmanCode,
	S.Posted,
	S.PostDate,
	S.PostedBy
UNION ALL
SELECT 
	Branch_Location = LEFT(dbo.fn_getpreference('BusinessShortName'), 50),
	VR_Type = 'SAI',
	TR_Type = 'CREDIT',
	VR_Date = S.Date,
	VR_No = S.ADJCode,
	Sub_Account = NULL,
	Nominal_Account=NULL,
	Party_ID = S.AccCode,
	Party_Name = A.Name,
	Party_Cell_No = NULL,
	Bill_No = NULL,
	BillDate = NULL,
	Bill_Due_Date = NULL,
	Payment_On_Sale=NULL,
	Gross_Amount = ROUND(SUM(D.LooseQty * D.Price), 0),
	Discount_Amount = 0.00,
	Tax_Amount = 0.00,
	Service_Charges = 0.00,
	IncomeTax = 0.00,
	Net_Amount = ROUND(SUM(D.LooseQty * D.Price), 0),
	Employee_ID = S.UserCode,
	Post_FIS = S.Posted,
	Post_FIS_Date = S.PostedDate,
	Post_User = S.PostedBy,
	PostTime = CONVERT(VARCHAR(12), S.PostedDate, 108)
FROM
	AdjHeader S,
	AdjDetail D,
	Accounts A
WHERE 
	S.Posted = 'Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.AdjCode = D.AdjCode AND
	S.AdjCatCode = 1 AND
	S.AccCode = A.AccCode
GROUP BY
	S.Date,
	S.AdjCode,
	S.AccCode,
	A.Name,
	S.UserCode,
	S.Posted,
	S.PostedDate,
	S.PostedBy
UNION ALL
SELECT 
	Branch_Location = LEFT(dbo.fn_getpreference('BusinessShortName'), 50),
	VR_Type = 'SAD',
	TR_Type = 'CREDIT',
	VR_Date = S.Date,
	VR_No = S.ADJCode,
	Sub_Account = NULL,
	Nominal_Account=NULL,
	Party_ID = S.AccCode,
	Party_Name = A.Name,
	Party_Cell_No = NULL,
	Bill_No = NULL,
	BillDate = NULL,
	Bill_Due_Date = NULL,
	Payment_On_Sale=NULL,
	Gross_Amount = ROUND(SUM(D.LooseQty * D.Price), 0),
	Discount_Amount = 0.00,
	Tax_Amount = 0.00,
	Service_Charges = 0.00,
	IncomeTax = 0.00,
	Net_Amount = ROUND(SUM(D.LooseQty * D.Price), 0),
	Employee_ID = S.UserCode,
	Post_FIS = S.Posted,
	Post_FIS_Date = S.PostedDate,
	Post_User = S.PostedBy,
	PostTime = CONVERT(VARCHAR(12), S.PostedDate, 108)
FROM
	AdjHeader S,
	AdjDetail D,
	Accounts A
WHERE 
	S.Posted = 'Y' AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.AdjCode = D.AdjCode AND
	S.AdjCatCode = 2 AND
	S.AccCode = A.AccCode
GROUP BY
	S.Date,
	S.AdjCode,
	S.AccCode,
	A.Name,
	S.UserCode,
	S.Posted,
	S.PostedDate,
	S.PostedBy
ORDER BY
	VR_Type,
	VR_No"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
)
