detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=custidlen dbname="CUSTIDLEN"  )
column=(type=char(8) updatewhereclause=yes name=custid dbname="CUSTID"  )
column=(type=long updatewhereclause=yes name=custnamelen dbname="CUSTNAMELEN"  )
column=(type=char(8000) updatewhereclause=yes name=custname dbname="CUSTNAME"  )
column=(type=long updatewhereclause=yes name=addresslen dbname="ADDRESSLEN"  )
column=(type=char(8000) updatewhereclause=yes name=address dbname="ADDRESS"  )
column=(type=long updatewhereclause=yes name=sectorlen dbname="SECTORLEN"  )
column=(type=char(8) updatewhereclause=yes name=sector dbname="SECTOR"  )
column=(type=long updatewhereclause=yes name=sectornamelen dbname="SECTORNAMELEN"  )
column=(type=char(8000) updatewhereclause=yes name=sectorname dbname="SECTORNAME"  )
column=(type=long updatewhereclause=yes name=custtypeidlen dbname="CUSTTYPEIDLEN"  )
column=(type=char(2) updatewhereclause=yes name=custtypeid dbname="CUSTTYPEID"  )
column=(type=long updatewhereclause=yes name=custtypedesclen dbname="CUSTTYPEDESCLEN"  )
column=(type=char(8000) updatewhereclause=yes name=custtypedesc dbname="CUSTTYPEDESC"  )
column=(type=long updatewhereclause=yes name=custclasslen dbname="CUSTCLASSLEN"  )
column=(type=char(1) updatewhereclause=yes name=custclass dbname="CUSTCLASS"  )
column=(type=long updatewhereclause=yes name=statuslen dbname="STATUSLEN"  )
column=(type=char(1) updatewhereclause=yes name=status dbname="STATUS"  )
 retrieve="SELECT
	DSTBIDLEN=2,
	DSTBID=:as_distcode + REPLICATE(' ', 2 - LEN(:as_distcode)),
	CUSTIDLEN=8,
	CUSTID = SUBSTRING(C.MembershipID, 1, 8),
	/*CTLEN=2,
	CT=CASE 
		WHEN SOUNDEX((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)) = SOUNDEX('WHOLE SALE') THEN '01'
		WHEN SOUNDEX((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)) = SOUNDEX('RETAIL') THEN '02'
		WHEN SOUNDEX((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)) = SOUNDEX('INSTITUTION') THEN '03'
		WHEN SOUNDEX((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)) = SOUNDEX('DOCTOR') THEN '04'
		ELSE '05' END,*/
	CUSTNAMELEN=50,
	CUSTNAME = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))))),
	ADDRESSLEN=100,
	ADDRESS = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 100))) + REPLICATE(' ', 100 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 100))))),
	SECTORLEN=8,
	SECTOR=Ltrim(STR(AR.AREACODE, 8)),
	SECTORNAMELEN=50,
	SECTORNAME = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))))),
	CUSTTYPEIDLEN=2,
	CUSTTYPEID=Ltrim(STR(C.CUSTCATCODE,2)),
	CUSTTYPEDESCLEN=25,
	CUSTTYPEDESC= LTRIM(RTRIM(SUBSTRING(CC.NAME, 1, 25))) + REPLICATE(' ', 25 - LEN(LTRIM(RTRIM(SUBSTRING(CC.NAME, 1, 25))))),
	CUSTCLASSLEN=1,
	CUSTCLASS=SUBSTRING(C.Designation,1,1),
	STATUSLEN=1,
	STATUS='N'
FROM Customer C, Accounts A, Area AR, Customercategory CC
WHERE C.CustCode = A.AccCode AND C.AreaCode = AR.AreaCode AND C.Custcatcode=CC.custcatcode
"
  arguments=(("as_distcode", string))
)
