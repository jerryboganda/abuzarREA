table(column=(type=char(15) updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=char(2) updatewhereclause=yes name=documenttype dbname="DocumentType"  )
column=(type=char(10) updatewhereclause=yes name=documentdate dbname="DocumentDate"  )
column=(type=char(12) updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(12) updatewhereclause=yes name=regioncode dbname="RegionCode"  )
column=(type=char(12) updatewhereclause=yes name=bookingmancode dbname="BookingManCode"  )
column=(type=char(12) updatewhereclause=yes name=deliverymancode dbname="DeliveryManCode"  )
column=(type=char(12) updatewhereclause=yes name=grossamount dbname="GrossAmount"  )
column=(type=char(12) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=char(12) updatewhereclause=yes name=saletaxamount dbname="SaleTaxAmount"  )
column=(type=char(12) updatewhereclause=yes name=netamount dbname="NetAmount"  )
 retrieve="SELECT 
	DocumentCode = LTRIM(RTRIM(STR(SL.SaleInvCode, 15))),
	DocumentType= 'SI',
	DocumentDate=Convert(varchar(10), SL.DATE, 103),
	CustCode = LTRIM(RTRIM(STR(SL.CustCode, 12))),
	RegionCode = LTRIM(RTRIM(STR(AR.RegionCode, 12))),
	BookingManCode = LTRIM(RTRIM(STR(SL.SMANCode, 12))),
	DeliveryManCode = LTRIM(RTRIM(STR(SL.DeliveredBY, 12))),
	GrossAmount=LTRIM(RTRIM(STR(Round(SUM(SD.LooseQty * SD.SalePrice), 2), 12, 2))),
	Discount=LTRIM(RTRIM(STR(Round(SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) + SUM(SD.LooseQty * SD.ItemFlatDisc), 12, 2))),
	SaleTaxAmount=LTRIM(RTRIM(STR(Round(SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2) + ROUND(SUM((SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax), 2), 12, 2))),
	NetAmount=LTRIM(RTRIM(STR(MAX(SL.InvTotal), 12, 2)))
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	Accounts A,
	Area AR,
	CustomerCategory CC,
	Item I
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
GROUP BY
	SL.SaleInvCode,
	SL.date,
	SL.CustCode,
	AR.RegionCode,
	SL.SManCode,
	SL.deliveredby
UNION ALL
SELECT 
	DocumentCode = LTRIM(RTRIM(STR(SL.SRInvCode, 15))),
	DocumentType= 'SR',
	DocumentDate=Convert(varchar(10), SL.DATE, 103),
	CustCode = LTRIM(RTRIM(STR(SL.CustCode, 12))),
	RegionCode = LTRIM(RTRIM(STR(AR.RegionCode, 12))),
	BookingManCode = LTRIM(RTRIM(STR(SL.SMANCode, 12))),
	DeliveryManCode = LTRIM(RTRIM(STR(SL.SMANCode, 12))),
	GrossAmount=LTRIM(RTRIM(STR(Round(SUM(SD.LooseQty * SD.SRPrice), 2), 12, 2))),
	Discount=LTRIM(RTRIM(STR(Round(SUM(SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	SaleTaxAmount=LTRIM(RTRIM(STR(Round(SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2) + ROUND(SUM((SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax), 2), 12, 2))),
	NetAmount=LTRIM(RTRIM(STR(MAX(SL.InvTotal), 12, 2)))
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Accounts A,
	Area AR,
	CustomerCategory CC,
	Item I
WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
GROUP BY
	SL.SRInvCode,
	SL.date,
	SL.CustCode,
	AR.RegionCode,
	SL.SManCode,
	SL.SMANCode
UNION ALL
SELECT 
	DocumentCode = LTRIM(RTRIM(STR(SL.PurInvCode, 15))),
	DocumentType= 'PI',
	DocumentDate=Convert(varchar(10), SL.DATE, 103),
	CustCode = LTRIM(RTRIM(STR(SL.SuppCode, 12))),
	RegionCode = '1',
	BookingManCode = '1',
	DeliveryManCode = '1',
	GrossAmount=LTRIM(RTRIM(STR(Round(SUM((SD.PackQty + SD.LooseQty) * SD.PurPrice), 2), 12, 2))),
	Discount=LTRIM(RTRIM(STR(Round(SUM((SD.PackQty + SD.LooseQty) * SD.PurPrice  * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	SaleTaxAmount=LTRIM(RTRIM(STR(Round(SUM((SD.PackQty + SD.LooseQty) * SD.PurPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2) + ROUND(SUM((SD.PackQty + SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax), 2), 12, 2))),
	NetAmount=LTRIM(RTRIM(STR(MAX(SL.InvTotal), 12, 2)))
FROM
	PurLedger SL,
	PurDetail SD,
	Supplier C,
	Accounts A,
	Item I
WHERE
	SL.PurInvCode = SD.PurInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.SuppCode = C.SuppCode AND
	C.SuppCode = A.AccCode AND 
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
GROUP BY
	SL.PurInvCode,
	SL.date,
	SL.SuppCode
UNION ALL
SELECT 
	DocumentCode = LTRIM(RTRIM(STR(SL.PrInvCode, 15))),
	DocumentType= 'PR',
	DocumentDate=Convert(varchar(10), SL.DATE, 103),
	CustCode = LTRIM(RTRIM(STR(SL.SuppCode, 12))),
	RegionCode = '1',
	BookingManCode = '1',
	DeliveryManCode = '1',
	GrossAmount=LTRIM(RTRIM(STR(Round(SUM((SD.PackQty + SD.LooseQty) * SD.PrPrice), 2), 12, 2))),
	Discount=LTRIM(RTRIM(STR(Round(SUM((SD.PackQty + SD.LooseQty) * SD.PrPrice  * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	SaleTaxAmount=LTRIM(RTRIM(STR(Round(SUM((SD.PackQty + SD.LooseQty) * SD.PrPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2) + ROUND(SUM((SD.PackQty + SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax), 2), 12, 2))),
	NetAmount=LTRIM(RTRIM(STR(MAX(SL.InvTotal), 12, 2)))
FROM
	PrLedger SL,
	PrDetail SD,
	Supplier C,
	Accounts A,
	Item I
WHERE
	SL.PrInvCode = SD.PrInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.SuppCode = C.SuppCode AND
	C.SuppCode = A.AccCode AND 
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
GROUP BY
	SL.PrInvCode,
	SL.date,
	SL.SuppCode
UNION ALL
SELECT 
	DocumentCode = LTRIM(RTRIM(STR(SL.AdjCode, 15))),
	DocumentType= CASE WHEN SL.AdjCatCode = 1 THEN 'TI' ELSE 'TO' END,
	DocumentDate=Convert(varchar(10), SL.DATE, 103),
	CustCode = LTRIM(RTRIM(STR(ISNULL(SL.AccCode, ''), 12))),
	RegionCode = '1',
	BookingManCode = '1', 
	DeliveryManCode = '1', 
	GrossAmount=LTRIM(RTRIM(STR(Round(SUM((SD.LooseQty) * SD.Price), 2), 12, 2))),
	Discount='0.00',
	SaleTaxAmount='0.00',
	NetAmount=LTRIM(RTRIM(STR(Round(SUM((SD.LooseQty) * SD.Price), 2), 12, 2)))
FROM
	AdjHeader SL,
	AdjDetail SD,
	Item I
WHERE
	SL.AdjCode = SD.AdjCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
GROUP BY
	SL.AdjCode,
	SL.AdjCatCode,
	SL.date,
	SL.AccCode
"
  arguments=(("manfcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
