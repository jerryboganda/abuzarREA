release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=88 color="536870912" )
table(column=(type=long updatewhereclause=yes name=depotidlen dbname="DEPOTIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=depotid dbname="DEPOTID"  )
column=(type=long updatewhereclause=yes name=productidlen dbname="PRODUCTIDLEN"  )
column=(type=char(9) updatewhereclause=yes name=productid dbname="PRODUCTID"  )
column=(type=long updatewhereclause=yes name=batchnolen dbname="BATCHNOLEN"  )
column=(type=char(10) updatewhereclause=yes name=batchno dbname="BATCHNO"  )
column=(type=long updatewhereclause=yes name=expdtlen dbname="EXPDTLEN"  )
column=(type=char(8000) updatewhereclause=yes name=expdt dbname="EXPDT"  )
column=(type=long updatewhereclause=yes name=openinglen dbname="OPENINGLEN"  )
column=(type=char(13) updatewhereclause=yes name=opening dbname="OPENING"  )
column=(type=long updatewhereclause=yes name=purchaseslen dbname="PURCHASESLEN"  )
column=(type=char(13) updatewhereclause=yes name=purchases dbname="PURCHASES"  )
column=(type=long updatewhereclause=yes name=transitlen dbname="TRANSITLEN"  )
column=(type=char(13) updatewhereclause=yes name=transit dbname="TRANSIT"  )
column=(type=long updatewhereclause=yes name=transferslen dbname="TRANSFERSLEN"  )
column=(type=char(13) updatewhereclause=yes name=transfers dbname="TRANSFERS"  )
column=(type=long updatewhereclause=yes name=salesqtylen dbname="SALESQTYLEN"  )
column=(type=char(13) updatewhereclause=yes name=salesqty dbname="SALESQTY"  )
column=(type=long updatewhereclause=yes name=returnqtylen dbname="RETURNQTYLEN"  )
column=(type=char(13) updatewhereclause=yes name=returnqty dbname="RETURNQTY"  )
column=(type=long updatewhereclause=yes name=bonusqtylen dbname="BONUSQTYLEN"  )
column=(type=char(13) updatewhereclause=yes name=bonusqty dbname="BONUSQTY"  )
column=(type=long updatewhereclause=yes name=shrtexplen dbname="SHRTEXPLEN"  )
column=(type=char(13) updatewhereclause=yes name=shrtexp dbname="SHRTEXP"  )
column=(type=long updatewhereclause=yes name=foclen dbname="FOCLEN"  )
column=(type=char(13) updatewhereclause=yes name=foc dbname="FOC"  )
column=(type=long updatewhereclause=yes name=misclen dbname="MISCLEN"  )
column=(type=char(13) updatewhereclause=yes name=misc dbname="MISC"  )
column=(type=long updatewhereclause=yes name=balqtylen dbname="BALQTYLEN"  )
column=(type=char(13) updatewhereclause=yes name=balqty dbname="BALQTY"  )
column=(type=long updatewhereclause=yes name=downloaddatelen dbname="DOWNLOADDATELEN"  )
column=(type=char(8000) updatewhereclause=yes name=downloaddate dbname="DOWNLOADDATE"  )
column=(type=long updatewhereclause=yes name=transinlen dbname="TRANSINLEN"  )
column=(type=char(13) updatewhereclause=yes name=transin dbname="TRANSIN"  )
column=(type=long updatewhereclause=yes name=transoutlen dbname="TRANSOUTLEN"  )
column=(type=char(13) updatewhereclause=yes name=transout dbname="TRANSOUT"  )
 retrieve="SELECT
 	DEPOTIDLEN=2,
	DEPOTID=:as_distcode + REPLICATE(' ', 2 - LEN(:as_distcode)),
	PRODUCTIDLEN=9,
	PRODUCTID=SUBSTRING(LTRIM(RTRIM(Max(I.packingdesc))), 1, 9),
	BATCHNOLEN=10,
	BATCHNO=SUBSTRING(St.Batch,1,10),
	EXPDTLEN=9,
	/*EXPDT=SUBSTRING(CONVERT(VARCHAR(9),St.EXPIRY,3),1,9),*/
	EXPDT=UPPER(REPLACE( SUBSTRING(CONVERT(VARCHAR(100), St.EXPIRY, 106), 1, 7), ' ', '-')) + STR(RIGHT(YEAR(St.EXPIRY), 2), 2),
	OPENINGLEN=13,
	OPENING=STR(SUM(CASE WHEN type='OP' THEN st.qty + st.bonus ELSE 0 END), 13),
	PURCHASESLEN=13,
	PURCHASES=STR(SUM(CASE TYPE WHEN 'PV' THEN st.qty + st.bonus ELSE 0 END), 13),
	TRANSITLEN=13,
	TRANSIT=STR(SUM(CASE TYPE WHEN 'TRN' THEN st.qty + st.bonus ELSE 0 END), 13),
	TRANSFERSLEN=13,
	TRANSFERS=STR(SUM(CASE TYPE WHEN 'PR' THEN st.qty + st.Bonus ELSE 0 END), 13),
	SALESQTYLEN=13,
	SALESQTY=STR(SUM(CASE TYPE WHEN 'SV' THEN st.qty ELSE 0 END), 13),
	RETURNQTYLEN=13,
	RETURNQTY=STR(SUM(CASE TYPE  WHEN 'SR' THEN  (st.qty) ELSE 0 END), 13),
	BONUSQTYLEN=13,
	BONUSQTY=STR(SUM(CASE TYPE WHEN 'SV' THEN st.Bonus WHEN 'SR' THEN - (st.bonus) ELSE 0 END), 13),
	SHRTEXPLEN=13,
	SHRTEXP=STR(0,13),
	FOCLEN=13,
	FOC=STR(SUM(CASE TYPE WHEN 'SVFOC' THEN (st.qty + st.Bonus)  ELSE 0 END), 13),
	MISCLEN=13,
	MISC= STR(SUM(CASE WHEN TYPE = 'RV' OR TYPE = 'AI' THEN st.qty + st.bonus ELSE 0 END) -  (SUM(CASE WHEN TYPE = 'IV' OR TYPE = 'AD' OR TYPE = 'DS' THEN st.qty + st.bonus ELSE 0 END)),13),
	BALQTYLEN=13,
	BALQTY=STR(SUM(
		CASE WHEN TYPE = 'OP' OR TYPE = 'PV' OR TYPE = 'SR' OR TYPE = 'RV' OR TYPE = 'AI' THEN +1 
		ELSE -1 END * (st.qty + st.Bonus) ), 13),
	DOWNLOADDATELEN=9,
	DOWNLOADDATE=UPPER(REPLACE( SUBSTRING(CONVERT(VARCHAR(100), GetDate(), 106), 1, 7), ' ', '-')) + STR(RIGHT(YEAR(GetDate()), 2), 2),
	TRANSINLEN=13,
	TRANSIN=STR(0,13),
	TRANSOUTLEN=13,
	TRANSOUT=STR(0,13)
FROM
	(SELECT type='OP', icode, batch,expiry, qty = sum(qty), bonus = sum(bonus)
	FROM	
		(select pd.icode, pd.batch, pd.expiry,
			qty = sum(isnull(
				case pl.purcatcode 
				when 1 THEN (pd.packqty * pd.packunits)
				when 2 THEN (pd.packqty * pd.packunits)
				else pd.looseqty end, 0)), 
			bonus = sum(isnull(
				case pl.purcatcode 
				when 1 THEN (pd.bonusqty * pd.packunits)
				when 2 THEN (pd.bonusqty * pd.packunits)
				else pd.bonusqty end, 0))
		FROM purledger pl, purdetail pd, item i
		WHERE pl.posted = 'Y' AND 
			pl.purinvcode = pd.purinvcode AND
			pl.postdate < :ar_startdate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode, pd.batch,pd.expiry
		UNION ALL
		select	pd.icode, pd.batch,pd.expiry,
			qty  = - sum(pd.looseqty),
			bonus = - sum(pd.bonusqty)
		FROM prledger pl, prdetail pd, item i
		WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
			pl.date < :ar_startdate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode, pd.batch,pd.expiry
		UNION ALL
		select	sd.icode, sd.batch,sd.expiry,
			qty  = -sum(sd.looseqty),
			bonus  = -sum(sd.bonusqty)
		FROM saleledger sl, saledetail sd, item i
		WHERE sl.saleinvcode = sd.saleinvcode AND
			  sl.posted = 'Y' AND 
		      sl.date < :ar_startdate AND sd.Due IS NULL AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch,sd.expiry,
			qty  = sum(sd.looseqty),
			bonus = sum(sd.bonusqty)
		FROM srledger sl, srdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
			  sl.posted = 'Y' AND 
		      sl.postdate < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch, sd.expiry,qty  = -sum(sd.qty), bonus = 0
		FROM issueheader sl, issuedetail sd, item i
		WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch, sd.expiry,qty  = sum(sd.qty), bonus=0
		FROM receiptheader sl, receiptdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
		      sl.postdate < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch,sd.expiry, qty = sum(sd.looseqty), bonus=0
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		      sl.posteddate < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch,sd.expiry, qty = -sum(sd.looseqty), bonus=0
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		      sl.posteddate < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	d.icode, d.batch, d.expiry, qty = -sum(d.duesatisfyqty), bonus=0
		FROM duesatisfyheader h, duesatisfydetail d, item i
		WHERE h.duesatisfycode=d.duesatisfycode AND
		      h.duesatisfydate < :ar_startdate AND
			d.icode=i.icode and i.manfcode in (:manfcode)
		Group By d.icode, d.batch,d.expiry) A
	GROUP BY icode, batch,expiry
	UNION ALL
	select	type='PV',
		pd.icode, pd.batch,pd.expiry,
		qty = sum(pd.looseqty + pd.packqty * pd.packunits),
		bonus = sum(isnull(case pl.purcatcode 
			when 1 THEN pd.bonusqty * pd.packunits
			when 2 THEN pd.bonusqty * pd.packunits
			else pd.bonusqty
			end, 0))
	FROM purledger pl, purdetail pd, item i
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pl.postdate BETWEEN :ar_startdate and :ar_enddate AND
		pd.icode=i.icode and i.manfcode in (:manfcode)
	Group By pd.icode, pd.batch,pd.expiry
	UNION ALL
	select	type='TRN',
		pd.icode, pd.batch,pd.expiry,
		qty = sum(pd.looseqty + pd.packqty * pd.packunits),
		bonus = sum(isnull(case pl.purcatcode 
			when 1 THEN pd.bonusqty * pd.packunits
			when 2 THEN pd.bonusqty * pd.packunits
			else pd.bonusqty
			end, 0))
	FROM purledger pl, purdetail pd, item i
	WHERE pl.posted = 'N' AND pl.purinvcode = pd.purinvcode AND
		pl.postdate BETWEEN :ar_startdate and :ar_enddate AND
		pd.icode=i.icode and i.manfcode in (:manfcode)
	Group By pd.icode, pd.batch,pd.expiry
	UNION ALL
	select	type='PR',
		pd.icode,
		pd.batch,pd.expiry,
		qty = sum(pd.looseqty),
		bonus = sum(pd.bonusqty)
	FROM prledger pl, prdetail pd, item i
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
	      pl.date BETWEEN :ar_startdate and :ar_enddate AND
		pd.icode=i.icode and i.manfcode in (:manfcode)
	Group By pd.icode, pd.batch,pd.expiry
	UNION ALL
	select	type='SV',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = sum(sd.bonusqty)
	FROM saleledger sl, saledetail sd, item i
	WHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
		sl.date BETWEEN :ar_startdate and :ar_enddate AND
		sd.saleprice <> 0 AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='SVFOC',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = sum(sd.bonusqty)
	FROM saleledger sl, saledetail sd, item i
	WHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.saleprice=0 AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='SR',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = sum(sd.bonusqty)
	FROM srledger sl, srdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
	      sl.postdate BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='IV',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.qty),
		bonus = 0
	FROM issueheader sl, issuedetail sd, item i
	WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
	      sl.date BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='DS',
		d.icode, d.batch,d.expiry,
		qty = sum(d.duesatisfyqty),
		bonus = 0
	FROM duesatisfyheader h, duesatisfydetail d, item i
	WHERE h.duesatisfycode = d.duesatisfycode AND
	      h.duesatisfydate BETWEEN :ar_startdate and :ar_enddate AND
		d.icode=i.icode and i.manfcode in (:manfcode)
	Group By d.icode, d.batch,d.expiry
	UNION ALL
	select	type='RV',
		sd.icode, sd.batch, sd.expiry, 
		qty = sum(sd.qty),
		bonus = 0
	FROM receiptheader sl, receiptdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	      sl.postdate BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='AI',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = 0
	FROM Adjheader sl, Adjdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		sl.posteddate BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='AD',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = 0
	FROM Adjheader sl, Adjdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		sl.date BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	/*UNION ALL
	SELECT type='OP', icode, batch=SPACE(10), expiry=getdate(),qty = 0, bonus = 0
	FROM ITEM 
	WHERE ManfCode IN (:manfcode)*/) St, 
	Item i
WHERE st.icode = i.icode
GROUP BY i.icode, i.name, i.customicode, st.batch,st.expiry
ORDER BY i.customicode
"
  arguments=(("manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
 filter=" integer(trim(opening)) <> 0 OR integer(trim(purchases)) <> 0 OR integer(trim(transit)) <> 0 OR integer(trim(transfers)) <> 0 OR integer(trim(salesqty)) <> 0 OR  integer(trim(returnqty)) <> 0 OR integer(trim(bonusqty)) <> 0 OR integer(trim(shrtexp)) <> 0 OR  integer(trim(foc)) <> 0 OR integer(trim(transin)) <> 0 OR integer(trim(transout)) <> 0 OR integer(trim(MISC)) <> 0 "
 )
