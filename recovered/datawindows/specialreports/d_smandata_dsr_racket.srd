table(column=(type=char(101) updatewhereclause=yes name=distributor dbname="Distributor"  )
column=(type=char(10) updatewhereclause=yes name=salesdirector dbname="SalesDirector"  )
column=(type=char(15) updatewhereclause=yes name=rsm dbname="RSM"  )
column=(type=char(10) updatewhereclause=yes name=asm dbname="ASM"  )
column=(type=char(14) updatewhereclause=yes name=tso_tse dbname="TSO_TSE"  )
column=(type=char(111) updatewhereclause=yes name=dsrcode dbname="DSRCode"  )
column=(type=char(60) updatewhereclause=yes name=dsrname dbname="DSRName"  )
column=(type=char(12) updatewhereclause=yes name=dsrtype dbname="DSRTYPE"  )
 retrieve="SELECT
	Distributor=LTRIM(RTRIM(:as_distcode + SPACE(100))),
	SalesDirector='Zaid Tahir',
	RSM='MUSHTAQ HUSSAIN',
	ASM='Jawad Raza',
	TSO_TSE='Tallat Mehmood',
	DSRCode=LTRIM(RTRIM(:as_distcode)) + LTRIM(RTRIM(STR(S.SalesmanCode))) + SPACE(100),
	DSRName=S.Name,
	DSRTYPE='Order Booker'
FROM SALESMAN S
"
  arguments=(("as_distcode", string))
)
