footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(6) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=spoidlen dbname="SPOIDLEN"  )
column=(type=char(8) updatewhereclause=yes name=spoid dbname="SPOID"  )
column=(type=long updatewhereclause=yes name=spolen dbname="SPOLEN"  )
column=(type=char(60) updatewhereclause=yes name=spo dbname="SPO"  )
column=(type=long updatewhereclause=yes name=teamlen dbname="TEAMLEN"  )
column=(type=char(1) updatewhereclause=yes name=team dbname="TEAM"  )
 retrieve="SELECT
	DSTBIDLEN=6,
	DSTBID=(SELECT LEFT(LTRIM(RTRIM(DBO.Fn_GetPreference('MerckDistCode'))), 6)),
	SPOIDLEN=8,
	SPOID=STR(S.SalesManCode, 8),
	SPOLEN=40,
	SPO=S.Name,
	TEAMLEN=1,
	TEAM=SUBSTRING(ST.Name, 1, 1)
FROM SALESMAN S, SALESTEAMMEMBER STM, SALESTEAM ST
WHERE ST.SaleTeamCode = STM.SaleTeamCode AND
		ST.ManfCode = :manfcode AND
		S.SalesManCode = STM.SalesManCode"
  arguments=(("manfcode", number))
)
