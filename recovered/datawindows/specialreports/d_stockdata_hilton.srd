table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(6) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=prdidlen dbname="PRDIDLEN"  )
column=(type=char(9) updatewhereclause=yes name=prdid dbname="PRDID"  )
column=(type=long updatewhereclause=yes name=productlen dbname="PRODUCTLEN"  )
column=(type=char(40) updatewhereclause=yes name=product dbname="PRODUCT"  )
column=(type=long updatewhereclause=yes name=cl_ballen dbname="CL_BALLEN"  )
column=(type=char(8) updatewhereclause=yes name=cl_bal dbname="CL_BAL"  )
column=(type=long updatewhereclause=yes name=in_transitlen dbname="IN_TRANSITLEN"  )
column=(type=char(8) updatewhereclause=yes name=in_transit dbname="IN_TRANSIT"  )
column=(type=long updatewhereclause=yes name=ot_outlen dbname="OT_OUTLEN"  )
column=(type=char(8) updatewhereclause=yes name=ot_out dbname="OT_OUT"  )
column=(type=long updatewhereclause=yes name=ot_inlen dbname="OT_INLEN"  )
column=(type=char(8) updatewhereclause=yes name=ot_in dbname="OT_IN"  )
 retrieve="SELECT
	DSTBIDLEN=6, 
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.Remarks)), 1, 9),
	PRODUCTLEN=40,
	PRODUCT=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 40),
	CL_BALLEN=8,
	CL_BAL=STR(SUM(ISNULL(GD.CurrQty, 0)), 8),
	IN_TRANSITLEN=8,
	IN_TRANSIT=STR(0, 8),
	OT_OUTLEN=8,
	OT_OUT=STR(0, 8),
	OT_INLEN=8,
	OT_IN=STR(0, 8)
FROM
	Item I LEFT OUTER JOIN GodownDetail AS GD ON (I.ICode = GD.ICode)
WHERE
	I.ManfCode = :manfcode
GROUP BY
	I.ICode, I.Name, I.Remarks"
  arguments=(("manfcode", number), ("as_distcode", string))
)
