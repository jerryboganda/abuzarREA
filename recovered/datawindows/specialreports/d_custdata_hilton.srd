table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(255) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=custidlen dbname="CUSTIDLEN"  )
column=(type=char(10) updatewhereclause=yes name=custid dbname="CUSTID"  )
column=(type=long updatewhereclause=yes name=ctlen dbname="CTLEN"  )
column=(type=char(2) updatewhereclause=yes name=ct dbname="CT"  )
column=(type=long updatewhereclause=yes name=custnamelen dbname="CUSTNAMELEN"  )
column=(type=char(255) updatewhereclause=yes name=custname dbname="CUSTNAME"  )
column=(type=long updatewhereclause=yes name=addresslen dbname="ADDRESSLEN"  )
column=(type=char(255) updatewhereclause=yes name=address dbname="ADDRESS"  )
column=(type=long updatewhereclause=yes name=address2len dbname="ADDRESS2LEN"  )
column=(type=char(255) updatewhereclause=yes name=address2 dbname="ADDRESS2"  )
column=(type=long updatewhereclause=yes name=citylen dbname="CITYLEN"  )
column=(type=char(255) updatewhereclause=yes name=city dbname="CITY"  )
column=(type=long updatewhereclause=yes name=dstb_areaidlen dbname="DSTB_AREAIDLEN"  )
column=(type=char(16) updatewhereclause=yes name=dstb_aearid dbname="DSTB_AEARID"  )
column=(type=long updatewhereclause=yes name=dstb_arealen dbname="DSTB_AREALEN"  )
column=(type=char(255) updatewhereclause=yes name=dstb_area dbname="DSTB_AREA"  )
 retrieve="SELECT
	DSTBIDLEN=6,
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	CUSTIDLEN=10,
	CUSTID = STR(C.CustCode, 10),
	CTLEN=2,
	CT=CASE 
		WHEN SOUNDEX((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)) = SOUNDEX('WHOLE SALE') THEN '01'
		WHEN SOUNDEX((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)) = SOUNDEX('RETAIL') THEN '02'
		WHEN SOUNDEX((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)) = SOUNDEX('INSTITUTION') THEN '03'
		WHEN SOUNDEX((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)) = SOUNDEX('DOCTOR') THEN '04'
		ELSE '05' END,
	CUSTNAMELEN=50,
	CUSTNAME = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))))),
	ADDRESSLEN=50,
	ADDRESS = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 50))))),
	ADDRESS2LEN=30,
	ADDRESS2 = LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 30))))),
	CITYLEN=30,
	CITY = LTRIM(RTRIM(SUBSTRING(C.CITY, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(C.CITY, 1, 30))))),
	DSTB_AREAIDLEN=16,
	DSTB_AEARID=STR(AR.AREACODE, 16),
	DSTB_AREALEN=100,
	DSTB_AREA = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 100))) + REPLICATE(' ', 16 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 100)))))
FROM Customer C, Accounts A, Area AR
WHERE C.CustCode = A.AccCode AND C.AreaCode = AR.AreaCode
"
  arguments=(("as_distcode", string))
)
