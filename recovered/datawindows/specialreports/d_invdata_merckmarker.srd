footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=documentnolen dbname="DOCUMENTNOLEN"  )
column=(type=char(12) updatewhereclause=yes name=documentno dbname="DOCUMENTNO"  )
column=(type=long updatewhereclause=yes name=docdatelen dbname="DOCDATELEN"  )
column=(type=char(10) updatewhereclause=yes name=docdate dbname="DOCDATE"  )
column=(type=long updatewhereclause=yes name=custidlen dbname="CUSTIDLEN"  )
column=(type=char(10) updatewhereclause=yes name=custid dbname="CUSTID"  )
column=(type=long updatewhereclause=yes name=prdidlen dbname="PRDIDLEN"  )
column=(type=char(9) updatewhereclause=yes name=prdid dbname="PRDID"  )
column=(type=long updatewhereclause=yes name=batchnolen dbname="BatchNoLEN"  )
column=(type=char(10) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=long updatewhereclause=yes name=expdatelen dbname="ExpDateLEN"  )
column=(type=char(10) updatewhereclause=yes name=expdate dbname="ExpDate"  )
column=(type=long updatewhereclause=yes name=actuallen dbname="ActualLEN"  )
column=(type=char(12) updatewhereclause=yes name=actual dbname="Actual"  )
column=(type=long updatewhereclause=yes name=ratelen dbname="RateLEN"  )
column=(type=char(12) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=long updatewhereclause=yes name=discountlen dbname="DISCOUNTLEN"  )
column=(type=char(12) updatewhereclause=yes name=discount dbname="DISCOUNT"  )
column=(type=long updatewhereclause=yes name=bonuslen dbname="BonusLEN"  )
column=(type=char(12) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=long updatewhereclause=yes name=returnslen dbname="ReturnsLEN"  )
column=(type=char(12) updatewhereclause=yes name=returns dbname="Returns"  )
column=(type=long updatewhereclause=yes name=expiredlen dbname="ExpiredLEN"  )
column=(type=char(12) updatewhereclause=yes name=expired dbname="Expired"  )
 retrieve="SELECT
	DSTBIDLEN=6, 
	DSTBID= ZAR.DistCode + REPLICATE(' ', 6 - LEN(ZAR.DistCode)), 
	DOCUMENTNOLEN=12, 
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SaleInvCode, 12))), 1, 12),  
	DOCDATELEN=10, 
	DOCDATE=Convert(varchar(10), SL.DATE, 103), 
	CUSTIDLEN=10,
	CUSTID = SUBSTRING(LTRIM(RTRIM(STR(SL.CustCode, 10))), 1, 10), 
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	ExpDateLEN=10,
	ExpDate=Convert(varchar(10), SD.Expiry, 103),
	ActualLEN=12,
	Actual=SUBSTRING(LTRIM(RTRIM(STR(SD.LooseQty, 12, 2))), 1, 12),
	RateLEN=12,
	Rate=SUBSTRING(LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))), 1, 12), 
	DISCOUNTLEN=12,
	DISCOUNT=SUBSTRING(LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + SD.ItemFlatDisc, 12, 2))),1, 12),
	BonusLEN=12,
	Bonus=SUBSTRING(LTRIM(RTRIM(STR(SD.BonusQty, 12, 2))), 1, 12), 
	ReturnsLEN=12,
	Returns=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))),1, 12),
	ExpiredLEN=12,
	Expired=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))),1, 12)
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	CustomerCategory CC,
	Item I,
	(SELECT DistCode = LEFT(LTRIM(RTRIM(Z.Remarks)), 6), ZA.AreaCode, Z.ManfCode
	FROM Zone Z, ZoneAreas ZA
	WHERE Z.ZoneCode = :ai_zonecode AND 
		Z.ZoneCode = ZA.ZoneCode) ZAR
WHERE
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate AND
	SL.POSTED = 'Y' AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.CustCode = C.CustCode AND
	C.AreaCode = ZAR.AreaCode AND
	C.CustCatCode = CC.CustCatCode AND
	SD.ICode = I.ICode AND
	I.ManfCode = ZAR.ManfCode
UNION ALL
SELECT 
	DSTBIDLEN=6,
	DSTBID= ZAR.DistCode + REPLICATE(' ', 6 - LEN(ZAR.DistCode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SRInvCode, 12))), 1, 12), 
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = SUBSTRING(LTRIM(RTRIM(STR(SL.CustCode, 10))), 1, 10), 
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	ExpDateLEN=10,
	ExpDate=Convert(varchar(10), SD.Expiry, 103),
	ActualLEN=12,
	Actual=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))), 1, 12),
	RateLEN=12,
	Rate=SUBSTRING(LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))), 1, 12), 
	DISCOUNTLEN=12,
	DISCOUNT=SUBSTRING(LTRIM(RTRIM(STR(- Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),1, 12),
	BonusLEN=12,
	Bonus=SUBSTRING(LTRIM(RTRIM(STR(SD.BonusQty, 12, 2))), 1, 12), 
	ReturnsLEN=12,
	Returns=SUBSTRING(LTRIM(RTRIM(STR(SD.LooseQty, 12, 2))),1, 12),
	ExpiredLEN=12,
	Expired=SUBSTRING(LTRIM(RTRIM(STR(0, 12, 2))),1, 12)
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	CustomerCategory CC,
	Item I,
	(SELECT DistCode = LEFT(LTRIM(RTRIM(Z.Remarks)), 6), ZA.AreaCode, Z.ManfCode
	FROM Zone Z, ZoneAreas ZA
	WHERE Z.ZoneCode = :ai_zonecode AND 
		Z.ZoneCode = ZA.ZoneCode) ZAR
WHERE
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate AND
	SL.POSTED = 'Y' AND
	SL.SRInvCode = SD.SRInvCode AND
	SL.CustCode = C.CustCode AND
	C.AreaCode = ZAR.AreaCode AND 
	C.CustCatCode = CC.CustCatCode AND
	SD.ICode = I.ICode AND
	I.ManfCode = ZAR.ManfCode
"
  arguments=(("ai_zonecode", number), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
