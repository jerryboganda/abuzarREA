detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=custcodelen dbname="CustCodeLen"  )
column=(type=char(10) updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=long updatewhereclause=yes name=prodcodelen dbname="ProdCodeLen"  )
column=(type=char(10) updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=long updatewhereclause=yes name=qtylen dbname="QtyLen"  )
column=(type=char(10) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=long updatewhereclause=yes name=tplen dbname="TPLen"  )
column=(type=char(12) updatewhereclause=yes name=tp dbname="Tp"  )
column=(type=long updatewhereclause=yes name=valuelen dbname="ValueLen"  )
column=(type=char(15) updatewhereclause=yes name=value dbname="Value"  )
column=(type=long updatewhereclause=yes name=datelen dbname="DATELEN"  )
column=(type=char(10) updatewhereclause=yes name=date dbname="DATE"  )
 retrieve="SELECT
	CustCodeLen=10,
	CustCode=STR(S.CustCode, 10), 
	ProdCodeLen=10, 
	ProdCode=STR(SD.ICode, 10),
	QtyLen=10,
	Qty=STR(CAST(Sum(SD.LooseQty) / (CASE WHEN :ai_loosepack = 0 THEN 1 ELSE CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END END) AS INT), 10),
	TPLen=12, 
	Tp=STR(CASE WHEN :ai_loosepack = 0 THEN ROUND((I.SalePrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END), 2) ELSE I.SalePrice END, 12, 2),
	ValueLen=15,
	Value=STR(CAST(Sum(SD.LooseQty) / (CASE WHEN :ai_loosepack = 0 THEN 1 ELSE CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END END) AS INT) * (CASE WHEN :ai_loosepack = 0 THEN ROUND((I.SalePrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END), 2) ELSE I.SalePrice END), 15, 2),
	DATELEN=10,
	DATE=Convert(varchar(10), S.DATE, 103)
FROM
	SRLedger S, SRDetail SD, Item I
WHERE
	S.Date >= :ar_startdate AND S.Date <= :ar_enddate AND
	SD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode) AND
	S.SRInvCode = SD.SRInvCode AND SD.LooseQty > 0 AND
	:ai_scope=1
GROUP BY
	S.CustCode, 
	SD.ICode,
	S.Date,
	I.SalePrice,
	I.PackUnits
UNION ALL
SELECT
	CustCodeLen=10,
	CustCode=STR(S.CustCode, 10), 
	ProdCodeLen=10, 
	ProdCode=STR(SD.ICode, 10),
	QtyLen=10,
	Qty=STR(CAST(Sum(SD.LooseQty) / (CASE WHEN :ai_loosepack = 0 THEN 1 ELSE CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END END) AS INT), 10),
	TPLen=12, 
	Tp=STR(CASE WHEN :ai_loosepack = 0 THEN ROUND((I.SalePrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END), 2) ELSE I.SalePrice END, 12, 2),
	ValueLen=15,
	Value=STR(CAST(Sum(SD.LooseQty) / (CASE WHEN :ai_loosepack = 0 THEN 1 ELSE CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END END) AS INT) * (CASE WHEN :ai_loosepack = 0 THEN ROUND((I.SalePrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END), 2) ELSE I.SalePrice END), 15, 2),
	DATELEN=10,
	DATE=Convert(varchar(10), S.DATE, 103)
FROM
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	CRS_SRLedger S, CRS_SRDetail SD, Item I
WHERE
	CL.ClientID = CI.ClientID AND CI.ClientInstanceID = S.ClientInstanceID AND
	S.ClientInstanceID = SD.ClientInstanceID AND
	S.Date BETWEEN :ar_startdate AND :ar_enddate AND
	SD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode) AND
	S.SRInvCode = SD.SRInvCode AND SD.LooseQty > 0 AND
	:ai_scope=2
GROUP BY
	S.CustCode, 
	SD.ICode,
	S.Date,
	I.SalePrice,
	I.PackUnits
ORDER BY
	CustCode,
	ProdCode
"
  arguments=(("ai_manfcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ai_loosepack", number), ("ai_scope", number))
)
