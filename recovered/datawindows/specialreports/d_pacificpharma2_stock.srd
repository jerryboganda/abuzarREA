table(column=(type=char(75) updatewhereclause=yes name=productcode dbname="ProductCode"  )
column=(type=char(100) updatewhereclause=yes name=batchcode dbname="BatchCode"  )
column=(type=decimal(4) updatewhereclause=yes name=availableunits dbname="AvailableUnits"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="Price"  )
column=(type=char(10) updatewhereclause=yes name=closingdate dbname="ClosingDate"  )
column=(type=char(11) updatewhereclause=yes name=distcode dbname="DistCode"  )
 retrieve="SELECT 
	ProductCode=Item.CustomICode, 
	BatchCode=GodownDetail.Batch, 
	AvailableUnits=GodownDetail.CurrQty, 
	Price=Item.SalePrice, 
	ClosingDate = CONVERT(VARCHAR(10), :ad_enddate, 120),
	DistCode=LTRIM(RTRIM(:as_distcode + SPACE(10))) 
FROM GodownDetail, Item
WHERE Item.ManfCode = :ai_manfcode AND Item.ICode = GodownDetail.ICode
ORDER BY ProductCode"
  arguments=(("as_distcode", string), ("ai_manfcode", number), ("ad_enddate", datetime))
)
