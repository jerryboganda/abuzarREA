detail(height=83 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=documentnolen dbname="DOCUMENTNOLEN"  )
column=(type=char(12) updatewhereclause=yes name=documentno dbname="DOCUMENTNO"  )
column=(type=long updatewhereclause=yes name=docdatelen dbname="DOCDATELEN"  )
column=(type=char(10) updatewhereclause=yes name=docdate dbname="DOCDATE"  )
column=(type=long updatewhereclause=yes name=custidlen dbname="CUSTIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=custid dbname="CUSTID"  )
column=(type=long updatewhereclause=yes name=ctlen dbname="CTLEN"  )
column=(type=char(2) updatewhereclause=yes name=ct dbname="CT"  )
column=(type=long updatewhereclause=yes name=townidlen dbname="TownIDLEN"  )
column=(type=char(16) updatewhereclause=yes name=townid dbname="TownID"  )
column=(type=long updatewhereclause=yes name=prdidlen dbname="PRDIDLEN"  )
column=(type=char(9) updatewhereclause=yes name=prdid dbname="PRDID"  )
column=(type=long updatewhereclause=yes name=prdlen dbname="PRDLEN"  )
column=(type=char(50) updatewhereclause=yes name=prd dbname="PRD"  )
column=(type=long updatewhereclause=yes name=batchnolen dbname="BatchNoLEN"  )
column=(type=char(10) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=long updatewhereclause=yes name=pricelen dbname="PRICELEN"  )
column=(type=char(12) updatewhereclause=yes name=price dbname="PRICE"  )
column=(type=long updatewhereclause=yes name=quantitylen dbname="QuantityLEN"  )
column=(type=char(12) updatewhereclause=yes name=quantity dbname="Quantity"  )
column=(type=long updatewhereclause=yes name=bonuslen dbname="BonusLEN"  )
column=(type=char(12) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=long updatewhereclause=yes name=discountamntlen dbname="DISCOUNTAMNTLEN"  )
column=(type=char(12) updatewhereclause=yes name=discountamnt dbname="DISCOUNTAMNT"  )
column=(type=long updatewhereclause=yes name=netamtlen dbname="NetAmtLEN"  )
column=(type=char(12) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=long updatewhereclause=yes name=reasonlen dbname="ReasonLen"  )
column=(type=char(1) updatewhereclause=yes name=reason dbname="Reason"  )
 retrieve="SELECT 
	DSTBIDLEN=6, 
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SaleInvCode, 12))), 1, 12), 
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = ISNULL((SELECT SUBSTRING(LTRIM(RTRIM(A.AliasName)), 1, 10) +  REPLICATE(' ', 10 - LEN(SUBSTRING(LTRIM(RTRIM(A.AliasName)), 1, 10))) FROM Accounts A WHERE A.AccCode = SL.CustCode), SPACE(10)),
	CTLEN=2,
	CT=CASE 
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN '01'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN '02'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN '03'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN '04'
		ELSE '02' END,
	TownIDLEN=16,
	TownID=SUBSTRING(LTRIM(RTRIM(STR(C.AREACODE, 16))), 1, 16), 
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	PRICELEN=12,
	PRICE=SUBSTRING(LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))), 1, 12), 
	QuantityLEN=12,
	Quantity=SUBSTRING(LTRIM(RTRIM(STR(SD.LooseQty, 12, 2))), 1, 12),
	BonusLEN=12,
	Bonus=SUBSTRING(LTRIM(RTRIM(STR(SD.BonusQty, 12, 2))), 1, 12), 
	DISCOUNTAMNTLEN=12,
	DISCOUNTAMNT=SUBSTRING(LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + SD.ItemFlatDisc, 12, 2))),1, 12),
	NetAmtLEN=12,
	NetAmt=SUBSTRING(LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2))), 1, 12),
	ReasonLen=1,
	Reason = 'S'
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	CustomerCategory CC,
	Item I
WHERE
	:ai_scope=1 AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6,
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SRInvCode, 12))), 1, 12), 
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = ISNULL((SELECT SUBSTRING(LTRIM(RTRIM(A.AliasName)), 1, 10) +  REPLICATE(' ', 10 - LEN(SUBSTRING(LTRIM(RTRIM(A.AliasName)), 1, 10))) FROM Accounts A WHERE A.AccCode = SL.CustCode), SPACE(10)),
	CTLEN=2,
	CT=CASE 
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN '01'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN '02'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN '03'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN '04'
		ELSE '02' END,
	TownIDLEN=16,
	TownID=SUBSTRING(LTRIM(RTRIM(STR(C.AREACODE, 16))), 1, 16), 
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	PRICELEN=12,
	PRICE=SUBSTRING(LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))), 1, 12), 
	QuantityLEN=12,
	Quantity=SUBSTRING(LTRIM(RTRIM(STR(- SD.LooseQty, 12, 2))), 1, 12),
	BonusLEN=12,
	Bonus=SUBSTRING(LTRIM(RTRIM(STR(- SD.BonusQty, 12, 2))), 1, 12), 
	DISCOUNTAMNTLEN=12,
	DISCOUNTAMNT=SUBSTRING(LTRIM(RTRIM(STR(- (Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2)), 12, 2))),1, 12),
	NetAmtLEN=12,
	NetAmt=SUBSTRING(LTRIM(RTRIM(STR(- (Round((SD.LooseQty * SD.SalePrice * (1 - SD.DiscPerc * 0.01)), 2)), 12, 2))), 1, 12),
	ReasonLen=1,
	Reason = 'R'
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	CustomerCategory CC,
	Item I
WHERE
	:ai_scope=1 AND
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6, 
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SaleInvCode, 12))), 1, 12), 
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = ISNULL((SELECT SUBSTRING(LTRIM(RTRIM(A.AliasName)), 1, 10) +  REPLICATE(' ', 10 - LEN(SUBSTRING(LTRIM(RTRIM(A.AliasName)), 1, 10))) FROM Accounts A WHERE A.AccCode = SL.CustCode), SPACE(10)),
	CTLEN=2,
	CT=CASE 
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN '01'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN '02'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN '03'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN '04'
		ELSE '02' END,
	TownIDLEN=16,
	TownID=SUBSTRING(LTRIM(RTRIM(STR(C.AREACODE, 16))), 1, 16), 
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	PRICELEN=12,
	PRICE=SUBSTRING(LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))), 1, 12), 
	QuantityLEN=12,
	Quantity=SUBSTRING(LTRIM(RTRIM(STR(SD.LooseQty, 12, 2))), 1, 12),
	BonusLEN=12,
	Bonus=SUBSTRING(LTRIM(RTRIM(STR(SD.BonusQty, 12, 2))), 1, 12), 
	DISCOUNTAMNTLEN=12,
	DISCOUNTAMNT=SUBSTRING(LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + SD.ItemFlatDisc, 12, 2))),1, 12),
	NetAmtLEN=12,
	NetAmt=SUBSTRING(LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2))), 1, 12),
	ReasonLen=1,
	Reason = 'S'
FROM
	CRS_SaleLedger SL,
	CRS_SaleDetail SD,
	Customer C,
	CustomerCategory CC,
	Item I
WHERE
	:ai_scope=2 AND
	SL.ClientInstanceID = SD.ClientInstanceID AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6,
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SRInvCode, 12))), 1, 12), 
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = ISNULL((SELECT SUBSTRING(LTRIM(RTRIM(A.AliasName)), 1, 10) +  REPLICATE(' ', 10 - LEN(SUBSTRING(LTRIM(RTRIM(A.AliasName)), 1, 10))) FROM Accounts A WHERE A.AccCode = SL.CustCode), SPACE(10)),
	CTLEN=2,
	CT=CASE 
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN '01'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN '02'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN '03'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN '04'
		ELSE '02' END,
	TownIDLEN=16,
	TownID=SUBSTRING(LTRIM(RTRIM(STR(C.AREACODE, 16))), 1, 16), 
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	PRICELEN=12,
	PRICE=SUBSTRING(LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))), 1, 12), 
	QuantityLEN=12,
	Quantity=SUBSTRING(LTRIM(RTRIM(STR(- SD.LooseQty, 12, 2))), 1, 12),
	BonusLEN=12,
	Bonus=SUBSTRING(LTRIM(RTRIM(STR(- SD.BonusQty, 12, 2))), 1, 12), 
	DISCOUNTAMNTLEN=12,
	DISCOUNTAMNT=SUBSTRING(LTRIM(RTRIM(STR(- (Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2)), 12, 2))),1, 12),
	NetAmtLEN=12,
	NetAmt=SUBSTRING(LTRIM(RTRIM(STR(- (Round((SD.LooseQty * SD.SalePrice * (1 - SD.DiscPerc * 0.01)), 2)), 12, 2))), 1, 12),
	ReasonLen=1,
	Reason = 'R'
FROM
	CRS_SRLedger SL,
	CRS_SRDetail SD,
	Customer C,
	CustomerCategory CC,
	Item I
WHERE
	:ai_scope=2 AND
	SL.ClientInstanceID = SD.ClientInstanceID AND
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:manfcode) AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
"
  arguments=(("as_dstcode", string), ("manfcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ai_scope", number))
 sort="prdid A"
)
