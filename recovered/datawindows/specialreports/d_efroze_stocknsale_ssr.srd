release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=64 color="536870912" )
summary(height=68 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=productcode dbname="productcode"  )
column=(type=char(60) updatewhereclause=yes name=productname dbname="productname"  )
column=(type=char(50) updatewhereclause=yes name=packsize dbname="PackSize"  )
column=(type=decimal(4) updatewhereclause=yes name=todaysaleunits dbname="TodaySaleUnits"  )
column=(type=decimal(9) updatewhereclause=yes name=todaysalevaluers dbname="TodaySaleValueRs"  )
column=(type=decimal(4) updatewhereclause=yes name=closingquantityunits dbname="ClosingQuantityUnits"  )
 retrieve="SELECT 
	productcode = T.productcode,
	productname = T.productname,
	PackSize = T.PackSize,
	TodaySaleUnits = SUM(T.TodaySaleUnits), 
	TodaySaleValueRs=SUM(T.TodaySaleValueRs), 
	ClosingQuantityUnits=SUM(T.ClosingQuantityUnits)
FROM
	(SELECT 
		productcode = I.ICODE,
		productname = I.Name,
		PackSize = I.PackingDesc,
		TodaySaleUnits = SUM(SD.LooseQty), 
		TodaySaleValueRs=SUM((SD.SalePrice - SD.ItemFlatDisc) * SD.LooseQty * (1 - SD.DiscPerc * 0.01)), 
		ClosingQuantityUnits=0.0000
	FROM
		SaleLedger SL, 
		SaleDetail SD,
		Item I,
		Manufacturer M
	WHERE
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND 
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = M.ManfCode AND
		M.ManfCode = :ai_manfcode
	GROUP BY
		I.ICODE,
		I.Name,
		I.PackingDesc
	UNION ALL
	SELECT 
		productcode = I.ICODE,
		productname = I.Name,
		PackSize = I.PackingDesc,
		TodaySaleUnits = -SUM(SD.LooseQty), 
		TodaySaleValueRs= - SUM(SD.SRPrice * SD.LooseQty * (1 - SD.DiscPerc * 0.01)), 
		ClosingQuantityUnits=0.0000
	FROM
		SRLedger SL, 
		SRDetail SD,
		Item I,
		Manufacturer M
	WHERE
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND 
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = M.ManfCode AND
		M.ManfCode = :ai_manfcode
	GROUP BY
		I.ICODE,
		I.Name,
		I.PackingDesc
	UNION ALL
	SELECT 
		productcode = I.ICODE,
		productname = I.Name,
		PackSize = I.PackingDesc,
		TodaySaleUnits = 0.0000, 
		TodaySaleValueRs=0.0000, 
		ClosingQuantityUnits=0.0000
	FROM
		Item I,
		Manufacturer M
	WHERE
		I.ManfCode = M.ManfCode AND
		M.ManfCode = :ai_manfcode
	UNION ALL
	SELECT 
		productcode = I.ICODE,
		productname = I.Name,
		PackSize = I.PackingDesc,
		TodaySaleUnits = 0.0000, 
		TodaySaleValueRs=0.0000, 
		ClosingQuantityUnits=SUM(A.Qty)
	FROM	
		(SELECT 
			pd.icode, 
			qty = sum(isnull(case pl.purcatcode 
					when 1 THEN (pd.packqty + pd.bonusqty) * pd.packunits
					when 2 THEN (pd.packqty + pd.bonusqty) * pd.packunits
					else pd.looseqty + pd.bonusqty end, 0))
		FROM purledger pl, purdetail pd, item i
		WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
			pl.date <= :adt_enddate and
			pd.icode = i.icode and i.manfcode = :ai_manfcode
		Group By pd.icode
		UNION ALL
		select	pd.icode,
			qty  = - sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits)
		FROM prledger pl, prdetail pd, item i
		WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
			pl.date <= :adt_enddate and
			pd.icode = i.icode and i.manfcode = :ai_manfcode
		Group By pd.icode
		UNION ALL
		select	sd.icode,
			qty  = -sum(sd.looseqty + sd.bonusqty)
		FROM saleledger sl, saledetail sd, item i
		WHERE /*sl.posted = 'Y' AND*/ sl.saleinvcode = sd.saleinvcode AND
			sl.date <= :adt_enddate AND sd.Due IS NULL and
			sd.icode = i.icode and i.manfcode = :ai_manfcode
		Group By sd.icode
		UNION ALL
		select	sd.icode,
			qty  = sum(sd.looseqty + sd.bonusqty)
		FROM srledger sl, srdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
			sl.date <= :adt_enddate and
			sd.icode = i.icode and i.manfcode = :ai_manfcode
		Group By sd.icode
		UNION ALL
		select	sd.icode,
			qty  = -sum(sd.qty)
		FROM issueheader sl, issuedetail sd, item i
		WHERE /*sl.posted = 'Y' AND*/ sl.issueinvcode = sd.issueinvcode AND
			sl.date <= :adt_enddate and
			sd.icode = i.icode and i.manfcode = :ai_manfcode
		Group By sd.icode
		UNION ALL
		select	sd.icode,
			qty  = sum(sd.qty)
		FROM receiptheader sl, receiptdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
			sl.date <= :adt_enddate and
			sd.icode = i.icode and i.manfcode = :ai_manfcode
		Group By sd.icode
		UNION ALL
		select	sd.icode,
			qty = sum(sd.looseqty)
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
			sl.date <= :adt_enddate and
			sd.icode = i.icode and i.manfcode = :ai_manfcode
		Group By sd.icode
		UNION ALL
		select	sd.icode,
			qty = -sum(sd.looseqty)
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
			sl.date <= :adt_enddate and
			sd.icode = i.icode and i.manfcode = :ai_manfcode
		Group By sd.icode
		UNION ALL
		select	d.icode,
			qty = -sum(d.duesatisfyqty)
		FROM duesatisfyheader h, duesatisfydetail d, item i
		WHERE h.duesatisfycode=d.duesatisfycode AND
			h.duesatisfydate <= :adt_enddate and
			d.icode = i.icode and i.manfcode = :ai_manfcode
		Group By d.icode) A, Item I
	WHERE A.ICode = I.ICode
	GROUP BY
		I.ICODE,
		I.Name,
		I.PackingDesc) T
GROUP BY
	T.productcode,
	T.productname,
	T.PackSize
ORDER BY
	ProductName
"
  arguments=(("ai_manfcode", number), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
