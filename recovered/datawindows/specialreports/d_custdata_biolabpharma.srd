header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(101) updatewhereclause=yes name=distributorid dbname="DistributorID"  )
column=(type=char(12) updatewhereclause=yes name=custid dbname="CustID"  )
column=(type=char(60) updatewhereclause=yes name=fullname dbname="FullName"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="ADDRESS"  )
column=(type=char(6) updatewhereclause=yes name=brickid dbname="BrickID"  )
column=(type=char(60) updatewhereclause=yes name=brick dbname="Brick"  )
column=(type=char(30) updatewhereclause=yes name=custtype dbname="CustType"  )
column=(type=char(6) updatewhereclause=yes name=townid dbname="TownID"  )
column=(type=char(60) updatewhereclause=yes name=townname dbname="TownName"  )
 retrieve="SELECT
	DistributorID=LTRIM(RTRIM(:as_distcode+SPACE(100))),
	CustID = LTRIM(RTRIM(A.AliasName)),
	FullName = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))),
	ADDRESS = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))),
	BrickID=LTRIM(RTRIM(STR(SAR.SubAreaCode, 6))),
	Brick = LTRIM(RTRIM(SUBSTRING(SAR.Name, 1, 60))),
	CustType=LTRIM(RTRIM(CT.NAME)),
	TownID=LTRIM(RTRIM(STR(C.AreaCode, 6))),
	TownName=(SELECT Area.Name FROM Area WHERE Area.AreaCode = C.AreaCode)
FROM Customer C, Accounts A, SubArea SAR, CUSTOMERCATEGORY CT
WHERE C.CustCode = A.AccCode AND C.SubAreaCode = SAR.SubAreaCode AND C.CUSTCATCODE = CT.CUSTCATCODE
"
  arguments=(("as_distcode", string))
)
