column=(type=char(6) updatewhereclause=yes name=brickcode dbname="BrickCode"  )
column=(type=long updatewhereclause=yes name=bricknamelen dbname="BrickNameLEN"  )
column=(type=char(8000) updatewhereclause=yes name=brickname dbname="BrickName"  )
column=(type=long updatewhereclause=yes name=custtypelen dbname="CustTypeLEN"  )
column=(type=char(8000) updatewhereclause=yes name=custtype dbname="CustType"  )
column=(type=long updatewhereclause=yes name=bpcodelen dbname="BPCodeLEN"  )
column=(type=char(8000) updatewhereclause=yes name=bpcode dbname="BPCode"  )
 retrieve="SELECT
	CodeLEN=12,
	Code = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),
	NameLEN=60,
	Name = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))))),
	ADDRESSLEN=60,
	ADDRESS = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))))),
	ADDRESS2LEN=60,
	ADDRESS2 = LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 60))))),
	PhoneLen=100,
	Phone = LTRIM(RTRIM(SUBSTRING(C.Phone, 1, 100))) + REPLICATE(' ', 100 - LEN(LTRIM(RTRIM(SUBSTRING(C.Phone, 1, 100))))),
	BrickCodeLEN=6,
	BrickCode=STR(SAR.SubAreaCode, 6),
	BrickNameLEN=60,
	BrickName = LTRIM(RTRIM(SUBSTRING(SAR.NAME, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(SAR.NAME, 1, 60))))),
	CustTypeLEN=30,
	CustType=LTRIM(RTRIM(CT.NAME)) + SPACE(50 - LEN(LTRIM(RTRIM(CT.NAME)))),
	BPCodeLEN=20,
	BPCode=:as_distcode + REPLICATE(' ', 20 - LEN(:as_distcode))
FROM Customer C, Accounts A, SubArea SAR, CUSTOMERCATEGORY CT
WHERE C.CustCode = A.AccCode AND C.SubAreaCode = SAR.SubAreaCode AND C.CUSTCATCODE = CT.CUSTCATCODE
"
  arguments=(("as_distcode", string))
)
