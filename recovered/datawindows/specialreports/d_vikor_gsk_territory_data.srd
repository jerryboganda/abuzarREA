column=(type=char(1) updatewhereclause=yes name=medicalrepcode20 dbname="MedicalRepCode20"  )
 retrieve="SELECT 
	DISTINCT
	DSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	PrincipalCode=LTRIM(RTRIM(STR(Z.ManfCode, 6))), 
	RegionCode=LTRIM(RTRIM(STR(Z.ZoneCode, 6))), 
	TerritoryCode=LTRIM(RTRIM(STR(ZA.AreaCode, 6))), 
	Name=AR.Name,
	MedicalRepCode1=LTRIM(RTRIM(STR(S.SalesManCode, 6))),
	MedicalRepCode2='-',
	MedicalRepCode3='-',
	MedicalRepCode4='-',
	MedicalRepCode5='-',
	MedicalRepCode6='-',
	MedicalRepCode7='-',
	MedicalRepCode8='-',
	MedicalRepCode9='-',
	MedicalRepCode10='-',
	MedicalRepCode11='-',
	MedicalRepCode12='-',
	MedicalRepCode13='-',
	MedicalRepCode14='-',
	MedicalRepCode15='-',
	MedicalRepCode16='-',
	MedicalRepCode17='-',
	MedicalRepCode18='-',
	MedicalRepCode19='-',
	MedicalRepCode20='-'
FROM
	Zone Z, ZoneAreas ZA, Customer C, SalesMan S, Area AR
WHERE 
	Z.ManfCode IN (:ai_manfcode) AND
	Z.ZoneCode = ZA.ZoneCode AND
	ZA.AreaCode = AR.AreaCode AND
	AR.AreaCode = C.AreaCode AND
	C.SalesManCode = S.SalesManCode"
  arguments=(("as_distcode", string), ("ai_manfcode", numberlist))
)
