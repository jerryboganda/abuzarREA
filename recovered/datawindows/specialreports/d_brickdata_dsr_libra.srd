table(column=(type=long updatewhereclause=yes name=brickcodelen dbname="BrickCodeLEN"  )
column=(type=char(6) updatewhereclause=yes name=brickcode dbname="BrickCode"  )
column=(type=long updatewhereclause=yes name=bricknamelen dbname="BrickNameLEN"  )
column=(type=char(8000) updatewhereclause=yes name=brickname dbname="BrickName"  )
column=(type=long updatewhereclause=yes name=seccodelen dbname="SecCodeLEN"  )
column=(type=char(6) updatewhereclause=yes name=seccode dbname="SecCode"  )
column=(type=long updatewhereclause=yes name=secnamelen dbname="SecNameLen"  )
column=(type=char(8000) updatewhereclause=yes name=secname dbname="SecName"  )
column=(type=long updatewhereclause=yes name=bpcodelen dbname="BPCodeLEN"  )
column=(type=char(8000) updatewhereclause=yes name=bpcode dbname="BPCode"  )
 retrieve="SELECT
	BrickCodeLEN=6,
	BrickCode=STR(SAR.SubAreaCode, 6),
	BrickNameLEN=60,
	BrickName = LTRIM(RTRIM(SUBSTRING(SAR.NAME, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(SAR.NAME, 1, 60))))),
	SecCodeLEN=6,
	SecCode=STR(AR.AreaCode, 6),
	SecNameLen=60,
	SecName=LTRIM(RTRIM(AR.NAME)) + SPACE(60 - LEN(LTRIM(RTRIM(AR.NAME)))),
	BPCodeLEN=20,
	BPCode=:as_distcode + REPLICATE(' ', 20 - LEN(:as_distcode))
FROM SubArea SAR, Area AR
WHERE SAR.AreaCode = AR.AreaCode
"
  arguments=(("as_distcode", string))
)
