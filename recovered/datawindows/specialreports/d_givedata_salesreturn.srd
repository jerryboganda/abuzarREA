release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1552 color="536870912" )
summary(height=187 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=inv_no dbname="INV_NO"  )
column=(type=datetime updatewhereclause=yes name=inv_date dbname="INV_DATE"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CUSTCODE"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="CUSTNAME"  )
column=(type=char(75) updatewhereclause=yes name=prod_code dbname="PROD_CODE"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ITEMNAME"  )
column=(type=char(50) updatewhereclause=yes name=pack_size dbname="PACK_SIZE"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="SRdetail.BATCH"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="SRdetail.EXPIRY"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="SRdetail.LOOSEQTY"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="SRdetail.BONUSQTY"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="SRdetail.DISCPERC"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SALEPRICE"  )
 retrieve="SELECT 
	INV_NO=S.SRINVCODE, 
	INV_DATE=S.DATE, 
	CUSTCODE=A.ACCCODE,
	CUSTNAME=A.NAME, 
	PROD_CODE=I.CUSTOMICODE, 
	ITEMNAME=I.NAME, 
	PACK_SIZE=I.PACKINGDESC, 
	SL.BATCH, 
	SL.EXPIRY,
	SL.LOOSEQTY, 
	SL.BONUSQTY, 
	SL.DISCPERC, 
	SALEPRICE=SL.SRPRICE 
FROM 
	SRLEDGER S, 
	SRDETAIL SL, 
	ITEM I, 
	ACCOUNTS A
WHERE 
	S.SRINVCODE = SL.SRINVCODE AND 
	S.CUSTCODE = A.ACCCODE AND 
	SL.ICODE = I.ICODE AND
	I.MANFCODE = :ai_manfcode AND 
	S.DATE BETWEEN :ad_StartDATE AND :ad_EndDATE
ORDER BY 
	S.DATE,
	S.SRINVCODE,
	I.NAME,
	SL.BATCH, 
	SL.EXPIRY"
  arguments=(("ai_manfcode", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="inv_date A, inv_no A, itemname A, prod_code A, batch A, expiry A"
)
