table(column=(type=char(200) updatewhereclause=yes name=region dbname="Region"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(100) updatewhereclause=yes name=town dbname="Town"  )
column=(type=char(101) updatewhereclause=yes name=distributorcode dbname="DistributorCode"  )
column=(type=char(101) updatewhereclause=yes name=shiptocode dbname="ShipToCode"  )
column=(type=char(200) updatewhereclause=yes name=distributorname dbname="DistributorName"  )
column=(type=char(4) updatewhereclause=yes name=currentyear dbname="CurrentYear"  )
column=(type=char(2) updatewhereclause=yes name=currentmonth dbname="CurrentMonth"  )
column=(type=char(12) updatewhereclause=yes name=customercode dbname="CustomerCode"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(120) updatewhereclause=yes name=outletaddress dbname="OutLetAddress"  )
column=(type=char(6) updatewhereclause=yes name=gtm dbname="GTM"  )
column=(type=char(30) updatewhereclause=yes name=distributorchanneldescription dbname="DistributorChannelDescription"  )
column=(type=char(30) updatewhereclause=yes name=outlettypedescription dbname="OutLetTypeDescription"  )
column=(type=char(60) updatewhereclause=yes name=tse_tsm dbname="TSE_TSM"  )
column=(type=char(10) updatewhereclause=yes name=dsrcode dbname="DSRCode"  )
column=(type=char(60) updatewhereclause=yes name=dsrname dbname="DSRName"  )
column=(type=long updatewhereclause=yes name=brickid dbname="BrickId"  )
column=(type=char(60) updatewhereclause=yes name=brickname dbname="BrickName"  )
column=(type=char(60) updatewhereclause=yes name=brand dbname="Brand"  )
column=(type=char(75) updatewhereclause=yes name=articlenumber dbname="ArticleNumber"  )
column=(type=char(60) updatewhereclause=yes name=skuname dbname="SKUName"  )
column=(type=char(10) updatewhereclause=yes name=invoiceno dbname="InvoiceNo"  )
column=(type=char(10) updatewhereclause=yes name=invoicedate dbname="InvoiceDate"  )
column=(type=char(12) updatewhereclause=yes name=quantity dbname="Quantity"  )
column=(type=char(12) updatewhereclause=yes name=dbprice dbname="DBPrice"  )
column=(type=char(12) updatewhereclause=yes name=tp dbname="TP"  )
column=(type=char(12) updatewhereclause=yes name=dbvalue dbname="DBValue"  )
column=(type=char(12) updatewhereclause=yes name=tpvalue dbname="TPValue"  )
column=(type=char(12) updatewhereclause=yes name=todiscperc dbname="ToDiscPerc"  )
column=(type=char(12) updatewhereclause=yes name=todiscdbvalue dbname="ToDiscDBValue"  )
column=(type=char(12) updatewhereclause=yes name=todisctpvalue dbname="TODiscTPValue"  )
 retrieve="SELECT 
	Region = UPPER(R.RemarKs),
	Area = R.Name,
	Town = B.Description,
	DistributorCode = LTRIM(RTRIM(:as_distcode + SPACE(100))),
	ShipToCode = LTRIM(RTRIM(:as_distcode + SPACE(100))),
	DistributorName = dbo.Fn_GetPreference('AppName'),
	CurrentYear=STR(Year(:adt_startdate), 4),
	CurrentMonth=STR(Month(:adt_startdate), 2),
	CustomerCode= A.AliasName,
	CustomerName = A.Name,
	OutLetAddress = CASE WHEN C.Address1 IS NULL THEN '' ELSE C.Address1 END + 
		CASE WHEN C.Address2 IS NULL THEN ' ' ELSE C.Address2 END,
	GTM = 'Shared',
	DistributorChannelDescription = CC.Name,
	OutLetTypeDescription = CC.Name,
	TSE_TSM = R.Manager,
	DSRCode=LTRIM(RTRIM(STR(SL.SManCode))),
	DSRName=(SELECT S.Name FROM SalesMan S WHERE S.SalesManCode=SL.SManCode),
	BrickId = SA.SubAreaCode,
	BrickName = SA.Name,
	Brand = B.Name,
	ArticleNumber=LTRIM(RTRIM(LTRIM(RTRIM(I.CustomICode)))),
	SKUName = I.Name,
	InvoiceNo = LTRIM(RTRIM(STR(SL.SaleInvCode, 10))),
	InvoiceDate=Convert(varchar(10), SL.DATE, 104),
	Quantity=LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	DBPrice=LTRIM(RTRIM(STR(I.PurPrice, 12, 2))),
	TP = LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))),
	DBValue=LTRIM(RTRIM(STR(I.PurPrice * SD.LooseQty, 12, 2))),
	TPValue= LTRIM(RTRIM(STR(SD.SalePrice * SD.LooseQty, 12, 2))),
	ToDiscPerc = LTRIM(RTRIM(STR(SD.DiscPerc, 12, 2))),
	ToDiscDBValue=LTRIM(RTRIM(STR(ROUND(I.PurPrice * SD.LooseQty * SD.DiscPerc * 0.01, 2), 12, 2))),
	TODiscTPValue=LTRIM(RTRIM(STR(ROUND(SD.SalePrice * SD.LooseQty * SD.DiscPerc * 0.01, 2), 12, 2)))
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Area AR,
	SubArea SA,
	Region R,
	Item I,
	ItemBrand B
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.IBrandCode = B.IBrandCode AND
	I.ManfCode = :ai_manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
 	C.AreaCode = AR.AreaCode AND
	C.SubAreaCode = SA.SubAreaCode AND
	SA.AreaCode = AR.AreaCode AND
	AR.RegionCode = R.RegionCode AND
	SL.DATE BETWEEN :adt_startdate AND :adt_enddate
UNION ALL
SELECT 
	Region = UPPER(R.RemarKs),
	Area = R.Name,
	Town = B.Description,
	DistributorCode = LTRIM(RTRIM(:as_distcode + SPACE(100))),
	ShipToCode = LTRIM(RTRIM(:as_distcode + SPACE(100))),
	DistributorName = dbo.Fn_GetPreference('AppName'),
	CurrentYear=STR(Year(:adt_startdate), 4),
	CurrentMonth=STR(Month(:adt_startdate), 2),
	CustomerCode= A.AliasName,
	CustomerName = A.Name,
	OutLetAddress = CASE WHEN C.Address1 IS NULL THEN '' ELSE C.Address1 END + 
		CASE WHEN C.Address2 IS NULL THEN ' ' ELSE C.Address2 END,
	GTM = 'Shared',
	DistributorChannelDescription = CC.Name,
	OutLetTypeDescription = CC.Name,
	TSE_TSM = R.Manager,
	DSRCode= LTRIM(RTRIM(STR(SL.SManCode))),
	DSRName=(SELECT S.Name FROM SalesMan S WHERE S.SalesManCode=SL.SManCode),
	BrickId = SA.SubAreaCode,
	BrickName = SA.Name,
	Brand = B.Name,
	ArticleNumber=LTRIM(RTRIM(LTRIM(RTRIM(I.CustomICode)))),
	SKUName = I.Name,
	InvoiceNo = LTRIM(RTRIM(STR(SL.SRInvCode, 10))),
	InvoiceDate=Convert(varchar(10), SL.DATE, 104),
	Quantity=LTRIM(RTRIM(STR( - SD.LooseQty, 12))),
	DBPrice=LTRIM(RTRIM(STR(I.PurPrice, 12, 2))),
	TP = LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))),
	DBValue=LTRIM(RTRIM(STR( - (I.PurPrice * SD.LooseQty), 12, 2))),
	TPValue= LTRIM(RTRIM(STR(- (SD.SRPrice * SD.LooseQty), 12, 2))),
	ToDiscPerc = LTRIM(RTRIM(STR(SD.DiscPerc, 12, 2))),
	ToDiscDBValue=LTRIM(RTRIM(STR(- 1 * ROUND(I.PurPrice * SD.LooseQty * SD.DiscPerc * 0.01, 2), 12, 2))),
	TODiscTPValue=LTRIM(RTRIM(STR(- 1 * ROUND(SD.SRPrice * SD.LooseQty * SD.DiscPerc * 0.01, 2), 12, 2)))
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Area AR,
	SubArea SA,
	Region R,
	Item I,
	ItemBrand B
WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.IBrandCode = B.IBrandCode AND
	I.ManfCode = :ai_manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
 	C.AreaCode = AR.AreaCode AND
	C.SubAreaCode = SA.SubAreaCode AND
	SA.AreaCode = AR.AreaCode AND
	AR.RegionCode = R.RegionCode AND
	SL.DATE BETWEEN :adt_startdate AND :adt_enddate
"
  arguments=(("ai_manfcode", number), ("as_distcode", string), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
