release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=char(8000) updatewhereclause=yes name=dscode dbname="DSCode"  )
column=(type=char(75) updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(6) updatewhereclause=yes name=principalcode dbname="PrincipalCode"  )
column=(type=char(50) updatewhereclause=yes name=packingsize dbname="PackingSize"  )
column=(type=char(15) updatewhereclause=yes name=tradeprice dbname="TradePrice"  )
column=(type=char(15) updatewhereclause=yes name=costprice dbname="CostPrice"  )
 retrieve="SELECT 
	DSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	ItemCode=LTRIM(RTRIM(I.CustomICode)),
	Name=LTRIM(RTRIM(I.Name)), 
	PrincipalCode=LTRIM(RTRIM(STR(I.ManfCode, 6))), 
	PackingSize=LTRIM(RTRIM(ISNULL(I.PackingDesc, '-'))),
	TradePrice=LTRIM(RTRIM(STR(ISNULL(I.SalePrice, 0), 15, 2))),
	CostPrice=LTRIM(RTRIM(STR(ISNULL(I.AvgPrice, 0), 15, 2)))
FROM
	Item I
WHERE
	I.ManfCode IN (:ai_manfcode)
ORDER BY
	I.ManfCode,
	I.Name"
  arguments=(("as_distcode", string), ("ai_manfcode", numberlist))
)
