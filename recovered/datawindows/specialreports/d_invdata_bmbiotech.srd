table(column=(type=char(20) updatewhereclause=yes name=invoice dbname="Invoice"  )
column=(type=char(10) updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(1) updatewhereclause=yes name=flag dbname="Flag"  )
column=(type=char(12) updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(6) updatewhereclause=yes name=brickcode dbname="BrickCode"  )
column=(type=char(20) updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=char(10) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=char(10) updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=char(5) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=char(12) updatewhereclause=yes name=units dbname="Units"  )
column=(type=char(12) updatewhereclause=yes name=tradeprice dbname="TradePrice"  )
column=(type=char(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=char(12) updatewhereclause=yes name=discountamount dbname="DiscountAmount"  )
column=(type=char(101) updatewhereclause=yes name=dscode dbname="DsCode"  )
column=(type=char(0) updatewhereclause=yes name=msmregionid dbname="MSMRegionID"  )
 retrieve="SELECT 
	Invoice = LTRIM(RTRIM(STR(SL.SaleInvCode, 20))),
	Date=Convert(varchar(10), SL.DATE, 103),
	Flag='S',
	CustCode  = LTRIM(RTRIM(A.AliasName)),
	BrickCode=LTRIM(RTRIM(STR(SA.SubAreaCode, 6))),
	ProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),
	Batch=SUBSTRING(SD.Batch, 1, 10),
	Expiry=Convert(varchar(10), SD.Expiry, 103),
	Bonus='FALSE',
	Units=LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	TradePrice = LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))),
	Discount=LTRIM(RTRIM(STR(SD.DiscPerc, 6, 2))),
	DiscountAmount=LTRIM(RTRIM(STR(
			Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + 
			(SD.LooseQty * SD.ItemFlatDisc), 12, 2))),
	DsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),
	MSMRegionID=''
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	SubArea SA,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	SD.LooseQty > 0 AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.SubAreaCode=SA.SubAreaCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	Invoice = LTRIM(RTRIM(STR(SL.SaleInvCode, 20))),
	Date=Convert(varchar(10), SL.DATE, 103),
	Flag='S',
	CustCode  = LTRIM(RTRIM(A.AliasName)),
	BrickCode=LTRIM(RTRIM(STR(SA.SubAreaCode, 6))),
	ProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),
	Batch=SUBSTRING(SD.Batch, 1, 10),
	Expiry=Convert(varchar(10), SD.Expiry, 103),
	Bonus= 'TRUE ',
	Units=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	TradePrice = LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))),
	Discount=LTRIM(RTRIM(STR(SD.DiscPerc, 6, 2))),
	DiscountAmount=LTRIM(RTRIM(STR(
			Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + 
			(SD.LooseQty * SD.ItemFlatDisc), 12, 2))),
	DsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),
	MSMRegionID=''
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	SubArea SA,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	SD.BonusQty > 0 AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.SubAreaCode=SA.SubAreaCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	Invoice = LTRIM(RTRIM(STR(SL.SRInvCode, 20))),
	Date=Convert(varchar(10), SL.DATE, 103),
	Flag='R',
	CustCode  = LTRIM(RTRIM(A.AliasName)),
	BrickCode=LTRIM(RTRIM(STR(SA.SubAreaCode, 6))),
	ProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),
	Batch=SUBSTRING(SD.Batch, 1, 10),
	Expiry=Convert(varchar(10), SD.Expiry, 103),
	Bonus='FALSE',
	Units=LTRIM(RTRIM(STR(-1 * (SD.LooseQty), 12))),
	TradePrice = LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))),
	Discount=LTRIM(RTRIM(STR(SD.DiscPerc, 6, 2))),
	DiscountAmount= LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	DsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),
	MSMRegionID=''
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	SubArea SA,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	SD.LooseQty > 0 AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.SubAreaCode=SA.SubAreaCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	Invoice = LTRIM(RTRIM(STR(SL.SRInvCode, 20))),
	Date=Convert(varchar(10), SL.DATE, 103),
	Flag='R',
	CustCode  = LTRIM(RTRIM(A.AliasName)),
	BrickCode=LTRIM(RTRIM(STR(SA.SubAreaCode, 6))),
	ProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),
	Batch=SUBSTRING(SD.Batch, 1, 10),
	Expiry=Convert(varchar(10), SD.Expiry, 103),
	Bonus='True',
	Units=LTRIM(RTRIM(STR(-1 * (SD.BonusQty), 12))),
	TradePrice = LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))),
	Discount=LTRIM(RTRIM(STR(SD.DiscPerc, 6, 2))),
	DiscountAmount= LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	DsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),
	MSMRegionID=''
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	SubArea SA,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	SD.BonusQty > 0 AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.SubAreaCode=SA.SubAreaCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	Invoice = LTRIM(RTRIM(STR(SL.PurInvCode, 20))),
	Date=Convert(varchar(10), SL.DATE, 103),
	Flag='P',
	CustCode  = '',
	BrickCode='',
	ProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),
	Batch=SUBSTRING(SD.Batch, 1, 10),
	Expiry=Convert(varchar(10), SD.Expiry, 103),
	Bonus=CASE WHEN SD.BonusQty >  0 THEN 'TRUE ' ELSE 'FALSE' END,
	Units=LTRIM(RTRIM(STR(SD.PackQty + SD.LooseQty + SD.BonusQty, 12))),
	TradePrice = LTRIM(RTRIM(STR(SD.PurPrice, 12, 2))),
	Discount=LTRIM(RTRIM(LTRIM(RTRIM(STR(SD.DiscPerc, 6, 2))))),
	DiscountAmount= LTRIM(RTRIM(STR(Round(((SD.PackQty + SD.LooseQty) * SD.PurPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	DsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),
	MSMRegionID=''
FROM
	PurLedger SL,
	PurDetail SD,
	Supplier C,
	Accounts A,
	Item I
WHERE
	SL.PurInvCode = SD.PurInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.SuppCode = C.SuppCode AND
	C.SuppCode = A.AccCode AND 
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	Invoice = LTRIM(RTRIM(STR(SL.PrInvCode, 20))),
	Date=Convert(varchar(10), SL.DATE, 103),
	Flag='O',
	CustCode  = '',
	BrickCode='',
	ProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),
	Batch=SUBSTRING(SD.Batch, 1, 10),
	Expiry=Convert(varchar(10), SD.Expiry, 103),
	Bonus=CASE WHEN SD.BonusQty >  0 THEN 'TRUE ' ELSE 'FALSE' END,
	Units=LTRIM(RTRIM(STR(SD.PackQty + SD.LooseQty + SD.BonusQty, 12))),
	TradePrice = LTRIM(RTRIM(STR(SD.PrPrice, 12, 2))),
	Discount=LTRIM(RTRIM(STR(SD.DiscPerc, 6, 2))),
	DiscountAmount= LTRIM(RTRIM(STR(Round(((SD.PackQty + SD.LooseQty) * SD.PrPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	DsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),
	MSMRegionID=''
FROM
	PrLedger SL,
	PrDetail SD,
	Supplier C,
	Accounts A,
	Item I
WHERE
	SL.PrInvCode = SD.PrInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.SuppCode = C.SuppCode AND
	C.SuppCode = A.AccCode AND 
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate"
  arguments=(("manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
