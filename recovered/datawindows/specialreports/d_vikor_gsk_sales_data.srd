table(column=(type=char(8000) updatewhereclause=yes name=dscode dbname="DSCode"  )
column=(type=char(8000) updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(1) updatewhereclause=yes name=saletype dbname="SaleType"  )
column=(type=char(10) updatewhereclause=yes name=invoice dbname="Invoice"  )
column=(type=char(6) updatewhereclause=yes name=salesmancode dbname="SalesManCode"  )
column=(type=char(6) updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(6) updatewhereclause=yes name=regioncode dbname="RegionCode"  )
column=(type=char(6) updatewhereclause=yes name=territorycode dbname="TerritoryCode"  )
column=(type=char(6) updatewhereclause=yes name=medicalrep dbname="MedicalRep"  )
column=(type=char(6) updatewhereclause=yes name=zonecode dbname="ZoneCode"  )
column=(type=char(75) updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=char(12) updatewhereclause=yes name=tradeprice dbname="TradePrice"  )
column=(type=char(12) updatewhereclause=yes name=discounttradeprice dbname="DiscountTradePrice"  )
column=(type=char(5) updatewhereclause=yes name=discountperc dbname="DiscountPerc"  )
column=(type=char(12) updatewhereclause=yes name=discountamt dbname="DiscountAmt"  )
column=(type=char(5) updatewhereclause=yes name=gstperc dbname="GSTPerc"  )
column=(type=char(12) updatewhereclause=yes name=gstamt dbname="GSTAmt"  )
column=(type=char(12) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=char(12) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=char(12) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
column=(type=char(12) updatewhereclause=yes name=returnamt dbname="ReturnAmt"  )
column=(type=char(12) updatewhereclause=yes name=grossamt dbname="GrossAmt"  )
column=(type=char(12) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=char(6) updatewhereclause=yes name=areacode dbname="AreaCode"  )
 retrieve="SELECT 
	DSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	Date=LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(100), SL.Date, 106), ' ', '-')))),
	SaleType=CASE SL.SaleCatCode WHEN 3 THEN 'C' ELSE 'I' END,
	Invoice = LTRIM(RTRIM(STR(SL.SaleInvCode, 10))),
	SalesManCode  = LTRIM(RTRIM(ISNULL(STR(SL.SManCode, 6), ''))),
	CustCode  = LTRIM(RTRIM(ISNULL(STR(SL.CustCode, 6), ''))),
	RegionCode=LTRIM(RTRIM(STR(R.RegionCode, 6))),
	TerritoryCode=LTRIM(RTRIM(STR(AR.AreaCode, 6))),
	MedicalRep=LTRIM(RTRIM(STR(C.SalesManCode, 6))),
	ZoneCode  = LTRIM(RTRIM(ISNULL(STR(R.RegionCode, 6), ''))),
	ItemCode=LTRIM(RTRIM(I.CustomICode)),
	Batch=LTRIM(RTRIM(SD.Batch)),
	TradePrice=LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))),
	DiscountTradePrice=LTRIM(RTRIM(STR(Round((SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01), 2), 12, 2))),
	DiscountPerc=LTRIM(RTRIM(STR(SD.DiscPerc, 5, 2))),
	DiscountAmt=LTRIM(RTRIM(STR(Round((LooseQty * SD.ItemFlatDisc) + (LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * SD.DiscPerc * 0.01), 2), 12, 2))),
	GSTPerc=LTRIM(RTRIM(STR(SD.GSTPerc, 5, 2))),
	GSTAmt=LTRIM(RTRIM(STR(Round((LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2), 12, 2))), 
	SaleQty=LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	BonusQty=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	ReturnQty=LTRIM(RTRIM(STR(0, 12))),
	ReturnAmt=LTRIM(RTRIM(STR(0, 12))),
	GrossAmt=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SalePrice), 2), 12, 2))),
	NetAmt=LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2))),
	AreaCode = LTRIM(RTRIM(ISNULL(STR(AR.AreaCode, 6), '')))
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	Accounts A,
	Area AR,
	Region R,
	CustomerCategory CC,
	Item I
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:ai_manfcode) AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode AND
	AR.RegionCode = R.RegionCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT 
	DSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	Date=LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(100), SL.Date, 106), ' ', '-')))),
	SaleType=CASE SL.SRCatCode WHEN 7 THEN 'C' ELSE 'I' END,
	Invoice = LTRIM(RTRIM(STR(SL.SRInvCode, 10))),
	SalesManCode  = LTRIM(RTRIM(ISNULL(STR(SL.SManCode, 6), ''))),
	CustCode  = LTRIM(RTRIM(ISNULL(STR(SL.CustCode, 6), ''))),
	RegionCode=LTRIM(RTRIM(STR(R.RegionCode, 6))),
	TerritoryCode=LTRIM(RTRIM(STR(AR.AreaCode, 6))),
	MedicalRep=LTRIM(RTRIM(STR(C.SalesManCode, 6))),
	ZoneCode  = LTRIM(RTRIM(ISNULL(STR(R.RegionCode, 6), ''))),
	ItemCode=LTRIM(RTRIM(I.CustomICode)),
	Batch=LTRIM(RTRIM(SD.Batch)),
	TradePrice=LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))),
	DiscountTradePrice=LTRIM(RTRIM(STR(Round(SD.SRPrice * (1 - SD.DiscPerc * 0.01), 2), 12, 2))),
	DiscountPerc=LTRIM(RTRIM(STR(SD.DiscPerc, 5, 2))),
	DiscountAmt=LTRIM(RTRIM(STR(Round((LooseQty * SD.SRPrice * SD.DiscPerc * 0.01), 2), 12, 2))),
	GSTPerc=LTRIM(RTRIM(STR(SD.GSTPerc, 5, 2))),
	GSTAmt=LTRIM(RTRIM(STR(Round((LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2), 12, 2))), 
	SaleQty=LTRIM(RTRIM(STR(0, 12))),
	BonusQty=LTRIM(RTRIM(STR(SD.BonusQty, 12))),
	ReturnQty=LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	ReturnAmt=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2))),
	GrossAmt=LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SRPrice), 2), 12, 2))),
	NetAmt=LTRIM(RTRIM(STR(0, 12, 2))),
	AreaCode = LTRIM(RTRIM(ISNULL(STR(AR.AreaCode, 6), '')))
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Accounts A,
	Area AR,
	Region R,
	CustomerCategory CC,
	Item I
WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode IN (:ai_manfcode) AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode AND
	AR.RegionCode = R.RegionCode AND
	SL.DATE BETWEEN :ar_startdate AND :ar_enddate
"
  arguments=(("as_distcode", string), ("ai_manfcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
