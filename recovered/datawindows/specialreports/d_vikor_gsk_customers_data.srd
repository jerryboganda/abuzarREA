table(column=(type=char(8000) updatewhereclause=yes name=dscode dbname="DSCode"  )
column=(type=char(6) updatewhereclause=yes name=customercode dbname="CustomerCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(1) updatewhereclause=yes name=custtype dbname="CustType"  )
column=(type=char(60) updatewhereclause=yes name=cityname dbname="CityName"  )
column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
column=(type=char(50) updatewhereclause=yes name=salestaxregno dbname="SalesTaxRegNo"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(30) updatewhereclause=yes name=consumertype dbname="ConsumerType"  )
column=(type=char(5) updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=areaname dbname="AreaName"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
 retrieve="SELECT 
	DSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	CustomerCode=LTRIM(RTRIM(A.AccCode)),
	Name=LTRIM(RTRIM(SUBSTRING(LTRIM(RTRIM(A.Name)), 1, 60))),
	CustType=CASE 
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'M' THEN 'M'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN 'R'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN 'I'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN 'D'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN 'W'
		ELSE 'M' END,
	CityName=LTRIM(RTRIM(ISNULL(C.City, '-'))),
	NTN=LTRIM(RTRIM(ISNULL(C.NTNNO, '-'))),
	SalesTaxRegNo=LTRIM(RTRIM(ISNULL(C.SalesTaxRegNo, '-'))),
	Address=LTRIM(RTRIM(ISNULL(C.Address1, '-'))),
	ConsumerType = (SELECT CS.AliasName FROM CustomerSector CS WHERE CS.CustomerSectorCode = C.CustomerSectorCode),
	AreaCode = LTRIM(RTRIM(STR(C.AreaCode, 5))),
	AreaName = (SELECT AR.Name FROM Area AR WHERE AR.AreaCode = C.AreaCode),
	Active = CASE A.Active WHEN 'Y' THEN '1' ELSE '0' END
FROM
	Customer C, Accounts A
WHERE
	C.CustCode = A.AccCode
ORDER BY
	A.AccCode"
  arguments=(("as_distcode", string))
)
