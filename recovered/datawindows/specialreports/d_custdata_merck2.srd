release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=112 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long updatewhereclause=yes name=manufacturerlen dbname="ManufacturerLen"  )
column=(type=char(8000) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=long updatewhereclause=yes name=custcodelen dbname="CustCodeLen"  )
column=(type=char(8000) updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=long updatewhereclause=yes name=customernamelen dbname="CustomerNameLen"  )
column=(type=char(8000) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=long updatewhereclause=yes name=salepersonlen dbname="SalePersonLen"  )
column=(type=char(8000) updatewhereclause=yes name=saleperson dbname="SalePerson"  )
column=(type=long updatewhereclause=yes name=percsharelen dbname="PercShareLen"  )
column=(type=char(12) updatewhereclause=yes name=percshare dbname="PercShare"  )
column=(type=long updatewhereclause=yes name=salesmancodelen dbname="SalesManCodeLen"  )
column=(type=char(10) updatewhereclause=yes name=salesmancode dbname="SalesManCode"  )
 retrieve="SELECT 
	ManufacturerLen = 60,
	Manufacturer = LTRIM(RTRIM(SUBSTRING((SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = :ai_manfcode), 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING((SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = :ai_manfcode), 1, 60))))),
	CustCodeLen=12,
	CustCode = LTRIM(RTRIM(SUBSTRING(A.AliasName, 1, 12))) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(SUBSTRING(A.AliasName, 1, 12))))),
	CustomerNameLen=60,
	CustomerName = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))))),
	SalePersonLen=60,
	SalePerson = LTRIM(RTRIM(SUBSTRING((SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = C.SalesManCode), 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING((SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = C.SalesManCode), 1, 60))))),
	PercShareLen=12,
	PercShare = STR(0.00, 12, 2),
	SalesManCodeLen = 10,
	SalesManCode= STR(C.SalesManCode, 10)
FROM Customer C, CustomerCategory CC, Accounts A
WHERE CC.CustCatCode IN (:ai_custcatcode) AND
	CC.CustCatCode = C.CustCatCode AND
	C.CustCode = A.AccCode
ORDER BY
	A.AliasName"
  arguments=(("ai_manfcode", number), ("ai_custcatcode", numberlist))
)
