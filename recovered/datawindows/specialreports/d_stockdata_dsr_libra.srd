table(column=(type=long updatewhereclause=yes name=productcodelen dbname="ProductCodeLEN"  )
column=(type=char(20) updatewhereclause=yes name=productcode dbname="ProductCode"  )
column=(type=long updatewhereclause=yes name=batchlen dbname="BatchLen"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=long updatewhereclause=yes name=openingunitslen dbname="OpeningUnitsLen"  )
column=(type=char(12) updatewhereclause=yes name=openingunits dbname="OpeningUnits"  )
column=(type=long updatewhereclause=yes name=openingbonuslen dbname="OpeningBonusLen"  )
column=(type=char(12) updatewhereclause=yes name=openingbonus dbname="OpeningBonus"  )
column=(type=long updatewhereclause=yes name=purchaseunitslen dbname="PurchaseUnitsLen"  )
column=(type=char(12) updatewhereclause=yes name=purchaseunits dbname="PurchaseUnits"  )
column=(type=long updatewhereclause=yes name=purchasebonuslen dbname="PurchaseBonusLen"  )
column=(type=char(12) updatewhereclause=yes name=purchasebonus dbname="PurchaseBonus"  )
column=(type=long updatewhereclause=yes name=salesunitslen dbname="SalesUnitsLen"  )
column=(type=char(12) updatewhereclause=yes name=salesunits dbname="SalesUnits"  )
column=(type=long updatewhereclause=yes name=salesbonuslen dbname="SalesBonusLen"  )
column=(type=char(12) updatewhereclause=yes name=salesbonus dbname="SalesBonus"  )
column=(type=long updatewhereclause=yes name=exportslen dbname="ExportsLen"  )
column=(type=char(12) updatewhereclause=yes name=exports dbname="Exports"  )
column=(type=long updatewhereclause=yes name=damageexpirylen dbname="DamageExpiryLen"  )
column=(type=char(12) updatewhereclause=yes name=damageexpiry dbname="DamageExpiry"  )
column=(type=long updatewhereclause=yes name=otherinlen dbname="OtherInLen"  )
column=(type=char(12) updatewhereclause=yes name=otherin dbname="OtherIn"  )
column=(type=long updatewhereclause=yes name=otheroutlen dbname="OtherOutLen"  )
column=(type=char(12) updatewhereclause=yes name=otherout dbname="OtherOut"  )
column=(type=long updatewhereclause=yes name=closingunitslen dbname="ClosingUnitsLen"  )
column=(type=char(12) updatewhereclause=yes name=closingunits dbname="ClosingUnits"  )
column=(type=long updatewhereclause=yes name=closingbonuslen dbname="ClosingBonusLen"  )
column=(type=char(12) updatewhereclause=yes name=closingbonus dbname="ClosingBonus"  )
column=(type=long updatewhereclause=yes name=datelen dbname="DateLen"  )
column=(type=char(10) updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=bpcodelen dbname="BPCodeLEN"  )
column=(type=char(8000) updatewhereclause=yes name=bpcode dbname="BPCode"  )
 retrieve="SELECT
	ProductCodeLEN=20,
	ProductCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),
	BatchLen=10,
	Batch=st.Batch,
	OpeningUnitsLen =12,
	OpeningUnits	= STR(SUM(CASE WHEN type='OP' THEN st.qty ELSE 0 END), 12),
	OpeningBonusLen =12,
	OpeningBonus	= STR(SUM(CASE WHEN type='OP' THEN st.bonus ELSE 0 END), 12),
	PurchaseUnitsLen =12,
	PurchaseUnits = STR(SUM(CASE TYPE WHEN 'PV' THEN st.qty WHEN 'PR' THEN -(st.qty) ELSE 0 END), 12),
	PurchaseBonusLen =12,
	PurchaseBonus = STR(SUM(CASE TYPE WHEN 'PV' THEN st.Bonus WHEN 'PR' THEN -(st.Bonus) ELSE 0 END), 12),
	SalesUnitsLen =12,
	SalesUnits = STR(SUM(CASE TYPE WHEN 'SI' THEN st.qty WHEN 'SR' THEN - (st.qty) ELSE 0 END), 12),
	SalesBonusLen =12,
	SalesBonus = STR(SUM(CASE TYPE WHEN 'SI' THEN st.Bonus WHEN 'SR' THEN - (st.bonus) ELSE 0 END), 12),
	ExportsLen =12,
	Exports = STR(SUM(CASE TYPE WHEN 'II' THEN st.qty WHEN 'IR' THEN - (st.qty) ELSE 0 END), 12),
	DamageExpiryLen =12,
	DamageExpiry = STR(SUM(CASE WHEN TYPE = 'PE' OR Type='PD' THEN st.qty + st.Bonus ELSE 0 END), 12),
	OtherInLen =12,
	OtherIn = STR(SUM(CASE WHEN TYPE = 'RV' OR TYPE = 'AI' THEN st.qty + st.bonus ELSE 0 END), 12),
	OtherOutLen =12,
	OtherOut = STR(SUM(CASE WHEN TYPE = 'IV' OR TYPE = 'AD' OR TYPE = 'DS' THEN st.qty + st.bonus ELSE 0 END), 12),
	ClosingUnitsLen =12,
	ClosingUnits = STR(SUM(
		CASE WHEN TYPE = 'OP' OR TYPE = 'PV' OR TYPE = 'SR' OR TYPE = 'RV' OR TYPE = 'AI' THEN +1 
		ELSE -1 END * st.qty ), 12),
	ClosingBonusLen =12,
	ClosingBonus = STR(SUM(
		CASE WHEN TYPE = 'OP' OR TYPE = 'PV' OR TYPE = 'SR' OR TYPE = 'RV' OR TYPE = 'AI' THEN +1 
		ELSE -1 END * st.bonus ), 12),
	DateLen=10,
	Date=CONVERT(VARCHAR(10), :ar_enddate, 101),
	BPCodeLEN=20,
	BPCode=:as_distcode + REPLICATE(' ', 20 - LEN(:as_distcode))
FROM
	(SELECT type='OP', icode, batch, qty = sum(qty), bonus = sum(bonus)
	FROM	
		(select pd.icode, pd.batch, 
			qty = sum(isnull(
				case pl.purcatcode 
				when 1 THEN (pd.packqty * pd.packunits)
				when 2 THEN (pd.packqty * pd.packunits)
				else pd.looseqty end, 0)), 
			bonus = sum(isnull(
				case pl.purcatcode 
				when 1 THEN (pd.bonusqty * pd.packunits)
				when 2 THEN (pd.bonusqty * pd.packunits)
				else pd.bonusqty end, 0))
		FROM purledger pl, purdetail pd, item i
		WHERE pl.posted = 'Y' AND 
			pl.purinvcode = pd.purinvcode AND
			pl.date < :ar_startdate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode, pd.batch
		UNION ALL
		select	pd.icode, pd.batch,
			qty  = - sum(pd.looseqty),
			bonus = - sum(pd.bonusqty)
		FROM prledger pl, prdetail pd, item i
		WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
			pl.date < :ar_startdate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode, pd.batch
		UNION ALL
		select	 sd.icode, sd.batch,
			qty  = -sum(sd.looseqty),
			bonus  = -sum(sd.bonusqty)
		FROM saleledger sl, saledetail sd, item i
		WHERE sl.saleinvcode = sd.saleinvcode AND
			  sl.posted = 'Y' AND 
		      sl.date < :ar_startdate AND sd.Due IS NULL AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	 sd.icode, sd.batch,
			qty  = sum(sd.looseqty),
			bonus = sum(sd.bonusqty)
		FROM srledger sl, srdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
			  sl.posted = 'Y' AND 
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	 sd.icode, sd.batch, qty  = -sum(sd.qty), bonus = 0
		FROM issueheader sl, issuedetail sd, item i
		WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select 	sd.icode, sd.batch, qty  = sum(sd.qty), bonus=0
		FROM receiptheader sl, receiptdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select 	sd.icode, sd.batch, qty = sum(sd.looseqty), bonus=0
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select 	sd.icode, sd.batch, qty = -sum(sd.looseqty), bonus=0
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	 d.icode, d.batch, qty = -sum(d.duesatisfyqty), bonus=0
		FROM duesatisfyheader h, duesatisfydetail d, item i
		WHERE h.duesatisfycode=d.duesatisfycode AND
		      h.duesatisfydate < :ar_startdate AND
			d.icode=i.icode and i.manfcode in (:manfcode)
		Group By d.icode, d.batch) A
	GROUP BY icode, batch
	UNION ALL
	select
		type='PV',
		pd.icode, pd.batch,
		qty = sum(pd.looseqty + pd.packqty * pd.packunits),
		bonus = sum(isnull(case pl.purcatcode 
			when 1 THEN pd.bonusqty * pd.packunits
			when 2 THEN pd.bonusqty * pd.packunits
			else pd.bonusqty
			end, 0))
	FROM purledger pl, purdetail pd, item i
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pl.date >= :ar_startdate and pl.date <= :ar_enddate AND
		pd.icode=i.icode and i.manfcode in (:manfcode)
	Group By pd.icode, pd.batch
	UNION ALL
	select	
		type= CASE LEFT(LTRIM(RTRIM(PT.Name)), 1) WHEN 'E' THEN 'PE' WHEN 'D' THEN 'PD' ELSE 'PR' END,
		pd.icode,
		pd.batch,
		qty = sum(pd.looseqty),
		bonus = sum(pd.bonusqty)
	FROM 
		PrLedger PL
		LEFT OUTER JOIN 
		PurchaseType AS PT ON (PL.PrTypeCode = PT.PurTypeCode) ,
		prdetail pd, item i
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
	      pl.date >= :ar_startdate and pl.date <= :ar_enddate AND
		pd.icode=i.icode and i.manfcode in (:manfcode)
	Group By PT.Name, pd.icode, pd.batch
	UNION ALL
	select
		type=CASE WHEN LEFT(UPPER(CC.Name),4) = 'INST' THEN 'II' ELSE 'SI' END,
		sd.icode, sd.batch,
		qty = sum(sd.looseqty),
		bonus = sum(sd.bonusqty)
	FROM saleledger sl, saledetail sd, item i, Customer C, CustomerCategory CC
	WHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode) AND
		sl.CustCode=C.CustCode AND C.CustCatCode=CC.CustCatCode
	Group By CC.Name, sd.icode, sd.batch
	UNION ALL
	select
		type=CASE WHEN LEFT(UPPER(CC.Name),4) = 'INST' THEN 'IR' ELSE 'SR' END,
		sd.icode, sd.batch,
		qty = sum(sd.looseqty),
		bonus = sum(sd.bonusqty)
	FROM srledger sl, srdetail sd, item i, Customer C, CustomerCategory CC
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode) AND
		sl.CustCode=C.CustCode AND C.CustCatCode=CC.CustCatCode
	Group By CC.Name, sd.icode, sd.batch
	UNION ALL
	select	type='IV',
		sd.icode, sd.batch,
		qty = sum(sd.qty),
		bonus = 0
	FROM issueheader sl, issuedetail sd, item i
	WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch
	UNION ALL
	select	type='DS',
		d.icode, d.batch,
		qty = sum(d.duesatisfyqty),
		bonus = 0
	FROM duesatisfyheader h, duesatisfydetail d, item i
	WHERE h.duesatisfycode = d.duesatisfycode AND
	      h.duesatisfydate >= :ar_startdate and h.duesatisfydate <= :ar_enddate AND
		d.icode=i.icode and i.manfcode in (:manfcode)
	Group By d.icode, d.batch
	UNION ALL
	select	type='RV',
		sd.icode, sd.batch,
		qty = sum(sd.qty),
		bonus = 0
	FROM receiptheader sl, receiptdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch
	UNION ALL
	select	type='AI',
		sd.icode, sd.batch,
		qty = sum(sd.looseqty),
		bonus = 0
	FROM Adjheader sl, Adjdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch
	UNION ALL
	select	type='AD',
		sd.icode, sd.batch,
		qty = sum(sd.looseqty),
		bonus = 0
	FROM Adjheader sl, Adjdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch
	UNION ALL
	SELECT type='OP', icode, batch=SPACE(10), qty = 0, bonus = 0
	FROM ITEM 
	WHERE ManfCode IN (:manfcode)) St, 
	Item i
WHERE st.icode = i.icode
GROUP BY i.icode, i.name, i.customicode, st.batch
ORDER BY i.customicode
"
  arguments=(("manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
