table(column=(type=long updatewhereclause=yes name=inv_no dbname="INV_NO"  )
column=(type=datetime updatewhereclause=yes name=inv_date dbname="INV_DATE"  )
column=(type=char(12) updatewhereclause=yes name=custcode dbname="CUSTCODE"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="CUSTNAME"  )
column=(type=char(75) updatewhereclause=yes name=prod_code dbname="PROD_CODE"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ITEMNAME"  )
column=(type=char(50) updatewhereclause=yes name=pack_size dbname="PACK_SIZE"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Saledetail.BATCH"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Saledetail.EXPIRY"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="Saledetail.LOOSEQTY"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="Saledetail.BONUSQTY"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="Saledetail.DISCPERC"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Saledetail.SALEPRICE"  )
column=(type=char(60) updatewhereclause=no name=username dbname="UserName"  )
 retrieve="SELECT 
	INV_NO=S.SALEINVCODE, 
	INV_DATE=S.DATE, 
	CUSTCODE=A.aliasname, 
	CUSTNAME=A.NAME, 
	PROD_CODE=I.CUSTOMICODE, 
	ITEMNAME=I.NAME, 
	PACK_SIZE=I.PACKINGDESC, 
	SL.BATCH,  
	SL.EXPIRY, 
	SL.LOOSEQTY, 
	SL.BONUSQTY, 
	SL.DISCPERC, 
	SL.SALEPRICE,
	UserName=(SELECT U.UserName FROM Users U WHERE U.UserCode = S.SalesmanCode)
FROM 
	SALELEDGER S, 
	SALEDETAIL SL, 
	ITEM I, 
	ACCOUNTS A
WHERE 
	S.SALEINVCODE = SL.SALEINVCODE AND 
	S.CUSTCODE = A.ACCCODE AND 
	SL.ICODE = I.ICODE AND
	I.MANFCODE = :ai_manfcode AND 
	S.DATE BETWEEN :ad_StartDATE AND :ad_EndDATE
ORDER BY  
	S.DATE,
	S.SALEINVCODE,
	I.NAME,
	SL.BATCH, 
	SL.EXPIRY"
  arguments=(("ai_manfcode", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="inv_date A, inv_no A, itemname A, prod_code A, batch A, expiry A"
)
