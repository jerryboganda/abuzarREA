table(column=(type=char(4) updatewhereclause=yes name=fiscalyear dbname="FiscalYear"  )
column=(type=char(2) updatewhereclause=yes name=period dbname="Period"  )
column=(type=char(2) updatewhereclause=yes name=tradesector dbname="TradeSector"  )
column=(type=char(101) updatewhereclause=yes name=distributorcode dbname="DistributorCode"  )
column=(type=char(101) updatewhereclause=yes name=warehousecode dbname="WareHouseCode"  )
column=(type=char(10) updatewhereclause=yes name=invoiceno dbname="InvoiceNo"  )
column=(type=char(20) updatewhereclause=yes name=invoicetype dbname="InvoiceType"  )
column=(type=char(10) updatewhereclause=yes name=createddate dbname="CreatedDate"  )
column=(type=char(10) updatewhereclause=yes name=delivereddate dbname="DeliveredDate"  )
column=(type=char(111) updatewhereclause=yes name=dsrcode dbname="DSRCode"  )
column=(type=char(113) updatewhereclause=yes name=outletcode dbname="OutletCode"  )
column=(type=char(75) updatewhereclause=yes name=skucode dbname="SKUCode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=char(12) updatewhereclause=yes name=dpnetamount dbname="DPNetAmount"  )
column=(type=char(12) updatewhereclause=yes name=tpamount dbname="TPAmount"  )
column=(type=char(12) updatewhereclause=yes name=tpgst dbname="TPGST"  )
column=(type=char(12) updatewhereclause=yes name=tpdiscount dbname="TPDiscount"  )
column=(type=char(12) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=char(12) updatewhereclause=yes name=quantity dbname="Quantity"  )
column=(type=char(2) updatewhereclause=yes name=unit dbname="Unit"  )
 retrieve="SELECT 
	FiscalYear=STR(Year(:ar_startdate), 4),
	Period=STR(Month(:ar_startdate), 2),
	TradeSector = 'PH',
	DistributorCode=LTRIM(RTRIM(:as_distcode + SPACE(100))),
	WareHouseCode=LTRIM(RTRIM(:as_distcode + SPACE(100))),
	InvoiceNo = LTRIM(RTRIM(STR(SL.SaleInvCode, 10))),
	InvoiceType='Sales Invoice',
	CreatedDate=Convert(varchar(10), SL.OriginalDATE, 104),
	DeliveredDate=Convert(varchar(10), SL.DATE, 104),
	DSRCode=LTRIM(RTRIM(:as_distcode)) + LTRIM(RTRIM(STR(SL.SmanCode))) + SPACE(100),
	OutletCode= LTRIM(RTRIM(:as_distcode + A.AliasName + SPACE(100))),
	SKUCode=LTRIM(RTRIM(LTRIM(RTRIM(I.CustomICode)))),
	Batch=SD.Batch,
	DPNetAmount=LTRIM(RTRIM(STR(I.PurPrice * SD.LooseQty, 12, 2))),
	TPAmount= LTRIM(RTRIM(STR(SD.SalePrice * SD.LooseQty, 12, 2))),
	TPGST = LTRIM(RTRIM(STR((SD.SalePrice - SD.ItemFlatDisc) * SD.LooseQty * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01, 12, 2))),
	TPDiscount=LTRIM(RTRIM(STR(
			Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + 
			(SD.LooseQty * SD.ItemFlatDisc), 12, 2))),
	NetAmount = LTRIM(RTRIM(STR((SD.SalePrice - SD.ItemFlatDisc) * SD.LooseQty * (1 - SD.DiscPerc * 0.01), 12, 2))),
	Quantity=LTRIM(RTRIM(STR(SD.LooseQty, 12))),
	Unit = 'EA'
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :ai_manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
UNION ALL
SELECT 
	FiscalYear=STR(Year(:ar_startdate), 4),
	Period=STR(Month(:ar_startdate), 2),
	TradeSector = 'PH',
	DistributorCode=LTRIM(RTRIM(:as_distcode + SPACE(100))),
	WareHouseCode=LTRIM(RTRIM(:as_distcode + SPACE(100))),
	InvoiceNo = LTRIM(RTRIM(STR(SL.SaleInvCode, 10))),
	InvoiceType='Sales Return Invoice',
	CreatedDate=Convert(varchar(10), SL.OriginalDATE, 104),
	DeliveredDate=Convert(varchar(10), SL.DATE, 104),
	DSRCode=LTRIM(RTRIM(:as_distcode)) + LTRIM(RTRIM(STR(SL.SmanCode))) + SPACE(100),
	OutletCode= LTRIM(RTRIM(:as_distcode + A.AliasName + SPACE(100))),
	SKUCode=LTRIM(RTRIM(LTRIM(RTRIM(I.CustomICode)))),
	Batch=SD.Batch,
	DPNetAmount=LTRIM(RTRIM(STR(- I.PurPrice * SD.LooseQty, 12, 2))),
	TPAmount= LTRIM(RTRIM(STR(- SD.SRPrice * SD.LooseQty, 12, 2))),
	TPGST = LTRIM(RTRIM(STR(- SD.SRPrice * SD.LooseQty * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01, 12, 2))),
	TPDiscount=LTRIM(RTRIM(STR( - 
			Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2))),
	NetAmount = LTRIM(RTRIM(STR(- SD.SRPrice * SD.LooseQty * (1 - SD.DiscPerc * 0.01), 12, 2))),
	Quantity=LTRIM(RTRIM(STR(- SD.LooseQty, 12))),
	Unit = 'EA'
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :ai_manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
"
  arguments=(("ai_manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
