release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(12) updatewhereclause=yes name=code dbname="Code"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(100) updatewhereclause=yes name=mobileno dbname="MobileNo"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="ADDRESS"  )
column=(type=char(60) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(60) updatewhereclause=yes name=contactperson dbname="ContactPerson"  )
column=(type=char(60) updatewhereclause=yes name=email dbname="Email"  )
column=(type=char(30) updatewhereclause=yes name=license dbname="License"  )
column=(type=char(10) updatewhereclause=yes name=licensedate dbname="LicenseDate"  )
column=(type=char(6) updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(30) updatewhereclause=yes name=custtype dbname="CustType"  )
column=(type=char(20) updatewhereclause=yes name=monthlysales dbname="MonthlySales"  )
column=(type=char(101) updatewhereclause=yes name=dscode dbname="DsCode"  )
column=(type=char(0) updatewhereclause=yes name=msmregionid dbname="MSMRegionID"  )
 retrieve="SELECT
	Code = LTRIM(RTRIM(A.AliasName)),
	Name = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))),
	City= LTRIM(RTRIM(SUBSTRING(C.City, 1, 60))),
	MobileNo= LTRIM(RTRIM(SUBSTRING(C.CellNo, 1, 100))),
	ADDRESS = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))),
	Phone = LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 100))),
	ContactPerson = LTRIM(RTRIM(SUBSTRING(C.CP, 1, 100))),
	Email= LTRIM(RTRIM(SUBSTRING(C.Email, 1, 100))),
	License= LTRIM(RTRIM(SUBSTRING(ISNULL(C.LicenceNo, 'ABCD'), 1, 100))),
	LicenseDate= Convert(varchar(10), C.LicenceExpiry, 103),
	AreaCode=LTRIM(RTRIM(STR(SAR.SubAreaCode, 6))),
	CustType=LTRIM(RTRIM(CT.NAME)),
	MonthlySales=LTRIM(RTRIM(STR(0.00, 20, 2))),
	DsCode=LTRIM(RTRIM(:as_distcode+SPACE(100))),
	MSMRegionID=''
FROM Customer C, Accounts A, SubArea SAR, CUSTOMERCATEGORY CT
WHERE C.CustCode = A.AccCode AND C.SubAreaCode = SAR.SubAreaCode AND C.CUSTCATCODE = CT.CUSTCATCODE
"
  arguments=(("as_distcode", string))
)
