table(column=(type=long updatewhereclause=yes name=prodcodelen dbname="ProdCodeLEN"  )
column=(type=char(20) updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=long updatewhereclause=yes name=prodnamelen dbname="ProdNameLEN"  )
column=(type=char(60) updatewhereclause=yes name=prodname dbname="ProdName"  )
column=(type=long updatewhereclause=yes name=packlen dbname="PackLEN"  )
column=(type=char(50) updatewhereclause=no name=pack dbname="Pack"  )
column=(type=long updatewhereclause=yes name=pricelen dbname="PriceLen"  )
column=(type=char(10) updatewhereclause=yes name=price dbname="Price"  )
column=(type=long updatewhereclause=yes name=bpcodelen dbname="BPCodeLEN"  )
column=(type=char(8000) updatewhereclause=yes name=bpcode dbname="BPCode"  )
 retrieve="SELECT 
	ProdCodeLEN=20,
	ProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),
	ProdNameLEN=60,
	ProdName=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 60),
	PackLEN=60,
	Pack=SUBSTRING(LTRIM(RTRIM(I.PackingDesc)), 1, 60),
	PriceLen=10,
	Price=STR(I.SalePrice, 10, 2),
	BPCodeLEN=20,
	BPCode=:as_distcode + REPLICATE(' ', 20 - LEN(:as_distcode))
FROM
	Item I
WHERE
	I.ManfCode = :manfcode"
  arguments=(("manfcode", number), ("as_distcode", string))
)
