table(column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="ADDRESS1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="ADDRESS2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(60) updatewhereclause=yes name=country dbname="Country"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(100) updatewhereclause=yes name=fax dbname="Fax"  )
column=(type=char(30) updatewhereclause=yes name=license dbname="License"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=areaname dbname="AreaName"  )
column=(type=char(30) updatewhereclause=yes name=custtype dbname="CustType"  )
 retrieve="SELECT
	CustCode = A.AccCode,
	Name = A.Name,
	ADDRESS1 = C.ADDRESS1,
	ADDRESS2 = C.ADDRESS2,
	City = C.City,
	Country = C.Country,
	Phone = C.Phone,
	Fax = C.Fax,
	License = C.LicenceNo,
	AreaCode=AR.AREACODE, 
	AreaName = AR.NAME,
	CustType=(SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE)
FROM Customer C, Accounts A, Area AR
WHERE C.CustCode = A.AccCode AND C.AreaCode = AR.AreaCode
ORDER BY
	CustCode"
 )
