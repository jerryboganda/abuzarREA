footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=custidlen dbname="CUSTIDLEN"  )
column=(type=char(10) updatewhereclause=yes name=custid dbname="CUSTID"  )
column=(type=long updatewhereclause=yes name=ctlen dbname="CTLEN"  )
column=(type=char(2) updatewhereclause=yes name=ct dbname="CT"  )
column=(type=long updatewhereclause=yes name=custnamelen dbname="CUSTNAMELEN"  )
column=(type=char(8000) updatewhereclause=yes name=custname dbname="CUSTNAME"  )
column=(type=long updatewhereclause=yes name=addresslen dbname="ADDRESSLEN"  )
column=(type=char(8000) updatewhereclause=yes name=address dbname="ADDRESS"  )
column=(type=long updatewhereclause=yes name=arealen dbname="AREALEN"  )
column=(type=char(8000) updatewhereclause=yes name=area dbname="AREA"  )
column=(type=long updatewhereclause=yes name=citylen dbname="CITYLEN"  )
column=(type=char(8000) updatewhereclause=yes name=city dbname="CITY"  )
column=(type=long updatewhereclause=yes name=stationidlen dbname="STATIONIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=stationid dbname="STATIONID"  )
column=(type=long updatewhereclause=yes name=stationlen dbname="STATIONLEN"  )
column=(type=char(8000) updatewhereclause=yes name=station dbname="STATION"  )
 retrieve="SELECT 
	DSTBIDLEN=6,
	DSTBID=ZAR.DistCode + REPLICATE(' ', 6 - LEN(ZAR.DistCode)),
	CUSTIDLEN=10,
	CUSTID = SUBSTRING(LTRIM(RTRIM(STR(C.CustCode,10))), 1, 10),
	CTLEN=2,
	CT=CASE 
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN '01'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN '02'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN '03'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN '04'
		ELSE '02' END,
	CUSTNAMELEN=50,
	CUSTNAME = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))))),
	ADDRESSLEN=50,
	ADDRESS = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 50))))),
	AREALEN=30,
	AREA = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 30))))),
	CITYLEN=30,
	CITY = LTRIM(RTRIM(SUBSTRING(C.CITY, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(C.CITY, 1, 30))))),
	STATIONIDLEN=9,
	STATIONID=REPLICATE('0', 4 - LEN(LTRIM(RTRIM(STR(SAR.SUBAREACODE))))) + LTRIM(RTRIM(STR(SAR.SUBAREACODE))) + SPACE(5),
	STATIONLEN=30,
	STATION = LTRIM(RTRIM(SUBSTRING(SAR.NAME, 1, 30))) + REPLICATE(' ', 30 - LEN(LTRIM(RTRIM(SUBSTRING(SAR.NAME, 1, 30)))))
FROM 
	Customer C, Accounts A, Area AR, SubArea SAR,
	(SELECT DistCode = LEFT(LTRIM(RTRIM(Z.Remarks)), 6), ZA.AreaCode
	FROM Zone Z, ZoneAreas ZA
	WHERE Z.ZoneCode = :ai_zonecode AND 
		Z.ZoneCode = ZA.ZoneCode) ZAR
WHERE C.CustCode = A.AccCode AND 
	C.AreaCode = AR.AreaCode AND 
	C.SubAreaCode = SAR.SubAreaCode AND
	C.AreaCode = ZAR.AreaCode
"
  arguments=(("ai_zonecode", number))
)
