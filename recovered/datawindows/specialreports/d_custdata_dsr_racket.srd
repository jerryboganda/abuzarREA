table(column=(type=char(2) updatewhereclause=yes name=tradesector dbname="TradeSector"  )
column=(type=char(113) updatewhereclause=yes name=outletcode dbname="OutletCode"  )
column=(type=char(60) updatewhereclause=yes name=outletname dbname="OutletName"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
column=(type=char(30) updatewhereclause=yes name=outlettype dbname="OutletType"  )
column=(type=char(5) updatewhereclause=yes name=areatype dbname="AreaType"  )
column=(type=char(30) updatewhereclause=yes name=accounttype dbname="AccountType"  )
column=(type=char(30) updatewhereclause=yes name=cannelprogram dbname="CannelProgram"  )
column=(type=char(60) updatewhereclause=yes name=town dbname="Town"  )
column=(type=char(60) updatewhereclause=yes name=locality dbname="Locality"  )
column=(type=char(60) updatewhereclause=yes name=sublocality dbname="SubLocality"  )
column=(type=char(15) updatewhereclause=yes name=lastchangeddate dbname="LastChangedDate"  )
column=(type=char(15) updatewhereclause=yes name=lastchangedtime dbname="LastChangedTime"  )
 retrieve="SELECT
	TradeSector='PH',
	OutletCode= LTRIM(RTRIM(:as_distcode + A.AliasName + SPACE(100))),
	OutletName = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 60))),
	Active = A.Active,
	OutletType=LTRIM(RTRIM(CT.NAME)),
	AreaType = 'RURAL',
	AccountType=LTRIM(RTRIM(CT.NAME)),
	CannelProgram=LTRIM(RTRIM(CT.NAME)),
	Town = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 60))),
	Locality = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 60))),
	SubLocality = LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 60))),
	LastChangedDate = CONVERT(VARCHAR(15), GETDATE(), 104),
	LastChangedTime = CONVERT(VARCHAR(15), GETDATE(), 108)
FROM Customer C, Accounts A, Area AR, CUSTOMERCATEGORY CT
WHERE C.CustCode = A.AccCode AND 
	C.AreaCode = AR.AreaCode AND 
	C.CUSTCATCODE = CT.CUSTCATCODE
"
  arguments=(("as_distcode", string))
)
