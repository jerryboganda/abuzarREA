detail(height=92 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=custid dbname="CUSTID"  )
column=(type=char(8000) updatewhereclause=yes name=ct dbname="CT"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="CUSTNAME"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="ADDRESS"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="CITY"  )
column=(type=long updatewhereclause=yes name=townid dbname="TOWNID"  )
column=(type=char(60) updatewhereclause=yes name=town dbname="TOWN"  )
 retrieve="SELECT 
	DSTBID=Ar.TAG,
	CUSTID = C.CustCode,
	CT=REPLICATE('0', 2 - LEN(LTRIM(RTRIM(STR(C.CustCatCode))))) + LTRIM(RTRIM(STR(C.CustCatCode))),
/*	CT='03',*/
	CUSTNAME = A.Name,
	ADDRESS = C.ADDRESS1,
	CITY = C.CITY, 
	TOWNID=AR.AREACODE, 
	TOWN = AR.NAME
FROM Customer C, Accounts A, Area AR
WHERE C.CustCode = A.AccCode AND C.AreaCode = AR.AreaCode
"
 )
