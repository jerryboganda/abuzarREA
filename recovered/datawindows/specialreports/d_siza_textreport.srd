release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=528 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=mainarea dbname="MainArea"  )
column=(type=char(13) updatewhereclause=yes name=subareacode dbname="Subareacode"  )
column=(type=char(60) updatewhereclause=yes name=subarea dbname="SUBAREA"  )
column=(type=char(12) updatewhereclause=yes name=chemistcode dbname="chemistcode"  )
column=(type=char(60) updatewhereclause=yes name=chemistname dbname="chemistname"  )
column=(type=char(12) updatewhereclause=yes name=productcode dbname="productcode"  )
column=(type=char(60) updatewhereclause=yes name=productname dbname="productname"  )
column=(type=char(14) updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=char(12) updatewhereclause=yes name=date dbname="DATE"  )
column=(type=char(10) updatewhereclause=yes name=saleunits dbname="SaleUnits"  )
column=(type=char(11) updatewhereclause=yes name=bonusunits dbname="BonusUnits"  )
column=(type=char(11) updatewhereclause=yes name=bonusvalue dbname="BonusValue"  )
column=(type=char(13) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=char(14) updatewhereclause=yes name=discountvalue dbname="DiscountValue"  )
column=(type=char(15) updatewhereclause=yes name=price dbname="Price"  )
column=(type=char(15) updatewhereclause=yes name=sales dbname="Sales"  )
 retrieve="SELECT  
	MainArea= LEFT(AR.Name, 60),
	Subareacode = STR(SA.SubAreaCode, 13),
	SUBAREA = LEFT(SA.Name, 60), 
	chemistcode = STR(C.CustCode, 12),
	chemistname = LEFT(A.Name, 60),
	productcode = STR(I.ICODE, 12),
	productname = LEFT(I.Name, 60),
	invcode = STR(SL.SaleInvCode, 14),
	DATE = CONVERT(VARCHAR(12), SL.Date, 103),
	SaleUnits = STR(SD.LooseQty, 10, 0),
	BonusUnits=STR(SD.BonusQty, 11, 0),
	BonusValue=STR(SD.BonusQty * (SD.SalePrice - SD.ItemFlatDisc), 11, 2),
	DiscPerc = STR(SD.DiscPerc, 13, 2),
	DiscountValue = STR((SD.LooseQty * SD.ItemFlatDisc) + (SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * SD.DiscPerc * 0.01), 14, 2),
	Price = STR((SD.SalePrice - SD.ItemFlatDisc), 15, 2),
	Sales = STR((SD.SalePrice - SD.ItemFlatDisc) * SD.LooseQty, 15, 2)
FROM
	SaleLedger SL, 
	SaleDetail SD,
	Item I,
	Manufacturer M,
	Customer C,
	Accounts A,
	Area AR,
	SubArea SA
WHERE
	SL.Date BETWEEN :adt_startdate AND :adt_enddate AND 
	SL.SaleInvCode = SD.SaleInvCode AND
	SD.ICode = I.ICode AND
	I.ManfCode = M.ManfCode AND
	M.ManfCode = :ai_manfcode AND 
	SL.CustCode = C.CustCode AND 
	C.CustCode = A.AccCode AND
	C.AreaCode = AR.AreaCode AND
	C.SubAreaCode = SA.SubAreaCode
UNION ALL
SELECT 
	MainArea= LEFT(AR.Name, 60),
	Subareacode = STR(SA.SubAreaCode, 13),
	SUBAREA = LEFT(SA.Name, 60),
	chemistcode = STR(C.CustCode, 12),
	chemistname = LEFT(A.Name, 60),
	productcode = STR(I.ICODE, 12),
	productname = LEFT(I.Name, 60),
	invcode = STR(SL.SRInvCode, 14),
	DATE = CONVERT(VARCHAR(12), SL.Date, 103),
	SaleUnits = STR(-SD.LooseQty, 10, 0),
	BonusUnits=STR(-SD.BonusQty, 11, 0),
	BonusValue=STR(-(SD.BonusQty * SD.SRPrice), 11, 2),
	DiscPerc = STR(SD.DiscPerc, 13, 2),
	DiscountValue = STR(-(SD.LooseQty * SD.SRPrice * SD.DiscPerc * 0.01), 14, 2),
	Price = STR(SD.SRPrice, 15, 2),
	Sales = STR(-(SD.SRPrice * SD.LooseQty), 15, 2)
FROM
	SRLedger SL, 
	SRDetail SD,
	Item I,
	Manufacturer M,
	Customer C,
	Accounts A,
	Area AR,
	SubArea SA
WHERE
	SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
	SL.SRInvCode = SD.SRInvCode AND
	SD.ICode = I.ICode AND
	I.ManfCode = M.ManfCode AND
	M.ManfCode = :ai_manfcode AND 
	SL.CustCode = C.CustCode AND 
	C.CustCode = A.AccCode AND
	C.AreaCode = AR.AreaCode AND
	C.SubAreaCode = SA.SubAreaCode
ORDER BY
	MAINAREA,
	SUBAREA,
	chemistname,
	DATE"
  arguments=(("ai_manfcode", number), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
compute(name=compute_2 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-12" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="9" y="92" height="76" width="3058" format="[GENERAL]" expression="f_ReportHeaderInfo('clientname')" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_3 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-12" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="9" y="180" height="76" width="3058" format="[GENERAL]" expression="'From  # ' + string(adt_startdate, 'dd/mm/yyyy') + '  To   # ' + string(adt_enddate, 'dd/mm/yyyy')" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_4 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-12" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="9" y="268" height="76" width="3058" format="[GENERAL]" expression="FILL('=', 407)" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_5 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-12" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="9" y="356" height="76" width="3058" format="[GENERAL]" expression="'MAIN AREA' + SPACE(52) + 'Sub-Area Code ' + 'Sub Area' + SPACE(53) + 'Chemist Code ' + 'Chemist Name' + SPACE(49) + 'Product Code ' + 'Product Name' + SPACE(49) + 'Invoice Number ' + 'Invoice Date ' + 'Sale Units ' + 'Bonus Units ' + 'Bonus Value ' + 'Discount %Age ' + 'Discount Value ' + 'Price' + SPACE(11) + 'Sale Value'" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_6 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-12" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="9" y="444" height="76" width="3058" format="[GENERAL]" expression="FILL('=', 407)" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_1 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-12" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="9" y="12" height="68" width="256" format="[GENERAL]" expression="''" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_7 visible="1" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-12" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="14" y="4" height="76" width="3058" format="[GENERAL]" expression="mainarea + SPACE(60 - len(mainarea) + 1) + subareacode + ' ' + subarea + SPACE(60 - len(subarea) + 1) + chemistcode + ' ' + chemistname + SPACE(60 - len(chemistname) + 1) + productcode + ' ' + productname + SPACE(60 - len(productname) + 1) + invcode + ' ' + date + '   ' +  saleunits + ' ' + bonusunits + ' ' +  bonusvalue + ' ' +  discperc + ' ' +  discountvalue + ' ' + price + ' ' + sales" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
htmltable(border="1" )
