table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=prdidlen dbname="PRDIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=prdid dbname="PRDID"  )
column=(type=long updatewhereclause=yes name=batchnolen dbname="BatchNoLen"  )
column=(type=char(100) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=long updatewhereclause=yes name=closingstocklen dbname="ClosingStockLen"  )
column=(type=char(12) updatewhereclause=yes name=closingstock dbname="ClosingStock"  )
column=(type=long updatewhereclause=yes name=expirylen dbname="ExpiryLEN"  )
column=(type=char(8000) updatewhereclause=yes name=expiry dbname="Expiry"  )
 retrieve="SELECT
	DSTBIDLEN=6,
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(I.CustomICode, 1, 9))))),
	BatchNoLen=10,
	BatchNo=GD.Batch,
	ClosingStockLen=12,
	ClosingStock=STR(SUM(ISNULL(GD.CurrQty, 0)), 12),
	ExpiryLEN=11,
	Expiry=REPLACE(Convert(varchar(11), GD.Expiry, 106), ' ', '-')
FROM
	Item I,
	GodownDetail GD
WHERE
	I.ManfCode IN (:ai_manfcode) AND
	I.ICode = GD.ICode
GROUP BY
	I.ICode,
	I.Name,
	I.CustomICode,
	GD.Batch,
	GD.Expiry
HAVING SUM(ISNULL(GD.CurrQty, 0)) <> 0
ORDER BY
	PRDID,
	Batch,
	Expiry"
  arguments=(("ai_manfcode", number), ("as_distcode", string), ("adt_enddate", datetime))
)
