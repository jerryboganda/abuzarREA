release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=93 color="536870912" )
table(column=(type=char(8000) updatewhereclause=yes name=dscode dbname="DSCode"  )
column=(type=char(8000) updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(75) updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(12) updatewhereclause=yes name=transferin dbname="TransferIn"  )
column=(type=char(12) updatewhereclause=yes name=marketsale dbname="MarketSale"  )
column=(type=char(12) updatewhereclause=yes name=instsale dbname="InstSale"  )
column=(type=char(12) updatewhereclause=yes name=transferout dbname="TransferOut"  )
column=(type=char(12) updatewhereclause=yes name=otherout dbname="OtherOut"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
 retrieve="SELECT
	DSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	Date=LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(100), ST.Date, 106), ' ', '-')))),
	ItemCode=LTRIM(RTRIM(I.CustomICode)),
	TransferIn = LTRIM(RTRIM(STR(SUM(CASE WHEN ST.type='PV' THEN ST.qty + ST.bonus ELSE 0 END), 12))),
	MarketSale = LTRIM(RTRIM(STR(SUM(CASE WHEN ST.type='MAS' THEN ST.qty + ST.bonus ELSE 0 END), 12))),
	InstSale = LTRIM(RTRIM(STR(SUM(CASE WHEN ST.type='INS' THEN ST.qty + ST.bonus ELSE 0 END), 12))),
	TransferOut = LTRIM(RTRIM(STR(SUM(CASE WHEN ST.type='PR' THEN ST.qty + ST.bonus ELSE 0 END), 12))),
	OtherOut = LTRIM(RTRIM(STR(0, 12))),
	Batch = ST.Batch
FROM
	(SELECT 
		type='MAS',
		Date=SL.Date,
		sd.icode,
		sd.batch,
		qty = sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus = sum(sd.bonusqty)
	FROM saleledger sl, saledetail sd, item i, customer c, customercategory cc
	WHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
		sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sl.custcode = c.custcode and c.custcatcode = cc.custcatcode AND
		UPPER(LEFT(cc.name, 1)) <> 'I' AND
		sd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By sl.date, sd.icode, sd.batch
	UNION ALL
	SELECT 
		type='MAS',
		Date=SL.Date,
		sd.icode,
		sd.batch,
		qty = - sum(sd.looseqty),
		bonus = - sum(sd.bonusqty)
	FROM SRledger sl, SRDetail sd, item i, customer c, customercategory cc
	WHERE sl.posted = 'Y' AND sl.SRinvcode = sd.SRinvcode AND 
		sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sl.custcode = c.custcode and c.custcatcode = cc.custcatcode AND
		UPPER(LEFT(cc.name, 1)) <> 'I' AND
		sd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By sl.date, sd.icode, sd.batch
	UNION ALL
	SELECT 
		type='INS',
		Date=SL.Date,
		sd.icode,
		sd.batch,
		qty = sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus = sum(sd.bonusqty)
	FROM saleledger sl, saledetail sd, item i, customer c, customercategory cc
	WHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
		sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sl.custcode = c.custcode and c.custcatcode = cc.custcatcode AND
		UPPER(LEFT(cc.name, 1)) = 'I' AND
		sd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By SL.Date, sd.icode, sd.batch
	UNION ALL
	SELECT 
		type='INS',
		Date=SL.Date,
		sd.icode,
		sd.batch,
		qty = - sum(sd.looseqty),
		bonus = - sum(sd.bonusqty)
	FROM SRLedger sl, SRDetail sd, item i, customer c, customercategory cc
	WHERE sl.posted = 'Y' AND sl.SRInvcode = sd.SRInvcode AND 
		sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sl.custcode = c.custcode and c.custcatcode = cc.custcatcode AND
		UPPER(LEFT(cc.name, 1)) = 'I' AND
		sd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By SL.Date, sd.icode, sd.batch
	UNION ALL
	select	
		type='PV',
		Date=PL.Date,
		pd.icode,
		pd.batch,
		qty = sum((pd.packqty * pd.packunits) + pd.looseqty),
		bonus = sum(pd.bonusqty * pd.packunits)
	FROM PurLedger pl, PurDetail pd, item i
	WHERE pl.posted = 'Y' AND pl.PurInvCode = pd.PurInvCode AND
	    pl.date BETWEEN :ar_startdate and :ar_enddate AND
		pd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By PL.Date, pd.icode, pd.batch
	UNION ALL
	select	
		type='PR',
		Date=PL.Date,
		pd.icode,
		pd.batch,
		qty = sum(pd.looseqty),
		bonus = sum(pd.bonusqty)
	FROM PRLedger pl, PRDetail pd, item i
	WHERE pl.posted = 'Y' AND pl.PRInvCode = pd.PRInvCode AND
	    pl.date BETWEEN :ar_startdate and :ar_enddate AND
		pd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By PL.Date, pd.icode, pd.batch
/*	UNION ALL
	SELECT type='OP', Date=:ar_startdate, icode, qty = 0, bonus = 0
	FROM ITEM WHERE Item.ManfCode IN (:ai_manfcode)*/) St, 
	Item i
WHERE st.icode = i.icode
GROUP BY LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(100), ST.Date, 106), ' ', '-')))), i.name, i.customicode, ST.Batch
ORDER BY i.customicode, ST.Batch, Date
"
  arguments=(("as_distcode", string), ("ai_manfcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
