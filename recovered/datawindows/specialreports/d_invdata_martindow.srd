detail(height=84 color="536870912" )
table(column=(type=char(101) updatewhereclause=yes name=distributorcode dbname="DistributorCode"  )
column=(type=char(100) updatewhereclause=yes name=distributername dbname="DistributerName"  )
column=(type=char(30) updatewhereclause=yes name=customertype dbname="CustomerType"  )
column=(type=char(12) updatewhereclause=yes name=customerno dbname="CustomerNo"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=long updatewhereclause=yes name=brickcode dbname="BrickCode"  )
column=(type=char(60) updatewhereclause=yes name=brickname dbname="BrickName"  )
column=(type=long updatewhereclause=yes name=invoiceno dbname="InvoiceNo"  )
column=(type=datetime updatewhereclause=yes name=invoicedate dbname="InvoiceDate"  )
column=(type=char(75) updatewhereclause=yes name=productcode dbname="ProductCode"  )
column=(type=char(100) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=decimal(4) updatewhereclause=yes name=salesqty dbname="SalesQty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=decimal(6) updatewhereclause=yes name=salesamount dbname="SalesAmount"  )
column=(type=decimal(6) updatewhereclause=yes name=discountamount dbname="DiscountAmount"  )
 retrieve="SELECT 
	DistributorCode=RTRIM(LTRIM(:as_distcode+SPACE(100))),
	DistributerName=SPACE(100),
	CustomerType=CC.Name,
	CustomerNo=AC.AliasName,
	CustomerName=AC.Name,
	BrickCode=SA.SubAreaCode,
	BrickName=SA.Name,
	InvoiceNo=SL.SaleInvCode,
	InvoiceDate=SL.Date,
	ProductCode=I.CustomICode,
	BatchNo=SD.Batch,
	SalesQty=SD.LooseQty,
	BonusQty=SD.BonusQty,
	SalesAmount=Round(SD.LooseQty * SD.SalePrice, 2),
	DiscountAmount=Round((SD.LooseQty * SD.ItemFlatDisc) + 
		(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)) + 
		(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (SL.DiscPerc * 0.01)), 2)
FROM 
	SaleLedger SL, SaleDetail SD, Item I, Customer C, Accounts AC, CustomerCategory CC, SubArea SA
WHERE 
	SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SD.ICode = I.ICOde AND
	I.ManfCode = :ai_manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = AC.AccCode AND
	C.SubAreaCode = SA.SubAreaCode AND
	C.CustCatCode = CC.CustCatCode
UNION ALL
SELECT 
	DistributorCode=RTRIM(LTRIM(:as_distcode+SPACE(100))),
	DistributerName=SPACE(100),
	CustomerType=CC.Name,
	CustomerNo=AC.AliasName,
	CustomerName=AC.Name,
	BrickCode=SA.SubAreaCode,
	BrickName=SA.Name,
	InvoiceNo=SL.SRInvCode,
	InvoiceDate=SL.PostDate,
	ProductCode=I.CustomICode,
	BatchNo=SD.Batch,
	SalesQty= - SD.LooseQty,
	BonusQty= - SD.BonusQty,
	SalesAmount= - Round(SD.LooseQty * SD.SRPrice, 2),
	DiscountAmount= - Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)) + 
		(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (SL.DiscPerc * 0.01)), 2)
FROM 
	SRLedger SL, SRDetail SD, Item I, Customer C, Accounts AC, CustomerCategory CC, SubArea SA
WHERE 
	SL.PostDate BETWEEN :adt_startdate AND :adt_enddate AND
	SL.SRInvCode = SD.SRInvCode AND
	SD.ICode = I.ICOde AND
	I.ManfCode = :ai_manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = AC.AccCode AND
	C.SubAreaCode = SA.SubAreaCode AND
	C.CustCatCode = CC.CustCatCode
"
  arguments=(("as_distcode", string), ("ai_manfcode", number), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
