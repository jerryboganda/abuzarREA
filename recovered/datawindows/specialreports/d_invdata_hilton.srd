table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(6) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=documentnolen dbname="DOCUMENTNOLEN"  )
column=(type=char(10) updatewhereclause=yes name=documentno dbname="DOCUMENTNO"  )
column=(type=long updatewhereclause=yes name=docdatelen dbname="DOCDATELEN"  )
column=(type=char(10) updatewhereclause=yes name=docdate dbname="DOCDATE"  )
column=(type=long updatewhereclause=yes name=custidlen dbname="CUSTIDLEN"  )
column=(type=char(10) updatewhereclause=yes name=custid dbname="CUSTID"  )
column=(type=long updatewhereclause=yes name=prdidlen dbname="PRDIDLEN"  )
column=(type=char(9) updatewhereclause=yes name=prdid dbname="PRDID"  )
column=(type=long updatewhereclause=yes name=batchnolen dbname="BatchNoLEN"  )
column=(type=char(10) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=long updatewhereclause=yes name=expdatelen dbname="EXPDATELEN"  )
column=(type=char(10) updatewhereclause=yes name=expdate dbname="EXPDATE"  )
column=(type=long updatewhereclause=yes name=pricelen dbname="PRICELEN"  )
column=(type=char(12) updatewhereclause=yes name=price dbname="PRICE"  )
column=(type=long updatewhereclause=yes name=actuallen dbname="ACTUALLEN"  )
column=(type=char(12) updatewhereclause=yes name=actual dbname="ACTUAL"  )
column=(type=long updatewhereclause=yes name=returnslen dbname="ReturnsLEN"  )
column=(type=char(12) updatewhereclause=yes name=returns dbname="Returns"  )
column=(type=long updatewhereclause=yes name=expiredlen dbname="EXPIREDLEN"  )
column=(type=char(12) updatewhereclause=yes name=expired dbname="EXPIRED"  )
column=(type=long updatewhereclause=yes name=bonuslen dbname="BonusLEN"  )
column=(type=char(12) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=long updatewhereclause=yes name=discountlen dbname="DISCOUNTLEN"  )
column=(type=char(12) updatewhereclause=yes name=discount dbname="DISCOUNT"  )
 retrieve="SELECT 
	DSTBIDLEN=6,
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	DOCUMENTNOLEN=10,
	DOCUMENTNO = STR(SL.SaleInvCode, 10),
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = STR(SL.CustCode, 10),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.Remarks)), 1, 9),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	EXPDATELEN=10,
	EXPDATE=Convert(varchar(10), SD.Expiry, 103),
	PRICELEN=12,
	PRICE=STR(SD.SalePrice, 12, 2),
	ACTUALLEN=12,
	ACTUAL=STR(SD.LooseQty, 12),
	ReturnsLEN=12,
	Returns=STR(0, 12),
	EXPIREDLEN=12,
	EXPIRED=STR(0, 12),
	BonusLEN=12,
	Bonus=STR(SD.BonusQty, 12),
	DISCOUNTLEN=12,
	DISCOUNT=STR(Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + SD.ItemFlatDisc, 12, 2)
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	CustomerCategory CC,
	Item I
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6,
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	DOCUMENTNOLEN=10,
	DOCUMENTNO = STR(SL.SRInvCode, 10),
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = STR(SL.CustCode, 10),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.Remarks)), 1, 9),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	EXPDATELEN=10,
	EXPDATE=Convert(varchar(10), SD.Expiry, 103),
	PRICELEN=12,
	PRICE=STR(SD.SRPrice, 12, 2),
	ACTUALLEN=12,
	ACTUAL=STR(0, 12),
	ReturnsLEN=12,
	Returns=STR(SD.LooseQty, 12),
	EXPIREDLEN=12,
	EXPIRED=STR(0, 12),
	BonusLEN=12,
	Bonus=STR(SD.BonusQty, 12),
	DISCOUNTLEN=12,
	DISCOUNT=STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2)
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	CustomerCategory CC,
	Item I

WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
"
  arguments=(("manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
