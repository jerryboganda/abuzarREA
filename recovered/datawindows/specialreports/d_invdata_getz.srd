column=(type=long updatewhereclause=yes name=custaddresslen dbname="CUSTADDRESSLen"  )
column=(type=char(8000) updatewhereclause=yes name=custaddress dbname="CUSTADDRESS"  )
 retrieve="SELECT 
	DSTBIDLEN=6, 
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = STR(SL.SaleInvCode, 12),
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = LTRIM(RTRIM(SUBSTRING(A.AliasName, 1, 10))) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(A.AliasName, 1, 10))))),
	CTLen = 2,
	CT = STR(CC.CustCatCode, 2),
	CUSTNAMELEN=50,
	CUSTNAME = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))))),
	TOWNIDLEN=16,
	TOWNID=STR(AR.AREACODE, 16),
	TOWNLEN=50,
	TOWN = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))))),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.Remarks)), 1, 9) + REPLICATE(' ', 9 - LEN(LTRIM(RTRIM(SUBSTRING(I.Remarks, 1, 9))))),
	PRDLEN=50,
	PRD = LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))))),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(SD.Batch, 1, 10))))),
	PRICELEN=12,
	PRICE=STR(SD.SalePrice, 12, 2),
	QUANTITYLEN=12,
	QUANTITY=STR(SD.LooseQty, 12),
	BONUSLEN=12,
	BONUS=STR(SD.BonusQty, 12),
	GROSSAMOUNTLEN=12,
	GROSSAMOUNT=STR(SD.SalePrice * SD.LooseQty, 12, 2),
	DISCOUNTLEN=12,
	DISCOUNT=STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) + (SD.ItemFlatDisc * SD.LooseQty), 12, 2),
	NETAMOUNTLEN = 12,
	NETAMOUNT = STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2),
	REASONLEN = 1,
	REASON = 'S',
	CUSTADDRESSLen=60,
	CUSTADDRESS=LTRIM(RTRIM(SUBSTRING(C.Address1, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(C.Address1, 1, 60)))))
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	CustomerCategory CC,
	Accounts A,
	Area AR,
	Item I
WHERE
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate AND
	SL.POSTED = 'Y' AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode
UNION ALL
SELECT 
	DSTBIDLEN=6,
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = STR(SL.SRInvCode, 12),
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = LTRIM(RTRIM(SUBSTRING(A.AliasName, 1, 10))) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(A.AliasName, 1, 10))))),
	CTLen = 2,
	CT = STR(CC.CustCatCode, 2),
	CUSTNAMELEN=50,
	CUSTNAME = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))))),
	TOWNIDLEN=16,
	TOWNID=STR(AR.AREACODE, 16),
	TOWNLEN=50,
	TOWN = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))))),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.Remarks)), 1, 9) + REPLICATE(' ', 9 - LEN(LTRIM(RTRIM(SUBSTRING(I.Remarks, 1, 9))))),
	PRDLEN=50,
	PRD = LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))))),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(SD.Batch, 1, 10))))),
	PRICELEN=12,
	PRICE=STR(SD.SRPrice, 12, 2),
	QUANTITYLEN=12,
	QUANTITY=STR(- (SD.LooseQty), 12),
	BONUSLEN=12,
	BONUS=STR(- (SD.BonusQty), 12),
	GROSSAMOUNTLEN=12,
	GROSSAMOUNT=STR(- (SD.SRPrice * SD.LooseQty), 12, 2),
	DISCOUNTLEN=12,
	DISCOUNT=STR(- (Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2)), 12, 2),
	NETAMOUNTLEN = 12,
	NETAMOUNT = STR(- (Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2)), 12, 2),
	REASONLEN = 1,
	REASON = CASE WHEN DATEDIFF(day, SL.Date, SD.Expiry) > 180 THEN 'R' ELSE 'E' END,
	CUSTADDRESSLen=60,
	CUSTADDRESS=LTRIM(RTRIM(SUBSTRING(C.Address1, 1, 60))) + REPLICATE(' ', 60 - LEN(LTRIM(RTRIM(SUBSTRING(C.Address1, 1, 60)))))
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	CustomerCategory CC,
	Accounts A,
	Area AR,
	Item I
WHERE
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate AND
	SL.POSTED = 'Y' AND
	SL.SRInvCode = SD.SRInvCode AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode
ORDER BY
	DOCDATE,
	PRD,
	REASON"
  arguments=(("manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
