footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=townidlen dbname="TOWNIDLEN"  )
column=(type=char(16) updatewhereclause=yes name=townid dbname="TOWNID"  )
column=(type=long updatewhereclause=yes name=townlen dbname="TOWNLEN"  )
column=(type=char(8000) updatewhereclause=yes name=town dbname="TOWN"  )
 retrieve="SELECT
	DSTBIDLEN=6,
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	TOWNIDLEN=16,
	TOWNID=STR(AR.AREACODE, 16),
	TOWNLEN=50,
	TOWN = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50)))))
FROM
	Area AR
ORDER BY
	Town"
  arguments=(("as_distcode", string))
)
