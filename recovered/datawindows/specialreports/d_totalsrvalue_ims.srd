release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=companycodelen dbname="CompanyCodeLEN"  )
column=(type=char(6) updatewhereclause=yes name=companycode dbname="CompanyCode"  )
column=(type=long updatewhereclause=yes name=totalqtylen dbname="TotalQtyLen"  )
column=(type=char(12) updatewhereclause=yes name=totalqty dbname="TotalQty"  )
column=(type=long updatewhereclause=yes name=totalvaluelen dbname="TotalValueLen"  )
column=(type=char(15) updatewhereclause=yes name=totalvalue dbname="TotalValue"  )
 retrieve="SELECT
	CompanyCodeLEN=6,
	CompanyCode=STR(S.CompanyCode, 6),
	TotalQtyLen=12, 
	TotalQty=STR(Sum(S.Qty), 12),
	TotalValueLen=15,
	TotalValue=STR(Sum(S.Value), 15, 2)
FROM
	(SELECT
		CustCode=S.CustCode,
		ProdCode=SD.ICode,
		CompanyCode = I.ManfCode,
		Qty=CAST(Sum(SD.LooseQty) / (CASE WHEN :ai_loosepack = 0 THEN 1 ELSE CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END END) AS INT),
		Tp=CASE WHEN :ai_loosepack = 0 THEN ROUND((I.SalePrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END), 2) ELSE I.SalePrice END,
		Value=CAST(Sum(SD.LooseQty) / (CASE WHEN :ai_loosepack = 0 THEN 1 ELSE CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END END) AS INT) * (CASE WHEN :ai_loosepack = 0 THEN ROUND((I.SalePrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END), 2) ELSE I.SalePrice END),
		DATE=Convert(varchar(10), S.DATE, 103)
	FROM
		SRLedger S, SRDetail SD, Item I
	WHERE
		S.Date BETWEEN :ar_startdate AND :ar_enddate AND
		S.SRInvCode = SD.SRInvCode AND 
		SD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode) AND
		:ai_scope = 1
	GROUP BY
		S.CustCode, 
		SD.ICode,
		S.Date,
		I.ManfCode,
		I.SalePrice,
		I.PackUnits
	UNION ALL
	SELECT
		CustCode=S.CustCode,
		ProdCode=SD.ICode,
		CompanyCode = I.ManfCode,
		Qty=CAST(Sum(SD.LooseQty) / (CASE WHEN :ai_loosepack = 0 THEN 1 ELSE CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END END) AS INT),
		Tp=CASE WHEN :ai_loosepack = 0 THEN ROUND((I.SalePrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END), 2) ELSE I.SalePrice END,
		Value=CAST(Sum(SD.LooseQty) / (CASE WHEN :ai_loosepack = 0 THEN 1 ELSE CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END END) AS INT) * (CASE WHEN :ai_loosepack = 0 THEN ROUND((I.SalePrice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END), 2) ELSE I.SalePrice END),
		DATE=Convert(varchar(10), S.DATE, 103)
	FROM
		CRS_ClientInstance CI, CRS_ClientList CL, CRS_SRLedger S, CRS_SRDetail SD, Item I
	WHERE
		CL.ClientID = CI.ClientID AND CI.ClientInstanceID = S.ClientInstanceID AND
		S.SRInvCode = SD.SRInvCode AND 
		S.Date BETWEEN :ar_startdate AND :ar_enddate AND
		SD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode) AND
		:ai_scope = 2
	GROUP BY
		S.CustCode, 
		SD.ICode,
		S.Date,
		I.ManfCode,
		I.SalePrice,
		I.PackUnits) S
GROUP BY
	S.CompanyCode
ORDER BY
	CompanyCode
"
  arguments=(("ai_manfcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ai_loosepack", number), ("ai_scope", number))
)
