detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=invoicelen dbname="InvoiceLEN"  )
column=(type=char(10) updatewhereclause=yes name=invoice dbname="Invoice"  )
column=(type=long updatewhereclause=yes name=datelen dbname="DateLEN"  )
column=(type=char(10) updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=custcodelen dbname="CustCodeLEN"  )
column=(type=char(8000) updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=long updatewhereclause=yes name=prodcodelen dbname="ProdCodeLEN"  )
column=(type=char(9) updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=long updatewhereclause=yes name=batchlen dbname="BatchLEN"  )
column=(type=char(10) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=long updatewhereclause=yes name=unitslen dbname="UnitsLEN"  )
column=(type=char(12) updatewhereclause=yes name=units dbname="Units"  )
column=(type=long updatewhereclause=yes name=bonuslen dbname="BonusLEN"  )
column=(type=char(12) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=long updatewhereclause=yes name=discountlen dbname="DiscountLEN"  )
column=(type=char(12) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=long updatewhereclause=yes name=netvaluelen dbname="NetValueLEN"  )
column=(type=char(12) updatewhereclause=yes name=netvalue dbname="NetValue"  )
column=(type=long updatewhereclause=yes name=flaglen dbname="FlagLen"  )
column=(type=char(1) updatewhereclause=yes name=flag dbname="Flag"  )
column=(type=long updatewhereclause=yes name=dscodeen dbname="DSCodeEN"  )
column=(type=char(6) updatewhereclause=yes name=dscode dbname="DSCode"  )
 retrieve="SELECT 
	InvoiceLEN=10,
	Invoice = STR(SL.SaleInvCode, 10),
	DateLEN=10,
	Date=Convert(varchar(10), SL.DATE, 103),
	CustCodeLEN=12,
	CustCode  = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),
	ProdCodeLEN=9,
	ProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	BatchLEN=10,
	Batch=SUBSTRING(SD.Batch, 1, 10),
	UnitsLEN=12,
	Units=STR(SD.LooseQty, 12),
	BonusLEN=12,
	Bonus=STR(SD.BonusQty, 12),
	DiscountLEN=12,
	Discount=STR(
			Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + 
			(SD.LooseQty * SD.ItemFlatDisc), 12, 2),
	NetValueLEN=12,
	NetValue=STR(
			Round((SD.LooseQty * SD.SalePrice * (1 - SD.DiscPerc * 0.01)), 2) + 
			(SD.LooseQty * SD.ItemFlatDisc), 12, 2),
	FlagLen=1,
	Flag='S',
	DSCodeEN=6,
	DSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode))
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
UNION ALL
SELECT 
	InvoiceLEN=10,
	Invoice = STR(SL.SRInvCode, 10),
	DateLEN=10,
	Date=Convert(varchar(10), SL.DATE, 103),
	CodeLEN=12,
	CustCode  = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 12 - LEN(LTRIM(RTRIM(A.AliasName)))),
	ProdCodeLEN=9,
	ProdCode=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	BatchLEN=10,
	Batch=SUBSTRING(SD.Batch, 1, 10),
	UnitsLEN=12,
	Units=STR(SD.LooseQty, 12),
	BonusLEN=12,
	Bonus=STR(SD.BonusQty, 12),
	DiscountLEN=12,
	Discount=STR(Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2), 12, 2),
	NetValueLEN=12,
	NetValue=STR(
			Round((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01)), 2), 12, 2),
	FlagLen=1,
	Flag='R',
	DSCodeEN=6,
	DSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode))
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Accounts A,
	CustomerCategory CC,
	Item I

WHERE
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
"
  arguments=(("manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
