column=(type=long updatewhereclause=yes name=customerlen dbname="CustomerLen"  )
column=(type=char(50) updatewhereclause=no name=customer dbname="Customer"  )
column=(type=long updatewhereclause=yes name=addresslen dbname="AddressLen"  )
