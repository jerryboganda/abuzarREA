column=(type=long updatewhereclause=yes name=longitudelen dbname="LongitudeLen"  )
column=(type=char(30) updatewhereclause=no name=longitude dbname="Longitude"  )
 retrieve="SELECT 
	DSTBIDLEN=6, 
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SaleInvCode, 12))), 1, 12), 
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = SUBSTRING(LTRIM(RTRIM(STR(SL.CustCode, 10))), 1, 10), 
	CTLEN=2,
	CT=CASE 
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN '01'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN '02'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN '03'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN '04'
		ELSE '02' END,
	TownIDLEN=16,
	TownID=SUBSTRING(LTRIM(RTRIM(STR(C.AREACODE, 16))), 1, 16), 
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	PRICELEN=12,
	PRICE=SUBSTRING(LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))), 1, 12), 
	QuantityLEN=12,
	Quantity=SUBSTRING(LTRIM(RTRIM(STR(SD.LooseQty, 12, 2))), 1, 12),
	BonusLEN=12,
	Bonus=SUBSTRING(LTRIM(RTRIM(STR(SD.BonusQty, 12, 2))), 1, 12), 
	DISCOUNTAMNTLEN=12,
	DISCOUNTAMNT=SUBSTRING(LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + SD.ItemFlatDisc, 12, 2))),1, 12),
	NetAmtLEN=12,
	NetAmt=SUBSTRING(LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2))), 1, 12),
	LineTypeLen=1,
	LineType = 'S',
	TOWNLEN=50,
	TOWN = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))))),
	CustomerLen = 50,
	Customer = ISNULL(LEFT(LTRIM(RTRIM(A.Name)), 50), SPACE(50)),
	AddressLen = 50,
	Address = ISNULL(LEFT(LTRIM(RTRIM(C.Address1)), 50), SPACE(50)),
	CustStatusLen=10,
	CustStatus='Open',
	LatitudeLen = 30,
	Latitude = SPACE(30),
	LongitudeLen=30,
	Longitude=SPACE(30)
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	Area AR,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	:ai_scope=1 AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.CustCatCode = CC.CustCatCode AND
	C.AreaCode = AR.AreaCode AND
	C.CustCode = A.AccCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6,
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SRInvCode, 12))), 1, 12), 
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = SUBSTRING(LTRIM(RTRIM(STR(SL.CustCode, 10))), 1, 10), 
	CTLEN=2,
	CT=CASE 
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN '01'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN '02'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN '03'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN '04'
		ELSE '02' END,
	TownIDLEN=16,
	TownID=SUBSTRING(LTRIM(RTRIM(STR(C.AREACODE, 16))), 1, 16), 
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	PRICELEN=12,
	PRICE=SUBSTRING(LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))), 1, 12), 
	QuantityLEN=12,
	Quantity=SUBSTRING(LTRIM(RTRIM(STR(- SD.LooseQty, 12, 2))), 1, 12),
	BonusLEN=12,
	Bonus=SUBSTRING(LTRIM(RTRIM(STR(- SD.BonusQty, 12, 2))), 1, 12), 
	DISCOUNTAMNTLEN=12,
	DISCOUNTAMNT=SUBSTRING(LTRIM(RTRIM(STR(- (Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2)), 12, 2))),1, 12),
	NetAmtLEN=12,
	NetAmt=SUBSTRING(LTRIM(RTRIM(STR(- (Round((SD.LooseQty * SD.SalePrice * (1 - SD.DiscPerc * 0.01)), 2)), 12, 2))), 1, 12),
	LineTypeLen=1,
	LineType = 'R',
	TOWNLEN=50,
	TOWN = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))))),
	CustomerLen = 50,
	Customer = ISNULL(LEFT(LTRIM(RTRIM(A.Name)), 50), SPACE(50)),
	AddressLen = 50,
	Address = ISNULL(LEFT(LTRIM(RTRIM(C.Address1)), 50), SPACE(50)),
	CustStatusLen=10,
	CustStatus='Open',
	LatitudeLen = 30,
	Latitude = SPACE(30),
	LongitudeLen=30,
	Longitude=SPACE(30)
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Area AR,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	:ai_scope=1 AND
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.AreaCode = AR.AreaCode AND
	C.CustCode = A.AccCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6, 
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SaleInvCode, 12))), 1, 12), 
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = SUBSTRING(LTRIM(RTRIM(STR(SL.CustCode, 10))), 1, 10), 
	CTLEN=2,
	CT=CASE 
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN '01'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN '02'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN '03'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN '04'
		ELSE '02' END,
	TownIDLEN=16,
	TownID=SUBSTRING(LTRIM(RTRIM(STR(C.AREACODE, 16))), 1, 16), 
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	PRICELEN=12,
	PRICE=SUBSTRING(LTRIM(RTRIM(STR(SD.SalePrice, 12, 2))), 1, 12), 
	QuantityLEN=12,
	Quantity=SUBSTRING(LTRIM(RTRIM(STR(SD.LooseQty, 12, 2))), 1, 12),
	BonusLEN=12,
	Bonus=SUBSTRING(LTRIM(RTRIM(STR(SD.BonusQty, 12, 2))), 1, 12), 
	DISCOUNTAMNTLEN=12,
	DISCOUNTAMNT=SUBSTRING(LTRIM(RTRIM(STR(Round((SD.LooseQty * SD.SalePrice * (SD.DiscPerc * 0.01)), 2) + SD.ItemFlatDisc, 12, 2))),1, 12),
	NetAmtLEN=12,
	NetAmt=SUBSTRING(LTRIM(RTRIM(STR(Round((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)), 2), 12, 2))), 1, 12),
	LineTypeLen=1,
	LineType = 'S',
	TOWNLEN=50,
	TOWN = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))))),
	CustomerLen = 50,
	Customer = ISNULL(LEFT(LTRIM(RTRIM(A.Name)), 50), SPACE(50)),
	AddressLen = 50,
	Address = ISNULL(LEFT(LTRIM(RTRIM(C.Address1)), 50), SPACE(50)),
	CustStatusLen=10,
	CustStatus='Open',
	LatitudeLen = 30,
	Latitude = SPACE(30),
	LongitudeLen=30,
	Longitude=SPACE(30)
FROM
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	CRS_SaleLedger SL,
	CRS_SaleDetail SD,
	Customer C,
	Area AR,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	:ai_scope=2 AND
	CL.ClientID = CI.ClientID AND CI.ClientInstanceID = SL.ClientInstanceID AND
	SL.ClientInstanceID = SD.ClientInstanceID AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.AreaCode = AR.AreaCode AND
	C.CustCode = A.AccCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
UNION ALL
SELECT 
	DSTBIDLEN=6,
	DSTBID=:as_dstcode + REPLICATE(' ', 6 - LEN(:as_dstcode)),
	DOCUMENTNOLEN=12,
	DOCUMENTNO = SUBSTRING(LTRIM(RTRIM(STR(SL.SRInvCode, 12))), 1, 12), 
	DOCDATELEN=10,
	DOCDATE=Convert(varchar(10), SL.DATE, 103),
	CUSTIDLEN=10,
	CUSTID = SUBSTRING(LTRIM(RTRIM(STR(SL.CustCode, 10))), 1, 10), 
	CTLEN=2,
	CT=CASE 
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'W' THEN '01'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'R' THEN '02'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'I' THEN '03'
		WHEN LEFT((SELECT CT.NAME FROM CUSTOMERCATEGORY CT WHERE CT.CUSTCATCODE = C.CUSTCATCODE), 1) = 'D' THEN '04'
		ELSE '02' END,
	TownIDLEN=16,
	TownID=SUBSTRING(LTRIM(RTRIM(STR(C.AREACODE, 16))), 1, 16), 
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9),
	PRDLEN=50,
	PRD=SUBSTRING(LTRIM(RTRIM(I.Name)), 1, 50),
	BatchNoLEN=10,
	BatchNo=SUBSTRING(SD.Batch, 1, 10),
	PRICELEN=12,
	PRICE=SUBSTRING(LTRIM(RTRIM(STR(SD.SRPrice, 12, 2))), 1, 12), 
	QuantityLEN=12,
	Quantity=SUBSTRING(LTRIM(RTRIM(STR(- SD.LooseQty, 12, 2))), 1, 12),
	BonusLEN=12,
	Bonus=SUBSTRING(LTRIM(RTRIM(STR(- SD.BonusQty, 12, 2))), 1, 12), 
	DISCOUNTAMNTLEN=12,
	DISCOUNTAMNT=SUBSTRING(LTRIM(RTRIM(STR(- (Round((SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01)), 2)), 12, 2))),1, 12),
	NetAmtLEN=12,
	NetAmt=SUBSTRING(LTRIM(RTRIM(STR(- (Round((SD.LooseQty * SD.SalePrice * (1 - SD.DiscPerc * 0.01)), 2)), 12, 2))), 1, 12),
	LineTypeLen=1,
	LineType = 'R',
	TOWNLEN=50,
	TOWN = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))))),
	CustomerLen = 50,
	Customer = ISNULL(LEFT(LTRIM(RTRIM(A.Name)), 50), SPACE(50)),
	AddressLen = 50,
	Address = ISNULL(LEFT(LTRIM(RTRIM(C.Address1)), 50), SPACE(50)),
	CustStatusLen=10,
	CustStatus='Open',
	LatitudeLen = 30,
	Latitude = SPACE(30),
	LongitudeLen=30,
	Longitude=SPACE(30)
FROM
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	CRS_SRLedger SL,
	CRS_SRDetail SD,
	Customer C,
	Area AR,
	Accounts A,
	CustomerCategory CC,
	Item I
WHERE
	:ai_scope=2 AND
	CL.ClientID = CI.ClientID AND CI.ClientInstanceID = SL.ClientInstanceID AND
	SL.ClientInstanceID = SD.ClientInstanceID AND
	SL.SRInvCode = SD.SRInvCode AND
	SL.POSTED = 'Y' AND
	SD.ICode = I.ICode AND
	I.ManfCode = :manfcode AND
	SL.CustCode = C.CustCode AND
	C.AreaCode = AR.AreaCode AND
	C.CustCode = A.AccCode AND
	C.CustCatCode = CC.CustCatCode AND
	SL.DATE >= :ar_startdate AND SL.DATE <= :ar_enddate
"
  arguments=(("as_dstcode", string), ("manfcode", number), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ai_scope", number))
)
