column=(type=char(12) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=long updatewhereclause=yes name=discountamntlen dbname="DISCOUNTAMNTLEN"  )
column=(type=char(12) updatewhereclause=yes name=discountamnt dbname="DISCOUNTAMNT"  )
