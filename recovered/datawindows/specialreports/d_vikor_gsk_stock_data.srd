detail(height=92 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(8000) updatewhereclause=yes name=dscode dbname="DSCode"  )
column=(type=char(75) updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(12) updatewhereclause=yes name=opening dbname="Opening"  )
column=(type=char(12) updatewhereclause=yes name=receiptqty dbname="ReceiptQty"  )
column=(type=char(12) updatewhereclause=yes name=sales dbname="Sales"  )
column=(type=char(12) updatewhereclause=yes name=otherout dbname="OtherOut"  )
column=(type=char(12) updatewhereclause=yes name=closingqty dbname="ClosingQty"  )
column=(type=char(8000) updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=char(8000) updatewhereclause=yes name=expiry dbname="Expiry"  )
 retrieve="SELECT
	DSCode=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	ItemCode=LTRIM(RTRIM(I.CustomICode)),
	Opening	= LTRIM(RTRIM(STR(SUM(CASE WHEN type='OP' THEN qty + bonus ELSE 0 END), 12))),
	ReceiptQty = LTRIM(RTRIM(STR(SUM(CASE TYPE WHEN 'PV' THEN +1 WHEN 'PR' THEN -1 ELSE 0 END * (qty + bonus)), 12))),
	Sales = LTRIM(RTRIM(STR(SUM(CASE TYPE WHEN 'SV' THEN +1 WHEN 'SR' THEN -1 ELSE 0 END * (qty + bonus)), 12))),
	OtherOut = LTRIM(RTRIM(STR(SUM(CASE WHEN TYPE = 'RV' OR TYPE = 'AI' THEN (qty + bonus)  WHEN TYPE = 'IV' OR TYPE = 'AD' OR TYPE = 'DS' THEN - (qty + bonus) ELSE 0 END), 12))),
	ClosingQty = LTRIM(RTRIM(STR(SUM(
		CASE WHEN TYPE = 'OP' OR TYPE = 'PV' OR TYPE = 'SR' OR TYPE = 'RV' OR TYPE = 'AI' THEN +1 
		ELSE -1 END * (qty + bonus)), 12))),
	Date=LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(100), :ar_enddate, 103), '/', '-')))),
	Batch=st.batch,
	Expiry = LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(100), st.expiry, 103), '/', '-'))))
FROM
	(SELECT type='OP', icode, Batch, expiry, qty = sum(qty), bonus = 0
	FROM	
		(select	pd.icode, pd.batch, pd.expiry,
			qty = sum(isnull(case pl.purcatcode 
				when 1 THEN (pd.packqty + pd.bonusqty) * pd.packunits
				when 2 THEN (pd.packqty + pd.bonusqty) * pd.packunits
				else pd.looseqty + pd.bonusqty end, 0))
		FROM purledger pl, purdetail pd, item i
		WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
			pl.date < :ar_startdate AND
			pd.icode=i.icode AND
			I.ManfCode IN (:ai_manfcode)
		Group By pd.icode, pd.batch, pd.expiry
		UNION ALL
		select	pd.icode, pd.batch, pd.expiry,
			qty  = - sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits)
		FROM prledger pl, prdetail pd, item i
		WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
			pl.date < :ar_startdate AND
			pd.icode=i.icode AND
			I.ManfCode IN (:ai_manfcode)
		Group By pd.icode, pd.batch, pd.expiry
		UNION ALL
		select	sd.icode, sd.batch, sd.expiry,
			qty  = -sum(sd.looseqty + sd.bonusqty)
		FROM saleledger sl, saledetail sd, item i
		WHERE sl.saleinvcode = sd.saleinvcode AND
			  sl.posted = 'Y' AND 
		      sl.date < :ar_startdate AND sd.Due IS NULL AND
			sd.icode=i.icode AND
			I.ManfCode IN (:ai_manfcode)
		Group By sd.icode, sd.batch, sd.expiry
		UNION ALL
		select	sd.icode, sd.batch, sd.expiry,
			qty  = sum(sd.looseqty + sd.bonusqty)
		FROM srledger sl, srdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
			  sl.posted = 'Y' AND 
		      sl.date < :ar_startdate AND
			sd.icode=i.icode AND
			I.ManfCode IN (:ai_manfcode)
		Group By sd.icode, sd.batch, sd.expiry
		UNION ALL
		select	sd.icode, sd.batch, sd.expiry,
			qty  = -sum(sd.qty)
		FROM issueheader sl, issuedetail sd, item i
		WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode AND
			I.ManfCode IN (:ai_manfcode)
		Group By sd.icode, sd.batch, sd.expiry
		UNION ALL
		select	sd.icode, sd.batch, sd.expiry,
			qty  = sum(sd.qty)
		FROM receiptheader sl, receiptdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode AND
			I.ManfCode IN (:ai_manfcode)
		Group By sd.icode, sd.batch, sd.expiry
		UNION ALL
		select	sd.icode, sd.batch, sd.expiry,
			qty = sum(sd.looseqty)
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode AND
			I.ManfCode IN (:ai_manfcode)
		Group By sd.icode, sd.batch, sd.expiry
		UNION ALL
		select	sd.icode, sd.batch, sd.expiry,
			qty = -sum(sd.looseqty)
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode AND
			I.ManfCode IN (:ai_manfcode)
		Group By sd.icode, sd.batch, sd.expiry
		UNION ALL
		select	d.icode, d.batch, d.expiry,
			qty = -sum(d.duesatisfyqty)
		FROM duesatisfyheader h, duesatisfydetail d, item i
		WHERE h.duesatisfycode=d.duesatisfycode AND
		      h.duesatisfydate < :ar_startdate AND
			d.icode=i.icode AND
			I.ManfCode IN (:ai_manfcode)
		Group By d.icode, d.batch, d.expiry) A
	GROUP BY icode, batch, expiry
	UNION ALL
	select	type='PV',
		pd.icode,
		pd.batch,
		pd.expiry,
		qty = sum(pd.looseqty + pd.packqty * pd.packunits),
		bonus = sum(isnull(case pl.purcatcode 
			when 1 THEN pd.bonusqty * pd.packunits
			when 2 THEN pd.bonusqty * pd.packunits
			else pd.bonusqty
			end, 0))
	FROM purledger pl, purdetail pd, item i
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pl.date >= :ar_startdate and pl.date <= :ar_enddate AND
		pd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By pd.icode, pd.batch, pd.expiry
	UNION ALL
	select	type='PR',
		pd.icode,
		pd.batch, pd.expiry,
		qty = sum(pd.looseqty + pd.packqty * pd.packunits),
		bonus = sum(pd.bonusqty)
	FROM prledger pl, prdetail pd, item i
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
	      pl.date >= :ar_startdate and pl.date <= :ar_enddate AND
		pd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By pd.icode, pd.batch, pd.expiry
	UNION ALL
	select	type='SV',
		sd.icode,
		sd.batch, sd.expiry,
		qty = sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus = sum(sd.bonusqty)
	FROM saleledger sl, saledetail sd, item i
	WHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By sd.icode, sd.batch, sd.expiry
	UNION ALL
	select	type='SR',
		sd.icode,
		sd.batch, sd.expiry,
		qty = sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus = sum(sd.bonusqty)
	FROM srledger sl, srdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By sd.icode, sd.batch, sd.expiry
	UNION ALL
	select	type='IV',
		sd.icode,
		sd.batch, sd.expiry,
		qty = sum(sd.qty),
		bonus = 0
	FROM issueheader sl, issuedetail sd, item i
	WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By sd.icode, sd.batch, sd.expiry
	UNION ALL
	select	type='DS',
		d.icode,
		d.batch, d.expiry,
		qty = sum(d.duesatisfyqty),
		bonus = 0
	FROM duesatisfyheader h, duesatisfydetail d, item i
	WHERE h.duesatisfycode = d.duesatisfycode AND
	      h.duesatisfydate >= :ar_startdate and h.duesatisfydate <= :ar_enddate AND
		d.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By d.icode, d.batch, d.expiry
	UNION ALL
	select	type='RV',
		sd.icode, 
		sd.batch, sd.expiry,
		qty = sum(sd.qty),
		bonus = 0
	FROM receiptheader sl, receiptdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By sd.icode, sd.batch, sd.expiry
	UNION ALL
	select	type='AI',
		sd.icode,
		sd.batch, sd.expiry,
		qty = sum(sd.looseqty),
		bonus = 0
	FROM Adjheader sl, Adjdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By sd.icode, sd.batch, sd.expiry
	UNION ALL
	select	type='AD',
		sd.icode,
		sd.batch, sd.expiry,
		qty = sum(sd.looseqty),
		bonus = 0
	FROM Adjheader sl, Adjdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode AND
		I.ManfCode IN (:ai_manfcode)
	Group By sd.icode, sd.batch, sd.expiry
/*	UNION ALL
	SELECT type='OP', icode, qty = 0, bonus = 0
	FROM ITEM WHERE Item.ManfCode IN (:ai_manfcode)*/) St, 
	Item i
WHERE st.icode = i.icode
GROUP BY i.name, i.customicode, st.batch, st.expiry
ORDER BY i.customicode, st.batch, st.expiry
"
  arguments=(("as_distcode", string), ("ai_manfcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
 filter=" integer(trim(opening)) <> 0 OR integer(trim( receiptqty )) <> 0 OR integer(trim( sales )) <> 0 OR integer(trim( otherout )) <> 0 OR integer(trim( closingqty )) <> 0"
 )
