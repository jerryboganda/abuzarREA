column=(type=char(8000) updatewhereclause=yes name=druglisno dbname="Druglisno"  )
column=(type=long updatewhereclause=yes name=areacodelen dbname="AreaCodeLEN"  )
column=(type=char(10) updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=long updatewhereclause=yes name=areanamelen dbname="AreaNameLEN"  )
column=(type=char(8000) updatewhereclause=yes name=areaname dbname="AreaName"  )
column=(type=long updatewhereclause=yes name=custtypelen dbname="CustTypeLEN"  )
column=(type=char(8000) updatewhereclause=yes name=custtype dbname="CustType"  )
column=(type=long updatewhereclause=yes name=imiscodelen dbname="IMiscodeLEN"  )
column=(type=char(8000) updatewhereclause=yes name=imiscode dbname="IMiscode"  )
 retrieve="SELECT
	CustCodeLEN=10,
	CustCode = LTRIM(RTRIM(A.AliasName)) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(A.AliasName)))),
	CustNameLEN=50,
	CustName = LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(A.Name, 1, 50))))),
	ADDRESS1LEN=50,
	ADDRESS1 = LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS1, 1, 50))))),
	ADDRESS2LEN=50,
	ADDRESS2 = LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(C.ADDRESS2, 1, 50))))),
	TelephoneLen=15,
	Telephone = LTRIM(RTRIM(SUBSTRING(C.Phone, 1, 15))) + REPLICATE(' ', 15 - LEN(LTRIM(RTRIM(SUBSTRING(C.Phone, 1, 15))))),
	DruglisnoLen=40,
	Druglisno = LTRIM(RTRIM(SUBSTRING(C.LicenceNo, 1, 40))) + REPLICATE(' ', 40 - LEN(LTRIM(RTRIM(SUBSTRING(C.LicenceNo, 1, 40))))),
	AreaCodeLEN=10,
	AreaCode=STR(AR.AREACODE, 10),
	AreaNameLEN=50,
	AreaName = LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(AR.NAME, 1, 50))))),
	CustTypeLEN=10,
	CustType=LTRIM(RTRIM(CT.NAME)) + SPACE(10 - LEN(LTRIM(RTRIM(CT.NAME)))),
	IMiscodeLEN=10,
	IMiscode=:as_distcode + REPLICATE(' ', 10 - LEN(:as_distcode))
FROM Customer C, Accounts A, Area AR, CUSTOMERCATEGORY CT
WHERE C.CustCode = A.AccCode AND C.AreaCode = AR.AreaCode AND C.CUSTCATCODE = CT.CUSTCATCODE
"
  arguments=(("as_distcode", string))
)
