table(column=(type=long updatewhereclause=yes name=custcodelen dbname="CustCodeLEN"  )
column=(type=char(8000) updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=long updatewhereclause=yes name=custnamelen dbname="CustNameLEN"  )
column=(type=char(8000) updatewhereclause=yes name=custname dbname="CustName"  )
column=(type=long updatewhereclause=yes name=address1len dbname="ADDRESS1LEN"  )
column=(type=char(8000) updatewhereclause=yes name=address1 dbname="ADDRESS1"  )
