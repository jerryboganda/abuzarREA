release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=prodcodelen dbname="PRODCODELEN"  )
column=(type=char(10) updatewhereclause=yes name=prodcode dbname="PRODCODE"  )
column=(type=long updatewhereclause=yes name=prodnamelen dbname="ProdNameLen"  )
column=(type=char(60) updatewhereclause=yes name=prodname dbname="ProdName"  )
column=(type=long updatewhereclause=yes name=packinglen dbname="PackingLen"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=long updatewhereclause=yes name=tplen dbname="TPLEN"  )
column=(type=char(12) updatewhereclause=yes name=tp dbname="TP"  )
column=(type=long updatewhereclause=yes name=manufacturerlen dbname="ManufacturerLen"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
 retrieve="SELECT 
	PRODCODELEN=10,
	PRODCODE=STR(I.ICode, 10),
	ProdNameLen=100,
	ProdName=I.Name,
	PackingLen=60,
	Packing=I.PackingDesc,
	TPLEN=12,
	TP=STR(ISNULL(I.SalePrice, 0), 12, 2),
	ManufacturerLen=100,
	Manufacturer=M.Name
FROM
	Item I, Manufacturer M
WHERE
	I.ManfCode = M.ManfCode AND M.ManfCode IN (:ai_manfcode)
ORDER BY
	PRODCODE"
  arguments=(("ai_manfcode", numberlist))
)
