release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=136 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dstbidlen dbname="DSTBIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=dstbid dbname="DSTBID"  )
column=(type=long updatewhereclause=yes name=cldatelen dbname="CLDATELEN"  )
column=(type=char(10) updatewhereclause=yes name=cldate dbname="CLDATE"  )
column=(type=long updatewhereclause=yes name=prdidlen dbname="PRDIDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=prdid dbname="PRDID"  )
column=(type=long updatewhereclause=yes name=prdlen dbname="PRDLEN"  )
column=(type=char(8000) updatewhereclause=yes name=prd dbname="PRD"  )
column=(type=long updatewhereclause=yes name=batchnolen dbname="BatchNoLEN"  )
column=(type=char(100) updatewhereclause=yes name=batchno dbname="BatchNo"  )
column=(type=long updatewhereclause=yes name=expdatelen dbname="EXPDATELEN"  )
column=(type=char(10) updatewhereclause=yes name=expdate dbname="EXPDATE"  )
column=(type=long updatewhereclause=yes name=clbalancelen dbname="CLBalanceLEN"  )
column=(type=char(14) updatewhereclause=yes name=clbalance dbname="CLBalance"  )
column=(type=long updatewhereclause=yes name=intransitlen dbname="InTransitLEN"  )
column=(type=char(14) updatewhereclause=yes name=intransit dbname="InTransit"  )
column=(type=long updatewhereclause=yes name=shortagelen dbname="ShortageLEN"  )
column=(type=char(14) updatewhereclause=yes name=shortage dbname="Shortage"  )
column=(type=long updatewhereclause=yes name=expiredlen dbname="ExpiredLEN"  )
column=(type=char(14) updatewhereclause=yes name=expired dbname="Expired"  )
column=(type=long updatewhereclause=yes name=stockpurchaselen dbname="StockPurchaseLen"  )
column=(type=char(14) updatewhereclause=yes name=stockpurchase dbname="StockPurchase"  )
column=(type=long updatewhereclause=yes name=bonuspurchaselen dbname="BonusPurchaseLen"  )
column=(type=char(14) updatewhereclause=yes name=bonuspurchase dbname="BonusPurchase"  )
column=(type=long updatewhereclause=yes name=clbonusstocklen dbname="CLBonusStockLen"  )
column=(type=char(14) updatewhereclause=yes name=clbonusstock dbname="CLBonusStock"  )
column=(type=long updatewhereclause=yes name=openingstocklen dbname="OpeningStockLen"  )
column=(type=char(14) updatewhereclause=yes name=openingstock dbname="OpeningStock"  )
column=(type=long updatewhereclause=yes name=openingbonuslen dbname="OpeningBonusLen"  )
column=(type=char(14) updatewhereclause=yes name=openingbonus dbname="OpeningBonus"  )
 retrieve="SELECT
	DSTBIDLEN=6, 
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	CLDATELEN=10,
	CLDATE=Convert(varchar(10), :ar_enddate, 103),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(I.CustomICode, 1, 9))))),
	PRDLEN=50,
	PRD = LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))))),
	BatchNoLEN=10,
	BatchNo=ISNULL(ST.Batch, '.'),
	EXPDATELEN=10,
	EXPDATE=Convert(varchar(10), ISNULL((SELECT MAX(GD.Expiry) FROM GodownDetail GD WHERE GD.Icode=I.ICode AND GD.Batch = ST.Batch), ISNULL((SELECT MAX(PD.Expiry) FROM PurDetail PD WHERE PD.Icode=I.ICode AND PD.Batch = ST.Batch), GETDATE())), 103),
	CLBalanceLEN=14,
	CLBalance=STR(SUM(
		CASE WHEN TYPE = 'OP' OR TYPE = 'PV' OR TYPE = 'SR' OR TYPE = 'RV' OR TYPE = 'AI' THEN +1 
		ELSE -1 END * st.qty ), 14),
	InTransitLEN=14,
	InTransit=STR(SUM(ISNULL(I.TransitStock, 0)), 14),
	ShortageLEN=14,
	Shortage=STR(0, 14),
	ExpiredLEN=14,
	Expired=STR(0, 14),
	StockPurchaseLen=14,
	StockPurchase=STR(SUM(CASE TYPE WHEN 'PV' THEN st.qty ELSE 0 END), 14),
	BonusPurchaseLen=14,
	BonusPurchase=STR(SUM(CASE TYPE WHEN 'PV' THEN st.Bonus ELSE 0 END), 14),
	CLBonusStockLen=14,
	CLBonusStock=STR(SUM(
		CASE WHEN TYPE = 'OP' OR TYPE = 'PV' OR TYPE = 'SR' OR TYPE = 'RV' OR TYPE = 'AI' THEN +1 
		ELSE -1 END * st.bonus ), 14),
	OpeningStockLen=14,
	OpeningStock=STR(SUM(CASE TYPE WHEN 'OP' THEN st.qty ELSE 0 END), 14),
	OpeningBonusLen=14,
	OpeningBonus=STR(SUM(CASE TYPE WHEN 'OP' THEN st.Bonus ELSE 0 END), 14)
FROM
	(SELECT type='OP', icode, batch,expiry, qty = sum(qty), bonus = sum(bonus)
	FROM	
		(select pd.icode, pd.batch, pd.expiry,
			qty = sum(isnull(
				case pl.purcatcode 
				when 1 THEN (pd.packqty * pd.packunits)
				when 2 THEN (pd.packqty * pd.packunits)
				else pd.looseqty end, 0)), 
			bonus = sum(isnull(
				case pl.purcatcode 
				when 1 THEN (pd.bonusqty * pd.packunits)
				when 2 THEN (pd.bonusqty * pd.packunits)
				else pd.bonusqty end, 0))
		FROM purledger pl, purdetail pd, item i
		WHERE pl.posted = 'Y' AND 
			pl.purinvcode = pd.purinvcode AND
			pl.postdate < :ar_startdate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode, pd.batch,pd.expiry
		UNION ALL
		select	pd.icode, pd.batch,pd.expiry,
			qty  = - sum(pd.looseqty),
			bonus = - sum(pd.bonusqty)
		FROM prledger pl, prdetail pd, item i
		WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
			pl.date < :ar_startdate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode, pd.batch,pd.expiry
		UNION ALL
		select	sd.icode, sd.batch,sd.expiry,
			qty  = -sum(sd.looseqty),
			bonus  = -sum(sd.bonusqty)
		FROM saleledger sl, saledetail sd, item i
		WHERE sl.saleinvcode = sd.saleinvcode AND
			  sl.posted = 'Y' AND 
		      sl.date < :ar_startdate AND sd.Due IS NULL AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch,sd.expiry,
			qty  = sum(sd.looseqty),
			bonus = sum(sd.bonusqty)
		FROM srledger sl, srdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
			  sl.posted = 'Y' AND 
		      sl.postdate < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch, sd.expiry,qty  = -sum(sd.qty), bonus = 0
		FROM issueheader sl, issuedetail sd, item i
		WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch, sd.expiry,qty  = sum(sd.qty), bonus=0
		FROM receiptheader sl, receiptdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
		      sl.postdate < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch,sd.expiry, qty = sum(sd.looseqty), bonus=0
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		      sl.posteddate < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	sd.icode, sd.batch,sd.expiry, qty = -sum(sd.looseqty), bonus=0
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		      sl.posteddate < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch,sd.expiry
		UNION ALL
		select	d.icode, d.batch, d.expiry, qty = -sum(d.duesatisfyqty), bonus=0
		FROM duesatisfyheader h, duesatisfydetail d, item i
		WHERE h.duesatisfycode=d.duesatisfycode AND
		      h.duesatisfydate < :ar_startdate AND
			d.icode=i.icode and i.manfcode in (:manfcode)
		Group By d.icode, d.batch,d.expiry) A
	GROUP BY icode, batch,expiry
	UNION ALL
	select	type='PV',
		pd.icode, pd.batch,pd.expiry,
		qty = sum(pd.looseqty + pd.packqty * pd.packunits),
		bonus = sum(isnull(case pl.purcatcode 
			when 1 THEN pd.bonusqty * pd.packunits
			when 2 THEN pd.bonusqty * pd.packunits
			else pd.bonusqty
			end, 0))
	FROM purledger pl, purdetail pd, item i
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pl.postdate BETWEEN :ar_startdate and :ar_enddate AND
		pd.icode=i.icode and i.manfcode in (:manfcode)
	Group By pd.icode, pd.batch,pd.expiry
	UNION ALL
	select	type='TRN',
		pd.icode, pd.batch,pd.expiry,
		qty = sum(pd.looseqty + pd.packqty * pd.packunits),
		bonus = sum(isnull(case pl.purcatcode 
			when 1 THEN pd.bonusqty * pd.packunits
			when 2 THEN pd.bonusqty * pd.packunits
			else pd.bonusqty
			end, 0))
	FROM purledger pl, purdetail pd, item i
	WHERE pl.posted = 'N' AND pl.purinvcode = pd.purinvcode AND
		pl.postdate BETWEEN :ar_startdate and :ar_enddate AND
		pd.icode=i.icode and i.manfcode in (:manfcode)
	Group By pd.icode, pd.batch,pd.expiry
	UNION ALL
	select	type='PR',
		pd.icode,
		pd.batch,pd.expiry,
		qty = sum(pd.looseqty),
		bonus = sum(pd.bonusqty)
	FROM prledger pl, prdetail pd, item i
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
	      pl.date BETWEEN :ar_startdate and :ar_enddate AND
		pd.icode=i.icode and i.manfcode in (:manfcode)
	Group By pd.icode, pd.batch,pd.expiry
	UNION ALL
	select	type='SV',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = sum(sd.bonusqty)
	FROM saleledger sl, saledetail sd, item i
	WHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
		sl.date BETWEEN :ar_startdate and :ar_enddate AND
		sd.saleprice <> 0 AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='SVFOC',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = sum(sd.bonusqty)
	FROM saleledger sl, saledetail sd, item i
	WHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.saleprice=0 AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='SR',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = sum(sd.bonusqty)
	FROM srledger sl, srdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
	      sl.postdate BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='IV',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.qty),
		bonus = 0
	FROM issueheader sl, issuedetail sd, item i
	WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
	      sl.date BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='DS',
		d.icode, d.batch,d.expiry,
		qty = sum(d.duesatisfyqty),
		bonus = 0
	FROM duesatisfyheader h, duesatisfydetail d, item i
	WHERE h.duesatisfycode = d.duesatisfycode AND
	      h.duesatisfydate BETWEEN :ar_startdate and :ar_enddate AND
		d.icode=i.icode and i.manfcode in (:manfcode)
	Group By d.icode, d.batch,d.expiry
	UNION ALL
	select	type='RV',
		sd.icode, sd.batch, sd.expiry, 
		qty = sum(sd.qty),
		bonus = 0
	FROM receiptheader sl, receiptdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	      sl.postdate BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='AI',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = 0
	FROM Adjheader sl, Adjdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		sl.posteddate BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	UNION ALL
	select	type='AD',
		sd.icode, sd.batch,sd.expiry,
		qty = sum(sd.looseqty),
		bonus = 0
	FROM Adjheader sl, Adjdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		sl.date BETWEEN :ar_startdate and :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode, sd.batch,sd.expiry
	/*UNION ALL
	SELECT type='OP', icode, batch=SPACE(10), expiry=getdate(),qty = 0, bonus = 0
	FROM ITEM 
	WHERE ManfCode IN (:manfcode)*/) St, 
	Item i
WHERE st.icode = i.icode
GROUP BY i.icode, i.name, i.customicode, st.batch
ORDER BY i.customicode, st.batch
/*
FROM
	Item I
	LEFT OUTER JOIN
	(SELECT icode, batch,qty = sum(qty+bonus)
	FROM	
		(select pd.icode, pd.batch, 
			qty = sum(isnull(
				case pl.purcatcode 
				when 1 THEN (pd.packqty * pd.packunits)
				when 2 THEN (pd.packqty * pd.packunits)
				else pd.looseqty end, 0)), 
			bonus = sum(isnull(
				case pl.purcatcode 
				when 1 THEN (pd.bonusqty * pd.packunits)
				when 2 THEN (pd.bonusqty * pd.packunits)
				else pd.bonusqty end, 0))
		FROM purledger pl, purdetail pd, item i
		WHERE pl.posted = 'Y' AND 
			pl.purinvcode = pd.purinvcode AND
			pl.postdate <= :ar_enddate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode, pd.batch
		UNION ALL
		select	pd.icode, pd.batch, qty  = - sum(pd.looseqty), bonus = - sum(pd.bonusqty)
		FROM prledger pl, prdetail pd, item i
		WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
			pl.date <= :ar_enddate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode, pd.batch
		UNION ALL
		select	sd.icode, sd.batch, qty  = -sum(sd.looseqty), bonus  = -sum(sd.bonusqty)
		FROM saleledger sl, saledetail sd, item i
		WHERE sl.saleinvcode = sd.saleinvcode AND
			  sl.posted = 'Y' AND 
		      sl.date <= :ar_enddate AND sd.Due IS NULL AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	sd.icode, sd.batch, qty  = sum(sd.looseqty), bonus = sum(sd.bonusqty)
		FROM srledger sl, srdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
			  sl.posted = 'Y' AND 
		      sl.postdate <= :ar_enddate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	sd.icode, sd.batch, qty  = -sum(sd.qty), bonus = 0
		FROM issueheader sl, issuedetail sd, item i
		WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
		      sl.date <= :ar_enddate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	sd.icode, sd.batch, qty  = sum(sd.qty), bonus=0
		FROM receiptheader sl, receiptdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
		      sl.postdate <= :ar_enddate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	sd.icode, sd.batch, qty = sum(sd.looseqty), bonus=0
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		      sl.posteddate <= :ar_enddate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	sd.icode, sd.batch, qty = -sum(sd.looseqty), bonus=0
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		      sl.posteddate <= :ar_enddate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	d.icode, d.batch, qty = -sum(d.duesatisfyqty), bonus=0
		FROM duesatisfyheader h, duesatisfydetail d, item i
		WHERE h.duesatisfycode=d.duesatisfycode AND
		      h.duesatisfydate <= :ar_enddate AND
			d.icode=i.icode and i.manfcode in (:manfcode)
		Group By d.icode, d.batch) A
	GROUP BY icode, batch
	HAVING sum(qty+bonus) <> 0) T ON (I.ICode = T.ICode)
WHERE
	:ai_scope = 1 AND
	I.ManfCode = :manfcode
GROUP BY
	I.ICode,
	I.Name,
	I.CustomICode,
	T.Batch
UNION ALL
SELECT
	DSTBIDLEN=6, 
	DSTBID=:as_distcode + REPLICATE(' ', 6 - LEN(:as_distcode)),
	CLDATELEN=10,
	CLDATE=Convert(varchar(10), :ar_enddate, 103),
	PRDIDLEN=9,
	PRDID=SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 9) + REPLICATE(' ', 10 - LEN(LTRIM(RTRIM(SUBSTRING(I.CustomICode, 1, 9))))),
	PRDLEN=50,
	PRD = LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))) + REPLICATE(' ', 50 - LEN(LTRIM(RTRIM(SUBSTRING(I.NAME, 1, 50))))),
	BatchNoLEN=10,
	BatchNo=ISNULL(T.Batch, '.'),
	CLBalanceLEN=14,
	CLBalance=STR(SUM(ISNULL(T.Qty, 0)), 14),
	InTransitLEN=14,
	InTransit=STR(SUM(ISNULL(I.TransitStock, 0)), 14),
	ShortageLEN=14,
	Shortage=STR(0, 14),
	ExpiredLEN=14,
	Expired=STR(0, 14)
FROM
	Item I
	LEFT OUTER JOIN
	(SELECT icode, batch,qty = sum(qty+bonus)
	FROM	
		(select pd.icode, pd.batch, 
			qty = sum(isnull(
				case pl.purcatcode 
				when 1 THEN (pd.packqty * pd.packunits)
				when 2 THEN (pd.packqty * pd.packunits)
				else pd.looseqty end, 0)), 
			bonus = sum(isnull(
				case pl.purcatcode 
				when 1 THEN (pd.bonusqty * pd.packunits)
				when 2 THEN (pd.bonusqty * pd.packunits)
				else pd.bonusqty end, 0))
		FROM crs_purledger pl, crs_purdetail pd, item i
		WHERE pl.posted = 'Y' AND 
			pl.clientinstanceid = pd.clientinstanceid AND
			pl.purinvcode = pd.purinvcode AND
			pl.postdate <= :ar_enddate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode, pd.batch
		UNION ALL
		select	pd.icode, pd.batch, qty  = - sum(pd.looseqty), bonus = - sum(pd.bonusqty)
		FROM crs_prledger pl, crs_prdetail pd, item i
		WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
			pl.clientinstanceid = pd.clientinstanceid AND
			pl.date <= :ar_enddate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode, pd.batch
		UNION ALL
		select	sd.icode, sd.batch, qty  = -sum(sd.looseqty), bonus  = -sum(sd.bonusqty)
		FROM crs_saleledger sl, crs_saledetail sd, item i
		WHERE sl.saleinvcode = sd.saleinvcode AND
			sl.clientinstanceid = sd.clientinstanceid AND
			  sl.posted = 'Y' AND 
		      sl.date <= :ar_enddate AND sd.Due IS NULL AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	sd.icode, sd.batch, qty  = sum(sd.looseqty), bonus = sum(sd.bonusqty)
		FROM crs_srledger sl, crs_srdetail sd, item i
		WHERE 
			sl.clientinstanceid = sd.clientinstanceid AND
			sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
			  sl.posted = 'Y' AND 
		      sl.postdate <= :ar_enddate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	sd.icode, sd.batch, qty  = -sum(sd.qty), bonus = 0
		FROM crs_issueheader sl, crs_issuedetail sd, item i
		WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
			sl.clientinstanceid = sd.clientinstanceid AND
		      sl.date <= :ar_enddate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	sd.icode, sd.batch, qty  = sum(sd.qty), bonus=0
		FROM crs_receiptheader sl, crs_receiptdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
			sl.clientinstanceid = sd.clientinstanceid AND
		      sl.postdate <= :ar_enddate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	sd.icode, sd.batch, qty = sum(sd.looseqty), bonus=0
		FROM crs_Adjheader sl, crs_Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
			sl.clientinstanceid = sd.clientinstanceid AND
		      sl.posteddate <= :ar_enddate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	sd.icode, sd.batch, qty = -sum(sd.looseqty), bonus=0
		FROM crs_Adjheader sl, crs_Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
			sl.clientinstanceid = sd.clientinstanceid AND
		      sl.posteddate <= :ar_enddate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode, sd.batch
		UNION ALL
		select	d.icode, d.batch, qty = -sum(d.duesatisfyqty), bonus=0
		FROM crs_duesatisfyheader h, crs_duesatisfydetail d, item i
		WHERE h.duesatisfycode=d.duesatisfycode AND
			h.clientinstanceid = d.clientinstanceid AND
		      h.duesatisfydate <= :ar_enddate AND
			d.icode=i.icode and i.manfcode in (:manfcode)
		Group By d.icode, d.batch) A
	GROUP BY icode, batch
	HAVING sum(qty+bonus) <> 0) T ON (I.ICode = T.ICode)
WHERE
	:ai_scope = 2 AND
	I.ManfCode = :manfcode
GROUP BY
	I.ICode,
	I.Name,
	I.CustomICode,
	T.Batch
ORDER BY
	CLDATE,
	PRD
*/"
  arguments=(("manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ai_scope", number))
 filter="integer(trim( openingstock )) <> 0 OR integer(trim( openingbonus )) <> 0 OR integer(trim( stockpurchase )) <> 0 OR integer(trim( bonuspurchase )) <> 0 OR integer(trim(  clbonusstock )) <> 0 OR integer(trim( clbalance )) <> 0"
 )
