table(column=(type=char(20) updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=char(12) updatewhereclause=yes name=opbox dbname="OpBox"  )
column=(type=char(12) updatewhereclause=yes name=prbox dbname="PRBox"  )
column=(type=char(12) updatewhereclause=yes name=rtbox dbname="RTBox"  )
column=(type=char(12) updatewhereclause=yes name=slbox dbname="SLBox"  )
column=(type=char(12) updatewhereclause=yes name=srbox dbname="SRBox"  )
column=(type=char(12) updatewhereclause=yes name=clbox dbname="CLBox"  )
column=(type=char(50) updatewhereclause=yes name=dbcod dbname="DBCod"  )
column=(type=char(8000) updatewhereclause=yes name=opdat dbname="OpDat"  )
column=(type=char(8000) updatewhereclause=yes name=cldat dbname="CLDat"  )
 retrieve="SELECT
	ProdCode=ISNULL(SUBSTRING(LTRIM(RTRIM(I.CustomICode)), 1, 20),''),
	OpBox	= ISNULL(LTRIM(RTRIM(STR(SUM(CASE WHEN type='OP' THEN qty ELSE 0 END), 12))),''),
	PRBox = ISNULL(LTRIM(RTRIM(STR(SUM(CASE WHEN TYPE = 'PV' THEN qty ELSE 0 END), 12))),''),
	RTBox = ISNULL(LTRIM(RTRIM(STR(SUM(CASE WHEN TYPE = 'PR' THEN Qty ELSE 0 END), 12))),''),
	SLBox = ISNULL(LTRIM(RTRIM(STR(SUM(CASE WHEN TYPE = 'SV' THEN Qty ELSE 0 END), 12))),''),
	SRBox = ISNULL(LTRIM(RTRIM(STR(SUM(CASE WHEN TYPE = 'SR' THEN Qty ELSE 0 END), 12))),''),
	CLBox = ISNULL(LTRIM(RTRIM(STR(SUM(CASE WHEN TYPE = 'OP' OR TYPE = 'PV' OR TYPE = 'SR' OR TYPE = 'RV' OR TYPE = 'AI' THEN +1 ELSE -1 END * (qty)), 12))),''),
	DBCod = ISNULL(LTRIM(RTRIM(:as_distcode + REPLICATE(' ', 50 - LEN(:as_distcode)))),''),
	OpDat=ISNULL(LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(100), :ar_startdate, 106), ' ', '-')))),''),
	CLDat=ISNULL(LTRIM(RTRIM(UPPER(REPLACE(Convert(VARCHAR(100), :ar_enddate, 106), ' ', '-')))),'')
FROM
	(SELECT type='OP', icode, qty = sum(qty)
	FROM	
		(select	pd.icode,
			qty = sum(isnull(case pl.purcatcode 
				when 1 THEN (pd.packqty + pd.bonusqty) * pd.packunits
				when 2 THEN (pd.packqty + pd.bonusqty) * pd.packunits
				else pd.looseqty + pd.bonusqty end, 0))
		FROM purledger pl, purdetail pd, item i
		WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
			pl.date < :ar_startdate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode
		UNION ALL
		select	pd.icode, qty  = - sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits)
		FROM prledger pl, prdetail pd, item i
		WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
			pl.date < :ar_startdate AND
			pd.icode=i.icode and i.manfcode in (:manfcode)
		Group By pd.icode
		UNION ALL
		select	 sd.icode, qty  = -sum(sd.looseqty + sd.bonusqty)
		FROM saleledger sl, saledetail sd, item i
		WHERE sl.saleinvcode = sd.saleinvcode AND
			  sl.posted = 'Y' AND 
		      sl.date < :ar_startdate AND sd.Due IS NULL AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode
		UNION ALL
		select	sd.icode, qty  = sum(sd.looseqty + sd.bonusqty)
		FROM srledger sl, srdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
			  sl.posted = 'Y' AND 
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode
		UNION ALL
		select	sd.icode, qty  = -sum(sd.qty)
		FROM issueheader sl, issuedetail sd, item i
		WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode
		UNION ALL
		select	sd.icode, qty  = sum(sd.qty)
		FROM receiptheader sl, receiptdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode
		UNION ALL
		select	sd.icode, qty = sum(sd.looseqty)
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode
		UNION ALL
		select	sd.icode, qty = -sum(sd.looseqty)
		FROM Adjheader sl, Adjdetail sd, item i
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		      sl.date < :ar_startdate AND
			sd.icode=i.icode and i.manfcode in (:manfcode)
		Group By sd.icode
		UNION ALL
		select	d.icode, qty = -sum(d.duesatisfyqty)
		FROM duesatisfyheader h, duesatisfydetail d, item i
		WHERE h.duesatisfycode=d.duesatisfycode AND
		      h.duesatisfydate < :ar_startdate AND
			d.icode=i.icode and i.manfcode in (:manfcode)
		Group By d.icode) A
	GROUP BY icode
	UNION ALL
	select	type='PV',
		pd.icode, qty = sum(pd.looseqty + pd.packqty * pd.packunits) + 
			sum(isnull(case pl.purcatcode 
				when 1 THEN pd.bonusqty * pd.packunits
				when 2 THEN pd.bonusqty * pd.packunits
				else pd.bonusqty
				end, 0))
	FROM purledger pl, purdetail pd, item i
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pl.date >= :ar_startdate and pl.date <= :ar_enddate AND
		pd.icode=i.icode and i.manfcode in (:manfcode)
	Group By pd.icode, pd.batch, PL.PurTypeCode
	UNION ALL
	select	type='PR', pd.icode, qty = sum(pd.looseqty + pd.packqty * pd.packunits) + sum(pd.bonusqty)
	FROM prledger pl, prdetail pd, item i
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
	      pl.date >= :ar_startdate and pl.date <= :ar_enddate AND
		pd.icode=i.icode and i.manfcode in (:manfcode)
	Group By pd.icode, pd.batch, PL.PrTypeCode
	UNION ALL
	select	type='SV', sd.icode, qty = sum(sd.looseqty + sd.packqty * sd.packunits) + sum(sd.bonusqty)
	FROM saleledger sl, saledetail sd, item i
	WHERE sl.posted = 'Y' AND sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode
	UNION ALL
	select	type='SR', sd.icode, qty = sum(sd.looseqty + sd.packqty * sd.packunits) + sum(sd.bonusqty)
	FROM srledger sl, srdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode
	UNION ALL
	select	type='IV', sd.icode, qty = sum(sd.qty)
	FROM issueheader sl, issuedetail sd, item i
	WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode
	UNION ALL
	select	type='DS', d.icode, qty = sum(d.duesatisfyqty)
	FROM duesatisfyheader h, duesatisfydetail d, item i
	WHERE h.duesatisfycode = d.duesatisfycode AND
	      h.duesatisfydate >= :ar_startdate and h.duesatisfydate <= :ar_enddate AND
		d.icode=i.icode and i.manfcode in (:manfcode)
	Group By d.icode
	UNION ALL
	select	type='RV', sd.icode, qty = sum(sd.qty)
	FROM receiptheader sl, receiptdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode
	UNION ALL
	select	type='AI', sd.icode, qty = sum(sd.looseqty)
	FROM Adjheader sl, Adjdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode
	UNION ALL
	select	type='AD', sd.icode, qty = sum(sd.looseqty)
	FROM Adjheader sl, Adjdetail sd, item i
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate AND
		sd.icode=i.icode and i.manfcode in (:manfcode)
	Group By sd.icode) St, 
	Item i
WHERE st.icode = i.icode
GROUP BY i.name, i.customicode
HAVING SUM(ST.Qty) <> 0
ORDER BY i.customicode
"
  arguments=(("manfcode", number), ("as_distcode", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
