header(height=1802 color="536870912" )
summary(height=416 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=char(12) updatewhereclause=yes name=type dbname="Type"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="CustRefNo"  )
column=(type=char(100) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=rowid dbname="rowid"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=char(20) updatewhereclause=yes name=machinename dbname="machinename"  )
column=(type=char(60) updatewhereclause=yes name=machineuser dbname="machineuser"  )
column=(type=char(30) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=decimal(6) updatewhereclause=yes name=totalsalestax dbname="totalsalestax"  )
 retrieve="SELECT 
	Type = 'Sales', 
	saleinvcode = dbo.saleledger.saleinvcode,
	date = dbo.saleledger.date,   
	invdiscperc = dbo.saleledger.discperc,    
	flatdisc = dbo.saleledger.flatdisc,    
	misccharges = dbo.saleledger.misccharges, 
	invsalestax = dbo.saleledger.salestax,
	invgstperc1 = dbo.saleledger.invgstperc1,
	CustRefNo   = dbo.saleledger.CustRefNo,
	Patient     = dbo.saleledger.Remarks,
	posted = dbo.saleledger.posted,	
	rowid = dbo.saledetail.rowid,
	looseqty = dbo.saledetail.looseqty, 
	bonusqty = dbo.saledetail.bonusqty, 
	machinename=saleledger.machinename,
	machineuser=(select users.username from users where users.usercode=saleledger.salesmancode),
	packing=case
	when dbo.item.packcode IS Null then space(30) 
	else dbo.itempacking.name
	end,
	itemflatdisc=saledetail.itemflatdisc,
	packqty  = saledetail.packqty,  
	price = dbo.saledetail.saleprice,    
	itemdiscperc = dbo.saledetail.discperc,    
	packunits = dbo.saledetail.packunits,    
	batch = dbo.saledetail.batch,    
	expiry = dbo.saledetail.expiry,    
	salestax  = saledetail.salestax,
	itemname = item.name,
	unitsalestax = dbo.saledetail.unitsalestax ,    
	gstperc = dbo.saledetail.gstperc ,    
	datestring = Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))), 
	Customer = dbo.accounts.name,
	totalsalestax = 
		(SELECT invtotalsalestax= 
			 Round (
				/*invoice level salestax*/
				Round ( ( Round ( Sum ( Round ( SD.looseqty * ( SD.saleprice - SD.itemflatdisc ) * 
					(1 - SD.discperc * 0.01 ) , 2 ) ) * ( 1 - SL.discperc * 0.01 ) , 2 ) - SL.flatdisc ) * SL.invgstperc1 * 0.01  , 2 )
				/*items salestax*/	 + 
				Sum (Round ((SD.looseqty + SD.bonusqty) * SD.unitsalestax + 
					Round ( Round (SD.looseqty * (SD.saleprice - SD.itemflatdisc ) * 
					(1 - SD.discperc * 0.01 ), 2 ) * SD.gstperc * 0.01 , 2 ) , 2 ) )
			, 0 )
		FROM 
			dbo.saleledger SL, dbo.saledetail SD
		WHERE  
			(SL.saleinvcode = dbo.saleledger.saleinvcode )   and
			(SL.saleinvcode = SD.saleinvcode ) 
		GROUP BY 
			SL.misccharges,   
			SL.flatdisc,   
			SL.date,   
			SL.saleinvcode, 
			SL.invgstperc1, 
			SL.discperc,  
			SL.salestax)

FROM
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.Item LEFT OUTER JOIN dbo.itempacking ON (dbo.item.packcode = dbo.itempacking.packcode),
	dbo.accounts
WHERE  
	dbo.saleledger.date >= :ad_StartDate and
	dbo.saleledger.date <= :ad_EndDate  and
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
	dbo.saledetail.icode = item.icode and 
	dbo.saleledger.custcode = dbo.accounts.acccode

UNION ALL
	
SELECT  
	Type = 'Sales Return',
	saleinvcode = dbo.srledger.srinvcode,
	date = dbo.srledger.date,   
	invdiscperc = dbo.srledger.discperc,    
	flatdisc = dbo.srledger.flatdisc,    
	misccharges = dbo.srledger.misccharges, 
	invsalestax = dbo.srledger.salestax,
	invgstperc1 = dbo.srledger.invgstperc1,
	CustRefNo   = dbo.srledger.CustRefNo,
	Patient     = dbo.srledger.Remarks,
	posted = dbo.srledger.posted,	
	rowid = dbo.srdetail.rowid,
	looseqty = dbo.srdetail.looseqty, 
	bonusqty = dbo.srdetail.bonusqty, 
	machinename=srledger.machinename,
	machineuser=(select users.username from users where users.usercode=srledger.salesmancode),
	packing=case when dbo.item.packcode IS Null then space(30) else dbo.itempacking.name end,
	itemflatdisc=0,
	packqty  = srdetail.packqty,  
	price = dbo.srdetail.srprice,    
	itemdiscperc = dbo.srdetail.discperc,    
	packunits = dbo.srdetail.packunits,    
	batch = dbo.srdetail.batch,    
	expiry = dbo.srdetail.expiry,    
	salestax  = srdetail.salestax,
	itemname = item.name,
	unitsalestax = dbo.srdetail.unitsalestax ,    
	gstperc = dbo.srdetail.gstperc ,    
	datestring = Rtrim(LTrim(Str(DatePart(dd, srledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, srledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, srledger.date)))), 
	Customer = dbo.accounts.name,
	totalsalestax = 
		(SELECT invtotalsalestax= 
			 Round (
				/*invoice level salestax*/
				Round ( ( Round ( Sum ( Round ( SD.looseqty * SD.srprice * 
					(1 - SD.discperc * 0.01 ) , 2 ) ) * ( 1 - SL.discperc * 0.01 ) , 2 ) - SL.flatdisc ) * SL.invgstperc1 * 0.01  , 2 )
				/*items salestax*/	 + 
				Sum (Round ((SD.looseqty + SD.bonusqty) * SD.unitsalestax + 
					Round ( Round (SD.looseqty * SD.srprice * (1 - SD.discperc * 0.01 ), 2 ) * 
					SD.gstperc * 0.01 , 2 ) , 2 ) )
			, 0 )
		FROM 
			dbo.srledger SL, dbo.srdetail SD
		WHERE  
			(SL.srinvcode = dbo.srledger.srinvcode )   and
			(SL.srinvcode = SD.srinvcode ) 
		GROUP BY 
			SL.misccharges,   
			SL.flatdisc,   
			SL.date,   
			SL.srinvcode, 
			SL.invgstperc1, 
			SL.discperc,  
			SL.salestax)
FROM
	dbo.srledger, 
	dbo.srdetail,    
	dbo.Item LEFT OUTER JOIN dbo.itempacking ON (dbo.item.packcode = dbo.itempacking.packcode),
	dbo.accounts
WHERE  
	dbo.srledger.date >= :ad_StartDate and
	dbo.srledger.date <= :ad_EndDate  and
	dbo.srledger.srinvcode = dbo.srdetail.srinvcode and  
	dbo.srdetail.icode = item.icode and 
	dbo.srledger.custcode = dbo.accounts.acccode
"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime))
 sort="type A, date A, saleinvcode A, rowid A"
)
