table(column=(type=char(100) updatewhereclause=yes name=client dbname="Client"  )
column=(type=char(100) updatewhereclause=yes name=date dbname="DATE"  )
column=(type=char(100) updatewhereclause=yes name=customergroup dbname="CustomerGroup"  )
column=(type=char(12) updatewhereclause=yes name=customercode dbname="CustomerCode"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(75) updatewhereclause=yes name=itemaliascode dbname="ItemAliasCode"  )
column=(type=decimal(4) updatewhereclause=yes name=itemqty dbname="ItemQty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=decimal(6) updatewhereclause=yes name=itemgrossamount dbname="ItemGrossAmount"  )
column=(type=decimal(15) updatewhereclause=yes name=prediscperc dbname="PreDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(6) updatewhereclause=yes name=totaldiscountperc dbname="TotalDiscountPerc"  )
column=(type=decimal(6) updatewhereclause=yes name=itemdiscountamount dbname="ItemDiscountAmount"  )
column=(type=decimal(6) updatewhereclause=yes name=itemnetsalesamount dbname="ItemNetSalesAmount"  )
column=(type=decimal(6) updatewhereclause=yes name=salestaxperc dbname="SalesTaxPerc"  )
column=(type=decimal(6) updatewhereclause=yes name=salestaxamount dbname="SalesTaxAmount"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxperc dbname="AdvanceTaxPerc"  )
column=(type=decimal(6) updatewhereclause=yes name=advancetaxamount dbname="AdvanceTaxAmount"  )
column=(type=char(6) updatewhereclause=yes name=salestype dbname="SalesType"  )
 retrieve="SELECT 
	Client = SPACE(100),
	DATE = CONVERT(VARCHAR(100), SL.PostDate, 101),
	CustomerGroup=(SELECT MAX(CG.Name) FROM CustomerGroup CG, CustomerGroupDetail CGD WHERE CG.CustomerGroupCode=CGD.CustomerGroupCode AND CGD.CustCode=C.CustCode),
	CustomerCode=A.AliasName,
	CustomerName=A.Name,
	InvoiceCode=SL.SaleInvCode,
	ItemName=I.Name,
	ItemAliasCode=I.CustomICode,
	ItemQty=SUM(SD.LooseQty),
	BonusQty=SUM(SD.BonusQty),
	ItemGrossAmount=ROUND(SUM(SD.LooseQty * SD.SalePrice), 2),
	PreDiscPerc = SUM(Round((SD.ItemFlatDisc / CASE WHEN SD.SalePrice = 0 THEN 1 ELSE SD.SalePrice END) * 100, 2)),
	DiscPerc = SD.DiscPerc, 
	TotalDiscountPerc=ROUND(((SUM(SD.LooseQty * SD.ItemFlatDisc) + SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01))) / CASE WHEN SUM(SD.LooseQty * SD.SalePrice) = 0 THEN 1 ELSE SUM(SD.LooseQty * SD.SalePrice) END) * 100, 2),
	ItemDiscountAmount=ROUND(SUM(SD.LooseQty * SD.ItemFlatDisc) + SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)),2),
	ItemNetSalesAmount=ROUND(SUM(SD.LooseQty * SD.SalePrice) - SUM(SD.LooseQty * SD.ItemFlatDisc) - SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2),
	SalesTaxPerc= ROUND(((SUM(SD.LooseQty * SD.UnitSalesTax) + ROUND(SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2)) / CASE WHEN ROUND(SUM(SD.LooseQty * SD.SalePrice) - SUM(SD.LooseQty * SD.ItemFlatDisc) - SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) = 0 THEN 1 ELSE ROUND(SUM(SD.LooseQty * SD.SalePrice) - SUM(SD.LooseQty * SD.ItemFlatDisc) - SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) END) * 100, 0),
	SalesTaxAmount=ROUND(SUM(SD.LooseQty * SD.UnitSalesTax) + ROUND(SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2),2),
	AdvanceTaxPerc=ROUND(SD.ItemAdvanceTaxPerc,2),
	AdvanceTaxAmount= ROUND((SUM((SD.PackQty + SD.LooseQty) * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) + 
		SUM((SD.PackQty + SD.LooseQty + SD.BonusQty) * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.Gstperc * 0.01) +
		SUM((SD.PackQty + SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax)) * SD.ItemAdvanceTaxPerc * 0.01, 2),
	SalesType=CASE WHEN SL.SaleCatCode = 3 THEN 'Cash' ELSE 'Credit' END
FROM
	SaleLedger SL,
	SaleDetail SD,
	Customer C,
	Accounts A,
	Item I
WHERE 
	:as_crs = 'N' AND
	:as_reporttype = 'S' AND
	SL.Posted='Y' AND
	SL.PostDate BETWEEN :adt_startdate AND :adt_enddate AND
	SL.SaleInvCode=SD.SaleInvCode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	SD.ICode = I.ICode
GROUP BY
	SL.PostDate,
	C.CustCode,
	SL.SaleInvCode,
	SL.SaleCatCode,
	A.AliasName,
	A.Name,
	I.Name,
	I.CustomICode,
	SD.DiscPerc,
	SD.ItemAdvanceTaxPerc
UNION ALL
SELECT 
	Client = SPACE(100),
	DATE = CONVERT(VARCHAR(100), SL.PostDate, 101),
	CustomerGroup=(SELECT MAX(CG.Name) FROM CustomerGroup CG, CustomerGroupDetail CGD WHERE CG.CustomerGroupCode=CGD.CustomerGroupCode AND CGD.CustCode=C.CustCode),
	CustomerCode=A.AliasName,
	CustomerName=A.Name,
	InvoiceCode=SL.SRInvCode,
	ItemName=I.Name,
	ItemAliasCode=I.CustomICode,
	ItemQty=SUM(SD.LooseQty),
	BonusQty=SUM(SD.BonusQty),
	ItemGrossAmount=ROUND(SUM(SD.LooseQty * SD.SRPrice),2),
	PreDiscPerc = 0.00,
	DiscPerc = SD.DiscPerc, 
	TotalDiscountPerc=ROUND((SUM(SD.LooseQty * SD.SRPrice * SD.DiscPerc * 0.01) / CASE WHEN SUM(SD.LooseQty * SD.SRPrice) = 0 THEN 1 ELSE SUM(SD.LooseQty * SD.SRPrice) END) * 100, 2),
	ItemDiscountAmount=ROUND(SUM(SD.LooseQty * SD.SRPrice * SD.DiscPerc * 0.01), 2),
	ItemNetSalesAmount=ROUND(SUM(SD.LooseQty * SD.SRPrice) - SUM(SD.LooseQty * SD.SRPrice * SD.DiscPerc * 0.01), 2),
	SalesTaxPerc= ROUND(((SUM(SD.LooseQty * SD.UnitSalesTax) + ROUND(SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2)) / CASE WHEN SUM(SD.LooseQty * SD.SRPrice) = 0 THEN 1 ELSE SUM(SD.LooseQty * SD.SRPrice) END) * 100, 0),
	SalesTaxAmount=ROUND(SUM(SD.LooseQty * SD.UnitSalesTax) + ROUND(SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2), 2),
	AdvanceTaxPerc=ROUND(SD.ItemAdvanceTaxPerc, 2),
	AdvanceTaxAmount = ROUND((SUM((SD.PackQty + SD.LooseQty) * SD.SRPrice * (1 - SD.DiscPerc * 0.01)) + 
		SUM((SD.PackQty + SD.LooseQty + SD.BonusQty) * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SD.Gstperc * 0.01) +
		SUM((SD.PackQty + SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax)) * SD.ItemAdvanceTaxPerc * 0.01, 2),
	SalesType=CASE WHEN SL.SRCatCode = 8 THEN 'Cash' ELSE 'Credit' END
FROM
	SRLedger SL,
	SRDetail SD,
	Customer C,
	Accounts A,
	Item I
WHERE 
	:as_crs = 'N' AND
	:as_reporttype = 'R' AND
	SL.Posted='Y' AND
	SL.PostDate BETWEEN :adt_startdate AND :adt_enddate AND
	SL.SRInvCode=SD.SRInvCode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	SD.ICode = I.ICode
GROUP BY
	SL.PostDate,
	C.CustCode,
	SL.SRInvCode,
	SL.SRCatCode,
	A.AliasName,
	A.Name,
	I.Name,
	I.CustomICode,
	SD.DiscPerc,
	SD.ItemAdvanceTaxPerc
UNION ALL
SELECT 
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=SL.ClientInstanceID AND CI.ClientID=CL.ClientID),
	DATE = CONVERT(VARCHAR(100), SL.PostDate, 101),
	CustomerGroup=(SELECT MAX(CG.Name) FROM CustomerGroup CG, CustomerGroupDetail CGD WHERE CG.CustomerGroupCode=CGD.CustomerGroupCode AND CGD.CustCode=C.CustCode),
	CustomerCode=A.AliasName,
	CustomerName=A.Name,
	InvoiceCode=SL.SaleInvCode,
	ItemName=I.Name,
	ItemAliasCode=I.CustomICode,
	ItemQty=SUM(SD.LooseQty),
	BonusQty=SUM(SD.BonusQty),
	ItemGrossAmount=ROUND(SUM(SD.LooseQty * SD.SalePrice), 2),
	PreDiscPerc = SUM(Round((SD.ItemFlatDisc / CASE WHEN SD.SalePrice = 0 THEN 1 ELSE SD.SalePrice END) * 100, 2)),
	DiscPerc = SD.DiscPerc, 
	TotalDiscountPerc=ROUND(((SUM(SD.LooseQty * SD.ItemFlatDisc) + SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01))) / CASE WHEN SUM(SD.LooseQty * SD.SalePrice) = 0 THEN 1 ELSE SUM(SD.LooseQty * SD.SalePrice) END) * 100, 2),
	ItemDiscountAmount=ROUND(SUM(SD.LooseQty * SD.ItemFlatDisc) + SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)),2),
	ItemNetSalesAmount=ROUND(SUM(SD.LooseQty * SD.SalePrice) - SUM(SD.LooseQty * SD.ItemFlatDisc) - SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2),
	SalesTaxPerc= ROUND(((SUM(SD.LooseQty * SD.UnitSalesTax) + ROUND(SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2)) / CASE WHEN ROUND(SUM(SD.LooseQty * SD.SalePrice) - SUM(SD.LooseQty * SD.ItemFlatDisc) - SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) = 0 THEN 1 ELSE ROUND(SUM(SD.LooseQty * SD.SalePrice) - SUM(SD.LooseQty * SD.ItemFlatDisc) - SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)), 2) END) * 100, 0),
	SalesTaxAmount=ROUND(SUM(SD.LooseQty * SD.UnitSalesTax) + ROUND(SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2),2),
	AdvanceTaxPerc=ROUND(SD.ItemAdvanceTaxPerc,2),
	AdvanceTaxAmount= ROUND((SUM((SD.PackQty + SD.LooseQty) * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) + 
		SUM((SD.PackQty + SD.LooseQty + SD.BonusQty) * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.Gstperc * 0.01) +
		SUM((SD.PackQty + SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax)) * SD.ItemAdvanceTaxPerc * 0.01, 2),
	SalesType=CASE WHEN SL.SaleCatCode = 3 THEN 'Cash' ELSE 'Credit' END
FROM
	CRS_SaleLedger SL,
	CRS_SaleDetail SD,
	Customer C,
	Accounts A,
	Item I
WHERE 
	:as_crs = 'Y' AND
	:as_reporttype = 'S' AND
	SL.Posted='Y' AND
	SL.PostDate BETWEEN :adt_startdate AND :adt_enddate AND
	SL.ClientInstanceID = SD.ClientInstanceID AND
	SL.SaleInvCode=SD.SaleInvCode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	SD.ICode = I.ICode
GROUP BY
	SL.ClientInstanceID,
	SL.PostDate,
	C.CustCode,
	SL.SaleInvCode,
	SL.SaleCatCode,
	A.AliasName,
	A.Name,
	I.Name,
	I.CustomICode,
	SD.DiscPerc,
	SD.ItemAdvanceTaxPerc
UNION ALL
SELECT 
	Client=(SELECT CL.Name FROM CRS_ClientList CL, CRS_ClientInstance CI WHERE CI.ClientInstanceID=SL.ClientInstanceID AND CI.ClientID=CL.ClientID),
	DATE = CONVERT(VARCHAR(100), SL.PostDate, 101),
	CustomerGroup=(SELECT MAX(CG.Name) FROM CustomerGroup CG, CustomerGroupDetail CGD WHERE CG.CustomerGroupCode=CGD.CustomerGroupCode AND CGD.CustCode=C.CustCode),
	CustomerCode=A.AliasName,
	CustomerName=A.Name,
	InvoiceCode=SL.SRInvCode,
	ItemName=I.Name,
	ItemAliasCode=I.CustomICode,
	ItemQty=SUM(SD.LooseQty),
	BonusQty=SUM(SD.BonusQty),
	ItemGrossAmount=ROUND(SUM(SD.LooseQty * SD.SRPrice),2),
	PreDiscPerc = 0.00,
	DiscPerc = SD.DiscPerc, 
	TotalDiscountPerc=ROUND((SUM(SD.LooseQty * SD.SRPrice * SD.DiscPerc * 0.01) / CASE WHEN SUM(SD.LooseQty * SD.SRPrice) = 0 THEN 1 ELSE SUM(SD.LooseQty * SD.SRPrice) END) * 100, 2),
	ItemDiscountAmount=ROUND(SUM(SD.LooseQty * SD.SRPrice * SD.DiscPerc * 0.01), 2),
	ItemNetSalesAmount=ROUND(SUM(SD.LooseQty * SD.SRPrice) - SUM(SD.LooseQty * SD.SRPrice * SD.DiscPerc * 0.01), 2),
	SalesTaxPerc= ROUND(((SUM(SD.LooseQty * SD.UnitSalesTax) + ROUND(SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2)) / CASE WHEN SUM(SD.LooseQty * SD.SRPrice) = 0 THEN 1 ELSE SUM(SD.LooseQty * SD.SRPrice) END) * 100, 0),
	SalesTaxAmount=ROUND(SUM(SD.LooseQty * SD.UnitSalesTax) + ROUND(SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2), 2),
	AdvanceTaxPerc=ROUND(SD.ItemAdvanceTaxPerc, 2),
	AdvanceTaxAmount = ROUND((SUM((SD.PackQty + SD.LooseQty) * SD.SRPrice * (1 - SD.DiscPerc * 0.01)) + 
		SUM((SD.PackQty + SD.LooseQty + SD.BonusQty) * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SD.Gstperc * 0.01) +
		SUM((SD.PackQty + SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax)) * SD.ItemAdvanceTaxPerc * 0.01, 2),
	SalesType=CASE WHEN SL.SRCatCode = 8 THEN 'Cash' ELSE 'Credit' END
FROM
	CRS_SRLedger SL,
	CRS_SRDetail SD,
	Customer C,
	Accounts A,
	Item I
WHERE 
	:as_crs = 'Y' AND
	:as_reporttype = 'R' AND
	SL.Posted='Y' AND
	SL.PostDate BETWEEN :adt_startdate AND :adt_enddate AND
	SL.ClientInstanceID = SD.ClientInstanceID AND
	SL.SRInvCode=SD.SRInvCode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	SD.ICode = I.ICode
GROUP BY
	SL.ClientInstanceID,
	SL.PostDate,
	C.CustCode,
	SL.SRInvCode,
	SL.SRCatCode,
	A.AliasName,
	A.Name,
	I.Name,
	I.CustomICode,
	SD.DiscPerc, 
	SD.ItemAdvanceTaxPerc
"
  arguments=(("as_crs", string), ("adt_startdate", datetime), ("adt_enddate", datetime), ("as_reporttype", string))
)
