release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=invoicelen dbname="InvoiceLen"  )
column=(type=char(10) updatewhereclause=yes name=invoice dbname="Invoice"  )
column=(type=long updatewhereclause=yes name=datelen dbname="DateLen"  )
column=(type=char(10) updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=custcodelen dbname="CustCodeLen"  )
column=(type=char(10) updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=long updatewhereclause=yes name=prodcodelen dbname="ProdCodeLen"  )
column=(type=char(10) updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=long updatewhereclause=yes name=batchlen dbname="BatchLen"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=long updatewhereclause=yes name=unitslen dbname="UnitsLen"  )
column=(type=char(10) updatewhereclause=yes name=units dbname="Units"  )
column=(type=long updatewhereclause=yes name=bonuslen dbname="BonusLen"  )
column=(type=char(10) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=long updatewhereclause=yes name=discountlen dbname="DiscountLen"  )
column=(type=char(12) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=long updatewhereclause=yes name=flaglen dbname="FlagLen"  )
column=(type=char(2) updatewhereclause=yes name=flag dbname="Flag"  )
column=(type=long updatewhereclause=yes name=dscodelen dbname="DsCodeLen"  )
column=(type=char(100) updatewhereclause=yes name=dscode dbname="DsCode"  )
 retrieve="SELECT 
	InvoiceLen=10,
	Invoice=STR(S.SaleInvCode, 10),
	DateLen = 10,
	Date = CONVERT(VARCHAR(10), S.Date, 103),
	CustCodeLen=10,
	CustCode=STR(S.CustCode, 10),
	ProdCodeLen=10,
	ProdCode=STR(SD.ICode, 10),
	BatchLen=10,
	Batch=SD.Batch,
	UnitsLen=10,
	Units=STR(SD.LooseQty, 10), 
	BonusLen=10,
	Bonus=STR(SD.BonusQty, 10), 
	DiscountLen=12,
	Discount=STR( 
		(SD.LooseQty * SD.ItemFlatDisc) + 
		(SD.LooseQty * SD.SalePrice * SD.DiscPerc * 0.01) + 
		(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * S.DiscPerc * 0.01), 12, 2), 
	FlagLen=2,
	Flag='S ',
	DsCodeLen=100,
	DsCode=CONVERT(VARCHAR(100), :as_dscode)
FROM
	SaleLedger S, SaleDetail SD, Item I
WHERE
	S.Date >= :ar_startdate AND S.Date <= :ar_enddate AND
	SD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode) AND
	S.SaleInvCode = SD.SaleInvCode
UNION ALL
SELECT 
	InvoiceLen=10,
	Invoice=STR(S.SRInvCode, 10),
	DateLen = 10,
	Date = CONVERT(VARCHAR(10), S.Date, 103),
	CustCodeLen=10,
	CustCode=STR(S.CustCode, 10),
	ProdCodeLen=10,
	ProdCode=STR(SD.ICode, 10),
	BatchLen=10,
	Batch=SD.Batch,
	UnitsLen=10,
	Units=STR(-SD.LooseQty, 10), 
	BonusLen=10,
	Bonus=STR(-SD.BonusQty, 10), 
	DiscountLen=12,
	Discount=STR( 
		(SD.LooseQty * SD.SalePrice * SD.DiscPerc * 0.01) + 
		(SD.LooseQty * SD.SalePrice * (1 - SD.DiscPerc * 0.01) * S.DiscPerc * 0.01), 12, 2), 
	FlagLen=2,
	Flag='SR',
	DsCodeLen=100,
	DsCode=CONVERT(VARCHAR(100), :as_dscode)
FROM
	SRLedger S, SRDetail SD, Item I
WHERE
	S.Date >= :ar_startdate AND S.Date <= :ar_enddate AND
	SD.ICode = I.ICode AND I.ManfCode IN (:ai_manfcode) AND
	S.SRInvCode = SD.SRInvCode
ORDER BY
	CustCode,
	ProdCode,
	Flag
"
  arguments=(("ai_manfcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime), ("as_dscode", string))
)
