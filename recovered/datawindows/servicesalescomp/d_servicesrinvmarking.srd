table(column=(type=long key=yes update=yes updatewhereclause=yes name=invoicecode dbname="ServiceRHeader.ServiceRInvCode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="ServiceRHeader.HeaderNo"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="HeaderInvNo"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="ServiceRHeader.Date"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="ServiceRHeader.CustCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.Name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=outstandingamt dbname="ServiceRHeader.OutstandingAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=netamt dbname="ServiceRHeader.InvTotal"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="ServiceRHeader.Posted"  )
column=(type=char(1) updatewhereclause=yes name=oldmarked dbname="OldMarked"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="AccountFor"  )
column=(type=char(1) update=yes updatewhereclause=yes name=marked dbname="ServiceRHeader.Marked" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	ServiceRHeader.ServiceRInvCode,
	ServiceRHeader.HeaderNo,
	HeaderInvNo=NULL,
	ServiceRHeader.Date,
	ServiceRHeader.CustCode,
	Accounts.Name,
	Accounts.AliasName,
	ServiceRHeader.OutstandingAmt,
	ServiceRHeader.InvTotal,
	ServiceRHeader.Posted,
	OldMarked=ServiceRHeader.Marked,
	AccountFor='Y',
	ServiceRHeader.Marked
FROM 
	ServiceRHeader, Accounts
WHERE
	ServiceRHeader.Posted ='Y' AND
	ServiceRHeader.CustCode = Accounts.AccCode"
  update="ServiceRHeader" updatewhere=1 updatekeyinplace=yes
 )
