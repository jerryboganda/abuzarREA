table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="username"  )
column=(type=long updatewhereclause=yes name=serviceheader_serviceinvcode dbname="serviceinvcode"  )
column=(type=char(60) updatewhereclause=yes name=doctorname dbname="doctorname"  )
column=(type=datetime updatewhereclause=yes name=serviceheader_date dbname="date"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceheader_discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceheader_misccharges dbname="misccharges"  )
column=(type=long updatewhereclause=yes name=serviceheader_custcode dbname="custcode"  )
column=(type=char(100) updatewhereclause=yes name=serviceheader_remarks dbname="remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=long updatewhereclause=yes name=reprintcounter dbname="reprintcounter"  )
column=(type=long updatewhereclause=yes name=service_servicecode dbname="servicecode"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="serviceflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="servicedetail_discperc"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=servicecatcode dbname="servicecatcode"  )
column=(type=long updatewhereclause=yes name=tokenno dbname="tokenno"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceinvtotal dbname="serviceinvtotal"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflattax dbname="ServiceFlatTax"  )
column=(type=decimal(2) updatewhereclause=yes name=servicegstperc dbname="ServiceGSTPerc"  )
 retrieve="SELECT 
	itemname = service.name,
	reprintdate = getDate(),
	users.username,  
	dbo.serviceheader.serviceinvcode,  
	doctorname=(select name from doctors where doctors.doctcode=serviceheader.doctcode), 
	dbo.serviceheader.date,  
	dbo.serviceheader.headerno,
	dbo.serviceheader.discperc,   
	dbo.serviceheader.misccharges,   
	dbo.serviceheader.custcode,   
	dbo.serviceheader.remarks,
	dbo.serviceheader.flatdisc,
	reprintcounter = dbo.serviceheader.reprintingcounter,
	dbo.service.servicecode,   
	price = dbo.servicedetail.price, 
	serviceflatdisc = dbo.servicedetail.serviceflatdisc, 
	Qty = dbo.servicedetail.qty,
	servicedetail_discperc = servicedetail.discperc, 
	customername=(SELECT Accounts.Name FROM Accounts WHERE Accounts.AccCode  = serviceheader.Custcode),
	dbo.serviceheader.saleinvcode,
	dbo.serviceheader.servicecatcode,
	tokenno = dbo.serviceheader.tokenno,
	serviceinvtotal=dbo.fn_getserviceinvtotal(T.ServiceInvCode),
	ServiceFlatTax = dbo.servicedetail.ServiceFlatTax,
	ServiceGSTPerc = dbo.servicedetail.ServiceGSTPerc
FROM 
	(SELECT ServiceInvCode FROM ServiceOHeader WHERE ServiceOHeader.ServiceOCode=:ar_Code) T,
	dbo.serviceheader,   
	dbo.servicedetail,  
	service, 
	users
	
WHERE 
	( dbo.serviceheader.serviceinvcode = T.ServiceInvCode ) AND
	( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND 
	( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND
	( servicedetail.servicecode = service.servicecode )
"
  arguments=(("ar_Code", number))
)
