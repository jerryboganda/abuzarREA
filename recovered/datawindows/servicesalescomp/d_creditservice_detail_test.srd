release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=68 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=icode dbname="ServiceDetail.servicecode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=char(9) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="ServiceDetail.serviceinvcode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) < 100" validationmsg="'Dsicount (%) must be between 0 and 100'" initial="0" name=discperc dbname="ServiceDetail.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="ServiceDetail.price"  )
 retrieve="  SELECT servicedetail.servicecode,
			itemname= service.name, 
			currlistrow = 0,
			fullcode = '         ',
			servicedetail.serviceinvcode,   
			Servicedetail.discperc,
         servicedetail.price

			
    FROM servicedetail,   
         service 

   WHERE ( servicedetail.serviceinvcode = :ar_SaleInvCode )    AND
		   ( servicedetail.servicecode = service.servicecode )
         




"
  arguments=(("ar_SaleInvCode", number))
)
