summary(height=77 color="536870912" )
footer(height=0 color="536870912" )
detail(height=93 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ServiceDetail.ServiceInvCode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="ServiceDetail.ServiceCode"  )
column=(type=long key=yes updatewhereclause=yes name=srvrowid dbname="ServiceDetail.SrvRowId"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=qty dbname="ServiceDetail.Qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="ServiceDetail.Price"  )
column=(type=decimal(15) updatewhereclause=yes name=prediscperc dbname="PreDiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=serviceflatdisc dbname="ServiceDetail.ServiceFlatDisc"  )
column=(type=char(1) updatewhereclause=yes name=allowsaleindecimal dbname="AllowSaleInDecimal"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=lockprice dbname="LockPrice"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=lockdiscperc dbname="LockDiscPerc"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=lockserviceflatdisc dbname="LockServiceFlatDisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=discperc dbname="ServiceDetail.DiscPerc"  )
column=(type=long update=yes updatewhereclause=yes name=smancode dbname="ServiceDetail.SmanCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=commission dbname="ServiceDetail.Commission"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0.00" name=costprice dbname="ServiceDetail.CostPrice"  )
column=(type=datetime update=yes updatewhereclause=yes name=deliverydate dbname="ServiceDetail.DeliveryDate"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=sampletaken dbname="ServiceDetail.SampleTaken"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=reportmade dbname="ServiceDetail.ReportMade"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ServiceDetail.Remarks"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=serviceflattax dbname="ServiceDetail.ServiceFlatTax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=servicegstperc dbname="ServiceDetail.servicegstperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=shareperc dbname="ServiceDetail.SharePerc"  )
 retrieve="SELECT 
	ServiceDetail.ServiceInvCode,   
	ServiceDetail.ServiceCode,   
	ServiceDetail.SrvRowId,
	ServiceDetail.Qty,
	ServiceDetail.Price,   
	PreDiscPerc=ROUND( (servicedetail.serviceflatdisc / CASE WHEN servicedetail.Price > 0 THEN servicedetail.Price ELSE 1 END) * 100, 2),
	ServiceDetail.ServiceFlatDisc,   
	AllowSaleInDecimal=Service.AllowSaleInDecimal,
	LockPrice = Service.LockPrice,
	LockDiscPerc = Service.LockDiscPerc,
	LockServiceFlatDisc = Service.LockServiceFlatDisc,
	ServiceDetail.DiscPerc,
	ServiceDetail.SmanCode,
	ServiceDetail.Commission,
	Servicedetail.CostPrice,
	ServiceDetail.DeliveryDate,
	ServiceDetail.SampleTaken,
	ServiceDetail.ReportMade,
	ServiceDetail.Remarks,
	ServiceDetail.ServiceFlatTax,
	ServiceDetail.servicegstperc,
	ServiceDetail.SharePerc
FROM ServiceDetail, Service
WHERE 
	ServiceDetail.ServiceInvCode = :ai_code AND
	Service.ServiceCode=ServiceDetail.ServiceCode
"
  update="ServiceDetail" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
