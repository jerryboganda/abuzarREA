table(column=(type=long updatewhereclause=yes name=code dbname="ServiceHeader.serviceinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ServiceHeader.date"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ServiceHeader.remarks"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(60) updatewhereclause=yes name=customer_name dbname="Accounts.name"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=char(100) updatewhereclause=yes name=fullpatientname dbname="FullPatientName"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="patientregno"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=long updatewhereclause=yes name=age dbname="Age"  )
column=(type=char(100) updatewhereclause=yes name=refby dbname="RefBy"  )
column=(type=char(60) updatewhereclause=yes name=ref1 dbname="Ref1"  )
column=(type=char(60) updatewhereclause=yes name=ref2 dbname="Ref2"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(60) updatewhereclause=yes name=studentregno dbname="studentregno"  )
column=(type=char(100) updatewhereclause=yes name=student dbname="student"  )
column=(type=char(100) updatewhereclause=yes name=studentclass dbname="studentClass"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
 retrieve="SELECT  
	serviceheader.serviceinvcode , 
	serviceheader.date , 
	InvTotal = serviceheader.InvTotal,
	serviceheader.remarks , 
	custcode=serviceheader.custcode,
	accounts.name,
	posted = serviceheader.posted,
	PostedBy = IsNull((Select username from users 
				where dbo.serviceheader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
				where dbo.serviceheader.modifiedby = dbo.users.usercode), '') ,
	FullPatientName=FullPatientName,
	patient=(select name from patient where patient.patientcode=Serviceheader.patientcode),
	patientregno=(select Regno from patient where patient.patientcode=Serviceheader.patientcode),
	Gender=(SELECT P.Gender FROM Patient P WHERE P.PatientCode=serviceheader.PatientCode),
	Age=(SELECT P.AgeYears FROM Patient P WHERE P.PatientCode=serviceheader.PatientCode),
	RefBy=PatientRefBy,
	Ref1=Ref1,
	Ref2=Ref2,
	Remarks=serviceheader.Remarks,
	HeaderNo=serviceheader.HeaderNo,
	PatientCode=serviceheader.PatientCode,
	studentregno=(select Student.Regno from student where student.studentcode=Serviceheader.studentcode),
	student=(select Student.Name from student where student.studentcode=Serviceheader.studentcode),
	studentClass=(select C.Name from student, Class C where student.studentcode=Serviceheader.studentcode and student.currentclass=C.classcode),
	StudentCode=ServiceHeader.StudentCode
FROM
	accounts , 
	serviceheader
WHERE 
	:as_showrows = 'Y' AND 
	( dbo.serviceheader.servicecatcode IN(12, 11 )) and
	(dbo.serviceheader.date > :ad_invdate) and
	( serviceheader.admissioncode IS NULL ) and 
	( serviceheader.custcode = accounts.acccode ) and 
	( Posted IN (:as_Posted))"
  arguments=(("ai_SaleCatCode", number), ("as_Posted", stringlist), ("ad_invdate", datetime), ("as_showrows", string))
)
