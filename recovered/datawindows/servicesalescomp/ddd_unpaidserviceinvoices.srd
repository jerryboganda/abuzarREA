footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="OutstandingAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve="SELECT  
	ServiceInvCode,
	Date,
	CustCode,
	Customer,
	AliasName,
	OutstandingAmt,
	InvTotal
FROM
(SELECT 
	ServiceHeader.ServiceInvCode,
	ServiceHeader.Date,
	ServiceHeader.CustCode,
	Customer=Accounts.Name,
	AliasName=Accounts.AliasName,
	OutstandingAmt = ServiceHeader.OutstandingAmt + 
		CASE :module
		WHEN 'SRA' THEN 
			ISNULL((SELECT SUM(Amt) FROM ServiceSRAllocationDetail 
			Where ServiceSRAllocationCode = :Code AND ServiceSRAllocationDetail.ServiceInvCode = ServiceHeader.ServiceInvCode), 0)
		ELSE 
			ISNULL((SELECT SUM(Debit-Credit) 
			FROM GLDetail D, GLHeader H, VocherCategory C
			Where D.GlVochCode = :Code AND D.InvoiceCode = ServiceHeader.ServiceInvCode AND D.GlVochCode = H.GlVochCode AND H.VochCatCode = C.VochCatCode AND C.InvoiceType=3), 0)
		END,
	ServiceHeader.InvTotal
FROM 
	ServiceHeader, Accounts
WHERE
	ServiceHeader.Marked ='N' AND
	ServiceHeader.Posted ='Y' AND
	ServiceHeader.CustCode = :custcode AND
	ServiceHeader.CustCode = Accounts.AccCode) S
WHERE
	OutstandingAmt > 0
ORDER BY
	Date,   
	ServiceInvCode"
  arguments=(("custcode", number), ("code", number), ("module", string))
)
