table(column=(type=long key=yes update=yes updatewhereclause=yes name=invoicecode dbname="ServiceHeader.ServiceInvCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="ServiceHeader.Date"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="ServiceHeader.CustCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.Name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=outstandingamt dbname="ServiceHeader.OutstandingAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=netamt dbname="ServiceHeader.InvTotal"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="ServiceHeader.Posted"  )
column=(type=char(1) updatewhereclause=yes name=oldmarked dbname="OldMarked"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="AccountFor"  )
column=(type=char(1) update=yes updatewhereclause=yes name=marked dbname="ServiceHeader.Marked" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	ServiceHeader.ServiceInvCode,
	ServiceHeader.Date,
	ServiceHeader.CustCode,
	Accounts.Name,
	Accounts.AliasName,
	ServiceHeader.OutstandingAmt,
	ServiceHeader.InvTotal,
	ServiceHeader.Posted,
	OldMarked=ServiceHeader.Marked,
	AccountFor='Y',
	ServiceHeader.Marked
FROM 
	ServiceHeader, Accounts
WHERE
	ServiceHeader.ServiceInvCode IN (:ia_invoices) AND
	ServiceHeader.Posted ='Y' AND
	ServiceHeader.CustCode = Accounts.AccCode"
  update="ServiceHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ia_invoices", numberlist))
)
