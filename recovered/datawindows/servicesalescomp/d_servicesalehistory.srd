summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="name"  )
column=(type=char(60) updatewhereclause=yes name=aliasname dbname="Aliasname"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="Serviceinvcode"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="Saleinvcode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=usercode dbname="usercode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="serviceflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=char(12) updatewhereclause=yes name=customeraliasname dbname="customeraliasname"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
 retrieve="select  	Service.name,
			Aliasname=Service.AliasName,
			Serviceinvcode=serviceheader.Serviceinvcode,
			Saleinvcode=serviceheader.Saleinvcode,
			custcode=serviceheader.custcode,
			headerno=serviceheader.headerno,
			usercode=serviceheader.salesmancode,
			remarks=serviceheader.remarks,
			invdiscperc=serviceheader.discperc,
			Date=serviceheader.date,
			Qty=sd.qty,
			SalePrice=sd.Price, 
			serviceflatdisc=sd.serviceflatdisc,
	         DiscPerc=sd.discperc,
			customeraliasname=dbo.accounts.aliasname,	
			CustomerName=dbo.accounts.name,
			patientname = (select p.name from patient p where p.patientcode=serviceheader.patientcode)
From   (Select servicecode,serviceinvcode,qty,price,serviceflatdisc,discperc From servicedetail Where servicecode = :ar_servicecode) sd 
       Inner Loop join serviceheader On sd.serviceinvcode = serviceheader.serviceinvcode 
       Inner Join Accounts On serviceheader.CustCode = Accounts.Acccode
       Inner Join Service On SD.ServiceCode = Service.ServiceCode 
"
  arguments=(("ar_servicecode", number))
 sort="date D, itemname A"
)
