release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="IncentiveSheet.IncentiveDocCode"  )
column=(type=long update=yes updatewhereclause=yes name=dracccode dbname="IncentiveSheet.DrAccCode"  )
column=(type=char(60) updatewhereclause=yes name=dracname dbname="DrAcName"  )
column=(type=long update=yes updatewhereclause=yes name=cracccode dbname="IncentiveSheet.CrAccCode"  )
column=(type=char(60) updatewhereclause=yes name=cracname dbname="CrAcName"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="IncentiveSheet.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="IncentiveSheet.UserCode" 
 values=""  )
column=(type=decimal(6) updatewhereclause=yes name=incentiveamount dbname="IncentiveAmount"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="IncentiveSheet.Posted"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="IncentiveSheet.PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=glvochcode dbname="IncentiveSheet.GLVochCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=startdate dbname="IncentiveSheet.StartDate"  )
column=(type=datetime update=yes updatewhereclause=yes name=enddate dbname="IncentiveSheet.EndDate"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="IncentiveSheet.Remarks"  )
 retrieve="SELECT 
	IncentiveSheet.IncentiveDocCode,   
	IncentiveSheet.DrAccCode,
	DrAcName = (SELECT AC.Name FROM Accounts AC WHERE AC.AccCode = IncentiveSheet.DrAccCode),
	IncentiveSheet.CrAccCode,   
	CrAcName = (SELECT AC.Name FROM Accounts AC WHERE AC.AccCode = IncentiveSheet.CrAccCode),
	IncentiveSheet.Date,   
	IncentiveSheet.UserCode,  
	IncentiveAmount = ISNULL((SELECT SUM(D.Qty * D.IncentiveRate) FROM IncentiveSheetDetail D WHERE D.IncentiveDocCode = IncentiveSheet.IncentiveDocCode),0), 
	IncentiveSheet.Posted,   
	IncentiveSheet.PostDate,   
	IncentiveSheet.GLVochCode,   
	IncentiveSheet.StartDate,   
	IncentiveSheet.EndDate,   
	IncentiveSheet.Remarks  
FROM 
	IncentiveSheet
ORDER BY 
	IncentiveSheet.IncentiveDocCode
"
  update="IncentiveSheet" updatewhere=1 updatekeyinplace=no
 )
