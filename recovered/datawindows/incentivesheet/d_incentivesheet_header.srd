column=(type=decimal(2) update=yes updatewhereclause=yes name=amount dbname="IncentiveSheet.Amount"  )
 retrieve="SELECT 
	IncentiveSheet.IncentiveDocCode,   
	IncentiveSheet.DrAccCode,   
	IncentiveSheet.CrAccCode,   
	IncentiveSheet.Date,   
	IncentiveSheet.UserCode,   
	IncentiveSheet.Posted,   
	IncentiveSheet.PostDate,
	IncentiveSheet.PostedBy,	
	IncentiveSheet.GLVochCode,   
	IncentiveSheet.StartDate,   
	IncentiveSheet.EndDate,   
	IncentiveSheet.Remarks,
	IncentiveSheet.Amount
FROM 
	IncentiveSheet  
WHERE 
	IncentiveSheet.IncentiveDocCode = :ai_code    
"
  update="IncentiveSheet" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
