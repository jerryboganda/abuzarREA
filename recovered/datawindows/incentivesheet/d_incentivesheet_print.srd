table(column=(type=long updatewhereclause=yes name=code dbname="IncentiveDocCode"  )
column=(type=char(60) updatewhereclause=yes name=debitaccount dbname="DebitAccount"  )
column=(type=char(60) updatewhereclause=yes name=creditaccount dbname="CreditAccount"  )
column=(type=long updatewhereclause=yes name=dracccode dbname="DrAccCode"  )
column=(type=long updatewhereclause=yes name=cracccode dbname="CrAccCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=long updatewhereclause=yes name=glvochcode dbname="GLVochCode"  )
column=(type=datetime updatewhereclause=yes name=startdate dbname="StartDate"  )
column=(type=datetime updatewhereclause=yes name=enddate dbname="EndDate"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=incentiverate dbname="IncentiveRate"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
 retrieve="SELECT
	IncentiveDocCode = IncentiveSheet.IncentiveDocCode, 
	DebitAccount = (SELECT AC.Name FROM Accounts AC WHERE Ac.AccCode = IncentiveSheet.DrAccCode),   
	CreditAccount = (SELECT AC.Name FROM Accounts AC WHERE Ac.AccCode = IncentiveSheet.CrAccCode),   
	DrAccCode=IncentiveSheet.DrAccCode,
	CrAccCode=IncentiveSheet.CrAccCode,
	Date=IncentiveSheet.Date,   
	UserCode=IncentiveSheet.UserCode,   
	Posted=IncentiveSheet.Posted,   
	PostDate=IncentiveSheet.PostDate,   
	GLVochCode=IncentiveSheet.GLVochCode,   
	StartDate=IncentiveSheet.StartDate,   
	EndDate=IncentiveSheet.EndDate,   
	Remarks=IncentiveSheet.Remarks,   
	Amount = IncentiveSheet.Amount,   
	ICode=IncentiveSheetDetail.ICode,   
	AliasName=(SELECT I.CustomICode FROM Item I WHERE I.ICode = IncentiveSheetDetail.ICode),   
	ItemName=(SELECT I.Name FROM Item I WHERE I.ICode = IncentiveSheetDetail.ICode),   
	Qty=IncentiveSheetDetail.Qty,   
	IncentiveRate=IncentiveSheetDetail.IncentiveRate,   
	RowID=IncentiveSheetDetail.RowID  
FROM IncentiveSheet,   
	IncentiveSheetDetail  
WHERE 
	( IncentiveSheetDetail.IncentiveDocCode = :ai_code ) AND
	( IncentiveSheetDetail.IncentiveDocCode = IncentiveSheet.IncentiveDocCode )    
ORDER BY
	RowID"
  arguments=(("ai_code", number))
)
