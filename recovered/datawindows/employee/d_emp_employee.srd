 retrieve="SELECT 
	EMP_Employee.EmpCode,   
	EMP_Employee.EmpID,   
	EMP_Employee.FullName,   
	EMP_Employee.Gender,   
	EMP_Employee.MaritalStatus,   
	EMP_Employee.Date,   
	EMP_Employee.Active,
	EMP_Employee.BirthDate,   
	EMP_Employee.JoinDate,   
	EMP_Employee.EmpCatCode,   
	EMP_Employee.DeptCode,   
	EMP_Employee.DesigCode,   
	EMP_Employee.AccCode,   
	EMP_Employee.CNICNo,   
	EMP_Employee.FHName,   
	EMP_Employee.FHNICNo,   
	EMP_Employee.PMTAddress,   
	EMP_Employee.TmpAddress,   
	EMP_Employee.MobileNo,   
	EMP_Employee.PhoneNo,   
	EMP_Employee.Email,   
	EMP_Employee.Web,   
	EMP_Employee.Nationality,   
	EMP_Employee.Domicile,   
	EMP_Employee.Religion,   
	EMP_Employee.NTN,   
	EMP_Employee.BloodGroup,   
	EMP_Employee.ExitDate,   
	EMP_Employee.ExitReason,   

	EMP_Employee.RefferedBy,   
	EMP_Employee.RefferedByContactNo,   
	EMP_Employee.RefferedByCNICNo,   
	EMP_Employee.RefferedByAdress,   
	EMP_Employee.RefferedByRelation,   
	EMP_Employee.AllowAttendanceViaID,
	EMP_Employee.MaxTimeInLimitInHrs,

	Accounts.AccCode,   
	Accounts.SubCode,   
	Accounts.Name,   
	Accounts.OpeningDate,   
	Accounts.AliasName,   
	Accounts.Active,   
	Accounts.Restricted,   
	Accounts.BalanceLimit,   
	Accounts.Remarks,   
	Accounts.AlertCode,

	OpenAdvAccount=CASE WHEN EMP_Employee.AdvAccCode > 0 THEN 'Y' ELSE 'N' END,
	EMP_Employee.AdvAccCode,   
	Adv_SubCode=(SELECT A.SubCode FROM Accounts A WHERE A.AccCode = EMP_Employee.AdvAccCode),
	Adv_Name=(SELECT A.Name FROM Accounts A WHERE A.AccCode = EMP_Employee.AdvAccCode),
	Adv_OpeningDate=(SELECT A.OpeningDate FROM Accounts A WHERE A.AccCode = EMP_Employee.AdvAccCode),
	Adv_AliasName=(SELECT A.AliasName FROM Accounts A WHERE A.AccCode = EMP_Employee.AdvAccCode),
	Adv_Active=(SELECT A.Active FROM Accounts A WHERE A.AccCode = EMP_Employee.AdvAccCode),
	Adv_Restricted=(SELECT A.Restricted FROM Accounts A WHERE A.AccCode = EMP_Employee.AdvAccCode),
	Adv_BalanceLimit=(SELECT A.BalanceLimit FROM Accounts A WHERE A.AccCode = EMP_Employee.AdvAccCode),
	Adv_Remarks=(SELECT A.Remarks FROM Accounts A WHERE A.AccCode = EMP_Employee.AdvAccCode),
	Adv_AlertCode=(SELECT A.AlertCode FROM Accounts A WHERE A.AccCode = EMP_Employee.AdvAccCode),

	TransportRouteCode,
	VehicleCode,
	BankAccountNo,
	BankName,
	BankBranch

FROM 
	Accounts,   
	EMP_Employee  
WHERE 
	EMP_Employee.AccCode = Accounts.AccCode AND
	EMP_Employee.EmpCode = :ai_code
"
  update="EMP_Employee" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
