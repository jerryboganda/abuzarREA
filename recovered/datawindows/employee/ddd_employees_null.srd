footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=empcode dbname="EmpCode"  )
column=(type=char(358) update=yes updatewhereclause=yes name=employeename dbname="EmployeeName"  )
column=(type=char(255) update=yes updatewhereclause=yes name=fullname dbname="FullName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=empid dbname="EmpID"  )
column=(type=char(1) update=yes updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=maritalstatus dbname="MaritalStatus" 
 values="Single	S/Married	M/"  )
column=(type=long update=yes updatewhereclause=yes name=empcatcode dbname="EmpCatCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=deptcode dbname="DeptCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=desigcode dbname="DesigCode" 
 values=""  )
 retrieve="SELECT 
	EmpCode=NULL,
	EmployeeName = '<NONE>',
	FullName=NULL,
	EmpID=NULL,
	Gender=NULL,
	MaritalStatus=NULL,
	EmpCatCode=NULL,
	DeptCode=NULL,
	DesigCode=NULL
UNION ALL
SELECT 
	EMP_Employee.EmpCode,   
	EmployeeName = EMP_Employee.FullName + ' (' + EMP_Employee.EmpID + ')',
	EMP_Employee.FullName,   
	EMP_Employee.EmpID,   
	EMP_Employee.Gender,   
	EMP_Employee.MaritalStatus,   
	EMP_Employee.EmpCatCode,   
	EMP_Employee.DeptCode,   
	EMP_Employee.DesigCode  
FROM 
	EMP_Employee   
WHERE
	EMP_Employee.Active='Y'
ORDER BY
	EmployeeName
"
 )
