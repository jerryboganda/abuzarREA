release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1333 color="536870912" )
summary(height=187 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=empcode dbname="EmpCode"  )
column=(type=char(255) updatewhereclause=yes name=employeename dbname="EmployeeName"  )
column=(type=char(100) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(100) updatewhereclause=yes name=department dbname="Department"  )
column=(type=char(60) updatewhereclause=yes name=designation dbname="Designation"  )
column=(type=long updatewhereclause=yes name=attendancecount dbname="AttendanceCount"  )
column=(type=long updatewhereclause=yes name=dayscount dbname="DaysCount"  )
column=(type=long updatewhereclause=yes name=hoursworked dbname="HoursWorked"  )
column=(type=long updatewhereclause=yes name=minworked dbname="MinWorked"  )
 retrieve="SELECT 
	EmpCode=A.EmpCode, 
	EmployeeName=E.FullName,
	Category = C.Name,
	Department = D.Name,
	Designation = DS.Name,
	AttendanceCount = COUNT(A.EmpCode),
	DaysCount = COUNT(DISTINCT CONVERT(VARCHAR(100), A.TimeIn,104)),
	HoursWorked = CAST(SUM(DATEDIFF(n, A.TimeIn, ISNULL(A.TimeOut, GETDATE()))) / 60 AS INT),
	MinWorked = CAST(SUM(DATEDIFF(n, A.TimeIn, ISNULL(A.TimeOut, GETDATE()))) % 60 AS INT)
FROM 
	EMP_Attendance A,
	EMP_Employee E, 
	EMP_Department D, 
	EMP_Category C, 
	EMP_Designation DS
WHERE 
	A.TimeIN BETWEEN :adt_startdate AND :adt_enddate AND
	C.EmpCatCode IN (:ai_empcatcode) AND
	D.DeptCode IN (:ai_deptcode) AND
	A.EmpCode = E.EmpCode AND
	E.DeptCode = D.DeptCode AND 
	E.EmpCatCode = C.EmpCatCode AND 
	E.DesigCode = DS.DesigCode
GROUP BY
	A.EmpCode, 
	E.FullName,
	C.Name,
	D.Name,
	DS.Name
ORDER BY
	Department,
	EmployeeName"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_empcatcode", numberlist), ("ai_deptcode", numberlist))
 sort="department A, employeename A"
)
group(level=1 header.height=187 trailer.height=187 by=("department"  ) header.color="536870912" trailer.color="536870912" )
