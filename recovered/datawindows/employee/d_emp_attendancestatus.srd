table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="EMP_AttendanceStatus.AttendanceStatusCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="EMP_AttendanceStatus.Name"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=half dbname="EMP_AttendanceStatus.Half" 
 values="Both Halve	0/1st Half	1/2nd Half	2/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=deductionperc dbname="EMP_AttendanceStatus.DeductionPerc"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=autoset dbname="EMP_AttendanceStatus.AutoSet" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=timetype dbname="EMP_AttendanceStatus.TimeType" 
 values="Time-In	1/Time-Out	2/"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=margin dbname="EMP_AttendanceStatus.Margin"  )
 retrieve="SELECT 
	EMP_AttendanceStatus.AttendanceStatusCode,
	EMP_AttendanceStatus.Name,   
	EMP_AttendanceStatus.Half,   
	EMP_AttendanceStatus.DeductionPerc,   
	EMP_AttendanceStatus.AutoSet,   
	EMP_AttendanceStatus.TimeType,   
	EMP_AttendanceStatus.Margin
FROM 
	EMP_AttendanceStatus   
WHERE 
	EMP_AttendanceStatus.AttendanceStatusCode = :ai_code
"
  update="EMP_AttendanceStatus" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
