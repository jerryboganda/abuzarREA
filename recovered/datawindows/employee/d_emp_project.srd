detail(height=824 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="EMP_Project.EmpCode"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="<PROJECT TITLE>" name=projectname dbname="EMP_Project.ProjectName"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="N/A" name=oganization dbname="EMP_Project.Oganization"  )
column=(type=datetime update=yes updatewhereclause=yes initial="TODAY" name=fromdate dbname="EMP_Project.FromDate"  )
column=(type=datetime update=yes updatewhereclause=yes name=todate dbname="EMP_Project.ToDate"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=rowid dbname="EMP_Project.ROWID"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=briefdescription dbname="EMP_Project.BriefDescription"  )
 retrieve="SELECT 
	EmpCode,
	ProjectName,
	Oganization,
	FromDate,
	ToDate,
	ROWID,
	BriefDescription
FROM
	EMP_Project
WHERE 
	EMPCode = :ai_code
ORDER BY
	RowID DESC"
  update="EMP_Project" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
