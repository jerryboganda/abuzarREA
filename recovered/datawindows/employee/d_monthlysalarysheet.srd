table(column=(type=long update=yes updatewhereclause=yes name=code dbname="PayrollCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="Date"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=paymentdate dbname="PaymentDate"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="Posted"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="UserCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=lastsaved dbname="LastSaved"  )
column=(type=datetime update=yes updatewhereclause=yes name=fromdate dbname="FromDate"  )
column=(type=datetime update=yes updatewhereclause=yes name=todate dbname="ToDate"  )
column=(type=char(100) updatewhereclause=yes name=empid dbname="EmpID"  )
column=(type=char(255) updatewhereclause=yes name=employeename dbname="EmployeeName"  )
column=(type=long update=yes updatewhereclause=yes name=empcode dbname="EmpCode"  )
column=(type=char(100) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(100) updatewhereclause=yes name=department dbname="Department"  )
column=(type=char(60) updatewhereclause=yes name=designation dbname="Designation"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid net pay'" initial="0" name=netpayable dbname="NetPayable"  )
column=(type=char(100) updatewhereclause=yes name=bankaccountno dbname="BankAccountNo"  )
column=(type=decimal(2) updatewhereclause=yes name=workdays dbname="WorkDays"  )
column=(type=decimal(2) updatewhereclause=yes name=presents dbname="Presents"  )
column=(type=decimal(2) updatewhereclause=yes name=absents dbname="Absents"  )
column=(type=decimal(2) updatewhereclause=yes name=leaves dbname="Leaves"  )
column=(type=decimal(2) updatewhereclause=yes name=workinghours dbname="WorkingHours"  )
column=(type=decimal(2) updatewhereclause=yes name=perhourrate dbname="PerHourRate"  )
column=(type=decimal(2) updatewhereclause=yes name=basicpay dbname="BasicPay"  )
column=(type=decimal(2) updatewhereclause=yes name=overtimehours dbname="OverTimeHours"  )
column=(type=decimal(2) updatewhereclause=yes name=overtimerate dbname="OverTimeRate"  )
column=(type=decimal(2) updatewhereclause=yes name=overtime dbname="OverTime"  )
column=(type=decimal(2) updatewhereclause=yes name=bonuspay dbname="BonusPay"  )
column=(type=decimal(2) updatewhereclause=yes name=specialpay dbname="SpecialPay"  )
column=(type=decimal(2) updatewhereclause=yes name=additionalpay dbname="AdditionalPay"  )
column=(type=decimal(2) updatewhereclause=yes name=otherpay dbname="OtherPay"  )
column=(type=decimal(2) updatewhereclause=yes name=fine dbname="Fine"  )
column=(type=decimal(2) updatewhereclause=yes name=penalty dbname="Penalty"  )
column=(type=decimal(2) updatewhereclause=yes name=othercharge dbname="OtherCharge"  )
column=(type=decimal(2) updatewhereclause=yes name=advance dbname="Advance"  )
column=(type=decimal(6) updatewhereclause=yes name=allowances dbname="Allowances"  )
column=(type=decimal(6) updatewhereclause=yes name=deductions dbname="Deductions"  )
 retrieve="SELECT 
	PayrollCode=EP.PayrollCode,
	Date=EP.Date,
	PaymentDate=EP.PaymentDate,
	Posted=EP.Posted,
	PostDate=EP.PostDate,
	UserCode=EP.UserCode,
	LastSaved=EP.LastSaved,
	FromDate=EP.FromDate,
	ToDate=EP.ToDate,
	EmpID = (SELECT E.EmpID FROM EMP_Employee E WHERE E.EMPCode = EP.EmpCode),
	EmployeeName = (SELECT E.FullName FROM EMP_Employee E WHERE E.EMPCode = EP.EmpCode),
	EmpCode=EP.EmpCode,
	Category = (SELECT EC.Name FROM EMP_Category EC, EMP_Employee E WHERE EP.EmpCode = E.EmpCode AND E.EmpCatCode = EC.EmpCatCode),
	Department = (SELECT ED.Name FROM EMP_Department ED, EMP_Employee E WHERE EP.EmpCode = E.EmpCode AND E.DeptCode = ED.DeptCode),
	Designation = (SELECT ED.Name FROM EMP_Designation ED, EMP_Employee E WHERE EP.EmpCode = E.EmpCode AND E.DesigCode = ED.DesigCode),
	NetPayable=EP.NetPayable,
	BankAccountNo = EM.BankAccountNo,
	WorkDays=EP.WorkDays,
	Presents=EP.Presents,
	Absents=EP.Absents,
	Leaves=EP.Leaves,
	WorkingHours=(SELECT P.Workinghours FROM EMP_Pay P WHERE P.EMPCode = EP.EmpCode),
	PerHourRate=EP.PerHourRate,
	BasicPay=EP.BasicPay,
	OverTimeHours=EP.OverTimeHours,
	OverTimeRate=EP.OverTimeRate,
	OverTime=EP.OverTime,
	BonusPay=EP.BonusPay,
	SpecialPay=EP.SpecialPay,
	AdditionalPay=EP.AdditionalPay, 
	OtherPay=EP.OtherPay,
	Fine=EP.Fine,
	Penalty=EP.Penalty,
	OtherCharge=EP.OtherCharge,
	Advance=EP.Advance,
	Allowances = ISNULL((SELECT SUM(Round((EPP.BasicPay * EPA.Percentage * 0.01) + EPA.FlatAmount, 2))
		FROM EMP_Payroll EPP, Emp_PayrollAllowances EPA, EMP_Allowance EA
		WHERE EP.PayrollCode = EPP.PayrollCode AND  
			EP.PayrollCode = EPA.PayrollCode AND EPA.AllowanceCode = EA.AllowanceCode AND
			( EPA.Percentage > 0 OR EPA.FlatAmount > 0 )), 0),
	Deductions = ISNULL((SELECT SUM(Round((EPp.BasicPay * EPD.Percentage * 0.01) + EPD.FlatAmount, 2))
		FROM EMP_Payroll EPP, Emp_PayrollDeductions EPD, EMP_Deduction ED, Accounts A
		WHERE EP.PayrollCode = EPP.PayrollCode AND  EP.PayrollCode = EPD.PayrollCode AND 
			EPD.DeductionCode = ED.DeductionCode AND 
			ED.DeductionCode = A.AccCode AND
			( EPD.Percentage > 0 OR EPD.FlatAmount > 0 )), 0)
FROM EMP_Payroll EP, EMP_Employee EM
WHERE EP.FromDate >= :adt_startdate AND EP.ToDate <= :adt_enddate AND
	EP.EmpCode = EM.EmpCode AND
	EM.EmpCatCode IN (:ai_empcatcode)"
  arguments=(("ai_empcatcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
