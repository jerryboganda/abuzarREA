table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="EMP_Pay.EMPCode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=payfrequency dbname="EMP_Pay.PayFrequency" 
 values="Monthly	1/Half-Monthly	2/Weekly	3/Daily	4/"  )
column=(type=long update=yes updatewhereclause=yes initial="30" name=payfrequencyfactor dbname="EMP_Pay.PayFrequencyFactor"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="8" name=workinghours dbname="EMP_Pay.WorkingHours"  )
column=(type=long update=yes updatewhereclause=yes initial="7" name=workingweekdays dbname="EMP_Pay.WorkingWeekDays"  )
column=(type=long update=yes updatewhereclause=yes initial="2" name=paytype dbname="EMP_Pay.PayType" 
 values="Hourly	1/Daily	2/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=perhourrate dbname="EMP_Pay.PerHourRate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=basicpay dbname="EMP_Pay.BasicPay"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=overtime dbname="EMP_Pay.OverTime" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=overtimerate dbname="EMP_Pay.OverTimeRate"  )
column=(type=datetime update=yes updatewhereclause=yes name=lastpayment dbname="EMP_Pay.LastPayment"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=lastraised dbname="EMP_Pay.LastRaised"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=sundayspaid dbname="EMP_Pay.SundaysPaid" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=holidayspaid dbname="EMP_Pay.HolidaysPaid" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=estnetpay dbname="EstNetPay"  )
 retrieve="SELECT 
	EMP_Pay.EMPCode,   
	EMP_Pay.PayFrequency,   
	EMP_Pay.PayFrequencyFactor,
	EMP_Pay.WorkingHours,   
	EMP_Pay.WorkingWeekDays,   
	EMP_Pay.PayType,   
	EMP_Pay.PerHourRate,   
	EMP_Pay.BasicPay,   
	EMP_Pay.OverTime,   
	EMP_Pay.OverTimeRate,   
	EMP_Pay.LastPayment,   
	EMP_Pay.LastRaised,
	EMP_Pay.SundaysPaid,
	EMP_Pay.HolidaysPaid,
	EstNetPay=0.00
FROM 
	EMP_Pay  
WHERE 
	EMP_Pay.EMPCode = :ai_code   
		
"
  update="EMP_Pay" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
