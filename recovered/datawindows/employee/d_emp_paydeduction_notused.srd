table(column=(type=long update=yes updatewhereclause=yes name=code dbname="EMPCode"  )
column=(type=decimal(2) updatewhereclause=yes name=basicpay dbname="BasicPay"  )
column=(type=char(255) updatewhereclause=yes name=name dbname="Name"  )
column=(type=long key=yes updatewhereclause=yes name=deductioncode dbname="EMP_Deduction.DeductionCode"  )
column=(type=decimal(2) updatewhereclause=yes name=percentage dbname="EMP_Deduction.Percentage"  )
column=(type=decimal(2) updatewhereclause=yes name=flatamount dbname="EMP_Deduction.FlatAmount"  )
 retrieve="SELECT 
	EMPCode=:ai_code, 
	BasicPay = (SELECT P.BasicPay FROM EMP_Pay P WHERE P.EmpCode = :ai_code),
	Name = EMP_Deduction.Description,
	EMP_Deduction.DeductionCode,   
	EMP_Deduction.Percentage,   
	EMP_Deduction.FlatAmount  
FROM 
	EMP_Deduction  
WHERE 
	EMP_Deduction.DeductionCode NOT IN (SELECT EMP_PayDeduction.DeductionCode FROM EMP_PayDeduction WHERE EMP_PayDeduction.EmpCode=:ai_code)
"
  update="EMP_Deduction" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
 sort="name A"
)
