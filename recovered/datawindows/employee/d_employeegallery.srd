detail(height=824 color="536870912" )
table(column=(type=long updatewhereclause=yes name=empcode dbname="EMP_Image.EMPCode"  )
column=(type=char(100) updatewhereclause=yes name=empid dbname="EmpID"  )
column=(type=char(255) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(100) updatewhereclause=yes name=imagedescription dbname="EMP_Image.ImageDescription"  )
column=(type=long updatewhereclause=yes name=rowid dbname="EMP_Image.ROWID"  )
column=(type=char(100) updatewhereclause=yes name=imagetype dbname="EMP_Image.ImageType"  )
 retrieve="SELECT 
	Emp_Image.EMPCode,
	EmpID = EMP_Employee.EMPID,
	Name = EMP_Employee.FullName,
	Emp_Image.ImageDescription,
	Emp_Image.ROWID,
	Emp_Image.ImageType
FROM 
	Emp_Image, EMP_Employee
WHERE 
	Emp_Image.EmpCode = :ai_code AND
	Emp_Image.EmpCode = EMP_Employee.EMPCode
"
  arguments=(("ai_code", number))
)
