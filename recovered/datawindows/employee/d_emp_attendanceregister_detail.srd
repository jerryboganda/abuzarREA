table(column=(type=decimal(0) key=yes identity=yes update=yes updatewhereclause=yes name=code dbname="EMP_Attendance.AttendanceCode"  )
column=(type=long update=yes updatewhereclause=yes name=empcode dbname="EMP_Attendance.EMPCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=paytype dbname="PayType" 
 values="Hourly	1/Daily	2/"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=timein dbname="EMP_Attendance.TIMEIN"  )
column=(type=datetime update=yes updatewhereclause=yes name=timeout dbname="EMP_Attendance.TIMEOUT"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=attendancestatuscode dbname="EMP_Attendance.AttendanceStatusCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=payed dbname="EMP_Attendance.Payed" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=fingercode dbname="EMP_Attendance.FingerCode"  )
column=(type=long update=yes updatewhereclause=yes name=fingercodeout dbname="EMP_Attendance.FingerCodeOut"  )
column=(type=char(1) updatewhereclause=yes name=oldsupervised dbname="OldSupervised"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=supervised dbname="EMP_Attendance.Supervised" 
 values="Yes	Y/No	N/"  )
column=(type=datetime update=yes updatewhereclause=yes name=supervisedon dbname="EMP_Attendance.SupervisedOn"  )
column=(type=long update=yes updatewhereclause=yes name=supervisedby dbname="EMP_Attendance.SupervisedBy" 
 values=""  )
column=(type=char(255) update=yes updatewhereclause=yes name=comments dbname="EMP_Attendance.Comments"  )
 retrieve="SELECT
	EMP_Attendance.AttendanceCode,
	EMP_Attendance.EMPCode,
	PayType = (SELECT EP.PayType FROM EMP_Pay EP WHERE EP.EMPCode=EMP_Attendance.EMPCode),
	EMP_Attendance.TIMEIN,
	EMP_Attendance.TIMEOUT,
	EMP_Attendance.AttendanceStatusCode,
	EMP_Attendance.Payed,
	EMP_Attendance.FingerCode,
	EMP_Attendance.FingerCodeOut,
	OldSupervised=EMP_Attendance.Supervised,
	EMP_Attendance.Supervised,
	EMP_Attendance.SupervisedOn,
	EMP_Attendance.SupervisedBy,
	EMP_Attendance.Comments
FROM
	EMP_Attendance
WHERE
	EMP_Attendance.TIMEIN BETWEEN :adt_startdate AND :adt_enddate AND
	EMP_Attendance.EMPCode = CASE WHEN :ai_empcode IS NULL THEN EMP_Attendance.EMPCode ELSE :ai_empcode END
ORDER BY 
	EMP_Attendance.AttendanceCode ASC,   
	EMP_Attendance.TIMEIN ASC "
  update="EMP_Attendance" updatewhere=1 updatekeyinplace=yes
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_empcode", number))
)
