compute(name=c_tot_deductions visible="1" band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-8" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="134217857" x="2153" y="4" height="56" width="475" format="###,##0.00" expression="sum(( basicpay * percentage * 0.01) + flatamount for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
