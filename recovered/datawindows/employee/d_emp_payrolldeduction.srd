release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=68 color="536870912" )
summary(height=60 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="EMP_PayrollDeductions.PayrollCode"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=basicpay dbname="BasicPay"  )
column=(type=long key=yes update=yes updatewhereclause=yes initial="N" name=deductioncode dbname="DeductionCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="REAL(GETTEXT()) >= 0 AND REAL(GETTEXT()) <= 100" validationmsg="~"Please enter valid value for percentage~"" initial="0" name=percentage dbname="Percentage"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="REAL(GETTEXT()) >= 0" validationmsg="~"Please enter valid value for flat amount~"" initial="0" name=flatamount dbname="FlatAmount"  )
 retrieve="SELECT 
	PayrollCode,   
	BasicPay = (SELECT P.BasicPay FROM EMP_Payroll P WHERE P.PayrollCode = EMP_PayrollDeductions.PayrollCode),
	DeductionCode=DeductionCode,   
	Percentage=Percentage,   
	FlatAmount=FlatAmount  
FROM 
	EMP_PayrollDeductions  
WHERE 
	PayrollCode = :ai_code    
"
  update="EMP_PayrollDeductions" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
text(name=t_1 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-8" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="8388608" alignment="2" border="6" x="9" y="8" height="56" width="101" text="No." html.valueishtml="0" )
