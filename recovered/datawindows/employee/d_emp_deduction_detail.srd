table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Accounts.acccode"  )
column=(type=long update=yes updatewhereclause=yes initial="24" name=subcode dbname="Accounts.subcode" 
 values=""  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Accounts.name"  )
column=(type=long updatewhereclause=yes name=emp_deduction_deductioncode dbname="EMP_Deduction.DeductionCode"  )
column=(type=char(255) updatewhereclause=yes name=emp_deduction_description dbname="EMP_Deduction.Description"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid percentage for deduction~"" initial="0" name=emp_deduction_percentage dbname="EMP_Deduction.Percentage"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid deduction amount~"" initial="0" name=emp_deduction_flatamount dbname="EMP_Deduction.FlatAmount"  )
column=(type=long updatewhereclause=yes initial="4" name=catacccode dbname="CategoryAccounts.catacccode" 
 values=""  )
column=(type=long updatewhereclause=yes initial="2" name=mainacccode dbname="MainAccounts.mainacccode" 
 values=""  )
column=(type=char(12) update=yes updatewhereclause=yes name=aliasname dbname="Accounts.aliasname"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today()" name=openingdate dbname="Accounts.openingdate"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=active dbname="Accounts.active" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=restricted dbname="Accounts.Restricted" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=balancelimit dbname="balancelimit"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) > 0" name=newbalancelimit dbname="newbalancelimit"  )
column=(type=char(2) updatewhereclause=yes initial="DR" name=balancelimitype dbname="balancelimitype" 
 values="Debit	DR/Credit	CR/"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=alertcode dbname="Accounts.AlertCode" 
 values=""  )
column=(type=char(1000) update=yes updatewhereclause=yes name=remarks dbname="Accounts.Remarks"  )
 retrieve="SELECT 
	accounts.acccode ,
	accounts.subcode ,
	accounts.name,
	emp_deduction.DeductionCode,
	emp_deduction.Description,
	emp_deduction.Percentage,
	emp_deduction.FlatAmount,
	categoryaccounts.catacccode,
	mainaccounts.mainacccode ,
	accounts.aliasname,
	accounts.openingdate,
	accounts.active,
	accounts.Restricted,
	balancelimit=accounts.balancelimit,
	newbalancelimit=ABS(accounts.balancelimit),
	balancelimitype=CASE WHEN accounts.balancelimit < 0 THEN 'CR' ELSE 'DR' END,
	Accounts.AlertCode,
	Accounts.Remarks
FROM accounts, subaccounts, categoryaccounts, mainaccounts, emp_deduction
WHERE ( accounts.acccode = :ra_AccCode )   AND
		( accounts.subcode = subaccounts.subacccode ) AND
		( subaccounts.catacccode = categoryaccounts.catacccode ) AND
		( categoryaccounts.mainacccode = mainaccounts.mainacccode ) AND
		( accounts.acccode = emp_deduction.DeductionCode )"
  update="accounts" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_AccCode", number))
)
