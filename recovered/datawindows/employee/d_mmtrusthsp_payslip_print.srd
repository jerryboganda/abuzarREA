table(column=(type=long updatewhereclause=yes name=reportgroup dbname="ReportGroup"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="PayrollCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="Date"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=paymentdate dbname="PaymentDate"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="Posted"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="UserCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=lastsaved dbname="LastSaved"  )
column=(type=datetime update=yes updatewhereclause=yes name=fromdate dbname="FromDate"  )
column=(type=datetime update=yes updatewhereclause=yes name=todate dbname="ToDate"  )
column=(type=char(100) updatewhereclause=yes name=empid dbname="EmpID"  )
column=(type=long update=yes updatewhereclause=yes name=empcode dbname="EmpCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(100) updatewhereclause=yes name=department dbname="Department"  )
column=(type=char(60) updatewhereclause=yes name=designation dbname="Designation"  )
column=(type=long updatewhereclause=yes name=paytype dbname="PayType" 
 values="Hourly	1/Daily	2/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid work days'" initial="0" name=workdays dbname="WorkDays"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid present days'" initial="0" name=presents dbname="Presents"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid absent days'" initial="0" name=absents dbname="Absents"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid leaves'" initial="0" name=leaves dbname="Leaves"  )
column=(type=decimal(2) updatewhereclause=yes name=sundays dbname="sundays"  )
column=(type=decimal(2) updatewhereclause=yes name=holidays dbname="holidays"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=workinghours dbname="WorkingHours"  )
column=(type=decimal(4) updatewhereclause=yes name=hoursworked dbname="HoursWorked"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid per hour work rate'" initial="0" name=perhourrate dbname="PerHourRate"  )
column=(type=decimal(2) updatewhereclause=yes name=standardbasicpay dbname="StandardBasicPay"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid basic pay'" initial="0" name=basicpay dbname="BasicPay"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid overtime hours'" initial="0" name=overtimehours dbname="OverTimeHours"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid per hour overtime rate'" initial="0" name=overtimerate dbname="OverTimeRate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid overtime pay'" initial="0" name=overtime dbname="OverTime"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid bonus pay'" initial="0" name=bonuspay dbname="BonusPay"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid special pay'" initial="0" name=specialpay dbname="SpecialPay"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid additional pay'" initial="0" name=additionalpay dbname="AdditionalPay"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid other pay'" initial="0" name=otherpay dbname="OtherPay"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid fine amount'" initial="0" name=fine dbname="Fine"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid Penalty amount'" initial="0" name=penalty dbname="Penalty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid other charge amount'" initial="0" name=othercharge dbname="OtherCharge"  )
column=(type=decimal(2) updatewhereclause=yes name=advance dbname="Advance"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid net pay'" initial="0" name=netpayable dbname="NetPayable"  )
