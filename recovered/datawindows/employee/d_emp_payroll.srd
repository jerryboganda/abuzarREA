 values="Hourly	1/Daily	2/"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=hoursworked dbname="EMP_Payroll.HoursWorked"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid per hour work rate'" initial="0" name=perhourrate dbname="EMP_Payroll.PerHourRate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid basic pay'" initial="0" name=basicpay dbname="EMP_Payroll.BasicPay"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid overtime hours'" initial="0" name=overtimehours dbname="EMP_Payroll.OverTimeHours"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid per hour overtime rate'" initial="0" name=overtimerate dbname="EMP_Payroll.OverTimeRate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid overtime pay'" initial="0" name=overtime dbname="EMP_Payroll.OverTime"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid bonus pay'" initial="0" name=bonuspay dbname="EMP_Payroll.BonusPay"  )
