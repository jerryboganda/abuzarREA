column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid net pay'" initial="0" name=netpayable dbname="EMP_Payroll.NetPayable"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="EMP_Payroll.Remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=paid dbname="EMP_Payroll.Paid" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes initial="2" name=paidvia dbname="EMP_Payroll.PaidVia" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=paymentdate dbname="EMP_Payroll.PaymentDate"  )
column=(type=char(20) update=yes updatewhereclause=yes initial="CASH" name=paymentrefno dbname="EMP_Payroll.PaymentRefNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=paymentremarks dbname="EMP_Payroll.PaymentRemarks"  )
column=(type=long update=yes updatewhereclause=yes name=paidby dbname="EMP_Payroll.PaidBy" 
 values=""  )
 retrieve="SELECT 
	PayrollCode,
	Date,
	Posted,
	PostedBy,
	PostDate,
	UserCode,
	LastSaved ,
	FromDate, 
	ToDate,
	EmpID = (SELECT E.EmpID FROM EMP_Employee E WHERE E.EMPCode = EMP_Payroll.EmpCode),
	EmpCode,
	WorkDays,
	Presents, 
	Absents,
	Leaves,
	Sundays,
	Holidays,
	WorkingHours=(SELECT P.Workinghours FROM EMP_Pay P WHERE P.EMPCode = EMP_Payroll.EmpCode),
	PayType=(SELECT P.PayType FROM EMP_Pay P WHERE P.EMPCode = EMP_Payroll.EmpCode),
	HoursWorked,
	PerHourRate,
	BasicPay,
	OverTimeHours,
	OverTimeRate,
	OverTime,
	BonusPay,
	SpecialPay,
	AdditionalPay, 
	OtherPay,
	Fine,
	Penalty,
	OtherCharge,
	Advance,
	NetPayable,
	Remarks,
	Paid,
	PaidVia,
	PaymentDate,
	PaymentRefNo,
	PaymentRemarks,
	PaidBy
FROM EMP_Payroll
WHERE PayrollCode=:ai_code"
  update="EMP_Payroll" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
