table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="EMP_Payroll.PayrollCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="EMP_Payroll.Date"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="EMP_Payroll.Posted"  )
column=(type=long updatewhereclause=yes name=postedby dbname="EMP_Payroll.PostedBy"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="EMP_Payroll.PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="EMP_Payroll.UserCode"  )
