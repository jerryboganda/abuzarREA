column=(type=long update=yes updatewhereclause=yes name=empcode dbname="EMP_Payroll.EmpCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid work days'" initial="0" name=workdays dbname="EMP_Payroll.WorkDays"  )
