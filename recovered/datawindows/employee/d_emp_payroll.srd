column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid absent days'" initial="0" name=absents dbname="EMP_Payroll.Absents"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid leaves'" initial="0" name=leaves dbname="EMP_Payroll.Leaves"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid sundays'" initial="0" name=sundays dbname="EMP_Payroll.Sundays"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid holidays'" initial="0" name=holidays dbname="EMP_Payroll.Holidays"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=workinghours dbname="WorkingHours"  )
