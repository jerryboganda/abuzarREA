column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid other pay'" initial="0" name=otherpay dbname="EMP_Payroll.OtherPay"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid fine amount'" initial="0" name=fine dbname="EMP_Payroll.Fine"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid Penalty amount'" initial="0" name=penalty dbname="EMP_Payroll.Penalty"  )
