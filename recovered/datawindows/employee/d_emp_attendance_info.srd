table(column=(type=decimal(0) key=yes update=yes updatewhereclause=yes name=attendancecode dbname="EMP_Attendance.AttendanceCode"  )
column=(type=char(100) updatewhereclause=yes name=empid dbname="EmpID"  )
column=(type=long update=yes updatewhereclause=yes name=empcode dbname="EMP_Attendance.EMPCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=fingercode dbname="EMP_Attendance.FingerCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=timein dbname="EMP_Attendance.TIMEIN"  )
column=(type=datetime update=yes updatewhereclause=yes name=timeout dbname="EMP_Attendance.TIMEOUT"  )
column=(type=long update=yes updatewhereclause=yes name=attendancestatuscode dbname="EMP_Attendance.AttendanceStatusCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes name=payed dbname="EMP_Attendance.Payed"  )
column=(type=char(255) update=yes updatewhereclause=yes name=comments dbname="EMP_Attendance.Comments"  )
column=(type=long updatewhereclause=yes name=empcatcode dbname="EmpCatCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=deptcode dbname="DeptCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=desigcode dbname="DesigCode" 
 values=""  )
 retrieve="SELECT 
	EMP_Attendance.AttendanceCode,   
	EmpID = (SELECT E.EmpID FROM EMP_Employee E WHERE E.EmpCode = EMP_Attendance.EMPCode),
	EMP_Attendance.EMPCode,   
	EMP_Attendance.FingerCode,   
	EMP_Attendance.TIMEIN,   
	EMP_Attendance.TIMEOUT,   
	EMP_Attendance.AttendanceStatusCode,   
	EMP_Attendance.Payed,   
	EMP_Attendance.Comments,
	EmpCatCode = (SELECT E.EmpCatCode FROM EMP_Employee E WHERE E.EmpCode = EMP_Attendance.EMPCode),
	DeptCode = (SELECT E.DeptCode FROM EMP_Employee E WHERE E.EmpCode = EMP_Attendance.EMPCode),
	DesigCode = (SELECT E.DesigCode FROM EMP_Employee E WHERE E.EmpCode = EMP_Attendance.EMPCode)
FROM 
	EMP_Attendance  
WHERE 
	EMP_Attendance.AttendanceCode = :ai_code AND
	EMP_Attendance.Payed = 'N'
"
  update="EMP_Attendance" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
