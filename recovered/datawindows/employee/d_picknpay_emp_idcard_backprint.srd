table(column=(type=long updatewhereclause=yes name=empcode dbname="EMPCode"  )
column=(type=char(100) updatewhereclause=yes name=empid dbname="EMPID"  )
column=(type=char(255) update=yes updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(255) updatewhereclause=yes name=fhname dbname="FHName"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="M" name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=birthdate dbname="BirthDate"  )
column=(type=char(100) updatewhereclause=yes name=cnicno dbname="CNICNo"  )
column=(type=char(100) updatewhereclause=yes name=mobileno dbname="MobileNo"  )
column=(type=long updatewhereclause=yes name=transportroutecode dbname="TransportRouteCode"  )
column=(type=long updatewhereclause=yes name=vehiclecode dbname="VehicleCode"  )
column=(type=char(255) updatewhereclause=yes name=pmtaddress dbname="PMTAddress"  )
column=(type=char(100) updatewhereclause=yes name=bloodgroup dbname="BloodGroup"  )
column=(type=char(100) updatewhereclause=yes name=department dbname="Department"  )
column=(type=char(100) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=designation dbname="Designation"  )
column=(type=datetime updatewhereclause=yes name=issuedate dbname="IssueDate"  )
column=(type=datetime updatewhereclause=yes name=expirydate dbname="ExpiryDate"  )
column=(type=char(30) updatewhereclause=yes name=filename dbname="FileName"  )
column=(type=char(27) updatewhereclause=yes name=signaturefile dbname="SignatureFile"  )
 retrieve="SELECT  
	EMPCode=E.EMPCode,
	EMPID=E.EMPID,
	Name=E.FullName,
	FHName=E.FHName,
	Gender=E.Gender,
	BirthDate=E.BirthDate,
	CNICNo=E.CNICNo,
	MobileNo=E.MobileNo,
	TransportRouteCode=E.TransportRouteCode,
	VehicleCode=E.VehicleCode,
	PMTAddress=E.PMTAddress,
	BloodGroup=E.BloodGroup,
	Department = (SELECT EC.Name FROM Emp_Department EC WHERE EC.DeptCode = E.DeptCode),
	Category = (SELECT EC.Name FROM Emp_Category EC WHERE EC.EmpCatCode = E.EmpCatCode),
	Designation = (SELECT EC.Name FROM Emp_Designation EC WHERE EC.DesigCode = E.DesigCode),
	IssueDate = GETDATE(),
	ExpiryDate = ISNULL((SELECT CAST(DBO.FN_GetPreference('DefaultExpiry') AS DATETIME)), GETDATE()+365),
	FileName = 'c:~\waseela_temp~\'+LTRIM(RTRIM(STR(E.EMPCode)))+'.jpg',
	SignatureFile = 'c:~\waseela_temp~\sigfile.jpg'
FROM
	EMP_Employee E
WHERE 
	E.EMPCode IN (:ai_code) AND
	E.Active = 'Y'
ORDER BY
	Name"
  arguments=(("ai_code", numberlist))
)
