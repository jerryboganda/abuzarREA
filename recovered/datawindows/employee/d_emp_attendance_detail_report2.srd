table(column=(type=long updatewhereclause=yes name=empcode dbname="EmpCode"  )
column=(type=char(100) updatewhereclause=yes name=empid dbname="EmpID"  )
column=(type=char(255) updatewhereclause=yes name=employeename dbname="EmployeeName"  )
column=(type=char(100) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(100) updatewhereclause=yes name=department dbname="Department"  )
column=(type=char(60) updatewhereclause=yes name=designation dbname="Designation"  )
column=(type=datetime updatewhereclause=yes name=timein dbname="TimeIn"  )
column=(type=datetime updatewhereclause=yes name=timeout dbname="TimeOut"  )
column=(type=long updatewhereclause=yes name=hoursworked dbname="HoursWorked"  )
column=(type=long updatewhereclause=yes name=minworked dbname="MinWorked"  )
column=(type=char(100) updatewhereclause=yes name=status dbname="Status"  )
column=(type=char(255) updatewhereclause=yes name=comments dbname="Comments"  )
 retrieve="SELECT 
	EmpCode=A.EmpCode, 
	EmpID=E.EmpID,
	EmployeeName=E.FullName,
	Category = C.Name,
	Department = D.Name,
	Designation = DS.Name,
	TimeIn = A.TimeIn,
	TimeOut= A.TimeOut,
	HoursWorked = CAST(DATEDIFF(n, A.TimeIn, ISNULL(A.TimeOut, GETDATE())) / 60 AS INT),
	MinWorked = CAST(DATEDIFF(n, A.TimeIn, ISNULL(A.TimeOut, GETDATE())) % 60 AS INT),
	Status = (SELECT S.Name FROM EMP_AttendanceStatus S WHERE A.AttendanceStatusCode = S.AttendanceStatusCode),
	Comments=A.Comments
FROM 
	EMP_Attendance A,
	EMP_Employee E, 
	EMP_Department D, 
	EMP_Category C, 
	EMP_Designation DS
WHERE 
	A.TimeIN BETWEEN :adt_startdate AND :adt_enddate AND
	C.EmpCatCode IN (:ai_empcatcode) AND
	D.DeptCode IN (:ai_deptcode) AND
	A.EmpCode = E.EmpCode AND
	E.DeptCode = D.DeptCode AND 
	E.EmpCatCode = C.EmpCatCode AND 
	E.DesigCode = DS.DesigCode AND
	E.Active = 'Y'
ORDER BY
	Department,
	EmployeeName,
	TimeIn
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_empcatcode", numberlist), ("ai_deptcode", numberlist))
 sort="department A, employeename A, timein A"
)
