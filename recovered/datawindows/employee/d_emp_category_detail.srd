table(column=(type=long updatewhereclause=yes name=tmp dbname="tmp"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="EMP_Category.EmpCatCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="EMP_Category.Name"  )
 retrieve="SELECT 
	tmp=1, 
	EmpCatCode ,  
	Name 
FROM EMP_Category
WHERE 
	EmpCatCode = :ai_code "
  update="EMP_Category" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
