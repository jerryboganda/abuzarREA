table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="EMP_Payroll.PayrollCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="EMP_Payroll.Date"  )
column=(type=char(100) updatewhereclause=yes name=empid dbname="EmpID"  )
column=(type=char(255) updatewhereclause=yes name=employee dbname="Employee"  )
column=(type=char(1) update=yes updatewhereclause=yes name=paid dbname="EMP_Payroll.Paid" 
 values="Yes	Y/No	N/"  )
column=(type=datetime update=yes updatewhereclause=yes name=paymentdate dbname="EMP_Payroll.PaymentDate"  )
column=(type=long update=yes updatewhereclause=yes name=paidvia dbname="EMP_Payroll.PaidVia" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=paidby dbname="EMP_Payroll.PaidBy" 
 values=""  )
column=(type=char(20) update=yes updatewhereclause=yes name=paymentrefno dbname="EMP_Payroll.PaymentRefNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=paymentremarks dbname="EMP_Payroll.PaymentRemarks"  )
column=(type=decimal(2) updatewhereclause=yes name=netpayable dbname="EMP_Payroll.NetPayable"  )
 retrieve="SELECT 
	PayrollCode,
	Date,
	EmpID = (SELECT E.EmpID FROM EMP_Employee E WHERE E.EMPCode = EMP_Payroll.EmpCode),
	Employee=(SELECT E.FullName FROM EMP_Employee E WHERE E.EMPCode = EMP_Payroll.EmpCode),
	Paid,
	PaymentDate,
	PaidVia,
	PaidBy,
	PaymentRefNo,
	PaymentRemarks,
	NetPayable
FROM 
	EMP_Payroll
WHERE 
	Posted='Y' AND Paid='N'
ORDER BY
	PayrollCode"
  update="EMP_Payroll" updatewhere=0 updatekeyinplace=yes
 )
