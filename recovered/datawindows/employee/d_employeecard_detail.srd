footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(100) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(255) updatewhereclause=yes name=fhname dbname="FHName"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender"  )
column=(type=long updatewhereclause=yes name=deptcode dbname="DeptCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=empcatcode dbname="EMPCatCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=desigcode dbname="DesigCode" 
 values=""  )
column=(type=char(358) updatewhereclause=yes name=itemname dbname="itemname"  )
 retrieve="SELECT
	Code=0,
	ICode=E.EmpCode,
	FullCode = E.EmpID,
	FHName = E.FHName,
	CurrListRow = 0,
	Gender=E.Gender,
	DeptCode=E.DeptCode,
	EMPCatCode=E.EmpCatCode,
	DesigCode=E.DesigCode,
	itemname = E.FullName + ' (' + E.EMPID + ')'
FROM 
	Emp_Employee E
WHERE 
	E.EmpCode = :ai_code"
  arguments=(("ai_code", number))
)
