table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="EMP_Allowance.AllowanceCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="EMP_Allowance.Name"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=attendancewise dbname="EMP_Allowance.AttendanceWise" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=percentage dbname="EMP_Allowance.Percentage"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=flatamount dbname="EMP_Allowance.FlatAmount"  )
 retrieve="SELECT 
	EMP_Allowance.AllowanceCode,   
	EMP_Allowance.Name,   
	EMP_Allowance.AttendanceWise,   
	EMP_Allowance.Percentage,   
	EMP_Allowance.FlatAmount  
FROM 
	EMP_Allowance  
WHERE 
	EMP_Allowance.AllowanceCode = :ai_code
"
  update="EMP_Allowance" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
