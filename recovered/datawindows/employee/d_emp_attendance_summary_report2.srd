table(column=(type=char(20) updatewhereclause=yes name=department dbname="department"  )
column=(type=char(20) updatewhereclause=yes name=category dbname="category"  )
column=(type=char(20) updatewhereclause=yes name=designation dbname="designation"  )
column=(type=char(20) updatewhereclause=yes name=employeename dbname="employeename"  )
column=(type=number updatewhereclause=yes name=hoursworked dbname="hoursworked"  )
 retrieve="SELECT 
	EmpCode=A.EmpCode, 
	EmployeeName=E.FullName + ' (' + E.EMPID + ')',
	Category = C.Name,
	Department = D.Name,
	Designation = DS.Name,
	Day=Day(A.TimeIN),
	TimeIn=A.TimeIN,
	HoursWorked = ROUND(CAST(SUM(DATEDIFF(n, A.TimeIn, ISNULL(A.TimeOut, GETDATE()))) / 60 AS INT),2) + Round(SUM(DATEDIFF(n, A.TimeIn, ISNULL(A.TimeOut, GETDATE()))) % 60 / 60.00, 2)
FROM 
	EMP_Attendance A,
	EMP_Employee E, 
	EMP_Department D, 
	EMP_Category C, 
	EMP_Designation DS
WHERE 
	A.TimeIN BETWEEN :adt_startdate AND :adt_enddate AND
	C.EmpCatCode IN (:ai_empcatcode) AND
	D.DeptCode IN (:ai_deptcode) AND
	A.EmpCode = E.EmpCode AND
	E.DeptCode = D.DeptCode AND 
	E.EmpCatCode = C.EmpCatCode AND 
	E.DesigCode = DS.DesigCode
GROUP BY
	A.EmpCode, 
	E.FullName,
	E.EMPID,
	C.Name,
	D.Name,
	DS.Name,
	A.TimeIN
ORDER BY
	Department,
	EmployeeName
	"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_empcatcode", numberlist), ("ai_deptcode", numberlist))
 sort="department A, category A, designation A, employeename A"
)
