summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=payrollcode dbname="PayrollCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=advance dbname="Advance"  )
column=(type=long updatewhereclause=yes name=empcode dbname="EmpCode"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=long updatewhereclause=yes name=advacccode dbname="AdvAccCode"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="PostedBy"  )
 retrieve="SELECT 
	PayrollCode=EP.PayrollCode, 
	Advance=EP.Advance, 
	EmpCode=EP.EmpCode, 
	AccCode=E.AccCode, 
	AdvAccCode=E.AdvAccCode, 
	Balance=(SELECT SUM(EA.Amount - EA.ReturnedAmt) FROM EMP_Advance EA WHERE EA.EmpAdvAccCode = E.AdvAccCode),
	Posted=EP.Posted,
	PostDate=EP.PostDate,
	PostedBy=EP.PostedBy
From
	Emp_Payroll EP, Emp_Employee E
Where  
	EP.PayrollCode Between :ai_scode AND :ai_ecode AND EP.Posted='N' AND EP.EmpCode=E.EmpCode
ORDER BY
	PayrollCode"
  arguments=(("ai_scode", number), ("ai_ecode", number))
)
