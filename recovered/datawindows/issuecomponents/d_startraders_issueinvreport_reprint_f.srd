table(column=(type=char(88) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes name=saleordercode dbname="saleordercode"  )
column=(type=char(100) updatewhereclause=yes name=saleorderremarks dbname="saleorderremarks"  )
column=(type=datetime updatewhereclause=yes name=saleorderdate dbname="saleorderdate"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="itempacking"  )
column=(type=char(150) updatewhereclause=yes name=genericname dbname="genericname"  )
column=(type=char(60) updatewhereclause=yes name=manf dbname="manf"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=char(30) updatewhereclause=yes name=licenceno dbname="licenceno"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=long updatewhereclause=yes name=issueinvcode dbname="issueinvcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(50) updatewhereclause=yes name=custtaxregno dbname="custTaxRegno"  )
column=(type=char(50) updatewhereclause=yes name=issueheader_referenceno dbname="IssueHeader.referenceno"  )
column=(type=char(100) updatewhereclause=yes name=issueheader_remarks dbname="IssueHeader.remarks"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CUSTALIAS"  )
 retrieve="  SELECT itemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END, 
         aliasname=item.customicode,   
         packingdesc=item.packingdesc,  
		/*saleordercode=0,
		saleorderremarks='',
		saleorderdate='',*/
		saleordercode=(select saleordercode from saleorderdetail where rowid=issuedetail.saleorderrowid),
		saleorderremarks=(select remarks from saleorderheader where saleorderheader.saleordercode=(select saleordercode from saleorderdetail where rowid=issuedetail.saleorderrowid)),
		saleorderdate=(select date from saleorderheader where saleorderheader.saleordercode=(select saleordercode from saleorderdetail where rowid=issuedetail.saleorderrowid)),
		itempacking=(select name from itempacking where itempacking.packcode=item.packcode), 
		genericname=(select name from genericitem where item.genericcode=genericitem.genericcode),
		manf=(select name from manufacturer where manufacturer.manfcode=item.manfcode),
         accname = dbo.accounts.name,   
         address = dbo.customer.address1,   
         address2= dbo.customer.address2,   
         city= dbo.customer.city,
         licenceno= dbo.customer.licenceno,   
         username= dbo.users.username,   
         issueinvcode = dbo.issueheader.issueinvcode,   
         headerno = dbo.issueheader.headerno,   
         date = dbo.issueheader.date , 

       
       
       
         gcode = issuedetail.gcode,   
         icode = issuedetail.icode,   
         batch = issuedetail.batch,   
         expiry = issuedetail.expiry,   
         looseqty = issuedetail.qty,   
  
        
         packunits= issuedetail.packunits,   
         saleprice= issuedetail.saleprice,   
          

		
         Id = dbo.issuedetail.IDENTITYCOL,   
         posted=issueheader.posted,   
        
		
		
       
         custTaxRegno=customer.salestaxregno  ,
			dbo.issueheader.referenceno,	
			dbo.issueheader.remarks,

		
			salesman=ltrim(rtrim(dbo.salesman.name)),
			
			CUSTALIAS=ACCOUNTS.ALIASNAME

    FROM issueheader LEFT OUTER JOIN Salesman ON ( dbo.issueheader.smancode = dbo.salesman.salesmancode ),   
         issuedetail,   
         accounts,   
         customer,   
         users,   
         item  

   WHERE ( dbo.issueheader.issueinvcode >= :ar_SInvCode  ) AND  
        			( dbo.issueheader.issueinvcode <= :ar_LInvCode  ) AND
			( dbo.issueheader.issueinvcode = dbo.issuedetail.issueinvcode) AND 
			( dbo.issueheader.acccode = dbo.accounts.acccode ) AND  
         ( dbo.customer.custcode = dbo.accounts.acccode ) AND  
         ( dbo.issueheader.salesmancode = dbo.users.usercode ) AND  
          ( dbo.issuedetail.icode = dbo.item.icode)    

ORDER BY dbo.issuedetail.issueinvcode,
			dbo.issuedetail.IDENTITYCOL"
  arguments=(("ar_SInvCode", number), ("ar_LInvcode", number))
)
