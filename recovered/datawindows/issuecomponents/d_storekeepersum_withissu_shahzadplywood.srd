release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=229 color="536870912" )
footer(height=510 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=issueinvcode dbname="Issueinvcode"  )
column=(type=long updatewhereclause=yes name=icode dbname="IssueDetail.ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=decimal(7) updatewhereclause=yes name=volume dbname="Volume"  )
column=(type=decimal(7) updatewhereclause=yes name=weight dbname="Weight"  )
column=(type=char(100) updatewhereclause=yes name=salecomments1 dbname="SaleComments1"  )
column=(type=char(100) updatewhereclause=yes name=salecomments2 dbname="SaleComments2"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
 retrieve="SELECT
	Issueinvcode=sl.Issueinvcode,
	SD.ICode, 
	AliasName = I.CustomICode,
	Item = I.Name,
	Godown = G.Name,
	ItemClass = ICL.Name,
	SUM(SD.Qty) AS Qty, 
	0.0000 AS Bonus,
	Manufacturer = M.Name,
	Volume = SUM( SD.Qty * I.PackingFactor),
	Weight = SUM( SD.Qty * I.UnitWeight),
	SaleComments1 = MAX(SL.Terms1),
	SaleComments2 = MAX(SL.Terms2),
	itemcategory=(select name from itemcategory where max(I.icatcode)=itemcategory.icatcode)
FROM
	IssueDetail SD,
	IssueHeader SL,
	ItemClass ICL,
	Manufacturer M,
	Item	I,
	Godown G
WHERE 
	SL.IssueInvCode = :ai_invCode AND
	SL.IssueInvCode = SD.IssueInvcode AND
	SD.ICode = I.ICode AND
	I.ManfCode = M.ManfCode AND
	I.ICCode = ICL.ICCode AND
	SD.GCode = G.GCode AND	
	SD.GCode IN 
		(SELECT GCode
		FROM GroupAllowedGodown
		WHERE Module = 5 AND GroupCode=:ai_groupcode)
GROUP BY
	SL.IssueInvCode,
	SD.ICode, 
	SD.GCode,
	M.Name,
	ICL.Name,
	I.Name,
	I.CustomICode,
	G.Name
ORDER BY
	G.Name,
	itemcategory,
	ICL.Name,
	I.Name,
	I.CustomICode
"
  arguments=(("ai_invcode", number), ("ai_groupcode", number))
)
