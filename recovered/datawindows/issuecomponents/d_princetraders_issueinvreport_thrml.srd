release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1812 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=166 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(60) updatewhereclause=yes name=recipient dbname="recipient"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=long updatewhereclause=yes name=issueinvcode dbname="issueinvcode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="smanname"  )
column=(type=char(75) updatewhereclause=yes name=itemlaias dbname="itemlaias"  )
column=(type=decimal(5) updatewhereclause=yes name=price dbname="price"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=issueheader_deptcode dbname="IssueHeader.deptcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="IssueHeader.remarks"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="looseqty"  )
column=(type=char(251) updatewhereclause=yes name=referenceno dbname="referenceno"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
 retrieve="SELECT 
	itemname= item.name, 
	headerno=max(issueheader.headerno),
	recipient = Case RecipientCode When 1 Then (Select Name From Department Where DeptCode=issueheader.deptcode) When 2 Then (Select Name From Accounts Where AccCode =max( issueheader.AccCode)) When 3 Then (Select Name From Accounts Where AccCode =Max( issueheader.AccCode)) When 4 Then (Select Name From SalesMan Where SalesManCode =max(issueheader.RecipientSalesMan) ) End,
	salesman = max(dbo.users.username), 
	issueinvcode = dbo.issueheader.issueinvcode, 
	smanname=(SELECT salesman.name FROM SalesMan WHERE SalesMan.SalesManCode =max( IssueHeader.SMANCode)),
	itemlaias=max(item.customicode), 
	price =max( issuedetail.price),
	date = dbo.issueheader.date,   
	dbo.issueheader.deptcode, 
	dbo.issueheader.remarks,	
	
	icode = issuedetail.icode,   
	batch =max( issuedetail.batch),   
	expiry = min(issuedetail.expiry),   
	looseqty = sum(issuedetail.qty),
	referenceno=ISNULL((select name from issuetype where issuetypecode = issueheader.issuetypecode), '') + CASE issueheader.issuetypecode WHEN NULL THEN '' ELSE '-' END + dbo.issueheader.referenceno,
	
	
	
	Id       = max(dbo.issuedetail.IDENTITYCOL )
	
FROM 
	issueheader, 
	issuedetail, 
	users, 
	item 
	LEFT OUTER JOIN itempacking ON (dbo.item.packcode = dbo.itempacking.packcode)
	LEFT OUTER JOIN Godown ON (dbo.item.gcode = dbo.Godown.gcode)	
WHERE 
	( dbo.issueheader.issueinvcode = :ar_issueInvCode ) AND
	( dbo.issueheader.issueinvcode = dbo.issuedetail.issueinvcode) AND
	( dbo.issueheader.salesmancode = dbo.users.usercode ) AND 
	( dbo.issuedetail.icode = dbo.item.icode)
group by
	issueheader.issueinvcode,
	issueheader.date,
	issueheader.issuetypecode,
	issueheader.referenceno,
	issueheader.remarks,
	issueheader.deptcode,
	issueheader.RecipientCode,
	issuedetail.icode,
	item.name
	
ORDER BY 
	max(dbo.issuedetail.IDENTITYCOL)"
  arguments=(("ar_IssueInvCode", number))
)
