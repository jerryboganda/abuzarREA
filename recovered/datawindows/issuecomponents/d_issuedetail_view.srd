table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(75) updatewhereclause=yes name=alternatecustomicode dbname="IssueDetail.alternatecustomicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=updatesaleprice dbname="updatesaleprice"  )
column=(type=long updatewhereclause=yes name=code dbname="IssueDetail.issueinvcode"  )
column=(type=long updatewhereclause=yes name=sectcode dbname="IssueDetail.sectcode" 
 values=""  )
column=(type=long updatewhereclause=yes name=icode dbname="IssueDetail.icode"  )
column=(type=long updatewhereclause=yes initial="1" name=gcode dbname="IssueDetail.gcode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(5) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Sale Price should be greater than zero'" initial="0" name=price dbname="price"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="'Sale Price should be greater than zero'" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=purchaseprice dbname="purchaseprice"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=long updatewhereclause=yes name=saleorderrowid dbname="saleorderrowid"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=mrpp dbname="mrpp"  )
column=(type=long identity=yes updatewhereclause=yes name=issrowid dbname="IssueDetail.IssRowId"  )
column=(type=long updatewhereclause=yes name=issuereqrowid dbname="IssueDetail.issuereqrowid"  )
column=(type=long updatewhereclause=yes name=rowgroup dbname="IssueDetail.RowGroup"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(100) updatewhereclause=yes name=itemdescription dbname="itemdescription"  )
column=(type=decimal(3) updatewhereclause=yes name=unitweight dbname="UnitWeight"  )
column=(type=decimal(3) updatewhereclause=yes name=packingfactor dbname="PackingFactor"  )
column=(type=decimal(4) updatewhereclause=yes name=packcapacity dbname="PackCapacity"  )
column=(type=long updatewhereclause=yes initial="0" name=piecesinhand dbname="PiecesInHand"  )
column=(type=long updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Please enter valid value for Total pieces'" initial="1" name=totalpieces dbname="TotalPieces"  )
column=(type=decimal(8) updatewhereclause=yes name=areavolume dbname="AreaVolume"  )
column=(type=decimal(6) updatewhereclause=yes name=pcs dbname="PCS"  )
column=(type=char(17) updatewhereclause=yes name=cartons dbname="Cartons"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=claimable dbname="claimable" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100 " validationmsg="'Claimable Disc. % Must be in range [0-100]'" initial="0" name=claimablediscperc dbname="claimablediscperc"  )
column=(type=long updatewhereclause=yes name=receiptrowid dbname="receiptrowid"  )
column=(type=decimal(4) updatewhereclause=yes name=issueableqty dbname="issueableqty"  )
column=(type=decimal(4) updatewhereclause=yes validation="real(gettext()) > 0" validationmsg="~"Quantity should be greater than zero~"" initial="1" name=qty dbname="qty"  )
 retrieve="SELECT 
	item.customicode, 
	issuedetail.alternatecustomicode,
	itemname= item.name, 
	currlistrow = 0,
	stock     = 0.0000, 
	totalstock= 0.0000, 
	assgcode  = 1,  
	updatesaleprice = 'N',
	issuedetail.issueinvcode,   
	issuedetail.sectcode,
	issuedetail.icode,   
	issuedetail.gcode,
	batch = max(issuedetail.batch),
	expiry = max(issuedetail.expiry),
	price = max(issuedetail.price),
	packunits = max(issuedetail.packunits),
	saleprice = max(issuedetail.saleprice),
	purchaseprice = max(issuedetail.purchaseprice),
	avgprice = max(issuedetail.avgprice),
	saleorderrowid = max(issuedetail.saleorderrowid),
	mrpp = max(issuedetail.mrpp),
	IssueDetail.IssRowId,
	IssueDetail.issuereqrowid,
	IssueDetail.RowGroup,
	itemcode = 0,
	itemdescription=max(issuedetail.itemdescription),
	UnitWeight = item.UnitWeight,
	PackingFactor = item.PackingFactor,
	PackCapacity = item.PackCapacity,
	PiecesInHand = SUM(issuedetail.PiecesInHand),
	TotalPieces = SUM(issuedetail.TotalPieces),
	AreaVolume = item.AreaVolume,
	PCS=ROUND(sum(issuedetail.qty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6),
	Cartons= LTRIM(RTRIM(STR(CAST(((ROUND(sum(issuedetail.qty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6)) / CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END) AS INT), 7, 0))) + ' : ' +
		LTRIM(RTRIM(STR(((CAST(ROUND(sum(issuedetail.qty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6) AS INT)) % CAST(CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END AS INT)), 7, 0))),
	claimable=issuedetail.claimable,
	claimablediscperc=issuedetail.claimablediscperc,
	receiptrowid=issuedetail.receiptrowid,
	issueableqty=0.0000,
	qty  = sum(issuedetail.qty)
FROM 
	issuedetail, item 
WHERE 
	( dbo.issuedetail.issueinvcode = :ar_IssueInvCode )    AND
	( issuedetail.icode = item.icode )
GROUP BY 
	issuedetail.issueinvcode, 
	issuedetail.icode, 
	issuedetail.alternatecustomicode,
	issuedetail.gcode, 
	issuedetail.sectcode,
	IssueDetail.RowGroup,
	IssueDetail.IssRowID,
	IssueDetail.Claimable,
	IssueDetail.ClaimableDiscPerc,
	IssueDetail.issuereqrowid,
	issuedetail.receiptrowid,
	item.customicode, 
	item.name,
	item.UnitWeight,
	item.PackingFactor,
	item.PackCapacity,
	item.AreaVolume
ORDER BY 
	min(Issuedetail.IssRowID)
"
  arguments=(("ar_IssueInvCode", number))
)
