table(column=(type=long updatewhereclause=yes name=code dbname="IssueHeader.Issueinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="IssueHeader.date"  )
column=(type=char(50) updatewhereclause=yes name=referenceno dbname="IssueHeader.ReferenceNo"  )
column=(type=datetime updatewhereclause=yes name=referencedate dbname="IssueHeader.ReferenceDate"  )
column=(type=char(200) updatewhereclause=yes name=issuetype dbname="IssueType"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="IssueHeader.remarks"  )
column=(type=long updatewhereclause=yes name=receiptinvcode dbname="IssueHeader.ReceiptInvCode"  )
column=(type=long updatewhereclause=yes name=recipientcode dbname="IssueHeader.RecipientCode" 
 values=""  )
column=(type=char(60) updatewhereclause=yes name=primaryrecipient dbname="PrimaryRecipient"  )
column=(type=char(60) updatewhereclause=no name=draccountname dbname="DrAccountName"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=long updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=long updatewhereclause=yes name=prodnotecode dbname="ProdNoteCode"  )
column=(type=long updatewhereclause=yes name=issuecode dbname="IssueCode"  )
column=(type=char(1) updatewhereclause=yes name=pushed dbname="Pushed" 
 values="Yes	Y/No	N/"  )
column=(type=datetime updatewhereclause=yes name=pushedon dbname="PushedOn"  )
column=(type=char(60) updatewhereclause=no name=pushedby dbname="PushedBy"  )
column=(type=char(203) updatewhereclause=no name=pushedfor dbname="PushedFor"  )
 retrieve="  SELECT
	IssueHeader.Issueinvcode , 
	IssueHeader.date , 
	IssueHeader.ReferenceNo, 
	IssueHeader.ReferenceDate, 
	IssueType=ISNULL((SELECT IssueType.Name FROM Issuetype WHERE IssueType.IssueTypeCode = IssueHeader.IssueTypeCode), ''), 
	IssueHeader.remarks , 
	IssueHeader.ReceiptInvCode,
	dbo.issueHeader.RecipientCode,
	PrimaryRecipient=
		CASE RecipientCode 
			WHEN 1 THEN (SELECT D.Name FROM Department D WHERE D.DeptCode = IssueHeader.DeptCode)
			WHEN 4 THEN (SELECT S.Name FROM Salesman S WHERE S.SalesMancode = IssueHeader.RecipientSalesman)
			ELSE (SELECT Name FROM Accounts A WHERE A.Acccode = IssueHeader.AccCode)
		END,
	DrAccountName = 	(select name from accounts where accounts.acccode=IssueHeader.dracccode),
	dbo.users.username,
	posted = IssueHeader.posted,
	PostedBy = IsNull((Select username from users 
				where dbo.IssueHeader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
				where dbo.IssueHeader.modifiedby = dbo.users.usercode), ''),
	ProdCode = (SELECT ProdHeader.ProdCode FROM ProdHeader WHERE ProdHeader.IssueInvCode = IssueHeader.Issueinvcode),
	ProdNoteCode = (SELECT ProdNote.ProdNoteCode FROM ProdNote WHERE ProdNote.IssueInvCode = IssueHeader.Issueinvcode),
	IssueCode=IssueHeader.IssueCode,
	Pushed=IssueHeader.Pushed,
	PushedOn=IssueHeader.PushedOn,
	PushedBy=IsNull((Select username from users 
							where dbo.IssueHeader.PushedBy = dbo.users.usercode), ''),
	PushedFor = IsNull((SELECT S.Name + ' (' + S.InstanceID + ')' FROM Site S WHERE S.SiteCode=IssueHeader.TargetSiteCode),'')

FROM
	users,
	IssueHeader

WHERE
	( IssueHeader.IssueCategoryCode  = :ai_issuecategorycode ) AND
	(dbo.IssueHeader.date > :ad_invdate) and
	( Posted IN (:as_Posted)) and
	( dbo.IssueHeader.salesmancode = dbo.users.usercode ) AND
	( dbo.IssueHeader.HeaderNo IS NULL OR
	( dbo.IssueHeader.HeaderNo IN 
		(SELECT HeaderCode FROM GroupAllowedHeader 
		WHERE GroupCode = :ai_GroupCode AND Module=:ai_Module)))"
  arguments=(("ai_SaleCatCode", number), ("as_Posted", stringlist), ("ad_invdate", datetime), ("ai_groupcode", number), ("ai_module", number), ("ai_issuecategorycode", number))
)
