table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="customicode"  )
column=(type=char(60) updatewhereclause=yes name=recipient dbname="recipient"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=long updatewhereclause=yes name=issueinvcode dbname="issueinvcode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="smanname"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(5) updatewhereclause=yes name=price dbname="price"  )
column=(type=long updatewhereclause=yes name=issueheader_deptcode dbname="IssueHeader.deptcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="IssueHeader.remarks"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=saledetail_expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="looseqty"  )
column=(type=char(251) updatewhereclause=yes name=referenceno dbname="referenceno"  )
column=(type=datetime updatewhereclause=yes name=referencedate dbname="IssueHeader.referencedate"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="itempacking"  )
column=(type=char(60) updatewhereclause=yes name=manf dbname="manf"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Id"  )
 retrieve="SELECT 
	itemname= item.name, 
	customicode=item.customicode,
	recipient = Case RecipientCode When 1 Then (Select Name From Department Where DeptCode=issueheader.deptcode) When 2 Then (Select Name From Accounts Where AccCode = issueheader.AccCode) When 3 Then (Select Name From Accounts Where AccCode = issueheader.AccCode) When 4 Then (Select Name From SalesMan Where SalesManCode = issueheader.RecipientSalesMan ) End,
	salesman = dbo.users.username, 
	address1=(select address1 from customer where customer.custcode= issueheader.AccCode),
	address2=(select address2 from customer where customer.custcode= issueheader.AccCode),
	issueinvcode = dbo.issueheader.issueinvcode, 
	smanname=salesman.name, 
	date = dbo.issueheader.date, 
	price = issuedetail.price,
	dbo.issueheader.deptcode,
	dbo.issueheader.remarks,	
	gcode = issuedetail.gcode,   
	icode = issuedetail.icode,   
	batch = issuedetail.batch,   
	expiry = issuedetail.expiry,   
	looseqty = issuedetail.qty,
	referenceno=ISNULL((select name from issuetype where issuetypecode = issueheader.issuetypecode), '') + CASE issueheader.issuetypecode WHEN NULL THEN '' ELSE '-' END + dbo.issueheader.referenceno,
	dbo.issueheader.referencedate,
	Godown = Godown.name,
	itempacking = itempacking.name,
	manf=(select name from manufacturer where manufacturer.manfcode=item.manfcode),
	Id       = dbo.issuedetail.IDENTITYCOL 
	
FROM issueheader, 
	issuedetail, 
	users, 
	item 
	LEFT OUTER JOIN itempacking ON (dbo.item.packcode = dbo.itempacking.packcode)
	LEFT OUTER JOIN Godown ON (dbo.item.gcode = dbo.Godown.gcode),
	salesman
	
WHERE 
	( dbo.issueheader.issueinvcode = :ar_issueInvCode ) AND
	( dbo.issueheader.issueinvcode = dbo.issuedetail.issueinvcode) AND
	( dbo.issueheader.Smancode = dbo.SalesMan.Salesmancode ) AND 
	( dbo.issueheader.salesmancode = dbo.users.usercode ) AND 
	( dbo.issuedetail.icode = dbo.item.icode)
	
	ORDER BY dbo.issuedetail.IDENTITYCOL"
  arguments=(("ar_IssueInvCode", number))
)
