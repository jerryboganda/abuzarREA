release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=68 color="536870912" )
summary(height=0 color="536870912" )
footer(height=68 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=issueinvcode dbname="IssueDetail.issueinvcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=gcode dbname="IssueDetail.gcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="IssueDetail.icode"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="IssueDetail.batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes name=expiry dbname="IssueDetail.expiry"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=qty dbname="qty"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="'Sale Price should be greater than zero'" name=saleprice dbname="saleprice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=mrpp dbname="mrpp"  )
column=(type=long updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=long updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
 retrieve="  SELECT issuedetail.issueinvcode,   
         issuedetail.gcode,   
         issuedetail.icode,   
         issuedetail.batch, 
         issuedetail.expiry,   
         Id = issuedetail.IDENTITYCOL,   
         qty = issuedetail.qty,
			
			packunits= issuedetail.packunits,
	 		saleprice= issuedetail.saleprice,
          
          
         avgprice = issuedetail.avgprice,  
         mrpp = issuedetail.mrpp, 
			
			
			stock = 0, 
			totalstock = 0 
			

    FROM issuedetail

   WHERE ( dbo.issuedetail.issueinvcode = :ar_IssueInvCode )

ORDER BY issuedetail.IDENTITYCOL



"
  update="issuedetail" updatewhere=0 updatekeyinplace=yes
  arguments=(("ar_IssueInvCode", number))
)
