footer(height=0 color="536870912" )
detail(height=77 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="IssueCategoryCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=subacccode dbname="SubAccCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=mainaccount dbname="MainAccount"  )
column=(type=long updatewhereclause=yes name=selected dbname="Selected" 
 values="Yes	1/	0/"  )
 retrieve="SELECT
	IssueCategoryCode=IssueCategoryAccounts.IssueCategoryCode,   
	SubAccCode=IssueCategoryAccounts.SubAccCode,
	Name=SubAccounts.Name,
	Category=CategoryAccounts.Name,
	MainAccount=MainAccounts.Name,
	Selected=1
FROM
	IssueCategoryAccounts, SubAccounts, CategoryAccounts, MainAccounts
WHERE
	IssueCategoryAccounts.IssueCategoryCode = :ai_code AND
	SubAccounts.SubAccCode = IssueCategoryAccounts.SubAccCode AND
	SubAccounts.CatAccCode = CategoryAccounts.CatAccCode AND
	CategoryAccounts.MainAccCode = MainAccounts.MainAccCode AND 
	SubAccounts.SubAccCode NOT IN (1,2,4,5,6,8,10,11,12,14.20,21,22,24,27,28,30)
UNION ALL
SELECT
	IssueCategoryCode=:ai_code,   
	SubAccounts.SubAccCode,
	Name=SubAccounts.Name,
	Category=CategoryAccounts.Name,
	MainAccount=MainAccounts.Name,
	Selected=0
FROM
	SubAccounts, CategoryAccounts, MainAccounts
WHERE
	SubAccounts.SubAcccode NOT IN 
		(SELECT IssueCategoryAccounts.SubAccCode 
		FROM IssueCategoryAccounts  
		WHERE IssueCategoryAccounts.IssueCategoryCode = :ai_code) AND
	SubAccounts.CatAccCode = CategoryAccounts.CatAccCode AND
	CategoryAccounts.MainAccCode = MainAccounts.MainAccCode AND 
	SubAccounts.SubAccCode NOT IN (1,2,4,5,6,8,10,11,12,14.20,21,22,24,27,28,30)
ORDER BY 
	Name,
	IssueCategoryCode"
  update="IssueCategoryAccounts" updatewhere=0 updatekeyinplace=no
  arguments=(("ai_code", number))
)
