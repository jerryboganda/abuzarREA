header(height=1656 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=156 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=issueinvcode dbname="IssueInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=recipientcode dbname="RecipientCode"  )
column=(type=char(60) updatewhereclause=yes name=recipient dbname="Recipient"  )
column=(type=char(60) updatewhereclause=yes name=recipientcity dbname="Recipientcity"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(50) updatewhereclause=yes name=referenceno dbname="ReferenceNo"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="GCode"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=datetime updatewhereclause=yes name=serverdate dbname="serverdate"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass"  )
column=(type=decimal(7) updatewhereclause=yes name=weight dbname="Weight"  )
column=(type=decimal(7) updatewhereclause=yes name=volume dbname="Volume"  )
column=(type=char(100) updatewhereclause=yes name=terms1 dbname="Terms1"  )
column=(type=char(100) updatewhereclause=yes name=terms2 dbname="Terms2"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="GODOWN"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
 retrieve="SELECT 
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end,
	reprintdate=getdate(), 
	users.username,
	headerno =max(IssueHeader.headerno),
	headerinvno=max(IssueHeader.headerinvno),
	posted=max(IssueHeader.posted),
	IssueInvCode=dbo.IssueHeader.Issueinvcode,   
	Date=dbo.IssueHeader.date,   
	RecipientCode = dbo.IssueHeader.RecipientCode,   
	Recipient = CASE dbo.IssueHeader.RecipientCode 
		WHEN 1 THEN (SELECT D.Name FROM Department D WHERE D.DeptCode = IssueHeader.DeptCode)
		WHEN 4 THEN (SELECT S.Name FROM Salesman S WHERE S.SalesmanCode = IssueHeader.RecipientSalesMan)
		ELSE (SELECT A.Name FROM Accounts A WHERE A.AccCode = IssueHeader.AccCode) END,
	Recipientcity = CASE dbo.IssueHeader.RecipientCode 
		WHEN 1 THEN ''
		WHEN 4 THEN ''
		ELSE (SELECT city from customer WHERE customer.custcode = IssueHeader.AccCode) END,
address1 = CASE dbo.IssueHeader.RecipientCode 
		WHEN 1 THEN ''
		WHEN 4 THEN ''
		ELSE (SELECT address1 from customer WHERE customer.custcode = IssueHeader.AccCode) END,
address2 = CASE dbo.IssueHeader.RecipientCode 
		WHEN 1 THEN ''
		WHEN 4 THEN ''
		ELSE (SELECT address2 from customer WHERE customer.custcode = IssueHeader.AccCode) END,
	Remarks=dbo.IssueHeader.remarks,
	ReferenceNo=dbo.IssueHeader.ReferenceNo,	
	Icode=dbo.IssueDetail.icode,   
	GCode=dbo.IssueDetail.gcode,
	Id        = MAX(dbo.IssueDetail.IDENTITYCOL),     
	qty  = sum(IssueDetail.qty), 
	packunits = max(IssueDetail.packunits), 
	saleprice = max(IssueDetail.saleprice), 
	serverdate=getdate(),
	ItemClass = ICL.Name,
	Weight = SUM(Item.UnitWeight * IssueDetail.qty),
	Volume = SUM(Item.PackingFactor * IssueDetail.qty),
	Terms1 = MAX(IssueHeader.Terms1),
	Terms2 = MAX(IssueHeader.Terms2),
	GODOWN=(select name from godown where IssueDetail.gcode=godown.gcode),
	itemcategory=(select name from itemcategory where itemcategory.icatcode=max(item.icatcode))
FROM 
	dbo.IssueHeader,   
	dbo.IssueDetail,  
	item, 
	itemclass ICL,
	users 
WHERE 
	( dbo.IssueHeader.IssueInvCode = :ra_InvCode ) AND
	( dbo.IssueHeader.IssueInvCode = dbo.IssueDetail.IssueInvCode ) AND 
	( dbo.IssueHeader.salesmancode = dbo.users.usercode ) AND
	( IssueDetail.icode = item.icode )  AND
	( item.iccode = ICL.ICCode )
GROUP BY 
	IssueHeader.IssueInvCode, 
	IssueHeader.date, 
	IssueHeader.RecipientCode,
	IssueHeader.AccCode, 
	IssueHeader.remarks,
	IssueHeader.ReferenceNo, 
	IssueHeader.DeptCode,
	IssueHeader.AccCode,
	IssueHeader.RecipientSalesMan,
	IssueDetail.icode,
	IssueDetail.gcode, 
	item.name,
	item.icode,
	item.printable, 
	ICL.Name,
	dbo.users.username
ORDER BY  
	itemcategory,
	Item.Name,
	MAX(dbo.IssueDetail.IDENTITYCOL)
"
  arguments=(("ra_InvCode", number))
)
