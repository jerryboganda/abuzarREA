summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="SaleLedger.saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleLedger.date"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="SaleLedger.custrefno"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SaleLedger.remarks"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=long updatewhereclause=yes name=reprintingcounter dbname="ReprintingCounter"  )
column=(type=datetime updatewhereclause=yes name=originaldate dbname="SaleLedger.OriginalDate"  )
column=(type=long updatewhereclause=yes name=modifycounter dbname="SaleLedger.ModifyCounter"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="SaleLedger.AdmissionCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Patient.Regno"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="patientcode"  )
 retrieve="SELECT	
	saleledger.saleinvcode , 
	saleledger.date , 
	saleledger.custrefno, 
	saleledger.remarks , 
	custcode=saleledger.custcode,
	accounts.name,
	users.username, 
	posted = saleledger.posted,
	PostedBy = IsNull((Select username from users 
								where dbo.saleledger.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
								where dbo.saleledger.modifiedby = dbo.users.usercode), ''),
	NetAmount =max( saleledger.invtotal),
					/* Round(SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) *
						(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) + 
						saleledger.misccharges + saleledger.salestax - saleledger.flatdisc, 0)+
						Round(SUM( (saledetail.looseqty + saledetail.bonusqty) * saledetail.unitsalestax) + 
						SUM(ROUND( (saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) *
						(1 - (.01 * saledetail.discperc)) * saledetail.gstperc * .01, 2)) +
						ROUND( (SUM((saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) *
						(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) -
						saleledger.flatdisc) * (saleledger.invgstperc1 * .01), 2), 0),*/
	dbo.saleledger.ReprintingCounter,
	dbo.saleledger.OriginalDate,
	dbo.saleledger.ModifyCounter,
	dbo.saleledger.AdmissionCode,
	dbo.Patient.Regno,
	Patient=dbo.Patient.Name,
	patientcode=patient.patientcode
	
FROM  
	accounts, saleledger, saledetail, users, patientadmission, patient
WHERE     
	( dbo.saleledger.AdmissionCode IS NOT NULL ) AND
	 ( dbo.saleledger.AdmissionCode = dbo.patientadmission.AdmissionCode ) AND
	 ( dbo.patientadmission.PatientCode = Patient.PatientCode ) AND
	 ( saleledger.custcode = accounts.acccode ) and 
	 ( dbo.saleledger.salecatcode = 1 or 
		dbo.saleledger.salecatcode = 2 )   and
	 ( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode)   and
	 ( dbo.saleledger.salesmancode = dbo.users.usercode)   and
	 (dbo.saleledger.date > :ad_invdate) and
	 ( Posted IN (:as_Posted)) and
		:as_showrows='Y' AND 
	 ( dbo.saleledger.headerno IS NULL OR
	 ( dbo.saleledger.headerno in (SELECT headercode FROM GroupAllowedHeader WHERE GroupCode = :ai_groupcode and module = :ai_module)))
GROUP BY 
	saleledger.SALEINVCODE,
	saleledger.CustCode,
	saleledger.DiscPerc,
	saleledger.MiscCharges,
	saleledger.SalesTax,
	saleledger.FlatDisc,
	saleledger.DiscPerc,
	saleledger.FlatDisc,
	saleledger.InvGSTPerc1,
	saleledger.date , 
	saleledger.custrefno, 
	accounts.name,
	saleledger.posted,
	saleledger.postedby,
	saleledger.modifiedby,
	users.username,
	dbo.saleledger.ReprintingCounter, 
	saleledger.remarks,
	dbo.saleledger.OriginalDate,
	dbo.saleledger.ModifyCounter,
	dbo.saleledger.AdmissionCode,
	dbo.Patient.RegNo,
	dbo.Patient.Name,
	dbo.patient.patientcode
"
  arguments=(("ai_SaleCatCode", number), ("as_Posted", stringlist), ("ad_invdate", datetime), ("as_showrows", string), ("ai_groupcode", number), ("ai_module", number))
 sort="code A"
)
