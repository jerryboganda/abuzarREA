release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=72 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="ServiceRHeader.servicerinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ServiceRHeader.date"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="invtotal"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ServiceRHeader.remarks"  )
column=(type=long updatewhereclause=yes name=servicerheader_serviceinvcode dbname="ServiceRHeader.serviceinvcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Patient.RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
 retrieve="SELECT  servicerheader.servicerinvcode , 
	servicerheader.date , 
	invtotal = servicerheader.invtotal,
	servicerheader.remarks , 
	servicerheader.serviceinvcode,
	headerno=servicerheader.headerno,
	accounts.name,
	posted = servicerheader.posted,
	PostedBy = IsNull((Select username from users 
					where dbo.servicerheader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
					where dbo.servicerheader.modifiedby = dbo.users.usercode), '') ,
	Patient.RegNo,
	Patient=Patient.Name
FROM  accounts , 
	 servicerheader,
	 patientadmission,
	 patient

WHERE  ( servicerheader.custcode = accounts.acccode ) and 
	 ( dbo.servicerheader.servicercatcode = 14 or 
		dbo.servicerheader.servicercatcode = 15 )   and
	 ( dbo.servicerheader.admissioncode IS NOT NULL ) AND
	 ( dbo.servicerheader.admissioncode = dbo.patientadmission.admissioncode ) and
	 ( dbo.patientadmission.patientcode = dbo.patient.patientcode ) and
	 ( Posted IN (:as_Posted))"
  arguments=(("ai_ServiceRCatCode", number), ("as_Posted", stringlist))
)
