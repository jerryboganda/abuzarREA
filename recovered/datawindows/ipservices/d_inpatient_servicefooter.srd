detail(height=168 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=code dbname="ServiceHeader.serviceinvcode"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=flatdisc dbname="ServiceHeader.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=misccharges dbname="ServiceHeader.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100" initial="0" name=serviceinvgstperc dbname="ServiceHeader.serviceinvgstperc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100" initial="0" name=invdiscperc dbname="ServiceHeader.discperc"  )
column=(type=long updatewhereclause=yes initial="99999" name=icode dbname="Icode"  )
column=(type=long updatewhereclause=yes initial="0" name=stock dbname="Stock"  )
column=(type=long updatewhereclause=yes initial="0" name=totalstock dbname="TotalStock"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Invoice total can not be negative'" initial="0" name=total dbname="Total"  )
column=(type=decimal(2) updatewhereclause=yes name=purdiscperc dbname="purdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=balance dbname="balance"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=cashreceived dbname="ServiceHeader.cashreceived"  )
 retrieve="SELECT
	ServiceHeader.serviceinvcode ,   
	ServiceHeader.flatdisc, 
	ServiceHeader.misccharges,   
	ServiceHeader.serviceinvgstperc,   
	ServiceHeader.discperc,
	Icode = 0, 
	Stock = 0,
	TotalStock = 0,
	Total = 0.00,
	purdiscperc = 0.00,
	balance = 0.00,
	cashreceived
FROM 
	ServiceHeader  
WHERE 
	ServiceHeader.serviceinvcode = :ar_invcode    
"
  update="ServiceHeader" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_invcode", number))
)
