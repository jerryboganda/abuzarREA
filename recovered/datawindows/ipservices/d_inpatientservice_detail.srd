table(column=(type=char(60) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=icode dbname="ServiceDetail.servicecode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long updatewhereclause=yes name=code dbname="ServiceDetail.serviceinvcode"  )
column=(type=long updatewhereclause=yes name=smancode dbname="ServiceDetail.smancode" 
 values=""  )
column=(type=decimal(2) updatewhereclause=yes validation="REAL ( GetText() ) > 0" initial="1" name=qty dbname="ServiceDetail.qty"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" name=saleprice dbname="ServiceDetail.price"  )
column=(type=decimal(15) updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) < 100" validationmsg="'Discount (%) must be between 0 and 100'" initial="0" name=prediscperc dbname="PreDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=serviceflatdisc dbname="ServiceDetail.serviceflatdisc"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=allowsaleindecimal dbname="allowsaleindecimal"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=commission dbname="ServiceDetail.Commission"  )
column=(type=decimal(5) updatewhereclause=yes initial="0.00" name=costprice dbname="ServiceDetail.CostPrice"  )
column=(type=long updatewhereclause=yes initial="1" name=srvorowid dbname="SrvORowId"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=servicestatus dbname="ServiceStatus"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=lockprice dbname="LockPrice"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=lockdiscperc dbname="LockDiscPerc"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=lockserviceflatdisc dbname="LockServiceFlatDisc"  )
column=(type=datetime updatewhereclause=yes name=deliverydate dbname="ServiceDetail.DeliveryDate"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=sampletaken dbname="ServiceDetail.SampleTaken"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=reportmade dbname="ServiceDetail.ReportMade"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ServiceDetail.Remarks"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=serviceflattax dbname="ServiceDetail.serviceflattax"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=servicegstperc dbname="ServiceDetail.servicegstperc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) <= 100" validationmsg="'Share (%) must be between 0 and 100'" initial="0" name=shareperc dbname="ServiceDetail.shareperc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) <= 100" validationmsg="'Discount (%) must be between 0 and 100'" initial="0" name=discperc dbname="ServiceDetail.discperc"  )
 retrieve="SELECT 
	fullcode=service.aliasname,
	itemname= service.name, 
	servicedetail.servicecode,
	itemcode = servicedetail.servicecode,
	currlistrow = 0,
	servicedetail.serviceinvcode,   
	Servicedetail.smancode,
	Servicedetail.qty,
	servicedetail.price,
	PreDiscPerc=ROUND( (servicedetail.serviceflatdisc / CASE WHEN servicedetail.Price > 0 THEN servicedetail.Price ELSE 1 END) * 100, 2),
	servicedetail.serviceflatdisc,
	allowsaleindecimal=service.allowsaleindecimal,
	Servicedetail.Commission,
	Servicedetail.CostPrice,
	SrvORowId = 1,
	ServiceStatus = 'N',
	LockPrice = Service.LockPrice,
	LockDiscPerc = Service.LockDiscPerc,
	LockServiceFlatDisc = Service.LockServiceFlatDisc,
	servicedetail.DeliveryDate,
	servicedetail.SampleTaken,
	servicedetail.ReportMade,
	servicedetail.Remarks,
	servicedetail.serviceflattax,
	servicedetail.servicegstperc,
	servicedetail.shareperc,
	Servicedetail.discperc
FROM 
	servicedetail, service 
WHERE 
	( servicedetail.serviceinvcode = :ar_SaleInvCode )    AND
	( servicedetail.servicecode = service.servicecode )
"
  arguments=(("ar_SaleInvCode", number))
)
