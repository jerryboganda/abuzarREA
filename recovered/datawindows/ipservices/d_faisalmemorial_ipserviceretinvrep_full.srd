summary(height=1218 color="536870912" )
footer(height=208 color="536870912" )
detail(height=208 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=char(60) updatewhereclause=yes name=doctorname dbname="doctorname"  )
column=(type=long updatewhereclause=yes name=serviceocatcode dbname="serviceocatcode"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="username"  )
column=(type=long updatewhereclause=yes name=servicercode dbname="servicercode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=headerno dbname="ServiceRHeader.headerno"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="ServiceRHeader.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="ServiceRHeader.misccharges"  )
column=(type=long updatewhereclause=yes name=custcode dbname="ServiceRHeader.custcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="ServiceRHeader.flatdisc"  )
column=(type=long updatewhereclause=yes name=service_servicecode dbname="Service.servicecode"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="ServiceFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="servicerdetail_discperc"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="ServiceRHeader.saleinvcode"  )
column=(type=long updatewhereclause=yes name=servicercatcode dbname="ServiceRHeader.servicercatcode"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=patientadd dbname="patientadd"  )
column=(type=char(30) updatewhereclause=yes name=patientphone dbname="patientphone"  )
column=(type=char(60) updatewhereclause=yes name=usergroupname dbname="usergroupname"  )
column=(type=long updatewhereclause=yes name=patientage dbname="patientage"  )
 retrieve="SELECT 
	itemname = service.name,
	reprintdate = getDate(),
	doctorname=(select name from doctors where doctors.doctcode=servicerheader.doctcode), 
	serviceocatcode=servicerheader.servicercatcode,
	username=users.username,  
	servicercode=dbo.servicerheader.servicerinvcode,   
	date=dbo.servicerheader.date,  
	dbo.servicerheader.headerno,
	dbo.servicerheader.discperc,   
	dbo.servicerheader.misccharges,   
	dbo.servicerheader.custcode,   
	remarks=dbo.servicerheader.remarks,
	dbo.servicerheader.flatdisc,
	dbo.service.servicecode,   
	price = dbo.servicerdetail.serviceprice, 
	ServiceFlatDisc = ServiceRDetail.ServiceFlatDisc,
	Qty = dbo.servicerdetail.qty,
	servicerdetail_discperc = servicerdetail.discperc, 
	customername=(SELECT Accounts.Name FROM Accounts WHERE Accounts.AccCode  = servicerheader.Custcode),
	dbo.servicerheader.saleinvcode,
	dbo.servicerheader.servicercatcode,
	Patient=(SELECT Patient.Name FROM Patient WHERE patientadmission.PatientCode = Patient.PatientCode),
	RegNo=(SELECT Patient.Regno FROM Patient WHERE patientadmission.PatientCode = Patient.PatientCode),
	patientadd=(SELECT Patient.address1 FROM Patient WHERE patientadmission.PatientCode = Patient.PatientCode),
	patientphone=(SELECT Patient.phone FROM Patient WHERE patientadmission.PatientCode = Patient.PatientCode),
	usergroupname=(select  groups.groupname from groups,usergroups where  users.usercode=usergroups.usercode and usergroups.groupcode=groups.groupcode),
	patientage=(SELECT Patient.ageyears FROM Patient WHERE patientadmission.PatientCode = Patient.PatientCode)
	
FROM 
	dbo.servicerheader 
	LEFT OUTER JOIN Patient ON (dbo.servicerheader.patientcode = dbo.patient.patientcode),
	dbo.servicerdetail,  
	service,
	users,
	patientadmission
WHERE 
	( dbo.servicerheader.servicerinvcode = :ra_InvCode ) AND
	( dbo.servicerheader.servicerinvcode = dbo.servicerdetail.servicerinvcode ) AND 
	( dbo.servicerdetail.servicecode = dbo.service.servicecode ) AND
	(dbo.servicerheader.salesmancode = dbo.users.usercode) AND
	(dbo.servicerheader.admissioncode=patientadmission.admissioncode)"
  arguments=(("ra_InvCode", number))
)
