 values=""  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Patient.regno"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="ServiceOHeader.patientcode"  )
column=(type=long update=yes updatewhereclause=yes name=admissioncode dbname="ServiceOHeader.admissioncode" 
 values=""  )
column=(type=long updatewhereclause=yes name=locationcode dbname="PatientAdmission.locationcode" 
 values=""  )
 retrieve="SELECT
	dbo.accounts.acccode, 
	dbo.accounts.subcode , 
	dbo.accounts.name ,
	aliasname = dbo.accounts.aliasname,
	dbo.accounts.openingdate ,
	dbo.customer.custcode ,
	dbo.customer.custcatcode ,
	dbo.customer.areacode,
	dbo.serviceOheader.serviceOcode , 
	dbo.serviceOheader.date , 
	dbo.serviceOheader.remarks , 
	dbo.serviceOheader.custcode , 
	dbo.serviceOheader.salesmancode,
	dbo.serviceOheader.headerno,  
	dbo.users.username,
	dbo.serviceOheader.discperc,
	dbo.serviceOheader.flatdisc,
	dbo.serviceOheader.misccharges,
	dbo.serviceOheader.posted,
	dbo.serviceOheader.postdate,
	customerbalance = 0,
	debitorcredit = ' ',
	dbo.serviceOheader.originaldate,
	dbo.serviceOheader.modifiedby,
	dbo.serviceOheader.postedby,
	dbo.serviceOheader.cashreceived,
	dbo.serviceOheader.doctcode,
	dbo.patient.regno,
	dbo.serviceOheader.patientcode,
	dbo.serviceOheader.admissioncode,
	patientadmission.locationcode

FROM
	dbo.customer, 
	dbo.serviceOheader, 
	dbo.users, 
	dbo.accounts,
	dbo.Patient,
	dbo.PatientAdmission

WHERE 
	( dbo.serviceOheader.serviceOcode = :ar_SaleInvCode ) AND
	( dbo.serviceOheader.custcode = dbo.customer.custcode ) AND
	( dbo.users.usercode = dbo.serviceOheader.salesmancode ) AND
	( dbo.serviceOheader.custcode = dbo.accounts.acccode ) AND
	( dbo.serviceOheader.AdmissionCode = dbo.PatientAdmission.AdmissionCode ) AND
	( dbo.PatientAdmission.PatientCode = dbo.Patient.PatientCode )
"
  update="serviceOheader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_SaleInvCode", number))
)
