release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="DiscountPolicyDetail.DiscountPolicyCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes validation="REAL(GETTEXT()) >= 0" validationmsg="'Please enter valid qty limit for discount policy'" name=qtylimit dbname="DiscountPolicyDetail.QtyLimit"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="REAL(GETTEXT()) >= 0 AND REAL(GETTEXT()) <= 100" validationmsg="'Please enter valid sale discount percentage for discount policy'" initial="0" name=discperc dbname="DiscountPolicyDetail.DiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="REAL(GETTEXT()) >= 0" validationmsg="'Please enter valid item flat discount for this row'" initial="0" name=itemflatdisc dbname="DiscountPolicyDetail.ItemFlatDisc"  )
column=(type=datetime update=yes updatewhereclause=yes name=expirydate dbname="DiscountPolicyDetail.ExpiryDate"  )
 retrieve="SELECT 
	DiscountPolicyDetail.DiscountPolicyCode,   
	DiscountPolicyDetail.QtyLimit,   
	DiscountPolicyDetail.DiscPerc,
	DiscountPolicyDetail.ItemFlatDisc,
	DiscountPolicyDetail.ExpiryDate
FROM 
	DiscountPolicyDetail  
WHERE 
	DiscountPolicyDetail.DiscountPolicyCode = :code   
ORDER BY 
	DiscountPolicyDetail.DiscountPolicyCode,   
	DiscountPolicyDetail.QtyLimit
"
  update="DiscountPolicyDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("code", number))
)
