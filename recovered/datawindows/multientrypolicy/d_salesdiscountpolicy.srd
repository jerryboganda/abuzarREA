table(column=(type=decimal(2) key=yes update=yes updatewhereclause=yes validation="REAL(GETTEXT()) >= 0" validationmsg="'Please enter valid Sale Invoice Amount'" initial="0" name=salelimit dbname="SalesDiscountPolicy.SaleLimit"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="REAL(GETTEXT()) >= 0 AND REAL(GETTEXT()) <= 100" validationmsg="'Please enter valid discount percentage [0-100]'" initial="0" name=discperc dbname="SalesDiscountPolicy.DiscPerc"  )
 retrieve="SELECT 
	SalesDiscountPolicy.SaleLimit,   
	SalesDiscountPolicy.DiscPerc  
FROM 
	SalesDiscountPolicy   
"
  update="SalesDiscountPolicy" updatewhere=1 updatekeyinplace=no
 )
