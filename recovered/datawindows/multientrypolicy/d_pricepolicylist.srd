table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Packunits"  )
 retrieve="SELECT 
	ItemName = I.Name,
	Name=PricePolicy.Name,   
	Code=PricePolicy.PricePolicyCode,   
	ICode=PricePolicy.ICode,
	Packunits = I.Packunits
FROM PricePolicy, Item I
WHERE PricePolicy.ICode = I.ICode
ORDER BY Code"
 )
