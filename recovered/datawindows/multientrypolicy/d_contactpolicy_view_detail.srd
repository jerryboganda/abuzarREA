header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=weekdaycode dbname="WeekDays.WeekDayCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=week1 dbname="Week1" 
 values="	1/	0"  )
column=(type=long updatewhereclause=yes name=week2 dbname="Week2" 
 values="	1/	0"  )
column=(type=long updatewhereclause=yes name=week3 dbname="Week3" 
 values="	1/	0"  )
column=(type=long updatewhereclause=yes name=week4 dbname="Week4" 
 values="	1/	0"  )
column=(type=long updatewhereclause=yes name=week5 dbname="Week5" 
 values="	1/	0"  )
 retrieve="SELECT 
	Code = 
		(SELECT C.ContactPolicyCode 
		FROM ContactPolicy C
		WHERE C.ContactPolicyCode = :ai_Code),
	W.WeekDayCode, 
	Week1=
	ISNULL((SELECT 1 FROM ContactPolicyDetail D
		WHERE D.ContactPolicyCode = :ai_Code AND
			D.WeekDayCode = W.WeekDayCode AND D.WeekOfMonth = 1), 0),
	Week2=
	ISNULL((SELECT 1 FROM ContactPolicyDetail D
		WHERE D.ContactPolicyCode = :ai_Code AND
			D.WeekDayCode = W.WeekDayCode AND D.WeekOfMonth = 2), 0),
	Week3=
	ISNULL((SELECT 1 FROM ContactPolicyDetail D
	WHERE D.ContactPolicyCode = :ai_Code AND
		D.WeekDayCode = W.WeekDayCode AND D.WeekOfMonth = 3), 0),
	Week4=
	ISNULL((SELECT 1 FROM ContactPolicyDetail D
		WHERE D.ContactPolicyCode = :ai_Code AND
			D.WeekDayCode = W.WeekDayCode AND D.WeekOfMonth = 4), 0),
	Week5=
	ISNULL((SELECT 1 FROM ContactPolicyDetail D
		WHERE D.ContactPolicyCode = :ai_Code AND
		D.WeekDayCode = W.WeekDayCode AND D.WeekOfMonth = 5), 0)
FROM
	WeekDays W "
  arguments=(("ai_code", number))
)
