release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="BonusPolicyDetail.BonusPolicyCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid qty Limit.'" name=qtylimit dbname="BonusPolicyDetail.QtyLimit"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid sale qty.'" initial="0" name=saleqty dbname="BonusPolicyDetail.SaleQty"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid bonus qty.'" initial="0" name=bonusqty dbname="BonusPolicyDetail.BonusQty"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=expirydate dbname="BonusPolicyDetail.ExpiryDate"  )
 retrieve="SELECT 
	BonusPolicyDetail.BonusPolicyCode,
	BonusPolicyDetail.QtyLimit,   
	BonusPolicyDetail.SaleQty,   
	BonusPolicyDetail.BonusQty,
	BonusPolicyDetail.ExpiryDate
FROM 
	BonusPolicyDetail  
WHERE 
	BonusPolicyDetail.BonusPolicyCode = :code   
ORDER BY 
	BonusPolicyDetail.BonusPolicyCode,   
	BonusPolicyDetail.QtyLimit
"
  update="BonusPolicyDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("code", number))
)
