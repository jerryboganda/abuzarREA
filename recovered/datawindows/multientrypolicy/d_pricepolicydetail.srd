release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PricePolicyDetail.PricePolicyCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=qtylimit dbname="PricePolicyDetail.QtyLimit"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0.00" name=price dbname="PricePolicyDetail.Price"  )
column=(type=long updatewhereclause=yes initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid item flat discount~"" initial="0" name=itemflatdisc dbname="PricePolicyDetail.ItemFlatDisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid item discount %age~"" initial="0" name=discperc dbname="PricePolicyDetail.DiscPerc"  )
column=(type=datetime update=yes updatewhereclause=yes initial="2012-12-12" name=expirydate dbname="PricePolicyDetail.ExpiryDate"  )
 retrieve="SELECT 
	PricePolicyDetail.PricePolicyCode, 
	PricePolicyDetail.QtyLimit, 
	PricePolicyDetail.Price, 
	packunits=ISNULL((SELECT Item.PackUnits FROM Item WHERE Item.ICode IN (SELECT PricePolicy.ICode FROM PricePolicy WHERE PricePolicy.PricePolicyCode = :ai_Code) ), 1),
	PricePolicyDetail.ItemFlatDisc, 
	PricePolicyDetail.DiscPerc, 
	PricePolicyDetail.ExpiryDate  
FROM 
	PricePolicyDetail  
WHERE 
	PricePolicyDetail.PricePolicyCode = :ai_code   
ORDER BY 
	PricePolicyDetail.PricePolicyCode ASC,   
	PricePolicyDetail.QtyLimit ASC   
"
  update="PricePolicyDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
