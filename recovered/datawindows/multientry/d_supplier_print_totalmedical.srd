table(column=(type=long key=yes update=yes updatewhereclause=yes name=accounts_acccode dbname="Accounts.acccode"  )
column=(type=long update=yes updatewhereclause=yes initial="7" name=accounts_subcode dbname="Accounts.subcode"  )
column=(type=char(60) update=yes updatewhereclause=yes validationmsg="'Item ~~'' +  gettext()  + '~~' does not pass validation test.'" name=accounts_name dbname="Accounts.name"  )
column=(type=char(12) update=yes updatewhereclause=yes name=accounts_aliasname dbname="Accounts.aliasname"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=accounts_openingdate dbname="Accounts.openingdate"  )
column=(type=long updatewhereclause=yes name=code dbname="Supplier.suppcode"  )
column=(type=long updatewhereclause=yes initial="1" name=suppcatcode dbname="Supplier.suppcatcode"  )
