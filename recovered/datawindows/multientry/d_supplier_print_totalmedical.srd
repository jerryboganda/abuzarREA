column=(type=char(30) updatewhereclause=yes name=supplier_phone dbname="Supplier.phone"  )
column=(type=char(16) updatewhereclause=yes name=supplier_fax dbname="Supplier.fax"  )
column=(type=char(30) updatewhereclause=yes name=supplier_email dbname="Supplier.email"  )
