column=(type=long updatewhereclause=yes initial="1" name=supplier_defaultgst dbname="Supplier.defaultgst" 
 values="GST%  1	1/GST%  2	2/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=accounts_active dbname="Accounts.active" 
 values="Yes	Y/No	N/"  )
column=(type=long updatewhereclause=yes initial="0" name=supplier_dayslimit dbname="Supplier.dayslimit"  )
column=(type=char(4000) updatewhereclause=yes name=supplier_specialinstructions dbname="Supplier.specialinstructions"  )
column=(type=long updatewhereclause=yes name=supplier_countycode dbname="Supplier.countycode"  )
column=(type=char(20) updatewhereclause=yes name=supplier_postcode dbname="Supplier.postcode"  )
column=(type=char(50) updatewhereclause=yes name=supplier_ntnno dbname="Supplier.ntnno"  )
column=(type=char(50) updatewhereclause=yes name=supplier_salestaxregno dbname="Supplier.salestaxregno"  )
 retrieve="SELECT  
	accounts.acccode ,
	accounts.subcode ,
	accounts.name ,
	accounts.aliasname,
	accounts.openingdate ,
	supplier.suppcode ,
	supplier.suppcatcode,
	supplier.cp ,
	supplier.address1 ,
	supplier.city ,
	supplier.country ,
	supplier.phone ,
	supplier.fax ,
	supplier.email ,
	supplier.address2,
	supplier.defaultgst,
	accounts.active,
	supplier.dayslimit,
	supplier.specialinstructions,
	supplier.countycode,
	supplier.postcode,
	supplier.ntnno,
	supplier.salestaxregno
FROM 
	accounts ,
	supplier     
WHERE 
	( supplier.suppcode = accounts.acccode ) and
	( ( dbo.supplier.SuppCode = :ar_supp_code ) )"
  update="accounts" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_supp_code", number))
)
