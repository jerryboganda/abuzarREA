header(height=968 color="536870912" )
summary(height=0 color="536870912" )
footer(height=156 color="536870912" )
detail(height=156 color="536870912" )
table(column=(type=char(203) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=theader_sgcode dbname="Theader.sgcode" 
 values=""  )
column=(type=long updatewhereclause=yes name=theader_transcode dbname="Theader.transcode"  )
column=(type=long updatewhereclause=yes name=theader_dgcode dbname="Theader.dgcode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=theader_date dbname="Theader.date"  )
column=(type=long updatewhereclause=yes name=icode dbname="Tdetail.icode"  )
column=(type=decimal(4) updatewhereclause=yes name=tdetail_qty dbname="Tdetail.qty"  )
column=(type=decimal(4) updatewhereclause=yes name=stqty dbname="stqty"  )
column=(type=decimal(4) updatewhereclause=yes name=gqty dbname="gqty"  )
 retrieve="SELECT   itemname= itemclass.name	+' ' +itemcategory.name+' ' +itempacking.name+' '+manufacturer.name, 
			dbo.theader.sgcode,
			dbo.theader.transcode,
         dbo.theader.dgcode,
         dbo.theader.date, 
         dbo.tdetail.icode,
         dbo.tdetail.qty,
			stqty = store.currqty,
			gqty = godown.currqty
 
FROM 		dbo.theader, 
         dbo.tdetail,
			dbo.godowndetail as store,
			dbo.godowndetail as godown,
         item ,
			itemclass,
			itemcategory,
			itempacking,
			manufacturer     

WHERE 	( dbo.tdetail.transcode = dbo.theader.transcode ) and 
         ( tdetail.icode = item.icode ) and  
			( store.gcode = 3) and
			( store.icode = item.icode) and
			( godown.gcode = item.gcode) and
			( godown.icode = item.icode) and
			( item.iccode = itemclass.iccode ) and  
			(( item.icatcode = itemcategory.icatcode ) and  
         ( item.packcode = itempacking.packcode ) and  
         ( item.manfcode = manufacturer.manfcode )) and
         ( ( dbo.theader.transcode = :ar_transcode ) )

Order by item.manfcode,
			item.packcode,
		   item.icatcode,
			item.iccode
"
  arguments=(("ar_transcode", number))
)
