column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="DispatchHeader.Remarks"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="DispatchHeader.date"  )
column=(type=long update=yes updatewhereclause=yes validationmsg="~"Please Select Some Valid Customer~"" name=custcode dbname="DispatchHeader.custcode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="DispatchHeader.posted"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Please Enter Valid Builty Expenses~"" initial="0" name=builtyexpenses dbname="DispatchHeader.BuiltyExpenses"  )
column=(type=long update=yes updatewhereclause=yes name=deliveredby dbname="DispatchHeader.DeliveredBy" 
 values=""  )
 retrieve="SELECT
	DispatchHeader.DispCode ,
	DispatchHeader.BiltyNo ,
	DispatchHeader.GCCode ,
	/* DispatchHeader.TelSender ,*/
	DispatchHeader.RecieverName ,
	DispatchHeader.RecieverTel ,
	DispatchHeader.Cartons ,
	DispatchHeader.BankName ,
	DispatchHeader.BranchName ,
	DispatchHeader.SalesmanCode ,
	DispatchHeader.Remarks ,
	DispatchHeader.date ,
	DispatchHeader.custcode ,
	DispatchHeader.posted,
	DispatchHeader.BuiltyExpenses,
	DispatchHeader.DeliveredBy

FROM 
	DispatchHeader      
WHERE 
	DispatchHeader.DispCode = :ad_DispCode"
  update="DispatchHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ad_DispCode", number))
)
