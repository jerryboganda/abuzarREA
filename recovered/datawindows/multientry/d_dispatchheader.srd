table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="DispatchHeader.DispCode"  )
column=(type=char(30) update=yes updatewhereclause=yes validationmsg="~"Please Enter Valid Builty No.~"" name=biltyno dbname="DispatchHeader.BiltyNo"  )
column=(type=long update=yes updatewhereclause=yes validationmsg="~"Please Select Valid Agency~"" name=gccode dbname="DispatchHeader.GCCode" 
 values=""  )
column=(type=char(30) update=yes updatewhereclause=yes name=recievername dbname="RecieverName"  )
column=(type=char(15) update=yes updatewhereclause=yes name=recievertel dbname="DispatchHeader.RecieverTel"  )
column=(type=decimal(0) update=yes updatewhereclause=yes initial="0" name=cartons dbname="DispatchHeader.Cartons"  )
