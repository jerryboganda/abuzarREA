column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=newsaleprice dbname="AvgPriceAdjDetail.NewSalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=newpurprice dbname="AvgPriceAdjDetail.NewPurPrice"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=rate dbname="Rate"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=newavgprice dbname="AvgPriceAdjDetail.NewAvgPrice"  )
 retrieve="SELECT 
   I.CustomICode,
	I.Name,
  	currlistrow = 0,
	D.DocumentCode,
	D.Icode,
   D.SalePrice,
   D.PurPrice,
   D.AvgPrice,
	UTN,
	D.Stock,
	D.NewSalePrice,
	D.NewPurPrice,
	Rate=0.00,
	Amount=0.00,
	D.NewAvgPrice
FROM AvgPriceAdjDetail D, Item I
WHERE D.DocumentCode=:AI_CODE AND D.ICode = I.ICode
"
  update="AvgPriceAdjDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("AI_CODE", number))
)
