table(column=(type=long key=yes updatewhereclause=yes name=rightcode dbname="Rights.RightCode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=checked dbname="checked" 
 values="	Y/	N"  )
column=(type=long updatewhereclause=yes name=levelindex dbname="Rights.LevelIndex"  )
column=(type=char(150) updatewhereclause=yes name=rightname dbname="Rights.RightName"  )
 retrieve="SELECT     
	Rights.RightCode, 
	checked = ' ',  
	Rights.LevelIndex,
	Rights.RightName
FROM 
	Rights   
ORDER BY 
	Rightname
	
"
  update="Rights" updatewhere=0 updatekeyinplace=no
  sort="rightname A"
)
