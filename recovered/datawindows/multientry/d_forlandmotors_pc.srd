table(column=(type=char(19) updatewhereclause=yes name=type dbname="Type"  )
column=(type=char(18) updatewhereclause=yes name=referenceno dbname="ReferenceNO"  )
column=(type=char(100) updatewhereclause=yes name=motorvehicle dbname="MotorVehicle"  )
column=(type=char(100) updatewhereclause=yes name=chasisno dbname="ChasisNo"  )
column=(type=char(100) updatewhereclause=yes name=engineno dbname="EngineNo"  )
column=(type=char(60) updatewhereclause=yes name=color dbname="Color"  )
column=(type=char(100) updatewhereclause=yes name=model dbname="Model"  )
column=(type=char(100) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(100) updatewhereclause=yes name=enginepower dbname="EnginePower"  )
column=(type=char(1) updatewhereclause=yes name=toolkit dbname="ToolKit"  )
column=(type=char(1) updatewhereclause=yes name=sparetyre dbname="SpareTyre"  )
column=(type=char(100) updatewhereclause=yes name=originalkeys dbname="OriginalKeys"  )
column=(type=char(1) updatewhereclause=yes name=warrantybook dbname="WarrantyBook"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(100) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=char(30) updatewhereclause=yes name=cnic dbname="CNIC"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=char(100) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(10) updatewhereclause=yes name=itemaliasname dbname="itemaliasname"  )
column=(type=long updatewhereclause=yes name=productcode dbname="Productcode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="smanname"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=char(100) updatewhereclause=yes name=referenceno2 dbname="referenceno2"  )
column=(type=datetime updatewhereclause=yes name=referencedate dbname="referencedate"  )
 retrieve="SELECT 
	Type = 'PASSAGE CERTIFICATE',
	ReferenceNO = 'FMM-GPD-' + LTRIM(RTRIM(STR(dbo.Product.productcode, 10))), 
	MotorVehicle = product.Name,
	ChasisNo = product.ChasisNo,
	EngineNo = product.EngineNo,
	Color = (SELECT M.Name FROM ItemColour M WHERE M.IColourCode = Product.IColourCode),
	Model = (SELECT M.Name FROM Model M WHERE M.ModelCode = Product.ModelCode),
	Area = product.Area,
	EnginePower = product.EnginePower,
	ToolKit = product.ToolKit,
	SpareTyre = product.SpareTyre,
	OriginalKeys = product.OriginalKeys,
	WarrantyBook = product.WarrantyBook,
	CustomerName = (SELECT A.Name FROM Accounts A WHERE A.AccCode = Product.CustCode),
	FatherName = (SELECT C.Fname FROM Customer C WHERE C.CustCode = Product.CustCode),
	CNIC = (SELECT C.NIC FROM Customer C WHERE C.CustCode = Product.CustCode),
	Phone = (SELECT C.Phone FROM Customer C WHERE C.CustCode = Product.CustCode),
	Address1 = (SELECT C.Address1 FROM Customer C WHERE C.CustCode = Product.CustCode),
	Address2 = (SELECT C.Address2 FROM Customer C WHERE C.CustCode = Product.CustCode),
	itemname= product.name,  
	itemaliasname=ltrim(rtrim(str(product.productcode))),
	Productcode = dbo.Product.Productcode, 
	smanname=(SELECT salesman.name FROM SalesMan WHERE SalesMan.SalesManCode = Product.SalesMANCode),
	date = dbo.Product.date,
	price = saleprice,
	referenceno2=Product.refno2,
	referencedate=dbo.Product.date
FROM 
	Product
WHERE 
	( dbo.Product.productcode = :ar_Code ) AND Delivered= 'Y'
ORDER BY 
	Type"
  arguments=(("ar_Code", number))
)
