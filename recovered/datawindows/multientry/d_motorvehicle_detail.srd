table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="MotorVehicle.MotorVehicleCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="MotorVehicle.Name"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=motorvehicletypecode dbname="MotorVehicle.MotorVehicleTypeCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=originaldate dbname="MotorVehicle.OriginalDate"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="MotorVehicle.Date"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="<CHASIS NO.>" name=chasisno dbname="MotorVehicle.ChasisNo"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="<ENGINE NO.>" name=engineno dbname="MotorVehicle.EngineNo"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="<MODEL>" name=model dbname="MotorVehicle.Model"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="<COLOR>" name=color dbname="MotorVehicle.Color"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="<POWER>" name=enginepower dbname="MotorVehicle.EnginePower"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="<AREA>" name=area dbname="MotorVehicle.Area"  )
column=(type=long update=yes updatewhereclause=yes initial="19" name=custcode dbname="MotorVehicle.CustCode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=regno dbname="MotorVehicle.RegNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=refno dbname="MotorVehicle.RefNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=refno2 dbname="MotorVehicle.RefNo2"  )
column=(type=char(100) update=yes updatewhereclause=yes name=refno3 dbname="MotorVehicle.RefNo3"  )
column=(type=char(100) update=yes updatewhereclause=yes name=refno4 dbname="MotorVehicle.RefNo4"  )
column=(type=char(100) update=yes updatewhereclause=yes name=refno5 dbname="MotorVehicle.RefNo5"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=toolkit dbname="MotorVehicle.ToolKit" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=sparetyre dbname="MotorVehicle.SpareTyre" 
 values="Yes	Y/No	N/"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="2" name=originalkeys dbname="MotorVehicle.OriginalKeys"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=warrantybook dbname="MotorVehicle.WarrantyBook" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT
	MotorVehicleCode,
	Name,
	MotorVehicleTypeCode,
	OriginalDate,
	Date,
	ChasisNo,
	EngineNo,
	Model,
	Color,
	EnginePower,
	Area,
	CustCode,
	RegNo,
	RefNo,
	RefNo2,
	RefNo3,
	RefNo4,
	RefNo5,
	ToolKit,
	SpareTyre,
	OriginalKeys,
	WarrantyBook
FROM 
	MotorVehicle
WHERE
	MotorVehicleCode = :ai_code
"
  update="MotorVehicle" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
