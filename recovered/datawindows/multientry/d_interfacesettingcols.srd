table(column=(type=long key=yes update=yes updatewhereclause=yes name=moduleid dbname="InterfaceSetting.moduleid"  )
column=(type=long update=yes updatewhereclause=yes name=sequenceid dbname="InterfaceSetting.sequenceid"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=colname dbname="InterfaceSetting.colname"  )
column=(type=char(100) update=yes updatewhereclause=yes name=colcaption dbname="InterfaceSetting.colcaption"  )
column=(type=long update=yes updatewhereclause=yes name=visibility dbname="InterfaceSetting.visibility" 
 values="	1/	0"  )
 retrieve="select moduleid,
       sequenceid,
		 colname,
		 colcaption,
		 visibility

From   InterfaceSetting

Where  ModuleId = :ai_moduleid AND WinType = :ai_wintype AND Visibility = :ai_visibility

Order By ModuleId , SequenceId
"
  update="InterfaceSetting" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_moduleid", number), ("ai_wintype", number), ("ai_visibility", number))
)
