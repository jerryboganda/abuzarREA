column=(type=long update=yes updatewhereclause=yes name=soldby dbname="Product.SoldBy"  )
 retrieve="SELECT 
	ProductCode,
	UserCode,
	OriginalDate,
	Date,
	Name,
	ChasisNo,
	EngineNo, 
	EnginePower,
	ModelCode,
	ProductPurposeCode,
	ProductTypeCode,
	IColourCode,
	Area,
	ToolKit,
	SpareTyre,
	WarrantyBook,
	Deck,
	OriginalKeys,
	OriginalKeysDetails,
	Others1,
	Others1Details,
	Others2,
	Others2Details,
	InvoiceIssued,
	FirmCommission,
	SalesPersonCommission,
	RefNo,
	RefNo2,
	RefNo3,
	RefNo4,
	RefNo5,
	Finalized,
	FinalizedOn,
	FinalizedBy,

	PurchasePrice,
	Transportation,
	FirmCommissionReceived,
	SuppCode,
	Aquired,
	AquiredOn,
	AquiredBy,
	
	CustCode,
	SalesManCode,
	CompanyInvoiceReceived,
	RegistrationRequired,
	Delivered,
	DeliveredOn,
	DeliveredBy,
	
	SalePrice,
	Discount,
	RegistrationAmount,
	RegistrationReceived,
	Sold,
	SoldOn,
	SoldBy
FROM
	DBO.Product
WHERE 
	ProductCode = :ai_code"
  update="DBO.Product" updatewhere=0 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
