table(column=(type=char(60) updatewhereclause=yes validation="match( gettext() , ~"^[A-Z]+[A-Za-z0-9~\-]~")" validationmsg="'Item ~~'' +  gettext()  + '~~' does not pass validation test.'" name=supplier_name dbname="Accounts.name"  )
column=(type=char(12) updatewhereclause=yes name=accounts_aliasname dbname="Accounts.aliasname"  )
column=(type=char(60) updatewhereclause=yes name=supplier_address dbname="Supplier.address1"  )
column=(type=long updatewhereclause=yes name=code dbname="Supplier.suppcode"  )
column=(type=char(30) updatewhereclause=yes name=supplier_city dbname="Supplier.city"  )
column=(type=char(100) updatewhereclause=yes name=suppcatname dbname="suppcatname"  )
 retrieve="SELECT  
	accounts.name, 
	accounts.aliasname, 
	supplier.address1,
	supplier.suppcode,
	supplier.city,
	suppcatname=(select name from suppliercategory where suppliercategory.suppcatcode=supplier.suppcatcode)
FROM 
	accounts, supplier
WHERE 
	(supplier.suppcode = accounts.acccode)"
 )
