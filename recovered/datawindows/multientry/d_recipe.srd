footer(height=0 color="536870912" )
detail(height=460 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Recipe.RecipeCode"  )
column=(type=char(12) update=yes updatewhereclause=yes name=aliasname dbname="Recipe.AliasName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="Recipe.Name"  )
column=(type=char(400) update=yes updatewhereclause=yes name=description dbname="Recipe.Description"  )
column=(type=long update=yes updatewhereclause=yes name=resulteditem dbname="Recipe.ResultedItem" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="Recipe.UserCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=originaldate dbname="Recipe.OriginalDate"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="Recipe.Date"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="REAL(GETTEXT()) > 0" validationmsg="'Please enter Valid Quantity'" initial="1" name=qty dbname="Recipe.Qty"  )
column=(type=long update=yes updatewhereclause=yes validation="INTEGER(GETTEXT()) >= 0" validationmsg="'Please enter Valid Priority'" initial="1" name=priority dbname="Recipe.Priority"  )
column=(type=decimal(13) updatewhereclause=yes validation="INTEGER(GETTEXT()) >= 0" validationmsg="'Please enter Valid Sale Price'" initial="0" name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=value dbname="Value"  )
 retrieve="SELECT
	Recipe.RecipeCode,   
	Recipe.AliasName,   
	Recipe.Name,   
	Recipe.Description,   
	Recipe.ResultedItem,   
	Recipe.UserCode,   
	Recipe.OriginalDate,   
	Recipe.Date,
	Recipe.Qty,
	Recipe.Priority,
	SalePrice=ISNULL((SELECT Price=ROUND(Item.SalePrice / CASE WHEN item.Packunits > 0 THEN Item.PackUnits ELSE 1 END, 2) FROM Item WHERE Item.ICode = Recipe.ResultedItem), 0),
	Value=0.00
FROM
	Recipe   
WHERE 
	Recipe.RecipeCode = :ar_Code"
  update="Recipe" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_code", number))
)
