detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="DispatchHeader.DispCode"  )
column=(type=char(30) updatewhereclause=yes name=biltyno dbname="DispatchHeader.BiltyNo"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="GoodsCompany.Name"  )
column=(type=char(1) updatewhereclause=yes name=dispatchheader_posted dbname="DispatchHeader.posted"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Accounts.name"  )
column=(type=datetime updatewhereclause=yes name=date dbname="DispatchHeader.date"  )
 retrieve=" SELECT DispatchHeader.DispCode,   
         DispatchHeader.BiltyNo,   
         GoodsCompany.Name,
  			DispatchHeader.posted,
         accounts.name,
         DispatchHeader.date
    FROM DispatchHeader,   
         GoodsCompany  , accounts
   WHERE ( DispatchHeader.GCCode = GoodsCompany.GCCode )    and
         ( DispatchHeader.custcode=accounts.acccode)
"
 )
