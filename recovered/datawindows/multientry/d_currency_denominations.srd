table(column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=type dbname="CurrencyDenomination.Type" 
 values="Coin	C/Note	N/"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="CurrencyDenomination.CurrencyCode"  )
column=(type=char(60) update=yes updatewhereclause=yes initial="<Currency Denomination>" name=name dbname="CurrencyDenomination.Name"  )
column=(type=decimal(2) key=yes update=yes updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="'Please enter valid currency denomination'" initial="1" name=denomination dbname="CurrencyDenomination.Denomination"  )
 retrieve="SELECT 
	Type,
	CurrencyCode,
	Name,
	Denomination
FROM
	CurrencyDenomination 
WHERE 
	CurrencyCode=:ai_code
ORDER BY 
	CurrencyCode,
	Denomination
"
  update="CurrencyDenomination" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
