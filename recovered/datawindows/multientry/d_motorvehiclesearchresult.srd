table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="MotorVehicle.MotorVehicleCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="MotorVehicle.Name"  )
column=(type=long update=yes updatewhereclause=yes name=motorvehicletypecode dbname="MotorVehicle.MotorVehicleTypeCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=originaldate dbname="MotorVehicle.OriginalDate"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="MotorVehicle.Date"  )
column=(type=char(100) update=yes updatewhereclause=yes name=chasisno dbname="MotorVehicle.ChasisNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=engineno dbname="MotorVehicle.EngineNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=model dbname="MotorVehicle.Model"  )
column=(type=char(100) update=yes updatewhereclause=yes name=color dbname="MotorVehicle.Color"  )
column=(type=char(100) update=yes updatewhereclause=yes name=enginepower dbname="MotorVehicle.EnginePower"  )
column=(type=char(100) update=yes updatewhereclause=yes name=area dbname="MotorVehicle.Area"  )
column=(type=long update=yes updatewhereclause=yes name=custcode dbname="MotorVehicle.CustCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=regno dbname="MotorVehicle.RegNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=refno dbname="MotorVehicle.RefNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=refno2 dbname="MotorVehicle.RefNo2"  )
column=(type=char(100) update=yes updatewhereclause=yes name=refno3 dbname="MotorVehicle.RefNo3"  )
column=(type=char(100) update=yes updatewhereclause=yes name=refno4 dbname="MotorVehicle.RefNo4"  )
column=(type=char(100) update=yes updatewhereclause=yes name=refno5 dbname="MotorVehicle.RefNo5"  )
column=(type=char(1) update=yes updatewhereclause=yes name=toolkit dbname="MotorVehicle.ToolKit"  )
column=(type=char(1) update=yes updatewhereclause=yes name=sparetyre dbname="MotorVehicle.SpareTyre"  )
column=(type=char(100) update=yes updatewhereclause=yes name=originalkeys dbname="MotorVehicle.OriginalKeys"  )
column=(type=char(1) update=yes updatewhereclause=yes name=warrantybook dbname="MotorVehicle.WarrantyBook"  )
 retrieve="SELECT
	MotorVehicleCode,
	Name,
	MotorVehicleTypeCode,
	OriginalDate,
	Date,
	ChasisNo,
	EngineNo,
	Model,
	Color,
	EnginePower,
	Area,
	CustCode,
	RegNo,
	RefNo,
	RefNo2,
	RefNo3,
	RefNo4,
	RefNo5,
	ToolKit,
	SpareTyre,
	OriginalKeys,
	WarrantyBook
FROM 
	DBO.MotorVehicle
WHERE 
		Chasisno LIKE (CASE WHEN :as_chasisno='' OR :as_chasisno IS NULL THEN '«»' ELSE :as_chasisno END) OR
		Name LIKE (CASE WHEN :as_name='' OR :as_name IS NULL THEN '«»' ELSE :as_name END) OR 
		EngineNo LIKE (CASE WHEN :as_EngineNo='' OR :as_EngineNo IS NULL THEN '«»' ELSE :as_EngineNo END) OR 
		RegNo LIKE (CASE WHEN :as_RegNo='' OR :as_RegNo IS NULL THEN '«»' ELSE :as_RegNo END) OR
		Model LIKE (CASE WHEN :as_Model='' OR :as_Model IS NULL THEN '«»' ELSE :as_Model END) OR
		color LIKE (CASE WHEN :as_color='' OR :as_color IS NULL THEN '«»' ELSE :as_color END)

"
  update="DBO.MotorVehicle" updatewhere=1 updatekeyinplace=no
  arguments=(("as_chasisno", string), ("as_name", string), ("as_engineno", string), ("as_regno", string), ("as_model", string), ("as_color", string))
)
