summary(height=0 color="536870912" )
footer(height=68 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.Name"  )
column=(type=long updatewhereclause=yes name=currlistrow dbname="currlistrow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="AvgPriceAdjDetail.DocumentCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="AvgPriceAdjDetail.Icode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="AvgPriceAdjDetail.SalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=purprice dbname="AvgPriceAdjDetail.PurPrice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=avgprice dbname="AvgPriceAdjDetail.AvgPrice"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=utn dbname="AvgPriceAdjDetail.UTN"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=stock dbname="AvgPriceAdjDetail.Stock"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=newsaleprice dbname="AvgPriceAdjDetail.NewSalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=newpurprice dbname="AvgPriceAdjDetail.NewPurPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=newavgprice dbname="AvgPriceAdjDetail.NewAvgPrice"  )
 retrieve="SELECT
   I.CustomICode,
	I.Name,
  	currlistrow = 0,
	D.DocumentCode, 
	D.Icode, 
   D.SalePrice,
   D.PurPrice,
   D.AvgPrice,
	UTN,
	D.Stock,
	D.NewSalePrice,
	D.NewPurPrice,
	Rate=0.00,
	Amount=0.00,
	D.NewAvgPrice
FROM AvgPriceAdjDetail D, Item I
WHERE D.DocumentCode=:AI_CODE AND D.ICode = I.ICode
"
  update="AvgPriceAdjDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
