release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=76 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="DispatchDetail.DispCode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customername"  )
column=(type=char(121) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=decimal(10) updatewhereclause=yes initial="0" name=saleinvamt dbname="saleinvamt"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=saleinvcode dbname="DispatchDetail.SaleInvCode"  )
 retrieve="  SELECT DispatchDetail.DispCode,   
	 		customername = dbo.accounts.name, 
			address = RTRIM(LTRIM(dbo.customer.address1)) + ' ' + RTRIM(LTRIM(dbo.customer.address2)),
			Remarks = dbo.saleledger.remarks,
			Area = dbo.area.name,
			saleinvamt = Sum ( (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc)) *  (1 - dbo.saledetail.discperc /100 ) * (1 - dbo.saleledger.discperc /100)) + dbo.saleledger.misccharges  - dbo.saleledger.flatdisc, 
			DispatchDetail.SaleInvCode
	 	
    FROM dbo.DispatchDetail, 
		 	dbo.saledetail,   
         dbo.saleledger,
			dbo.accounts, 
			dbo.customer,
			dbo.area

   WHERE ( dbo.DispatchDetail.DispCode = :li_code) and
			( dbo.saleledger.saleinvcode  = dbo.DispatchDetail.SaleInvCode) and
	 		( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and
			( dbo.saleledger.custcode = dbo.accounts.acccode ) and
			( dbo.accounts.acccode = dbo.customer.custcode ) and
			( dbo.customer.areacode = dbo.area.areacode )

GROUP BY DispatchDetail.DispCode,    
	 		DispatchDetail.saleinvcode,   
			dbo.accounts.name,
			dbo.customer.address1,
			dbo.customer.address2,
			dbo.saleledger.remarks,
			dbo.area.name,
	 		dbo.saleledger.misccharges,   
         dbo.saleledger.flatdisc,   
	 		dbo.saleledger.discperc   
"
  update="DispatchDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("li_code", number))
)
