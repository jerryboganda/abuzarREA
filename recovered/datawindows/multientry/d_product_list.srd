table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Product.ProductCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="Product.Name"  )
column=(type=char(100) update=yes updatewhereclause=yes name=chasisno dbname="Product.ChasisNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=engineno dbname="Product.EngineNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=model dbname="Model"  )
column=(type=char(100) update=yes updatewhereclause=yes name=purpose dbname="Purpose"  )
column=(type=char(100) update=yes updatewhereclause=yes name=producttype dbname="ProductType"  )
column=(type=char(60) update=yes updatewhereclause=yes name=colour dbname="Colour"  )
column=(type=char(60) update=yes updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(60) update=yes updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) update=yes updatewhereclause=yes name=salesman dbname="SalesMan"  )
column=(type=char(1) update=yes updatewhereclause=yes name=finalized dbname="Product.Finalized" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=aquired dbname="Product.Aquired" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=delivered dbname="Product.Delivered" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=sold dbname="Product.Sold" 
 values="Yes	Y/No	N/"  )
column=(type=datetime update=yes updatewhereclause=yes name=originaldate dbname="Product.OriginalDate"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Product.Date"  )
column=(type=datetime update=yes updatewhereclause=yes name=finalizedon dbname="Product.FinalizedOn"  )
column=(type=datetime update=yes updatewhereclause=yes name=aquiredon dbname="Product.AquiredOn"  )
column=(type=datetime update=yes updatewhereclause=yes name=deliveredon dbname="Product.DeliveredOn"  )
column=(type=datetime update=yes updatewhereclause=yes name=soldon dbname="Product.SoldOn"  )
 retrieve="SELECT 
	ProductCode,
	Name,
	ChasisNo,
	EngineNo,
	Model=(SELECT M.Name FROM Model M WHERE M.ModelCode=Product.ModelCode),
	Purpose=(SELECT P.Name FROM ProductPurpose P WHERE P.ProductPurposeCode=Product.ProductPurposeCode),
	ProductType=(SELECT P.Name FROM ProductType P WHERE P.ProductTypeCode=Product.ProductTypeCode),
	Colour=(SELECT C.Name FROM ItemColour C WHERE C.IColourCode =Product.IColourCode),
	Supplier=(SELECT A.Name FROM Accounts A WHERE A.AccCode =Product.SuppCode),
	Customer=(SELECT A.Name FROM Accounts A WHERE A.AccCode =Product.CustCode),
	SalesMan=(SELECT S.Name FROM SalesMan S WHERE S.SalesmanCode =Product.SalesManCode),
	Finalized,
	Aquired,
	Delivered,
	Sold,
	OriginalDate,
	Date,
	FinalizedOn,
	AquiredOn,
	DeliveredOn,
	SoldOn
FROM
	DBO.Product
"
  update="DBO.Product" updatewhere=1 updatekeyinplace=no
 )
