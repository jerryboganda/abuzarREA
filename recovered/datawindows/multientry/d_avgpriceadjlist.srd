 retrieve="SELECT 
	AvgPriceAdjHeader.DocumentCode,   
	AvgPriceAdjHeader.DATE,   
	AvgPriceAdjHeader.USERCODE,   
	AvgPriceAdjHeader.REMARKS,   
	AvgPriceAdjHeader.POSTED,   
	AvgPriceAdjHeader.POSTDATE,   
	AvgPriceAdjHeader.POSTEDBY,   
	AvgPriceAdjHeader.Amount,   
	Debit=(SELECT Name From Accounts WHERE AccCode = AvgPriceAdjHeader.Dr_AccCode),   
	Credit=(SELECT Name From Accounts WHERE AccCode = AvgPriceAdjHeader.Cr_AccCode),
	AvgPriceAdjHeader.GLVOCHCODE,
	AvgPriceAdjHeader.Amount
FROM AvgPriceAdjHeader  
ORDER BY AvgPriceAdjHeader.DocumentCode"
  update="AvgPriceAdjHeader" updatewhere=1 updatekeyinplace=no
 )
