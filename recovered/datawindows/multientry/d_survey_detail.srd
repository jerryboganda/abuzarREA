footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SurveyDetail.surveycode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="SurveyDetail.icode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes name=rowid dbname="SurveyDetail.rowid"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=manfcode dbname="SurveyDetail.manfcode" 
 values=""  )
column=(type=long key=yes update=yes updatewhereclause=yes name=packcode dbname="SurveyDetail.packcode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" name=price1 dbname="SurveyDetail.price1"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" name=price2 dbname="SurveyDetail.price2"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" initial="0" name=reqprice dbname="SurveyDetail.reqprice"  )
 retrieve="Select sd.surveycode,
		 sd.icode,
		 itemcode = sd.icode,
		 aliasname = i.customicode,
		 i.name,
		 sd.rowid,
		 CurrListRow = 0,
		 sd.manfcode,
		 sd.packcode,
		 sd.price1,
		 sd.price2,
		 sd.reqprice
		 
From   surveydetail SD , Item I, Manufacturer M, ItemPacking P

Where  sd.surveycode = :al_surveycode AND
		 sd.icode = i.icode AND
	    sd.manfcode = m.manfcode AND
		 sd.packcode = p.packcode"
  update="surveydetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("al_surveycode", number))
 sort="rowid A"
)
