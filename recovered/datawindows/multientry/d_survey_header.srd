column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="SurveyHeader.remarks"  )
 retrieve="Select surveycode,
		 originaldate,
		 date,
		 createdby,
		 username = (Select username from users where usercode = surveyheader.createdby) ,
		 modifiedby,
		 pptcustcode,	
		 remarks

From   surveyheader

Where  surveycode = :al_surveycode"
  update="surveyheader" updatewhere=1 updatekeyinplace=yes
  arguments=(("al_surveycode", number))
)
