release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=728 color="536870912" )
summary(height=152 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=recipecode dbname="RecipeCode"  )
column=(type=char(12) updatewhereclause=yes name=recipealias dbname="RecipeAlias"  )
column=(type=char(100) updatewhereclause=yes name=recipename dbname="RecipeName"  )
column=(type=char(400) updatewhereclause=yes name=description dbname="Description"  )
column=(type=char(75) updatewhereclause=yes name=resulteditemalias dbname="ResultedItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=resulteditem dbname="ResultedItem"  )
column=(type=decimal(13) updatewhereclause=yes name=price dbname="Price"  )
column=(type=char(75) updatewhereclause=yes name=ingredientaliasname dbname="IngredientAliasName"  )
column=(type=char(60) updatewhereclause=yes name=ingredientname dbname="IngredientName"  )
column=(type=decimal(7) updatewhereclause=yes name=ingredientqty dbname="IngredientQty"  )
column=(type=decimal(2) updatewhereclause=yes name=ingredientprice dbname="IngredientPrice"  )
 retrieve="SELECT 
	RecipeCode = R.RecipeCode, 
	RecipeAlias = R.AliasName, 
	RecipeName = R.Name, 
	Description = R.Description, 
	ResultedItemAlias = (SELECT RI.CustomICode FROM Item RI WHERE R.ResultedItem = RI.ICode),
	ResultedItem = (SELECT RI.Name FROM Item RI WHERE R.ResultedItem = RI.ICode),
	Price = (SELECT ROUND(RI.SalePrice / CASE WHEN RI.PackUnits=0 THEN 1 ELSE RI.PackUnits END, 2)FROM Item RI WHERE R.ResultedItem = RI.ICode),
	IngredientAliasName = I.CustomICode,
	IngredientName = I.Name,
	IngredientQty = RD.Qty,
	IngredientPrice = RD.Price
FROM 
	Recipe R, RecipeDetail RD, Item I
WHERE
	R.RecipeCode = :ai_code AND
	R.RecipeCode = RD.RecipeCode AND
	RD.ICode = I.ICode
ORDER BY
	IngredientName"
  arguments=(("ai_code", number))
)
