compute(name=c_netamount visible="1	0" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-7" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="114" y="21" height="135" width="427" format="[general]" expression=" c_amount *  ( 1 -  saleledger_discperc  * .01 ) " alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_amount visible="0" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-7" font.pitch="2" font.weight="400" background.mode="1" background.color="553648127" color="0" x="2062" y="21" height="135" width="468" format="#######0.00" expression="(  looseqty *  saledetail_saleprice -  looseqty *  itemflatdisc )  *  ( 1 -  (   saledetail_discperc  * .01 )  ) " alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_salestaxval visible="1" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-7" font.pitch="2" font.weight="400" background.mode="1" background.color="553648127" color="0" x="1177" y="21" height="135" width="322" format="###0.00" expression="round( c_amount  *  itemgstperc * 0.01, 2) +  Round(looseqty * itemunitsalestax ,2)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_1 visible="1" band=trailer.1 font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="553648127" color="0" x="1979" y="11" height="135" width="718" format="###0.00" expression="sum(round( c_amount  *  itemgstperc * 0.01, 2) +  Round(looseqty * itemunitsalestax ,2) for group 1)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
column(name=itempacking visible="1" band=trailer.1 id=2 x="52" y="11" height="135" width="1843" color="0" border="0" alignment="0" format="[general]" html.valueishtml="0" edit.focusrectangle=no edit.autohscroll=no edit.autoselect=no edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Arial" font.family="2" font.height="-8" font.pitch="2" font.weight="700" tabsequence=0 )
