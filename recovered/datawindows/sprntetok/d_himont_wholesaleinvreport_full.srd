column=(type=char(50) updatewhereclause=yes name=messages dbname="messages"  )
 retrieve="   SELECT itemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END,   
         aliasname=item.customicode, 
		   item = LTRIM(RTRIM(case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END)) , 
         packingdesc= max(item.packingdesc),
    		manufacturer = Max(Manufacturer.Name), 
         accname = dbo.accounts.name,   
         address = Max(dbo.customer.address1),   
         address2= Max(dbo.customer.address2),   
         salesman = dbo.users.username,   
         saleinvcode = dbo.saleledger.saleinvcode,   
         headerno = Max(dbo.saleledger.headerno),   
         date = dbo.saleledger.date,   
         invdiscperc = dbo.saleledger.discperc,   
         misccharges = dbo.saleledger.misccharges,   
         flatdisc = dbo.saleledger.flatdisc,   
         invsalestax = dbo.saleledger.salestax,   
         unitprice = Max(item.saleprice) ,   
         purprice = Max(item.purprice) ,   
         gcode = saledetail.gcode,   
         icode = saledetail.icode,   
         batch = max(saledetail.batch),   
         expiry = max(saledetail.expiry),   
         /*looseqty = saledetail.looseqty,*/
			looseqty =(Case ( CAST(sum(saledetail.looseqty) / max(saledetail.packunits) AS INT) - (Sum(saledetail.looseqty) / max(saledetail.packunits)) ) When 0 Then (sum(saledetail.looseqty) /max(saledetail.packunits)) Else sum(saledetail.looseqty) End),
			totalqty=sum(saledetail.looseqty) + sum(saledetail.bonusqty),
			packorloose = (Case ( CAST(sum(saledetail.looseqty) / max(saledetail.packunits) AS INT) - (sum(saledetail.looseqty) / max(saledetail.packunits) )) When 0 Then '' Else 'L' End),
         bonuspackorloose = (Case ( CAST(sum(saledetail.bonusqty) / max(saledetail.packunits) AS INT) - (Sum(saledetail.bonusqty) / max(saledetail.packunits)) ) When 0 Then '' Else 'L' End),
			bonusqty = (Case ( CAST(sum(saledetail.bonusqty) / max(saledetail.packunits) AS INT) - (Sum(saledetail.bonusqty) / max(saledetail.packunits)) ) When 0 Then (sum(saledetail.bonusqty) /max(saledetail.packunits)) Else sum(saledetail.bonusqty) End),   
         packqty = sum(saledetail.packqty),   
         packunits= max(saledetail.packunits),   
         /*saleprice= saledetail.saleprice,   */
		   saleprice=(Case ( CAST(sum(saledetail.looseqty) / max(saledetail.packunits) AS INT) - (sum(saledetail.looseqty) / max(saledetail.packunits)) ) When 0 Then (max(saledetail.saleprice * saledetail.packunits)) Else max(saledetail.saleprice) End),
         discperc = max(saledetail.discperc),  
		   /*itemflatdisc=saledetail.itemflatdisc, */  
		   itemflatdisc=(Case ( CAST(sum(saledetail.looseqty) / max(saledetail.packunits) AS INT) - (sum(saledetail.looseqty) / max(saledetail.packunits)) ) When 0 Then (max(saledetail.packunits * saledetail.itemflatdisc)) Else max(saledetail.itemflatdisc) End ),
         salestax = Max(saledetail.salestax),   
         saleitemdescription = Max(saledetail.saleitemdescription),   
         Id = Max(dbo.saledetail.IDENTITYCOL) ,   
         posted= Max(saleledger.posted) ,   
         balance=0,   
         unitsalestax = Max(saledetail.unitsalestax) ,   
         gstperc = Max(saledetail.gstperc) ,   
         invgstperc = Max(saleledger.invgstperc1) ,   
         custTaxRegno= Max(customer.salestaxregno)  ,
			dbo.saleledger.custrefno,	
			dbo.saleledger.remarks,
			dbo.saleledger.printwaranty,
			dbo.saleledger.printbatch,
			reprintcount= Max(saleledger.Reprintingcounter),
			serverdate=getdate(),
			custcode=dbo.saleledger.custcode,
			salesperson=(select name from salesman where salesmancode= Max(saleledger.smancode) ),
			messages=(select description from message where messagecode= Max(saleledger.messagecode) )
    FROM saleledger,   
         saledetail,   
         accounts,   
         customer,   
         users,   
         item,
	      manufacturer

   WHERE ( dbo.saleledger.saleinvcode = :ar_SaleInvCode ) AND  
         ( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND  
         ( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  
         ( dbo.customer.custcode = dbo.accounts.acccode ) AND  
         ( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  
         ( dbo.saledetail.icode = dbo.item.icode)   AND
         ( dbo.item.manfcode = dbo.manufacturer.manfcode)   

GROUP BY saleledger.saleinvcode, 
			saleledger.date, 
			saleledger.custcode, 
			saleledger.discperc, 
			saleledger.flatdisc, 
			saleledger.misccharges, 
			saleledger.salestax, 
			saleledger.remarks,
			saleledger.printwaranty,
			saleledger.printbatch,
			saleledger.custrefno, 
			saledetail.icode,
			saledetail.batch, 
			saledetail.expiry,
			saledetail.gcode, 
			item.name,
			item.customicode,
			item.icode,
			item.printable, 
			accounts.name,
			dbo.users.username
"
  arguments=(("ar_SaleInvCode", number))
 sort="manufacturer A, item A"
)
