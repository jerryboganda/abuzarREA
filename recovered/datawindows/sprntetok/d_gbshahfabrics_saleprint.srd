detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saletype dbname="SaleType"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=decimal(5) updatewhereclause=yes name=balance dbname="balance"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleLedger.saleinvcode"  )
column=(type=long updatewhereclause=yes name=srbufferinvcode dbname="srbufferinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleLedger.date"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_discperc dbname="SaleLedger.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_misccharges dbname="SaleLedger.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_flatdisc dbname="SaleLedger.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_salestax dbname="SaleLedger.salestax"  )
column=(type=long updatewhereclause=yes name=custcode dbname="SaleLedger.custcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SaleLedger.remarks"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="SaleLedger.custrefno"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Saledetail.icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="Saledetail.gcode"  )
column=(type=long updatewhereclause=yes name=salecatcode dbname="salecatcode"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_discperc dbname="discperc"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=long updatewhereclause=yes name=reprintcounter dbname="reprintcounter"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="doctor"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="patientregno"  )
column=(type=long updatewhereclause=yes name=locationcode dbname="locationcode"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=decimal(2) updatewhereclause=yes name=cashtendered dbname="CashTendered"  )
column=(type=decimal(2) updatewhereclause=yes name=cashcharged dbname="CashCharged"  )
column=(type=decimal(2) updatewhereclause=yes name=cashback dbname="CashBack"  )
column=(type=decimal(2) updatewhereclause=yes name=cardscharged dbname="CardsCharged"  )
 retrieve=" SELECT 
	SaleType = 1,
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale' else item.name end,
	AliasName = item.customicode,
	reprintdate=getdate(),
	users.username,   
	accounts.name, 
	headerno =max(saleledger.headerno),
	posted=max(saleledger.posted),
	balance=isnull(max(balance),0),
	dbo.saleledger.saleinvcode,   
	srbufferinvcode=dbo.saleledger.srbufferinvcode,
	dbo.saleledger.date,   
	dbo.saleledger.discperc, 
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.salestax,   
	dbo.saleledger.custcode,   
	dbo.saleledger.remarks,
	dbo.saleledger.custrefno,	
	dbo.saledetail.icode,   
	dbo.saledetail.gcode,
	salecatcode=max(saleledger.salecatcode),
	Id        = MAX(dbo.saledetail.IDENTITYCOL),     
	looseqty  = sum(saledetail.looseqty), 
	packqty   = sum(saledetail.packqty), 
	packunits = max(saledetail.packunits), 
	saleprice = max(saledetail.saleprice), 
	rate      = max(saledetail.rate),
	salestax  = max(saledetail.salestax),   
	discperc  = max(saledetail.discperc), 
	customername='                                  '  ,
	itemflatdisc  = max(saledetail.itemflatdisc),
	unitsalestax  = max(saledetail.unitsalestax),
	gstperc       = max(saledetail.gstperc),
	invgstperc    = max(saleledger.invgstperc1),
	reprintcounter=max(saleledger.reprintingcounter),
	patient=max(patient.name),
	doctor=max(doctors.name),
	patientregno=max(patient.regno),
	locationcode=max(patient.locationcode),
	InvTotal = ISNULL(DBO.fn_GetSaleInvTotal(saleledger.saleinvcode), 0),
	CashTendered = max(saleledger.CashTendered),
	CashCharged = max(saleledger.CashCharged),
	CashBack = max(saleledger.CashBack),
	CardsCharged=ISNULL((SELECT SUM(CW.Amount) FROM CashierWindow CW WHERE CW.SaleInvCode = SaleLedger.SaleInvCode), 0)
FROM 
	dbo.saleledger
	LEFT OUTER JOIN DBO.Doctors ON (dbo.saleledger.doctcode = dbo.Doctors.doctcode)
	LEFT OUTER JOIN DBO.Patient ON (dbo.saleledger.Patientcode = dbo.Patient.Patientcode),
	dbo.saledetail,  
	item, 
	customer, 
	accounts,
	users 
	
WHERE 
	( dbo.saleledger.saleinvcode = :ra_InvCode ) AND
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND 
	( dbo.saleledger.custcode = dbo.customer.custcode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( dbo.saleledger.salesmancode = dbo.users.usercode ) AND
	( saledetail.icode = item.icode )  and
	( saleledger.admissioncode IS NULL)
	
GROUP BY 
	saleledger.saleinvcode, 
	dbo.saleledger.srbufferinvcode,
	saleledger.date, 
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	saleledger.salestax, 
	saleledger.remarks,
	saleledger.custrefno, 
	saledetail.icode, 
	saledetail.rowgroup,
	saledetail.gcode, 
	item.name,
	item.customicode,
	item.icode,
	item.printable, 
	accounts.name,
	dbo.users.username
UNION ALL
SELECT 
	SaleType = 2,
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale' else item.name end,
	AliasName = item.customicode,
	reprintdate=getdate(),
	users.username,  
	accounts.name, 
	headerno =max(dbo.srbufferledger.headerno),
	posted=max(dbo.srbufferledger.posted),
	balance=0,
	saleinvcode = s.saleinvcode,   
	srbufferinvcode=dbo.srbufferledger.srbufferinvcode,
	dbo.srbufferledger.date,   
	dbo.srbufferledger.discperc, 
	dbo.srbufferledger.misccharges,   
	dbo.srbufferledger.flatdisc,   
	dbo.srbufferledger.salestax,   
	dbo.srbufferledger.custcode,   
	dbo.srbufferledger.remarks,
	dbo.srbufferledger.custrefno,	
	dbo.srbufferdetail.icode,   
	dbo.srbufferdetail.gcode,
	salecatcode=max(srbufferledger.srcatcode),
	Id        = MAX(dbo.srbufferdetail.IDENTITYCOL),     
	looseqty  = sum(srbufferdetail.looseqty), 
	packqty   = 0, 
	packunits = max(srbufferdetail.packunits), 
	saleprice = max(srbufferdetail.srprice), 
	rate      = 0,
	salestax  = max(srbufferdetail.salestax),   
	discperc  = max(srbufferdetail.discperc), 
	customername='                                  '  ,
	itemflatdisc  = 0.00,
	unitsalestax  = max(srbufferdetail.unitsalestax),
	gstperc       = max(srbufferdetail.gstperc),
	invgstperc    = max(srbufferledger.invgstperc1),
	reprintcounter=NULL,
	patient=max(patient.name),
	doctor=NULL,
	patientregno=max(patient.regno),
	locationcode=max(patient.locationcode),
	InvTotal = ISNULL(DBO.fn_GetSRBufferInvTotal(srbufferledger.srbufferinvcode), 0),
	CashTendered = ISNULL((SELECT S.CashTendered FROM SaleLedger S WHERE S.SaleInvCode = :ra_InvCode), 0),
	CashCharged = ISNULL((SELECT S.CashCharged FROM SaleLedger S WHERE S.SaleInvCode = :ra_InvCode), 0),
	CashBack = ISNULL((SELECT S.CashBack  FROM SaleLedger S WHERE S.SaleInvCode = :ra_InvCode), 0),
	CardsCharged=ISNULL((SELECT SUM(CW.Amount) FROM CashierWindow CW WHERE CW.SaleInvCode = S.SaleInvCode), 0)
FROM 
	(SELECT SL.* FROM SaleLedger SL WHERE SL.SaleInvCode = :ra_InvCode AND SL.SRBufferInvCode >= 0) S,
	dbo.srbufferledger
	LEFT OUTER JOIN DBO.Patient ON (dbo.srbufferledger.Patientcode = dbo.Patient.Patientcode),
	dbo.srbufferdetail,  
	item, 
	customer, 
	accounts,
	users
	
WHERE 
	( dbo.srbufferledger.srbufferinvcode = S.srbufferinvcode ) AND
	( dbo.srbufferledger.srbufferinvcode  = dbo.srbufferdetail.srbufferinvcode ) AND 
	( dbo.srbufferledger.custcode = dbo.customer.custcode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( dbo.srbufferledger.salesmancode = dbo.users.usercode ) AND
	( srbufferdetail.icode = item.icode )  and
	( srbufferledger.admissioncode IS NULL) 
	
GROUP BY 
	srbufferledger.srbufferinvcode, 
	srbufferledger.saleinvcode, 
	s.saleinvcode, 
	srbufferledger.date, 
	srbufferledger.custcode, 
	srbufferledger.discperc, 
	srbufferledger.flatdisc, 
	srbufferledger.misccharges, 
	srbufferledger.salestax, 
	srbufferledger.remarks,
	srbufferledger.custrefno, 
	srbufferdetail.icode, 
	srbufferdetail.gcode, 
	item.name,
	item.customicode,
	item.icode,
	item.printable, 
	accounts.name,
	dbo.users.username

ORDER BY 
	SaleType, ID
"
  arguments=(("ra_InvCode", number))
)
