table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=altersaleinvcode dbname="altersaleinvcode"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long updatewhereclause=yes name=salecat dbname="salecat"  )
column=(type=char(60) updatewhereclause=yes name=saletypename dbname="saletypename"  )
column=(type=char(100) updatewhereclause=yes name=custref dbname="custref"  )
column=(type=long updatewhereclause=yes name=saleledger_custcode dbname="SaleLedger.custcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="doctor"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleLedger.saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=saleledger_date dbname="SaleLedger.date"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_discperc dbname="SaleLedger.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_misccharges dbname="SaleLedger.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=fbrposfee dbname="SaleLedger.FBRPOSFee"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_flatdisc dbname="SaleLedger.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_salestax dbname="SaleLedger.salestax"  )
column=(type=long updatewhereclause=yes name=custcode dbname="SaleLedger.custcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SaleLedger.remarks"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Saledetail.icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=decimal(2) updatewhereclause=yes name=cashreceived dbname="cashreceived"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=itemgstperc dbname="itemgstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestaxschedule_prec dbname="SalesTaxSchedule_prec"  )
column=(type=decimal(2) updatewhereclause=yes name=itemunitsalestax dbname="itemunitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_discperc dbname="discperc"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(21) updatewhereclause=yes name=machinename dbname="machinename"  )
column=(type=decimal(2) updatewhereclause=yes name=totaltaxoninv dbname="totaltaxonInv"  )
column=(type=char(100) updatewhereclause=yes name=fiscalinvoiceno dbname="fiscalinvoiceno"  )
column=(type=decimal(2) updatewhereclause=yes name=cashtendered dbname="cashtendered"  )
column=(type=decimal(2) updatewhereclause=yes name=cashcharged dbname="cashcharged"  )
column=(type=decimal(2) updatewhereclause=yes name=cardcharged dbname="CardCharged"  )
column=(type=long updatewhereclause=yes name=previousloyalty dbname="PreviousLoyalty"  )
column=(type=long updatewhereclause=yes name=pointsadded dbname="PointsAdded"  )
column=(type=long updatewhereclause=yes name=totalloyalty dbname="TotalLoyalty"  )
column=(type=long updatewhereclause=yes name=reprintcounter dbname="reprintcounter"  )
 retrieve="SELECT 
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale' else item.name end, 
	altersaleinvcode=max(saleledger.altersaleinvcode),
	users.username,  
	salecat=max(saleledger.salecatcode),
	saletypename=(select name from saletype where max(saleledger.saletypecode)=saletype.saletypecode),
	custref=max(saleledger.custrefno),
	saleledger.custcode,
	headerno = dbo.saleledger.headerno,
	customer=(select name from accounts where acccode=saleledger.custcode),
	regno=(select regno from patient where patientcode=max(saleledger.patientcode)),
	patientname=(select name from patient where patientcode=max(saleledger.patientcode)),
	doctor=(select d.name from doctors d where doctcode=max(saleledger.doctcode)),
	headerinvno=max(saleledger.headerinvno),
	dbo.saleledger.saleinvcode,   
	dbo.saleledger.date,
	dbo.saleledger.discperc,   
	dbo.saleledger.misccharges,   
	dbo.saleledger.FBRPOSFee,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.salestax,   
	dbo.saleledger.custcode,   
	dbo.saleledger.remarks,   
	dbo.saledetail.icode,   
	gcode=max(dbo.saledetail.gcode), 
	cashreceived=max(dbo.saleledger.cashreceived),
	Id        = MAX(dbo.saledetail.IDENTITYCOL),  
	looseqty  = sum(saledetail.looseqty), 
	packqty   = sum(saledetail.packqty), 
	packunits = max(saledetail.packunits), 
	saleprice = max(saledetail.saleprice), 
	rate      = max(saledetail.rate),
	salestax  = max(saledetail.salestax),   
	itemgstperc=MAX(saledetail.gstperc),
	SalesTaxSchedule_prec = (SELECT MAX(STS.taxperc) FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode = Item.SalesTaxScheduleCode),
	itemunitsalestax=saledetail.unitsalestax,
	discperc  = saledetail.discperc, 
	customername='                                  '  ,
	itemflatdisc  = max(saledetail.itemflatdisc),
	aliasname=item.customicode,
	machinename=',' +  max(saleledger.machinename),
	totaltaxonInv=dbo.fn_gettaxonsaleinv(saleledger.saleinvcode),
	fiscalinvoiceno = saleledger.fiscalinvoiceno,
	cashtendered=max(saleledger.cashtendered),
	cashcharged=max(saleledger.cashcharged),
	CardCharged=ISNULL((SELECT SUM(CW.Amount) FROM CashierWindow CW WHERE CW.SaleInvCode=:ra_InvCode),0),
	PreviousLoyalty = 
		ISNULL((SELECT PL=SUM(LC.PointsDebit - LC.PointsCredit) 
		FROM LoyaltyCardLedger LC 
		WHERE 
			LC.AccCode = dbo.saleledger.custcode AND 
			ISNULL(LC.InvoiceType,'') + STR(ISNULL(LC.InvoiceCode,0)) <> 'SV' + STR(dbo.saleledger.saleinvcode)), 0),
	PointsAdded = 
		ISNULL((SELECT PL=SUM(LC.PointsDebit - LC.PointsCredit) 
		FROM LoyaltyCardLedger LC 
		WHERE LC.AccCode = dbo.saleledger.custcode AND LC.InvoiceType = 'SV' AND LC.InvoiceCode = dbo.saleledger.saleinvcode), 0),
	TotalLoyalty = 
		ISNULL((SELECT PL=SUM(LC.PointsDebit - LC.PointsCredit) 
		FROM LoyaltyCardLedger LC 
		WHERE LC.AccCode = dbo.saleledger.custcode), 0),
		reprintcounter=max(saleledger.reprintingcounter)
FROM dbo.saleledger,   
	dbo.saledetail,  
	item,
	Users 
WHERE 
	( dbo.saleledger.saleinvcode = :ra_InvCode ) AND
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND 
	( saleLedger.SalesManCode = users.userCode ) and
	( saledetail.icode = item.icode )
GROUP BY saleledger.saleinvcode, 
			saleledger.date, 
			saleledger.custcode, 
			saleledger.discperc, 
			saleledger.flatdisc, 
			saleledger.misccharges, 
			saleledger.headerno,
			saleledger.salestax, 
			saleledger.remarks, 
			saleledger.fiscalinvoiceno,
			dbo.saleledger.FBRPOSFee, 
			saledetail.icode, 
			saledetail.saleprice,
			saledetail.itemflatdisc,
			saledetail.discperc,
			saledetail.gstperc,
			saledetail.unitsalestax,
			item.name,
			item.icode,
			item.printable,
			item.customicode,
			Item.SalesTaxScheduleCode,
			users.username
ORDER BY MAX(dbo.saledetail.IDENTITYCOL)
"
  arguments=(("ra_InvCode", number))
 sort="id A"
)
