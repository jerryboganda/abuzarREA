release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(1) updatewhereclause=yes name=selected dbname="Selected" 
 values="	Y/	0"  )
column=(type=char(75) updatewhereclause=yes name=contactcardname dbname="ContactCardName"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ContactCard.ContactCardCode"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="ContactCard.AccCode"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(50) update=yes updatewhereclause=yes name=title dbname="ContactCard.Title"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="ContactCard.Name"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=address dbname="ContactCard.Address"  )
column=(type=char(100) update=yes updatewhereclause=yes name=phone dbname="ContactCard.Phone"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fax dbname="ContactCard.Fax"  )
column=(type=char(100) update=yes updatewhereclause=yes name=email dbname="ContactCard.Email"  )
column=(type=char(255) update=yes updatewhereclause=yes name=mobile dbname="ContactCard.Mobile"  )
column=(type=char(1) update=yes updatewhereclause=yes name=useforsms dbname="ContactCard.UseForSMS" 
 values="Yes	Y/No	N/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=web dbname="ContactCard.Web"  )
 retrieve="SELECT 
	Selected='N',
	ContactCardName = ISNULL((SELECT A.Name FROM Accounts A WHERE A.AccCode=ContactCard.AccCode), '') + ' ('  + LTRIM(RTRIM(CAST(ContactCard.ContactCardCode as INT)))  + ')',
	ContactCard.ContactCardCode,   
	ContactCard.AccCode,   
	AccountName = (SELECT A.Name FROM Accounts A WHERE A.AccCode=ContactCard.AccCode),
	ContactCard.Title,   
	ContactCard.Name,   
	ContactCard.Address,   
	ContactCard.Phone,   
	ContactCard.Fax, 
	ContactCard.Email, 
	ContactCard.Mobile, 
	ContactCard.UseForSMS,   
	ContactCard.Web
FROM 
	ContactCard   
WHERE 
	ContactCard.UseForSMS = 'Y'
ORDER BY
	ContactCardName"
  update="ContactCard" updatewhere=1 updatekeyinplace=no
 )
