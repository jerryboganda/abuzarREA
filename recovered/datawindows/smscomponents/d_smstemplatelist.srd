 values=""  )
column=(type=char(4000) update=yes updatewhereclause=yes name=smstemplate dbname="SMS_Template.SMSTemplate"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="SMS_Template.Active" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=enabled dbname="SMS_Template.Enabled"  )
 retrieve="SELECT 
	SMSTemplateCode,   
	Name,   
	SMSTypeCode,   
	SMSDataCode,   
	SMSTemplate,
	Active,
	Enabled
FROM 
	SMS_Template  
WHERE 
	Enabled = 'Y'
		
"
  update="SMS_Template" updatewhere=1 updatekeyinplace=no
 )
