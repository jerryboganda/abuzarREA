table(column=(type=long key=yes identity=yes update=yes updatewhereclause=yes name=smscode dbname="SMS_Center.SMSCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="SMS_Center.Date"  )
column=(type=char(255) update=yes updatewhereclause=yes name=smsto dbname="SMS_Center.SMSTO"  )
column=(type=char(4000) update=yes updatewhereclause=yes name=smstext dbname="SMS_Center.SMSText"  )
column=(type=long update=yes updatewhereclause=yes name=smstypecode dbname="SMS_Center.SMSTypeCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=smsstatuscode dbname="SMS_Center.SMSStatusCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=smstemplatecode dbname="SMS_Center.SMSTemplateCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=sentdate dbname="SMS_Center.SentDate"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="SMS_Center.Expiry"  )
column=(type=datetime updatewhereclause=yes name=today dbname="Today"  )
 retrieve="SELECT 
	SMS_Center.SMSCode,   
	SMS_Center.Date,   
	SMS_Center.SMSTO,   
	SMS_Center.SMSText,   
	SMS_Center.SMSTypeCode,   
	SMS_Center.SMSStatusCode,   
	SMS_Center.SMSTemplateCode,   
	SMS_Center.SentDate,
	SMS_Center.Expiry,
	Today = GETDATE()
FROM 
	SMS_Center 
WHERE 
	SMSStatusCode = :ai_code
ORDER BY 
	Date
"
  update="SMS_Center" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
