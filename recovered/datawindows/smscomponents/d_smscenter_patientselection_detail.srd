table(column=(type=char(1) updatewhereclause=yes name=selected dbname="Selected" 
 values="	Y/	N"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=datetime updatewhereclause=yes name=registrationdate dbname="RegistrationDate"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=char(60) updatewhereclause=yes name=location dbname="Location"  )
column=(type=char(60) updatewhereclause=yes name=disease dbname="Disease"  )
column=(type=char(100) updatewhereclause=yes name=diagnosis dbname="Diagnosis"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender"  )
column=(type=char(25) updatewhereclause=yes name=nic dbname="NIC"  )
column=(type=char(100) updatewhereclause=yes name=ward dbname="Ward"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mobile dbname="Mobile"  )
 retrieve="SELECT 
	Selected='Y',
	PatientCode = P.PatientCode, 
	RegistrationDate = P.Date,
	Category = PC.Name,
	PatientRegNo = P.RegNo,
	PatientName = P.Name,
	Customer = ISNULL((SELECT A.Name FROM Accounts A WHERE A.AccCode=P.CustCode),''),
	Doctor = ISNULL((SELECT D.Name FROM Doctors D WHERE D.DoctCode=P.DoctCode),''),
	Location = ISNULL((SELECT L.Name FROM PatientLocation L WHERE L.LocationCode=P.LocationCode),''),
	Disease = ISNULL((SELECT D.Name FROM Disease D WHERE D.DiseaseCode=P.DiseaseCode),''),
	Diagnosis = ISNULL(P.Diagnosis, ''),
	Gender = ISNULL(P.Gender, ''),
	NIC = ISNULL(P.NationalIDCard, ''),
	Ward = ISNULL(P.Ward, ''),
	Mobile = ISNULL(P.MobileNo1, '')
FROM
	Patient P, PatientCategory PC
WHERE 
	P.PatientCatCode = PC.PatientCatCode AND
	PC.PatientCatCode IN (:ai_patientcatcode) AND
	LEN(P.MobileNo1) > 5
ORDER BY
	Category,
	PatientName
"
  arguments=(("ai_patientcatcode", numberlist))
)
