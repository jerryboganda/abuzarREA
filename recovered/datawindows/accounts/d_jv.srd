datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=625 color="536870912" )
summary(height=93 color="536870912" )
footer(height=1 color="536870912" )
detail(height=65 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=long updatewhereclause=yes name=gldetail_glvochcode dbname="GLDetail.GLVochCode"  )
column=(type=decimal(2) updatewhereclause=yes name=gldetail_debit dbname="GLDetail.Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=gldetail_credit dbname="GLDetail.Credit"  )
column=(type=datetime updatewhereclause=yes name=glheader_date dbname="Glheader.Date"  )
 retrieve="  SELECT Accounts.Name,   
         GLDetail.GLVochCode,   
         GLDetail.Debit,   
         GLDetail.Credit,
			GlHeader.Date
	 FROM Accounts,   
         GLDetail,
			GlHeader  
   WHERE ( GLDetail.AccCode = Accounts.AccCode ) and
			( dbo.glheader.acccode <> dbo.gldetail.acccode ) and
			( GlDetail.GLVochCode = :vno )  
"
  arguments=(("vno", number))
 sort="accounts_name A"
)
