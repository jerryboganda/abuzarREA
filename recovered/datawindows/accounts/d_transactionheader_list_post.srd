table(column=(type=char(60) updatewhereclause=yes name=transactioncategory dbname="TransactionCategory"  )
column=(type=char(60) updatewhereclause=yes name=transactiontype dbname="TransactionType"  )
column=(type=char(2) updatewhereclause=yes name=shortname dbname="ShortName"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=long updatewhereclause=yes name=tansactiontypecode dbname="TansactionTypeCode"  )
column=(type=long updatewhereclause=yes name=transactioncode dbname="TransactionCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=decimal(2) updatewhereclause=yes name=cashcharged dbname="CashCharged"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
 retrieve="SELECT 
	TransactionCategory=TC.Name,
	TransactionType=TT.Name,
	ShortName=TT.ShortName,
	DocumentCode=TH.DocumentCode,
	TansactionTypeCode=TH.TransactionTypeCode,
	TransactionCode=TH.TransactionCode,
	Date=TH.Date,
	UserCode=TH.UserCode,
	Remarks=TH.Remarks,
	PatientCode=TH.PatientCode,
	PatientName=(SELECT P.Name FROM Patient P WHERE TH.PatientCode=P.PatientCode),
	AdmissionCode=TH.AdmissionCode,
	AccCode=TH.AccCode,
	AccountName=(SELECT A.Name FROM Accounts A WHERE TH.AccCode=A.AccCode),
	CashCharged=TH.CashCharged,
	Posted=TH.Posted
FROM 
	TransactionCategory TC,
	TransactionType TT,
	TransactionHeader TH
WHERE 
	TH.Posted = 'N' AND
	TH.TransactionTypeCode = TT.TransactionTypeCode and
	TT.TransactionCatCode = TC.TransactionCatCode AND
	TT.TransactionCatCode = :ai_transactioncatcode
ORDER BY
	TH.DocumentCode DESC"
  arguments=(("ai_transactioncatcode", number))
)
