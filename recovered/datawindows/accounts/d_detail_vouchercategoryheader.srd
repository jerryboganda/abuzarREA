footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="VocherCategoryHeader.VochCatCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=subacccode dbname="VocherCategoryHeader.SubAccCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=mainaccount dbname="MainAccount"  )
column=(type=long updatewhereclause=yes name=selected dbname="Selected" 
 values="Yes	1/	0/"  )
 retrieve="SELECT
	VocherCategoryHeader.VochCatCode,   
	VocherCategoryHeader.SubAccCode,
	Name=SubAccounts.Name,
	Category=CategoryAccounts.Name,
	MainAccount=MainAccounts.Name,
	Selected=1
FROM
	VocherCategoryHeader, SubAccounts, CategoryAccounts, MainAccounts
WHERE
	VocherCategoryHeader.VochCatCode = :ai_vochcatcode AND
	SubAccounts.SubAccCode = VocherCategoryHeader.SubAccCode AND
	SubAccounts.CatAccCode = CategoryAccounts.CatAccCode AND
	CategoryAccounts.MainAccCode = MainAccounts.MainAccCode
UNION ALL
SELECT
	VochCatCode=:ai_vochcatcode,   
	SubAccounts.SubAccCode,
	Name=SubAccounts.Name,
	Category=CategoryAccounts.Name,
	MainAccount=MainAccounts.Name,
	Selected=0
FROM
	SubAccounts, CategoryAccounts, MainAccounts
WHERE
	SubAccounts.SubAcccode NOT IN 
		(SELECT VocherCategoryHeader.SubAccCode 
		FROM VocherCategoryHeader  
		WHERE VocherCategoryHeader.VochCatCode = :ai_vochcatcode) AND
	SubAccounts.CatAccCode = CategoryAccounts.CatAccCode AND
	CategoryAccounts.MainAccCode = MainAccounts.MainAccCode
ORDER BY 
	Name,
	VochCatCode"
  update="VocherCategoryHeader" updatewhere=0 updatekeyinplace=no
  arguments=(("ai_vochcatcode", number))
)
