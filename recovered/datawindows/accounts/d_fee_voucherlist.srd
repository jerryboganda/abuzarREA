detail(height=88 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=code dbname="Glheader.glvochcode"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="Glheader.vouchercode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Glheader.date"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="Accounts.name"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Glheader.posted"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="Glheader.postdate"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(30) updatewhereclause=yes name=vouchercategory dbname="VoucherCategory"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
 retrieve="SELECT
	dbo.glheader.glvochcode ,
	dbo.glheader.vouchercode ,
	dbo.glheader.date ,
	dbo.accounts.name ,
	dbo.glheader.posted,
	dbo.glheader.postdate,
	UserName = IsNull((Select username from users
								where dbo.glheader.salesmancode = users.usercode), ''),
	VoucherCategory = (SELECT Name FROM VocherCategory 
								WHERE VocherCategory.VochCatCode = :ai_VochCatCode),
	PostedBy = IsNull((Select username from users
								where dbo.glheader.postedby = users.usercode), ''),
	ModifiedBy = IsNull((Select username from users
									where dbo.glheader.modifiedby = users.usercode), ''),
	Remarks=glheader.remarks
FROM
	dbo.glheader,
	dbo.accounts     
WHERE 
	dbo.glheader.acccode = dbo.accounts.acccode AND
	dbo.glheader.vochcatcode = :ai_vochcatcode AND
	dbo.glheader.posted IN (:as_posted) AND
	dbo.glheader.salesmancode = 
		CASE (SELECT 'Y' FROM GroupRights WHERE GroupCode = :gl_groupcode AND RightCode = 606) 
		WHEN 'Y' THEN dbo.glheader.salesmancode ELSE :gl_usercode END
"
  arguments=(("ai_vochcatcode", number), ("as_posted", stringlist), ("gl_groupcode", number), ("gl_usercode", number))
)
