release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80269524 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(121) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(60) updatewhereclause=yes name=groupaccount dbname="GroupAccount"  )
column=(type=char(115) updatewhereclause=yes name=summaryaccount dbname="SummaryAccount"  )
column=(type=long updatewhereclause=yes name=alertcode dbname="Accounts.AlertCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=alerttypecode dbname="AlertTypeCode"  )
 retrieve="SELECT 
	AccCode=A.AccCode, 
	AccountName=A.Name,
	AliasName=A.AliasName,
	Address = 
		CASE A.SubCode 
			WHEN 3 THEN (SELECT ISNULL(C.Address1,'') + ' ' + ISNULL(C.Address2, '') FROM Customer C WHERE C.CustCode = A.AccCode)
			WHEN 7 THEN (SELECT ISNULL(S.Address1,'') + ' ' + ISNULL(S.Address2, '') FROM Supplier S WHERE S.SuppCode = A.AccCode)
			ELSE '' 
		END,
	City = 
		CASE A.SubCode 
			WHEN 3 THEN (SELECT C.City FROM Customer C WHERE C.CustCode = A.AccCode)
			WHEN 7 THEN (SELECT S.City FROM Supplier S WHERE S.SuppCode = A.AccCode)
			ELSE '' 
		END,
	GroupAccount = S.Name,
	SummaryAccount = 
		CASE 
		WHEN (SELECT Count(SD.AccCode) 
				FROM SummaryAccountDetail SD 
				WHERE SD.AccCode = A.AccCode) = 0 THEN NULL 
		ELSE
			(SELECT MAX(SA.Name) + ' (' + MAX(SA.AliasName) + ')' 
			FROM SummaryAccount SA, SummaryAccountDetail SD 
			WHERE SD.AccCode = A.AccCode AND 
				SD.SummaryAccCode = SA.SummaryAccCode)
		END,
	A.AlertCode,
	AlertTypeCode=(SELECT Alert.AlertTypeCode FROM Alert WHERE Alert.AlertCode = A.AlertCode)
FROM
	Accounts A, SubAccounts S
WHERE
	A.SubCode = S.SubAccCode AND A.Active = 'Y' AND Restricted='N'
UNION 
SELECT 
	AccCode=NULL, 
	AccountName='  <NONE>',
	AliasName='<NONE>',
	Address = '',
	City = '',
	GroupAccount = '<NONE>',
	SummaryAccount = '<NONE>',
	AlertCode=1,
	AlertTypeCode=1
ORDER BY
	A.Name,
	A.AliasName,
	S.Name"
 )
