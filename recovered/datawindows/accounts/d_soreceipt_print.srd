table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SOReceipt.SOReceiptCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="SOReceipt.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="SOReceipt.UserCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="SOReceipt.Posted" 
 values="Yes	Y/No	N/"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="SOReceipt.PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="SOReceipt.PostedBy" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=serviceocode dbname="SOReceipt.ServiceOCode"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="SOReceipt.AccCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="SOReceipt.PatientCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=soamt dbname="SOReceipt.SOAmt"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="C" name=receiptmode dbname="SOReceipt.ReceiptMode" 
 values="Cash	C/Bank	B/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please emter valid/positive amount'" initial="0" name=receiptamt dbname="SOReceipt.ReceiptAmt"  )
column=(type=long update=yes updatewhereclause=yes name=receiptacccode dbname="SOReceipt.ReceiptAccCode" 
 values=""  )
column=(type=char(20) update=yes updatewhereclause=yes name=receiptrefno dbname="SOReceipt.ReceiptRefNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=receiptremarks dbname="SOReceipt.ReceiptRemarks"  )
column=(type=long update=yes updatewhereclause=yes initial="28" name=whtaxacccode dbname="SOReceipt.WHTaxAccCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please emter valid withholding tax base amount'" initial="0" name=whtaxbaseamt dbname="SOReceipt.WHTaxBaseAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 and real(gettext()) <= 100" validationmsg="'Please emter valid withholding percentage amount'" initial="0" name=whtaxperc dbname="SOReceipt.WHTaxPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please emter valid withholding tax amount'" initial="0" name=whtaxamt dbname="SOReceipt.WHTaxAmt"  )
column=(type=char(20) update=yes updatewhereclause=yes name=whtaxrefno dbname="SOReceipt.WHTaxRefNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=whtaxremarks dbname="SOReceipt.WHTaxRemarks"  )
column=(type=long update=yes updatewhereclause=yes name=glvochcode dbname="SOReceipt.GLVochCode"  )
 retrieve="SELECT 
	SOReceiptCode,
	Date,
	UserCode,
	Posted,
	PostDate,
	PostedBy,
	ServiceOCode,
	AccCode,
	PatientCode,
	SOAmt,
	ReceiptMode,
	ReceiptAmt,
	ReceiptAccCode,
	ReceiptRefNo,
	ReceiptRemarks,
	WHTaxAccCode,
	WHTaxBaseAmt,
	WHTaxPerc,
	WHTaxAmt,
	WHTaxRefNo,
	WHTaxRemarks,
	GLVochCode
FROM
	DBO.SOReceipt 
WHERE
	SOReceiptCode = :ai_code"
  update="DBO.SOReceipt" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
