header(height=136 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=vochcatcode dbname="VocherCategory.VochCatCode"  )
column=(type=char(30) update=yes updatewhereclause=yes name=name dbname="VocherCategory.Name"  )
column=(type=char(20) updatewhereclause=yes name=shortname dbname="VocherCategory.ShortName"  )
column=(type=char(3) updatewhereclause=yes name=userdefined dbname="UserDefined"  )
column=(type=char(3) updatewhereclause=yes name=jv dbname="JV"  )
column=(type=char(3) updatewhereclause=yes name=invoicebased dbname="InvoiceBased"  )
column=(type=char(8) updatewhereclause=yes name=invoicetype dbname="InvoiceType"  )
 retrieve="SELECT
	VocherCategory.VochCatCode,   
	VocherCategory.Name,
	VocherCategory.ShortName,
	UserDefined=Case VocherCategory.SystemType WHEN 0 THEN 'Yes' WHEN 1 THEN 'No' ELSE '' END,
	JV=Case VocherCategory.JournalVoucher WHEN 0 THEN 'No' WHEN 1 THEN 'Yes' ELSE '' END,
	InvoiceBased=Case VocherCategory.InvoiceBased WHEN 0 THEN 'No' WHEN 1 THEN 'Yes' ELSE '' END,
	InvoiceType=Case VocherCategory.InvoiceType WHEN 1 THEN 'Sales' WHEN 2 THEN 'Purchase' ELSE '' END
FROM 
	VocherCategory  
WHERE 
	POSTED='Y' AND VochCatCode IN 
		(SELECT VochCatCode FROM GroupVoucherCategory 
		WHERE GroupCode = :ai_GroupCode)
ORDER BY 
	VocherCategory.Name
"
  update="VocherCategory" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_GroupCode", number))
)
