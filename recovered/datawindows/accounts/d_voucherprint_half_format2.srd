table(column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=long updatewhereclause=yes name=glheader_vochcatcode dbname="Glheader.vochcatcode"  )
column=(type=decimal(2) updatewhereclause=yes name=gldetail_debit dbname="GLDetail.Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=gldetail_credit dbname="GLDetail.Credit"  )
column=(type=char(20) updatewhereclause=yes name=gldetail_chkno dbname="GLDetail.ChkNo"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="GLDetail.Remarks"  )
column=(type=char(1) updatewhereclause=yes name=glheader_posted dbname="Glheader.Posted"  )
column=(type=datetime updatewhereclause=yes name=glheader_date dbname="Glheader.Date"  )
column=(type=char(100) updatewhereclause=yes name=glheader_remarks dbname="Glheader.Remarks"  )
column=(type=char(30) updatewhereclause=yes name=vochercategory_name dbname="VocherCategory.Name"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.UserName"  )
column=(type=long updatewhereclause=yes name=glheader_glvochcode dbname="Glheader.GLVochCode"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="Glheader.VoucherCode"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="GLDetail.Balance"  )
column=(type=char(1) updatewhereclause=yes name=creditordebit dbname="CreditorDebit"  )
column=(type=long identity=yes updatewhereclause=yes name=gldetail_glrowid dbname="GLDetail.glrowid"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=long updatewhereclause=yes name=invoicebased dbname="InvoiceBased"  )
 retrieve="  SELECT Accounts.Name,
			Accounts.AliasName,
			Glheader.vochcatcode,   
         GLDetail.Debit,   
         GLDetail.Credit,   
         GLDetail.ChkNo,   
         GLDetail.Remarks,   
			Glheader.Posted,
         Glheader.Date,   
         Glheader.Remarks,   
         VocherCategory.Name,   
         Users.UserName,   
         Glheader.GLVochCode,
			Glheader.VoucherCode,
			GlDetail.Balance,
			CreditorDebit = Case GLDetail.Debit When 0 Then 'C' Else 'D' End,
			gldetail.glrowid,
			InvoiceCode=GLDetail.InvoiceCode,
			InvoiceBased=VocherCategory.InvoiceBased
    FROM GLDetail,   
         Glheader,   
         Accounts,   
         VocherCategory,   
         Users  
   WHERE ( Glheader.GLVochCode = GLDetail.GLVochCode ) and  
         ( Accounts.AccCode = GLDetail.AccCode ) and  
         ( VocherCategory.VochCatCode = Glheader.VochCatCode ) and  
         ( Users.UserCode = Glheader.salesmancode ) and  
         ( Glheader.GLVochCode = :ar_code )   

"
  arguments=(("ar_code", number))
)
