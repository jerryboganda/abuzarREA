detail(height=860 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="TransactionType.TransactionTypeCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="TransactionType.Name"  )
column=(type=char(2) update=yes updatewhereclause=yes name=shortname dbname="TransactionType.ShortName"  )
column=(type=long update=yes updatewhereclause=yes name=transactioncatcode dbname="TransactionType.TransactionCatCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=counter dbname="TransactionType.Counter"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=posted dbname="TransactionType.Posted" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=autopost dbname="TransactionType.AutoPost" 
 values="Yes	Y/No	N/"  )
 retrieve="  SELECT TransactionType.TransactionTypeCode,   
         TransactionType.Name,   
         TransactionType.ShortName,   
         TransactionType.TransactionCatCode,   
         TransactionType.Counter,   
         TransactionType.Posted,   
         TransactionType.AutoPost  
    FROM TransactionType  
   WHERE TransactionType.TransactionTypeCode = :ai_code   
            
"
  update="TransactionType" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
