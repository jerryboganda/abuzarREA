 retrieve="SELECT 
	SOReceiptCode,
	Date,
	UserCode,
	Posted,
	PostDate,
	PostedBy,
	ServiceOCode,
	AccCode,
	PatientCode,
	SOAmt,
	ReceiptMode,
	ReceiptAmt,
	ReceiptAccCode,
	ReceiptRefNo,
	ReceiptRemarks,
	WHTaxAccCode,
	WHTaxBaseAmt,
	WHTaxPerc,
	WHTaxAmt,
	WHTaxRefNo,
	WHTaxRemarks,
	GLVochCode,
	Deduction1,
	Deduction1_AccCode,
	Deduction1_Ref,
	Deduction1_Remarks,
	Deduction2,
	Deduction2_AccCode,
	Deduction2_Ref,
	Deduction2_Remarks,
	Deduction3,
	Deduction3_AccCode,
	Deduction3_Ref,
	Deduction3_Remarks,
	Deduction4,
	Deduction4_AccCode,
	Deduction4_Ref,
	Deduction4_Remarks,
	Deduction5,
	Deduction5_AccCode,
	Deduction5_Ref,
	Deduction5_Remarks
FROM
	DBO.SOReceipt 
WHERE
	SOReceiptCode = :ai_code"
  update="DBO.SOReceipt" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
