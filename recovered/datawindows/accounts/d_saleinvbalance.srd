release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=decimal(6) updatewhereclause=yes name=sale dbname="sale"  )
column=(type=decimal(6) updatewhereclause=yes name=sret dbname="sret"  )
column=(type=decimal(2) updatewhereclause=yes name=voch dbname="voch"  )
 retrieve="select sale = isnull((select IsNull(Round(sum(( (sd.looseqty + sd.packqty * sd.packunits) *
	(sd.saleprice - sd.itemflatdisc)) * (1 - (.01 * sd.discperc))) * 
	(1- (.01 * sl.discperc)) + sl.misccharges + sl.salestax -
	sl.flatdisc, 0), 0)

     from saleledger sl, saledetail sd

     where sl.saleinvcode = :ar_invcode and sl.Posted = 'Y' and
	   sl.saleinvcode = sd.saleinvcode

     group by sl.saleinvcode, sl.discperc, sl.flatdisc, sl.misccharges, sl.salestax), 0),

     sret = isnull((select IsNull(Round(sum(((sd.looseqty + sd.packqty * sd.packunits) * 
	sd.srprice) * (1 - (.01 * sd.discperc))) * 
	(1- (.01 * sl.discperc)) + sl.misccharges + sl.salestax -
	sl.flatdisc, 0), 0)

     from     srledger sl, srdetail sd

     where    sl.saleinvcode = :ar_invcode and sl.posted = 'Y' and
  	      sl.srinvcode = sd.srinvcode 

     group by sl.srinvcode,
	      sl.saleinvcode,
	      sl.discperc,
	      sl.misccharges,
	      sl.salestax,
	      sl.flatdisc), 0),

     voch = isnull((select sum(gl.credit - gl.debit)

     from   invledger il, invdetail gl

     where  gl.invcode = :ar_invcode  and
		  	   il.invvochcode = gl.invvochcode and 
	   		il.invvochcatcode in (12,13,14)), 0)


"
  arguments=(("ar_invcode", number))
)
