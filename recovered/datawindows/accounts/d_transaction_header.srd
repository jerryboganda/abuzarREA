table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="TransactionHeader.DocumentCode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=transactiontypecode dbname="TransactionHeader.TransactionTypeCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=transactioncode dbname="TransactionHeader.TransactionCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="TransactionHeader.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="TransactionHeader.UserCode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="TransactionHeader.Remarks"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="TransactionHeader.PatientCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=admissioncode dbname="TransactionHeader.AdmissionCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=patientbalance dbname="TransactionHeader.PatientBalance"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="TransactionHeader.AccCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=accbalance dbname="TransactionHeader.AccBalance"  )
column=(type=long update=yes updatewhereclause=yes initial="2" name=cashacccode dbname="TransactionHeader.CashAccCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=cashtendered dbname="TransactionHeader.CashTendered"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=cashcharged dbname="TransactionHeader.CashCharged"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=cashback dbname="TransactionHeader.CashBack"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="TransactionHeader.Posted"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="TransactionHeader.PostedBy"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=postdate dbname="TransactionHeader.PostDate"  )
 retrieve="SELECT 
	TransactionHeader.DocumentCode,
	TransactionHeader.TransactionTypeCode,
	TransactionHeader.TransactionCode,
	TransactionHeader.Date,
	TransactionHeader.UserCode,
	TransactionHeader.Remarks,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = TransactionHeader.PatientCode),
	TransactionHeader.PatientCode,
	TransactionHeader.AdmissionCode,
	TransactionHeader.PatientBalance,
	AliasName = (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = TransactionHeader.AccCode),
	TransactionHeader.AccCode,
	TransactionHeader.AccBalance,
	TransactionHeader.CashAccCode,
	TransactionHeader.CashTendered,
	TransactionHeader.CashCharged,
	TransactionHeader.CashBack,
	TransactionHeader.Posted,
	TransactionHeader.PostedBy,
	TransactionHeader.PostDate
FROM 
	TransactionHeader
WHERE
	TransactionHeader.DocumentCode = :ai_code
"
  update="TransactionHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
