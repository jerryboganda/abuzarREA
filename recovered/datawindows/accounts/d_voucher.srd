datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1833 color="536870912" )
summary(height=0 color="536870912" )
footer(height=166 color="536870912" )
detail(height=166 color="536870912" )
table(column=(type=char(30) updatewhereclause=yes name=vochercategory_name dbname="VocherCategory.Name"  )
column=(type=long updatewhereclause=yes name=gldetail_glvochcode dbname="GLDetail.GLVochCode"  )
column=(type=datetime updatewhereclause=yes name=glheader_date dbname="Glheader.Date"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=char(20) updatewhereclause=yes name=gldetail_chkno dbname="GLDetail.ChkNo"  )
column=(type=decimal(2) updatewhereclause=yes name=camount dbname="amount"  )
 retrieve="  SELECT VocherCategory.Name,   
         GLDetail.GLVochCode,   
         Glheader.Date,   
         Accounts_a.Name,   
         Accounts_b.Name,   
         GLDetail.ChkNo,   
         amount = GLDetail.Credit + GLDetail.Debit    
    FROM GLDetail,   
         Glheader,   
         VocherCategory,   
         Accounts Accounts_a,   
         Accounts Accounts_b  
   WHERE ( Glheader.GLVochCode = GLDetail.GLVochCode ) and  
         ( VocherCategory.VochCatCode = Glheader.VochCatCode ) and  
         ( Glheader.AccCode = Accounts_a.AccCode ) and  
         ( GLDetail.AccCode = Accounts_b.AccCode ) and  
         ( dbo.glheader.acccode <> dbo.gldetail.acccode ) AND  
         ( Glheader.GLVochCode = :vno)    
"
  arguments=(("vno", number))
 sort="accounts_name A"
)
