release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="InstallmentReceipt.ReceiptCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="InstallmentReceipt.DATE"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="InstallmentReceipt.UserCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=saleinvcode dbname="InstallmentReceipt.SaleInvCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=netamt dbname="InstallmentReceipt.NetAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=outstandingamt dbname="InstallmentReceipt.OutstandingAmt"  )
column=(type=long update=yes updatewhereclause=yes name=custcode dbname="CustCode" 
 values=""  )
column=(type=char(60) update=yes updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=amtreceived dbname="AmtReceived"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=fine dbname="Fine"  )
column=(type=long update=yes updatewhereclause=yes name=glvochcode dbname="InstallmentReceipt.GLVochCode"  )
column=(type=long update=yes updatewhereclause=yes name=glvochcodedisount dbname="InstallmentReceipt.GLVochCodeDisount"  )
column=(type=long update=yes updatewhereclause=yes name=glvochcodefine dbname="InstallmentReceipt.GLVochCodeFine"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="InstallmentReceipt.Remarks"  )
 retrieve="SELECT 
	ReceiptCode,
	DATE,
	UserCode,
	SaleInvCode,
	NetAmt,
	OutstandingAmt,
	CustCode = (SELECT MIN(H.CustCode) FROM InstallmentHeader H WHERE H.SaleInvCode = InstallmentReceipt.SaleInvCode),
	ItemName = (SELECT I.Name FROM InstallmentHeader H, Item I WHERE H.SaleInvCode = InstallmentReceipt.SaleInvCode AND H.ICode=I.ICode),
	AmtReceived = (SELECT SUM(D.AmtReceived) FROM InstallmentReceiptDetail D WHERE D.ReceiptCode = InstallmentReceipt.ReceiptCode),
	Discount = (SELECT SUM(D.Discount) FROM InstallmentReceiptDetail D WHERE D.ReceiptCode = InstallmentReceipt.ReceiptCode),
	Fine = (SELECT SUM(D.Fine) FROM InstallmentReceiptDetail D WHERE D.ReceiptCode = InstallmentReceipt.ReceiptCode),
	GLVochCode,
	GLVochCodeDisount,
	GLVochCodeFine,
	Remarks
FROM 
	InstallmentReceipt
"
  update="InstallmentReceipt" updatewhere=1 updatekeyinplace=no
 )
