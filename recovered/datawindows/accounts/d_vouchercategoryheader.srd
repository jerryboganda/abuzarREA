table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="VocherCategory.VochCatCode"  )
column=(type=char(30) update=yes updatewhereclause=yes name=name dbname="VocherCategory.Name"  )
column=(type=char(20) update=yes updatewhereclause=yes name=shortname dbname="VocherCategory.ShortName"  )
column=(type=long updatewhereclause=yes initial="0" name=counter dbname="VocherCategory.Counter"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="VocherCategory.Posted" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=systemtype dbname="VocherCategory.SystemType" 
 values="System	1/User	0/"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=journalvoucher dbname="VocherCategory.JournalVoucher" 
 values="Yes	1/No	0/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=headertreatment dbname="VocherCategory.HeaderTreatment" 
 values="Debit	D/Credit	C/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=detailtreatment dbname="VocherCategory.DetailTreatment" 
 values="Debit	D/Credit	C/"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=invoicebased dbname="VocherCategory.InvoiceBased" 
 values="Yes	1/No	0/"  )
column=(type=long update=yes updatewhereclause=yes name=invoicetype dbname="VocherCategory.InvoiceType" 
 values="Sale	1/Purchase	2/Sale of Service	3/Purchase of Service	4/"  )
column=(type=long update=yes updatewhereclause=yes name=voucherorder dbname="VocherCategory.VoucherOrder" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=autoposting dbname="VocherCategory.AutoPosting" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=useforsms dbname="VocherCategory.UseForSMS" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	VocherCategory.VochCatCode,   
	VocherCategory.Name,   
	VocherCategory.ShortName,   
	VocherCategory.Counter,   
	VocherCategory.Posted,   
	VocherCategory.SystemType,   
	VocherCategory.JournalVoucher,   
	VocherCategory.HeaderTreatment,   
	VocherCategory.DetailTreatment,   
	VocherCategory.InvoiceBased,   
	VocherCategory.InvoiceType,
	VocherCategory.VoucherOrder,
	VocherCategory.AutoPosting,
	VocherCategory.UseForSMS
FROM 
	VocherCategory  
WHERE 
	VocherCategory.VochCatCode = :ai_vochcatcode    
"
  update="VocherCategory" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_vochcatcode", number))
)
