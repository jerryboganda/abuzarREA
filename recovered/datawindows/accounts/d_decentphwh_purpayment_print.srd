header(height=2004 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PurPayment.PurPaymentCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="PurPayment.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="PurPayment.UserCode"  )
column=(type=long update=yes updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=netamt dbname="PurPayment.NetAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=outstandingamt dbname="PurPayment.OutstandingAmt"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="PurPayment.AccCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="PurPayment.Posted"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="PurPayment.PostedBy"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="PurPayment.PostDate"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="C" name=paymentmode dbname="PurPayment.PaymentMode" 
 values="Cash	C/Bank	B/"  )
column=(type=long update=yes updatewhereclause=yes name=paymentacccode dbname="PurPayment.PaymentAccCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please emter valid/positive payment amount'" initial="0" name=paymentamt dbname="PurPayment.PaymentAmt"  )
column=(type=char(20) update=yes updatewhereclause=yes name=paymentcheckno dbname="PurPayment.PaymentCheckNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=paymentremarks dbname="PurPayment.PaymentRemarks"  )
column=(type=long update=yes updatewhereclause=yes initial="28" name=whtaxacccode dbname="PurPayment.WHTaxAccCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 and real(gettext()) <= 100" validationmsg="'Please emter valid withholding percentage amount'" initial="0" name=whtaxperc dbname="PurPayment.WHTaxPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please emter valid withholding tax base amount'" initial="0" name=whtaxbaseamt dbname="PurPayment.WHTaxBaseAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please emter valid withholding tax amount'" initial="0" name=whtaxamt dbname="PurPayment.WHTaxAmt"  )
column=(type=char(20) update=yes updatewhereclause=yes name=whtaxcheckno dbname="PurPayment.WHTaxCheckNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=whtaxremarks dbname="PurPayment.WHTaxRemarks"  )
column=(type=long update=yes updatewhereclause=yes name=glvochcode dbname="PurPayment.GLVochCode"  )
 retrieve="SELECT 
	PurPaymentCode,
	Date,
	UserCode,
	PurInvCode=PurInvCode,
	NetAmt,
	OutstandingAmt,
	AliasName = (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = PurPayment.AccCode),
	NTN = (SELECT S.NTNNo FROM Supplier S WHERE S.SuppCode=PurPayment.AccCode),
	AccCode ,
	Posted,
	PostedBy,
	PostDate,
	
	PaymentMode,
	PaymentAccCode,
	PaymentAmt,
	PaymentCheckNo,
	PaymentRemarks,
	
	WHTaxAccCode,
	WHTaxPerc,
	WHTaxBaseAmt,
	WHTaxAmt,
	WHTaxCheckNo,
	WHTaxRemarks,

	GLVochCode
FROM 
	PurPayment
WHERE 
	PurPaymentCode = :ai_code
"
  update="PurPayment" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
