column=(type=long updatewhereclause=yes name=glvochcode dbname="IncentiveSheet.glvochcode"  )
 retrieve="Select 
	IncentiveDocCode,
	date,
	usercode,
	dracccode,
	cracccode,
	remarks,
	posted,
	postdate,
	postedby,
	startdate,
	enddate,
	amount,
	glvochcode
From   
	IncentiveSheet
Where  
	IncentiveDocCode Between :al_sinvcode AND :al_linvcode AND 
	Posted = 'N'
ORDER BY 
	IncentiveDocCode"
  update="IncentiveSheet" updatewhere=1 updatekeyinplace=no
  arguments=(("al_sinvcode", number), ("al_linvcode", number))
)
