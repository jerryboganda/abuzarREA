release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=79741120 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=acccode dbname="acccode"  )
column=(type=long updatewhereclause=yes name=subcode dbname="subcode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="name"  )
column=(type=long updatewhereclause=yes name=custcatcode dbname="custcatcode"  )
column=(type=char(100) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=char(60) updatewhereclause=yes name=subaccounts_name dbname="name"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(1) updatewhereclause=yes name=restricted dbname="restricted"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="balance"  )
column=(type=char(3) updatewhereclause=yes name=balancetype dbname="BalanceType"  )
column=(type=long updatewhereclause=yes name=alertcode dbname="AlertCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=alerttypecode dbname="AlertTypeCode"  )
 retrieve="  SELECT dbo.accounts.acccode,   
			dbo.accounts.subcode, 
			dbo.accounts.aliasname, 
         dbo.accounts.name,   
			custcatcode = CASE WHEN dbo.accounts.subcode = 3 THEN dbo.customer.custcatcode
						 	  ELSE -1 END,
			Category = CASE WHEN dbo.accounts.subcode = 3 THEN ( Select Name From CustomerCategory Where dbo.customer.custcatcode = dbo.CustomerCategory.CustCatCode ) 
								 WHEN dbo.accounts.subcode = 7 THEN ( Select Name From SupplierCategory Where dbo.supplier.suppcatcode = dbo.SupplierCategory.SuppCatCode ) 									 
								 ELSE Null END	,
			city = CASE WHEN dbo.accounts.subcode = 3 THEN dbo.customer.city
						 ELSE dbo.supplier.city END,
			dbo.subaccounts.name,
			Address = CASE WHEN dbo.accounts.subcode = 3 THEN dbo.customer.address1 
						 ELSE dbo.Supplier.address1 END,
			dbo.accounts.restricted,
		   balance=CASE accounts.restricted when'Y' then 0
					  ELSE isnull(V.balance,0)
					  END,
			BalanceType=CASE WHEN V.Balance > 0 THEN 'DR.' ELSE 'CR.' END,
	AlertCode=Accounts.AlertCode,
	AlertTypeCode=(SELECT Alert.AlertTypeCode FROM Alert WHERE Alert.AlertCode = Accounts.AlertCode)

FROM 
	dbo.accounts
	LEFT OUTER JOIN dbo.customer ON (dbo.accounts.acccode = dbo.customer.custcode)
	LEFT OUTER JOIN dbo.supplier ON (dbo.accounts.acccode = dbo.supplier.suppcode)
	LEFT OUTER JOIN (SELECT acccode, sum(debit - credit) as balance FROM virtualgl GROUP BY acccode) AS V ON (dbo.accounts.acccode = V.acccode), 
	dbo.subaccounts
WHERE 
	(dbo.accounts.subcode = dbo.subaccounts.subacccode) AND 
	(dbo.accounts.active = 'Y' )
ORDER BY
	dbo.accounts.name 
"
  sort="name A"
)
