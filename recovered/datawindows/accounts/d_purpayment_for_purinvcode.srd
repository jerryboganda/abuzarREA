release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=77 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=char(1) updatewhereclause=yes name=paymentmode dbname="PaymentMode" 
 values="Cash	C/Bank	B/"  )
column=(type=char(60) updatewhereclause=yes name=paidfrom dbname="PaidFrom"  )
column=(type=decimal(2) updatewhereclause=yes name=paymentamt dbname="PaymentAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=withholdingtaxamt dbname="WithHoldingTaxAmt"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted" 
 values="Yes	Y/No	N/"  )
column=(type=long updatewhereclause=yes name=postedby dbname="PostedBy" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=long updatewhereclause=yes name=glvochcode dbname="GLVochCode"  )
 retrieve="SELECT Code=P.PurPaymentCode, PurInvCode=P.PurInvCode, Date=P.Date, UserCode=P.UserCode, PaymentMode=P.PaymentMode, PaidFrom=(SELECT A.Name FROM Accounts A WHERE A.AccCode=P.PaymentAccCode), PaymentAmt=P.PaymentAmt, WithHoldingTaxAmt=P.WHTaxAmt, Posted=P.Posted, PostedBy=P.PostedBy, PostDate=P.PostDate, GLVochCode=P.GLVochCode
FROM PurPayment P
WHERE P.PurInvCode=:ai_code
ORDER BY Code DESC

"
  arguments=(("ai_code", number))
)
