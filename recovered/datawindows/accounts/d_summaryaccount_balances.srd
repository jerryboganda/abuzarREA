table(column=(type=char(115) updatewhereclause=yes name=summaryaccount dbname="SummaryAccount"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=subcode dbname="SubCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="Name"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
 retrieve="SELECT
	SummaryAccount = 
		CASE 
		WHEN (SELECT Count(SD.AccCode) 
				FROM SummaryAccountDetail SD 
				WHERE SD.AccCode = A.AccCode) = 0 THEN NULL 
		ELSE
			(SELECT MAX(SA.Name) + ' (' + MAX(SA.AliasName) + ')' 
			FROM SummaryAccount SA, SummaryAccountDetail SD 
			WHERE SD.AccCode = A.AccCode AND 
				SD.SummaryAccCode = SA.SummaryAccCode)
		END, 
	A.AliasName, 
	A.SubCode,
	A.AccCode,
	A.Name,
	Balance=ISNULL(Sum(V.Debit - V.Credit), 0)
FROM 
	Accounts A
	LEFT OUTER JOIN VirtualGL V ON(A.AccCode = V.AccCode),
	UDF_GetSummaryAccountList(:ai_accCode) L
WHERE
	L.AccCode = A.AccCode
GROUP BY
	A.AccCode,
	A.Name,
	A.AliasName, 
	A.SubCode
ORDER BY
	SummaryAccount,
	A.Name"
  arguments=(("ai_acccode", number))
)
