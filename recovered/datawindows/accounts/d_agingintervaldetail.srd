header(height=88 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="AgingIntervalDetail.AgingIntervalCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=limit dbname="AgingIntervalDetail.Limit"  )
 retrieve="SELECT 
	AgingIntervalDetail.AgingIntervalCode,   
	AgingIntervalDetail.Limit
FROM 
	AgingIntervalDetail
WHERE
	AgingIntervalDetail.AgingIntervalCode = :ai_code
ORDER BY 
	AgingIntervalDetail.Limit"
  update="AgingIntervalDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
