release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=decimal(6) updatewhereclause=yes name=pur dbname="pur"  )
column=(type=decimal(6) updatewhereclause=yes name=pret dbname="pret"  )
column=(type=decimal(2) updatewhereclause=yes name=voch dbname="voch"  )
 retrieve="Select pur = IsNull((select  IsNull( Round(sum(( (purdetail.looseqty + purdetail.packqty 
					* purdetail.packunits) * purdetail.purprice) * (1 - (.01 * purdetail.discperc)))
					* (1- (.01 * purledger.discperc)) + purledger.misccharges + purledger.salestax - 
						purledger.flatdisc, 0), 0)
						from     purledger,	 
									purdetail 
						where    purledger.purinvcode  = :ar_code and
								   purledger.purinvcode = purdetail.purinvcode and
									purledger.posted = 'Y' 
						group by purledger.purinvcode,
								   purledger.discperc,
							      purledger.misccharges,
							      purledger.salestax,
								   purledger.flatdisc), 0),
		pret = IsNull((select IsNull(Round(sum((( prdetail.looseqty + prdetail.packqty * 
							prdetail.packunits) * prdetail.prprice) * (1 - (.01 *
						   prdetail.discperc))) * (1- (.01 * prledger.discperc)) + 
							prledger.misccharges + prledger.salestax - prledger.flatdisc,
							 0), 0)
							from     prledger,	 
									   prdetail		
							where    prledger.PurInvCode = :ar_code and
								 		prledger.posted = 'Y' and
		                        prledger.prinvcode = prdetail.prinvcode
							
							group by prledger.prinvcode,
										 prledger.discperc,
										 prledger.misccharges,
										 prledger.salestax,
										 prledger.flatdisc), 0),
		voch = IsNull((select sum(gl.credit - gl.debit)
					     from     invledger il, invdetail gl
					     where    gl.invcode = :ar_code and
							  	     il.invvochcode = gl.invvochcode and 
							        il.invvochcatcode in (15,16,17)), 0)"
  arguments=(("ar_code", number))
)
