header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=67 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=acccode dbname="acccode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="name"  )
column=(type=char(60) updatewhereclause=yes name=subaccount dbname="subaccount"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="category"  )
 retrieve="SELECT 
	acccode=a.acccode,
	name=a.name,
	subaccount=s.name,
	category = c.name
FROM   
	accounts a, subaccounts s, categoryaccounts c, mainaccounts m
WHERE  
	a.subcode = s.subacccode and
	s.catacccode = c.catacccode and
	c.mainacccode = m.mainacccode and
	m.mainacccode = 5 and
	a.active = 'Y'
ORDER BY
	A.Name
  
"
  sort="name A"
)
