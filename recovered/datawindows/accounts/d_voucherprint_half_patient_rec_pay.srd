release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=385 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=0 color="536870912"  height.autosize=yes)
table(column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=long updatewhereclause=yes name=vochcatcode dbname="Glheader.vochcatcode"  )
column=(type=decimal(2) updatewhereclause=yes name=gldetail_debit dbname="GLDetail.Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=gldetail_credit dbname="GLDetail.Credit"  )
column=(type=char(20) updatewhereclause=yes name=gldetail_chkno dbname="GLDetail.ChkNo"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="GLDetail.Remarks"  )
column=(type=char(1) updatewhereclause=yes name=glheader_posted dbname="Glheader.Posted"  )
column=(type=datetime updatewhereclause=yes name=glheader_date dbname="Glheader.Date"  )
column=(type=char(100) updatewhereclause=yes name=glheader_remarks dbname="Glheader.Remarks"  )
column=(type=char(30) updatewhereclause=yes name=vochercategory_name dbname="VocherCategory.Name"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.UserName"  )
column=(type=long updatewhereclause=yes name=glheader_glvochcode dbname="Glheader.GLVochCode"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="Glheader.VoucherCode"  )
column=(type=char(1) updatewhereclause=yes name=creditordebit dbname="CreditorDebit"  )
column=(type=long identity=yes updatewhereclause=yes name=gldetail_glrowid dbname="GLDetail.glrowid"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
column=(type=char(60) updatewhereclause=yes name=location dbname="Location"  )
 retrieve="SELECT 
	Accounts.Name,
	Accounts.AliasName,
	Glheader.vochcatcode,   
	GLDetail.Debit,   
	GLDetail.Credit,   
	GLDetail.ChkNo,   
	GLDetail.Remarks,   
	Glheader.Posted,
	Glheader.Date,   
	Glheader.Remarks,   
	VocherCategory.Name,   
	Users.UserName,   
	Glheader.GLVochCode,
	Glheader.VoucherCode,
	CreditorDebit = Case GLDetail.Debit When 0 Then 'C' Else 'D' End,
	gldetail.glrowid,
	PatientRegNo=(SELECT P.RegNo FROM Patient P WHERE P.PatientCode = GLDetail.PatientCode),
	patientname=(SELECT P.name FROM Patient P WHERE P.PatientCode = GLDetail.PatientCode),
	Location=
		(SELECT LocationCode = 
				(SELECT PL.Name
				FROM PatientLocation PL 
				WHERE PL.LocationCode IN
						(ISNULL((SELECT TargetLocation FROM PatientTransfer 
							WHERE PatientTransfer.TransferCode = 
								(SELECT Max(PatientTransfer.TransferCode) 
								FROM PatientTransfer 
								WHERE PatientTransfer.AdmissionCode = PA.AdmissionCode)), 
							(SELECT A.LocationCode FROM PatientAdmission A 
							WHERE A.AdmissionCode = PA.AdmissionCode))))
							FROM PatientAdmission PA
							WHERE 
								PatientCode = GLDETAIL.PatientCode AND 
								PA.AdmissionCode IN 
									(SELECT MAX(PAA.AdmissionCode) 
									FROM PatientAdmission PAA WHERE PAA.PatientCode = GLDETAIL.PatientCode))
FROM 
	GLDetail,   
	Glheader,   
	Accounts,   
	VocherCategory,   
	Users  
WHERE
	( Glheader.GLVochCode = GLDetail.GLVochCode ) and  
	( Accounts.AccCode = GLDetail.AccCode ) and  
	( VocherCategory.VochCatCode = Glheader.VochCatCode ) and  
	( Users.UserCode = Glheader.salesmancode ) and  
	( Glheader.GLVochCode = :ar_code )   
ORDER BY GLDetail.GLRowID"
  arguments=(("ar_code", number))
 filter="c_amount <> 0"
 )
