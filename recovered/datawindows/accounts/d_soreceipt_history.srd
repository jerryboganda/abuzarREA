table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SOReceipt.SOReceiptCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="SOReceipt.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="SOReceipt.UserCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="SOReceipt.Posted" 
 values="Yes	Y/No	N/"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="SOReceipt.PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="SOReceipt.PostedBy" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=serviceocode dbname="SOReceipt.ServiceOCode"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="SOReceipt.AccCode"  )
column=(type=char(60) updatewhereclause=yes name=receivedfrom dbname="ReceivedFrom"  )
column=(type=char(113) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="SOReceipt.PatientCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=soamt dbname="SOReceipt.SOAmt"  )
column=(type=char(1) update=yes updatewhereclause=yes name=receiptmode dbname="SOReceipt.ReceiptMode" 
 values="Cash	C/Bank	B/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=receiptamt dbname="SOReceipt.ReceiptAmt"  )
column=(type=char(60) updatewhereclause=yes name=receiptin dbname="ReceiptIn"  )
column=(type=long update=yes updatewhereclause=yes name=receiptacccode dbname="SOReceipt.ReceiptAccCode"  )
column=(type=char(20) update=yes updatewhereclause=yes name=receiptrefno dbname="SOReceipt.ReceiptRefNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=receiptremarks dbname="SOReceipt.ReceiptRemarks"  )
column=(type=long update=yes updatewhereclause=yes name=whtaxacccode dbname="SOReceipt.WHTaxAccCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=whtaxbaseamt dbname="SOReceipt.WHTaxBaseAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=whtaxperc dbname="SOReceipt.WHTaxPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=whtaxamt dbname="SOReceipt.WHTaxAmt"  )
column=(type=char(20) update=yes updatewhereclause=yes name=whtaxrefno dbname="SOReceipt.WHTaxRefNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=whtaxremarks dbname="SOReceipt.WHTaxRemarks"  )
column=(type=decimal(2) updatewhereclause=yes name=deductions dbname="Deductions"  )
column=(type=long update=yes updatewhereclause=yes name=glvochcode dbname="SOReceipt.GLVochCode"  )
 retrieve="SELECT 
	SOReceiptCode,
	Date,
	UserCode,
	Posted,
	PostDate,
	PostedBy,
	ServiceOCode,
	AccCode,
	ReceivedFrom=(SELECT A.Name FROM Accounts A WHERE A.AccCode=DBO.SOReceipt.AccCode),
	Patient=(SELECT P.Name + ' (' + p.regno + ')' FROM Patient P, ServiceOHeader SO WHERE SO.ServiceOCode = DBO.SOReceipt.ServiceOCode AND SO.PatientCode=P.PatientCode),
	PatientCode,
	SOAmt,
	ReceiptMode,
	ReceiptAmt,
	ReceiptIn=(SELECT A.Name FROM Accounts A WHERE A.AccCode=DBO.SOReceipt.ReceiptAccCode),
	ReceiptAccCode,
	ReceiptRefNo,
	ReceiptRemarks,
	WHTaxAccCode,
	WHTaxBaseAmt,
	WHTaxPerc,
	WHTaxAmt,
	WHTaxRefNo,
	WHTaxRemarks,
	Deductions = ISNULL(Deduction1, 0) + ISNULL(Deduction2, 0) + ISNULL(Deduction3, 0) + ISNULL(Deduction4, 0) + ISNULL(Deduction5, 0),
	GLVochCode
FROM
	DBO.SOReceipt 
WHERE
	ServiceOCode = :ai_code"
  update="DBO.SOReceipt" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
 sort="code D, date D"
)
