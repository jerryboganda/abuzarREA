header(height=132 color="536870912" )
summary(height=20 color="536870912" )
footer(height=72 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=invoicecode dbname="GLDetail.invoicecode"  )
column=(type=datetime updatewhereclause=yes name=invdate dbname="invdate"  )
column=(type=decimal(2) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=outstandingamt dbname="GLDetail.OutStandingAmt"  )
column=(type=char(12) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="GLDetail.acccode" 
 values=""  )
column=(type=char(20) update=yes updatewhereclause=yes name=chkno dbname="GLDetail.chkno"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="GLDetail.remarks"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="GLDetail.glvochcode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="GLDetail.patientcode" 
 values=""  )
column=(type=char(50) updatewhereclause=yes name=guestregno dbname="guestregno"  )
column=(type=long update=yes updatewhereclause=yes name=guestcode dbname="GLDetail.guestcode" 
 values=""  )
column=(type=char(60) updatewhereclause=yes name=studentregno dbname="Studentregno"  )
column=(type=long update=yes updatewhereclause=yes name=studentcode dbname="GLDetail.studentcode" 
 values=""  )
column=(type=long key=yes update=yes updatewhereclause=yes name=glrowid dbname="GLROWID"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=glutn dbname="GLUTN"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=balance dbname="GLDetail.balance"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Please enter valid Foreign Amount'" initial="0" name=foreignamt dbname="GLDetail.foreignamt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=debit dbname="GLDetail.debit"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(GetText()) >= 0" initial="0" name=credit dbname="GLDetail.credit"  )
 retrieve="SELECT  
	dbo.gldetail.invoicecode,
	invdate=GetDate(),
	NetAmt=0.00,
	dbo.gldetail.OutStandingAmt,
	fullcode=dbo.accounts.aliasname,
	dbo.gldetail.acccode,
	dbo.gldetail.chkno,
	dbo.gldetail.remarks,
	dbo.gldetail.glvochcode ,
	regno = (SELECT regno FROM Patient WHERE Patient.PatientCode = dbo.gldetail.patientcode),
	dbo.gldetail.patientcode,
	guestregno = (SELECT regno FROM Guest WHERE Guest.GuestCode = dbo.gldetail.Guestcode),
	dbo.gldetail.guestcode,
	Studentregno = (SELECT regno FROM Student WHERE Student.StudentCode = dbo.gldetail.Studentcode),
	dbo.gldetail.studentcode,
	GLROWID=dbo.gldetail.IDENTITYCOL,
	GLUTN=dbo.gldetail.GLUTN,
	dbo.gldetail.balance,
	dbo.gldetail.foreignamt,
	dbo.gldetail.debit,
	dbo.gldetail.credit
	
FROM
	dbo.gldetail ,
	dbo.glheader, 
	dbo.accounts
	
WHERE
   ( dbo.glheader.glvochcode = :ar_VochCode ) and
	( dbo.glheader.glvochcode = dbo.gldetail.glvochcode ) and
	( dbo.glheader.acccode <> dbo.gldetail.acccode ) and 
	( dbo.gldetail.acccode = dbo.accounts.acccode )
ORDER BY
	dbo.gldetail.IDENTITYCOL
"
  update="gldetail" updatewhere=1 updatekeyinplace=no
  arguments=(("ar_VochCode", number))
)
