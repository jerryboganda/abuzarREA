table(column=(type=char(60) updatewhereclause=yes name=transactioncategory dbname="TransactionCategory"  )
column=(type=char(60) updatewhereclause=yes name=transactiontype dbname="TransactionType"  )
column=(type=char(2) updatewhereclause=yes name=shortname dbname="ShortName"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=long updatewhereclause=yes name=tansactiontypecode dbname="TansactionTypeCode"  )
column=(type=long updatewhereclause=yes name=transactioncode dbname="TransactionCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=decimal(2) updatewhereclause=yes name=patientbalance dbname="PatientBalance"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=decimal(2) updatewhereclause=yes name=accbalance dbname="AccBalance"  )
column=(type=long updatewhereclause=yes name=cashacccode dbname="CashAccCode" 
 values=""  )
column=(type=decimal(2) updatewhereclause=yes name=cashtendered dbname="CashTendered"  )
column=(type=decimal(2) updatewhereclause=yes name=cashcharged dbname="CashCharged"  )
column=(type=decimal(2) updatewhereclause=yes name=cashback dbname="CashBack"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=long updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=long updatewhereclause=yes name=detailacccode dbname="DetailAccCode"  )
column=(type=char(60) updatewhereclause=yes name=detailaccountname dbname="DetailAccountName"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=char(100) updatewhereclause=yes name=detailremarks dbname="DetailRemarks"  )
column=(type=long updatewhereclause=yes name=rowid dbname="RowId"  )
 retrieve="SELECT 
	TransactionCategory=TC.Name,
	TransactionType=TT.Name,
	ShortName=TT.ShortName,
	DocumentCode=TH.DocumentCode,
	TansactionTypeCode=TH.TransactionTypeCode,
	TransactionCode=TH.TransactionCode,
	Date=TH.Date,
	UserCode=TH.UserCode,
	Remarks=TH.Remarks,
	PatientCode=TH.PatientCode,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = TH.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = TH.PatientCode),
	AdmissionCode=TH.AdmissionCode,
	PatientBalance=TH.PatientBalance,
	AccCode=TH.AccCode,
	AliasName=(SELECT A.AliasName FROM Accounts A WHERE A.AccCode = TH.AccCode),
	AccountName=(SELECT A.Name FROM Accounts A WHERE A.AccCode = TH.AccCode),
	AccBalance=TH.AccBalance,
	CashAccCode=TH.CashAccCode,
	CashTendered=TH.CashTendered,
	CashCharged=TH.CashCharged,
	CashBack=TH.CashBack,
	Posted=TH.Posted,
	PostedBy=TH.PostedBy,
	PostDate=TH.PostDate,
	DetailAccCode=TD.AccCode,
	DetailAccountName=(SELECT A.Name FROM Accounts A WHERE A.AccCode = TD.AccCode),
	Amount=TD.Amount,
	DetailRemarks=TD.Remarks,
	RowId=TD.RowID  
FROM 
	TransactionCategory TC,
	TransactionType TT, 
	TransactionHeader TH
	LEFT OUTER JOIN 
		(SELECT TransactionDetail.* 
		FROM TransactionDetail 
		WHERE TransactionDetail.DocumentCode = :ai_code AND 	TransactionDetail.Amount > 0) AS TD ON (TH.DocumentCode = TD.DocumentCode)
WHERE 
	TH.DocumentCode = :ai_code AND
	TH.TransactionTypeCode = TT.TransactionTypeCode and
	TT.TransactionCatCode = TC.TransactionCatCode
ORDER BY
	TH.DocumentCode,
	TD.RowId"
  arguments=(("ai_code", number))
)
