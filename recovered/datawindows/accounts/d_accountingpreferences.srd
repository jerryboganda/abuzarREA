 retrieve="SELECT 
	userid, 
	VoucherPrintingFormat, 
	VoucherPrintingPageSize, 
	aliasnameintrans, 
	askdateintrans,
	transuserwindow,
	patientintransaction,
	SalePersonInTrans,
	ShowSaleRemarksInLedger,
	ShowSRetRemarksInLedger,
	ShowPurRemarksInLedger,
	ShowPRetRemarksInLedger,
	ShowSvcRemarksInLedger,
	ShowSvcRetRemarksInLedger,
	UniqueRefNoInTrans,
	AutoRefNoInTrans,
	IncVochInActMonitor,
	IncBRBPInActMonitor
FROM Preferences"
  update="Preferences" updatewhere=1 updatekeyinplace=yes
 )
