header(height=80 color="536870912" )
summary(height=68 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="TransactionDetail.DocumentCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=acccode dbname="TransactionDetail.AccCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=amount dbname="TransactionDetail.Amount"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="TransactionDetail.Remarks"  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="TransactionDetail.RowId"  )
 retrieve="SELECT DocumentCode, AccCode, Amount, Remarks, RowId
FROM TransactionDetail
WHERE DocumentCode=:ai_Code"
  update="TransactionDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_Code", number))
)
