table(column=(type=long update=yes updatewhereclause=yes name=code dbname="ReceiptCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="DATE"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=netamt dbname="NetAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=outstandingamt dbname="OutstandingAmt"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode" 
 values=""  )
column=(type=char(30) updatewhereclause=yes name=nic dbname="NIC"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(2) updatewhereclause=yes name=receiveduptill dbname="ReceivedUpTill"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long update=yes updatewhereclause=yes name=installmentrowid dbname="InstallmentRowID"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=installmentamount dbname="InstallmentAmount"  )
column=(type=datetime updatewhereclause=yes name=installmentdate dbname="InstallmentDate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=installmentbalance dbname="InstallmentBalance"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=amtreceived dbname="AmtReceived"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discount dbname="Discount"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=fine dbname="Fine"  )
column=(type=long updatewhereclause=yes name=installmentleft dbname="InstallmentLeft"  )
column=(type=long update=yes updatewhereclause=yes name=glvochcode dbname="GLVochCode"  )
column=(type=long update=yes updatewhereclause=yes name=glvochcodedisount dbname="GLVochCodeDisount"  )
column=(type=long update=yes updatewhereclause=yes name=glvochcodefine dbname="GLVochCodeFine"  )
column=(type=char(100) updatewhereclause=yes name=detailremarks dbname="DetailRemarks"  )
 retrieve="SELECT 
	ReceiptCode=R.ReceiptCode,
	DATE=R.DATE,
	UserCode=R.UserCode, 
	SaleInvCode=R.SaleInvCode,
	NetAmt=R.NetAmt,
	OutstandingAmt=R.OutstandingAmt,
	CustCode = (SELECT MIN(H.CustCode) FROM InstallmentHeader H WHERE H.SaleInvCode = R.SaleInvCode),
	NIC = (SELECT MIN(C.NIC) FROM InstallmentHeader H, Customer C WHERE H.SaleInvCode = R.SaleInvCode AND H.CustCode = C.CustCode),
	ItemName = (SELECT I.Name FROM InstallmentHeader H, Item I WHERE H.SaleInvCode = R.SaleInvCode AND H.ICode=I.ICode),
	ReceivedUpTill = ISNULL((SELECT H.DownPayment FROM InstallmentHeader H WHERE H.SaleInvCode = R.SaleInvCode),0) + ISNULL((SELECT SUM(IRD.AmtReceived + IRD.Discount) FROM InstallmentReceipt IR, InstallmentReceiptDetail IRD WHERE IR.ReceiptCode = IRD.ReceiptCode AND IR.SaleInvCode = R.SaleInvCode), 0),
	Remarks=R.Remarks,
	InstallmentRowID=D.InstallmentRowID,
	InstallmentAmount=D.InstallmentAmount,
	InstallmentDate=(SELECT ID.Date FROM InstallmentHeader H, InstallmentDetail ID WHERE H.SaleInvCode = R.SaleInvCode AND H.InstallmentCode = ID.InstallmentCode AND ID.RowID = D.InstallmentRowID),
	InstallmentBalance=D.InstallmentBalance,
	AmtReceived=D.AmtReceived,
	Discount=D.Discount,
	Fine=D.Fine,
	InstallmentLeft = (SELECT COUNT(D.InstallmentCode) FROM InstallmentHeader H, InstallmentDetail D WHERE H.SaleInvCode = R.SaleInvCode AND H.InstallmentCode = D.InstallmentCode AND D.Amount - D.AmtReceived > 0),
	GLVochCode=R.GLVochCode,
	GLVochCodeDisount=R.GLVochCodeDisount,
	GLVochCodeFine=R.GLVochCodeFine,
	DetailRemarks=D.Remarks
FROM 
	InstallmentReceipt R, InstallmentReceiptDetail D
WHERE
	R.ReceiptCode = :ai_code AND
	R.ReceiptCode = D.ReceiptCode
"
  arguments=(("ai_code", number))
 sort="code A, installmentrowid A"
)
