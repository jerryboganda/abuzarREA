release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=68 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=code dbname="InstallmentCode"  )
column=(type=char(52) updatewhereclause=yes name=installment dbname="Installment"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="Date"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=amtreceived dbname="AmtReceived"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=discount dbname="Discount"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=fine dbname="Fine"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=amount dbname="Amount"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=char(1) updatewhereclause=yes name=cancelled dbname="Cancelled"  )
 retrieve="SELECT 
	InstallmentCode = InstallmentDetail.InstallmentCode,
	Installment = 'SI-' + LTRIM(RTRIM(STR(InstallmentHeader.SaleInvCode,10))) + '-IN-' + LTRIM(RTRIM(STR(InstallmentDetail.InstallmentCode,10))) + '-DT-' + CONVERT(VARCHAR(10), InstallmentDetail.Date, 103) + '-' + LTRIM(RTRIM(STR(InstallmentDetail.rowid,10))),
	Date=InstallmentDetail.Date,
	AmtReceived=InstallmentDetail.AmtReceived,
	Discount=InstallmentDetail.Discount,
	Fine=InstallmentDetail.Fine,
	Amount=InstallmentDetail.Amount,
	RowID=InstallmentDetail.RowID,
	Cancelled = InstallmentDetail.Cancelled
FROM
	InstallmentDetail, InstallmentHeader
WHERE 
	InstallmentHeader.SaleInvCode = :ai_code AND
	InstallmentHeader.Approved = 'Y' AND
	InstallmentHeader.Posted = 'Y' AND
	InstallmentHeader.InstallmentCode = InstallmentDetail.InstallmentCode AND
	InstallmentDetail.Amount - InstallmentDetail.Discount - InstallmentDetail.AmtReceived > 0 AND
	InstallmentDetail.Cancelled = 'N'
ORDER BY
	InstallmentDetail.InstallmentCode,
	InstallmentDetail.Date,
	InstallmentDetail.RowID
"
  arguments=(("ai_code", number))
)
