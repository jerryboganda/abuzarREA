column=(type=char(100) updatewhereclause=yes name=studentregno dbname="StudentRegNo"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode" 
 values=""  )
 retrieve="SELECT
	dbo.glheader.glvochcode ,
	dbo.glheader.vouchercode,
	dbo.glheader.acccode,
	remarks='                                                                               ',
	dbo.glheader.vochcatcode ,
	dbo.glheader.salesmancode ,
	dbo.glheader.date ,
	dbo.glheader.posted ,
	dbo.glheader.postdate ,
	dbo.users.username,
	dbo.glheader.originaldate,
	dbo.glheader.modifiedby,
	dbo.glheader.postedby,
	dbo.glheader.chkno,
	dbo.glheader.smancode,
	FeeComment = SPACE(255),
	ClassCode=NULL,
	FNIC=SPACE(100),
	StudentRegNo=SPACE(100),
	StudentCode=NULL
FROM 
	dbo.glheader ,
	dbo.users     
WHERE 
	( dbo.glheader.salesmancode = dbo.users.usercode ) and  
	( dbo.glheader.glvochcode = :ar_VoucherCode )    "
  update="glheader" updatewhere=0 updatekeyinplace=yes
  arguments=(("ar_VoucherCode", number))
)
