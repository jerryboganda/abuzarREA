table(column=(type=long key=yes updatewhereclause=yes name=code dbname="GuestCheckin.GuestCheckINCode"  )
column=(type=datetime updatewhereclause=yes initial="today" name=date dbname="GuestCheckin.Date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="GuestCheckin.UserCode" 
 values=""  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=long updatewhereclause=yes name=guestcode dbname="GuestCheckin.GuestCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=currentroom dbname="GuestCheckin.CurrentRoom"  )
column=(type=long updatewhereclause=yes name=checkinroom dbname="GuestCheckin.CheckInRoom" 
 values=""  )
column=(type=datetime updatewhereclause=yes initial="today" name=checkindate dbname="GuestCheckin.CheckInDate"  )
column=(type=long updatewhereclause=yes name=checkinby dbname="GuestCheckin.CheckInBy" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=checkout dbname="GuestCheckin.CheckOut" 
 values="Yes	Y/No	N/"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=checkoutdate dbname="GuestCheckin.CheckOutDate"  )
column=(type=long update=yes updatewhereclause=yes name=checkoutby dbname="GuestCheckin.CheckOutBy" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="GuestCheckin.Remarks"  )
column=(type=long updatewhereclause=yes initial="2" name=cashacccode dbname="GuestCheckin.CashAccCode"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=cashtendered dbname="GuestCheckin.CashTendered"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=cashcharged dbname="GuestCheckin.CashCharged"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=cashback dbname="GuestCheckin.CashBack"  )
 retrieve="  SELECT GuestCheckin.GuestCheckINCode,   
         GuestCheckin.Date,   
         GuestCheckin.UserCode,   
		RegNo=SPACE(50),
         GuestCheckin.GuestCode,   
         GuestCheckin.CurrentRoom,   
         GuestCheckin.CheckInRoom,   
         GuestCheckin.CheckInDate,   
         GuestCheckin.CheckInBy,   
         GuestCheckin.CheckOut,   
         GuestCheckin.CheckOutDate,   
         GuestCheckin.CheckOutBy,   
         GuestCheckin.Remarks,   
         GuestCheckin.CashAccCode,   
         GuestCheckin.CashTendered,   
         GuestCheckin.CashCharged,   
         GuestCheckin.CashBack  
    FROM GuestCheckin  
   WHERE GuestCheckin.GuestCheckINCode = :ai_code    
"
  update="GuestCheckin" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
