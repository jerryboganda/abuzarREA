table(column=(type=long key=yes updatewhereclause=yes name=guestcheckincode dbname="GuestCheckin.GuestCheckInCode"  )
column=(type=long updatewhereclause=yes name=guestcode dbname="GuestCheckin.GuestCode"  )
column=(type=datetime updatewhereclause=yes name=checkindate dbname="GuestCheckin.CheckInDate"  )
column=(type=long updatewhereclause=yes name=checkinby dbname="GuestCheckin.CheckInBy" 
 values=""  )
column=(type=char(1) updatewhereclause=yes name=checkout dbname="GuestCheckin.CheckOut"  )
column=(type=datetime updatewhereclause=yes name=checkoutdate dbname="GuestCheckin.CheckOutDate"  )
column=(type=long updatewhereclause=yes name=checkoutby dbname="GuestCheckin.CheckOutBy" 
 values=""  )
 retrieve="  SELECT GuestCheckIn.GuestCheckInCode,   
         GuestCheckIn.GuestCode,   
         GuestCheckIn.CheckInDate,   
         GuestCheckIn.CheckInBy,   
         GuestCheckIn.CheckOut,   
         GuestCheckIn.CheckOutDate,   
         GuestCheckIn.CheckOutBy
    FROM GuestCheckIn   
WHERE		GuestCheckIn.GuestCode = :ar_GuestCode
ORDER BY GuestCheckIn.Date DESC, GuestCheckIn.GuestCheckInCode DESC, GuestCheckIn.CheckOutDate"
  update="GuestCheckIn" updatewhere=1 updatekeyinplace=no
  arguments=(("ar_GuestCode", number))
)
