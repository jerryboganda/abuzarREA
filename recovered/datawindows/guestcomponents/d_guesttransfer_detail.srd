table(column=(type=long updatewhereclause=yes name=guestcheckincode dbname="GuestCheckin.GuestCheckInCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Regno"  )
column=(type=long updatewhereclause=yes name=guestcode dbname="GuestCheckin.GuestCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=checkinroom dbname="CheckInRoom" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=checkindate dbname="CheckInDate"  )
column=(type=long updatewhereclause=yes name=checkinby dbname="CheckInBy" 
 values=""  )
column=(type=long updatewhereclause=yes name=code dbname="GuestTransferCode"  )
column=(type=long updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=lastroom dbname="LastRoom" 
 values=""  )
column=(type=long updatewhereclause=yes name=newroom dbname="NewRoom" 
 values=""  )
column=(type=char(62) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=usercode dbname="usercode"  )
 retrieve="SELECT
	GC.GuestCheckInCode,
	Regno = (SELECT Guest.RegNo FROM Guest WHERE Guest.GuestCode = GC.GuestCode),
	GC.GuestCode,   
	CheckInRoom=GC.CheckInRoom,   
	CheckInDate=GC.CheckInDate,   
	CheckInBy=GC.CheckInBy,   
	GuestTransferCode=NULL,
	Date=NULL,   
	LastRoom = GC.CurrentRoom, 
	NewRoom = NULL,
	Remarks='                                                              ',
	usercode=null
FROM
	GuestCheckIn GC,
	GuestRoom GR
WHERE
	GC.GuestCheckInCode = :Code AND
	GC.CurrentRoom = GR.GuestRoomCode
"
  arguments=(("Code", number))
)
