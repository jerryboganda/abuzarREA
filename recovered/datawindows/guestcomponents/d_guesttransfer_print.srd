table(column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes name=guestcheckincode dbname="GuestCheckInCode"  )
column=(type=datetime updatewhereclause=yes name=checkindate dbname="CheckInDate"  )
column=(type=char(202) updatewhereclause=yes name=checkinroom dbname="CheckInRoom"  )
column=(type=char(60) updatewhereclause=yes name=checkinby dbname="CheckInBy"  )
column=(type=char(1) updatewhereclause=yes name=checkout dbname="CheckOut" 
 values="Yes	Y/No	N/"  )
column=(type=datetime updatewhereclause=yes name=checkoutdate dbname="CheckOutDate"  )
column=(type=char(60) updatewhereclause=yes name=checkoutby dbname="CheckOutBy"  )
column=(type=long updatewhereclause=yes name=guesttransfercode dbname="GuestTransferCode"  )
column=(type=datetime updatewhereclause=yes name=transferdate dbname="TransferDate"  )
column=(type=char(202) updatewhereclause=yes name=transferfrom dbname="TransferFrom"  )
column=(type=char(202) updatewhereclause=yes name=transferto dbname="TransferTo"  )
column=(type=char(60) updatewhereclause=yes name=transferby dbname="TransferBy"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
 retrieve="SELECT
	RegNo = (SELECT G.RegNo FROM Guest G WHERE GC.GuestCode=G.GuestCode),
	Name= (SELECT G.Name FROM Guest G WHERE GC.GuestCode=G.GuestCode),
	GuestCheckInCode=T.GuestCheckInCode,
	CheckInDate=GC.CheckInDate,
	CheckInRoom=(SELECT LTRIM(RTRIM(GR.NAME)) + ', ' + LTRIM(RTRIM(F.Name))
			FROM GuestRoom GR, GuestRoomFloor F
			WHERE GR.GuestRoomCode=GC.CheckInRoom AND
				GR.GuestRoomFloorCode=F.GuestRoomFloorCode),
	CheckInBy = (SELECT U.UserName FROM Users U WHERE U.UserCode=GC.CheckInBy),
	CheckOut=GC.CheckOut,
	CheckOutDate=GC.CheckOutDate,
	CheckOutBy = (SELECT U.UserName FROM Users U WHERE U.UserCode=GC.CheckOutBy),
	GuestTransferCode=T.GuestTransferCode,
	TransferDate=T.Date,
	TransferFrom=(SELECT LTRIM(RTRIM(GR.NAME)) + ', ' + LTRIM(RTRIM(F.Name))
			FROM GuestRoom GR, GuestRoomFloor F
			WHERE GR.GuestRoomCode=T.LastRoom AND
				GR.GuestRoomFloorCode=F.GuestRoomFloorCode),
	TransferTo=(SELECT LTRIM(RTRIM(GR.NAME)) + ', ' + LTRIM(RTRIM(F.Name))
			FROM GuestRoom GR, GuestRoomFloor F
			WHERE GR.GuestRoomCode=T.NewRoom AND
				GR.GuestRoomFloorCode=F.GuestRoomFloorCode),
	TransferBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=T.UserCode),
	Remarks=T.Remarks
FROM
	GuestCheckIn GC LEFT OUTER JOIN GuestTransfer T ON (GC.GuestCheckInCode = T.GuestCheckInCode)
WHERE
	GC.GuestCheckInCode = :ai_code
ORDER BY
	GuestTransferCode DESC,
	TransferDate,
	TransferFrom,
	TransferTo,
	TransferBy"
  arguments=(("ai_code", number))
)
