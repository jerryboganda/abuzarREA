detail(height=4968 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Guest.GuestCode"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=active dbname="Guest.Active" 
 values="Yes	Y/No	N/"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Guest.Date"  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="Guest.RegNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="Guest.Name"  )
column=(type=long update=yes updatewhereclause=yes initial="22" name=custcode dbname="Guest.CustCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="Guest.UserCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="M" name=gender dbname="Guest.Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=nic dbname="Guest.NIC"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fhname dbname="Guest.FHName"  )
column=(type=char(255) update=yes updatewhereclause=yes name=address dbname="Guest.Address"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mobile dbname="Guest.Mobile"  )
column=(type=char(100) update=yes updatewhereclause=yes name=phone dbname="Guest.Phone"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fax dbname="Guest.Fax"  )
column=(type=char(100) update=yes updatewhereclause=yes name=email dbname="Guest.Email"  )
column=(type=char(100) update=yes updatewhereclause=yes name=profession dbname="Guest.Profession"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="PAKISTANI" name=nationality dbname="Guest.Nationality"  )
column=(type=char(100) update=yes updatewhereclause=yes name=passport dbname="Guest.Passport"  )
column=(type=char(100) update=yes updatewhereclause=yes name=reference dbname="Guest.Reference"  )
 retrieve="  SELECT Guest.GuestCode,   
         Guest.Active,   
         Guest.Date,   
         Guest.RegNo,   
         Guest.Name,   
         Guest.CustCode,   
         Guest.UserCode,   
         Guest.Gender,   
         Guest.NIC,   
         Guest.FHName,   
         Guest.Address, 
         Guest.Mobile,   
         Guest.Phone,   
         Guest.Fax,   
         Guest.Email,   
         Guest.Profession,   
         Guest.Nationality,   
         Guest.Passport,   
         Guest.Reference  
    FROM Guest  
   WHERE Guest.GuestCode = :ai_code    
"
  update="Guest" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
