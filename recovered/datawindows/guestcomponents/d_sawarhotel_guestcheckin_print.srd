table(column=(type=long updatewhereclause=yes name=guestcheckincode dbname="GuestCheckInCode"  )
column=(type=datetime updatewhereclause=yes name=checkindate dbname="CheckInDate"  )
column=(type=char(202) updatewhereclause=yes name=checkinroom dbname="CheckInRoom"  )
column=(type=char(60) updatewhereclause=yes name=checkinby dbname="CheckInBy"  )
column=(type=char(202) updatewhereclause=yes name=currentroom dbname="CurrentRoom"  )
column=(type=char(1) updatewhereclause=yes name=checkout dbname="CheckOut" 
 values="Yes	Y/No	N/"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes name=guestcode dbname="Guest.GuestCode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="Guest.CustCode" 
 values=""  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Guest.Gender"  )
column=(type=char(100) updatewhereclause=yes name=nic dbname="Guest.NIC"  )
column=(type=char(100) updatewhereclause=yes name=fhname dbname="Guest.FHName"  )
column=(type=char(255) updatewhereclause=yes name=address dbname="Guest.Address"  )
column=(type=char(100) updatewhereclause=yes name=mobile dbname="Guest.Mobile"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Guest.Phone"  )
column=(type=char(100) updatewhereclause=yes name=fax dbname="Guest.Fax"  )
column=(type=char(100) updatewhereclause=yes name=email dbname="Guest.Email"  )
column=(type=char(100) updatewhereclause=yes name=profession dbname="Guest.Profession"  )
column=(type=char(100) updatewhereclause=yes name=nationality dbname="Guest.Nationality"  )
column=(type=char(100) updatewhereclause=yes name=passport dbname="Guest.Passport"  )
column=(type=char(100) updatewhereclause=yes name=reference dbname="Guest.Reference"  )
column=(type=char(100) updatewhereclause=yes name=comingfrom dbname="ComingFrom"  )
column=(type=datetime updatewhereclause=yes name=arrivaldate dbname="ArrivalDate"  )
column=(type=datetime updatewhereclause=yes name=departuredate dbname="DepartureDate"  )
column=(type=long updatewhereclause=yes name=stayperiod dbname="StayPeriod"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="GuestCheckInService.ServiceCode" 
 values=""  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="GuestCheckInService.Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="GuestCheckInService.SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="GuestCheckInService.ServiceFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="GuestCheckInService.DiscPerc"  )
column=(type=decimal(8) updatewhereclause=yes name=totalamount dbname="TotalAmount"  )
column=(type=decimal(6) updatewhereclause=yes name=expectedtotalamt dbname="ExpectedTotalAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=cashtendered dbname="CashTendered"  )
column=(type=decimal(2) updatewhereclause=yes name=cashcharged dbname="CashCharged"  )
column=(type=decimal(2) updatewhereclause=yes name=cashback dbname="CashBack"  )
 retrieve="SELECT
	GuestCheckInCode=GC.GuestCheckInCode,
	CheckInDate=GC.CheckInDate,
	CheckInRoom=(SELECT LTRIM(RTRIM(GR.NAME)) + ', ' + LTRIM(RTRIM(F.Name))
			FROM GuestRoom GR, GuestRoomFloor F
			WHERE GR.GuestRoomCode=GC.CheckInRoom AND
				GR.GuestRoomFloorCode=F.GuestRoomFloorCode),
	CheckInBy = (SELECT U.UserName FROM Users U WHERE U.UserCode=GC.CheckInBy),
	CurrentRoom=(SELECT LTRIM(RTRIM(GR.NAME)) + ', ' + LTRIM(RTRIM(F.Name))
			FROM GuestRoom GR, GuestRoomFloor F
			WHERE GR.GuestRoomCode=GC.CurrentRoom AND
				GR.GuestRoomFloorCode=F.GuestRoomFloorCode),
	CheckOut=GC.CheckOut,
	RegNo = G.RegNo,
	Name= G.Name,
	G.GuestCode,   
	G.CustCode,   
	G.Gender,   
	G.NIC,   
	G.FHName,   
	G.Address,   
	G.Mobile,   
	G.Phone,   
	G.Fax,   
	G.Email,   
	G.Profession,   
	G.Nationality,   
	G.Passport,   
	G.Reference,
	ComingFrom=GC.ComingFrom,
	ArrivalDate=GC.ArrivalDate,
	DepartureDate=GC.DepartureDate,
	StayPeriod = GC.StayPeriod,
	GCS.ServiceCode,
	GCS.Qty,
	GCS.SalePrice,
	GCS.ServiceFlatDisc,
	GCS.DiscPerc,
	TotalAmount = Round(GCS.Qty * (GCS.SalePrice - GCS.ServiceFlatDisc) * (1 - GCS.DiscPerc * 0.01),2),
	ExpectedTotalAmt = Round(GC.StayPeriod * GCS.Qty * (GCS.SalePrice - GCS.ServiceFlatDisc) * (1 - GCS.DiscPerc * 0.01),2),
	CashTendered = GC.CashTendered,
	CashCharged = ISNULL(GC.CashCharged, 0) + ISNULL((SELECT SUM(MC.Amount) FROM MasterCashWin MC WHERE MC.DocumentCode = GC.GuestCheckInCode AND MC.DocumentType = 'GC'), 0),
	CashBack = GC.CashBack
FROM
	GuestCheckIn GC 
	LEFT OUTER JOIN GuestCheckInService AS GCS ON (GC.GuestCheckInCode = GCS.GuestCheckInCode),
	Guest G
WHERE
	GC.GuestCheckInCode = :ai_code AND
	GC.GuestCode = G.GuestCode
"
  arguments=(("ai_code", number))
)
