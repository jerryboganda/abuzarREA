table(column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="GuestRoom.Name"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="GuestRoom.GuestRoomCode"  )
column=(type=long update=yes updatewhereclause=yes name=capacity dbname="GuestRoom.Capacity"  )
column=(type=char(100) update=yes updatewhereclause=yes name=guestroomfloor dbname="GuestRoomFloor"  )
column=(type=char(100) update=yes updatewhereclause=yes name=guestroomtype dbname="GuestRoomType"  )
column=(type=char(100) update=yes updatewhereclause=yes name=guestroomstatus dbname="GuestRoomStatus"  )
column=(type=char(1) update=yes updatewhereclause=yes name=occupied dbname="GuestRoom.Occupied" 
 values="Yes	Y/No	N/"  )
column=(type=long updatewhereclause=yes name=guestcheckincode dbname="GuestCheckInCode"  )
column=(type=char(153) updatewhereclause=yes name=guestname dbname="GuestName"  )
 retrieve="SELECT 
	GuestRoom.Name,   
	GuestRoom.GuestRoomCode,   
	GuestRoom.Capacity,   
	GuestRoomFloor= (SELECT F.Name FROM GuestRoomFloor F WHERE F.GuestRoomFloorCode = GuestRoom.GuestRoomFloorCode),   
	GuestRoomType= (SELECT T.Name FROM GuestRoomType T WHERE T.GuestRoomTypeCode = GuestRoom.GuestRoomTypeCode),   
	GuestRoomStatus= (SELECT S.Name FROM GuestRoomStatus S WHERE S.GuestRoomStatusCode = GuestRoom.GuestRoomStatusCode),   
	GuestRoom.Occupied,
	GuestCheckInCode=(SELECT MAX(GC.GuestCheckInCode) FROM GuestCheckIn GC WHERE GC.CurrentRoom=GuestRoom.GuestRoomCode AND CheckOut='N'),
	GuestName=(SELECT G.Name + ' (' + g.regno + ')'
					FROM (SELECT GuestCheckInCode=MAX(GC.GuestCheckInCode) FROM GuestCheckIn GC WHERE GC.CurrentRoom=GuestRoom.GuestRoomCode AND CheckOut='N') T, Guest G, GuestCheckIn GCI
					WHERE T.GuestCheckInCode = GCI.GuestCheckInCode AND GCI.GuestCode = G.GuestCode)
FROM 
	GuestRoom  
"
  update="GuestRoom" updatewhere=1 updatekeyinplace=no
 )
