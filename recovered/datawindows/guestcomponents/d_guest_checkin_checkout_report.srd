release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1308 color="536870912" )
summary(height=0 color="536870912" )
footer(height=8 color="536870912" )
detail(height=183 color="536870912" )
table(column=(type=char(9) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=guestname dbname="GuestName"  )
column=(type=char(100) updatewhereclause=yes name=fhname dbname="FHName"  )
column=(type=char(100) updatewhereclause=yes name=cnic dbname="CNIC"  )
column=(type=char(100) updatewhereclause=yes name=mobile dbname="Mobile"  )
column=(type=char(60) updatewhereclause=yes name=company dbname="Company"  )
column=(type=char(100) updatewhereclause=yes name=comingfrom dbname="ComingFrom"  )
column=(type=long updatewhereclause=yes name=stayperiod dbname="StayPeriod"  )
column=(type=decimal(2) updatewhereclause=yes name=cashcharged dbname="CashCharged"  )
column=(type=decimal(8) updatewhereclause=yes name=payableamt dbname="PayableAmt"  )
 retrieve="SELECT 
	Type = 'CHECK IN',
	Date=GC.CheckInDate,
	RegNo = G.RegNo,
	GuestName = G.Name,
	FHName = G.FHName,
	CNIC = G.NIC,
	Mobile = G.Mobile,
	Company = (SELECT A.Name FROM Accounts A WHERE A.AccCode=G.CustCode),
	ComingFrom = GC.ComingFrom,
	StayPeriod = GC.StayPeriod,
	CashCharged = GC.CashCharged,
	PayableAmt = ISNULL((SELECT SUM(GCS.Qty * GCS.SalePrice * (1 - GCS.DiscPerc * 0.01)) FROM GuestCheckInService GCS WHERE GC.GuestCheckInCode = GCS.GuestCheckInCode), 0)
FROM GuestCheckIn GC, Guest G
WHERE GC.GuestCode = G.GuestCode AND GC.CheckInDate BETWEEN :adt_startdate AND :adt_enddate
UNION ALL
SELECT 
	Type = 'CHECK OUT',
	Date=GC.CheckOutDate,
	RegNo = G.RegNo,
	GuestName = G.Name,
	FHName = G.FHName,
	CNIC = G.NIC,
	Mobile = G.Mobile,
	Company = (SELECT A.Name FROM Accounts A WHERE A.AccCode=G.CustCode),
	ComingFrom = GC.ComingFrom,
	StayPeriod = GC.StayPeriod,
	CashCharged = GC.CashCharged,
	PayableAmt = ISNULL((SELECT SUM(GCS.Qty * GCS.SalePrice * (1 - GCS.DiscPerc * 0.01)) FROM GuestCheckInService GCS WHERE GC.GuestCheckInCode = GCS.GuestCheckInCode), 0)
FROM GuestCheckIn GC, Guest G
WHERE GC.CheckOut = 'Y' AND GC.GuestCode = G.GuestCode AND GC.CheckOutDate BETWEEN :adt_startdate AND :adt_enddate
ORDER BY Type, Date"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
)
