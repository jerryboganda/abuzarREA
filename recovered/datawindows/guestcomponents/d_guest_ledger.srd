release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1260 color="536870912" )
summary(height=229 color="536870912" )
footer(height=0 color="536870912" )
detail(height=260 color="536870912"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes name=documentcode dbname="VirtualGl.documentcode"  )
column=(type=char(27) updatewhereclause=yes name=type dbname="type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=guestcode dbname="Guest.GuestCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Guest.RegNo"  )
column=(type=char(100) updatewhereclause=yes name=name dbname="Guest.name"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(100) updatewhereclause=yes name=remark dbname="remark"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="cash"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="VirtualGl.CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VirtualGl.VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VirtualGl.vouchercode"  )
column=(type=char(1) updatewhereclause=yes name=checkout dbname="CheckOut"  )
column=(type=long updatewhereclause=yes name=room dbname="Room"  )
 retrieve="SELECT
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	G.GuestCode,
	G.RegNo, 
	G.name,
	Customer = (SELECT Accounts.Name FROM Accounts WHERE C.CustCode = Accounts.AccCode),
	CustomerCategory = (SELECT CustomerCategory.Name FROM CustomerCategory WHERE CustomerCategory.CustCatCode = C.CustCatCode),
	debit = V.Debit,
	credit= V.Credit,
	remark = V.Remarks,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	CheckOut=
		(SELECT GC.CheckOut FROM GuestCheckIn GC 
		WHERE GC.GuestCode = G.GuestCode AND GC.GuestCheckInCode IN 
			(SELECT GuestCheckInCode=MAX(GuestCheckInCode) FROM GuestCheckIn WHERE GuestCheckIn.GuestCode = G.GuestCode)),
	Room = (SELECT GC.CurrentRoom FROM GuestCheckIn GC 
		WHERE GC.GuestCode = G.GuestCode AND GC.GuestCheckInCode IN 
			(SELECT GuestCheckInCode=MAX(GuestCheckInCode) FROM GuestCheckIn WHERE GuestCheckIn.GuestCode = G.GuestCode))
FROM
	VirtualGL V, Guest G, Customer C
WHERE
	G.GuestCode IN (:ai_Guestcode) AND
	V.GuestCode = G.GuestCode AND 
	V.AccCode = C.CustCode AND
	V.date <= :ad_enddate
ORDER BY
	G.RegNo, G.Name, G.GuestCode, date, type, VRow
"
  arguments=(("ad_enddate", datetime), ("ai_guestcode", numberlist))
 sort="date A, documentcode A, type A, vrow A"
)
