table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="GuestCheckInService.GuestCheckInCode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=currlistrow dbname="currlistrow"  )
column=(type=char(9) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="GuestCheckInService.servicecode"  )
column=(type=long update=yes updatewhereclause=yes name=smancode dbname="GuestCheckInService.smancode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) > 0" validationmsg="~"Please enter valid service qty~"" initial="1" name=qty dbname="GuestCheckInService.qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid service price~"" name=saleprice dbname="GuestCheckInService.saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" initial="0" name=serviceflatdisc dbname="GuestCheckInService.ServiceFlatDisc"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=allowsaleindecimal dbname="AllowSaleInDecimal"  )
column=(type=long updatewhereclause=yes name=rowid dbname="GuestCheckInService.ROWID"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid service discount percentage~"" initial="0" name=discperc dbname="GuestCheckInService.discperc"  )
 retrieve="SELECT 
	GuestCheckInService.GuestCheckInCode,
	itemcode = GuestCheckInService.servicecode,
	itemname= service.name, 
	currlistrow = 0,
	fullcode = '         ',
	GuestCheckInService.servicecode,
	GuestCheckInService.smancode,
	GuestCheckInService.qty,
	GuestCheckInService.saleprice,
	GuestCheckInService.ServiceFlatDisc,
	AllowSaleInDecimal= Service.AllowSaleInDecimal,
	GuestCheckInService.IDentityCOL,
	GuestCheckInService.discperc
FROM GuestCheckInService, Service
WHERE ( GuestCheckInService.GuestCheckInCode = :ai_code )    AND
	( GuestCheckInService.servicecode = service.servicecode )
	"
  update="GuestCheckInService" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
