column=(type=char(100) update=yes updatewhereclause=yes name=reference dbname="Guest.Reference"  )
 retrieve="  SELECT Guest.Name,   
         Guest.GuestCode,   
         Guest.Active,   
         Guest.Date,   
         Guest.RegNo,   
         Guest.CustCode,   
         Guest.UserCode,   
         Guest.Gender,   
         Guest.NIC,   
         Guest.FHName,   
         Guest.Address,   
         Guest.Mobile,   
         Guest.Phone,   
         Guest.Fax,   
         Guest.Email,   
         Guest.Profession,   
         Guest.Nationality,   
         Guest.Passport,   
         Guest.Reference  
    FROM Guest   
"
  update="Guest" updatewhere=1 updatekeyinplace=no
 )
