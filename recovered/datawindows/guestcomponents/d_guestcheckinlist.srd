 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=checkindate dbname="GuestCheckin.CheckInDate"  )
column=(type=long update=yes updatewhereclause=yes name=checkinby dbname="GuestCheckin.CheckInBy" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes name=checkout dbname="GuestCheckin.CheckOut" 
 values="Yes	Y/No	N/"  )
column=(type=datetime update=yes updatewhereclause=yes name=checkoutdate dbname="GuestCheckin.CheckOutDate"  )
column=(type=long update=yes updatewhereclause=yes name=checkoutby dbname="GuestCheckin.CheckOutBy" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="GuestCheckin.Remarks"  )
column=(type=long update=yes updatewhereclause=yes name=cashacccode dbname="GuestCheckin.CashAccCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=cashtendered dbname="GuestCheckin.CashTendered"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=cashcharged dbname="GuestCheckin.CashCharged"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=cashback dbname="GuestCheckin.CashBack"  )
 retrieve="  SELECT GuestCheckin.GuestCheckINCode,   
         GuestCheckin.Date,   
         GuestCheckin.UserCode,   
		RegNo=(SELECT Guest.RegNo FROM Guest WHERE Guest.GuestCode=GuestCheckin.GuestCode),
		GuestName=(SELECT Guest.Name  + ' ('  + Guest.RegNo  + ')' FROM Guest WHERE Guest.GuestCode=GuestCheckin.GuestCode),
         GuestCheckin.GuestCode,   
         GuestCheckin.CurrentRoom,   
         GuestCheckin.CheckInRoom,   
         GuestCheckin.CheckInDate,   
         GuestCheckin.CheckInBy,   
         GuestCheckin.CheckOut,   
         GuestCheckin.CheckOutDate,   
         GuestCheckin.CheckOutBy,   
         GuestCheckin.Remarks,   
         GuestCheckin.CashAccCode,   
         GuestCheckin.CashTendered,   
         GuestCheckin.CashCharged,   
         GuestCheckin.CashBack  
    FROM GuestCheckin  
"
  update="GuestCheckin" updatewhere=1 updatekeyinplace=no
 )
