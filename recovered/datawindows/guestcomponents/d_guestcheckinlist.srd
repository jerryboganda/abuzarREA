table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="GuestCheckin.GuestCheckINCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="GuestCheckin.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="GuestCheckin.UserCode" 
 values=""  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(153) update=yes updatewhereclause=yes name=guestname dbname="GuestName"  )
column=(type=long update=yes updatewhereclause=yes name=guestcode dbname="GuestCheckin.GuestCode"  )
