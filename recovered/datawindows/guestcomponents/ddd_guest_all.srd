release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=char(153) updatewhereclause=yes name=guest dbname="Guest"  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="Guest.RegNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="Guest.Name"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Guest.GuestCode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(1) update=yes updatewhereclause=yes name=active dbname="Guest.Active"  )
column=(type=long updatewhereclause=yes name=guestcheckincode dbname="GuestCheckInCode"  )
 retrieve="  SELECT 
		Guest=Guest.Name + ' (' + Guest.RegNo + ')', 
         Guest.RegNo,   
		Guest.Name,   
         Guest.GuestCode,   
		customer=(select accounts.name from accounts where acccode=Guest.custcode),
         Guest.Active,
		GuestCheckInCode=(SELECT MAX(GC.GuestCheckInCode) FROM GuestCheckIn GC WHERE GC.GuestCode = Guest.GuestCode AND GC.CheckOut='N')
    FROM Guest   
WHERE 	Guestcode in
		(SELECT PP.GuestCode
		FROM Guest PP
		WHERE
			dbo.fn_GetPreference('allowedGuestsintransaction') = 'A'
		UNION 
		SELECT PP.GuestCode
		FROM Guest PP
		WHERE
			dbo.fn_GetPreference('allowedGuestsintransaction') = 'C' AND 	PP.Active = 'Y'
		UNION 
		SELECT PP.GuestCode
		FROM Guest PP, GuestCheckIn PA
		WHERE
			dbo.fn_GetPreference('allowedGuestsintransaction') = 'D' AND
			PP.Active = 'Y' AND
			PP.GuestCode = PA.GuestCode AND
			PA.CheckOut = 'N'	
		UNION 
		SELECT PP.GuestCode
		FROM Guest PP
		WHERE
			dbo.fn_GetPreference('allowedGuestsintransaction') = 'X' AND
			PP.Active = 'Y' AND
			PP.GuestCode NOT IN
				(SELECT DISTINCT PA.GuestCode FROM GuestCheckIn PA WHERE PA.CheckOut='Y'))

"
  update="Guest" updatewhere=1 updatekeyinplace=no
 )
