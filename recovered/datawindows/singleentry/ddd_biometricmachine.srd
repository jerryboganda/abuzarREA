table(column=(type=char(112) updatewhereclause=yes name=biometricmachine dbname="BioMetricMachine"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="BioMetricMachine.Name"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="BioMetricMachine.MachineCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=manufacturer dbname="BioMetricMachine.Manufacturer"  )
column=(type=char(100) update=yes updatewhereclause=yes name=model dbname="BioMetricMachine.Model"  )
column=(type=char(100) update=yes updatewhereclause=yes name=ipaddress dbname="BioMetricMachine.IPAddress"  )
column=(type=long update=yes updatewhereclause=yes name=port dbname="BioMetricMachine.PORT"  )
 retrieve="SELECT 
	BioMetricMachine=BioMetricMachine.Name + '(' + LTRIM(RTRIM(STR(BioMetricMachine.MachineCode,10))) + ')',
	BioMetricMachine.Name,   
	BioMetricMachine.MachineCode,   
	BioMetricMachine.Manufacturer,   
	BioMetricMachine.Model,   
	BioMetricMachine.IPAddress,   
	BioMetricMachine.PORT  
FROM 
	BioMetricMachine  
"
  update="BioMetricMachine" updatewhere=1 updatekeyinplace=no
 )
