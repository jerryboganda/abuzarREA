table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="BioMetricMachine.MachineCode"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="<MACHINE NAME. FOR EXAMPLE DEPARTMENTOR SECTION>" name=name dbname="BioMetricMachine.Name"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="<MANUFACTURER NAME>" name=manufacturer dbname="BioMetricMachine.Manufacturer"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="<MODEL NAME>" name=model dbname="BioMetricMachine.Model"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="192.168.1.201" name=ipaddress dbname="BioMetricMachine.IPAddress"  )
column=(type=long update=yes updatewhereclause=yes initial="4370" name=port dbname="BioMetricMachine.PORT"  )
 retrieve="SELECT 
	BioMetricMachine.MachineCode,   
	BioMetricMachine.Name,   
	BioMetricMachine.Manufacturer,   
	BioMetricMachine.Model,   
	BioMetricMachine.IPAddress,   
	BioMetricMachine.PORT  
FROM 
	BioMetricMachine  
WHERE 
	BioMetricMachine.MachineCode = :ai_code
		
"
  update="BioMetricMachine" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
