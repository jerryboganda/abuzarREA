column=(type=char(20) update=yes updatewhereclause=yes name=email dbname="GoodsCompany.email"  )
 retrieve="SELECT  /*doctor.remarks ,*/
     GC.GCcode, 
     GC.name , 
       
    
     GC.address1,
     GC.address2,
     GC.city,
     GC.country,
     GC.phone,
     GC.fax,
     GC.email
     

FROM GoodsCompany As GC      
WHERE ( GC.GCcode = :ra_GCCode )   "
  update="GoodsCompany" updatewhere=1 updatekeyinplace=no
  arguments=(("ra_GCCode", number))
)
