table(column=(type=long key=yes update=yes updatewhereclause=yes name=messagecode dbname="Message.MessageCode"  )
column=(type=char(50) update=yes updatewhereclause=yes name=description dbname="Message.Description"  )
 retrieve="  SELECT Message.MessageCode,   
         Message.Description  
    FROM Message
/*	UNION   
  SELECT MessageCode=NULL,  
         Description=~"<No Message>~"  */
ORDER BY Message.MessageCode,   
         Message.Description

"
  update="Message" updatewhere=1 updatekeyinplace=no
 )
