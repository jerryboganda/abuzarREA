 retrieve="SELECT 
	GuaranteePerson.GuaranteePersonCode,   
	GuaranteePerson.Name,   
	GuaranteePerson.FHName,   
	GuaranteePerson.Address,   
	GuaranteePerson.Phone,   
	GuaranteePerson.Mobile,   
	GuaranteePerson.Fax,   
	GuaranteePerson.Email,   
	GuaranteePerson.Web,  
	GuaranteePerson.NIC , 
	GuaranteePerson.DOB ,
	GuaranteePerson.ageinyears ,
	GuaranteePerson.Gender , 
	GuaranteePerson.Occupation, 
	GuaranteePerson.monthlyIncome , 
	GuaranteePerson.tempAddress1 , 
	GuaranteePerson.tempAddress2 , 
	GuaranteePerson.OffAddress, 
	GuaranteePerson.Offphone,
	GuaranteePerson.Designation,
	GuaranteePerson.jobduration
FROM 
	GuaranteePerson   
WHERE 
	GuaranteePerson.GuaranteePersonCode = :ai_code
"
  update="GuaranteePerson" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
