table(column=(type=char(12) updatewhereclause=yes name=supplieralias dbname="supplieralias"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="suppliername"  )
column=(type=long key=yes updatewhereclause=yes name=accounts_acccode dbname="Accounts.acccode"  )
column=(type=long update=yes updatewhereclause=yes name=accounts_subcode dbname="Accounts.subcode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=char(12) update=yes updatewhereclause=yes name=accounts_aliasname dbname="Accounts.aliasname"  )
column=(type=datetime update=yes updatewhereclause=yes name=accounts_openingdate dbname="Accounts.openingdate"  )
column=(type=long updatewhereclause=yes name=code dbname="Accounts.suppcode"  )
column=(type=char(60) updatewhereclause=yes name=cp dbname="Accounts.cp"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Accounts.address1"  )
column=(type=char(30) updatewhereclause=yes name=city dbname="Accounts.city"  )
column=(type=char(30) updatewhereclause=yes name=country dbname="Accounts.country"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Accounts.phone"  )
column=(type=char(16) updatewhereclause=yes name=fax dbname="Accounts.fax"  )
column=(type=char(30) updatewhereclause=yes name=email dbname="Accounts.email"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Accounts.address2"  )
column=(type=long updatewhereclause=yes name=suppcatcode dbname="Accounts.suppcatcode" 
 values=""  )
column=(type=long updatewhereclause=yes name=defaultgst dbname="Accounts.defaultgst"  )
column=(type=char(4000) updatewhereclause=yes name=specialinstructions dbname="Accounts.specialinstructions"  )
column=(type=long updatewhereclause=yes name=dayslimit dbname="Accounts.dayslimit"  )
column=(type=char(50) updatewhereclause=yes name=salestaxregno dbname="Accounts.salestaxregno"  )
column=(type=char(50) updatewhereclause=yes name=ntnno dbname="Accounts.ntnno"  )
column=(type=long updatewhereclause=yes name=countycode dbname="Supplier.countycode" 
 values=""  )
column=(type=char(20) updatewhereclause=yes name=postcode dbname="Supplier.postcode"  )
column=(type=char(50) updatewhereclause=yes name=cnic dbname="Supplier.CNIC"  )
column=(type=char(50) updatewhereclause=yes name=mobileno dbname="Supplier.MobileNo"  )
column=(type=char(150) updatewhereclause=yes name=websiteadd dbname="Supplier.WebSiteAdd"  )
column=(type=char(50) updatewhereclause=yes name=phone2 dbname="Supplier.Phone2"  )
column=(type=char(50) updatewhereclause=yes name=email2 dbname="Supplier.EMAIL2"  )
column=(type=char(50) updatewhereclause=yes name=email3 dbname="Supplier.EMAIL3"  )
column=(type=char(100) updatewhereclause=yes name=bankacc dbname="Supplier.BankAcc"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=whperc dbname="Supplier.whperc"  )
 retrieve="SELECT
	supplieralias=accounts.aliasname,
	suppliername = accounts.name,
	accounts.acccode, 
	accounts.subcode , 
	accounts.name ,
	accounts.aliasname,
	accounts.openingdate ,
	suppcode,
	cp,
	address1,
	city,
	country,
	phone,
	fax,
	email,
	address2,
	suppcatcode,
	defaultgst,
	specialinstructions,
	dayslimit,
	salestaxregno,
	ntnno,
	supplier.countycode,
	supplier.postcode,
	supplier.CNIC ,
	supplier.MobileNo ,
	supplier.WebSiteAdd ,
	supplier.Phone2 ,
	supplier.EMAIL2 ,
	supplier.EMAIL3 ,
	supplier.BankAcc,
	supplier.whperc

FROM accounts ,
	supplier     
WHERE
	( supplier.suppcode = accounts.acccode ) and 
	(supplier.suppcatcode IN (:aa_suppcatcode))
order by Accounts.name"
  update="accounts" updatewhere=0 updatekeyinplace=no
  arguments=(("aa_suppcatcode", numberlist))
)
