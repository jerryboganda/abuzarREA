table(column=(type=long updatewhereclause=yes name=tmp dbname="tmp"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SaleType.saletypecode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="SaleType.name"  )
column=(type=char(100) update=yes updatewhereclause=yes name=description dbname="SaleType.description"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=counter dbname="SaleType.Counter"  )
 retrieve="SELECT tmp=1, 
	saletype.saletypecode ,  
	saletype.name,
	saletype.description,
	saletype.Counter
 
FROM saletype

WHERE ( saletype.saletypecode = :ra_saletypecode )   "
  update="saletype" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_saletypecode", number))
)
