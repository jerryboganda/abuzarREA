detail(height=484 color="536870912" )
table(column=(type=long updatewhereclause=yes name=tmp dbname="tmp"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="TimeSlot.tscode"  )
column=(type=long update=yes updatewhereclause=yes name=shiftcode dbname="TimeSlot.shiftcode" 
 values=""  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="TimeSlot.name"  )
column=(type=char(100) update=yes updatewhereclause=yes name=description dbname="TimeSlot.description"  )
 retrieve="  SELECT tmp=1, 
			timeslot.tscode ,  
         timeslot.shiftcode,
         timeslot.name,
			timeslot.description

    FROM TimeSlot      

   WHERE ( timeslot.tscode = :ra_timeslot_code )   "
  update="TimeSlot" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_timeslot_code", number))
)
