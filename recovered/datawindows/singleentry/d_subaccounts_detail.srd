table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SubAccounts.subacccode"  )
column=(type=long update=yes updatewhereclause=yes name=catacccode dbname="SubAccounts.catacccode" 
 values=""  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="SubAccounts.name"  )
column=(type=long updatewhereclause=yes name=mainacccode dbname="MainAccounts.mainacccode" 
 values=""  )
 retrieve="  SELECT dbo.subaccounts.subacccode ,
         dbo.subaccounts.catacccode ,
         dbo.subaccounts.name,
         dbo.mainaccounts.mainacccode
  FROM   dbo.subaccounts, dbo.categoryaccounts, dbo.mainaccounts
  WHERE  dbo.subaccounts.subacccode = :ar_SubCode AND 
			dbo.subaccounts.catacccode = dbo.categoryaccounts.catacccode AND
			dbo.categoryaccounts.mainacccode = dbo.mainaccounts.mainacccode"
  update="subaccounts" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_SubCode", number))
)
