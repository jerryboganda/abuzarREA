table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Doctors.doctcode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Doctors.name"  )
column=(type=char(60) update=yes updatewhereclause=yes name=aliasname dbname="Doctors.aliasname"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=active dbname="Doctors.Active" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=lasttokenno dbname="Doctors.LastTokenNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=address1 dbname="Doctors.address1"  )
column=(type=char(100) update=yes updatewhereclause=yes name=address2 dbname="Doctors.address2"  )
column=(type=char(20) update=yes updatewhereclause=yes name=city dbname="Doctors.city"  )
column=(type=char(25) update=yes updatewhereclause=yes name=country dbname="Doctors.country"  )
column=(type=char(15) update=yes updatewhereclause=yes name=phone dbname="Doctors.phone"  )
column=(type=char(20) update=yes updatewhereclause=yes name=fax dbname="Doctors.fax"  )
column=(type=char(35) update=yes updatewhereclause=yes name=email dbname="Doctors.email"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=fee dbname="Doctors.Fee"  )
column=(type=char(100) update=yes updatewhereclause=yes name=title1 dbname="Doctors.Title1"  )
column=(type=char(100) update=yes updatewhereclause=yes name=title2 dbname="Doctors.Title2"  )
column=(type=char(100) update=yes updatewhereclause=yes name=title3 dbname="Doctors.Title3"  )
column=(type=char(100) update=yes updatewhereclause=yes name=title4 dbname="Doctors.Title4"  )
column=(type=char(100) update=yes updatewhereclause=yes name=footer1 dbname="Doctors.Footer1"  )
column=(type=char(100) update=yes updatewhereclause=yes name=footer2 dbname="Doctors.Footer2"  )
column=(type=char(100) update=yes updatewhereclause=yes name=footer3 dbname="Doctors.Footer3"  )
column=(type=char(100) update=yes updatewhereclause=yes name=footer4 dbname="Doctors.Footer4"  )
column=(type=long update=yes updatewhereclause=yes name=servicetemplatecode dbname="Doctors.ServiceTemplateCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid +ve value~"" initial="9999" name=estpatientcountperday dbname="Doctors.EstPatientCountPerDay"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Time Slot Interval~"" initial="15" name=timeslotinterval dbname="Doctors.TimeSlotInterval"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="Doctors.AccCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=headerno dbname="Doctors.HeaderNo" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=doctorcategorycode dbname="Doctors.DoctorCategoryCode" 
 values=""  )
column=(type=blob updatewhereclause=yes name=blob_1 dbname="Signature"  )
 retrieve="SELECT
	doctcode, 
	name , 
	aliasname,
	Active,
	LastTokenNo,
	address1,
	address2,
	city,
	country,
	phone,
	fax,
	email,
	Fee,
	Title1,
	Title2,
	Title3,
	Title4,
	Footer1,
	Footer2,
	Footer3,
	Footer4,
	ServiceTemplateCode,
	EstPatientCountPerDay,
	TimeSlotInterval,
	AccCode,
	HeaderNo,
	DoctorCategoryCode
FROM doctors      
WHERE ( doctors.doctcode = :ra_doctCode )   "
  update="doctors" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_doctCode", number))
)
