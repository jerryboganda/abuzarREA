table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Resource.ResourceCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Resource.Name"  )
column=(type=long update=yes updatewhereclause=yes name=resourcecatcode dbname="Resource.ResourceCatCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=cost dbname="Resource.Cost"  )
column=(type=char(200) update=yes updatewhereclause=yes name=description dbname="Resource.Description"  )
 retrieve="SELECT
	Resource.ResourceCode,
	Resource.Name,
	Resource.ResourceCatCode,
	Resource.Cost,
	Resource.Description
FROM
	Resource
WHERE
	ResourceCode = :ai_code"
  update="Resource" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
