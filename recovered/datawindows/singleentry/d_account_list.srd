table(column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.aliasname"  )
column=(type=char(60) updatewhereclause=yes name=group dbname="SubAccounts.name"  )
column=(type=long updatewhereclause=yes name=code dbname="Accounts.acccode"  )
column=(type=datetime updatewhereclause=yes name=openingdate dbname="Accounts.OpeningDate"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Accounts.active" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes name=restricted dbname="Accounts.Restricted" 
 values="Yes	Y/No	N/"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="CategoryAccounts.name"  )
column=(type=char(60) updatewhereclause=yes name=type dbname="MainAccounts.name"  )
column=(type=long updatewhereclause=yes name=alertcode dbname="Accounts.alertcode"  )
column=(type=long updatewhereclause=yes name=alerttypecode dbname="alerttypecode"  )
 retrieve="  SELECT accounts.name ,
			accounts.aliasname ,
			subaccounts.name, 
			accounts.acccode ,
         accounts.OpeningDate,
			accounts.active,
			accounts.Restricted,
			categoryaccounts.name,
			mainaccounts.name,
			accounts.alertcode,
			alerttypecode = (SELECT alert.AlertTypeCode FROM Alert WHERE Alert.AlertCode=accounts.alertcode)
    FROM accounts ,
         subaccounts,
			categoryaccounts,
			mainaccounts

   WHERE ( subaccounts.subacccode = accounts.subcode )   and
			( subaccounts.catacccode = categoryaccounts.catacccode )   and
			( categoryaccounts.mainacccode = mainaccounts.mainacccode )"
 )
