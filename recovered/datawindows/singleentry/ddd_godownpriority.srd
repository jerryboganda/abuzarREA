release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=gcode dbname="Godown.GCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Godown.Name"  )
column=(type=long update=yes updatewhereclause=yes name=priority dbname="Priority"  )
 retrieve="SELECT
	Godown.GCode, 
	Godown.Name, 
	Priority= CASE :ai_strategy WHEN 2 THEN 9999 ELSE 
		(SELECT Priority From GroupAllowedGodown
		WHERE	GroupAllowedGodown.GroupCode = :ai_groupcode AND
			GroupAllowedGodown.Module = :ai_module AND
			GroupAllowedGodown.GCode = Godown.GCode) END
FROM	Godown
WHERE	GCode IN
	(CASE :ai_strategy
	WHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = Godown.GCode)
	ELSE (SELECT DISTINCT GCode From GroupAllowedGodown
		WHERE	GroupAllowedGodown.GroupCode = :ai_groupcode AND
			GroupAllowedGodown.Module = :ai_module AND
			GroupAllowedGodown.GCode = Godown.GCode) END)
ORDER BY
	Priority,
	Godown.Name,
	Godown.GCode

/*SELECT Godown.GCode, 
		 Godown.Name,
		 Priority=9999
FROM Godown
WHERE GCode >= CASE :ai_strategy WHEN 2 THEN 0 ELSE 100000 END
UNION ALL
SELECT Godown.GCode, 
		 Godown.Name, 
		 GroupAllowedGodown.Priority
FROM Godown, GroupAllowedGodown
WHERE Godown.GCode >= CASE :ai_strategy WHEN 1 THEN 0 ELSE 100000 END AND
		GroupAllowedGodown.GroupCode = :ai_groupcode AND
		GroupAllowedGodown.Module = :ai_module AND
		Godown.GCode = GroupAllowedGodown.GCode
ORDER BY GroupAllowedGodown.Priority,
			Godown.Name,
			Godown.GCode*/"
  update="Godown" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_groupcode", number), ("ai_module", number), ("ai_strategy", number))
)
