table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long updatewhereclause=yes name=serviceheader_serviceinvcode dbname="ServiceHeader.serviceinvcode"  )
column=(type=datetime updatewhereclause=yes name=serviceheader_date dbname="ServiceHeader.date"  )
column=(type=long updatewhereclause=yes name=headerno dbname="ServiceHeader.headerno"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceheader_discperc dbname="ServiceHeader.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceheader_misccharges dbname="ServiceHeader.misccharges"  )
column=(type=long updatewhereclause=yes name=serviceheader_custcode dbname="ServiceHeader.custcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ServiceHeader.remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="ServiceHeader.flatdisc"  )
column=(type=long updatewhereclause=yes name=reprintcounter dbname="reprintcounter"  )
column=(type=char(60) updatewhereclause=yes name=doctorname dbname="doctorname"  )
column=(type=long updatewhereclause=yes name=service_servicecode dbname="Service.servicecode"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="serviceflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=servicedetail_discperc dbname="servicedetail_discperc"  )
column=(type=char(60) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Patient.regno"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=long updatewhereclause=yes name=ageyears dbname="ageyears"  )
column=(type=long updatewhereclause=yes name=agemonths dbname="agemonths"  )
column=(type=long updatewhereclause=yes name=agedays dbname="agedays"  )
column=(type=long updatewhereclause=yes name=tokenno dbname="tokenno"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceinvtotal dbname="serviceinvtotal"  )
 retrieve="SELECT 
	itemname = service.name,
	reprintdate = getDate(),
	users.username,  
	dbo.serviceheader.serviceinvcode,   
	dbo.serviceheader.date,  
	dbo.serviceheader.headerno,
	dbo.serviceheader.discperc,   
	dbo.serviceheader.misccharges,   
	dbo.serviceheader.custcode,   
	dbo.serviceheader.remarks,
	dbo.serviceheader.flatdisc,
	reprintcounter = dbo.serviceheader.reprintingcounter,
	doctorname=(select name from doctors where doctors.doctcode=serviceheader.doctcode), 
	dbo.service.servicecode,   
	price = dbo.servicedetail.price, 
	serviceflatdisc=servicedetail.serviceflatdisc,
	Qty = dbo.servicedetail.qty,
	servicedetail_discperc = servicedetail.discperc, 
	customername=Accounts.Name,
	patient.regno,
	patient=patient.name,
	ageyears = patient.ageyears,
	agemonths = patient.agemonths,
	agedays = patient.agedays,
	tokenno = dbo.serviceheader.tokenno,
	serviceinvtotal=dbo.fn_getserviceinvtotal(:ra_InvCode)
	
FROM 
	dbo.serviceheader LEFT OUTER JOIN Patient ON (dbo.serviceheader.patientcode = patient.patientcode),   
	dbo.servicedetail,  
	service, 
	users,
	Accounts
	
WHERE 
	( dbo.serviceheader.serviceinvcode = :ra_InvCode ) AND
	( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND 
	( dbo.serviceheader.custcode = dbo.accounts.AccCode ) AND
	( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND
	( servicedetail.servicecode = service.servicecode )
"
  arguments=(("ra_InvCode", number))
)
