text(name=t_17 visible="1" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" alignment="0" border="0" x="50" y="2800" height="316" width="3258" text="5. Students will not be allowed to attend class if dues are not paid within due date." html.valueishtml="0" )
text(name=t_16 visible="1" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" alignment="0" border="0" x="58" y="2433" height="325" width="3250" text="4. One month notice in writing is required for the withdrawal of a child to make you eligible for security refund." html.valueishtml="0" )
