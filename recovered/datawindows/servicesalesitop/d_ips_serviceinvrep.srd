column=(type=decimal(2) updatewhereclause=yes name=studentbalance dbname="StudentBalance"  )
 retrieve="SELECT 
	itemname = service.name,
	users.username,  
	accounts.name, 
	reprintdate = getDate(),
	ReprintingCounter = dbo.ServiceHeader.ReprintingCounter,
	code=dbo.serviceheader.serviceinvcode,   
	date=dbo.serviceheader.date,  
	duedate=dbo.serviceheader.duedate,  
	headerno=dbo.serviceheader.headerno, 
	invdiscperc=dbo.serviceheader.discperc,  
	flatdisc=dbo.serviceheader.flatdisc,	 
	misccharges=dbo.serviceheader.misccharges,   
	custcode=dbo.serviceheader.custcode,   
	remarks=dbo.serviceheader.remarks,
	servicecode=dbo.service.servicecode,   
	price = dbo.servicedetail.price, 
	serviceflatdisc = dbo.servicedetail.serviceflatdisc, 
	Qty = dbo.servicedetail.qty,
	discperc = dbo.servicedetail.discperc,
	RegNo = Student.Regno,
	StudentCode = Student.StudentCode,
	StudentName=Student.Name,
	FatherName=Student.FName,
	SchoolName = (SELECT SC.Name FROM School SC, Class C WHERE C.ClassCode = Student.CurrentClass AND SC.SchoolCode = C.SchoolCode),
	Class = (SELECT G.Name FROM Grade G, Class C WHERE C.ClassCode = Student.CurrentClass AND C.GradeCode = G.GradeCode),
	Section = (SELECT LTRIM(RTRIM(SUBSTRING(C.Name, CHARINDEX(',', C.Name, 1)+1, CHARINDEX(',', SUBSTRING(C.Name, CHARINDEX(',', C.Name, 1)-1, LEN(C.Name)),1)))) FROM Class C WHERE C.ClassCode = Student.CurrentClass),
	Medium = (SELECT CM.Name FROM Class C, ClassMedium CM WHERE C.ClassCode = Student.CurrentClass AND C.ClassMediumCode = CM.ClassMediumCode),
	RollNo = (SELECT SC.RollNo FROM Class C, StudentClass SC
		WHERE Student.Studentcode = SC.StudentCode AND 
			Student.CurrentClass=C.ClassCode AND
			C.ClassCode = SC.ClassCode),
	StudentBalance= ISNULL(
		(SELECT Balance=SUM(V.Debit - V.Credit)
		FROM
			VirtualGL V,
			Accounts A,
			Customer C,
			SubAccounts S,
			Student P,
			ServiceHeader SH
		WHERE 
			SH.ServiceInvCode = :ra_InvCode AND
			SH.StudentCode = P.StudentCode AND
			P.StudentCode = V.StudentCode AND
			V.Date < SH.Date AND 
			V.AccCode = A.AccCode AND
			A.AccCode = C.CustCode AND
			V.AccCode = C.CustCode AND
			A.SubCode = S.SubAccCode 
		GROUP BY 
			P.StudentCode), 0)
FROM 
	dbo.serviceheader LEFT OUTER JOIN Student ON (dbo.serviceheader.studentcode = student.studentcode),   
	dbo.servicedetail,  
	service, 
	customer, 
	accounts,
	users
WHERE 
	( dbo.serviceheader.serviceinvcode = :ra_InvCode ) AND
	( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND 
	( dbo.serviceheader.custcode = dbo.customer.custcode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND
	( servicedetail.servicecode = service.servicecode ) 
ORDER BY itemname

/*
SELECT
	itemname = S.Name,
	UserName = (SELECT U.UserName FROM Users U, ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode AND SH.SalesManCode = U.UserCode),
	AliasName = (SELECT A.AliasName FROM Accounts A, ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode AND SH.CustCode = A.AccCode),
	Name = (SELECT A.Name FROM Accounts A, ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode AND SH.CustCode = A.AccCode),
	reprintdate = GETDATE(),
	ReprintingCounter = (SELECT SH.ReprintingCounter FROM ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode),
	Code = (SELECT SH.ServiceInvCode FROM ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode),
	Date = (SELECT SH.date FROM ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode),
	DueDate = (SELECT SH.Duedate FROM ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode),
	headerno = (SELECT SH.headerno FROM ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode),
	invdiscperc = (SELECT SH.discperc FROM ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode),
	flatdisc = (SELECT SH.flatdisc FROM ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode),
	misccharges = (SELECT SH.misccharges FROM ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode),
	CustCode = (SELECT SH.CustCode FROM ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode),
	remarks = (SELECT SH.remarks FROM ServiceHeader SH WHERE SH.ServiceInvCode = :ra_InvCode),
	S.ServiceCode,
	price = (SELECT MAX(SD.Price) FROM ServiceHeader SH, ServiceDetail SD WHERE SH.ServiceInvCode = :ra_InvCode AND SH.ServiceInvCode = SD.ServiceInvCode AND SD.ServiceCode = S.ServiceCode), 
	serviceflatdisc = (SELECT MAX(SD.serviceflatdisc) FROM ServiceHeader SH, ServiceDetail SD WHERE SH.ServiceInvCode = :ra_InvCode AND SH.ServiceInvCode = SD.ServiceInvCode AND SD.ServiceCode = S.ServiceCode), 
	Qty = (SELECT MAX(SD.Qty) FROM ServiceHeader SH, ServiceDetail SD WHERE SH.ServiceInvCode = :ra_InvCode AND SH.ServiceInvCode = SD.ServiceInvCode AND SD.ServiceCode = S.ServiceCode), 
	discperc = (SELECT MAX(SD.discperc) FROM ServiceHeader SH, ServiceDetail SD WHERE SH.ServiceInvCode = :ra_InvCode AND SH.ServiceInvCode = SD.ServiceInvCode AND SD.ServiceCode = S.ServiceCode), 
	RegNo = (SELECT ST.Regno FROM ServiceHeader SH, Student ST WHERE SH.ServiceInvCode = :ra_InvCode AND SH.StudentCode=ST.StudentCode),
	StudentCode = (SELECT ST.StudentCode FROM ServiceHeader SH, Student ST WHERE SH.ServiceInvCode = :ra_InvCode AND SH.StudentCode=ST.StudentCode),
	StudentName = (SELECT ST.Name FROM ServiceHeader SH, Student ST WHERE SH.ServiceInvCode = :ra_InvCode AND SH.StudentCode=ST.StudentCode),
	FatherName = (SELECT ST.FName FROM ServiceHeader SH, Student ST WHERE SH.ServiceInvCode = :ra_InvCode AND SH.StudentCode=ST.StudentCode),
	SchoolName = (SELECT SC.Name FROM ServiceHeader SH, Student ST, School SC, Class C WHERE SH.ServiceInvCode = :ra_InvCode AND SH.StudentCode=ST.StudentCode AND C.ClassCode = ST.CurrentClass AND SC.SchoolCode = C.SchoolCode),
	Grade = (SELECT G.Name FROM ServiceHeader SH, Student ST, Grade G, Class C WHERE SH.ServiceInvCode = :ra_InvCode AND SH.StudentCode=ST.StudentCode AND C.ClassCode = ST.CurrentClass AND C.GradeCode = G.GradeCode),
	Class = (SELECT C.Name FROM ServiceHeader SH, Student ST, Grade G, Class C WHERE SH.ServiceInvCode = :ra_InvCode AND SH.StudentCode=ST.StudentCode AND C.ClassCode = ST.CurrentClass AND C.GradeCode = G.GradeCode),
	Section = (SELECT LTRIM(RTRIM(SUBSTRING(C.Name, CHARINDEX(',', C.Name, 1)+1, CHARINDEX(',', SUBSTRING(C.Name, CHARINDEX(',', C.Name, 1)-1, LEN(C.Name)),1))))  FROM ServiceHeader SH, Student ST, Class C WHERE SH.ServiceInvCode = :ra_InvCode AND SH.StudentCode=ST.StudentCode AND C.ClassCode = ST.CurrentClass),
	Medium = (SELECT CM.Name FROM ServiceHeader SH, Student ST, Class C, ClassMedium CM WHERE SH.ServiceInvCode = :ra_InvCode AND SH.StudentCode=ST.StudentCode AND C.ClassCode = ST.CurrentClass AND C.ClassMediumCode = CM.ClassMediumCode),
	RollNo = (SELECT SC.RollNo FROM ServiceHeader SH, Student ST, Class C, StudentClass SC WHERE SH.ServiceInvCode = :ra_InvCode AND SH.StudentCode=ST.StudentCode AND C.ClassCode = ST.CurrentClass AND ST.Studentcode = SC.StudentCode AND ST.CurrentClass=C.ClassCode AND C.ClassCode = SC.ClassCode)
FROM ServiceTemplateHeader H, ServiceTemplateDetail D, Service S
WHERE H.ServiceTemplateCode = 1 AND 
	H.ServiceTemplateCode = D.ServiceTemplateCode AND
	D.ServiceCode = S.ServiceCode
ORDER BY RowID
*/"
  arguments=(("ra_InvCode", number))
)
