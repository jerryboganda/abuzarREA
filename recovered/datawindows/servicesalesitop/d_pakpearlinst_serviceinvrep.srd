table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=long updatewhereclause=yes name=reprintingcounter dbname="ReprintingCounter"  )
column=(type=long updatewhereclause=yes name=code dbname="code"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="duedate"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=long updatewhereclause=yes name=serviceheader_custcode dbname="custcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=service_servicecode dbname="servicecode"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="serviceflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
