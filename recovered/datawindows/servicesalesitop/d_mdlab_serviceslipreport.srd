summary(height=0 color="536870912" )
footer(height=520 color="536870912" )
detail(height=1333 color="536870912"  height.autosize=yes)
table(column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=long updatewhereclause=yes name=serviceinvcode1 dbname="serviceinvcode"  )
column=(type=char(100) updatewhereclause=yes name=patientrefby dbname="patientrefby"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=servicecatcode dbname="servicecatcode"  )
column=(type=datetime updatewhereclause=yes name=deliverydate dbname="deliverydate"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender"  )
column=(type=char(39) updatewhereclause=yes name=age dbname="Age"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="servicecode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=servicecategory dbname="ServiceCategory"  )
column=(type=long identity=yes updatewhereclause=yes name=srvrowid dbname="SrvRowid"  )
column=(type=char(100) updatewhereclause=yes name=sampletype dbname="SampleType"  )
 retrieve="SELECT 
	username=users.username,  
	serviceinvcode=dbo.serviceheader.serviceinvcode,
	patientrefby=dbo.serviceheader.patientrefby,
	Date=dbo.serviceheader.date,  
	headerno=dbo.serviceheader.headerno,
	custcode=dbo.serviceheader.custcode,   
	remarks=dbo.serviceheader.remarks,
	servicecatcode=dbo.serviceheader.servicecatcode,
	deliverydate = dbo.servicedetail.deliverydate,
	customername=(SELECT Accounts.Name FROM Accounts WHERE Accounts.AccCode  = serviceheader.Custcode),
	regno=patient.regno,
	patient=patient.name,
	Gender = patient.gender, 
	Age=LTRIM(RTRIM(STR(DATEDIFF(yyyy, Patient.DOB, getdate()), 4, 0))) + ' Year(s) ' +
		LTRIM(RTRIM(STR(DATEDIFF(dd, Patient.DOB, getdate()) % 360 / 30, 4, 0))) + ' Month(s) ' +
		LTRIM(RTRIM(STR(DATEDIFF(dd, Patient.DOB, getdate()) % 360 % 30, 4, 0))) + ' Day(s) ',
	servicecode=dbo.service.servicecode,   
	itemname = service.name,
	ServiceCategory = ServiceCategory.Name,
	SrvRowid=dbo.servicedetail.SrvRowid,
	SampleType = (SELECT MAX(SM.Name) FROM ServiceSampleRequirement SSR, SampleType SM WHERE SM.SampleTypeCode = SSR.SampleTypeCode AND SSR.ServiceCode = Service.ServiceCode)
FROM 
	dbo.serviceheader LEFT OUTER JOIN Patient ON (dbo.serviceheader.patientcode = patient.patientcode),   
	dbo.servicedetail,  
	service, 
	ServiceCategory,
	users
WHERE 
	( dbo.serviceheader.serviceinvcode = :ra_InvCode ) AND
	( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND 
	( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND
	( servicedetail.servicecode = service.servicecode ) AND
	( Service.ServiceCatCode = ServiceCategory.ServiceCatCode )
ORDER BY
	ServiceCategory.Name,
	Service.Name"
  arguments=(("ra_InvCode", number))
 sort="serviceinvcode1 A, srvrowid A"
)
