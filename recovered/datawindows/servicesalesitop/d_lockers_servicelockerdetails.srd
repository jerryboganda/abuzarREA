header(height=134 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=58 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=serviceinvcode dbname="ServiceLockerDetail.ServiceInvCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ServiceLockerDetail.ICode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=qty dbname="ServiceLockerDetail.Qty"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="ServiceLockerDetail.Remarks"  )
 retrieve="SELECT 
	ServiceLockerDetail.ServiceInvCode,   
	ServiceLockerDetail.ICode,   
	ItemName = (SELECT I.Name FROM Item I WHERE I.ICode = ServiceLockerDetail.ICode),
	ServiceLockerDetail.Qty,   
	ServiceLockerDetail.Remarks  
FROM 
	ServiceLockerDetail  
WHERE 
	ServiceLockerDetail.ServiceInvCode = :ai_code   
ORDER BY 
	ItemName		
"
  update="ServiceLockerDetail" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
