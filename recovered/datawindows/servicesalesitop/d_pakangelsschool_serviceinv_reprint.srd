table(column=(type=long updatewhereclause=yes name=pageid dbname="PageID"  )
column=(type=char(11) updatewhereclause=yes name=page dbname="Page"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="username"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=long updatewhereclause=yes name=reprintcount dbname="reprintcount"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="serviceinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="duedate"  )
column=(type=char(30) updatewhereclause=yes name=billmonth dbname="BillMonth"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceheader_misccharges dbname="misccharges"  )
column=(type=long updatewhereclause=yes name=serviceheader_custcode dbname="custcode"  )
column=(type=char(100) updatewhereclause=yes name=serviceheader_remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=service_servicecode dbname="servicecode"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="serviceflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(100) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=char(100) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=char(100) updatewhereclause=yes name=schoolname dbname="SchoolName"  )
column=(type=long updatewhereclause=yes name=classcode dbname="ClassCode"  )
column=(type=char(100) updatewhereclause=yes name=class dbname="Class"  )
column=(type=char(100) updatewhereclause=yes name=shortname dbname="ShortName"  )
column=(type=char(100) updatewhereclause=yes name=section dbname="Section"  )
column=(type=char(100) updatewhereclause=yes name=medium dbname="Medium"  )
column=(type=char(40) updatewhereclause=yes name=rollno dbname="RollNo"  )
column=(type=long updatewhereclause=yes name=rowid dbname="RowId"  )
 retrieve="SELECT
	PageID,
	Page,
	itemname,
	username, 
	customer,
	reprintdate,
	reprintcount,
	serviceinvcode, 
	date,  
	duedate,  
	BillMonth,
	headerno,
	invdiscperc,  
	flatdisc,	 
	misccharges,   
	custcode,   
	remarks,
	servicecode   ,
	price, 
	serviceflatdisc, 
	Qty,
	discperc,
	RegNo,
	StudentCode,
	StudentName,
	FatherName,
	SchoolName,
	ClassCode,
	Class,
	ShortName,
	Section,
	Medium,
	RollNo,
	RowId
FROM
	(SELECT 
		PageID=1,
		Page = 'Bank Copy',
		itemname = service.name,
		users.username,  
		customer=accounts.name, 
		reprintdate = getDate(),
		reprintcount = dbo.ServiceHeader.ReprintingCounter,
		dbo.serviceheader.serviceinvcode,   
		dbo.serviceheader.date,  
		duedate=dbo.serviceheader.duedate,  
		BillMonth = DATENAME(mm,dbo.serviceheader.duedate),
		dbo.serviceheader.headerno, 
		invdiscperc=dbo.serviceheader.discperc,  
		dbo.serviceheader.flatdisc,	 
		dbo.serviceheader.misccharges,   
		dbo.serviceheader.custcode,   
		dbo.serviceheader.remarks,
		dbo.service.servicecode,   
		price = dbo.servicedetail.price, 
		serviceflatdisc = dbo.servicedetail.serviceflatdisc, 
		Qty = dbo.servicedetail.qty,
		discperc = dbo.servicedetail.discperc,
		RegNo = (SELECT Student.Regno FROM Student WHERE  dbo.serviceheader.studentcode = student.studentcode),
		StudentCode = serviceheader.StudentCode,
		StudentName=(SELECT Student.Name FROM Student WHERE  dbo.serviceheader.studentcode = student.studentcode),
		FatherName=(SELECT Student.FName FROM Student WHERE  dbo.serviceheader.studentcode = student.studentcode),
		SchoolName = (SELECT MAX(SC.Name) FROM School SC, Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass AND SC.SchoolCode = C.SchoolCode),
		ClassCode = (SELECT MAX(C.ClassCode) FROM Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass),
		Class = (SELECT MAX(G.Name) FROM Grade G, Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass AND C.GradeCode = G.GradeCode),
		ShortName = (SELECT MAX(C.ShortName) FROM Grade G, Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass AND C.GradeCode = G.GradeCode),
		Section = (SELECT MAX(LTRIM(RTRIM(SUBSTRING(C.Name, CHARINDEX(',', C.Name, 1)+1, CHARINDEX(',', SUBSTRING(C.Name, CHARINDEX(',', C.Name, 1)-1, LEN(C.Name)),1))))) FROM Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass),
		Medium = (SELECT MAX(CM.Name) FROM Class C, ClassMedium CM, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass AND C.ClassMediumCode = CM.ClassMediumCode),
		RollNo = (SELECT MAX(SC.RollNo) FROM Class C, StudentClass SC, Student 
			WHERE dbo.serviceheader.studentcode = student.studentcode AND Student.Studentcode = SC.StudentCode AND 
				Student.CurrentClass=C.ClassCode AND
				C.ClassCode = SC.ClassCode),
		RowId=servicedetail.srvrowid
	FROM 
		dbo.serviceheader,   
		dbo.servicedetail,  
		service, 
		customer, 
		accounts,
		users
	WHERE 
		( dbo.serviceheader.serviceinvcode BETWEEN :ra_SInvCode AND :ra_LInvCode) AND
		( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND 
		( dbo.serviceheader.custcode = dbo.customer.custcode ) AND 
		( dbo.customer.custcode = dbo.accounts.acccode ) AND 
		( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND
		( servicedetail.servicecode = service.servicecode ) 
	UNION ALL
	SELECT 
		PageID=2,
		Page = 'School Copy',
		itemname = service.name,
		users.username,  
		accounts.name, 
		reprintdate = getDate(),
		reprintcount = dbo.ServiceHeader.ReprintingCounter,
		dbo.serviceheader.serviceinvcode,   
		dbo.serviceheader.date,  
		duedate=dbo.serviceheader.duedate,  
		BillMonth = DATENAME(mm,dbo.serviceheader.duedate),
		dbo.serviceheader.headerno, 
		invdiscperc=dbo.serviceheader.discperc,  
		dbo.serviceheader.flatdisc,	 
		dbo.serviceheader.misccharges,   
		dbo.serviceheader.custcode,   
		dbo.serviceheader.remarks,
		dbo.service.servicecode,   
		price = dbo.servicedetail.price, 
		serviceflatdisc = dbo.servicedetail.serviceflatdisc, 
		Qty = dbo.servicedetail.qty,
		discperc = dbo.servicedetail.discperc,
		RegNo = (SELECT Student.Regno FROM Student WHERE  dbo.serviceheader.studentcode = student.studentcode),
		StudentCode = serviceheader.StudentCode,
		StudentName=(SELECT Student.Name FROM Student WHERE  dbo.serviceheader.studentcode = student.studentcode),
		FatherName=(SELECT Student.FName FROM Student WHERE  dbo.serviceheader.studentcode = student.studentcode),
		SchoolName = (SELECT MAX(SC.Name) FROM School SC, Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass AND SC.SchoolCode = C.SchoolCode),
		ClassCode = (SELECT MAX(C.ClassCode) FROM Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass),
		Class = (SELECT MAX(G.Name) FROM Grade G, Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass AND C.GradeCode = G.GradeCode),
		ShortName = (SELECT MAX(C.ShortName) FROM Grade G, Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass AND C.GradeCode = G.GradeCode),
		Section = (SELECT MAX(LTRIM(RTRIM(SUBSTRING(C.Name, CHARINDEX(',', C.Name, 1)+1, CHARINDEX(',', SUBSTRING(C.Name, CHARINDEX(',', C.Name, 1)-1, LEN(C.Name)),1))))) FROM Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass),
		Medium = (SELECT MAX(CM.Name) FROM Class C, ClassMedium CM, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass AND C.ClassMediumCode = CM.ClassMediumCode),
		RollNo = (SELECT MAX(SC.RollNo) FROM Class C, StudentClass SC, Student 
			WHERE dbo.serviceheader.studentcode = student.studentcode AND Student.Studentcode = SC.StudentCode AND 
				Student.CurrentClass=C.ClassCode AND
				C.ClassCode = SC.ClassCode),
		RowId=servicedetail.srvrowid
	FROM 
		dbo.serviceheader,   
		dbo.servicedetail,  
		service, 
		customer, 
		accounts,
		users
	WHERE 
		( dbo.serviceheader.serviceinvcode BETWEEN :ra_SInvCode AND :ra_LInvCode) AND
		( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND 
		( dbo.serviceheader.custcode = dbo.customer.custcode ) AND 
		( dbo.customer.custcode = dbo.accounts.acccode ) AND 
		( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND
		( servicedetail.servicecode = service.servicecode ) 
	UNION ALL
	SELECT 
		PageID=3,
		Page = 'Parent Copy',
		itemname = service.name,
		users.username,  
		accounts.name, 
		reprintdate = getDate(),
		reprintcount = dbo.ServiceHeader.ReprintingCounter,
		dbo.serviceheader.serviceinvcode,   
		dbo.serviceheader.date,  
		duedate=dbo.serviceheader.duedate,  
		BillMonth = DATENAME(mm,dbo.serviceheader.duedate),
		dbo.serviceheader.headerno, 
		invdiscperc=dbo.serviceheader.discperc,  
		dbo.serviceheader.flatdisc,	 
		dbo.serviceheader.misccharges,   
		dbo.serviceheader.custcode,   
		dbo.serviceheader.remarks,
		dbo.service.servicecode,   
		price = dbo.servicedetail.price, 
		serviceflatdisc = dbo.servicedetail.serviceflatdisc, 
		Qty = dbo.servicedetail.qty,
		discperc = dbo.servicedetail.discperc,
		RegNo = (SELECT Student.Regno FROM Student WHERE  dbo.serviceheader.studentcode = student.studentcode),
		StudentCode = serviceheader.StudentCode,
		StudentName=(SELECT Student.Name FROM Student WHERE  dbo.serviceheader.studentcode = student.studentcode),
		FatherName=(SELECT Student.FName FROM Student WHERE  dbo.serviceheader.studentcode = student.studentcode),
		SchoolName = (SELECT MAX(SC.Name) FROM School SC, Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass AND SC.SchoolCode = C.SchoolCode),
		ClassCode = (SELECT MAX(C.ClassCode) FROM Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass),
		Class = (SELECT MAX(G.Name) FROM Grade G, Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass AND C.GradeCode = G.GradeCode),
		ShortName = (SELECT MAX(C.ShortName) FROM Grade G, Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass AND C.GradeCode = G.GradeCode),
		Section = (SELECT MAX(LTRIM(RTRIM(SUBSTRING(C.Name, CHARINDEX(',', C.Name, 1)+1, CHARINDEX(',', SUBSTRING(C.Name, CHARINDEX(',', C.Name, 1)-1, LEN(C.Name)),1))))) FROM Class C, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass),
		Medium = (SELECT MAX(CM.Name) FROM Class C, ClassMedium CM, Student WHERE dbo.serviceheader.studentcode = student.studentcode AND C.ClassCode = Student.CurrentClass AND C.ClassMediumCode = CM.ClassMediumCode),
		RollNo = (SELECT MAX(SC.RollNo) FROM Class C, StudentClass SC, Student 
			WHERE dbo.serviceheader.studentcode = student.studentcode AND Student.Studentcode = SC.StudentCode AND 
				Student.CurrentClass=C.ClassCode AND
				C.ClassCode = SC.ClassCode),
		RowId=servicedetail.srvrowid
	FROM 
		dbo.serviceheader,   
		dbo.servicedetail,  
		service, 
		customer, 
		accounts,
		users
	WHERE 
		( dbo.serviceheader.serviceinvcode BETWEEN :ra_SInvCode AND :ra_LInvCode) AND
		( dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode ) AND 
		( dbo.serviceheader.custcode = dbo.customer.custcode ) AND 
		( dbo.customer.custcode = dbo.accounts.acccode ) AND 
		( dbo.serviceheader.salesmancode = dbo.users.usercode ) AND
		( servicedetail.servicecode = service.servicecode ) ) T
WHERE 
	ClassCode IN (:ra_classcode)
ORDER BY 
	serviceinvcode, 
	PageID,
	RowID
	
	
"
  arguments=(("ra_SInvCode", number), ("ra_LInvCode", number), ("ra_classcode", numberlist))
)
group(level=1 header.height=845 trailer.height=1622 by=("serviceinvcode" "pageid"  ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.length="100" header.gradient.repetition.count="0" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.length="100" trailer.gradient.repetition.count="0" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" newpage=yes resetpagecount=yes )
