detail(height=183 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=long updatewhereclause=yes name=icode dbname="Item.Icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=manf dbname="manf"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=decimal(13) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(4) updatewhereclause=yes name=openqty dbname="openqty"  )
column=(type=decimal(6) updatewhereclause=yes name=openvalue dbname="openvalue"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalue dbname="PurValue"  )
column=(type=decimal(4) updatewhereclause=yes name=pretqty dbname="PRetQty"  )
column=(type=decimal(6) updatewhereclause=yes name=pretvalue dbname="PRetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(4) updatewhereclause=yes name=sretqty dbname="SRetQty"  )
column=(type=decimal(6) updatewhereclause=yes name=sretvalue dbname="SRetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=issueqty dbname="IssueQty"  )
column=(type=decimal(6) updatewhereclause=yes name=issuevalue dbname="IssueValue"  )
column=(type=decimal(4) updatewhereclause=yes name=duesatisfyqty dbname="DueSatisfyQty"  )
column=(type=decimal(6) updatewhereclause=yes name=duesatisfyvalue dbname="DueSatisfyValue"  )
column=(type=decimal(4) updatewhereclause=yes name=receiptqty dbname="ReceiptQty"  )
column=(type=decimal(6) updatewhereclause=yes name=receiptvalue dbname="ReceiptValue"  )
column=(type=decimal(4) updatewhereclause=yes name=adjqty dbname="AdjQty"  )
column=(type=decimal(6) updatewhereclause=yes name=adjvalue dbname="AdjValue"  )
column=(type=decimal(4) updatewhereclause=yes name=transferinqty dbname="TransferINQty"  )
column=(type=decimal(6) updatewhereclause=yes name=transferinvalue dbname="TransferINValue"  )
column=(type=decimal(4) updatewhereclause=yes name=transferoutqty dbname="TransferOutQty"  )
column=(type=decimal(6) updatewhereclause=yes name=transferoutvalue dbname="TransferOutValue"  )
 retrieve="SELECT 
	Godown = (SELECT Godown.Name FROM Godown WHERE Godown.GCode = :ar_gcode),
	St.Icode,
	AliasName= i.customicode,
	Item = i.name, 
	Code = i.icatcode,
	packingdesc=max(i.packingdesc),
	manf=(select name from manufacturer where manufacturer.manfcode=max(i.manfcode)),
	Name = ic.Name,
	Rate = Round(i.saleprice/case when i.packunits > 0 THEN i.packunits ELSE 1 END, 2),
	openqty	  =SUM(CASE WHEN type='OP' THEN qty ELSE 0 END),
	openvalue =SUM(CASE WHEN type='OP' THEN value ELSE 0 END),
	PurQty 	  =SUM(CASE WHEN type='PV' THEN qty ELSE 0 END),
	PurValue  =SUM(CASE WHEN type='PV' THEN value ELSE 0 END),
	PRetQty	  =SUM(CASE WHEN type='PR' THEN qty ELSE 0 END),
	PRetValue =SUM(CASE WHEN type='PR' THEN value ELSE 0 END),
	SaleQty	  =SUM(CASE WHEN type='SV' THEN qty ELSE 0 END),
	SaleValue =SUM(CASE WHEN type='SV' THEN value ELSE 0 END),
	SRetQty	  =SUM(CASE WHEN type='SR' THEN qty ELSE 0 END),
	SRetValue =SUM(CASE WHEN type='SR' THEN value ELSE 0 END),
	IssueQty  =SUM(CASE WHEN type='IV' THEN qty ELSE 0 END),
	IssueValue=SUM(CASE WHEN type='IV' THEN value ELSE 0 END),
	DueSatisfyQty  =SUM(CASE WHEN type='DS' THEN qty ELSE 0 END),
	DueSatisfyValue=SUM(CASE WHEN type='DS' THEN value ELSE 0 END),
	ReceiptQty=SUM(CASE WHEN type='RV' THEN qty ELSE 0 END),
	ReceiptValue=SUM(CASE WHEN type='RV' THEN value ELSE 0 END),
	AdjQty	  =SUM(CASE WHEN type='AI' THEN qty 
								WHEN type='AD' THEN -qty 
								ELSE 0 END),
	AdjValue  =SUM(CASE  WHEN type='AI' THEN value 
								WHEN type='AD' THEN -value  
								ELSE 0 END),
	TransferINQty  =SUM(CASE WHEN type='TI' THEN qty ELSE 0 END),
	TransferINValue=SUM(CASE WHEN type='TI' THEN value ELSE 0 END),
	TransferOutQty  =SUM(CASE WHEN type='TO' THEN qty ELSE 0 END),
	TransferOutValue=SUM(CASE WHEN type='TO' THEN value ELSE 0 END)
FROM
	(SELECT type='OP', icode, qty = sum(qty), value=0
	FROM	(select	pd.icode, qty = sum(isnull(case pl.purcatcode 
			when 1 THEN (packqty + bonusqty) * packunits
			when 2 THEN (packqty + bonusqty) * packunits
			else looseqty + bonusqty end, 0))
	FROM purledger pl, purdetail pd
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pd.Gcode = :ar_gcode AND
		pl.postdate < :ar_startdate
	Group By pd.icode
	UNION ALL
	select	pd.icode,
		qty  = - sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits)
	FROM prledger pl, prdetail pd
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
		pd.Gcode = :ar_gcode AND
		pl.date < :ar_startdate
	Group By pd.icode
	UNION ALL
	select	sd.icode,
		qty  = -sum(sd.looseqty + sd.bonusqty)
	FROM saleledger sl, saledetail sd
	WHERE /*sl.posted = 'Y' AND*/ sl.saleinvcode = sd.saleinvcode AND
		sd.Gcode = :ar_gcode AND
		sl.date < :ar_startdate AND sd.Due IS NULL
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = sum(sd.looseqty + sd.bonusqty)
	FROM srledger sl, srdetail sd
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
			sd.Gcode = :ar_gcode AND
	      sl.postdate < :ar_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = -sum(sd.qty)
	FROM issueheader sl, issuedetail sd
	WHERE /*sl.posted = 'Y' AND*/ sl.issueinvcode = sd.issueinvcode AND
			sd.Gcode = :ar_gcode AND
	      sl.date < :ar_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = sum(sd.qty)
	FROM receiptheader sl, receiptdetail sd
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
		sd.Gcode = :ar_gcode AND
		sl.postdate < :ar_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty = sum(sd.looseqty)
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		sd.Gcode = :ar_gcode AND
		sl.posteddate < :ar_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty = -sum(sd.looseqty)
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		sd.Gcode = :ar_gcode AND
		sl.date < :ar_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode, qty = -sum(sd.qty)
	FROM THeader sl, TDetail sd
	WHERE sl.posted = 'Y' AND sl.Transcode = sd.Transcode and 
		sl.SGcode = :ar_gcode AND
		sl.postdate < :ar_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode, qty = sum(sd.qty)
	FROM THeader sl, TDetail sd
	WHERE sl.posted = 'Y' AND sl.Transcode = sd.Transcode and 
		sl.DGcode = :ar_gcode AND
		sl.postdate < :ar_startdate
	Group By sd.icode
	UNION ALL
	select	d.icode,
		qty = -sum(d.duesatisfyqty)
	FROM duesatisfyheader h, duesatisfydetail d
	WHERE h.duesatisfycode=d.duesatisfycode AND
			d.Gcode = :ar_gcode AND
	      h.duesatisfydate < :ar_startdate
	Group By d.icode) A
	GROUP BY icode
	UNION ALL
	select	type='PV',
		pd.icode,
		qty = sum(case pl.purcatcode when 1 THEN (packqty + bonusqty) * packunits
				when 2 THEN (packqty + bonusqty) * packunits
				else (looseqty + bonusqty) end),
		value = sum(isnull(case pl.purcatcode 
			when 1 THEN (packqty + bonusqty)
			when 2 THEN (packqty + bonusqty)
			else looseqty + bonusqty 
			end, 0) * pd.purprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01))
	FROM purledger pl, purdetail pd
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pd.Gcode = :ar_gcode AND
		pl.postdate BETWEEN :ar_startdate and :ar_enddate
	Group By pd.icode
	UNION ALL
	select	type='PR',
		pd.icode,
		qty = sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits),
		value = sum((pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits) *
			pd.prprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01))
	FROM prledger pl, prdetail pd
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
			pd.Gcode = :ar_gcode AND
	      pl.date BETWEEN :ar_startdate and :ar_enddate
	Group By pd.icode
	UNION ALL
	select	type='SV',
		sd.icode,
		qty = sum(sd.looseqty + sd.bonusqty + sd.packqty * sd.packunits),
		value = sum((sd.looseqty + sd.bonusqty + sd.packqty * sd.packunits) *
			sd.saleprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01))
	FROM saleledger sl, saledetail sd
	WHERE /*sl.posted = 'Y' AND */ sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
			sd.Gcode = :ar_gcode AND
	      sl.date BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='SR',
		sd.icode,
		qty = sum(sd.looseqty + sd.bonusqty + sd.packqty * sd.packunits),
		value = sum((sd.looseqty + sd.bonusqty + sd.packqty * sd.packunits) *
			sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01))
	FROM srledger sl, srdetail sd
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
			sd.Gcode = :ar_gcode AND
	      sl.postdate BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='IV',
		sd.icode,
		qty = sum(sd.qty),
		value = sum(sd.qty * sd.saleprice)
	FROM issueheader sl, issuedetail sd
	WHERE /*sl.posted = 'Y' AND */ sl.issueinvcode = sd.issueinvcode AND
			sd.Gcode = :ar_gcode AND
	      sl.date BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='DS',
		d.icode,
		qty = sum(d.duesatisfyqty),
		value = sum(d.duesatisfyqty * (d.packsaleprice / case d.packunits when 0 then 1 else d.packunits end))
	FROM duesatisfyheader h, duesatisfydetail d
	WHERE h.duesatisfycode = d.duesatisfycode AND
			d.Gcode = :ar_gcode AND
	      h.duesatisfydate BETWEEN :ar_startdate and :ar_enddate
	Group By d.icode
	UNION ALL
	select	type='RV',
		sd.icode,
		qty = sum(sd.qty),
		value = sum(sd.qty * sd.saleprice)
	FROM receiptheader sl, receiptdetail sd
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
			sd.Gcode = :ar_gcode AND
	      sl.postdate BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='AI',
		sd.icode,
		qty = sum(sd.looseqty),
		value = sum(sd.looseqty * sd.price)
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		sd.Gcode = :ar_gcode AND
		sl.posteddate BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='AD',
		sd.icode,
		qty = sum(sd.looseqty),
		value = sum(sd.looseqty * sd.price)
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		sd.Gcode = :ar_gcode AND
		sl.date BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='TO',
		sd.icode,
		qty = sum(sd.qty),
		value = sum(sd.qty * (sd.saleprice / CASE sd.packunits WHEN 0 THEN 1 ELSE sd.packunits END))
	FROM THeader sl, TDetail sd
	WHERE sl.posted = 'Y' AND sl.Transcode = sd.Transcode and 
		sl.SGcode = :ar_gcode AND
		sl.postdate BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='TI',
		sd.icode,
		qty = sum(sd.qty),
		value = sum(sd.qty * (sd.saleprice / CASE sd.packunits WHEN 0 THEN 1 ELSE sd.packunits END))
	FROM THeader sl, TDetail sd
	WHERE sl.posted = 'Y' AND sl.Transcode = sd.Transcode and 
		sl.DGcode = :ar_gcode AND
		sl.postdate BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	SELECT type='OP', icode, qty = 0, value=0 FROM ITEM) St, 
	Item i, 
	itemcategory ic
WHERE st.icode = i.icode and
		i.icatcode in (:ar_icatcode) and 
		i.icatcode = ic.icatcode
GROUP BY St.icode, i.name, i.customicode, i.icatcode, ic.Name, i.saleprice, i.packunits
ORDER BY ic.name, i.name"
  arguments=(("ar_gcode", number), ("ar_icatcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
 sort="godown A, name A, item A"
)
group(level=1 header.height=200 trailer.height=683 by=("name"  ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.length="100" header.gradient.repetition.count="0" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.length="100" trailer.gradient.repetition.count="0" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" )
