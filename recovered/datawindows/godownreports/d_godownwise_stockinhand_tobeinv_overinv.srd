release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=97 print.margin.bottom=97 print.paper.size=2 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=508 color="536870912" )
summary(height=88 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=long updatewhereclause=yes name=stocktypemark dbname="StockTypeMark"  )
column=(type=char(20) updatewhereclause=yes name=stocktype dbname="StockType"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="PackUnits"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="QTY"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
 retrieve="SELECT  
	Godown=Godown.Name, 
	StockTypeMark = 
		CASE 
			WHEN ISNULL(Item.OptimumQty, 0) > ISNULL(GD.Qty, 0) THEN 1 
			WHEN ISNULL(Item.OptimumQty, 0) < ISNULL(GD.Qty, 0) THEN 2
		END,
	StockType = 
		CASE 
			WHEN ISNULL(Item.OptimumQty, 0) > ISNULL(GD.Qty, 0) THEN 'Items To Be Invoiced' 
			WHEN ISNULL(Item.OptimumQty, 0) < ISNULL(GD.Qty, 0) THEN 'Items Over Invoiced'
		END,
	Item.Name,  
	aliasname=item.customicode, 
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	Item.purprice,   
	Item.PackUnits,   
	QTY = 		
		CASE 
			WHEN ISNULL(Item.OptimumQty, 0) > ISNULL(GD.Qty, 0) THEN ISNULL(Item.OptimumQty, 0) - ISNULL(GD.Qty, 0)
			WHEN ISNULL(Item.OptimumQty, 0) < ISNULL(GD.Qty, 0) THEN ISNULL(GD.Qty, 0) - ISNULL(Item.OptimumQty, 0)
		END,
	PackingDesc=item.PackingDesc, 
	UnitPrice = Round(Item.saleprice /(case Item.PackUnits when 0 then 1 else item.packunits end), 2)
FROM 
	(SELECT GD.GCode, GD.ICode, Qty = ISNULL(SUM(GD.CurrQty), 0)
	FROM GodownDetail GD 
	WHERE GD.GCode IN (:ai_godown)
	GROUP BY GD.GCode, GD.ICode) GD,
	Godown,
	Item
WHERE 
	Godown.GCode IN (:ai_godown) AND
	Godown.GCode = GD.GCode AND
	Item.ICode = GD.ICode and  
	Item.active=1 and
	Item.OptimumQty <> GD.Qty
GROUP BY 
	Godown.Name,
	Item.name,
	item.customicode, 
	Item.Active,
	Item.purprice, 
	Item.PackUnits, 
	Item.PackingDesc,
	Item.SalePrice,
	Item.PurPrice,
	Item.AvgPrice,
	Item.OptimumQty,
	GD.Qty
"
  arguments=(("ai_godown", numberlist))
 sort="godown A, stocktype A, item_name A"
)
