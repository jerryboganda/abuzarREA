release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=480 color="536870912" )
summary(height=308 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=gcode dbname="GCode"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(20) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="ReOrderQty"  )
column=(type=long updatewhereclause=yes name=optimumqty dbname="OptimumQty"  )
column=(type=decimal(4) updatewhereclause=yes name=stockqty dbname="StockQty"  )
column=(type=decimal(4) updatewhereclause=yes name=required dbname="Required"  )
 retrieve="SELECT 
	GCode,
	Godown,
	GroupCode,
	GroupName, 
	ICode,
	AliasName,
	ItemName,
	PackingDesc,
	ReOrderQty,
	OptimumQty,
	StockQty,
	Required = CASE WHEN StockQty > ReOrderQty THEN 0 ELSE OptimumQty - StockQty END
FROM 
	(SELECT 
		GroupCode=CASE :as_type 
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PackCode END ,
		GroupName = CASE :as_type 
		WHEN 'M' THEN (SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = I.ManfCode)
		WHEN 'C' THEN (SELECT M.Name FROM ItemCategory M WHERE M.ICatCode = I.ICatCode) 
		WHEN 'L' THEN (SELECT M.Name FROM ItemClass M WHERE M.ICCode = I.ICCode) 
		ELSE (SELECT M.Name FROM ItemPacking M WHERE M.PackCode = I.PackCode) END ,
		GCode=G.GCode,
		Godown = G.Name,
		ICode=I.Icode,
		AliasName=I.CustomICode,
		ItemName=I.Name,
		PackingDesc = I.PackingDesc,
		ReOrderQty=GIS.ReOrderQty,
		OptimumQty=GIS.OptimumQty,
		StockQty = ISNULL((SELECT SUM(GD.CurrQty) FROM GodownDetail GD WHERE I.ICode = GD.ICode AND G.Gcode = GD.GCode), 0)
	FROM GodownItemSetting GIS, Godown G, Item I
	WHERE 
		G.GCode IN (:ai_gcode) AND
		G.GCode = GIS.GCode AND
		GIS.ICode = I.ICode AND
		CASE :as_type
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PackCode END in (:ai_groupcode)) T
ORDER BY
	Godown,
	GroupName,
	ItemName
	"
  arguments=(("ai_gcode", numberlist), ("ai_groupcode", numberlist), ("as_type", string))
)
