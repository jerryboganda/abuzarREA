table(column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CustAlias"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long updatewhereclause=yes name=gcode dbname="GCode"  )
column=(type=char(60) updatewhereclause=yes name=godwon dbname="Godwon"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="ItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=decimal(8) updatewhereclause=yes name=price dbname="Price"  )
 retrieve="SELECT 
	CustCode = A.AccCode, 
	CustAlias = A.AliasName,
	Customer = A.Name,
	GCode=T.GCode,
	Godwon=T.Godown,
	ItemAlias = I.CustomICode,
	Item = I.Name,
	Batch = GD.Batch,
	Expiry = GD.Expiry,
	Stock = GD.CurrQty,
	Price=ISNULL((SELECT MAX(ROUND(QD.SalePrice / QD.PackUnits,2))
		FROM Customer C, QuotationHeader QH, QuotationDetail QD 
		WHERE C.CustCode=A.AccCode AND 
			C.AssociatedQuotationCode=QH.QuotationCode AND 
			QH.QuotationCode=QD.QuotationCode AND 
			QD.ICode=I.ICode), Round(I.SalePrice / I.PackUnits,2))
FROM
	(SELECT AG.AccCode, AG.GCode, Godown=G.Name FROM AccountGodown AG, Godown G WHERE AG.AccCode IN (:ai_custcode) AND G.GCode=AG.GCode) T,
	Accounts A,
	GodownDetail GD,
	Item I
WHERE 
	A.AccCode IN (:ai_custcode) AND 
	A.AccCode = T.AccCode AND
	T.GCode=GD.GCode AND 
	GD.ICode=I.ICode

"
  arguments=(("ai_custcode", numberlist))
 sort="customer A, godwon A, item A, batch A"
)
