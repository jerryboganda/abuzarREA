release 12.5;
datawindow ( units=0 timer_interval=60000 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=72 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=char(100) updatewhereclause=yes name=quicksearch dbname="QuickSearch"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes validation="gettext()<>''" validationmsg="'Please type batch number'" initial="." name=batch dbname="Batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes initial="12/12/2010" name=expiry dbname="Expiry"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=gcode dbname="GCode" 
 values=""  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="'Qty should be greater then zero'" initial="1" name=packqty dbname="PackQty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=looseqty dbname="LooseQty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=bonusqty dbname="BonusQty"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=foreignprice dbname="ForeignPrice"  )
column=(type=long update=yes updatewhereclause=yes validation="Real (GetText()) > 0" name=packunits dbname="PackUnits"  )
column=(type=long update=yes updatewhereclause=yes validation="Real (GetText()) > 0" validationmsg="~"Please enter valid value for Total Pieces~"" initial="1" name=totalpieces dbname="TotalPieces"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=piecesinhand dbname="PiecesInHand"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=purprice dbname="PurPrice"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PurInvCode"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=avgprice dbname="AVGPrice"  )
column=(type=long key=yes updatewhereclause=yes name=purrowid dbname="PurRowID"  )
column=(type=long update=yes updatewhereclause=yes name=receiptrowid dbname="ReceiptRowID"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=newavgprice dbname="NewAvgPrice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=currstock dbname="CurrStock"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=purutn dbname="PurUtn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=gstperc dbname="GSTPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=unitsalestax dbname="UnitSalesTax"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=netrate dbname="NetRate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=recentpurprice dbname="RecentPurPrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=purpriceinadvpur dbname="PurPriceInAdvPur"  )
column=(type=char(100) update=yes updatewhereclause=yes name=itemdescription dbname="ItemDescription"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=salepriceforitem dbname="SalePriceForItem"  )
column=(type=decimal(10) updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=valueextax dbname="ValueExTax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <=100" initial="0" name=discperc dbname="DiscPerc"  )
 retrieve="SELECT 
	item.customicode,
	item.name, 
	currlistrow = 0,
	totalstock=0.0000,
	stock=0.0000,
	QuickSearch=SPACE(100),
	itemtotalval=space(30),
	packingdesc=item.packingdesc,
	ICode=ProformaPurDetail.icode,
	Batch=ProformaPurDetail.batch,
	Expiry=ProformaPurDetail.expiry,
	GCode=ProformaPurDetail.gcode,
	PackQty=ProformaPurDetail.packqty,   
	LooseQty=ProformaPurDetail.looseqty,
	BonusQty=ProformaPurDetail.bonusqty,
	ForeignPrice=ProformaPurDetail.foreignprice,
	PackUnits=ProformaPurDetail.packunits,      
	TotalPieces=ProformaPurDetail.totalpieces,
	PiecesInHand=ProformaPurDetail.piecesinhand,
	PurPrice=ProformaPurDetail.purprice,   
	PurInvCode=ProformaPurDetail.purinvcode,
	AVGPrice=ProformaPurDetail.avgprice,
	PurRowID=ProformaPurDetail.IDENTITYCOL,
	ReceiptRowID=ProformaPurDetail.ReceiptRowID,
	NewAvgPrice=ProformaPurDetail.newavgprice,
	CurrStock=ProformaPurDetail.currstock,
	PurUtn=ProformaPurDetail.purutn ,
	GSTPerc=ProformaPurDetail.gstperc,
	UnitSalesTax=ProformaPurDetail.unitsalestax,
	NetRate=ProformaPurDetail.netrate,
	RecentPurPrice=ProformaPurDetail.recentpurprice,
	SalePrice=ProformaPurDetail.saleprice,
	Rate=ProformaPurDetail.rate,
	PurPriceInAdvPur=ProformaPurDetail.purpriceinadvpur,
	ItemDescription=ProformaPurDetail.itemdescription,
	SalePriceForItem=ProformaPurDetail.salepriceforitem,
	ValueExTax = SUM(( ProformaPurDetail.purprice * ProformaPurDetail.packqty) * (1 - ( ProformaPurDetail.discperc  * .01  ) )  ),
	DiscPerc=ProformaPurDetail.discperc
FROM 
	ProformaPurDetail , 
	dbo.item

WHERE 
	( ProformaPurDetail.purinvcode = :r_InvCode ) AND
   ( ProformaPurDetail.icode = dbo.item.icode ) 

GROUP BY
	item.customicode,
	item.name, 
	item.packingdesc,
	ProformaPurDetail.icode,
	ProformaPurDetail.batch,
	ProformaPurDetail.expiry,
	ProformaPurDetail.gcode,
	ProformaPurDetail.packqty,   
	ProformaPurDetail.looseqty,
	ProformaPurDetail.bonusqty,
	ProformaPurDetail.foreignprice,
	ProformaPurDetail.packunits,      
	ProformaPurDetail.totalpieces,
	ProformaPurDetail.piecesinhand,
	ProformaPurDetail.purprice,   
	ProformaPurDetail.purinvcode,
	ProformaPurDetail.avgprice,
	ProformaPurDetail.IDENTITYCOL,
	ProformaPurDetail.newavgprice,
	ProformaPurDetail.currstock,
	ProformaPurDetail.purutn ,
	ProformaPurDetail.ReceiptRowID,
	ProformaPurDetail.gstperc,
	ProformaPurDetail.unitsalestax,
	ProformaPurDetail.netrate,
	ProformaPurDetail.recentpurprice,
	ProformaPurDetail.saleprice,
	ProformaPurDetail.rate,
	ProformaPurDetail.purpriceinadvpur,
	ProformaPurDetail.itemdescription,
	ProformaPurDetail.salepriceforitem,
	ProformaPurDetail.discperc
"
  update="ProformaPurDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("r_InvCode", number))
 sort="purrowid A"
)
