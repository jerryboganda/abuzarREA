table(column=(type=long key=yes update=yes updatewhereclause=yes name=purinvcode dbname="Purledger.PurInvCode"  )
 retrieve="SELECT 
	Purledger.PurInvCode  
FROM  
	Purledger  
WHERE 
	( Purledger.ImpactInventory = 'N' ) AND
	(( Purledger.PurCatCode = :ra_PurCatCode ) OR  
	( Purledger.PurCatCode = :ra_PurCatCode1 )) AND  
	( Purledger.Posted= 'N') AND  
	( Purledger.PurInvCode between :ra_StInvNo and :ra_EndInvNo )    
"
  update="Purledger" updatewhere=1 updatekeyinplace=no
  arguments=(("ra_PurCatCode", number), ("ra_PurCatCode1", number), ("ra_StInvNo", number), ("ra_EndInvNo", number))
 sort="purinvcode A"
)
