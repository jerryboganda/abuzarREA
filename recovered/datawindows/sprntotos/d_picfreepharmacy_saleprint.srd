 retrieve="SELECT 
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, 
	users.username, 
	accounts.name, 
	headerno =max(saleledger.headerno),
	dbo.saleledger.saleinvcode,   
	dbo.saleledger.date,   
	dbo.saleledger.discperc,   
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.salestax,   
	dbo.saleledger.custcode,   
	dbo.saleledger.remarks,
	dbo.saleledger.custrefno,	
	dbo.saledetail.icode,   
	dbo.saledetail.gcode,
	headerinvno=max(saleledger.headerinvno),
	max(saleledger.salecatcode),
	Id        = max(dbo.saledetail.IDENTITYCOL),     
	looseqty  = sum(saledetail.looseqty), 
	packqty   = sum(saledetail.packqty), 
	packunits = max(saledetail.packunits), 
	saleprice = max(saledetail.saleprice), 
	rate      = max(saledetail.rate),
	salestax  = max(saledetail.salestax),   
	discperc  = max(saledetail.discperc), 
	customername='                                  '  ,
	itemflatdisc  = max(saledetail.itemflatdisc),
	unitsalestax  = max(saledetail.unitsalestax),
	gstperc       = max(saledetail.gstperc),
	invgstperc    = max(saleledger.invgstperc1),
	reprintcounter=max(saleledger.reprintingcounter),
	patientname=(select name from patient where patientcode=max(saleledger.patientcode)),
	regno=(select regno from patient where patientcode=max(saleledger.patientcode)),
	fatherhusband=(select fatherhusband from patient where patientcode=max(saleledger.patientcode)),
	gender=(select gender from patient where patientcode=max(saleledger.patientcode)),
	fname=(select fname from patient where patientcode=max(saleledger.patientcode)),
	address = (select LTRIM(RTRIM(ISNULL(address1, '') + ' ' + ISNULL(address2, ''))) from patient where patientcode=max(saleledger.patientcode)),
	city=(select city from patient where patientcode=max(saleledger.patientcode)),
	Contact = (select ISNULL(Phone, '') + CASE WHEN LEN(Phone) > 0 THEN ', ' ELSE '' END + LTRIM(RTRIM(ISNULL(MobileNo1, '') + CASE WHEN LEN(MobileNo1) > 0 THEN ', ' ELSE '' END + ISNULL(MobileNo2, '') + CASE WHEN LEN(MobileNo2) > 0 THEN ', ' ELSE '' END + ISNULL(MobileNo3, ''))) from patient where patientcode=max(saleledger.patientcode)),
	serverdate=getdate()
	
FROM 
	dbo.saleledger,   
	dbo.saledetail,  
	item, 
	customer, 
	accounts,
	users 
	
WHERE 
	( dbo.saleledger.saleinvcode = :ra_InvCode ) AND
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND 
	( dbo.saleledger.custcode = dbo.customer.custcode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( dbo.saleledger.salesmancode = dbo.users.usercode ) AND
	( saledetail.icode = item.icode )  
	
GROUP BY 
	saleledger.saleinvcode, 
	saleledger.date, 
	/*saleledger.headerno,*/
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	saleledger.salestax, 
	saleledger.remarks,
	saleledger.custrefno, 
	saledetail.icode,
	saledetail.rowgroup,  
	saledetail.gcode, 
	item.name,
	item.icode,
	item.printable, 
	accounts.name,
	dbo.users.username
ORDER BY 
	MAX(dbo.saledetail.IDENTITYCOL)
"
  arguments=(("ra_InvCode", number))
 sort="id A"
)
