compute(name=c_netamount visible="1	0" band=detail font.charset="0" font.face="Times New Roman" font.family="1" font.height="-8" font.pitch="2" font.weight="400" tooltip.enabled="0" tooltip.isbubble="0" tooltip.textcolor="134217751" tooltip.backcolor="134217752" tooltip.icon="0" tooltip.maxwidth="0" tooltip.transparency="0" tooltip.delay.visible="32000" tooltip.delay.initial="0" tooltip.hasclosebutton="0" transparency="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.length="100" background.gradient.repetition.count="0" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" color="0" x="1156" y="10" height="145" width="416" format="[general]" expression="c_amount  *  ( 1 -  invdiscperc  * .01 )  " alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_netrate visible="1" band=detail font.charset="0" font.face="Times New Roman" font.family="1" font.height="-8" font.pitch="2" font.weight="400" tooltip.enabled="0" tooltip.isbubble="0" tooltip.textcolor="134217751" tooltip.backcolor="134217752" tooltip.icon="0" tooltip.maxwidth="0" tooltip.transparency="0" tooltip.delay.visible="32000" tooltip.delay.initial="0" tooltip.hasclosebutton="0" transparency="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.length="100" background.gradient.repetition.count="0" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" color="0" x="2552" y="10" height="145" width="500" format="#####.00" expression="Round((((saleprice - itemflatdisc) * looseqty * (1- discperc * 0.01)) + ((looseqty + bonusqty) * unitsalestax) + ((saleprice - itemflatdisc) * looseqty * (1- discperc * 0.01) * gstperc * 0.01)) / if(looseqty > 0, looseqty, 1), 2)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
