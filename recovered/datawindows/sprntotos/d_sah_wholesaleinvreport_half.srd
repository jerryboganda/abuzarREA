compute(name=c_totaltax visible="1	0" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-12" font.pitch="2" font.weight="400" background.mode="1" background.color="553648127" color="0" x="5531" y="73" height="156" width="531" format="#####0.00" expression="Round(Round((Round(sum((round(c_amount,2) ) for all)  *  (1 - invdiscperc * 0.01) ,2) -  flatdisc  )  *  invgstperc  * 0.01,2) + sum(c_salestaxval for all) , 0)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_grosstotal visible="1" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-12" font.pitch="2" font.weight="400" background.mode="1" background.color="553648127" color="0" x="6135" y="84" height="156" width="812" format="#########0.00" expression="Sum((  looseqty   *  (saleprice - itemflatdisc)  )  *  ( 1 -  (    discperc * .01 )  )  -  (  salestax   *  looseqty ) )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
