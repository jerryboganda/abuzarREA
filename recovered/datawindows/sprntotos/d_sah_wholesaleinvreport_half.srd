compute(name=c_invsalestaxval visible="1	if(invgstperc>0,1,0)" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-12" font.pitch="2" font.weight="400" background.mode="1" background.color="553648127" color="0" x="4281" y="313" height="156" width="614" format="#####0.00" expression="Round((Round(sum((round(c_amount,2) ) for all)  *  (1 - invdiscperc * 0.01),2) -  flatdisc  )  *  invgstperc  * 0.01,2)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumsalestaxval visible="1	if(sum(c_salestaxval)>0,1,0)" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-12" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="7000" y="84" height="156" width="229" format="###0.00" expression="sum(round( c_amount  *  gstperc * 0.01, 2) +  Round((looseqty+bonusqty) * unitsalestax ,2) for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
