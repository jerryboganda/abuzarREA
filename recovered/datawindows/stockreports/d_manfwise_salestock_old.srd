release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1812 color="536870912" )
summary(height=385 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemName"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="Packingdesc"  )
column=(type=decimal(13) updatewhereclause=yes name=traderprice dbname="Traderprice"  )
column=(type=decimal(4) updatewhereclause=yes name=openingstock dbname="openingstock"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(4) updatewhereclause=yes name=prqty dbname="PrQty"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="salevalue"  )
column=(type=decimal(4) updatewhereclause=yes name=lastdaysaleqty dbname="LastDaySaleQty"  )
column=(type=decimal(6) updatewhereclause=yes name=lastdaysalevalue dbname="LastDaySalevalue"  )
column=(type=decimal(4) updatewhereclause=yes name=salebonus dbname="SaleBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=salebonusvalue dbname="SaleBonusvalue"  )
column=(type=decimal(4) updatewhereclause=yes name=srqty dbname="SRQty"  )
column=(type=decimal(4) updatewhereclause=yes name=other dbname="Other"  )
column=(type=long updatewhereclause=yes name=closingstock dbname="ClosingStock"  )
 retrieve="SELECT
	Aliasname=I.customicode,
	itemName=I.name,
	manufacturer=IC.name,
	Category=C.name,
	Packingdesc=I.packingdesc,
	Traderprice=I.saleprice/(CASE I.packunits when 0 then 1 else I.packunits end),
	openingstock=(SELECT isnull(sum(qty),0)
					 FROM
						(select qty=(- 1) * Isnull(sum(ISD.Qty),0) 
		 			 	from issueheader ISL,
		      				issuedetail ISD
		 			   where ISL.date <:ar_StartDate AND
		      			 ISL.Issueinvcode=ISD.Issueinvcode AND
		      			 ISD.icode=I.icode
		
						union all
		
						select  isnull(sum(RD.Qty),0) 
						from receiptheader RL,
		      		  	  receiptdetail RD
		 				where RL.date <:ar_StartDate AND
		      				RL.posted='Y' AND
		      				RL.receiptinvcode=RD.receiptinvcode AND
		      				RD.icode=I.icode
		
					union all
		
					select 	 isnull(sum(ADJD.looseQty),0) 
					from Adjheader ADJL,
	      			  Adjdetail ADJD
		 			where ADJL.posteddate <:ar_StartDate AND
		      			ADJL.posted='Y' AND
		      			ADJL.adjcatcode=1 AND
		     			 	ADJL.adjcode=ADJD.adjcode AND
		      			ADJD.icode=I.icode
		
					union all
		
					select 	 (-1)*isnull(sum(ADJD.looseQty),0) 
					from Adjheader ADJL,
		      		  Adjdetail ADJD
		 			where ADJL.posteddate <:ar_StartDate AND
		      			ADJL.posted='Y' AND
		      			ADJL.adjcatcode=2 AND
		     				ADJL.adjcode=ADJD.adjcode AND
		      			ADJD.icode=I.icode

					union all
		
					select 	 (-1)*isnull(sum(DUED.DueSatisfyQty),0) 
					from duesatisfyheader DUEH,
		      		  duesatisfydetail DUED
		 			where DUEH.DueSatisfyDate <:ar_StartDate AND
		      			DUEH.Duesatisfycode=DUED.duesatisfycode and		     				
		      			DUED.icode=I.icode

					union all

					select purqty=isnull(sum(PD.looseqty)+
			      					Sum(PD.bonusqty *  Case  PL.purcatcode when 1 then PD.packunits when 2 then PD.packunits Else 1 End)+
			      					sum(PD.packqty*packunits),0)
					from purledger PL,
		    			  purdetail PD
					where PL.postdate <:ar_StartDate AND
		      			PL.purinvcode=PD.purinvcode AND
							PL.posted='Y' AND
		      			PD.icode=I.icode
					
					union all

					select (-1) * isnull(sum(PRD.looseqty)+ Sum(PRD.bonusqty),0)
					from prledger PRL,
	     				  prdetail PRD
					where 	PRL.date <:ar_StartDate AND
		      				PRL.prinvcode=PRD.prinvcode AND
								/*PRL.posted='Y' AND*/
		     					PRD.icode=I.icode
					
					union all
			
					select (- 1) * Isnull(sum(SD.looseqty + SD.bonusqty),0)
		 			from  saleledger SL,
	      				saledetail SD
				 	where SL.date<:ar_StartDate and
		       				SL.saleinvcode=SD.saleinvcode and
		       				SD.Due is null and
								SD.icode=I.icode
				 union all

				select isnull(sum(SRD.looseqty)+ Sum(SRD.bonusqty),0)
				from Srledger SRL,
     				  Srdetail SRD
				where SRL.date <:ar_StartDate AND
      				SRL.Srinvcode=SRD.Srinvcode AND
      				SRD.icode=I.icode
	
				) AS A ),




/*----------end of opening stock calculation --------*/
	PurQty=ISNULL((select purqty=sum(PD.looseqty)+
			      Sum(PD.bonusqty *  Case  PL.purcatcode when 1 then PD.packunits when 2 then PD.packunits Else 1 End)+
			      sum(PD.packqty*packunits)
					  from purledger PL,
		    				 purdetail PD
						where PL.postdate >=:ar_StartDate AND
		      				PL.postdate <=:ar_EndDate AND
								PL.posted='Y' AND
		      				PL.purinvcode=PD.purinvcode AND
		      				PD.icode=I.icode
		),0) ,

	PrQty=ISNULL((select sum(PRD.looseqty)+ Sum(PRD.bonusqty)
						from prledger PRL,
		     				  prdetail PRD
						where PRL.date >=:ar_StartDate AND
		      				PRL.date <=:ar_EndDate AND
								/*PRL.posted='Y' AND*/
		      				PRL.prinvcode=PRD.prinvcode AND
		     					PRD.icode=I.icode
					),0),

      SaleQty=(SELECT isnull(sum(qty),0)
					FROM
						( 
						select qty=Isnull(sum(SD.looseqty),0)
		 				from  saleledger SL,
		      				saledetail SD
					 	where SL.date>=:ar_StartDate and
		       				SL.date<=dateadd(day,- 1,:ar_EndDate) and
		       				SL.saleinvcode=SD.saleinvcode and
								SD.due is null and
		       				SD.icode=I.icode and
								DATEDIFF(day, :ar_StartDate, :ar_EndDate) >0
					union all
					
					select isnull((- 1)*sum(SRD.looseqty),0)
						from Srledger SRL,
		     				  Srdetail SRD
						where SRL.date >=:ar_StartDate AND
		      				SRL.date <=dateadd(day,- 1,:ar_EndDate) AND
		      				SRL.Srinvcode=SRD.Srinvcode AND
		      				SRD.icode=I.icode AND
								DATEDIFF(day, :ar_StartDate, :ar_EndDate) >0
						) AS A), /* n - 1 day */
		salevalue=		( SELECT isnull(sum(salevalue),0)
							  FROM
								(
								select 
									salevalue=(case :ar_pricetype when 1 then Isnull(sum((SD.looseqty*(SD.saleprice - SD.itemflatdisc ) * (1 - SD.discperc*0.01))* ( 1 - SL.discperc*0.01)),0)
													 else
															isnull(sum(SD.looseqty ),0)*I.saleprice/I.packunits
													 end)
		 						from  saleledger SL,
		      						saledetail SD
					 			where SL.date>=:ar_StartDate and
		       						SL.date<=dateadd(day,- 1,:ar_EndDate) and
		       						SL.saleinvcode=SD.saleinvcode and
										SD.due is null and
		       						SD.icode=I.icode and
										DATEDIFF(day, :ar_StartDate, :ar_EndDate) >0
							 union all
						
							select srvalue= - 1*(case :ar_pricetype when 1 then isnull(sum((SRD.looseqty*SRD.srprice*(1 - SRD.discperc*0.01)) * (1 - SRL.discperc*0.01)),0)
											else
												isnull(sum(SRD.looseqty ),0)*I.saleprice/I.packunits
											end)
							from Srledger SRL,
		     				  		Srdetail SRD
							where SRL.date >=:ar_StartDate AND
		      					SRL.date <=dateadd(day,- 1,:ar_EndDate) AND
		      					SRL.Srinvcode=SRD.Srinvcode AND
		      					SRD.icode=I.icode AND
									DATEDIFF(day, :ar_StartDate, :ar_EndDate) >0
								)as A), /* n - 1 day */
	
	LastDaySaleQty=( SELECT isnull(sum(qty),0)
					     FROM
							(
						  select qty=Isnull(sum(SD.looseqty),0)
		 				  from  saleledger SL,
		      				  saledetail SD
					 	  where SL.date> =  convert(varchar(2) , month(:ar_enddate) ) + '/' + convert(varchar(2) , day(:ar_enddate) ) + '/' + convert(varchar(4) , year(:ar_enddate) ) and /* to get just date */
		       				SL.date<=:ar_EndDate and
		       				SL.saleinvcode=SD.saleinvcode and
								SD.Due is null and
		       				SD.icode=I.icode
						 union all
						 select (-1)*isnull(sum(SRD.looseqty),0)
						 from Srledger SRL,
		     				  Srdetail SRD
						 where SRL.date >= convert(varchar(2) , month(:ar_enddate) ) + '/' + convert(varchar(2) , day(:ar_enddate) ) + '/' + convert(varchar(4) , year(:ar_enddate) ) and /* to get just date */
		      				SRL.date <=:ar_EndDate AND
		      				SRL.Srinvcode=SRD.Srinvcode AND
		      				SRD.icode=I.icode

								
						)AS A),
LastDaySalevalue=(SELECT isnull(sum(salevalue),0)
						FROM
						( select salevalue=(case :ar_pricetype when 1 then Isnull(sum((SD.looseqty*(SD.saleprice - SD.itemflatdisc ) * (1 - SD.discperc*0.01))* ( 1 - SL.discperc*0.01)),0)
													 else
															isnull(sum(SD.looseqty ),0)*I.saleprice/I.packunits
													 end)
		 				  from  saleledger SL,
		      				  saledetail SD
					 		where SL.date>= convert(varchar(2) , month(:ar_enddate) ) + '/' + convert(varchar(2) , day(:ar_enddate) ) + '/' + convert(varchar(4) , year(:ar_enddate) ) and /* to get just date */
		       				SL.date<=:ar_EndDate and
		       				SL.saleinvcode=SD.saleinvcode and
								SD.Due is null and
		       				SD.icode=I.icode
							 union all
						
							select srvalue= - 1*(case :ar_pricetype when 1 then isnull(sum((SRD.looseqty*SRD.srprice*(1 - SRD.discperc*0.01)) * (1 - SRL.discperc*0.01)),0)
											else
												isnull(sum(SRD.looseqty ),0)*I.saleprice/I.packunits
											end)
							from Srledger SRL,
		     				  		Srdetail SRD
							where SRL.date >= convert(varchar(2) , month(:ar_enddate) ) + '/' + convert(varchar(2) , day(:ar_enddate) ) + '/' + convert(varchar(4) , year(:ar_enddate) ) and /* to get just date */
		      					SRL.date <=:ar_EndDate AND
		      					SRL.Srinvcode=SRD.Srinvcode AND
		      					SRD.icode=I.icode
								
						) AS A ),

	SaleBonus=( SELECT isnull(sum(qty),0)
					FROM
						(select  qty=isnull(Sum(SD.bonusqty),0)
		   				from Saleledger SL,
		     						Saledetail SD
		  					where SL.date >=:ar_StartDate AND
		      					SL.date <= :ar_EndDate AND
		      					SL.Saleinvcode=SD.Saleinvcode AND
									SD.Due is null and
		     						SD.icode=I.icode
							union all
							select  (-1)*isnull(Sum(SRD.bonusqty),0)
							from Srledger SRL,
		     				  		Srdetail SRD
							where SRL.date >=:ar_StartDate AND
		      					SRL.date <=:ar_EndDate AND
		      					SRL.Srinvcode=SRD.Srinvcode AND
		      					SRD.icode=I.icode
							) AS A),
	SaleBonusvalue=(SELECT isnull(sum(salevalue),0)
						 FROM
									(select  salevalue=isnull((case :ar_pricetype when 1 then sum(SD.bonusqty*SD.saleprice)
														else
															sum(SD.bonusqty) * I.saleprice/I.packunits
														end),0)
		   						from Saleledger SL,
		     								Saledetail SD
		  							where SL.date >=:ar_StartDate AND
		      							SL.date <= :ar_EndDate AND
		      							SL.Saleinvcode=SD.Saleinvcode AND
											SD.Due is null and
		     								SD.icode=I.icode
								 union all
								 select srvalue= - 1*(case :ar_pricetype when 1 then isnull(sum(SRD.bonusqty*SRD.srprice),0)
											else
												isnull(sum(SRD.bonusqty ),0)*I.saleprice/I.packunits
											end)
								from Srledger SRL,
		     				  			Srdetail SRD
								where SRL.date >=:ar_Startdate AND
		      						SRL.date <=:ar_EndDate AND
		      						SRL.Srinvcode=SRD.Srinvcode AND
		      						SRD.icode=I.icode
					
							) AS A),
	SRQty=ISNULL((select sum(SRD.looseqty)+ Sum(SRD.bonusqty)
						from Srledger SRL,
		     				  Srdetail SRD
						where SRL.date >=:ar_StartDate AND
		      				SRL.date <=:ar_EndDate AND
		      				SRL.Srinvcode=SRD.Srinvcode AND
		      				SRD.icode=I.icode
				),0),

	Other= (SELECT sum(qty)
		 		FROM
					(select qty=(- 1) * Isnull(sum(ISD.Qty),0) 
		 			 from issueheader ISL,
		      			issuedetail ISD
		 			 where ISL.date >=:ar_StartDate AND
		      			 ISL.date <= :ar_EndDate AND
		      			 ISL.Issueinvcode=ISD.Issueinvcode AND
		      			 ISD.icode=I.icode
		
					union all
		
					select  isnull(sum(RD.Qty),0) 
					from receiptheader RL,
		      		  receiptdetail RD
		 			where RL.postdate >=:ar_StartDate AND
		      			RL.postdate <= :ar_EndDate AND
		      			RL.posted='Y' AND
		      			RL.receiptinvcode=RD.receiptinvcode AND
		      			RD.icode=I.icode
		
					union all
		
					select 	 isnull(sum(ADJD.looseQty),0) 
					from Adjheader ADJL,
		      			Adjdetail ADJD
		 			where ADJL.posteddate >=:ar_StartDate AND
		      			ADJL.posteddate <= :ar_EndDate AND
		      			ADJL.posted='Y' AND
		      			ADJL.adjcatcode=1 AND
		     			 	ADJL.adjcode=ADJD.adjcode AND
		      			ADJD.icode=I.icode
		
					union all
		
					select 	 (-1)*isnull(sum(ADJD.looseQty),0) 
					from Adjheader ADJL,
		      		  Adjdetail ADJD
		 			where ADJL.posteddate >=:ar_StartDate AND
		      			ADJL.posteddate <= :ar_EndDate AND
		      			ADJL.posted='Y' AND
		      			ADJL.adjcatcode=2 AND
		     				ADJL.adjcode=ADJD.adjcode AND
		      			ADJD.icode=I.icode

					union all
		
					select 	 (-1)*isnull(sum(DUED.DueSatisfyQty),0) 
					from duesatisfyheader DUEH,
		      		  duesatisfydetail DUED
		 			where DUEH.DueSatisfyDate >=:ar_StartDate AND
		      			DUEH.DueSatisfyDate <= :ar_EndDate AND
		      			DUEH.Duesatisfycode=DUED.duesatisfycode and		     				
		      			DUED.icode=I.icode
				) AS A ),




	ClosingStock=0

FROM item I,
    manufacturer IC,
	 ItemCategory C
	
WHERE I.manfcode IN (:aa_manfcode) AND
      I.manfcode=IC.manfcode AND
		I.ICatCode = C.ICatCode
ORDER BY
      IC.name,
		C.Name,
    	I.name"
  arguments=(("aa_manfcode", numberlist), ("ar_StartDate", datetime), ("ar_EndDate", datetime), ("al_projectionperiod", number), ("ar_pricetype", number))
)
group(level=1 header.height=177 trailer.height=416 by=("manufacturer"  ) header.color="536870912" trailer.color="536870912" newpage=yes resetpagecount=yes )
group(level=2 header.height=177 trailer.height=427 by=("category"  ) header.color="536870912" trailer.color="536870912" )
text(name=t_3 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" alignment="2" border="0" x="93" y="218" height="156" width="7635" text="Sale Stock" html.valueishtml="0" )
