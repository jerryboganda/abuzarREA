release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1041 color="536870912" )
header[2](height=354 color="536870912" )
header[3](height=354 color="536870912" )
summary(height=197 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=groupname dbname="groupname"  )
column=(type=char(20) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(20) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(20) updatewhereclause=yes name=class dbname="class"  )
column=(type=char(20) updatewhereclause=yes name=model dbname="model"  )
column=(type=number updatewhereclause=yes name=stockinhand dbname="stockinhand"  )
column=(type=number updatewhereclause=yes name=transitstock dbname="transitstock"  )
 retrieve="SELECT
	GroupName    = CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) 	ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	Manufacturer   = (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode),
	AliasName    = I.CustomICode,
	ItemName     = I.Name,
	Class        = (SELECT C.NAME FROM ItemClass C WHERE C.ICCODE  = I.ICCode),
	Model        = (SELECT M.Name FROM Model M WHERE M.ModelCode IN 
					(SELECT ModelCode=MAX(IM.ModelCode) 
					FROM ItemInModel IM 
					WHERE IM.ICode=I.ICode)),
	StockInHand  = ISNULL(SUM(GD.CurrQty), 0),
	TransitStock = ISNULL(I.TransitStock, 0)
FROM
	Item I LEFT OUTER JOIN GodownDetail AS GD ON (I.ICode = GD.ICode)
WHERE 
	CASE :as_grouptype 
		WHEN 'M' THEN I.MANFCODE 
		WHEN 'C' THEN I.ICatCode 
		WHEN 'L' THEN I.ICCode 
		ELSE I.PACKCODE 
	END IN (:ai_groupcode) AND
	I.ManfCode IN (:ai_ManfCode)
GROUP BY
	I.ManfCode,
	I.ICatCode,
	I.ICCode,
	I.Packcode,
	I.ICode,
	I.CustomICode,
	I.Name,
	I.TransitStock
ORDER BY
	GroupName,
	Manufacturer,
	ItemName,
	AliasName"
  arguments=(("as_grouptype", string), ("ai_groupcode", numberlist), ("ai_manfcode", numberlist))
 sort="groupname A, itemname A, class A, model A, aliasname A"
)
