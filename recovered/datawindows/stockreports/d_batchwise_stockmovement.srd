release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1500 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=icode dbname="Item.Icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="Groupname"  )
column=(type=decimal(16) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(4) updatewhereclause=yes name=openqty dbname="openqty"  )
column=(type=decimal(6) updatewhereclause=yes name=openvalue dbname="openvalue"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(4) updatewhereclause=yes name=purbonus dbname="PurBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalue dbname="PurValue"  )
column=(type=decimal(4) updatewhereclause=yes name=pretqty dbname="PRetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=pretbonus dbname="PRetBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=pretvalue dbname="PRetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=decimal(4) updatewhereclause=yes name=salebonus dbname="SaleBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(4) updatewhereclause=yes name=sretqty dbname="SRetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=sretbonus dbname="SRetBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=sretvalue dbname="SRetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=issueqty dbname="IssueQty"  )
column=(type=decimal(6) updatewhereclause=yes name=issuevalue dbname="IssueValue"  )
column=(type=decimal(4) updatewhereclause=yes name=duesatisfyqty dbname="DueSatisfyQty"  )
column=(type=decimal(6) updatewhereclause=yes name=duesatisfyvalue dbname="DueSatisfyValue"  )
column=(type=decimal(4) updatewhereclause=yes name=receiptqty dbname="ReceiptQty"  )
column=(type=decimal(6) updatewhereclause=yes name=receiptvalue dbname="ReceiptValue"  )
column=(type=decimal(4) updatewhereclause=yes name=adjqty dbname="AdjQty"  )
column=(type=decimal(6) updatewhereclause=yes name=adjvalue dbname="AdjValue"  )
 retrieve=" SELECT	
	St.Icode, 
	AliasName= i.customicode,
	Item = i.name,
	packingdesc=max(i.packingdesc),
	Groupname = CASE :ar_grouping WHEN 'M' THEN ISNULL((SELECT Manufacturer.name FROM Manufacturer WHERE Manufacturer.ManfCode = i.manfcode), '')
			WHEN 'C' THEN ISNULL((SELECT ItemCategory.name FROM ItemCategory WHERE ItemCategory.ICatCode = i.icatcode), '')
			WHEN 'L' THEN ISNULL((SELECT ItemClass.name FROM ItemClass WHERE ItemClass.ICCode = i.iccode), '')
			ELSE ISNULL((SELECT itempacking.name FROM itempacking WHERE itempacking.PackCode = i.packcode), '') END,
	Rate = Round(CASE :ai_pricetype WHEN 1 THEN i.saleprice WHEN 2 THEN i.purprice ELSE i.avgprice END / CASE :ai_pricetype WHEN 3 THEN 1 ELSE CASE WHEN i.packunits > 0 THEN i.packunits ELSE 1 END END, 2),
	openqty	  =SUM(CASE WHEN type='OP' THEN qty ELSE 0 END),
	openvalue =SUM(CASE WHEN type='OP' THEN value ELSE 0 END),
	PurQty 	  =SUM(CASE WHEN type='PV' THEN qty ELSE 0 END),
	PurBonus  =SUM(CASE WHEN type='PV' THEN bonus ELSE 0 END),
	PurValue  =SUM(CASE WHEN type='PV' THEN value ELSE 0 END),
	PRetQty	  =SUM(CASE WHEN type='PR' THEN qty ELSE 0 END),
	PRetBonus =SUM(CASE WHEN type='PR' THEN bonus ELSE 0 END),
	PRetValue =SUM(CASE WHEN type='PR' THEN value ELSE 0 END),
	SaleQty	  =SUM(CASE WHEN type='SV' THEN qty ELSE 0 END),
	SaleBonus =SUM(CASE WHEN type='SV' THEN bonus ELSE 0 END),
	SaleValue =SUM(CASE WHEN type='SV' THEN value ELSE 0 END),
	SRetQty	  =SUM(CASE WHEN type='SR' THEN qty ELSE 0 END),
	SRetBonus =SUM(CASE WHEN type='SR' THEN bonus ELSE 0 END),
	SRetValue =SUM(CASE WHEN type='SR' THEN value ELSE 0 END),
	IssueQty  =SUM(CASE WHEN type='IV' THEN qty ELSE 0 END),
	IssueValue=SUM(CASE WHEN type='IV' THEN value ELSE 0 END),
	DueSatisfyQty  =SUM(CASE WHEN type='DS' THEN qty ELSE 0 END),
	DueSatisfyValue=SUM(CASE WHEN type='DS' THEN value ELSE 0 END),
	ReceiptQty=SUM(CASE WHEN type='RV' THEN qty ELSE 0 END),
	ReceiptValue=SUM(CASE WHEN type='RV' THEN value ELSE 0 END),
	AdjQty	  =SUM(CASE WHEN type='AI' THEN qty 
								WHEN type='AD' THEN -qty 
								ELSE 0 END),
	AdjValue  =SUM(CASE  WHEN type='AI' THEN value 
								WHEN type='AD' THEN -value  
								ELSE 0 END)
FROM
	(SELECT type='OP', icode, qty = sum(qty), bonus = 0, value=0
	FROM	(select	pd.icode, qty = sum(isnull(case pl.purcatcode 
														when 1 THEN (packqty + bonusqty) * packunits
														when 2 THEN (packqty + bonusqty) * packunits
														else looseqty + bonusqty end, 0))
	FROM purledger pl, purdetail pd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		pd.batch = :as_batch AND
		pd.icode = itm.icode AND
		pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pl.postdate < :ar_startdate
	Group By pd.icode
	UNION ALL
	select	pd.icode,
		qty  = - sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits)
	FROM prledger pl, prdetail pd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		pd.batch = :as_batch AND
		pd.icode = itm.icode AND
		pl.prinvcode = pd.prinvcode AND
		pl.date < :ar_startdate
	Group By pd.icode
	UNION ALL
	select	
		sd.icode,
		qty  = -sum(sd.looseqty + sd.bonusqty)
	FROM saleledger sl, saledetail sd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		sd.batch = :as_batch AND
		sd.icode = itm.icode AND
		sl.saleinvcode = sd.saleinvcode AND
	      sl.date < :ar_startdate AND sd.Due IS NULL
	Group By sd.icode
	UNION ALL
	select	
		sd.icode,
		qty  = sum(sd.looseqty + sd.bonusqty)
	FROM srledger sl, srdetail sd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		sd.batch = :as_batch AND
		sd.icode = itm.icode AND
		sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
		sl.postdate < :ar_startdate
	Group By sd.icode
	UNION ALL
	select	
		sd.icode,
		qty  = -sum(sd.qty)
	FROM issueheader sl, issuedetail sd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		sd.batch = :as_batch AND
		sd.icode = itm.icode AND
		/*sl.posted = 'Y' AND*/ sl.issueinvcode = sd.issueinvcode AND
		sl.date < :ar_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = sum(sd.qty)
	FROM receiptheader sl, receiptdetail sd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		sd.batch = :as_batch AND
		sd.icode = itm.icode AND
		sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	    sl.postdate < :ar_startdate
	Group By sd.icode
	UNION ALL
	select	
		sd.icode,
		qty = sum(sd.looseqty)
	FROM Adjheader sl, Adjdetail sd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		sd.batch = :as_batch AND
		sd.icode = itm.icode AND
		sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		sl.posteddate < :ar_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty = -sum(sd.looseqty)
	FROM Adjheader sl, Adjdetail sd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		sd.batch = :as_batch AND
		sd.icode = itm.icode AND
		sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		sl.posteddate < :ar_startdate
	Group By sd.icode
	UNION ALL
	select	d.icode,
		qty = -sum(d.duesatisfyqty)
	FROM duesatisfyheader h, duesatisfydetail d,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		d.batch = :as_batch AND
		d.icode = itm.icode AND
		h.duesatisfycode=d.duesatisfycode AND
		h.duesatisfydate < :ar_startdate
	Group By d.icode) A
	GROUP BY icode
	UNION ALL
	select	type='PV',
		pd.icode,
		qty = sum(looseqty + packqty * packunits),
		bonus = sum(isnull(case pl.purcatcode 
			when 1 THEN bonusqty * packunits
			when 2 THEN bonusqty * packunits
			else bonusqty
			end, 0)),
		value = sum(isnull(case pl.purcatcode 
			when 1 THEN (packqty + bonusqty)
			when 2 THEN (packqty + bonusqty)
			else looseqty + bonusqty 
			end, 0) * pd.purprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01))
	FROM purledger pl, purdetail pd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		pd.batch = :as_batch AND
		pd.icode = itm.icode AND
		pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pl.postdate BETWEEN :ar_startdate and :ar_enddate
	Group By pd.icode
	UNION ALL
	select	type='PR',
		pd.icode,
		qty = sum(pd.looseqty + pd.packqty * pd.packunits),
		bonus = sum(bonusqty),
		value = sum((pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits) *
			pd.prprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01))
	FROM prledger pl, prdetail pd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		pd.batch = :as_batch AND
		pd.icode = itm.icode AND
		pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
		pl.date BETWEEN :ar_startdate and :ar_enddate
	Group By pd.icode
	UNION ALL
	select	type='SV',
		sd.icode,
		qty = sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus = sum(bonusqty),
		value = sum((sd.looseqty + sd.packqty * sd.packunits) *
			sd.saleprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01))
	FROM saleledger sl, saledetail sd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		sd.batch = :as_batch AND
		sd.icode = itm.icode AND
		/*sl.posted = 'Y' AND */ sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
		sl.date >= :ar_startdate and sl.date <= :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='SR',
		sd.icode,
		qty = sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus = sum(bonusqty),
		value = sum((sd.looseqty + sd.packqty * sd.packunits) *
			sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01))
	FROM srledger sl, srdetail sd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		sd.batch = :as_batch AND
		sd.icode = itm.icode AND
		sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
		sl.postdate BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='IV',
		sd.icode,
		qty = sum(sd.qty),
		bonus = 0,
		value = sum(sd.qty * sd.saleprice)
	FROM issueheader sl, issuedetail sd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		sd.batch = :as_batch AND
		sd.icode = itm.icode AND
		/*sl.posted = 'Y' AND */ sl.issueinvcode = sd.issueinvcode AND
		sl.date BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='DS',
		d.icode,
		qty = sum(d.duesatisfyqty),
		bonus = 0,
		value = sum(d.duesatisfyqty * (d.packsaleprice / case d.packunits when 0 then 1 else d.packunits end))
	FROM duesatisfyheader h, duesatisfydetail d,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		d.batch = :as_batch AND
		d.icode = itm.icode AND
		h.duesatisfycode = d.duesatisfycode AND
		h.duesatisfydate BETWEEN :ar_startdate and :ar_enddate
	Group By d.icode
	UNION ALL
	select	type='RV',
		sd.icode,
		qty = sum(sd.qty),
		bonus = 0,
		value = sum(sd.qty * sd.saleprice)
	FROM receiptheader sl, receiptdetail sd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		sd.batch = :as_batch AND
		sd.icode = itm.icode AND
		sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
		sl.postdate BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='AI',
		sd.icode,
		qty = sum(sd.looseqty),
		bonus = 0,
		value = sum(sd.looseqty * sd.price)
	FROM Adjheader sl, Adjdetail sd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		sd.batch = :as_batch AND
		sd.icode = itm.icode AND
		sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
		sl.posteddate BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='AD',
		sd.icode,
		qty = sum(sd.looseqty),
		bonus = 0,
		value = sum(sd.looseqty * sd.price)
	FROM Adjheader sl, Adjdetail sd,
		(SELECT ICode FROM Item IT 
		WHERE 
			CASE :ar_grouping WHEN 'M' THEN IT.ManfCode
				WHEN 'C' THEN IT.ICatCode
				WHEN 'L' THEN IT.ICCode
						 ELSE IT.PackCode END in (:ar_groupcode)) Itm
	WHERE 
		sd.batch = :as_batch AND
		sd.icode = itm.icode AND
		sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
		sl.posteddate BETWEEN :ar_startdate and :ar_enddate
	Group By sd.icode
	UNION ALL
	SELECT type='OP', IT.icode, qty = 0, bonus = 0, value=0 FROM ITEM IT
	WHERE
		CASE :ar_grouping 
		WHEN 'M' THEN IT.ManfCode
		WHEN 'C' THEN IT.ICatCode
		WHEN 'L' THEN IT.ICCode
		 ELSE IT.PackCode END in (:ar_groupcode) ) St, 
	Item i
WHERE 
	st.icode = i.icode and
	CASE :ar_grouping WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
				 ELSE I.PackCode END in (:ar_groupcode) 
GROUP BY 
	St.icode, 
	i.name, 
	i.customicode, 	
	i.ManfCode,
	i.PackCode,
	i.ICCode,
	i.ICatCode,
	i.saleprice, 
	i.purprice, 
	i.avgprice, 
	i.packunits
ORDER BY 
	groupname, 
	i.name, 
	i.customicode
"
  update="Item" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_groupcode", numberlist), ("ar_grouping", string), ("ar_startdate", datetime), ("ar_enddate", datetime), ("as_batch", string), ("ai_pricetype", number))
 sort="groupname A, item A"
 filter="(openqty + purqty + purbonus - pretqty - pretbonus - saleqty - salebonus + sretqty + sretbonus - duesatisfyqty - issueqty + receiptqty + adjqty) <> 0"
 )
group(level=1 header.height=187 trailer.height=291 by=("groupname"  ) header.color="536870912" trailer.color="536870912" )
compute(name=compute_22 visible="1	0" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="8812" y="822" height="166" width="62" format="#######0.00" expression="sum( issuevalue + receiptvalue + adjvalue for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=othervalue visible="1	0" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="8697" y="822" height="166" width="62" format="#######0.00" expression="sum( issuevalue + receiptvalue + adjvalue + duesatisfyvalue for group 1 )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
text(name=issueqty_t visible="1	0" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="2" border="0" x="8927" y="822" height="166" width="62" text="Others" html.valueishtml="0" )
compute(name=compute_1 visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="437" y="62" height="156" width="1739" format="dd/mm/yyyy hh:mm:ss" expression="today()" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
text(name=t_17 visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="0" border="0" x="52" y="62" height="156" width="343" text="Date: " html.valueishtml="0" )
compute(name=compute_24 visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="666" y="822" height="166" width="1416" format="dd/mm/yy hh:mm" expression=" ar_startdate " alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
