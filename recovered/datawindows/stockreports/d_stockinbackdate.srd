footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=godown dbname="godown"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=decimal(2) updatewhereclause=yes name=purchaseprice dbname="PurchasePrice"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
column=(type=decimal(6) updatewhereclause=yes name=stockvalue dbname="StockValue"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="Class"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
 retrieve="SELECT 
	godown = case :as_allgodown when 'Y' then 'All Godown'
				else (select G.Name 
				 		From Godown G where G.Gcode = :ai_Gcode)
				end, 
	Date=S.Date,
	Code = CASE :as_ReportType WHEN 'M' THEN I.ManfCode 
			WHEN 'C' THEN I.ICatCode 
			ELSE I.ICCode END,
	Name = CASE :as_ReportType WHEN 'M' THEN M.name 
			WHEN 'C' THEN IC.name 
			ELSE  ICL.name END,
	AliasName=I.customicode, 
	Item=I.Name,
	active=CASE I.active WHEN 1 THEN 'Y' ELSE 'N' END,
	PurchasePrice=S.purchaseprice,
	PackUnits=S.PackUnits,   
	Stock = sum(S.Stock),   
	UnitPrice = Case :ai_pricetype
		WHEN 2 THEN Round(S.purchaseprice/ CASE WHEN S.PackUnits > 0 THEN S.PackUnits ELSE 1 END, 2)
		WHEN 1 THEN Round(max(S.Saleprice) / CASE WHEN S.PackUnits > 0 THEN S.PackUnits ELSE 1 END, 2)
		WHEN 3 THEN Round(max(S.avgprice), 2) END ,
	StockValue = Sum(S.Stock) * 
		Case :ai_pricetype
		WHEN 2 THEN Round(S.purchaseprice/ CASE WHEN S.PackUnits > 0 THEN S.PackUnits ELSE 1 END, 2)
		WHEN 1 THEN Round(max(S.Saleprice) / CASE WHEN S.PackUnits > 0 THEN S.PackUnits ELSE 1 END, 2)
		WHEN 3 THEN Round(max(S.avgprice), 2) END,
	Manufacturer=M.name,
	Class=ICL.name,
	Category=IC.name

FROM 
	StockReport S,
	Item I,
	Manufacturer M,   
	ItemCategory IC,
	ItemClass ICL
WHERE
	S.Date = :ad_date AND
	( I.ICode = S.ICode ) AND 
	( S.GCode IN 
		(select case :as_allgodown when 'Y' then gcode else :ai_GCode end 
		from godown) ) AND
	( CASE :as_ReportType 
		 WHEN 'M' THEN I.ManfCode
		 WHEN 'C' THEN I.ICatCode 
		 ELSE I.ICCode END IN (:ai_code) ) AND
	( M.ManfCode = I.ManfCode ) and
	( I.ICatCode= IC.ICatCode) and
	( I.ICCode=ICL.ICCode)

GROUP BY 
	S.Date,
	I.Name, 
	I.CustomICode, 
	I.Active,
	S.PurchasePrice, 
	S.PackUnits, 
	I.ManfCode,
	M.Name, 
	I.ICatCode,
	IC.Name, 
	I.ICCode,
	ICL.Name

ORDER BY
	Name,
	CODE,
	Item,
	AliasName
"
  arguments=(("as_ReportType", string), ("ai_Code", numberlist), ("ai_PriceType", number), ("ad_date", datetime), ("ai_gcode", number), ("as_allgodown", string))
 sort="name A, code A, item A, aliasname A"
)
