table(column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="Item.purprice"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="QTY"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.name"  )
column=(type=char(60) updatewhereclause=yes name=classname dbname="classname"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
column=(type=decimal(6) updatewhereclause=yes name=packqty dbname="PackQty"  )
column=(type=decimal(6) updatewhereclause=yes name=stockvalue dbname="StockValue"  )
column=(type=char(60) updatewhereclause=yes name=itempart dbname="ItemPart"  )
column=(type=char(100) updatewhereclause=yes name=description dbname="ItemPart.Description"  )
column=(type=char(60) updatewhereclause=yes name=masterpartno dbname="masterpartno"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(8000) updatewhereclause=yes name=mastermodels dbname="mastermodels"  )
column=(type=char(100) updatewhereclause=yes name=application dbname="Application"  )
 retrieve="SELECT
	Item.Name,  
	aliasname=item.customicode, 
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	Item.purprice,   
	Item.PackUnits,   
	QTY = isnull(sum(GodownDetail.CurrQty),0),   
	Manufacturer.name,
	classname=itemclass.name,
	Category=itemcategory.name,
	UnitPrice = Case :ai_pricetype 
						WHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
						WHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
						WHEN 3 THEN Round(max(Item.avgprice), 2)
					END ,
	PackQty =isnull( Round(sum(GodownDetail.CurrQty) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2),0),
	StockValue = isnull(Sum(GodownDetail.CurrQty),0) *
					 Case :ai_pricetype 
						 WHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
						 WHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
						 WHEN 3 THEN Round(max(Item.avgprice), 2)
					END,
	ItemPart=ItemPart.Name,
	ItemPart.Description,
	masterpartno = 
		CASE WHEN itempart.masteripartcode IS NULL THEN
			(SELECT DISTINCT IP.Name FROM ItemPart IP 
			WHERE IP.IPartCode = item.ipartcode)
		ELSE
			(SELECT DISTINCT IP.Name FROM ItemPart IP 
			WHERE IP.IPartCode = itempart.masteripartcode)
		END,
	Remarks = 
		CASE WHEN itempart.masteripartcode IS NULL THEN
			(SELECT DISTINCT IP.Remarks FROM ItemPart IP 
			WHERE IP.IPartCode = item.ipartcode)
		ELSE
			(SELECT DISTINCT IP.Remarks FROM ItemPart IP 
			WHERE IP.IPartCode = itempart.masteripartcode)
		END,
	mastermodels = 
		DBO.fn_GetModelListOfItemPart(
			CASE 
				WHEN itempart.masteripartcode IS NULL THEN item.ipartcode
				ELSE itempart.masteripartcode 
			END),
	Application = 
		CASE WHEN itempart.masteripartcode IS NULL THEN
			(SELECT DISTINCT IP.Application FROM ItemPart IP 
			WHERE IP.IPartCode = item.ipartcode)
		ELSE
			(SELECT DISTINCT IP.Application FROM ItemPart IP 
			WHERE IP.IPartCode = itempart.masteripartcode)
		END

FROM 
	Manufacturer,   
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)
	LEFT OUTER JOIN ItemClass ON (Item.iccode=itemclass.iccode),
	ItemCategory,
	itempart

WHERE 
	( Manufacturer.manfcode = Item.ManfCode ) and
	( Item.icatcode=itemcategory.icatcode) and
	( Item.active=1) and
	( itempart.ipartcode IN 
			(SELECT IPartCode 
			FROM ItemPart 
			WHERE 
				MasterIPartCode IN
					(SELECT IPartCode 
					FROM ItemPart	
					WHERE NAME = :as_masterpart AND MasterIPartCode IS NULL)
			UNION
			SELECT IPartCode 
			FROM ItemPart 
			WHERE 
				MasterIPartCode IN
					(SELECT MasterIPartCode FROM ItemPart	
					WHERE NAME = :as_masterpart AND MasterIPartCode IS NOT NULL)
			UNION
			SELECT IPartCode = MasterIPartCode 
			FROM ItemPart
			WHERE NAME = :as_masterpart AND MasterIPartCode IS NOT NULL
			UNION
			SELECT IPartCode FROM ItemPart WHERE NAME = :as_masterpart)
	) AND
	( Item.IPartCode = ItemPart.IPartCode )

GROUP BY 
	ItemPart.Name,
	ItemPart.Description,
	Item.name,
	item.customicode, 
	Item.Active,
	Item.purprice, 
	Item.PackUnits, 
	Manufacturer.name,
	itemcategory.name,
	Itemclass.name,
	item.IPartCode,
	itempart.MasterIPartCode
UNION
SELECT 
	Item.Name,  
	aliasname=item.customicode, 
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	Item.purprice,   
	Item.PackUnits,   
	QTY = isnull(sum(GodownDetail.CurrQty),0),   
	Manufacturer.name,
	classname=itemclass.name,
	Category=itemcategory.name,
	UnitPrice = Case :ai_pricetype 
						WHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
						WHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
						WHEN 3 THEN Round(max(Item.avgprice), 2)
					END ,
	PackQty =isnull( Round(sum(GodownDetail.CurrQty) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2),0),
	StockValue = isnull(Sum(GodownDetail.CurrQty),0) *
					 Case :ai_pricetype 
						 WHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
						 WHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
						 WHEN 3 THEN Round(max(Item.avgprice), 2)
					END,
	ItemPart=ItemPart.Name,
	ItemPart.Description,
	masterpartno = 
		CASE WHEN itempart.masteripartcode IS NULL THEN
			(SELECT DISTINCT IP.Name FROM ItemPart IP 
			WHERE IP.IPartCode = item.ipartcode)
		ELSE
			(SELECT DISTINCT IP.Name FROM ItemPart IP 
			WHERE IP.IPartCode = itempart.masteripartcode)
		END,
	Remarks = 
		CASE WHEN itempart.masteripartcode IS NULL THEN
			(SELECT DISTINCT IP.Remarks FROM ItemPart IP 
			WHERE IP.IPartCode = item.ipartcode)
		ELSE
			(SELECT DISTINCT IP.Remarks FROM ItemPart IP 
			WHERE IP.IPartCode = itempart.masteripartcode)
		END,
	mastermodels = 
		DBO.fn_GetModelListOfItemPart(
			CASE 
				WHEN itempart.masteripartcode IS NULL THEN item.ipartcode
				ELSE itempart.masteripartcode 
			END),
	Application = 
		CASE WHEN itempart.masteripartcode IS NULL THEN
			(SELECT DISTINCT IP.Application FROM ItemPart IP 
			WHERE IP.IPartCode = item.ipartcode)
		ELSE
			(SELECT DISTINCT IP.Application FROM ItemPart IP 
			WHERE IP.IPartCode = itempart.masteripartcode)
		END

FROM 
	Manufacturer,   
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)
	LEFT OUTER JOIN ItemClass ON (Item.iccode=itemclass.iccode),
	ItemCategory,
	itempart

WHERE 
	( :as_masterpart IS NULL ) and
	( Manufacturer.manfcode = Item.ManfCode ) and
	( Item.icatcode=itemcategory.icatcode) and
	( Item.active=1) and
	( Item.IPartCode = ItemPart.IPartCode )

GROUP BY 
	ItemPart.Name,
	ItemPart.Description,
	Item.Remarks,
	Item.name,
	item.customicode, 
	Item.Active,
	Item.purprice, 
	Item.PackUnits, 
	Manufacturer.name,
	itemcategory.name,
	Itemclass.name,
	item.IPartCode,
	itempart.MasterIPartCode
"
  arguments=(("as_masterpart", string), ("ai_pricetype", number))
 sort="masterpartno A, itempart A, description A"
)
