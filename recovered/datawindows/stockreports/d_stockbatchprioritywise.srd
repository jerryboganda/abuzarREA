table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=long updatewhereclause=yes name=godown_gcode dbname="Godown.GCode"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="GodownDetail.Batch"  )
column=(type=char(12) updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=long updatewhereclause=yes name=priority dbname="GodownDetail.Priority"  )
column=(type=char(1) updatewhereclause=yes name=godowndetail_locked dbname="GodownDetail.Locked"  )
column=(type=char(100) updatewhereclause=yes name=lockreason dbname="LockReason"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="Item.PackingDesc"  )
column=(type=decimal(13) updatewhereclause=yes name=rate dbname="Rate"  )
 retrieve=" SELECT	
	AliasName=I.CustomICode, 
	icode=I.icode,
	Item=I.Name, 
	active=CASE i.active WHEN 1 THEN 'Y' ELSE 'N' END,
	GroupCode=GR.Code,
	GroupName=GR.Name,
	G.GCode, 
	Godown=G.Name,  
	GD.Batch, 
	Expiry=CONVERT(varchar(12), GD.Expiry, 3), 
	GD.Priority, 
	GD.Locked,
	LockReason = (SELECT LR.Name FROM LockReason LR WHERE LR.LockReasonCode=GD.LockReasonCode),
	Stock=GD.CurrQty, 
	I.PackingDesc,
	Rate =Case :ai_pricetype 
				WHEN 2 THEN Round(I.purprice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END, 2)
				WHEN 1 THEN Round(I.Saleprice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END, 2)
				WHEN 3 THEN Round(I.avgprice, 2)
			END

FROM	
	ITEM I, 
	(SELECT Code=M.ManfCode, Name=M.Name
	FROM MANUFACTURER M
	WHERE :as_group = 'M' AND M.ManfCode IN (:ar_GroupCode)
	UNION ALL 
	SELECT Code=IC.ICatCode, Name=IC.Name
	FROM ItemCategory IC
	WHERE :as_group = 'C' AND IC.ICatCode IN (:ar_GroupCode)
	UNION ALL 
	SELECT Code=IC.ICCode, Name=IC.Name
	FROM ItemClass IC
	WHERE :as_group = 'L' AND IC.ICCode IN (:ar_GroupCode)
	UNION ALL 
	SELECT Code=IP.PackCode, Name=IP.Name
	FROM ItemPacking IP
	WHERE :as_group = 'P' AND IP.PackCode IN (:ar_GroupCode)) GR,
	GODOWNDETAIL GD, 
	Godown G
WHERE	
	CASE :as_group
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		WHEN 'P' THEN I.PackCode
	END = GR.Code AND
	I.Icode = GD.ICode AND
	GD.GCode = G.GCode
ORDER BY
	GR.Name,
	I.Name,
	G.Name,
	I.PackingDesc,
	GD.Priority,
	GD.Batch,
	GD.Expiry"
  arguments=(("as_group", string), ("ar_GroupCode", numberlist), ("ai_pricetype", number))
 sort="groupname A, item A, packingdesc A, godown A, priority A, batch A, expiry A"
)
