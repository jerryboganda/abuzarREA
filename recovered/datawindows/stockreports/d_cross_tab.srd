release 12.5;
datawindow ( units=0 timer_interval=0 processing=4 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=3 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=384 color="536870912" )
header[2](height=64 color="536870912" )
header[3](height=60 color="536870912" )
summary(height=116 color="536870912" )
footer(height=0 color="536870912" )
detail(height=88 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=name dbname="name"  )
column=(type=char(20) updatewhereclause=yes name=customicode dbname="customicode"  )
column=(type=number updatewhereclause=yes name=unitprice dbname="unitprice"  )
column=(type=number updatewhereclause=yes name=qty dbname="qty"  )
column=(type=number updatewhereclause=yes name=val dbname="val"  )
 retrieve="select  qty=case when sum(godowndetail.currqty) is null then 0
            else sum(godowndetail.currqty) 
            end,
        item.customicode,
       item.name,
       item.packunits,
       item.purprice,
       unitprice=item.purprice/item.packunits,
       godown=(select godown.name from godown where godown.gcode=1)

from item LEFT OUTER JOIN godowndetail ON (item.icode = godowndetail.icode)
where  godowndetail.gcode=1

group by item.name,
         item.customicode,
         item.purprice,
         item.packunits

union all

select qty=case  when sum(godowndetail.currqty) is null then 0
           else sum(godowndetail.currqty) 
           end,
        item.customicode,
       item.name,
       item.packunits,
       item.purprice,
       unitprice=item.purprice/item.packunits,
       godown=(select godown.name from godown where godown.gcode=2)

from item LEFT OUTER JOIN godowndetail ON (item.icode = godowndetail.icode)

where godowndetail.gcode=2

group by item.name,
         item.customicode,
         item.purprice,
         item.packunits



union all

select qty=case when sum(godowndetail.currqty) is null then 0
           else sum(godowndetail.currqty) 
           end,
       item.customicode,
       item.name,
       item.purprice,
       item.packunits,
       unitprice=item.purprice/item.packunits,
       godown=(select godown.name from godown where godown.gcode=3)

from item LEFT OUTER JOIN godowndetail ON (item.icode = godowndetail.icode)
where godowndetail.gcode=3

group by item.name,
         item.customicode,
         item.purprice,
         item.packunits"
  sort="name A, customicode A, unitprice A"
)
