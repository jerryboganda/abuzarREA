table(column=(type=char(20) updatewhereclause=yes name=groupname dbname="groupname"  )
column=(type=char(20) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(20) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=number updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=number updatewhereclause=yes name=stock dbname="stock"  )
 retrieve="Select 	
	Godown = G.Name,
	GroupName=CASE :as_Grouping
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	AliasName = I.customicode,
	ItemName = I.name,
	PackUnits = I.packunits,
	Stock = A.Stock
From  
	(Select 
		icode,
	  	gcode,
		Sum(currqty) As Stock
	From
		GodownDetail	
	Where
		Gcode In (:ai_gcode)
	Group By 
		Icode,
		Gcode
	Union All
	Select
		icode,
		gcode = ( Select Min(Gcode) From Godown Where Gcode IN (:ai_gcode) ),
		0 As Stock
	From
		Item 
	Where
		Icode Not In (Select Distinct gd.Icode From GodownDetail gd Where gd.Gcode In (:ai_gcode))) A, 
	Godown G, 
	Item I
Where
	A.icode = I.icode And
	A.gcode = G.Gcode And
	CASE :as_Grouping
		WHEN 'M' THEN I.MANFCODE
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE 
	END IN (:ai_groupcode)
"
  arguments=(("as_grouping", string), ("ai_groupcode", numberlist), ("ai_gcode", numberlist))
 sort="groupname A, aliasname A, itemname A, packunits A"
)
