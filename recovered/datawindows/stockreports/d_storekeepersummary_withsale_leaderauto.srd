header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=166 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="Saleinvcode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=datetime updatewhereclause=yes name=invdate dbname="InvDate"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Saledetail.ICode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Saledetail.Batch"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
 retrieve=" SELECT  
	Saleinvcode=sl.saleinvcode, 
	customer=(select name from accounts where accounts.acccode=max(SL.custcode)),
	address1=(select address1 from customer where customer.custcode=max(SL.custcode)),
	address2=(select address2 from customer where customer.custcode=max(SL.custcode)),
	InvDate=max(SL.Date),
	SD.ICode, 
	SD.Batch, 
	AliasName = I.CustomICode,
	Item = I.Name,
	Godown = G.Name,
	stock=(select isnull(sum(currqty),0) from godowndetail where godowndetail.Icode=Max(I.icode)),
	Rate=Max(SD.saleprice),
	Packing=MAX(I.packingdesc),
	SUM(SD.looseQty) AS Qty, 
	SUM(SD.BonusQty) AS Bonus,
	Manufacturer = M.Name
FROM
	Saledetail SD,
	SaleLedger SL,
	Manufacturer M,
	Item	I,
	Godown G
WHERE 
	SL.SaleInvCode = :ai_invCode AND
	SL.SaleInvCode = SD.SaleInvcode AND
	SD.ICode = I.ICode AND
	I.ManfCode = M.ManfCode AND
	SD.GCode = G.GCode/* AND	
	SD.GCode NOT IN 
		(SELECT TOP 1 GCode=Min(GCode)
		FROM GroupAllowedGodown
		WHERE Module = 1 AND GroupCode=:ai_groupcode
		GROUP BY Priority)*/
GROUP BY
	SL.SaleInvCode,
	SD.ICode, 
	SD.GCode,
	SD.Batch, 
	M.Name,
	I.Name,
	I.CustomICode,
	G.Name
ORDER BY
	G.Name,
	I.Name,
	I.CustomICode,
	SD.Batch"
  arguments=(("ai_invcode", number), ("ai_groupcode", number))
)
