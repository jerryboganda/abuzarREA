release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=584 color="536870912" )
summary(height=612 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=srinvcode dbname="SRInvCode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="ICode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Manufacturer"  )
 retrieve=" SELECT 
		SRInvCode=(SELECT COUNT(s.SRInvCode) 
				FROM SRLedger s, customer cc, area ar, subarea sar
				WHERE
					s.SRInvCode Between :ar_SinvCode AND :ar_LinvCode AND 
					s.custcode = cc.custcode AND 
					cc.areacode = ar.areacode AND 
					cc.subareacode = sar.subareacode AND 
					ar.areacode = sar.areacode AND 
					sar.subareacode IN (:ar_subareacode) AND
					s.Posted = 'Y'), 
		ICode=SD.ICode, 
		Batch=SD.Batch, 
		Item = I.Name,
		Packing=MAX(I.packingdesc),
		SUM(SD.looseQty) AS Qty, 
		SUM(SD.BonusQty) AS Bonus,
		SaleValue=SUM(SD.looseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * 	(1 - SL.DiscPerc * 0.01)),
		Manufacturer = CASE :ar_grouping WHEN 1 THEN ICT.Name WHEN 2 THEN M.Name ELSE IC.Name END
FROM
		SRDetail SD,
		SRLedger SL,
		Customer C,
		Area A,
		SubArea SA,
		Manufacturer M,
		ItemCategory ICT,
		ItemClass IC,
		Item	I
WHERE 
		SL.SRInvCode Between :ar_SinvCode AND :ar_LinvCode AND
		SL.SRInvCode = SD.SRInvCode AND
		SL.CustCode = C.CustCode AND
		C.AreaCode = A.AreaCode AND
		C.SubAreaCode = SA.SubAreaCode AND
		A.AreaCode = SA.AreaCode AND
		SA.SubAreaCode IN (:ar_subareacode) AND
		SL.Posted = 'Y' AND
		SD.ICode = I.ICode AND
		I.ManfCode = M.ManfCode AND
		I.ICatCode = ICT.ICatCode AND
		I.ICCode = IC.ICCode
GROUP BY
		SD.ICode, 
		SD.Batch, 
		M.Name,
		ICT.Name,
		IC.Name,
		I.Name
ORDER BY
		Manufacturer,
		I.Name 
"
  arguments=(("ar_subareacode", numberlist), ("ar_SinvCode", number), ("ar_Linvcode", number), ("ar_invlist", string), ("ar_subarealist", string), ("ar_grouping", number))
 sort="name A, item A"
)
