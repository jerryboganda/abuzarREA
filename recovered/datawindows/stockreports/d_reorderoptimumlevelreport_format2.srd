release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=400 color="536870912" )
summary(height=280 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.CustomICode"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.Name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="Item.ReorderQty"  )
column=(type=long updatewhereclause=yes name=optimumqty dbname="Item.OptimumQty"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Item.Remarks"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.Name"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(4) updatewhereclause=yes name=required dbname="Required"  )
 retrieve="SELECT 
	Item.CustomICode,   
	Stock = isnull(SUM(GodownDetail.CurrQty),0),   
	Item.Name,   
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
   Item.ReorderQty, 
   Item.OptimumQty,
	Item.Remarks,
	Manufacturer.Name,
	purprice=item.purprice,
	Packing= ISNULL((SELECT itempacking.Name FROM itempacking WHERE itempacking.packcode = item.packcode), ''),
	Required= (Case WHEN isnull(SUM(GodownDetail.CurrQty),0)>=Item.ReorderQty THEN 0
					ELSE Item.OptimumQty - isnull(SUM(GodownDetail.CurrQty),0) END)	

FROM 
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode),
	Manufacturer

WHERE
	Item.ManfCode IN (:aa_manfcode)  and
	Item.ICatCode IN (:aa_icatcode)  and
	Item.ICCode	 IN (:aa_iccode)    and
	Item.PackCode IN (:aa_packcode) and
	Item.ManfCode = Manufacturer.ManfCode

GROUP BY 
	Item.Name,   
	Item.CustomICode,   
	Item.Active,
	item.packcode,
   Item.ReorderQty,
 	Item.optimumQty,
	Item.purprice,
	Item.Remarks,
	Manufacturer.Name
HAVING 
	(Case WHEN isnull(SUM(GodownDetail.CurrQty),0)>=Item.ReorderQty THEN 0
					ELSE Item.OptimumQty - isnull(SUM(GodownDetail.CurrQty),0) END) > 0

ORDER BY
	item.name,
	Item.CustomICode

"
  arguments=(("aa_manfcode", numberlist), ("aa_icatcode", numberlist), ("aa_iccode", numberlist), ("aa_packcode", numberlist))
)
