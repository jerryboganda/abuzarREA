release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=576 color="536870912" )
summary(height=86 color="536870912" )
footer(height=0 color="536870912" )
detail(height=74 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=decimal(13) updatewhereclause=yes name=unitpurprice dbname="unitpurprice"  )
column=(type=decimal(13) updatewhereclause=yes name=unitsaleprice dbname="unitsaleprice"  )
column=(type=decimal(6) updatewhereclause=yes name=saleval dbname="saleval"  )
column=(type=decimal(6) updatewhereclause=yes name=purval dbname="purval"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="QTY"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="Manufacturer.name"  )
column=(type=decimal(13) updatewhereclause=yes name=unitmargin dbname="unitmargin"  )
column=(type=decimal(10) updatewhereclause=yes name=marginpercent dbname="marginpercent"  )
 retrieve="SELECT 
	Item.Name,  
	aliasname=item.customicode, 
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	unitpurprice=round( CASE :ai_pricetype When 3 THEN (item.avgprice) When 2 THEN (item.purprice/item.packunits) When 1 THEN (item.recentpurprice/case when item.packunits > 0 THEN item.packunits ELSE 1 END) END , 2 ) ,
	unitsaleprice=round((item.saleprice/case when item.packunits > 0 THEN item.packunits ELSE 1 END),2),
	saleval=isnull(sum(GodownDetail.CurrQty),0) * Round((item.saleprice/case when item.packunits > 0 THEN item.packunits ELSE 1 END),2),
	purval=isnull(sum(GodownDetail.CurrQty),0) * Round( CASE :ai_pricetype When 3 THEN (item.avgprice) When 2 THEN (item.purprice/case when item.packunits > 0 THEN item.packunits ELSE 1 END) When 1 THEN (item.recentpurprice/case when item.packunits > 0 THEN item.packunits ELSE 1 END) END , 2 ) ,
	Item.PackUnits,   
	QTY = isnull(sum(GodownDetail.CurrQty),0),   
	Manufacturer.name,
	unitmargin=round((item.saleprice/case when item.packunits > 0 THEN item.packunits ELSE 1 END),2) - round((item.purprice/case when item.packunits > 0 THEN item.packunits ELSE 1 END),2),
	marginpercent=((round((item.saleprice/case when item.packunits > 0 THEN item.packunits ELSE 1 END),2) - round((item.purprice/case when item.packunits > 0 THEN item.packunits ELSE 1 END),2))* 100) /round((case when item.saleprice <=0 THEN 1 else item.saleprice end/case when item.packunits > 0 THEN item.packunits ELSE 1 END),2) 
FROM 
	Manufacturer,   
	Item LEFT OUTER JOIN GodownDetail ON ( Item.ICode = GodownDetail.ICode)
WHERE 
	( Item.ManfCode IN (:ai_manfcode ) ) and
	( Manufacturer.manfcode = Item.ManfCode ) and
	( Item.active=1) 
GROUP BY 
	Item.name,
	item.customicode,
	item.active,
	Item.purprice,
	Item.avgprice,
	Item.recentpurprice,
	Item.saleprice,
	Item.PackUnits,
	Manufacturer.name
ORDER BY 
	Manufacturer.name,
	item.name
"
  arguments=(("ai_manfcode", numberlist), ("ai_pricetype", number))
)
