release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=644 color="536870912" )
summary(height=0 color="536870912" )
footer(height=4 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=item_customicode dbname="Item.CustomICode"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(20) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Purdetail.Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Purdetail.Expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="Purdetail.packQty"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="Purdetail.looseqty"  )
 retrieve="    SELECT Item.CustomICode, 
		GroupCode=
		CASE :as_reportgrouping
		WHEN 'M' THEN max(Item.ManfCode)
		WHEN 'C' THEN max(Item.ICatCode)
		WHEN 'L' THEN max(Item.ICCode)
		ELSE Max(Item.PACKCODE) END,
		GroupName= 
		CASE :as_reportgrouping 
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = max(Item.ManfCode))
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = max(Item.ICatCode))
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = max(Item.ICCode))
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = max(Item.PACKCODE)) END,    
         Item.Name,   
		active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
         Item.PackUnits,   
          
         Purdetail.Batch,   
         Purdetail.Expiry,   
         Purdetail.packQty,
         purdetail.looseqty  
    FROM Purdetail,   
         Item
        
   WHERE 
          ( Purdetail.Expiry Between :adt_sdate and :adt_edate ) and
          ( Purdetail.icode=item.icode)and
		CASE :as_reportgrouping
		WHEN 'M' THEN Item.ManfCode
		WHEN 'C' THEN Item.ICatCode
		WHEN 'L' THEN Item.ICCode
		ELSE item.PACKCODE END IN (:ai_groupcode) 
GROUP BY Item.CustomICode,    
         Item.Name,   
		Item.Active,
         Item.PackUnits,   
          
         purdetail.Batch,   
         PurDetail.Expiry,   
         purDetail.packQty,
         purdetail.looseqty 

union all

SELECT Item.CustomICode, 
		GroupCode=  
			CASE :as_reportgrouping
		WHEN 'M' THEN max(Item.ManfCode)
		WHEN 'C' THEN max(Item.ICatCode)
		WHEN 'L' THEN max(Item.ICCode)
		ELSE Max(Item.PACKCODE) END,
	GroupName= 
		CASE :as_reportgrouping 
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = max(Item.ManfCode))
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = max(Item.ICatCode))
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = max(Item.ICCode))
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = max(Item.PACKCODE)) END,    
         Item.Name,   
		active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
         Item.PackUnits,   
            
         Srdetail.Batch,   
         srdetail.Expiry,   
         srdetail.packQty,
         srdetail.looseqty  
    FROM srdetail,   
         Item
   WHERE 
          ( srdetail.Expiry Between :adt_sdate and :adt_edate ) and
          ( srdetail.icode=item.icode)and
		 CASE :as_reportgrouping
		WHEN 'M' THEN Item.ManfCode
		WHEN 'C' THEN Item.ICatCode
		WHEN 'L' THEN Item.ICCode
		ELSE item.PACKCODE END IN (:ai_groupcode) 
GROUP BY Item.CustomICode,   
         Item.Name,   
		Item.Active,
         Item.PackUnits,   
         
         Srdetail.Batch,   
         SrDetail.Expiry,   
         SrDetail.packQty,
         Srdetail.looseqty 
order by 
		GroupName,
		 Item.Name,   
         Item.PackUnits,   
           
         purdetail.Batch,   
         PurDetail.Expiry,   
         purDetail.packQty,
         purdetail.looseqty 
"
  arguments=(("as_reportgrouping", string), ("ai_groupcode", numberlist), ("adt_sdate", datetime), ("adt_edate", datetime))
)
