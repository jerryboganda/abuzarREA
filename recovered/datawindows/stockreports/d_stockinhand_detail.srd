release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=576 color="536870912" )
summary(height=84 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=item_customicode dbname="Item.CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=decimal(2) updatewhereclause=yes name=item_saleprice dbname="Item.SalePrice"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="GodownDetail.CurrQty"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="GodownDetail.Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="GodownDetail.Expiry"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="Manufacturer.name"  )
 retrieve="    SELECT Item.CustomICode,   
         Item.Name,   
			active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
         Item.SalePrice,   
         Item.PackUnits,   
         GodownDetail.CurrQty,   
         GodownDetail.Batch,
			GodownDetail.Expiry,
			Manufacturer.name  
    FROM GodownDetail,
			Manufacturer,   
         Item  
   WHERE ( Item.ICode = GodownDetail.ICode ) and  
         ( ( Item.ManfCode = :manfcode ) ) and
			(  Manufacturer.manfcode = Item.ManfCode)  
"
  arguments=(("manfcode", number))
 sort="item_customicode A, item_name A"
)
