release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=300 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1812 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=char(60) updatewhereclause=yes name=categoryname dbname="categoryname"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=decimal(4) updatewhereclause=yes name=netqty dbname="netqty"  )
column=(type=long updatewhereclause=yes name=projection dbname="Projection"  )
column=(type=char(28) updatewhereclause=yes name=excessorrequired dbname="ExcessORRequired"  )
column=(type=decimal(4) updatewhereclause=yes name=excessorrequiredqty dbname="ExcessORRequiredQTY"  )
column=(type=decimal(2) updatewhereclause=yes name=itemsaleprice dbname="itemsaleprice"  )
column=(type=long updatewhereclause=yes name=itempackunits dbname="itempackunits"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=char(3) updatewhereclause=yes name=inandout dbname="InAndOut"  )
column=(type=decimal(4) updatewhereclause=yes name=currqty dbname="currqty"  )
 retrieve="select  
		aliasname=max(item.customicode),
		itemname=item.name,		
      itemcode=icode,  
		active=CASE dbo.item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	   categoryname=(select name from itemcategory where max(item.icatcode)=itemcategory.icatcode) ,
      manufacturer=(select name from manufacturer where manufacturer.manfcode=max(item.manfcode)) ,
	   netqty = Sum(H.saleqty),		 
	   Projection = :al_projection,
		ExcessORRequired =  '                            ',
		ExcessORRequiredQTY = 1234567.9999,
		itemsaleprice=item.saleprice,
		itempackunits=item.packunits,
		amount=0.00,
		InAndOut=ISNULL(max(H.InAndOut),'NO'),
		currqty = IsNull((Select  sum(currqty) 	
					from godowndetail 	
					where item.icode = godowndetail.icode),0)
FROM
item
LEFT OUTER JOIN
(SELECT  itemcode = dbo.item.icode,  
	      saleqty = Sum(dbo.saledetail.looseqty),		 
	   	InAndOut='YES'
		
	
FROM dbo.saleledger,	 
	 dbo.saledetail,
	 dbo.item
	 
WHERE  dbo.saleledger.date >= :ad_StartDate and 	
 	   dbo.saleledger.date <= :ad_EndDate and 	
	   dbo.saleledger.salecatcode IN (1, 2, 3) and	 
	   dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and	   
	   dbo.item.icatcode  IN (:aia_categories) and	  
		dbo.saledetail.icode = dbo.item.icode 
			 		 
GROUP BY saledetail.icode,
			item.icode

union all


SELECT 
       itemcode = dbo.item.icode,  
	     saleqty = (-1) * Sum(dbo.srdetail.looseqty),
		InAndOut='YES'		 
	   	
FROM dbo.srledger,	 
	  dbo.srdetail,
	  dbo.item
	
WHERE  dbo.srledger.date >= :ad_StartDate and 	
 	    dbo.srledger.date <= :ad_EndDate and 	
	    dbo.srledger.srcatcode IN (6, 7, 8) and	 
	    dbo.srledger.srinvcode = dbo.srdetail.srinvcode and	   
	    dbo.item.icatcode  IN (:aia_categories) and	  
		 dbo.srdetail.icode = dbo.item.icode 
			 		 
GROUP BY srdetail.icode,
		 	item.icode
UNION ALL
SELECT 
      itemcode = dbo.item.icode,  
	   saleqty = 0,		 
		InAndOut='YES'		 
FROM dbo.item
WHERE dbo.item.icatcode  IN (:aia_categories)
) as H ON (Item.icode = H.itemcode)

WHERE item.icatcode  IN (:aia_categories)

GROUP BY item.icode,
		 	item.name, 
		   item.saleprice,
		   item.packunits, item.active

ORDER BY categoryname,
			item.name	 "
  arguments=(("aia_Categories", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("al_Projection", number))
 sort="categoryname A"
)
