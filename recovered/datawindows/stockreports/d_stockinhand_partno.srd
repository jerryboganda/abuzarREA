table(column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="Item.purprice"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="QTY"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="Manufacturer.name"  )
column=(type=char(60) updatewhereclause=yes name=classname dbname="classname"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
column=(type=decimal(6) updatewhereclause=yes name=packqty dbname="PackQty"  )
column=(type=decimal(6) updatewhereclause=yes name=stockvalue dbname="StockValue"  )
column=(type=char(60) updatewhereclause=yes name=itempartno dbname="ItemPartName"  )
 retrieve="SELECT 
	Item.Name,  
	aliasname=item.customicode, 
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	Item.purprice,   
	Item.PackUnits,   
	QTY = isnull(sum(GodownDetail.CurrQty),0),   
	Manufacturer.name,
	classname=itemclass.name,
	Category=itemcategory.name,
	UnitPrice = Case :ai_pricetype 
		WHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
		WHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
		WHEN 3 THEN Round(max(Item.avgprice), 2)
		END ,
	PackQty =isnull( Round(sum(GodownDetail.CurrQty) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2),0),
	StockValue = isnull(Sum(GodownDetail.CurrQty),0) *
		Case :ai_pricetype 
			 WHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
			 WHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
			 WHEN 3 THEN Round(max(Item.avgprice), 2)
		END,
	ItemPartName=ItemPart.Name

FROM 
	Manufacturer,   
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)
	LEFT OUTER JOIN ItemClass ON (Item.iccode=itemclass.iccode),
	ItemCategory,
	itempart

WHERE 
	( Item.ManfCode IN (:manfcode ) ) and
	( Manufacturer.manfcode = Item.ManfCode ) and
	( Item.icatcode=itemcategory.icatcode) and
	( Item.active=1) and
	( item.ipartcode = itempart.ipartcode )

GROUP BY 
	Item.name, item.customicode, Item.Active, 
	Item.purprice, Item.PackUnits, Manufacturer.name, 
	itemcategory.name, Itemclass.name, ItemPart.Name
"
  arguments=(("manfcode", numberlist), ("ai_pricetype", number))
 sort="manufacturer_name A, item_name A"
)
