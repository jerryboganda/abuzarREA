release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=464 color="536870912" )
summary(height=568 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.CustomICode"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.Name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="Item.ReorderQty"  )
column=(type=char(20) updatewhereclause=yes name=groupname dbname="groupname"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="Class"  )
column=(type=decimal(13) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(4) updatewhereclause=yes name=dueqty dbname="DueQty"  )
 retrieve="SELECT 
	Item.CustomICode,   
	Stock = isnull(SUM(GodownDetail.CurrQty),0),
	Item.Name,
	Active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	Item.ReorderQty,
	groupname = CASE :as_type WHEN 'M' THEN ISNULL((SELECT Manufacturer.name FROM Manufacturer WHERE Manufacturer.ManfCode = item.manfcode), '')
			WHEN 'C' THEN ISNULL((SELECT ItemCategory.name FROM ItemCategory WHERE ItemCategory.ICatCode = item.icatcode), '')
			WHEN 'L' THEN ISNULL((SELECT ItemClass.name FROM ItemClass WHERE ItemClass.ICCode = item.iccode), '')
			ELSE ISNULL((SELECT itempacking.name FROM itempacking WHERE itempacking.PackCode = item.packcode), '') END,
	packing=ISNULL((SELECT itempacking.name FROM itempacking WHERE itempacking.PackCode = item.packcode), ''),
	Manufacturer=ISNULL((SELECT Manufacturer.name FROM Manufacturer WHERE Manufacturer.ManfCode = item.manfcode), ''),
	Category=ISNULL((SELECT ItemCategory.name FROM ItemCategory WHERE ItemCategory.ICatCode = item.icatcode), ''),
	Class=ISNULL((SELECT ItemClass.name FROM ItemClass WHERE ItemClass.ICCode = item.iccode), ''),
	purprice=item.purprice/(case item.packunits when 0 then 1 else item.packunits end),
	saleprice=item.saleprice/(case item.packunits when 0 then 1 else item.packunits end),
	DueQty = (select isnull(sum(SD.looseqty+SD.bonusqty),0) from saledetail SD where SD.Due IN ('X','D','S') and SD.icode=Item.Icode)
				- (select isnull(sum(DD.DeletedQty),0) from DueDeleteDetail DD where DD.icode=Item.ICode)
				- (select isnull(sum(DS.DueSatisfyQty),0) from duesatisfydetail DS where DS.icode=item.icode)
FROM 
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode),
	Manufacturer

WHERE
	( Item.ManfCode = Manufacturer.ManfCode ) and  
	CASE :as_type WHEN 'M' THEN Item.ManfCode
		WHEN 'C' THEN Item.ICatCode
		WHEN 'L' THEN Item.ICCode
				 ELSE Item.PackCode END in (:aa_code) 

GROUP BY 
	Item.Icode,
	Item.CustomICode,   
	Item.Name,   
	Item.Active,
	Item.ManfCode,
	Item.PackCode,
	Item.ICCode,
	Item.ICatCode,
	Item.ReorderQty ,  
	Item.purprice,
	Item.saleprice,
	item.packunits

ORDER BY
	groupname,
	item.name
"
  arguments=(("aa_code", numberlist), ("as_type", string))
 sort="groupname A, itemname A"
)
