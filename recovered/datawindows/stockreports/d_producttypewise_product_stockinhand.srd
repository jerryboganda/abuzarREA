table(column=(type=long key=yes update=yes updatewhereclause=yes name=productcode dbname="Product.ProductCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=productname dbname="ProductName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=chasisno dbname="Product.ChasisNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=engineno dbname="Product.EngineNo"  )
column=(type=char(100) update=yes updatewhereclause=no name=model dbname="Model"  )
column=(type=char(100) update=yes updatewhereclause=no name=purpose dbname="Purpose"  )
column=(type=char(100) update=yes updatewhereclause=no name=producttype dbname="ProductType"  )
column=(type=char(60) update=yes updatewhereclause=no name=colour dbname="Colour"  )
column=(type=char(1) update=yes updatewhereclause=yes name=finalized dbname="Product.Finalized"  )
column=(type=datetime update=yes updatewhereclause=yes name=finalizedon dbname="Product.FinalizedOn"  )
column=(type=char(1) update=yes updatewhereclause=yes name=acquired dbname="Acquired"  )
column=(type=datetime update=yes updatewhereclause=yes name=acquiredon dbname="AcquiredOn"  )
column=(type=char(1) update=yes updatewhereclause=yes name=delivered dbname="Product.Delivered"  )
column=(type=decimal(2) updatewhereclause=yes name=productcost dbname="ProductCost"  )
 retrieve="SELECT 
	ProductCode,
	ProductName=Name,
	ChasisNo,
	EngineNo,
	Model=(SELECT M.Name FROM Model M WHERE M.ModelCode=Product.ModelCode),
	Purpose=(SELECT P.Name FROM ProductPurpose P WHERE P.ProductPurposeCode=Product.ProductPurposeCode),
	ProductType=(SELECT P.Name FROM ProductType P WHERE P.ProductTypeCode=Product.ProductTypeCode),
	Colour=(SELECT C.Name FROM ItemColour C WHERE C.IColourCode =Product.IColourCode),
	Finalized,
	FinalizedOn,
	Acquired=Aquired,
	AcquiredOn=AquiredOn,
	Delivered,
	ProductCost= PurchasePrice + Transportation
FROM
	DBO.Product
WHERE 
	Finalized='Y' AND Delivered='N'
"
  update="DBO.Product" updatewhere=1 updatekeyinplace=no
  sort="producttype A, c_stockage D"
)
