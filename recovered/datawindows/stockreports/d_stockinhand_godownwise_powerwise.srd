release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=564 color="536870912" )
summary(height=92 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=godown dbname="godown"  )
column=(type=long updatewhereclause=yes name=i_icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="customicode"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory_name dbname="name"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="name"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="class"  )
column=(type=char(50) updatewhereclause=yes name=packingdescription dbname="packingdescription"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(8) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
 retrieve="SELECT 
	godown=(SELECT name FROM godown WHERE gcode=:ai_gcode),
	I.ICode,
	I.customicode,   
	active=CASE i.active WHEN 1 THEN 'Y' ELSE 'N' END,
	I.Name,
	I.PackUnits,   
	ItemCategory.name, 
	Manufacturer.name,
	class=(select name from itemclass where itemclass.iccode=Max(I.iccode)),
	packingdescription=Max(I.packingdesc),
	I.purprice,
	stock = Case When Sum(G.CurrQty) IS NULL then 0 Else Sum(G.CurrQty) End,
	UnitPrice = Round(I.purprice / I.PackUnits, 2)
FROM 
	ItemCategory,   
	(SELECT * FROM Item where item.icatcode=:al_icatcode) AS I
	LEFT OUTER JOIN 
	(SELECT * FROM GodownDetail WHERE gcode=:ai_gcode) AS G ON (I.ICode = G.ICode),
	Manufacturer  
WHERE 
     (  I.icatCode = ItemCategory.icatcode ) and
		(I.manfcode = manufacturer.manfcode)  
GROUP BY 
         Manufacturer.name, 
			ItemCategory.Name,
         I.ICode,
			I.customicode,
         I.Name,
			I.Active,
			I.purprice,
			
			I.PackUnits
			
Order By Manufacturer.name, 
			I.Name"
  arguments=(("ai_gcode", number), ("ll_icatcode", number), ("al_icatcode", number))
)
