release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=300 print.margin.top=300 print.margin.bottom=300 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1447 color="536870912" )
summary(height=1166 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=decimal(4) updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(8) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(8) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(2) updatewhereclause=yes name=srqty dbname="srqty"  )
column=(type=decimal(2) updatewhereclause=yes name=purqty dbname="purqty"  )
column=(type=decimal(2) updatewhereclause=yes name=prqty dbname="prqty"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(2) updatewhereclause=yes name=netadj dbname="netadj"  )
column=(type=decimal(2) updatewhereclause=yes name=netissue dbname="netissue"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="category"  )
column=(type=decimal(4) updatewhereclause=yes name=itemopeningstock dbname="itemopeningstock"  )
column=(type=decimal(4) updatewhereclause=yes name=currqty dbname="currqty"  )
 retrieve="select  
	icode=code1, 
	saleprice=item.saleprice/item.packunits,
	purprice=item.purprice/item.packunits,
	avgprice=item.avgprice,
	saleqty=value3,
	srqty=value4,
	purqty=value5,
	prqty=value6,
	itemname=item.name,
	netadj=value7,
	netissue=value8,
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	aliasname=item.customicode,
	Manufacturer=(select name from manufacturer where manfcode=:ar_manfcode),
	category=itemcategory.name,
	itemopeningstock= (select isnull(sum(Case When purledger.purcatcode IN (3, 7, 8)  THEN
												 purdetail.looseqty + purdetail.bonusqty
												 Else (purdetail.packqty  + purdetail.bonusqty) * purdetail.packunits 
												 END),0)
						from purdetail,purledger 
						where purledger.postdate < :ar_StartDate and 
								purledger.posted='Y'and
								purledger.purinvcode=purdetail.purinvcode and
								purdetail.icode=reportdata.code1
								 ) 
					-
					(select isnull(sum(saledetail.looseqty),0) from saledetail,saleledger 
						where saleledger.date < :ar_StartDate and 
								saleledger.saleinvcode=saledetail.saleinvcode and
								saledetail.due IS NULL and
								saledetail.icode=reportdata.code1)
					-
					(select isnull(sum(duesatisfydetail.duesatisfyqty),0) from duesatisfyheader,duesatisfydetail
					 where duesatisfyheader.duesatisfydate<:ar_Startdate and
							 duesatisfyheader.duesatisfycode=duesatisfydetail.duesatisfycode and
							 duesatisfydetail.icode=reportdata.code1)
					- 
					(select isnull(sum(issuedetail.qty),0) from issuedetail , issueheader
						where    issueheader.date < :ar_StartDate and 
									issueheader.issueinvcode=issuedetail.issueinvcode and 
									issuedetail.icode=reportdata.code1)
					 +
					(select isnull(sum(receiptdetail.qty),0) from receiptdetail , receiptheader
						where    receiptheader.date < :ar_StartDate and 
									receiptheader.posted='Y' and
									receiptheader.receiptinvcode=receiptdetail.receiptinvcode and 
									receiptdetail.icode=reportdata.code1)
					 +
					(select isnull(sum(Case when adjheader.adjcatcode=1 then
										 adjdetail.looseqty 
								ELSE 
										(-1) * adjdetail.looseqty
								END ),0)
					from adjdetail,adjheader 
					where adjheader.date <:ar_StartDate  and
							adjheader.adjcode=adjdetail.adjcode and
							adjdetail.icode=Reportdata.code1)
					 +
					(select isnull(sum(srdetail.looseqty),0) from srdetail,srledger 
					 where srledger.date < :ar_StartDate and 
							srledger.srinvcode=srdetail.srinvcode and 
							srdetail.icode=reportdata.code1)
					 -
					(select isnull(sum(prdetail.looseqty + prdetail.bonusqty),0)
						from prdetail,prledger 
						where prledger.date < :ar_StartDate and
								prledger.prinvcode=prdetail.prinvcode and
								prdetail.icode=reportdata.code1),
	
	currqty= ISNULL((select sum(currqty) from godowndetail where  icode = reportdata.code1),0)
from 
	reportdata, item, itemcategory
where 
	reportdata.code1=item.icode AND
	item.icatcode=itemcategory.icatcode
order by 
	itemcategory.name, item.name
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ar_manfcode", number))
)
