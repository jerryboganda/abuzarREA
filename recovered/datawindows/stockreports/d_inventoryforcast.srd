release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1458 color="536870912" )
summary(height=260 color="536870912" )
footer(height=0 color="536870912" )
detail(height=166 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=char(60) updatewhereclause=yes name=categoryname dbname="categoryname"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=number updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=number updatewhereclause=yes name=salevalue dbname="salevalue"  )
column=(type=number updatewhereclause=yes name=stock dbname="currqty"  )
column=(type=long updatewhereclause=yes name=projection dbname="Projection"  )
column=(type=char(28) updatewhereclause=yes name=excessorrequired dbname="ExcessORRequired"  )
column=(type=long updatewhereclause=yes name=excessorrequiredqty dbname="ExcessORRequiredQTY"  )
column=(type=decimal(2) updatewhereclause=yes name=itemsaleprice dbname="itemsaleprice"  )
column=(type=long updatewhereclause=yes name=itempackunits dbname="itempackunits"  )
column=(type=long updatewhereclause=yes name=itemrank dbname="itemrank"  )
 retrieve="SELECT  
		itemname = dbo.item.name,		
      itemcode = dbo.item.icode,  
		active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	   categoryname = dbo.itemcategory.name,
      manufacturer = dbo.manufacturer.name,
		saleqty = Round(Sum(Convert(real,dbo.saledetail.looseqty)) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2),		 
		salevalue = Round(Sum(Convert(real,dbo.saledetail.looseqty)) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2) * max(dbo.item.saleprice),
	   currqty = IsNull((Select  sum(Convert(real,currqty)) 	
					from godowndetail 	
					where dbo.item.icode = godowndetail.icode),0)/ CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END,
	   Projection = :al_projection,
		ExcessORRequired =  '                            ',
		ExcessORRequiredQTY = 1234567        ,
		itemsaleprice=max(dbo.item.saleprice),
		itempackunits= max(dbo.item.packunits),
		itemrank = 0
	
FROM dbo.saleledger,	 
	 dbo.saledetail,
	 dbo.item,
	 dbo.itemcategory,
	 dbo.manufacturer 	

WHERE  dbo.saleledger.date >= :ad_StartDate and 	
 	   dbo.saleledger.date <= :ad_EndDate and 	
	   dbo.saleledger.salecatcode IN (3) and	 
	   dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and	   
	  /* dbo.item.icatcode  IN (:aia_categories) and	  */
		case :as_group when 'P' then item.packcode
						when 'C' THEN item.icatcode
						when 'L' THEN item.iccode
						when 'M' THEN item.manfcode  end  IN (:aia_categories) and
		dbo.item.icatcode = dbo.itemcategory.icatcode and 
		dbo.item.manfcode = dbo.manufacturer.manfcode and 
	   dbo.saledetail.icode = dbo.item.icode 
			 		 
GROUP BY saledetail.icode,
			dbo.itemcategory.name,
			dbo.manufacturer.name, 	 	
			item.name, item.icode,
		 	dbo.item.packunits, item.active

ORDER BY dbo.itemcategory.name	 "
  arguments=(("aia_categories", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("al_Projection", number), ("as_group", string))
 sort="saleqty D"
)
