datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1447 color="536870912" )
summary(height=1166 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=decimal(4) updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(2) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(2) updatewhereclause=yes name=srqty dbname="srqty"  )
column=(type=decimal(2) updatewhereclause=yes name=purqty dbname="purqty"  )
column=(type=decimal(2) updatewhereclause=yes name=prqty dbname="prqty"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(2) updatewhereclause=yes name=adjinc dbname="adjinc"  )
column=(type=decimal(2) updatewhereclause=yes name=adjdec dbname="adjdec"  )
column=(type=decimal(2) updatewhereclause=yes name=issue dbname="issue"  )
column=(type=decimal(5) updatewhereclause=yes name=receipt dbname="receipt"  )
column=(type=decimal(2) updatewhereclause=yes name=totalin dbname="totalin"  )
column=(type=decimal(5) updatewhereclause=yes name=reportdata_value10 dbname="ReportData.value10"  )
column=(type=decimal(2) updatewhereclause=yes name=totalout dbname="totalout"  )
column=(type=decimal(5) updatewhereclause=yes name=othersqty dbname="othersqty"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="groupname"  )
column=(type=decimal(4) updatewhereclause=yes name=itemopeningstock dbname="itemopeningstock"  )
column=(type=decimal(4) updatewhereclause=yes name=currqty dbname="currqty"  )
 retrieve="  select icode=code1, 
			saleqty=value3,
			srqty=value4,
			purqty=value5,
			prqty=value6,
			itemname=item.name,
			adjinc=value7,
			adjdec=value8,
			issue=value9,
			receipt=value10,
			totalin=value4 + value5 + value7,value10 ,
			totalout= value3 + value6 + value8 + value9,
			othersqty=value7 - value8 - value9 + value10 - value11,
			active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
			aliasname=item.customicode,
      	groupname=(case :as_grouping when 'M' then (select name from manufacturer where manfcode=:ar_code)
												 when 'C' then (select name from itemcategory where icatcode=:ar_code)
												 when 'L' then (select name from itemclass where iccode=:ar_code)
												 when 'P' then (select name from itempacking where packcode=:ar_code)
							end),

			itemopeningstock= 
					ISNULL((SELECT	qty = sum(isnull(case pl.purcatcode 
														when 1 THEN (pd.packqty + pd.bonusqty) * pd.packunits
														when 2 THEN (pd.packqty + pd.bonusqty) * pd.packunits
														else pd.looseqty + pd.bonusqty end, 0))
							FROM purledger pl, purdetail pd
							WHERE 
								pl.posted = 'Y' AND 
								pl.purinvcode = pd.purinvcode AND
								pl.PostDate <   :ar_StartDate and 
								pd.icode = reportdata.code1) , 0)
					- 
					ISNULL((SELECT qty  = sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits)
					FROM prledger pl, prdetail pd
					WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
						pl.date <   :ar_StartDate and pd.icode = reportdata.code1), 0)
					-
					ISNULL((SELECT qty  = sum(sd.looseqty + sd.bonusqty)
					FROM saleledger sl, saledetail sd
					WHERE sl.saleinvcode = sd.saleinvcode AND
						 sl.date <   :ar_StartDate AND sd.Due IS NULL and 
						sd.icode in (  reportdata.code1)), 0)
					+
					ISNULL((SELECT qty  = sum(sd.looseqty + sd.bonusqty)
					FROM srledger sl, srdetail sd
					WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
						sl.PostDate <   :ar_StartDate and 
						sd.icode in (  reportdata.code1)), 0)
					-
					ISNULL((SELECT qty  = sum(sd.qty)
					FROM issueheader sl, issuedetail sd
					WHERE sl.issueinvcode = sd.issueinvcode AND
						sl.date <   :ar_StartDate  and sd.icode in (reportdata.code1)), 0)
				 	+
					ISNULL((select qty  = sum(sd.qty)
					FROM receiptheader sl, receiptdetail sd
					WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
						sl.PostDate <   :ar_StartDate and 
						sd.icode in (  reportdata.code1)), 0)
					+
					ISNULL((select qty = sum(sd.looseqty)
							FROM Adjheader sl, Adjdetail sd
							WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
								sl.PostedDate <   :ar_StartDate and 
								sd.icode in (  reportdata.code1)), 0)
					-
					ISNULL((SELECT qty = sum(sd.looseqty)
					FROM Adjheader sl, Adjdetail sd
					WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
							sl.PostedDate <   :ar_StartDate and 
						sd.icode in (  reportdata.code1)), 0)
					-
					ISNULL((SELECT qty = sum(d.duesatisfyqty)
					FROM duesatisfyheader h, duesatisfydetail d
					WHERE h.duesatisfycode=d.duesatisfycode AND
							h.duesatisfydate <   :ar_StartDate and 
						d.icode in (  reportdata.code1)), 0)
					-
					ISNULL((SELECT qty = -sum(d.deletedqty)
					FROM duesatisfyheader h, duedeletedetail d
					WHERE h.duesatisfycode=d.duesatisfycode AND
						h.duesatisfydate <   :ar_StartDate and 
						d.icode in (  reportdata.code1)), 0),
			   
			currqty= ISNULL((select sum(currqty) from godowndetail where  icode = reportdata.code1),0)

from reportdata, item

where reportdata.code1=item.icode 
		
order by groupname, 
			item.name

"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ar_code", number), ("as_grouping", string))
)
