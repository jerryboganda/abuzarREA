release 12.5;
datawindow ( units=0 timer_interval=0 processing=4 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=72 color="536870912" )
header[2](height=72 color="536870912" )
summary(height=116 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=customicode dbname="customicode"  )
column=(type=number updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=number updatewhereclause=yes name=currqty dbname="currqty"  )
 retrieve="  select  i.customicode, 
	i.name, 
	i.saleprice,
	i.purprice,
	i.avgprice,
	i.iccode,
	i.icatcode,
	i.packcode,
	i.manfcode,
	godown = (select name from godown where godown.gcode = i.gcode), 
	currqty = isnull((select sum(currqty) as currqty
			from godowndetail 
			where godowndetail.icode = i.icode and
				godowndetail.gcode = i.gcode 
			Group by godowndetail.icode, godowndetail.gcode), 0)

from 	(select i.icode, i.customicode, i.name, i.saleprice, i.purprice, i.avgprice,
		i.iccode, i.icatcode, i.packcode, i.manfcode, g.gcode
		from item i, godown g) AS i

order by i.icode, i.gcode
"
  sort="customicode A, saleprice A"
)
group(level=1 header.height=0 trailer.height=116 by=("customicode"  ) header.color="536870912" trailer.color="536870912" )
text(name=t_1 visible="1" band=header[1] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="0" border="0" x="9" y="4" height="64" width="457" text="Sum Of Currqty" html.valueishtml="0" )
text(name=t_2 visible="1" band=header[1] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="0" border="0" x="475" y="4" height="64" width="343" text="Godown" html.valueishtml="0" )
text(name=customicode_t visible="1" band=header[2] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="0" border="0" x="9" y="4" height="64" width="457" text="Customicode" html.valueishtml="0" )
text(name=saleprice_t visible="1" band=header[2] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="0" border="0" x="475" y="4" height="64" width="343" text="Saleprice" html.valueishtml="0" )
text(name=currqty_t visible="1" band=header[2] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="0" border="0" x="827" y="4" height="64" width="343" text="@godown" html.valueishtml="0" )
text(name=grand_sum_currqty_t visible="1" band=header[2] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="0" border="0" x="1179" y="4" height="64" width="686" text="Grand Total " html.valueishtml="0" )
compute(name=compute_4 visible="1" band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="9" y="4" height="76" width="457" format="[general]" expression="~"Grand Total~"" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_5 visible="1" band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="827" y="4" height="76" width="343" format="	f_SetColumnFormat('Qty')" expression="sum(currqty for all )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_6 visible="1" band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="1179" y="4" height="76" width="686" format="	f_SetColumnFormat('Qty')" expression="sum(grand_sum_currqty for all )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
column(name=customicode visible="1" band=detail id=1 x="9" y="4" height="76" width="457" color="0" border="0" alignment="0" format="[general]" html.valueishtml="0" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=yes edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
