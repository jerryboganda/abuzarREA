column(name=currqty visible="1" band=detail id=3 x="827" y="4" height="76" width="343" color="0" border="0" alignment="1" format="	f_SetColumnFormat('Qty')" html.valueishtml="0" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=yes edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=yes background.mode="1" background.color="536870912" font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
compute(name=grand_sum_currqty visible="1" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="1179" y="4" height="76" width="686" format="	f_SetColumnFormat('Qty')" expression="crosstabsum(1)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
crosstab(columns="godown" rows="customicode, saleprice" values="sum(currqty for crosstab)" sourcenames = "customicode, name, saleprice, purprice, avgprice, iccode, icatcode, packcode, manfcode, godown, currqty" crosstabonly=yes  band=foreground )
compute(name=compute_1 visible="1" band=trailer.1 font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="9" y="4" height="76" width="457" format="[general]" expression="customicode + ~" Total~"" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_2 visible="1" band=trailer.1 font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="827" y="4" height="76" width="343" format="	f_SetColumnFormat('Qty')" expression="sum(currqty for group 1)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_3 visible="1" band=trailer.1 font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="1179" y="4" height="76" width="686" format="	f_SetColumnFormat('Qty')" expression="sum(grand_sum_currqty for group 1)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
sparse(names="customicode")
