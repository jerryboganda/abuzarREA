release 12.5;
datawindow ( units=0 timer_interval=0 processing=4 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=72 color="536870912" )
header[2](height=72 color="536870912" )
summary(height=96 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=customicode dbname="customicode"  )
column=(type=char(20) updatewhereclause=yes name=name dbname="name"  )
column=(type=number updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=number updatewhereclause=yes name=qty dbname="qty"  )
 retrieve=" select Qty=sum(GD.currqty),
        I.Icode,
        gcode=1,
        godownname=(select name from godown where gcode=1),
        I.customicode,
        I.name,
        I.saleprice,
        stockvalue=sum(GD.currqty)*I.saleprice 
 from item I LEFT OUTER JOIN godowndetail AS GD ON (I.ICode = GD.ICode)
 where GD.gcode=1

 group by I.icode,
        I.customicode,
        I.name,
        I.saleprice 

 Union all

 select Qty=sum(GD.currqty) ,
        I.Icode,
        gcode=2,
        godownname=(select name from godown where gcode=2),
        I.customicode,
        I.name,
        I.saleprice,
        stockvalue=sum(GD.currqty)*I.saleprice
 from item I LEFT OUTER JOIN godowndetail AS GD ON (I.ICode=GD.ICode)

 where GD.gcode=2

 group by I.icode,
        I.customicode,
        I.name,
        I.saleprice 

Union all

 select Qty=sum(GD.currqty),
        I.Icode,
        gcode=3,
        godownname=(select name from godown where gcode=3),
        I.customicode,
        I.name,
        I.saleprice,
        stockvalue=sum(GD.currqty)*I.saleprice
 from item I LEFT OUTER JOIN godowndetail AS GD ON (I.ICode = GD.ICode)
 where GD.gcode=3

 group by I.icode,
          I.customicode,
        I.name,
        I.saleprice 

order by I.icode, gcode"
  sort="customicode A, name A, saleprice A"
)
group(level=1 header.height=0 trailer.height=0 by=("customicode"  ) header.color="536870912" trailer.color="536870912" )
group(level=2 header.height=0 trailer.height=0 by=("name"  ) header.color="536870912" trailer.color="536870912" )
