release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=104 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="Saleinvcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Saledetail.ICode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Saledetail.Batch"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
 retrieve=" SELECT 
		Saleinvcode=(select count(saleinvcode) 
				from saleledger 
				where
					SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND
					Posted = 'N'), 
		SD.ICode,  
		SD.Batch, 
		Item = I.Name,
		Packing=MAX(I.packingdesc),
		SUM(SD.looseQty) AS Qty, 
		SUM(SD.BonusQty) AS Bonus,
		SaleValue=SUM((SD.looseQty * (SD.SalePrice - ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) *
			(1 - SL.DiscPerc * 0.01)),
		Manufacturer = M.Name,
		SalesPerson = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = SL.SManCode)

FROM
		Saledetail SD,
		SaleLedger SL,
		Manufacturer M,
		Item	I
WHERE 
		SL.Posted = 'N' AND
		SL.SManCode = 
			CASE WHEN :ai_salemancode IS NULL THEN SL.SManCode 
			ELSE :ai_salemancode END AND
		SL.SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND
		SL.SaleInvCode = SD.SaleInvcode AND
		SD.ICode = I.ICode AND
		I.ManfCode = M.ManfCode
GROUP BY
		SD.ICode, 
		SD.Batch, 
		M.Name,
		I.Name,
		SL.SManCode
ORDER BY
		SalesPerson,
		M.Name,
		I.Name 
"
  arguments=(("ar_SinvCode", number), ("ar_Linvcode", number), ("ai_salemancode", number))
 sort="salesperson A, manufacturer A, item A, saleinvcode A, batch A"
)
