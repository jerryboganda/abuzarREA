table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="looseqty"  )
column=(type=char(251) updatewhereclause=yes name=referenceno dbname="referenceno"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="class"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="itempacking"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
 retrieve=" SELECT 
	aliasname=item.customicode,
	itemname= item.name,  
	looseqty = SUM(issuedetail.qty),
	referenceno=ISNULL(issuetype.name + CASE issueheader.issuetypecode WHEN NULL THEN '' ELSE '-' END + dbo.issueheader.referenceno, ''),
	class = ISNULL((select itemclass.name from itemclass where itemclass.iccode = item.iccode), ''),
	itempacking = itempacking.name,
	Batch = issuedetail.Batch
FROM 
	issueheader, 
	issuedetail, 
	issuetype,
	item LEFT OUTER JOIN itempacking ON ( dbo.item.packcode = dbo.itempacking.packcode)
WHERE 
	( dbo.issueheader.referenceno = :ar_refno) AND
	( dbo.issueheader.issuetypecode = :ar_issuetypecode ) AND
	( dbo.issueheader.issuetypecode = issuetype.issuetypecode ) AND
	( dbo.issueheader.issueinvcode = dbo.issuedetail.issueinvcode) AND 
	( dbo.issuedetail.icode = dbo.item.icode)
GROUP BY
	dbo.issueheader.referenceno,
	dbo.issueheader.issuetypecode,
	issuetype.name,
	item.customicode,
	item.name,
	itempacking.name,
	item.iccode,
	issuedetail.Batch

ORDER BY 
	item.name"
  arguments=(("ar_refno", string), ("ar_issuetypecode", number))
)
