table(column=(type=long updatewhereclause=yes name=invcode dbname="IssueHeader.issueinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="IssueHeader.date"  )
column=(type=char(40) updatewhereclause=yes name=department dbname="department"  )
column=(type=decimal(9) updatewhereclause=yes name=cost dbname="Cost"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(6) updatewhereclause=yes name=purchasevalue dbname="PurchaseValue"  )
column=(type=long updatewhereclause=yes name=salesmancode dbname="IssueHeader.salesmancode"  )
column=(type=char(60) updatewhereclause=yes name=user dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="IssueHeader.posted"  )
 retrieve="SELECT	h.issueinvcode, 
	h.date, 
	department=dpt.name,
	Round(sum(d.qty * d.avgprice), 0) as Cost, 
	Round(sum(d.qty * d.saleprice), 0) as SaleValue, 
	Round(sum(d.qty * d.purchaseprice), 0) as PurchaseValue, 
	h.salesmancode, 
	u.username, 
	h.posted 
FROM
	issueheader h LEFT OUTER JOIN department dpt ON (h.deptcode = dpt.deptcode),
	issuedetail d, users u
WHERE 	h.issueinvcode = d.issueinvcode and 
	h.date >= :ar_startdate and 
	h.date <= :ar_enddate and
	h.salesmancode = u.usercode
GROUP BY h.issueinvcode, h.date, h.salesmancode, u.username, dpt.name, h.posted
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
