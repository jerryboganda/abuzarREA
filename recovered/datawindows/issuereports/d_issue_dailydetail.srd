table(column=(type=char(60) updatewhereclause=yes name=name dbname="Godown.name"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="IssueHeader.posted"  )
column=(type=datetime updatewhereclause=yes name=date dbname="IssueHeader.date"  )
column=(type=char(40) updatewhereclause=yes name=department_name dbname="Department.name"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.name"  )
column=(type=decimal(5) updatewhereclause=yes name=saleprice dbname="Saleprice"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="IssueDetail.qty"  )
column=(type=char(30) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="IssueDetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="IssueDetail.expiry"  )
column=(type=long updatewhereclause=yes name=packunits dbname="IssueDetail.packunits"  )
column=(type=long updatewhereclause=yes name=issueinvcode dbname="IssueDetail.issueinvcode"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
 retrieve="SELECT G.name,
       ISSH.posted,
       ISSH.date,
       D.name,
       I.name,
       Saleprice=ISSD.price,
	  avgprice = ISSD.Avgprice,
       ISSD.qty,
		 packing=case
						when I.packcode=null then space(30) 
						else dbo.itempacking.name
					end,
       ISSD.batch, 
       ISSD.expiry,
       ISSD.packunits,
       ISSD.issueinvcode,
       datestring = Rtrim(LTrim(Str(DatePart(dd, ISSH.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, ISSH.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, ISSH.date)))), 
	    users.username
FROM issuedetail ISSD,
     item I ,
     Issueheader ISSH LEFT OUTER JOIN department D ON (ISSH.deptcode = D.deptcode),
     users,godown G,itempacking
WHERE (ISSH.date>:adt_sdate AND ISSH.date<:adt_ldate)AND
      ISSH.issueinvcode=ISSD.Issueinvcode AND
      ISSD.icode=I.icode AND
      ISSH.salesmancode=users.usercode AND
      ISSD.gcode=G.gcode AND
      (I.packcode=dbo.itempacking.packcode or I.packcode IS null)
"
  arguments=(("adt_sdate", datetime), ("adt_ldate", datetime))
)
