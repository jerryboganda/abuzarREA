table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="IssueDetail.saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="IssueDetail.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="IssueDetail.posted"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="IssueDetail.amount"  )
column=(type=char(12) updatewhereclause=yes name=salealiasname dbname="IssueDetail.salealiasname"  )
column=(type=char(60) updatewhereclause=yes name=salecustname dbname="IssueDetail.salecustname"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="IssueDetail.remarks"  )
column=(type=char(1) updatewhereclause=yes name=marked dbname="Marked"  )
column=(type=long updatewhereclause=yes name=issuerowid dbname="issuerowid"  )
column=(type=long updatewhereclause=yes name=issueinvcode dbname="issueinvcode"  )
column=(type=decimal(9) updatewhereclause=yes name=issueamount dbname="issueamount"  )
column=(type=datetime updatewhereclause=yes name=issuedate dbname="issuedate"  )
column=(type=char(60) updatewhereclause=yes name=issuecustomer dbname="issuecustomer"  )
 retrieve="SELECT  A.saleinvcode,
	A.date,
	A.posted,
	A.amount,
	A.salealiasname,
	A.salecustname,
	A.remarks,
	Marked=( CASE WHEN ISD.issueinvcode is NULL THEN 'N'ELSE 'Y' end),
	issuerowid=max(A.issrowid),
	issueinvcode=ISD.issueinvcode,
	issueamount=isnull((select sum(qty*price) from issuedetail where issuedetail.issueinvcode=ISD.issueinvcode),0),
	issuedate=(select max(issueheader.date) from issueheader where issueheader.issueinvcode=ISD.Issueinvcode),
	issuecustomer=(select name from accounts,issueheader where accounts.acccode=issueheader.acccode and issueheader.issueinvcode=ISD.issueinvcode)

FROM
		(select saleinvcode=SL.saleinvcode,
			date,
			posted,
			amount=SL.invtotal,
			salealiasname=(select aliasname from accounts where accounts.acccode=SL.custcode),
			salecustname=(select name from accounts where accounts.acccode=sL.custcode),
			remarks=SL.remarks,
			issrowid=SD.issuerowid
		
		
		from 	saleLedger SL,
			saleinvdetail SD
		where 	SL.date>=:ar_StartDate and SL.date<=:ar_EndDate and
			SL.saleinvcode=SD.saleinvcode
		) as A LEFT OUTER JOIN Issuedetail ISD ON (A.issrowid=ISD.issrowid)
GROUP BY
	A.saleinvcode,
	A.date,
	A.posted,
	A.amount,
	A.salealiasname,
	A.salecustname,
	A.remarks,
	ISD.issueinvcode
ORDER BY
	A.saleinvcode



"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
