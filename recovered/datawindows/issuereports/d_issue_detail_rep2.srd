table(column=(type=long updatewhereclause=yes name=issuecode dbname="IssueHeader.issueinvcode"  )
column=(type=long updatewhereclause=yes name=recipientcode dbname="RecipientCode" 
 values=""  )
column=(type=char(60) updatewhereclause=yes name=recipientname dbname="RecipientName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="IssueHeader.date"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.customicode"  )
column=(type=char(200) updatewhereclause=yes name=issuetype dbname="issuetype"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="IssueDetail.qty"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="IssueDetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="IssueDetail.expiry"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="ItemPacking.name"  )
column=(type=decimal(5) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(9) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=char(251) updatewhereclause=yes name=referenceno dbname="referenceno"  )
column=(type=datetime updatewhereclause=yes name=referencedate dbname="referencedate"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="AvgPrice"  )
 retrieve="SELECT
	issueheader.issueinvcode, 
	RecipientCode =issueheader.RecipientCode,
	RecipientName = 
		CASE issueheader.RecipientCode 
		WHEN 1 THEN
			(SELECT D.Name FROM Department D WHERE D.DeptCode = issueheader.DeptCode)
		WHEN 4 THEN
			(SELECT S.Name FROM Salesman S WHERE S.SalesManCode = issueheader.SManCode)
		ELSE
			(SELECT A.Name FROM Accounts A WHERE A.AccCode = issueheader.Acccode)
		END,
	issueheader.date,
	item.name,
	item.customicode,
	issuetype = ISNULL((select name from issuetype where issuetypecode = issueheader.issuetypecode), ''),
	issuedetail.qty,
	issuedetail.batch,
	issuedetail.expiry,
	itempacking.name,
	saleprice=issuedetail.price,
	amount=issuedetail.qty * issuedetail.price,
	referenceno = ISNULL((select name from issuetype where issuetypecode = issueheader.issuetypecode), '') + CASE issueheader.issuetypecode WHEN NULL THEN '' ELSE '-' END + dbo.issueheader.referenceno,
	referencedate = issueheader.referencedate,
	AvgPrice = issuedetail.AvgPrice
FROM 	 
	issueheader, issuedetail, item LEFT OUTER JOIN itempacking ON (item.packcode = itempacking.packcode)
WHERE  
	dbo.issueheader.date >= :ad_StartDate and
	dbo.issueheader.date <= :ad_EndDate  and
	issueheader.issueinvcode=issuedetail.issueinvcode and
	issuedetail.icode=item.icode
ORDER BY 
	issueheader.issueinvcode"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime))
)
