table(column=(type=long updatewhereclause=yes name=issueinvcode dbname="SaleInvDetail.issueinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleInvDetail.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="SaleInvDetail.posted"  )
column=(type=decimal(9) updatewhereclause=yes name=amount dbname="SaleInvDetail.amount"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="SaleInvDetail.aliasname"  )
column=(type=char(60) updatewhereclause=yes name=issuename1 dbname="SaleInvDetail.issuename1"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SaleInvDetail.remarks"  )
column=(type=char(1) updatewhereclause=yes name=marked dbname="Marked"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=decimal(2) updatewhereclause=yes name=saleamount dbname="saleamount"  )
column=(type=datetime updatewhereclause=yes name=saleinvdate dbname="saleinvdate"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
 retrieve="SELECT A.issueinvcode,
	A.date,
	A.posted,
	A.amount,
	A.aliasname,
	A.issuename1,
	A.remarks,
	Marked=( CASE WHEN SD.saleinvcode is NULL THEN 'N'ELSE 'Y' end),
	/*issuerowid=A.issrowid,*/
	saleinvcode=SD.saleinvcode,
	
	saleamount=(select saleledger.invtotal from saleledger where saleledger.saleinvcode=SD.saleinvcode),
	saleinvdate=(select saleledger.date from saleledger where saleledger.saleinvcode=SD.saleinvcode),
	customer=(select name from accounts,saleledger where accounts.acccode=saleledger.custcode and saleledger.saleinvcode=SD.saleinvcode)

FROM
		(select issueinvcode=ISH.issueinvcode,
			date,
			posted,
			amount=(select isnull(sum(qty*price),0) from issuedetail where issuedetail.issueinvcode=ISH.issueinvcode),
			aliasname=(select aliasname from accounts where accounts.acccode=ISH.acccode),
			issuename1=(select name from accounts where accounts.acccode=ISH.acccode),
			remarks=ISH.remarks,
			issrowid=ISD.issrowid
		
		
		from 	issueheader ISH,
			issuedetail ISD
		where 	ISH.date>=:ar_StartDate and ISH.date<=:ar_EndDate and
			ISH.issueinvcode=ISD.issueinvcode
		) as A LEFT OUTER JOIN Saleinvdetail SD ON (A.issrowid = SD.issuerowid)
GROUP BY
	issueinvcode,
	A.date,
	A.posted,
	A.amount,
	A.aliasname,
	A.issuename1,
	A.remarks,
	SD.saleinvcode
ORDER BY
	issueinvcode



"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
