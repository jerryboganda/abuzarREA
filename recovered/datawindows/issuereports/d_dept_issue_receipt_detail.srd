table(column=(type=char(12) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(40) updatewhereclause=yes name=department dbname="Department"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=char(7) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(5) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(9) updatewhereclause=yes name=value dbname="Value"  )
column=(type=char(100) updatewhereclause=yes name=refno dbname="RefNo"  )
 retrieve="SELECT 
	doctype = 'IS' + LTRIM(RTRIM(STR(h.IssueInvCode, 10))), 
	Department=DT.Name,
	Code = H.IssueInvCode,
	Type = 'Issue',
	Date=H.Date,
	UserName=U.UserName,
	AliasName=I.CustomICode,
	ItemName=I.Name,
	Batch=D.Batch,
	Expiry=D.Expiry,
	Qty=D.Qty,
	Price=D.Price, 
	Value = -(D.Price * D.Qty),
	RefNo = H.ReferenceNo
FROM
	IssueHeader H LEFT OUTER JOIN Department DT ON (H.DeptCode = DT.DeptCode),
	IssueDetail D, Item I, Users U
WHERE
	H.IssueInvCode = D.IssueInvCode AND
	DT.DeptCode IN (:ai_deptcode) AND
	H.Date >= :ad_startdate AND 
	H.Date <= :ad_enddate AND 
	D.ICode = I.ICode AND
	H.SalesManCode = U.UserCode
UNION ALL
SELECT 
	doctype = 'RC' + LTRIM(RTRIM(STR(h.ReceiptInvCode, 10))), 
	Department=DT.Name,
	Code = H.ReceiptInvCode,
	Type = 'Receipt',
	Date=H.Date, 
	UserName=U.UserName,
	AliasName=I.CustomICode,
	ItemName=I.Name,
	Batch=D.Batch,
	Expiry=D.Expiry,
	Qty=D.Qty,
	Price=D.Price,
	Value = D.Price * D.Qty,
	RefNo = H.ReferenceNo
FROM
	ReceiptHeader H 	LEFT OUTER JOIN Department DT ON (H.DeptCode = DT.DeptCode),
	ReceiptDetail D, Item I, Users U
WHERE
	H.ReceiptInvCode = D.ReceiptInvCode AND
	DT.DeptCode IN (:ai_deptcode) AND
	H.Date >= :ad_startdate AND 
	H.Date <= :ad_enddate AND 
	D.ICode = I.ICode AND
	H.SalesManCode = U.UserCode
ORDER BY
	Department,
	Date,
	Type,
	Code,
	ItemName
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_deptcode", numberlist))
 sort="department A, type A, code A, date A, itemname A, aliasname A, batch A, expiry A"
)
