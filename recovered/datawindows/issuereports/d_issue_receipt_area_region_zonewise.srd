release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=528 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=decimal(4) updatewhereclause=yes name=issueqty dbname="IssueQty"  )
column=(type=decimal(16) updatewhereclause=yes name=issuevalue dbname="IssueValue"  )
column=(type=decimal(4) updatewhereclause=yes name=receiptqty dbname="ReceiptQty"  )
column=(type=decimal(16) updatewhereclause=yes name=receiptvalue dbname="ReceiptValue"  )
column=(type=decimal(4) updatewhereclause=yes name=netqty dbname="NetQty"  )
column=(type=decimal(16) updatewhereclause=yes name=netvalue dbname="NetValue"  )
 retrieve="SELECT
	GroupCode = CASE :as_GroupType
		WHEN 'R' THEN (SELECT RegionCode FROM Region WHERE RegionCode = :ai_Groupcode)
		WHEN 'Z' THEN (SELECT ZoneCode FROM Zone WHERE ZoneCode = :ai_Groupcode)
		ELSE NULL END,
	GroupName = CASE :as_GroupType
		WHEN 'R' THEN (SELECT Region.Name FROM Region WHERE RegionCode = :ai_Groupcode)
		WHEN 'Z' THEN (SELECT Zone.Name FROM Zone WHERE ZoneCode = :ai_Groupcode)
		ELSE 'SELECTED AREAS' END,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	Area = A.Name,
	IssueQty = SUM(IR.IssueQty),
	IssueValue = SUM(IR.IssueValue),
	ReceiptQty = SUM(IR.ReceiptQty),
	ReceiptValue = SUM(IR.ReceiptValue),
	NetQty = SUM(IR.IssueQty) - SUM(IR.ReceiptQty),
	NetValue = SUM(IR.IssueValue) - SUM(IR.ReceiptValue)
FROM
	Area A, 
	Item I,
	(SELECT
		D.ICODE,
		H.AreaCode,
		IssueQty=Sum(D.Qty),
		IssueValue=SUM(D.Qty * 
				(CASE :ai_pricetype
				WHEN 1 THEN D.SalePrice 
				WHEN 2 THEN D.PurchasePrice
				ELSE D.AvgPrice END / CASE :ai_pricetype WHEN 3 THEN 1 ELSE CASE D.PackUnits WHEN 0 THEN 1 ELSE D.Packunits END END) ),
		ReceiptQty=0,
		ReceiptValue=0
	FROM
		IssueHeader H, 
		IssueDetail D
	WHERE
		H.IssueInvCode = D.IssueInvcode AND
		H.Date >= :adt_startdate AND H.Date <= :adt_enddate AND
		H.AreaCode IN (:ai_areacode) AND
		H.POSTED IN (:as_posted)
	GROUP BY
		H.AreaCode,
		D.ICode
	UNION ALL
	SELECT
		D.ICODE,
		H.AreaCode,
		IssueQty=0,
		IssueValue=0,
		ReceiptQty=SUM(D.Qty),
		ReceiptValue=SUM(D.Qty * 
				(CASE :ai_pricetype
				WHEN 1 THEN D.SalePrice 
				WHEN 2 THEN D.PurchasePrice
				ELSE D.AvgPrice END / CASE :ai_pricetype WHEN 3 THEN 1 ELSE CASE D.PackUnits WHEN 0 THEN 1 ELSE D.Packunits END END) )
	FROM
		ReceiptHeader H, 
		ReceiptDetail D
	WHERE
		H.ReceiptInvCode = D.ReceiptInvcode AND
		H.Date >= :adt_startdate AND H.Date <= :adt_enddate AND
		H.AreaCode IN (:ai_areacode) AND
		H.POSTED IN (:as_posted)
	GROUP BY
		H.AreaCode,
		D.ICode) IR
WHERE
	I.ICode = IR.ICode AND
	IR.AreaCode = A.AreaCode AND
	I.Active = 1
GROUP BY
	A.Name,
	I.Name,
	I.CustomICode
ORDER BY
	GroupName,
	Area,
	ItemName,
	AliasName"
  arguments=(("as_grouptype", string), ("ai_groupcode", number), ("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_areacode", numberlist), ("ai_pricetype", number), ("as_posted", stringlist))
)
