table(column=(type=long updatewhereclause=yes name=issuecode dbname="IssueHeader.issueinvcode"  )
column=(type=char(50) updatewhereclause=yes name=referenceno dbname="IssueHeader.referenceno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="IssueHeader.date"  )
column=(type=char(60) updatewhereclause=yes name=recipienttype dbname="recipienttype"  )
column=(type=char(60) updatewhereclause=yes name=recipient dbname="recipient"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.customicode"  )
column=(type=char(20) updatewhereclause=no name=itempacking dbname="ItemPacking"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="IssueDetail.qty"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="IssueDetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="IssueDetail.expiry"  )
column=(type=decimal(5) updatewhereclause=yes name=price dbname="IssueDetail.price"  )
column=(type=decimal(9) updatewhereclause=yes name=amount dbname="amount"  )
 retrieve="SELECT 
	issueheader.issueinvcode,
	issueheader.referenceno,
	issueheader.date,
	recipienttype = recipient.name,
	recipient = CASE :ai_recipientcode When 1 Then (select name from department where deptcode = issueheader.deptcode and deptcode in (:ai_recipientlist) ) When 2 Then (Select Name From Accounts Where subcode = 3 and acccode=issueheader.acccode and acccode in (:ai_recipientlist) ) When 3 Then (Select Name from accounts where acccode=issueheader.acccode and acccode in (:ai_recipientlist) ) When 4 Then (Select name from salesman where salesmancode = issueheader.recipientsalesman and salesmancode in (:ai_recipientlist) ) End, 
	item.name,
	item.customicode, 
	ItemPacking = (SELECT P.Name FROM ItemPacking P WHERE P.PackCode= Item.PackCode),
	issuedetail.qty,
	issuedetail.batch,
	issuedetail.expiry,
	issuedetail.price,
	amount=issuedetail.qty * issuedetail.price
FROM
	issueheader,
	issuedetail,
	item, 
	recipient
WHERE  
	dbo.issueheader.date Between :ad_StartDate and :ad_EndDate and
	issueheader.recipientcode = :ai_recipientcode and
	issueheader.recipientcode = recipient.recipientcode and
	issueheader.issueinvcode=issuedetail.issueinvcode and
	issuedetail.icode=item.icode 
ORDER BY 
	issueheader.issueinvcode
"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_recipientcode", number), ("ai_recipientlist", numberlist))
)
