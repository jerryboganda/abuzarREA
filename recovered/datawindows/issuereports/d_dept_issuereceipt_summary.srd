table(column=(type=char(40) updatewhereclause=yes name=department dbname="Department"  )
column=(type=decimal(4) updatewhereclause=yes name=issueqty dbname="IssueQty"  )
column=(type=decimal(9) updatewhereclause=yes name=issueamt dbname="IssueAmt"  )
column=(type=decimal(4) updatewhereclause=yes name=receiptqty dbname="ReceiptQty"  )
column=(type=decimal(9) updatewhereclause=yes name=receiptamt dbname="ReceiptAmt"  )
 retrieve="SELECT
	Department,
	IssueQty = SUM(IssueQty),
	IssueAmt = SUM(IssueAmt),
	ReceiptQty = SUM(ReceiptQty),
	ReceiptAmt= SUM(ReceiptAmt)
FROM 
	(SELECT 
		Department=DT.Name,
		IssueQty = SUM(D.Qty),
		IssueAmt = ROUND(SUM(D.Price * D.Qty), 0),
		ReceiptQty = 0.0000,
		ReceiptAmt=0
	FROM
		IssueHeader H LEFT OUTER JOIN Department DT ON (H.DeptCode = DT.DeptCode),
		IssueDetail D, Item I, Users U
	WHERE
		H.IssueInvCode = D.IssueInvCode AND
		DT.DeptCode IN (:ai_deptcode) AND
		H.Date >= :ad_startdate AND 
		H.Date <= :ad_enddate AND 
		D.ICode = I.ICode AND
		H.SalesManCode = U.UserCode
	GROUP BY
		H.IssueInvCode, DT.Name
	UNION ALL
	SELECT 
		Department=DT.Name,
		IssueQty = 0.0000,
		IssueAmt = 0,
		ReceiptQty = SUM(D.Qty),
		ReceiptAmt = ROUND(SUM(D.Price * D.Qty), 0)
	FROM
		ReceiptHeader H 	LEFT OUTER JOIN Department DT ON (H.DeptCode = DT.DeptCode),
		ReceiptDetail D, Item I, Users U
	WHERE
		H.ReceiptInvCode = D.ReceiptInvCode AND
		DT.DeptCode IN (:ai_deptcode) AND
		H.Date >= :ad_startdate AND 
		H.Date <= :ad_enddate AND 
		D.ICode = I.ICode AND
		H.SalesManCode = U.UserCode
	GROUP BY
		H.ReceiptInvCode, DT.Name
	UNION ALL
	SELECT Depatment=D.Name, IssueQty=0, IssueAmt=0, ReceiptQty=0, ReceiptAmt=0 FROM Department D) IR
GROUP BY
	Department
ORDER BY
	Department
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_deptcode", numberlist))
)
