table(column=(type=long updatewhereclause=yes name=issueinvcode dbname="IssueInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(40) updatewhereclause=no name=department dbname="Department"  )
column=(type=char(60) updatewhereclause=no name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=no name=supplier dbname="Supplier"  )
column=(type=char(60) updatewhereclause=no name=salesperson dbname="SalesPerson"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=issueqty dbname="IssueQty"  )
column=(type=decimal(4) updatewhereclause=yes name=receiptqty dbname="ReceiptQty"  )
 retrieve="SELECT 
	IssueInvCode=H.IssueInvCode, 
	Date=H.Date,
	Department = (SELECT D.Name FROM Department D WHERE D.DeptCode=H.DeptCode),
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode=H.AccCode),
	Supplier = (SELECT A.Name FROM Accounts A WHERE A.AccCode=H.AccCode),
	SalesPerson = (SELECT S.Name FROM SalesMan S WHERE S.SalesManCode=H.RecipientSalesman),
	CustomICode = I.CustomICode,
	ItemName = I.Name,
	IssueQty = SUM(D.Qty),
	ReceiptQty = 	(SELECT Qty=SUM(RD.Qty) 
			FROM ReceiptHeader RH, ReceiptDetail RD
			WHERE RH.IssueInvCode = H.IssueInvCode AND
				RH.ReceiptInvCode = RD.ReceiptInvCode AND
				D.Icode = RD.ICode)
FROM IssueHeader H, IssueDetail D, Item I
WHERE H.IssueInvCode = D.IssueInvCode AND
	D.ICode = I.ICode AND
	H.Date BETWEEN :adt_startdate AND :adt_enddate
GROUP BY
	H.IssueInvCode,
	H.Date,
	H.DeptCode,
	H.AccCode,
	H.RecipientSalesMan,
	I.CustomICode,
	I.Name,
	D.Icode
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="issueinvcode A, itemname A"
)
