column=(type=char(1) updatewhereclause=yes initial="M" name=gender dbname="Gender"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=long update=yes updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="DischargePrescription.UserCode" 
 values=""  )
