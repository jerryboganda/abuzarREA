 values=""  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=currlistrow dbname="CurrListRow"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=long update=yes updatewhereclause=yes name=dosageunitcode dbname="DosageUnitCode" 
 values=""  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=qty dbname="Qty"  )
column=(type=char(60) update=yes updatewhereclause=yes name=dosagestrength dbname="DosageStrength"  )
column=(type=long update=yes updatewhereclause=yes name=dosagecode dbname="DosageCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=dosagefactor dbname="DosageFactor"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=routecode dbname="RouteCode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=duration dbname="Duration"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=startdate dbname="StartDate"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=inscode dbname="InsCode" 
 values=""  )
 retrieve="SELECT 
	RowID,
	Date,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = DischargePrescription.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = DischargePrescription.PatientCode),
	FHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = DischargePrescription.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = DischargePrescription.PatientCode),
	Gender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = DischargePrescription.PatientCode),
	PatientCode=PatientCode,
	AdmissionCode=AdmissionCode,
	UserCode,
	AttendingDoctCode,
	FullCode=(SELECT Item.CustomICode FROM ITEM WHERE Item.ICode = DischargePrescription.ICode),
	ItemName=(SELECT Item.Name FROM ITEM WHERE Item.ICode = DischargePrescription.ICode),
	CurrListRow=0, 
	ItemCode=0,
	ICode=ICode,
	DosageUnitCode=DosageUnitCode,
	Qty=Qty,
	DosageStrength=DosageStrength,
	DosageCode=DosageCode,
	DosageFactor=DosageFactor,
	RouteCode=RouteCode,
	Duration=Duration,
	StartDate=StartDate,
	InsCode=InsCode
FROM
	DischargePrescription
WHERE 
	DischargePrescription.AdmissionCode = :ai_code
ORDER BY
	DischargePrescription.PatientCode,
	DischargePrescription.RowID
"
  update="DischargePrescription" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
