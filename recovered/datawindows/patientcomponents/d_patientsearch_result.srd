table(column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) update=yes updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=char(73) update=yes updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(201) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(60) update=yes updatewhereclause=yes name=fatherhusband dbname="FatherHusband"  )
column=(type=char(100) update=yes updatewhereclause=yes name=prefession dbname="Prefession"  )
column=(type=char(1) update=yes updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(60) updatewhereclause=no name=customer dbname="Customer"  )
column=(type=char(25) updatewhereclause=yes name=nic dbname="NIC"  )
column=(type=char(100) updatewhereclause=yes name=mobileno1 dbname="MobileNo1"  )
column=(type=char(100) updatewhereclause=yes name=mobileno2 dbname="MobileNo2"  )
column=(type=char(100) updatewhereclause=yes name=mobileno3 dbname="MobileNo3"  )
column=(type=long updatewhereclause=yes name=lastvisit dbname="LastVisit"  )
column=(type=long updatewhereclause=yes name=lastadmission dbname="LastAdmission"  )
 retrieve="SELECT 
	PatientCode = P.PatientCode,
	PatientRegNo=P.Regno,
	PatientName= LTRIM(RTRIM(P.Name)) + ' (' + LTRIM(RTRIM(STR(P.PatientCode))) + ')',
	Phone = P.Phone,
	Address = LTRIM(RTRIM(P.Address1)) + ' ' + LTRIM(RTRIM(P.Address2)),
	FatherHusband = P.FName,
	Prefession = P.Profession,
	Gender = P.Gender,
	CustCode = P.CustCode,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode=P.CustCode),
	NIC = P.NationalIDCard,
	MobileNo1 = P.MobileNo1,
	MobileNo2 = P.MobileNo2,
	MobileNo3 = P.MobileNo3,
	LastVisit = (SELECT MAX(V.VisitCode) FROM Visit V WHERE V.PatientCode=P.PatientCode),
	LastAdmission = (SELECT MAX(PA.AdmissionCode) FROM PatientAdmission PA WHERE PA.PatientCode=P.PatientCode)
FROM
	Patient P
WHERE
	(
		P.RegNo LIKE (CASE WHEN :as_regno='' OR :as_regno IS NULL THEN '«»' ELSE :as_regno END) OR
		P.Name LIKE (CASE WHEN :as_name='' OR :as_name IS NULL THEN '«»' ELSE :as_name END) OR 
		P.FName LIKE (CASE WHEN :as_fhname='' OR :as_fhname IS NULL THEN '«»' ELSE :as_fhname END) OR 
		P.Profession LIKE (CASE WHEN :as_profession='' OR :as_profession IS NULL THEN '«»' ELSE :as_profession END) OR
		P.NationalIDCard LIKE (CASE WHEN :as_nic='' OR :as_nic IS NULL THEN '«»' ELSE :as_nic END) OR
		P.Phone LIKE (CASE WHEN :as_phone='' OR :as_phone IS NULL THEN '«»' ELSE :as_phone END) OR
		P.MobileNo1 LIKE (CASE WHEN :as_mobileno1='' OR :as_mobileno1 IS NULL THEN '«»' ELSE :as_mobileno1 END) OR
		P.MobileNo2 LIKE (CASE WHEN :as_mobileno2='' OR :as_mobileno2 IS NULL THEN '«»' ELSE :as_mobileno2 END) OR
		P.MobileNo3 LIKE (CASE WHEN :as_mobileno3='' OR :as_mobileno3 IS NULL THEN '«»' ELSE :as_mobileno3 END))
ORDER BY
	PatientName,
	PatientRegNo"
  arguments=(("as_regno", string), ("as_name", string), ("as_fhname", string), ("as_profession", string), ("as_nic", string), ("as_phone", string), ("as_mobileno1", string), ("as_mobileno2", string), ("as_mobileno3", string))
)
