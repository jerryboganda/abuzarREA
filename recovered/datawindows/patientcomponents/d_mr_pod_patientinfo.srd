datawindow ( units=0 timer_interval=0 processing=0 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=264 color="536870912" )
table(column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) update=yes updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) update=yes updatewhereclause=yes name=fhname dbname="FHName"  )
column=(type=char(46) update=yes updatewhereclause=yes name=age dbname="Age"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="M" name=gender dbname="Gender"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="PatientAdmission.PatientCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=admissioncode dbname="PatientAdmission.AdmissionCode"  )
 retrieve="SELECT 
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = PatientAdmission.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = PatientAdmission.PatientCode),
	FHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = PatientAdmission.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = PatientAdmission.PatientCode),
	Gender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = PatientAdmission.PatientCode),
	PatientCode,
	AdmissionCode
FROM 
	PatientAdmission
WHERE
	AdmissionCode = :ai_code"
  update="PatientAdmission" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
