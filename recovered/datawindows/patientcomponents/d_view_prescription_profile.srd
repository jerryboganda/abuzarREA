footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=prescode dbname="PresCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=datetime updatewhereclause=yes name=createdon dbname="CreatedOn"  )
column=(type=char(60) updatewhereclause=yes name=createdby dbname="CreatedBy"  )
column=(type=datetime updatewhereclause=yes name=lastupdated dbname="LastUpdated"  )
column=(type=char(60) updatewhereclause=yes name=lastupdatedby dbname="LastUpdatedBy"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="ItemAliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=long updatewhereclause=yes name=noofunits dbname="NoofUnits"  )
column=(type=char(60) updatewhereclause=yes name=dosage dbname="Dosage"  )
column=(type=long updatewhereclause=yes name=dosefactor dbname="DoseFactor"  )
column=(type=char(60) updatewhereclause=yes name=route dbname="Route"  )
column=(type=datetime updatewhereclause=yes name=startedon dbname="StartedOn"  )
column=(type=long updatewhereclause=yes name=duration dbname="Duration"  )
column=(type=char(60) updatewhereclause=yes name=instruction dbname="Instruction"  )
column=(type=datetime updatewhereclause=yes name=discontinuedon dbname="DiscontinuedOn"  )
 retrieve="SELECT 
	PresCode=H.PresCode,
	RegNo=(SELECT P.RegNo FROM Patient P WHERE P.PatientCode = H.PatientCode),
	Patient=(SELECT P.Name FROM Patient P WHERE P.PatientCode = H.PatientCode),
	CreatedOn=H.OriginalDate,
	CreatedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode = H.CreatedBy),
	LastUpdated=H.ModifiedDate,
	LastUpdatedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode = H.ModifiedBy),
	Doctor=(SELECT DC.Name FROM Doctors DC WHERE DC.DoctCode = H.DoctCode),
	Remarks=H.Remarks,
	ItemAliasName=I.CustomICode,
	ItemName=I.Name,
	RowID=D.RowId,
	NoofUnits=D.NoOfUnits,
	Dosage=(SELECT DS.Name FROM Dosage DS WHERE DS.DosageCode = D.DosageCode),
	DoseFactor=D.DoseFactor,
	Route=(SELECT R.Name FROM Route R WHERE R.RouteCode = D.RouteCode),
	StartedOn=D.Date,
	Duration=D.Duration,
	Instruction=(SELECT I.Name FROM Instruction I WHERE I.InsCode = D.InsCode),
	DiscontinuedOn=D.DeleteDate
FROM
	PrescriptionDeleteDetail D, PrescriptionHeader H, Item I
WHERE 
	D.PresCode = :ai_code AND
	D.PresCode = H.PresCode AND
	D.ICode = I.ICode
UNION ALL
SELECT 
	PresCode=H.PresCode,
	RegNo=(SELECT P.RegNo FROM Patient P WHERE P.PatientCode = H.PatientCode),
	Patient=(SELECT P.Name FROM Patient P WHERE P.PatientCode = H.PatientCode),
	CreatedOn=H.OriginalDate,
	CreatedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode = H.CreatedBy),
	LastUpdated=H.ModifiedDate,
	LastUpdatedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode = H.ModifiedBy),
	Doctor=(SELECT DC.Name FROM Doctors DC WHERE DC.DoctCode = H.DoctCode),
	Remarks=H.Remarks,
	ItemAliasName=I.CustomICode,
	ItemName=I.Name,
	RowID=D.RowId,
	NoofUnits=D.NoOfUnits,
	Dosage=(SELECT DS.Name FROM Dosage DS WHERE DS.DosageCode = D.DosageCode),
	DoseFactor=D.DoseFactor,
	Route=(SELECT R.Name FROM Route R WHERE R.RouteCode = D.RouteCode),
	StartedOn=D.Date,
	Duration=D.Duration,
	Instruction=(SELECT I.Name FROM Instruction I WHERE I.InsCode = D.InsCode),
	DiscontinuedOn=NULL
FROM
	PrescriptionDetail D, PrescriptionHeader H, Item I
WHERE 
	D.PresCode = :ai_code AND
	D.PresCode = H.PresCode AND
	D.ICode = I.ICode
ORDER BY
	D.RowId"
  arguments=(("ai_code", number))
)
