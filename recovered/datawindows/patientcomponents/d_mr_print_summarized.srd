	E_Doctor=E.DoctorEcho ,
	E_Institution=E.InstitutionEcho,
	E_NormalLV=E.NormalLV,
	E_RV=E.RV,

	E_DilatedLV=E.DilatedLV,
	E_DialatedLVValue=E.DialatedLVValue,
	E_DialatedRVValue=E.DialatedRVValue,
	E_DialatedLAValue=E.DialatedLAValue,
	E_DialatedRAValue=E.DialatedRAValue,
	E_DialatedARValue=E.DialatedARValue,

	E_LVSystolic=E.LVSystolicdysfunctionEcho,
	E_LVSystolicVal=E.LVSystolicdysfunctionValueEcho,

	E_RVVal=E.RVsystolicdysfunctionEcho,
	E_RVValue=E.RVSystolicDysfunctionValueEcho,
	
	E_DiastolicDysfunctionEcho = E.DiastolicDysfunctionEcho,
	E_DiastolicDysfunctionValueEcho = E.DiastolicDysfunctionValueEcho,

	E_SWMA=E.SWMAEcho,
	E_SWMAVal=E.SWMAValueEcho,
	E_EF=E.EF,
	E_EFVal=E.EFEcho,
	

	E_ValvularHeartDisease=E.ValvularHeartDiseaseEcho,
	E_MS=E.MS,
	E_MSVal=E.MSEcho,
	E_MR=E.MR,
	E_MRVal=E.MREcho,
	E_AR=E.AR,
	E_AR_Val=E.AREcho,
	E_ASE=E.ASE,
	E_ASEVal=E.ASEcho,
	E_PS=E.PS,
	E_PSVal=E.PSEcho,
	E_TR=E.TR,
	E_TRVal=E.TREcho,
	E_ASD=E.ASD,
	E_ASDVal=E.ASDEcho,
	E_VSD=E.VSD,
	E_VSDVal=E.VSDEcho,
	E_TOF=E.TOF,
	E_TOFVal=E.TOFEcho,
	E_PH=E.PulmonaryHypertension,
	E_PHVal=E.PulmonaryHypertensionEcho,
	E_Other=E.OtherEchoDetail,

	CAP=HadCoronoryAngioplasty,
	CAPOn=HadCoronoryAngioplastyOn,
	CAP_Des=DESCoronoryAngioplasty,
	CapDesQty=DESQtyCoronoryAngioplasty,
	CapDesLAD=DesLADCoronoryAngioplasty,
	CapDesLcx=DesLcxCoronoryAngioplasty,
	CapDesRCA=DesRCACoronoryAngioplasty,
	CapDesDiagnol=DesDiagnolCoronoryAngioplasty,
	CapDesOM=DesOMCoronoryAngioplasty,
	CapDesPDA=DesPDACoronoryAngioplasty,
	CapDesOther=DesOthersCoronoryAngioplasty,
	CAPBMS=BMSCoronoryAngioplasty,
	CAPBMSQty=BMSQtyCoronoryAngioplasty,
	CAPBMSLAD=BMSLADCoronoryAngioplasty,
	CAPBMSLCX=BMSLcxCoronoryAngioplasty,
	CAPBMSRCA=BMSRCACoronoryAngioplasty,
	CAPBMSDiagnol=BMSDiagnolCoronoryAngioplasty,
	CAPBMSOM=BMSOMCoronoryAngioplasty,
	CAPBMSPDA=BMSPDACoronoryAngioplasty,
	CAPBMSOther=BMSOthersCoronoryAngioplasty,

	ISR=HadPreviousISR,
	ISROn=HadPreviousISRON,
	ISRDes=DESPreviousISR,
	ISRDesQty=DESQtyISR,
	ISRDesLAD=DESLADPreviousISR,
	ISRDesLCX=DESLcxPreviousISR,
	ISRDesRCA=DESRCAPreviousISR,
	ISRDesDiagnol=DESDiagnolPreviousISR,
	ISRDesOM=DESOMPreviousISR,
	ISRDesPDA=DESPDAPreviousISR,
	ISRDesOther=DESOtherPreviousISR,
	ISRBMS=BMSPreviousISR,
	ISRBMSQty=BMSQtyISR,
	ISRBMSLAD=BMSLADPreviousISR,
	ISRBMSLCX=BMSLcxPreviousISR,
	ISRBMSRCA=BMSRCAPreviousISR,
	ISRBMSDiagnol=BMSDiagnolPreviousISR,
	ISRBMSOM=BMSOMPreviousISR,
	ISRBMSPDA=BMSPDAPreviousISR,
	ISRBMSOther=BMSOtherPreviousISR,
	REST=HadReStenting,
	RESTOn=HadReStentingOn,
	RESTDes=DESReStenting,
	RESTDesQty=DESQtyReStenting,
	RESTDesLAD=DESLADReStenting,
	RESTDesLCX=DESLcxReStenting,
	RESTDesRCA=DESRCAReStenting,
	RESTDesDiagnol=DESDiagnolReStenting,
	RESTDesOM=DESOMReStenting,
	RESTDesPDA=DESPDAReStenting,
	RESTDesOther=DESOtherReStenting,
	RESTBms=BMSReStenting,
	RESTBmsQty=BMSQtyReStenting,
	RESTBmsLAD=BMSLADReStenting,
	RESTBmsLCX=BMSLcxReStenting,
	RESTBmsRCA=BMSRCAReStenting,
	RESTBmsDiagnol=BMSDiagnolReStenting,
	RESTBmsOM=BMSOMReStenting,
	RESTBmsPDA=BMSPDAReStenting,
	RESTBmsOther=BMSOtherReStenting,

	ProvisionalDiagnosis = PD.ProvisionalDiagnosis,
	PD_Details = PD.Details

FROM 
	(SELECT Patient.PatientCode, Patient.Name, Patient.RegNo, Patient.FName, Patient.Date, Patient.AgeYears, Patient.AgeMonths, Patient.AgeDays, Patient.DOB, Patient.Address1, Patient.Gender, Patient.DoctCode, 
		A.AdmissionCode, AdmissionDate=A.Date, Discharged=A.Discharged, DischargedOn=A.DischargedOn
	FROM PatientAdmission A, Patient 
	WHERE Patient.PatientCode = :ai_code AND 
		Patient.PatientCode = A.PatientCode AND 
		A.AdmissionCode IN (SELECT MAX(PAA.AdmissionCode) FROM PatientAdmission PAA WHERE PAA.PatientCode=:ai_code)) P
	LEFT OUTER JOIN PatientFirstContact PFC ON (P.PatientCode = PFC.PatientCode AND P.AdmissionCode=PFC.AdmissionCode)
	LEFT OUTER JOIN PC ON (P.PatientCode = PC.PatientCode AND P.AdmissionCode=PC.AdmissionCode)
	LEFT OUTER JOIN  
		(SELECT GPE.* FROM GPE
		WHERE GPE.PatientCode = :ai_code AND 
		GPE.RowID IN (SELECT MAX(G.RowID) FROM GPE G WHERE G.PatientCode = :ai_code)) AS GPE ON (P.PatientCode = GPE.PatientCode AND P.AdmissionCode=GPE.AdmissionCode)
	LEFT OUTER JOIN
		(SELECT SE.* FROM SE
		WHERE SE.PatientCode = :ai_code AND 
		SE.RowID IN (SELECT MAX(S.RowID) FROM SE S WHERE S.PatientCode = :ai_code)) AS SE ON (P.PatientCode = SE.PatientCode AND P.AdmissionCode=SE.AdmissionCode)
	LEFT OUTER JOIN PrevAbnormalLabs PAL ON (P.PatientCode = PAL.PatientCode AND P.AdmissionCode=PAL.AdmissionCode)
	LEFT OUTER JOIN EmrLabInvestRec AS ELIR ON (P.PatientCode = ELIR.PatientCode AND P.AdmissionCode=ELIR.AdmissionCode)
	LEFT OUTER JOIN LabInvestRec AS LIR ON (P.PatientCode = LIR.PatientCode AND P.AdmissionCode=LIR.AdmissionCode)
	LEFT OUTER JOIN ProvDiag PD ON (P.PatientCode = PD.PatientCode AND P.AdmissionCode=PD.AdmissionCode)
	LEFT OUTER JOIN 
		(SELECT ECG.* FROM ECG 
		WHERE ECG.PatientCode = :ai_code AND 
		ECG.RowID IN (SELECT MAX(E.RowID) FROM ECG E WHERE E.PatientCode = :ai_code)) AS ECG ON (P.PatientCode = ECG.PatientCode AND P.AdmissionCode=ECG.AdmissionCode)
	LEFT OUTER JOIN 
		(SELECT Xray.* FROM Xray
		WHERE Xray.PatientCode = :ai_code AND 
		Xray.RowID IN (SELECT MAX(X.RowID) FROM Xray X WHERE X.PatientCode = :ai_code)) AS Xray ON (P.PatientCode = Xray.PatientCode AND P.AdmissionCode=Xray.AdmissionCode)
	LEFT OUTER JOIN 
		(SELECT C.* FROM CABG C
		WHERE C.PatientCode = :ai_code AND 
		C.RowID IN (SELECT MAX(CB.RowID) FROM CABG CB WHERE CB.PatientCode = :ai_code)) AS CABG ON (P.PatientCode = CABG.PatientCode AND P.AdmissionCode=CABG.AdmissionCode)
	LEFT OUTER JOIN 
		(SELECT C.* FROM CTAngiogram C
		WHERE C.PatientCode = :ai_code AND 
		C.RowID IN (SELECT MAX(CT.RowID) FROM CTAngiogram CT WHERE CT.PatientCode = :ai_code)) AS CTA ON (P.PatientCode = CTA.PatientCode AND P.AdmissionCode=CTA.AdmissionCode)
	LEFT OUTER JOIN 
		(SELECT C.* FROM CoronoryAngiogram C
		WHERE C.PatientCode = :ai_code AND 
		C.RowID IN (SELECT MAX(CAN.RowID) FROM CoronoryAngiogram CAN WHERE CAN.PatientCode = :ai_code)) AS CA ON (P.PatientCode = CA.PatientCode AND P.AdmissionCode=CA.AdmissionCode)
	LEFT OUTER JOIN 
		(SELECT TS.* FROM ThaliumScan TS
		WHERE TS.PatientCode = :ai_code AND 
		TS.RowID IN (SELECT MAX(TSC.RowID) FROM ThaliumScan TSC WHERE TSC.PatientCode = :ai_code)) AS TS ON (P.PatientCode = TS.PatientCode AND P.AdmissionCode=TS.AdmissionCode)
	LEFT OUTER JOIN 
		(SELECT E.* FROM Echo E
		WHERE E.PatientCode = :ai_code AND 
		E.RowID IN (SELECT MAX(EC.RowID) FROM ECHO EC WHERE EC.PatientCode = :ai_code)) AS E ON (P.PatientCode = E.PatientCode AND P.AdmissionCode=E.AdmissionCode)
	LEFT OUTER JOIN 
		(SELECT C.* FROM CoronoryAngioplasty C
		WHERE C.PatientCode = :ai_code AND 
		C.RowID IN (SELECT MAX(CP.RowID) FROM CoronoryAngioplasty CP WHERE CP.PatientCode = :ai_code)) AS CAP ON (P.PatientCode = CAP.PatientCode AND P.AdmissionCode=CAP.AdmissionCode)

WHERE 
	P.PatientCode = :ai_code
ORDER BY
	P.PatientCode"
  arguments=(("ai_code", number))
)
text(name=t_13 visible="1" band=header font.charset="0" font.face="Lucida Sans Unicode" font.family="2" font.height="-22" font.italic="1" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" alignment="0" border="0" x="1600" y="2328" height="120" width="96" text="℞" html.valueishtml="0" )
compute(name=compute_4 visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-8" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="27" y="1368" height="500" width="1541" format="[GENERAL]" expression="if(se_cvsexam >= 0, 'CVS:' + if(se_cvsexam=0, 'S1+S2+0', if(se_cvsexam=1, 'S1+S2+SM', if(se_cvsexam=2, 'S1+S2+ESM', if(se_cvsexam=3, 'S1+S2+DM', if(se_cvsexam=4, 'S1+S2+SM+DM', if(se_cvsexam=5, 'S1+S2+PSM', if(se_cvsexam=6, 'S1+S2+Machinery Murmur',''))))))), '') + if(se_pericardialrubexam='Y' OR se_s3exam ='Y' OR se_s4exam ='Y' OR se_osexam ='Y', '~~r~~n', '') + if(se_pericardialrubexam='Y', 'Pericardial Rub, ','')  + if( se_s3exam ='Y', 'S3,','') + if( se_s4exam ='Y', 'S4,','') + if( se_osexam ='Y', 'OS','') + if(isnull(se_otherexam),'', '~~r~~n' + se_otherexam) + if( se_chestexaminationexam ='Y', '~~r~~n' + 'Chest Exam:' + if( se_bilateralnormalvesicularbreathingexam ='Y', 'Bilateral Normal Vesicular Breathing','') + if(ISNULL(se_bilateralcrepitationexam),'', if(se_bilateralcrepitationexam IN ('B','M','F'),'~~r~~nBilateral Crepitation: ','') + if(se_bilateralcrepitationexam='B','Basel', if(se_bilateralcrepitationexam='M','UPTO Mid Level', if(se_bilateralcrepitationexam='F','Full of Chest', '')))), '') + if( se_chestexaminationexam ='Y', '~~r~~n' + if( se_ronchiexam ='Y', ' Ronchi, ','') + if(  se_wheezingexam ='Y', ' Wheezing, ','') + if(se_rightbronchialbreathingexam ='Y', ' Right Bronchial Breathing, ','') + if( se_leftbronchialbreathingexam  ='Y', 'Left Bronchial Breathing, ','') + if( se_bilateralbronchialbreathingexam ='Y', 'Bilateral Bronchial Breathing, ','') + if( se_absentairentryexam ='Y', 'Absent Air Entry',''), '') + if( se_peripheralpulsesexaminationexam='Y', '~~r~~nPeripheral Pulses Examination: ' + if( se_palpablebilaterallyinupperandlowerlimbexam='Y', 'Palpable Bilaterally in Upper and Lower Limb, ','') + if(  se_absentinleftexam ='Y', '~~r~~nAbsent Pulse In (Left): ' + if( se_radialabsentinleftexam ='Y', 'Radial A, ', '') + if( se_ulnarabsentinleftexam ='Y', 'Ulnar A, ', '')  + if(  se_brachialabsentinleftexam ='Y', 'Brachial A', ''),'') + if(  se_absentinrightexam ='Y', '~~r~~nAbsent Pulse In (Right): ' + if( se_radialabsentinrightexam ='Y', 'Radial A, ', '') + if( se_ulnarabsentinrightexam ='Y', 'Ulnar A, ', '')  + if(  se_brachialabsentinrightexam ='Y', 'Brachial A', ''),'') + if(  se_absentinleft2exam ='Y', '~~r~~nAbsent Pulse In (Left): ' + if(  se_femoralabsentinleft2exam ='Y', 'Femoral A, ', '') + if( se_poplitialabsentinleft2exam ='Y', 'Poplitial A, ', '') + if(   se_posteriortibbialabsentinleft2exam ='Y', 'Posterior Tibbial A', '') + if(    se_dorsalispaedisabsentinleft2exam  ='Y', 'Dorsalis Paedis A', ''),'') + if(  se_absentinright2exam ='Y', '~~r~~nAbsent Pulse In (Right): ' + if(  se_femoralabsentinRight2exam ='Y', 'Femoral A, ', '') + if( se_poplitialabsentinRight2exam ='Y', 'Poplitial A, ', '') + if(   se_posteriortibbialabsentinRight2exam ='Y', 'Posterior Tibbial A', '') + if(    se_dorsalispaedisabsentinRight2exam  ='Y', 'Dorsalis Paedis A', ''),''),'')" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
text(name=t_12 visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-8" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" alignment="0" border="0" x="27" y="1100" height="52" width="1541" text="Clinical Examination:" html.valueishtml="0" )
compute(name=c_left visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-8" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="27" y="468" height="620" width="1541" format="[GENERAL]" expression="chestpain + if( len(chestpainatypical) > 0, if(len(chestpain) > 0, '~~r~~n', '') + chestpainatypical, '') + if( len( shortnessofbreath ) > 0, '~~r~~n' + shortnessofbreath , '')  + if( len( relievedatrestincreaseonexertion ) > 0, '~~r~~n' + relievedatrestincreaseonexertion , '') + if( len( chestdiscomfort ) > 0, '~~r~~n' + chestdiscomfort, '') + if( len( chestheavinesstightnessonexertion) > 0, '~~r~~n' + chestheavinesstightnessonexertion,'') + if( len( pressurelikesymtomsinchest ) > 0, '~~r~~n' + pressurelikesymtomsinchest , '') + if( len( typicalanginafunctionalclass ) > 0, '~~r~~n' + typicalanginafunctionalclass, '') + if( len( dysnaeonexertionfunctionalclass) > 0, '~~r~~n' + dysnaeonexertionfunctionalclass, '') + if( len( syncopewithhofall) > 0, '~~r~~n' + syncopewithhofall, '') + if( len( syncopewithnohofall) > 0, '~~r~~n' + syncopewithnohofall, '') + if(len( patientpresentation ) > 0,  '~~r~~n' + patientpresentation ,'') + if(len(palpitations) > 0 or len(vertigo) > 0 or len(headache) > 0 or len(faintness) > 0 or len(dizziness) > 0 or len(presyncope) > 0 or len(fever) > 0, '~~r~~nComplaints of ', '') + if( len(palpitations) > 0, Palpitations +', ','') + if(len(vertigo) > 0,Vertigo +', ','') + if(len(headache) > 0, Headache +', ','') + if( len(faintness) > 0, Faintness +', ','') + if(len(dizziness) > 0, Dizziness +', ','') + if(len(presyncope) > 0, presyncope +', ','') + if( len(fever) > 0, Fever +', ','') + if(len(paininleftleg) > 0 or len(paininrightleg) > 0 or len(paininleftarm) > 0 or len(paininrightarm) > 0 or len(paininlowerlimb) > 0 or len(paininupperlimb) > 0 or len(musculoskeletonpain) > 0, '~~r~~nComplaint of Pain in ', '') + if(len(paininleftleg) > 0, paininleftleg + ', ','') + if(len(paininrightleg) > 0, paininrightleg + ', ','') + if(len(paininleftarm) > 0, paininleftarm +', ','') + if(len(paininrightarm) > 0, paininrightarm + ', ','') + if( len( paininlowerlimb ) > 0, paininlowerlimb+ ', ','') + if(len(paininupperlimb) > 0, paininupperlimb + ', ','') + if(len(paininabdomen ) >0 ,paininabdomen + ', ','') + if(len(musculoskeletonpain) > 0, musculoskeletonpain, '') + if(isnull(othercomplaints),'', '~~r~~n' + othercomplaints) /*+ if( len(pasthistoryihd)> 0 or len(pasthistorystemi) > 0 or len(pasthistorynstemi) > 0 or len(pasthistoryusa) > 0 or len(pasthistoryacs) > 0, ~"~~r~~nPatient's Past History ~",'')*/ + '~~r~~n' + if( len(pasthistoryihd)> 0,pasthistoryihd +' Back, ','') + if( len(pasthistorystemi) > 0, pasthistorystemi + ' Back, ','') + if( len(pasthistorynstemi) > 0,pasthistorynstemi + ' Back, ','') + if( len(trim(pasthistoryusa)) > 0, pasthistoryusa + ' Back, ','') + if( len(trim(pasthistoryacs)) > 0, pasthistoryacs +  ' Back','')" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
