~~n  TVCAD', '')))+if(isnull(ca_other),'','~~r~~n  Other:'+ca_other)+if(isnull(ca_remarks),'','~~r~~n  Remarks:'+ca_remarks),'') + if(ts='Y','~~r~~nThalium Scan: '+if(ISNULL(tson),'',STRING(tson,'dd-mm-yyyy hh:mm'))+if(ts_doctor='Y','~~r~~n  Consultant: '+ if(isnull(ts_doctor),'', ts_doctor),'')+if(ts_institute='Y','~~r~~n  Institution: '+ if(isnull(ts_institute),'', ts_institute),'')+if(ts_reversible='Y','~~r~~n  Reversible Ischemia Present: '+ if(ts_reversibleval='L','Mild',if(ts_reversibleval='M','Moderate',if(ts_reversibleval='S','Severe',''))),'')+if(ts_noreversible='Y','~~r~~n  No Reversible Ischemia: ','')+if(ts_myocardium='Y','~~r~~n  Myocardium Viability: '+ if(ts_myocardiumval='V','Viable',if(ts_myocardiumval='P','Partially Viable',if(ts_myocardiumval='N','Non-Viable',''))),'')+if(ts_ef='Y','~~r~~n  EF (%age):'+if(ts_efval > 0,string(ts_efval,'#####0.00'),''),'')+if(len(ts_others)>0,'~~r~~n  Others:'+ts_others,'')+if(len(ts_remarks)>0,'~~r~~n  Remarks:'+ts_remarks,''),'') + if(e_echo='Y','~~r~~nEcho: '+trim(String(e_echoon,'dd-mm-yyyy hh:mm'))+if(len(e_doctor)>0,'~~r~~n  Consultant:'+e_doctor,'')+if(len(e_institution)>0,'~~r~~n  Institution:'+e_institution,'')+if(e_normallv='Y','~~r~~n  Normal LV Size and Systolic Function','')+if(e_rv='Y','~~r~~n  Normal RV Size and Systolic Function','')+if(e_dilatedlv ='Y','~~r~~n  Dialated: ' + if(e_dialatedlvvalue='Y', 'LV,','') + if(e_dialatedrvvalue='Y', ' RV,','') + if(e_dialatedLAvalue='Y', ' LA,','') + if(e_dialatedRAvalue='Y', ' RA,','') + if(e_dialatedARvalue='Y', ' Aortic Root',''),'') + if(e_lvsystolic='Y','~~r~~n  LV Systolic Dysfunction: ' + if( e_lvsystolicval ='L', 'Mild', if( e_lvsystolicval ='M', 'Moderate', if( e_lvsystolicval ='S', 'Severe',''))),'')+if(e_rvval='Y','~~r~~n  RV Systolic Dysfunction: ' + if( e_rvvalue ='L', 'Mild', if( e_lvsystolicval ='M', 'Moderate', if( e_lvsystolicval ='S', 'Severe',''))),'') + if(e_diastolicdysfunctionecho='Y', '~~r~~n  Diastolic Dysfunction: ' + if(e_diastolicdysf