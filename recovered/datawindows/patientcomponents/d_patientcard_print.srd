table(column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=long update=yes updatewhereclause=yes initial="22" name=custcode dbname="CustCode"  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Name"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) update=yes updatewhereclause=yes name=fname dbname="FName"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="M" name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=birthdate dbname="BirthDate"  )
column=(type=char(27) updatewhereclause=no name=age dbname="Age"  )
column=(type=char(100) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(100) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=char(25) updatewhereclause=yes name=cnic dbname="CNIC"  )
column=(type=char(100) updatewhereclause=yes name=mobile dbname="Mobile"  )
column=(type=datetime updatewhereclause=yes name=issuedate dbname="IssueDate"  )
 retrieve="SELECT  
	PatientCode=Patient.PatientCode,
	CustCode=Patient.CustCode,
	RegNo=Patient.RegNo,
	Name=Patient.Name,
	Date = Patient.OriginalDate,
	FName=Patient.FName,
	Gender=Patient.Gender,
	BirthDate=Patient.DOB,
	Age=LTRIM(RTRIM(STR( (DATEDIFF(dd, Patient.DOB, getdate()) / 365), 4, 0))) + ' Yrs ' +
		LTRIM(RTRIM(STR(DATEDIFF(mm, Patient.DOB, getdate()) % 12, 4, 0))) + ' Mon ' +
		LTRIM(RTRIM(STR((DATEDIFF(dd, Patient.DOB, getdate()) % 365 % 12), 4, 0))) + ' Days',
	Address1 = Patient.Address1,
	Address2 = Patient.Address2,
	CNIC = Patient.NationalIDCard,
	Mobile = Patient.MobileNo1,
	IssueDate = GETDATE()
FROM
	Patient
WHERE 
	Patient.PatientCode IN (:ai_code) AND
	Patient.Active = 'Y'
ORDER BY
	Name"
  arguments=(("ai_code", numberlist))
)
