table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(50) updatewhereclause=yes name=fullcode dbname="Aliasname"  )
column=(type=char(60) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(25) updatewhereclause=yes name=cnic dbname="CNIC"  )
column=(type=datetime updatewhereclause=yes name=dob dbname="DOB"  )
column=(type=char(27) updatewhereclause=yes name=age dbname="Age"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=char(113) updatewhereclause=yes name=itemname dbname="itemname"  )
 retrieve="SELECT
	Code=Patient.PatientCode,
	ICode=Patient.PatientCode,
	Aliasname = Patient.RegNo,
	FatherName = Patient.FName,
	Gender = Patient.Gender,
	CNIC = Patient.NationalIDCard,
	DOB = Patient.DOB,
	Age=LTRIM(RTRIM(STR( (DATEDIFF(dd, Patient.DOB, getdate()) / 365), 4, 0))) + ' Yrs ' +
		LTRIM(RTRIM(STR(DATEDIFF(mm, Patient.DOB, getdate()) % 12, 4, 0))) + ' Mon ' +
		LTRIM(RTRIM(STR((DATEDIFF(dd, Patient.DOB, getdate()) % 365 % 12), 4, 0))) + ' Days',
	CurrListRow = 0,
	itemname = Patient.Name + ' (' + Patient.RegNo + ')' 
FROM 
	Patient
WHERE 
	Patient.PatientCode = :ai_patientcode"
  arguments=(("ai_patientcode", number))
)
