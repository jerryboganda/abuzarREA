table(column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Regno"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="patientcode"  )
column=(type=char(100) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(60) updatewhereclause=yes name=rank dbname="rank"  )
column=(type=char(25) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(25) updatewhereclause=yes name=nic dbname="NIC"  )
column=(type=long updatewhereclause=yes name=relationcode dbname="relationcode"  )
column=(type=long updatewhereclause=yes name=doctcode dbname="doctcode"  )
column=(type=long updatewhereclause=yes name=wardcode dbname="wardcode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(113) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=long updatewhereclause=yes name=recurringperiod dbname="RecurringPeriod"  )
column=(type=char(100) updatewhereclause=yes name=reference dbname="Reference"  )
 retrieve="SELECT  
	Name=P.name,
	Regno=P.regno,
	patientcode=P.patientcode,
	Address1 = P.Address1,
	Phone = P.Phone,
	rank=(select name from rank where rank.rankcode=P.rankcode),
	City=P.city,
	NIC=P.NationalIDCard,
	relationcode=P.relationcode,
	doctcode=P.doctcode,
	wardcode=P.wardcode,
	customer=(SELECT A.name FROM Accounts A WHERE P.CustCode = A.AccCode),
	patient = LTRIM(RTRIM(P.Name)) + ' (' + LTRIM(RTRIM(P.RegNo)) + ')',
	RecurringPeriod=ISNULL(P.RecurringPeriod,0),
	Reference=P.Reference
FROM Patient P, PatientCategory PC, PatientCatAllowedModule PAM
WHERE 
	P.Active='Y' AND 
	P.PatientCatCode = PC.PatientCatCode AND
	P.PatientCatCode = PAM.PatientCatCode AND	PAM.ModuleID = :ai_module

"
  arguments=(("ai_module", number))
 sort="name A, regno A, customer A"
)
