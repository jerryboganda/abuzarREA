table(column=(type=long updatewhereclause=yes name=code dbname="PatientAdmission.AdmissionCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Regno"  )
column=(type=char(60) updatewhereclause=no name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=no name=customer dbname="Customer"  )
column=(type=long updatewhereclause=yes name=patientageyears dbname="patientageyears"  )
column=(type=long updatewhereclause=yes name=patientagemonts dbname="patientagemonts"  )
column=(type=long updatewhereclause=yes name=patientagedays dbname="patientagedays"  )
column=(type=char(1) updatewhereclause=no name=gender dbname="gender"  )
column=(type=char(100) updatewhereclause=no name=patientadd1 dbname="patientadd1"  )
column=(type=char(100) updatewhereclause=no name=patientadd2 dbname="patientadd2"  )
column=(type=char(30) updatewhereclause=no name=patientphone dbname="patientphone"  )
column=(type=char(25) updatewhereclause=no name=patientnic dbname="patientnic"  )
column=(type=char(60) updatewhereclause=no name=patientcatname dbname="patientcatname"  )
column=(type=char(100) updatewhereclause=yes name=nextofkins dbname="nextofkins"  )
column=(type=long updatewhereclause=yes validationmsg="~"Please Enter Valid Patient~"" name=patientcode dbname="PatientAdmission.PatientCode"  )
column=(type=long updatewhereclause=yes validationmsg="~"Please Enter Valid Location~"" name=locationcode dbname="PatientAdmission.LocationCode"  )
column=(type=char(60) updatewhereclause=yes name=patientlocationname dbname="patientlocationname"  )
column=(type=char(60) updatewhereclause=no name=wardname dbname="wardname"  )
column=(type=long updatewhereclause=yes name=wardcode dbname="PatientLocation.WardCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=date dbname="PatientAdmission.Date"  )
column=(type=long updatewhereclause=yes name=doctorcode dbname="PatientAdmission.DoctorCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=usercode dbname="PatientAdmission.UserCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=diseasecode dbname="PatientAdmission.DiseaseCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=diagnosis dbname="PatientAdmission.Diagnosis"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="PatientAdmission.Remarks"  )
column=(type=datetime updatewhereclause=yes name=recurringserviceschargedon dbname="PatientAdmission.RecurringServicesChargedOn"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="PatientAdmission.ServiceInvCode"  )
column=(type=char(1) updatewhereclause=yes name=discharged1 dbname="PatientAdmission.Discharged1"  )
column=(type=char(1) updatewhereclause=yes name=discharged dbname="PatientAdmission.Discharged"  )
column=(type=decimal(2) updatewhereclause=yes name=amountcharged dbname="AmountCharged"  )
 retrieve="SELECT 
	PatientAdmission.AdmissionCode,
	Regno = (SELECT Patient.RegNo FROM Patient WHERE Patient.PatientCode = PatientAdmission.PatientCode),
	PatientName = (SELECT Patient.Name FROM Patient WHERE Patient.PatientCode = PatientAdmission.PatientCode),
	Customer = (SELECT Accounts.Name FROM Accounts WHERE Accounts.Acccode = PatientAdmission.CustCode),
	patientageyears=(SELECT Patient.ageyears FROM Patient WHERE Patient.PatientCode = PatientAdmission.PatientCode),
	patientagemonts=(SELECT Patient.agemonths FROM Patient WHERE Patient.PatientCode = PatientAdmission.PatientCode),
	patientagedays=(SELECT Patient.agedays FROM Patient WHERE Patient.PatientCode = PatientAdmission.PatientCode),
	gender=(SELECT Patient.gender FROM Patient WHERE Patient.PatientCode = PatientAdmission.PatientCode),
	patientadd1=(SELECT Patient.address1 FROM Patient WHERE Patient.PatientCode = PatientAdmission.PatientCode),
	patientadd2=(SELECT Patient.address1 FROM Patient WHERE Patient.PatientCode = PatientAdmission.PatientCode),
	patientphone=(SELECT Patient.phone FROM Patient WHERE Patient.PatientCode = PatientAdmission.PatientCode),
	patientnic=(SELECT Patient.nationalidcard FROM Patient WHERE Patient.PatientCode = PatientAdmission.PatientCode),
	patientcatname=(select patientcategory.name from patientcategory,patient where patient.patientcode= PatientAdmission.PatientCode and patient.patientcatcode=patientcategory.patientcatcode),
	nextofkins=patientadmission.nextofkins,
	PatientAdmission.PatientCode,   
	PatientAdmission.LocationCode,   
	patientlocationname=patientlocation.name,
	wardname=(select name from ward where ward.wardcode=patientlocation.wardcode),
	PatientLocation.WardCode,
	PatientAdmission.Date,   
	PatientAdmission.DoctorCode,   
	PatientAdmission.UserCode,
	PatientAdmission.DiseaseCode,
	PatientAdmission.Diagnosis,
	PatientAdmission.Remarks,
	PatientAdmission.RecurringServicesChargedOn,
	PatientAdmission.ServiceInvCode,
	PatientAdmission.Discharged1,
	PatientAdmission.Discharged,
	AmountCharged = ISNULL(PatientAdmission.CashCharged,0) + 
		ISNULL((SELECT SUM(MasterCashWin.Amount) FROM MasterCashWin WHERE MasterCashWin.DocumentCode = :ai_code AND MasterCashWin.DocumentType = 'PA'), 0)
FROM PatientAdmission, PatientLocation
WHERE PatientAdmission.AdmissionCode = :ai_code AND
		PatientAdmission.LocationCode = PatientLocation.LocationCode 
"
  arguments=(("ai_code", number))
)
