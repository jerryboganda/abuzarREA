release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=68 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=name dbname="Patient.name"  )
column=(type=long updatewhereclause=yes name=code dbname="Patient.Patientcode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Patient.regno"  )
column=(type=char(60) updatewhereclause=yes name=fname dbname="Patient.fname"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Patient.active"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Patient.gender"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Accounts.name"  )
column=(type=char(25) updatewhereclause=yes name=city dbname="Patient.city"  )
column=(type=long updatewhereclause=yes name=usercode dbname="Patient.UserCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=date dbname="Patient.date"  )
column=(type=datetime updatewhereclause=yes name=originaldate dbname="Patient.originaldate"  )
column=(type=long updatewhereclause=yes name=createdby dbname="Patient.createdby" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=inactivedate dbname="Patient.inactivedate"  )
column=(type=long updatewhereclause=yes name=inactivedby dbname="Patient.inactivedby" 
 values=""  )
column=(type=long updatewhereclause=yes name=locationcode dbname="Patient.locationcode" 
 values=""  )
column=(type=long updatewhereclause=yes name=patientcatcode dbname="Patient.patientcatcode" 
 values=""  )
column=(type=char(20) updatewhereclause=yes name=membershipid dbname="Patient.membershipid"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Patient.Phone"  )
column=(type=char(100) updatewhereclause=yes name=phone2 dbname="Patient.Phone2"  )
column=(type=char(100) updatewhereclause=yes name=mobileno1 dbname="Patient.MobileNo1"  )
 retrieve="SELECT 
	patient.name,
	patient.Patientcode,
	patient.regno,
	patient.fname,
	patient.active,
	patient.gender,
	accounts.name,
	patient.city,
	Patient.UserCode,
	Patient.date,
	Patient.originaldate,
	Patient.createdby,
	Patient.inactivedate,
	Patient.inactivedby,
	patient.locationcode,
	patient.patientcatcode,
	patient.membershipid,
	patient.Phone,
	patient.Phone2,
	patient.MobileNo1
FROM 
	Patient
	LEFT OUTER JOIN Accounts ON (Patient.CustCode = Accounts.AccCode)
WHERE
	patient.patientcatcode IN 
		(SELECT DISTINCT PatientCatCode 
		FROM PatientCatAllowedModule
		WHERE ModuleID = :ai_module)"
  arguments=(("ai_module", number))
)
