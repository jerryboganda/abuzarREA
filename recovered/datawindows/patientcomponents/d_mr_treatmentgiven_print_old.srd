header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="TreatmentGiven.RowID"  )
column=(type=datetime updatewhereclause=yes name=date dbname="TreatmentGiven.Date"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="TreatmentGiven.PatientCode"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="TreatmentGiven.AdmissionCode"  )
column=(type=long updatewhereclause=yes name=icode dbname="TreatmentGiven.ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=dosageunitcode dbname="TreatmentGiven.DosageUnitCode"  )
column=(type=char(255) updatewhereclause=yes name=localdosageunit dbname="LocalDosageUnit"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="TreatmentGiven.Qty"  )
column=(type=char(60) updatewhereclause=yes name=dosagestrength dbname="TreatmentGiven.DosageStrength"  )
column=(type=long updatewhereclause=yes name=dosagecode dbname="TreatmentGiven.DosageCode"  )
column=(type=long updatewhereclause=yes name=dosagefactor dbname="TreatmentGiven.DosageFactor"  )
column=(type=char(255) updatewhereclause=yes name=localdosage dbname="LocalDosage"  )
column=(type=long updatewhereclause=yes name=routecode dbname="TreatmentGiven.RouteCode"  )
column=(type=char(255) updatewhereclause=yes name=localroute dbname="LocalRoute"  )
column=(type=long updatewhereclause=yes name=duration dbname="TreatmentGiven.Duration"  )
column=(type=datetime updatewhereclause=yes name=startdate dbname="TreatmentGiven.StartDate"  )
column=(type=long updatewhereclause=yes name=inscode dbname="TreatmentGiven.InsCode"  )
column=(type=char(255) updatewhereclause=yes name=localinstruction dbname="LocalInstruction"  )
 retrieve="SELECT 
	TreatmentGiven.RowID,   
	TreatmentGiven.Date,   
	TreatmentGiven.PatientCode,   
	TreatmentGiven.AdmissionCode,   
	TreatmentGiven.ICode,   
	ItemName = (SELECT I.Name FROM Item I WHERE I.ICode = TreatmentGiven.ICode),
	TreatmentGiven.DosageUnitCode,   
	LocalDosageUnit = (SELECT DU.LocalDosageUnit FROM DosageUnit DU WHERE DU.DosageUnitCode = TreatmentGiven.DosageUnitCode),
	TreatmentGiven.Qty,   
	TreatmentGiven.DosageStrength,   
	TreatmentGiven.DosageCode,   
	TreatmentGiven.DosageFactor,   
	LocalDosage = (SELECT D.LocalDosage FROM Dosage D WHERE D.DosageCode = TreatmentGiven.DosageCode),
	TreatmentGiven.RouteCode,   
	LocalRoute = (SELECT R.LocalRoute FROM Route R WHERE R.RouteCode = TreatmentGiven.RouteCode),
	TreatmentGiven.Duration,   
	TreatmentGiven.StartDate,   
	TreatmentGiven.InsCode,
	LocalInstruction = (SELECT I.LocalInstruction FROM Instruction I WHERE I.InsCode = TreatmentGiven.InsCode)
FROM 
	TreatmentGiven  
WHERE 
	TreatmentGiven.AdmissionCode = :ai_code     
ORDER BY 
	TreatmentGiven.RowID ASC   
"
  arguments=(("ai_code", number))
)
