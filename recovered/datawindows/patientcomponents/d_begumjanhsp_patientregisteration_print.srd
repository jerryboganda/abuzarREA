footer(height=0 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=code dbname="Patient.patientcode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Patient.Regno"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Patient.name"  )
column=(type=char(100) updatewhereclause=yes name=ward dbname="Patient.ward"  )
column=(type=char(1) updatewhereclause=yes initial="M" name=gender dbname="Patient.gender" 
 values="Male	M/Female	F/"  )
column=(type=char(1) updatewhereclause=yes initial="Y" name=active dbname="Patient.active" 
 values="Yes	Y/No	N/"  )
column=(type=char(60) updatewhereclause=yes name=fname dbname="Patient.fname"  )
column=(type=datetime updatewhereclause=yes name=dob dbname="Patient.dob"  )
column=(type=long updatewhereclause=yes name=custcode dbname="Patient.custcode"  )
column=(type=long updatewhereclause=yes name=usercode dbname="Patient.usercode"  )
column=(type=datetime updatewhereclause=yes initial="today" name=date dbname="Patient.date"  )
column=(type=char(25) updatewhereclause=yes name=nationalidcard dbname="Patient.NationalIDCard"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Patient.phone"  )
column=(type=char(30) updatewhereclause=yes name=fax dbname="Patient.fax"  )
column=(type=char(35) updatewhereclause=yes name=email dbname="Patient.email"  )
column=(type=long updatewhereclause=yes initial="1" name=rankcode dbname="Patient.rankcode"  )
column=(type=long updatewhereclause=yes initial="1" name=unitcode dbname="Patient.unitcode"  )
column=(type=char(100) updatewhereclause=yes name=address1 dbname="Patient.address1"  )
column=(type=char(100) updatewhereclause=yes name=address2 dbname="Patient.address2"  )
column=(type=char(25) updatewhereclause=yes name=city dbname="Patient.city"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="doctor"  )
column=(type=long updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Please Enter Valid Age'" name=age dbname="Age"  )
column=(type=char(6) updatewhereclause=yes name=agein dbname="Agein"  )
 retrieve=" SELECT  patientcode ,
        Regno,
			name ,
			ward,
			gender,
			active,
			fname,
			dob,
			custcode,
			usercode,
			date,
			NationalIDCard,
			phone,
			fax,
			email,
			rankcode,
			unitcode,
			address1,
			address2,
			city,
			customer=(select name from accounts where accounts.acccode=patient.custcode),
			doctor=(select name from doctors where doctors.doctcode=patient.doctcode),
			Age=(Case patient.ageyears when 0 then patient.agemonths else DATEDIFF(YYYY, DOB, GETDATE()) end),
         	Agein=(Case patient.ageyears when 0 then 'Months' else 'Years' end)
FROM patient      
WHERE ( patientcode = :ra_patientcode )   "
  update="patient" updatewhere=0 updatekeyinplace=no
  arguments=(("ra_patientcode", number))
)
