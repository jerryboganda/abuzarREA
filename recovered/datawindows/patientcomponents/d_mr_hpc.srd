 retrieve="SELECT 
	RowID,
	Date,
	PatientCode,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE HPC.PatientCode=P.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = HPC.PatientCode),
	FHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = HPC.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = HPC.PatientCode),
	Gender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = HPC.PatientCode),
	AdmissionCode,
	HPC_ChestPain, 
	HPC_ChestpainSince, 
	HPC_ChestPainTimeUnit,
	HPC_ChestPainOnExertion, 
	HPC_ChestPainOnExertionSince, 
	HPC_ChestPainOnExertionTimeUnit,
	HPC_ChestHeavinessTightnessOnExertion, 
	HPC_ChestHeavinessTightnessOnExertionSince, 
	HPC_ChestHeavinessTightnessOnExertionTimeUnit, 
	HPC_ChestHeavinessAssWithNausia, 
	HPC_ChestHeavinessAssWithVomitting, 
	HPC_ChestHeavinessAssWithSweating, 
	HPC_ChestHeavinessAssWithPalpitations, 
	HPC_ChestHeavinessAssWithSuffocation, 
	HPC_ChestHeavinessRadiatedToLeftArm, 
	HPC_ChestHeavinessRadiatedToRightArm, 
	HPC_ChestHeavinessRadiatedToBack, 
	HPC_ChestHeavinessRadiatedToJawNeck, 
	HPC_ChestHeavinessRadiatedToEpigastrium, 
	HPC_TypicalAnginaFunctionalClass, 
	HPC_TypicalAnginaFunctionalClassSince, 
	HPC_TypicalAnginaFunctionalClassTimeUnit, 
	HPC_Type1AnginaFunctionalClass, 
	HPC_Type2AnginaFunctionalClass, 
	HPC_Type3AnginaFunctionalClass, 
	HPC_Type4AnginaFunctionalClass, 
	HPC_ShortnessofBreathAtRest, 
	HPC_ShortnessofBreathAtRestSince, 
	HPC_ShortnessofBreathAtRestTimeUnit, 
	HPC_ShortnessofBreathOnExertion, 
	HPC_ShortnessofBreathOnExertionSince, 
	HPC_ShortnessofBreathOnExertionTimeUnit, 
	HPC_RelievedAtRestIncreaseOnExertion, 
	HPC_RelievedAtRestIncreaseOnExertionSince, 
	HPC_RelievedAtRestIncreaseOnExertionTimeUnit, 
	HPC_ShortnessofBreathAssWithNausia, 
	HPC_ShortnessofBreathAssWithVomitting, 
	HPC_ShortnessofBreathAssWithSweating, 
	HPC_ShortnessofBreathAssWithPalpitations, 
	HPC_ShortnessofBreathAssWithSuffocation, 
	HPC_SyncopeWithHOFall, 
	HPC_SyncopeWithHOFallSince,
	HPC_SyncopeWithHOFallTimeUnit, 
	HPC_SyncopeWithHOFallDetail, 
	HPC_SyncopeWithNoHOFall, 
	HPC_SyncopeWithNoHOFallSince, 
	HPC_SyncopeWithNoHOFallTimeUnit, 
	HPC_SyncopeWithNoHOFallDetail,
	HPC_Palpitations, 
	HPC_PalpitationsSince, 
	HPC_PalpitationsTimeUnit, 
	HPC_Vertigo, 
	HPC_VertigoSince, 
	HPC_VertigoTimeUnit, 
	HPC_Headache, 
	HPC_HeadacheSince, 
	HPC_HeadacheTimeUnit, 
	HPC_Faintness, 
	HPC_FaintnessSince, 
	HPC_FaintnessTimeUnit, 
	HPC_Dizziness, 
	HPC_DizzinessSince, 
	HPC_DizzinessTimeUnit, 
	HPC_PreSyncope, 
	HPC_PreSyncopeSince, 
	HPC_PreSyncopeTimeUnit, 
	HPC_Fever, 
	HPC_FeverSince, 
	HPC_FeverTimeUnit, 
	HPC_PaininLeftLeg, 
	HPC_PaininLeftLegSince, 
	HPC_PaininLeftLegTimeUnit, 
	HPC_PaininRightLeg, 
	HPC_PaininRightLegSince, 
	HPC_PaininRightLegTimeUnit, 
	HPC_PaininLeftArm, 
	HPC_PaininLeftArmSince, 
	HPC_PaininLeftArmTimeUnit, 
	HPC_PaininRightArm, 
	HPC_PaininRightArmSince, 
	HPC_PaininRightArmTimeUnit, 
	HPC_PaininLowerLimb, 
	HPC_PaininLowerLimbSince, 
	HPC_PaininLowerLimbTimeUnit, 
	HPC_PaininUpperLimb, 
	HPC_PaininUpperLimbSince, 
	HPC_PaininUpperLimbTimeUnit, 
	HPC_PaininAbdomen, 
	HPC_PaininAbdomenSince, 
	HPC_PaininAbdomenTimeUnit, 
	HPC_MusculoskeletonPain, 
	HPC_MusculoskeletonPainSince, 
	HPC_MusculoskeletonPainTimeUnit, 
	HPC_OtherComplaints,
	UserCode,
	AttendingDoctCode
FROM 
	HPC
WHERE 
	AdmissionCode = :ai_code
ORDER BY
	PatientCode, RowID DESC"
  update="HPC" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
