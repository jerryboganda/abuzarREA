detail(height=72 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="AdmittedPatientRecurringServices.admissioncode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=char(9) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="AdmittedPatientRecurringServices.servicecode"  )
column=(type=long update=yes updatewhereclause=yes name=smancode dbname="AdmittedPatientRecurringServices.smancode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="24" name=frequencyhrs dbname="AdmittedPatientRecurringServices.FrequencyHrs"  )
column=(type=datetime update=yes updatewhereclause=yes name=startdate dbname="AdmittedPatientRecurringServices.StartDate"  )
column=(type=datetime update=yes updatewhereclause=yes name=nextrunon dbname="AdmittedPatientRecurringServices.NextRunOn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real ( GetText() ) > 0" initial="1" name=qty dbname="AdmittedPatientRecurringServices.qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" name=saleprice dbname="AdmittedPatientRecurringServices.saleprice"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=allowsaleindecimal dbname="AllowSaleInDecimal"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real ( GetText() ) >= 0" initial="0" name=serviceflatdisc dbname="AdmittedPatientRecurringServices.serviceflatdisc"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="AdmittedPatientRecurringServices.RowId"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) < 100" initial="0" name=discperc dbname="AdmittedPatientRecurringServices.discperc"  )
 retrieve="SELECT 
	AdmittedPatientRecurringServices.admissioncode,
	itemcode = AdmittedPatientRecurringServices.servicecode,
	itemname= service.name, 
	currlistrow = 0,
	fullcode = '         ',
	AdmittedPatientRecurringServices.servicecode,
	AdmittedPatientRecurringServices.smancode,
	AdmittedPatientRecurringServices.FrequencyHrs,
	AdmittedPatientRecurringServices.StartDate,
	AdmittedPatientRecurringServices.NextRunOn,
	AdmittedPatientRecurringServices.qty,
	AdmittedPatientRecurringServices.saleprice,
	AllowSaleInDecimal = Service.AllowSaleInDecimal,
	AdmittedPatientRecurringServices.serviceflatdisc,
	AdmittedPatientRecurringServices.IDentityCOL,
	AdmittedPatientRecurringServices.discperc
FROM AdmittedPatientRecurringServices, service
WHERE ( AdmittedPatientRecurringServices.admissioncode = :ai_code )    AND
	( AdmittedPatientRecurringServices.servicecode = service.servicecode )
	"
  update="AdmittedPatientRecurringServices" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
