table(column=(type=long key=yes updatewhereclause=yes name=rowid dbname="PrevAbnormalLabs.RowID"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="PrevAbnormalLabs.Date"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=yes name=fhname dbname="FHName"  )
column=(type=char(46) updatewhereclause=yes name=age dbname="Age"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=patientcode dbname="PrevAbnormalLabs.PatientCode"  )
column=(type=long update=yes updatewhereclause=yes name=admissioncode dbname="PrevAbnormalLabs.AdmissionCode"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="PrevAbnormalLabs.UserCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=attendingdoctcode dbname="PrevAbnormalLabs.AttendingDoctcode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=incuc dbname="PrevAbnormalLabs.IncUC" 
 values="↑ Urea, Creatinine	Y/↑ Urea, Creatinine	N"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=inclfts dbname="PrevAbnormalLabs.IncLFTs" 
 values="↑ LFTs	Y/↑ LFTs	N"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=incpotk dbname="PrevAbnormalLabs.IncPotK" 
 values="↑ Potatium K+	Y/↑ Potatium K+	N"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=decinpotk dbname="PrevAbnormalLabs.DecInPotK" 
 values="↓ Potatium K+	Y/↓ Potatium K+	N"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=incinhb dbname="PrevAbnormalLabs.IncInHb" 
 values="↑ Hb	Y/↑ Hb	N"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=dechb dbname="PrevAbnormalLabs.DecHB" 
 values="↓ Hb	Y/↓ Hb	N"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=incptinr dbname="PrevAbnormalLabs.IncPTINR" 
 values="↑ PT//INR	Y/↑ PT//INR	N"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=decmeg dbname="PrevAbnormalLabs.DecMeg" 
 values="↓ Magnesium	Y/↓ Magnesium	N"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=deccal dbname="PrevAbnormalLabs.DecCal" 
 values="↓ Calcium	Y/↓ Calcium	N"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=prevabnormallabs dbname="PrevAbnormalLabs.PrevAbnormalLabs"  )
 retrieve="SELECT 
	RowID,
	Date,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = PrevAbnormalLabs.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = PrevAbnormalLabs.PatientCode),
	FHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = PrevAbnormalLabs.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = PrevAbnormalLabs.PatientCode),
	Gender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = PrevAbnormalLabs.PatientCode),
	PatientCode,
	AdmissionCode,
	UserCode,
	AttendingDoctcode,
	IncUC,
	IncLFTs,
	IncPotK,
	DecInPotK,
	IncInHb,
	DecHB,
	IncPTINR,
	DecMeg,
	DecCal,

	PrevAbnormalLabs
FROM 
	PrevAbnormalLabs
WHERE 
	PrevAbnormalLabs.AdmissionCode = :ai_code
ORDER BY 
	PrevAbnormalLabs.PatientCode,
	PrevAbnormalLabs.RowID DESC"
  update="PrevAbnormalLabs" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
