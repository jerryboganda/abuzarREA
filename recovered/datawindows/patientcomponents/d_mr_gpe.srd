detail(height=1252 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=rowid dbname="GPE.RowID"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="GPE.Date"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=yes name=fhname dbname="FHName"  )
column=(type=char(46) updatewhereclause=yes name=age dbname="Age"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=patientcode dbname="GPE.PatientCode"  )
column=(type=long update=yes updatewhereclause=yes name=admissioncode dbname="GPE.AdmissionCode"  )
column=(type=long update=yes updatewhereclause=yes validation="long(gettext()) > 0" validationmsg="~"Please enter patient pulse~"" name=pulse dbname="GPE.Pulse"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="R" name=pulsetype dbname="GPE.PulseType" 
 values="Regular	R/Irregular	I/"  )
column=(type=long update=yes updatewhereclause=yes validation="long(gettext()) > 0" validationmsg="~"Please enter patient Blood Pressure~"" name=bp1 dbname="GPE.BP1"  )
column=(type=long update=yes updatewhereclause=yes validation="long(gettext()) > 0" validationmsg="~"Please enter patient Blood Pressure~"" name=bp2 dbname="GPE.BP2"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=ankleoedema dbname="GPE.AnkleOedema" 
 values="Possitive	Y/Negative	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=pallor dbname="GPE.Pallor" 
 values="Possitive	Y/Negative	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=jaundice dbname="GPE.Jaundice" 
 values="Possitive	Y/Negative	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=clubbing dbname="GPE.Clubbing" 
 values="Possitive	Y/Negative	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=cyanosis dbname="GPE.Cyanosis" 
 values="Possitive	Y/Negative	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=ascities dbname="GPE.Ascities" 
 values="Possitive	Y/Negative	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=jvp dbname="GPE.JVP" 
 values="Normal	N/Raised	R/"  )
column=(type=char(255) update=yes updatewhereclause=yes name=others dbname="GPE.OTHERS"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="GPE.UserCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=attendingdoctcode dbname="GPE.AttendingDoctCode" 
 values=""  )
 retrieve="SELECT 
	GPE.RowID,   
	GPE.Date,   
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode=GPE.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = GPE.PatientCode),
	FHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = GPE.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = GPE.PatientCode),
	Gender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = GPE.PatientCode),
	GPE.PatientCode,   
	GPE.AdmissionCode,   
	GPE.Pulse,   
	GPE.PulseType,   
	GPE.BP1,   
	GPE.BP2,   
	GPE.AnkleOedema,   
	GPE.Pallor,   
	GPE.Jaundice,   
	GPE.Clubbing,   
	GPE.Cyanosis,   
	GPE.Ascities,   
	GPE.JVP,   
	GPE.OTHERS,
	UserCode,
	AttendingDoctCode	
FROM 
	GPE   
WHERE 
	GPE.AdmissionCode = :ai_code
ORDER BY
	GPE.PatientCode,
	GPE.RowID DESC"
  update="GPE" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
