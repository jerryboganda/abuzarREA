release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="patientlocation.locationcode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="patientlocation.name"  )
column=(type=long update=yes updatewhereclause=yes name=wardcode dbname="patientlocation.wardcode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=description dbname="patientlocation.description"  )
column=(type=char(1) updatewhereclause=yes name=occupied dbname="occupied"  )
 retrieve="SELECT
	PatientLocation.LocationCode ,
	PatientLocation.Name ,
	PatientLocation.WardCode ,
	PatientLocation.Description ,
	Occupied=
		CASE WHEN PatientLocation.LocationCode IN
			(SELECT 
				ISNULL(
					(SELECT TargetLocation FROM PatientTransfer 
					WHERE 
						PatientTransfer.TransferCode IN
							(SELECT Max(PatientTransfer.TransferCode) 
							FROM PatientTransfer 
							WHERE PatientTransfer.AdmissionCode = PA.AdmissionCode)), 
					PA.LocationCode)
			FROM PatientAdmission PA
			WHERE PA.Discharged = 'N') THEN 'Y' ELSE 'N' END
FROM 
	PatientLocation"
  update="PatientLocation" updatewhere=1 updatekeyinplace=no
 )
