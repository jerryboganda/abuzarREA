table(column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(50) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname1 dbname="ItemName1"  )
column=(type=char(113) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(0) updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
column=(type=char(0) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(0) updatewhereclause=yes name=location dbname="Location"  )
column=(type=char(60) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(1) update=yes updatewhereclause=yes name=gender dbname="Gender" 
 values="Yes	Y/No	N/"  )
column=(type=datetime update=yes updatewhereclause=yes name=birthdate dbname="BirthDate"  )
column=(type=char(30) update=yes updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mobile dbname="Mobile"  )
column=(type=char(1) update=yes updatewhereclause=yes name=status dbname="Status" 
 values="Registered	R/Admitted	A/School Leaving	L/"  )
 retrieve="SELECT
	ICode=Patient.PatientCode,   
	FullCode=Patient.RegNo,   
	ItemName1=Patient.Name,   
	ItemName = Patient.Name + ' (' + Patient.RegNo + ')',
	Packing=Patient.FName, 
	PackingDesc='',
	Manufacturer='',
	Location='',
	FatherName=Patient.FName,   
	customer=(select accounts.name from accounts where acccode=Patient.custcode),
	Gender=Patient.Gender,   
	BirthDate=Patient.DOB,   
	Phone=Patient.Phone,   
	Mobile=Patient.MobileNo1,   
	Status = Patient.Active
FROM 
	Patient
WHERE
	Patient.Active = 'Y'
ORDER BY 
	ItemName,
	FullCode
"
 )
