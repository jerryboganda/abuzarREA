table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="BirthCertificate.BirthCertificateCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="BirthCertificate.PatientCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=visitcode dbname="BirthCertificate.VisitCode"  )
column=(type=long update=yes updatewhereclause=yes name=admissioncode dbname="BirthCertificate.AdmissionCode"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="BirthCertificate.UserCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="BirthCertificate.Date"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=dob dbname="BirthCertificate.DOB"  )
column=(type=char(100) update=yes updatewhereclause=yes name=childname dbname="BirthCertificate.ChildName"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="M" name=gender dbname="BirthCertificate.Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fathername dbname="BirthCertificate.FatherName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fathercnic dbname="BirthCertificate.FatherCNIC"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fathercellno dbname="BirthCertificate.FatherCellNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mothername dbname="BirthCertificate.MotherName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mothercnic dbname="BirthCertificate.MotherCNIC"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mothercellno dbname="BirthCertificate.MotherCellNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=ageofmother dbname="BirthCertificate.AgeOfMother"  )
column=(type=char(100) update=yes updatewhereclause=yes name=placeofbirth dbname="BirthCertificate.PlaceOfBirth"  )
column=(type=char(100) update=yes updatewhereclause=yes name=doctorname dbname="BirthCertificate.DoctorName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=hospitalname dbname="BirthCertificate.HospitalName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=issuedto dbname="BirthCertificate.IssuedTo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=issuedtocnic dbname="BirthCertificate.IssuedToCNIC"  )
column=(type=char(100) update=yes updatewhereclause=yes name=issuedtocellno dbname="BirthCertificate.IssuedToCellNo"  )
 retrieve="SELECT 
	BirthCertificate.BirthCertificateCode,   
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode=BirthCertificate.PatientCode),
	BirthCertificate.PatientCode,   
	BirthCertificate.VisitCode,   
	BirthCertificate.AdmissionCode,   
	BirthCertificate.UserCode,   
	BirthCertificate.Date,   
	BirthCertificate.DOB,   
	BirthCertificate.ChildName,   
	BirthCertificate.Gender,   
	BirthCertificate.FatherName,   
	BirthCertificate.FatherCNIC,   
	BirthCertificate.FatherCellNo,   
	BirthCertificate.MotherName,   
	BirthCertificate.MotherCNIC,   
	BirthCertificate.MotherCellNo,   
	BirthCertificate.AgeOfMother,   
	BirthCertificate.PlaceOfBirth,   
	BirthCertificate.DoctorName,   
	BirthCertificate.HospitalName,   
	BirthCertificate.IssuedTo,   
	BirthCertificate.IssuedToCNIC,   
	BirthCertificate.IssuedToCellNo  
FROM 
	BirthCertificate
WHERE 
	BirthCertificate.BirthCertificateCode = :ai_code"
  update="BirthCertificate" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
