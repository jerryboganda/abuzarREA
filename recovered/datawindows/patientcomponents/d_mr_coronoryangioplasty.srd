 retrieve="SELECT 
	RowID,
	Date,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = CoronoryAngioplasty.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = CoronoryAngioPlasty.PatientCode),
	FHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = CoronoryAngioPlasty.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = CoronoryAngioPlasty.PatientCode),
	Gender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = CoronoryAngioPlasty.PatientCode),
	PatientCode,
	AdmissionCode,
	UserCode,
	AttendingDoctCode,
	HadCoronoryAngioplasty,
	HadCoronoryAngioplastyOn,
	DESCoronoryAngioplasty,
	DESQtyCoronoryAngioplasty,
	DesLADCoronoryAngioplasty,
	DesLcxCoronoryAngioplasty,
	DesRCACoronoryAngioplasty,
	DesDiagnolCoronoryAngioplasty,
	DesOMCoronoryAngioplasty,
	DesPDACoronoryAngioplasty,
	DesOthersCoronoryAngioplasty,
	BMSCoronoryAngioplasty,
	BMSQtyCoronoryAngioplasty,
	BMSLADCoronoryAngioplasty,
	BMSLcxCoronoryAngioplasty,
	BMSRCACoronoryAngioplasty,
	BMSDiagnolCoronoryAngioplasty,
	BMSOMCoronoryAngioplasty,
	BMSPDACoronoryAngioplasty,
	BMSOthersCoronoryAngioplasty,
	HadPreviousISR,
	HadPreviousISRON,
	DESPreviousISR,
	DESQtyISR,
	DESLADPreviousISR,
	DESLcxPreviousISR,
	DESRCAPreviousISR,
	DESDiagnolPreviousISR,
	DESOMPreviousISR,
	DESPDAPreviousISR,
	DESOtherPreviousISR,
	BMSPreviousISR,
	BMSQtyISR,
	BMSLADPreviousISR,
	BMSLcxPreviousISR,
	BMSRCAPreviousISR,
	BMSDiagnolPreviousISR,
	BMSOMPreviousISR,
	BMSPDAPreviousISR,
	BMSOtherPreviousISR,
	HadReStenting,
	HadReStentingOn,
	DESReStenting,
	DESQtyReStenting,
	DESLADReStenting,
	DESLcxReStenting,
	DESRCAReStenting,
	DESDiagnolReStenting,
	DESOMReStenting,
	DESPDAReStenting,
	DESOtherReStenting,
	BMSReStenting,
	BMSQtyReStenting,
	BMSLADReStenting,
	BMSLcxReStenting,
	BMSRCAReStenting,
	BMSDiagnolReStenting,
	BMSOMReStenting,
	BMSPDAReStenting,
	BMSOtherReStenting
FROM
	CoronoryAngioplasty
WHERE 
	CoronoryAngioplasty.AdmissionCode = :ai_code
ORDER BY
	CoronoryAngioplasty.PatientCode,
	CoronoryAngioplasty.RowID DESC"
  update="CoronoryAngioplasty" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
