column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=copdxray dbname="XRay.COPDXRay" 
 values="COPD	Y/COPD	N"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=otherxray dbname="XRay.OtherXray"  )
 retrieve="SELECT 
	RowID,
	Date,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = XRay.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = Xray.PatientCode),
	FHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = Xray.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = Xray.PatientCode),
	Gender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = Xray.PatientCode),
	PatientCode,
	AdmissionCode,
	UserCode,
	AttendingDoctCode,
	XrayAdvised,
	AdviseDetail,
	Xray,
	XrayDate,
	FindingswithinNormalLimits,
	FindingswithinNormalLimitsXRay,
	Cardiomegaloy,
	CardiomegaloyXRay,
	FindingSuggestiveofXRay,
	PulmonaryEdemaXRay,
	PulmonaryEmbolismXRay,
	HeartFailureXRay,
	ChestInfectionXRay,
	PleuralEffusionXRay,
	PulmonaryCocksXRay,
	MassConsolidationXRay,
	BronchiactasisXRay,
	PhenuthoraxXRay,
	HaemothoraxXRay,
	COPDXRay,
	OtherXray
FROM
	XRay
WHERE
	XRay.AdmissionCode = :ai_code
ORDER BY 
	XRay.PatientCode,
	XRay.RowID DESC"
  update="XRay" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
