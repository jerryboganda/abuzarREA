table(column=(type=long key=yes update=yes updatewhereclause=yes name=transfercode dbname="PatientTransfer.TransferCode"  )
column=(type=long update=yes updatewhereclause=yes name=admissioncode dbname="PatientTransfer.AdmissionCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="PatientTransfer.Date"  )
column=(type=long update=yes updatewhereclause=yes name=sourcelocation dbname="PatientTransfer.SourceLocation"  )
column=(type=long update=yes updatewhereclause=yes name=targetlocation dbname="PatientTransfer.TargetLocation"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="PatientTransfer.UserCode"  )
column=(type=long update=yes updatewhereclause=yes name=doctcode dbname="PatientTransfer.DoctCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="PatientTransfer.Remarks"  )
 retrieve="  SELECT PatientTransfer.TransferCode,   
         PatientTransfer.AdmissionCode,   
         PatientTransfer.Date,   
         PatientTransfer.SourceLocation,   
         PatientTransfer.TargetLocation,   
         PatientTransfer.UserCode,   
		 PatientTransfer.DoctCode, 
         PatientTransfer.Remarks  
    FROM PatientTransfer   
WHERE PatientTransfer.TransferCode = :Code"
  update="PatientTransfer" updatewhere=1 updatekeyinplace=yes
  arguments=(("Code", number))
)
