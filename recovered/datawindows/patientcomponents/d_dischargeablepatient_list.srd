table(column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="PatientAdmission.AdmissionCode"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="PatientAdmission.PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=fname dbname="FName"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender"  )
column=(type=datetime updatewhereclause=yes name=dob dbname="DOB"  )
column=(type=long update=yes updatewhereclause=yes name=locationcode dbname="PatientAdmission.LocationCode"  )
column=(type=char(122) updatewhereclause=yes name=location dbname="Location"  )
column=(type=char(122) updatewhereclause=yes name=currentlocation dbname="CurrentLocation"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="PatientAdmission.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="PatientAdmission.UserCode"  )
column=(type=char(60) updatewhereclause=yes name=admittedby dbname="AdmittedBy"  )
column=(type=char(100) update=yes updatewhereclause=yes name=diagnosis dbname="PatientAdmission.Diagnosis"  )
column=(type=long update=yes updatewhereclause=yes name=doctorcode dbname="PatientAdmission.DoctorCode"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=char(1) updatewhereclause=yes name=initialdischarged dbname="InitialDischarged" 
 values="Yes	Y/No	N/"  )
column=(type=long updatewhereclause=yes name=initialdischargedby dbname="InitialDischargedBy" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes name=discharged dbname="PatientAdmission.Discharged" 
 values="Yes	Y/No	N/"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(113) updatewhereclause=yes name=patient dbname="Patient"  )
 retrieve="SELECT
	PatientName=Patient.Name,
	PatientAdmission.AdmissionCode,
	PatientAdmission.PatientCode,
	RegNo=Patient.RegNo,
	FName=Patient.FName,
	Gender=Patient.Gender,
	DOB=Patient.DOB,
	PatientAdmission.LocationCode,
	Location = RTRIM(LTRIM(PatientLocation.Name)) + ', ' + RTRIM(LTRIM(WARD.Name)),
	CurrentLocation = (SELECT LTRIM(RTRIM(PL.NAME)) + ', ' + LTRIM(RTRIM(W.Name))
			FROM PATIENTLOCATION PL, Ward W
			WHERE PL.LOCATIONCODE = ISNULL((SELECT TargetLocation FROM PatientTransfer WHERE PatientTransfer.TransferCode = (SELECT Max(PatientTransfer.TransferCode) FROM PatientTransfer WHERE PatientTransfer.AdmissionCode = PatientAdmission.AdmissionCode)), (SELECT A.LocationCode FROM PatientAdmission A WHERE A.AdmissionCode = PatientAdmission.AdmissionCode)) AND PL.WardCode=W.WardCode),
	PatientAdmission.Date,
	PatientAdmission.UserCode,
	AdmittedBy=Users.UserName,
	PatientAdmission.Diagnosis,   
	PatientAdmission.DoctorCode,   
	Doctor=Doctors.Name,
	InitialDischarged=PatientAdmission.Discharged1,
	InitialDischargedBy=PatientAdmission.Discharged1By,
	PatientAdmission.Discharged,
	Customer=Accounts.Name,
	Patient=LTRIM(RTRIM(Patient.Name)) + ' (' + LTRIM(RTRIM(Patient.RegNo)) + ')'
FROM
	PatientAdmission
	LEFT OUTER JOIN Doctors ON (PatientAdmission.DoctorCode = Doctors.DoctCode)
	LEFT OUTER JOIN Users ON (PatientAdmission.Usercode = Users.UserCode),
	Patient, 
	PatientLocation, 
	Ward,
	Accounts
WHERE
	PatientAdmission.Discharged = 'N' AND
	PatientAdmission.PatientCode = Patient.PatientCode ANd
	PatientAdmission.LocationCode = PatientLocation.LocationCode AND
	PatientLocation.WardCode = Ward.WardCode AND
	Patient.CustCode = Accounts.AccCode
Order By Patient.Name, Patient.FName, Patient.RegNo, PatientAdmission.AdmissionCode"
 )
