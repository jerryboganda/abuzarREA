table(column=(type=char(50) updatewhereclause=yes name=regno dbname="Regno"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=yes name=fhname dbname="FHName"  )
column=(type=char(100) updatewhereclause=yes name=profession dbname="Profession"  )
column=(type=char(100) updatewhereclause=yes name=nic dbname="NIC"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(100) updatewhereclause=yes name=mobileno1 dbname="MobileNo1"  )
column=(type=char(100) updatewhereclause=yes name=mobileno2 dbname="MobileNo2"  )
column=(type=char(100) updatewhereclause=yes name=mobileno3 dbname="MobileNo3"  )
 retrieve="SELECT
	Regno = SPACE(50),
	PatientName = SPACE(60),
	FHName = SPACE(60),
	Profession = SPACE(100),
	NIC = SPACE(100),
	Phone = SPACE(100),
	MobileNo1 = SPACE(100),
	MobileNo2 = SPACE(100),
	MobileNo3 = SPACE(100)
"
 )
