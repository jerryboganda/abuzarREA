footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=code dbname="PrescriptionHeader.prescode"  )
column=(type=datetime updatewhereclause=yes name=modifieddate dbname="PrescriptionHeader.modifieddate"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="PrescriptionHeader.posted"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PrescriptionHeader.postdate"  )
column=(type=char(60) updatewhereclause=yes name=createdby dbname="createdby"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="modifiedby"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="postedby"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=long updatewhereclause=yes name=modifycounter dbname="PrescriptionHeader.modifycounter"  )
 retrieve="SELECT  prescode ,
        modifieddate ,
		  posted, 
		  postdate,
		  createdby = (Select UserName from Users Where users.usercode = prescriptionheader.createdby)  ,
		  modifiedby = (Select UserName from Users Where users.usercode = prescriptionheader.modifiedby) ,
		  postedby = (Select UserName from Users Where users.usercode = prescriptionheader.postedby),
		  regno = (Select regno From Patient Where patientcode = prescriptionheader.patientcode),
        patient = ( Select name From Patient Where patientcode = prescriptionheader.patientcode ),
		  modifycounter

FROM PrescriptionHeader"
  update="PrescriptionHeader" updatewhere=0 updatekeyinplace=no
 )
