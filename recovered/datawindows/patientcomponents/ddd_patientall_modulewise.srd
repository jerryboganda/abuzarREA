table(column=(type=long updatewhereclause=yes name=patientcode dbname="Patient.PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Patient.RegNo"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Patient.Name"  )
column=(type=char(113) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(60) updatewhereclause=yes name=fname dbname="Patient.FName"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Patient.Gender"  )
column=(type=long updatewhereclause=yes name=custcode dbname="Patient.CustCode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
 retrieve="SELECT 
	P.PatientCode,   
	P.RegNo,   
	P.Name,   
	Patient=LTRIM(RTRIM(P.Name)) + ' (' + LTRIM(RTRIM(P.RegNo)) + ')',
	P.FName,   
	P.Gender,   
	P.CustCode,
	Customer=(SELECT A.Name FROM Accounts A WHERE P.CustCode = A.AccCode),
	Active=P.Active
FROM Patient P, PatientCategory PC, PatientCatAllowedModule PAM
WHERE 
	P.PatientCatCode = PC.PatientCatCode AND
	P.PatientCatCode = PAM.PatientCatCode AND
	PAM.ModuleID = :ai_module
ORDER BY P.Name, P.FName, P.Regno, Customer
"
  arguments=(("ai_module", number))
)
