footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(50) updatewhereclause=yes name=regno dbname="Patient.regno"  )
column=(type=long updatewhereclause=yes name=code dbname="Patient.Patientcode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Patient.name"  )
column=(type=char(60) updatewhereclause=yes name=fname dbname="Patient.fname"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Patient.active"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Patient.gender"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Accounts.name"  )
column=(type=char(25) updatewhereclause=yes name=city dbname="Patient.city"  )
column=(type=long updatewhereclause=yes name=usercode dbname="Patient.UserCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=date dbname="Patient.date"  )
column=(type=datetime updatewhereclause=yes name=originaldate dbname="Patient.originaldate"  )
column=(type=long updatewhereclause=yes name=createdby dbname="Patient.createdby" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=inactivedate dbname="Patient.inactivedate"  )
column=(type=long updatewhereclause=yes name=inactivedby dbname="Patient.inactivedby" 
 values=""  )
column=(type=long updatewhereclause=yes name=locationcode dbname="Patient.locationcode" 
 values=""  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
 retrieve="   SELECT 
			patient.regno,
			patient.Patientcode,
			patient.name,
			patient.fname,
			patient.active,
			patient.gender,
			accounts.name,
			patient.city,
			Patient.UserCode,
			Patient.date,
			Patient.originaldate,
			Patient.createdby,
			Patient.inactivedate,
			Patient.inactivedby,
			patient.locationcode,
			AdmissionCode = (SELECT PA.AdmissionCode FROM PatientAdmission PA WHERE PA.Discharged='N' AND PA.PatientCode = Patient.PatientCode)
  FROM 
	Patient
	LEFT OUTER JOIN Accounts ON (Patient.CustCode = Accounts.AccCode)
	   
"
 )
