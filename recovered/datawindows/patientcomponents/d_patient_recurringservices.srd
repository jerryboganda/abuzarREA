table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PatientRecServices.PatientCode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=char(9) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="PatientRecServices.servicecode"  )
column=(type=long update=yes updatewhereclause=yes name=smancode dbname="PatientRecServices.smancode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="1" name=qty dbname="PatientRecServices.qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=saleprice dbname="PatientRecServices.saleprice"  )
column=(type=char(1) updatewhereclause=yes name=allowsaleindecimal dbname="AllowSaleInDecimal"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=serviceflatdisc dbname="PatientRecServices.ServiceFlatDisc"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="PatientRecServices.ROWID"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discperc dbname="PatientRecServices.discperc"  )
 retrieve="SELECT 
	PatientRecServices.PatientCode,
	itemcode = PatientRecServices.servicecode,
	itemname= service.name, 
	currlistrow = 0,
	fullcode = '         ',
	PatientRecServices.servicecode,
	PatientRecServices.smancode,
	PatientRecServices.qty,
	PatientRecServices.saleprice,
	AllowSaleInDecimal=Service.AllowSaleInDecimal,
	PatientRecServices.ServiceFlatDisc,
	PatientRecServices.IDentityCOL,
	PatientRecServices.discperc
FROM PatientRecServices, service
WHERE ( PatientRecServices.PatientCode = :ai_code )    AND
	( PatientRecServices.servicecode = service.servicecode )
	"
  update="PatientRecServices" updatewhere=0 updatekeyinplace=no
  arguments=(("ai_code", number))
)
