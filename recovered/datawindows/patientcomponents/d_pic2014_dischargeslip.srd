column=(type=char(255) updatewhereclause=yes name=provisionaldiagnosis dbname="ProvisionalDiagnosis"  )
column=(type=char(1000) updatewhereclause=yes name=pd_details dbname="PD_Details"  )
column=(type=long updatewhereclause=yes name=dischargerefferalcode dbname="DischargeRefferalCode"  )
column=(type=char(100) updatewhereclause=yes name=dischargerefferal dbname="DischargeRefferal"  )
column=(type=char(1000) updatewhereclause=yes name=dischargenotes dbname="DischargeNotes"  )
 retrieve="SELECT 
	Date=P.Date,
	PatientCode=P.PatientCode,
	RegNo = P.RegNo,
	PatientName = P.Name,
	FHName = P.FName,
	Gender = CASE P.Gender WHEN 'M' THEN 'Male' WHEN 'F' THEN 'Female' ELSE ' ' END,
	Age = ISNULL(LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ','') + ISNULL(LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ','') + ISNULL(LTRIM(RTRIM(STR(P.AgeDays))) + ' days ',''),
	Address1=P.Address1,
	DoctCode = P.DoctCode,
	ConsultanctFirstContact=PFC.DoctCode,
	AdmissionCode=P.AdmissionCode,
	ChestPain=CASE WHEN PC.ChestPain ='Y' THEN 'Typical Chest Pain: ' + CASE WHEN PC.ChestpainSince > 0 THEN LTRIM(RTRIM(STR(PC.ChestpainSince))) ELSE '' END + ' ' + CASE PC.ChestPainTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	ChestPainATypical=CASE WHEN PC.ChestPainATypical ='Y' THEN 'ATypical Chest Pain: ' + CASE WHEN PC.ChestPainATypicalSince > 0 THEN LTRIM(RTRIM(STR(PC.ChestPainATypicalSince))) ELSE '' END + ' ' + CASE PC.ChestPainATypicalTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	ShortnessofBreath=CASE WHEN PC.ShortnessofBreath ='Y' THEN 'Shortness of Breath: ' + CASE WHEN PC.ShortnessofBreathSince > 0 THEN LTRIM(RTRIM(STR(PC.ShortnessofBreathSince))) ELSE '' END + ' ' + CASE PC.ShortnessofBreathTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	RelievedAtRestIncreaseOnExertion=CASE WHEN PC.RelievedAtRestIncreaseOnExertion ='Y' THEN 'Relieved At Rest, Increase On Exertion: ' + CASE WHEN PC.RelievedAtRestIncreaseOnExertionSince > 0 THEN LTRIM(RTRIM(STR(PC.RelievedAtRestIncreaseOnExertionSince))) ELSE '' END + ' ' + CASE PC.RelievedAtRestIncreaseOnExertionTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	ChestDiscomfort=CASE WHEN PC.ChestDiscomfort='Y' THEN 'Un-Explained Chest Discomfort: ' + CASE WHEN PC.ChestDiscomfortSince > 0 THEN LTRIM(RTRIM(STR(PC.ChestDiscomfortSince))) ELSE '' END + ' ' + CASE PC.ChestDiscomforttimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	ChestHeavinessTightnessOnExertion=CASE WHEN PC.ChestHeavinessTightnessOnExertion='Y' THEN 'Chest Heaviness & Tightness On Exertion: ' + CASE WHEN PC.ChestHeavinessTightnessOnExertionFor > 0 THEN LTRIM(RTRIM(STR(PC.ChestHeavinessTightnessOnExertionFor))) ELSE '' END + ' ' + CASE PC.ChestHeavinessTightnessOnExertionTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PressureLikeSymtomsInChest=CASE WHEN PC.PressureLikeSymtomsInChest='Y' THEN 'Pressure Like Symptoms In Chest: ' + CASE WHEN PC.PressureLikeSymtomsInChestSince > 0 THEN LTRIM(RTRIM(STR(PC.PressureLikeSymtomsInChestSince))) ELSE '' END + ' ' + CASE PC.PressureLikeSymtomsInChestTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	TypicalAnginaFunctionalClass=CASE WHEN PC.TypicalAnginaFunctionalClass='Y' THEN 'Typical Angina NYHA Functional Class: ' + 
		CASE WHEN PC.Type1AnginaFunctionalClass='Y' THEN 'I,' ELSE '' END +
		CASE WHEN PC.Type2AnginaFunctionalClass='Y' THEN 'II,' ELSE '' END +
		CASE WHEN PC.Type3AnginaFunctionalClass='Y' THEN 'III,' ELSE '' END +
		CASE WHEN PC.Type4AnginaFunctionalClass='Y' THEN 'IV,' ELSE '' END + ' ' + 
		CASE WHEN PC.TypicalAnginaFunctionalClassSince > 0 THEN LTRIM(RTRIM(STR(PC.TypicalAnginaFunctionalClassSince))) ELSE '' END + ' ' +
		CASE PC.TypicalAnginaFunctionalClassTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	DysnaeonExertionFunctionalClass=CASE WHEN PC.DysnaeonExertionFunctionalClass='Y' THEN 'Dysnae on Exertion NYHA Functional Class: ' + 
		CASE WHEN PC.Type1DysnaeonExertionFunctionalClass='Y' THEN 'I,' ELSE '' END +
		CASE WHEN PC.Type2DysnaeonExertionFunctionalClass='Y' THEN 'II,' ELSE '' END +
		CASE WHEN PC.Type3DysnaeonExertionFunctionalClass='Y' THEN 'III,' ELSE '' END +
		CASE WHEN PC.Type4DysnaeonExertionFunctionalClass='Y' THEN 'IV,' ELSE '' END + ' ' + 
		CASE WHEN PC.DysnaeonExertionFunctionalClassSince > 0 THEN LTRIM(RTRIM(STR(PC.DysnaeonExertionFunctionalClassSince))) ELSE '' END + ' ' +
		CASE PC.DysnaeonExertionFunctionalClassTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	SyncopeWithHOFall=CASE WHEN PC.SyncopeWithHOFall='Y' THEN 'Syncope With H/O Fall: ' + LTRIM(RTRIM(SyncopeWithHOFallDetail)) + '  Ep. in last:  ' + CASE WHEN PC.SyncopeWithHOFallSince > 0 THEN LTRIM(RTRIM(STR(PC.SyncopeWithHOFallSince))) ELSE '' END + ' ' + CASE PC.SyncopeWithHOFallTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	SyncopeWithNoHOFall=CASE WHEN PC.SyncopeWithNoHOFall='Y' THEN 'Syncope With No H/O Fall: ' + LTRIM(RTRIM(SyncopeWithNoHOFallDetail)) + '  Ep. in last:  ' + CASE WHEN PC.SyncopeWithNoHOFallSince > 0 THEN LTRIM(RTRIM(STR(PC.SyncopeWithNoHOFallSince))) ELSE '' END + ' ' + CASE PC.SyncopeWithNoHOFallTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PatientPresentation=CASE WHEN PC.PatientPresentation = 'Y' THEN 'Presented in Un-Conscious & Collapsed State: ' + ISNULL(PC.PatientPresentationDetails,'') ELSE '' END,
	Palpitations=CASE WHEN PC.Palpitations='Y' THEN 'Palpitations: ' + CASE WHEN PC.PalpitationsSince > 0 THEN LTRIM(RTRIM(STR(PC.PalpitationsSince))) ELSE '' END + ' ' + CASE PC.PalpitationsTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	Vertigo=CASE WHEN PC.Vertigo='Y' THEN 'Vertigo: ' + CASE WHEN PC.VertigoSince > 0 THEN LTRIM(RTRIM(STR(PC.VertigoSince))) ELSE '' END + ' ' + CASE PC.VertigoTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	Headache=CASE WHEN PC.Headache='Y' THEN 'Headache: ' + CASE WHEN PC.HeadacheSince > 0 THEN LTRIM(RTRIM(STR(PC.HeadacheSince))) ELSE '' END + ' ' + CASE PC.HeadacheTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	Faintness=CASE WHEN PC.Faintness='Y' THEN 'Faintness: ' + CASE WHEN PC.FaintnessSince > 0 THEN LTRIM(RTRIM(STR(PC.FaintnessSince))) ELSE '' END + ' ' + CASE PC.FaintnessTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	Dizziness=CASE WHEN PC.Dizziness='Y' THEN 'Dizziness: ' + CASE WHEN PC.DizzinessSince > 0 THEN LTRIM(RTRIM(STR(PC.DizzinessSince))) ELSE '' END + ' ' + CASE PC.DizzinessTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PreSyncope=CASE WHEN PC.PreSyncope='Y' THEN 'Pre-Syncope: ' + CASE WHEN PC.PreSyncopeSince > 0 THEN LTRIM(RTRIM(STR(PC.PreSyncopeSince))) ELSE '' END + ' ' + CASE PC.PreSyncopeTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	Fever=CASE WHEN PC.Fever='Y' THEN 'Fever: ' + CASE WHEN PC.FeverSince > 0 THEN LTRIM(RTRIM(STR(PC.FeverSince))) ELSE '' END + ' ' + CASE PC.FeverTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,

	PaininLeftLeg=CASE WHEN PC.PaininLeftLeg='Y' THEN 'Left Leg: ' + CASE WHEN PC.PaininLeftLegSince > 0 THEN LTRIM(RTRIM(STR(PC.PaininLeftLegSince))) ELSE '' END + ' ' + CASE PC.PaininLeftLegTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PaininRightLeg=CASE WHEN PC.PaininRightLeg='Y' THEN 'Right Leg: ' + CASE WHEN PC.PaininRightLegSince > 0 THEN LTRIM(RTRIM(STR(PC.PaininRightLegSince))) ELSE '' END + ' ' + CASE PC.PaininRightLegTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PaininLeftArm=CASE WHEN PC.PaininLeftArm='Y' THEN 'Left Arm: ' + CASE WHEN PC.PaininLeftArmSince > 0 THEN LTRIM(RTRIM(STR(PC.PaininLeftArmSince))) ELSE '' END + ' ' + CASE PC.PaininLeftArmTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PaininRightArm=CASE WHEN PC.PaininRightArm='Y' THEN 'Right Arm: ' + CASE WHEN PC.PaininRightArmSince > 0 THEN LTRIM(RTRIM(STR(PC.PaininRightArmSince))) ELSE '' END + ' ' + CASE PC.PaininRightArmTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PaininLowerLimb=CASE WHEN PC.PaininLowerLimb='Y' THEN 'Lower Limb: ' + CASE WHEN PC.PaininLowerLimbSince > 0 THEN LTRIM(RTRIM(STR(PC.PaininLowerLimbSince))) ELSE '' END + ' ' + CASE PC.PaininLowerLimbTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PaininUpperLimb=CASE WHEN PC.PaininUpperLimb='Y' THEN 'Upper Limb: ' + CASE WHEN PC.PaininUpperLimbSince > 0 THEN LTRIM(RTRIM(STR(PC.PaininUpperLimbSince))) ELSE '' END + ' ' + CASE PC.PaininUpperLimbTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PaininAbdomen=CASE WHEN PC.PaininAbdomen='Y' THEN 'Abdomen: ' + CASE WHEN PC.PaininAbdomenSince > 0 THEN LTRIM(RTRIM(STR(PC.PaininAbdomenSince))) ELSE '' END + ' ' + CASE PC.PaininAbdomenTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	MusculoskeletonPain=CASE WHEN PC.MusculoskeletonPain='Y' THEN 'Musculoskeleton Pain: ' + CASE WHEN PC.MusculoskeletonPainSince > 0 THEN LTRIM(RTRIM(STR(PC.MusculoskeletonPainSince))) ELSE '' END + ' ' + CASE PC.MusculoskeletonPainTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	OtherComplaints = CASE WHEN PC.OtherComplaints IS NULL THEN '' ELSE 'Other Pain (if any): ' + PC.OtherComplaints END,
	ReceivedDead = CASE WHEN PC.ReceivedDead='Y' THEN 'Received Dead' ELSE '' END,
	IssueDeathCertificate = CASE WHEN PC.IssueDeathCertificate='Y' THEN 'Issued Death Certificate' ELSE '' END,
	PC.Diabetic,
	PC.DiabeticSince,
	PC.DiabeticTimeUnit,
	PC.HyperTension,
	PC.HyperTensionSince,
	PC.HyperTensionTimeUnit,
	PC.Smoking,
	PC.SmokingSince,
	PC.SmokingTimeUnit,
	PC.Obesity,
	PC.ObesitySince,
	PC.ObesityTimeUnit,
	PC.FamilyIHD,
	PC.FamilyIHDToMother,
	PC.FamilyIHDToFather,
	PC.FamilyIHDToSiblings,
	PC.FamilyIHDTo,
	PC.OtherCardiacComplaints,
	PC.COPD,
	PC.Asthma,
	PC.CVA,
	PC.CKD,
	PC.CLD,
	PC.Allergy,
	PC.AllergyDetails,
	PC.OtherComorbidCondition,

	PastHistoryIHD=CASE WHEN PC.PastHistoryIHD='Y' THEN 'IHD: ' + CASE WHEN PC.PastHistoryIHDSince > 0 THEN LTRIM(RTRIM(STR(PC.PastHistoryIHDSince))) ELSE '' END + ' ' + CASE PC.PastHistoryIHDTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PastHistorySTEMI=CASE WHEN PC.PastHistorySTEMI='Y' THEN 'STEMI: ' + CASE WHEN PC.PastHistorySTEMISince > 0 THEN LTRIM(RTRIM(STR(PC.PastHistorySTEMISince))) ELSE '' END + ' ' + CASE PC.PastHistorySTEMITimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PastHistoryNSTEMI=CASE WHEN PC.PastHistoryNSTEMI='Y' THEN 'NSTEMI: ' + CASE WHEN PC.PastHistoryNSTEMISince > 0 THEN LTRIM(RTRIM(STR(PC.PastHistoryNSTEMISince))) ELSE '' END + ' ' + CASE PC.PastHistoryNSTEMITimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PastHistoryUSA=CASE WHEN PC.PastHistoryUSA='Y' THEN 'USA: ' + CASE WHEN PC.PastHistoryUSASince > 0 THEN LTRIM(RTRIM(STR(PC.PastHistoryUSASince))) ELSE '' END + ' ' + CASE PC.PastHistoryUSATimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,
	PastHistoryACS=CASE WHEN PC.PastHistoryUSA='Y' THEN 'ACS: ' + CASE WHEN PC.PastHistoryACSSince > 0 THEN LTRIM(RTRIM(STR(PC.PastHistoryACSSince))) ELSE '' END + ' ' + CASE PC.PastHistoryACSTimeUnit WHEN 'D' THEN 'Days' WHEN 'W' THEN 'Weeks' WHEN 'M' THEN 'Months' WHEN 'Y' THEN 'Yrs' WHEN 'H' THEN 'Hrs' WHEN 'T' THEN 'Min' ELSE '' END ELSE '' END,

	SE.CVSExam,
	SE.PericardialRubExam,
	SE.S3Exam,
	SE.S4Exam,
	SE.OSExam,
	SE.OtherExam,
	SE.ChestExaminationExam,
	SE.BilateralNormalVesicularBreathingExam,
	SE.BilateralCrepitationExam,
	SE.RonchiExam,
	SE.WheezingExam,
	SE.RightBronchialBreathingExam,
	SE.LeftBronchialBreathingExam,
	SE.BilateralBronchialBreathingExam,
	SE.AbsentAirEntryExam,
	SE.PeripheralPulsesExaminationExam,
	SE.PalpablebilaterallyinupperandlowerlimbExam,
	SE.AbsentinLeftExam,
	SE.RadialAbsentinLeftExam,
	SE.UlnarAbsentinLeftExam,
	SE.BrachialAbsentinLeftExam,
	SE.AbsentinRightExam,
	SE.RadialAbsentinRightExam,
	SE.UlnarAbsentinRightExam,
	SE.BrachialAbsentinRightExam,
	SE.AbsentinLeft2Exam,
	SE.FemoralAbsentinLeft2Exam,
	SE.PoplitialAbsentinLeft2Exam,
	SE.PosteriorTibbialAbsentinLeft2Exam,
	SE.DorsalisPaedisAbsentinLeft2Exam,
	SE.AbsentinRight2Exam,
	SE.FemoralAbsentinRight2Exam,
	SE.PoplitialAbsentinRight2Exam,
	SE.PosteriorTibbialAbsentinRight2Exam,
	SE.DorsalisPaedisAbsentinRight2Exam,
	SE.OtherSystemicAbnormalFindingsExam,

	LIR.CBC,
	LIR.RFTs,
	LIR.LFTs,
	LIR.UricAcid,
	LIR.SerumElectrolytes,
	LIR.UreaCreatinine,
	LIR.FastingLipidProfile,
	LIR.FastingBloodSugar,
	LIR.RandomBloodSugar,
	LIR.HbA1C,
	LIR.CardiacEnzymes,
	LIR.TropT,
	LIR.TropI,
	LIR.PTINR,
	LIR.APTT,
	LIR.BNP,
	LIR.DDimmer,
	LIR.ASOTitre,
	LIR.CRP,
	LIR.CRPHighSensitive,
	LIR.PSA,
	LIR.ThyroidFunctionTest,
	LIR.Other,

	ProvisionalDiagnosis = PD.ProvisionalDiagnosis,
	PD_Details = PD.Details,
	DischargeRefferalCode=P.DischargeRefferalCode, 
	DischargeRefferal = (SELECT DR.Name FROM DischargeRefferal DR WHERE DR.DischargeRefferalCode = P.DischargeRefferalCode),
	DischargeNotes=P.DischargeNotes
	
FROM 
	(SELECT Patient.PatientCode, Patient.Name, Patient.RegNo, Patient.FName, Patient.Date, Patient.AgeYears, Patient.AgeMonths, Patient.AgeDays, Patient.DOB, Patient.Address1, Patient.Gender, Patient.DoctCode,
		A.AdmissionCode, AdmissionDate=A.Date, Discharged=A.Discharged, DischargedOn=A.DischargedOn, DischargeRefferalCode, DischargeNotes
	FROM PatientAdmission A, Patient 
	WHERE A.AdmissionCode IN (:ai_code) AND 
		A.PatientCode = Patient.PatientCode) P
	LEFT OUTER JOIN PatientFirstContact PFC ON (P.PatientCode = PFC.PatientCode AND P.AdmissionCode=PFC.AdmissionCode)
	LEFT OUTER JOIN PC ON (P.PatientCode = PC.PatientCode AND P.AdmissionCode=PC.AdmissionCode)
	LEFT OUTER JOIN GPE ON (P.PatientCode = GPE.PatientCode AND P.AdmissionCode=GPE.AdmissionCode)
	LEFT OUTER JOIN SE ON (P.PatientCode = SE.PatientCode AND P.AdmissionCode=SE.AdmissionCode)
	LEFT OUTER JOIN LabInvestRec AS LIR ON (P.PatientCode = LIR.PatientCode AND P.AdmissionCode=LIR.AdmissionCode)
	LEFT OUTER JOIN ProvDiag PD ON (P.PatientCode = PD.PatientCode AND P.AdmissionCode=PD.AdmissionCode)
ORDER BY
	P.PatientCode"
  arguments=(("ai_code", number))
)
