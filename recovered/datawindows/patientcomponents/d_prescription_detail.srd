footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PrescriptionDetail.prescode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="PrescriptionDetail.icode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=discontinued dbname="Discontinued" 
 values="Yes	Y/No	N/"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=long updatewhereclause=yes name=rowid dbname="PrescriptionDetail.rowid"  )
column=(type=long update=yes updatewhereclause=yes validation="Long( GetText() ) > 0" initial="1" name=noofunits dbname="PrescriptionDetail.noofunits"  )
column=(type=long update=yes updatewhereclause=yes validation="Long( GetText() ) > 0" name=dosagecode dbname="PrescriptionDetail.dosagecode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes validation="Long( GetText() ) > 0" name=dosefactor dbname="PrescriptionDetail.dosefactor"  )
column=(type=long update=yes updatewhereclause=yes validation="Long( GetText() ) > 0" name=routecode dbname="PrescriptionDetail.routecode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=date dbname="PrescriptionDetail.date"  )
column=(type=long update=yes updatewhereclause=yes validation="Long( GetText() ) > 0" initial="1" name=duration dbname="PrescriptionDetail.duration"  )
column=(type=long update=yes updatewhereclause=yes name=inscode dbname="PrescriptionDetail.inscode" 
 values=""  )
 retrieve="Select p.prescode,
		 p.icode,
		 Discontinued='N',
		 aliasname = i.customicode,
		 i.name,
		 CurrListRow = 0,
		 p.rowid,
		 p.noofunits,
		 p.dosagecode,
		 p.dosefactor,
		 p.routecode,
		 p.date,
		 p.duration,
		 p.inscode
		 
From   PrescriptionDetail p , Item i

Where  p.prescode = :ar_prescode And
		 p.icode = i.icode

Order By RowID"
  update="PrescriptionDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_prescode", number))
)
