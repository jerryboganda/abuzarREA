column=(type=char(100) update=yes updatewhereclause=yes name=issuedto dbname="BirthCertificate.IssuedTo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=issuedtocnic dbname="BirthCertificate.IssuedToCNIC"  )
column=(type=char(100) update=yes updatewhereclause=yes name=issuedtocellno dbname="BirthCertificate.IssuedToCellNo"  )
 retrieve="SELECT 
	BirthCertificate.BirthCertificateCode,   
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode=BirthCertificate.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode=BirthCertificate.PatientCode),
	BirthCertificate.VisitCode,   
	BirthCertificate.AdmissionCode,   
	BirthCertificate.UserCode,   
	BirthCertificate.Date,   
	BirthCertificate.DOB,   
	BirthCertificate.ChildName,   
	BirthCertificate.Gender,   
	BirthCertificate.FatherName,   
	BirthCertificate.FatherCNIC,   
	BirthCertificate.FatherCellNo,   
	BirthCertificate.MotherName,   
	BirthCertificate.MotherCNIC,   
	BirthCertificate.MotherCellNo,   
	BirthCertificate.AgeOfMother,   
	BirthCertificate.PlaceOfBirth,   
	BirthCertificate.DoctorName,   
	BirthCertificate.HospitalName,   
	BirthCertificate.IssuedTo,   
	BirthCertificate.IssuedToCNIC,   
	BirthCertificate.IssuedToCellNo  
FROM 
	BirthCertificate"
  update="BirthCertificate" updatewhere=1 updatekeyinplace=no
 )
