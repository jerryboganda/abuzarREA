column=(type=long update=yes updatewhereclause=yes name=attendingdoctcode dbname="PC.AttendingDoctCode" 
 values=""  )
 retrieve="SELECT 
	RowID,
	Date,
	PatientCode,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = PC.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = PC.PatientCode),
	FHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = PC.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = PC.PatientCode),
	Gender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = PC.PatientCode),
	AdmissionCode,
	ChestPain,
	ChestpainSince,
	ChestPainTimeUnit,
	ChestPainATypical,
	ChestPainATypicalSince,
	ChestPainATypicalTimeUnit,
	ShortnessofBreath,
	ShortnessofBreathSince,
	ShortnessofBreathTimeUnit,
	RelievedAtRestIncreaseOnExertion,
	RelievedAtRestIncreaseOnExertionSince,
	RelievedAtRestIncreaseOnExertionTimeUnit,
	ChestDiscomfort,
	ChestDiscomfortSince,
	ChestDiscomforttimeUnit,
	ChestHeavinessTightnessOnExertion,
	ChestHeavinessTightnessOnExertionFor,
	ChestHeavinessTightnessOnExertionTimeUnit,
	ChestHeavinessTightnessOnExertionReason,
	PressureLikeSymtomsInChest,
	PressureLikeSymtomsInChestSince,
	PressureLikeSymtomsInChestTimeUnit,
	TypicalAnginaFunctionalClass,
	TypicalAnginaFunctionalClassSince,
	TypicalAnginaFunctionalClassTimeUnit,
	Type1AnginaFunctionalClass,
	Type2AnginaFunctionalClass,
	Type3AnginaFunctionalClass,
