table(column=(type=long updatewhereclause=yes name=code dbname="PatientAdmission.AdmissionCode"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientAdmission.PatientCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=admittedto dbname="AdmittedTo" 
 values=""  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Regno"  )
column=(type=long updatewhereclause=yes name=currentlocation dbname="CurrentLocation" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=admittedon dbname="AdmittedOn"  )
column=(type=long updatewhereclause=yes name=admittedby dbname="AdmittedBy" 
 values=""  )
column=(type=long updatewhereclause=yes name=doctorcode dbname="PatientAdmission.DoctorCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=diagnosis dbname="PatientAdmission.Diagnosis"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=discharged1 dbname="PatientAdmission.Discharged1" 
 values="Yes	Y/No	N/"  )
column=(type=long updatewhereclause=yes name=discharged1by dbname="PatientAdmission.Discharged1By" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=discharged1on dbname="PatientAdmission.Discharged1On"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=discharged dbname="PatientAdmission.Discharged" 
 values="Yes	Y/No	N/"  )
column=(type=long updatewhereclause=yes name=dischargedby dbname="PatientAdmission.DischargedBy" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=dischargedon dbname="PatientAdmission.DischargedOn"  )
 retrieve="SELECT
	PA.AdmissionCode,
	PA.PatientCode,   
	AdmittedTo=PA.LocationCode,   
	Regno = (SELECT Patient.RegNo FROM Patient 
		WHERE Patient.PatientCode = 
			(SELECT PatientCode 
			FROM PatientAdmission 
			WHERE PatientAdmission.AdmissionCode = :Code)),
	CurrentLocation = ISNULL((SELECT TargetLocation FROM PatientTransfer WHERE PatientTransfer.TransferCode = (SELECT Max(PatientTransfer.TransferCode) FROM PatientTransfer WHERE PatientTransfer.AdmissionCode = :Code)), (SELECT A.LocationCode FROM PatientAdmission A WHERE A.AdmissionCode = :Code)), 
	AdmittedOn=PA.Date,
	AdmittedBy=PA.UserCode,
	PA.DoctorCode,
	PA.Diagnosis,
	PA.Discharged1,
	PA.Discharged1By,
	PA.Discharged1On,
	PA.Discharged,
	PA.DischargedBy,
	PA.DischargedOn
FROM
	PatientAdmission PA
WHERE
	PA.AdmissionCode = :Code
"
  arguments=(("Code", number))
)
