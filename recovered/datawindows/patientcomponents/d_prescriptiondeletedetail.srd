column=(type=datetime update=yes updatewhereclause=yes name=deletedate dbname="PrescriptionDeleteDetail.DeleteDate"  )
 retrieve="SELECT 
	PrescriptionDeleteDetail.PresCode,   
	PrescriptionDeleteDetail.ICode,   
	PrescriptionDeleteDetail.RowId,   
	PrescriptionDeleteDetail.NoOfUnits,   
	PrescriptionDeleteDetail.DosageCode,   
	PrescriptionDeleteDetail.DoseFactor,   
	PrescriptionDeleteDetail.RouteCode,   
	PrescriptionDeleteDetail.Date,   
	PrescriptionDeleteDetail.Duration,   
	PrescriptionDeleteDetail.InsCode,   
	PrescriptionDeleteDetail.DeleteDate  
FROM
	PrescriptionDeleteDetail  
WHERE 
	PrescriptionDeleteDetail.PresCode = :ai_code
ORDER BY
	PrescriptionDeleteDetail.RowId"
  update="PrescriptionDeleteDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
