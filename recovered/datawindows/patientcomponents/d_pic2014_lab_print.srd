column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_seta_k dbname="EmrLabInvestRec.SetA_K"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_seta_randombloodsugar dbname="EmrLabInvestRec.SetA_RandomBloodSugar"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_seta_cpk dbname="EmrLabInvestRec.SetA_CPK"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_seta_ckmb dbname="EmrLabInvestRec.SetA_CKMB"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setb dbname="EmrLabInvestRec.SetB"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setb_tropti dbname="EmrLabInvestRec.SetB_TropTI"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setb_ce dbname="EmrLabInvestRec.SetB_CE"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setb_ptinr dbname="EmrLabInvestRec.SetB_PTINR"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setb_aptt dbname="EmrLabInvestRec.SetB_APTT"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setc dbname="EmrLabInvestRec.SetC"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setc_serummagnesium dbname="EmrLabInvestRec.SetC_SerumMagnesium"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setc_serumcalcium dbname="EmrLabInvestRec.SetC_SerumCalcium"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setc_bnp dbname="EmrLabInvestRec.SetC_BNP"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setc_ddimmer dbname="EmrLabInvestRec.SetC_DDimmer"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setc_asotitre dbname="EmrLabInvestRec.SetC_ASOTitre"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setc_crp dbname="EmrLabInvestRec.SetC_CRP"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setc_crphighsensitive dbname="EmrLabInvestRec.SetC_CRPHighSensitive"  )
column=(type=char(1) updatewhereclause=yes name=emrlabinvestrec_setc_urinece dbname="EmrLabInvestRec.SetC_UrineCE"  )
column=(type=char(1000) updatewhereclause=yes name=emrlabinvestrec_other dbname="EmrLabInvestRec.Other"  )
 retrieve="SELECT 
	Date=P.Date,
	PatientCode=P.PatientCode,
	RegNo = P.RegNo,
	PatientName = P.Name,
	FHName = P.FName,
	Gender = CASE P.Gender WHEN 'M' THEN 'Male' WHEN 'F' THEN 'Female' ELSE ' ' END,
	Age = ISNULL(LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ','')/* + ISNULL(LTRIM(RTRIM(STR(P.AgeMonths))) + ' month ','') + ISNULL(LTRIM(RTRIM(STR(P.AgeDays))) + ' days ','')*/,
	Address1=P.Address1,
	DoctCode = P.DoctCode,
	ConsultanctFirstContact=PFC.DoctCode,
	AdmissionCode=P.AdmissionCode,

	ELIR.SetA,
	ELIR.SetA_CBC,
	ELIR.SetA_UreaCreatinine,
	ELIR.SetA_SerumNa,
	ELIR.SetA_K,
	ELIR.SetA_RandomBloodSugar,
	ELIR.SetA_CPK,
	ELIR.SetA_CKMB,
	ELIR.SetB,
	ELIR.SetB_TropTI,
	ELIR.SetB_CE,
	ELIR.SetB_PTINR,
	ELIR.SetB_APTT,
	ELIR.SetC,
	ELIR.SetC_SerumMagnesium,
	ELIR.SetC_SerumCalcium,
	ELIR.SetC_BNP,
	ELIR.SetC_DDimmer,
	ELIR.SetC_ASOTitre,
	ELIR.SetC_CRP,
	ELIR.SetC_CRPHighSensitive,
	ELIR.SetC_UrineCE,
	ELIR.Other

FROM 
	(SELECT Patient.PatientCode, Patient.Name, Patient.RegNo, Patient.FName, Patient.Date, Patient.AgeYears, Patient.AgeMonths, Patient.AgeDays, Patient.DOB, Patient.Address1, Patient.Gender, Patient.DoctCode, 
		A.AdmissionCode, AdmissionDate=A.Date, Discharged=A.Discharged, DischargedOn=A.DischargedOn
	FROM PatientAdmission A, Patient 
	WHERE A.AdmissionCode = :ai_code AND A.PatientCode = Patient.PatientCode) P
	LEFT OUTER JOIN PatientFirstContact PFC ON (P.PatientCode = PFC.PatientCode AND P.AdmissionCode=PFC.AdmissionCode)
	LEFT OUTER JOIN EmrLabInvestRec AS ELIR ON (P.PatientCode = ELIR.PatientCode AND P.AdmissionCode=ELIR.AdmissionCode)
WHERE 
	P.AdmissionCode = :ai_code
ORDER BY
	P.PatientCode"
  arguments=(("ai_code", number))
)
