table(column=(type=long key=yes updatewhereclause=yes name=rowid dbname="CABG.RowID"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="CABG.Date"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=yes name=fhname dbname="FHName"  )
column=(type=char(46) updatewhereclause=yes name=age dbname="Age"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=patientcode dbname="CABG.PatientCode"  )
column=(type=long update=yes updatewhereclause=yes name=admissioncode dbname="CABG.AdmissionCode"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="CABG.UserCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=attendingdoctcode dbname="CABG.AttendingDoctCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=hadcabg dbname="CABG.HadCABG" 
 values="Had CABG	Y/Had CABG	N"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=hadcabgon dbname="CABG.HadCABGOn"  )
column=(type=char(255) update=yes updatewhereclause=yes name=surgeon dbname="CABG.Surgeon"  )
column=(type=char(255) update=yes updatewhereclause=yes name=institution dbname="CABG.Institution"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=lima dbname="CABG.Lima" 
 values="LIMA	Y/LIMA	N"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=limavalue dbname="CABG.LimaValue"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=svg dbname="CABG.SVG" 
 values="SVG	Y/SVG	N"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=svgvalue dbname="CABG.SVGValue"  )
column=(type=char(255) update=yes updatewhereclause=yes name=other dbname="CABG.Other"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=remarks dbname="CABG.Remarks"  )
 retrieve="SELECT 
	RowID,
	Date,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = CABG.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = CABG.PatientCode),
	FHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = CABG.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = CABG.PatientCode),
	Gender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = CABG.PatientCode),
	PatientCode,
	AdmissionCode,
	UserCode,
	AttendingDoctCode,
	HadCABG,
	HadCABGOn,
	Surgeon,
	Institution,
	Lima,
	LimaValue,
	SVG,
	SVGValue,
	Other,
	Remarks
FROM
	CABG
WHERE 
	CABG.AdmissionCode = :ai_code
ORDER BY
	CABG.PatientCode,
	CABG.RowID DESC"
  update="CABG" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
