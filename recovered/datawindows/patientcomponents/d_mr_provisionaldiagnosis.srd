detail(height=1320 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=rowid dbname="ProvDiag.RowID"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="ProvDiag.Date"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=yes name=fhname dbname="FHName"  )
column=(type=char(46) updatewhereclause=yes name=age dbname="Age"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=patientcode dbname="ProvDiag.PatientCode"  )
column=(type=long update=yes updatewhereclause=yes name=admissioncode dbname="ProvDiag.AdmissionCode"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="ProvDiag.UserCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=attendingdoctcode dbname="ProvDiag.AttendingDoctCode" 
 values=""  )
column=(type=char(255) update=yes updatewhereclause=yes name=provisionaldiagnosis dbname="ProvDiag.ProvisionalDiagnosis" 
 values=""  )
column=(type=char(1000) update=yes updatewhereclause=yes name=details dbname="ProvDiag.Details"  )
 retrieve="SELECT 
	RowID,
	Date,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = ProvDiag.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = ProvDiag.PatientCode),
	FHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = ProvDiag.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = ProvDiag.PatientCode),
	Gender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = ProvDiag.PatientCode),
	PatientCode,
	AdmissionCode,
	UserCode,
	AttendingDoctCode,
	ProvisionalDiagnosis,
	Details
FROM
	ProvDiag
WHERE 
	ProvDiag.AdmissionCode = :ai_code
ORDER BY
	ProvDiag.PatientCode,
	ProvDiag.RowID DESC"
  update="ProvDiag" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
