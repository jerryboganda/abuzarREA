 retrieve="SELECT
	patientcode,
	Regno, 
	name ,
	employeename,
	ward,
	gender,
	active,
	FatherHusband,
	fname,
	dob,
	custcode,
	usercode,
	date,
	NationalIDCard,
	phone,
	fax,
	email,
	rankcode,
	unitcode,
	address1,
	address2,
	city,
	AgeYears,
	AgeMonths,
	AgeDays,
	OriginalDate,
	InactiveDate,
	RelationCode,
	DoctCode,
	WardCode,
	CreatedBy,
	UserCode,
	InActivedBy,
	DiseaseCode,
	LocationCode,
	Diagnosis,
	RecurringPeriod,
	Profession,
	PatientCatCode,
	Reference,
	GestationCode,
	CrLimit,
	RefNo1,
	RefNo2,
	RefNo3,
	RefNo4,
	RefNo5,
	RefNo6,
	RefNo7,
	CashAccCode,
	CashTendered,
	CashCharged,
	CashBack,
	Address3,
	Institute,
	Phone2,
	Nationality,
	MobileNo1,
	MobileNo2,
	MobileNo3,
	FamilyMembers,
	Brothers,
	Sisters,
	MotherName,
	Profession2,
	PassportNo,
	PrincipalPatient,
	Allergies,
	CountyCode,
	LicenseExpiry,
	MemberShipID
FROM 
	patient      
WHERE
	( patientcode = :ra_patientcode )   "
  update="patient" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_patientcode", number))
)
