table(column=(type=long key=yes updatewhereclause=yes name=code dbname="Patient.patientcode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Patient.Regno"  )
column=(type=char(127) updatewhereclause=yes name=name dbname="name"  )
column=(type=char(100) updatewhereclause=yes name=ward dbname="Patient.ward"  )
column=(type=char(1) updatewhereclause=yes initial="M" name=gender dbname="Patient.gender" 
 values="Male	M/Female	F/"  )
column=(type=char(1) updatewhereclause=yes initial="Y" name=active dbname="Patient.active" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes name=fatherhusband dbname="Patient.fatherhusband"  )
column=(type=char(60) updatewhereclause=yes name=fname dbname="Patient.fname"  )
column=(type=datetime updatewhereclause=yes name=dob dbname="Patient.dob"  )
column=(type=long updatewhereclause=yes name=custcode dbname="Patient.custcode"  )
column=(type=long updatewhereclause=yes name=usercode dbname="Patient.usercode"  )
column=(type=datetime updatewhereclause=yes initial="today" name=date dbname="Patient.date"  )
column=(type=char(25) updatewhereclause=yes name=nationalidcard dbname="Patient.NationalIDCard"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Patient.phone"  )
column=(type=char(30) updatewhereclause=yes name=fax dbname="Patient.fax"  )
column=(type=char(35) updatewhereclause=yes name=email dbname="Patient.email"  )
column=(type=long updatewhereclause=yes initial="1" name=rankcode dbname="Patient.rankcode"  )
column=(type=long updatewhereclause=yes initial="1" name=unitcode dbname="Patient.unitcode"  )
column=(type=char(100) updatewhereclause=yes name=address1 dbname="Patient.address1"  )
column=(type=char(100) updatewhereclause=yes name=address2 dbname="Patient.address2"  )
column=(type=char(25) updatewhereclause=yes name=city dbname="Patient.city"  )
column=(type=char(100) updatewhereclause=yes name=allergies dbname="Patient.allergies"  )
column=(type=char(99) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Please Enter Valid Age'" name=age dbname="Age"  )
column=(type=datetime updatewhereclause=yes name=lastvisitdate dbname="LastVisitDate"  )
 retrieve="SELECT  
	patientcode ,
	Regno,
	name = name + ' ' + ISNULL(CASE gender WHEN 'F' THEN CASE WHEN fatherhusband = 'H' THEN ' W/O: ' ELSE ' D/O: ' END ELSE  ' S/O: ' END + FName, ''),
	ward,
	gender,
	active,
	fatherhusband,
	fname,
	dob,
	custcode,
	usercode,
	date,
	NationalIDCard,
	phone,
	fax,
	email,
	rankcode,
	unitcode,
	address1,
	address2,
	city,
	allergies,
	Age=LTRIM(RTRIM(STR(DATEDIFF(yy, Patient.DOB, GETDATE()) - CASE WHEN (MONTH(Patient.DOB) > MONTH(GETDATE())) OR (MONTH(Patient.DOB) = MONTH(GETDATE()) AND DAY(Patient.DOB) > DAY(GETDATE())) THEN 1 ELSE 0 END))) + ' Year(s) ' +
		LTRIM(RTRIM(STR(DATEDIFF(m, DATEADD(yy, DATEDIFF(yy, Patient.DOB, GETDATE()) - CASE WHEN (MONTH(Patient.DOB) > MONTH(GETDATE())) OR (MONTH(Patient.DOB) = MONTH(GETDATE()) AND DAY(Patient.DOB) > DAY(GETDATE())) THEN 1 ELSE 0 END, Patient.DOB), GETDATE()) - CASE WHEN DAY(Patient.DOB) > DAY(GETDATE()) THEN 1 ELSE 0 END))) + ' Month(s) ' +
		LTRIM(RTRIM(STR(DATEDIFF(d, DATEADD(m, DATEDIFF(m, DATEADD(yy, DATEDIFF(yy, Patient.DOB, GETDATE()) - CASE WHEN (MONTH(Patient.DOB) > MONTH(GETDATE())) OR (MONTH(Patient.DOB) = MONTH(GETDATE()) AND DAY(Patient.DOB) > DAY(GETDATE())) THEN 1 ELSE 0 END, Patient.DOB), GETDATE()) - CASE WHEN DAY(Patient.DOB) > DAY(GETDATE()) THEN 1 ELSE 0 END, DATEADD(yy, DATEDIFF(yy, Patient.DOB, GETDATE()) - CASE WHEN (MONTH(Patient.DOB) > MONTH(GETDATE())) OR (MONTH(Patient.DOB) = MONTH(GETDATE()) AND DAY(Patient.DOB) > DAY(GETDATE())) THEN 1 ELSE 0 END, Patient.DOB)), GETDATE())))) + ' Day(s)                                           ',
	LastVisitDate=(SELECT MAX(SH.Date) FROM ServiceHeader SH WHERE SH.PatientCode = :ra_patientcode)
FROM 
	Patient      
WHERE 
	patientcode = :ra_patientcode AND 
	patient.Active='Y'
"
  update="Patient" updatewhere=0 updatekeyinplace=no
  arguments=(("ra_patientcode", number))
)
