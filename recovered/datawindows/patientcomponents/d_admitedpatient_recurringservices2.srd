table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="AdmittedPatientRecurringServices.admissioncode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="AdmittedPatientRecurringServices.servicecode"  )
column=(type=long update=yes updatewhereclause=yes name=smancode dbname="AdmittedPatientRecurringServices.smancode"  )
column=(type=long update=yes updatewhereclause=yes name=frequencyhrs dbname="AdmittedPatientRecurringServices.FrequencyHrs"  )
column=(type=datetime update=yes updatewhereclause=yes name=startdate dbname="AdmittedPatientRecurringServices.StartDate"  )
column=(type=datetime update=yes updatewhereclause=yes name=nextrunon dbname="AdmittedPatientRecurringServices.NextRunOn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=qty dbname="AdmittedPatientRecurringServices.qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="AdmittedPatientRecurringServices.saleprice"  )
column=(type=char(1) updatewhereclause=yes name=allowsaleindecimal dbname="AllowSaleInDecimal"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=serviceflatdisc dbname="AdmittedPatientRecurringServices.serviceflatdisc"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="AdmittedPatientRecurringServices.RowId"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=discperc dbname="AdmittedPatientRecurringServices.discperc"  )
 retrieve="SELECT 
	AdmittedPatientRecurringServices.admissioncode,
	AdmittedPatientRecurringServices.servicecode,
	AdmittedPatientRecurringServices.smancode,
	AdmittedPatientRecurringServices.FrequencyHrs,
	AdmittedPatientRecurringServices.StartDate,
	AdmittedPatientRecurringServices.NextRunOn,
	AdmittedPatientRecurringServices.qty,
	AdmittedPatientRecurringServices.saleprice,
	AllowSaleInDecimal=Service.AllowSaleInDecimal,
	AdmittedPatientRecurringServices.serviceflatdisc,
	AdmittedPatientRecurringServices.IDentityCOL,
	AdmittedPatientRecurringServices.discperc
FROM 
	AdmittedPatientRecurringServices, service
WHERE 
	AdmittedPatientRecurringServices.admissioncode = :ai_code AND
	AdmittedPatientRecurringServices.servicecode = service.servicecode
	"
  update="AdmittedPatientRecurringServices" updatewhere=0 updatekeyinplace=no
  arguments=(("ai_code", number))
)
