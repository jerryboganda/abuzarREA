column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=cashback dbname="Patient.CashBack"  )
 retrieve="SELECT 
	patientcode ,
	Regno,
	name ,
	ward,
	gender,
	active,
	fname,
	dob,
	custcode,
	usercode,
	date,
	NationalIDCard,
	phone,
	fax,
	email,
	rankcode,
	unitcode,
	address1,
	address2,
	city,
	admissioncode=null,
	locationcode=null,
	diagnosis='                                               ',
	doctorcode=null,
	AutoGenRecurringServiceInv,
	admit=0,
	CashAccCode,
	CashTendered,
	CashCharged,
	CashBack
FROM 
	patient      
WHERE 
	( patientcode = :ra_patientcode )
"
  update="patient" updatewhere=1 updatekeyinplace=yes
  arguments=(("ra_patientcode", number))
)
