table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="DeathCertificateCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="PatientCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=visitcode dbname="VisitCode"  )
column=(type=long update=yes updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="Date"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=dob dbname="DOB"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fullname dbname="FullName"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="M" name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=cnic dbname="CNIC"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fathercnic dbname="FatherCNIC"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fathercellno dbname="FatherCellNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mothername dbname="MotherName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mothercnic dbname="MotherCNIC"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mothercellno dbname="MotherCellNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=ageofmother dbname="AgeOfMother"  )
column=(type=long update=yes updatewhereclause=yes name=diseasecode dbname="DiseaseCode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=placeofdeath dbname="PlaceOfDeath"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=causeofdeath dbname="CauseOfDeath"  )
column=(type=char(100) update=yes updatewhereclause=yes name=doctorname dbname="DoctorName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=hospitalname dbname="HospitalName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=issuedto dbname="IssuedTo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=issuedtocnic dbname="IssuedToCNIC"  )
column=(type=char(100) update=yes updatewhereclause=yes name=issuedtocellno dbname="IssuedToCellNo"  )
 retrieve="SELECT 
	DeathCertificateCode=DeathCertificate.DeathCertificateCode,   
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode=DeathCertificate.PatientCode),
	PatientCode=DeathCertificate.PatientCode,   
	VisitCode=DeathCertificate.VisitCode,   
	AdmissionCode=DeathCertificate.AdmissionCode,   
	UserCode=DeathCertificate.UserCode,   
	Date=DeathCertificate.Date,   
	DOB=DeathCertificate.DOB,   
	FullName=DeathCertificate.FullName,   
	Gender=DeathCertificate.Gender,   
	CNIC = DeathCertificate.CNIC,
	FatherName=DeathCertificate.FatherName,   
	FatherCNIC=DeathCertificate.FatherCNIC,   
	FatherCellNo=DeathCertificate.FatherCellNo,   
	MotherName=DeathCertificate.MotherName,   
	MotherCNIC=DeathCertificate.MotherCNIC,   
	MotherCellNo=DeathCertificate.MotherCellNo,   
	AgeOfMother=DeathCertificate.AgeOfMother,   
	DiseaseCode=DeathCertificate.DiseaseCode,   
	PlaceOfDeath=DeathCertificate.PlaceOfDeath,   
	CauseOfDeath=DeathCertificate.CauseOfDeath,   
	DoctorName=DeathCertificate.DoctorName,   
	HospitalName=DeathCertificate.HospitalName,   
	IssuedTo=DeathCertificate.IssuedTo,   
	IssuedToCNIC=DeathCertificate.IssuedToCNIC,   
	IssuedToCellNo=DeathCertificate.IssuedToCellNo 
FROM 
	DeathCertificate
WHERE 
	DeathCertificate.DeathCertificateCode = :ai_code"
  update="DeathCertificate" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
