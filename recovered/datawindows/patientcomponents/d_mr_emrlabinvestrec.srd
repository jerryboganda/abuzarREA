 values="Serum Magnesium	Y/Serum Magnesium	N"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=setc_serumcalcium dbname="EmrLabInvestRec.SetC_SerumCalcium" 
 values="Serum Calcium	Y/Serum Calcium	N"  )
