column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=setc_urinece dbname="EmrLabInvestRec.SetC_UrineCE" 
 values="Urine C//E	Y/Urine C//E	N"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=other dbname="EmrLabInvestRec.Other"  )
 retrieve="SELECT
	RowID,
	Date,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = EmrLabInvestRec.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode = EmrLabInvestRec.PatientCode),
	FHName = (SELECT P.FName FROM Patient P WHERE P.PatientCode = EmrLabInvestRec.PatientCode),
	Age = (SELECT LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ' + LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ' + LTRIM(RTRIM(STR(P.AgeDays))) + ' days ' FROM Patient P WHERE P.PatientCode = EmrLabInvestRec.PatientCode),
	Gender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode = EmrLabInvestRec.PatientCode),
	PatientCode,
	AdmissionCode,
	UserCode,
	AttendingDoctCode,
	SetA,
	SetA_CBC,
	SetA_UreaCreatinine,
	SetA_SerumNa,
	SetA_K,
	SetA_RandomBloodSugar,
	SetA_CPK,
	SetA_CKMB,
	SetB,
	SetB_TropTI,
	SetB_CE,
	SetB_PTINR,
	SetB_APTT,
	SetC,
	SetC_SerumMagnesium,
	SetC_SerumCalcium,
	SetC_BNP,
	SetC_DDimmer,
	SetC_ASOTitre,
	SetC_CRP,
	SetC_CRPHighSensitive,
	SetC_UrineCE,
	Other
FROM
	EmrLabInvestRec
WHERE 
	EmrLabInvestRec.AdmissionCode = :ai_code
ORDER BY
	EmrLabInvestRec.PatientCode,
	EmrLabInvestRec.RowID DESC"
  update="EmrLabInvestRec" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
