table(column=(type=long updatewhereclause=yes name=admissioncode dbname="PatientAdmission.AdmissionCode"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientAdmission.PatientCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=admittedto dbname="AdmittedTo" 
 values=""  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Regno"  )
column=(type=datetime updatewhereclause=yes name=admittedon dbname="AdmittedOn"  )
column=(type=long updatewhereclause=yes name=admittedby dbname="AdmittedBy" 
 values=""  )
column=(type=long updatewhereclause=yes name=doctorcode dbname="PatientAdmission.DoctorCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=diagnosis dbname="PatientAdmission.Diagnosis"  )
column=(type=long updatewhereclause=yes name=code dbname="TransferCode"  )
column=(type=long updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=sourcelocation dbname="SourceLocation" 
 values=""  )
column=(type=long updatewhereclause=yes name=targetlocation dbname="TargetLocation" 
 values=""  )
column=(type=long updatewhereclause=yes name=doctcode dbname="DoctCode" 
 values=""  )
column=(type=char(62) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=usercode dbname="usercode"  )
 retrieve="SELECT
	PA.AdmissionCode,
	PA.PatientCode,   
	AdmittedTo=PA.LocationCode,   
	Regno = (SELECT Patient.RegNo FROM Patient 
		WHERE Patient.PatientCode = 
			(SELECT PatientCode 
			FROM PatientAdmission 
			WHERE PatientAdmission.AdmissionCode = :Code)),
	AdmittedOn=PA.Date,   
	AdmittedBy=PA.UserCode,
	PA.DoctorCode,   
	PA.Diagnosis ,
	TransferCode=NULL,
	Date=NULL,   
	SourceLocation = ISNULL((SELECT TargetLocation FROM PatientTransfer WHERE PatientTransfer.TransferCode = (SELECT Max(PatientTransfer.TransferCode) FROM PatientTransfer WHERE PatientTransfer.AdmissionCode = :Code)), (SELECT A.LocationCode FROM PatientAdmission A WHERE A.AdmissionCode = :Code)), 
	TargetLocation = NULL,
	DoctCode=NULL,
	Remarks='                                                              ',
	usercode=null
FROM
	PatientAdmission PA,
	PatientLocation L
WHERE
	PA.AdmissionCode = :Code AND
	PA.LocationCode = L.LocationCode
"
  arguments=(("Code", number))
)
