summary(height=0 color="536870912" )
footer(height=228 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=yes name=fhname dbname="FHName"  )
column=(type=char(6) updatewhereclause=yes name=gender dbname="Gender"  )
column=(type=char(15) updatewhereclause=yes name=age dbname="Age"  )
column=(type=char(100) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="Date"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=long update=yes updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=doctcode dbname="DoctCode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=optioncode dbname="OptionCode" 
 values=""  )
column=(type=char(255) update=yes updatewhereclause=yes name=details dbname="Details"  )
 retrieve="SELECT 
	RegNo = P.RegNo,
	PatientName = P.Name,
	FHName = P.FName,
	Gender = CASE P.Gender WHEN 'M' THEN 'Male' WHEN 'F' THEN 'Female' ELSE ' ' END,
	Age = ISNULL(LTRIM(RTRIM(STR(P.AgeYears))) + ' yrs ','') /*+ ISNULL(LTRIM(RTRIM(STR(P.AgeMonths))) + ' mon ','') + ISNULL(LTRIM(RTRIM(STR(P.AgeDays))) + ' days ','')*/,
	Address1=P.Address1,
	RowID=PFC.RowID,
	Date=PFC.Date,
	PatientCode=PFC.PatientCode,
	AdmissionCode=PFC.AdmissionCode,
	DoctCode=PFC.DoctCode,
	OptionCode=PFC.OptionCode,
	Details=PFC.Details
FROM
	PatientFirstContact PFC, Patient P
WHERE 
	PFC.RowID = :ai_rowid AND
	PFC.PatientCode = P.PatientCode"
  arguments=(("ai_rowid", number))
)
