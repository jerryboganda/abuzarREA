table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PrescriptionHeader.prescode"  )
column=(type=long update=yes updatewhereclause=yes name=admissioncode dbname="PrescriptionHeader.admissioncode"  )
column=(type=long update=yes updatewhereclause=yes name=createdby dbname="PrescriptionHeader.createdby"  )
column=(type=long update=yes updatewhereclause=yes name=modifiedby dbname="PrescriptionHeader.modifiedby"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="users"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="PrescriptionHeader.Patientcode" 
 values=""  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=originaldate dbname="PrescriptionHeader.originaldate"  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=modifieddate dbname="PrescriptionHeader.modifieddate"  )
column=(type=long update=yes updatewhereclause=yes name=doctcode dbname="PrescriptionHeader.doctcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=modifycounter dbname="PrescriptionHeader.modifycounter"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="PrescriptionHeader.posted"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="PrescriptionHeader.postedby"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="PrescriptionHeader.postdate"  )
column=(type=char(30) update=yes updatewhereclause=yes name=refno dbname="PrescriptionHeader.refno"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="PrescriptionHeader.remarks"  )
 retrieve="Select PrescriptionHeader.prescode,
		 PrescriptionHeader.admissioncode,
		 PrescriptionHeader.createdby,
		 PrescriptionHeader.modifiedby,
       users = ( Select UserName From users where usercode = PrescriptionHeader.createdby ),	
		 PrescriptionHeader.Patientcode,
	    regno = patient.regno , 
		 PrescriptionHeader.originaldate,
		 PrescriptionHeader.modifieddate,
		 PrescriptionHeader.doctcode,
		 PrescriptionHeader.modifycounter,
		 PrescriptionHeader.posted,
		 PrescriptionHeader.postedby,
		 PrescriptionHeader.postdate,
		 PrescriptionHeader.refno,
		 PrescriptionHeader.remarks

From   PrescriptionHeader, Patient

Where  PrescriptionHeader.PresCode = :ar_prescode And
		 PrescriptionHeader.PatientCode = Patient.PatientCode"
  update="PrescriptionHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_prescode", number))
)
