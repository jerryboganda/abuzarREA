 retrieve="SELECT   
	prledger.purinvcode ,
	prledger.prinvcode ,
	prledger.suppcode ,
	prledger.custcode,
	prledger.datacarrycustcode,
	prledger.salesmancode ,
	prledger.date ,
	prledger.discperc ,
	prledger.flatdisc ,
	prledger.misccharges ,
	prledger.salestax ,
	prledger.posted ,
	prledger.postdate ,
	prledger.remarks ,
	prledger.invtotal,
	prledger.prcatcode ,
	supplier.address1 ,
	supplier.city ,
	supplier.phone ,
	users.username,
	prledger.originaldate,
	prledger.modifiedby,
	prledger.postedby,
	prledger.invgstperc1,
	prledger.headerno,
	prledger.headerinvno,
	gcode=0,
	dbo.prledger.AccountFor,
	dbo.prledger.PaymentMode,
	dbo.prledger.PaymentAccCode,
	dbo.prledger.Amt,
	dbo.prledger.AmtBy,
	dbo.prledger.AmtDate,
	dbo.prledger.AmtReference,
	dbo.prledger.Outstandingamt,
	dbo.prledger.marked,
	dbo.prledger.prtypecode,
	dbo.prledger.Terms1,
	dbo.prledger.Terms2,
	dbo.prledger.Terms3,
	dbo.prledger.Terms4,
	dbo.prledger.Terms5,
	dbo.prledger.icatcode,
	dbo.prledger.PurchaseInvNo,
	dbo.prledger.UpdateAvgPriceWithNetRate,
	dbo.prledger.SiteCode,
	dbo.prledger.TargetSiteCode
FROM
	prledger ,
	supplier ,
	users ,
	accounts     

WHERE
	( prledger.suppcode = supplier.suppcode ) and
	( prledger.salesmancode = users.usercode ) and 
	( prledger.suppcode = accounts.acccode ) and
	( dbo.prledger.prinvcode = :ar_prinvcode )"
  update="prledger" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_prinvcode", number))
)
