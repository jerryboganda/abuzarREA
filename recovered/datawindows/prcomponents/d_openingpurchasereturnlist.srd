table(column=(type=long key=yes updatewhereclause=yes name=code dbname="PRLedger.prinvcode"  )
column=(type=long updatewhereclause=yes name=pur_inv_code dbname="PRLedger.purinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PRLedger.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
 retrieve="  SELECT  dbo.prledger.prinvcode , 
          dbo.prledger.purinvcode , 
          dbo.prledger.date ,  
			 posted = prledger.posted    
	 FROM  dbo.prledger      
   WHERE  ( dbo.prledger.prcatcode = 6 )  and
			 ( Posted IN (:as_Posted))   "
  update="prledger" updatewhere=0 updatekeyinplace=no
  arguments=(("as_Posted", stringlist))
)
