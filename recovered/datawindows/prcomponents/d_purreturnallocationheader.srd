table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PRAllocationHeader.PRAllocationCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="PRAllocationHeader.Date"  )
column=(type=long update=yes updatewhereclause=yes name=prinvcode dbname="PRAllocationHeader.PRInvCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=returntype dbname="ReturnType"  )
column=(type=datetime updatewhereclause=yes name=returndate dbname="ReturnDate"  )
column=(type=decimal(2) updatewhereclause=yes name=returnamt dbname="ReturnAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=returnoutstanding dbname="ReturnOutstanding"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="PRLedger.PurInvCode"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="PRLedger.SuppCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.Name"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="PRAllocationHeader.UserCode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes name=modified dbname="PRAllocationHeader.Modified"  )
column=(type=long update=yes updatewhereclause=yes name=modifiedby dbname="PRAllocationHeader.ModifiedBy"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="PRAllocationHeader.Posted"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="PRAllocationHeader.PostedBy"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="PRAllocationHeader.PostDate"  )
 retrieve="SELECT
	PRAllocationHeader.PRAllocationCode,   
	PRAllocationHeader.Date,   
	PRAllocationHeader.PRInvCode,   
	ReturnType=PRLedger.PRCatCode,
	ReturnDate=PRLedger.Date, 
	ReturnAmt=PRLedger.InvTotal,
	ReturnOutstanding=PRLedger.OutStandingAmt,
	PRLedger.PurInvCode, 
	PRLedger.SuppCode,
	Accounts.AliasName, 
	Accounts.Name,
	PRAllocationHeader.UserCode,
	PRAllocationHeader.Modified, 
	PRAllocationHeader.ModifiedBy,
	PRAllocationHeader.Posted, 
	PRAllocationHeader.PostedBy,
	PRAllocationHeader.PostDate
FROM 
	PRAllocationHeader, PRLedger, Accounts, Supplier
WHERE
	PRAllocationHeader.PRAllocationCode = :code AND
	PRAllocationHeader.PRInvCode = PRLedger.PRInvCode AND
	PRLedger.SuppCode = Supplier.SuppCode AND
	Supplier.SuppCode = Accounts.AccCode

"
  update="PRAllocationHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("code", number))
)
