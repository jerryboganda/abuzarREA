release 12.5;
datawindow ( units=0 timer_interval=60000 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=4 color="536870912" )
footer(height=92 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PRdetail.prinvcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="PRdetail.icode" 
 values=""  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="PRdetail.batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes validation="Datetime(gettext()) > today()" validationmsg="~"Expiry must be greater than today's date~"" name=expiry dbname="PRdetail.expiry"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=gcode dbname="PRdetail.gcode" 
 values=""  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=packqty dbname="PRdetail.packqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=looseqty dbname="PRdetail.looseqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=bonusqty dbname="PRdetail.bonusqty"  )
column=(type=long update=yes updatewhereclause=yes name=packunits dbname="PRdetail.packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="1" name=prprice dbname="PRdetail.prprice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=avgprice dbname="PRdetail.avgprice"  )
column=(type=decimal(0) key=yes update=yes updatewhereclause=yes name=prutn dbname="PRdetail.prutn"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=retablelooseqty dbname="retablelooseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=prevretlooseqty dbname="prevretlooseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=retablebonusqty dbname="retablebonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=prevretbonusqty dbname="prevretbonusqty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real( GetText()) >= 0 AND Real (GetText()) <= 100" initial="0" name=discperc dbname="PRdetail.discperc"  )
 retrieve="SELECT 
	item.customicode, 
	currlistrow = 0,
	packingdesc=item.packingdesc,
	dbo.prdetail.prinvcode,   
	dbo.prdetail.icode,
	dbo.prdetail.batch,
	dbo.prdetail.expiry,
	dbo.prdetail.gcode,
	dbo.prdetail.packqty,   
	dbo.prdetail.looseqty,   
	dbo.prdetail.bonusqty,   
	dbo.prdetail.packunits,   
	dbo.prdetail.prprice,   
	dbo.prdetail.avgprice,
	dbo.prdetail.prutn,
	stock= 0.0000,
	retablelooseqty=0.0000,
	prevretlooseqty=0.0000, 	 
	retablebonusqty=0.0000,
	prevretbonusqty=0.0000, 
	dbo.prdetail.discperc  
FROM 
	dbo.prdetail, dbo.item
WHERE 
	(dbo.prdetail.prinvcode = :r_InvCode)   and  
	( dbo.prdetail.icode = dbo.item.icode )
"
  update="prdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("r_InvCode", number))
)
