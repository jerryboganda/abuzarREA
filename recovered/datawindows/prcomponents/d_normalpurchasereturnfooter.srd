detail(height=348 color="536870912" )
table(column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real (GetText()) <= 100" initial="0" name=discperc dbname="PRLedger.discperc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=flatdisc dbname="PRLedger.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(gettext()) >= 0" initial="0" name=misccharges dbname="PRLedger.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=salestax dbname="PRLedger.salestax"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=purlooseqty dbname="purlooseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=prevretlooseqty dbname="prevretlooseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=purbonusqty dbname="purbonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=prevretbonusqty dbname="prevretbonusqty"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=total dbname="total"  )
 retrieve="  SELECT dbo.prledger.discperc,   
         dbo.prledger.flatdisc,   
         dbo.prledger.misccharges,  
         dbo.prledger.salestax,  
			icode=0,
			stock=0.0000,
			purlooseqty=0.0000,
			prevretlooseqty=0.0000,
			purbonusqty=0.0000,
			prevretbonusqty=0.0000,
			total=0.00
  FROM   dbo.prledger  
  WHERE  dbo.prledger.prinvcode=:ar_PRInvCode  
"
  arguments=(("ar_PRInvCode", number))
)
