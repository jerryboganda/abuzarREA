table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PRLedger.prinvcode"  )
column=(type=long update=yes updatewhereclause=yes name=purinvcode dbname="PRLedger.purinvcode"  )
column=(type=long update=yes updatewhereclause=yes initial="18" name=suppcode dbname="PRLedger.suppcode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=salesmancode dbname="PRLedger.salesmancode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="PRLedger.date"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discperc dbname="PRLedger.discperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=flatdisc dbname="PRLedger.flatdisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=misccharges dbname="PRLedger.misccharges"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=salestax dbname="PRLedger.salestax"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=posted dbname="PRLedger.posted"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=postdate dbname="PRLedger.postdate"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="PRLedger.remarks"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long update=yes updatewhereclause=yes initial="6" name=prcatcode dbname="PRLedger.prcatcode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=purdate dbname="Purledger.date"  )
 retrieve="SELECT  dbo.prledger.prinvcode ,
           dbo.prledger.purinvcode ,
           dbo.prledger.suppcode ,
           dbo.prledger.salesmancode ,
           dbo.prledger.date ,
           dbo.prledger.discperc ,
           dbo.prledger.flatdisc ,
           dbo.prledger.misccharges ,
           dbo.prledger.salestax ,
           dbo.prledger.posted ,
           dbo.prledger.postdate ,
           dbo.prledger.remarks ,
           dbo.users.username ,
           dbo.prledger.prcatcode ,
           dbo.purledger.date     

        FROM dbo.prledger ,
           dbo.users ,
           dbo.purledger     

        WHERE ( dbo.prledger.salesmancode = dbo.users.usercode ) and 
	           ( dbo.prledger.purinvcode = dbo.purledger.purinvcode ) and 
              ( dbo.prledger.prinvcode = :ar_prinvcode )  "
  update="prledger" updatewhere=0 updatekeyinplace=yes
  arguments=(("ar_prinvcode", number))
)
