 retrieve="SELECT  
	purledger.purcatcode ,
	prledger.purinvcode ,
	prledger.prinvcode ,
	prledger.suppcode ,
	prledger.salesmancode ,
	prledger.date ,
	prledger.discperc ,
	prledger.flatdisc ,
	prledger.misccharges ,
	prledger.salestax ,
	prledger.posted ,
	prledger.postdate ,
	prledger.remarks ,
	supplier.address1 ,
	supplier.city ,
	supplier.phone ,
	users.username ,
	prledger.prcatcode ,
	purledger.date ,
	accounts.name,
	dbo.prledger.AccountFor,
	dbo.prledger.PaymentMode,
	dbo.prledger.PaymentAccCode,
	dbo.prledger.Amt,
	dbo.prledger.AmtBy,
	dbo.prledger.AmtDate,
	dbo.prledger.AmtReference,
	dbo.prledger.Outstandingamt,
	dbo.prledger.marked

FROM 
	prledger ,
	supplier ,
	users ,
	purledger ,
	accounts     
WHERE 
	( prledger.suppcode = supplier.suppcode ) and 
	( prledger.salesmancode = users.usercode ) and
	( prledger.purinvcode = purledger.purinvcode ) and 
	( prledger.suppcode = accounts.acccode ) and 
	( ( dbo.prledger.prinvcode = :ar_prinvcode ) )"
  update="prledger" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_prinvcode", number))
)
