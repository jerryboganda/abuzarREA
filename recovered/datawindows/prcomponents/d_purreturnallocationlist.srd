summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="PRAllocationHeader.PRAllocationCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PRAllocationHeader.Date"  )
column=(type=long updatewhereclause=yes name=prinvcode dbname="PRAllocationHeader.PRInvCode"  )
column=(type=long updatewhereclause=yes name=returntype dbname="ReturnType"  )
column=(type=datetime updatewhereclause=yes name=returndate dbname="ReturnDate"  )
column=(type=decimal(2) updatewhereclause=yes name=returnamt dbname="ReturnAmt"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="PRLedger.PurInvCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.Name"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.UserName"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="PRAllocationHeader.Posted"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PRAllocationHeader.PostDate"  )
 retrieve="SELECT
	PRAllocationHeader.PRAllocationCode,   
	PRAllocationHeader.Date,   
	PRAllocationHeader.PRInvCode,   
	ReturnType=PRLedger.PRCatCode,
	ReturnDate=PRLedger.Date, 
	ReturnAmt=PRLedger.InvTotal,
	PRLedger.PurInvCode, 
	Accounts.AliasName, 
	Accounts.Name,
	Users.UserName,
	PRAllocationHeader.Posted, 
	PRAllocationHeader.PostDate

FROM 
	PRAllocationHeader, PRLedger, Accounts, Supplier, Users

WHERE
	PRAllocationHeader.PRInvCode = PRLedger.PRInvCode AND
	PRLedger.SuppCode = Supplier.SuppCode AND
	Supplier.SuppCode = Accounts.AccCode AND
	PRAllocationHeader.UserCode = Users.UserCode

ORDER BY
	PRAllocationHeader.PRAllocationCode"
 )
