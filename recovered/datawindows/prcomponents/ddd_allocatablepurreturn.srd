header(height=132 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=prinvcode dbname="PRInvCode"  )
column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="OutstandingAmt"  )
column=(type=long updatewhereclause=yes name=prcatcode dbname="PRCatCode"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve="SELECT 
	PRInvCode,   
	PurInvCode,   
	Date,   
	SuppCode,   
	Supplier,
	AliasName,
	OutstandingAmt,
	PRCatCode,
	InvTotal
FROM 
	(SELECT 
		PRLedger.PRInvCode,   
		PRLedger.PurInvCode,   
		PRLedger.Date,   
		PRLedger.SuppCode,   
		Supplier=Accounts.Name,
		AliasName=Accounts.AliasName,
		OutstandingAmt = PRLedger.OutstandingAmt + 
			ISNULL((SELECT PRAllocationHeader.PRInvCode FROM PRAllocationHeader 
				WHERE PRAllocationHeader.PRAllocationCode = :Code AND 
					PRAllocationHeader.PRInvCode = PRLedger.PRInvCode), 0),
		PRLedger.PRCatCode,
		PRLedger.InvTotal
	
	FROM 
		PRLedger, Accounts
	WHERE
		PRLedger.AccountFor = 'Y' AND
		PRLedger.Marked = 'N' AND
		PRLedger.Posted ='Y' AND
		PRLedger.SuppCode = Accounts.AccCode) PR
WHERE 
	OutstandingAmt > 0
ORDER BY
	Date,   
	PRInvCode"
  arguments=(("code", number))
)
