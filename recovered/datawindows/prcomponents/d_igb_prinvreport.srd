summary(height=1729 color="536870912" )
footer(height=187 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(20) updatewhereclause=yes name=packingname dbname="ItemPacking.name"  )
column=(type=long updatewhereclause=yes name=prinvcode dbname="PRLedger.prinvcode"  )
column=(type=long updatewhereclause=yes name=prledger_purinvcode dbname="PRLedger.purinvcode"  )
column=(type=datetime updatewhereclause=yes name=prledger_date dbname="PRLedger.date"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="PRLedger.remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=prledger_discperc dbname="PRLedger.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=prledger_misccharges dbname="PRLedger.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=prledger_flatdisc dbname="PRLedger.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=prledger_salestax dbname="PRLedger.salestax"  )
column=(type=long updatewhereclause=yes name=prledger_suppcode dbname="PRLedger.suppcode"  )
column=(type=long updatewhereclause=yes name=icode dbname="PRdetail.icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="PRdetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="PRdetail.expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="PRdetail.packqty"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="PRdetail.looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="PRdetail.bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PRdetail.packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=prprice dbname="PRdetail.prprice"  )
column=(type=decimal(5) updatewhereclause=yes name=prdetail_avgprice dbname="PRdetail.avgprice"  )
column=(type=decimal(2) updatewhereclause=yes name=prdetail_discperc dbname="PRdetail.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="PRdetail.unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="PRdetail.gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="PRLedger.invgstperc1"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=char(60) updatewhereclause=yes name=users dbname="users"  )
column=(type=char(75) updatewhereclause=yes name=alias dbname="alias"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="saleprice"  )
 retrieve="SELECT 	
	itemname= dbo.item.name, 
	dbo.itempacking.name, 
	dbo.prledger.prinvcode,
	dbo.prledger.purinvcode,
	dbo.prledger.date ,  
	dbo.prledger.remarks,
	dbo.prledger.discperc,  
	dbo.prledger.misccharges,  
	dbo.prledger.flatdisc,  
	dbo.prledger.salestax,  
	dbo.prledger.suppcode,  
	dbo.prdetail.icode,  
	dbo.prdetail.batch,  
	dbo.prdetail.expiry,  
	dbo.prdetail.packqty, 
	dbo.prdetail.looseqty, 
	dbo.prdetail.bonusqty, 
	dbo.prdetail.packunits, 
	dbo.prdetail.prprice,   
	dbo.prdetail.avgprice,    
	dbo.prdetail.discperc,   
	dbo.prdetail.unitsalestax,
	dbo.prdetail.gstperc,
	dbo.prledger.invgstperc1,
	SupplierName=dbo.accounts.name,
	users=(SELECT users.username FROM users WHERE usercode=prledger.salesmancode),
	alias=item.customicode,
	saleprice=prdetail.packsaleprice/dbo.prdetail.packunits
FROM
	dbo.prledger,   
	dbo.prdetail,
	dbo.accounts,   
	item
	LEFT OUTER JOIN itempacking ON (dbo.item.packcode = dbo.itempacking.packcode)
WHERE	
	( dbo.prledger.prinvcode = :ra_InvCode ) and 
	( dbo.prledger.prinvcode = dbo.prdetail.prinvcode ) and  
	(dbo.prledger.suppcode = dbo.accounts.acccode) and 
	( prdetail.icode = item.icode )"
  arguments=(("ra_InvCode", number))
)
