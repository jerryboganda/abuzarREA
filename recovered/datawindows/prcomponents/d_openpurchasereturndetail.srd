table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(75) update=yes updatewhereclause=yes name=alternatecustomicode dbname="PRdetail.alternatecustomicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(100) update=yes updatewhereclause=yes name=itemdescription dbname="PRdetail.itemdescription"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PRdetail.prinvcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="PRdetail.icode"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="PRdetail.batch" 
 values=""  )
column=(type=datetime key=yes update=yes updatewhereclause=yes validationmsg="~"Expiry should be greater than today's date~"" name=expiry dbname="PRdetail.expiry"  )
column=(type=long key=yes update=yes updatewhereclause=yes initial="1" name=gcode dbname="PRdetail.gcode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=historicalbatch dbname="PRdetail.HistoricalBatch" 
 values=""  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=packqty dbname="PRdetail.packqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="~"Quantity should be greater than zero~"" initial="1" name=looseqty dbname="PRdetail.looseqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=bonusqty dbname="PRdetail.bonusqty"  )
column=(type=long update=yes updatewhereclause=yes name=packunits dbname="PRdetail.packunits"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="~"Please enter valid value for Total Pieces~"" initial="1" name=totalpieces dbname="PRdetail.TotalPieces"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=piecesinhand dbname="PRdetail.PiecesInHand"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"prprice~"" initial="1" name=prprice dbname="PRdetail.prprice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=avgprice dbname="PRdetail.avgprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=packsaleprice dbname="PRdetail.packsaleprice"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=prutn dbname="PRdetail.prutn"  )
column=(type=decimal(4) updatewhereclause=yes name=retablelooseqty dbname="retablelooseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=prevretlooseqty dbname="prevretlooseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=retablebonusqty dbname="retablebonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=prevretbonusqty dbname="prevretbonusqty"  )
column=(type=decimal(4) updatewhereclause=yes validationmsg="~"stock~"" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=balancestock dbname="balancestock"  )
column=(type=long updatewhereclause=yes initial="0" name=temp_packqty dbname="temp_packqty"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=unitsalestax dbname="PRdetail.unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=gstperc dbname="PRdetail.gstperc"  )
column=(type=long updatewhereclause=yes name=prrowid dbname="PRdetail.PrRowId"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="ManfCode" 
 values=""  )
column=(type=decimal(4) updatewhereclause=yes name=packcapacity dbname="PackCapacity"  )
column=(type=decimal(8) updatewhereclause=yes name=areavolume dbname="AreaVolume"  )
column=(type=decimal(19) updatewhereclause=yes name=pcs dbname="PCS"  )
column=(type=char(17) updatewhereclause=yes name=cartons dbname="Cartons"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real( GetText()) >= 0 AND Real (GetText()) <= 100" validationmsg="~"Disc~"" initial="0" name=discperc dbname="PRdetail.discperc"  )
 retrieve="SELECT
	item.customicode,
	dbo.prdetail.alternatecustomicode,   
	item.name, 
	dbo.prdetail.itemdescription,
	currlistrow = 0,
	packingdesc=item.packingdesc,
	dbo.prdetail.prinvcode,   
	dbo.prdetail.icode,
	dbo.prdetail.batch,
	dbo.prdetail.expiry,
	dbo.prdetail.gcode,
	dbo.prdetail.HistoricalBatch,
	dbo.prdetail.packqty,   
	dbo.prdetail.looseqty,   
	dbo.prdetail.bonusqty,   
	dbo.prdetail.packunits,   
	dbo.prdetail.TotalPieces,
	dbo.prdetail.PiecesInHand,
	dbo.prdetail.prprice,   
	dbo.prdetail.avgprice,  
	dbo.prdetail.packsaleprice,
	dbo.prdetail.prutn,
	retablelooseqty=0.0000,
	prevretlooseqty=0.0000, 	 
	retablebonusqty=0.0000,
	prevretbonusqty=0.0000,  
	stock=0.0000, 
	totalstock=0.0000,
	balancestock=dbo.prdetail.balancestock,
	temp_packqty=0,
	itemtotalval=space(30),
	prdetail.unitsalestax,
	prdetail.gstperc, 
	prdetail.PrRowId,
	ManfCode = dbo.Item.ManfCode,
	PackCapacity = item.PackCapacity,
	AreaVolume = item.AreaVolume,
	PCS=ROUND(prdetail.looseqty / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6),
	Cartons= LTRIM(RTRIM(STR(CAST(((ROUND(prdetail.looseqty / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6)) / CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END) AS INT), 7, 0))) + ' : ' +
		LTRIM(RTRIM(STR(((CAST(ROUND(prdetail.looseqty / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6) AS INT)) % CAST(CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END AS INT)), 7, 0))),
	dbo.prdetail.discperc
FROM 
	dbo.prdetail, dbo.item
WHERE 
	(dbo.prdetail.prinvcode = :r_InvCode)   and  
	( dbo.prdetail.icode = dbo.item.icode )
ORDER By PrRowid
"
  update="prdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("r_InvCode", number))
)
