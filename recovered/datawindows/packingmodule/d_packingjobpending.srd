footer(height=166 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PackingJobPending.PackingJobCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="PackingJobPending.ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="ICatCode"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=long updatewhereclause=yes name=iccode dbname="ICCode"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass"  )
column=(type=long updatewhereclause=yes name=packcode dbname="PackCode"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="ItemPacking"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=qty dbname="PackingJobPending.Qty"  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="PackingJobPending.RowID"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="PackingJobPending.Batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes name=expiry dbname="PackingJobPending.Expiry"  )
column=(type=char(1) updatewhereclause=yes initial="Y" name=selected dbname="Selected" 
 values="	Y/	N"  )
column=(type=char(1) updatewhereclause=yes name=deleteed dbname="Deleteed"  )
 retrieve="SELECT 
	PackingJobPending.PackingJobCode,   
	PackingJobPending.ICode,   
	AliasName=Item.CustomICode,
	ItemName=Item.Name,
	ICatCode=Item.ICatCode,
	ItemCategory = ItemCategory.Name,
	ICCode=Item.ICCode,
	ItemClass = ItemClass.Name,
	PackCode=Item.PackCode,
	ItemPacking = ItemPacking.Name,
	PackingJobPending.Qty,   
	PackingJobPending.RowID,
	PackingJobPending.Batch,
	PackingJobPending.Expiry,
	Selected='Y',
	Deleteed = 'N'
FROM 
	PackingJobPending, 
	Item LEFT OUTER JOIN ItemPacking ON (Item.PackCode = ItemPacking.PackCode), 
	ItemCategory, ItemClass
WHERE 
	PackingJobPending.PackingJobCode = :ai_code AND
	PackingJobPending.ICode = Item.ICode AND
	Item.ICatCode = ItemCategory.ICatCode AND
	Item.ICCode = ItemClass.ICCode
ORDER BY 
	PackingJobPending.RowID
"
  update="PackingJobPending" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
 sort="itemname A, batch A, expiry A"
)
