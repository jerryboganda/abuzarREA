release 12.5;
datawindow ( units=2 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=177 color="536870912" )
summary(height=0 color="536870912" )
footer(height=166 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PackingJobCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=packinglayoutcode dbname="PackingLayoutCode" 
 values=""  )
column=(type=long key=yes update=yes updatewhereclause=yes initial="0" name=caseno dbname="CaseNo"  )
column=(type=long key=yes update=yes updatewhereclause=yes initial="0" name=mastercartonno dbname="MasterCartonNo"  )
column=(type=long key=yes update=yes updatewhereclause=yes initial="0" name=cartonno dbname="CartonNo"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="ICatCode"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=long updatewhereclause=yes name=iccode dbname="ICCode"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass"  )
column=(type=long updatewhereclause=yes name=packcode dbname="PackCode"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="ItemPacking"  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="RowId"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=qty dbname="Qty"  )
 retrieve="SELECT 
	PackingJobCode=PackingJobDetail.PackingJobCode,   
	PackingLayoutCode=PackingJobDetail.PackingLayoutCode,   
	CaseNo=PackingJobDetail.CaseNo,   
	MasterCartonNo=PackingJobDetail.MasterCartonNo,   
	CartonNo=PackingJobDetail.CartonNo,   
	ICode=PackingJobDetail.ICode,
	ItemName=Item.Name,   
	AliasName=Item.CustomICode,   
	ICatCode=Item.ICatCode,
	ItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = Item.ICatCode),
	ICCode=Item.ICCode,
	ItemClass = (SELECT IC.Name FROM ItemClass IC WHERE IC.ICCode = Item.ICCode),
	PackCode=Item.PackCode,
	ItemPacking = (SELECT P.Name FROM ItemPacking P WHERE P.PackCode = Item.PackCode),
	RowId=PackingJobDetail.RowID,   
	Batch = PackingJobDetail.Batch,
	Expiry = PackingJobDetail.Expiry,
	Qty=PackingJobDetail.Qty
FROM 
	PackingJobDetail,   
	Item  
WHERE 
	Item.ICode = PackingJobDetail.ICode and  
	PackingJobDetail.PackingJobCode = :ai_code
ORDER BY 
	PackingJobDetail.PackingJobCode,   
	PackingJobDetail.PackingLayoutCode,
	PackingJobDetail.CaseNo,   
	PackingJobDetail.MasterCartonNo,   
	PackingJobDetail.CartonNo,
	PackingJobDetail.RowID
"
  update="PackingJobDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
