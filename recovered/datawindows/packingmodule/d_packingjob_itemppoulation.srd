release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="ICatCode"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=long updatewhereclause=yes name=iccode dbname="ICCode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass"  )
column=(type=long updatewhereclause=yes name=packcode dbname="PackCode"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="ItemPacking"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
 retrieve="SELECT 
	ICode=D.ICode,
	AliasName=I.CustomICode,
	ItemName=I.Name,
	ICatCode=I.ICatCode,
	ItemCategory=IC.Name,
	ICCode=I.ICCode,
	Batch=D.Batch,
	Expiry=D.Expiry,
	ItemClass=IL.Name, 
	PackCode=I.PackCode,
	ItemPacking=IP.Name,
	Qty=SUM(D.LooseQty + D.BonusQty)
FROM
	SaleLedger S, 
	SaleDetail D, 
	Item I LEFT OUTER JOIN ItemPacking AS IP ON (I.PackCode = IP.PackCode), 
	ItemCategory IC, 
	ItemClass IL
	
WHERE 
	S.SaleInvCode IN (:ai_invcode) AND
	S.SaleInvCode = D.SaleInvCode AND
	D.ICode = I.ICode AND
	I.ICatCode = IC.ICatCode AND
	I.ICCode = IL.ICCode
GROUP BY
	D.ICode,
	D.Batch,
	D.Expiry,
	I.CustomICode,
	I.Name,
	I.ICatCode,
	IC.Name,
	I.ICCode,
	IL.Name,
	I.PackCode,
	IP.Name
ORDER BY
	IC.Name,
	IL.Name,
	IP.Name,
	I.Name,
	Batch,
	Expiry	
		"
  arguments=(("ai_invcode", numberlist))
)
