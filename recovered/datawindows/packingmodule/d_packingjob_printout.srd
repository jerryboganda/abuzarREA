release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1666 color="536870912" )
summary(height=187 color="536870912" )
footer(height=0 color="536870912" )
detail(height=208 color="536870912" )
table(column=(type=long updatewhereclause=yes name=packingjobcode dbname="PackingJobCode"  )
column=(type=long updatewhereclause=yes name=doccode dbname="DocCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=packinglayoutcode dbname="PackingLayoutCode"  )
column=(type=long updatewhereclause=yes name=caseno dbname="CaseNo"  )
column=(type=long updatewhereclause=yes name=mastercartonno dbname="MasterCartonNo"  )
column=(type=long updatewhereclause=yes name=cartonno dbname="CartonNo"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="ICatCode"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=long updatewhereclause=yes name=iccode dbname="ICCode"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass"  )
column=(type=long updatewhereclause=yes name=packcode dbname="PackCode"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="ItemPacking"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowId"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
 retrieve="SELECT
	PackingJobCode=PackingJobDetail.PackingJobCode, 
	DocCode = (SELECT MAX(PJS.DocCode) FROM PackingJobSource PJS WHERE PJS.PackingJobCode = :ai_code),
	Date = PackingJob.Date,
	UserCode = PackingJob.UserCode,
	Remarks = PackingJob.Remarks,
	PackingLayoutCode=PackingJobDetail.PackingLayoutCode,   
	CaseNo=PackingJobDetail.CaseNo,   
	MasterCartonNo=PackingJobDetail.MasterCartonNo,   
	CartonNo=PackingJobDetail.CartonNo,   
	ICode=PackingJobDetail.ICode,   
	ItemName=Item.Name,   
	AliasName=Item.CustomICode,   
	ICatCode=Item.ICatCode,
	ItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = Item.ICatCode),
	ICCode=Item.ICCode,
	ItemClass = (SELECT IC.Name FROM ItemClass IC WHERE IC.ICCode = Item.ICCode),
	PackCode=Item.PackCode,
	ItemPacking = (SELECT P.Name FROM ItemPacking P WHERE P.PackCode = Item.PackCode),
	RowId=PackingJobDetail.RowID,   
	Batch = PackingJobDetail.Batch,
	Expiry = PackingJobDetail.Expiry,
	Qty=PackingJobDetail.Qty
FROM 
	PackingJob,
	PackingJobDetail, 
	Item  
WHERE 
	PackingJob.PackingJobCode = :ai_code AND
	PackingJob.PackingJobCode = PackingJobDetail.PackingJobCode AND
	PackingJobDetail.ICode = Item.ICode

"
  arguments=(("ai_code", number))
 sort="packingjobcode A, packinglayoutcode A, caseno A, mastercartonno A, cartonno A, rowid A"
)
