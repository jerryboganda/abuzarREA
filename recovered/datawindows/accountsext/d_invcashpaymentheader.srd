column=(type=long update=yes updatewhereclause=yes name=postedby dbname="InvLedger.postedby"  )
 retrieve="SELECT  dbo.InvLedger.invvochcode ,
           dbo.InvLedger.acccode ,
           remarks='                                                                               ',
           dbo.InvLedger.invvochcatcode ,
           dbo.InvLedger.salesmancode ,
           dbo.InvLedger.date ,
           dbo.InvLedger.posted ,
           dbo.InvLedger.postdate ,
           dbo.users.username,
			  dbo.InvLedger.originaldate,
    		  dbo.InvLedger.modifiedby,
			  dbo.InvLedger.postedby	      
        FROM dbo.InvLedger ,
           dbo.users     
        WHERE ( dbo.InvLedger.salesmancode = dbo.users.usercode ) and  
         		( dbo.InvLedger.invvochcode = :ar_VoucherCode )    "
  update="InvLedger" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_VoucherCode", number))
)
