column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="InvLedger.posted"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=postdate dbname="InvLedger.postdate"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="InvLedger.remarks"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=originaldate dbname="InvLedger.originaldate"  )
column=(type=long update=yes updatewhereclause=yes name=modifiedby dbname="InvLedger.modifiedby"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="InvLedger.postedby"  )
 retrieve="  SELECT  invledger.invvochcode , 
          invledger.invvochcatcode , 
          invledger.date ,  
          invledger.acccode ,  
          invledger.salesmancode , 
          invledger.posted , 
          invledger.postdate , 
          invledger.remarks ,  
          users.username,
          dbo.invledger.originaldate,
    		 dbo.invledger.modifiedby,
			 dbo.invledger.postedby
 
    FROM  invledger , 
          users    
 
   WHERE ( invledger.invvochcode = :ar_VouchCode ) AND 
			( invledger.salesmancode = users.usercode ) 
"
  update="invledger" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_VouchCode", number))
)
