column=(type=long update=yes updatewhereclause=yes initial="17" name=invvochcatcode dbname="InvLedger.invvochcatcode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="InvLedger.date"  )
column=(type=long update=yes updatewhereclause=yes initial="2" name=acccode dbname="InvLedger.acccode"  )
