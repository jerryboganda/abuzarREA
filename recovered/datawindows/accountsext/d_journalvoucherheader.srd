table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Glheader.glvochcode"  )
column=(type=long update=yes updatewhereclause=yes initial="5" name=vochcatcode dbname="Glheader.vochcatcode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="Glheader.date"  )
column=(type=long update=yes updatewhereclause=yes initial="2" name=acccode dbname="Glheader.acccode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=salesmancode dbname="Glheader.salesmancode"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="Glheader.posted"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=postdate dbname="Glheader.postdate"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Glheader.remarks"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=originaldate dbname="originaldate"  )
column=(type=long update=yes updatewhereclause=yes name=modifiedby dbname="modifiedby"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="postedby"  )
 retrieve="  SELECT  glheader.glvochcode , 
          glheader.vochcatcode , 
          glheader.date ,  
          glheader.acccode ,  
          glheader.salesmancode , 
          glheader.posted , 
          glheader.postdate , 
          glheader.remarks ,  
          users.username,
			 originaldate = dbo.glheader.originaldate,
    		 modifiedby = dbo.glheader.modifiedby,
			 postedby = dbo.glheader.postedby
 
    FROM  glheader , 
          users    
 
   WHERE ( glheader.glvochcode = :ar_VouchCode ) AND 
			( glheader.salesmancode = users.usercode ) 
"
  update="glheader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_VouchCode", number))
)
