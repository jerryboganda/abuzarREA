column=(type=long update=yes updatewhereclause=yes name=postedby dbname="Glheader.postedby"  )
 retrieve="SELECT  dbo.glheader.glvochcode ,
           dbo.glheader.acccode ,
           remarks='                                                                                 ',
           dbo.glheader.vochcatcode ,
           dbo.glheader.salesmancode ,
           dbo.glheader.date ,
           dbo.glheader.posted ,
           dbo.glheader.postdate ,
           dbo.users.username,
			  dbo.glheader.originaldate,
			  dbo.glheader.modifiedby,
				dbo.glheader.postedby				     
        FROM dbo.glheader ,
           dbo.users     
        WHERE ( dbo.glheader.salesmancode = dbo.users.usercode ) and          ( ( dbo.glheader.glvochcode = :ar_VoucherCode ) )   "
  update="glheader" updatewhere=0 updatekeyinplace=yes
  arguments=(("ar_VoucherCode", number))
)
