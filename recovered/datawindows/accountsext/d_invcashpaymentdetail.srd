release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=72 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=acccode dbname="InvDetail.acccode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(GetText()) >= 0" initial="0" name=credit dbname="InvDetail.credit"  )
column=(type=char(20) update=yes updatewhereclause=yes name=chkno dbname="InvDetail.chkno"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="InvDetail.remarks"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="InvDetail.invvochcode"  )
column=(type=long update=yes updatewhereclause=yes name=invcode dbname="InvDetail.invcode"  )
column=(type=long key=yes identity=yes update=yes updatewhereclause=yes name=rowid dbname="InvDetail.RowId"  )
column=(type=long updatewhereclause=yes name=invamt dbname="invamt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) > 0" initial="0" name=debit dbname="InvDetail.debit"  )
 retrieve="  SELECT  dbo.invdetail.acccode ,
			 dbo.invdetail.credit ,
          dbo.invdetail.chkno ,
          dbo.invdetail.remarks ,
          dbo.invdetail.invvochcode ,
          dbo.invdetail.invcode,
			 dbo.invdetail.IDENTITYCOL,
			 invamt = 0,
          dbo.invdetail.debit     

  FROM    dbo.invdetail,
          dbo.invledger      

  WHERE   ( dbo.invledger.invvochcode = :ar_VochCode ) and
          ( dbo.invledger.invvochcode = dbo.invdetail.invvochcode ) and
          ( isnull(dbo.InvDetail.acccode, 0) not in 
							(select dbo.InvLedger.acccode from dbo.InvLedger 
								where dbo.InvLedger.invvochcode = :ar_VochCode))   
"
  update="invdetail" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_VochCode", number))
)
