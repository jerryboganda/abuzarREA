footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=accountsname dbname="AccountsName"  )
column=(type=long updatewhereclause=yes name=invledger_invvochcatcode dbname="InvLedger.invvochcatcode"  )
column=(type=decimal(2) updatewhereclause=yes name=invdetail_debit dbname="InvDetail.Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=invdetail_credit dbname="InvDetail.Credit"  )
column=(type=char(20) updatewhereclause=yes name=invdetail_chkno dbname="InvDetail.ChkNo"  )
column=(type=char(100) updatewhereclause=yes name=invdetail_remarks dbname="InvDetail.Remarks"  )
column=(type=long updatewhereclause=yes name=invdetail_invcode dbname="InvDetail.invcode"  )
column=(type=char(1) updatewhereclause=yes name=invledger_posted dbname="InvLedger.Posted"  )
column=(type=datetime updatewhereclause=yes name=invledger_date dbname="InvLedger.Date"  )
column=(type=char(100) updatewhereclause=yes name=invledger_remarks dbname="InvLedger.Remarks"  )
column=(type=char(30) updatewhereclause=yes name=vochercategory_name dbname="VocherCategory.Name"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.UserName"  )
column=(type=long updatewhereclause=yes name=invledger_invvochcode dbname="InvLedger.invVochCode"  )
column=(type=char(1) updatewhereclause=yes name=creditordebit dbname="CreditorDebit"  )
 retrieve="  SELECT AccountsName = (select accounts.name from accounts 
								where Accounts.AccCode = InvDetail.AccCode),
			invledger.invvochcatcode,   
         invdetail.Debit,   
         invdetail.Credit,   
         invdetail.ChkNo,   
         invdetail.Remarks,
			invdetail.invcode,   
			invledger.Posted,
         invledger.Date,   
         invledger.Remarks,   
         VocherCategory.Name,   
         Users.UserName,   
         invledger.invVochCode,
			CreditorDebit = Case InvDetail.Debit When 0 Then 'C' Else 'D' End
    FROM InvDetail,   
         InvLedger,   
         VocherCategory,   
         Users  
   WHERE ( InvLedger.InvVochCode = InvDetail.InvVochCode ) and  

         ( VocherCategory.VochCatCode = InvLedger.InvVochCatCode ) and  
         ( Users.UserCode = InvLedger.salesmancode ) and  
         ( InvLedger.InvVochCode = :ar_code )    

"
  arguments=(("ar_code", number))
 sort="creditordebit D"
)
