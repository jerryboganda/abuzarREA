header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=code dbname="Glheader.glvochcode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Glheader.date"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="Accounts.name"  )
column=(type=char(1) updatewhereclause=yes name=glheader_posted dbname="Glheader.posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
 retrieve="SELECT  dbo.glheader.glvochcode ,
           dbo.glheader.date ,
           dbo.accounts.name ,
    		dbo.glheader.posted,
			PostedBy = IsNull((Select username from users
										where dbo.glheader.postedby = users.usercode), ''),
			 ModifiedBy = IsNull((Select username from users
										where dbo.glheader.modifiedby = users.usercode), ''),
			Remarks=glheader.remarks
        FROM dbo.glheader ,
           dbo.accounts     
        WHERE ( dbo.glheader.acccode = dbo.accounts.acccode ) and          ( ( dbo.glheader.vochcatcode = 1 ) )  "
 )
