release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=long updatewhereclause=yes name=headercode dbname="HeaderCode"  )
column=(type=long updatewhereclause=yes name=allowed dbname="ALLowed" 
 values="	1/	0"  )
column=(type=long update=yes updatewhereclause=yes name=module dbname="Module"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Godown Priority Must be Greater than Zero ~"" initial="10" name=priority dbname="Priority"  )
 retrieve="SELECT
	GroupCode=GroupAllowedHeader.GroupCode,
	HeaderCode=GroupAllowedHeader.HeaderCode,
	ALLowed=1,
	Module=GroupAllowedHeader.Module,
	Priority=GroupAllowedHeader.Priority
FROM	GroupAllowedHeader
WHERE	GroupAllowedHeader.GroupCode = :ai_GroupCode AND
		GroupAllowedHeader.Module = :ai_Module
ORDER BY GroupAllowedHeader.Priority, GroupAllowedHeader.HeaderCode"
  arguments=(("ai_GroupCode", number), ("ai_Module", number))
)
