release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=304 color="536870912" )
summary(height=76 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saletemplatecode dbname="SaleTemplateCode"  )
column=(type=char(100) updatewhereclause=yes name=template dbname="Template"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=decimal(4) updatewhereclause=yes name=stockqty dbname="StockQty"  )
column=(type=decimal(16) updatewhereclause=yes name=stockvalue dbname="StockValue"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes initial="0" name=value dbname="Value"  )
column=(type=decimal(6) updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Required Sales Value must be Possitive.~"" initial="0" name=requiredvalue dbname="RequiredValue"  )
 retrieve="SELECT 
	SaleTemplateCode=H.SaleTemplateCode, 
	Template = H.Name,
	GroupCode = G.GroupCode,
	GroupName = G.GroupName,
	StockQty = ISNULL(
		(SELECT SUM(GD.CurrQty) 
		FROM GodownDetail GD, Item II,
			(SELECT GroupCode = ManfCode, GroupName = Name
			FROM Manufacturer
			WHERE :as_group = 'M' 
			UNION ALL
			SELECT GroupCode = ICatCode, GroupName = Name
			FROM ItemCategory
			WHERE :as_group = 'C' 
			UNION ALL
			SELECT GroupCode = ICCode, GroupName = Name
			FROM ItemClass
			WHERE :as_group = 'L' 
			UNION ALL
			SELECT GroupCode = PackCode, GroupName = Name
			FROM ItemPacking
			WHERE :as_group = 'P' ) GG
		WHERE GD.ICode = II.ICode AND 	
			G.GroupCode = 
			CASE :as_group 
				WHEN 'M' THEN II.ManfCode 
				WHEN 'C' THEN II.ICatCode 
				WHEN 'L' THEN II.ICCode 
				ELSE II.PackCode END AND 
			GG.GroupCode = G.GroupCode), 0),
	StockValue = ISNULL(
		(SELECT SUM(GD.CurrQty * ROUND(II.SalePrice / CASE WHEN II.PackUnits > 0 THEN II.PackUnits ELSE 1 END, 2)) 
		FROM GodownDetail GD, Item II,
			(SELECT GroupCode = ManfCode, GroupName = Name
			FROM Manufacturer
			WHERE :as_group = 'M' 
			UNION ALL
			SELECT GroupCode = ICatCode, GroupName = Name
			FROM ItemCategory
			WHERE :as_group = 'C' 
			UNION ALL
			SELECT GroupCode = ICCode, GroupName = Name
			FROM ItemClass
			WHERE :as_group = 'L' 
			UNION ALL
			SELECT GroupCode = PackCode, GroupName = Name
			FROM ItemPacking
			WHERE :as_group = 'P' ) GG
		WHERE GD.ICode = II.ICode AND 	
			G.GroupCode = 
			CASE :as_group 
				WHEN 'M' THEN II.ManfCode 
				WHEN 'C' THEN II.ICatCode 
				WHEN 'L' THEN II.ICCode 
				ELSE II.PackCode END AND 
			GG.GroupCode = G.GroupCode), 0),
	Qty = SUM(D.LooseQty),
	Value = Round(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2),
	RequiredValue = Round(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2)
FROM 
	SaleTemplateHeader H, 
	(SELECT STD.SaleTemplateCode, STD.ICode, STD.LooseQty, STD.BonusQty, STD.SalePrice, STD.DiscPerc, STD.ItemFlatDisc, STD.MArked
	FROM SaleTemplateDetail STD 
	WHERE STD.SaleTemplateCode = :ai_templatecode
	UNION ALL
	SELECT SaleTemplateCode=:ai_templatecode, Item.ICode, LooseQty=0, BonusQty=0, 
		SalePrice=Round(Item.SalePrice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2), 
		DiscPerc=0, ItemFlatDisc=0, MArked='Y'
	FROM Item
	WHERE :ai_format = 2) D,
	Item I,
	(SELECT GroupCode = NULL, GroupName = 'NONE'
	UNION ALL
	SELECT GroupCode = ManfCode, GroupName = Name
	FROM Manufacturer
	WHERE :as_group = 'M' 
	UNION ALL
	SELECT GroupCode = ICatCode, GroupName = Name
	FROM ItemCategory
	WHERE :as_group = 'C' 
	UNION ALL
	SELECT GroupCode = ICCode, GroupName = Name
	FROM ItemClass
	WHERE :as_group = 'L' 
	UNION ALL
	SELECT GroupCode = PackCode, GroupName = Name
	FROM ItemPacking
	WHERE :as_group = 'P' ) G
WHERE 
	H.SaleTemplateCode = :ai_templatecode AND
	H.SaleTemplateCode = D.SaleTemplateCode AND
	D.Marked = 'Y' AND
	D.ICode = I.ICode AND
	G.GroupCode = 
		CASE :as_group 
			WHEN 'M' THEN I.ManfCode 
			WHEN 'C' THEN I.ICatCode 
			WHEN 'L' THEN I.ICCode 
			ELSE I.PackCode END
GROUP BY
	H.SaleTemplateCode,
	H.Name,
	G.GroupCode,
	G.GroupName
ORDER BY 
	GroupName"
  arguments=(("as_group", string), ("ai_templatecode", number), ("ai_format", number))
 sort="groupname A"
)
