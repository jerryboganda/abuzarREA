release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=488 color="536870912" )
summary(height=76 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=template dbname="Template"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=value dbname="Value"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="SalesTax"  )
column=(type=decimal(6) updatewhereclause=yes name=total dbname="Total"  )
 retrieve="SELECT 
	Template = H.Name,
	GroupCode = G.GroupCode,
	GroupName = G.GroupName,
	Qty = SUM(D.LooseQty),
	Value = Round(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2),
	SalesTax = ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + 
		(D.LooseQty * D.UnitSalestax) ), 2),
	Total = ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2) +
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + 
				(D.LooseQty * D.UnitSalestax) ), 2)
FROM 
	SaleTemplateHeader H, 
	SaleTemplateDetail D,
	Item I,
	(SELECT GroupCode = NULL, GroupName = 'NONE'
	UNION ALL
	SELECT GroupCode = ManfCode, GroupName = Name
	FROM Manufacturer
	WHERE :as_group = 'M' 
	UNION ALL
	SELECT GroupCode = ICatCode, GroupName = Name
	FROM ItemCategory
	WHERE :as_group = 'C' 
	UNION ALL
	SELECT GroupCode = ICCode, GroupName = Name
	FROM ItemClass
	WHERE :as_group = 'L' 
	UNION ALL
	SELECT GroupCode = PackCode, GroupName = Name
	FROM ItemPacking
	WHERE :as_group = 'P' ) G
WHERE 
	H.SaleTemplateCode = :ai_templatecode AND
	H.SaleTemplateCode = D.SaleTemplateCode AND
	D.Marked = 'Y' AND
	D.ICode = I.ICode AND
	G.GroupCode = 
		CASE :as_group 
			WHEN 'M' THEN I.ManfCode 
			WHEN 'C' THEN I.ICatCode 
			WHEN 'L' THEN I.ICCode 
			ELSE I.PackCode END
GROUP BY
	H.Name,
	G.GroupCode,
	G.GroupName
ORDER BY 
	GroupName"
  arguments=(("as_group", string), ("ai_templatecode", number))
 sort="groupname A"
)
