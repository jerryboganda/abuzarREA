 values="	Y/	N"  )
column=(type=char(150) updatewhereclause=yes name=rightname dbname="Rightsclone.RightName"  )
column=(type=char(60) updatewhereclause=yes name=menuname dbname="Rightsclone.MenuName"  )
column=(type=long updatewhereclause=yes name=levelindex dbname="Rightsclone.LevelIndex"  )
column=(type=char(30) updatewhereclause=yes name=indicesstring dbname="Rightsclone.IndicesString"  )
column=(type=long updatewhereclause=yes name=rightcatcode dbname="Rightsclone.RightCatCode"  )
column=(type=char(1) updatewhereclause=yes name=object dbname="Rightsclone.Object"  )
 retrieve="  SELECT RightCode , 
			'',  
         RightName ,
			MenuName ,
			LevelIndex , 
			IndicesString , 
			RightCatCode,
			Object
        
  FROM RightsClone   

  Order By RightsClone.RightName


"
  sort="rightname A, indicesstring A"
)
