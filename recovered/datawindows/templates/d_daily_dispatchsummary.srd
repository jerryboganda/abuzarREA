release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1666 color="536870912" )
summary(height=302 color="536870912" )
footer(height=0 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dispcode dbname="DispatchHeader.DispCode"  )
column=(type=char(30) updatewhereclause=yes name=biltyno dbname="DispatchHeader.BiltyNo"  )
column=(type=char(60) updatewhereclause=yes name=agency dbname="GoodsCompany.name"  )
column=(type=decimal(0) updatewhereclause=yes name=cartons dbname="DispatchHeader.Cartons"  )
column=(type=decimal(10) updatewhereclause=yes name=saleinvamt dbname="saleinvamt"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="DispatchDetail.SaleInvCode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Accounts.name"  )
column=(type=datetime updatewhereclause=yes name=date dbname="DispatchHeader.date"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=builtyexpenses dbname="DispatchHeader.BuiltyExpenses"  )
 retrieve="SELECT   DispatchHeader.DispCode,   
         DispatchHeader.BiltyNo,   
         goodscompany.name,   
         DispatchHeader.Cartons, 
			saleinvamt = Round(Sum ( (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc )) *  (1 - dbo.saledetail.discperc /100) * (1 - dbo.saleledger.discperc /100)) + dbo.saleledger.misccharges  - dbo.saleledger.flatdisc, 0), 
			DispatchDetail.SaleInvCode,
         accounts.name,
         DispatchHeader.date,
			remarks=max(dispatchheader.remarks),
			DispatchHeader.BuiltyExpenses
 
    FROM DispatchHeader,
			dbo.DispatchDetail, 
		 	dbo.saledetail,   
         dbo.saleledger ,
			goodscompany,
         accounts

   WHERE ( DispatchHeader.date >= :ad_startdate ) and  
         ( DispatchHeader.date <= :ad_enddate )   and
			( DispatchHeader.DispCode = dbo.DispatchDetail.DispCode) and
			( dbo.saleledger.saleinvcode  = dbo.DispatchDetail.SaleInvCode) and
	 		( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and
			( dbo.goodscompany.GCcode = DispatchHeader.GCCode ) and
			( DispatchHeader.custCode = dbo.accounts.accCode)

GROUP BY DispatchHeader.DispCode,    
         DispatchHeader.BiltyNo,   
			DispatchHeader.BuiltyExpenses,
         goodscompany.name,
         DispatchHeader.date,
         accounts.name,   
         DispatchHeader.Cartons, 
	 		DispatchDetail.saleinvcode,   
	 		dbo.saleledger.misccharges,   
         dbo.saleledger.flatdisc,   
	 		dbo.saleledger.discperc   

"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime))
)
