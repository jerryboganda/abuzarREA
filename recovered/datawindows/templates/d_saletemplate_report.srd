release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=500 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1052 color="536870912" )
summary(height=333 color="536870912" )
footer(height=0 color="536870912" )
detail(height=156 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=currlistrow dbname="currlistrow"  )
column=(type=char(100) updatewhereclause=yes name=saletemplateheader_name dbname="SaleTemplateHeader.name"  )
column=(type=long updatewhereclause=yes name=saletemplatedetail_saletemplatecode dbname="SaleTemplateDetail.saletemplatecode"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="SaleTemplateDetail.rowid"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="SaleTemplateDetail.looseqty"  )
 retrieve="  SELECT itemname = item.name,
		 	currlistrow = 0,
			saletemplateheader.name,
			saletemplatedetail.saletemplatecode,
		 	saleprice = saletemplatedetail.saleprice,
         saletemplatedetail.rowid,
         saletemplatedetail.looseqty 

    FROM saletemplateheader,
			saletemplatedetail,   
         item 

   WHERE ( dbo.saletemplateheader.saletemplatecode = :ra_InvCode ) AND
			( dbo.saletemplateheader.saletemplatecode = dbo.saletemplatedetail.saletemplatecode) AND
		 	( saletemplatedetail.icode = item.icode ) 
"
  arguments=(("ra_InvCode", number))
)
