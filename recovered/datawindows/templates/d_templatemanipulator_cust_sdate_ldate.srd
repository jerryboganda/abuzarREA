release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80269524 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=148 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=saledate dbname="SaleDate"  )
column=(type=long updatewhereclause=yes name=salecatcode dbname="SaleCatCode" 
 values="Cash//Retail	3/Credit Sale	2/"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode" 
 values=""  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=long updatewhereclause=yes name=count dbname="Count"  )
column=(type=long updatewhereclause=yes name=unmarkedcount dbname="UnMarkedCount"  )
column=(type=char(1) updatewhereclause=yes name=marked dbname="Marked" 
 values="	Y/	N"  )
 retrieve="SELECT 
	SaleInvCode=D.SaleInvCode, 
	SaleDate=D.SaleDate, 
	SaleCatCode=D.SaleCatCode, 
	CustCode=D.CustCode,
	SaleValue=ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2) +
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + 
				(D.LooseQty * D.UnitSalestax) ), 2),
	Count=ISNULL((SELECT Count(T.ICode) FROM SaleTemplateDetail T WHERE T.SaleTemplateCode=:ai_code AND T.SaleInvCode = D.SaleInvCode), 0),
	UnMarkedCount=ISNULL((SELECT Count(T.ICode) FROM SaleTemplateDetail T WHERE T.SaleTemplateCode=:ai_code AND Marked='N' AND T.SaleInvCode = D.SaleInvCode), 0),
	Marked=D.Marked
FROM
	SaleTemplateDetail D
WHERE 
	D.SaleTemplateCode = :ai_code AND
	D.CustCode = CASE WHEN :ai_custcode IS NULL THEN D.CustCode ELSE :ai_custcode END AND
	D.SaleDate BETWEEN :adt_StartDate AND :adt_EndDate AND
	D.Marked='Y'	
GROUP BY
	D.SaleInvCode, 
	D.SaleDate, 
	D.SaleCatCode, 
	D.CustCode,
	D.Marked
ORDER BY
	SaleInvCode"
  arguments=(("ai_code", number), ("ai_custcode", number), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="saleinvcode A"
)
