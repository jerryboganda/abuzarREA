summary(height=0 color="536870912" )
footer(height=68 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="saletemplatecode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(13) updatewhereclause=yes name=retailprice dbname="retailprice"  )
column=(type=decimal(2) updatewhereclause=yes name=recentpurprice dbname="recentpurprice"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="rowid"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real( GetText() ) >= 0" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real( GetText() ) >= 0" name=discperc dbname="discperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real( GetText() ) >= 0" name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real( GetText() ) >= 0" name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real( GetText() ) >= 0" name=gstperc dbname="gstperc"  )
column=(type=long update=yes updatewhereclause=yes validation="Integer( GetText() ) >= 1" initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real( GetText() ) >= 0" validationmsg="~"Please enter valid bonus qty~"" initial="0" name=bonusqty dbname="bonusqty"  )
column=(type=long update=yes updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=saledate dbname="SaleDate"  )
column=(type=long update=yes updatewhereclause=yes name=custcode dbname="CustCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=salecatcode dbname="SaleCatCode"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=marked dbname="Marked" 
 values="Yes	Y/No	N/"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real ( GetText() ) >= 1" initial="1" name=qty dbname="looseqty"  )
 retrieve="SELECT 
	GroupCode = G.GroupCode,
	GroupName = G.GroupName,
	saletemplatedetail.saletemplatecode,
	fullcode = item.customicode,
	itemname = item.name,
	currlistrow = 0,
	stock     = 0.0000,
	totalstock= isnull((select sum(gd.currqty) from godowndetail gd where gd.icode=item.icode), 0), 
	purprice=item.purprice,
	retailprice=Round(item.retailprice / case when saletemplatedetail.packunits > 0 then saletemplatedetail.packunits else 1 end, 2),
	recentpurprice=item.recentpurprice,
	avgprice=item.avgprice,
	itemtotalval=space(30),
	saletemplatedetail.icode,
	saletemplatedetail.rowid,
	saletemplatedetail.Remarks,
	saletemplatedetail.saleprice,
	saletemplatedetail.discperc,
	saletemplatedetail.itemflatdisc,
	saletemplatedetail.unitsalestax,	
	saletemplatedetail.gstperc,
	saletemplatedetail.packunits,
	saletemplatedetail.bonusqty,
	saletemplatedetail.SaleInvCode,
	saletemplatedetail.SaleDate,
	saletemplatedetail.CustCode,
	saletemplatedetail.SaleCatCode,
	Marked=saletemplatedetail.Marked,
	itemcode = 0,
	saletemplatedetail.looseqty 
FROM 
	saletemplatedetail,   
	item ,
	(SELECT GroupCode = NULL, GroupName = 'NONE'
	UNION ALL
	SELECT GroupCode = ManfCode, GroupName = Name
	FROM Manufacturer
	WHERE :as_group = 'M' 
	UNION ALL
	SELECT GroupCode = ICatCode, GroupName = Name
	FROM ItemCategory
	WHERE :as_group = 'C' 
	UNION ALL
	SELECT GroupCode = ICCode, GroupName = Name
	FROM ItemClass
	WHERE :as_group = 'L' 
	UNION ALL
	SELECT GroupCode = PackCode, GroupName = Name
	FROM ItemPacking
	WHERE :as_group = 'P' ) G
WHERE 
	( dbo.saletemplatedetail.saletemplatecode = :ar_SaleInvCode ) AND 
	( saletemplatedetail.icode = item.icode ) AND
	( G.GroupCode = 
		CASE :as_group 
			WHEN 'M' THEN Item.ManfCode 
			WHEN 'C' THEN Item.ICatCode 
			WHEN 'L' THEN Item.ICCode 
			ELSE Item.PackCode END)
"
  update="saletemplatedetail" updatewhere=0 updatekeyinplace=yes
  arguments=(("as_group", string), ("ar_SaleInvCode", number))
 sort="groupname A, saleinvcode A, rowid A"
)
