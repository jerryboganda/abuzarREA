 retrieve="Select customer.custcode ,
		 customer.custcatcode ,
       customer.areacode,
		 customer.subareacode,
		 customer.crlimit,
		 customer.dayslimit,
       customer.address1 ,
  		 customer.city ,
       customer.phone 
 
 FROM CUSTOMER"
  update="CUSTOMER" updatewhere=1 updatekeyinplace=yes
 )
