table(column=(type=long key=yes update=yes updatewhereclause=yes name=groupcode dbname="GroupAllowedHeader.GroupCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=headercode dbname="GroupAllowedHeader.HeaderCode"  )
column=(type=long updatewhereclause=yes name=allowed dbname="Allowed"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=module dbname="GroupAllowedHeader.Module"  )
column=(type=long update=yes updatewhereclause=yes name=priority dbname="GroupAllowedHeader.Priority"  )
 retrieve="SELECT
	GroupAllowedHeader.GroupCode,
	GroupAllowedHeader.HeaderCode,
	Allowed=1,
	GroupAllowedHeader.Module,
	GroupAllowedHeader.Priority
FROM	GroupAllowedHeader
WHERE	GroupAllowedHeader.GroupCode = :ai_GroupCode
ORDER BY Module, HeaderCode"
  update="GroupAllowedHeader" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_groupcode", number))
)
