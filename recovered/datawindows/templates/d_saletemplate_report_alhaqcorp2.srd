release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=500 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1197 color="536870912" )
summary(height=31 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(150) updatewhereclause=yes name=genericname dbname="GenericName"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=long updatewhereclause=yes name=manufcode dbname="manufcode"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=currlistrow dbname="currlistrow"  )
column=(type=char(100) updatewhereclause=yes name=templatename dbname="templatename"  )
column=(type=long updatewhereclause=yes name=saletemplatedetail_saletemplatecode dbname="SaleTemplateDetail.saletemplatecode"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(13) updatewhereclause=yes name=retailprice dbname="retailprice"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="SaleTemplateDetail.rowid"  )
column=(type=long updatewhereclause=yes name=looseqty dbname="SaleTemplateDetail.looseqty"  )
 retrieve="SELECT 
	itemname = item.name,
	aliasname= item.customicode,
	GenericName= (SELECT GenericItem.name from GenericItem WHERE item.GenericCode = GenericItem.GenericCode),
	packing= (SELECT itempacking.name from itempacking WHERE item.packcode = itempacking.packcode),
	manufacturer = manufacturer.name,
	manufcode=item.manfcode,
	packingdesc= item.packingdesc,
	headerno = saletemplateheader.headerno,
	remarks = saletemplatedetail.remarks,
	currlistrow = 0,
	templatename=saletemplateheader.name,
	saletemplatedetail.saletemplatecode,
	saleprice = saletemplatedetail.saleprice,
	retailprice = Round(item.retailprice / case when item.packunits > 0 THEN item.packunits ELSE 1 END, 2),
	saletemplatedetail.rowid,
	saletemplatedetail.looseqty 
FROM 
	saletemplateheader,
	saletemplatedetail,   
	item,
	manufacturer
WHERE 
	( dbo.saletemplateheader.saletemplatecode = :ra_InvCode ) AND
	( dbo.saletemplateheader.saletemplatecode = dbo.saletemplatedetail.saletemplatecode) AND
	( saletemplatedetail.icode = item.icode )  AND
	( item.manfcode = manufacturer.manfcode )
ORDER BY
	itemname"
  arguments=(("ra_InvCode", number))
 sort="genericname A, itemname A"
)
group(level=1 header.height=187 trailer.height=0 by=("genericname"  ) header.color="536870912" trailer.color="536870912" )
