release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1416 color="536870912" )
summary(height=270 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=template dbname="Template"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long updatewhereclause=yes name=cashsalecount dbname="CashSaleCount"  )
column=(type=decimal(6) updatewhereclause=yes name=cashsaleamt dbname="CashSaleAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=cashsaletax dbname="CashSaleTax"  )
column=(type=long updatewhereclause=yes name=creditsalecount dbname="CreditSaleCount"  )
column=(type=decimal(6) updatewhereclause=yes name=creditsaleamt dbname="CreditSaleAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=creditsaletax dbname="CreditSaleTax"  )
column=(type=long updatewhereclause=yes name=totalsalecount dbname="TotalSaleCount"  )
column=(type=decimal(6) updatewhereclause=yes name=totalsaleamt dbname="TotalSaleAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=totalsaletax dbname="TotalSaleTax"  )
 retrieve="SELECT 
	Template = H.Name, 
	CustCode=D.CustCode,
	AliasName = (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = D.CustCode),
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = D.CustCode),
	CashSaleCount = CASE WHEN D.SaleCatCode = 3 THEN COUNT(DISTINCT D.SaleInvCode) ELSE 0 END,
	CashSaleAmt = CASE WHEN D.SaleCatCode = 3 THEN ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2) +
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + 
				(D.LooseQty * D.UnitSalestax) ), 2) ELSE 0 END,
	CashSaleTax = CASE WHEN D.SaleCatCode = 3 THEN ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + 
				(D.LooseQty * D.UnitSalestax) ), 2) ELSE 0 END,
	CreditSaleCount = CASE WHEN D.SaleCatCode = 3 THEN 0 ELSE COUNT(DISTINCT D.SaleInvCode) END,
	CreditSaleAmt = CASE WHEN D.SaleCatCode = 3 THEN 0 ELSE ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2) +
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + 
				(D.LooseQty * D.UnitSalestax) ), 2) END,
	CreditSaleTax = CASE WHEN D.SaleCatCode = 3 THEN 0 ELSE ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + 
				(D.LooseQty * D.UnitSalestax) ), 2) END,
	TotalSaleCount = COUNT(DISTINCT D.SaleInvCode),
	TotalSaleAmt = ROUND(SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)), 2) +
		ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + 
				(D.LooseQty * D.UnitSalestax) ), 2),
	TotalSaleTax = ROUND(SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) + 
				(D.LooseQty * D.UnitSalestax) ), 2)
FROM 
	SaleTemplateHeader H, SaleTemplateDetail D
WHERE
	H.SaleTemplateCode IN (:ai_code) AND 
	H.SaleTemplateCode = D.SaleTemplateCode AND
	D.Marked='Y'
GROUP BY
	H.Name,
	D.CustCode,
	D.SaleCatCode
ORDER BY 
	Customer"
  arguments=(("ai_code", number))
)
