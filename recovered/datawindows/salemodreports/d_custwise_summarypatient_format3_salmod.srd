table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="patientcode"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=cp dbname="Customer.cp"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Customer.address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Customer.address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="Customer.city"  )
column=(type=decimal(6) updatewhereclause=yes name=netamount dbname="netamount"  )
column=(type=long updatewhereclause=yes name=salereturn dbname="salereturn"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
column=(type=char(60) updatewhereclause=yes name=designation dbname="designation"  )
column=(type=char(60) updatewhereclause=yes name=relation dbname="Relation"  )
 retrieve="SELECT invcode     = dbo.saleledgermodified.saleinvcode,     
         date        = CASE lower(:as_datetype) 
									 When 'originaldate' Then dbo.saleledgermodified.originaldate 
									 When 'lastsavingdate' Then dbo.saleledgermodified.date
									 When 'billingdate' Then dbo.saleledgermodified.billingdate
							  END	,    
			patientcode = Max(dbo.saleledgermodified.patientcode),
         dbo.accounts.name, 
			dbo.customer.cp,
			dbo.customer.address1,
			dbo.customer.address2,
			dbo.customer.city,
			netamount = 
					Round(
					SUM((saledetailmodified.looseqty*(saledetailmodified.saleprice - saledetailmodified.itemflatdisc)) *
						(1 - (.01 * saledetailmodified.discperc))) * (1- (.01 * saleledgermodified.discperc)) + 
							saleledgermodified.misccharges + saleledgermodified.salestax - saleledgermodified.flatdisc, 0)
					+
					Round(
					SUM( (saledetailmodified.looseqty + saledetailmodified.bonusqty) * saledetailmodified.unitsalestax) + 
					SUM(ROUND( (saledetailmodified.looseqty * 
								  (saledetailmodified.saleprice - saledetailmodified.itemflatdisc)) *
								  (1 - (.01 * saledetailmodified.discperc)) * saledetailmodified.gstperc * .01, 2)) +
						 ROUND( (SUM((saledetailmodified.looseqty * 
								(saledetailmodified.saleprice - saledetailmodified.itemflatdisc)) *
								(1 - (.01 * saledetailmodified.discperc))) * (1- (.01 * saleledgermodified.discperc)) -
								saleledgermodified.flatdisc) * (saleledgermodified.invgstperc1 * .01), 2), 0),
			salereturn = (Select count(*) From SrLedger Where dbo.saleledgermodified.saleinvcode = dbo.srledger.saleinvcode ),
			regno = dbo.Patient.RegNo,
			patientname = Patient.name,
			designation = (Select dbo.rank.name From dbo.Patient, dbo.Rank Where dbo.saleledgermodified.patientcode = dbo.patient.patientcode AND dbo.patient.rankcode = dbo.rank.rankcode),
			Relation    = (Select dbo.relation.name From dbo.Relation Where dbo.saleledgermodified.relationcode = dbo.relation.relationcode)

    FROM dbo.saleledgermodified, 
         dbo.saledetailmodified,   
         dbo.accounts, 
			dbo.customer,
			dbo.Patient	

   WHERE dbo.saleledgermodified.saleinvcode = dbo.saledetailmodified.saleinvcode and  
			CASE lower(:as_datetype) 
				When 'originaldate' Then dbo.saleledgermodified.originaldate 
				When 'lastsavingdate' Then dbo.saleledgermodified.date
				When 'billingdate' Then dbo.saleledgermodified.billingdate
			END
				Between :ad_StartDate and :ad_EndDate and
			dbo.saleledgermodified.salecatcode IN (1, 2, 3) and
			dbo.saleledgermodified.custcode  = :al_CustCode and 
         dbo.saleledgermodified.custcode = dbo.accounts.acccode and	
         dbo.customer.custcode = dbo.saleledgermodified.custcode and
		   dbo.saleledgermodified.patientcode = dbo.patient.patientcode

GROUP BY dbo.saleledgermodified.saleinvcode,   
			CASE lower(:as_datetype) 
				When 'originaldate' Then dbo.saleledgermodified.originaldate 
				When 'lastsavingdate' Then dbo.saleledgermodified.date
				When 'billingdate' Then dbo.saleledgermodified.billingdate
			END,   
			dbo.saleledgermodified.misccharges,   
         dbo.saleledgermodified.flatdisc,   
         dbo.saleledgermodified.discperc,  
			dbo.saleledgermodified.salestax, 
			dbo.saleledgermodified.invgstperc1,
			dbo.saleledgermodified.salecatcode, 
			dbo.saleledgermodified.patientcode,
			dbo.Patient.RegNo,
			dbo.Patient.Name,
			dbo.saleledgermodified.custrefno,	 
			dbo.saleledgermodified.remarks,
			dbo.saleledgermodified.relationcode,
			dbo.accounts.name,	
			dbo.customer.cp,
			dbo.customer.address1,
			dbo.customer.address2,
			dbo.customer.city
         
ORDER BY dbo.saleledgermodified.saleinvcode ASC,   
        date ASC   

"
  arguments=(("al_Custcode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_caption", string), ("as_datetype", string), ("ai_supressheader", number))
 sort="patientname A, date A"
)
