compute(name=compute_4 visible="1	0" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="700" tooltip.enabled="0" tooltip.isbubble="0" tooltip.textcolor="134217751" tooltip.backcolor="134217752" tooltip.icon="0" tooltip.maxwidth="0" tooltip.transparency="0" tooltip.delay.visible="32000" tooltip.delay.initial="0" tooltip.hasclosebutton="0" transparency="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.length="100" background.gradient.repetition.count="0" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" color="0" x="2011" y="192" height="64" width="183" format="[GENERAL]" expression="sum((((  looseqty   *  price  ) - (itemflatdisc* looseqty))  *  ( 1 -  (    itemdiscperc * .01 )  )  -  (  salestax   *  looseqty ))  *  invdiscperc  * 0.01 for all)" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
