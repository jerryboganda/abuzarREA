table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="CustRefNo"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=char(30) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Person"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
 retrieve="SELECT saleinvcode = dbo.saleledgermodified.saleinvcode,     
       date = dbo.saleledgermodified.date,   
       invdiscperc = dbo.saleledgermodified.discperc,    
       flatdisc = dbo.saleledgermodified.flatdisc,    
       misccharges = dbo.saleledgermodified.misccharges, 
       invsalestax = dbo.saleledgermodified.salestax,
		 CustRefNo   = dbo.saleledgermodified.CustRefNo,
		 remarks     = dbo.saleledgermodified.Remarks,
		 looseqty = dbo.saledetailmodified.looseqty, 
		 packing=case 
						when dbo.item.packcode IS Null then space(30) 
						else dbo.itempacking.name
					end,
       itemflatdisc=saledetailmodified.itemflatdisc,
       packqty  = saledetailmodified.packqty,  
       price = dbo.saledetailmodified.saleprice,    
       itemdiscperc = dbo.saledetailmodified.discperc,    
		 packunits = dbo.saledetailmodified.packunits,    
		 batch = dbo.saledetailmodified.batch,    
		 expiry = dbo.saledetailmodified.expiry,    
		 salestax  = saledetailmodified.salestax,
	 	 itemname = item.name,
		 datestring = Rtrim(LTrim(Str(DatePart(dd, saleledgermodified.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledgermodified.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledgermodified.date)))), 
		 Person = dbo.accounts.name,
       patient=(select name from patient where  patientcode=:ai_patientcode),
		 regno = (select regno from patient where  patientcode=:ai_patientcode)

FROM 	 dbo.saleledgermodified, 
		 dbo.saledetailmodified,    
		dbo.item
		LEFT OUTER JOIN dbo.itempacking ON (dbo.item.packcode = dbo.itempacking.packcode),
		 dbo.accounts

WHERE  dbo.saleledgermodified.date >= :ad_StartDate and
		 dbo.saleledgermodified.date <= :ad_EndDate  and
		 dbo.saleledgermodified.salecatcode IN (1, 2, 3) and
		 dbo.saleledgermodified.patientcode = :ai_patientcode and
		 dbo.saleledgermodified.saleinvcode = dbo.saledetailmodified.saleinvcode and  
		 dbo.saledetailmodified.icode = item.icode and 
		 dbo.saleledgermodified.custcode = dbo.accounts.acccode

"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_patientcode", number))
 sort="patient A, regno A, saleinvcode A, date A, itemname A, batch A, expiry A"
)
