table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=manufacurer dbname="manufacurer"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="itempacking"  )
column=(type=char(1) updatewhereclause=yes name=claim dbname="claim"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
 retrieve="SELECT itemname = item.name, 
		 manufacurer = (dbo.manufacturer.name),
		 itempacking = dbo.itempacking.name,
		 claim = Max(dbo.saledetailmodified.claimable),			
		 looseqty = Sum (dbo.saledetailmodified.looseqty),
		 price = Max (dbo.saledetailmodified.saleprice)
		  
FROM 	 dbo.saleledgermodified, 
		 dbo.saledetailmodified,    
		 dbo.item, 
		 dbo.itempacking,
		 dbo.Customer, 
		 dbo.Manufacturer 

WHERE  CASE lower(:as_datetype) 
		 	When 'originaldate' Then dbo.saleledgermodified.originaldate 
			When 'lastsavingdate' Then dbo.saleledgermodified.date
			When 'billingdate' Then dbo.saleledgermodified.billingdate
  		 End Between :ad_startdate AND :ad_enddate AND
		 dbo.saleledgermodified.custcode IN (:al_custcode) AND
		 dbo.saleledgermodified.salecatcode IN (1, 2, 3) AND
		 dbo.saleledgermodified.saleinvcode = dbo.saledetailmodified.saleinvcode AND
		 dbo.saledetailmodified.icode = item.icode AND
		 dbo.item.packcode = dbo.itempacking.packcode AND
		 dbo.saleledgermodified.custcode = dbo.customer.custcode AND
		 dbo.Item.manfcode = dbo.manufacturer.manfcode

Group by 
		dbo.saledetailmodified.icode,
		dbo.item.name,
		dbo.manufacturer.name,
		dbo.itempacking.name

order by 
		itemname
"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_contactperson", string), ("as_address1", string), ("as_address2", string), ("as_city", string), ("as_line1", string), ("as_line2", string), ("as_displayheader", string), ("as_datetype", string))
 sort="c_itemname A"
)
