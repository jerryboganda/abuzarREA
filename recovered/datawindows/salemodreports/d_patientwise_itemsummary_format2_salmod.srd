table(column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=rank dbname="rank"  )
column=(type=char(60) updatewhereclause=yes name=unit dbname="unit"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=unitprice dbname="unitprice"  )
column=(type=char(100) updatewhereclause=yes name=itemname dbname="itemname"  )
 retrieve="SELECT  
		 patient = Max(patient.name) ,
		 regno = Max(patient.regno) ,
		 rank = Max(rank.name), 
		 unit = Max(unit.name),
	    looseqty = Sum(saledetailmodified.looseqty),
       unitprice = Max(SaleDetailmodified.saleprice),
       itemname=(CASE max(SaleDetailmodified.SaleItemDescription) WHEN NULL THEN item.name ELSE max(SaleDetailmodified.SaleItemDescription) END)

FROM 	 dbo.saleledgermodified, 
		 dbo.saledetailmodified,    
		 dbo.item,
   	 dbo.patient,
		 dbo.rank,
		 dbo.unit 

WHERE  dbo.saleledgermodified.date >= :ad_startdate AND
		 dbo.saleledgermodified.date <= :ad_enddate  AND
		 dbo.saleledgermodified.patientcode = dbo.patient.patientcode AND
		 dbo.patient.patientcode = :ai_patientcode AND
		 dbo.patient.rankcode = dbo.rank.rankcode AND
		 dbo.patient.unitcode = dbo.unit.unitcode AND
		 dbo.saleledgermodified.saleinvcode = dbo.saledetailmodified.saleinvcode AND  
		 dbo.saledetailmodified.icode = item.icode 

GROUP BY dbo.item.name

"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_patientcode", number), ("adt_admitdate", datetime), ("adt_dischargedate", datetime), ("as_adno", string), ("adt_Issuedate", datetime), ("ad_discperc", number))
)
