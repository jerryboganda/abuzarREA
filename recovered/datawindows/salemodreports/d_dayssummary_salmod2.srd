table(column=(type=char(60) updatewhereclause=yes name=custname dbname="Custname"  )
column=(type=datetime updatewhereclause=yes name=saledate dbname="saledate"  )
column=(type=long updatewhereclause=yes name=day dbname="day"  )
column=(type=long updatewhereclause=yes name=invcode dbname="Invcode"  )
column=(type=decimal(6) updatewhereclause=yes name=grossamount dbname="GrossAmount"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="MiscCharges"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(6) updatewhereclause=yes name=invvalue dbname="InvValue"  )
column=(type=decimal(6) updatewhereclause=yes name=salestaxamount dbname="salestaxamount"  )
column=(type=decimal(6) updatewhereclause=yes name=netamount dbname="netamount"  )
column=(type=long updatewhereclause=yes name=count dbname="count"  )
column=(type=long updatewhereclause=yes name=srretval dbname="SrRetVal"  )
 retrieve="SELECT Custname = accounts.name,
		 saledate=max(SL.date),
		 day=datepart(dy,SL.date),
		 Invcode=  SL.saleinvcode , 
		 GrossAmount=SUM(SD.looseqty * SD.saleprice),
		 MiscCharges=MAX(SL.MiscCharges),
		 Discount=MAX(SL.FlatDisc)+ sum(SD.looseqty*SD.itemflatdisc)+sum(SD.looseqty*(SD.saleprice - SD.itemflatdisc)*SD.discperc*0.01) + sum(((SD.looseqty*(SD.saleprice - SD.itemflatDisc))*(1 - SD.discperc*0.01))*SL.discperc*0.01) ,
 		 InvValue=  Case when Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) - flatdisc   +   misccharges), 0) IS NULL Then 0  Else Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc   +   misccharges, 0) End ,
		 salestaxamount=Round(Sum (Round (  SD.looseqty *   SD.unitsalestax + Round ( Round (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc ) * (1 -   SD.discperc * 0.01 ), 2 ) *   SD.gstperc * 0.01 , 2 ) , 2 ) )
							 +  (Case when (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) - flatdisc), 2)) * SL.invgstperc1 * 0.01 IS NULL Then 0  Else (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc ,2) ) * SL.invgstperc1 * 0.01 End ), 0),
		 netamount= Case when Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) - flatdisc   +   misccharges), 2) IS NULL Then 0  Else Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc   +   misccharges, 0) End 
						+
						Round(Sum (Round (  SD.looseqty *   SD.unitsalestax + Round ( Round (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc ) * (1 -   SD.discperc * 0.01 ), 2 ) *   SD.gstperc * 0.01 , 2 ) , 2 ) )
							 +  (Case when (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) - flatdisc), 2)) * SL.invgstperc1 * 0.01 IS NULL Then 0  Else (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc ,2) ) * SL.invgstperc1 * 0.01 End ), 0),

		 count=1,
		 SrRetVal=0

    FROM saleledgermodified SL,
		 	saledetailmodified SD,   
         accounts  
   WHERE 
			( SL.custcode IN (:al_custcode)  ) and
			( SL.date between :ad_StartDate and :ad_EndDate) and   
			( SL.saleinvcode = SD.saleinvcode )AND
         ( SL.custcode = accounts.acccode ) 
         

GROUP BY 
		accounts.name,
		datepart(dy,SL.date),
		 SL.saleinvcode,
		 SL.flatdisc,
		 SL.misccharges,
       SL.discperc,
		 SL.invgstperc1
order by datepart(dy,SL.date)
		 
         
		 


	     "
  arguments=(("al_custcode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number))
 sort="custname A, saledate A"
)
