table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="GLDocument.GLVochCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=rowid dbname="GLDocument.ROWID"  )
column=(type=char(100) update=yes updatewhereclause=yes name=documenttype dbname="GLDocument.DocumentType"  )
column=(type=char(100) update=yes updatewhereclause=yes name=docdescription dbname="GLDocument.DocDescription"  )
 retrieve="SELECT 
	GLDocument.GLVochCode,   
	GLDocument.ROWID,   
	GLDocument.DocumentType,   
	GLDocument.DocDescription  
FROM 
	GLDocument  
WHERE 
	GLDocument.GLVochCode = :ai_code   
ORDER BY 
	GLDocument.ROWID ASC   
"
  update="GLDocument" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
