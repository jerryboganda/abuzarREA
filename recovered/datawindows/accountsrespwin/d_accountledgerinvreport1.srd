table(column=(type=long updatewhereclause=yes name=status dbname="Status"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=char(100) updatewhereclause=yes name=summaryaccount dbname="SummaryAccount"  )
column=(type=long updatewhereclause=yes name=code dbname="code1"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date1"  )
column=(type=char(28) updatewhereclause=yes name=type dbname="name2"  )
column=(type=char(60) updatewhereclause=yes name=account dbname="name1"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="name5"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="value1"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="value2"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="name3"  )
column=(type=char(60) updatewhereclause=yes name=subaccount dbname="name4"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=long updatewhereclause=yes name=roworder dbname="RowOrder"  )
 retrieve="SELECT
	Status = 0,
	InvoiceCode=V.InvoiceCode,
	SummaryAccount=ISNULL((SELECT MAX(SA.Name)
			FROM SummaryAccount SA, SummaryAccountDetail SD 
			WHERE SD.AccCode = :acccode AND 
				SD.SummaryAccCode = SA.SummaryAccCode), A.Name),
	code1 = V.AccCode,
	date1 = V.date,  
	name2 = V.documenttype + '-' + RTrim(LTrim(convert(char(7), V.documentcode))), 
	name1 = A.name,		
	name5 = A.AliasName,		
	value1= V.Debit,
	value2= V.Credit,
	name3 = V.Remarks,
	name4 = S.name,
	CheckNo = V.CheckNo,
	RowOrder=V.VRow
FROM 
	VirtualGL V, Accounts A, SubAccounts S, 
	(SELECT AccCode FROM udf_GetSummaryAccountList(:acccode) UNION SELECT :acccode) L
WHERE 
	L.AccCode = A.AccCode AND 
	(V.AccCode = A.AccCode OR V.AlternateAccCode = A.AccCode) AND 
	A.restricted='N' AND
	A.SubCode = S.SubAccCode
UNION ALL
SELECT
	Status = 0,
	InvoiceCode=V.InvoiceCode,
	SummaryAccount=ISNULL((SELECT MAX(SA.Name)
			FROM SummaryAccount SA, SummaryAccountDetail SD 
			WHERE SD.AccCode = :acccode AND 
				SD.SummaryAccCode = SA.SummaryAccCode), A.Name),
	code1 = V.AccCode, 
	date1 = V.date, 
	name2 = V.documenttype + '-' + RTrim(LTrim(convert(char(7), V.documentcode))), 
	name1 = A.name,		
	name5 = A.AliasName,		
	value1= V.Credit,
	value2= V.Debit,
	name3 = Case debit 
			When 0 then 'Cash Paid Against Sale Ret. # '
			Else 'Cash Received Against Sales Inv. # '
			End + RTrim(LTrim(convert(char(6), V.documentcode))),
	name4 = S.name,
	CheckNo = V.CheckNo,
	RowOrder=V.VRow
FROM 
	VirtualGL V, Accounts A, SubAccounts S, 
	(SELECT AccCode FROM udf_GetSummaryAccountList(:acccode) UNION SELECT :acccode) L
WHERE 
	L.AccCode = A.AccCode AND 
	V.AlternateAccCode = A.AccCode AND 
	A.restricted='N' AND
	A.SubCode = S.SubAccCode
UNION ALL
SELECT
	Status = 1,
	InvoiceCode=SL.SaleInvCode,
	SummaryAccount=ISNULL((SELECT MAX(SA.Name)
			FROM SummaryAccount SA, SummaryAccountDetail SD 
			WHERE SD.AccCode = :acccode AND 
				SD.SummaryAccCode = SA.SummaryAccCode), A.Name),
	code1 = SL.CustCode, 
	date1 = SL.date, 
	name2 = '*SV-' + RTrim(LTrim(convert(char(7), SL.SaleInvCode))), 
	name1 = A.name,		
	name5 = A.AliasName,		
	value1= SL.InvTotal,
	value2= 0.00,
	name3 = SL.Remarks,
	name4 = S.name,
	CheckNo = NULL,
	RowOrder=1
FROM 
	SaleLedger SL, Accounts A, SubAccounts S, 
	(SELECT AccCode FROM udf_GetSummaryAccountList(:acccode) UNION SELECT :acccode) L
WHERE 
	SL.Posted = 'N' AND
	L.AccCode = SL.CustCode AND
	SL.CustCode = A.AccCode AND
	A.restricted='N' AND
	A.SubCode = S.SubAccCode
UNION ALL
SELECT
	Status = 1,
	InvoiceCode=SL.PurInvCode,
	SummaryAccount=ISNULL((SELECT MAX(SA.Name)
			FROM SummaryAccount SA, SummaryAccountDetail SD 
			WHERE SD.AccCode = :acccode AND 
				SD.SummaryAccCode = SA.SummaryAccCode), A.Name),
	code1 = SL.SuppCode, 
	date1 = SL.date, 
	name2 = '*PV-' + RTrim(LTrim(convert(char(7), SL.PurInvCode))), 
	name1 = A.name,		
	name5 = A.AliasName,		
	value1= 0.00,
	value2= SL.InvTotal,
	name3 = SL.Remarks,
	name4 = S.name,
	CheckNo = NULL,
	RowOrder=1
FROM 
	PurLedger SL, Accounts A, SubAccounts S, 
	(SELECT AccCode FROM udf_GetSummaryAccountList(:acccode) UNION SELECT :acccode) L
WHERE 
	SL.Posted = 'N' AND
	L.AccCode = SL.SuppCode AND
	SL.SuppCode = A.AccCode AND
	A.restricted='N' AND
	A.SubCode = S.SubAccCode
UNION ALL
SELECT
	Status = 1,
	InvoiceCode=N.NoteCode,
	SummaryAccount=ISNULL((SELECT MAX(SA.Name)
			FROM SummaryAccount SA, SummaryAccountDetail SD 
			WHERE SD.AccCode = :acccode AND 
				SD.SummaryAccCode = SA.SummaryAccCode), A.Name),
	code1 = N.AccCode, 
	date1 = N.duedate,
	name2 = Case N.NoteCatCode When 1 Then '*NR' Else '*NP' End + '-' + RTrim(LTrim(convert(char(6), N.NoteCode))),
	name1 = A.name,		
	name5 = A.AliasName,		
	value1= Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = A.AccCode THEN 0 ELSE N.Amount END ELSE CASE WHEN N.AccCode = A.AccCode THEN N.Amount ELSE 0 END END,
	value2= Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = A.AccCode THEN N.Amount ELSE 0 END ELSE CASE WHEN N.AccCode = A.AccCode THEN 0 ELSE N.Amount END END,
	name3 = N.Remarks,
	name4 = S.name,
	CheckNo = LEFT(N.DocumentNumber, 20),
	RowOrder=1
FROM 
	Notes N, Accounts A, SubAccounts S, 
	(SELECT AccCode FROM udf_GetSummaryAccountList(:acccode) UNION SELECT :acccode) L
WHERE 
	N.Posted = 'N' AND N.Finalized = 'Y' AND
	(N.AccCode = A.AccCode OR N.BankAccCode = A.AccCode ) and
	L.AccCode = A.AccCode AND
	A.SubCode = S.SubAccCode
UNION ALL
SELECT
	Status = 1,
	InvoiceCode=H.VoucherCode,
	SummaryAccount=ISNULL((SELECT MAX(SA.Name)
			FROM SummaryAccount SA, SummaryAccountDetail SD 
			WHERE SD.AccCode = :acccode AND 
				SD.SummaryAccCode = SA.SummaryAccCode), A.Name),
	code1 = D.AccCode, 
	date1 = H.Date,
	name2 = '*' + (SELECT VC.ShortName FROM VocherCategory VC WHERE VC.VochCatCode = H.VochCatCode) + '-' + RTrim(LTrim(convert(char(6), H.GLVochCode))),
	name1 = A.name,		
	name5 = A.AliasName,		
	value1= Case When D.Debit > 0 Then D.Debit ELSE 0 END,
	value2= Case When D.Credit > 0 Then D.Credit ELSE 0 END,
	name3 = H.Remarks,
	name4 = S.name,
	CheckNo = LEFT(D.ChkNo, 20),
	RowOrder=D.GLRowID
FROM 
	GLHeader H, GLDetail D, Accounts A, SubAccounts S, 
	(SELECT AccCode FROM udf_GetSummaryAccountList(:acccode) UNION SELECT :acccode) L
WHERE 
	H.Posted = 'N' AND 
	H.GLVochCode = D.GLVochCode AND
	D.AccCode = A.AccCode AND
	L.AccCode = A.AccCode AND
	A.SubCode = S.SubAccCode
ORDER BY 
	Status,
	SummaryAccount,
	Date, 
	Name2, 
	RowOrder,
	Name1, 
	Name5, 
	Debit, 
	Credit"
  arguments=(("AccCode", number))
)
