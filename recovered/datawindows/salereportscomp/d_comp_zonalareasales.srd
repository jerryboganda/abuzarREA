release 12.5;
datawindow ( units=0 timer_interval=60000 processing=5 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=1 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=408 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=2296 color="536870912"  height.autosize=yes)
table(column=(type=char(10) updatewhereclause=yes name=a dbname="a"  )
 unbound = "yes"
  arguments=(("ar_zonecode", number), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_list", string))
)
compute(name=compute_16 band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-14" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" x="37" y="20" height="72" width="1829" format="[GENERAL]" expression="~"Zonal Sales Area Wise~"" alignment="0" border="0" crosstab.repeat=no )
compute(name=c_companyname band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="41" y="112" height="64" width="3054" format="[GENERAL]" expression="f_ReportHeaderInfo('clientname')" alignment="0" border="0" crosstab.repeat=no )
compute(name=c_address1 band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="41" y="188" height="64" width="3054" format="[GENERAL]" expression="f_ReportHeaderInfo('address1')" alignment="0" border="0" crosstab.repeat=no )
compute(name=c_address2 band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="37" y="260" height="64" width="3054" format="[GENERAL]" expression="f_ReportHeaderInfo('address2')" alignment="0" border="0" crosstab.repeat=no )
text(name=t_1 band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" alignment="0" border="0" x="37" y="340" height="64" width="3054" text="	~"Report Date:~" + string(today()) + Space(5) + ~"From :~" +  STRING(ar_startdate ) + Space(5) + ~"To :~" +  STRING(ar_enddate )" )
compute(name=compute_11 band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="1888" y="20" height="72" width="1207" format="[GENERAL]" expression="'Page ' + page() + ':' + pageAcross() + ' of ' + pageCount() + ':' + pageCountAcross()" alignment="0" border="0" crosstab.repeat=no )
