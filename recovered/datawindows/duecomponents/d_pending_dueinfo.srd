release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1458 color="536870912" )
summary(height=375 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=groupname dbname="groupname"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="groupcode"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(75) updatewhereclause=yes name=alisaname dbname="Alisaname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=dueqty dbname="dueqty"  )
column=(type=decimal(4) updatewhereclause=yes name=satisfyqty dbname="satisfyqty"  )
column=(type=decimal(4) updatewhereclause=yes name=pendingdue dbname="pendingdue"  )
 retrieve="SELECT
	groupname=A.groupname,
	groupcode=A.groupcode,
	icode=A.icode,
	Alisaname=max(A.aliasname),
	itemname=A.itemname,
	dueqty=ISNULL(sum(A.dueqty),0),
	satisfyqty=ISNULL(SUM(A.satisfiedqty),0),
	pendingdue=ISNULL(sum(A.dueqty),0) - ISNULL(SUM(A.satisfiedqty),0)
	
FROM

(
		SELECT  
			groupcode = 	case :ar_grouptype 
								when 'P' then max(I.packcode)
								when 'C' THEN max(I.icatcode)
								when 'L' THEN max(I.iccode)
								when 'M' THEN max(I.manfcode)  end,
			groupname = 	case :ar_grouptype 
								when 'P' then (SELECT P.Name FROM ItemPacking P WHERE P.PackCode = max(I.packcode))
								when 'C' THEN (SELECT C.Name FROM ItemCategory C WHERE C.ICatCode = max(I.icatcode)) 
								when 'L' THEN (SELECT L.Name FROM ItemClass L WHERE L.ICCode = max(I.iccode) )
								when 'M' THEN (SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = max(I.manfcode)) end,
			icode=SD.icode,
			itemname=I.name,
			Aliasname=max(I.customicode),
			dueqty=sum(SD.looseqty),
			satisfiedqty=(	select isnull(SUM(DSD.duesatisfyqty),0)
								from  duesatisfyheader DSH, duesatisfydetail DSD
								where 	DSH.saleinvcode=SL.saleinvcode and
											DSH.duesatisfycode=DSD.duesatisfycode and
											DSD.icode=SD.icode
								group by 	DSH.saleinvcode,
														DSD.icode	),
			pendingdue=0,
			Category=(select name from itemcategory where itemcategory.icatcode=max(I.icatcode))
		
		FROM SaleLedger SL, Saledetail SD, Item I
		WHERE 	SL.date>=:ar_StartDate  AND
					SL.date<=:ar_EndDate AND
					SL.saleinvcode=SD.saleinvcode AND
					SD.Due in ('D', 'X', 'S') and  
					SD.icode=I.icode AND
					case :ar_grouptype 
						when 'P' then I.packcode
						when 'C' THEN I.icatcode
						when 'L' THEN I.iccode
						when 'M' THEN I.manfcode  end  IN (:ar_groupcode) 
		GROUP BY
			SL.saleinvcode,
			SD.icode,
			I.name			)  AS A


GROUP BY groupname,
				groupcode,
				A.itemname,
				A.icode

ORDER BY
	groupname,
	itemname







"
  arguments=(("ar_grouptype", string), ("ar_groupcode", numberlist), ("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
