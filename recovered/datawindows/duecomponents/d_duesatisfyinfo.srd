release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1520 color="536870912" )
summary(height=218 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="code"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=datetime updatewhereclause=yes name=saledate dbname="saledate"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=quantity dbname="quantity"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="godown"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="DueSatisfyDetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="DueSatisfyDetail.expiry"  )
column=(type=decimal(13) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="icatcode"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="category"  )
 retrieve="SELECT 
	code=dbo.duesatisfyheader.duesatisfycode,
	saleinvcode=dbo.duesatisfyheader.saleinvcode, 
	date		=dbo.duesatisfyheader.duesatisfydate,
	saledate	=(select date from dbo.saleledger  
				where saleinvcode = dbo.duesatisfyheader.saleinvcode),
	customer	=(select name from dbo.accounts  
			  where acccode =
				(select custcode from dbo.saleledger 
			  	where saleinvcode = dbo.duesatisfyheader.saleinvcode)),
	itemname = dbo.item.name, 
	quantity = dbo.duesatisfydetail.duesatisfyqty, 
	godown=(select name from dbo.godown where gcode = dbo.duesatisfydetail.gcode),
	dbo.duesatisfydetail.batch, 
	dbo.duesatisfydetail.expiry,
	rate=Round(dbo.duesatisfydetail.packsaleprice/CASE dbo.duesatisfydetail.packunits WHEN 0 THEN 1 ELSE dbo.duesatisfydetail.packunits END, 2),
	username = dbo.users.username,
	icatcode = dbo.item.icatcode,
	category = dbo.itemcategory.name
FROM 
	dbo.duesatisfyheader,
	dbo.duesatisfydetail,
	dbo.item, 
	dbo.users,
	dbo.itemcategory 
WHERE 
	( dbo.duesatisfyheader.duesatisfydate between :ar_StartDate and :ar_EndDate) and
	( dbo.duesatisfyheader.duesatisfycode = dbo.duesatisfydetail.duesatisfycode ) and  
	( dbo.duesatisfydetail.icode = dbo.item.icode ) and
	( dbo.item.icatcode = dbo.itemcategory.icatcode) and
	( dbo.itemcategory.icatcode IN (:ar_icatcode)) and
	( dbo.duesatisfyheader.usercode = dbo.users.usercode )
ORDER BY 
	dbo.itemcategory.name,
	dbo.item.icatcode,
	dbo.duesatisfyheader.duesatisfydate,
	dbo.item.name,
	dbo.item.icode
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_icatcode", numberlist))
)
