 retrieve="SELECT 
	DueSatisfyDetail.DueSatisfyCode,   
	DueSatisfyDetail.ICode,   
	DueSatisfyDetail.GCode,   
	DueSatisfyDetail.Batch,   
	DueSatisfyDetail.Expiry,   
	DueSatisfyDetail.BalanceStock,
	DueSatisfyDetail.DueSatisfyQty,
	DueSatisfyDetail.AvgPrice,
	DueSatisfyDetail.DueSatisfyUtn,
	DueSatisfyDetail.SaleRowId,
	packsaleprice=0.00,
	packunits=1,
	stock = 0.0000,
	totalstock = 0.0000 
FROM 
	DueSatisfyDetail

"
  update="DueSatisfyDetail" updatewhere=1 updatekeyinplace=yes
 )
