table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="DueSatisfyDetail.DueSatisfyCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="DueSatisfyDetail.ICode" 
 values=""  )
column=(type=long key=yes update=yes updatewhereclause=yes initial="1" name=gcode dbname="DueSatisfyDetail.GCode"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="DueSatisfyDetail.Batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes name=expiry dbname="DueSatisfyDetail.Expiry"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=salerowid dbname="DueSatisfyDetail.SaleRowId"  )
column=(type=decimal(4) updatewhereclause=yes name=totalsatisfyqty dbname="totalsatisfyqty"  )
column=(type=decimal(4) updatewhereclause=yes name=duedelete dbname="DueDelete" 
 values="	1/	0/"  )
column=(type=decimal(4) updatewhereclause=yes name=dueqty dbname="DueQty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="'Due Satisfy Quantity must greater than zero'" initial="1" name=duesatisfyqty dbname="DueSatisfyDetail.DueSatisfyQty"  )
 retrieve="SELECT 
	DueSatisfyDetail.DueSatisfyCode,   
	DueSatisfyDetail.ICode,   
	DueSatisfyDetail.GCode,   
	DueSatisfyDetail.Batch,   
	DueSatisfyDetail.Expiry,
	DueSatisfyDetail.SaleRowId,
	totalsatisfyqty = 0.0000,  
	DueDelete = 0.0000,
	DueQty = (select looseqty from saledetail
				 where saleinvcode = (Select saleinvcode from DueSatisfyHeader
												where DueSatisfyHeader.DueSatisfyCode = :ar_DueSatisfyCode )And
						 saledetail.icode = DueSatisfyDetail.icode and 
						 saledetail.RowId = DueSatisfyDetail.SaleRowId and
						 saledetail.due In ('D', 'S', 'X')),
	DueSatisfyDetail.DueSatisfyQty
FROM 
	DueSatisfyDetail  
WHERE 
	DueSatisfyDetail.DueSatisfyCode = :ar_DueSatisfyCode    
"
  update="DueSatisfyDetail" updatewhere=0 updatekeyinplace=yes
  arguments=(("ar_DueSatisfyCode", number))
)
