table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="DueSatisfyHeader.DueSatisfyCode"  )
column=(type=long update=yes updatewhereclause=yes name=saleinvcode dbname="DueSatisfyHeader.SaleInvCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=duesatisfydate dbname="DueSatisfyHeader.DueSatisfyDate"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="DueSatisfyHeader.UserCode"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="Salesman"  )
column=(type=long update=yes updatewhereclause=yes name=dueadjcode dbname="DueSatisfyHeader.DueAdjCode"  )
 retrieve="  SELECT DueSatisfyHeader.DueSatisfyCode,   
         DueSatisfyHeader.SaleInvCode,   
         DueSatisfyHeader.DueSatisfyDate,   
        	DueSatisfyHeader.UserCode,  
			Salesman = users.username,
			DueSatisfyHeader.DueAdjCode
    FROM DueSatisfyHeader,   
         users  
   WHERE ( DueSatisfyHeader.DueSatisfyCode = :ar_duesatisfycode) and  
         ( users.usercode = DueSatisfyHeader.UserCode ) 

"
  update="DueSatisfyHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_duesatisfycode", number))
)
