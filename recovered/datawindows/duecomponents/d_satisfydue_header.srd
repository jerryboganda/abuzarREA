table(column=(type=long update=yes updatewhereclause=yes initial="2" name=salecatcode dbname="SaleLedger.salecatcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SaleLedger.saleinvcode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=salesmancode dbname="SaleLedger.salesmancode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="SaleLedger.date"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=posted dbname="SaleLedger.posted"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=postdate dbname="SaleLedger.postdate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discperc dbname="SaleLedger.discperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=flatdisc dbname="SaleLedger.flatdisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=misccharges dbname="SaleLedger.misccharges"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=salestax dbname="SaleLedger.salestax"  )
column=(type=long update=yes updatewhereclause=yes name=custcode dbname="SaleLedger.custcode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="SaleLedger.remarks"  )
column=(type=char(30) update=yes updatewhereclause=yes name=saleledger_custrefno dbname="SaleLedger.custrefno"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Customer.address1"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="Customer.city"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Customer.phone"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
 retrieve="  SELECT  saleledger.salecatcode ,  
          saleledger.saleinvcode , 
          saleledger.salesmancode ,  
          saleledger.date , 
          users.username , 
          saleledger.posted , 
          saleledger.postdate , 
          saleledger.discperc , 
          saleledger.flatdisc , 
          saleledger.misccharges , 
          saleledger.salestax , 
          saleledger.custcode , 
          saleledger.remarks , 
          saleledger.custrefno , 
          customer.address1 , 
          customer.city , 
          customer.phone ,
		  accounts.name
   
    FROM  customer , 
          saleledger , 
          users , 
          accounts  
   
   WHERE ( saleledger.custcode = customer.custcode ) and 
         ( users.usercode = saleledger.salesmancode ) and 
         ( saleledger.custcode = accounts.acccode ) and 
         ( ( dbo.saleledger.saleinvcode = :ar_SaleInvCode ) )   "
  update="saleledger" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_SaleInvCode", number))
)
