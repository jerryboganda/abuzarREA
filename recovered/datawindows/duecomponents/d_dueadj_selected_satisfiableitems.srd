summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleLedger.SaleInvcode"  )
column=(type=long updatewhereclause=yes name=icode dbname="Saledetail.icode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes name=gcode dbname="Saledetail.gcode"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="Saledetail.RowId"  )
column=(type=decimal(4) updatewhereclause=yes name=dueqty dbname="Saledetail.looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=satisfiedqty dbname="SatisfiedQty"  )
 retrieve="Select Sl.SaleInvcode, Sd.icode, i.name, Sd.gcode, Sd.RowId, Sd.looseqty,
		 SatisfiedQty = IsNull ( (select sum(dsd.duesatisfyqty) from duesatisfyheader dsh, duesatisfydetail dsd where dsh.saleinvcode = sl.saleinvcode And dsh.duesatisfycode = dsd.duesatisfycode And dsd.icode = sd.icode And dsd.salerowid = sd.rowid )  ,  0  )
From   SaleLedger Sl, SaleDetail Sd , item i 
Where  sl.saleinvcode = sd.saleinvcode And  
	    sl.Posted = 'Y'  And
	    sl.Date Between :ad_startdate  And :ad_enddate And
	    sd.icode = i.icode And
	    sd.Due = 'D' AND
		CASE :as_group
		WHEN 'M' THEN I.ManfCode 
		WHEN 'C' THEN I.ICatCode 
		WHEN 'L' THEN I.ICCode 
		ELSE I.PackCode END IN (:ai_groupcode)
Order By Sl.saleinvcode, i.name"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("as_group", string), ("ai_groupcode", numberlist))
)
