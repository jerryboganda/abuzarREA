header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Saledetail.saleinvcode"  )
column=(type=char(1) updatewhereclause=yes name=due dbname="Saledetail.due"  )
column=(type=datetime updatewhereclause=yes name=saleledger_date dbname="SaleLedger.date"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=char(1) updatewhereclause=yes name=satisfied dbname="Satisfied"  )
 retrieve="  SELECT distinct saledetail.saleinvcode,   
         saledetail.due,   
         saleledger.date,   
         accounts.name ,
			Satisfied = Case saledetail.due When 'D' Then 'N' 
													  When 'S' Then 'Y'
							End
    FROM saledetail,   
         saleledger,   
         accounts  
   WHERE ( saleledger.saleinvcode = saledetail.saleinvcode ) and  
         ( saleledger.custcode = accounts.acccode ) and  
         ( ( saledetail.due in ('D','S') ) )    
"
 )
