release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=1 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=288 color="536870912" )
summary(height=132 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Saledetail.ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=godown dbname="Godown" 
 values=""  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=decimal(4) updatewhereclause=yes name=dueqty dbname="DueQty"  )
column=(type=decimal(4) updatewhereclause=yes name=satisfiedqty dbname="SatisfiedQty"  )
 retrieve="SELECT 
	SaleInvCode = SL.SaleInvcode, 
	Date = SL.Date,
	SD.ICode, 
	AliasName = I.CustomICode,
	ItemName = I.Name, 
	Godown = SD.GCode, 
	RowID=SD.RowID, 
	DueQty = SD.LooseQty,
	SatisfiedQty = 
		ISNULL(
			(SELECT SUM(DSD.DueSatisfyQty) 
			FROM DueSatisfyHeader DSH, DueSatisfyDetail DSD 
			WHERE DSH.SaleInvCode = SL.SaleInvCode AND 
				DSH.DueSatisfyCode = DSD.DueSatisfyCode AND 
				DSD.ICode = SD.ICode AND
				DSD.SaleRowID = SD.RowID), 0)
FROM
	SaleLedger SL, 
	SaleDetail SD, 
	Item I 
WHERE
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.Posted = 'Y'  AND
	SD.ICode = :ai_icode AND
	SD.ICode = I.ICode AND
	SD.Due = 'D' 
ORDER BY 
	SL.SaleInvCode, 
	I.Name"
  arguments=(("ai_icode", number))
 sort="date A"
 filter="(dueqty - satisfiedqty) > 0"
 )
compute(name=compute_3 visible="1" band=background font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="219" y="80" height="64" width="2354" format="[GENERAL]" expression="'Item Name: ' + ItemName" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
