release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1458 color="536870912" )
summary(height=218 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=groupcode dbname="groupcode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="groupname"  )
column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=char(9) updatewhereclause=yes name=status dbname="status"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=decimal(4) updatewhereclause=yes name=quantity dbname="quantity"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
 retrieve="SELECT
	groupcode = 	case :ar_grouptype 
		when 'P' then item.packcode
		when 'C' THEN item.icatcode
		when 'L' THEN item.iccode
		when 'M' THEN item.manfcode  end,
	groupname = 	case :ar_grouptype 
		when 'P' then (SELECT P.Name FROM ItemPacking P WHERE P.PackCode = item.packcode)
		when 'C' THEN (SELECT C.Name FROM ItemCategory C WHERE C.ICatCode = item.icatcode) 
		when 'L' THEN (SELECT L.Name FROM ItemClass L WHERE L.ICCode = item.iccode) 
		when 'M' THEN (SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = item.manfcode) end,
	invcode     = dbo.saleledger.saleinvcode,
	date        = dbo.saleledger.date,
	itemname    = dbo.item.name, 
	aliasname=item.customicode,
	dbo.accounts.name, 
	status = Case	When dbo.saledetail.Due = 'D' Then 'Due'
			When dbo.saledetail.Due = 'X' Then 'Deleted' 
			When dbo.saledetail.Due = 'S' Then 'Satisfied' 
			End, 
	rate = dbo.saledetail.rate, 
	quantity = dbo.saledetail.looseqty, 
	salesman = dbo.users.username 
FROM 
	dbo.saleledger, 
	dbo.saledetail,  
	dbo.item, 
	dbo.accounts,
	dbo.users
WHERE 
	( dbo.saleledger.date between :ar_StartDate and :ar_EndDate) and
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and  
	( dbo.saledetail.Due in ('D', 'X', 'S')) and  
	( dbo.saledetail.icode = dbo.item.icode ) and
	case :ar_grouptype 
		when 'P' then item.packcode
		when 'C' THEN item.icatcode
		when 'L' THEN item.iccode
		when 'M' THEN item.manfcode  end  IN (:ar_groupcode) and
	( dbo.saleledger.custcode = dbo.accounts.acccode ) and  
	( dbo.saleledger.salesmancode = dbo.users.usercode )
ORDER BY 
	groupname,
	groupcode,
	dbo.saleledger.saleinvcode ASC,
	dbo.saleledger.date ASC
"
  arguments=(("ar_grouptype", string), ("ar_groupcode", numberlist), ("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
