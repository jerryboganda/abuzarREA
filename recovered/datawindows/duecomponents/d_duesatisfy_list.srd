header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=code dbname="DueSatisfyHeader.DueSatisfyCode"  )
column=(type=long update=yes updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=datetime update=yes updatewhereclause=yes name=duesatisfydate dbname="duesatisfydate"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="usercode"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=long updatewhereclause=yes name=dueadjcode dbname="dueAdjCode"  )
 retrieve="  SELECT DueSatisfyHeader.DueSatisfyCode,   
         saleinvcode = Max(DueSatisfyHeader.SaleInvCode) ,   
         duesatisfydate = Max(DueSatisfyHeader.DueSatisfyDate) ,   
         usercode = Max(DueSatisfyHeader.UserCode) ,   
         username = Max(Users.UserName) ,
			dueAdjCode = DueSatisfyHeader.DueAdjCode
    FROM DueSatisfyHeader, DueSatisfyDetail,
         Users  
   WHERE DueSatisfyHeader.DueSatisfyCode = DueSatisfyDetail.DueSatisfyCode And
			Users.UserCode = DueSatisfyHeader.UserCode     

Group By duesatisfyheader.duesatisfycode, DueSatisfyHeader.DueAdjCode"
 )
