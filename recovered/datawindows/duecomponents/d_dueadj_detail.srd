table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="DueAdjDetail.dueadjcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=saleinvcode dbname="DueAdjDetail.saleinvcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes validation="Real( GetText() ) > 0" name=icode dbname="DueAdjDetail.icode"  )
column=(type=long update=yes updatewhereclause=yes validation="Real( GetText() ) > 0" name=gcode dbname="DueAdjDetail.gcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=salerowid dbname="DueAdjDetail.salerowid"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=dueqty dbname="DueAdjDetail.dueqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=satisfiedqty dbname="DueAdjDetail.satisfiedqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real( GetText() ) >= 0" initial="0" name=satisfiableqty dbname="DueAdjDetail.satisfiableqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=duedelete dbname="DueAdjDetail.duedelete" 
 values="	Y/	N"  )
 retrieve="  SELECT dad.dueadjcode,
			dad.saleinvcode,	
			dad.icode,
			dad.gcode,
			dad.salerowid,
			i.name,
			dad.dueqty,
			dad.satisfiedqty,
			dad.satisfiableqty,
			stock = 0.0000,
			dad.duedelete

From    dueadjdetail dad, item i

Where   dad.dueadjcode = :ar_dueadjcode And
		  dad.icode = i.icode

Order By dad.SaleInvCode,
			i.name"
  update="dueadjdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_dueadjcode", number))
)
