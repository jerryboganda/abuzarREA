table(column=(type=long updatewhereclause=yes name=code dbname="DueAdjHeader.DueadjCode"  )
column=(type=datetime updatewhereclause=yes name=startdate dbname="DueAdjHeader.StartDate"  )
column=(type=datetime updatewhereclause=yes name=enddate dbname="DueAdjHeader.EndDate"  )
column=(type=long updatewhereclause=yes name=dueadjheader_usercode dbname="DueAdjHeader.UserCode"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.UserName"  )
column=(type=char(60) updatewhereclause=yes name=remarks dbname="DueAdjHeader.remarks"  )
 retrieve="  SELECT dah.DueadjCode,   
         dah.StartDate,   
         dah.EndDate,   
         dah.UserCode,   
         Users.UserName,
			dah.remarks
    FROM DueAdjHeader dah,
         Users  
   WHERE ( Users.UserCode = dah.UserCode )    
"
 )
