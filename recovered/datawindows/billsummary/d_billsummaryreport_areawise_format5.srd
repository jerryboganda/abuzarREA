table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="Custcode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=decimal(6) updatewhereclause=yes name=net dbname="Net"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=long updatewhereclause=yes name=lastsaleinv dbname="LastSaleInv"  )
column=(type=datetime updatewhereclause=yes name=lastsaledate dbname="LastSaleDate"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
 retrieve="SELECT  SL.saleinvcode,
	Custcode=C.Custcode,
	AliasName=A.AliasName,
	Customer=A.Name,
	Area=Ar.Name,
	AreaCode=C.AreaCode,
	Net=Round(
		SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
		(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
		SL.misccharges + SL.salestax - SL.flatdisc, 0)+
		Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
		SUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
		ROUND( (SUM((SD.looseqty * 
			(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
			SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0),
	Balance=CASE WHEN (SELECT MIN(SaleLedger.SaleInvCode)
		FROM	SaleLedger 
		WHERE	SaleLedger.Posted='N' AND SaleLedger.Deleted='N' AND 
			SaleLedger.CustCode = C.CustCode) = SL.SaleInvCode THEN MAX(Isnull(B.Balance, 0)) ELSE 0 END,
	Address=C.Address1,
	LastSaleInv=NULL,
	LastSaleDate = NULL,
	SalesPerson = (SELECT SM.Name FROM SalesMan SM WHERE SL.SManCode = SM.SalesManCode)
FROM    saleledger SL,	 
	saledetail SD,
	(SELECT Acccode, Balance=Sum(debit-credit)
	From VirtualGL
	Where Acccode IN (select custcode from customer)
	Group By Acccode
	UNION
	SELECT Acccode, Balance=0
	From Accounts
	Where Acccode NOT IN (select distinct acccode from virtualgl)) B,
	Customer C,
	Area Ar,
	Accounts A
WHERE SL.Posted = 'N' AND
	SL.Deleted = 'N' AND
	SL.SaleInvCode = SD.SaleInvcode AND
	SL.Custcode = C.Custcode AND
	C.CustCode=A.Acccode AND
	C.AreaCode = Ar.AreaCode AND
	Ar.AreaCode IN (:ar_areacode) AND
	A.Acccode = B.Acccode
GROUP BY SL.saleinvcode,
	C.CustCode,
	A.Name,
	SL.date,
	SL.discperc,
	SL.misccharges,
	SL.salestax,
	SL.flatdisc,
	SL.invgstperc1,
	C.Address1,
	A.AliasName,
	Ar.Name,
	C.AreaCode,
	SL.SManCode
UNION ALL
SELECT  saleinvcode=0,
	Custcode=C.Custcode,
	AliasName=A.AliasName,
	Customer=A.Name,
	Area=Ar.Name,
	AreaCode=C.AreaCode,
	Net=0,
	Balance= MAX(Isnull(B.Balance, 0)),
	Address=C.Address1,
	LastSaleInv=(SELECT Max(S.SaleInvCode) FROM SaleLedger S WHERE S.CustCode = C.CustCode AND POSTED='Y'),
	LastSaleDate = (SELECT Max(S.Date) FROM SaleLedger S WHERE S.CustCode = C.CustCode AND POSTED='Y'),
	SalesPerson = (SELECT SM.Name FROM SalesMan SM WHERE C.SalesManCode = SM.SalesManCode)
FROM    
	(SELECT  Acccode, Balance=Sum(debit-credit)
	From VirtualGL
	Where Acccode IN (select custcode from customer)
	Group By Acccode
	HAVING Sum(debit-credit) <> 0) B,
	Customer C,
	Area Ar,
	Accounts A
WHERE	
	C.CustCode NOT IN (SELECT DISTINCT CUSTCODE FROM SaleLedger WHERE POSTED='N' AND DELETED='N')	AND
	C.CustCode=A.Acccode AND
	C.AreaCode = Ar.AreaCode AND
	Ar.AreaCode IN (:ar_areacode) AND
	A.Acccode = B.Acccode
GROUP BY C.CustCode,
	 A.Name,
	 C.Address1,
	 A.AliasName,
	 Ar.Name,
	 C.AreaCode,
	 C.SalesManCode
Order BY 
	 Ar.Name,
	 C.AreaCode,
	 A.AliasName,
	 Customer,
	 SL.SaleInvCode
"
  arguments=(("ar_areacode", numberlist))
)
