table(column=(type=char(60) updatewhereclause=yes name=areaname dbname="AreaName"  )
column=(type=char(60) updatewhereclause=yes name=subareaname dbname="SubAreaName"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="outstandingamt"  )
 retrieve="SELECT
	AreaName=A.Name,
	SubAreaName=SA.Name,
	AliasName=AC.AliasName,
	CustomerName=AC.Name,
	Date = S.Date,
	SaleInvCode=S.Saleinvcode, 
	NetAmount = DBO.fn_GetSaleInvTotal(S.SaleInvCode),
	outstandingamt=S.outstandingamt
FROM
	SaleLedger S, Customer C, Area A, SubArea SA, Accounts AC
WHERE
	S.salecatcode in (2) AND 
	S.posted='Y' and S.accountfor='Y' AND S.marked='N' AND S.OutStandingAmt > 0 AND
	S.CustCode = C.CustCode AND
	C.CustCode = AC.AccCode AND
	C.AreaCode = A.AreaCode AND
	C.SubAreaCode = SA.SubAreaCode AND
	SA.AreaCode = A.AreaCode AND
	SA.SubAreaCode IN (:ai_subareacode) AND
	S.SaleTypeCode IN (:ai_saletypecode)
ORDER BY
	A.Name,
	SA.Name,
	AC.AliasName,
	S.Saleinvcode
"
  arguments=(("ai_subareacode", numberlist), ("ai_saletypecode", numberlist), ("as_saletypelist", string))
)
