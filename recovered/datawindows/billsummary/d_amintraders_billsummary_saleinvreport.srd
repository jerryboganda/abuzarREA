table(column=(type=long updatewhereclause=yes name=billsummarycode dbname="BillSummaryCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=custarea dbname="custarea"  )
