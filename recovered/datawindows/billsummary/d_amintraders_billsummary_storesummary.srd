datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=596 color="536870912" )
summary(height=104 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=billsummarycode dbname="BillSummaryCode"  )
column=(type=long updatewhereclause=yes name=saleinvoices dbname="SaleInvoices"  )
column=(type=long updatewhereclause=yes name=minsaleinvcode dbname="MinSaleInvCode"  )
column=(type=long updatewhereclause=yes name=maxsaleinvcode dbname="MaxSaleInvCode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="bonus"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="salevalue"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
 retrieve="SELECT
	BillSummaryCode,
		SaleInvoices=max(SaleInvoices) ,
		MinSaleInvCode=max(MinSaleInvCode) ,
		MaxSaleInvCode =max(MaxSaleInvCode),
		icode,  
		batch, 
		expiry, 
		Item ,
		Packing,
		qty=Sum(A.Qty), 
		bonus=sum(A.Bonus),
		salevalue=sum(A.SaleValue),
		Manufacturer 


		FROM (SELECT 
				BillSummaryCode=BS.BillSummaryCode,
				SaleInvoices = COUNT(DISTINCT BSD.SaleInvCode),
				MinSaleInvCode = MIN(BSD.SaleInvCode),
				MaxSaleInvCode = MAX(BSD.SaleInvCode),
				SD.ICode,  
				SD.Batch, 
				SD.Expiry, 
				Item = I.Name,
				Packing=MAX(I.packingdesc),
				SUM(SD.looseQty) AS Qty, 
				SUM(SD.BonusQty) AS Bonus,
				SaleValue=SUM(SD.looseQty * (SD.SalePrice - ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) *
					(1 - SL.DiscPerc * 0.01),
				Manufacturer = M.Name
		
		FROM
				BillSummary BS,	
				BillSummaryDetail BSD,	
				Saledetail SD,
				SaleLedger SL,
				Manufacturer M,
				Item	I
		WHERE 
				BS.BillSummaryCode = :ai_Code AND
				BS.BillSummaryCode = BSD.BillSummaryCode AND
				BSD.SaleInvCode > 0 AND
				BSD.SaleInvCode = SL.SaleInvCode AND
				SL.SaleInvCode = SD.SaleInvcode AND
				SD.ICode = I.ICode AND
				I.ManfCode = M.ManfCode
		GROUP BY
				BS.BillSummaryCode,
				SD.ICode, 
				SD.Batch, 
				SD.Expiry,
				SL.DiscPerc,
				M.Name,
				I.Name) A
GROUP BY
		BillSummaryCode,
		ICode, 
		Batch, 
		Expiry,
		Manufacturer,
		Item,
		A.packing
ORDER BY
		Manufacturer,
		Item


/* SELECT 
		BillSummaryCode=BS.BillSummaryCode,
		SaleInvoices = COUNT(DISTINCT BSD.SaleInvCode),
		MinSaleInvCode = MIN(BSD.SaleInvCode),
		MaxSaleInvCode = MAX(BSD.SaleInvCode),
		SD.ICode,  
		SD.Batch, 
		SD.Expiry, 
		Item = I.Name,
		Packing=MAX(I.packingdesc),
		SUM(SD.looseQty) AS Qty, 
		SUM(SD.BonusQty) AS Bonus,
		SaleValue=SUM(SD.looseQty * (SD.SalePrice - ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) *
			(1 - SL.DiscPerc * 0.01),
		Manufacturer = M.Name

FROM
		BillSummary BS,	
		BillSummaryDetail BSD,	
		Saledetail SD,
		SaleLedger SL,
		Manufacturer M,
		Item	I
WHERE 
		BS.BillSummaryCode = :ai_Code AND
		BS.BillSummaryCode = BSD.BillSummaryCode AND
		BSD.SaleInvCode > 0 AND
		BSD.SaleInvCode = SL.SaleInvCode AND
		SL.SaleInvCode = SD.SaleInvcode AND
		SD.ICode = I.ICode AND
		I.ManfCode = M.ManfCode
GROUP BY
		BS.BillSummaryCode,
		SD.ICode, 
		SD.Batch, 
		SD.Expiry,
		SL.DiscPerc,
		M.Name,
		I.Name
ORDER BY
		M.Name,
		I.Name 
*/"
  arguments=(("ai_Code", number))
 sort="manufacturer A, item A, batch A, expiry A"
)
