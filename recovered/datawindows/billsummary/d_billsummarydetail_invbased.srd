header(height=124 color="536870912" )
summary(height=0 color="536870912" )
footer(height=64 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="BillSummaryDetail.BillSummaryCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=custcode dbname="BillSummaryDetail.CustCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=accbalance dbname="BillSummaryDetail.AccBalance"  )
column=(type=long update=yes updatewhereclause=yes name=saleinvcode dbname="BillSummaryDetail.SaleInvCode"  )
column=(type=decimal(2) updatewhereclause=yes initial="0.00" name=netamount dbname="NetAmount"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=outstandingamt dbname="BillSummaryDetail.OutStandingAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid cash amount~"" initial="0.00" name=cashamt dbname="BillSummaryDetail.CashAmt"  )
column=(type=long update=yes updatewhereclause=yes name=cashacccode dbname="BillSummaryDetail.CashAccCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid cheque amount~"" initial="0.00" name=chequeamt dbname="BillSummaryDetail.ChequeAmt"  )
column=(type=long update=yes updatewhereclause=yes name=bankacccode dbname="BillSummaryDetail.BankAccCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid debit note amount~"" initial="0.00" name=debitnoteamt dbname="BillSummaryDetail.DebitNoteAmt"  )
column=(type=long update=yes updatewhereclause=yes name=debitnoteacccode dbname="BillSummaryDetail.DebitNoteAccCode"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="BillSummaryDetail.RowID"  )
column=(type=long update=yes updatewhereclause=yes name=creditnoteacccode dbname="BillSummaryDetail.CreditNoteAccCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid credit note amount~"" initial="0.00" name=creditnoteamt dbname="BillSummaryDetail.CreditNoteAmt"  )
column=(type=char(100) update=yes updatewhereclause=yes name=billsonhandbreakup dbname="BillSummaryDetail.BillsOnHandBreakUp"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="BillSummaryDetail.Remarks"  )
column=(type=long update=yes updatewhereclause=yes name=srbufferinvcode dbname="BillSummaryDetail.SRBufferInvCode"  )
column=(type=long updatewhereclause=yes name=refsaleinvcode dbname="RefSaleInvCode"  )
column=(type=decimal(2) updatewhereclause=yes initial="0.00" name=salereturnamt dbname="SaleReturnAmt"  )
 retrieve="SELECT 
	BillSummaryDetail.BillSummaryCode,
	AliasName = (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = BillSummaryDetail.CustCode),
	BillSummaryDetail.CustCode,
	BillSummaryDetail.AccBalance,
	BillSummaryDetail.SaleInvCode,
	NetAmount = ISNULL(DBO.fn_GetSaleInvTotal(BillSummaryDetail.SaleInvCode), 0),
	BillSummaryDetail.OutStandingAmt,
	BillSummaryDetail.CashAmt,
	BillSummaryDetail.CashAccCode,
	BillSummaryDetail.ChequeAmt,
	BillSummaryDetail.BankAccCode,
	BillSummaryDetail.DebitNoteAmt,
	BillSummaryDetail.DebitNoteAccCode,
	BillSummaryDetail.RowID,
	BillSummaryDetail.CreditNoteAccCode,
	BillSummaryDetail.CreditNoteAmt,
	BillSummaryDetail.BillsOnHandBreakUp,
	BillSummaryDetail.Remarks,
	BillSummaryDetail.SRBufferInvCode,
	RefSaleInvCode = (SELECT SR.SaleInvCode FROM SRBufferLedger SR WHERE SR.SRBufferInvCode = BillSummaryDetail.SRBufferInvCode),
	SaleReturnAmt = ISNULL(DBO.Fn_getSRBufferInvTotal(BillSummaryDetail.SRBufferInvCode), 0)
FROM 
	BillSummaryDetail
WHERE
	BillSummaryDetail.BillSummaryCode = :ai_code
ORDER BY 
	BillSummaryDetail.RowID"
  update="BillSummaryDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
