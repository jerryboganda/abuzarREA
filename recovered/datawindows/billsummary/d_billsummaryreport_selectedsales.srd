table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="Custcode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=decimal(6) updatewhereclause=yes name=net dbname="Net"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
 retrieve="SELECT  SL.saleinvcode,
	Custcode=C.Custcode,
	AliasName=A.AliasName,
	Customer=A.Name,
	Net=Round(
		SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
		(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
		SL.misccharges + SL.salestax - SL.flatdisc, 0)+
		Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
		SUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
		ROUND( (SUM((SD.looseqty * 
			(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
			SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0),
	UserCode=SL.salesmancode,
	UserName=U.UserName,
	Balance=MAX(Isnull(B.Balance, 0)),
	Address=C.Address1

FROM    saleledger SL,	 
	saledetail SD,
	(SELECT  Acccode,
		Balance=Sum(debit-credit)
	From VirtualGL
	Where Acccode IN (select custcode from customer)
	Group By Acccode
	UNION
	SELECT  Acccode,
		Balance=0
	From Accounts
	Where Acccode NOT IN (select distinct acccode from virtualgl)) B,
	Customer C,
	Accounts A,
	Users U


WHERE SL.SaleInvCode IN (SELECT Code1 FROM ReportData) AND
		SL.SaleInvCode = SD.SaleInvcode AND
		SL.SalesManCode = U.UserCODE AND
		SL.Custcode = C.Custcode AND
		C.CustCode=A.Acccode AND
		A.Acccode = B.Acccode

GROUP BY SL.saleinvcode,
	 C.CustCode,
	 A.Name,
	 SL.date,
	 SL.discperc,
	 SL.misccharges,
	 SL.salestax,
	 SL.flatdisc,
	 SL.invgstperc1,
	 SL.salesmancode,
	 U.UserName,
	 C.Address1,
	 A.AliasName
Order BY 
	 U.UserName,
	 SL.SaleInvCode,
	 A.AliasName,
	 Customer
"
  arguments=(("as_billsumm", string))
)
