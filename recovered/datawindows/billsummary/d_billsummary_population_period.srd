summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=areaname dbname="AreaName"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="CustName"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
 retrieve="SELECT  
	AreaCode=T.AreaCode, 
	AreaName = AR.Name, 
	CustCode=T.CustCode,
	CustName = AC.Name, 
	SaleInvCode=T.SaleInvCode
FROM
	Area AR, Accounts AC,
	(SELECT DISTINCT 
		AR.AreaCode, S.SaleInvCode, C.CustCode
	FROM
		SaleLedger S, Customer C, Area AR, Accounts A
	WHERE
		S.Posted = CASE UPPER(:as_posted) WHEN 'Y' THEN 'Y' WHEN 'N' THEN 'N' ELSE S.Posted END AND
		S.DATE BETWEEN :adt_startdate AND :adt_enddate AND 
		S.SaleCatCode <> 3 AND 
		S.CustCode = C.CustCode AND 
		C.CustCode = A.AccCode AND
		A.Active = 'Y' AND
		C.AreaCode IN (:ai_areacode) AND 
		C.AreaCode = AR.AreaCode
	UNION ALL
	SELECT AR.AreaCode, SaleInvCode=NULL, C.CustCode
	FROM
		Customer C, Area AR, Accounts A, 
		(SELECT V.AccCode, BALANCE=SUM(V.Debit - V.Credit)
		FROM VirtualGL V
		GROUP BY V.AccCode
		HAVING SUM(V.Debit - V.Credit) > 0) B
	WHERE
		:ai_outstandingcust = 1 AND 
		C.CustCode = A.AccCode AND
		A.AccCode = B.AccCode AND 
		A.Active = 'Y' AND
		C.AreaCode IN (:ai_areacode) AND 
		C.AreaCode = AR.AreaCode AND 
		C.CustCode NOT IN
			(SELECT DISTINCT C.CustCode
			FROM
				SaleLedger S, Customer C
			WHERE
				S.Posted = CASE UPPER(:as_posted) WHEN 'Y' THEN 'Y' WHEN 'N' THEN 'N' ELSE S.Posted END AND
				S.DATE BETWEEN :adt_startdate AND :adt_enddate AND 
				S.SaleCatCode <> 3 AND 
				S.CustCode = C.CustCode AND
				C.AreaCode IN (:ai_areacode))
	UNION ALL
	SELECT AR.AreaCode, SaleInvCode=NULL, C.CustCode
	FROM
		Customer C, Area AR, Accounts A
	WHERE
		:ai_zerobalcust = 1 AND
		C.CustCode NOT IN 
			(SELECT V.AccCode
			FROM VirtualGL V
			GROUP BY V.AccCode
			HAVING SUM(V.Debit - V.Credit) > 0) AND
		C.CustCode = A.AccCode AND
		A.Active = 'Y' AND 
		C.AreaCode IN (:ai_areacode) AND
		C.AreaCode = AR.AreaCode AND
		C.CustCode NOT IN
			(SELECT DISTINCT C.CustCode
			FROM
				SaleLedger S, Customer C
			WHERE
				S.Posted = CASE UPPER(:as_posted) WHEN 'Y' THEN 'Y' WHEN 'N' THEN 'N' ELSE S.Posted END AND
				S.DATE BETWEEN :adt_startdate AND :adt_enddate AND 
				S.SaleCatCode <> 3 AND 
				S.CustCode = C.CustCode AND
				C.AreaCode IN (:ai_areacode))) T
WHERE 
	T.CustCode = AC.AccCode AND
	T.AreaCode = AR.AreaCode
ORDER BY
	AreaName,
	CustName,
	SaleInvCode
	"
  arguments=(("ai_areacode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime), ("as_posted", string), ("ai_outstandingcust", number), ("ai_zerobalcust", number))
)
