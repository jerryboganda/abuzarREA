release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1500 color="536870912" )
summary(height=260 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=long updatewhereclause=yes name=billsummarycode dbname="BillSummaryCode"  )
column=(type=long updatewhereclause=yes name=saleinvoices dbname="SaleInvoices"  )
column=(type=long updatewhereclause=yes name=minsaleinvcode dbname="MinSaleInvCode"  )
column=(type=long updatewhereclause=yes name=maxsaleinvcode dbname="MaxSaleInvCode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Saledetail.ICode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Saledetail.Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Saledetail.Expiry"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Saledetail.SalePrice"  )
column=(type=decimal(6) updatewhereclause=yes name=discountvalue dbname="DiscountValue"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
 retrieve=" SELECT 
		BillSummaryCode=BS.BillSummaryCode,
		SaleInvoices = COUNT(DISTINCT BSD.SaleInvCode),
		MinSaleInvCode=(SELECT MIN(D.SaleInvCode) FROM BillSummaryDetail D WHERE D.BillSummaryCode = :ai_code),
		MaxSaleInvCode=(SELECT MAX(D.SaleInvCode) FROM BillSummaryDetail D WHERE D.BillSummaryCode = :ai_code),
		AliasName = I.CustomICode,
		SD.ICode,  
		SD.Batch, 
		SD.Expiry, 
		Item = I.Name,
		Packing=MAX(I.packingdesc),
		SUM(SD.looseQty) AS Qty, 
		SUM(SD.BonusQty) AS Bonus,
		SD.SalePrice,
		DiscountValue = SUM(SD.looseQty * SD.ItemFlatDisc) +  
			SUM(SD.looseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01)) +
			SUM(SD.looseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (SL.DiscPerc * 0.01)),
		SaleValue=SUM(SD.looseQty * (SD.SalePrice - ItemFlatDisc) * (1 - SD.DiscPerc * 0.01)) *
			(1 - SL.DiscPerc * 0.01),
		Manufacturer = M.Name,
		SalesPerson = (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode=SL.SManCode)
FROM
		BillSummary BS,	
		BillSummaryDetail BSD,	
		Saledetail SD,
		SaleLedger SL,
		Manufacturer M,
		Item	I
WHERE 
		BS.BillSummaryCode = :ai_Code AND
		BS.BillSummaryCode = BSD.BillSummaryCode AND
		BSD.SaleInvCode > 0 AND
		BSD.SaleInvCode = SL.SaleInvCode AND
		SL.SaleInvCode = SD.SaleInvcode AND
		SD.ICode = I.ICode AND
		I.ManfCode = M.ManfCode
GROUP BY
		BS.BillSummaryCode,
		SL.SManCode,
		M.Name,
		SD.ICode, 
		I.Name,
		I.CustomICode,
		SD.Batch, 
		SD.Expiry,
		SD.SalePrice,
		SL.DiscPerc
ORDER BY
		M.Name,
		I.Name,
		SD.Batch
"
  arguments=(("ai_Code", number))
 sort="manufacturer A, item A, batch A, expiry A"
)
