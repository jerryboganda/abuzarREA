table(column=(type=long updatewhereclause=yes name=billsummarycode dbname="BillSummaryCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=char(1) updatewhereclause=yes name=finalized dbname="Finalized"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=long updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(60) updatewhereclause=yes name=country dbname="Country"  )
column=(type=char(60) updatewhereclause=yes name=areaname dbname="AreaName"  )
column=(type=decimal(2) updatewhereclause=yes name=accbalance dbname="AccBalance"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=decimal(2) updatewhereclause=yes name=cashamt dbname="CashAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=chequeamt dbname="ChequeAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=debitnoteamt dbname="DebitNoteAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=creditnoteamt dbname="CreditNoteAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=salereturnamt dbname="SaleReturnAmt"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
 retrieve="SELECT 
	BillSummaryCode = B.BillSummaryCode,
	Date = B.Date,
	UserCode=B.UserCode,
	Posted=B.Posted,
	Finalized=B.Finalized,
	PostDate = B.PostDate,
	PostedBy = B.PostedBy,
	Remarks = B.Remarks,
	AccCode = A.AccCode,
	AliasName = A.AliasName,
	CustomerName = A.Name,
	Address1 = C.Address1,
	Address2 = C.Address2,
	City = C.City,
	Country = C.Country,
	AreaName = (SELECT AR.Name FROM Area AR WHERE C.AreaCode = AR.AreaCode),
	AccBalance = D.AccBalance,
	SaleInvCode = CASE WHEN D.SaleInvCode IS NULL THEN 0 ELSE D.SaleInvCode END,
	NetAmount = ISNULL(DBO.fn_GetSaleInvTotal(D.SaleInvCode), 0),
	CashAmt = ISNULL(D.CashAmt,0),
	ChequeAmt = ISNULL(D.ChequeAmt, 0),
	DebitNoteAmt = ISNULL(D.DebitNoteAmt, 0),
	CreditNoteAmt = ISNULL(D.CreditNoteAmt, 0),
	SaleReturnAmt = ISNULL(DBO.fn_GetSRBufferInvTotal(D.SRBufferInvCode), 0),
	RowID = D.RowId

FROM
	BillSummary B, BillSummaryDetail D, Accounts A, Customer C
WHERE
	B.BillSummaryCode = :ai_code AND
	B.BillSummaryCode = D.BillSummaryCode AND
	D.CustCode = A.AccCode AND
	A.AccCode = C.CustCode
ORDER BY
	D.RowID
"
  arguments=(("ai_code", number))
)
