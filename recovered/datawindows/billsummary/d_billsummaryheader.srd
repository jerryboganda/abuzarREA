 retrieve="SELECT 
	BillSummary.BillSummaryCode,   
	BillSummary.BillSummaryTypeCode,   
	BillSummary.Date,   
	BillSummary.UserCode,   
	BillSummary.Posted,   
	BillSummary.PostedBy,
	BillSummary.Finalized,   
	BillSummary.FinalizedOn,
	BillSummary.FinalizedBy,
	BillSummary.Remarks  
FROM 
	BillSummary  
WHERE 
	BillSummary.BillSummaryCode = :ai_code   
"
  update="BillSummary" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
