table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleLedger.saleinvcode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="Custcode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=decimal(2) updatewhereclause=yes name=net dbname="Net"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="SaleLedger.Posted"  )
 retrieve="SELECT  SL.saleinvcode,
	Custcode=C.Custcode,
	AliasName=A.AliasName,
	Customer=A.Name,
	Area=Ar.Name,
	AreaCode=C.AreaCode,
	Net=Round(
		SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
		(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
		SL.misccharges + SL.salestax - SL.flatdisc, 0)+
		Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
		SUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
		ROUND( (SUM((SD.looseqty * 
			(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
			SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0),
	Balance=(CASE WHEN (SELECT MIN(SaleLedger.SaleInvCode)
		FROM	SaleLedger 
		WHERE	SaleLedger.Posted IN (:as_posted) AND 
			SaleLedger.SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND
			SaleLedger.CustCode = C.CustCode) = SL.SaleInvCode THEN CASE SL.POSTED WHEN 'Y' THEN Isnull(SL.BALANCE, 0) ELSE MAX(Isnull(B.Balance, 0)) END ELSE 0 END),
	Address=C.Address1,
	SL.Posted

FROM
	saleledger SL,	 
	saledetail SD,
	(SELECT  Acccode,
		Balance=Sum(debit-credit)
	From VirtualGL
	Where Acccode IN (select custcode from customer)
	Group By Acccode
	UNION
	SELECT  Acccode,
		Balance=0
	From Accounts
	Where Acccode NOT IN (select distinct acccode from virtualgl)) B,
	Customer C,
	Area Ar,
	Accounts A

WHERE SL.Posted IN (:as_posted) AND
		SL.SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND
		SL.SaleInvCode = SD.SaleInvcode AND
		SL.Custcode = C.Custcode AND
		C.CustCode=A.Acccode AND
		C.AreaCode = Ar.AreaCode AND
		Ar.AreaCode IN (:ar_areacode) AND
		A.Acccode = B.Acccode

GROUP BY SL.saleinvcode,
	 C.CustCode,
	 A.Name,
	 SL.date,
	 SL.discperc,
	 SL.misccharges,
	 SL.salestax,
	 SL.flatdisc,
	 SL.invgstperc1,
	 SL.BALANCE,
	 SL.Posted,
	 C.Address1,
	 A.AliasName,
	 Ar.Name,
	 C.AreaCode
Order BY 
	 Ar.Name,
	 C.AreaCode,
	 A.AliasName,
	 Customer,
	 SL.SaleInvCode
"
  arguments=(("ar_sinvcode", number), ("ar_linvcode", number), ("ar_areacode", numberlist), ("as_posted", stringlist))
)
