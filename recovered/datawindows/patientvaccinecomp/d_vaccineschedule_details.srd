table(column=(type=long key=yes identity=yes updatewhereclause=yes name=code dbname="VaccineSchedule.Code"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="VaccineSchedule.PatientCode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="VaccineSchedule.ICode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=scheduledate dbname="VaccineSchedule.ScheduleDate"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="VaccineSchedule.UserCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=duedate dbname="VaccineSchedule.DueDate"  )
column=(type=datetime update=yes updatewhereclause=yes name=modifiedon dbname="VaccineSchedule.modifiedOn"  )
column=(type=long update=yes updatewhereclause=yes name=modifiedby dbname="VaccineSchedule.modifiedBy" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=stoppedon dbname="VaccineSchedule.StoppedOn"  )
column=(type=long update=yes updatewhereclause=yes name=stoppedby dbname="VaccineSchedule.StoppedBy" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="4" name=vaccinestatuscode dbname="VaccineSchedule.VaccineStatusCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=lastremindedon dbname="VaccineSchedule.LastRemindedOn"  )
column=(type=long update=yes updatewhereclause=yes name=lastremindedby dbname="VaccineSchedule.LastRemindedBy" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=lastpendedon dbname="VaccineSchedule.LastPendedOn"  )
column=(type=long update=yes updatewhereclause=yes name=lastpendedby dbname="VaccineSchedule.LastPendedBy" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=vaccinatedon dbname="VaccineSchedule.VaccinatedOn"  )
column=(type=long update=yes updatewhereclause=yes name=vaccinatedby dbname="VaccineSchedule.VaccinatedBy" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=saletemplaterowid dbname="VaccineSchedule.SaleTemplateRowID"  )
column=(type=long update=yes updatewhereclause=yes name=doctcode dbname="VaccineSchedule.DoctCode" 
 values=""  )
column=(type=char(1000) update=yes updatewhereclause=yes name=remarks dbname="VaccineSchedule.Remarks"  )
 retrieve="SELECT 
	V.Code,
	V.PatientCode,
	V.ICode,
	aliasname = i.customicode,
	i.name,
	CurrListRow = 0,
	V.ScheduleDate,
	V.UserCode,
	V.DueDate,
	V.modifiedOn,
	V.modifiedBy,
	V.StoppedOn,
	V.StoppedBy,
	V.VaccineStatusCode,
	V.LastRemindedOn,
	V.LastRemindedBy,
	V.LastPendedOn,
	V.LastPendedBy,
	V.VaccinatedOn,
	V.VaccinatedBy,
	V.SaleTemplateRowID,
	V.DoctCode,
	V.Remarks
From   
	vaccineschedule v , Item i
Where  
	v.patientcode = :ai_code And
	v.icode = i.icode
Order By V.Code"
  update="vaccineschedule" updatewhere=0 updatekeyinplace=no
  arguments=(("ai_code", number))
)
