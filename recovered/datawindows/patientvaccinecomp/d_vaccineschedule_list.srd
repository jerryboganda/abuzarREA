summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Patient.PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Patient.RegNo"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Patient.Name"  )
column=(type=char(60) updatewhereclause=yes name=fname dbname="Patient.FName"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Patient.Gender" 
 values="Male	M/Female	F/"  )
column=(type=datetime updatewhereclause=yes name=dob dbname="Patient.DOB"  )
 retrieve="SELECT 
	DISTINCT
	Patient.PatientCode,   
	Patient.RegNo,   
	Patient.Name,   
	Patient.FName,   
	Patient.Gender,   
	Patient.DOB  
FROM 
	Patient,   
	VaccineSchedule  
WHERE 
	( VaccineSchedule.PatientCode = Patient.PatientCode )
"
 )
