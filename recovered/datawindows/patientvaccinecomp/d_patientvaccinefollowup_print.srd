table(column=(type=long identity=yes updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=yes name=patientfname dbname="PatientFName"  )
column=(type=char(100) updatewhereclause=yes name=mobileno1 dbname="MobileNo1"  )
column=(type=char(100) updatewhereclause=yes name=mobileno2 dbname="MobileNo2"  )
column=(type=char(100) updatewhereclause=yes name=mobileno3 dbname="MobileNo3"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=currlistrow dbname="CurrListRow"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="DueDate"  )
column=(type=long updatewhereclause=yes name=vaccinestatuscode dbname="VaccineStatusCode" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=lastremindedon dbname="LastRemindedOn"  )
column=(type=long updatewhereclause=yes name=lastremindedby dbname="LastRemindedBy" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=lastpendedon dbname="LastPendedOn"  )
column=(type=long updatewhereclause=yes name=lastpendedby dbname="LastPendedBy" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=vaccinatedon dbname="VaccinatedOn"  )
column=(type=datetime updatewhereclause=yes name=stoppedon dbname="StoppedOn"  )
column=(type=long updatewhereclause=yes name=stoppedby dbname="StoppedBy"  )
column=(type=long updatewhereclause=yes name=vaccinatedby dbname="VaccinatedBy" 
 values=""  )
column=(type=char(1000) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=doctcode dbname="Doctcode" 
 values=""  )
 retrieve="SELECT 
	Code=V.Code,
	PatientCode=V.PatientCode,
	RegNo=P.RegNo,
	PatientName=P.Name,
	PatientFName=P.FName,
	MobileNo1=P.MobileNo1,
	MobileNo2=P.MobileNo2,
	MobileNo3=P.MobileNo3,
	ICode=V.ICode,
	fullcode = i.customicode,
	ItemName=i.name,
	CurrListRow = 0,
	DueDate=V.DueDate,
	VaccineStatusCode=V.VaccineStatusCode,
	LastRemindedOn=V.LastRemindedOn,
	LastRemindedBy=V.LastRemindedBy,
	LastPendedOn=V.LastPendedOn,
	LastPendedBy=V.LastPendedBy,
	VaccinatedOn=V.VaccinatedOn,
	StoppedOn=V.StoppedOn,
	StoppedBy=V.StoppedBy,
	VaccinatedBy=V.VaccinatedBy,
	Remarks=V.Remarks,
	Doctcode=V.Doctcode
From   
	vaccineschedule v , Item i, Patient P
Where 
	V.Code < 0 AND
	v.patientcode = p.patientcode AND
	v.icode = i.icode"
 )
