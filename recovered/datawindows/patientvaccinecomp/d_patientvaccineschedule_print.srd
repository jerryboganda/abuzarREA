release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=836 color="536870912" )
summary(height=104 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long identity=yes updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=yes name=fname dbname="FName"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender" 
 values="Female	F/Male	M/"  )
column=(type=datetime updatewhereclause=yes name=dob dbname="DOB"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="DueDate"  )
column=(type=char(1000) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=vaccinestatuscode dbname="VaccineStatusCode"  )
column=(type=char(60) updatewhereclause=yes name=status dbname="Status"  )
column=(type=datetime updatewhereclause=yes name=vaccinatedon dbname="VaccinatedOn"  )
column=(type=char(60) updatewhereclause=yes name=doctorname dbname="DoctorName"  )
 retrieve="SELECT 
	Code=V.Code, 
	PatientCode=V.PatientCode, 
	PatientRegNo=P.RegNo,
	PatientName=P.Name,
	FName=P.FName,
	Gender=P.Gender,
	DOB=P.DOB,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = P.CustCode),
	ICode=V.ICode, 
	ItemName=I.Name,
	DueDate=V.DueDate, 
	Remarks=V.Remarks, 
	VaccineStatusCode =  VS.VaccineStatusCode,
	Status=VS.Name, 
	VaccinatedOn=V.VaccinatedOn,
	DoctorName = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = V.DoctCode)
FROM 
	VaccineSchedule AS V, 
	VaccineStatus AS VS,
	Item AS I, 
	Patient AS P
WHERE
	V.PatientCode = :ai_patientcode AND
	V.PatientCode = P.PatientCode AND
	V.ICode = I.ICode AND
	V.VaccineStatusCode = VS.VaccineStatusCode
ORDER BY
	PatientName,
	DueDate,
	ItemName,
	DoctorName
	"
  arguments=(("ai_patientcode", number))
)
