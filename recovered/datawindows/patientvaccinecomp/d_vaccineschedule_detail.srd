table(column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="Patient.RegNo"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=patientcode dbname="Patient.PatientCode" 
 values=""  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Patient.Name"  )
column=(type=char(60) update=yes updatewhereclause=yes name=fname dbname="Patient.FName"  )
column=(type=char(1) update=yes updatewhereclause=yes name=gender dbname="Patient.Gender" 
 values="Male	M/Female	F/"  )
column=(type=datetime update=yes updatewhereclause=yes name=dob dbname="Patient.DOB"  )
column=(type=long update=yes updatewhereclause=yes name=custcode dbname="Patient.CustCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mobileno1 dbname="Patient.MobileNo1"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mobileno2 dbname="Patient.MobileNo2"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mobileno3 dbname="Patient.MobileNo3"  )
 retrieve="SELECT 
	RegNo,
	PatientCode,
	Name,
	FName,
	Gender,
	DOB,
	CustCode,
	MobileNo1,
	MobileNo2,
	MobileNo3
FROM
	Patient
WHERE 
	PatientCode = :ai_code"
  update="Patient" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
