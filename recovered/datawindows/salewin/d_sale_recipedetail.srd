header(height=128 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(7) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="Price"  )
 retrieve="Select  	icode=RD.ICode,
			qty=RD.qty, 
			Price=RD.Price
From   	Recipe R, RecipeDetail RD
Where   	R.RecipeCode = RD.RecipeCode And
			R.ResultedItem = :al_icode And
			R.Priority = ( Select Min(Priority) From Recipe  Where ResultedItem = :al_icode )

Order By RD.RowId"
  arguments=(("al_icode", number))
)
