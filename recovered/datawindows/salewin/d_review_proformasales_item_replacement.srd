table(column=(type=long key=yes updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=long updatewhereclause=yes name=proformainvoice dbname="ProformaInvoice"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(60) updatewhereclause=yes name=finditem dbname="FindItem"  )
column=(type=long updatewhereclause=yes name=replaceicode dbname="ReplaceICode"  )
column=(type=char(60) updatewhereclause=no name=replacewith dbname="ReplaceWith"  )
column=(type=long updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Please enter valid sale price~"" initial="0" name=replacesaleprice dbname="ReplaceSalePrice"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="ItemFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
 retrieve="SELECT 
	SaleInvCode = D.SaleInvCode,
	ProformaInvoice = 1,
	Date = S.Date,
	Customer = A.Name,
	Posted = S.Posted,
	RowID = D.RowId,
	ICode = D.ICode, 
	FindItem = I.Name,
	ReplaceICode = :ai_replaceitem,
	ReplaceWith = (SELECT IT.Name FROM Item IT WHERE IT.ICode=:ai_replaceitem),
	ReplaceSalePrice = :ai_replacesaleprice,
	Qty=D.LooseQty,
	Bonus=D.BonusQty,
	SalePrice = D.SalePrice,
	ItemFlatDisc=D.ItemFlatDisc,
	DiscPerc = D.DiscPerc
FROM
	SaleLedger S, SaleInvDetail D, Item I, Accounts A
WHERE
	S.Posted = 'N' AND
	S.SaleInvCode IN 
		(SELECT DISTINCT G.SaleInvCode 
		FROM SaleInvGroupDetail G
		WHERE G.SaleInvGroupCode=:ai_code) AND
	S.SaleInvCode = D.SaleInvCode AND
	S.CustCode = A.AccCode AND
	D.ICode = I.ICode AND
	I.ICode = :ai_finditem
ORDER BY
	SaleInvCode,
	RowId"
  update="SaleInvDetail" updatewhere=0 updatekeyinplace=no
  arguments=(("ai_code", number), ("ai_finditem", number), ("ai_findsaleprice", number), ("ai_replaceitem", number), ("ai_replacesaleprice", number))
)
