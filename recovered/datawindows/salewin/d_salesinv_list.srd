table(column=(type=long updatewhereclause=yes name=code dbname="SaleLedger.saleinvcode"  )
column=(type=char(60) updatewhereclause=yes name=salecategory_name dbname="SaleCategory.name"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=datetime updatewhereclause=yes name=saleledger_date dbname="SaleLedger.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
 retrieve="  SELECT  saleledger.saleinvcode , 
          salecategory.name , 
          accounts.name , 
          saleledger.date,     
          posted = saleledger.posted

    FROM  saleledger , 
          accounts , 
          salecategory     

   WHERE  saleledger.custcode = accounts.acccode   and 
			 saleledger.salecatcode = salecategory.salecatcode  
          "
 )
