table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long updatewhereclause=yes name=guaranteepersoncode dbname="InstallmentGuarantor.GuaranteePersonCode"  )
column=(type=char(100) updatewhereclause=yes name=guaranteeperson dbname="GuaranteePerson"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=long updatewhereclause=yes name=installmentfrequency dbname="InstallmentFrequency" 
 values="Daily	1/Weekly	7/Half-Monthly	15/Monthly	30/Quarterly	90/Half-Yearly	180/Annually//Yearly	360/"  )
column=(type=long updatewhereclause=yes name=noofinstallments dbname="NoOfInstallments"  )
column=(type=decimal(9) updatewhereclause=yes name=contractamt dbname="ContractAmt"  )
column=(type=char(60) updatewhereclause=yes name=usercode dbname="UserCode"  )
column=(type=char(255) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=char(1) updatewhereclause=yes name=approved dbname="Approved"  )
column=(type=char(60) updatewhereclause=yes name=approvedby dbname="ApprovedBy"  )
column=(type=datetime updatewhereclause=yes name=approvedon dbname="ApprovedOn"  )
column=(type=char(1) updatewhereclause=yes name=rejected dbname="Rejected"  )
column=(type=char(60) updatewhereclause=yes name=rejectedby dbname="RejectedBy" 
 values=""  )
column=(type=datetime updatewhereclause=yes name=rejectedon dbname="RejectedOn"  )
 retrieve="SELECT
	Code=InstallmentHeader.InstallmentCode, 
	SaleInvCode=InstallmentHeader.SaleInvCode,
	Date=InstallmentHeader.Date, 
	AliasName = Accounts.AliasName,
	CustCode = Accounts.AccCode,
	Customer = Accounts.Name,
	installmentguarantor.GuaranteePersonCode,
	GuaranteePerson=(SELECT G.Name FROM GuaranteePerson G WHERE G.GuaranteePersonCode = installmentguarantor.GuaranteePersonCode),
	Godown = (SELECT G.Name FROM Godown G WHERE G.GCode = InstallmentHeader.GCode),
	CustomICode = Item.CustomICode,
	ItemName = Item.Name, 
	Qty = InstallmentHeader.Qty, 
	SalePrice=InstallmentHeader.SalePrice, 
	InstallmentFrequency=InstallmentHeader.InstallmentFrequency, 
	NoOfInstallments=InstallmentHeader.NoOfInstallments,
	ContractAmt = Round(Round((InstallmentHeader.qty * (InstallmentHeader.saleprice - InstallmentHeader.itemflatdisc) ) * (1 - InstallmentHeader.discperc * 0.01), 2)  + InstallmentHeader.markupamt + InstallmentHeader.processingfee, 0),
	UserCode=(SELECT U.UserName FROM Users U WHERE U.UserCode=InstallmentHeader.UserCode),
	Remarks=InstallmentHeader.Remarks,
	Posted=InstallmentHeader.Posted, 
	PostedBy = (SELECT U.UserName FROM Users U WHERE U.UserCode=InstallmentHeader.PostedBy),
	PostDate=InstallmentHeader.PostDate,
	Approved=InstallmentHeader.Approved,
	ApprovedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=InstallmentHeader.ApprovedBy),
	ApprovedOn=InstallmentHeader.ApprovedOn,
	Rejected=InstallmentHeader.Rejected,
	RejectedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=InstallmentHeader.RejectedBy),
	RejectedOn=InstallmentHeader.RejectedOn
FROM
	InstallmentHeader, Accounts, Item, installmentguarantor
WHERE
	InstallmentHeader.CustCode=Accounts.AccCode AND
	InstallmentHeader.InstallmentCode=installmentguarantor.InstallmentCode AND
	InstallmentHeader.ICode = Item.ICode
UNION
SELECT
	Code=InstallmentHeader.InstallmentCode, 
	SaleInvCode=InstallmentHeader.SaleInvCode,
	Date=InstallmentHeader.Date, 
	AliasName = Accounts.AliasName,
	CustCode = Accounts.AccCode,
	Customer = Accounts.Name,
	GuaranteePersonCode=NULL,
	GuaranteePerson=NULL,
	Godown = (SELECT G.Name FROM Godown G WHERE G.GCode = InstallmentHeader.GCode),
	CustomICode = Item.CustomICode,
	ItemName = Item.Name, 
	Qty = InstallmentHeader.Qty, 
	SalePrice=InstallmentHeader.SalePrice, 
	InstallmentFrequency=InstallmentHeader.InstallmentFrequency, 
	NoOfInstallments=InstallmentHeader.NoOfInstallments,
	ContractAmt = Round(Round((InstallmentHeader.qty * (InstallmentHeader.saleprice - InstallmentHeader.itemflatdisc) ) * (1 - InstallmentHeader.discperc * 0.01), 2)  + InstallmentHeader.markupamt + InstallmentHeader.processingfee, 0),
	UserCode=(SELECT U.UserName FROM Users U WHERE U.UserCode=InstallmentHeader.UserCode),
	Remarks=InstallmentHeader.Remarks,
	Posted=InstallmentHeader.Posted, 
	PostedBy = (SELECT U.UserName FROM Users U WHERE U.UserCode=InstallmentHeader.PostedBy),
	PostDate=InstallmentHeader.PostDate,
	Approved=InstallmentHeader.Approved,
	ApprovedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=InstallmentHeader.ApprovedBy),
	ApprovedOn=InstallmentHeader.ApprovedOn,
	Rejected=InstallmentHeader.Rejected,
	RejectedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=InstallmentHeader.RejectedBy),
	RejectedOn=InstallmentHeader.RejectedOn
FROM
	InstallmentHeader, Accounts, Item
WHERE
	InstallmentHeader.CustCode=Accounts.AccCode AND
	InstallmentHeader.ICode = Item.ICode AND
	InstallmentHeader.InstallmentCode NOT IN (SELECT installmentguarantor.InstallmentCode FROM installmentguarantor)
UNION
SELECT
	Code=NULL, 
	SaleInvCode=NULL,
	Date=NULL,
	AliasName = NULL,
	CustCode = Accounts.AccCode,
	Customer = Accounts.Name,
	GuaranteePersonCode=G.GuaranteePersonCode,
	GuaranteePerson=(SELECT GP.Name FROM GuaranteePerson GP WHERE GP.GuaranteePersonCode = G.GuaranteePersonCode),
	Godown = NULL,
	CustomICode = NULL,
	ItemName = NULL, 
	Qty = NULL, 
	SalePrice=NULL, 
	InstallmentFrequency=NULL, 
	NoOfInstallments=NULL,
	ContractAmt = NULL,
	UserCode=NULL,
	Remarks=NULL,
	Posted=NULL, 
	PostedBy = NULL,
	PostDate=NULL,
	Approved=NULL,
	ApprovedBy=NULL,
	ApprovedOn=NULL,
	Rejected=NULL,
	RejectedBy=NULL,
	RejectedOn=NULL
FROM
	Accounts, Customer , custguaranteeperson g
WHERE
	Accounts.AccCode = Customer.CustCode AND
	Customer.CustCode = G.CustCode AND
	Customer.CustCode NOT IN (SELECT CustCode FROM InstallmentHeader)
UNION
SELECT
	Code=NULL, 
	SaleInvCode=NULL,
	Date=NULL,
	AliasName = NULL,
	CustCode = Accounts.AccCode,
	Customer = Accounts.Name,
	GuaranteePersonCode=NULL,
	GuaranteePerson=NULL,
	Godown = NULL,
	CustomICode = NULL,
	ItemName = NULL, 
	Qty = NULL, 
	SalePrice=NULL, 
	InstallmentFrequency=NULL, 
	NoOfInstallments=NULL,
	ContractAmt = NULL,
	UserCode=NULL,
	Remarks=NULL,
	Posted=NULL, 
	PostedBy = NULL,
	PostDate=NULL,
	Approved=NULL,
	ApprovedBy=NULL,
	ApprovedOn=NULL,
	Rejected=NULL,
	RejectedBy=NULL,
	RejectedOn=NULL
FROM
	Accounts, Customer
WHERE
	Accounts.AccCode = Customer.CustCode AND
	Customer.CustCode  NOT IN (SELECT CustCode FROM custguaranteeperson) AND
	Customer.CustCode NOT IN (SELECT CustCode FROM InstallmentHeader)
UNION
SELECT
	Code=NULL, 
	SaleInvCode=NULL,
	Date=NULL,
	AliasName = NULL,
	CustCode = NULL,
	Customer = NULL,
	GuaranteePersonCode=G.GuaranteePersonCode,
	GuaranteePerson=G.Name,
	Godown = NULL,
	CustomICode = NULL,
	ItemName = NULL, 
	Qty = NULL, 
	SalePrice=NULL, 
	InstallmentFrequency=NULL, 
	NoOfInstallments=NULL,
	ContractAmt = NULL,
	UserCode=NULL,
	Remarks=NULL,
	Posted=NULL, 
	PostedBy = NULL,
	PostDate=NULL,
	Approved=NULL,
	ApprovedBy=NULL,
	ApprovedOn=NULL,
	Rejected=NULL,
	RejectedBy=NULL,
	RejectedOn=NULL
FROM
	GuaranteePerson G
WHERE
	G.GuaranteePersonCode NOT IN (SELECT installmentguarantor.GuaranteePersonCode FROM installmentguarantor)
"
  sort="IF(ISNULL(code),2,1) A, code A"
)
