column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >=0 and Real(GetText()) < 100" validationmsg="'Discount % value should be between 0 and 100'" name=discperc dbname="discperc"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=long updatewhereclause=yes name=rowgroup dbname="rowgroup"  )
