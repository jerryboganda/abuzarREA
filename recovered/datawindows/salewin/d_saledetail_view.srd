column=(type=decimal(5) updatewhereclause=yes name=packprice dbname="packprice"  )
column=(type=decimal(4) updatewhereclause=yes name=purunitrate dbname="purunitrate"  )
column=(type=decimal(4) updatewhereclause=yes name=rppunitrate dbname="rppunitrate"  )
column=(type=decimal(5) updatewhereclause=yes name=batchcost dbname="BatchCost"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=alternatepurprice dbname="alternatepurprice"  )
column=(type=long updatewhereclause=yes name=itemalertcode dbname="itemalertcode"  )
column=(type=decimal(3) updatewhereclause=yes name=unitweight dbname="UnitWeight"  )
column=(type=decimal(3) updatewhereclause=yes name=packingfactor dbname="PackingFactor"  )
column=(type=decimal(4) updatewhereclause=yes name=packcapacity dbname="PackCapacity"  )
column=(type=decimal(8) updatewhereclause=yes name=areavolume dbname="AreaVolume"  )
column=(type=decimal(4) updatewhereclause=yes initial="1" name=length dbname="Length"  )
column=(type=decimal(15) updatewhereclause=yes initial="0" name=rateperlength dbname="RatePerLength"  )
column=(type=decimal(6) updatewhereclause=yes name=pcs dbname="PCS"  )
column=(type=char(17) updatewhereclause=yes name=cartons dbname="Cartons"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=long updatewhereclause=yes initial="0" name=taxflag dbname="taxflag"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(4) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Pack Qty should be greater than or equal to zero'" initial="0" name=packqtyforsale dbname="packqtyforsale"  )
column=(type=decimal(4) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Bonus Qty should be greater than or equal to zero'" initial="0" name=bonuspackqtyforsale dbname="bonuspackqtyforsale"  )
column=(type=decimal(4) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Pack Price should be greater than or equal to zero'" initial="0" name=packsaleprice dbname="PackSalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=commissionperunit dbname="CommissionPerUnit"  )
column=(type=decimal(2) updatewhereclause=yes name=commissionperc dbname="CommissionPerc"  )
column=(type=long updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="~"Please enter valid value for Total Pieces~"" initial="1" name=totalpieces dbname="TotalPieces"  )
column=(type=long updatewhereclause=yes initial="0" name=piecesinhand dbname="PiecesInHand"  )
column=(type=decimal(6) updatewhereclause=yes validation="Real(GetText()) >=0 and Real(GetText()) <= 100" validationmsg="'Extra Tax % value should be between 0 and 100'" initial="0" name=extrataxperc dbname="ExtraTaxPerc"  )
column=(type=long updatewhereclause=yes initial="1" name=myrowid dbname="MyRowID"  )
column=(type=char(100) updatewhereclause=yes name=yourlotno dbname="YourLotNo"  )
column=(type=datetime updatewhereclause=yes name=yourexpiry dbname="YourExpiry"  )
column=(type=char(100) updatewhereclause=yes name=yourpacking dbname="YourPacking"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="1" name=looseqty dbname="looseqty"  )
 retrieve="SELECT
	item.customicode,  
	SaleDetail.AlternateCustomICode,
	itemname= item.name,  
	itemtypecode = item.itemtypecode,
	locksaleprice = dbo.item.locksaleprice, 
	lockdiscperc = dbo.item.lockdiscperc, 
	AllowSaleInDecimalQty=dbo.item.AllowSaleInDecimalQty,
	currlistrow = 0, 
	stock     = 0.0000, 
	QuickSearch=SPACE(100),
	itempacking=(SELECT IP.Name FROM ItemPacking IP WHERE IP.Packcode=saledetail.icode),
	packingdesc=item.packingdesc,
	qtysale=item.saleqty,
	bonus=item.bonusqty,
	totalstock= 0.0000, 
	purprice=0.00,
	recentpurprice=0.00,
	avgprice=0.000,
	LatestNetRate=0.00,
	itemtotalval=space(30),
	assgcode  = 1, 
	updatesaleprice = 'N',
	saledetail.saleinvcode,   
	saledetail.icode,   
	saledetail.gcode,
	itemmetercode=saledetail.itemmetercode,
	itemmetername=(SELECT IM.Name FROM ItemMeter IM WHERE IM.itemmetercode=saledetail.itemmetercode),
	meterreading = saledetail.meterreading,
	PreDiscPerc=max(ROUND( (Saledetail.itemflatdisc / CASE WHEN Saledetail.SalePrice > 0 THEN Saledetail.SalePrice ELSE 1 END) * 100, 2)),
	itemflatdisc = max(saledetail.itemflatdisc),
	Id        = max(saledetail.IDENTITYCOL), 
	packunits = max(saledetail.packunits),
	saleprice = max(saledetail.saleprice),
	discprice=0.00,
	pricepolicyapplied = 0,
	rate      = max(saledetail.rate),
	salestax  = max(saledetail.salestax), 
	Due       = max(Due),
	SatisfiedDate = max(SatisfiedDate),
	DueQty    = 0.0000,
	packqty   = sum(saledetail.packqty),
	SaleItemDescription =  max( saledetail.SaleItemDescription),
	InsCode =  Max(saledetail.InsCode),
	DescICode =  max( saledetail.DescICode),
	claimable=max(saledetail.claimable),
	claimablediscperc=max(saledetail.claimablediscperc),
	discperc  = max(saledetail.discperc),
	itemcode = 0,
	rowgroup=saledetail.rowgroup,
	retailprice=item.retailprice,
	saleorderrowid=saledetail.saleorderrowid,
	salerowid=saledetail.salerowid,
	issuerowid=saledetail.issuerowid,
	RefusalSaleRowID = saledetail.RefusalSaleRowID,
	sourcesaleinvcode=saledetail.sourcesaleinvcode,
	packprice = max(saledetail.packprice),
	purunitrate = max(saledetail.purunitrate),
	rppunitrate = max(saledetail.rppunitrate),
	BatchCost = max(saledetail.BatchCost),
	alternatepurprice = max(saledetail.alternatepurprice),
	itemalertcode = item.itemalertcode,
	UnitWeight = item.UnitWeight,
	PackingFactor = item.PackingFactor,
	PackCapacity = item.PackCapacity,
	AreaVolume = item.AreaVolume,
	Length = item.Length,
	RatePerLength = Round(max(saledetail.saleprice) / CASE WHEN Item.Length > 0 THEN Item.Length ELSE 1 END, 2),
	PCS=ROUND(sum(saledetail.looseqty) / CASE WHEN item.AreaVolume IS NULL OR item.AreaVolume <= 0 THEN 1 ELSE item.AreaVolume END, 6),
	Cartons= LTRIM(RTRIM(STR(CAST(((ROUND(sum(saledetail.looseqty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6)) / CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END) AS INT), 7, 0))) + ' : ' +
		LTRIM(RTRIM(STR(((CAST(ROUND(sum(saledetail.looseqty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6) AS INT)) % CAST(CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END AS INT)), 7, 0))),
	HeaderNo = Item.HeaderNo,
	taxflag = 1,
	unitsalestax=max(saledetail.unitsalestax),
	gstperc=max(saledetail.gstperc),
	packqtyforsale = Max(saledetail.packqtyforsale) , 
	bonuspackqtyforsale = Max(saledetail.bonuspackqtyforsale),
	PackSalePrice = Max(saledetail.PackSalePrice),
	CommissionPerUnit=Max(saledetail.commissionperunit),
	CommissionPerc=Max(saledetail.commissionperc),
	TotalPieces=sum (saledetail.TotalPieces),
	PiecesInHand=MAX(saledetail.piecesinhand),
	ExtraTaxPerc=max((((saledetail.looseqty +saledetail.bonusqty) * saledetail.unitsalestax) / CASE WHEN (SaleDetail.LooseQty * (SaleDetail.SalePrice -  SaleDetail.ItemFlatDisc) * (1 - SaleDetail.DiscPerc * 0.01)) <= 0 THEN 1 ELSE 	(SaleDetail.LooseQty * (SaleDetail.SalePrice -  SaleDetail.ItemFlatDisc) * (1 - SaleDetail.DiscPerc * 0.01)) END) * 100),
	MyRowID = 0,
	YourLotNo = MAX(saledetail.YourLotNo),
	YourExpiry = MAX(saledetail.YourExpiry),
	YourPacking = MAX(saledetail.YourPacking),

	bonusqty=sum (saledetail.bonusqty),
	looseqty  = sum(saledetail.looseqty) 

FROM 
	saledetail, 
	item 

WHERE 
	( dbo.saledetail.saleinvcode = :ar_SaleInvCode )    AND
	( saledetail.icode = item.icode )
         
GROUP BY 
	saledetail.saleinvcode, 
	saledetail.icode, 
	saledetail.RowGroup,
	saledetail.gcode, 
	saledetail.itemmetercode,
	saledetail.meterreading,
	saledetail.saleorderrowid,
	saledetail.salerowid,
	saledetail.issuerowid,
	saledetail.RefusalSaleRowID,
	saledetail.sourcesaleinvcode,
	item.customicode, 
	SaleDetail.AlternateCustomICode,
	item.saleqty, 
	item.bonusqty, 
	item.name,
	item.itemtypecode,
	item.itemalertcode,
	item.UnitWeight,
	item.PackingFactor,
	item.locksaleprice,
	item.lockdiscperc,
	item.AllowSaleInDecimalQty,
	item.retailprice,
	item.PackCapacity,
	item.AreaVolume,
	item.Length,
	item.packingdesc,
	Item.HeaderNo
UNION ALL
SELECT
	item.customicode,  
	AlternateCustomICode=SPACE(100),
	itemname= item.name,  
	itemtypecode = item.itemtypecode,
	locksaleprice = dbo.item.locksaleprice, 
	lockdiscperc = dbo.item.lockdiscperc, 
	AllowSaleInDecimalQty=dbo.item.AllowSaleInDecimalQty,
	currlistrow = 0, 
	stock     = 0.0000, 
	QuickSearch=SPACE(100),
	itempacking=(SELECT IP.Name FROM ItemPacking IP WHERE IP.Packcode=saledetail.icode),
	packingdesc=item.packingdesc,
	qtysale=item.saleqty,
	bonus=item.bonusqty,
	totalstock= 0.0000, 
	purprice=0.00,
	recentpurprice=0.00,
	avgprice=0.000,
	LatestNetRate=0.00,
	itemtotalval=space(30),
	assgcode  = 1, 
	updatesaleprice = 'N',
	saledetail.saleinvcode,   
	saledetail.icode,   
	saledetail.gcode,
	itemmetercode=NULL,
	itemmetername=NULL,
	meterreading = NULL,
	PreDiscPerc=max(ROUND( (Saledetail.itemflatdisc / CASE WHEN Saledetail.SalePrice > 0 THEN Saledetail.SalePrice ELSE 1 END) * 100, 2)),
	itemflatdisc = max(saledetail.itemflatdisc),
	Id        = max(saledetail.IDENTITYCOL), 
	packunits = max(saledetail.packunits),
	saleprice = max(saledetail.saleprice),
	discprice=0.00,
	pricepolicyapplied = 0,
	rate      = max(saledetail.rate),
	salestax  = 0.00, 
	Due       = NULL,
	SatisfiedDate = NULL,
	DueQty    = 0.0000,
	packqty   = 0,
	SaleItemDescription =  max( saledetail.SaleItemDescription),
	InsCode =  NULL,
	DescICode =  max( saledetail.DescICode),
	claimable=max(saledetail.claimable),
	claimablediscperc=max(saledetail.claimablediscperc),
	discperc  = max(saledetail.discperc),
	itemcode = 0,
	rowgroup=saledetail.rowgroup,
	retailprice=item.retailprice,
	saleorderrowid=NULL,
	salerowid=saledetail.salerowid,
	issuerowid=saledetail.issuerowid,
	RefusalSaleRowID = NULL,
	sourcesaleinvcode=saledetail.sourcesaleinvcode,
	packprice = max(saledetail.packprice),
	purunitrate = 0.00,
	rppunitrate = 0.00,
	BatchCost = 0.00,
	alternatepurprice = max(saledetail.alternatepurprice),
	itemalertcode = item.itemalertcode,
	UnitWeight = item.UnitWeight,
	PackingFactor = item.PackingFactor,
	PackCapacity = item.PackCapacity,
	AreaVolume = item.AreaVolume,
	Length = item.Length,
	RatePerLength = Round(max(saledetail.saleprice) / CASE WHEN Item.Length > 0 THEN Item.Length ELSE 1 END, 2),
	PCS=ROUND(sum(saledetail.looseqty) / CASE WHEN item.AreaVolume IS NULL OR item.AreaVolume <= 0 THEN 1 ELSE item.AreaVolume END, 6),
	Cartons= LTRIM(RTRIM(STR(CAST(((ROUND(sum(saledetail.looseqty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6)) / CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END) AS INT), 7, 0))) + ' : ' +
		LTRIM(RTRIM(STR(((CAST(ROUND(sum(saledetail.looseqty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6) AS INT)) % CAST(CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END AS INT)), 7, 0))),
	HeaderNo = Item.HeaderNo,
	taxflag = 1,
	unitsalestax=max(saledetail.unitsalestax),
	gstperc=max(saledetail.gstperc),
	packqtyforsale = Max(saledetail.packqtyforsale) , 
	bonuspackqtyforsale = Max(saledetail.bonuspackqtyforsale),
	PackSalePrice = 0.00,
	CommissionPerUnit=0.00,
	CommissionPerc=0.00,
	TotalPieces=0,
	PiecesInHand=0,
	ExtraTaxPerc=max((((saledetail.looseqty +saledetail.bonusqty) * saledetail.unitsalestax) / CASE WHEN (SaleDetail.LooseQty * (SaleDetail.SalePrice -  SaleDetail.ItemFlatDisc) * (1 - SaleDetail.DiscPerc * 0.01)) <= 0 THEN 1 ELSE 	(SaleDetail.LooseQty * (SaleDetail.SalePrice -  SaleDetail.ItemFlatDisc) * (1 - SaleDetail.DiscPerc * 0.01)) END) * 100),
	MyRowID = 0,
	YourLotNo = NULL,
	YourExpiry = NULL,
	YourPacking = NULL,

	bonusqty=sum (saledetail.bonusqty),
	looseqty  = sum(saledetail.looseqty) 

FROM 
	saleinvdetail saledetail, 
	item 

WHERE 
	( saledetail.saleinvcode = :ar_SaleInvCode )    AND
	( saledetail.icode = item.icode )
         
GROUP BY 
	saledetail.saleinvcode, 
	saledetail.icode, 
	saledetail.RowGroup,
	saledetail.gcode, 
	saledetail.salerowid,
	saledetail.issuerowid,
	saledetail.sourcesaleinvcode,
	item.customicode, 
	item.saleqty, 
	item.bonusqty, 
	item.name,
	item.itemtypecode,
	item.itemalertcode,
	item.UnitWeight,
	item.PackingFactor,
	item.locksaleprice,
	item.lockdiscperc,
	item.AllowSaleInDecimalQty,
	item.retailprice,
	item.PackCapacity,
	item.AreaVolume,
	item.Length,
	item.packingdesc,
	Item.HeaderNo
ORDER BY 
	Id"
  arguments=(("ar_SaleInvCode", number))
 sort="id A"
