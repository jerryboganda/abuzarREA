compute(name=c_detaildwtotal visible="1" tag="" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" tooltip.enabled="0" tooltip.isbubble="0" tooltip.textcolor="134217751" tooltip.backcolor="134217752" tooltip.icon="0" tooltip.maxwidth="0" tooltip.transparency="0" tooltip.delay.visible="32000" tooltip.delay.initial="0" tooltip.hasclosebutton="0" transparency="0" background.mode="2" background.color="80263581" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.length="100" background.gradient.repetition.count="0" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" color="0" x="3483" y="3" height="61" width="439" format="###,###,##0.00" expression="sum((  ( looseqty *  (saleprice - itemflatdisc) )  +   ( packqty *  (saleprice - itemflatdisc) * packunits ) ) *  ( 1-  (  discperc  *  .01 )  )  for all) " alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_totaldiscount visible="0" tag="" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" tooltip.enabled="0" tooltip.isbubble="0" tooltip.textcolor="134217751" tooltip.backcolor="134217752" tooltip.icon="0" tooltip.maxwidth="0" tooltip.transparency="0" tooltip.delay.visible="32000" tooltip.delay.initial="0" tooltip.hasclosebutton="0" transparency="0" background.mode="2" background.color="80263581" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.length="100" background.gradient.repetition.count="0" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" color="0" x="2743" y="3" height="61" width="169" format="[GENERAL]" expression="sum(looseqty * itemflatdisc for all) + if(rate - saleprice > 0, sum(looseqty * (rate - saleprice) for all), 0) + sum( round(((saleprice - itemflatdisc)*discperc*0.01)*looseqty,2) for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
