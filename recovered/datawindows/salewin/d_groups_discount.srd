column=(type=char(1) updatewhereclause=yes name=consideralldiscountsonitem dbname="Groups.ConsiderAllDiscountsOnItem"  )
 retrieve="select groups.groupcode,
		 saleinvflatdisc,
		 saleitemdiscperc,
		 accumulateddiscperc,
		 accumdiscperccaution,
		 servicediscperclimit,
		 maxserviceflatdisc,
		 maxserviceinvflatdisc,
		 ConsiderAllDiscountsOnItem
from groups,usergroups
where usergroups.usercode=:ai_usercode and
		groups.groupcode =usergroups.groupcode"
  arguments=(("ai_usercode", number))
)
