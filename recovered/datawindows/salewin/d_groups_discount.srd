table(column=(type=long update=yes updatewhereclause=yes name=groupcode dbname="Groups.groupcode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleinvflatdisc dbname="Groups.saleinvflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleitemdiscperc dbname="Groups.saleitemdiscperc"  )
