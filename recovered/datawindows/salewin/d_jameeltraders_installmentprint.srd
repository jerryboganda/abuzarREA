table(column=(type=long update=yes updatewhereclause=yes name=code dbname="InstallmentHeader.InstallmentCode"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="InstallmentHeader.Date"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long update=yes updatewhereclause=yes initial="19" name=custcode dbname="InstallmentHeader.CustCode" 
 values=""  )
column=(type=char(60) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=char(60) updatewhereclause=yes name=resaddress dbname="ResAddress"  )
column=(type=char(300) updatewhereclause=yes name=offaddress dbname="OffAddress"  )
