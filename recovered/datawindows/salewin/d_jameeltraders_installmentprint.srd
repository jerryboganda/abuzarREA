column=(type=char(75) updatewhereclause=yes name=customicode dbname="CustomICode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="InstallmentHeader.ICode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=packunits dbname="InstallmentHeader.PackUnits"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) > 0" initial="1" name=qty dbname="InstallmentHeader.Qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Item Sale Price~"" initial="0" name=saleprice dbname="InstallmentHeader.SalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Item Flat Discount~"" initial="0" name=itemflatdisc dbname="InstallmentHeader.ItemFlatDisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid Discount Percentage~"" initial="0" name=discperc dbname="InstallmentHeader.DiscPerc"  )
column=(type=decimal(17) updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid Mark-Up Percentage~"" initial="0" name=markupperc dbname="MarkupPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=markupamt dbname="InstallmentHeader.MarkupAmt"  )
column=(type=decimal(17) updatewhereclause=yes initial="0" name=processingfeeperc dbname="ProcessingFeePerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Processing Fee~"" initial="0" name=processingfee dbname="InstallmentHeader.ProcessingFee"  )
column=(type=decimal(15) updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid Down Payment Percentage~"" initial="0" name=downpaymentperc dbname="DownPaymentPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=downpayment dbname="InstallmentHeader.DownPayment"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=installmentfrequency dbname="InstallmentHeader.InstallmentFrequency" 
 values="Daily	1/Weekly	7/Half Monthly	15/Monthly	30/Quarterly	90/Semi-Annualy	180/Yearly//Annually	360/"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid no. of Installments~"" initial="1" name=noofinstallments dbname="InstallmentHeader.NoOfInstallments"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=firstduedate dbname="InstallmentHeader.FirstDueDate"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="InstallmentHeader.UserCode" 
 values=""  )
