table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=long updatewhereclause=yes name=icode dbname="Icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="LooseQty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=long updatewhereclause=yes name=gcode dbname="Gcode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="ItemFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="UnitSalesTax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="GstPerc"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="AvgPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=long updatewhereclause=yes name=salerowid dbname="SaleRowID"  )
column=(type=char(100) updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=decimal(5) updatewhereclause=yes name=packprice dbname="PackPrice"  )
column=(type=decimal(4) updatewhereclause=yes name=packqtyforsale dbname="PackQtyForSale"  )
column=(type=decimal(4) updatewhereclause=yes name=bonuspackqtyforsale dbname="BonusPackQtyForSale"  )
column=(type=long updatewhereclause=yes name=sourcesaleinvcode dbname="SourceSaleInvcode"  )
column=(type=char(1) updatewhereclause=yes name=invselected dbname="INVSELECTED" 
 values="	Y/	N"  )
column=(type=char(1) updatewhereclause=yes name=selected dbname="SELECTED" 
 values="	Y/	N"  )
column=(type=char(1) updatewhereclause=yes name=status dbname="Status" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	SaleInvCode=SaleInvCode, 
	Date,
	InvTotal, 
	Icode,
	AliasName,
	ItemName,
	Godown,	
	LooseQty,
	BonusQty,
	Gcode,
	Batch,
	Expiry,
	PackUnits,
	SalePrice,
	DiscPerc,
	ItemFlatDisc,
	UnitSalesTax,
	GstPerc,
	AvgPrice,
	Rate,
	SaleRowID,
	SaleItemDescription,
	PackPrice,
	PackQtyForSale,
	BonusPackQtyForSale,
	SourceSaleInvcode,
	INVSELECTED='N',
	SELECTED='N',
	Status
FROM
	(SELECT 
		SL.SaleInvCode, 
		SL.Date, 
		SL.InvTotal, 
		I.Icode,
		AliasName = I.CustomICode,
		ItemName = I.Name,
		Godown = G.Name,	
		SD.LooseQty,
		SD.BonusQty,
		SD.Gcode,
		SD.Batch,
		SD.Expiry,
		SD.PackUnits,
		SD.SalePrice,
		SD.DiscPerc,
		SD.ItemFlatDisc,
		SD.UnitSalesTax,
		SD.GstPerc,
		SD.AvgPrice,
		SD.Rate,
		SaleRowID=SD.RowID,
		SD.SaleItemDescription,
		SD.PackPrice,
		SD.PackQtyForSale,
		SD.BonusPackQtyForSale,
		SourceSaleInvcode=SL.SaleInvCode,
		INVSELECTED='N',
		SELECTED='N',
		Status=CASE (SELECT Count(d.salerowid) FROM saleinvdetail d WHERE d.salerowid = SD.RowID) 
					WHEN NULL THEN 'N' 
					WHEN 0 THEN 'N' 
					ELSE 'Y' END
	FROM
		SaleLedger SL, SaleDetail SD, Item I, Godown G
	WHERE 
		SL.SaleInvCode IN (:ai_invcode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SL.ImpactInventory = 'Y' AND
		SD.ICode = I.ICode AND
		SD.GCode = G.GCode
	UNION ALL
	SELECT 
		SL.SaleInvCode, 
		SL.Date, 
		SL.InvTotal, 
		I.Icode,
		AliasName = I.CustomICode,
		ItemName = I.Name,
		Godown = G.Name,	
		SD.LooseQty,
		SD.BonusQty,
		SD.Gcode,
		SD.Batch,
		SD.Expiry,
		SD.PackUnits,
		SD.SalePrice,
		SD.DiscPerc,
		SD.ItemFlatDisc,
		SD.UnitSalesTax,
		SD.GstPerc,
		SD.AvgPrice,
		SD.Rate,
		SaleRowID=SD.RowID,
		SD.SaleItemDescription,
		SD.PackPrice,
		SD.PackQtyForSale,
		SD.BonusPackQtyForSale,
		SourceSaleInvcode=SL.SaleInvCode,
		INVSELECTED='N',
		SELECTED='N',
		Status=CASE (SELECT Count(d.salerowid) FROM saleinvdetail d WHERE d.salerowid = SD.RowID) 
					WHEN NULL THEN 'N' 
					WHEN 0 THEN 'N' 
					ELSE 'Y' END
	FROM
		SaleLedger SL, SaleInvDetail SD, Item I, Godown G
	WHERE 
		SL.SaleInvCode IN (:ai_invcode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SL.ImpactInventory = 'N' AND
		SD.ICode = I.ICode AND
		SD.GCode = G.GCode) T
ORDER BY
	:ai_ordercol"
  arguments=(("ai_invcode", numberlist), ("ai_ordercol", string))
)
