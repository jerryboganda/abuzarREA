compute(name=c_grossamt visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="67108864" color="0" x="626" y="3" height="61" width="987" format="[GENERAL]" expression="sum(looseqty * saleprice for all)" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
text(name=t_1 visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="67108864" color="0" alignment="1" border="0" x="626" y="3" height="61" width="987" text="Total:  " html.valueishtml="0" )
compute(name=c_sumgstval visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="67108864" color="0" x="5179" y="3" height="61" width="265" format="#,##0.00" expression="Sum ( Round(( c_itemtotal * gstperc * 0.01),2)  for all )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumtaxval visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="67108864" color="0" x="4681" y="3" height="61" width="270" format="#,##0.00" expression="Sum ( Round( unitsalestax  * (looseqty+bonusqty),2 ) for all )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_detaildwtotal visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="67108864" color="0" x="3973" y="3" height="61" width="357" format="###,##,##,##0.00" expression=" sum((  ( looseqty *  (saleprice -  itemflatdisc ))  +   ( packqty *  (saleprice -  itemflatdisc ) * packunits ) ) *  ( 1-  (  discperc  *  .01 )  )  for all) " alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumitemflatdisc visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="2" background.color="67108864" color="0" x="2450" y="3" height="61" width="270" format="####0.00" expression="sum(itemflatdisc*looseqty for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
