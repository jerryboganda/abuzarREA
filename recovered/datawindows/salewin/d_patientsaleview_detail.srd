column=(type=long update=yes updatewhereclause=yes initial="1" name=gcode dbname="Saledetail.gcode"  )
column=(type=long updatewhereclause=yes name=itemmetercode dbname="itemmetercode"  )
column=(type=char(100) updatewhereclause=yes name=itemmetername dbname="itemmetername"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=meterreading dbname="meterreading"  )
column=(type=decimal(15) updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) < 100" validationmsg="'Discount (%) must be between 0 and 100'" initial="0" name=prediscperc dbname="PreDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Item Flat Disc should be greater than zero~"" name=itemflatdisc dbname="Itemflatdisc"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= rate" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" name=discprice dbname="discprice"  )
column=(type=long updatewhereclause=yes initial="0" name=pricepolicyapplied dbname="pricepolicyapplied"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=salestax dbname="salestax"  )
column=(type=char(1) updatewhereclause=yes name=due dbname="Due"  )
column=(type=datetime updatewhereclause=yes name=satisfieddate dbname="SatisfiedDate"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=dueqty dbname="DueQty"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=packqty dbname="packqty"  )
column=(type=char(100) updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=long updatewhereclause=yes name=inscode dbname="InsCode"  )
column=(type=long updatewhereclause=yes name=descicode dbname="DescICode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=claimable dbname="claimable" 
 values="No	N/Yes	Y/"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) < 100" validationmsg="'Claimable Discount % value should be between 0 and 100'" initial="0" name=claimablediscperc dbname="claimablediscperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 and Real(GetText()) < 100" validationmsg="'Discount (%) must be between 0 and 100'" name=discperc dbname="discperc"  )
column=(type=long updatewhereclause=yes name=saleorderrowid dbname="saleorderrowid"  )
column=(type=long updatewhereclause=yes name=salerowid dbname="salerowid"  )
