header(height=437 color="536870912" )
summary(height=10 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=long updatewhereclause=yes name=guaranteepersoncode dbname="GuaranteePersonCode"  )
column=(type=char(100) updatewhereclause=yes name=guaranteeperson dbname="GuaranteePerson"  )
column=(type=char(100) updatewhereclause=yes name=fhname dbname="FHName"  )
column=(type=char(300) updatewhereclause=yes name=resaddress dbname="ResAddress"  )
column=(type=char(300) updatewhereclause=yes name=offaddress dbname="OffAddress"  )
column=(type=char(100) updatewhereclause=yes name=mobile dbname="Mobile"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(200) updatewhereclause=yes name=cast dbname="Cast"  )
column=(type=char(30) updatewhereclause=yes name=nic dbname="NIC"  )
column=(type=char(200) updatewhereclause=yes name=occupation dbname="Occupation"  )
 retrieve="SELECT 
	CustCode=(SELECT IH.CustCode FROM InstallmentHeader IH WHERE InstallmentCode = :ai_code),   
	GuaranteePersonCode=InstallmentGuarantor.GuaranteePersonCode,   
	GuaranteePerson=GuaranteePerson.Name,   
	FHName=GuaranteePerson.FHName,   
	ResAddress=GuaranteePerson.Address,   
	OffAddress=GuaranteePerson.OffAddress,   
	Mobile=GuaranteePerson.Mobile,
	Phone = GuaranteePerson.Phone,
	Cast = GuaranteePerson.Education,
	NIC = GuaranteePerson.NIC,
	Occupation = GuaranteePerson.Occupation 
FROM 
	InstallmentGuarantor,   
	GuaranteePerson  
WHERE 
	GuaranteePerson.GuaranteePersonCode = InstallmentGuarantor.GuaranteePersonCode and  
	InstallmentGuarantor.InstallmentCode = :ai_code
"
  arguments=(("ai_code", number))
)
