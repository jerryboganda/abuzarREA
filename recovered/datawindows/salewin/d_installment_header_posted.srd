table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="InstallmentHeader.InstallmentCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="InstallmentHeader.Date"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long update=yes updatewhereclause=yes initial="19" name=custcode dbname="InstallmentHeader.CustCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=gcode dbname="InstallmentHeader.GCode" 
 values=""  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=godownstock dbname="GodownStock"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="CustomICode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="InstallmentHeader.ICode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=packunits dbname="InstallmentHeader.PackUnits"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) > 0" initial="1" name=qty dbname="InstallmentHeader.Qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Item Sale Price~"" initial="0" name=saleprice dbname="InstallmentHeader.SalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Item Flat Discount~"" initial="0" name=itemflatdisc dbname="InstallmentHeader.ItemFlatDisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid Discount Percentage~"" initial="0" name=discperc dbname="InstallmentHeader.DiscPerc"  )
column=(type=decimal(17) updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid Mark-Up Percentage~"" initial="0" name=markupperc dbname="MarkupPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=markupamt dbname="InstallmentHeader.MarkupAmt"  )
column=(type=decimal(17) updatewhereclause=yes initial="0" name=processingfeeperc dbname="ProcessingFeePerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid Processing Fee~"" initial="0" name=processingfee dbname="InstallmentHeader.ProcessingFee"  )
column=(type=decimal(15) updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid Down Payment Percentage~"" initial="0" name=downpaymentperc dbname="DownPaymentPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=downpayment dbname="InstallmentHeader.DownPayment"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=installmentfrequency dbname="InstallmentHeader.InstallmentFrequency" 
 values="Daily	1/Weekly	7/Half Monthly	15/Monthly	30/Quarterly	90/Semi-Annualy	180/Yearly//Annually	360/"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid no. of Installments~"" initial="1" name=noofinstallments dbname="InstallmentHeader.NoOfInstallments"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=firstduedate dbname="InstallmentHeader.FirstDueDate"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="InstallmentHeader.UserCode" 
 values=""  )
column=(type=char(255) update=yes updatewhereclause=yes name=remarks dbname="InstallmentHeader.Remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="InstallmentHeader.Posted"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="InstallmentHeader.PostedBy"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="InstallmentHeader.PostDate"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=approved dbname="InstallmentHeader.Approved"  )
column=(type=long update=yes updatewhereclause=yes name=approvedby dbname="InstallmentHeader.ApprovedBy"  )
column=(type=datetime update=yes updatewhereclause=yes name=approvedon dbname="InstallmentHeader.ApprovedOn"  )
column=(type=long update=yes updatewhereclause=yes name=smancode dbname="InstallmentHeader.SManCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=inquirypersoncode dbname="InstallmentHeader.InquiryPersonCode" 
 values=""  )
 retrieve="SELECT
	InstallmentHeader.InstallmentCode, 
	InstallmentHeader.Date,
	AliasName = Accounts.AliasName,
	InstallmentHeader.CustCode,
	InstallmentHeader.GCode,
	GodownStock=0.0000,
	CustomICode = Item.CustomICode,
	InstallmentHeader.ICode, 
	InstallmentHeader.PackUnits, 
	InstallmentHeader.Qty, 
	InstallmentHeader.SalePrice, 
	InstallmentHeader.ItemFlatDisc, 
	InstallmentHeader.DiscPerc, 
	MarkupPerc = ROUND((InstallmentHeader.MarkupAmt / CASE WHEN ROUND((InstallmentHeader.Qty * (InstallmentHeader.SalePrice - InstallmentHeader.ItemFlatDisc) * ( 1 - InstallmentHeader.DiscPerc * 0.01)), 2) > 0 THEN ROUND((InstallmentHeader.Qty * (InstallmentHeader.SalePrice - InstallmentHeader.ItemFlatDisc) * ( 1 - InstallmentHeader.DiscPerc * 0.01)),2) ELSE 1 END) * 100, 2),
	InstallmentHeader.MarkupAmt, 
	ProcessingFeePerc = ROUND((ProcessingFee / CASE WHEN ROUND((InstallmentHeader.Qty * (InstallmentHeader.SalePrice - InstallmentHeader.ItemFlatDisc) * ( 1 - InstallmentHeader.DiscPerc * 0.01)), 2) + InstallmentHeader.MarkupAmt > 0 THEN ROUND((InstallmentHeader.Qty * (InstallmentHeader.SalePrice - InstallmentHeader.ItemFlatDisc) * ( 1 - InstallmentHeader.DiscPerc * 0.01)), 2) + InstallmentHeader.MarkupAmt ELSE 1 END) * 100, 2), 
	InstallmentHeader.ProcessingFee, 
	DownPaymentPerc = ROUND((InstallmentHeader.DownPayment / CASE WHEN (ROUND((InstallmentHeader.Qty * (InstallmentHeader.SalePrice - InstallmentHeader.ItemFlatDisc) * ( 1 - InstallmentHeader.DiscPerc * 0.01)), 2) + InstallmentHeader.MarkupAmt + InstallmentHeader.ProcessingFee) > 0 THEN (ROUND((InstallmentHeader.Qty * (InstallmentHeader.SalePrice - InstallmentHeader.ItemFlatDisc) * ( 1 - InstallmentHeader.DiscPerc * 0.01)), 2) + InstallmentHeader.MarkupAmt + InstallmentHeader.ProcessingFee) ELSE 1 END) * 100, 2), 
	InstallmentHeader.DownPayment, 
	InstallmentHeader.InstallmentFrequency, 
	InstallmentHeader.NoOfInstallments,
	InstallmentHeader.FirstDueDate,
	InstallmentHeader.UserCode,
	InstallmentHeader.Remarks,
	InstallmentHeader.Posted, 
	InstallmentHeader.PostedBy,
	InstallmentHeader.PostDate,
	InstallmentHeader.Approved,
	InstallmentHeader.ApprovedBy,
	InstallmentHeader.ApprovedOn,
	InstallmentHeader.SManCode,
	InstallmentHeader.InquiryPersonCode
FROM
	InstallmentHeader, Accounts, Item
WHERE
	InstallmentHeader.InstallmentCode = :ai_code AND
	InstallmentHeader.CustCode = Accounts.AccCode AND
	InstallmentHeader.ICode = Item.ICode
"
  update="InstallmentHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
