table(column=(type=long key=yes updatewhereclause=yes name=code dbname="SaleLedger.saleinvcode"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Flat Discount should be greater equal zero'" initial="0" name=flatdisc dbname="SaleLedger.flatdisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Miscellaneous Charges should be greater equal zero'" initial="0" name=misccharges dbname="SaleLedger.misccharges"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=misccharges1 dbname="SaleLedger.MiscCharges1"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=misccharges2 dbname="SaleLedger.MiscCharges2"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=misccharges3 dbname="SaleLedger.MiscCharges3"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=misccharges4 dbname="SaleLedger.MiscCharges4"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=misccharges5 dbname="SaleLedger.MiscCharges5"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=salestax dbname="SaleLedger.salestax"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100" validationmsg="'Discount % should be between 0 and 100'" initial="0" name=invdiscperc dbname="SaleLedger.discperc"  )
column=(type=long updatewhereclause=yes initial="99999" name=icode dbname="Icode"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=purdisc dbname="Stock"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="TotalStock"  )
column=(type=long updatewhereclause=yes name=piecesinhand dbname="PiecesInHand"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Invoice total can not be negative'" initial="0" name=total dbname="Total"  )
column=(type=decimal(2) updatewhereclause=yes name=purdiscperc dbname="purdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=invgstperc1 dbname="InvGSTPerc1"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxamt dbname="AdvanceTaxAmt"  )
column=(type=decimal(3) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(2) updatewhereclause=yes name=rpp dbname="rpp"  )
column=(type=decimal(2) updatewhereclause=yes name=rppmargin dbname="rppmargin"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=char(20) updatewhereclause=yes name=bonusratio dbname="BonusRatio"  )
column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="retailprice"  )
column=(type=decimal(2) updatewhereclause=yes name=grossforaccumdisc dbname="grossforaccumdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=totaldiscount dbname="totaldiscount"  )
column=(type=decimal(2) updatewhereclause=yes name=accumulateddiscperc dbname="accumulateddiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=latestnetrate dbname="LatestNetRate"  )
column=(type=decimal(2) updatewhereclause=yes name=salereturnamt dbname="salereturnamt"  )
column=(type=long updatewhereclause=yes initial="1" name=currencycode dbname="SaleLedger.CurrencyCode"  )
column=(type=decimal(5) updatewhereclause=yes initial="1" name=conversionrate dbname="SaleLedger.ConversionRate"  )
 retrieve="SELECT 
	saleledger.saleinvcode,   
	saleledger.flatdisc,   
	saleledger.misccharges,   

	saleledger.MiscCharges1,
	saleledger.MiscCharges2,
	saleledger.MiscCharges3,
	saleledger.MiscCharges4,
	saleledger.MiscCharges5,

	saleledger.salestax,   
	saleledger.discperc,
	Icode = 0, 
	itemtotalval=space(30),
	Stock = 0.0000,
	TotalStock = 0.0000,
	PiecesInHand=0,
	Total = 0.00,
	purdiscperc = 0.00,
	InvGSTPerc1= saleledger.Invgstperc1,
	AdvanceTaxAmt = saleledger.AdvanceTaxAmt,
	avgprice=0.000,
	rpp=0.00,
	rppmargin=0.00,
	purprice=0.00,
	BonusRatio=SPACE(20),
	retailprice=0.00,
	grossforaccumdisc = 0.00,
	totaldiscount = 0.00,
	accumulateddiscperc = 0.00,
	LatestNetRate=0.00,
	salereturnamt = ISNULL((SELECT netamt=dbo.fn_GetSRBufferInvTotal(SRBufferInvCode)), 0.00),
	CurrencyCode,
	ConversionRate
FROM 
	saleledger  
WHERE 
	saleledger.saleinvcode = :ar_invcode    
"
  update="saleledger" updatewhere=0 updatekeyinplace=yes
  arguments=(("ar_invcode", number))
)
