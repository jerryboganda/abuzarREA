footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=issueinvcode dbname="IssueDetail.issueinvcode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="IssueDetail.icode"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=batch dbname="IssueDetail.batch"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes name=expiry dbname="IssueDetail.expiry"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=gcode dbname="IssueDetail.gcode"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=qty dbname="IssueDetail.qty"  )
column=(type=long key=yes updatewhereclause=yes name=issuerowid dbname="issuerowid"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=price dbname="price"  )
column=(type=char(100) update=yes updatewhereclause=yes name=itemdescription dbname="itemdescription"  )
column=(type=long update=yes updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="saleqty"  )
 retrieve="SELECT
	issuedetail.issueinvcode,   
	issuedetail.icode,   
	issuedetail.batch, 
	issuedetail.expiry,   
	issuedetail.gcode,
	issuedetail.qty,
	issuerowid=issuedetail.issrowid,	
	price = issuedetail.price,
	itemdescription=issuedetail.itemdescription,
	packunits = issuedetail.packunits,
	saleqty = 
		ISNULL(
			(SELECT SUM(SD.LooseQty) 
			FROM SaleInvDetail SD 
			WHERE SD.IssueRowID = IssueDetail.IssRowId), 0) +
		ISNULL(
			(SELECT SUM(SD.LooseQty) 
			FROM SaleDetail SD 
			WHERE SD.IssueRowID = IssueDetail.IssRowId), 0)
FROM
	IssueDetail
WHERE
	( dbo.issuedetail.issueinvcode = :ar_IssueInvCode )
ORDER BY IssueDetail.IssRowId"
  update="IssueDetail" updatewhere=1 updatekeyinplace=no
  arguments=(("ar_IssueInvCode", number))
)
