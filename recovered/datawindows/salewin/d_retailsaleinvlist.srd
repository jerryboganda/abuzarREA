table(column=(type=long updatewhereclause=yes name=code dbname="SaleLedger.saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleLedger.date"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="patientcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="SaleLedger.headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="SaleLedger.headerinvno"  )
column=(type=long updatewhereclause=yes name=altersaleinvcode dbname="SaleLedger.altersaleinvcode"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=long updatewhereclause=yes name=reprintingcounter dbname="SaleLedger.ReprintingCounter"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SaleLedger.Remarks"  )
column=(type=datetime updatewhereclause=yes name=originaldate dbname="SaleLedger.OriginalDate"  )
column=(type=decimal(2) updatewhereclause=yes name=totalofsalereturns dbname="SaleLedger.TotalOfSaleReturns"  )
column=(type=char(500) updatewhereclause=yes name=listofsrinvoices dbname="SaleLedger.ListofSrInvoices"  )
column=(type=long updatewhereclause=yes name=modifycounter dbname="SaleLedger.ModifyCounter"  )
column=(type=char(1) updatewhereclause=yes name=deleted dbname="SaleLedger.Deleted"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="SaleLedger.custrefno"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="area"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="patientregno"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=saletype dbname="SaleType"  )
column=(type=long updatewhereclause=yes name=saletypeinvno dbname="SaleTypeInvNo"  )
column=(type=char(1) updatewhereclause=yes name=fiscalized dbname="Fiscalized" 
 values="Yes	Y/No	N/"  )
column=(type=datetime updatewhereclause=yes name=fiscalizedon dbname="FiscalizedOn"  )
column=(type=char(100) updatewhereclause=yes name=fiscalinvoiceno dbname="FiscalInvoiceNo"  )
column=(type=char(1) updatewhereclause=yes name=paidviaapi dbname="PaidViaAPI"  )
column=(type=char(255) updatewhereclause=no name=contactcellno dbname="ContactCellNo"  )
column=(type=long updatewhereclause=yes name=sourcemodule dbname="sourcemodule" 
 values=""  )
column=(type=long updatewhereclause=yes name=sourcedocument dbname="sourcedocument"  )
column=(type=char(1) updatewhereclause=yes name=pushed dbname="Pushed" 
 values="Yes	Y/No	N/"  )
column=(type=datetime updatewhereclause=yes name=pushedon dbname="PushedOn"  )
column=(type=char(60) updatewhereclause=no name=pushedby dbname="PushedBy"  )
column=(type=char(203) updatewhereclause=no name=pushedfor dbname="PushedFor"  )
 retrieve="SELECT  
	dbo.saleledger.saleinvcode , 
	dbo.saleledger.date ,
	custcode=dbo.saleledger.custcode,
	patientcode=dbo.saleledger.patientcode,
	dbo.saleledger.headerno,
	dbo.saleledger.headerinvno,
	dbo.saleledger.altersaleinvcode,
	dbo.users.username,
	posted = dbo.saleledger.posted, 
	PostedBy = IsNull((Select username from users 
					where dbo.saleledger.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
					where dbo.saleledger.modifiedby = dbo.users.usercode), ''),
	NetAmount = saleledger.invtotal ,
	dbo.saleledger.ReprintingCounter,
	dbo.saleledger.Remarks,
	dbo.saleledger.OriginalDate,
	dbo.saleledger.TotalOfSaleReturns,
	dbo.saleledger.ListofSrInvoices,
	dbo.saleledger.ModifyCounter,
	dbo.saleledger.Deleted,
	dbo.saleledger.custrefno,
	customer = dbo.accounts.name,
	area=(select name from area,customer where area.areacode=customer.areacode and customer.custcode=saleledger.custcode),
	patientregno=(select regno from patient where patient.patientcode=saleledger.patientcode),
	patientname=(select name from patient where patient.patientcode=saleledger.patientcode),
	StudentCode=dbo.SaleLedger.StudentCode,
	SaleType = (SELECT ST.Name FROM SaleType ST WHERE ST.SaleTypeCode = saleledger.SaleTypeCode),
	SaleTypeInvNo=saleledger.SaleTypeInvNo,
	Fiscalized = saleledger.Fiscalized,
	FiscalizedOn = saleledger.FiscalizedOn,
	FiscalInvoiceNo = saleledger.FiscalInvoiceNo,
	PaidViaAPI = SaleLedger.PaidViaAPI,
	ContactCellNo = (SELECT CC.Mobile FROM ContactCard CC WHERE CC.ContactCardCode = SaleLedger.ContactCardCode),
	sourcemodule = saleledger.moduleid,
	sourcedocument = saleledger.doccode,
	Pushed=SaleLedger.Pushed,
	PushedOn=SaleLedger.PushedOn,
	PushedBy=IsNull((Select username from users 
							where dbo.saleledger.PushedBy = dbo.users.usercode), ''),
	PushedFor = IsNull((SELECT S.Name + ' (' + S.InstanceID + ')' FROM Site S WHERE S.SiteCode=SaleLedger.TargetSiteCode),'')
FROM 
	dbo.saleledger, users, accounts
WHERE 
	dbo.saleledger.admissioncode IS NULL AND
	dbo.saleledger.custcode = dbo.accounts.acccode AND
	dbo.saleledger.salecatcode IN (:ai_SaleCatCode)  AND
	dbo.saleledger.posted IN (:as_Posted) AND
	dbo.saleledger.date > :ad_invdate AND
	(dbo.saleledger.salesmancode = dbo.users.usercode ) and
	:as_showrows = 'Y' AND 
	(dbo.saleledger.headerno IS NULL OR
		(dbo.saleledger.headerno in 
			(SELECT headercode FROM GroupAllowedHeader 
			WHERE GroupCode = :ai_groupcode and module = :ai_module))) AND
	saleledger.impactinventory  ='Y' AND
	Exists (SELECT DBO.Fn_GetPreference('AllowedGroupsInSalesList') WHERE DBO.Fn_GetPreference('AllowedGroupsInSalesList') = 'N')
UNION ALL
SELECT 
	dbo.saleledger.saleinvcode , 
	dbo.saleledger.date ,
	custcode=dbo.saleledger.custcode,
	patientcode=dbo.saleledger.patientcode,
	dbo.saleledger.headerno,
	dbo.saleledger.headerinvno,
	dbo.saleledger.altersaleinvcode,
	dbo.users.username,
	posted = dbo.saleledger.posted,
	PostedBy = IsNull((Select username from users 
					where dbo.saleledger.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
					where dbo.saleledger.modifiedby = dbo.users.usercode), ''),
	NetAmount = saleledger.invtotal ,
	dbo.saleledger.ReprintingCounter,
	dbo.saleledger.Remarks,
	dbo.saleledger.OriginalDate,
	dbo.saleledger.TotalOfSaleReturns,
	dbo.saleledger.ListofSrInvoices,
	dbo.saleledger.ModifyCounter,
	dbo.saleledger.Deleted,
	dbo.saleledger.custrefno,
	customer = dbo.accounts.name,
	area=(select name from area,customer where area.areacode=customer.areacode and customer.custcode=saleledger.custcode),
	patientregno=(select regno from patient where patient.patientcode=saleledger.patientcode),
	patientname=(select name from patient where patient.patientcode=saleledger.patientcode),
	StudentCode=dbo.SaleLedger.StudentCode,
	SaleType = (SELECT ST.Name FROM SaleType ST WHERE ST.SaleTypeCode = saleledger.SaleTypeCode),
	SaleTypeInvNo=saleledger.SaleTypeInvNo,
	Fiscalized = saleledger.Fiscalized,
	FiscalizedOn = saleledger.FiscalizedOn,
	FiscalInvoiceNo = saleledger.FiscalInvoiceNo,
	PaidViaAPI = SaleLedger.PaidViaAPI,
	ContactCellNo = (SELECT CC.Mobile FROM ContactCard CC WHERE CC.ContactCardCode = SaleLedger.ContactCardCode),
	sourcemodule = saleledger.moduleid,
	sourcedocument = saleledger.doccode,
	Pushed=SaleLedger.Pushed,
	PushedOn=SaleLedger.PushedOn,
	PushedBy=IsNull((Select username from users 
							where dbo.saleledger.PushedBy = dbo.users.usercode), ''),
	PushedFor = IsNull((SELECT S.Name + ' (' + S.InstanceID + ')' FROM Site S WHERE S.SiteCode=SaleLedger.TargetSiteCode),'')
FROM 
	dbo.saleledger, users, accounts
WHERE 
	(dbo.saleledger.admissioncode IS NULL)  AND
	dbo.saleledger.custcode = dbo.accounts.acccode AND
	dbo.saleledger.salecatcode IN (:ai_SaleCatCode)  AND
	dbo.saleledger.posted IN (:as_Posted) AND
	dbo.saleledger.date > :ad_invdate AND
	(dbo.saleledger.salesmancode = dbo.users.usercode ) and
	:as_showrows = 'Y' AND 
	saleledger.impactinventory  ='Y' And
	saleledger.salesmancode IN (
									Select 	Distinct U.usercode
									From   	Users U, UserGroups UG, GroupAllowedGroups GAG
									Where  	U.UserCode = UG.UserCode And UG.GroupCode = GAG.AllowedGroupCode And 
												GAG.GroupCode = :ai_groupcode And GAG.Module = :ai_module
									Union 
									Select   U.Usercode
									From     Users U, UserGroups UG
									Where    U.usercode = UG.usercode And UG.GroupCode = :ai_groupcode
									
								  ) And
	Exists (SELECT DBO.Fn_GetPreference('AllowedGroupsInSalesList') 
			WHERE DBO.Fn_GetPreference('AllowedGroupsInSalesList') = 'Y')
ORDER BY 
	dbo.saleledger.SaleInvCode
"
  arguments=(("ai_SaleCatCode", numberlist), ("as_posted", stringlist), ("ad_invdate", datetime), ("as_showrows", string), ("ai_groupcode", number), ("ai_module", number))
)
