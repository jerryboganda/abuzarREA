table(column=(type=long key=yes update=yes updatewhereclause=yes name=invoicecode dbname="SaleLedger.SaleInvCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="SaleLedger.Date"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="SaleLedger.CustCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.Name"  )
column=(type=char(20) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=outstandingamt dbname="SaleLedger.OutstandingAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=netamt dbname="SaleLedger.InvTotal"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="SaleLedger.Posted"  )
column=(type=char(1) updatewhereclause=yes name=oldmarked dbname="OldMarked"  )
column=(type=char(1) update=yes updatewhereclause=yes name=accountfor dbname="SaleLedger.AccountFor"  )
column=(type=char(1) update=yes updatewhereclause=yes name=marked dbname="SaleLedger.Marked" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	SaleLedger.SaleInvCode,
	SaleLedger.Date,
	SaleLedger.CustCode,
	Accounts.Name,
	Accounts.AliasName,
	SaleLedger.OutstandingAmt,
	SaleLedger.InvTotal,
	SaleLedger.Posted,
	OldMarked=SaleLedger.Marked,
	SaleLedger.AccountFor,
	SaleLedger.Marked
FROM 
	SaleLedger, Accounts
WHERE
	SaleLedger.AccountFor = 'Y' AND
	SaleLedger.Posted ='Y' AND
	SaleLedger.SaleCatCode IN (2) AND
	SaleLedger.CustCode = Accounts.AccCode AND
	SaleLedger.SaleInvCode IN (:ia_invoices)"
  update="SaleLedger" updatewhere=1 updatekeyinplace=yes
  arguments=(("ia_invoices", numberlist))
)
