table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Saledetail.saleinvcode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=gcode dbname="Saledetail.gcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="Saledetail.icode"  )
column=(type=char(100) update=yes updatewhereclause=yes validation="len(gettext()) > 0" validationmsg="'please enter valid batch no.'" name=batch dbname="Saledetail.batch"  )
column=(type=datetime update=yes updatewhereclause=yes name=expiry dbname="Saledetail.expiry"  )
column=(type=datetime update=yes updatewhereclause=yes name=manfdate dbname="Saledetail.manfdate"  )
column=(type=long update=yes updatewhereclause=yes name=rowgroup dbname="Saledetail.rowgroup"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="RowId"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Qty should be greater than zero'" initial="0" name=looseqty dbname="looseqty"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Qty should be greater than zero'" initial="0" name=packqty dbname="packqty"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) > 0" initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Sale Price should be valid'" initial="0" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=0 and Real(GetText()) < 100" validationmsg="'Dsicount % value should be between 0 and 100'" initial="0" name=discperc dbname="discperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=rate dbname="rate"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=salestax dbname="salestax"  )
column=(type=char(1) update=yes updatewhereclause=yes name=due dbname="Due"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Item flat disc should be equal or greater than zero~"" initial="0" name=itemflatdisc dbname="itemflatdisc"  )
column=(type=datetime update=yes updatewhereclause=yes name=satisfieddate dbname="SatisfiedDate"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=packqtyforsale dbname="Saledetail.packqtyforsale"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=bonuspackqtyforsale dbname="Saledetail.bonuspackqtyforsale"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=long update=yes updatewhereclause=yes name=saleorderrowid dbname="saleorderrowid"  )
column=(type=long update=yes updatewhereclause=yes name=salerowid dbname="salerowid"  )
column=(type=long update=yes updatewhereclause=yes name=issuerowid dbname="issuerowid"  )
column=(type=long update=yes updatewhereclause=yes name=sourcesaleinvcode dbname="sourcesaleinvcode"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=packprice dbname="Saledetail.packprice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=purunitrate dbname="Saledetail.purunitrate"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=rppunitrate dbname="Saledetail.rppunitrate"  )
column=(type=decimal(3) updatewhereclause=yes name=unitweight dbname="UnitWeight"  )
column=(type=decimal(3) updatewhereclause=yes name=packingfactor dbname="PackingFactor"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=saleutn dbname="Saledetail.SaleUtn"  )
column=(type=char(100) update=yes updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=long update=yes updatewhereclause=yes name=descicode dbname="DescICode"  )
column=(type=char(1) update=yes updatewhereclause=yes name=claimable dbname="claimable" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=0 and Real(GetText()) < 100" validationmsg="'Claimable Discount % value should be between 0 and 100'" initial="0" name=claimablediscperc dbname="claimablediscperc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=balancestock dbname="balancestock"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=totalpieces dbname="totalpieces"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=piecesinhand dbname="piecesinhand"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
 retrieve="SELECT 
	saledetail.saleinvcode,   
	FullCode = (select customicode FROM Item WHERE saledetail.icode = item.icode),
	itemname = (select name FROM Item WHERE saledetail.icode = item.icode),
	saledetail.gcode,   
	saledetail.icode, 
	saledetail.batch, 
	saledetail.expiry,   
	saledetail.manfdate,
	saledetail.rowgroup,
	RowId = saledetail.IDENTITYCOL,   
	looseqty = saledetail.looseqty,
	packqty  = saledetail.packqty,
	packunits= saledetail.packunits,
	saleprice= saledetail.saleprice,
	discperc = saledetail.discperc,  
	rate     = saledetail.rate,  
	avgprice = saledetail.avgprice,  
	salestax = saledetail.salestax, 
	Due      = saledetail.Due,
	itemflatdisc = saledetail.itemflatdisc,
	SatisfiedDate = saledetail.SatisfiedDate,
	saledetail.packqtyforsale,
	saledetail.bonuspackqtyforsale,
	stock = 0.0000, 
	packingdesc=space(50),
	totalstock = 0.0000,
	saleorderrowid = saledetail.saleorderrowid,
	salerowid=saledetail.salerowid,
	issuerowid=saledetail.issuerowid,
	sourcesaleinvcode=saledetail.sourcesaleinvcode,
	saledetail.packprice,
	saledetail.purunitrate,
	saledetail.rppunitrate,
	UnitWeight = 0.000,
	PackingFactor = 0.000,
	saledetail.SaleUtn,
	SaleItemDescription =  saledetail.SaleItemDescription,
	DescICode =  saledetail.DescICode,
	claimable=saledetail.claimable,
	claimablediscperc=saledetail.claimablediscperc,
	balancestock=saledetail.balancestock,
	unitsalestax=saledetail.unitsalestax,
	totalpieces = saledetail.totalpieces,
	piecesinhand = saledetail.piecesinhand,
	gstperc=saledetail.gstperc,
	bonusqty=saledetail.bonusqty
FROM 
	saledetail
WHERE 
	( dbo.saledetail.saleinvcode = :ar_SaleInvCode )
ORDER BY 
	saledetail.IDENTITYCOL
"
  update="saledetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_SaleInvCode", number))
)
