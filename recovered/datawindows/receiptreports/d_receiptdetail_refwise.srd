table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(40) updatewhereclause=yes name=department dbname="department"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=long updatewhereclause=yes name=receiptcode dbname="Receiptinvcode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="smanname"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=deptcode dbname="ReceiptHeader.deptcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ReceiptHeader.remarks"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="looseqty"  )
column=(type=char(100) updatewhereclause=yes name=referenceno dbname="referenceno"  )
column=(type=datetime updatewhereclause=yes name=referencedate dbname="ReceiptHeader.referencedate"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="itempacking"  )
 retrieve="SELECT 
	aliasname= item.customicode,
	itemname= item.name, 
	department = dbo.department.name, 
	salesman = dbo.users.username, 
	Receiptinvcode = dbo.Receiptheader.Receiptinvcode, 
	smanname=salesman.name, 
	date = dbo.Receiptheader.date,   
	dbo.Receiptheader.deptcode,
	dbo.Receiptheader.remarks,	
	gcode = Receiptdetail.gcode,   
	icode = Receiptdetail.icode,   
	batch = Receiptdetail.batch,   
	expiry = Receiptdetail.expiry,   
	looseqty = Receiptdetail.qty,
	referenceno=dbo.Receiptheader.referenceno,
	dbo.Receiptheader.referencedate,
	Godown = Godown.name,
	itempacking = itempacking.name
FROM 
	Receiptheader
	LEFT OUTER JOIN dbo.salesman ON (dbo.Receiptheader.Smancode = dbo.SalesMan.Salesmancode),
	Receiptdetail, 
	users, 
	dbo.item
	LEFT OUTER JOIN dbo.itempacking ON (dbo.item.packcode = dbo.itempacking.packcode)
	LEFT OUTER JOIN dbo.Godown ON (dbo.item.gcode = dbo.Godown.gcode),
	department
WHERE 
	( dbo.Receiptheader.Referenceno = :ar_refno ) AND
	( dbo.Receiptheader.Receiptinvcode = dbo.Receiptdetail.Receiptinvcode) AND
	( dbo.Receiptheader.deptcode = dbo.department.deptcode ) AND 
	( dbo.Receiptheader.salesmancode = dbo.users.usercode ) AND 
	( dbo.Receiptdetail.icode = dbo.item.icode) 
ORDER BY 
	dbo.Receiptheader.Receiptinvcode,
	item.name"
  arguments=(("ar_refno", string))
)
