table(column=(type=long updatewhereclause=yes name=receiptinvcode dbname="ReceiptInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(5) updatewhereclause=yes name=valueexstax dbname="ValueExStax"  )
column=(type=decimal(2) updatewhereclause=yes name=staxperc dbname="STaxPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(6) updatewhereclause=yes name=staxvalue dbname="STaxValue"  )
column=(type=decimal(5) updatewhereclause=yes name=valueincstax dbname="ValueIncStax"  )
 retrieve="SELECT
	ReceiptInvCode = RH.ReceiptInvCode,
	Date=RH.Date,
	ValueExStax = SUM(CEILING(RD.Qty * :ai_reducedqty * 0.01) * RD.Price),
	STaxPerc=:ai_staxperc * 1.00,
	DiscPerc=:ai_discperc * 1.00,
	STaxValue = ROUND(SUM(CEILING(RD.Qty * :ai_reducedqty * 0.01) * RD.Price * :ai_staxperc * 0.01),2),
	ValueIncStax = SUM(CEILING(RD.Qty * :ai_reducedqty * 0.01) * RD.Price) + ROUND(SUM(CEILING(RD.Qty * :ai_reducedqty * 0.01) * RD.Price * :ai_staxperc * 0.01),2)
FROM
	ReceiptHeader RH, ReceiptDetail RD
WHERE
	RH.Date BETWEEN :adt_startdate AND :adt_enddate AND
	RH.ReceiptInvCode = RD.ReceiptInvCode
GROUP BY
	RH.ReceiptInvCode,
	RH.Date
ORDER BY
	ReceiptInvCode,
	Date
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_staxperc", number), ("ai_discperc", number), ("ai_reducedqty", number))
)
