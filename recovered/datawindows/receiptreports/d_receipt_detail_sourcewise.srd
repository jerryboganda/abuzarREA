table(column=(type=long updatewhereclause=yes name=receiptinvcode dbname="ReceiptHeader.receiptinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ReceiptHeader.date"  )
column=(type=char(60) updatewhereclause=yes name=recipienttype dbname="recipienttype"  )
column=(type=char(60) updatewhereclause=yes name=recipient dbname="recipient"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.customicode"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="ReceiptDetail.qty"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="ReceiptDetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="ReceiptDetail.expiry"  )
column=(type=decimal(5) updatewhereclause=yes name=price dbname="ReceiptDetail.price"  )
column=(type=decimal(9) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=char(100) updatewhereclause=yes name=refno dbname="RefNo"  )
 retrieve="SELECT 
	receiptheader.receiptinvcode,
	receiptheader.date,
	recipienttype = recipient.name,
	recipient = 
		CASE :ai_recipientcode 
		When 1 Then 
			(select name from department 
			where deptcode = receiptheader.deptcode and deptcode in (:ai_recipientlist) ) 
		When 2 Then 
			(Select Name From Accounts 
			Where subcode = 3 and acccode=receiptheader.acccode and 
				acccode in (:ai_recipientlist) ) 
		When 3 Then 
			(Select Name from accounts 
			where acccode=receiptheader.acccode and 
				acccode in (:ai_recipientlist) ) 
		When 4 Then 
			(Select name from salesman 
			where salesmancode = receiptheader.recipientsalesman and 
				salesmancode in (:ai_recipientlist) ) 
		End, 
	item.name,
	item.customicode,
	receiptdetail.qty,
	receiptdetail.batch,
	receiptdetail.expiry,
	receiptdetail.price,
	amount=receiptdetail.qty * receiptdetail.price,
	RefNo = receiptheader.ReferenceNo
FROM
	receiptheader,
	receiptdetail,
	item, 
	recipient
WHERE
	dbo.receiptheader.date Between :ad_StartDate and :ad_EndDate and
	receiptheader.recipientcode = :ai_recipientcode and
	receiptheader.recipientcode = recipient.recipientcode and
	CASE :ai_recipientcode
		WHEN 1 THEN receiptheader.DeptCode 
		WHEN 4 THEN receiptheader.RecipientSalesMan 
		ELSE receiptheader.AccCode END
	IN 
		(SELECT Code=D.DeptCode 
		FROM Department D
		WHERE :ai_recipientcode=1 AND D.DeptCode IN (:ai_recipientlist)
		UNION ALL
		SELECT Code=S.SalesManCode 
		FROM SalesMan S
		WHERE :ai_recipientcode=4 AND S.SalesManCode IN (:ai_recipientlist)
		UNION ALL
		SELECT Code=A.AccCode
		FROM Accounts A
		WHERE :ai_recipientcode > 1 AND :ai_recipientcode < 4 AND A.AccCode IN (:ai_recipientlist)) AND
	receiptheader.receiptinvcode=receiptdetail.receiptinvcode and
	receiptdetail.icode=item.icode 
ORDER BY 
	receiptheader.receiptinvcode
"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_recipientcode", number), ("ai_recipientlist", numberlist))
)
