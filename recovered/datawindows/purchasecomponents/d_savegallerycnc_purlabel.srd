table(column=(type=char(77) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname2 dbname="AliasName2"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="RetailPrice"  )
column=(type=long updatewhereclause=yes name=qty dbname="Qty"  )
 retrieve="SELECT 
	AliasName = '*' + Item.CustomICode + '*',
	AliasName2 = Item.CustomICode,
	Name = Item.Name,
	PackingDesc=Item.PackingDesc,
	SalePrice = Item.SalePrice,
	RetailPrice=Item.SalePrice2,
	Qty = 1
FROM
	PurDetail, Item
WHERE
	PurDetail.PurInvCode = :ai_code AND
	PurDetail.ICode = Item.ICode
ORDER BY
	PurDetail.PurRowID
"
  arguments=(("ai_code", number))
)
