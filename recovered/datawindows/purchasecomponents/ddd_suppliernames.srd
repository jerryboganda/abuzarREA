table(column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="name"  )
column=(type=char(12) updatewhereclause=yes name=accounts_aliasname dbname="aliasname"  )
column=(type=long updatewhereclause=yes name=supplier_suppcode dbname="suppcode"  )
column=(type=char(60) updatewhereclause=yes name=supplier_address1 dbname="address1"  )
column=(type=char(30) updatewhereclause=yes name=supplier_phone dbname="phone"  )
column=(type=char(30) updatewhereclause=yes name=supplier_city dbname="City"  )
column=(type=char(30) updatewhereclause=yes name=supplier_country dbname="country"  )
column=(type=long updatewhereclause=yes name=suppcatcode dbname="suppcatcode" 
 values=""  )
column=(type=char(115) updatewhereclause=yes name=summaryaccount dbname="SummaryAccount"  )
column=(type=char(3) updatewhereclause=yes name=balancetype dbname="balancetype"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="balance"  )
 retrieve="  SELECT dbo.accounts.name,   
			dbo.accounts.aliasname,   
         dbo.supplier.suppcode,
			dbo.supplier.address1,
			dbo.supplier.phone,
			dbo.supplier.City,
			dbo.supplier.country,
			dbo.supplier.suppcatcode,
			SummaryAccount = 
				CASE 
				WHEN (SELECT Count(SD.AccCode) 
						FROM SummaryAccountDetail SD 
						WHERE SD.AccCode = dbo.Accounts.AccCode) = 0 THEN NULL 
				ELSE
					(SELECT MAX(SA.Name) + ' (' + MAX(SA.AliasName) + ')' 
					FROM SummaryAccount SA, SummaryAccountDetail SD 
					WHERE SD.AccCode = dbo.Accounts.AccCode AND 
						SD.SummaryAccCode = SA.SummaryAccCode)
				END,
			balancetype=CASE WHEN V.Balance > 0 THEN 'DR.' ELSE 'CR.' END,
			balance= case accounts.restricted when 'Y' then 0
						else V.balance
						end
    FROM 
		dbo.accounts LEFT OUTER JOIN    
		(SELECT acccode, sum(debit - credit) as balance 
						FROM virtualgl 
						GROUP BY acccode) AS V ON (dbo.accounts.acccode = v.acccode),
		dbo.supplier
   WHERE ( dbo.supplier.suppcode = dbo.accounts.acccode ) and
			( dbo.accounts.active='Y')/*and
         ( dbo.supplier.suppcode NOT IN (Select dbo.global.code From dbo.global Where dbo.global.name = 'GT_OpeningSupplierACC') )    */
"
  sort="accounts_name A"
)
