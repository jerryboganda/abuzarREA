release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="Item.icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Item.name"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=avgprice dbname="Item.avgprice"  )
column=(type=long update=yes updatewhereclause=yes name=packunits dbname="Item.packunits"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=packsalestax dbname="Item.packsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=recentpurprice dbname="Item.recentpurprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Item.saleprice"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="Item.packingdesc"  )
 retrieve="SELECT icode, aliasname = customicode, name, gcode=:ar_godown, rate=purprice, avgprice, packunits, qty=1.0000, 
	gstperc=gstperc1, packsalestax, discperc=purdiscperc, recentpurprice, saleprice,packingdesc
from item 
where (manfcode in (:ar_manfcode) OR icatcode in (:ar_icatcode) OR 
		iccode in (:ar_iccode) OR packcode in (:ar_packcode) OR 
		NAME LIKE (:ar_itemlike)) AND (Active =1)
order by name, icode"
  update="item" updatewhere=1 updatekeyinplace=no
  arguments=(("ar_manfcode", numberlist), ("ar_icatcode", numberlist), ("ar_iccode", numberlist), ("ar_packcode", numberlist), ("ar_godown", number), ("ar_itemlike", string))
)
