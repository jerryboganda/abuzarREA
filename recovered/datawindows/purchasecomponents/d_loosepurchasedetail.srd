table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(75) update=yes updatewhereclause=yes name=alternatecustomicode dbname="Purdetail.alternatecustomicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=char(100) updatewhereclause=yes name=quicksearch dbname="QuickSearch"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(100) update=yes updatewhereclause=yes name=location dbname="location"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="Purdetail.icode"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes validation="gettext()<>''" validationmsg="'Please type batch number'" initial="." name=batch dbname="Purdetail.batch"  )
column=(type=datetime updatewhereclause=yes initial="today" name=manfdate dbname="Purdetail.manfdate"  )
column=(type=datetime key=yes update=yes updatewhereclause=yes validationmsg="~"expiry must be greater tlhan today's date~"" initial="12/12/2010" name=expiry dbname="Purdetail.expiry"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=gcode dbname="Purdetail.gcode" 
 values=""  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=packqty dbname="Purdetail.packqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Qunatity should be greater than 0~"" initial="1" name=looseqty dbname="Purdetail.looseqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=bonusqty dbname="Purdetail.bonusqty"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=foreignprice dbname="Purdetail.foreignprice"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) > 0" name=packunits dbname="Purdetail.packunits"  )
column=(type=long updatewhereclause=yes name=basicpackunits dbname="basicpackunits"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) > 0" validationmsg="~"Please enter valid value for Total Pieces~"" initial="1" name=totalpieces dbname="Purdetail.totalpieces"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=piecesinhand dbname="Purdetail.piecesinhand"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Purdetail.purinvcode"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=avgprice dbname="Purdetail.avgprice"  )
column=(type=long updatewhereclause=yes name=purrowid dbname="Purdetail.PurRowId"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="~"Please enter valid value for Pre-Discount Price~"" initial="0" name=prediscprice dbname="prediscprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" validationmsg="~"Please enter valid value for Item Flat Discount~"" initial="0" name=itemflatdisc dbname="Purdetail.itemflatdisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=purprice dbname="Purdetail.purprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=gstperc dbname="Purdetail.gstperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=unitsalestax dbname="Purdetail.unitsalestax"  )
column=(type=decimal(6) updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <=100" initial="0" name=extrataxperc dbname="ExtraTaxPerc"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=netrate dbname="Purdetail.netrate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=recentpurprice dbname="Purdetail.recentpurprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=saleprice dbname="Purdetail.saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=salepriceforitem dbname="Purdetail.salepriceforitem"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Please entervalid batch sale price'" initial="0" name=batchsaleprice dbname="Purdetail.BatchSalePrice"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=lockbatch dbname="Purdetail.LockBatch" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=lockreasoncode dbname="Purdetail.LockReasonCode" 
 values=""  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=godownstock dbname="Purdetail.godownstock"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=rate dbname="Purdetail.rate"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=purpriceinadvpur dbname="Purdetail.purpriceinadvpur"  )
column=(type=char(100) update=yes updatewhereclause=yes name=itemdescription dbname="Purdetail.itemdescription"  )
column=(type=long update=yes updatewhereclause=yes name=manfcodeforitem dbname="Purdetail.ManfCodeforitem" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discountedsaleprice dbname="Purdetail.DiscountedSalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=salediscperc dbname="salediscperc"  )
column=(type=decimal(10) updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=valueextax dbname="ValueExTax"  )
column=(type=decimal(4) updatewhereclause=yes name=packcapacity dbname="PackCapacity"  )
column=(type=decimal(8) updatewhereclause=yes name=areavolume dbname="AreaVolume"  )
column=(type=decimal(6) updatewhereclause=yes name=pcs dbname="PCS"  )
column=(type=char(17) updatewhereclause=yes name=cartons dbname="Cartons"  )
column=(type=decimal(3) update=yes updatewhereclause=yes name=unitweight dbname="Purdetail.unitweight"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=taxable dbname="Taxable"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=itemadvancetaxperc dbname="ItemAdvanceTaxPerc"  )
column=(type=long update=yes updatewhereclause=yes name=salestaxschedulecode dbname="SalesTaxScheduleCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=pctcode dbname="PCTCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=itemalertcode dbname="ItemAlertCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <=100" initial="0" name=discperc dbname="Purdetail.discperc"  )
 retrieve="SELECT 
	item.customicode,
	purdetail.alternatecustomicode,
	item.name, 
	currlistrow = 0,
	totalstock=ISNULL((SELECT SUM(GD.CurrQty) FROM GodownDetail GD WHERE GD.ICode=dbo.purdetail.Icode), 0),
	stock=ISNULL((SELECT SUM(GD.CurrQty) FROM GodownDetail GD WHERE GD.GCode=dbo.purdetail.gcode AND GD.ICode=dbo.purdetail.Icode), 0),
	QuickSearch=SPACE(100),
	itemtotalval=space(30),
	packingdesc=item.packingdesc,
	location = purdetail.location,
	dbo.purdetail.icode,
	dbo.purdetail.batch,
	dbo.purdetail.manfdate,
	dbo.purdetail.expiry,
	dbo.purdetail.gcode,
	dbo.purdetail.packqty,   
	dbo.purdetail.looseqty,
	dbo.purdetail.bonusqty,
	dbo.purdetail.foreignprice,
	dbo.purdetail.packunits,      
	basicpackunits=dbo.item.packunits,
	dbo.purdetail.totalpieces,
	dbo.purdetail.piecesinhand,
	dbo.purdetail.purinvcode,
	dbo.purdetail.avgprice,
	dbo.purdetail.IDENTITYCOL,
	prediscprice = dbo.purdetail.purprice + dbo.purdetail.itemflatdisc,
	dbo.purdetail.itemflatdisc,
	dbo.purdetail.purprice,
	dbo.purdetail.gstperc,
	dbo.purdetail.unitsalestax,
	ExtraTaxPerc=max((((purdetail.looseqty + purdetail.bonusqty) * purdetail.unitsalestax) / CASE WHEN (purdetail.LooseQty * purdetail.PurPrice * (1 - purdetail.DiscPerc * 0.01)) <= 0 THEN 1 ELSE (purdetail.LooseQty * purdetail.purPrice * (1 - purdetail.DiscPerc * 0.01)) END) * 100),
	dbo.purdetail.netrate,
	dbo.purdetail.recentpurprice,
	dbo.purdetail.saleprice,
	dbo.purdetail.salepriceforitem,
	dbo.purdetail.BatchSalePrice,
	dbo.purdetail.LockBatch,
	dbo.purdetail.LockReasonCode,
	dbo.purdetail.godownstock,
	dbo.purdetail.rate,
	dbo.purdetail.purpriceinadvpur,
	dbo.purdetail.itemdescription,
	dbo.purdetail.ManfCodeforitem,
	dbo.purdetail.DiscountedSalePrice,
	salediscperc=item.salediscperc,
	ValueExTax = SUM(( dbo.purdetail.purprice * dbo.purdetail.packqty) * (1 - ( dbo.purdetail.discperc  * .01))),
	PackCapacity = item.PackCapacity,
	AreaVolume = item.AreaVolume,
	PCS=ROUND(sum(purdetail.looseqty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6),
	Cartons= LTRIM(RTRIM(STR(CAST(((ROUND(sum(purdetail.looseqty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6)) / CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END) AS INT), 7, 0))) + ' : ' +
		LTRIM(RTRIM(STR(((CAST(ROUND(sum(purdetail.looseqty) / CASE WHEN item.AreaVolume > 0 THEN item.AreaVolume ELSE 1 END, 6) AS INT)) % CAST(CASE WHEN item.PackCapacity > 0 THEN item.PackCapacity ELSE 1 END AS INT)), 7, 0))),
	dbo.purdetail.unitweight,
	Taxable = Item.Taxable,
	ItemAdvanceTaxPerc = MAX(purdetail.ItemAdvanceTaxPerc),
	SalesTaxScheduleCode=purdetail.SalesTaxScheduleCode,
	PCTCode = purdetail.PCTCode,
	ItemAlertCode = purdetail.ItemAlertCode,
	dbo.purdetail.discperc

FROM 
	dbo.purdetail , 
   dbo.item

WHERE 
	( dbo.purdetail.purinvcode = :r_InvCode ) AND
	( dbo.purdetail.icode = dbo.item.icode ) 

GROUP BY
	item.customicode,
	purdetail.alternatecustomicode,
	item.name, 
	item.packingdesc,
	purdetail.location,
	dbo.purdetail.icode,
	dbo.purdetail.batch,
	dbo.purdetail.manfdate,
	dbo.purdetail.expiry,
	dbo.purdetail.gcode,
	dbo.purdetail.packqty,   
	dbo.purdetail.looseqty,
	dbo.purdetail.bonusqty,
	dbo.purdetail.foreignprice,
	dbo.purdetail.packunits,  
	dbo.item.packunits,    
	dbo.purdetail.totalpieces,
	dbo.purdetail.piecesinhand,
	dbo.purdetail.itemflatdisc,
	dbo.purdetail.purprice,   
	dbo.purdetail.purinvcode,
	dbo.purdetail.avgprice,
	dbo.purdetail.IDENTITYCOL,
	dbo.purdetail.newavgprice,
	dbo.purdetail.currstock,
	dbo.purdetail.godownstock,
	dbo.purdetail.purutn ,
	dbo.purdetail.gstperc,
	dbo.purdetail.unitsalestax,
	dbo.purdetail.netrate,
	dbo.purdetail.recentpurprice,
	dbo.purdetail.saleprice,
	dbo.purdetail.rate,
	dbo.purdetail.purpriceinadvpur,
	dbo.purdetail.itemdescription,
	dbo.purdetail.salepriceforitem,
	dbo.purdetail.BatchSalePrice,
	dbo.purdetail.LockBatch,
	dbo.purdetail.LockReasonCode,
	dbo.purdetail.DiscountedSalePrice,
	dbo.purdetail.unitweight,
	item.PackCapacity,
	item.AreaVolume,
	item.salediscperc,
	Item.Taxable,
	dbo.purdetail.discperc,
	dbo.purdetail.ManfCodeforitem,
	purdetail.SalesTaxScheduleCode,
	purdetail.PCTCode,
	purdetail.ItemAlertCode

"
  update="purdetail" updatewhere=0 updatekeyinplace=no
  arguments=(("r_InvCode", number))
 sort="purrowid A"
)
