table(column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=invgstperc1 dbname="Purledger.invgstperc1"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=purinvcode dbname="Purledger.purinvcode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0  AND Real(GetText()) <=100" initial="0.00" name=discperc dbname="Purledger.discperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0.00" name=flatdisc dbname="Purledger.flatdisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0.00" name=misccharges dbname="Purledger.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=misccharges1 dbname="Purledger.misccharges1"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=misccharges2 dbname="Purledger.misccharges2"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=misccharges3 dbname="Purledger.misccharges3"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=misccharges4 dbname="Purledger.misccharges4"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=misccharges5 dbname="Purledger.misccharges5"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=salestax dbname="Purledger.salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxamt dbname="Purledger.advancetaxamt"  )
column=(type=long updatewhereclause=yes name=piecesinhand dbname="piecesinhand"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="Itemtotalval"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=total dbname="total"  )
column=(type=decimal(2) updatewhereclause=yes name=totalexp dbname="TotalExp"  )
 retrieve="SELECT 
	dbo.purledger.invgstperc1,
	dbo.purledger.purinvcode,   
	dbo.purledger.discperc,   
	dbo.purledger.flatdisc,   
	dbo.purledger.misccharges,   
	dbo.purledger.misccharges1,   
	dbo.purledger.misccharges2,   
	dbo.purledger.misccharges3,   
	dbo.purledger.misccharges4,   
	dbo.purledger.misccharges5,   
	dbo.purledger.salestax,
	dbo.purledger.advancetaxamt,
	piecesinhand = 0,  
	icode=0,
	stock=0.0000,
	totalstock=0.0000,
	Itemtotalval=space(30),
	total=0.00,
	TotalExp=ISNULL((SELECT SUM(PE.Amount) FROM PurExp PE WHERE PE.PurInvCode=PurLedger.PurInvCode),0)
FROM   
	dbo.purledger   
WHERE 	
	dbo.purledger.PurInvCode = :al_PurInvCode
"
  update="purledger" updatewhere=1 updatekeyinplace=no
  arguments=(("al_PurInvCode", number))
)
