table(column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=suppinvcode dbname="SuppInvCode"  )
column=(type=char(100) updatewhereclause=yes name=grn dbname="GRN"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="OutstandingAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve="SELECT 
	PurInvCode,
	Date,
	SuppInvCode,
	GRN,
	SuppCode,
	Supplier,
	AliasName,
	OutstandingAmt,
	InvTotal
FROM
(SELECT 
	PurLedger.PurInvCode,
	PurLedger.Date,
	PurLedger.SuppInvCode,
	PurLedger.GRN,
	PurLedger.SuppCode,
	Supplier=Accounts.Name,
	AliasName=Accounts.AliasName,
	OutstandingAmt = PurLedger.OutstandingAmt + 
		CASE :module
		WHEN 'NP' THEN 
			ISNULL((SELECT SUM(Amt) FROM NotesDetail 
			Where NoteCode = :Code AND NotesDetail.InvoiceCode = PurLedger.PurInvCode), 0)
		WHEN 'PRA' THEN 
			ISNULL((SELECT SUM(Amt) FROM PRAllocationDetail 
			Where PRAllocationCode = :Code AND PRAllocationDetail.PurInvCode = PurLedger.PurInvCode), 0)
		ELSE 
			ISNULL((SELECT SUM(Debit-Credit) FROM GLDetail 
			Where GlVochCode = :Code AND GLDetail.InvoiceCode = PurLedger.PurInvCode), 0)
		END,
	PurLedger.InvTotal
FROM 
	PurLedger, Accounts
WHERE
	PurLedger.AccountFor = 'Y' AND
	PurLedger.Marked = 'N' AND
	PurLedger.Posted ='Y' AND
	PurLedger.SuppCode = :suppcode AND
	PurLedger.SuppCode = Accounts.AccCode) P
WHERE
	OutstandingAmt > 0
ORDER BY
	Date,   
	PurInvCode"
  arguments=(("suppcode", number), ("code", number), ("module", string))
)
