release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="Item.icode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(255) updatewhereclause=yes name=localitemname dbname="localitemname"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="Item.manfcode"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Item.packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="Item.purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Item.saleprice"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.name"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=sstock dbname="sstock"  )
column=(type=decimal(4) updatewhereclause=yes name=pstock dbname="pstock"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="Item.icatcode"  )
column=(type=long updatewhereclause=yes name=iccode dbname="Item.iccode"  )
column=(type=long updatewhereclause=yes name=packcode dbname="Item.packcode"  )
column=(type=long updatewhereclause=yes name=itemalertcode dbname="Item.itemalertcode"  )
column=(type=long updatewhereclause=yes name=itemalerttypecode dbname="itemalerttypecode"  )
column=(type=char(1) updatewhereclause=yes name=restricted dbname="Item.restricted"  )
column=(type=char(100) updatewhereclause=yes name=location dbname="Item.location"  )
 retrieve="SELECT
	dbo.item.icode,
	dbo.item.customicode,
	dbo.item.name,
	localitemname = dbo.item.localitemname,
	dbo.item.manfcode, 
	dbo.item.packunits,
	dbo.item.purprice,
	dbo.item.saleprice,
	dbo.Manufacturer.name,
	stock = (select	sum(dbo.godowndetail.currqty)
		from	dbo.godowndetail 
		where	dbo.godowndetail.icode = dbo.item.icode),
	sstock = (select	sum(dbo.godowndetail.currqty)
		from	dbo.godowndetail 
		where	dbo.godowndetail.icode = dbo.item.icode and
			dbo.godowndetail.gcode IN 
			(SELECT Godown.GCode
			FROM Godown
			WHERE GCode IN
				(CASE (SELECT salegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)
				WHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = Godown.GCode)
				ELSE (SELECT DISTINCT GCode From GroupAllowedGodown
					WHERE	GroupAllowedGodown.GroupCode = :ai_groupcode AND
						GroupAllowedGodown.Module = 1 AND
						GroupAllowedGodown.GCode = Godown.GCode) END))),
	pstock=	(select	sum(dbo.godowndetail.currqty)
		from	dbo.godowndetail 
		where	dbo.godowndetail.icode = dbo.item.icode and
			dbo.godowndetail.gcode IN 
			(SELECT Godown.GCode
			FROM Godown
			WHERE GCode IN
				(CASE (SELECT purchasegodownstrategy FROM Groups Where GroupCode = :ai_groupcode)
				WHEN 2 THEN (SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode = Godown.GCode)
				ELSE (SELECT DISTINCT GCode From GroupAllowedGodown
					WHERE	GroupAllowedGodown.GroupCode = :ai_groupcode AND
						GroupAllowedGodown.Module = 3 AND
						GroupAllowedGodown.GCode = Godown.GCode) END))),
	Packing = dbo.itempacking.name,
	packingdesc=item.packingdesc,
	dbo.item.icatcode,
	dbo.item.iccode,
	dbo.item.packcode,
	dbo.item.itemalertcode,
	itemalerttypecode = (select ia.itemalerttypecode from itemalert ia where ia.itemalertcode = item.itemalertcode),
	dbo.item.restricted,
	dbo.item.location
FROM
	dbo.item LEFT OUTER JOIN dbo.itempacking ON (dbo.item.packcode = dbo.itempacking.packcode), 
	dbo.Manufacturer, Recipe R
WHERE	
	R.ResultedItem = dbo.Item.icode And
	dbo.item.itemtypecode <> 2 And
	dbo.item.Active = 1 And
	dbo.Manufacturer.manfcode = dbo.item.manfcode 
	
ORDER BY dbo.item.name
"
  arguments=(("ai_groupcode", number))
)
