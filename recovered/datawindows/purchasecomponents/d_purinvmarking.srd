table(column=(type=long key=yes update=yes updatewhereclause=yes name=invoicecode dbname="Purledger.PurInvCode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="Purledger.HeaderNo"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="Purledger.HeaderInvNo"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Purledger.Date"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="Purledger.SuppCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.Name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=outstandingamt dbname="Purledger.OutstandingAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=netamt dbname="Purledger.InvTotal"  )
column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="Purledger.Posted"  )
column=(type=char(1) updatewhereclause=yes name=oldmarked dbname="OldMarked"  )
column=(type=char(1) update=yes updatewhereclause=yes name=accountfor dbname="Purledger.AccountFor"  )
column=(type=char(1) update=yes updatewhereclause=yes name=marked dbname="Purledger.Marked" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	PurLedger.PurInvCode,
	PurLedger.HeaderNo,
	PurLedger.HeaderInvNo,
	PurLedger.Date,
	PurLedger.SuppCode,
	Accounts.Name,
	Accounts.AliasName,
	PurLedger.OutstandingAmt,
	PurLedger.InvTotal,
	PurLedger.Posted,
	OldMarked=PurLedger.Marked,
	PurLedger.AccountFor,
	PurLedger.Marked
FROM 
	PurLedger, Accounts
WHERE
	PurLedger.AccountFor = 'Y' AND
	PurLedger.Posted ='Y' AND
	PurLedger.SuppCode = Accounts.AccCode"
  update="PurLedger" updatewhere=1 updatekeyinplace=yes
 )
