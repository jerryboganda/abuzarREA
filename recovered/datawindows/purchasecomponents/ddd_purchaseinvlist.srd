table(column=(type=long updatewhereclause=yes name=purinvcode dbname="Purledger.purinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Purledger.date"  )
column=(type=char(60) updatewhereclause=yes name=suppname dbname="Accounts.name"  )
 retrieve="  SELECT purledger.purinvcode,   
         purledger.date,   
         accounts.name  
    FROM purledger,   
         accounts  
   WHERE purledger.suppcode = accounts.acccode

"
  sort="date D"
)
