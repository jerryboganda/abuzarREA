 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discountedsaleprice dbname="Purdetail.DiscountedSalePrice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=flatdiscforitem dbname="Purdetail.flatdiscforitem"  )
column=(type=decimal(2) updatewhereclause=yes name=salediscperc dbname="salediscperc"  )
column=(type=decimal(10) updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=valueextax dbname="ValueExTax"  )
column=(type=decimal(4) updatewhereclause=yes name=packcapacity dbname="PackCapacity"  )
column=(type=decimal(8) updatewhereclause=yes name=areavolume dbname="AreaVolume"  )
column=(type=decimal(6) updatewhereclause=yes name=pcs dbname="PCS"  )
column=(type=char(17) updatewhereclause=yes name=cartons dbname="Cartons"  )
column=(type=decimal(3) update=yes updatewhereclause=yes initial="1" name=unitweight dbname="Purdetail.unitweight"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=qe1 dbname="QE1"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=qe2 dbname="QE2"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=qe3 dbname="QE3"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=qe4 dbname="QE4"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=qe5 dbname="QE5"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=we1 dbname="WE1"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=we2 dbname="WE2"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=we3 dbname="WE3"  )
