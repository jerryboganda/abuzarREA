column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=gstperc dbname="Purdetail.gstperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=unitsalestax dbname="Purdetail.unitsalestax"  )
column=(type=decimal(6) updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <=100" initial="0" name=extrataxperc dbname="ExtraTaxPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Please enter valid retail price~"" initial="0" name=retailprice dbname="Purdetail.retailprice"  )
