column=(type=long update=yes updatewhereclause=yes validation="Real (GetText()) > 0" validationmsg="~"Please enter valid value for Total Pieces~"" initial="1" name=totalpieces dbname="Purdetail.totalpieces"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=piecesinhand dbname="Purdetail.piecesinhand"  )
