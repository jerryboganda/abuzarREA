release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes name=icode dbname="Item.icode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Purdetail.packunits"  )
column=(type=decimal(4) updatewhereclause=yes name=packqty dbname="Purdetail.packqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="Purdetail.bonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="Purdetail.looseqty"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Purdetail.batch"  )
column=(type=long updatewhereclause=yes name=gcode dbname="Purdetail.gcode"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Purdetail.expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="Purdetail.purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="Purdetail.discperc"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="Purdetail.avgprice"  )
 retrieve="   SELECT dbo.item.name,
			dbo.item.icode, 
			dbo.item.customicode,
			dbo.purdetail.packunits,
 			dbo.purdetail.packqty, 
			dbo.purdetail.bonusqty, 
			dbo.purdetail.looseqty, 
			dbo.purdetail.batch,
			dbo.purdetail.gcode,   
			dbo.purdetail.expiry,
			dbo.purdetail.purprice,
			dbo.purdetail.discperc,
			dbo.purdetail.avgprice			 
			
    FROM dbo.item, 
	 		dbo.purdetail	

   WHERE ( dbo.purdetail.purinvcode = :ar_PurInvCode )and
	 		( dbo.item.icode = dbo.purdetail.icode )
"
  arguments=(("ar_PurInvCode", number))
)
