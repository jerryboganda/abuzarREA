release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1091 color="536870912" )
summary(height=791 color="536870912" )
footer(height=0 color="536870912" )
detail(height=2175 color="536870912" )
table(column=(type=long updatewhereclause=yes name=purinvcode dbname="Purledger.PurinvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Purledger.Date"  )
column=(type=char(100) updatewhereclause=yes name=suppinvcode dbname="Purledger.SuppinvCode"  )
column=(type=datetime updatewhereclause=yes name=suppinvdate dbname="Purledger.SuppInvDate"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Purledger.Posted"  )
column=(type=decimal(2) updatewhereclause=yes name=suppinvamount dbname="suppinvamount"  )
column=(type=long updatewhereclause=yes name=totalitems dbname="TotalItems"  )
column=(type=char(60) updatewhereclause=yes name=department dbname="Department"  )
column=(type=char(100) updatewhereclause=yes name=purchasetype dbname="PurchaseType"  )
column=(type=char(100) updatewhereclause=yes name=grn dbname="GRN"  )
column=(type=decimal(6) updatewhereclause=yes name=saletax dbname="SaleTax"  )
column=(type=decimal(6) updatewhereclause=yes name=gross dbname="Gross"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Purledger.Remarks"  )
 retrieve="SELECT 
	H.PurinvCode,
	H.Date, 
	H.SuppinvCode, 
	H.SuppInvDate,
	AliasName = A.aliasname,
	Supplier = A.name,
	H.Posted,
	suppinvamount = MAX(H.suppinvamount),
	TotalItems = COUNT(D.ICode),
	Department = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode =H.ICatCode),
	PurchaseType = (SELECT PT.Name FROM PurchaseType PT WHERE PT.PurTypecode=H.PurTypecode),
	GRN=H.GRN,
	SaleTax=ROUND( 
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.purprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.purprice) * 
				(1 - (.01 * D.discperc))) * 
				(1- (.01 * H.discperc)) - H.flatdisc) * 
				(H.invgstperc1 * .01), 2), ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)),
	Gross=  ROUND(SUM((D.looseqty + D.packqty) * D.purprice * 
			(1 - (.01 * D.discperc))) * (1- (.01 * H.discperc)) + 
			H.misccharges + H.salestax - H.flatdisc, ISNULL((SELECT A=dbo.Fn_Get_Int_Preference('roundpurinvon')), 0)),
	H.Remarks
FROM 
	Purledger H, Purdetail D, Accounts A
WHERE 
	H.PurInvCode = :ai_invcode AND
	H.Purinvcode = D.Purinvcode AND
	H.SuppCode = A.AccCode
GROUP BY
	H.PurinvCode,
	H.Date,
	H.SuppinvCode,
	H.SuppInvDate,
	H.Posted,
	H.DiscPerc,
	H.FlatDisc,
	H.InvGSTPerc1,
	H.SalesTax,
	H.MiscCharges,
	H.Remarks,
	H.ICatCode,
	H.PurTypeCode,
	H.GRN,
	A.AliasName,
	A.name

"
  arguments=(("ai_invcode", number))
)
