table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="GroupPurExpTemplate.GroupCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=acccode dbname="GroupPurExpTemplate.AccCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="GroupPurExpTemplate.RowID"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="GroupPurExpTemplate.Remarks"  )
 retrieve="SELECT 
	GroupCode, 
	AccCode,   
	RowID,
	Remarks
FROM GroupPurExpTemplate
WHERE 
	GroupCode = :ai_code
ORDER BY
	GroupCode,
	RowID"
  update="GroupPurExpTemplate" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
