table(column=(type=long updatewhereclause=yes name=code dbname="Item.icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Item.name"  )
column=(type=char(255) updatewhereclause=yes name=localitemname dbname="localitemname"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="Item.manfcode"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Item.packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="Item.purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice2 dbname="SalePrice2"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice3 dbname="SalePrice3"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice4 dbname="SalePrice4"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="AvgPrice"  )
column=(type=char(100) updatewhereclause=yes name=itemdescription dbname="ItemDescription"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer.name"  )
column=(type=char(150) updatewhereclause=yes name=genericname dbname="genericname"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=sstock dbname="sstock"  )
column=(type=decimal(4) updatewhereclause=yes name=pstock dbname="pstock"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="Item.icatcode"  )
column=(type=long updatewhereclause=yes name=iccode dbname="Item.iccode"  )
column=(type=long updatewhereclause=yes name=packcode dbname="Item.packcode"  )
column=(type=long updatewhereclause=yes name=itemalertcode dbname="Item.itemalertcode"  )
column=(type=long updatewhereclause=yes name=itemalerttypecode dbname="itemalerttypecode"  )
column=(type=char(1) updatewhereclause=yes name=restricted dbname="Item.restricted"  )
column=(type=char(100) updatewhereclause=yes name=location dbname="Item.location"  )
column=(type=decimal(4) updatewhereclause=yes name=transitstock dbname="transitstock"  )
column=(type=long updatewhereclause=yes name=bgcolor dbname="BGColor"  )
 retrieve="SELECT
	dbo.item.icode,
	dbo.item.customicode,
	dbo.item.name,
	localitemname = dbo.item.localitemname,
	dbo.item.manfcode, 
	dbo.item.packunits,
	dbo.item.purprice, 
	SalePrice = CASE (SELECT G.SalePriceInItemList FROM Groups G WHERE G.GroupCode = :ai_GroupCode) 
						WHEN 2 THEN dbo.item.saleprice2
						WHEN 3 THEN dbo.item.saleprice3
						WHEN 4 THEN dbo.item.saleprice4
						WHEN 5 THEN dbo.item.saleprice5
						ELSE dbo.item.saleprice END, 
	SalePrice2 = dbo.item.saleprice2, 
	SalePrice3 = dbo.item.saleprice3, 
	SalePrice4 = dbo.item.saleprice4, 
	AvgPrice = dbo.item.AvgPrice, 
	ItemDescription = dbo.item.Remarks1,
	dbo.Manufacturer.name,
	genericname=(select name from genericitem where genericitem.genericcode=item.genericcode),
	stock = (select	sum(dbo.godowndetail.currqty)
		from	dbo.godowndetail 
		where	dbo.godowndetail.icode = dbo.item.icode),
	sstock = CASE WHEN (SELECT salegodownstrategy FROM Groups Where GroupCode = :ai_GroupCode) = 2  THEN
		(select	sum(dbo.godowndetail.currqty)
		from	dbo.godowndetail
		where	dbo.godowndetail.icode = dbo.item.icode and
			dbo.godowndetail.gcode = item.GCode)
		ELSE
			(select	sum(dbo.godowndetail.currqty)
			from	dbo.godowndetail,
				(SELECT DISTINCT GCode From GroupAllowedGodown
				WHERE	GroupAllowedGodown.GroupCode = :ai_GroupCode AND
					GroupAllowedGodown.Module = 1) T
			where	dbo.godowndetail.icode = dbo.item.icode and
				dbo.godowndetail.gcode = T.GCode)
		END,
	pstock = CASE WHEN (SELECT purchasegodownstrategy FROM Groups Where GroupCode = :ai_GroupCode) = 2  THEN
		(select	sum(dbo.godowndetail.currqty)
		from	dbo.godowndetail
		where	dbo.godowndetail.icode = dbo.item.icode and
			dbo.godowndetail.gcode = item.GCode)
		ELSE
			(select	sum(dbo.godowndetail.currqty)
			from	dbo.godowndetail,
				(SELECT DISTINCT GCode From GroupAllowedGodown
				WHERE	GroupAllowedGodown.GroupCode = :ai_GroupCode AND
					GroupAllowedGodown.Module = 3) T
			where	dbo.godowndetail.icode = dbo.item.icode and
				dbo.godowndetail.gcode = T.GCode)
		END,
	Packing = dbo.itempacking.name,
	packingdesc=item.packingdesc,
	dbo.item.icatcode,
	dbo.item.iccode,
	dbo.item.packcode,
	dbo.item.itemalertcode,
	itemalerttypecode = (select ia.itemalerttypecode from itemalert ia where ia.itemalertcode = item.itemalertcode),
	dbo.item.restricted,
	dbo.item.location,
	transitstock=item.transitstock,
	BGColor = (SELECT IA.BGColor FROM ItemAlert IA WHERE IA.ItemAlertCode = dbo.item.itemalertcode)
FROM 
	dbo.item LEFT OUTER JOIN dbo.itempacking ON (dbo.item.packcode = dbo.itempacking.packcode), 
	dbo.Manufacturer
WHERE	
	dbo.item.Active = 1 and
	dbo.Manufacturer.manfcode = dbo.item.manfcode 
ORDER BY 
	dbo.item.name
"
  arguments=(("ai_groupcode", number))
)
