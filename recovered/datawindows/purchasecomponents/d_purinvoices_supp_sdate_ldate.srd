header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=72 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=purinvcode dbname="PurInvCode"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Purledger.Date"  )
column=(type=char(60) update=yes updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Purledger.Remarks"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Purledger.Posted" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes name=selected dbname="SELECTED" 
 values="	Y/	N"  )
 retrieve="SELECT
	PurInvCode=SL.PurInvCode, 
	SuppCode=SL.SuppCode,
	AliasName = (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = SL.SuppCode), 
	Supplier = (SELECT A.Name FROM Accounts A WHERE A.AccCode = SL.SuppCode), 
	SL.Date, 
	UserName=(SELECT users.username FROM users where users.usercode = SL.SalesManCode),
	SL.Remarks,
	SL.Posted,
	SELECTED='Y'
FROM
	PurLedger SL
WHERE 
	SL.SuppCode = CASE WHEN :ai_suppcode > 0 THEN :ai_suppcode ELSE SL.SuppCode END AND
	SL.Date >= :ad_startdate AND SL.Date <= :ad_enddate
ORDER BY
	SL.Date,
	SL.PurInvCode"
  arguments=(("ai_suppcode", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="date A"
)
