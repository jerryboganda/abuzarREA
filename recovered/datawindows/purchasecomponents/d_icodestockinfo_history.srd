table(column=(type=char(100) updatewhereclause=yes name=historicalbatch dbname="HistoricalBatch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(13) updatewhereclause=yes name=purprice dbname="PurPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(13) updatewhereclause=yes name=unitsalestax dbname="UnitSalesTax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="GSTPerc"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
 retrieve="SELECT
	HistoricalBatch=PurDetail.batch, 
	expiry=PurDetail.expiry, 
	Qty=CASE WHEN purledger.purcatcode > 2 THEN PurDetail.LooseQty + PurDetail.PackQty ELSE (PurDetail.LooseQty + PurDetail.PackQty) * PurDetail.Packunits END, 
	PurPrice=ROUND(CASE WHEN purledger.purcatcode > 2 THEN PurDetail.PurPrice ELSE (PurDetail.PurPrice / CASE WHEN PurDetail.Packunits=0 OR PurDetail.Packunits IS NULL THEN 1 ELSE PurDetail.Packunits END) END, 2), 
	DiscPerc=PurDetail.DiscPerc, 
	UnitSalesTax=ROUND(CASE WHEN purledger.purcatcode > 2 THEN PurDetail.UnitSalesTax ELSE (PurDetail.UnitSalesTax / CASE WHEN PurDetail.Packunits=0 OR PurDetail.Packunits IS NULL THEN 1 ELSE PurDetail.Packunits END) END, 2),  
	GSTPerc=PurDetail.GSTPerc, 
	BonusQty = CASE WHEN purledger.purcatcode > 2 THEN PurDetail.BonusQty ELSE (PurDetail.BonusQty * PurDetail.Packunits) END
FROM
	PurDetail, purledger
WHERE
	PurDetail.icode = :al_icode AND 
	purledger.purinvcode=purdetail.purinvcode
ORDER BY
	HistoricalBatch, 
	expiry
"
  arguments=(("al_icode", number))
)
