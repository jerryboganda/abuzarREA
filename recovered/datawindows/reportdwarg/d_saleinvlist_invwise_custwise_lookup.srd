datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="SaleLedger.saleinvcode"  )
column=(type=char(1) updatewhereclause=yes name=invselect dbname="invselect" 
 values="	Y/	N"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleLedger.date"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=decimal(6) updatewhereclause=yes name=netamount dbname="NetAmount"  )
 retrieve="SELECT	saleledger.saleinvcode , 
			invselect = 'N',
			saleledger.date , 
			accounts.name,
			users.username, 
			custcode=saleledger.custcode,
			NetAmount = Round(SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc)) *
								(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) + 
								saleledger.misccharges + saleledger.salestax - saleledger.flatdisc, 0)+
								Round(SUM( (saledetail.looseqty + saledetail.bonusqty) * saledetail.unitsalestax) + 
								SUM(ROUND( (saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) *
								(1 - (.01 * saledetail.discperc)) * saledetail.gstperc * .01, 2)) +
								ROUND( (SUM((saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) *
								(1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)) -
								saleledger.flatdisc) * (saleledger.invgstperc1 * .01), 2), 0)
FROM  accounts, saleledger, saledetail, users

WHERE  	 saleledger.saleinvcode Between :al_sinvcode AND :al_linvcode AND
			 saleledger.custcode = :al_custcode AND
			 ( saleledger.custcode = accounts.acccode ) and 
          ( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode)   and
          ( dbo.saleledger.salesmancode = dbo.users.usercode) 

GROUP BY 
	saleledger.SALEINVCODE,
	saleledger.CustCode,
	saleledger.DiscPerc,
	saleledger.MiscCharges,
	saleledger.SalesTax,
	saleledger.FlatDisc,
	saleledger.DiscPerc,
	saleledger.FlatDisc,
	saleledger.InvGSTPerc1,
	saleledger.date , 
	saleledger.custrefno, 
	accounts.name,
	users.username
"
  arguments=(("al_sinvcode", number), ("al_linvcode", number), ("al_custcode", number))
 sort="code A"
)
