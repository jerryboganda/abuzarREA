release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=74 color="536870912" )
summary(height=74 color="536870912" )
footer(height=0 color="536870912" )
detail(height=67 color="536870912" )
table(column=(type=long updatewhereclause=yes name=selected dbname="SELECTED" 
 values="	1/	0"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="HeaderInvNo"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(30) updatewhereclause=yes name=refno dbname="RefNo"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode" 
 values=""  )
column=(type=decimal(2) updatewhereclause=yes name=invamount dbname="InvAmount"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="OutStandingAmt"  )
column=(type=long updatewhereclause=yes name=smancode dbname="SManCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=guaranteepersoncode dbname="GuaranteePersonCode" 
 values=""  )
 retrieve="SELECT 	
	SELECTED = 0,
	InvoiceCode=S.SaleInvCode,
	HeaderNo = S.HeaderNo,
	HeaderInvNo = S.HeaderInvNo,
	Date = S.Date,
	RefNo = S.CustRefNo,
	AliasName = A.AliasName,
	AccCode = A.AccCode,
	InvAmount = S.InvTotal,
	OutStandingAmt = S.OutStandingAmt,
	SManCode = S.SManCode,
	GuaranteePersonCode=S.GuaranteePersonCode
FROM
	SaleLedger S, Accounts A
WHERE
	S.Date BETWEEN :ad_startdate AND :ad_enddate AND
	S.Posted = 'Y' AND
	S.OutStandingAmt <> 0 AND
	S.CustCode = A.AccCode AND
	S.CustCode = CASE WHEN :ai_custcode = 0 THEN S.CustCode ELSE :ai_custcode END
ORDER BY
	S.Date"
  arguments=(("ai_custcode", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
