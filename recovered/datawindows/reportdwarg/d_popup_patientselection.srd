header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Patient.PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=aliasname dbname="Patient.RegNo"  )
column=(type=char(113) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(113) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(60) updatewhereclause=yes name=fname dbname="Patient.FName"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Patient.Gender"  )
column=(type=long updatewhereclause=yes name=custcode dbname="Patient.CustCode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
 retrieve="  SELECT P.PatientCode,   
         P.RegNo,   
         Name = LTRIM(RTRIM(P.Name)) + ' (' + LTRIM(RTRIM(P.RegNo)) + ')',   
         Patient=LTRIM(RTRIM(P.Name)) + ' (' + LTRIM(RTRIM(P.RegNo)) + ')',
         P.FName,   
         P.Gender,   
         P.CustCode,
			Customer=A.Name
    FROM Patient P, Accounts A
WHERE P.CustCode = A.AccCode 
ORDER BY P.Name, P.FName, A.Name
"
 )
