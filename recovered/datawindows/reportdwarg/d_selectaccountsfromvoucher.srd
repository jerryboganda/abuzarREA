header(height=144 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long updatewhereclause=yes name=vouchercode dbname="VoucherCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=title dbname="Title"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(20) updatewhereclause=yes name=chequeno dbname="ChequeNo"  )
column=(type=long updatewhereclause=yes name=selected dbname="Selected" 
 values="	1/	0"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
 retrieve="SELECT
	VoucherCode = H.GLVochCode,
	Date = H.Date,
	AccCode=D.AccCode,
	AliasName = A.AliasName,
	Title = A.Name,
	Amount = D.Credit,
	Remarks = D.Remarks,
	ChequeNo= D.ChkNo,
	Selected = 0,
	RowID = GLRowID
FROM
	GLHeader H,
	GLDetail D,
	Accounts A
WHERE
	H.VochCatCode = :ai_VoucherCatCode AND
	H.GLVochCode BETWEEN :ai_startvouchercode AND :ai_lastvouchercode AND
	H.GLVochCode = D.GLVochCode AND
	H.AccCode <> D.AccCode AND
	D.AccCode = A.AccCode
ORDER BY
	H.GLVochCode,
	D.GLRowID"
  arguments=(("ai_vouchercatcode", number), ("ai_startvouchercode", number), ("ai_lastvouchercode", number))
)
