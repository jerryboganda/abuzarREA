 retrieve="Select code = icode,
		 aliasname = customicode,
		 name = item.name , 
		 manfname = manufacturer.name

From Item , Manufacturer

Where Item.Manfcode = Manufacturer.Manfcode

Order By Name
		 
		"
 )
