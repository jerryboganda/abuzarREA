footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="PurOrderHeader.pocode"  )
column=(type=char(1) updatewhereclause=yes name=invselect dbname="invselect" 
 values="	Y/	N"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.date"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="suppcode"  )
 retrieve="SELECT	purorderheader.pocode , 
			invselect = 'N',
			purorderheader.date , 
			accounts.name,
			users.username, 
			suppcode= purorderheader.suppcode

FROM  	accounts, purorderheader, users

WHERE  	PurOrderHeader.Date Between :al_sdate AND :al_edate AND
			PurOrderHeader.suppcode = :al_suppcode AND
			PurOrderHeader.suppcode = accounts.acccode AND
         PurOrderHeader.salesmancode = users.usercode 

"
  arguments=(("al_sdate", datetime), ("al_edate", datetime), ("al_suppcode", number))
)
