table(column=(type=long key=yes updatewhereclause=yes name=code dbname="ItemCategory.icatcode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="ItemCategory.name"  )
column=(type=char(1) updatewhereclause=yes name=status dbname="status" 
 values="	Y/	N"  )
 retrieve="Select 
	icatcode, 
	name,
	status = 'N'
From 
	ItemCategory
Where 
	Exists (SELECT DBO.Fn_GetPreference('groupcategoryrights') WHERE DBO.Fn_GetPreference('groupcategoryrights') = 'Y') And
	ICatCode IN 
		(SELECT ItemsCategoryCode 
		FROM ItemsGroupCategory 
		WHERE GroupCode IN
		   (SELECT GroupCode FROM UserGroups WHERE UserCode = :gl_userCode) ) 
Union All
Select 
	icatcode, 
	name,
	status = 'N'
From 
	ItemCategory
Where Exists 
	(SELECT DBO.Fn_GetPreference('groupcategoryrights') 
	WHERE DBO.Fn_GetPreference('groupcategoryrights') = 'N')
Order By 
	Name"
  update="ItemCategory" updatewhere=0 updatekeyinplace=no
  arguments=(("gl_usercode", number))
)
