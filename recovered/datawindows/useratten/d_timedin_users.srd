release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=424 color="536870912" )
summary(height=84 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=usercode dbname="Users.UserCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=username dbname="Users.UserName"  )
column=(type=datetime updatewhereclause=yes name=timein dbname="UserAttendance.TimeIn"  )
column=(type=datetime updatewhereclause=yes name=timeout dbname="UserAttendance.TimeOut"  )
column=(type=long updatewhereclause=yes name=hoursworked dbname="HoursWorked"  )
column=(type=long updatewhereclause=yes name=minutesworked dbname="MinutesWorked"  )
column=(type=long updatewhereclause=yes name=secondsworked dbname="SecondsWorked"  )
 retrieve="SELECT
	U.UserCode,
	U.UserName,
	UT.TimeIn,
	UT.TimeOut,
	HoursWorked = (DATEDIFF(ss, TimeIn, GETDATE()) / 3600),
	MinutesWorked = (DATEDIFF(ss, TimeIn, GETDATE()) % 3600) / 60,
	SecondsWorked = ((DATEDIFF(ss, TimeIn, GETDATE()) % 3600) % 60)
FROM
	Users U, UserAttendance UT
WHERE 
	U.UserCode = UT.UserCode AND
	UT.TimeIn IS NOT NULL AND 
	UT.TimeOut IS NULL
ORDER BY
	U.UserName
"
  filter="hoursworked > -1 AND  minutesworked > -1 AND  secondsworked > -1"
 )
