table(column=(type=long key=yes update=yes updatewhereclause=yes name=usercode dbname="Users.UserCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=username dbname="Users.UserName"  )
column=(type=long update=yes updatewhereclause=yes name=attendencecount dbname="Users.AttendenceCount"  )
column=(type=long update=yes updatewhereclause=yes name=hoursworked dbname="HoursWorked"  )
column=(type=long update=yes updatewhereclause=yes name=minutesworked dbname="MinutesWorked"  )
column=(type=long update=yes updatewhereclause=yes name=secondsworked dbname="SecondsWorked"  )
 retrieve="SELECT
	U.UserCode,
	U.UserName, 
	UT.AttendenceCount,
	HoursWorked = (UT.SecWorked / 3600),
	MinutesWorked = (UT.SecWorked % 3600) / 60,
	SecondsWorked = ((UT.SecWorked % 3600) % 60)
FROM
	Users U,
	(SELECT 
		UserCode,
		AttendenceCount=COUNT(UserCode),
		SecWorked = SUM(DATEDIFF(ss, TimeIn, TimeOut))
	FROM DBO.UserAttendance
	WHERE UserCode IN (:ai_usercode) AND 
		TimeIn >= :ad_startdate AND 
		TimeIn <= :ad_enddate AND
		TimeOut >= :ad_startdate AND 
		TimeOut <= :ad_enddate
	GROUP BY UserCode) UT
WHERE 
	U.UserCode IN (:ai_usercode) AND 
	U.UserCode = UT.UserCode
ORDER BY
	U.UserName
"
  update="Users" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_usercode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
