table(column=(type=long update=yes updatewhereclause=yes name=usercode dbname="UserCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=username dbname="UserName"  )
column=(type=decimal(1) update=yes updatewhereclause=yes name=transactionorder dbname="TransactionOrder"  )
column=(type=char(81) update=yes updatewhereclause=yes name=transactiontype dbname="TransactionType"  )
column=(type=long update=yes updatewhereclause=yes name=transactioncount dbname="TransactionCount"  )
 retrieve="SELECT 
	UserCode=U.UserCode,
	UserName = U.UserName,
	TransactionOrder = UT.TransOrder,
	TransactionType = UT.TransType,
	TransactionCount = UT.TransCount
FROM 
	Users U,
	(SELECT 
		TransOrder = 1,
		TransType  = 'Cash Sales',	
		UserCode   = S.SalesManCode, 
		TransCount = Count(S.SaleInvCode)
	FROM
		SaleLedger S
	WHERE 
		S.SalesManCode IN (:ai_usercode) AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.Posted = 'Y' AND
		S.SaleCatCode = 3
	GROUP BY
		S.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 2,
		TransType  = 'Credit Sales',	
		UserCode   = S.SalesManCode, 
		TransCount = Count(S.SaleInvCode)
	FROM
		SaleLedger S
	WHERE 
		S.SalesManCode IN (:ai_usercode) AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.Posted = 'Y' AND
		S.SaleCatCode <> 3
	GROUP BY
		S.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 3,
		TransType  = 'Cash Sales Return',	
		UserCode   = S.SalesManCode, 
		TransCount = Count(S.SRInvCode)
	FROM
		SRLedger S
	WHERE 
		S.SalesManCode IN (:ai_usercode) AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.Posted = 'Y' AND
		S.SRCatCode = 8
	GROUP BY
		S.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 4,
		TransType  = 'Credit Sales Return',	
		UserCode   = S.SalesManCode, 
		TransCount = Count(S.SRInvCode)
	FROM
		SRLedger S
	WHERE 
		S.SalesManCode IN (:ai_usercode) AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.Posted = 'Y' AND
		S.SRCatCode <> 8
	GROUP BY
		S.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 5,
		TransType  = 'Purcahses',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.PurInvCode)
	FROM
		PurLedger T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 6,
		TransType  = 'Purcahse Returns',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.PRInvCode)
	FROM
		PRLedger T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 7,
		TransType  = 'Adjustment Increase',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.AdjCode)
	FROM
		AdjHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y' AND
		T.AdjCatCode = 1
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 8,
		TransType  = 'Adjustment Decrease',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.AdjCode)
	FROM
		AdjHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y' AND
		T.AdjCatCode = 2
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 9,
		TransType  = 'Issue',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.IssueInvCode)
	FROM
		IssueHeader T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 10,
		TransType  = 'Receipt',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.ReceiptInvCode)
	FROM
		ReceiptHeader T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 11,
		TransType  = 'Transfer Requistion',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.TransReqCode)
	FROM
		TransferRequisitionHeader T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 11.1,
		TransType  = 'Transfer',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.TransCode)
	FROM
		THeader T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 12,
		TransType  = 'Cash Service Sales',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.ServiceInvCode)
	FROM
		ServiceHeader T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y' AND
		T.ServiceCatCode = 10
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 13,
		TransType  = 'Credit Service Sales',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.ServiceInvCode)
	FROM
		ServiceHeader T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y' AND
		T.ServiceCatCode <> 10
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 14,
		TransType  = 'Cash Service Return',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.ServiceInvCode)
	FROM
		ServiceRHeader T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y' AND
		T.ServiceRCatCode = 13
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 15,
		TransType  = 'Credit Service Return',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.ServiceInvCode)
	FROM
		ServiceRHeader T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y' AND
		T.ServiceRCatCode <> 13
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 16,
		TransType  = 'Sale Order',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.SaleOrderCode)
	FROM
		SaleOrderHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 17,
		TransType  = 'Avg. Price Adjustment',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.DocumentCode)
	FROM
		AvgPriceAdjHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 18,
		TransType  = 'Quotation',
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.QuotationCode)
	FROM
		QuotationHeader T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 19,
		TransType  = 'Due Adjustment',
		UserCode   = T.UserCode, 
		TransCount = Count(T.DueAdjCode)
	FROM
		DueAdjHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 20,
		TransType  = 'Due Satisfy',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.DueSatisfyCode)
	FROM
		DueSatisfyHeader T
	WHERE 
		T.UserCode IN (:ai_usercode)
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 21,
		TransType  = 'Expiry Intimation',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.IntimationCode)
	FROM
		ExpiryIntimation T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 22,
		TransType  = 'Incentive Sheet',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.IncentiveDocCode)
	FROM
		IncentiveSheet T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 23,
		TransType  = 'Issue Request',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.IssueReqInvCode)
	FROM
		IssueReqHeader T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 24,
		TransType  = 'Item Conversion Increase',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.ItemConversionCode)
	FROM
		ItemConversionHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y' AND
		T.ItemConversionEffectCode = 1
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 25,
		TransType  = 'Item Conversion Decrease',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.ItemConversionCode)
	FROM
		ItemConversionHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y' AND
		T.ItemConversionEffectCode = 2
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 26,
		TransType  = 'Notes Receivable',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.NoteCode)
	FROM
		Notes T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.DueDate BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y' AND
		T.NoteCatCode = 1
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 27,
		TransType  = 'Notes Payable',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.NoteCode)
	FROM
		Notes T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.DueDate BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y' AND
		T.NoteCatCode = 2
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 28,
		TransType  = 'Patient Admission',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.AdmissionCode)
	FROM
		PatientAdmission T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 28.1,
		TransType  = 'Patient Discharge',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.AdmissionCode)
	FROM
		PatientAdmission T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.DischargedOn BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 29,
		TransType  = 'Patient Transfer',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.TransferCode)
	FROM
		PatientTransfer T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 30,
		TransType  = 'Purchase Return Allocation',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.PRAllocationCode)
	FROM
		PRAllocationHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 31,
		TransType  = 'Sale Return Allocation',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.SRAllocationCode)
	FROM
		SRAllocationHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 32,
		TransType  = 'Prescrption',	
		UserCode   = T.CreatedBy, 
		TransCount = Count(T.PresCode)
	FROM
		PrescriptionHeader T
	WHERE 
		T.CreatedBy IN (:ai_usercode) AND
		T.ModifiedDate BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.CreatedBy
	UNION ALL
	SELECT 
		TransOrder = 33,
		TransType  = 'Production',	
		UserCode   = T.CreatedBy, 
		TransCount = Count(T.ProdCode)
	FROM
		ProdHeader T
	WHERE 
		T.CreatedBy IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.CreatedBy
	UNION ALL
	SELECT 
		TransOrder = 34,
		TransType  = 'Purchase Order',	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.POCode)
	FROM
		PurOrderHeader T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.SalesManCode
	UNION ALL
	SELECT 
		TransOrder = 35,
		TransType  = 'Purchase Quotation',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.PurQuotationCode)
	FROM
		PurQuotationHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 36,
		TransType  = 'Purchase Register',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.PurRegisterCode)
	FROM
		PurRegister T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 37,
		TransType  = 'Recipe',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.RecipeCode)
	FROM
		Recipe T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 38,
		TransType  = 'Refused Sales',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.RefusedSaleInvCode)
	FROM
		RefusedSaleHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 39,
		TransType  = 'Sale Invoice Group',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.SaleInvGroupCode)
	FROM
		SaleInvGroup T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 40,
		TransType  = 'Samples',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.SampleCode)
	FROM
		Samples T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.SampleDate BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 41,
		TransType  = 'Service Result',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.ServiceResultCode)
	FROM
		ServiceResultHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 42,
		TransType  = 'Service Template',	
		UserCode   = T.UserCode, 
		TransCount = Count(T.ServiceTemplateCode)
	FROM
		ServiceTemplateHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 43,
		TransType  = 'Survey',	
		UserCode   = T.CreatedBy, 
		TransCount = Count(T.SurveyCode)
	FROM
		SurveyHeader T
	WHERE 
		T.CreatedBy IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		T.CreatedBy
	UNION ALL
	SELECT 
		TransOrder = 44,
		TransType  = 'Transaction Window - ' + ISNULL((SELECT TT.Name FROM TransactionType TT WHERE T.TransactionTypeCode = TT.TransactionTypeCode), ''),	
		UserCode   = T.UserCode, 
		TransCount = Count(T.DocumentCode)
	FROM
		TransactionHeader T
	WHERE 
		T.UserCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.TransactionTypeCode,
		T.UserCode
	UNION ALL
	SELECT 
		TransOrder = 45,
		TransType  = 'Voucher - ' + ISNULL((SELECT VC.Name FROM VocherCategory VC WHERE T.VochCatCode = VC.VochCatCode), ''),	
		UserCode   = T.SalesManCode, 
		TransCount = Count(T.GLVochCode)
	FROM
		GLHeader T
	WHERE 
		T.SalesManCode IN (:ai_usercode) AND
		T.Date BETWEEN :adt_startdate AND :adt_enddate AND
		T.Posted = 'Y'
	GROUP BY
		T.VochCatCode,
		T.SalesManCode) UT
WHERE 
	U.UserCode IN (:ai_usercode) AND
	U.UserCode = UT.UserCode
ORDER BY
	UserName,
	TransactionOrder"
  arguments=(("ai_usercode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
group(level=1 header.height=468 trailer.height=229 by=("usercode" "username"  ) header.color="536870912" trailer.color="536870912" )
