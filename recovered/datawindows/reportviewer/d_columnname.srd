table(column=(type=char(100) updatewhereclause=yes name=columnname dbname="ColumnName"  )
column=(type=char(1) updatewhereclause=yes initial="Y" name=autovisible dbname="AutoVisible" 
 values="	Y/	N"  )
column=(type=char(0) updatewhereclause=yes name=visibilityexp dbname="visibilityexp"  )
column=(type=char(1) updatewhereclause=yes initial="Y" name=visible dbname="visible" 
 values="	Y/	N"  )
column=(type=char(100) updatewhereclause=yes name=columntype dbname="ColumnType"  )
 retrieve="SELECT 
	ColumnName = SPACE(100),
	AutoVisible='Y',
	visibilityexp='',
	visible   = 'Y',
	ColumnType = SPACE(100)"
  sort="columntype A, columnname A, visible A"
)
