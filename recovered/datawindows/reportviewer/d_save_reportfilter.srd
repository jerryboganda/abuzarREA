detail(height=556 color="536870912" )
table(column=(type=char(100) key=yes update=yes updatewhereclause=yes name=reportidentifier dbname="reportfilter.reportidentifier"  )
column=(type=char(100) key=yes update=yes updatewhereclause=yes name=filtername dbname="reportfilter.filtername"  )
column=(type=char(4000) update=yes updatewhereclause=yes name=filterexpression dbname="reportfilter.filterexpression"  )
 retrieve="SELECT
	ReportFilter.ReportIdentifier,   
	ReportFilter.FilterName,   
	ReportFilter.FilterExpression  
FROM 
	ReportFilter
WHERE
	ReportFilter.ReportIdentifier = :as_reportid AND
	ReportFilter.FilterName = :as_filtername AND   
	ReportFilter.FilterExpression = :as_filterexp
"
  update="ReportFilter" updatewhere=1 updatekeyinplace=yes
  arguments=(("as_reportid", string), ("as_filtername", string), ("as_filterexp", string))
)
