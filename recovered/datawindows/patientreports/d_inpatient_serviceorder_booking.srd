release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1479 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=ordercode dbname="OrderCode"  )
column=(type=datetime updatewhereclause=yes name=orderdate dbname="OrderDate"  )
column=(type=datetime updatewhereclause=yes name=bookingdate dbname="BookingDate"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(6) updatewhereclause=yes name=sex dbname="SEX"  )
column=(type=long updatewhereclause=yes name=age dbname="AGE"  )
column=(type=char(60) updatewhereclause=yes name=service dbname="Service"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=char(122) updatewhereclause=yes name=location dbname="Location"  )
column=(type=char(60) updatewhereclause=yes name=ward dbname="Ward"  )
 retrieve="SELECT 
	OrderCode=H.ServiceOCode,
	OrderDate=H.Date,
	BookingDate=D.Date, 
	PatientRegNo=P.RegNo,
	Patient=P.Name,
	SEX= CASE P.GENDER WHEN 'M' THEN 'Male' ELSE 'Female' END,
	AGE= DATEDIFF(yy, P.DOB, GETDATE()),
	Service= S.Name,
	Doctor= (SELECT D.Name FROM Doctors D WHERE D.DoctCode = H.DoctCode),
	Location = LTRIM(RTRIM(PL.Name)) + '(' + LTRIM(RTRIM(W.Name)) + ')',
	Ward = W.Name
FROM 
	ServiceOHeader H, 
	ServiceODetail D,
	PatientAdmission PA,
	PatientLocation PL,
	Patient P,
	Service S,
	(SELECT 
		PA.AdmissionCode, 
		LocationCode = ISNULL((SELECT TargetLocation FROM PatientTransfer 
									WHERE PatientTransfer.TransferCode = 
											(SELECT Max(PatientTransfer.TransferCode) 
											FROM PatientTransfer 
											WHERE PatientTransfer.AdmissionCode = PA.AdmissionCode)), (SELECT A.LocationCode FROM PatientAdmission A WHERE A.AdmissionCode = PA.AdmissionCode))
	FROM PatientAdmission PA) L,
	Ward W

WHERE
	D.Date >= :ad_startdate AND D.Date <= :ad_enddate AND
	D.ServiceCode = S.ServiceCode AND 
	D.ServiceOCode = H.ServiceOCode AND
	H.AdmissionCode = PA.AdmissionCode AND
	PA.PatientCode = P.PatientCode AND
	PA.AdmissionCode = L.AdmissionCode AND
	L.LocationCode = PL.LocationCode AND
	PL.WardCode = W.WardCode
ORDER BY
	BookingDate
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="bookingdate A, location A, sex A, age A, doctor A"
)
