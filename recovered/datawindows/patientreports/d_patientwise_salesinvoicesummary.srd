table(column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=decimal(2) updatewhereclause=yes name=invoiceamount dbname="InvoiceAmount"  )
column=(type=char(100) updatewhereclause=yes name=remarls dbname="Remarls"  )
 retrieve="SELECT 
	RegNo = P.RegNo,
	PatientName = P.Name,
	Date = S.Date,
	InvoiceCode = S.SaleInvCode,
	InvoiceAmount = S.InvTotal,
	Remarls = S.Remarks
FROM
	SaleLedger S,
	Patient P
WHERE 
	S.PatientCode = :ai_patientcode AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.PatientCode = P.PatientCode
ORDER BY
	P.Name,
	P.RegNo,
	S.Date"
  arguments=(("ai_patientcode", number), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
