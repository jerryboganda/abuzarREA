release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2158 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=400 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=183 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(3) updatewhereclause=yes name=maintype dbname="MainType"  )
column=(type=char(17) updatewhereclause=yes name=subtype dbname="SubType"  )
column=(type=decimal(1) updatewhereclause=yes name=rowgroup dbname="RowGroup"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=datetime updatewhereclause=yes name=admittedon dbname="AdmittedOn"  )
column=(type=char(60) updatewhereclause=yes name=admittedby dbname="AdmittedBy"  )
column=(type=datetime updatewhereclause=yes name=dischargedon dbname="DischargedOn"  )
column=(type=char(60) updatewhereclause=yes name=dischargedby dbname="DischargedBy"  )
column=(type=char(1) updatewhereclause=yes name=discharged dbname="PatientAdmission.Discharged"  )
column=(type=char(60) updatewhereclause=yes name=patientlocation dbname="PatientLocation"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(255) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(255) updatewhereclause=yes name=description dbname="Description"  )
column=(type=char(60) updatewhereclause=yes name=procedurename dbname="ProcedureName"  )
column=(type=decimal(2) updatewhereclause=yes name=procedurecharges dbname="ProcedureCharges"  )
column=(type=decimal(2) updatewhereclause=yes name=proceduregstperc dbname="ProcedureGSTPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=transportcharges dbname="TransportCharges"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=balancepayable dbname="BalancePayable"  )
 retrieve="SELECT 
	MainType='ALL', 
	SubType=ItemType,
	RowGroup=T.RowGroup,
	Category = 
		CASE WHEN T.ServiceCatCode IS NULL THEN 
			CASE T.RowGroup 
			WHEN 1 THEN 'NET MEDICINE SALES' 
			WHEN 3 THEN '' 
			ELSE 'SERVICES ADD/LESS' END
		ELSE SC.Name END,
	RegNo = P.RegNo,
	Patient=P.Name, 
	AdmissionCode=:ai_admissioncode,
	AdmittedOn=PA.Date,
	AdmittedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.UserCode),
	DischargedOn=PA.DischargedOn,
	DischargedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.DischargedBy),
	PA.Discharged,
	PatientLocation = (SELECT L.Name FROM PatientLocation L WHERE L.LocationCode = PA.LocationCode),
	Amount = SUM(Debit) - SUM(Credit),
	Date=T.Date,
	Remarks=T.Remarks,
	Description=T.Remarks2,
	ProcedureName = (SELECT S.Name FROM Service S WHERE PA.ProcedureRequired=S.ServiceCode),
	ProcedureCharges = PA.ProcedureCharges,
	ProcedureGSTPerc = PA.ProcedureGSTPerc,
	TransportCharges = PA.TransportCharges,
	BalancePayable = 0.00
FROM
	PatientAdmission PA,
	Patient P,
	(SELECT  
		RowGroup=1,
		ItemType='MEDICINE',
		ServiceCatCode=NULL,
		Debit=SUM(T.NetAmt),
		Credit=0,
		AdmissionCode=:ai_admissioncode,
		Date=GETDATE(),
		Remarks=SPACE(255),
		Remarks2=SPACE(255)
	FROM 
		SaleLedger S,
		(SELECT 
			SS.SaleInvCode, 
			NetAmt=ROUND(
			SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
				SUM(ROUND( (DD.looseqty * 
					(DD.saleprice - DD.itemflatdisc)) *
					(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
				ROUND( (SUM((DD.looseqty * 
					(DD.saleprice - DD.itemflatdisc)) *
					(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
					SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
			Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
				SS.misccharges + SS.salestax - SS.flatdisc, 0)
		FROM SaleLedger SS, SaleDetail DD 
		WHERE 
			SS.SaleInvCode = DD.SaleInvCode AND
			SS.AdmissionCode IN (:ai_admissioncode)
		GROUP BY
			SS.SaleInvCode,
			SS.DiscPerc,
			SS.FlatDisc,
			SS.InvGSTPerc1,
			SS.DiscPerc,
			SS.MiscCharges,
			SS.SalesTax) T
	WHERE
		( S.AdmissionCode = :ai_admissioncode ) AND	
		( S.SaleInvCode = T.SaleInvCode )
	UNION ALL
	SELECT  
		RowGroup=1,
		ItemType='MEDICINE',
		ServiceCatCode=NULL,
		Debit = 0,
		Credit= SUM(isnull(S.Amt, 0) + isnull(S.CashCharged, 0)) + 
			ISNULL((SELECT SUM(CW.Amount) 
					FROM CashierWindow CW, SaleLedger SS
					WHERE SS.AdmissionCode = :ai_admissioncode and  
						SS.SaleCatcode = 2 AND
						SS.SaleInvCode = CW.SaleInvCode), 0),
		AdmissionCode=:ai_admissioncode,
		Date=GETDATE(),
		Remarks=SPACE(255),
		Remarks2=SPACE(255)
	FROM
		SaleLedger S
	WHERE   
		( S.AdmissionCode = :ai_admissioncode ) and  
		( S.SaleCatcode = 2 ) AND
		( S.Amt <> 0 OR S.CashCharged <> 0 OR S.SaleInvCode IN (SELECT DISTINCT CW.SaleInvCode FROM CashierWindow CW WHERE CW.SaleInvCode = S.SaleInvCode))
	UNION ALL
	SELECT  
		RowGroup=1,
		ItemType='MEDICINE',
		ServiceCatCode=NULL,
		Debit=0,
		Credit=SUM(T.NetAmt),
		AdmissionCode=:ai_admissioncode,
		Date=GETDATE(),
		Remarks=SPACE(255),
		Remarks2=SPACE(255)
	FROM
		SRLedger S,
		(SELECT 
			SS.SRInvCode, 
			NetAmt=ROUND(
			SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
				SUM(ROUND( (DD.looseqty * DD.SRPrice) *
					(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
				ROUND( (SUM((DD.looseqty * DD.SRPrice) *
					(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
					SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
			Round(SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
				SS.misccharges + SS.salestax - SS.flatdisc, 0)
		FROM SRLedger SS, SRDetail DD 
		WHERE 
			SS.AdmissionCode IN (:ai_admissioncode) AND
			SS.SRInvCode = DD.SRInvCode
		GROUP BY
			SS.SRInvCode,
			SS.DiscPerc,
			SS.FlatDisc,
			SS.InvGSTPerc1,
			SS.DiscPerc,
			SS.MiscCharges,
			SS.SalesTax) T
	WHERE   
		( S.AdmissionCode = :ai_admissioncode) AND
		( S.SRInvCode = T.SRInvCode)
	UNION ALL
	SELECT  
		RowGroup=1,
		ItemType='MEDICINE',
		ServiceCatCode=NULL,
		Debit = SUM(isnull(S.Amt, 0) + isnull(S.CashCharged, 0)) + 
			ISNULL((SELECT SUM(CW.Amount) 
					FROM MasterCashWin CW, SRLedger SS
					WHERE SS.AdmissionCode = :ai_admissioncode and  
						SS.SRCatcode = 7 AND
						SS.SRInvCode = CW.DocumentCode), 0),
		Credit=0,
		AdmissionCode=:ai_admissioncode,
		Date=GETDATE(),
		Remarks=SPACE(255),
		Remarks2=SPACE(255)
	FROM
		SRLedger S
	WHERE   
		( S.AdmissionCode = :ai_admissioncode ) and  
		( S.SRCatcode = 7 ) AND
		( S.Amt <> 0 OR S.CashCharged <> 0 OR S.SRInvCode IN (SELECT DISTINCT CW.DocumentCode FROM MasterCashWin CW WHERE CW.DocumentCode = S.SRInvCode))
	UNION ALL
	SELECT 
		RowGroup=2,
		ItemType='SERVICES',
		T.ServiceCatCode,
		Debit=SUM(T.Amt),
		Credit=0,
		AdmissionCode=:ai_admissioncode,
		Date=GETDATE(),
		Remarks=SPACE(255),
		Remarks2=SPACE(255)
	FROM 
		ServiceHeader S,
		(SELECT 
			SS.ServiceInvCode, 
			SC.ServiceCatCode,
			Amt=SUM(DD.qty * (DD.Price - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc))
		FROM ServiceHeader SS, ServiceDetail DD, Service S, ServiceCategory SC
		WHERE 
			SS.ServiceInvCode = DD.ServiceInvCode AND
			SS.AdmissionCode IN (:ai_admissioncode ) AND
			DD.ServiceCode = S.ServiceCode AND
			S.ServiceCatCode = SC.ServiceCatCode
		GROUP BY
			SC.ServiceCatCode,
			SS.ServiceInvCode,
			SS.DiscPerc) T
	WHERE
		( S.AdmissionCode = :ai_admissioncode ) and  
		( S.ServiceInvCode = T.ServiceInvCode )
	GROUP BY T.ServiceCatCode
	UNION ALL
	SELECT  
		RowGroup=2,
		ItemType='SERVICES',
		ServiceCatCode=NULL,
		Debit = 0,
		Credit= SUM(isnull(S.CashCharged, 0)) + 
			ISNULL((SELECT SUM(CW.Amount) 
					FROM MasterCashWin CW, ServiceHeader SS
					WHERE SS.AdmissionCode = :ai_admissioncode and  
						SS.ServiceCatcode = 11 AND
						CW.DocumentType = 'RS' AND
						SS.ServiceInvCode = CW.DocumentCode), 0),
		AdmissionCode=:ai_admissioncode,
		Date=GETDATE(),
		Remarks=SPACE(255),
		Remarks2=SPACE(255)
	FROM
		ServiceHeader S
	WHERE   
		( S.AdmissionCode = :ai_admissioncode ) and  
		( S.ServiceCatcode = 11 ) AND
		( S.CashCharged <> 0 OR S.ServiceInvCode IN (SELECT DISTINCT CW.DocumentCode FROM MasterCashWin CW WHERE CW.DocumentCode = S.ServiceInvCode))
	UNION ALL
	SELECT 
		RowGroup=2,
		ItemType='SERVICES',
		T.ServiceCatCode,
		Debit=0, 
		Credit=SUM(T.Amt),
		AdmissionCode=:ai_admissioncode,
		Date=GETDATE(),
		Remarks=SPACE(255),
		Remarks2=SPACE(255)
	FROM 
		ServiceRHeader S,
		(SELECT 
			SS.ServiceRInvCode, 
			SC.ServiceCatCode,
			Amt=SUM(DD.qty * (DD.ServicePrice - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc))
		FROM ServiceRHeader SS, ServiceRDetail DD, Service S, ServiceCategory SC
		WHERE 
			SS.ServiceRInvCode = DD.ServiceRInvCode AND
			SS.AdmissionCode IN (:ai_admissioncode ) AND
			DD.ServiceCode = S.ServiceCode AND
			S.ServiceCatCode = SC.ServiceCatCode
		GROUP BY
			SC.ServiceCatCode,
			SS.ServiceRInvCode,
			SS.DiscPerc) T
	WHERE
		( S.AdmissionCode = :ai_admissioncode ) and  
		( S.ServiceRInvCode = T.ServiceRInvCode )
	GROUP BY T.ServiceCatCode
	UNION ALL
	SELECT  
		RowGroup=2,
		ItemType='SERVICES',
		ServiceCatCode=NULL,
		Debit = SUM(isnull(S.CashCharged, 0)) + 
			ISNULL((SELECT SUM(CW.Amount) 
					FROM MasterCashWin CW, ServiceRHeader SS
					WHERE SS.AdmissionCode = :ai_admissioncode and  
						SS.ServiceRCatcode = 14 AND
						CW.DocumentType = 'RR' AND
						SS.ServiceRInvCode = CW.DocumentCode), 0),
		Credit = 0,
		AdmissionCode=:ai_admissioncode,
		Date=GETDATE(),
		Remarks=SPACE(255),
		Remarks2=SPACE(255)
	FROM
		ServiceRHeader S
	WHERE   
		( S.AdmissionCode = :ai_admissioncode ) and  
		( S.ServiceRCatcode = 14 ) AND
		( S.CashCharged <> 0 OR S.ServiceRInvCode IN (SELECT DISTINCT CW.DocumentCode FROM MasterCashWin CW WHERE CW.DocumentCode = S.ServiceRInvCode))
	UNION ALL
	SELECT
		RowGroup=2.1,
		ItemType='SERVICES',
		ServiceCatCode=NULL,
		Debit=SUM(CASE WHEN AMT > 0 THEN T.Amt ELSE 0 END),
		Credit=SUM(CASE WHEN AMT > 0 THEN 0 ELSE T.Amt END),
		AdmissionCode=:ai_admissioncode,
		Date=GETDATE(),
		Remarks=SPACE(255),
		Remarks2=SPACE(255)
	FROM 
		ServiceHeader S,
		(SELECT 
			SS.ServiceInvCode, 
			Amt=
				ROUND(SUM(DD.qty * (DD.Price - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
					SS.misccharges - SS.flatdisc, 0) -
				(ROUND(SUM(DD.qty * (DD.Price - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
					SS.misccharges - SS.flatdisc, 2)) + SS.misccharges - SS.flatdisc
		FROM ServiceHeader SS, ServiceDetail DD 
		WHERE 
			SS.ServiceInvCode = DD.ServiceInvCode AND
			SS.AdmissionCode IN (:ai_admissioncode )
		GROUP BY
			SS.ServiceInvCode,
			SS.DiscPerc,
			SS.FlatDisc,
			SS.DiscPerc,
			SS.MiscCharges) T
	WHERE
		( S.AdmissionCode = :ai_admissioncode ) and  
		( S.ServiceInvCode = T.ServiceInvCode )
	UNION ALL
	SELECT 
		RowGroup=2.2,
		ItemType='SERVICES',
		ServiceCatCode=NULL,
		Debit=SUM(CASE WHEN NETAMT > 0 THEN T.NetAmt ELSE 0 END),
		Credit=SUM(CASE WHEN NETAMT > 0 THEN 0 ELSE T.NetAmt END),
		AdmissionCode=:ai_admissioncode,
		Date=GETDATE(),
		Remarks=SPACE(255),
		Remarks2=SPACE(255)
	FROM 
		ServiceRHeader S,
		(SELECT 
			SS.ServiceRInvCode, 
			NetAmt=
				ROUND(SUM(DD.qty * (DD.serviceprice - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
				SS.misccharges - SS.flatdisc, 0) - 
				(ROUND(SUM(DD.qty * (DD.serviceprice - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
				SS.misccharges - SS.flatdisc, 2)) + SS.misccharges - SS.flatdisc
		FROM ServiceRHeader SS, ServiceRDetail DD 
		WHERE 
			SS.ServiceRInvCode = DD.ServiceRInvCode AND
			SS.AdmissionCode IN (:ai_admissioncode) 
		GROUP BY
			SS.ServiceRInvCode,
			SS.DiscPerc,
			SS.FlatDisc,
			SS.DiscPerc,
			SS.MiscCharges) T
	WHERE
		( S.AdmissionCode = :ai_admissioncode ) and  
		( S.ServiceRInvCode = T.ServiceRInvCode )
	UNION ALL
	SELECT
		RowGroup=3,
		ItemType='RECEIPTS/PAYMENTS',
		ServiceCatCode=NULL,
		Debit=GD.Debit,
		Credit=GD.Credit,
		AdmissionCode=:ai_admissioncode,
		Date=GL.Date,
		Remarks=LTRIM(RTRIM(VC.ShortName)) + '-' + LTRIM(RTRIM(CAST(GL.VoucherCode AS Varchar(10)))),
		Remarks2=GD.Remarks
	FROM
		VocherCategory VC,
		GLHeader GL,
		GLDetail GD,
		Patient P,
		PatientAdmission PA
	WHERE   
		PA.AdmissionCode IN ( :ai_admissioncode ) AND
		PA.PatientCode = P.PatientCode AND
		GL.Posted = 'Y' AND
		GL.GlVochCode = GD.GLVochCode AND
		GL.VochCatCode = VC.VochCatCode AND
		GD.PatientCode = P.PatientCode AND
		GD.AccCode IN (SELECT AccCode FROM Accounts WHERE SubCode=3) AND
	 	GL.Date >= PA.Date AND
		GL.Date <= CASE PA.Discharged WHEN 'N' THEN GETDATE() ELSE PA.DischargedOn END
	UNION ALL
	SELECT
		RowGroup=3,
		ItemType='RECEIPTS/PAYMENTS',
		ServiceCatCode=NULL,
		Debit=V.Debit,
		Credit=V.Credit,
		AdmissionCode=:ai_admissioncode,
		Date=V.Date,
		Remarks=LTRIM(RTRIM(V.DocumentType)) + '-' + RTRIM(LTRIM(STR(V.DocumentCode, 10))), 
		Remarks2=V.Remarks
	FROM
		VirtualGL V,
		Patient P,
		PatientAdmission PA
	WHERE   
		PA.AdmissionCode IN (:ai_admissioncode) AND
		PA.PatientCode = P.PatientCode AND
		V.DocumentType = 'PA' AND
		V.DocumentCode = PA.AdmissionCode AND
		V.Credit > 0 AND
		V.Date >= PA.Date AND
		V.Date <= CASE PA.Discharged WHEN 'N' THEN GETDATE() ELSE PA.DischargedOn END
	UNION ALL
	SELECT
		RowGroup=3,
		ItemType='RECEIPTS/PAYMENTS',
		ServiceCatCode=NULL,
		Debit=
			CASE TT.TransactionCatCode 
			WHEN 1 THEN 0 
			ELSE ISNULL(TH.CashCharged,0) 
			END + 
		SUM(
			CASE TT.TransactionCatCode 
			WHEN 1 THEN 0 
			ELSE ISNULL(TD.Amount,0)
			END),
		Credit= 
			CASE TT.TransactionCatCode 
			WHEN 1 THEN ISNULL(TH.CashCharged,0) 
			ELSE 0
			END + 
			SUM(
			CASE TT.TransactionCatCode 
			WHEN 1 THEN ISNULL(TD.Amount,0)
			ELSE 0
			END),
		AdmissionCode=PA.AdmissionCode,
		Date = TH.Date, 
		Remarks = RTRIM(LTRIM(TT.ShortName)) + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), TH.TransactionCode))), 
		Remarks2 = 'Amount ' + CASE TT.TransactionCatCode WHEN 1 THEN 'Receipt' ELSE 'Paid' END + ' During Transaction Document: ' + RTRIM(LTRIM(CONVERT(CHAR(7), TH.DocumentCode)))
	FROM
		TransactionType TT,
		TransactionHeader TH
		LEFT OUTER JOIN 
			(SELECT TransactionDetail.* 
			FROM TransactionDetail, TransactionHeader, PatientAdmission
			WHERE 
				PatientAdmission.AdmissionCode IN (:ai_admissioncode) AND
				PatientAdmission.PatientCode = TransactionHeader.PatientCode AND
				TransactionHeader.Posted = 'Y' AND
				TransactionHeader.DocumentCode = TransactionDetail.DocumentCode AND
				TransactionDetail.Amount <> 0 ) AS TD ON (TH.DocumentCode = TD.DocumentCode),
		Patient P,
		PatientAdmission PA
	WHERE   
		PA.AdmissionCode IN (:ai_admissioncode) AND
		PA.PatientCode = P.PatientCode AND
		TH.Posted = 'Y' AND
		TH.TransactionTypeCode = TT.TransactionTypeCode AND
		TH.PatientCode = P.PatientCode AND
		TH.AccCode IN (SELECT AccCode FROM Accounts WHERE SubCode=3) AND
		TH.Date >= PA.Date AND
		TH.Date <= CASE PA.Discharged WHEN 'N' THEN GETDATE() ELSE PA.DischargedOn END
	GROUP BY
		TH.DocumentCode, 
		TT.ShortName, 
		TH.TransactionCode,
		TT.TransactionCatCode,
		TH.CashCharged,
		TH.Date, 
		P.RegNo,
		P.Name,
		PA.AdmissionCode,
		PA.Date,
		PA.UserCode,
		PA.DischargedOn,
		PA.DischargedBy,
		PA.Discharged,
		PA.LocationCode) AS T LEFT OUTER JOIN 	ServiceCategory AS SC ON (T.ServiceCatCode = SC.ServiceCatCode)
WHERE 
	PA.AdmissionCode = :ai_admissioncode AND
	PA.PatientCode = P.PatientCode AND
	PA.AdmissionCode = T.AdmissionCode
GROUP BY
	SC.Name, 
	T.RowGroup, 
	T.ItemType,	
	T.ServiceCatCode,
	T.Date,
	T.Remarks,
	T.Remarks2,
	P.RegNo, 
	P.Name, 
	PA.Date,
	PA.UserCode, 
	PA.DischargedON, 
	PA.DischargedBy,
	PA.Discharged,
	PA.LocationCode,
	PA.ProcedureRequired,
	PA.ProcedureCharges,
	PA.ProcedureGSTPerc,
	PA.TransportCharges
HAVING SUM(Debit) - SUM(Credit) <> 0
ORDER BY
	MainType,
	RowGroup,
	SubType,
	Category,
	RegNo,
	Patient"
  arguments=(("ai_admissioncode", number))
 sort="maintype A, rowgroup A, regno A, patient A, date A"
)
