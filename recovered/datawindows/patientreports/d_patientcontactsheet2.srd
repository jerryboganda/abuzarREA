table(column=(type=long key=yes update=yes updatewhereclause=yes name=patientcode dbname="Patient.PatientCode"  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="Patient.RegNo"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Patient.Name"  )
column=(type=char(201) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(25) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(302) updatewhereclause=yes name=contact dbname="Contact"  )
column=(type=char(60) update=yes updatewhereclause=yes name=doctor dbname="Doctor"  )
 retrieve="SELECT 
	PatientCode,
	RegNo,
	Name, 
	Address = LTRIM(RTRIM(ISNULL(Address1, '') + ' ' + ISNULL(Address2, ''))) ,
	City = City,
	Contact = LTRIM(RTRIM(ISNULL(MobileNo1, '') + ' ' + ISNULL(MobileNo2, '') + ' ' + ISNULL(MobileNo3, ''))),
	Doctor = (SELECT MAX(D.Name) FROM Doctors D 
				WHERE D.DoctCode IN
					(SELECT DoctCode=MAX(S.DoctCode)
					FROM SaleLedger S
					WHERE S.Date BETWEEN :adt_startdate AND :adt_enddate AND S.PatientCode = Patient.PatientCode
					UNION
					SELECT DoctCode=MAX(S.DoctCode)
					FROM ServiceHeader S
					WHERE S.Date BETWEEN :adt_startdate AND :adt_enddate AND S.PatientCode = Patient.PatientCode))
FROM 
	Patient
WHERE	
	PatientCode IN 
	(SELECT CASE WHEN S.AdmissionCode IS NULL THEN S.PatientCode ELSE (SELECT PA.AdmissionCode FROM PatientAdmission PA WHERE PA.AdmissionCode = S.AdmissionCode)END
	FROM SaleLedger S
	WHERE S.Date BETWEEN :adt_startdate AND :adt_enddate
	UNION
	SELECT CASE WHEN S.AdmissionCode IS NULL THEN S.PatientCode ELSE (SELECT PA.AdmissionCode FROM PatientAdmission PA WHERE PA.AdmissionCode = S.AdmissionCode)END
	FROM ServiceHeader S
	WHERE S.Date BETWEEN :adt_startdate AND :adt_enddate)
/*ORDER BY
	Name, RegNo*/


"
  update="Patient" updatewhere=1 updatekeyinplace=no
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="name A, regno A"
)
