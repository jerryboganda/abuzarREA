release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=614 color="536870912" )
summary(height=74 color="536870912" )
footer(height=0 color="536870912" )
detail(height=70 color="536870912" )
table(column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=decimal(2) updatewhereclause=yes name=patienttotal dbname="patienttotal"  )
 retrieve="SELECT
	A.regno,
	A.patientname,
	A.customer,
	patienttotal=sum(A.patienttotal)

FROM
		(select  
			
			regno=P.regno,
			patientname=P.name,
			customer=(select name from accounts where accounts.acccode=P.custcode),
			patienttotal=dbo.fn_getsaleinvtotal(SL.saleinvcode)
		from 
			saleledger SL , patient P
		where  
			SL.date>=:ad_StartDate AND 
			SL.date<=:ad_EndDate AND
			SL.custcode IN (:ai_custcode) AND
			P.patientcode=SL.patientcode 
		
			) as A
GROUP By
	A.customer,
	A.Patientname,
	A.Regno

ORDER BY
	A.customer,
	A.patientname,
	A.Regno
	

	"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_custcode", numberlist))
)
