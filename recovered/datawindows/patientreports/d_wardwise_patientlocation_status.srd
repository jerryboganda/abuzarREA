release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1114 color="536870912" )
summary(height=187 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=admittedby dbname="AdmittedBy"  )
column=(type=char(100) updatewhereclause=yes name=diagnosis dbname="Diagnosis"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=char(60) updatewhereclause=yes name=disease dbname="Disease"  )
column=(type=char(1) updatewhereclause=yes name=discharged dbname="Discharged"  )
column=(type=char(60) updatewhereclause=yes name=location dbname="Location"  )
column=(type=long updatewhereclause=yes name=floorcode dbname="WardCode"  )
column=(type=char(60) updatewhereclause=yes name=floor dbname="WardName"  )
column=(type=char(1) updatewhereclause=yes name=occupied dbname="Occupied"  )
 retrieve="SELECT
	PA.AdmissionCode,
	PA.PatientCode,
	PatientRegNo=P.RegNo, 
	PatientName=P.Name, 
	PA.Date,
	AdmittedBy=(SELECT Users.UserName FROM Users WHERE Users.UserCode = PA.UserCode),
	PA.Diagnosis, 
	Doctor=(SELECT Doctors.Name FROM Doctors WHERE Doctors.DoctCode = PA.DoctorCode), 
	Disease=(SELECT Disease.Name FROM Disease WHERE Disease.DiseaseCode = PA.DiseaseCode), 
	PA.Discharged,
	Location = L.Name,
	WardCode=L.WardCode,
	WardName=W.Name,
	Occupied='Y'
FROM 
	PatientAdmission PA, 
	Patient P, 
	PatientLocation L,
	Ward W,
	(SELECT 
		PA.AdmissionCode, 
		LocationCode= 					ISNULL((SELECT TargetLocation FROM PatientTransfer 
									WHERE PatientTransfer.TransferCode = 
											(SELECT Max(PatientTransfer.TransferCode) 
											FROM PatientTransfer 
											WHERE PatientTransfer.AdmissionCode = PA.AdmissionCode)), (SELECT A.LocationCode FROM PatientAdmission A WHERE A.AdmissionCode = PA.AdmissionCode))
	FROM PatientAdmission PA
	WHERE PA.Discharged = 'N') PAL
WHERE 
	L.WardCode IN (:ai_wardcode) AND
	PA.Discharged = 'N' AND
	PA.PatientCode = P.PatientCode AND
	PA.AdmissionCode = PAL.AdmissionCode AND
	PAL.LocationCode = L.LocationCode AND
	L.WardCode = W.WardCode
UNION ALL
SELECT 
	AdmissionCode=NULL,
	PatientCode=NULL,
	PatientRegNo=NULL, 
	PatientName=NULL, 
	Date=NULL,
	AdmittedBy=NULL,
	Diagnosis=NULL, 
	Doctor=NULL, 
	Disease=NULL, 
	Discharged=NULL,
	Location = L.Name,
	WardCode=L.WardCode,
	WardName=W.Name,
	Occupied='N'
FROM 
	PatientLocation L,
	Ward W
WHERE 
	L.WardCode IN (:ai_wardcode) AND
	L.LocationCode NOT IN 
	 	(SELECT DISTINCT LocationCode= ISNULL(
				(SELECT TargetLocation FROM PatientTransfer 
				WHERE PatientTransfer.TransferCode = 
						(SELECT Max(PatientTransfer.TransferCode) 
						FROM PatientTransfer 
						WHERE PatientTransfer.AdmissionCode = PA.AdmissionCode)), 
			(SELECT A.LocationCode 
			FROM PatientAdmission A 
			WHERE A.AdmissionCode = PA.AdmissionCode))
		FROM PatientAdmission PA
		WHERE PA.Discharged = 'N') AND
	L.WardCode = W.WardCode
ORDER BY
	W.Name,
	L.Name,
	Occupied,
	PatientName"
  arguments=(("ai_wardcode", numberlist))
)
