table(column=(type=char(1) updatewhereclause=yes name=reportgroup dbname="ReportGroup"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(4) updatewhereclause=yes name=srqty dbname="srqty"  )
column=(type=decimal(6) updatewhereclause=yes name=sramount dbname="sramount"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="MiscCharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="FlatDisc"  )
column=(type=decimal(6) updatewhereclause=yes name=invsaletax dbname="InvSaleTax"  )
column=(type=decimal(6) updatewhereclause=yes name=roundingdiff dbname="RoundingDiff"  )
column=(type=decimal(6) updatewhereclause=yes name=others dbname="Others"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=datetime updatewhereclause=yes name=inactivedate dbname="InActiveDate"  )
column=(type=long updatewhereclause=yes name=inactivecount dbname="InActiveCount"  )
 retrieve="SELECT
	ReportGroup='D',
	patient = (SELECT name FROM patient WHERE patientcode = :ai_patientcode ),
	regno = (SELECT regno FROM patient WHERE patientcode = :ai_patientcode ),
	a.itemname,
	qty =  ISNULL(SUM (CASE type When 'S' THEN ISNULL(Looseqty,0) END) , 0 ) ,
	amount = ISNULL(SUM (CASE type When 'S' THEN ISNULL(Amount,0) + ISNULL(SalesTax,0)  END),  0 ) , 
	srqty =  ISNULL(SUM (CASE type When 'R' THEN ISNULL(Looseqty,0) END) , 0 ) ,
	sramount = ISNULL(SUM (CASE type When 'R' THEN ISNULL(Amount,0)  + ISNULL(SalesTax,0) END) , 0),
	MiscCharges=0,
	FlatDisc=0,
	InvSaleTax=0, 
	RoundingDiff = 0,
	Others = 0,
	Debit=0.00000,
	Credit=0.00000,
	InActiveDate = (SELECT InActiveDate FROM patient WHERE patientcode = :ai_patientcode ),
	InActiveCount = (SELECT InActiveCount FROM patient WHERE patientcode = :ai_patientcode )
FROM
	(SELECT 
		type = 'S' ,
		looseqty=saledetail.looseqty,
		amount=( ( saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)),
		salestax = Round(((saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc)) * saledetail.gstperc * 0.01), 2) + 
			Round((saledetail.looseqty + saledetail.bonusqty) * saledetail.unitsalestax, 2),
		itemname=item.name
	FROM
		dbo.saleledger, 
		dbo.saledetail,    
		dbo.item 
	WHERE
		dbo.saleledger.date >= :ad_startdate AND
		dbo.saleledger.date <= :ad_enddate  AND
		dbo.saleledger.patientcode = :ai_patientcode AND
		dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND  
		dbo.saledetail.icode = item.icode 
	UNION ALL
	SELECT 
		type = 'R' ,
		looseqty= srdetail.looseqty,
		amount=( ( srdetail.looseqty * srdetail.srprice ) * (1 - (.01 * srdetail.discperc) )  ) * (1- (.01 * srledger.discperc)),
		salestax = Round(((srdetail.looseqty * srdetail.srprice ) * (1 - (.01 * srdetail.discperc)) * srdetail.gstperc * 0.01), 2) + 
			Round((srdetail.looseqty + srdetail.bonusqty) * srdetail.unitsalestax, 2),
		itemname = item.name
	FROM
		dbo.srledger, 
		dbo.srdetail,    
		dbo.item 
	WHERE
		dbo.srledger.date >= :ad_startdate AND
		dbo.srledger.date <= :ad_enddate  AND
		dbo.srledger.patientcode = :ai_patientcode AND
		dbo.srledger.srinvcode = dbo.srdetail.srinvcode AND  
		dbo.srdetail.icode = item.icode) AS A
GROUP BY itemname
UNION ALL
SELECT
	ReportGroup='T',
	patient = (SELECT patient.name FROM patient WHERE patient.patientcode = :ai_patientcode ),
	regno = (SELECT patient.regno FROM patient WHERE patient.patientcode = :ai_patientcode ),
	itemname='',
	qty = 0 ,
	amount = 0 , 
	srqty = 0 ,
	sramount = 0,
	MiscCharges=0,
	FlatDisc=0,
	InvSaleTax=0,
	RoundingDiff = 0,
	Others = 0,
	Debit=ISNULL(SUM(GD.Debit), 0),
	Credit=-ISNULL(SUM(GD.Credit), 0),
	InActiveDate = (SELECT InActiveDate FROM patient WHERE patientcode = :ai_patientcode ),
	InActiveCount = (SELECT InActiveCount FROM patient WHERE patientcode = :ai_patientcode )
FROM
	GLHeader GL,
	GLDetail GD
WHERE   
	GD.PatientCode IN (:ai_patientcode) AND
	GL.Posted = 'Y' AND
	GL.GlVochCode = GD.GLVochCode AND
	GD.AccCode IN (SELECT AccCode FROM Accounts WHERE SubCode=3) AND
	GL.Date BETWEEN :ad_startdate AND :ad_enddate
UNION ALL
SELECT
	ReportGroup='S',
	patient = (SELECT name FROM patient WHERE patientcode = :ai_patientcode ),
	regno = (SELECT regno FROM patient WHERE patientcode = :ai_patientcode ),
	itemname='',
	qty = 0 ,
	amount = 0 , 
	srqty = 0 ,
	sramount = 0,
	MiscCharges=SUM(T.MiscCharges),
	FlatDisc=SUM(T.FlatDisc),
	InvSaleTax=SUM(T.InvSaleTax),
	RoundingDiff = SUM(T.RoundingDiff),
	Others = SUM(ISNULL(T.MiscCharges, 0) - ISNULL(T.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0)),
	Debit=0.00000,
	Credit=0.00000,
	InActiveDate = (SELECT InActiveDate FROM patient WHERE patientcode = :ai_patientcode),
	InActiveCount = (SELECT InActiveCount FROM patient WHERE patientcode = :ai_patientcode )
FROM 
	(SELECT 
		PatientCode=:ai_patientcode,
		Type='S',
		InvCode=SS.SaleInvCode,
		MiscCharges=SS.MiscCharges,
		FlatDisc=SS.FlatDisc,
		InvSaleTax=	ROUND((SUM((DD.looseqty * 
			(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		RoundingDiff=
			ROUND(
					SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
						SUM(ROUND( (DD.looseqty * 
							(DD.saleprice - DD.itemflatdisc)) *
							(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
						ROUND( (SUM((DD.looseqty * 
							(DD.saleprice - DD.itemflatdisc)) *
							(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
							SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
					Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
						(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
						SS.misccharges + SS.salestax - SS.flatdisc, 0) - 
			
					(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
						SUM(ROUND( (DD.looseqty * 
							(DD.saleprice - DD.itemflatdisc)) *
							(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
						ROUND( (SUM((DD.looseqty * 
							(DD.saleprice - DD.itemflatdisc)) *
							(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
							SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
					SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
						(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
						SS.misccharges + SS.salestax - SS.flatdisc),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM SaleLedger SS, SaleDetail DD 
	WHERE 
		SS.PatientCode IN (:ai_patientcode) AND
		SS.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SS.SaleInvCode = DD.SaleInvCode
	GROUP BY
		SS.SaleInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax
	UNION ALL
	SELECT 
		PatientCode=:ai_patientcode,
		Type='R',
		InvCode=SS.SRInvCode,
		MiscCharges=-SS.MiscCharges,
		FlatDisc=-SS.FlatDisc,
		InvSaleTax=	ROUND((SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		RoundingDiff=
		- (ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) - 
		
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc) ),
		NetAmt=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM SRLedger SS, SRDetail DD 
	WHERE 
		SS.PatientCode IN (:ai_patientcode) AND
		SS.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SS.SRInvCode = DD.SRInvCode
	GROUP BY
		SS.SRInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
GROUP BY PatientCode
ORDER BY
	PATIENT,
	REGNO,
	REPORTGROUP,
	ITEMNAME"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_patientcode", number), ("ai_otamount", number), ("ai_audience", number))
)
