release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=760 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(1) updatewhereclause=yes name=customerline1 dbname="CustomerLine1"  )
column=(type=char(1) updatewhereclause=yes name=customerline2 dbname="CustomerLine2"  )
column=(type=char(60) updatewhereclause=yes name=saletype dbname="SaleType"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Regno"  )
column=(type=char(60) updatewhereclause=yes name=employeename dbname="EmployeeName"  )
column=(type=char(1) updatewhereclause=yes name=patientgender dbname="patientgender"  )
column=(type=datetime updatewhereclause=yes name=patientdob dbname="patientDOB"  )
column=(type=char(25) updatewhereclause=yes name=patientcnic dbname="patientcnic"  )
column=(type=char(100) updatewhereclause=yes name=patientadd1 dbname="patientadd1"  )
column=(type=char(100) updatewhereclause=yes name=patientadd2 dbname="patientadd2"  )
column=(type=char(60) updatewhereclause=yes name=designation dbname="Designation"  )
column=(type=decimal(8) updatewhereclause=yes name=amount dbname="Amount"  )
 retrieve="SELECT 
	CustomerName = A.Name,
	AliasName = A.AliasName,
	CustomerLine1 = :as_line1,
	CustomerLine2 = :as_line2,
	SaleType = (SELECT ST.Name FROM SaleType ST WHERE ST.SaleTypeCode = :ai_SaleTypeCode),
	PatientCode=P.PatientCode,
	Regno=P.RegNo,
	EmployeeName = P.Name,
	patientgender=max(P.gender),
	patientDOB=max(P.DOB),
	patientcnic=max(P.NationalIDCard),
	patientadd1=max(P.Address1),
	patientadd2=max(P.Address2),
	Designation = (SELECT R.Name FROM Rank R WHERE P.RankCode = R.RankCode),
	Amount = ISNULL(SUM(T.Amount), 0)
FROM
	Customer C,
	Accounts A,
	Patient P,
	(SELECT 
		S.CustCode,
		S.SaleTypeCode,
		S.PatientCode,
		S.SaleInvCode,
		Amount = SUM((D.LooseQty * D.SalePrice) * (1 + :ad_servicecharge * 0.01))
	FROM
		SaleLedger S,
		SaleDetail D
	WHERE
		S.CustCode = :ai_custcode AND
		S.SaleTypeCode = :ai_SaleTypeCode AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SaleInvCode = D.SaleInvCode
	GROUP BY 
		S.CustCode,
		S.SaleTypeCode,
		S.PatientCode,
		S.SaleInvCode) T
WHERE		
	C.CustCode = :ai_custcode AND
	C.CustCode = A.AccCode AND
	A.AccCode = T.CustCode AND
	T.PatientCode = P.PatientCode
GROUP BY
	A.Name,
	A.AliasName,
	P.PatientCode,
	P.RegNo,
	P.Name,
	P.RankCode"
  arguments=(("ai_custcode", number), ("ai_saletypecode", number), ("adt_startdate", datetime), ("adt_enddate", datetime), ("as_line1", string), ("as_line2", string), ("ad_servicecharge", number))
 sort="customername A, saletype A, employeename A, regno A"
)
