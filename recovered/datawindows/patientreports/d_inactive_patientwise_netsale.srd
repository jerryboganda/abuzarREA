release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1677 color="536870912" )
summary(height=187 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleamount dbname="SaleAmount"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=returnamount dbname="ReturnAmount"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=netsale dbname="NetSale"  )
column=(type=long updatewhereclause=yes name=customercatcode dbname="CustomerCatCode"  )
column=(type=decimal(2) updatewhereclause=yes name=discount dbname="Discount"  )
 retrieve="SELECT 
	CustomerCategory=CC.Name,
	Customer=A.Name,
	PatientCode = P.PatientCode,
	Patient = P.Name,
	RegNo = P.RegNo,
	SaleAmount = ISNULL(SUM(SaleAmount), 0), 
	ReturnAmount = ISNULL(SUM(ReturnAmount), 0),
	NetSale = ISNULL(SUM(SaleAmount), 0) - ISNULL(SUM(ReturnAmount), 0),
	CustomerCatCode=(Select custcatcode from customer where customer.custcode=max(P.custcode)),
	Discount = (SELECT Discount=SUM(V.Credit) FROM VirtualGl V WHERE V.CatCode = 102 AND V.PatientCode = P.PatientCode AND V.Debit = 0)
FROM
	DBO.CustomerCategory CC,
	DBO.Customer C,
	DBO.Accounts A,
	DBO.Patient P
	LEFT OUTER JOIN 
	(SELECT 
		SL.PatientCode,
		SaleAmount = SUM(SL.InvTotal),
		ReturnAmount= 0.00
	FROM 	 
		DBO.SaleLedger SL, Patient P
	WHERE
		P.InActiveDate >= :ad_startdate AND
		P.InActiveDate <= :ad_enddate AND
		P.Active = 'N' AND
		SL.patientcode = P.PatientCode
	GROUP BY
		SL.PatientCode
	UNION ALL
	SELECT 
		SL.PatientCode,
		SaleAmount = 0.00,
		ReturnAmount= SUM(SL.InvTotal)
	FROM 	 
		DBO.SRLedger SL, Patient P
	WHERE
		P.InActiveDate >= :ad_startdate AND
		P.InActiveDate <= :ad_enddate AND
		P.Active = 'N' AND
		SL.patientcode = P.PatientCode
	GROUP BY
		SL.PatientCode) AS S ON (P.PatientCode = S.PatientCode)
WHERE
	P.InActiveDate >= :ad_startdate AND
	P.InActiveDate <= :ad_enddate AND
	P.Active = 'N' AND
	P.CustCode = C.CustCode AND
	C.CustCatCode = CC.CustCatCode AND
	C.CustCode = A.AccCode
GROUP BY 
	CC.Name,
	A.Name,
	P.PatientCode,
	P.Name,
	P.RegNo
ORDER BY
	CC.Name,
	A.Name,
	P.Name,
	P.RegNo
	"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
)
