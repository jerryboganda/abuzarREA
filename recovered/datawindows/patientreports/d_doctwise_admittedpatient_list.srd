table(column=(type=char(60) updatewhereclause=yes name=doctorname dbname="DoctorName"  )
column=(type=char(60) updatewhereclause=yes name=disease dbname="Disease"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=char(60) updatewhereclause=yes name=location dbname="Location"  )
column=(type=datetime updatewhereclause=yes name=admissiondate dbname="AdmissionDate"  )
column=(type=char(1) updatewhereclause=yes name=discharged1 dbname="Discharged1"  )
 retrieve="SELECT 
	DoctorName  = D.Name,
	Disease = PD.Name,
	PatientCode=P.PatientCode,
	RegNo = P.RegNo,
	PatientName = P.Name,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = P.CustCode),
	AdmissionCode=PA.AdmissionCode,
	Location = PL.Name,
	AdmissionDate=PA.Date,
	Discharged1 = PA.Discharged1
FROM 
	PatientAdmission PA,
	Patient P,
	Doctors D,
	PatientLocation PL,
	Disease PD
WHERE
	PA.Discharged = 'N' AND
	PA.PatientCode = P.PatientCode AND
	PA.DoctorCode = D.DoctCode AND
	D.DoctCode IN (:ai_doctorcode) AND
	PA.LocationCode  = PL.LocationCode AND
	PA.DiseaseCode = PD.DiseaseCode
ORDER BY
	DoctorName,
	Customer,
	PatientName,
	Location
	"
  arguments=(("ai_doctorcode", numberlist))
)
