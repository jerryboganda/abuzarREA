table(column=(type=char(50) updatewhereclause=yes name=mcno dbname="MCNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=long updatewhereclause=yes name=age dbname="Age"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=char(60) updatewhereclause=yes name=test dbname="Test"  )
column=(type=datetime updatewhereclause=yes name=visitdate dbname="VisitDate"  )
column=(type=long updatewhereclause=yes name=tokenno dbname="TokenNo"  )
column=(type=decimal(4) updatewhereclause=yes name=fee dbname="Fee"  )
column=(type=decimal(7) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(6) updatewhereclause=yes name=received dbname="Received"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=decimal(4) updatewhereclause=yes name=shareamt dbname="ShareAmt"  )
 retrieve="SELECT 
	MCNo = P.RegNo,
	PatientName = P.Name,
	Age = P.AgeYears,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = SH.CustCode),
	Doctor=D.Name,
	Test = S.Name,
	VisitDate=SH.Date,
	TokenNo=SH.TokenNo,
	Fee = SUM(SD.Qty * SD.Price),
	Discount = SUM(
		(SD.Qty * SD.ServiceFlatDisc) + 
		(SD.Qty * (SD.Price - SD.ServiceFlatDisc) * (SD.DiscPerc * 0.01)) +
		(SD.Qty * (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (SH.DiscPerc * 0.01))),
	Received = SUM(
		(SD.Qty * (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SH.DiscPerc * 0.01))),
	UserName = U.UserName,
	ShareAmt = SUM(SD.Qty * SD.Commission) + 
		SUM(	SD.Qty * (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SH.DiscPerc * 0.01) * SD.SharePerc * 0.01)
FROM ServiceHeader SH, ServiceDetail SD, Doctors D, Service S, Patient P, Users U
WHERE 
	SH.Date BETWEEN :adt_startdate AND :adt_enddate AND
	SH.ServiceInvCode = SD.ServiceInvCode AND
	SH.PatientCode = P.PatientCode AND
	SH.SalesManCode = U.UserCode AND
	P.DoctCode = D.DoctCode AND
	D.DoctCode IN (:ai_doctcode) AND
	SD.ServiceCode=S.ServiceCode
GROUP BY
	P.RegNo,
	P.Name,
	P.AgeYears,
	D.Name,
	S.Name,
	SH.Date,
	SH.CustCode,
	SH.TokenNo,
	U.UserName

"
  arguments=(("ai_doctcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="doctor A, customer A, patientname A"
)
