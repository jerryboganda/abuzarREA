table(column=(type=char(20) updatewhereclause=yes name=patientcategory dbname="patientcategory"  )
column=(type=char(20) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(20) updatewhereclause=yes name=patientname dbname="patientname"  )
column=(type=char(20) updatewhereclause=yes name=location dbname="location"  )
column=(type=datetime updatewhereclause=yes name=admissiondate dbname="admissiondate"  )
column=(type=datetime updatewhereclause=yes name=dischargedate dbname="dischargedate"  )
column=(type=number updatewhereclause=yes name=amount dbname="amount"  )
 retrieve="SELECT
	PatientCode=P.PatientCode,
	RegNo = P.RegNo,
	PatientName = P.Name,
	PatientCategory = PC.Name,
	Location = 
		(SELECT PL.Name + ', ' + W.Name
		FROM PatientLocation PL, Ward W, PatientAdmission PA 
		WHERE PL.WardCode=W.WardCode AND PL.LocationCode = PA.LocationCode AND
		PA.AdmissionCode IN (SELECT MAX(PAA.AdmissionCode) FROM PatientAdmission PAA WHERE PAA.PatientCode=P.PatientCode)),
	AdmissionDate = (SELECT PA.Date FROM PatientAdmission PA 
		WHERE PA.AdmissionCode IN (SELECT MAX(PAA.AdmissionCode) FROM PatientAdmission PAA WHERE PAA.PatientCode=P.PatientCode)),
	DischargeDate = (SELECT PA.DischargedOn FROM PatientAdmission PA 
		WHERE PA.AdmissionCode IN (SELECT MAX(PAA.AdmissionCode) FROM PatientAdmission PAA WHERE PAA.PatientCode=P.PatientCode)),
	ItemType = T.ItemType,
	Amount = SUM(T.ItemValue + T.Others)
FROM	
	Patient P,
	PatientCategory PC,
	(SELECT  
		SummaryGroup=0,  
		RowGroup=1, 
		ItemType=' MEDICINE',
		PatientCode = ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)),
		ItemValue=SUM(S.InvTotal),
		Others= 0.00
	FROM 
		SaleLedger S
	WHERE
		( ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)) > 0 ) and  
		(S.Date BETWEEN :adt_startdate AND :adt_enddate)
	GROUP  BY
		S.PatientCode,
		S.AdmissionCode,
		S.SaleCatCode,
		S.CustCode
	UNION ALL
	SELECT  
		SummaryGroup=0,  
		RowGroup=3,
		ItemType=' MEDICINE',
		PatientCode = ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)),
		ItemValue= - SUM(S.InvTotal),
		Others= 0.00
	FROM
		SRLedger S
	WHERE   
		( ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)) > 0 ) and  
		S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY 
		S.PatientCode,
		S.AdmissionCode,
		S.SRInvCode,
		S.SRCatCode,
		S.CustCode
	UNION ALL
	SELECT 
		SummaryGroup=0,  
		RowGroup=5,
		ItemType=(SELECT SC.Name FROM ServiceCategory SC WHERE SC.ServiceCatCode=SV.ServiceCatCode),
		PatientCode = ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)),
		ItemValue=SUM(D.Qty * (D.Price - D.ServiceFlatDisc) * (1 - (0.01 * D.discperc)) * (1-(0.01 * S.discperc))),
		Others= 0.00
	FROM 
		ServiceHeader S,
		Servicedetail D,
		Service SV
	WHERE
		( ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)) > 0 ) and  
		( S.ServiceInvCode = D.ServiceInvCode ) and
		( D.ServiceCode = SV.Servicecode ) AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP  BY
		S.PatientCode,
		S.AdmissionCode,
		S.ServiceInvCode,
		SV.ServiceCatCode,
		S.ServiceCatCode,
		S.CustCode
	UNION ALL
	SELECT 
		SummaryGroup=0,  
		RowGroup=6.1,
		ItemType=(SELECT SC.Name FROM ServiceCategory SC WHERE SC.ServiceCatCode=SV.ServiceCatCode),
		PatientCode = ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)),
		ItemValue=-1 * SUM(D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - (0.01 * D.discperc)) * (1 - (0.01 * S.discperc))),
		Others= 0.00
	FROM 
		ServiceRHeader S,
		ServiceRdetail D,
		Service SV
	WHERE
		( ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)) > 0 ) AND
		( S.ServiceRInvCode = D.ServiceRInvCode ) and
		( D.ServiceCode = SV.Servicecode ) AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP  BY
		S.PatientCode,
		S.AdmissionCode,
		S.ServiceRInvCode,
		SV.ServiceCatCode,
		S.ServiceRCatCode,
		S.CustCode) T
WHERE
	P.PatientCode=T.PatientCode AND
	P.PatientCatCode = PC.PatientCatCode
GROUP BY
	P.PatientCode,
	P.RegNo,
	P.Name,
	PC.Name,
	T.ItemType"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="patientcategory A, regno A, patientname A, location A, admissiondate A, dischargedate A"
)
