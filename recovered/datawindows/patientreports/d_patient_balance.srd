release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1489 color="536870912" )
summary(height=229 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=char(1) updatewhereclause=yes name=discharged dbname="Discharged"  )
column=(type=char(60) updatewhereclause=yes name=location dbname="Location"  )
 retrieve="SELECT 
	A.RegNo,
	A.Name, 
	A.PatientCode,
	Doctor=(SELECT D.Name FROM Doctors D WHERE D.DoctCode = A.DoctCode),
	A.Customer,
	CustomerCategory = (SELECT CustomerCategory.Name FROM CustomerCategory WHERE CustomerCategory.CustCatCode = A.CustCatCode),
	Debit= CASE WHEN Balance > 0 THEN Balance ELSE 0 END,
	Credit= CASE WHEN Balance < 0 THEN ABS(Balance) ELSE 0 END,
	Discharged=
		(SELECT PA.Discharged 
		FROM PatientAdmission PA
		WHERE PA.AdmissionCode IN 	
			(SELECT AdmissionCode=MAX(AdmissionCode) 
			FROM PatientAdmission 
			WHERE PatientCode = A.PatientCode)),
	Location=
		CASE WHEN A.LocationCode IS NULL THEN
			(SELECT PL.Name
			FROM PatientAdmission PA, PatientLocation PL
			WHERE 
				PA.PatientCode = A.PatientCode AND
				PA.AdmissionCode IN 
					(SELECT AdmissionCode=MAX(AdmissionCode) 
					FROM PatientAdmission 
					WHERE PatientAdmission.PatientCode = A.PatientCode) AND
					PA.LocationCode = PL.LocationCode)
		ELSE
			(SELECT PL.Name
			FROM PatientLocation PL
			WHERE 
				A.LocationCode = PL.LocationCode)
		END	
FROM
	(SELECT 
		P.Name, P.RegNo, P.LocationCode, P.PatientCode, P.DoctCode,
		C.CustCode, Customer=A.Name, C.CustCatCode,
		Balance=SUM(V.Debit - V.Credit)
	FROM
		VirtualGL V,
		Accounts A,
		Customer C,
		SubAccounts S,
		Patient P
	WHERE 
		V.PatientCode = P.PatientCode AND
		P.PatientCode IN (:ai_patientcode) AND
		V.Date <= :ad_Date AND 
		V.AccCode = A.AccCode AND
		A.AccCode = C.CustCode AND
		V.AccCode = C.CustCode AND
		A.SubCode = S.SubAccCode 
	GROUP BY 
		P.PatientCode, 
		P.Name, 
		P.RegNo, 
		P.LocationCode,
		P.DoctCode,
		A.Name, 
		C.CustCode,
		C.CustCatCode) A
ORDER BY 
	A.RegNo, A.Name, A.PatientCode, A.Customer
   "
  arguments=(("ad_date", datetime), ("ai_patientcode", numberlist))
 sort="regno A, name A"
)
