release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=3450 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=1141 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=175 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=long updatewhereclause=yes name=summarygroup dbname="SummaryGroup"  )
column=(type=char(60) updatewhereclause=yes name=servicecategory dbname="ServiceCategory"  )
column=(type=decimal(1) updatewhereclause=yes name=rowgroup dbname="RowGroup"  )
column=(type=char(23) updatewhereclause=yes name=itemtype dbname="ItemType"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(100) updatewhereclause=yes name=patientaddress1 dbname="PatientAddress1"  )
column=(type=char(100) updatewhereclause=yes name=patientaddress2 dbname="PatientAddress2"  )
column=(type=char(100) updatewhereclause=yes name=patientaddress3 dbname="PatientAddress3"  )
column=(type=char(60) updatewhereclause=yes name=employeename dbname="EmployeeName"  )
column=(type=long updatewhereclause=yes name=diseasecode dbname="DiseaseCode"  )
column=(type=char(100) updatewhereclause=yes name=diagnosis dbname="Diagnosis"  )
column=(type=long updatewhereclause=yes name=doctorcode dbname="DoctorCode"  )
column=(type=long updatewhereclause=yes name=ageyears dbname="AgeYears"  )
column=(type=char(100) updatewhereclause=yes name=nextofkins dbname="NextOfKins"  )
column=(type=long updatewhereclause=yes name=relationcode dbname="RelationCode"  )
column=(type=char(100) updatewhereclause=yes name=nextofkinscontactno dbname="NextOfKinsContactNo"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=datetime updatewhereclause=yes name=admittedon dbname="AdmittedOn"  )
column=(type=char(60) updatewhereclause=yes name=admittedby dbname="AdmittedBy"  )
column=(type=datetime updatewhereclause=yes name=dischargedon dbname="DischargedOn"  )
column=(type=char(60) updatewhereclause=yes name=dischargedby dbname="DischargedBy"  )
column=(type=char(1) updatewhereclause=yes name=discharged dbname="PatientAdmission.Discharged"  )
column=(type=char(60) updatewhereclause=yes name=patientlocation dbname="PatientLocation"  )
column=(type=long updatewhereclause=yes name=transcode dbname="TransCode"  )
column=(type=char(10) updatewhereclause=yes name=transtype dbname="TransType"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=details dbname="Details"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="Cash"  )
column=(type=long updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VRow"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=grossvalue dbname="ItemValue"  )
column=(type=decimal(6) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=decimal(6) updatewhereclause=yes name=others dbname="Others"  )
 retrieve="SELECT 
	SummaryGroup=T.SummaryGroup,  
	ServiceCategory=T.ServiceCategory,
	RowGroup=T.RowGroup,
	ItemType=T.ItemType,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = P.CustCode),
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientAddress1=P.Address1,
	PatientAddress2=P.Address2,
	PatientAddress3=P.Address3,
	EmployeeName=P.EmployeeName,
	DiseaseCode=PA.DiseaseCode,
	Diagnosis=PA.Diagnosis,
	DoctorCode=PA.DoctorCode,
	AgeYears=DATEDIFF(yy, P.DOB, getdate()) + 1,
	NextOfKins=PA.NextOfKins,
	RelationCode=PA.RelationCode,
	NextOfKinsContactNo=PA.NextOfKinsContactNo,
	AdmissionCode=T.AdmissionCode,
	AdmittedOn=PA.Date,
	AdmittedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.UserCode),
	DischargedOn=PA.DischargedOn,
	DischargedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.DischargedBy),
	PA.Discharged,
	PatientLocation = (SELECT L.Name FROM PatientLocation L WHERE L.LocationCode = PA.LocationCode),
	TransCode=T.TransCode,
	TransType=T.TransType,
	Date=T.Date,
	Details=T.Details,
	Cash = T.Cash,
	CheckNo=T.CheckNo,
	VRow=T.VRow,
	Qty=T.Qty,
	ItemValue=T.ItemValue,
	NetAmt=T.NetAmt,
	Debit = Debit,
	Credit= T.Credit,
	Others= T.Others
FROM
	(SELECT 
		SummaryGroup=0,  
		RowGroup=5,
		ServiceCategory=(SELECT SC.NAME FROM ServiceCategory SC WHERE SC.ServiceCatCode = SV.ServiceCatCode),
		ItemType='SERVICES',
		AdmissionCode=S.AdmissionCode,
		TransCode=S.ServiceInvCode,
		TransType='RS-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceInvCode))),
		Date=S.Date,
		Details=SV.Name,
		Cash = CASE S.ServiceCatCode WHEN 11 THEN 'N' ELSE 'Y' END,
		CheckNo=NULL,
		VRow=MAX(D.SrvRowID),
		Qty=SUM(D.Qty),
		ItemValue=SUM(D.Qty * (D.Price - D.ServiceFlatDisc)  * (1-(.01*D.discperc)) * (1-(.01*S.discperc))),
		NetAmt=T.NetAmt,
		Debit = CASE MAX(D.SrvROWID) WHEN (SELECT MAX(SD.SrvROWID) 
			FROM ServiceDetail SD 
			WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN T.NetAmt ELSE 0 END,
		Credit= CASE MAX(D.SrvRowID) WHEN (SELECT MAX(SD.SrvROWID) 
			FROM ServiceDetail SD 
			WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN CASE S.ServiceCatCode WHEN 11 THEN 0 ELSE T.NetAmt END ELSE 0 END,
		Others= CASE MAX(D.SrvRowID) WHEN (SELECT MAX(SD.SrvROWID) 
			FROM ServiceDetail SD 
			WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END
	FROM 
		Patient P,
		PatientAdmission PA,
		Servicedetail D,
		ServiceHeader S,
		Service SV,
		(SELECT 
			SS.ServiceInvCode, 
			RoundingDiff=
			ROUND(SUM(DD.qty * (DD.Price - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
				SS.misccharges - SS.flatdisc, 0) -
			(SUM((DD.qty * (DD.Price - DD.ServiceFlatDisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
				SS.misccharges - SS.flatdisc),
			InvSaleTax=	0,
			NetAmt=ROUND(SUM(DD.qty * (DD.Price - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
				SS.misccharges - SS.flatdisc, 0)
		FROM ServiceHeader SS, ServiceDetail DD 
		WHERE 
			SS.ServiceInvCode = DD.ServiceInvCode AND
			SS.AdmissionCode IN (:ai_admissioncode)
		GROUP BY
			SS.ServiceInvCode,
			SS.DiscPerc,
			SS.FlatDisc,
			SS.DiscPerc,
			SS.MiscCharges) T
	WHERE
		( PA.AdmissionCode = :ai_admissioncode ) AND
		( PA.PatientCode = P.PatientCode ) and  
		( S.AdmissionCode = PA.AdmissionCode ) and  
		( S.ServiceInvCode = D.ServiceInvCode ) and
		( S.ServiceInvCode = T.ServiceInvCode ) AND
		( D.ServiceCode = SV.Servicecode )
	GROUP  BY
		S.AdmissionCode,
		PA.Date,
		PA.UserCode,
		S.ServiceInvCode,
		S.Date,
		SV.Name,
		SV.ServiceCatCode,
		S.ServiceCatCode,
		S.HeaderNo,
		S.CustCode, 
		S.Date,
		S.DiscPerc,
		S.MiscCharges,
		S.FlatDisc,
		T.InvSaleTax,
		T.NetAmt,
		T.RoundingDiff
	UNION ALL
	SELECT  
		SummaryGroup=0,  
		RowGroup=6,
		ServiceCategory=NULL,
		ItemType='SERVICES',
		AdmissionCode=S.AdmissionCode,
		TransCode=S.ServiceInvCode,
		TransType='RS-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceInvCode))),
		Date = S.Date, 
		Details = 'Amt. Recvd. During Service Inv. #:' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceInvCode))),
		Cash = CASE S.ServiceCatCode WHEN 11 THEN 'N' ELSE 'Y' END,
		CheckNo=NULL,
		VRow=9999999,
		Qty=0,
		ItemValue=0,
		NetAmt=0,
		Debit = 0,
		Credit= isnull(S.CashCharged, 0) + ISNULL((SELECT SUM(CW.Amount) FROM MasterCashWin CW WHERE CW.DocumentType = 'RS' AND CW.DocumentCode=S.ServiceInvCode), 0),
		Others= 0
	FROM
		Patient P,
		PatientAdmission PA,
		ServiceHeader S
	WHERE   
		( PA.AdmissionCode = :ai_admissioncode ) AND
		( PA.PatientCode = P.PatientCode ) and  
		( S.AdmissionCode = PA.AdmissionCode ) and  
		( S.ServiceCatcode = 11 ) AND
		( S.CashCharged <> 0 OR S.ServiceInvCode IN (SELECT DISTINCT CW.DocumentCode FROM MasterCashWin CW WHERE CW.DocumentType = 'RS' AND CW.DocumentCode = S.ServiceInvCode))
	UNION ALL
	SELECT 
		SummaryGroup=0,  
		RowGroup=6.1,
		ServiceCategory=(SELECT SC.NAME FROM ServiceCategory SC WHERE SC.ServiceCatCode = SV.ServiceCatCode),
		ItemType='SERVICES',
		AdmissionCode=S.AdmissionCode,
		TransCode=S.ServiceRInvCode,
		TransType='RR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceRInvCode))),
		Date=S.Date,
		Details=SV.Name,
		Cash = CASE S.ServiceRCatCode WHEN 14 THEN 'N' ELSE 'Y' END,
		CheckNo=NULL,
		VRow=MAX(D.SrvRRowID),
		Qty= - SUM(D.Qty),
		ItemValue=-1 * SUM(D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1-(.01*D.discperc)) * (1-(.01*S.discperc))),
		NetAmt= T.NetAmt,
		Debit = CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SrvRRowID) 
			FROM ServiceRDetail SD 
			WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN CASE S.ServiceRCatCode WHEN 14 THEN 0 ELSE T.NetAmt END ELSE 0 END,
		Credit= CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SrvRRowID) 
			FROM ServiceRDetail SD 
			WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN T.NetAmt ELSE 0 END,
		Others= CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SrvRROWID) 
			FROM ServiceRDetail SD 
			WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END
	FROM 
		Patient P,
		PatientAdmission PA,
		ServiceRdetail D,
		ServiceRHeader S,
		Service SV,
		(SELECT 
			SS.ServiceRInvCode, 
			RoundingDiff=
			ROUND(SUM(DD.qty * (DD.serviceprice - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
				SS.misccharges - SS.flatdisc, 0) -
			(SUM((DD.qty * DD.serviceprice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
				SS.misccharges - SS.flatdisc),
			InvSaleTax=	0,
			NetAmt=ROUND(SUM(DD.qty * DD.serviceprice * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
				SS.misccharges - SS.flatdisc, 0)
		FROM ServiceRHeader SS, ServiceRDetail DD 
		WHERE 
			SS.ServiceRInvCode = DD.ServiceRInvCode AND
			SS.AdmissionCode IN (:ai_admissioncode)
		GROUP BY
			SS.ServiceRInvCode,
			SS.DiscPerc,
			SS.FlatDisc,
			SS.DiscPerc,
			SS.MiscCharges) T
	WHERE
		( PA.AdmissionCode = :ai_admissioncode ) AND
		( PA.PatientCode = P.PatientCode ) and  
		( S.AdmissionCode = PA.AdmissionCode ) and  
		( S.ServiceRInvCode = D.ServiceRInvCode ) and
		( S.ServiceRInvCode = T.ServiceRInvCode ) AND
		( D.ServiceCode = SV.Servicecode )
	GROUP  BY
		S.AdmissionCode,
		PA.Date,
		PA.UserCode,
		S.ServiceRInvCode,
		S.Date,
		SV.Name,
		SV.ServiceCatCode,
		S.ServiceRCatCode,
		S.HeaderNo,
		S.CustCode, 
		S.Date,
		S.DiscPerc,
		S.MiscCharges,
		S.FlatDisc,
		T.InvSaleTax,
		T.NetAmt,
		T.RoundingDiff
	UNION ALL
	SELECT  
		SummaryGroup=0,  
		RowGroup=6,
		ServiceCategory=NULL,
		ItemType='SERVICES',
		AdmissionCode=S.AdmissionCode,
		TransCode=S.ServiceRInvCode,
		TransType='RR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceRInvCode))),
		Date = S.Date, 
		Details = 'Amt. Paid During Service Ret. Inv. #:' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceRInvCode))),
		Cash = CASE S.ServiceRCatCode WHEN 14 THEN 'N' ELSE 'Y' END,
		CheckNo=NULL,
		VRow=9999999,
		Qty=0,
		ItemValue=0,
		NetAmt=0,
		Debit = isnull(S.CashCharged, 0) + ISNULL((SELECT SUM(CW.Amount) FROM MasterCashWin CW WHERE CW.DocumentType = 'RR' AND CW.DocumentCode=S.ServiceRInvCode), 0),
		Credit= 0,
		Others= 0
	FROM
		Patient P,
		PatientAdmission PA,
		ServiceRHeader S
	WHERE   
		( PA.AdmissionCode = :ai_admissioncode ) AND
		( PA.PatientCode = P.PatientCode ) and  
		( S.AdmissionCode = PA.AdmissionCode ) and  
		( S.ServiceRCatcode = 14 ) AND
		( S.CashCharged <> 0 OR S.ServiceRInvCode IN (SELECT DISTINCT CW.DocumentCode FROM MasterCashWin CW WHERE CW.DocumentType = 'RR' AND CW.DocumentCode = S.ServiceRInvCode))
	UNION ALL
	SELECT 
		SummaryGroup=0,
		RowGroup=7,
		ServiceCategory=Null,
		ItemType='MEDICINE SALES',
		AdmissionCode=:ai_admissioncode,
		TransCode=NULL, 
		TransType = NULL, 
		Date = NULL, 
		Details = ItemType,
		Cash = NULL,
		NULL,
		Vrow=0,
		Qty=0,
		ItemValue=0,
		NetAmt=0,
		Debit=SUM(Debit),
		Credit=SUM(Credit),
		Others= 0
	FROM
		PatientAdmission PA,
		Patient P,
		(SELECT  
			RowGroup=1,
			ItemType='NET MEDICINE SALES VALUE',
			Debit=SUM(T.NetAmt),
			Credit=0,
			AdmissionCode=:ai_admissioncode
		FROM 
			SaleLedger S,
			(SELECT 
				SS.SaleInvCode, 
				NetAmt=ROUND(
				SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
					SUM(ROUND( (DD.looseqty * 
						(DD.saleprice - DD.itemflatdisc)) *
						(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
					ROUND( (SUM((DD.looseqty * 
						(DD.saleprice - DD.itemflatdisc)) *
						(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
						SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
				Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
					(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
					SS.misccharges + SS.salestax - SS.flatdisc, 0)
			FROM SaleLedger SS, SaleDetail DD 
			WHERE 
				SS.SaleInvCode = DD.SaleInvCode AND
				SS.AdmissionCode IN (:ai_admissioncode)
			GROUP BY
				SS.SaleInvCode,
				SS.DiscPerc,
				SS.FlatDisc,
				SS.InvGSTPerc1,
				SS.DiscPerc,
				SS.MiscCharges,
				SS.SalesTax) T
		WHERE
			( S.AdmissionCode = :ai_admissioncode ) AND	
			( S.SaleInvCode = T.SaleInvCode )
		UNION ALL
		SELECT  
			RowGroup=1,
			ItemType='NET MEDICINE SALES VALUE',
			Debit = 0,
			Credit = SUM(S.AMT),
			AdmissionCode=:ai_admissioncode
		FROM
			SaleLedger S
		WHERE   
			( S.AdmissionCode = :ai_admissioncode ) and  
			( S.Amt <> 0 AND S.SaleCatcode = 2 )
		UNION ALL
		SELECT  
			RowGroup=1,
			ItemType='NET MEDICINE SALES VALUE',
			Debit=0,
			Credit=SUM(T.NetAmt),
			AdmissionCode=:ai_admissioncode
		FROM
			SRLedger S,
			(SELECT 
				SS.SRInvCode, 
				NetAmt=ROUND(
				SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
					SUM(ROUND( (DD.looseqty * DD.SRPrice) *
						(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
					ROUND( (SUM((DD.looseqty * DD.SRPrice) *
						(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
						SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
				Round(SUM((DD.looseqty * DD.SRPrice) *
					(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
					SS.misccharges + SS.salestax - SS.flatdisc, 0)
			FROM SRLedger SS, SRDetail DD 
			WHERE 
				SS.AdmissionCode IN (:ai_admissioncode) AND
				SS.SRInvCode = DD.SRInvCode
			GROUP BY
				SS.SRInvCode,
				SS.DiscPerc,
				SS.FlatDisc,
				SS.InvGSTPerc1,
				SS.DiscPerc,
				SS.MiscCharges,
				SS.SalesTax) T
		WHERE   
			( S.AdmissionCode = :ai_admissioncode) AND
			( S.SRInvCode = T.SRInvCode)
		UNION ALL
		SELECT  
			RowGroup=1,
			ItemType='NET MEDICINE SALES VALUE',
			Debit=SUM(S.Amt),
			Credit=0,
			AdmissionCode=:ai_admissioncode
		FROM
			SRLedger S
		WHERE   
			( S.AdmissionCode = :ai_admissioncode ) and  
			( S.Amt <> 0 AND S.SRCatCode = 7 )) T
	WHERE 
		PA.AdmissionCode = :ai_admissioncode AND
		PA.PatientCode = P.PatientCode AND
		PA.AdmissionCode = T.AdmissionCode
	GROUP BY 
		T.RowGroup, T.ItemType, P.CustCode, P.RegNo, P.Name, PA.Date,
		PA.UserCode, PA.DischargedON, PA.DischargedBy,
		PA.Discharged, PA.LocationCode
	UNION ALL
	SELECT 
		SummaryGroup=0,
		RowGroup=8,
		ServiceCategory=Null,
		ItemType='RECEIPT/PAYMENT SUMMARY',
		AdmissionCode=:ai_admissioncode,
		TransCode=NULL, 
		TransType = NULL, 
		Date = NULL, 
		Details = ItemType,
		Cash = NULL,
		NULL,
		Vrow=0,
		Qty=0,
		ItemValue=0,
		NetAmt=0,
		Debit=SUM(Debit),
		Credit=SUM(Credit),
		Others= 0
	FROM
		PatientAdmission PA,
		Patient P,
		(SELECT
			RowGroup=2,
			ItemType='PATIENT ADMISSION RECEIPT',
			Debit=SUM(V.Debit),
			Credit=SUM(V.Credit),
			AdmissionCode=:ai_admissioncode
		FROM
			VirtualGL V,
			Patient P,
			PatientAdmission PA
		WHERE   
			PA.AdmissionCode IN (:ai_admissioncode) AND
			PA.PatientCode = P.PatientCode AND
			V.DocumentType = 'PA' AND
			V.DocumentCode = PA.AdmissionCode AND
			V.Credit > 0 AND
			V.Date >= PA.Date AND
			V.Date <= CASE PA.Discharged WHEN 'N' THEN GETDATE() ELSE PA.DischargedOn END
		UNION ALL
		SELECT
			RowGroup=3,
			ItemType=VC.Name,
			Debit=SUM(GD.Debit),
			Credit=SUM(GD.Credit),
			AdmissionCode=:ai_admissioncode
		FROM
			VocherCategory VC,
			GLHeader GL,
			GLDetail GD,
			Patient P,
			PatientAdmission PA
		WHERE   
			PA.AdmissionCode IN ( :ai_admissioncode ) AND
			PA.PatientCode = P.PatientCode AND
			GL.Posted = 'Y' AND
			GL.GlVochCode = GD.GLVochCode AND
			GL.VochCatCode = VC.VochCatCode AND
			GD.PatientCode = P.PatientCode AND
			GD.AccCode IN (SELECT AccCode FROM Accounts WHERE SubCode=3) AND
			GL.Date >= PA.Date AND
			GL.Date <= CASE PA.Discharged WHEN 'N' THEN GETDATE() ELSE PA.DischargedOn END
		GROUP BY VC.Name
		UNION ALL
		SELECT
			RowGroup=4,
			ItemType='PAYMENT/RECEIPT VIA TRANSACTION WINDOW',
			Debit=
				CASE TT.TransactionCatCode 
				WHEN 1 THEN 0 
				ELSE ISNULL(TH.CashCharged,0) 
				END + 
			SUM(
				CASE TT.TransactionCatCode 
				WHEN 1 THEN 0 
				ELSE ISNULL(TD.Amount,0)
				END),
			Credit= 
				CASE TT.TransactionCatCode 
				WHEN 1 THEN ISNULL(TH.CashCharged,0) 
				ELSE 0
				END + 
				SUM(
				CASE TT.TransactionCatCode 
				WHEN 1 THEN ISNULL(TD.Amount,0)
				ELSE 0
				END),
			AdmissionCode=PA.AdmissionCode
		FROM
			TransactionType TT,
			TransactionHeader TH
			LEFT OUTER JOIN 
				(SELECT TransactionDetail.* 
				FROM TransactionDetail, TransactionHeader, PatientAdmission
				WHERE 
					PatientAdmission.AdmissionCode IN (:ai_admissioncode) AND
					PatientAdmission.PatientCode = TransactionHeader.PatientCode AND
					TransactionHeader.Posted = 'Y' AND
					TransactionHeader.DocumentCode = TransactionDetail.DocumentCode AND
					TransactionDetail.Amount <> 0 ) AS TD ON (TH.DocumentCode = TD.DocumentCode),
			Patient P,
			PatientAdmission PA
		WHERE   
			PA.AdmissionCode IN (:ai_admissioncode) AND
			PA.PatientCode = P.PatientCode AND
			TH.Posted = 'Y' AND
			TH.TransactionTypeCode = TT.TransactionTypeCode AND
			TH.PatientCode = P.PatientCode AND
			TH.AccCode IN (SELECT AccCode FROM Accounts WHERE SubCode=3) AND
			TH.Date >= PA.Date AND
			TH.Date <= CASE PA.Discharged WHEN 'N' THEN GETDATE() ELSE PA.DischargedOn END
		GROUP BY
			TH.DocumentCode, 
			TT.ShortName, 
			TH.TransactionCode,
			TT.TransactionCatCode,
			TH.CashCharged,
			TH.Date, 
			P.RegNo,
			P.Name,
			PA.AdmissionCode,
			PA.Date,
			PA.UserCode,
			PA.DischargedOn,
			PA.DischargedBy,
			PA.Discharged,
			PA.LocationCode) T
	WHERE 
		PA.AdmissionCode = :ai_admissioncode AND
		PA.PatientCode = P.PatientCode AND
		PA.AdmissionCode = T.AdmissionCode
	GROUP BY 
		T.RowGroup, T.ItemType, P.CustCode, P.RegNo, P.Name, PA.Date,
		PA.UserCode, PA.DischargedON, PA.DischargedBy,
		PA.Discharged, PA.LocationCode) T,
	Patient P,
	PatientAdmission PA
WHERE
	T.AdmissionCode = PA.AdmissionCode AND
	PA.PatientCode = P.PatientCode
ORDER BY
	SummaryGroup,  
	RowGroup,
	ItemType,
	ServiceCategory,
	RegNo,
	Patient,
	Date,
	TransType,
	TransCode,
	VRow
"
  arguments=(("ai_admissioncode", number))
 sort="summarygroup A, rowgroup A, itemtype A, servicecategory A, regno A, patient A, date A, transtype A, vrow A"
)
