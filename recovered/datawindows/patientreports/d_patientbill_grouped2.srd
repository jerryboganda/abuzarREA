release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1083 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=591 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=183 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=long updatewhereclause=yes name=summarygroup dbname="SummaryGroup"  )
column=(type=decimal(1) updatewhereclause=yes name=rowgroup dbname="RowGroup"  )
column=(type=char(28) updatewhereclause=yes name=itemtype dbname="ItemType"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=long updatewhereclause=yes name=transcode dbname="TransCode"  )
column=(type=char(31) updatewhereclause=yes name=transtype dbname="TransType"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=details dbname="Details"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="Cash"  )
column=(type=char(100) updatewhereclause=yes name=checkno dbname="VirtualGl.CheckNo"  )
column=(type=decimal(0) updatewhereclause=yes name=vrow dbname="Vrow"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=grossvalue dbname="ItemValue"  )
column=(type=decimal(6) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=decimal(6) updatewhereclause=yes name=others dbname="Others"  )
 retrieve="SELECT
	SummaryGroup=0,  
	RowGroup=0,
	ItemType='PATIENT REGISTRATION RECEIPT',
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientCode = P.PatientCode,
	TransCode=V.DocumentCode, 
	TransType = LTRIM(RTRIM(V.DocumentType)) + '-' + RTRIM(LTRIM(STR(V.DocumentCode, 10))), 
	Date = V.Date, 
	Details = V.Remarks,
	Cash = 'N',
	V.CheckNo,
	Vrow=V.Vrow,
	Qty=0,
	ItemValue=0,
	NetAmt=0, 
	Debit=V.Debit,
	Credit=V.Credit,
	Others= 0
FROM
	VirtualGL V,
	Patient P
WHERE   
	P.PatientCode IN (:ai_patientcode) AND
	P.PatientCode = V.PatientCode AND
	V.DocumentType = 'PG' AND
	V.DocumentCode = P.PatientCode AND
	V.Credit > 0 AND
	V.Date BETWEEN :adt_startdate AND :adt_enddate
UNION ALL
SELECT  
	SummaryGroup=0,  
	RowGroup=1, 
	ItemType='MEDICINE',
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientCode = P.PatientCode,
	TransCode=S.SaleInvCode,
	TransType='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.Date, 
	Details = I.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=MAX(D.RowID),
	Qty=SUM(D.LooseQty),
	ItemValue=SUM(D.LooseQty * D.SalePrice) - 
		SUM((D.looseqty*D.itemflatdisc) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (1-(.01*D.discperc)) * 
				(.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN CASE S.SaleCatCode WHEN 2 THEN 0 ELSE T.NetAmt END ELSE 0 END,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END
FROM 
	Patient P,
	Item I,
	SaleLedger S,	 
	SaleDetail D,
	(SELECT 
		SS.SaleInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc),
		InvSaleTax=	ROUND((SUM((DD.looseqty * 
			(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM SaleLedger SS, SaleDetail DD 
	WHERE 
		SS.SaleInvCode = DD.SaleInvCode AND
		SS.PatientCode IN (:ai_patientcode) AND
		SS.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		SS.SaleInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE
	( P.PatientCode IN (:ai_patientcode) ) AND
	( S.PatientCode = P.PatientCode ) and  
	( S.SaleInvCode = D.SaleInvCode ) and
	( S.SaleInvCode = T.SaleInvCode ) and
	( D.ICode = I.Icode ) AND
	(S.Date BETWEEN :adt_startdate AND :adt_enddate)
GROUP  BY
	P.RegNo,
	P.Name,
	P.PatientCode,
	S.SaleInvCode,
	S.Date,
	I.CustomICode,
	I.Name,
	S.SaleCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	SummaryGroup=0,  
	RowGroup=2,
	ItemType='MEDICINE',
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientCode = P.PatientCode,
	TransCode=S.SaleInvCode,
	TransType='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = CASE WHEN S.AmtDate IS NULL THEN S.Date ELSE S.AmtDate END, 
	Details = 'Amt. Recvd. During Sale #:' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	CheckNo=S.AmtReference,
	VRow=9999999,
	Qty=0,
	ItemValue=0,
	NetAmt=0,
	Debit = 0,
	Credit= isnull(S.Amt, 0) + isnull(S.CashCharged, 0) + ISNULL((SELECT SUM(CW.Amount) FROM CashierWindow CW WHERE CW.SaleInvCode=S.SaleInvCode), 0),
	Others= 0
FROM
	Patient P,
	SaleLedger S
WHERE   
	( P.PatientCode IN (:ai_patientcode) ) AND
	( S.PatientCode = P.PatientCode ) and  
	( S.SaleCatcode = 2 ) AND
	( S.Amt <> 0 OR S.CashCharged <> 0 OR S.SaleInvCode IN (SELECT DISTINCT CW.SaleInvCode FROM CashierWindow CW WHERE CW.SaleInvCode = S.SaleInvCode)) AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate
UNION ALL
SELECT  
	SummaryGroup=0,  
	RowGroup=3,
	ItemType='MEDICINE',
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientCode = P.PatientCode,
	TransCode=S.SRInvCode,
	TransType='SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Date = S.Date, 
	Details = I.Name,
	Cash = CASE S.SRCatCode WHEN 7 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=MAX(D.SRUTN),
	Qty=-SUM(D.LooseQty),
	ItemValue= -1 * (SUM(D.LooseQty * D.SRPrice) - 
		SUM((D.looseqty * D.SRPrice * .01 * D.discperc) +
				(D.looseqty * D.SRPrice * (1-(.01*D.discperc)) * (.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * D.SRPrice * (1 - (.01 * D.discperc)) * D.gstperc * .01))),
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) FROM SRDetail SD 
		WHERE SD.SRInvCode=S.SRInvCode) THEN CASE S.SRCatCode WHEN 7 THEN 0 ELSE T.NetAmt END ELSE 0 END,
	Credit= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) FROM SRDetail SD WHERE SD.SRInvCode=S.SRInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) 
		FROM SRDetail SD 
		WHERE SD.SRInvCode=S.SRInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END
FROM
	Patient P,
	Item I,
	SRLedger S,
	SRDetail D,
	(SELECT 
		SS.SRInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * DD.SRPrice) *

				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty * DD.SRPrice *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc)),
		InvSaleTax=	ROUND((SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM SRLedger SS, SRDetail DD 
	WHERE 
		SS.PatientCode IN (:ai_patientcode) AND
		SS.SRInvCode = DD.SRInvCode AND
		SS.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		SS.SRInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	( P.PatientCode IN (:ai_patientcode) ) AND
	( S.PatientCode = P.PatientCode ) and  
	( S.SRInvCode = D.SRInvCode ) and
	( S.SRInvCode = T.SRInvCode ) and
	( D.ICode = I.Icode ) AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate
GROUP BY 
	P.RegNo,
	P.Name,
	P.PatientCode,
	S.SRInvCode,
	S.Date,
	I.CustomICode,
	I.Name,
	S.SRCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	SummaryGroup=0,  
	RowGroup=4,
	ItemType='MEDICINE',
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientCode=S.PatientCode,
	TransCode=S.SRInvCode,
	TransType='SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Date = CASE WHEN S.AmtDate IS NULL THEN S.Date ELSE S.AmtDate END, 
	Details = 'Cash Paid During S/Return #:' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Cash = CASE S.SRCatCode WHEN 7 THEN 'N' ELSE 'Y' END,
	CheckNo=S.AmtReference,
	VRow=9999999,
	Qty=0,
	ItemValue=0,
	NetAmt=0,
	Debit = ISNULL(S.Amt, 0) + isnull(S.CashCharged, 0) + ISNULL((SELECT SUM(CW.Amount) FROM MasterCashWin CW WHERE CW.DocumentType = 'SR' AND CW.DocumentCode=S.SRInvCode), 0),
	Credit= 0,
	Others= 0
FROM
	Patient P, SRLedger S
WHERE   
	( P.PatientCode IN (:ai_patientcode) ) AND
	( S.PatientCode = P.PatientCode ) and  
	( S.SRCatCode = 7 ) AND
	( S.Amt <> 0 OR S.CashCharged <> 0 OR S.SRInvCode IN (SELECT DISTINCT CW.DocumentCode FROM MasterCashWin CW WHERE CW.DocumentType = 'SR' AND CW.DocumentCode = S.SRInvCode)) AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate
UNION ALL
SELECT 
	SummaryGroup=0,  
	RowGroup=5,
	ItemType='SERVICES',
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientCode=S.PatientCode,
	TransCode=S.ServiceInvCode,
	TransType='RS-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceInvCode))),
	Date=S.Date,
	Details=SV.Name,
	Cash = CASE S.ServiceCatCode WHEN 11 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=MAX(D.SrvRowID),
	Qty=SUM(D.Qty),
	ItemValue=SUM(D.Qty * (D.price - D.ServiceFlatDisc) * (1-(.01*D.discperc)) * (1-(.01*S.discperc))),
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.SrvROWID) WHEN (SELECT MAX(SD.SrvROWID) 
		FROM ServiceDetail SD 
		WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.SrvRowID) WHEN (SELECT MAX(SD.SrvROWID) 
		FROM ServiceDetail SD 
		WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN CASE S.ServiceCatCode WHEN 11 THEN 0 ELSE T.NetAmt END ELSE 0 END,
	Others= CASE MAX(D.SrvRowID) WHEN (SELECT MAX(SD.SrvROWID) 
		FROM ServiceDetail SD 
		WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END
FROM 
	Patient P,
	Servicedetail D,
	ServiceHeader S,
	Service SV,
	(SELECT 
		SS.ServiceInvCode, 
		RoundingDiff=
		ROUND(SUM(DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges - SS.flatdisc, 0) -
		(SUM((DD.qty * (DD.price - DD.ServiceFlatDisc)) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges - SS.flatdisc),
		InvSaleTax=	0,
		NetAmt=ROUND(SUM(DD.qty * (DD.price - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges - SS.flatdisc, 0)
	FROM ServiceHeader SS, ServiceDetail DD 
	WHERE 
		SS.ServiceInvCode = DD.ServiceInvCode AND
		SS.PatientCode IN (:ai_patientcode)
	GROUP BY
		SS.ServiceInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.DiscPerc,
		SS.MiscCharges) T

WHERE
	( P.PatientCode IN (:ai_patientcode) ) AND
	( S.PatientCode = P.PatientCode ) and  
	( S.ServiceInvCode = D.ServiceInvCode ) and
	( S.ServiceInvCode = T.ServiceInvCode ) AND
	( D.ServiceCode = SV.Servicecode ) AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate
GROUP  BY
	P.RegNo,
	P.Name,
	S.PatientCode,
	S.ServiceInvCode,
	S.Date,
	SV.Name,
	S.ServiceCatCode,
	S.HeaderNo,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.FlatDisc,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	SummaryGroup=0,  
	RowGroup=6,
	ItemType='SERVICES',
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientCode=S.PatientCode,
	TransCode=S.ServiceInvCode,
	TransType='RS-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceInvCode))),
	Date = S.Date, 
	Details = 'Amt. Recvd. During Service Inv. #:' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceInvCode))),
	Cash = CASE S.ServiceCatCode WHEN 11 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=9999999,
	Qty=0,
	ItemValue=0,
	NetAmt=0,
	Debit = 0,
	Credit= isnull(S.CashCharged, 0) + ISNULL((SELECT SUM(CW.Amount) FROM MasterCashWin CW WHERE CW.DocumentType = 'RS' AND CW.DocumentCode=S.ServiceInvCode), 0),
	Others= 0
FROM
	Patient P,
	ServiceHeader S
WHERE   
	( P.PatientCode IN (:ai_patientcode) ) AND
	( S.PatientCode = P.PatientCode ) and  
	( S.ServiceCatcode = 11 ) AND
	( S.CashCharged <> 0 OR S.ServiceInvCode IN (SELECT DISTINCT CW.DocumentCode FROM MasterCashWin CW WHERE CW.DocumentType = 'RS' AND CW.DocumentCode = S.ServiceInvCode)) AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate
UNION ALL
SELECT 
	SummaryGroup=0,  
	RowGroup=6.1,
	ItemType='SERVICES',
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientCode=S.PatientCode,
	TransCode=S.ServiceRInvCode,
	TransType='RR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceRInvCode))),
	Date=S.Date,
	Details=SV.Name,
	Cash = CASE S.ServiceRCatCode WHEN 14 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=MAX(D.SrvRRowID),
	Qty= - SUM(D.Qty),
	ItemValue=-1 * SUM(D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1-(.01*D.discperc)) * (1-(.01*S.discperc))),
	NetAmt= T.NetAmt,
	Debit = CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SrvRRowID) 
		FROM ServiceRDetail SD 
		WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN CASE S.ServiceRCatCode WHEN 14 THEN 0 ELSE T.NetAmt END ELSE 0 END,
	Credit= CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SrvRRowID) 
		FROM ServiceRDetail SD 
		WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SrvRROWID) 
		FROM ServiceRDetail SD 
		WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END
FROM 
	Patient P,
	ServiceRdetail D,
	ServiceRHeader S,
	Service SV,
	(SELECT 
		SS.ServiceRInvCode, 
		RoundingDiff=
		ROUND(SUM(DD.qty * (DD.serviceprice - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges - SS.flatdisc, 0) -
		(SUM((DD.qty * (DD.serviceprice - DD.ServiceFlatDisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges - SS.flatdisc),
		InvSaleTax=	0,
		NetAmt=ROUND(SUM(DD.qty * (DD.serviceprice - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges - SS.flatdisc, 0)
	FROM ServiceRHeader SS, ServiceRDetail DD 
	WHERE 
		SS.ServiceRInvCode = DD.ServiceRInvCode AND
		SS.PatientCode IN (:ai_patientcode) AND
		SS.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		SS.ServiceRInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.DiscPerc,
		SS.MiscCharges) T
WHERE
	( P.PatientCode IN (:ai_patientcode) ) AND
	( S.PatientCode = P.PatientCode ) and  
	( S.ServiceRInvCode = D.ServiceRInvCode ) and
	( S.ServiceRInvCode = T.ServiceRInvCode ) AND
	( D.ServiceCode = SV.Servicecode ) AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate
GROUP  BY
	P.RegNo,
	P.Name,
	S.PatientCode,
	S.ServiceRInvCode,
	S.Date,
	SV.Name,
	S.ServiceRCatCode,
	S.HeaderNo,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.FlatDisc,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	SummaryGroup=0,  
	RowGroup=6,
	ItemType='SERVICES',
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientCode=S.PatientCode,
	TransCode=S.ServiceRInvCode,
	TransType='RR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceRInvCode))),
	Date = S.Date, 
	Details = 'Amt. Paid During Service Ret. Inv. #:' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceRInvCode))),
	Cash = CASE S.ServiceRCatCode WHEN 14 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=9999999,
	Qty=0,
	ItemValue=0,
	NetAmt=0,
	Debit = isnull(S.CashCharged, 0) + ISNULL((SELECT SUM(CW.Amount) FROM MasterCashWin CW WHERE CW.DocumentType = 'RR' AND CW.DocumentCode=S.ServiceRInvCode), 0),
	Credit= 0,
	Others= 0
FROM
	Patient P,
	ServiceRHeader S
WHERE   
	( P.PatientCode IN (:ai_patientcode) ) AND
	( S.PatientCode = P.PatientCode ) and  
	( S.ServiceRCatcode = 14 ) AND
	( S.CashCharged <> 0 OR S.ServiceRInvCode IN (SELECT DISTINCT CW.DocumentCode FROM MasterCashWin CW WHERE CW.DocumentType = 'RR' AND CW.DocumentCode = S.ServiceRInvCode)) AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate
UNION ALL
SELECT
	SummaryGroup=0,  
	RowGroup=9,
	ItemType='PAYMENT/RECEIPT',
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientCode=P.PatientCode,
	TransCode=GL.GLVochCode, 
	TransType = RTRIM(LTRIM(VC.ShortName)) + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), GL.GLVochCode))), 
	Date = GL.Date, 
	Details = GD.Remarks,
	Cash = 'N',
	GD.ChkNo,
	Vrow=GD.GLROWID,
	Qty=0,
	ItemValue=0,
	NetAmt=0,
	Debit=GD.Debit,
	Credit=GD.Credit,
	Others= 0
FROM
	VocherCategory VC,
	GLHeader GL,
	GLDetail GD,
	Patient P
WHERE   
	P.PatientCode IN (:ai_patientcode) AND
	GL.Posted = 'Y' AND
	GL.GlVochCode = GD.GLVochCode AND
	GL.VochCatCode = VC.VochCatCode AND
	GD.PatientCode = P.PatientCode AND
	GD.AccCode IN (SELECT AccCode FROM Accounts WHERE SubCode=3) AND
	GL.Date BETWEEN :adt_startdate AND :adt_enddate
UNION ALL
SELECT
	SummaryGroup=0,
	RowGroup=9,
	ItemType='PAYMENT/RECEIPT',
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientCode=P.PatientCode,
	TransCode=TH.DocumentCode, 
	TransType = RTRIM(LTRIM(TT.ShortName)) + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), TH.TransactionCode))), 
	Date = TH.Date, 
	Details = CASE WHEN LEN(TH.Remarks) > 0 THEN TH.Remarks ELSE 'Amount ' + CASE TT.TransactionCatCode WHEN 1 THEN 'Receipt' ELSE 'Paid' END + ' During Transaction Document: ' + RTRIM(LTRIM(CONVERT(CHAR(7), TH.DocumentCode))) END,
	Cash = 'N',
	ChkNo=SPACE(100),
	Vrow=0,
	Qty=0,
	ItemValue=0,
	NetAmt=0,
	Debit= CASE TT.TransactionCatCode WHEN 1 THEN 0 ELSE ISNULL(TH.CashCharged,0) END,
	Credit= CASE TT.TransactionCatCode WHEN 1 THEN ISNULL(TH.CashCharged,0) ELSE 0 END,
	Others= 0
FROM
	TransactionType TT,
	TransactionHeader TH,
	Patient P
WHERE   
	P.PatientCode IN (:ai_patientcode) AND
	TH.Posted = 'Y' AND
	TH.CashCharged <> 0 AND 
	TH.TransactionTypeCode = TT.TransactionTypeCode AND
	TH.PatientCode = P.PatientCode AND
	TH.AccCode IN (SELECT AccCode FROM Accounts WHERE SubCode=3) AND
	TH.Date BETWEEN :adt_startdate AND :adt_enddate
UNION ALL
SELECT
	SummaryGroup=0,
	RowGroup=9,
	ItemType='PAYMENT/RECEIPT',
	RegNo = P.RegNo,
	Patient=P.Name,
	PatientCode=P.PatientCode,
	TransCode=TH.DocumentCode, 
	TransType = RTRIM(LTRIM(TT.ShortName)) + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), TH.TransactionCode))), 
	Date = TH.Date, 
	Details = CASE WHEN LEN(TD.Remarks) > 0 THEN TD.Remarks ELSE 'Amount ' + CASE TT.TransactionCatCode WHEN 1 THEN 'Receipt' ELSE 'Paid' END + ' During Transaction Document: ' + RTRIM(LTRIM(CONVERT(CHAR(7), TH.DocumentCode))) END,
	Cash = 'N',
	ChkNo=SPACE(100),
	Vrow=0,
	Qty=0,
	ItemValue=0,
	NetAmt=0,
	Debit= CASE TT.TransactionCatCode WHEN 1 THEN 0 	ELSE ISNULL(TD.Amount,0) 	END,
	Credit= CASE TT.TransactionCatCode WHEN 1 THEN ISNULL(TD.Amount,0) ELSE 0 END,
	Others= 0
FROM
	TransactionType TT,
	TransactionHeader TH
	LEFT OUTER JOIN 
		(SELECT TransactionDetail.* 
		FROM TransactionDetail, TransactionHeader, Patient
		WHERE 
			Patient.PatientCode IN (:ai_PatientCode) AND
			Patient.PatientCode = TransactionHeader.PatientCode AND
			TransactionHeader.Posted = 'Y' AND
			TransactionHeader.Date BETWEEN :adt_startdate AND :adt_enddate AND
			TransactionHeader.DocumentCode = TransactionDetail.DocumentCode AND
			TransactionDetail.Amount <> 0 ) AS TD ON (TH.DocumentCode = TD.DocumentCode),
	Patient P
WHERE   
	P.PatientCode IN (:ai_patientcode) AND
	TH.Posted = 'Y' AND
	TH.TransactionTypeCode = TT.TransactionTypeCode AND
	TH.PatientCode = P.PatientCode AND
	TH.AccCode IN (SELECT AccCode FROM Accounts WHERE SubCode=3) AND
	TH.Date BETWEEN :adt_startdate AND :adt_enddate
ORDER BY
	SummaryGroup,  
	RowGroup,
	ItemType,
	RegNo,
	Patient,
	Date,
	TransType,
	TransCode,
	VRow
"
  arguments=(("ai_patientcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime), ("ad_discperc", number))
 sort="regno A, patient A, summarygroup A, rowgroup A, itemtype A, date A, transtype A, vrow A"
)
