table(column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=long updatewhereclause=yes name=customercatcode dbname="CustomerCatCode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=decimal(2) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(2) updatewhereclause=yes name=returnvalue dbname="ReturnValue"  )
column=(type=datetime updatewhereclause=yes name=lasttransdate dbname="LastTransDate"  )
 retrieve="Select Customer = (Select name From Accounts Where Accounts.Acccode = C.custcode ) ,
		 CustomerCatCode=(select custcatcode from customer where customer.custcode=C.custcode),
		 custcode = c.custcode,
       RegNo  = IsNull( (Select RegNo From Patient  Where patientcode = C.PatientCode ) , '' ),
       PatientName  = IsNull( (Select Name From Patient  Where patientcode = C.PatientCode ) , 'N/A' ),
       SaleValue = Sum ( CASE C.Type When 'S' Then dbo.Fn_getSaleInvTotal(C.InvCode) Else 0 End ),
       ReturnValue = Sum ( CASE C.Type When 'SR' Then dbo.Fn_getSRInvTotal(C.InvCode) Else 0 End ),
       LastTransDate = Max(C.Date)
From (  	Select saleinvcode As InvCode, custcode, patientcode, date, Type = 'S'
			From SaleLedger 
		 	Where Date Between :ar_sdate And :ar_ldate And
					Custcode In (:al_custcode)

	     	Union All

	      Select srinvcode As InvCode, custcode, patientcode, date, Type = 'SR'
			From SRLedger 
		 	Where Date Between :ar_sdate And :ar_ldate And
					Custcode In (:al_custcode)
     ) C 

Group By C.custcode , C.patientcode



"
  arguments=(("ar_Sdate", datetime), ("ar_Ldate", datetime), ("al_custcode", numberlist))
 sort="customer A, patientname A"
)
