table(column=(type=long updatewhereclause=yes name=documentcode dbname="VirtualGl.documentcode"  )
column=(type=char(27) updatewhereclause=yes name=type dbname="type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="Patient.PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Patient.RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="Patient.name"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
column=(type=char(60) updatewhereclause=no name=patientcategory dbname="PatientCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(100) updatewhereclause=yes name=remark dbname="remark"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="cash"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="VirtualGl.CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VirtualGl.VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VirtualGl.vouchercode"  )
column=(type=char(1) updatewhereclause=yes name=discharged dbname="Discharged"  )
column=(type=char(60) updatewhereclause=yes name=location dbname="Location"  )
column=(type=decimal(2) updatewhereclause=yes name=patientbalance dbname="PatientBalance"  )
 retrieve="SELECT
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	P.PatientCode,
	P.RegNo,
	P.name,
	Customer = (SELECT Accounts.Name FROM Accounts WHERE C.CustCode = Accounts.AccCode),
	CustomerCategory = (SELECT CustomerCategory.Name FROM CustomerCategory WHERE CustomerCategory.CustCatCode = C.CustCatCode),
	PatientCategory = (SELECT PatientCategory.Name FROM PatientCategory WHERE PatientCategory.PatientCatCode = P.PatientCatCode),
	debit = V.Debit,
	credit= V.Credit,
	remark = V.Remarks,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	Discharged=
		(SELECT PA.Discharged 
		FROM PatientAdmission PA
		WHERE 
			PA.PatientCode = P.PatientCode AND
			PA.AdmissionCode IN 	
			(SELECT AdmissionCode=MAX(AdmissionCode) 
			FROM PatientAdmission 
			WHERE PatientAdmission.PatientCode = P.PatientCode)),
	Location=
		CASE WHEN P.LocationCode IS NULL THEN
			(SELECT PL.Name
			FROM PatientAdmission PA, PatientLocation PL
			WHERE 
				PA.PatientCode = P.PatientCode AND
				PA.AdmissionCode IN 
					(SELECT AdmissionCode=MAX(AdmissionCode) 
					FROM PatientAdmission 
					WHERE PatientAdmission.PatientCode = P.PatientCode) AND
					PA.LocationCode = PL.LocationCode)
		ELSE
			(SELECT PL.Name
			FROM PatientLocation PL
			WHERE 
				P.LocationCode = PL.LocationCode)
		END,
	PatientBalance = (SELECT Balance=ISNULL(SUM(VV.Debit - VV.Credit),0)
		FROM	VirtualGL VV
		WHERE 	VV.PatientCode = P.PatientCode AND
			VV.Date < :ad_startdate)
FROM
	VirtualGL V, Patient P, Customer C
WHERE
	V.PatientCode = P.PatientCode AND
	P.PatientCatCode IN (:ai_patientcatcode) AND
	V.PatientCode = P.PatientCode AND 
	V.AccCode = C.CustCode AND
	V.date BETWEEN :ad_startdate AND :ad_enddate
ORDER BY
	CustomerCategory, P.RegNo, P.Name, P.PatientCode, date, type, VRow
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_patientcatcode", numberlist))
 sort="patientcategory A, regno A, patientname A, date A, documentcode A, type A, vrow A"
)
