table(column=(type=char(60) updatewhereclause=yes name=disease dbname="Disease"  )
column=(type=decimal(2) updatewhereclause=yes name=sales dbname="Sales"  )
column=(type=decimal(9) updatewhereclause=yes name=cost dbname="Cost"  )
column=(type=decimal(2) updatewhereclause=yes name=gp dbname="GP"  )
column=(type=decimal(6) updatewhereclause=yes name=gprate dbname="GPRate"  )
column=(type=decimal(2) updatewhereclause=yes name=servicesales dbname="ServiceSales"  )
column=(type=decimal(2) updatewhereclause=yes name=servicecost dbname="ServiceCost"  )
column=(type=decimal(2) updatewhereclause=yes name=servicegp dbname="ServiceGP"  )
column=(type=decimal(6) updatewhereclause=yes name=servicegprate dbname="ServiceGPRate"  )
 retrieve="SELECT 
	Disease=S.Disease, 
	Sales=SUM(S.Sales), 
	Cost=SUM(S.Cost),
	GP = SUM(S.Sales) - SUM(S.Cost),
	GPRate = ((SUM(S.Sales) - SUM(S.Cost)) / CASE WHEN SUM(S.Sales) <> 0 THEN SUM(S.Sales) ELSE 1 END) * 100,
	ServiceSales=SUM(S.ServiceSales), 
	ServiceCost=SUM(S.ServiceCost),
	ServiceGP = SUM(S.ServiceSales) - SUM(S.ServiceCost),
	ServiceGPRate = ((SUM(S.ServiceCost) - SUM(S.ServiceCost)) / CASE WHEN SUM(S.ServiceSales) <> 0 THEN SUM(S.ServiceSales) ELSE 1 END) * 100
FROM
	(SELECT 
		Disease=D.Name, Sales=0.00, Cost=0.00, ServiceSales=0.00, ServiceCost = 0.00
	FROM Disease D
	UNION ALL
	SELECT 
		Disease=D.Name, Sales=SUM(S.InvTotal), Cost=ISNULL((SELECT SUM((D.LooseQty + D.BonusQty) * D.AvgPrice) FROM SaleDetail D WHERE S.SaleInvCode=D.SaleInvCode), 0), ServiceSales=0.00, ServiceCost = 0.00
	FROM 
		SaleLedger S, Patient P, Disease D
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.PatientCode = P.PatientCode AND
		P.DiseaseCode = D.DiseaseCode AND
		D.DiseaseCode IN (:ai_diseasecode)		
	GROUP BY 
		D.Name,
		S.SaleInvCode
	UNION ALL
	SELECT 
		Disease=D.Name, Sales=0.00, Cost=0.00, ServiceSales=SUM(S.InvTotal), ServiceCost=ISNULL((SELECT SUM(P.InvTotal) FROM ServicePurHeader P WHERE P.ServiceInvCode=S.ServiceInvCode), 0)
	FROM 
		ServiceHeader S, Patient P, Disease D
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.PatientCode = P.PatientCode AND
		P.DiseaseCode = D.DiseaseCode AND
		D.DiseaseCode IN (:ai_diseasecode)		
	GROUP BY 
		D.Name,
		S.ServiceInvCode) S
GROUP BY 
	Disease"
  arguments=(("ai_diseasecode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
