table(column=(type=char(20) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=char(20) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(20) updatewhereclause=yes name=area dbname="area"  )
column=(type=char(20) updatewhereclause=yes name=peiod dbname="peiod"  )
column=(type=decimal(0) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(0) updatewhereclause=yes name=salevalue dbname="salevalue"  )
 retrieve="SELECT 
	Area=A.Name,
	CustomerName = AC.Name,
	Address = C.Address1,
	Peiod = LTRIM(RTRIM(CONVERT(VARCHAR(100), :adt_startdate, 103))) + ' - ' + LTRIM(RTRIM(CONVERT(VARCHAR(100), :adt_enddate, 103))),
	ICode=I.ICode,
	ItemName=I.ShortName,
	Qty = SUM(T.Qty + CASE WHEN :ai_bonus = 1 THEN T.BonusQty ELSE 0 END),
	SaleValue = SUM(T.SaleValue)
FROM
	(SELECT II.ICode, II.Name, II.ShortName, II.ManfCode FROM Item II WHERE II.ManfCode = :ai_ManfCode) AS I, 
	Area A,
	Accounts AC,
	Customer C,
	(SELECT 
		C.CustCode,
		I.ICode,
		Qty = SUM(D.LooseQty),
		BonusQty = SUM(D.BonusQty),
		SaleValue = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.Discperc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM 
		SaleLedger S, SaleDetail D, 
		(SELECT II.ICode FROM Item II WHERE II.ManfCode = :ai_ManfCode) AS I, 
		(SELECT CC.CustCode, CC.AreaCode 
		FROM Area AA, Customer CC
		WHERE AA.AreaCode IN (:ai_areacode) AND AA.AreaCode = CC.AreaCode) C
	WHERE
		C.CustCode = S.CustCode AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.Posted = 'Y' AND S.SaleInvCode = D.SaleInvCode AND
		D.ICode = I.ICode
	GROUP BY
		C.AreaCode,
		C.CustCode,
		I.ICode
	UNION ALL
	SELECT 
		C.CustCode,
		I.ICode,
		Qty = SUM(D.LooseQty),
		BonusQty = SUM(D.BonusQty),
		SaleValue = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.Discperc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM 
		SaleLedger S, SaleInvDetail D, 
		(SELECT II.ICode FROM Item II WHERE II.ManfCode = :ai_ManfCode) AS I, 
		(SELECT CC.CustCode, CC.AreaCode 
		FROM Area AA, Customer CC
		WHERE AA.AreaCode IN (:ai_areacode) AND AA.AreaCode = CC.AreaCode) C
	WHERE
		C.CustCode = S.CustCode AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.Posted = 'Y' AND S.SaleInvCode = D.SaleInvCode AND
		D.ICode = I.ICode
	GROUP BY
		C.CustCode,
		I.ICode
	UNION ALL
	SELECT 
		C.CustCode,
		I.ICode,
		Qty = -SUM(D.LooseQty),
		BonusQty = - SUM(D.BonusQty),
		SaleValue = - SUM(D.LooseQty * D.SRPrice * (1 - D.Discperc * 0.01) * (1 - S.DiscPerc * 0.01))
	FROM 
		SRLedger S, SRDetail D, 
		(SELECT II.ICode FROM Item II WHERE II.ManfCode = :ai_ManfCode) AS I, 
		(SELECT CC.CustCode, CC.AreaCode 
		FROM Area AA, Customer CC
		WHERE AA.AreaCode IN (:ai_areacode) AND AA.AreaCode = CC.AreaCode) C
	WHERE
		C.CustCode = S.CustCode AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.Posted = 'Y' AND S.SRInvCode = D.SRInvCode AND
		D.ICode = I.ICode
	GROUP BY
		C.CustCode,
		I.ICode) T
WHERE 
	T.ICode = I.ICode AND
	T.CustCode = C.CustCode AND
	C.AreaCode = A.AreaCode AND
	C.CustCode = AC.AccCode
GROUP BY
	A.Name,
	AC.Name,
	C.Address1,
	I.ICode,
	I.ShortName
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_manfcode", number), ("ai_areacode", numberlist), ("ai_bonus", number))
 sort="customername A, address A, area A, peiod A"
)
