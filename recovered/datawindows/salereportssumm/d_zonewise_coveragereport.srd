datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1408 color="536870912" )
summary(height=216 color="536870912" )
footer(height=0 color="536870912" )
detail(height=183 color="536870912" )
table(column=(type=long updatewhereclause=yes name=zonecode dbname="ZoneCode"  )
column=(type=char(60) updatewhereclause=yes name=zone dbname="Zone"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=long updatewhereclause=yes name=customercount dbname="CustomerCount"  )
column=(type=long updatewhereclause=yes name=totalcustcount dbname="TotalCustCount"  )
 retrieve="SELECT 
	ZoneCode = (SELECT Z.ZoneCode FROM Zone Z WHERE Z.ZoneCode=:ai_zonecode),
	Zone = (SELECT Z.Name FROM Zone Z WHERE Z.ZoneCode=:ai_zonecode),
	Manufacturer=M.Name,
	ItemCategory = IC.Name,
	Area = A.Name,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	Packing = I.PackingDesc,
	SaleQty = SUM(T.SaleQty),
	SaleValue = SUM(T.SaleValue),
	CustomerCount = COUNT(DISTINCT T.CustCode),
	TotalCustCount = ISNULL((SELECT Count(C.CustCode) FROM Customer C WHERE C.AreaCode = T.AreaCode), 0)
FROM
	Manufacturer M,
	ItemCategory IC,
	Area A,
	Item I,
	Salesman S,
	(SELECT 
		I.ManfCode,
		I.ICatCode,
		I.ICode,
		ZA.AreaCode,
		SL.CustCode,
		SaleQty = SUM(SD.LooseQty + SD.BonusQty),
		SaleValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))
	FROM
		SaleLedger SL,
		SaleDetail SD,
		Item I,
		Zone Z,
		ZoneAreas ZA,
		Customer C
	WHERE
		Z.ZoneCode = :ai_zonecode AND
		Z.ZoneCode = ZA.ZoneCode AND
		ZA.AreaCode = C.AreaCode AND
		C.CustCode = SL.CustCode AND
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = Z.ManfCode AND
		I.ICatCode = Z.ICatCode
	GROUP BY 
		I.ManfCode,
		I.ICatCode,
		I.ICode,
		ZA.AreaCode,
		SL.CustCode
	UNION ALL
	SELECT 
		I.ManfCode,
		I.ICatCode,
		I.ICode,
		ZA.AreaCode,
		SL.CustCode,
		SaleQty = SUM(SD.LooseQty + SD.BonusQty),
		SaleValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))
	FROM
		SaleLedger SL,
		SaleInvDetail SD,
		Item I,
		Zone Z,
		ZoneAreas ZA,
		Customer C
	WHERE
		Z.ZoneCode = :ai_zonecode AND
		Z.ZoneCode = ZA.ZoneCode AND
		ZA.AreaCode = C.AreaCode AND
		C.CustCode = SL.CustCode AND
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = Z.ManfCode AND
		I.ICatCode = Z.ICatCode
	GROUP BY 
		I.ManfCode,
		I.ICatCode,
		I.ICode,
		ZA.AreaCode,
		SL.CustCode
	UNION ALL
	SELECT 
		I.ManfCode,
		I.ICatCode,
		I.ICode,
		ZA.AreaCode,
		SL.CustCode,
		SaleQty = - SUM(SD.LooseQty + SD.BonusQty),
		SaleValue = - SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))
	FROM
		SRLedger SL,
		SRDetail SD,
		Item I,
		Zone Z,
		ZoneAreas ZA,
		Customer C
	WHERE
		Z.ZoneCode = :ai_zonecode AND
		Z.ZoneCode = ZA.ZoneCode AND
		ZA.AreaCode = C.AreaCode AND
		C.CustCode = SL.CustCode AND
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode = Z.ManfCode AND
		I.ICatCode = Z.ICatCode
	GROUP BY 
		I.ManfCode,
		I.ICatCode,
		I.ICode,
		ZA.AreaCode,
		SL.CustCode) T
WHERE
	T.ManfCode = M.ManfCode AND
	T.ICatCode = IC.ICatCode AND
	T.AreaCode = A.AreaCode AND
	T.ICode = I.ICode
GROUP BY
	M.Name,
	IC.Name,
	T.AreaCode,
	A.Name,
	I.CustomICode,
	I.Name,
	I.PackingDesc"
  arguments=(("ai_zonecode", number), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="area A, itemname A"
)
