release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1600 color="536870912" )
summary(height=241 color="536870912" )
footer(height=0 color="536870912" )
detail(height=183 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=manufacturercategory dbname="ManufacturerCategory"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Manufacturer.Name"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="ManfCode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="Salesman"  )
column=(type=decimal(6) updatewhereclause=yes name=sale dbname="Sale"  )
column=(type=decimal(6) updatewhereclause=yes name=sreturn dbname="SReturn"  )
column=(type=decimal(6) updatewhereclause=yes name=netsale dbname="NetSale"  )
 retrieve="SELECT 
	ManufacturerCategory=MC.Name,
	M.Name, 
	ManfCode=S.ManfCode,
	Salesman=(SELECT SM.NAME FROM SALESMAN SM WHERE SM.SALESMANCODE=:ai_SManCode),
	Sale=SUM(S.SaleAmt),
	SReturn=SUM(S.ReturnAmt),
	NetSale=SUM(S.SaleAmt - S.ReturnAmt)
FROM
 	ManufacturerCategory MC,
	Manufacturer M,
	(SELECT
		I.ManfCode,
		SaleAmt=SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * 
			(1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
		ReturnAmt=0
	FROM
		SaleLedger SL, SaleDetail SD, Item I
	WHERE
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SManCode = :ai_SManCode AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (SELECT ManfCode FROM Manufacturer WHERE ManfCatCode IN (:ai_ManfCatCode))
	GROUP BY
		SL.SaleInvCode,
		SD.ICode,
		I.ManfCode
	UNION ALL
	SELECT
		I.ManfCode,
		SaleAmt=SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * 
			(1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
		ReturnAmt=0
	FROM
		SaleLedger SL, SaleInvDetail SD, Item I
	WHERE
		SL.ImpactInventory = 'N' AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SManCode = :ai_SManCode AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (SELECT ManfCode FROM Manufacturer WHERE ManfCatCode IN (:ai_ManfCatCode))
	GROUP BY
		SL.SaleInvCode,
		SD.ICode,
		I.ManfCode
	UNION ALL
	SELECT
		I.ManfCode,
		SaleAmt=0,
		ReturnAmt=SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))
	FROM
		SRLedger SL, SRDetail SD, Item I
	WHERE
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SManCode = :ai_SManCode AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (SELECT ManfCode FROM Manufacturer WHERE ManfCatCode IN (:ai_ManfCatCode))
	GROUP BY
		SL.SRInvCode,
		SD.ICode,
		I.ManfCode) S
WHERE
	S.ManfCode = M.ManfCode AND
	M.ManfCatCode = MC.ManfCatCode AND
	MC.ManfCatCode IN (:ai_ManfCatCode)
GROUP BY
	MC.Name,
	M.Name,
	S.ManfCode
ORDER BY
	MC.Name,
	M.Name"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ai_ManfCatCode", numberlist), ("ai_SManCode", number))
)
