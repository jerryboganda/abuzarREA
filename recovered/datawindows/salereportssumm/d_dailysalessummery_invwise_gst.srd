table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(4) updatewhereclause=yes name=salesvalue dbname="salesvalue"  )
column=(type=decimal(4) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
 retrieve="SELECT  
	invcode     = dbo.saleledger.saleinvcode, 
	date        = dbo.saleledger.date, 
	salesvalue = DBO.fn_GetSaleInvTotal( dbo.saleledger.saleinvcode) - ROUND( (ISNULL(DBO.fn_GetSaleInvTotal( dbo.saleledger.saleinvcode ), 0) * :ad_gstperc * 0.01), 2),
	salestax = ROUND( (ISNULL(DBO.fn_GetSaleInvTotal( dbo.saleledger.saleinvcode ), 0) * :ad_gstperc * 0.01), 2),
	NetAmount = ISNULL(DBO.fn_GetSaleInvTotal( dbo.saleledger.saleinvcode ), 0),
	customername = dbo.accounts.name, 
	salesman = dbo.users.username ,
	remarks=saleledger.remarks
FROM 
	dbo.saleledger, 
	dbo.saledetail,   
	dbo.accounts,
	dbo.users  
WHERE 
	( dbo.saleledger.saleinvcode between :ar_StartInv and :ar_EndInv) and
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and  
	( dbo.saleledger.custcode = dbo.accounts.acccode ) and  
	( dbo.saleledger.salesmancode = dbo.users.usercode )  
GROUP BY 
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.date,   
	dbo.saleledger.saleinvcode,   
	dbo.saleledger.discperc,  
	dbo.saleledger.salestax, 
	dbo.saleledger.salecatcode, 
	dbo.saleledger.invgstperc1,
	dbo.saleledger.accountfor,
	dbo.saleledger.impactinventory,
	dbo.accounts.name,
	dbo.users.username ,
	dbo.saleledger.remarks
ORDER BY 
	dbo.saleledger.saleinvcode
	
"
  arguments=(("ar_Startinv", number), ("ar_EndInv", number), ("ad_gstperc", number), ("adt_date", datetime))
)
