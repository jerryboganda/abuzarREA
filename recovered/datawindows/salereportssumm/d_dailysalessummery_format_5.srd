table(column=(type=char(12) updatewhereclause=yes name=transtype dbname="TransType"  )
column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=long updatewhereclause=yes name=altersaleinvcode dbname="altersaleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=saletype dbname="saletype"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(6) updatewhereclause=yes name=gross dbname="gross"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=decimal(6) updatewhereclause=yes name=totaldiscount dbname="totaldiscount"  )
column=(type=decimal(6) updatewhereclause=yes name=difference dbname="difference"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsalestax dbname="itemsalestax"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="accountfor"  )
column=(type=char(1) updatewhereclause=yes name=impactinventory dbname="impactinventory"  )
column=(type=decimal(2) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=cashamount dbname="CashAmount"  )
column=(type=decimal(2) updatewhereclause=yes name=creditamount dbname="CreditAmount"  )
column=(type=char(1) updatewhereclause=yes name=postmark dbname="PostMark"  )
 retrieve="SELECT 
	TransType = 'Sales',
	invcode     = dbo.saleledger.saleinvcode,    
	altersaleinvcode = dbo.saleledger.altersaleinvcode,
	date        = dbo.saleledger.date,    
	flatdisc    = dbo.saleledger.flatdisc,  
	salestax    = dbo.saleledger.salestax,       
	misccharges = dbo.saleledger.misccharges, 
	invdiscperc = dbo.saleledger.discperc, 
	invgstperc1 = dbo.saleledger.invgstperc1, 
	posted = dbo.saleledger.posted,
	saletype = (Select Name From SaleType Where saletypecode = Max(dbo.saleledger.saletypecode) ) ,
	doctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name, 
	amount =  Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice),   
	gross= Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice), 
	itemdiscpercvalue = Round(Sum (Round(( dbo.saledetail.looseqty  * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01)) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc),2)), 2),    
	invdiscpercvalue = Sum (Round( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01)),2)) * (dbo.saleledger.discperc /100),
	salesman = dbo.users.username ,
	totaldiscount= Round(Sum (Round(( dbo.saledetail.looseqty  * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01)) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc),2)), 2) + Round(Sum ( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01))) * (dbo.saleledger.discperc /100), 2) + dbo.saleledger.flatdisc,
	difference= Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice) - sum(Round(saledetail.rate,2) * saledetail.looseqty) ,
	itemsalestax = Sum (Round (dbo.saledetail.looseqty * dbo.saledetail.unitsalestax + Round ( Round (dbo.saledetail.looseqty * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc ) * (1 - dbo.saledetail.discperc * 0.01 ), 2 ) * dbo.saledetail.gstperc * 0.01 , 2 ) , 2 ) ),
	accountfor=dbo.saleledger.accountfor,
	impactinventory=dbo.saleledger.impactinventory,
	NetAmt = dbo.fn_GetSaleInvTotal(dbo.saleledger.saleinvcode),
	CashAmount = Case dbo.saleledger.salecatcode When 1 Then dbo.saleledger.InvTotal When 2 Then 0 Else dbo.saleledger.InvTotal End, 
	CreditAmount= Case dbo.saleledger.salecatcode When 1 Then 0 When 2 Then dbo.saleledger.InvTotal Else 0 End,
	PostMark=CASE dbo.saleledger.posted WHEN 'Y' THEN '' ELSE '*' END
FROM 
	dbo.saleledger, 
	dbo.saledetail,   
	dbo.accounts,
	dbo.users  

WHERE 
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and 
	( dbo.saleledger.salecatcode IN (:aa_saletype) ) and  
	( dbo.saleledger.custcode = dbo.accounts.acccode )and  
	( dbo.saleledger.salesmancode = dbo.users.usercode )and  
	( dbo.saleledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY 
	dbo.saleledger.saleinvcode,   
	dbo.saleledger.altersaleinvcode,
	dbo.saleledger.date,   
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.discperc,  
	dbo.saleledger.salestax, 
	dbo.saleledger.invgstperc1 ,
	dbo.saleledger.salecatcode, 
	dbo.saleledger.posted, 
	dbo.saleledger.accountfor,
	dbo.saleledger.impactinventory,
	dbo.accounts.name,
	dbo.users.username,
	dbo.saleledger.InvTotal, 
	DBO.SaleLedger.CashReceived
UNION ALL
SELECT 
	TransType = 'Sales',
	invcode     = dbo.saleledger.saleinvcode,    
	altersaleinvcode = dbo.saleledger.altersaleinvcode,
	date        = dbo.saleledger.date,    
	flatdisc    = dbo.saleledger.flatdisc, 
	salestax    = dbo.saleledger.salestax,       
	misccharges = dbo.saleledger.misccharges, 
	invdiscperc = dbo.saleledger.discperc, 
	invgstperc1 = dbo.saleledger.invgstperc1, 
	posted = dbo.saleledger.posted,
	saletype = (Select Name From SaleType Where saletypecode = Max(dbo.saleledger.saletypecode) ) ,
	doctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name, 
	amount =  Sum ( sd.looseqty * sd.saleprice),   
	gross= Sum ( sd.looseqty * sd.saleprice), 
	itemdiscpercvalue = Round(Sum (Round(( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc),2)), 2),    
	invdiscpercvalue = Sum (Round( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01)),2)) * (dbo.saleledger.discperc /100),
	salesman = dbo.users.username ,
	totaldiscount= Round(Sum (Round(( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc),2)), 2) + Round(Sum ( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01))) * (dbo.saleledger.discperc /100), 2) + dbo.saleledger.flatdisc,
	difference= Sum ( sd.looseqty * sd.saleprice) - sum(Round(sd.rate,2) * sd.looseqty) ,
	itemsalestax = Sum (Round (sd.looseqty * sd.unitsalestax + Round ( Round (sd.looseqty * (sd.saleprice - sd.itemflatdisc ) * (1 - sd.discperc * 0.01 ), 2 ) * sd.gstperc * 0.01 , 2 ) , 2 ) ),
	accountfor=dbo.saleledger.accountfor,
	impactinventory=dbo.saleledger.impactinventory,
	NetAmt = dbo.fn_GetSaleInvTotal(dbo.saleledger.saleinvcode),
	CashAmount = Case dbo.saleledger.salecatcode When 1 Then dbo.saleledger.InvTotal When 2 Then 0 Else dbo.saleledger.InvTotal End, 
	CreditAmount= Case dbo.saleledger.salecatcode When 1 Then 0 When 2 Then dbo.saleledger.InvTotal Else 0 End,
	PostMark=CASE dbo.saleledger.posted WHEN 'Y' THEN '' ELSE '*' END
FROM 
	dbo.saleledger, 
	dbo.saleinvdetail sd,   
	dbo.accounts,
	dbo.users  
WHERE 
	( DBO.SaleLedger.impactinventory = 'N' ) AND 
	( dbo.saleledger.saleinvcode = sd.saleinvcode ) and 
	( dbo.saleledger.salecatcode IN (:aa_saletype) ) and  
	( dbo.saleledger.custcode = dbo.accounts.acccode )and  
	( dbo.saleledger.salesmancode = dbo.users.usercode )and  
	( dbo.saleledger.date between :ar_StartDate and :ar_EndDate)            
GROUP BY 
	dbo.saleledger.saleinvcode,   
	dbo.saleledger.altersaleinvcode,
	dbo.saleledger.date,   
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.discperc,  
	dbo.saleledger.salestax, 
	dbo.saleledger.invgstperc1 ,
	dbo.saleledger.salecatcode, 
	dbo.saleledger.posted, 
	dbo.saleledger.accountfor,
	dbo.saleledger.impactinventory,
	dbo.accounts.name,
	dbo.users.username,
	dbo.saleledger.InvTotal, 
	DBO.SaleLedger.CashReceived
UNION ALL
SELECT 
	TransType = 'Sales Return',
	invcode     = dbo.SRledger.SRinvcode,    
	altersaleinvcode = NULL,
	date        = dbo.SRledger.date,    
	flatdisc    = dbo.SRledger.flatdisc, 
	salestax    = dbo.SRledger.salestax,       
	misccharges = dbo.SRledger.misccharges, 
	invdiscperc = dbo.SRledger.discperc, 
	invgstperc1 = dbo.SRledger.invgstperc1, 
	posted = dbo.SRledger.posted,
	saletype = 'Sales Return',
	doctype = Case When dbo.SRledger.srcatcode = 8 Then 'Cash' Else 'Credit' End, 
	dbo.accounts.name, 
	amount =  Sum ( dbo.SRDetail.looseqty * dbo.SRDetail.srprice),   
	gross= Sum ( dbo.SRDetail.looseqty * dbo.SRDetail.srprice), 
	itemdiscpercvalue = Round(Sum (Round(dbo.SRDetail.looseqty * dbo.SRDetail.srprice * dbo.SRDetail.discperc * .01,2)), 2),    
	invdiscpercvalue = Sum (Round( dbo.SRDetail.looseqty * dbo.SRDetail.srprice * (1 - (dbo.SRDetail.discperc * .01)),2)) * (dbo.SRledger.discperc /100),
	salesman = dbo.users.username ,
	totaldiscount= Round(Sum (Round(( dbo.SRDetail.looseqty  * dbo.SRDetail.srprice * (dbo.SRDetail.discperc * .01)),2)), 2) + Round(Sum ( dbo.SRDetail.looseqty * dbo.SRDetail.srprice * (1 - (dbo.SRDetail.discperc * .01))) * (dbo.SRledger.discperc /100), 2) + dbo.SRledger.flatdisc,
	difference= 0,
	itemsalestax = Sum (Round (dbo.SRDetail.looseqty * dbo.SRDetail.unitsalestax + Round ( Round (dbo.SRDetail.looseqty * dbo.SRDetail.srprice * (1 - dbo.SRDetail.discperc * 0.01 ), 2 ) * dbo.SRDetail.gstperc * 0.01 , 2 ) , 2 ) ),
	accountfor=dbo.SRledger.accountfor,
	impactinventory='Y',
	NetAmt = dbo.fn_GetSRInvTotal(dbo.SRledger.srinvcode),
	CashAmount = Case When dbo.SRledger.srcatcode = 8 Then dbo.srledger.InvTotal Else 0 End , 
	CreditAmount= Case When dbo.SRledger.srcatcode = 8 Then 0 Else dbo.srledger.InvTotal End,
	PostMark=CASE dbo.sRledger.posted WHEN 'Y' THEN '' ELSE '*' END
FROM 
	dbo.SRledger, 
	dbo.SRDetail,   
	dbo.accounts,
	dbo.users  

WHERE 
	( dbo.SRledger.srinvcode = dbo.SRDetail.srinvcode ) and 
	( dbo.SRledger.srcatcode IN (:aa_saletype) ) and  
	( dbo.SRledger.custcode = dbo.accounts.acccode )and  
	( dbo.SRledger.salesmancode = dbo.users.usercode )and  
	( dbo.SRledger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY 
	dbo.SRledger.srinvcode,   
	dbo.SRledger.date,   
	dbo.SRledger.misccharges,   
	dbo.SRledger.flatdisc,   
	dbo.SRledger.discperc,  
	dbo.SRledger.salestax, 
	dbo.SRledger.invgstperc1 ,
	dbo.SRledger.srcatcode, 
	dbo.SRledger.posted, 
	dbo.SRledger.accountfor,
	dbo.accounts.name,
	dbo.users.username,
	dbo.SRledger.InvTotal
UNION ALL
SELECT 
	TransType = 'Sales Return',
	invcode     = dbo.SRBufferLedger.SRBufferinvcode,    
	altersaleinvcode = NULL,
	date        = dbo.SRBufferLedger.date,    
	flatdisc    = dbo.SRBufferLedger.flatdisc, 
	salestax    = dbo.SRBufferLedger.salestax,       
	misccharges = dbo.SRBufferLedger.misccharges, 
	invdiscperc = dbo.SRBufferLedger.discperc, 
	invgstperc1 = dbo.SRBufferLedger.invgstperc1, 
	posted = dbo.SRBufferLedger.posted,
	saletype = 'Sales Return',
	doctype = Case When dbo.SRBufferLedger.srcatcode = 8 Then 'Cash' Else 'Credit' End, 
	dbo.accounts.name, 
	amount =  Sum ( dbo.SRBufferDetail.looseqty * dbo.SRBufferDetail.srprice),   
	gross= Sum ( dbo.SRBufferDetail.looseqty * dbo.SRBufferDetail.srprice), 
	itemdiscpercvalue = Round(Sum (Round(dbo.SRBufferDetail.looseqty * dbo.SRBufferDetail.srprice * dbo.SRBufferDetail.discperc * .01,2)), 2),    
	invdiscpercvalue = Sum (Round( dbo.SRBufferDetail.looseqty * dbo.SRBufferDetail.srprice * (1 - (dbo.SRBufferDetail.discperc * .01)),2)) * (dbo.SRBufferLedger.discperc /100),
	salesman = dbo.users.username ,
	totaldiscount= Round(Sum (Round(( dbo.SRBufferDetail.looseqty  * dbo.SRBufferDetail.srprice * (dbo.SRBufferDetail.discperc * .01)),2)), 2) + Round(Sum ( dbo.SRBufferDetail.looseqty * dbo.SRBufferDetail.srprice * (1 - (dbo.SRBufferDetail.discperc * .01))) * (dbo.SRBufferLedger.discperc /100), 2) + dbo.SRBufferLedger.flatdisc,
	difference= 0,
	itemsalestax = Sum (Round (dbo.SRBufferDetail.looseqty * dbo.SRBufferDetail.unitsalestax + Round ( Round (dbo.SRBufferDetail.looseqty * dbo.SRBufferDetail.srprice * (1 - dbo.SRBufferDetail.discperc * 0.01 ), 2 ) * dbo.SRBufferDetail.gstperc * 0.01 , 2 ) , 2 ) ),
	accountfor=dbo.SRBufferLedger.accountfor,
	impactinventory='Y',
	NetAmt = dbo.SRBufferLedger.InvTotal,
	CashAmount = Case When dbo.SRBufferLedger.srcatcode = 8 Then dbo.SRBufferLedger.InvTotal Else 0 End , 
	CreditAmount= Case When dbo.SRBufferLedger.srcatcode = 8 Then 0 Else dbo.SRBufferLedger.InvTotal End,
	PostMark=CASE dbo.srbufferledger.posted WHEN 'Y' THEN '' ELSE '*' END
FROM 
	dbo.SRBufferLedger, 
	dbo.SRBufferDetail,   
	dbo.accounts,
	dbo.users  

WHERE 
	( dbo.SRBufferLedger.Posted = 'N' ) AND 
	( dbo.SRBufferLedger.SRBufferinvcode = dbo.SRBufferDetail.SRBufferinvcode ) and 
	( dbo.SRBufferLedger.srcatcode IN (:aa_saletype) ) and  
	( dbo.SRBufferLedger.custcode = dbo.accounts.acccode )and  
	( dbo.SRBufferLedger.salesmancode = dbo.users.usercode )and  
	( dbo.SRBufferLedger.date between :ar_StartDate and :ar_EndDate)            

GROUP BY 
	dbo.SRBufferLedger.SRBufferinvcode,   
	dbo.SRBufferLedger.date,   
	dbo.SRBufferLedger.misccharges,   
	dbo.SRBufferLedger.flatdisc,   
	dbo.SRBufferLedger.discperc,  
	dbo.SRBufferLedger.salestax, 
	dbo.SRBufferLedger.invgstperc1 ,
	dbo.SRBufferLedger.srcatcode, 
	dbo.SRBufferLedger.posted, 
	dbo.SRBufferLedger.accountfor,
	dbo.accounts.name,
	dbo.users.username,
	dbo.SRBufferLedger.InvTotal
ORDER BY 
	TransType,
	INVCode,   
	date
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("aa_saletype", numberlist))
)
