table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=purledger_date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsalestax dbname="itemsalestax"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="accountfor"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="invtotal"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(8) updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
 retrieve="SELECT  
	invcode     = h.srinvcode,    
	date        = h.date,    
	flatdisc    = h.flatdisc, 
	salestax    = h.salestax,       
	misccharges = h.misccharges, 
	invdiscperc = h.discperc, 
	invgstperc1 = h.invgstperc1,
	doctype = Case h.srcatcode When 6 Then 'Cash' When 7 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name, 
	amount =  Round(Sum ( d.looseqty * d.srprice), 2),    
	itemdiscpercvalue = Round(Sum (Round( d.looseqty  * d.srprice * (d.discperc * .01),2)), 2),    
	invdiscpercvalue = Round(Sum (Round( (d.looseqty  ) * d.srprice * (1 - (d.discperc * .01)),2)) * (h.discperc /100), 2) ,
	/*invamount= Round( (Sum(Round((d.srprice * (d.looseqty  - (d.discperc * 0.01))),2))) * ( 1 - (h.discperc * 0.01)) - h.flatdisc + h.misccharges,0),*/
	username=users.username,
	itemsalestax = Sum (Round ( (d.looseqty + d.bonusqty) * d.unitsalestax + Round ( Round ( d.looseqty * d.srprice * (1 - d.discperc * 0.01 ), 2 ) * d.gstperc * 0.01 , 2 ) , 2 ) ),
	accountfor = h.accountfor,
	invtotal=h.invtotal,
	aliasname=dbo.accounts.aliasname,
	SaleInvCode=CASE 
		WHEN h.SaleInvCode IS NULL THEN 
			(SELECT CASE WHEN MAX(D.SaleInvCode) IS NULL THEN '' ELSE '*' END + LTRIM(RTRIM(STR(MAX(D.SaleInvCode), 7)))
			FROM SRAllocationDetail D, SRAllocationHeader H
			WHERE H.SRInvCode = h.SRInvCode AND H.SRAllocationCode = D.SRAllocationCode)
		ELSE 
			LTRIM(RTRIM(STR(h.SaleInvCode, 7))) 
		END,
	Remarks=h.Remarks,
	Posted=h.Posted
FROM 
	dbo.srledger h, 
	dbo.srdetail d,   
	dbo.accounts,
	dbo.users  
WHERE 
	( h.srinvcode = d.srinvcode ) and  
	( h.custcode = dbo.accounts.acccode )and  
	( h.salesmancode=users.usercode)and
	(h.srcatcode IN (:ai_salerettype) )and
	( h.date between :ar_StartDate and :ar_EndDate)            
GROUP BY 
	h.misccharges,   
	h.flatdisc,   
	h.date,   
	h.srinvcode,   
	h.invtotal,
	h.SaleInvCode,
	h.discperc,  
	h.salestax, 
	h.srcatcode, 
	h.invgstperc1, 
	h.accountfor, 
	dbo.accounts.aliasname,
	dbo.accounts.name  ,
	dbo.users.username   ,
	h.Remarks,
	h.Posted
UNION
SELECT 
	invcode     = h.srbufferinvcode,    
	date        = h.date,    
	flatdisc    = h.flatdisc, 
	salestax    = h.salestax,       
	misccharges = h.misccharges, 
	invdiscperc = h.discperc, 
	invgstperc1 = h.invgstperc1,
	doctype = Case h.srcatcode When 6 Then 'Cash' When 7 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name, 
	amount =  Round(Sum ( d.looseqty * d.srprice), 2),    
	itemdiscpercvalue = Round(Sum (Round( d.looseqty  * d.srprice * (d.discperc * .01),2)), 2),    
	invdiscpercvalue = Round(Sum (Round( (d.looseqty  ) * d.srprice * (1 - (d.discperc * .01)),2)) * (h.discperc /100), 2) ,
	/*invamount= Round( (Sum(Round((d.srprice * (d.looseqty  - (d.discperc * 0.01))),2))) * ( 1 - (h.discperc * 0.01)) - h.flatdisc + h.misccharges,0),*/
	username=users.username,
	itemsalestax = Sum (Round ( (d.looseqty + d.bonusqty) * d.unitsalestax + Round ( Round ( d.looseqty * d.srprice * (1 - d.discperc * 0.01 ), 2 ) * d.gstperc * 0.01 , 2 ) , 2 ) ),
	accountfor = h.accountfor,
	invtotal=h.invtotal,
	aliasname=dbo.accounts.aliasname,
	SaleInvCode=CASE 
		WHEN h.SaleInvCode IS NULL THEN 
			(SELECT CASE WHEN MAX(DD.SaleInvCode) IS NULL THEN '' ELSE '*' END + LTRIM(RTRIM(STR(MAX(DD.SaleInvCode), 7)))
			FROM SRAllocationDetail DD, SRAllocationHeader HH
			WHERE HH.SRInvCode = h.SRBufferInvCode AND HH.SRAllocationCode = DD.SRAllocationCode)
		ELSE 
			LTRIM(RTRIM(STR(h.SaleInvCode, 7))) 
		END,
	Remarks=h.Remarks,
	Posted=h.Posted
FROM 
	dbo.srbufferledger h, 
	dbo.srbufferdetail d,   
	dbo.accounts,
	dbo.users  
WHERE 
	( h.posted = 'N' ) AND
	( h.srbufferinvcode = d.srbufferinvcode ) and  
	( h.custcode = dbo.accounts.acccode )and  
	( h.salesmancode=users.usercode)and
	(h.srcatcode IN (:ai_salerettype) )and
	( h.date between :ar_StartDate and :ar_EndDate)            
GROUP BY 
	h.misccharges,   
	h.flatdisc,   
	h.date,   
	h.srbufferinvcode,   
	h.invtotal,
	h.SaleInvCode,
	h.discperc,  
	h.salestax, 
	h.srcatcode, 
	h.invgstperc1, 
	h.accountfor, 
	dbo.accounts.aliasname,
	dbo.accounts.name  ,
	dbo.users.username   ,
	h.Remarks,
	h.Posted
ORDER BY 
	invcode ASC, 
	date ASC   
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ai_salerettype", numberlist))
)
