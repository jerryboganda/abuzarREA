table(column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(100) updatewhereclause=yes name=refno dbname="RefNo"  )
column=(type=decimal(6) updatewhereclause=yes name=retailgross dbname="RetailGross"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="MiscCharges"  )
column=(type=decimal(6) updatewhereclause=yes name=saleamount dbname="SaleAmount"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="AccountFor"  )
column=(type=char(1) updatewhereclause=yes name=impactinventory dbname="ImpactInventory"  )
column=(type=decimal(2) updatewhereclause=yes name=salesreturn dbname="SalesReturn"  )
 retrieve="SELECT 
	InvoiceCode=S.saleinvcode,
	Date    = S.date,
	CustomerCategory=CC.Name,
	AliasName=A.AliasName,
	Customer=A.Name,
	Address=C.Address1,
	City=C.City,
	RefNo = S.CustRefNo,
	RetailGross= SUM(D.Looseqty * D.SalePrice),
	Discount = SUM(D.looseqty* D.itemflatdisc) + 
		Round(SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * (D.discperc * 0.01)), 2),
	MiscCharges = S.misccharges,
	SaleAmount=
		Round(SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
			SUM(ROUND( (D.looseqty * 
				(D.saleprice - D.itemflatdisc)) *
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND( (SUM((D.looseqty * 
				(D.saleprice - D.itemflatdisc)) *
				(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) -
				S.flatdisc) * (S.invgstperc1 * .01), 2), 0) +
		Round(SUM((D.looseqty*(D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) + 
			S.misccharges + S.salestax - S.flatdisc, 0),
	Posted=S.Posted,
	AccountFor=S.AccountFor,
	ImpactInventory=S.ImpactInventory,
	SalesReturn = (SELECT SUM(SR.InvTotal) FROM SRLedger SR WHERE SR.SaleInvCode=S.SaleInvCode)
FROM
	SaleLedger S,
	SaleDetail D,
	Customer C,
	Accounts A,
	CustomerCategory CC
WHERE
	S.DATE >= :adt_startdate AND S.DATE <= :adt_enddate AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode IN (:ai_custcatcode) AND
	C.CustCatCode = CC.CustCatCode AND
	S.saleinvcode = D.saleinvcode
GROUP BY 
	S.saleinvcode,
	S.date,
	S.discperc,
	S.misccharges, 
	S.salestax,
	S.flatdisc,
	S.invgstperc1,
	S.salesmancode,
	S.Posted,
	S.AccountFor,
	S.ImpactInventory,
	S.CustRefNo,
	CC.Name,
	A.AliasName,
	A.Name,
	C.Address1,
	C.City
UNION ALL
SELECT
	InvoiceCode=S.saleinvcode,
	Date    = S.date,
	CustomerCategory=CC.Name,
	AliasName=A.AliasName,
	Customer=A.Name,
	Address=C.Address1,
	City=C.City,
	RefNo = S.CustRefNo,
	RetailGross= SUM(D.Looseqty * D.SalePrice),
	Discount = SUM(D.looseqty* D.itemflatdisc) + 
		Round(SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * (D.discperc * 0.01)), 2),
	MiscCharges = S.misccharges,
	SaleAmount=
		Round(SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
			SUM(ROUND( (D.looseqty * 
				(D.saleprice - D.itemflatdisc)) *
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND( (SUM((D.looseqty * 
				(D.saleprice - D.itemflatdisc)) *
				(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) -
				S.flatdisc) * (S.invgstperc1 * .01), 2), 0) +
		Round(SUM((D.looseqty*(D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc))) * (1- (.01 * S.discperc)) + 
			S.misccharges + S.salestax - S.flatdisc, 0),
	Posted=S.Posted,
	AccountFor=S.AccountFor,
	ImpactInventory=S.ImpactInventory,
	SalesReturn = (SELECT SUM(SR.InvTotal) FROM SRLedger SR WHERE SR.SaleInvCode=S.SaleInvCode)
FROM
	SaleLedger S,
	SaleInvDetail D,
	Customer C,
	Accounts A,
	CustomerCategory CC
WHERE
	S.impactinventory = 'N' AND
	S.DATE >= :adt_startdate AND S.DATE <= :adt_enddate AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND 
	C.CustCatCode IN (:ai_custcatcode) AND
	C.CustCatCode = CC.CustCatCode AND
	S.saleinvcode = D.saleinvcode
GROUP BY 
	S.saleinvcode,
	S.date,
	S.discperc,
	S.misccharges, 
	S.salestax,
	S.flatdisc,
	S.invgstperc1,
	S.salesmancode,
	S.Posted,
	S.AccountFor,
	S.ImpactInventory,
	S.CustRefNo,
	CC.Name,
	A.AliasName,
	A.Name,
	C.Address1,
	C.City
ORDER BY
	CC.Name,
	S.saleinvcode,
	S.date,
	A.Name,
	A.AliasName,
	C.Address1,
	C.City
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_custcatcode", numberlist))
 sort="customercategory A, invoicecode A, date A, customer A"
)
