release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1229 color="536870912" )
summary(height=270 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=long updatewhereclause=yes name=salecount dbname="SaleCount"  )
column=(type=decimal(2) updatewhereclause=yes name=sales dbname="Sales"  )
column=(type=decimal(2) updatewhereclause=yes name=rerturns dbname="Rerturns"  )
column=(type=long updatewhereclause=yes name=returncount dbname="ReturnCount"  )
column=(type=decimal(2) updatewhereclause=yes name=netsale dbname="NetSale"  )
 retrieve="SELECT
	AliasName,
	CustomerName,
	SaleCount = SUM(SaleCount),
	Sales = SUM(Sales),
	Rerturns = SUM(Rerturns),
	ReturnCount = SUM(ReturnCount),
	NetSale=SUM(Sales) - SUM(Rerturns)
FROM 
	(SELECT 
		Type = 'S',
		AliasName=A.AliasName,
		CustomerName = A.Name,
		SaleCount = COUNT(S.SaleInvCode),
		Sales = SUM(S.InvTotal),
		Rerturns = 0.00,
		ReturnCount = 0
	FROM
		SaleLedger S, Accounts A
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.CustCode = A.AccCode
	GROUP BY
		A.Name, A.AliasName
	UNION ALL
	SELECT 
		Type = 'R',
		AliasName=A.AliasName,
		CustomerName = A.Name,
		SaleCount = 0,
		Sales = 0.00,
		Rerturns = SUM(S.InvTotal),
		ReturnCount = COUNT(S.SRInvCode)
	FROM
		SRLedger S, Accounts A
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.CustCode = A.AccCode
	GROUP BY
		A.Name, A.AliasName) SL
GROUP BY
	AliasName,
	CustomerName
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="salecount D"
)
