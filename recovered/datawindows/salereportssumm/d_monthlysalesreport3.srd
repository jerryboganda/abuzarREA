release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=1 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1041 color="536870912" )
header[2](height=354 color="536870912" )
header[3](height=0 color="536870912" )
summary(height=187 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=name1 dbname="name1"  )
column=(type=char(20) updatewhereclause=yes name=name3 dbname="name3"  )
column=(type=char(20) updatewhereclause=yes name=name2 dbname="name2"  )
column=(type=char(20) updatewhereclause=yes name=name4 dbname="name4"  )
column=(type=char(20) updatewhereclause=yes name=name5 dbname="name5"  )
column=(type=number updatewhereclause=yes name=value1 dbname="value1"  )
column=(type=number updatewhereclause=yes name=value2 dbname="value2"  )
column=(type=number updatewhereclause=yes name=value3 dbname="value3"  )
 retrieve="SELECT ReportData.code1,   
         ReportData.code2,   
         ReportData.value1,   
         ReportData.value2,   
         ReportData.value3,   
         ReportData.date1,   
         ReportData.name1,   
         ReportData.name2,   
         ReportData.name3,   
         ReportData.name4,
			ReportData.name5
FROM ReportData   
WHERE code1 in (:ar_icatcode)
ORDER BY name1, name2, name3
"
  arguments=(("ar_icatcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_customer", string))
 sort="name1 A, name3 A, name2 A, name4 A, name5 A, value1 A"
)
group(level=1 header.height=197 trailer.height=187 by=("name1"  ) header.color="536870912" trailer.color="536870912" )
group(level=2 header.height=0 trailer.height=0 by=("name3"  ) header.color="536870912" trailer.color="536870912" )
group(level=3 header.height=0 trailer.height=0 by=("name2"  ) header.color="536870912" trailer.color="536870912" )
group(level=4 header.height=0 trailer.height=0 by=("name4"  ) header.color="536870912" trailer.color="536870912" )
group(level=5 header.height=0 trailer.height=0 by=("name5"  ) header.color="536870912" trailer.color="536870912" )
