table(column=(type=char(10) updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=long updatewhereclause=yes name=saletype dbname="SaleType"  )
column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvNo"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(8) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsalestax dbname="itemsalestax"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=decimal(2) updatewhereclause=yes name=cashamt dbname="CashAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=creditcardamt dbname="CreditCardAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=otheramt dbname="OtherAmt"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
 retrieve="SELECT 
	documentcode = 'SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), SL.SaleInvCode))),
	SaleType = 1,
	invcode = SL.saleinvcode,    
	headerno=SL.headerno,
	headerinvNo = SL.headerinvNo,    
	date = SL.date,    
	flatdisc = SL.flatdisc,  
	salestax = SL.salestax,       
	misccharges = SL.misccharges, 
	invdiscperc = SL.discperc,
	invgstperc1 = SL.invgstperc1 ,
	doctype = Case SL.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
	customername = A.name, 
	amount =  Round(Sum ( SD.looseqty * SD.saleprice), 2),    
	itemdiscpercvalue = Round(Sum (( SD.looseqty  * (SD.saleprice - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2),    
	invdiscpercvalue = Sum (Round( SD.looseqty   * (SD.saleprice  - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2)) * (SL.discperc /100),
	itemsalestax = Sum (Round (SD.looseqty * SD.unitsalestax + Round ( Round (SD.looseqty * (SD.saleprice - SD.itemflatdisc ) * (1 - SD.discperc * 0.01 ), 2 ) * SD.gstperc * 0.01 , 2 ) , 2 ) ),
	salesman = U.username,
	Discount = Round(Sum (( SD.looseqty  * (SD.saleprice - SD.itemflatdisc) * (SD.discperc * .01)) + (SD.looseqty  * SD.itemflatdisc)), 2)+
	Sum (Round( SD.looseqty   * (SD.saleprice  - SD.itemflatdisc) * (1 - (SD.discperc * .01)),2)) * (SL.discperc /100) + 
	SL.flatdisc,
	A.AliasName,
	CashAmt = ISNULL(Case When SL.salecatcode <> 3 Then SL.Amt ELSE 0 End, 0) + 
		ISNULL((SELECT SUM(SRA.DEBIT - SRA.Credit) 
		FROM SaleReceivableAdj SRA 
		WHERE SRA.SaleInvCode = SL.SaleInvCode AND 
			SRA.AccCode IN 
			(SELECT AccCode FROM Accounts 
			WHERE SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub'))), 0) +
		ISNULL(SL.CashCharged, 0),
	CreditCardAmt = ISNULL((SELECT SUM(SRA.DEBIT - SRA.Credit) 
		FROM SaleReceivableAdj SRA 
		WHERE SRA.SaleInvCode = SL.SaleInvCode AND 
			SRA.DEBIT > 0 AND
			SRA.AccCode IN 
			(SELECT AccCode FROM Accounts 
			WHERE SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_BankSub'))), 0) +
		ISNULL((SELECT SUM(CW.Amount) 
				FROM CashierWindow CW
				WHERE CW.SaleInvCode = SL.SaleInvCode), 0),
	OtherAmt = ISNULL((SELECT SUM(SRA.DEBIT - SRA.Credit) 
		FROM SaleReceivableAdj SRA 
		WHERE SRA.SaleInvCode = SL.SaleInvCode AND 
			SRA.AccCode <> SL.CustCode AND
			SRA.AccCode NOT IN 
			(SELECT AccCode FROM Accounts 
			WHERE SubCode IN (SELECT Code FROM Global WHERE Name IN ('GT_CashSub', 'GT_BankSub')))), 0),
	Posted = SL.Posted
FROM 
	dbo.saleledger SL, 
	dbo.saledetail SD,   
	dbo.accounts A,
	dbo.users U  
WHERE 
	( SL.saleinvcode = SD.saleinvcode ) and  
	( SL.custcode = A.acccode )and  
	( SL.salesmancode = U.usercode )and  
	( SL.date between :ar_StartDate and :ar_EndDate) 
GROUP BY 
	SL.saleinvcode,   
	SL.headerno,
	SL.headerinvNo,
	SL.CustCode,
	SL.date,   
	SL.misccharges,   
	SL.flatdisc,   
	SL.discperc,  
	SL.salestax, 
	SL.invgstperc1,
	SL.salecatcode, 
	SL.Amt,
	SL.CashCharged,
	SL.InvTotal,
	A.name,
	A.AliasName,
	U.username,
	SL.Posted
UNION ALL
SELECT 
	documentcode = 'SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), SL.SaleInvCode))),
	SaleType = 1,
	invcode = SL.saleinvcode,    
	headerno=SL.headerno,
	headerinvNo = SL.headerinvNo,    
	date = SL.date,    
	flatdisc = SL.flatdisc, 
	salestax = SL.salestax,       
	misccharges = SL.misccharges, 
	invdiscperc = SL.discperc,
	invgstperc1 = SL.invgstperc1 ,
	doctype = Case SL.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
	customername = A.name, 
	amount =  Round(Sum ( sd.looseqty * sd.saleprice), 2),    
	itemdiscpercvalue = Round(Sum (( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc)), 2),    
	invdiscpercvalue = Sum (Round( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01)),2)) * (SL.discperc /100),
	itemsalestax = Sum (Round (sd.looseqty * sd.unitsalestax + Round ( Round (sd.looseqty * (sd.saleprice - sd.itemflatdisc ) * (1 - sd.discperc * 0.01 ), 2 ) * sd.gstperc * 0.01 , 2 ) , 2 ) ),
	salesman = U.username,
	Discount = Round(Sum (( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc)), 2)+
	Sum (Round( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01)),2)) * (SL.discperc /100) + 
	SL.flatdisc,
	A.AliasName,
	CashAmt = ISNULL(Case When SL.salecatcode <> 3 Then SL.Amt ELSE 0 End, 0) + 
		ISNULL((SELECT SUM(SRA.DEBIT - SRA.Credit) 
		FROM SaleReceivableAdj SRA 
		WHERE SRA.SaleInvCode = SL.SaleInvCode AND 
			SRA.AccCode IN 
			(SELECT AccCode FROM Accounts 
			WHERE SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_CashSub'))), 0) +
		ISNULL(SL.CashCharged, 0),
	CreditCardAmt = ISNULL((SELECT SUM(SRA.DEBIT - SRA.Credit) 
		FROM SaleReceivableAdj SRA 
		WHERE SRA.SaleInvCode = SL.SaleInvCode AND 
			SRA.DEBIT > 0 AND
			SRA.AccCode IN 
			(SELECT AccCode FROM Accounts 
			WHERE SubCode IN (SELECT Code FROM Global WHERE Name = 'GT_BankSub'))), 0) +
		ISNULL((SELECT SUM(CW.Amount) 
				FROM CashierWindow CW
				WHERE CW.SaleInvCode = SL.SaleInvCode), 0),
	OtherAmt = ISNULL((SELECT SUM(SRA.DEBIT - SRA.Credit) 
		FROM SaleReceivableAdj SRA 
		WHERE SRA.SaleInvCode = SL.SaleInvCode AND 
			SRA.AccCode <> SL.CustCode AND
			SRA.AccCode NOT IN 
			(SELECT AccCode FROM Accounts 
			WHERE SubCode IN (SELECT Code FROM Global WHERE Name IN ('GT_CashSub', 'GT_BankSub')))), 0),
	Posted = SL.Posted
FROM 
	dbo.saleledger SL, 
	dbo.saleinvdetail sd,  
	dbo.Accounts A,
	dbo.users U  
WHERE 
	( SL.impactinventory = 'N' ) AND 
	( SL.saleinvcode = sd.saleinvcode ) and  
	( SL.custcode = A.acccode )and  
	( SL.salesmancode = U.usercode )and  
	( SL.date between :ar_StartDate and :ar_EndDate)            
GROUP BY 
	SL.saleinvcode,   
	SL.headerno,
	SL.headerinvNo,
	SL.custcode,
	SL.date,   
	SL.misccharges,   
	SL.flatdisc,   
	SL.discperc,  
	SL.salestax, 
	SL.invgstperc1,
	SL.salecatcode, 
	SL.Amt,
	SL.CashCharged,
	SL.InvTotal,
	A.name,
	A.AliasName,
	U.username,
	SL.Posted
UNION ALL
SELECT 
	documentcode = 'SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), SRL.SRInvCode))),
	SaleType = 2,
	invcode     = SRL.srinvcode,    
	headerno=SRL.headerno,
	headerinvNo = SRL.headerinvNo,    
	date        = SRL.date,    
	flatdisc    = SRL.flatdisc, 
	salestax    = SRL.salestax,       
	misccharges = SRL.misccharges, 
	invdiscperc = SRL.discperc, 
	invgstperc1 = SRL.invgstperc1,
	doctype = Case SRL.srcatcode When 6 Then 'Cash-R' When 7 Then 'Credit-R' Else 'Cash-R' End, 
	customername = A.name, 
	amount =  Round(Sum ( SRD.looseqty * SRD.srprice), 2),    
	itemdiscpercvalue = Round(Sum ( SRD.looseqty  * SRD.srprice * (SRD.discperc * .01)), 2),    
	invdiscpercvalue = Round(Sum ( (SRD.looseqty  ) * SRD.srprice * (1 - (SRD.discperc * .01))) * (SRL.discperc /100), 2)     ,
	itemsalestax = Sum (Round (SRD.looseqty * SRD.unitsalestax + Round ( Round ( SRD.looseqty * SRD.srprice * (1 - SRD.discperc * 0.01 ), 2 ) * SRD.gstperc * 0.01 , 2 ) , 2 ) ),
	salesman = U.username,
	Discount = Round(Sum ( SRD.looseqty  * SRD.srprice * SRD.discperc * .01), 2) +
	Sum (Round( SRD.looseqty   * SRD.srprice * (1 - (SRD.discperc * .01)), 2)) * (SRL.discperc * 0.01) + 
	SRL.flatdisc,
	A.AliasName,
	CashAmt = 	ISNULL(SRL.CashCharged, 0) + ISNULL(SRL.Amt, 0),
	CreditCardAmt = ISNULL((SELECT ISNULL(SUM(Amount),0) FROM MasterCashWin MCW WHERE MCW.DocumentType = 'SR' AND MCW.DocumentCode = SRL.SRInvCode), 0),
	OthersAmt = 0,
	Posted = SRL.Posted
FROM 
	dbo.SRLedger SRL, 
	dbo.srdetail SRD,   
	dbo.Accounts A ,
	dbo.users U
WHERE 
	( SRL.srinvcode = SRD.srinvcode ) and  
	( SRL.custcode = A.acccode )and 
	( SRL.salesmancode = U.usercode )and  
	( SRL.date between :ar_StartDate and :ar_EndDate)
GROUP BY 
	SRL.srinvcode,   
	SRL.headerno,
	SRL.headerinvNo,
	SRL.CustCode,
	SRL.date,   
	SRL.misccharges,   
	SRL.flatdisc,   
	SRL.discperc,  
	SRL.salestax, 
	SRL.invgstperc1,
	SRL.srcatcode, 
	SRL.Amt,
	SRL.Posted,
	SRL.InvTotal,
	SRL.CashCharged,
	A.name,
	A.AliasName,
	U.username
UNION ALL
SELECT 
	documentcode = 'SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), SRL.SRBufferInvCode))),
	SaleType = 2,
	invcode     = SRL.srbufferinvcode,    
	headerno=SRL.headerno,
	headerinvNo = SRL.headerinvNo,    
	date        = SRL.date,    
	flatdisc    = SRL.flatdisc, 
	salestax    = SRL.salestax,       
	misccharges = SRL.misccharges, 
	invdiscperc = SRL.discperc, 
	invgstperc1 = SRL.invgstperc1,
	doctype = Case SRL.srcatcode When 6 Then 'Cash-R' When 7 Then 'Credit-R' Else 'Cash-R' End, 
	customername = A.name, 
	amount =  Round(Sum ( SRD.looseqty * SRD.srprice), 2),    
	itemdiscpercvalue = Round(Sum ( SRD.looseqty  * SRD.srprice * (SRD.discperc * .01)), 2),    
	invdiscpercvalue = Round(Sum ( (SRD.looseqty  ) * SRD.srprice * (1 - (SRD.discperc * .01))) * (SRL.discperc /100), 2)     ,
	itemsalestax = Sum (Round (SRD.looseqty * SRD.unitsalestax + Round ( Round ( SRD.looseqty * SRD.srprice * (1 - SRD.discperc * 0.01 ), 2 ) * SRD.gstperc * 0.01 , 2 ) , 2 ) ),
	salesman = U.username,
	Discount = Round(Sum ( SRD.looseqty  * SRD.srprice * SRD.discperc * .01), 2) +
	Sum (Round( SRD.looseqty   * SRD.srprice * (1 - (SRD.discperc * .01)), 2)) * (SRL.discperc * 0.01) + 
	SRL.flatdisc,
	A.AliasName,
	CashAmt = 	ISNULL(SRL.CashCharged, 0) + ISNULL(SRL.Amt, 0),
	CreditCardAmt = ISNULL((SELECT ISNULL(SUM(Amount),0) FROM MasterCashWin MCW WHERE MCW.DocumentType = 'SR' AND MCW.DocumentCode = SRL.SRBufferInvCode), 0),
	OthersAmt = 0,
	Posted = SRL.Posted
FROM 
	dbo.SRBufferLedger SRL, 
	dbo.SRBufferDetail SRD,   
	dbo.Accounts A ,
	dbo.users U
WHERE 
	( SRL.Posted = 'N' ) AND 
	( SRL.SRBufferInvCode = SRD.SRBufferInvCode ) and 
	( SRL.custcode = A.acccode )and 
	( SRL.salesmancode = U.usercode )and 
	( SRL.date between :ar_StartDate and :ar_EndDate)
GROUP BY 
	SRL.SRBufferInvCode,   
	SRL.headerno,
	SRL.headerinvNo,
	SRL.CustCode,
	SRL.date,   
	SRL.misccharges,   
	SRL.flatdisc,   
	SRL.discperc,  
	SRL.salestax, 
	SRL.invgstperc1,
	SRL.srcatcode, 
	SRL.Amt,
	SRL.Posted,
	SRL.InvTotal,
	SRL.CashCharged,
	A.name,
	A.AliasName,
	U.username
ORDER BY
	SaleType,
	date,
	InvCode
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime))
 sort="saletype A, invcode A, date A"
)
