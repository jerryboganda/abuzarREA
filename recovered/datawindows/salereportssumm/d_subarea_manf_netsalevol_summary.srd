release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1291 color="536870912" )
summary(height=187 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=subareacode dbname="SubAreaCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=subarea dbname="SubArea"  )
column=(type=long update=yes updatewhereclause=yes name=manfcode dbname="ManfCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(12) update=yes updatewhereclause=yes name=customeralias dbname="CustomerAlias"  )
column=(type=char(60) update=yes updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=decimal(6) update=yes updatewhereclause=yes name=netsale dbname="NetSale"  )
column=(type=decimal(7) update=yes updatewhereclause=yes name=netsalevolume dbname="NetSaleVolume"  )
 retrieve="SELECT
	SubAreaCode=C.SubAreaCode,
	SubArea=C.SubArea, 
	ManfCode=M.ManfCode, 
	Manufacturer=M.Name,
	CustomerAlias=C.CustomerAlias,
	Customer=C.Customer,
	NetSale=SUM(S.Sale),
	NetSaleVolume=SUM(S.SaleVolume)
FROM
	Manufacturer M, 
	(SELECT C.CustCode, C.SubAreaCode, CustomerAlias=A.AliasName, Customer=A.Name, SubArea=SA.Name
	FROM Customer C, Accounts A, SubArea SA
	WHERE 
		C.SubAreaCode IN (:ai_subareacode) AND 
		C.SubAreaCode = SA.SubAreaCode AND 
		C.CustCode = A.AccCode) C,
	(SELECT
		I.ManfCode,
		C.SubAreaCode,
		S.CustCode,
		Sale = SUM(SD.LooseQty * ((SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - S.DiscPerc * .01) )),
		SaleVolume = SUM(SD.LooseQty * I.PackingFactor)
	FROM
		(SELECT CustCode, SubAreaCode FROM Customer WHERE SubAreaCode IN (:ai_subareacode)) C,
		(SELECT I.ICode, I.ManfCode, I.PackingFactor FROM Item I WHERE I.ManfCode IN (:ai_manfcode)) I,
		SaleLedger S, 
		SaleDetail SD
	WHERE 
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		S.CustCode = C.CustCode AND
		S.SaleInvCode = SD.SaleInvCode AND 
		SD.ICode = I.ICode
	GROUP BY
		S.CustCode,
		S.SaleInvCode,
		I.ManfCode,
		C.SubAreaCode
	UNION ALL
	SELECT
		I.ManfCode,
		C.SubAreaCode,
		S.CustCode,
		Sale = SUM(SD.LooseQty * ((SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - S.DiscPerc * .01) )),
		SaleVolume = SUM(SD.LooseQty * I.PackingFactor)
	FROM
		(SELECT CustCode, SubAreaCode FROM Customer WHERE SubAreaCode IN (:ai_subareacode)) C,
		(SELECT I.ICode, I.ManfCode, I.PackingFactor FROM Item I WHERE I.ManfCode IN (:ai_manfcode)) I,
		SaleLedger S, 
		SaleInvDetail SD
	WHERE 
		S.ImpactInventory = 'N' AND
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		S.CustCode = C.CustCode AND
		S.SaleInvCode = SD.SaleInvCode AND 
		SD.ICode = I.ICode
	GROUP BY
		S.CustCode,
		S.SaleInvCode,
		I.ManfCode,
		C.SubAreaCode
	UNION ALL
	SELECT
		I.ManfCode,
		C.SubAreaCode,
		S.CustCode,
		Sale = -SUM(SD.LooseQty * (SD.SRPrice * (1 - SD.DiscPerc * .01) * (1 - S.DiscPerc * .01) )),
		SaleVolume = -SUM(SD.LooseQty * I.PackingFactor)
	FROM
		(SELECT CustCode, SubAreaCode FROM Customer WHERE SubAreaCode IN (:ai_subareacode)) C,
		(SELECT I.ICode, I.ManfCode, I.PackingFactor FROM Item I WHERE I.ManfCode IN (:ai_manfcode)) I,
		SRLedger S, 
		SRDetail SD
	WHERE 
		S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
		S.SRInvCode = SD.SRInvCode AND 
		S.CustCode = C.CustCode AND
		SD.ICode = I.ICode
	GROUP BY
		S.CustCode,
		S.SRInvCode,
		I.ManfCode,
		C.SubAreaCode
	UNION ALL
	SELECT
		I.ManfCode,
		C.SubAreaCode,
		C.CustCode,
		Sale = 0,
		SaleVolume = 0.00
	FROM
		(SELECT CustCode, SubAreaCode FROM Customer WHERE SubAreaCode IN (:ai_subareacode)) C,
		(SELECT DISTINCT I.ManfCode FROM Item I WHERE I.ManfCode IN (:ai_manfcode)) I) S
WHERE
	S.SubAreaCode = C.SubAreaCode AND
	S.CustCode = C.CustCode AND
	S.ManfCode = M.ManfCode
GROUP BY
	C.SubAreaCode,
	C.SubArea,
	M.ManfCode,
	M.Name,
	C.CustomerAlias,
	C.Customer
ORDER BY
	Manufacturer,
	SubArea,
	Customer
"
  arguments=(("ai_subareacode", numberlist), ("ai_manfcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
