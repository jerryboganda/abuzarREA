table(column=(type=char(60) updatewhereclause=yes name=saletype dbname="SaleType"  )
column=(type=decimal(2) updatewhereclause=yes name=sales dbname="Sales"  )
column=(type=decimal(9) updatewhereclause=yes name=cost dbname="Cost"  )
column=(type=decimal(2) updatewhereclause=yes name=gp dbname="GP"  )
column=(type=decimal(6) updatewhereclause=yes name=gprate dbname="GPRate"  )
 retrieve="SELECT 
	SaleType=S.SaleType, 
	Sales=SUM(S.Sales), 
	Cost=SUM(S.Cost),
	GP = SUM(S.Sales) - SUM(S.Cost),
	GPRate = ((SUM(S.Sales) - SUM(S.Cost)) / CASE WHEN SUM(S.Sales) <> 0 THEN SUM(S.Sales) ELSE 1 END) * 100
FROM
	(SELECT 
		SaleType=ST.Name, Sales=0.00, Cost=0.00
	FROM SaleType ST
	UNION ALL
	SELECT 
		SaleType=ST.Name, Sales=SUM(S.InvTotal), Cost=ISNULL((SELECT SUM((D.LooseQty + D.BonusQty) * D.AvgPrice) FROM SaleDetail D WHERE S.SaleInvCode=D.SaleInvCode), 0)
	FROM 
		SaleType ST, SaleLedger S
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SaleTypeCode = ST.SaleTypeCode AND
		ST.SaleTypeCode IN (:ai_saletypecode)
		
	GROUP BY 
		ST.Name,
		S.SaleInvCode) S
GROUP BY 
	SaleType"
  arguments=(("ai_saletypecode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
