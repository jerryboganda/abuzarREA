table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=totaldiscount dbname="totaldiscount"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="accountfor"  )
column=(type=char(1) updatewhereclause=yes name=impactinventory dbname="impactinventory"  )
 retrieve="SELECT 
	invcode     = dbo.saleledger.saleinvcode,    
	date        = dbo.saleledger.date,    
	flatdisc    = dbo.saleledger.flatdisc, 
	salestax    = dbo.saleledger.salestax,       
	misccharges = dbo.saleledger.misccharges,
	remarks     = dbo.saleledger.remarks,
	patient		= patient.name , 
	regno       = patient.regno ,  
	custrefno = dbo.saleledger.custrefno, 
	invdiscperc = dbo.saleledger.discperc, 
	doctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name, 
	amount =  Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice),    
	itemdiscpercvalue = Round(Sum (Round(( dbo.saledetail.looseqty  * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01)) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc),2)), 2),    
	invdiscpercvalue = Sum (Round( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01)),2)) * (dbo.saleledger.discperc /100) ,
	totaldiscount= Round(Sum (Round(( dbo.saledetail.looseqty  * (dbo.saledetail.saleprice - dbo.saledetail.itemflatdisc) * (dbo.saledetail.discperc * .01)) + (dbo.saledetail.looseqty  * dbo.saledetail.itemflatdisc),2)), 2) + Round(Sum ( dbo.saledetail.looseqty   * (dbo.saledetail.saleprice  - dbo.saledetail.itemflatdisc) * (1 - (dbo.saledetail.discperc * .01))) * (dbo.saleledger.discperc /100), 2) + dbo.saleledger.flatdisc,
	accountfor=dbo.saleledger.accountfor,
	impactinventory=dbo.saleledger.impactinventory
/*	difference= Sum ( dbo.saledetail.looseqty * dbo.saledetail.saleprice) - sum(Round(saledetail.packprice/ISNULL(saledetail.packunits ,1),2) * saledetail.looseqty) */
FROM 
	dbo.saleledger Left Outer Join dbo.Patient on dbo.saleledger.patientcode = dbo.patient.patientcode ,
	dbo.saledetail, 
	dbo.accounts
WHERE 
	( dbo.saleledger.custcode = :ar_custcode ) and
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) and  
	( dbo.saleledger.custcode = dbo.accounts.acccode )and  
	( dbo.saleledger.date between :ar_StartDate and :ar_EndDate)      
GROUP BY 
	dbo.saleledger.saleinvcode,   
	dbo.saleledger.date,   
	dbo.saleledger.salecatcode, 
	dbo.saleledger.remarks,
	dbo.patient.name,
	dbo.patient.regno,
	dbo.saleledger.custrefno, 
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.discperc,  
	dbo.saleledger.salestax,  
	dbo.saleledger.accountfor,
	dbo.saleledger.impactinventory,
	dbo.accounts.name
UNION ALL			
 SELECT 
	invcode     = dbo.saleledger.saleinvcode,    
	date        = dbo.saleledger.date,    
	flatdisc    = dbo.saleledger.flatdisc, 
	salestax    = dbo.saleledger.salestax,       
	misccharges = dbo.saleledger.misccharges,
	remarks     = dbo.saleledger.remarks,
	patient		= patient.name , 
	regno       = patient.regno ,  
	custrefno = dbo.saleledger.custrefno, 
	invdiscperc = dbo.saleledger.discperc, 
	doctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name, 
	amount =  Sum ( sd.looseqty * sd.saleprice),    
	itemdiscpercvalue = Round(Sum (Round(( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc),2)), 2),    
	invdiscpercvalue = Sum (Round( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01)),2)) * (dbo.saleledger.discperc /100) ,
	totaldiscount= Round(Sum (Round(( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc),2)), 2) + Round(Sum ( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01))) * (dbo.saleledger.discperc /100), 2) + dbo.saleledger.flatdisc,
	accountfor=dbo.saleledger.accountfor,
	impactinventory=dbo.saleledger.impactinventory
/*	difference= Sum ( sd.looseqty * sd.saleprice) - sum(Round(saledetail.packprice/ISNULL(saledetail.packunits ,1),2) * saledetail.looseqty) */
FROM 
	dbo.saleledger Left Outer Join dbo.Patient on dbo.saleledger.patientcode = dbo.patient.patientcode ,
	dbo.saleinvdetail sd, 
	dbo.accounts
WHERE 
	( DBO.SaleLedger.impactinventory = 'N' ) AND 
	( dbo.saleledger.custcode = :ar_custcode ) and
	( dbo.saleledger.saleinvcode = sd.saleinvcode ) and  
	( dbo.saleledger.custcode = dbo.accounts.acccode )and  
	( dbo.saleledger.date between :ar_StartDate and :ar_EndDate)      
GROUP BY 
	dbo.saleledger.saleinvcode,   
	dbo.saleledger.date,   
	dbo.saleledger.salecatcode, 
	dbo.saleledger.remarks,
	dbo.patient.name,
	dbo.patient.regno,
	dbo.saleledger.custrefno, 
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.discperc,  
	dbo.saleledger.salestax,  
	dbo.saleledger.accountfor,
	dbo.saleledger.impactinventory,
	dbo.accounts.name
ORDER BY 
	dbo.saleledger.saleinvcode ASC,   
	dbo.saleledger.date ASC  
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ar_custcode", number))
)
