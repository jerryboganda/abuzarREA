table(column=(type=decimal(2) updatewhereclause=yes name=cashsale dbname="cashsale"  )
column=(type=decimal(2) updatewhereclause=yes name=creditsale dbname="creditsale"  )
column=(type=decimal(2) updatewhereclause=yes name=saleinvtotal dbname="saleinvtotal"  )
column=(type=decimal(2) updatewhereclause=yes name=cashreturn dbname="cashReturn"  )
column=(type=decimal(2) updatewhereclause=yes name=creditreturn dbname="creditReturn"  )
column=(type=decimal(2) updatewhereclause=yes name=srinvtotal dbname="srinvtotal"  )
column=(type=decimal(2) updatewhereclause=yes name=netsale dbname="netsale"  )
column=(type=decimal(9) updatewhereclause=yes name=cgs dbname="cgs"  )
column=(type=decimal(9) updatewhereclause=yes name=profitamt dbname="profitamt"  )
column=(type=decimal(6) updatewhereclause=yes name=profitperc dbname="profitperc"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=netcash dbname="NetCash"  )
 retrieve="select  
	cashsale = ISNULL(SUM(CASE WHEN Cash=1 THEN saleinvtotal ELSE 0 END), 0),
	creditsale = ISNULL(SUM(CASE WHEN Cash=0 THEN saleinvtotal ELSE 0 END), 0),
	saleinvtotal=isnull(sum(saleinvtotal),0),
	cashReturn = ISNULL(SUM(CASE WHEN Cash=1 THEN srinvtotal ELSE 0 END), 0),
	creditReturn = ISNULL(SUM(CASE WHEN Cash=0 THEN srinvtotal ELSE 0 END), 0),
	srinvtotal=ISNULL(sum(srinvtotal),0),
	netsale=ISNULL(sum(saleinvtotal - srinvtotal),0),
	cgs=ISNULL(sum(cost_of_sale - cost_of_saleRet),0),
	profitamt=ISNULL(sum(saleinvtotal - srinvtotal - cost_of_sale + cost_of_saleRet),0),
	profitperc=(ISNULL(sum(saleinvtotal - srinvtotal - cost_of_sale + cost_of_saleRet), 0) * 100) / ISNULL(CASE sum(saleinvtotal - srinvtotal) WHEN 0 THEN 1 ELSE sum(saleinvtotal - srinvtotal) END,1),
	date=max(date),
	NetCash = ISNULL(SUM(CASE WHEN Cash=1 THEN saleinvtotal ELSE 0 END), 0) - ISNULL(SUM(CASE WHEN Cash=1 THEN srinvtotal ELSE 0 END), 0)
from
	(select  
		cash = CASE WHEN SL.SaleCatCode = 2 THEN 0 ELSE 1 END,
		saleinvtotal=dbo.fn_getsaleinvtotal(SL.saleinvcode),
		srinvtotal=0,
		cost_of_sale=sum((SD.looseqty + SD.BonusQty) * CASE :ai_pricetype WHEN 5 THEN sd.rppunitrate ELSE sd.avgprice END),
		cost_of_saleRet=0,
		day_of_year=DATEPART ( y , date ),
		date=max(SL.date)
	from 
		saleledger SL,
		saledetail SD
	where 
		date>=:adt_sdate and date<=:adt_edate and
		SL.saleinvcode=SD.saleinvcode 
	group by 
		DATEPART ( y , date ),
		SL.SaleCatCode,
		SL.saleinvcode
	union all
	select  
		cash = CASE WHEN SRL.SRCatCode = 7 THEN 0 ELSE 1 END,
		saleinvtoal=0,
		srinvtotal=dbo.fn_getsrinvtotal(SRL.srinvcode),
		cost_of_sale=0,
		cost_of_saleret=sum( (SRD.looseqty + SRD.BonusQty) * SRD.avgprice),
		day_of_year=DATEPART ( y , date ),
		date=max(SRL.date)
	from 
		srledger SRL,
		srdetail SRD
	where 
		date>=:adt_sdate and date<=:adt_edate and
		SRL.srinvcode=SRD.srinvcode
	group by 
		DATEPART ( y , date ),
		SRL.SRCatCode,
		SRL.srinvcode)  T1
group by 
	day_of_year
order by 
	day_of_year"
  arguments=(("adt_SDate", datetime), ("adt_EDate", datetime), ("ai_pricetype", number))
)
