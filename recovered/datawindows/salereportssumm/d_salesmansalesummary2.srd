table(column=(type=long updatewhereclause=yes name=salespersoncode dbname="SmanCode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesMan"  )
column=(type=decimal(6) updatewhereclause=yes name=grosssales dbname="GrossSales"  )
column=(type=decimal(6) updatewhereclause=yes name=salesdiscount dbname="SalesDiscount"  )
column=(type=decimal(6) updatewhereclause=yes name=saleextras dbname="SaleExtras"  )
column=(type=decimal(6) updatewhereclause=yes name=salesamt dbname="SalesAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=grossreturns dbname="GrossReturns"  )
column=(type=decimal(6) updatewhereclause=yes name=returndiscount dbname="ReturnDiscount"  )
column=(type=decimal(6) updatewhereclause=yes name=returnsextras dbname="ReturnsExtras"  )
column=(type=decimal(6) updatewhereclause=yes name=returnsamt dbname="ReturnsAmt"  )
 retrieve="SELECT
	SmanCode = S.SmanCode,
	SalesMan = SM.Name,
	GrossSales = SUM(S.GrossSales), 
	SalesDiscount = SUM(S.SalesDiscount),
	SaleExtras = SUM(S.GrossSales) - SUM(S.SalesDiscount) - SUM(S.SaleNet),
	SalesAmt = SUM(S.SaleNet),
	GrossReturns = SUM(S.GrossReturns),
	ReturnDiscount = SUM(S.ReturnDiscount),
	ReturnsExtras = SUM(S.GrossReturns) - SUM(S.ReturnDiscount) - SUM(S.RetNet),
	ReturnsAmt = SUM(S.RetNet)
FROM	
	(SELECT 	
		Type=1,
		SL.saleinvcode,
		SL.SmanCode,
		GrossSales = SUM(SD.LooseQty * SD.SalePrice),
		SalesDiscount = SUM(SD.LooseQty * SD.itemflatdisc) + 
			SUM(SD.looseqty * (SD.saleprice - SD.itemflatdisc) * (.01 * SD.discperc)) +
			SUM(SD.looseqty * (SD.saleprice - SD.itemflatdisc) * (1 - (.01 * SD.discperc)) * (.01 * SL.discperc) ),
		SaleNet = Round(
			SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
			SL.misccharges + SL.salestax - SL.flatdisc, 0)+
			Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
			SUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
			ROUND( (SUM((SD.looseqty * 
				(SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
				SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0),
		GrossReturns= 0.00,
		ReturnDiscount= 0.00,
		RetNet =0.00
	FROM    
		saleledger SL,	 
		saledetail SD
	WHERE   
		SL.Posted = 'Y' AND
		SL.date Between :ar_startdate AND :ar_enddate AND
		SL.SManCode IN (:ar_salesmancode) AND
		SL.SaleInvCode = SD.SaleInvcode
	GROUP BY 
		SL.saleinvcode,
		SL.SmanCode,
		SL.discperc,
		SL.misccharges,
		SL.salestax,
		SL.flatdisc,
		SL.invgstperc1
	UNION ALL
	SELECT 
		Type=1,
		SL.saleinvcode,
		SL.SmanCode,
		GrossSales = SUM(SD.LooseQty * SD.SalePrice),
		SalesDiscount = SUM(SD.LooseQty * SD.itemflatdisc) + 
			SUM(SD.looseqty * (SD.saleprice - SD.itemflatdisc) * (.01 * SD.discperc)) +
			SUM(SD.looseqty * (SD.saleprice - SD.itemflatdisc) * (1 - (.01 * SD.discperc)) * (.01 * SL.discperc) ),
		SaleNet=Round(
			SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
			SL.misccharges + SL.salestax - SL.flatdisc, 0)+
			Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
			SUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
			ROUND( (SUM((SD.looseqty * 
				(SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
				SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0),
		GrossReturns= 0.00,
		ReturnDiscount= 0.00,
		RetNet =0.00
	FROM  
		saleledger SL,	saleinvdetail SD
	WHERE 
		SL.ImpactInventory='N' AND  SL.Posted = 'Y' AND
		SL.date Between :ar_startdate AND :ar_enddate AND
		SL.SManCode IN (:ar_salesmancode) AND
		SL.SaleInvCode = SD.SaleInvcode
	GROUP BY 
		SL.saleinvcode,
		SL.SmanCode,
		SL.discperc,
		SL.misccharges,
		SL.salestax,
		SL.flatdisc,
		SL.invgstperc1
	UNION ALL
	SELECT 
		Type=2,
		SL.SRInvCode,
		SL.SmanCode,
		GrossSales = 0.00,
		SalesDiscount = 0.00,
		SaleNet=0.00,
		GrossReturns= 	SUM(SD.looseqty * SD.srprice),
		ReturnDiscount= 
			SUM(SD.looseqty * SD.srprice * (.01 * SD.discperc)) +
			SUM(SD.looseqty * SD.srprice * (1 - (.01 * SD.discperc)) * (.01 * SL.discperc) ),
		RetNet = Round(
			SUM((SD.looseqty*SD.srprice) *
			(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
			SL.misccharges + SL.salestax - SL.flatdisc, 0)+
			Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
			SUM(ROUND( (SD.looseqty * SD.srprice ) *
				(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
			ROUND( (SUM((SD.looseqty * SD.srprice) *
				(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
				SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0)
	FROM    
		srledger SL,	 
		srdetail SD
	WHERE   
		SL.Posted = 'Y' AND
		SL.date Between :ar_startdate AND :ar_enddate AND
		SL.SManCode IN (:ar_salesmancode) AND
		SL.SRInvCode = SD.SRInvcode
	GROUP BY 
		SL.srinvcode,
		SL.SmanCode,
		SL.discperc,
		SL.misccharges,
		SL.salestax,
		SL.flatdisc,
		SL.invgstperc1) S, SalesMan SM
WHERE
	SM.SalesManCode IN (:ar_salesmancode) AND
	S.SmanCode = SM.SalesmanCode
GROUP BY
	S.SmanCode,
	SM.Name
ORDER BY
	SM.Name"
  arguments=(("ar_SalesmanCode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
