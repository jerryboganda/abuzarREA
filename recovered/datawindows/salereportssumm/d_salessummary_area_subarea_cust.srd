datawindow ( units=0 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=548 color="536870912" )
summary(height=108 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=decimal(6) updatewhereclause=yes name=grosssales dbname="GrossSales"  )
column=(type=decimal(6) updatewhereclause=yes name=discounts dbname="Discounts"  )
column=(type=decimal(2) updatewhereclause=yes name=salesreturns dbname="SalesReturns"  )
 retrieve="SELECT
	GroupCode,
	GroupName, 
	GrossSales = Sum(GrossSales),
	Discounts  = SUM(Discounts),
	SalesReturns = SUM(SalesReturns)
FROM
	(SELECT 
		GroupCode = A.AreaCode,
		GroupName = A.Name,
		GrossSales = Sum(SD.LooseQty * SD.SalePrice),
		Discounts  = SUM( (SD.LooseQty * SD.ItemFlatDisc) + (SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * SD.DiscPerc * 0.01) 
			+ (SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (S.DiscPerc * 0.01) ) ),
		SalesReturns = 0.00
	FROM
		SaleLedger S, SaleDetail SD, Customer C, Area A
	WHERE
		:as_group = 'A' AND
		A.AreaCode IN (:ai_groupcode) AND 
		A.AreaCode = C.AreaCode AND 
		C.CustCode = S.CustCode AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND 
		S.SaleInvCode = SD.SaleInvCode
	GROUP BY
		A.AreaCode,
		A.Name
	UNION ALL
	SELECT 
		GroupCode = A.AreaCode,
		GroupName = A.Name,
		GrossSales = 0.00,
		Discounts  = 0.00,
		SalesReturns = SUM(DBO.fn_GetSRInvTotal(S.SRInvCode))
	FROM
		SRLedger S, Customer C, Area A
	WHERE
		:as_group = 'A' AND
		A.AreaCode IN (:ai_groupcode) AND 
		A.AreaCode = C.AreaCode AND 
		C.CustCode = S.CustCode AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		A.AreaCode,
		A.Name) S
WHERE 
	:as_group = 'A'
GROUP BY
	GroupCode,
	GroupName
UNION ALL
SELECT
	GroupCode,
	GroupName,
	GrossSales = Sum(GrossSales),
	Discounts  = SUM(Discounts),
	SalesReturns = SUM(SalesReturns)
FROM
	(SELECT 
		GroupCode = A.SubAreaCode,
		GroupName = A.Name,
		GrossSales = Sum(SD.LooseQty * SD.SalePrice),
		Discounts  = SUM( (SD.LooseQty * SD.ItemFlatDisc) + (SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * SD.DiscPerc * 0.01) 
			+ (SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (S.DiscPerc * 0.01) ) ),
		SalesReturns = 0.00
	FROM
		SaleLedger S, SaleDetail SD, Customer C, SubArea A
	WHERE
		:as_group = 'S' AND
		A.SubAreaCode IN (:ai_groupcode) AND 
		A.SubAreaCode = C.SubAreaCode AND 
		C.CustCode = S.CustCode AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND 
		S.SaleInvCode = SD.SaleInvCode
	GROUP BY
		A.SubAreaCode,
		A.Name
	UNION ALL
	SELECT 
		GroupCode = A.SubAreaCode,
		GroupName = A.Name,
		GrossSales = 0.00,
		Discounts  = 0.00,
		SalesReturns = SUM(DBO.fn_GetSRInvTotal(S.SRInvCode))
	FROM
		SRLedger S, Customer C, SubArea A
	WHERE
		:as_group = 'S' AND
		A.SubAreaCode IN (:ai_groupcode) AND 
		A.SubAreaCode = C.SubAreaCode AND 
		C.CustCode = S.CustCode AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		A.SubAreaCode,
		A.Name) S
WHERE 
	:as_group = 'S'
GROUP BY
	GroupCode,
	GroupName
UNION ALL
SELECT
	GroupCode,
	GroupName,
	GrossSales = Sum(GrossSales),
	Discounts  = SUM(Discounts),
	SalesReturns = SUM(SalesReturns)
FROM
	(SELECT 
		GroupCode = A.AccCode,
		GroupName = A.Name,
		GrossSales = Sum(SD.LooseQty * SD.SalePrice),
		Discounts  = SUM( (SD.LooseQty * SD.ItemFlatDisc) + (SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * SD.DiscPerc * 0.01) 
			+ (SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (S.DiscPerc * 0.01) ) ),
		SalesReturns = 0.00
	FROM
		SaleLedger S, SaleDetail SD, Customer C, Accounts A
	WHERE
		:as_group = 'C' AND
		A.AccCode IN (:ai_groupcode) AND 
		A.AccCode = C.CustCode AND 
		C.CustCode = S.CustCode AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND 
		S.SaleInvCode = SD.SaleInvCode
	GROUP BY
		A.AccCode,
		A.Name
	UNION ALL
	SELECT 
		GroupCode = A.AccCode,
		GroupName = A.Name,
		GrossSales = 0.00,
		Discounts  = 0.00,
		SalesReturns = SUM(DBO.fn_GetSRInvTotal(S.SRInvCode))
	FROM
		SRLedger S, Customer C, Accounts A
	WHERE
		:as_group = 'C' AND
		A.AccCode IN (:ai_groupcode) AND 
		A.AccCode = C.CustCode AND 
		C.CustCode = S.CustCode AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY
		A.AccCode,
		A.Name) S
WHERE 
	:as_group = 'C'
GROUP BY
	GroupCode,
	GroupName

"
  arguments=(("as_group", string), ("ai_groupcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
