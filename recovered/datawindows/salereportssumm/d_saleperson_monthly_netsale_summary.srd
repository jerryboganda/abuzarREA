table(column=(type=char(20) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(6) updatewhereclause=yes name=value dbname="value"  )
 retrieve="SELECT 
	SalesPerson = SM.Name,
	Date = T.Date,
	Qty = SUM(T.Qty),
	Value = SUM(T.Value)
FROM
	SalesMan SM,
	(SELECT
		SManCode=S.SManCode,
		Date=CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME),
		Qty = SUM(D.PackQty + D.LooseQty + D.BonusQty),
		Value = SUM( (D.PackQty + D.LooseQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) )
	FROM
		SaleLedger S, SaleDetail D, Item I, Manufacturer M
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SaleInvCode=D.SaleInvCode AND
		D.ICode=I.ICode AND
		I.ManfCode = M.ManfCode AND
		S.SManCode IN (:ai_smancode) AND
		M.ManfCode IN (:ai_manfcode)
	GROUP BY S.SManCode, CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME)
	UNION ALL
	SELECT
		SManCode=S.SManCode,
		Date=CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME),
		Qty = - SUM(D.PackQty + D.LooseQty + D.BonusQty),
		Value = - SUM( (D.PackQty + D.LooseQty) * D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) )
	FROM
		SRLedger S, SRDetail D, Item I, Manufacturer M
	WHERE
		S.Posted='Y' AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SRInvCode=D.SRInvCode AND
		D.ICode=I.ICode AND
		I.ManfCode = M.ManfCode AND
		S.SManCode IN (:ai_smancode) AND
		M.ManfCode IN (:ai_manfcode)
	GROUP BY S.SManCode, CAST(LTRIM(RTRIM(STR(DATEPART(yy, S.Date)))) + '/' + LTRIM(RTRIM(STR(DATEPART(mm, S.Date)))) + '/01' AS DATETIME)) AS T
WHERE SM.SalesManCode = T.SManCode AND
	SM.SalesManCode IN (:ai_smancode)
GROUP BY SM.Name, T.Date


"
  arguments=(("ai_smancode", numberlist), ("ai_manfcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="salesperson A"
)
