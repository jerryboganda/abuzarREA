table(column=(type=char(20) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(20) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=number updatewhereclause=yes name=invoiceno dbname="invoiceno"  )
column=(type=char(20) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=decimal(0) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(0) updatewhereclause=yes name=value dbname="value"  )
 retrieve="SELECT 
	Manufacturer = M.Name,
	SalesPerson = SM.Name,
	InvoiceNo = T.InvoiceNo,
	Customer = A.Name,
	ItemName = I.Name,
	Qty = SUM(T.Qty),
	Value = SUM(T.Value)
FROM
	SalesMan SM,
	Customer C,
	Accounts A,
	Item I,
	Manufacturer M,
	(SELECT
		InvoiceNo=S.SaleInvCode,
		S.SManCode,
		S.CustCode,
		I.ICode,
		Qty = SUM(D.PackQty + D.LooseQty + D.BonusQty),
		Value = SUM( (D.PackQty + D.LooseQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) )
	FROM
		SaleLedger S, SaleDetail D, Item I
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SManCode IN (:ai_smancode) AND
		S.SaleInvCode=D.SaleInvCode AND
		D.ICode=I.ICode AND
		I.ManfCode = :ai_manfcode
	GROUP BY S.SaleInvCode, S.SManCode, S.CustCode, I.ICode
	UNION ALL
	SELECT
		InvoiceNo=S.SaleInvCode,
		S.SManCode,
		S.CustCode,
		I.ICode,
		Qty = - SUM(D.PackQty + D.LooseQty + D.BonusQty),
		Value = - SUM( (D.PackQty + D.LooseQty) * D.SRPrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01) )
	FROM
		SRLedger S, SRDetail D, Item I
	WHERE
		S.Posted='Y' AND
		S.SaleInvCode > 0 AND
		S.SaleInvCode IN 
			(SELECT SS.SaleInvCode
			FROM SaleLedger SS
			WHERE
				SS.Posted='Y' AND
				SS.Date BETWEEN :adt_startdate AND :adt_enddate AND
				SS.SManCode IN (:ai_smancode)) AND
		S.SRInvCode=D.SRInvCode AND
		D.ICode=I.ICode AND
		I.ManfCode = :ai_manfcode
	GROUP BY S.SRInvCode,S.SaleInvCode,S.SManCode, S.CustCode, I.ICode) AS T
WHERE 
	T.SManCode = SM.SalesManCode AND
	SM.SalesManCode IN (:ai_smancode) AND
	T.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	T.ICode = I.ICode AND
	I.ManfCode = M.ManfCode AND
	M.ManfCode = :ai_manfcode
GROUP BY M.Name,SM.Name, A.Name, T.InvoiceNo, I.ICode, I.Name


"
  arguments=(("ai_manfcode", number), ("ai_smancode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="manufacturer A, salesperson A, invoiceno A, customer A"
)
