header[1](height=84 color="536870912" )
header[2](height=0 color="536870912" )
header[3](height=80 color="536870912" )
summary(height=88 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=area dbname="area"  )
column=(type=char(20) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(20) updatewhereclause=yes name=category dbname="category"  )
column=(type=char(20) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(20) updatewhereclause=yes name=city dbname="city"  )
column=(type=number updatewhereclause=yes name=salevalue dbname="salevalue"  )
 retrieve="SELECT 
	Area = Name1, 
	Customer = Name2,
	Address = Name3,
	City = Name4,
	SaleCategory = Name5,
	Category = Name7,
	Month= Code1,
	Slab = Name6,
	SaleValue = ISNULL(SUM(Value1), 0)
FROM ReportData
GROUP BY
	Name1,
	Name2,
	Name3,
	Name4,
	Name5,
	Code1,
	Name6,
	Name7
"
  arguments=(("as_grouping", string), ("as_grouplist", string), ("ai_month", number), ("ai_year", number))
 sort="area A, customer A, category A, address A, city A"
)
