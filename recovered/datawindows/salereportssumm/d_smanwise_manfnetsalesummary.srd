table(column=(type=char(60) updatewhereclause=yes name=name dbname="Manufacturer.NAme"  )
column=(type=long key=yes updatewhereclause=yes name=manfcode dbname="Manufacturer.ManfCode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="Salesman"  )
column=(type=decimal(6) updatewhereclause=yes name=sale dbname="Sale"  )
column=(type=decimal(6) updatewhereclause=yes name=sreturn dbname="SReturn"  )
column=(type=decimal(6) updatewhereclause=yes name=netsale dbname="NetSale"  )
 retrieve="SELECT 
	M.NAme, 
	S.ManfCode,
	Salesman=(SELECT SM.NAME FROM SALESMAN SM WHERE SM.SALESMANCODE=:ai_SManCode),
	Sale=SUM(S.SaleAmt),
	SReturn=SUM(S.ReturnAmt),
	NetSale=SUM(S.SaleAmt - S.ReturnAmt)
FROM
	Manufacturer M,
	(SELECT
		I.ManfCode,
		SaleAmt=SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * 
			(1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
		ReturnAmt=0
	FROM
		SaleLedger SL, SaleDetail SD, Item I, Customer C
	WHERE
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SManCode = :ai_SManCode AND
		SL.CustCode = C.CustCode AND
		C.AreaCode IN (:ai_AreaCode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode 
	GROUP BY
		SL.SaleInvCode,
		SD.ICode,
		I.ManfCode
	UNION ALL
	SELECT
		I.ManfCode,
		SaleAmt=SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * 
			(1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
		ReturnAmt=0
	FROM
		SaleLedger SL, SaleInvDetail SD, Item I, Customer C
	WHERE
		SL.ImpactInventory = 'N' AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SManCode = :ai_SManCode AND
		SL.CustCode = C.CustCode AND
		C.AreaCode IN (:ai_AreaCode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode 
	GROUP BY
		SL.SaleInvCode,
		SD.ICode,
		I.ManfCode
	UNION ALL
	SELECT
		I.ManfCode,
		SaleAmt=0,
		ReturnAmt=SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))
	FROM
		SRLedger SL, SRDetail SD, Item I, Customer C
	WHERE
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SManCode = :ai_SManCode AND
		SL.CustCode = C.CustCode AND
		C.AreaCode IN (:ai_AreaCode) AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = I.ICode 
	GROUP BY
		SL.SRInvCode,
		SD.ICode,
		I.ManfCode) S
WHERE
	S.ManfCode = M.ManfCode
GROUP BY
	M.Name,
	S.ManfCode
ORDER BY
	M.Name"
  update="Manufacturer" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ai_AreaCode", numberlist), ("ai_SManCode", number))
)
