table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="HeaderInvNo"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=decimal(2) updatewhereclause=yes name=oldamt dbname="OldAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=amt dbname="Amt"  )
column=(type=char(1) updatewhereclause=yes name=paymentmode dbname="PaymentMode"  )
column=(type=long updatewhereclause=yes name=paymentacccode dbname="PaymentAccCode"  )
column=(type=char(60) updatewhereclause=yes name=ddd_acccode dbname="ddd_AccCode"  )
column=(type=datetime updatewhereclause=yes name=amtdate dbname="AmtDate"  )
column=(type=char(20) updatewhereclause=yes name=amtreference dbname="AmtReference"  )
column=(type=long updatewhereclause=yes name=amtby dbname="AmtBy"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="OutStandingAmt"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
 retrieve="SELECT
	SaleInvCode=S.SaleInvCode,
	HeaderInvNo=S.HeaderInvNo,
	HeaderNo=S.HeaderNo, 
	Date=S.Date,
	AliasName=A.AliasName,
	AccountName=A.Name,
	InvTotal=ISNULL(S.InvTotal, 0),
	OldAmt=ISNULL(S.Amt, 0),
	Amt=ISNULL(S.Amt, 0),
	PaymentMode=S.PaymentMode,
	PaymentAccCode=S.PaymentAccCode,
	ddd_AccCode=(SELECT A.Name FROM Accounts A WHERE A.AccCode = S.PaymentAccCode),
	AmtDate=S.AmtDate,
	AmtReference=S.AmtReference,
	AmtBy=S.AmtBy,
	OutStandingAmt=S.OutStandingAmt,
	Posted=S.Posted
	
FROM SaleLedger S, Accounts A
WHERE
	S.AccountFor = 'Y' AND 
	S.Deleted='N' AND
	S.CustCode = A.AccCode AND
	S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
	S.HeaderNo = :ai_headerno
ORDER BY
	S.SaleInvCode,
	A.Name,
	A.AliasName"
  arguments=(("ai_headerno", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
