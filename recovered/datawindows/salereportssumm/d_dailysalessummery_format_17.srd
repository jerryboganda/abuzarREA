table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=long updatewhereclause=yes name=salecount dbname="SaleCount"  )
column=(type=decimal(6) updatewhereclause=yes name=grosssales dbname="GrossSales"  )
column=(type=decimal(2) updatewhereclause=yes name=sales dbname="Sales"  )
column=(type=decimal(6) updatewhereclause=yes name=salesdiscount dbname="SalesDiscount"  )
column=(type=decimal(2) updatewhereclause=yes name=rerturns dbname="Rerturns"  )
column=(type=long updatewhereclause=yes name=returncount dbname="ReturnCount"  )
column=(type=decimal(2) updatewhereclause=yes name=returndiscount dbname="ReturnDiscount"  )
column=(type=decimal(2) updatewhereclause=yes name=netsale dbname="NetSale"  )
 retrieve="SELECT
	AliasName,
	CustomerName,
	SaleCount = SUM(SaleCount),
	GrossSales = SUM(GrossSales),
	Sales = SUM(Sales),
	SalesDiscount = SUM(SaleDiscount),
	Rerturns = SUM(Rerturns),
	ReturnCount = SUM(ReturnCount),
	ReturnDiscount = SUM(ReturnDiscount),
	NetSale=SUM(Sales) - SUM(Rerturns)
FROM 
	(SELECT 
		Type = 'S',
		AliasName=A.AliasName,
		CustomerName = A.Name,
		SaleCount = COUNT(S.SaleInvCode),
		GrossSales = ISNULL(SUM(D.LooseQty * D.SalePrice), 0.00),
		Sales = S.InvTotal,
		SaleDiscount = SUM(D.LooseQty * D.ItemFlatDisc) + 
				SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * D.DiscPerc * 0.01) + 
				SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * S.DiscPerc * 0.01),
		Rerturns = 0.00,
		ReturnDiscount=0.00,
		ReturnCount = 0
	FROM
		SaleLedger S, SaleDetail D, Accounts A
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.CustCode = A.AccCode AND
		D.SaleInvCode = S.SaleInvCode 
	GROUP BY
		A.Name, A.AliasName, S.SaleInvCode, S.InvTotal
	UNION ALL
	SELECT 
		Type = 'R',
		AliasName=A.AliasName,
		CustomerName = A.Name,
		SaleCount = 0,
		GrossSales = 0.00,
		Sales = 0.00,
		SaleDiscount=0.00,
		Rerturns = SUM(S.InvTotal),
		ReturnDiscount=0.00,
		ReturnCount = COUNT(S.SRInvCode)
	FROM
		SRLedger S, Accounts A
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.CustCode = A.AccCode
	GROUP BY
		A.Name, A.AliasName) SL
GROUP BY
	AliasName,
	CustomerName
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="salecount D"
)
