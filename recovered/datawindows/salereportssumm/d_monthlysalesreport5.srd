compute(name=compute_2 visible="1" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="2854" y="11" height="197" width="781" format="	f_setColumnFormat('Qty')" expression="sum(value2 for all )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_3 visible="1" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="3656" y="11" height="197" width="812" format="	f_setColumnFormat('Qty')" expression="sum(grand_sum_value2 for all )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
column(name=name1 visible="1" band=detail id=1 x="20" y="11" height="197" width="2812" color="33554432" border="0" alignment="0" format="[general]" html.valueishtml="0" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=yes edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Times New Roman" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
