compute(name=grand_sum_value2 visible="1" band=detail font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="3656" y="11" height="197" width="812" format="	f_setColumnFormat('Qty')" expression="crosstabsum(1)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
crosstab(columns="date1" rows="name1" values="sum(value2 for crosstab)" sourcenames = "code1, code2, value1, value2, date1, name1, name2, name3, name4" crosstabonly=yes  band=foreground )
