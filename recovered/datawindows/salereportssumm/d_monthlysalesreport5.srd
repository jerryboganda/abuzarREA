release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1052 color="536870912" )
header[2](height=354 color="536870912" )
summary(height=218 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=name1 dbname="name1"  )
column=(type=number updatewhereclause=yes name=value2 dbname="value2"  )
 retrieve="SELECT ReportData.code1,   
         ReportData.code2,   
         ReportData.value1,   
         ReportData.value2,   
         ReportData.date1,   
         ReportData.name1,   
         ReportData.name2,   
         ReportData.name3,   
         ReportData.name4  
FROM ReportData   
WHERE code1 in (:ar_icatcode)
ORDER BY name1, name2, name3
"
  arguments=(("ar_icatcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_customer", string))
 sort="name1 A"
)
compute(name=compute_6 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-12" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" x="52" y="31" height="208" width="7739" format="[GENERAL]" expression="~"Category Wise Monthly Sales Report~"" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_4 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="6541" y="52" height="166" width="1239" format="[GENERAL]" expression="'Page ' + page() + ':' + pageAcross() + ' of ' + pageCount() + ':' + pageCountAcross()" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_companyname visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="41" y="270" height="166" width="7750" format="[GENERAL]" expression="f_ReportHeaderInfo('clientname')" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_address1 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="41" y="468" height="166" width="7750" format="[GENERAL]" expression="f_ReportHeaderInfo('address1')" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_address2 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="41" y="666" height="166" width="7750" format="[GENERAL]" expression="f_ReportHeaderInfo('address2')" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_start visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="41" y="864" height="166" width="7750" format="[GENERAL]" expression="~"Report Date:~" + STRING(day( today() )) + '/' + STRING(month( today() )) + '/' + STRING(year( today() )) + SPACE(10) + SPACE(5) + ~"From :~" +  STRING(day(ar_startdate )) + '/' + STRING(month(ar_startdate )) + '/' + STRING(year(ar_startdate )) + SPACE(10) + ~"To :~" +  STRING(day(ar_enddate)) + '/' + STRING(month(ar_enddate)) + '/' + STRING(year(ar_enddate)) + '  Customer: ' +  ar_customer " alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
text(name=grand_sum_value2_t visible="1" band=header[2] font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" alignment="2" border="0" x="3656" y="10" height="333" width="812" text="Grand
Total " html.valueishtml="0" )
text(name=name1_t visible="1" band=header[2] font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" alignment="2" border="0" x="20" y="10" height="333" width="2812" text="Item
Category" html.valueishtml="0" )
text(name=value2_t visible="1" band=header[2] font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" alignment="2" border="0" x="2854" y="10" height="333" width="781" text="	trim(case(month(date(left(~"@date1~", 10))) when 1 then 'JAN.' when 2 then 'FEB.' when 3 then 'MAR.' when 4 then 'APR.' when 5 then 'MAY' when 6 then 'JUNE' when 7 then 'JULY' when 8 then 'AUG.' when 9 then 'SEPT.' when 10 then 'OCT.' when 11 then 'NOV.' else 'DEC.') + '~~r~~n' + Right(left(~"@date1~", 10), 4))" html.valueishtml="0" )
