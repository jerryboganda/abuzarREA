table(column=(type=decimal(0) updatewhereclause=yes name=saleledgerlogid dbname="SaleLedgerLogID"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=datetime updatewhereclause=yes name=reprintdate dbname="reprintdate"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=decimal(5) updatewhereclause=yes name=balance dbname="balance"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=saleledger_date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(100) updatewhereclause=yes name=saleledger_remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_discperc dbname="discperc"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=long updatewhereclause=yes name=reprintcounter dbname="reprintcounter"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="doctor"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=datetime updatewhereclause=yes name=serverdate dbname="serverdate"  )
column=(type=long updatewhereclause=yes name=modifycounter dbname="modifycounter"  )
 retrieve="SELECT 
	SaleLedgerLogID=99999999999,
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, 
	salesman = CASE WHEN saleledger.modifycounter > 0 THEN (select u.username from users u where u.usercode = saleledger.modifiedby) ELSE users.username END,
	reprintdate=getdate(),
	headerno = dbo.saleledger.headerno,
	posted=max(saleledger.posted),
	balance=isnull(max(balance),0), 
	saleinvcode=dbo.saleledger.saleinvcode,   
	date=dbo.saleledger.date,   
	discperc=dbo.saleledger.discperc,   
	misccharges=dbo.saleledger.misccharges,   
	flatdisc=dbo.saleledger.flatdisc,   
	salestax=dbo.saleledger.salestax,   
	custcode=dbo.saleledger.custcode,   
	remarks=dbo.saleledger.remarks,   
	icode=dbo.saledetail.icode,   
	gcode=dbo.saledetail.gcode, 
	Id        = MAX(dbo.saledetail.IDENTITYCOL),  
	looseqty  = sum(saledetail.looseqty), 
	packqty   = sum(saledetail.packqty), 
	packunits = max(saledetail.packunits), 
	saleprice = max(saledetail.saleprice), 
	rate      = max(saledetail.rate),
	salestax  = max(saledetail.salestax),   
	discperc  = max(saledetail.discperc), 
	customername='                                  '  ,
	itemflatdisc  = max(saledetail.itemflatdisc),
	unitsalestax  = max(saledetail.unitsalestax),
	gstperc       = max(saledetail.gstperc),
	invgstperc    = max(saleledger.invgstperc1),
	reprintcounter=max(saleledger.reprintingcounter),
	doctor=max(doctors.name),
	patient=max(patient.name),
	serverdate=getdate(),
	modifycounter=dbo.saleledger.modifycounter
FROM 
	dbo.saleledger
	LEFT OUTER JOIN dbo.patient ON ( dbo.saleledger.patientcode = dbo.patient.patientcode)
	LEFT OUTER JOIN dbo.doctors ON ( dbo.saleledger.doctcode = dbo.doctors.doctcode), 
	dbo.saledetail,  
	item,
	Users
WHERE 
	( dbo.saleledger.saleinvcode = :ra_InvCode ) AND
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND 
	( saleLedger.SalesManCode = users.userCode ) and
	( saledetail.icode = item.icode )
GROUP BY 
	saleledger.saleinvcode, 
	saleledger.date, 
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	saleledger.headerno,
	saleledger.salestax, 
	saleledger.remarks, 
	saledetail.icode, 
	saledetail.rowgroup,
	saledetail.gcode, 
	item.name,
	item.icode,
	item.printable,
	users.username,
	saleledger.modifiedby,
	saleledger.modifycounter
UNION ALL
SELECT 
	SaleLedgerLogID=lh.SaleLedgerLogID,
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, 
	salesman = CASE WHEN lh.modifycounter > 0 THEN (select u.username from users u where u.usercode = lh.modifiedby) ELSE users.username END,
	reprintdate=getdate(),
	headerno = lh.headerno,
	posted=max(lh.posted),
	balance=isnull(max(lh.balance),0),
	saleinvcode=lh.saleinvcode,   
	date=lh.date,   
	discperc=lh.discperc,   
	misccharges=lh.misccharges,   
	flatdisc=lh.flatdisc,   
	salestax=lh.salestax,   
	custcode=lh.custcode,   
	remarks=lh.remarks,   
	icode=ld.icode,   
	gcode=ld.gcode, 
	Id        = MAX(ld.RowID),  
	looseqty  = sum(ld.looseqty), 
	packqty   = sum(ld.packqty), 
	packunits = max(ld.packunits), 
	saleprice = max(ld.saleprice), 
	rate      = max(ld.rate),
	salestax  = max(ld.salestax),   
	discperc  = max(ld.discperc), 
	customername='                                  '  ,
	itemflatdisc  = max(ld.itemflatdisc),
	unitsalestax  = max(ld.unitsalestax),
	gstperc       = max(ld.gstperc),
	invgstperc    = max(lh.invgstperc1),
	reprintcounter=max(lh.reprintingcounter),
	doctor=max(doctors.name),
	patient=max(patient.name),
	serverdate=getdate(),
	modifycounter=lh.modifycounter
FROM 
	dbo.saleledgerlog lh
	LEFT OUTER JOIN dbo.patient ON ( lh.patientcode = dbo.patient.patientcode)
	LEFT OUTER JOIN dbo.doctors ON ( lh.doctcode = dbo.doctors.doctcode), 
	dbo.saledetaillog ld,  
	item,
	Users

WHERE 
	lh.saleinvcode = :ra_InvCode AND
	lh.saleinvcode = ld.saleinvcode AND 
	lh.saleledgerlogid = ld.saleledgerlogid AND 
	lh.SalesManCode = users.userCode and
	ld.icode = item.icode
GROUP BY 
	lh.saleinvcode, 
	lh.SaleLedgerLogID,
	lh.date, 
	lh.custcode, 
	lh.discperc, 
	lh.flatdisc, 
	lh.misccharges, 
	lh.headerno,
	lh.salestax, 
	lh.remarks, 
	ld.icode, 
	ld.rowgroup,
	ld.gcode, 
	item.name,
	item.icode,
	item.printable,
	users.username,
	lh.modifiedby,
	lh.modifycounter
ORDER BY 
	SaleLedgerLogID,
	saleinvcode,
	ID"
  arguments=(("ra_InvCode", number))
)
