release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1270 color="536870912" )
summary(height=208 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="ItemAliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="Price"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="TotalStock"  )
column=(type=decimal(4) updatewhereclause=yes name=currstock dbname="CurrStock"  )
column=(type=decimal(6) updatewhereclause=yes name=value dbname="Value"  )
 retrieve="SELECT 
	ICode=D.ICode, 
	ItemAliasName = ISNULL((SELECT Item.CustomICode FROM ITEM WHERE ITEM.ICode = D.ICode), NULL),
	ItemName = ISNULL((SELECT Item.Name FROM ITEM WHERE ITEM.ICode = D.ICode), MAX(D.UnKnownItemName)),
	Qty=SUM(D.Qty), 
	Price=Max(D.SalePrice),
	Remarks=MAX(D.Remarks),
	TotalStock=MAX(D.TotalStock),
	CurrStock = ISNULL((SELECT SUM(G.CurrQty) FROM GodownDetail G WHERE G.ICode = D.ICode), 0),
	Value = SUM(D.Qty * D.SalePrice)
FROM 
	RefusedSaleHeader S, RefusedSaleDetail D, SaleRefusalReason SRR
WHERE 
	S.Date BETWEEN :ad_startdate AND :ad_enddate AND
	S.RefusedSaleInvCode = D.RefusedSaleInvCode AND
	D.ReasonCode = SRR.ReasonCode
GROUP BY
	D.ICode
ORDER BY
	ItemName
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="itemname A"
)
