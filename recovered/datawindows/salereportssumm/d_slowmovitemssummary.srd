release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=572 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=long updatewhereclause=yes name=reorderlevel dbname="ReorderLevel"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="salevalue"  )
column=(type=decimal(4) updatewhereclause=yes name=currqty dbname="currqty"  )
column=(type=decimal(6) updatewhereclause=yes name=stockvalue dbname="stockvalue"  )
 retrieve="SELECT itemname = dbo.item.name,	 	
       itemcode = dbo.item.icode,
	 ReorderLevel = dbo.item.ReorderLevel,	 
	 Manufacturer= dbo.Manufacturer.name, 
 	 ItemCategory = dbo.ItemCategory.name, 
	 saleqty = Sum(dbo.saledetail.looseqty),		 
	salevalue = Sum(dbo.saledetail.looseqty) * (Max(dbo.item.saleprice) / Max(dbo.item.packunits)),	
	 currqty = IsNull((Select  sum(currqty) 	
			from godowndetail 	
			where dbo.item.icode = godowndetail.icode),0),
	stockvalue = IsNull((Select  sum(currqty) 	
			from godowndetail 	
			where dbo.item.icode = godowndetail.icode),0)   * (Max(dbo.item.saleprice) / Max(dbo.item.packunits))
	
FROM dbo.saleledger,	 
	 dbo.saledetail,
	 dbo.item,
	 dbo.ItemCategory,
	 dbo.Manufacturer	

WHERE dbo.saleledger.date >= :ad_StartDate and 	
	dbo.saleledger.date <= :ad_EndDate and 	
	dbo.saleledger.salecatcode IN (1, 2, 3) and	 
	dbo.Item.icatcode IN (:ana_icatcode) and
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and	   
	dbo.saledetail.icode = dbo.item.icode and 
	dbo.item.manfcode = dbo.Manufacturer.manfcode and 
   dbo.item.icatcode = dbo.ItemCategory.icatcode	 		 

GROUP BY Manufacturer.Name, ItemCategory.name, item.name, item.icode, dbo.item.ReorderLevel	 

Union 

SELECT itemname = dbo.item.name,		
       itemcode = dbo.item.icode,
	ReorderLevel = dbo.item.ReorderLevel,	 
	Manufacturer= dbo.Manufacturer.name, 
   ItemCategory = dbo.ItemCategory.name,  
       saleqty = 0, 	 
	salevalue = 0,	
	currqty = IsNull((Select  sum(currqty) 	
			from godowndetail 	
			where dbo.item.icode = godowndetail.icode),0),
	stockvalue = IsNull((Select  sum(currqty) 	
			from godowndetail 	
			where dbo.item.icode = godowndetail.icode),0)   * (Max(dbo.item.saleprice) / Max(dbo.item.packunits))
	  	
FROM 	 dbo.item,
		dbo.ItemCategory, 
	 dbo.Manufacturer	

WHERE   dbo.item.icode Not in  (Select saledetail.icode
				From Saleledger,saledetail
				Where 	dbo.saleledger.date >= :ad_StartDate and 	
				 	   dbo.saleledger.date <= :ad_EndDate and 	
					   dbo.saleledger.salecatcode IN (1, 2, 3) and	 
					   dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) and
	 dbo.Item.icatcode IN (:ana_icatcode) and
	 Item.manfcode = manufacturer.manfcode and
    dbo.item.icatcode = dbo.ItemCategory.icatcode	 		  			 
GROUP BY Manufacturer.Name, ItemCategory.name, item.name, item.icode, dbo.item.ReorderLevel"
  arguments=(("ana_icatcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="manufacturer A, saleqty A"
)
