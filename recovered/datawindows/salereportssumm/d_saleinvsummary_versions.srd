table(column=(type=decimal(0) updatewhereclause=yes name=saleledgerlogid dbname="SaleLedgerLogID"  )
column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=long updatewhereclause=yes name=altersaleinvcode dbname="altersaleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=saletype dbname="saletype"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(6) updatewhereclause=yes name=gross dbname="gross"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=decimal(6) updatewhereclause=yes name=totaldiscount dbname="totaldiscount"  )
column=(type=decimal(6) updatewhereclause=yes name=difference dbname="difference"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsalestax dbname="itemsalestax"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="accountfor"  )
column=(type=char(1) updatewhereclause=yes name=impactinventory dbname="impactinventory"  )
column=(type=decimal(2) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=cashreceived dbname="CashReceived"  )
column=(type=decimal(2) updatewhereclause=yes name=creditcardcharged dbname="CreditCardCharged"  )
column=(type=long updatewhereclause=yes name=modifycounter dbname="SaleLedger.ModifyCounter"  )
column=(type=char(60) updatewhereclause=yes name=saleperson dbname="saleperson"  )
 retrieve="SELECT  
	SaleLedgerLogID=99999999999,
	invcode     = saleledger.saleinvcode,    
	altersaleinvcode = saleledger.altersaleinvcode,
	date        = saleledger.date,    
	flatdisc    = saleledger.flatdisc, 
	salestax    = saleledger.salestax,       
	misccharges = saleledger.misccharges, 
	invdiscperc = saleledger.discperc, 
	invgstperc1 = saleledger.invgstperc1, 
	posted = saleledger.posted,
	saletype = (Select Name From SaleType Where saletypecode = Max(saleledger.saletypecode) ) ,
	accounts.name, 
	amount =  Sum ( saledetail.looseqty * saledetail.saleprice),   
	gross= Sum ( saledetail.looseqty * saledetail.saleprice), 
	itemdiscpercvalue = Round(Sum (Round(( saledetail.looseqty  * (saledetail.saleprice - saledetail.itemflatdisc) * (saledetail.discperc * .01)) + (saledetail.looseqty  * saledetail.itemflatdisc),2)), 2),    
	invdiscpercvalue = Sum (Round( saledetail.looseqty   * (saledetail.saleprice  - saledetail.itemflatdisc) * (1 - (saledetail.discperc * .01)),2)) * (saleledger.discperc /100),
	salesman = CASE WHEN saleledger.modifycounter > 0 THEN (select u.username from users u where u.usercode = saleledger.modifiedby) ELSE users.username END,
	totaldiscount= Round(Sum (Round(( saledetail.looseqty  * (saledetail.saleprice - saledetail.itemflatdisc) * (saledetail.discperc * .01)) + (saledetail.looseqty  * saledetail.itemflatdisc),2)), 2) + Round(Sum ( saledetail.looseqty   * (saledetail.saleprice  - saledetail.itemflatdisc) * (1 - (saledetail.discperc * .01))) * (saleledger.discperc /100), 2) + saleledger.flatdisc,
	difference= Sum ( saledetail.looseqty * saledetail.saleprice) - sum(Round(saledetail.rate,2) * saledetail.looseqty) ,
	itemsalestax = Sum (Round (saledetail.looseqty * saledetail.unitsalestax + Round ( Round (saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc ) * (1 - saledetail.discperc * 0.01 ), 2 ) * saledetail.gstperc * 0.01 , 2 ) , 2 ) ),
	accountfor=saleledger.accountfor,
	impactinventory=saleledger.impactinventory,
	NetAmt = dbo.fn_GetSaleInvTotal(saleledger.saleinvcode),
	CashReceived = ISNULL(saleledger.Amt, 0) + ISNULL(CashCharged, 0),
	CreditCardCharged = ISNULL((SELECT SUM(CW.Amount) FROM CashierWindow CW WHERE CW.SaleInvCode = saleledger.SaleInvCode), 0),
	SaleLedger.ModifyCounter,
	saleperson = (select sm.Name from salesman sm where sm.salesmancode = saleledger.smancode)
FROM 
	saleledger, 
	saledetail,   
	accounts,
	users  
WHERE 
	( saleledger.modifycounter > 0 ) AND
	( saleledger.saleinvcode = saledetail.saleinvcode ) and 
	( saleledger.custcode = accounts.acccode ) and  
	( saleledger.salesmancode = users.usercode ) and  
	( saleledger.date between :ar_StartDate and :ar_EndDate)            
GROUP BY 
	saleledger.saleinvcode,   
	saleledger.altersaleinvcode,
	saleledger.date,   
	saleledger.misccharges,   
	saleledger.flatdisc,   
	saleledger.discperc,  
	saleledger.salestax, 
	saleledger.invgstperc1 ,
	saleledger.salecatcode, 
	saleledger.posted, 
	saleledger.accountfor,
	saleledger.impactinventory,
	saleledger.modifiedby,
	saleledger.modifycounter,
	saleledger.Amt,
	saleledger.CashCharged,
	accounts.name,
	users.username,
	saleledger.smancode
UNION ALL
SELECT 
	SaleLedgerLogID=99999999999,
	invcode     = saleledger.saleinvcode,    
	altersaleinvcode = saleledger.altersaleinvcode,
	date        = saleledger.date,    
	flatdisc    = saleledger.flatdisc, 
	salestax    = saleledger.salestax,       
	misccharges = saleledger.misccharges, 
	invdiscperc = saleledger.discperc, 
	invgstperc1 = saleledger.invgstperc1, 
	posted = saleledger.posted,
	saletype = (Select Name From SaleType Where saletypecode = Max(saleledger.saletypecode) ) ,
	accounts.name, 
	amount =  Sum ( sd.looseqty * sd.saleprice),   
	gross= Sum ( sd.looseqty * sd.saleprice), 
	itemdiscpercvalue = Round(Sum (Round(( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc),2)), 2),    
	invdiscpercvalue = Sum (Round( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01)),2)) * (saleledger.discperc /100),
	salesman = CASE WHEN saleledger.modifycounter > 0 THEN (select u.username from users u where u.usercode = saleledger.modifiedby) ELSE users.username END,
	totaldiscount= Round(Sum (Round(( sd.looseqty  * (sd.saleprice - sd.itemflatdisc) * (sd.discperc * .01)) + (sd.looseqty  * sd.itemflatdisc),2)), 2) + Round(Sum ( sd.looseqty   * (sd.saleprice  - sd.itemflatdisc) * (1 - (sd.discperc * .01))) * (saleledger.discperc /100), 2) + saleledger.flatdisc,
	difference= Sum ( sd.looseqty * sd.saleprice) - sum(Round(sd.rate,2) * sd.looseqty) ,
	itemsalestax = Sum (Round (sd.looseqty * sd.unitsalestax + Round ( Round (sd.looseqty * (sd.saleprice - sd.itemflatdisc ) * (1 - sd.discperc * 0.01 ), 2 ) * sd.gstperc * 0.01 , 2 ) , 2 ) ),
	accountfor=saleledger.accountfor,
	impactinventory=saleledger.impactinventory,
	NetAmt = SaleLedger.InvTotal,
	CashReceived = ISNULL(saleledger.Amt, 0) + ISNULL(CashCharged, 0),
	CreditCardCharged = ISNULL((SELECT SUM(CW.Amount) FROM CashierWindow CW WHERE CW.SaleInvCode = saleledger.SaleInvCode), 0),
	SaleLedger.ModifyCounter,
	saleperson = (select sm.Name from salesman sm where sm.salesmancode = saleledger.smancode)
FROM saleledger, 
	saleinvdetail sd,   
	accounts,
	users  
WHERE 
	( saleledger.modifycounter > 0 ) AND
	( SaleLedger.impactinventory = 'N' ) AND 
	( saleledger.saleinvcode = sd.saleinvcode ) and 
	( saleledger.custcode = accounts.acccode )and  
	( saleledger.salesmancode = users.usercode ) and  
	( saleledger.date between :ar_StartDate and :ar_EndDate)            
GROUP BY 
	saleledger.saleinvcode,   
	saleledger.altersaleinvcode,
	saleledger.date,   
	saleledger.misccharges,   
	saleledger.flatdisc,   
	saleledger.discperc,  
	saleledger.salestax, 
	saleledger.invgstperc1 ,
	saleledger.salecatcode, 
	saleledger.posted, 
	saleledger.invtotal,
	saleledger.accountfor,
	saleledger.modifiedby,
	saleledger.modifycounter,
	saleledger.impactinventory,
	saleledger.Amt,
	saleledger.CashCharged,
	accounts.name,
	users.username,
	saleledger.smancode
UNION ALL
SELECT 
	SaleLedgerLogID = SaleLedgerLog.SaleLedgerLogID,
	invcode     = saleledgerlog.saleinvcode,    
	altersaleinvcode = saleledgerlog.altersaleinvcode,
	date        = saleledgerlog.date,    
	flatdisc    = saleledgerlog.flatdisc, 
	salestax    = saleledgerlog.salestax,       
	misccharges = saleledgerlog.misccharges, 
	invdiscperc = saleledgerlog.discperc, 
	invgstperc1 = saleledgerlog.invgstperc1, 
	posted = saleledgerlog.posted,
	saletype = (Select Name From SaleType Where saletypecode = Max(saleledgerlog.saletypecode) ) ,
	accounts.name, 
	amount =  Sum ( saledetaillog.looseqty * saledetaillog.saleprice),   
	gross= Sum ( saledetaillog.looseqty * saledetaillog.saleprice), 
	itemdiscpercvalue = Round(Sum (Round(( saledetaillog.looseqty  * (saledetaillog.saleprice - saledetaillog.itemflatdisc) * (saledetaillog.discperc * .01)) + (saledetaillog.looseqty  * saledetaillog.itemflatdisc),2)), 2),    
	invdiscpercvalue = Sum (Round( saledetaillog.looseqty   * (saledetaillog.saleprice  - saledetaillog.itemflatdisc) * (1 - (saledetaillog.discperc * .01)),2)) * (saleledgerlog.discperc /100),
	salesman = CASE WHEN saleledgerlog.modifycounter > 0 THEN (select u.username from users u where u.usercode = saleledgerlog.modifiedby) ELSE users.username END,
	totaldiscount= Round(Sum (Round(( saledetaillog.looseqty  * (saledetaillog.saleprice - saledetaillog.itemflatdisc) * (saledetaillog.discperc * .01)) + (saledetaillog.looseqty  * saledetaillog.itemflatdisc),2)), 2) + Round(Sum ( saledetaillog.looseqty   * (saledetaillog.saleprice  - saledetaillog.itemflatdisc) * (1 - (saledetaillog.discperc * .01))) * (saleledgerlog.discperc /100), 2) + saleledgerlog.flatdisc,
	difference= Sum ( saledetaillog.looseqty * saledetaillog.saleprice) - sum(Round(saledetaillog.rate,2) * saledetaillog.looseqty) ,
	itemsalestax = Sum (Round (saledetaillog.looseqty * saledetaillog.unitsalestax + Round ( Round (saledetaillog.looseqty * (saledetaillog.saleprice - saledetaillog.itemflatdisc ) * (1 - saledetaillog.discperc * 0.01 ), 2 ) * saledetaillog.gstperc * 0.01 , 2 ) , 2 ) ),
	accountfor=saleledgerlog.accountfor,
	impactinventory=saleledgerlog.impactinventory,
	NetAmt = SaleLedgerLog.InvTotal,
	CashReceived = ISNULL(saleledgerlog.Amt, 0) + ISNULL(SaleLedgerLog.CashCharged, 0),
	CreditCardCharged = ISNULL((SELECT SUM(CW.Amount) FROM CashierWindow CW WHERE CW.SaleInvCode = saleledgerlog.SaleInvCode), 0),
	SaleLedgerlog.ModifyCounter,
	saleperson = (select sm.Name from salesman sm where sm.salesmancode = max(saleledgerlog.smancode))
FROM 
	(SELECT SL.SaleInvCode 
	FROM SaleLedger SL
	WHERE SL.modifycounter > 0 AND 
		SL.Date BETWEEN :ar_StartDate and :ar_EndDate ) S,
	saleledgerlog, 
	saledetaillog,   
	accounts,
	users  
WHERE 
	( saleledgerlog.saleledgerlogid = saledetaillog.saleledgerlogid ) and 
	( saleledgerlog.saleinvcode = saledetaillog.saleinvcode ) and 
	( saleledgerlog.saleinvcode = S.SaleInvCode ) AND
	( saleledgerlog.custcode = accounts.acccode ) and  
	( saleledgerlog.salesmancode = users.usercode ) AND 
	( saleledgerlog.date between :ar_StartDate and :ar_EndDate)            
GROUP BY 
	SaleLedgerLog.SaleLedgerLogID,
	saleledgerlog.saleinvcode,   
	saleledgerlog.altersaleinvcode,
	saleledgerlog.date,   
	saleledgerlog.misccharges,   
	saleledgerlog.flatdisc,   
	saleledgerlog.discperc,  
	saleledgerlog.salestax, 
	saleledgerlog.invgstperc1 ,
	saleledgerlog.salecatcode, 
	SaleLedgerLog.InvTotal,
	saleledgerlog.posted, 
	saleledgerlog.accountfor,
	saleledgerlog.modifiedby,
	saleledgerlog.modifycounter,
	saleledgerlog.impactinventory,
	saleledgerlog.Amt,
	saleledgerlog.CashCharged,
	accounts.name,
	users.username,
	saleledgerlog.smancode
ORDER BY
	invcode,
	modifycounter
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
