table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=char(60) updatewhereclause=no name=godown dbname="godown"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=decimal(6) updatewhereclause=yes name=totaldiscount dbname="totaldiscount"  )
column=(type=long updatewhereclause=yes name=difference dbname="difference"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="accountfor"  )
column=(type=decimal(2) updatewhereclause=yes name=saleamount dbname="saleamount"  )
 retrieve="SELECT 
	invcode     = dbo.srledger.srinvcode,    
	date        = dbo.srledger.date,     
	flatdisc    = dbo.srledger.flatdisc, 
	misccharges = dbo.srledger.misccharges,
	godown		= (SELECT godown.name FROM godown WHERE godown.gcode=srdetail.gcode), 
	patient		= (SELECT name FROM patient WHERE patientcode=:ar_patientcode), 
	regno       = (SELECT regno FROM patient WHERE patientcode=:ar_patientcode), 
	invdiscperc = dbo.srledger.discperc, 
	doctype = Case dbo.srledger.srcatcode When 8 Then 'Cash' When 7 Then 'Credit' Else 'Credit' End, 
	dbo.accounts.name, 
	amount =  MAX( dbo.srledger.invtotal), 
	itemdiscpercvalue = Round(Sum (Round(( (dbo.srdetail.looseqty  * dbo.srdetail.srprice) * (dbo.srdetail.discperc * .01)) , 2) ) , 2),    
	invdiscpercvalue = Sum (Round( (dbo.srdetail.looseqty * dbo.srdetail.srprice) * (1 - (dbo.srdetail.discperc * .01)),2)) * (dbo.srledger.discperc /100) ,
	salesman = dbo.users.username ,
	totaldiscount= Round(Sum (Round(( (dbo.srdetail.looseqty  * dbo.srdetail.srprice) * (dbo.srdetail.discperc * .01)) ,2)), 2) + Round(Sum ( (dbo.srdetail.looseqty * dbo.srdetail.saleprice) * (1 - (dbo.srdetail.discperc * .01))) * (dbo.srledger.discperc /100), 2) + dbo.srledger.flatdisc,
	difference= 0, /* Sum ( dbo.srdetail.looseqty * dbo.srdetail.srprice) - sum(Round(srdetail.saleprice/ISNULL(srdetail.packunits ,1),2) * srdetail.looseqty) */
	accountfor=dbo.srledger.accountfor,
	saleamount= (select sum(A.saleamount) from 
		 (select saleamount=dbo.fn_getsaleinvtotal(saleinvcode)
		  from saleledger
			where saleledger.patientcode=:ar_patientcode AND
					saleledger.headerno = (case :ar_allheader when 'Y' then saleledger.headerno else :ar_headerno end) and
					(dbo.saleledger.salecatcode between ( CASE :ar_saletype WHEN 1 THEN 3 When 2 Then 1 When 3 Then 0 When 4 Then 1 END ) and (CASE :ar_saletype WHEN 1 THEN 3 When 2 Then 2 When 3 Then 0 When 4 Then 3 END) )  And
					saleledger.date between :ar_StartDate and :ar_EndDate) as A)
FROM 
	dbo.srledger, dbo.srdetail, dbo.accounts, dbo.users  
WHERE 
	( dbo.srledger.patientcode = :ar_patientcode ) and
	dbo.srledger.headerno = (case :ar_allheader when 'Y' then srledger.headerno else :ar_headerno end) and
	dbo.srledger.custcode = (case :ar_allcustcode when 'Y' then srledger.custcode else :ar_custcode end) and
	(dbo.srledger.srcatcode between ( CASE :ar_saletype WHEN 1 THEN 8 When 2 Then 6 When 3 Then 0 When 4 Then 6 END ) and (CASE :ar_saletype WHEN 1 THEN 8 When 2 Then 7 When 3 Then 0 When 4 Then 8 END) )  And
	( dbo.srledger.srinvcode = dbo.srdetail.srinvcode ) and  
	( dbo.srledger.custcode = dbo.accounts.acccode )and  
	( dbo.srledger.salesmancode = dbo.users.usercode )and  
	( dbo.srledger.date between :ar_StartDate and :ar_EndDate)            
GROUP BY 
	dbo.srledger.misccharges,   
	dbo.srledger.flatdisc,   
	dbo.srledger.date,   
	dbo.srledger.srinvcode,   
	dbo.srledger.discperc,  
	dbo.srledger.srcatcode, 
	dbo.srledger.accountfor,
	dbo.accounts.name,
	dbo.users.username,
	dbo.srdetail.gcode

"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ar_patientcode", number), ("ar_saletype", number), ("ar_headerno", number), ("ar_allheader", string), ("ar_custcode", number), ("ar_allcustcode", string))
 sort="godown A, invcode A, date A"
)
