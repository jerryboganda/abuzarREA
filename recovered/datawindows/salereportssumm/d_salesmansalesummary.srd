table(column=(type=long updatewhereclause=yes name=salespersoncode dbname="SalesMan.SmanCode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesMan.Salesman"  )
column=(type=decimal(2) updatewhereclause=yes name=saletarget dbname="SaleTarget"  )
column=(type=long updatewhereclause=yes name=invoices dbname="Invoices"  )
column=(type=decimal(6) updatewhereclause=yes name=invoicesvalue dbname="InvoicesValue"  )
 retrieve="SELECT
	S.SmanCode,
	SM.Name As Salesman, 
	SaleTarget=SM.SaleTarget,
	COUNT(S.saleinvcode) as Invoices,
	SUM(S.Net) AS InvoicesValue

FROM	(SELECT SL.saleinvcode,
		SL.SmanCode,
		Net=Round(
			SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
			SL.misccharges + SL.salestax - SL.flatdisc, 0)+
			Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
			SUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
			ROUND( (SUM((SD.looseqty * 
				(SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
				SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0)

	FROM    saleledger SL,	 
		saledetail SD
	WHERE   SL.Posted = 'Y' AND
		SL.date Between :ar_startdate AND :ar_enddate AND
		SL.SManCode IN (:ar_salesmancode) AND
		SL.SaleInvCode = SD.SaleInvcode
	GROUP BY SL.saleinvcode,
		 SL.SmanCode,
		 SL.discperc,
		 SL.misccharges,
		 SL.salestax,
		 SL.flatdisc,
		 SL.invgstperc1
	UNION ALL
	SELECT SL.saleinvcode,
		SL.SmanCode,
		Net=Round(
			SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
			(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
			SL.misccharges + SL.salestax - SL.flatdisc, 0)+
			Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
			SUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
			ROUND( (SUM((SD.looseqty * 
				(SD.saleprice - SD.itemflatdisc)) *
				(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
				SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0)

	FROM  saleledger SL,	saleinvdetail SD
	WHERE SL.ImpactInventory='N' AND  SL.Posted = 'Y' AND
		SL.date Between :ar_startdate AND :ar_enddate AND
		SL.SManCode IN (:ar_salesmancode) AND
		SL.SaleInvCode = SD.SaleInvcode
	GROUP BY SL.saleinvcode,
		 SL.SmanCode,
		 SL.discperc,
		 SL.misccharges,
		 SL.salestax,
		 SL.flatdisc,
		 SL.invgstperc1) S, SalesMan SM

WHERE
	SM.SalesManCode IN (:ar_salesmancode) AND
	S.SmanCode = SM.SalesmanCode
GROUP BY
	S.SmanCode,
	SM.Name,
	SM.SaleTarget
ORDER BY
	SM.Name"
  arguments=(("ar_salesmancode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
