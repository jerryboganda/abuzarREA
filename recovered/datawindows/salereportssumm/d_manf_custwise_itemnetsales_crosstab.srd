release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=26 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1218 color="536870912" )
header[2](height=343 color="536870912" )
summary(height=197 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=char(20) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(20) updatewhereclause=yes name=area dbname="area"  )
column=(type=char(20) updatewhereclause=yes name=peiod dbname="peiod"  )
column=(type=number updatewhereclause=yes name=qty dbname="qty"  )
 retrieve="SELECT 
	Area=A.Name,
	CustomerName = AC.Name,
	Address = C.Address1,
	Peiod = LTRIM(RTRIM(CONVERT(VARCHAR(100), :adt_startdate, 103))) + ' - ' + LTRIM(RTRIM(CONVERT(VARCHAR(100), :adt_enddate, 103))),
	ICode=I.ICode,
	ItemName=I.ShortName,
	Qty = SUM(T.Qty + CASE WHEN :ai_bonus = 1 THEN T.BonusQty ELSE 0 END)
FROM
	(SELECT II.ICode, II.Name, II.ShortName, II.ManfCode FROM Item II WHERE II.ManfCode = :ai_ManfCode) AS I, 
	Area A,
	Accounts AC,
	Customer C,
	(SELECT 
		C.CustCode,
		I.ICode,
		Qty = SUM(D.LooseQty),
		BonusQty = SUM(D.BonusQty)
	FROM 
		SaleLedger S, SaleDetail D, 
		(SELECT II.ICode FROM Item II WHERE II.ManfCode = :ai_ManfCode) AS I, 
		(SELECT CC.CustCode, CC.AreaCode 
		FROM Area AA, Customer CC
		WHERE AA.AreaCode IN (:ai_areacode) AND AA.AreaCode = CC.AreaCode) C
	WHERE
		C.CustCode = S.CustCode AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.Posted = 'Y' AND S.SaleInvCode = D.SaleInvCode AND
		D.ICode = I.ICode
	GROUP BY
		C.AreaCode,
		C.CustCode,
		I.ICode
	UNION ALL
	SELECT 
		C.CustCode,
		I.ICode,
		Qty = SUM(D.LooseQty),
		BonusQty = SUM(D.BonusQty)
	FROM 
		SaleLedger S, SaleInvDetail D, 
		(SELECT II.ICode FROM Item II WHERE II.ManfCode = :ai_ManfCode) AS I, 
		(SELECT CC.CustCode, CC.AreaCode 
		FROM Area AA, Customer CC
		WHERE AA.AreaCode IN (:ai_areacode) AND AA.AreaCode = CC.AreaCode) C
	WHERE
		C.CustCode = S.CustCode AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.Posted = 'Y' AND S.SaleInvCode = D.SaleInvCode AND
		D.ICode = I.ICode
	GROUP BY
		C.CustCode,
		I.ICode
	UNION ALL
	SELECT 
		C.CustCode,
		I.ICode,
		Qty = -SUM(D.LooseQty),
		BonusQty = - SUM(D.BonusQty)
	FROM 
		SRLedger S, SRDetail D, 
		(SELECT II.ICode FROM Item II WHERE II.ManfCode = :ai_ManfCode) AS I, 
		(SELECT CC.CustCode, CC.AreaCode 
		FROM Area AA, Customer CC
		WHERE AA.AreaCode IN (:ai_areacode) AND AA.AreaCode = CC.AreaCode) C
	WHERE
		C.CustCode = S.CustCode AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.Posted = 'Y' AND S.SRInvCode = D.SRInvCode AND
		D.ICode = I.ICode
	GROUP BY
		C.CustCode,
		I.ICode) T
WHERE 
	T.ICode = I.ICode AND
	T.CustCode = C.CustCode AND
	C.AreaCode = A.AreaCode AND
	C.CustCode = AC.AccCode
GROUP BY
	A.Name,
	AC.Name,
	C.Address1,
	I.ICode,
	I.ShortName
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_manfcode", number), ("ai_areacode", numberlist), ("ai_bonus", number))
 sort="area A, customername A"
)
