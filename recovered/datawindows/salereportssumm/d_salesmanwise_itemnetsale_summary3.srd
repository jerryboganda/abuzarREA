table(column=(type=long updatewhereclause=yes name=salespersoncode dbname="SalesPersonCode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="SoldQty"  )
column=(type=decimal(6) updatewhereclause=yes name=salesvalue dbname="SalesValue"  )
column=(type=decimal(6) updatewhereclause=yes name=avgsaleprice dbname="AvgSalePrice"  )
column=(type=decimal(4) updatewhereclause=yes name=retqty dbname="RetQty"  )
column=(type=decimal(6) updatewhereclause=yes name=retvalue dbname="RetValue"  )
column=(type=decimal(6) updatewhereclause=yes name=avgretprice dbname="AvgRetPrice"  )
column=(type=decimal(4) updatewhereclause=yes name=netsaleqty dbname="NetSaleQty"  )
column=(type=decimal(6) updatewhereclause=yes name=netsalevalue dbname="NetSaleValue"  )
column=(type=decimal(6) updatewhereclause=yes name=weight dbname="Weight"  )
 retrieve="SELECT
	SalesPersonCode=S.SManCode,
	SalesPerson=SM.Name,
	ICode=I.ICode,
	AliasName=I.CustomICode, 
	ItemName=I.Name,
	ItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = I.ICatCode),
	SoldQty = SUM(S.SoldQty),
	SalesValue = SUM(SalesValue),
	AvgSalePrice = Round(SUM(SalesValue) / CASE WHEN SUM(S.SoldQty) IS NULL THEN 1 WHEN SUM(S.SoldQty) = 0 THEN 1 ELSE SUM(S.SoldQty) END, 2), 
	RetQty = SUM(S.RetQty),
	RetValue = SUM(RetValue),
	AvgRetPrice = Round(SUM(RetValue) / CASE WHEN SUM(S.RetQty) IS NULL THEN 1 WHEN SUM(S.RetQty) = 0 THEN 1 ELSE SUM(S.RetQty) END, 2),
	NetSaleQty = SUM(S.SoldQty - S.RetQty),
	NetSaleValue = SUM(SalesValue - RetValue),
	Weight = SUM((S.SoldQty - S.RetQty) * I.UnitWeight)
FROM
	Item I,
	SalesMan SM,
	(SELECT
		SL.SManCode,
		SD.ICode,
		SoldQty = SUM(SD.LooseQty),
		SalesValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ),
		RetQty = 0.0000,
		RetValue = 0.00
	FROM
		SaleLedger SL, SaleDetail SD
	WHERE
		SL.Date >= :ad_startdate AND
		SL.Date <= :ad_enddate AND
		SL.SManCode IN (:ai_smancode) AND
		SL.SaleInvCode = SD.SaleInvCode
	GROUP BY 
		SL.SManCode,
		SD.ICode
	UNION ALL
	SELECT
		SL.SManCode,
		SD.ICode,
		SoldQty = SUM(SD.LooseQty),
		SalesValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ),
		RetQty = 0.0000,
		RetValue = 0.00
	FROM
		SaleLedger SL, SaleInvDetail SD
	WHERE
		SL.ImpactInventory = 'N' AND
		SL.Date >= :ad_startdate AND
		SL.Date <= :ad_enddate AND
		SL.SManCode IN (:ai_smancode) AND
		SL.SaleInvCode = SD.SaleInvCode
	GROUP BY 
		SL.SManCode,
		SD.ICode
	UNION ALL
	SELECT
		SL.SManCode,
		SD.ICode,
		SoldQty = 0.0000,
		SalesValue = 0.00,
		RetQty = SUM(SD.LooseQty),
		RetValue = SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) )
	FROM
		SRLedger SL, SRDetail SD
	WHERE
		SL.Date >= :ad_startdate AND
		SL.Date <= :ad_enddate AND
		SL.SManCode IN (:ai_smancode) AND
		SL.SRInvCode = SD.SRInvCode
	GROUP BY 
		SL.SManCode,
		SD.ICode) S
WHERE
	I.ICode = S.ICode AND
	S.SManCode = SM.SalesManCode
GROUP BY
	S.SManCode,
	SM.Name,
	I.ICatCode,
	I.ICode,
	I.CustomICode,
	I.Name
ORDER BY
	SM.Name,
	NetSaleQty DESC,
	ItemName
"
  arguments=(("ai_smancode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
