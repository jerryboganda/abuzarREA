table(column=(type=char(13) updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=char(8) updatewhereclause=yes name=maintype dbname="MainType"  )
column=(type=char(14) updatewhereclause=yes name=type dbname="Type"  )
column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="netamount"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="accountfor"  )
column=(type=char(1) updatewhereclause=yes name=impactinventory dbname="impactinventory"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
 retrieve="SELECT 
	DocumentCode= 'SV-' + LTRIM(RTRIM(STR(dbo.saleledger.saleinvcode, 10))),
	MainType = 'Sales',
	Type = 'Sales',
	invcode     = dbo.saleledger.saleinvcode,    
	date        = dbo.saleledger.date,    
	doctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name, 
	netamount =  ISNULL(saleledger.invtotal, 0),    
	salesman = dbo.users.username ,
	remarks=saleledger.remarks ,
	accountfor=dbo.saleledger.accountfor,
	impactinventory=dbo.saleledger.impactinventory,
	saleinvcode= NULL,
	regno = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = SaleLedger.PatientCode),
	patientname = (SELECT P.Name FROM Patient P WHERE P.PatientCode = SaleLedger.PatientCode)
FROM 
	dbo.saleledger, 
	dbo.accounts,
	dbo.users  
WHERE 
	( dbo.saleledger.Date between :adt_startdate and :adt_enddate) and
	( dbo.saleledger.custcode = dbo.accounts.acccode )and  
	( dbo.saleledger.salesmancode = dbo.users.usercode )  
UNION ALL
SELECT 
	DocumentCode= 'SV-' + LTRIM(RTRIM(STR(dbo.saleledger.saleinvcode, 10))),
	MainType = 'Sales',
	Type = 'Sales',
	invcode     = dbo.saleledger.saleinvcode,    
	date        = dbo.saleledger.date,    
	doctype = Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name, 
	netamount =  ISNULL(saleledger.invtotal, 0),    
	salesman = dbo.users.username ,
	remarks=saleledger.remarks ,
	accountfor=dbo.saleledger.accountfor,
	impactinventory=dbo.saleledger.impactinventory,
	saleinvcode= NULL,
	regno = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = SaleLedger.PatientCode),
	patientname = (SELECT P.Name FROM Patient P WHERE P.PatientCode = SaleLedger.PatientCode)
FROM 
	dbo.saleledger, 
	dbo.accounts,
	dbo.users  
WHERE 
	( DBO.SaleLedger.impactinventory = 'N' ) AND 
	( dbo.saleledger.Date between :adt_startdate and :adt_enddate) and
	( dbo.saleledger.custcode = dbo.accounts.acccode )and  
	( dbo.saleledger.salesmancode = dbo.users.usercode )  
UNION ALL
SELECT 
	DocumentCode= 'SR-' + LTRIM(RTRIM(STR(dbo.srledger.srinvcode, 10))),
	MainType = 'Sales',
	TYPE = 'Sales Return',
	invcode     = dbo.srledger.srinvcode,    
	date        = dbo.srledger.date,    
	doctype = Case dbo.srledger.srcatcode When 6 Then 'Cash' When 7 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name, 
	netamount =  - ISNULL(srledger.invtotal, 0),    
	salesman = dbo.users.username ,
	remarks=srledger.remarks ,
	accountfor=dbo.srledger.accountfor,
	impactinventory='N',
	saleinvcode= dbo.srledger.saleinvcode,
	regno = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = SrLedger.PatientCode),
	patientname = (SELECT P.Name FROM Patient P WHERE P.PatientCode = SrLedger.PatientCode)
FROM 
	dbo.srledger, 
	dbo.accounts,
	users  
WHERE 
	( dbo.srledger.Date between :adt_startdate and :adt_enddate) and
	( dbo.srledger.custcode = dbo.accounts.acccode )and 
	( dbo.srledger.salesmancode=users.usercode)           
UNION ALL
SELECT 
	DocumentCode= 'RS-' + LTRIM(RTRIM(STR(dbo.serviceheader.serviceinvcode, 10))),
	MainType = 'Services',
	TYPE = 'Service',
	invcode     = dbo.serviceheader.serviceinvcode, 
	date        = dbo.serviceheader.date, 
	doctype = Case dbo.serviceheader.servicecatcode When 10 Then 'Cash' When 11 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name,
	netamount =  ISNULL(serviceheader.invtotal, 0),    
	salesman = dbo.users.username,
	remarks=serviceheader.remarks,
	accountfor='Y',
	impactinventory='Y',
	saleinvcode= dbo.serviceheader.saleinvcode,
	regno = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = ServiceHeader.PatientCode),
	patientname = (SELECT P.Name FROM Patient P WHERE P.PatientCode = ServiceHeader.PatientCode)
FROM 
	dbo.serviceheader, 
	dbo.accounts,
	dbo.users  
WHERE 
	( dbo.serviceheader.date between :adt_StartDate and :adt_EndDate) AND 
	( dbo.serviceheader.custcode = dbo.accounts.acccode ) and  
	( dbo.serviceheader.salesmancode = dbo.users.usercode )
UNION ALL
SELECT 
	DocumentCode= 'RR-' + LTRIM(RTRIM(STR(dbo.serviceRheader.serviceRinvcode, 10))),
	MainType = 'Services',
	TYPE = 'Service Return',
	invcode     = dbo.serviceRheader.serviceRinvcode, 
	date        = dbo.serviceRheader.date, 
	doctype = Case dbo.serviceRheader.serviceRcatcode When 13 Then 'Cash' When 14 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name,
	netamount =  - ISNULL(servicerheader.invtotal, 0),    
	salesman = dbo.users.username,
	remarks=serviceRheader.remarks,
	accountfor='Y',
	impactinventory='Y',
	saleinvcode= dbo.serviceRheader.serviceinvcode,
	regno = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = ServiceRHeader.PatientCode),
	patientname = (SELECT P.Name FROM Patient P WHERE P.PatientCode = ServiceRHeader.PatientCode)
FROM 
	dbo.serviceRheader, 
	dbo.accounts,
	dbo.users  
WHERE 
	( dbo.serviceRheader.date between :adt_StartDate and :adt_EndDate) AND 
	( dbo.serviceRheader.custcode = dbo.accounts.acccode ) and  
	( dbo.serviceRheader.salesmancode = dbo.users.usercode )"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="maintype A, date A, type A, invcode A"
)
