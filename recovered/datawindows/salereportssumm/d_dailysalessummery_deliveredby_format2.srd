table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="usercode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(60) updatewhereclause=yes name=saletype dbname="saletype"  )
column=(type=char(60) updatewhereclause=yes name=deliveredby dbname="deliveredBy"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="invtotal"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="custalias"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="accountfor"  )
column=(type=char(1) updatewhereclause=yes name=impactinventory dbname="impactinventory"  )
 retrieve="SELECT 
	invcode = dbo.saleledger.saleinvcode,    
	date = dbo.saleledger.date, 
	usercode=saleledger.salesmancode,   
	remarks = dbo.saleledger.remarks,
	saletype = ( Select Name From SaleType Where SaleTypeCode = SaleLedger.SaleTypeCode),
	deliveredBy = ( Select Name From SalesMan Where SalesManCode = SaleLedger.DeliveredBy),
		doctype 	= Case dbo.saleledger.salecatcode When 1 Then 'Cash' When 2 Then 'Credit' Else 'Cash' End, 
	invtotal = dbo.fn_getsaleinvtotal(dbo.saleledger.saleinvcode),
	dbo.accounts.name,
	custalias=accounts.aliasname,
	accountfor=dbo.saleledger.accountfor,
	impactinventory=dbo.saleledger.impactinventory
FROM 	
	dbo.saleledger, dbo.accounts, dbo.users  
WHERE 
	( dbo.saleledger.saleinvcode between :ar_sinvcode and :ar_linvcode)  And
	( dbo.saleledger.posted IN (:aa_posted) ) AND
	( dbo.saleledger.deliveredby In (:ai_deliveredby) ) And
	( dbo.saleledger.custcode = dbo.accounts.acccode ) and  
	( dbo.saleledger.salesmancode = dbo.users.usercode )

Order By deliveredby,
			invcode



"
  arguments=(("ar_Sinvcode", number), ("ar_linvcode", number), ("ai_deliveredby", numberlist), ("aa_posted", stringlist))
)
