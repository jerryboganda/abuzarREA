release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=628 color="536870912" )
summary(height=4 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=manf dbname="Manf"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="supplier"  )
column=(type=long updatewhereclause=yes name=days dbname="days"  )
column=(type=long updatewhereclause=yes name=totaldays dbname="totaldays"  )
column=(type=decimal(2) updatewhereclause=yes name=packprice dbname="packprice"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="unitprice"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(6) updatewhereclause=yes name=stockval dbname="stockval"  )
column=(type=decimal(4) updatewhereclause=yes name=netsale dbname="netsale"  )
column=(type=decimal(6) updatewhereclause=yes name=perdayconsumption dbname="perdayconsumption"  )
 retrieve="SELECT itemcode=I.icode,
			itemname=I.name, 
			Manf=(select name from manufacturer M where M.manfcode=I.manfcode),
			/*supplier=(select suppcode=min(suppcode) from 	itemsuppliers ,
									( select prority=min(priority) from itemsuppliers  Where itemsuppliers.icode=I.icode) as b
								 where itemsuppliers.icode=I.icode and itemsuppliers.priority=b.prority) ,
			*/
			supplier=(select name from accounts where accounts.acccode=max(S.suppcode)),
			days=max(S.days),
			totaldays=DateDiff(d,:ad_startdate,:ad_enddate),
			packprice=I.purprice,
			packunits=I.packunits,
			unitprice=I.purprice/(case I.packunits when 0 then 1 else I.packunits end),
			stock=ISNULL((select isnull(sum(currqty),0) from godowndetail GD where GD.icode=I.icode group by GD.icode),0),
			stockval=	(select isnull(sum(currqty),0) from godowndetail GD where GD.icode=I.icode group by GD.icode)
							*
							(I.purprice/(case I.packunits when 0 then 1 else I.packunits end)) ,
		
			netsale= isnull(sum(A.qty),0),
			perdayconsumption=isnull(sum(A.qty),0)/ (case DateDiff(d,:ad_startdate,:ad_enddate) when 0 then 1 else DateDiff(d,:ad_startdate,:ad_enddate) end)
	

FROM 	Item I,
			(select SD.icode,qty=ISNULL(sum(SD.looseqty),0) from saleledger SL, saledetail SD, item where SL.date>=:ad_StartDate and SL.date<=:ad_EndDate and SL.saleinvcode=SD.saleinvcode and item.icode=SD.icode and item.manfcode IN (:aa_manfcode) group by SD.icode
				union All
				select SD.icode,qty= - ISNULL(sum(SD.looseqty),0) from srledger SL, srdetail SD, item where SL.date>=:ad_StartDate and SL.date<=:ad_EndDate and SL.srinvcode=SD.srinvcode and item.icode=SD.icode and item.manfcode IN (:aa_manfcode) group by SD.icode
			) AS A,
		
			(select P.icode,suppcode,days from  itemsuppliers,
					(select priority=min(priority),icode from itemsuppliers 
					group by icode ) as P
		
			where itemsuppliers.icode=P.icode and
				itemsuppliers.priority=P.priority
			
			union all
			
			select icode,null,0 from item where icode not in (select distinct(icode) from itemsuppliers)
			
			)AS S


WHERE 	I.manfcode IN (:aa_manfcode) AND
			I.icode=A.icode AND
			I.icode=S.icode
	
GROUP BY 	I.icode,
				I.name,
				I.purprice,
				I.packunits,
				I.manfcode
		
		
ORDER BY  I.icode"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("aa_manfcode", numberlist))
)
