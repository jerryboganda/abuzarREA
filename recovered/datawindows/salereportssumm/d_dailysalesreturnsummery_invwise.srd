table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=purledger_date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(60) updatewhereclause=yes name=users dbname="Users"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsalestax dbname="itemsalestax"  )
column=(type=char(1) updatewhereclause=yes name=accountfor dbname="accountfor"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
 retrieve="SELECT 
	invcode     = h.srinvcode,     
	date        = h.date,    
	flatdisc    = h.flatdisc, 
	salestax    = h.salestax,       
	misccharges = h.misccharges, 
	invdiscperc = h.discperc, 
	invgstperc1 = h.invgstperc1, 
	doctype = Case h.srcatcode When 6 Then 'Cash' When 7 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name, 
	amount =  Round(Sum ( d.looseqty * d.srprice), 2),    
	itemdiscpercvalue = Round(Sum ( d.looseqty  * d.srprice * (d.discperc * .01)), 2),    
	invdiscpercvalue = Sum (Round( (d.looseqty  ) * d.srprice * (1 - (d.discperc * .01)),2)) * (h.discperc /100)     ,
	saleinvcode= h.saleinvcode,
	remarks=h.remarks,
	Users=max(users.username),
	itemsalestax = Sum (Round ( (d.looseqty + d.bonusqty) * d.unitsalestax + Round ( Round ( d.looseqty * d.srprice * (1 - d.discperc * 0.01 ), 2 ) * d.gstperc * 0.01 , 2 ) , 2 ) ),
	accountfor=h.accountfor,
	posted=h.posted
FROM 
	dbo.srledger h, 
	dbo.srdetail d,   
	dbo.accounts,
	users  
WHERE 
	( h.srinvcode between :ar_StartInv and :ar_EndInv) and
	( h.srcatcode IN (:ai_retail,:ai_cash,:ai_credit) )and
	( h.srinvcode = d.srinvcode ) and  
	( h.custcode = dbo.accounts.acccode )and 
	( h.salesmancode=users.usercode)           
GROUP BY 
	h.misccharges,   
	h.flatdisc,   
	h.date,   
	h.srinvcode,   
	h.discperc,  
	h.salestax, 
	h.srcatcode, 
	h.invgstperc1,
	h.accountfor,
	dbo.accounts.name ,
	h.saleinvcode ,   
	h.remarks,
	h.posted
UNION
SELECT 
	invcode     = h.srbufferinvcode,    
	date        = h.date,    
	flatdisc    = h.flatdisc, 
	salestax    = h.salestax,       
	misccharges = h.misccharges, 
	invdiscperc = h.discperc, 
	invgstperc1 = h.invgstperc1, 
	doctype = Case h.srcatcode When 6 Then 'Cash' When 7 Then 'Credit' Else 'Cash' End, 
	dbo.accounts.name, 
	amount =  Round(Sum ( d.looseqty * d.srprice), 2),    
	itemdiscpercvalue = Round(Sum ( d.looseqty  * d.srprice * (d.discperc * .01)), 2),    
	invdiscpercvalue = Sum (Round( (d.looseqty  ) * d.srprice * (1 - (d.discperc * .01)),2)) * (h.discperc /100)     ,
	saleinvcode= h.saleinvcode,
	remarks=h.remarks,
	Users=max(users.username),
	itemsalestax = Sum (Round ( (d.looseqty + d.bonusqty) * d.unitsalestax + Round ( Round ( d.looseqty * d.srprice * (1 - d.discperc * 0.01 ), 2 ) * d.gstperc * 0.01 , 2 ) , 2 ) ),
	accountfor=h.accountfor,
	posted=h.posted
FROM 
	dbo.srbufferledger h, 
	dbo.srbufferdetail d,   
	dbo.accounts,
	users  
WHERE 
	( h.posted = 'N' ) AND
	( h.srbufferinvcode between :ar_StartInv and :ar_EndInv) and
	( h.srcatcode IN (:ai_retail,:ai_cash,:ai_credit) )and
	( h.srbufferinvcode = d.srbufferinvcode ) and  
	( h.custcode = dbo.accounts.acccode )and 
	( h.salesmancode=users.usercode)           
GROUP BY 
	h.misccharges,   
	h.flatdisc,   
	h.date,   
	h.srbufferinvcode,   
	h.discperc,  
	h.salestax, 
	h.srcatcode, 
	h.invgstperc1,
	h.accountfor,
	dbo.accounts.name ,
	h.saleinvcode ,   
	h.remarks,
	h.posted
ORDER BY 
	invcode ASC,   
	date ASC   

"
  arguments=(("ar_StartInv", number), ("ar_EndINv", number), ("ai_retail", number), ("ai_cash", number), ("ai_credit", number))
)
