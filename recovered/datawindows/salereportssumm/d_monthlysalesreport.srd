release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=1090519039 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=1 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1041 color="536870912" )
header[2](height=354 color="536870912" )
header[3](height=0 color="536870912" )
summary(height=197 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=name1 dbname="name1"  )
column=(type=char(20) updatewhereclause=yes name=name2 dbname="name2"  )
column=(type=char(20) updatewhereclause=yes name=name3 dbname="name3"  )
column=(type=number updatewhereclause=yes name=value2 dbname="value2"  )
column=(type=number updatewhereclause=yes name=value3 dbname="value3"  )
 retrieve="SELECT ReportData.code1,   
         ReportData.code2,   
         ReportData.value1,   
         ReportData.value2,   
         ReportData.value3,   
         ReportData.date1,   
         ReportData.name1,   
         ReportData.name2,   
         ReportData.name3,   
         ReportData.name4  
FROM ReportData   
WHERE code1 in (:ar_icatcode)
ORDER BY name1, name2, name3
"
  arguments=(("ar_icatcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_customer", string))
 sort="name1 A, name2 A, name3 A"
)
group(level=1 header.height=187 trailer.height=197 by=("name1"  ) header.color="536870912" trailer.color="536870912" )
compute(name=compute_4 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" x="4750" y="52" height="166" width="1937" format="[GENERAL]" expression="'Page ' + page() + ':' + pageAcross() + ' of ' + pageCount() + ':' + pageCountAcross()" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
