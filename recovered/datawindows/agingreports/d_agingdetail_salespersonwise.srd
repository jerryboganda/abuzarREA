table(column=(type=char(100) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=char(100) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(100) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=doccode dbname="DocCode"  )
column=(type=decimal(4) updatewhereclause=yes name=age dbname="Age"  )
column=(type=decimal(4) updatewhereclause=yes name=agegroup dbname="AgeGroup"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=decimal(2) updatewhereclause=yes name=paid dbname="Paid"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=datetime updatewhereclause=yes name=lastpaymentdate dbname="LastPaymentDate"  )
 retrieve="SELECT 
	SalesPerson = Name7,
	AliasName=name1,
	AccountName=name2, 
	Date=Date1, 
	DocCode=name3, 
	Age=code2,
	AgeGroup=code3,
	Amount=Value1,
	Paid=Value2,
	Balance=Value3,
	Remarks=Name4,
	LastPaymentDate=Date2
FROM 
	Reportdata 
ORDER BY
	SalesPerson, AccountName, AliasName, Date, Age Desc, AgeGroup
"
  arguments=(("ad_date", datetime), ("ai_interval", number), ("ai_limit", number), ("ai_code", number))
 sort="salesperson A, accountname A, aliasname A, date A, age D, agegroup A"
)
