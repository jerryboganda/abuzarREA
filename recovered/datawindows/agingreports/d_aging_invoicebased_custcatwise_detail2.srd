table(column=(type=char(30) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=datetime updatewhereclause=yes name=invdate dbname="InvDate"  )
column=(type=char(100) updatewhereclause=yes name=refno dbname="RefNo"  )
column=(type=char(60) updatewhereclause=yes name=saleperson dbname="SalePerson"  )
column=(type=long updatewhereclause=yes name=invoiceno dbname="InvoiceNo"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="OutStandingAmt"  )
column=(type=long updatewhereclause=yes name=invoiceage dbname="InvoiceAge"  )
column=(type=long updatewhereclause=yes name=lowerlimit dbname="LowerLimit"  )
column=(type=long updatewhereclause=yes name=upperlimit dbname="UpperLimit"  )
 retrieve="SELECT 
	Category=CC.Name,
	AliasName=A.AliasName,
	Customer=A.Name,
	InvDate = S.Date,
	RefNo= S.CustRefNo,
	SalePerson = (SELECT SM.Name FROM Salesman SM WHERE SM.SalesmanCode=S.SManCode),
	InvoiceNo=S.SaleInvCode, 
	InvTotal = S.InvTotal,
	OutStandingAmt=S.OutStandingAmt, 
	InvoiceAge=DATEDIFF(day, S.date, GETDATE()), 
	LowerLimit = (SELECT MAX(AID.Limit) 
		FROM AgingIntervalDetail AID
		WHERE AID.AgingIntervalCode=:ai_aginginterval AND DATEDIFF(day, S.date, GETDATE()) >= limit),
	UpperLimit=
		(SELECT MIN(AID2.Limit) - 1
		FROM AgingIntervalDetail AID2
		WHERE AID2.AgingIntervalCode=:ai_aginginterval AND AID2.LIMIT >
			(SELECT L=MAX(AID.Limit) 
			FROM AgingIntervalDetail AID
			WHERE AID.AgingIntervalCode=:ai_aginginterval AND DATEDIFF(day, S.date, GETDATE()) >= limit))
FROM 
	SaleLedger S, Customer C, CustomerCategory CC, Accounts A
WHERE
	S.SaleCatCode IN (2) AND S.Posted='Y' AND S.Marked ='N' AND 
	S.CustCode=C.CustCode AND C.CustCode = A.AccCode AND 
	C.CustCatCode = CC.CustCatCode AND
	C.CustCatCode IN (:ai_custcatcode) AND
	DATEDIFF(day, S.date, GETDATE()) BETWEEN :ai_from_interval AND :ai_to_interval"
  arguments=(("ai_custcatcode", numberlist), ("ai_aginginterval", number), ("ai_from_interval", number), ("ai_to_interval", number))
 sort="category A, customer A, invoiceage D, invoiceno A"
)
