footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=decimal(4) updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(100) updatewhereclause=yes name=areaname dbname="AreaName"  )
column=(type=char(100) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(100) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(100) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=decimal(2) updatewhereclause=yes name=duebalance dbname="DueBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=totalbalance dbname="TotalBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=collection dbname="Collection"  )
column=(type=decimal(2) updatewhereclause=yes name=epivalue dbname="EPIValue"  )
 retrieve="SELECT
	AreaCode = Code1,
	AreaName = Name1,
	AliasName = Name2,
	AccountName = Name3,
	Address = Name4,
	Phone = Name5,
	DueBalance = Value1,
	TotalBalance = Value2,
	Collection = Value3,
	EPIValue = Value4
FROM 
	ReportData

ORDER BY
	AreaName,
	AccountName
"
  arguments=(("ai_areacode", number), ("ai_agelimt", number), ("ai_EPIPerc", number), ("ad_agedate", datetime), ("ad_collectionStartDate", datetime), ("ad_collectionEndDate", datetime))
 sort="areaname A, accountname A"
)
