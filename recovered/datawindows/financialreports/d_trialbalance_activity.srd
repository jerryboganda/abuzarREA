table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=title dbname="Name1"  )
column=(type=char(60) updatewhereclause=yes name=type dbname="Name2"  )
column=(type=decimal(2) updatewhereclause=yes name=opening dbname="Opening"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Value1"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Value2"  )
column=(type=decimal(2) updatewhereclause=yes name=closing dbname="Closing"  )
 retrieve="SELECT  
	AliasName = CASE :ar_tbcontent When 'Accounts' Then (SELECT AC.AliasName FROM Accounts AC WHERE AC.Name =  T.Name1) ELSE NULL END,
	Name1,
	Name2,
	Opening = ISNULL(SUM(Opening), 0),
	Value1 = ISNULL(SUM(Value1), 0),
	Value2 = ISNULL(SUM(Value2), 0),
	Closing = ISNULL(SUM(Closing), 0)
FROM
	(SELECT 
			name1 = Case :ar_tbcontent 
							When 'MainAccounts' Then M.Name
							When 'SubAccounts' Then S.Name
							When 'Accounts' Then A.Name
							Else C.Name
						END, 
			name2 = Case :ar_tbcontent 
							When 'MainAccounts' Then ''
							When 'SubAccounts' Then C.Name
							When 'Accounts' Then S.Name
							Else M.Name
						END,
			Opening = 0.00,
			value1 = 0.00,
			value2 = 0.00,
			Closing = 0.00
	FROM 
		  Accounts A,
		  SubAccounts S, 
		  CategoryAccounts C,
		  MainAccounts M
	WHERE 
			A.SubCode = S.SubAccCode AND
			S.CatAccCode = C.CatAccCode AND
			C.MainAccCode = M.MainAccCode
	GROUP BY 
			 Case :ar_tbcontent 
				When 'MainAccounts' Then M.Name
				When 'SubAccounts' Then S.Name
				When 'Accounts' Then A.Name
				Else C.Name
			 END,
			 Case :ar_tbcontent 
				When 'MainAccounts' Then ''
				When 'SubAccounts' Then C.Name
				When 'Accounts' Then S.Name
				Else M.Name
			 END
	UNION ALL
	SELECT 
			name1 = Case :ar_tbcontent 
							When 'MainAccounts' Then M.Name
							When 'SubAccounts' Then S.Name
							When 'Accounts' Then A.Name
							Else C.Name
						END, 
			name2 = Case :ar_tbcontent 
							When 'MainAccounts' Then ''
							When 'SubAccounts' Then C.Name
							When 'Accounts' Then S.Name
							Else M.Name
						END,
			Opening = ISNULL(SUM(V.Debit - Credit), 0),
			value1 = 0,
			value2 = 0,
			Closing = 0
	FROM VirtualGL V,
		  Accounts A,
		  SubAccounts S, 
		  CategoryAccounts C,
		  MainAccounts M
	WHERE 
			V.Date < :ar_startdate AND 
			V.AccCode = A.AccCode AND 
			A.SubCode = S.SubAccCode AND
			S.CatAccCode = C.CatAccCode AND
			C.MainAccCode = M.MainAccCode
	GROUP BY 
			 Case :ar_tbcontent 
				When 'MainAccounts' Then M.Name
				When 'SubAccounts' Then S.Name
				When 'Accounts' Then A.Name
				Else C.Name
			 END,
			 Case :ar_tbcontent 
				When 'MainAccounts' Then ''
				When 'SubAccounts' Then C.Name
				When 'Accounts' Then S.Name
				Else M.Name
			 END
	UNION ALL
	SELECT 
			name1 = Case :ar_tbcontent 
							When 'MainAccounts' Then M.Name
							When 'SubAccounts' Then S.Name
							When 'Accounts' Then A.Name
							Else C.Name
						END, 
			name2 = Case :ar_tbcontent 
							When 'MainAccounts' Then ''
							When 'SubAccounts' Then C.Name
							When 'Accounts' Then S.Name
							Else M.Name
						END,
			Opening = 0.00,
			value1 = Case :ar_tbtype 
							When 'Balance' Then Sum(Debit - Credit)
							Else Sum(Debit)
						END,
			value2 = Case :ar_tbtype 
							When 'Balance' Then Sum(Debit - Credit)
							Else -Sum(Credit)
						END,
			Closing = 0.00
	FROM VirtualGL V,
		  Accounts A,
		  SubAccounts S, 
		  CategoryAccounts C,
		  MainAccounts M
	WHERE 
			V.Date >= :ar_startdate 	AND 
			V.Date <= :ar_enddate AND
			V.AccCode = A.AccCode AND 
			A.SubCode = S.SubAccCode AND
			S.CatAccCode = C.CatAccCode AND
			C.MainAccCode = M.MainAccCode
	GROUP BY 
			 Case :ar_tbcontent 
				When 'MainAccounts' Then M.Name
				When 'SubAccounts' Then S.Name
				When 'Accounts' Then A.Name
				Else C.Name
			 END,
			 Case :ar_tbcontent 
				When 'MainAccounts' Then ''
				When 'SubAccounts' Then C.Name
				When 'Accounts' Then S.Name
				Else M.Name
			 END
	UNION ALL
	SELECT 
			name1 = Case :ar_tbcontent 
							When 'MainAccounts' Then M.Name
							When 'SubAccounts' Then S.Name
							When 'Accounts' Then A.Name
							Else C.Name
						END, 
			name2 = Case :ar_tbcontent 
							When 'MainAccounts' Then ''
							When 'SubAccounts' Then C.Name
							When 'Accounts' Then S.Name
							Else M.Name
						END,
			Opening = 0.00,
			value1 = 0.00,
			value2 = 0.00,
			Closing = ISNULL(SUM(V.Debit - Credit), 0)
	FROM VirtualGL V,
		  Accounts A,
		  SubAccounts S, 
		  CategoryAccounts C,
		  MainAccounts M
	WHERE 
			V.Date <= :ar_enddate AND 
			V.AccCode = A.AccCode AND 
			A.SubCode = S.SubAccCode AND
			S.CatAccCode = C.CatAccCode AND
			C.MainAccCode = M.MainAccCode
	GROUP BY 
			 Case :ar_tbcontent 
				When 'MainAccounts' Then M.Name
				When 'SubAccounts' Then S.Name
				When 'Accounts' Then A.Name
				Else C.Name
			 END,
			 Case :ar_tbcontent 
				When 'MainAccounts' Then ''
				When 'SubAccounts' Then C.Name
				When 'Accounts' Then S.Name
				Else M.Name
			 END) T
GROUP BY
	Name1,
	Name2 
ORDER BY 
	Name2, 
	Name1
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_tbtype", string), ("ar_tbcontent", string))
 sort="type A, title A, debit A, credit A"
)
