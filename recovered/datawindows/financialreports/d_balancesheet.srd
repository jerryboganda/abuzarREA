release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1666 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=long updatewhereclause=yes name=portion dbname="Portion"  )
column=(type=decimal(0) updatewhereclause=yes name=mainacccode dbname="MainAccCode"  )
column=(type=char(60) updatewhereclause=yes name=accounttype dbname="AccountType"  )
column=(type=decimal(0) updatewhereclause=yes name=catacccode dbname="CatAccCode"  )
column=(type=char(60) updatewhereclause=yes name=accountcategory dbname="AccountCategory"  )
column=(type=long updatewhereclause=yes name=subacccode dbname="SubAccCode"  )
column=(type=char(60) updatewhereclause=yes name=accountgroup dbname="AccountGroup"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(60) updatewhereclause=yes name=account dbname="Account"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
 retrieve="SELECT	
	Portion,
	MainAccCode, 
	AccountType, 
	CatAccCode, 
	AccountCategory,
	SubAccCode, 
	AccountGroup, 
	AccCode, 
	Account, 
	Balance=SUM(Balance)
FROM 
(SELECT
	Portion=2,
	MainAccCode=(SELECT Code FROM GLOBAL WHERE TableName = 'mainaccounts' and NAME = 'GT_EquityMain'), 
	AccountType=(SELECT NAME FROM MainAccounts 
			WHERE MainAccCode = (SELECT Code FROM GLOBAL WHERE TableName = 'mainaccounts' and NAME = 'GT_EquityMain')), 
	CatAccCode=(SELECT Code FROM GLOBAL WHERE TableName = 'categoryaccounts' and NAME = 'GT_CapitalAccountsCat'), 
	AccountCategory=(SELECT NAME FROM CategoryAccounts WHERE CatAccCode = (SELECT Code FROM GLOBAL WHERE TableName = 'categoryaccounts' and NAME = 'GT_CapitalAccountsCat')),
	SubAccCode=8888, 
	AccountGroup = 'ACCUMULATED PROFIT/LOSS',
	AccCode=8888, 
	Account = 'ACCUMULATED PROFIT/LOSS UPTO DATE',
	Balance = Value1
FROM ReportData
WHERE Code1=-1 AND Code2 IN (SELECT MAX(Code2) FROM ReportData WHERE Code1=-1 AND Code2 IN (3,5,7,9,11))
UNION ALL
SELECT
	Portion=1,
	MainAccCode=(SELECT Code FROM GLOBAL WHERE TableName = 'mainaccounts' and NAME = 'GT_AssetMain'), 
	AccountType=(SELECT NAME FROM MainAccounts WHERE MainAccCode = (SELECT Code FROM GLOBAL WHERE TableName = 'mainaccounts' and NAME = 'GT_AssetMain')), 
	CatAccCode=(SELECT Code FROM GLOBAL WHERE TableName = 'categoryaccounts' and NAME = 'GT_CurrentAssetsCat'), 
	AccountCategory=(SELECT NAME FROM CategoryAccounts WHERE CatAccCode = (SELECT Code FROM GLOBAL WHERE TableName = 'categoryaccounts' and NAME = 'GT_CurrentAssetsCat')),
	SubAccCode=6666, 
	AccountGroup ='CLOSING STOCK/INVENTORY',
	AccCode=6666, 
	Account ='CLOSING STOCK/INVENTORY',
	Balance = -(Value1)
FROM ReportData
WHERE Name1 = 'CLOSING STOCK/INVENTORY'
UNION ALL 
SELECT	
	Portion=CASE M.MainAccCode WHEN 1 THEN 1 ELSE 2 END,
	M.MainAccCode, 
	AccountType = M.Name,
	C.CatAccCode,
	AccountCategory = C.Name,
	SubAccCode= S.SubAccCode, 
	AccountGroup = S.Name,
	AccCode=CASE :ai_level WHEN 1 THEN S.SubAccCode ELSE V.AccCode END, 
	Account = CASE :ai_level WHEN 1 THEN S.Name ELSE A.NAme END,
	Balance = SUM(V.Debit - V.Credit)
FROM	VirtualGl V, 
	Accounts A, 
	CategoryAccounts C,
	SubAccounts S,
	MainAccounts M
WHERE	
	V.Date <= :ad_EndDate AND
	M.MainAccCode IN (SELECT Code
			 FROM GLOBAL 
			 WHERE TableName = 'mainaccounts' and NAME IN 
				('GT_AssetMain', 'GT_LiabilityMain', 'GT_EquityMain')) AND
	M.MainAccCode = C.MainAccCode AND
	C.CatAccCode = S.CatAccCode AND
	S.SubAccCode = A.SubCode AND
	A.AccCode = V.AccCode
GROUP BY
	M.MainAccCode, 
	M.Name,
	C.CatAccCode,
	C.Name,
	S.SubAccCode, 
	S.Name,
	CASE :ai_level WHEN 1 THEN S.SubAccCode ELSE V.AccCode END, 
	CASE :ai_level WHEN 1 THEN S.Name ELSE A.NAme END
HAVING	SUM(V.Debit - V.Credit) <> 0) T
GROUP BY
	Portion,
	MainAccCode, 
	AccountType,
	CatAccCode,
	AccountCategory,
	SubAccCode, 
	AccountGroup,
	AccCode, 
	Account
ORDER BY
	Portion,
	MainAccCode, 
	AccountType,
	CatAccCode,
	AccountCategory,
	SubAccCode, 
	AccountGroup,
	AccCode, 
	Account
/*SELECT	
	Portion=2,
	MainAccCode=(SELECT Code FROM GLOBAL WHERE TableName = 'mainaccounts' and NAME = 'GT_EquityMain'), 
	AccountType=(SELECT NAME FROM MainAccounts 
			WHERE MainAccCode = (SELECT Code FROM GLOBAL WHERE TableName = 'mainaccounts' and NAME = 'GT_EquityMain')), 
	CatAccCode=(SELECT Code FROM GLOBAL WHERE TableName = 'categoryaccounts' and NAME = 'GT_CapitalAccountsCat'), 
	AccountCategory=(SELECT NAME FROM CategoryAccounts WHERE CatAccCode = (SELECT Code FROM GLOBAL WHERE TableName = 'categoryaccounts' and NAME = 'GT_CapitalAccountsCat')),
	SubAccCode=7777, 
	AccountGroup = 'RETAINED EARNINGS',
	AccCode=7777, 
	Account ='RETAINED EARNINGS',
	Balance = -SUM(B)
FROM
	(SELECT	B=Value1
	FROM ReportData
	WHERE Code1=-1 AND Code2 IN (SELECT MAX(Code2) FROM ReportData WHERE Code1=-1)
	UNION ALL
	SELECT	B= -(Value1)
	FROM ReportData
	WHERE Name1 = 'CLOSING STOCK'
	UNION ALL
	SELECT	
		B= SUM(V.Debit - V.Credit)
	FROM	VirtualGl V, 
		Accounts A, 
		CategoryAccounts C,
		SubAccounts S,
		MainAccounts M
	WHERE	
		V.Date <= :ad_EndDate AND
		M.MainAccCode IN (SELECT Code
			 FROM GLOBAL 
			 WHERE TableName = 'mainaccounts' and NAME IN 
				('GT_AssetMain', 'GT_LiabilityMain', 'GT_EquityMain')) AND
		M.MainAccCode = C.MainAccCode AND
		C.CatAccCode = S.CatAccCode AND
		S.SubAccCode = A.SubCode AND
		A.AccCode = V.AccCode) A
UNION ALL*/"
  arguments=(("ad_EndDate", datetime), ("ai_Level", number))
)
