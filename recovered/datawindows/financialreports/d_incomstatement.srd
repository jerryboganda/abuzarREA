column=(type=decimal(2) updatewhereclause=yes name=value4 dbname="ReportData.Value4"  )
column=(type=char(100) updatewhereclause=yes name=name2 dbname="ReportData.name2"  )
column=(type=decimal(2) updatewhereclause=yes name=value5 dbname="ReportData.Value5"  )
 retrieve="  SELECT name1,
         code1,
         code2, 
			date1,
			date2,
			value1,
			value2,
			Value3, 
			Value4,
			name2,
			Value5
FROM reportdata
ORDER BY value4, code1, code2, name1, name2
         "
 )
