table(column=(type=long updatewhereclause=yes name=mainacccode dbname="MainAccCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=mainaccount dbname="MainAccount"  )
column=(type=char(60) updatewhereclause=yes name=categoryaccount dbname="CategoryAccount"  )
column=(type=char(60) updatewhereclause=yes name=groupaccount dbname="GroupAccount"  )
column=(type=char(60) updatewhereclause=yes name=accounttitle dbname="AccountTitle"  )
column=(type=char(100) updatewhereclause=no name=category dbname="Category"  )
column=(type=decimal(2) updatewhereclause=yes name=opening dbname="Opening"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Value1"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Value2"  )
column=(type=decimal(2) updatewhereclause=yes name=closing dbname="Closing"  )
 retrieve="SELECT  
	MainAccCode=T.MainAccCode,
	AliasName = T.AliasName,
	MainAccount = T.MainAccount, 
	CategoryAccount = T.CategoryAccount,
	GroupAccount = T.GroupAccount,
	AccountTitle = T.AccountTitle,
	Category = CASE T.SubAccCode 
					WHEN 3 THEN (SELECT CC.Name FROM CustomerCategory CC, Customer C WHERE C.CustCode=T.AccCode AND CC.CustCatCode=C.CustCatCode) 
					WHEN 7 THEN (SELECT SC.Name FROM SupplierCategory SC, Supplier S WHERE S.SuppCode=T.AccCode AND S.SuppCatCode=SC.SuppCatCode) 
					ELSE NULL END,	
	Opening = ISNULL(SUM(Opening), 0),
	Value1 = ISNULL(SUM(Value1), 0),
	Value2 = ISNULL(SUM(Value2), 0),
	Closing = ISNULL(SUM(Closing), 0)
FROM
	(SELECT 
			MainAccCode=M.MainAccCode,
			CatAccCode=C.CatAccCode,
			SubAccCode = S.SubAccCode,
			A.AccCode,
			A.AliasName,
			MainAccount = M.Name, 
			CategoryAccount = C.Name,
			GroupAccount = S.Name,
			AccountTitle = A.Name,
			Opening = 0.00,
			value1 = 0.00,
			value2 = 0.00,
			Closing = 0.00
	FROM 
		  Accounts A,
		  SubAccounts S, 
		  CategoryAccounts C,
		  MainAccounts M
	WHERE 
			A.SubCode = S.SubAccCode AND
			S.CatAccCode = C.CatAccCode AND
			C.MainAccCode = M.MainAccCode
	UNION ALL
	SELECT 
			MainAccCode=M.MainAccCode,
			CatAccCode=C.CatAccCode,
			SubAccCode = S.SubAccCode,
			A.AccCode,
			A.AliasName,
			MainAccount = M.Name, 
			CategoryAccount = C.Name,
			GroupAccount = S.Name,
			AccountTitle = A.Name,
			Opening = ISNULL(SUM(V.Debit - Credit), 0),
			value1 = 0,
			value2 = 0,
			Closing = 0
	FROM VirtualGL V,
		  Accounts A,
		  SubAccounts S, 
		  CategoryAccounts C,
		  MainAccounts M
	WHERE 
		V.Date < :ar_startdate AND 
		V.AccCode = A.AccCode AND 
		A.SubCode = S.SubAccCode AND
		S.CatAccCode = C.CatAccCode AND
		C.MainAccCode = M.MainAccCode
	GROUP BY 
		M.MainAccCode,
		C.CatAccCode,
		S.SubAccCode,
		A.AccCode,
		M.Name,
		C.Name,
		S.Name,
		A.Name, 
		A.AliasName
	UNION ALL
	SELECT 
			MainAccCode=M.MainAccCode,
			CatAccCode=C.CatAccCode,
			SubAccCode = S.SubAccCode,
			A.AccCode,
			A.AliasName,
			MainAccount = M.Name, 
			CategoryAccount = C.Name,
			GroupAccount = S.Name,
			AccountTitle = A.Name,
			Opening = 0.00,
			value1 = Case :ar_tbtype 
							When 'Balance' Then Sum(Debit - Credit)
							Else Sum(Debit)
						END,
			value2 = Case :ar_tbtype 
							When 'Balance' Then Sum(Debit - Credit)
							Else -Sum(Credit)
						END,
			Closing = 0.00
	FROM VirtualGL V,
		  Accounts A,
		  SubAccounts S, 
		  CategoryAccounts C,
		  MainAccounts M
	WHERE 
			V.Date >= :ar_startdate 	AND 
			V.Date <= :ar_enddate AND
			V.AccCode = A.AccCode AND 
			A.SubCode = S.SubAccCode AND
			S.CatAccCode = C.CatAccCode AND
			C.MainAccCode = M.MainAccCode
	GROUP BY 
		M.MainAccCode,
		C.CatAccCode,
		S.SubAccCode,
		A.AccCode,
		M.Name,
		C.Name,
		S.Name,
		A.Name, 
		A.AliasName
	UNION ALL
	SELECT 
			MainAccCode=M.MainAccCode,
			CatAccCode=C.CatAccCode,
			SubAccCode = S.SubAccCode,
			A.AccCode,
			A.AliasName,
			MainAccount = M.Name, 
			CategoryAccount = C.Name,
			GroupAccount = S.Name,
			AccountTitle = A.Name,
			Opening = 0.00,
			value1 = 0.00,
			value2 = 0.00,
			Closing = ISNULL(SUM(V.Debit - Credit), 0)
	FROM VirtualGL V,
		  Accounts A,
		  SubAccounts S, 
		  CategoryAccounts C,
		  MainAccounts M
	WHERE 
			V.Date <= :ar_enddate AND 
			V.AccCode = A.AccCode AND 
			A.SubCode = S.SubAccCode AND
			S.CatAccCode = C.CatAccCode AND
			C.MainAccCode = M.MainAccCode
	GROUP BY 
		M.MainAccCode,
		C.CatAccCode,
		S.SubAccCode,
		A.AccCode,
		M.Name,
		C.Name,
		S.Name,
		A.Name, 
		A.AliasName) T
GROUP BY
	T.MainAccCode,
	T.CatAccCode,
	T.SubAccCode,
	T.AccCode,
	T.MainAccCode,
	T.MainAccount, 
	T.CategoryAccount,
	T.GroupAccount,
	T.AccountTitle,
	T.AccCode,
	T.AliasName
ORDER BY
	MainAccCode,
	MainAccount, 
	CategoryAccount,
	GroupAccount,
	AccountTitle"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_tbtype", string), ("ar_tbcontent", string))
 sort="mainacccode A, mainaccount A, categoryaccount A, groupaccount A, category A, debit A, credit A"
)
