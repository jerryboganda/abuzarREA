table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(75) update=yes updatewhereclause=yes name=alternatecustomicode dbname="PurOrderDetail.alternatecustomicode"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PurOrderDetail.pocode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="itempacking"  )
column=(type=char(60) updatewhereclause=yes name=manufname dbname="manufname"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="itemclass"  )
column=(type=char(150) updatewhereclause=yes name=genericitem dbname="genericitem"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="PurOrderDetail.icode"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(GetText() ) >= 0" initial="0" name=bonusqty dbname="PurOrderDetail.bonusqty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(GetText()) >=0" initial="0" name=rate dbname="PurOrderDetail.rate"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=soldqty dbname="PurOrderDetail.soldqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=returnqty dbname="PurOrderDetail.returnqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=netsaleqty dbname="netsaleqty"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="PurOrderDetail.packunits"  )
column=(type=decimal(15) updatewhereclause=yes initial="0" name=avgsaleqty dbname="avgsaleqty"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=forecastqty dbname="forecastqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=stock dbname="PurOrderDetail.stock"  )
column=(type=long updatewhereclause=yes name=porowid dbname="PurOrderDetail.PORowID"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=looseqty dbname="looseqty"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="PurOrderDetail.remarks"  )
column=(type=char(100) update=yes updatewhereclause=yes initial="." name=batch dbname="PurOrderDetail.batch"  )
column=(type=decimal(4) updatewhereclause=yes initial="99999999.9999" name=allowedqty dbname="allowedqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="1" name=qty dbname="PurOrderDetail.qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation=" Real(GetText()) >= 0" initial="0" name=itemflatdisc dbname="PurOrderDetail.itemflatdisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation=" Real(GetText()) >= 0" validationmsg="~"Negative Salestax is not allowed~"" initial="0" name=packsalestax dbname="PurOrderDetail.packsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation=" Real(GetText()) >= 0 AND  Real(GetText()) <= 100" validationmsg="~"GST % must be in the range of 0-100~"" initial="0" name=gstperc dbname="PurOrderDetail.gstperc"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="Real (GetText()) >= 0" initial="0" name=foreignprice dbname="PurOrderDetail.foreignprice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=purprice dbname="PurOrderDetail.purprice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=saleprice dbname="PurOrderDetail.saleprice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=rpp dbname="PurOrderDetail.rpp"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=packavgprice dbname="PurOrderDetail.packavgprice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation=" Real(GetText()) >= 0" initial="0" name=transitstock dbname="PurOrderDetail.transitstock"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation=" Real(GetText()) >= 0" initial="0" name=saleorderrequest dbname="PurOrderDetail.saleorderrequest"  )
column=(type=long update=yes updatewhereclause=yes name=lastpurinvcode dbname="PurOrderDetail.LastPurInvCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=lastpurdate dbname="PurOrderDetail.LastPurDate"  )
column=(type=long update=yes updatewhereclause=yes validation=" Real(GetText()) >= 0" initial="0" name=minqty dbname="PurOrderDetail.minqty"  )
column=(type=long update=yes updatewhereclause=yes validation=" Real(GetText()) >= 0" initial="0" name=reorderqty dbname="PurOrderDetail.ReOrderQty"  )
column=(type=long update=yes updatewhereclause=yes validation=" Real(GetText()) >= 0" initial="0" name=optimumqty dbname="PurOrderDetail.OptimumQty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation=" Real(GetText()) >= 0 AND  Real(GetText()) <= 100" validationmsg="~"Disc. % 2 must be in the range of 0-100~"" initial="0" name=discperc2 dbname="PurOrderDetail.discperc2"  )
column=(type=long update=yes updatewhereclause=yes name=itemalertcode dbname="itemalertcode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation=" Real(GetText()) >= 0" initial="0" name=discperc dbname="PurOrderDetail.discperc"  )
 retrieve="SELECT
	item.customicode,
	purorderdetail.alternatecustomicode,
	currlistrow = 0,
	purorderdetail.pocode,   
	itemname = item.name,
	itempacking = itempacking.name,
	manufname = manufacturer.name,
	itemcategory = itemcategory.name,
	itemclass = itemclass.name,
	genericitem = genericitem.name,
	purorderdetail.icode,   
	purorderdetail.bonusqty,   
	purorderdetail.rate,
	purorderdetail.soldqty,
	purorderdetail.returnqty,
	netsaleqty=purorderdetail.soldqty - purorderdetail.returnqty,
	purorderdetail.packunits,
	avgsaleqty = 
			case purorderheader.purordercatcode when 1 then 0 when 3 then 0 
			else (purorderdetail.soldqty - purorderdetail.returnqty) / 
				case datediff(dy, purorderheader.startdate, purorderheader.enddate)
				when 0 THEN 1.0 ELSE convert(numeric(10,2), datediff(dy, purorderheader.startdate, purorderheader.enddate)) 
				END
			END,
	forecastqty = 
			CAST(case purorderheader.purordercatcode when 1 then 0 when 3 then 0
			else ceiling(((purorderdetail.soldqty - purorderdetail.returnqty) / 
				case datediff(dy, purorderheader.startdate, purorderheader.enddate)
				when 0 THEN 1.0 ELSE convert(numeric(15,4), datediff(dy, purorderheader.startdate, purorderheader.enddate)) 
				END) * purorderheader.projectionperiod) 
			END AS numeric(15,4)),
	purorderdetail.stock,
	purorderdetail.PORowID,   
	looseqty = 
			case purorderheader.purordercatcode when 1 then purorderdetail.OptimumQty - purorderdetail.stock + purorderdetail.transitstock
			else 0 end ,
	purorderdetail.remarks,   
	purorderdetail.batch,
	allowedqty = 999999.0000,
	purorderdetail.qty,
	purorderdetail.itemflatdisc,
	purorderdetail.packsalestax,
	purorderdetail.gstperc,
	purorderdetail.foreignprice,
	purorderdetail.purprice,
	purorderdetail.saleprice,
	purorderdetail.rpp,
	purorderdetail.packavgprice,
	purorderdetail.transitstock,
	purorderdetail.saleorderrequest,
	purorderdetail.LastPurInvCode,
	purorderdetail.LastPurDate,
	purorderdetail.minqty,
	purorderdetail.ReOrderQty,
	purorderdetail.OptimumQty,
	purorderdetail.discperc2,
	itemalertcode=purorderdetail.itemalertcode,
	purorderdetail.discperc
FROM	
	purorderdetail,  
	purorderheader, 
	item
	LEFT OUTER JOIN itempacking ON (item.packcode = itempacking.packcode),
	manufacturer,
	itemcategory,
	itemclass,
	genericitem
WHERE 
	( dbo.purorderheader.pocode = :ra_POCode ) and
	( dbo.purorderheader.pocode = purorderdetail.pocode ) and  
	( purorderdetail.icode = item.icode ) and  
	( item.manfcode = manufacturer.manfcode )  and
	( item.icatcode = itemcategory.icatcode )  and
	( item.iccode = itemclass.iccode ) and
	( item.genericcode = genericitem.genericcode )
ORDER BY	
	purorderdetail.PORowID
"
  update="purorderdetail" updatewhere=1 updatekeyinplace=no
  arguments=(("ra_POCode", number))
)
