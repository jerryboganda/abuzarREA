release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=long updatewhereclause=yes name=icode dbname="Item.icode"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="Item.ManfCode"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Item.packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="Item.purPrice"  )
column=(type=long updatewhereclause=yes name=minqty dbname="Item.minqty"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="SoldQty"  )
column=(type=decimal(4) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=decimal(4) updatewhereclause=yes name=transitstock dbname="TransitStock"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=rpp dbname="rpp"  )
column=(type=decimal(5) updatewhereclause=yes name=packavgprice dbname="packavgprice"  )
 retrieve="SELECT
	aliasname=item.customicode,
	item.icode, 
	item.ManfCode,
	Item=item.name,
	Manufacturer=Manufacturer.name,
	ItemCategory=ItemCategory.name,
	ItemClass=ItemClass.name,
	item.packunits,
	item.purPrice,  
	item.minqty,
	SoldQty = ISNULL(SUM(SL.SoldQty), 0),
	ReturnQty = ISNULL(SUM(SL.ReturnQty), 0),
	Stock = ISNULL((select SUM(currqty) from godowndetail where godowndetail.icode = Item.icode AND GodownDetail.GCode IN (SELECT G.Gcode FROM Godown G WHERE G.ConsiderStockInPO='Y')), 0),
	TransitStock = ISNULL(dbo.item.transitstock, 0),
	purprice=dbo.item.purprice,
	saleprice=dbo.item.saleprice,
	rpp=dbo.item.recentpurprice,
	packavgprice=ROUND(dbo.item.avgprice * dbo.item.packunits, 2)
FROM 
	Manufacturer,
	ItemCategory,
	ItemClass,
	Item
	LEFT OUTER JOIN
	(SELECT
		Saledetail.icode,
		soldqty   = SUM(Saledetail.LooseQty),
		ReturnQty = 0
	FROM 	Saledetail, SaleLedger
	WHERE	( SaleLedger.date >= :ar_StartDate ) and
        	( SaleLedger.date <= :ar_EndDate ) and
	        ( SaleLedger.SaleInvCode = Saledetail.SaleInvcode ) and  
        	( Saledetail.ICode IN 
				(SELECT Icode FROM Item WHERE Item.ManfCode IN (:ar_manfcode) OR 
					dbo.item.icatcode in (:ar_icatcode) OR 
					dbo.item.iccode in (:ar_iccode) OR dbo.item.NAME LIKE (:ar_itemlike)))
	GROUP BY Saledetail.icode
	UNION ALL
	SELECT
		Srdetail.icode,
		soldqty   = 0,
		ReturnQty = SUM(Srdetail.LooseQty)
	FROM 	Srdetail, SrLedger
	WHERE	( SrLedger.date >= :ar_StartDate ) and
        	( SrLedger.date <= :ar_EndDate ) and
	      	( SrLedger.SrInvCode = Srdetail.SrInvcode ) and  
        	( Srdetail.ICode IN 
				(SELECT Icode FROM Item WHERE Item.ManfCode IN (:ar_manfcode) OR dbo.item.icatcode in (:ar_icatcode) OR 
					dbo.item.iccode in (:ar_iccode) OR 
					dbo.item.NAME LIKE (:ar_itemlike)))
	GROUP BY	Srdetail.icode) AS SL ON (dbo.Item.ICode = SL.ICode)
WHERE	
	(dbo.item.manfcode in (:ar_manfcode) OR dbo.item.icatcode in (:ar_icatcode) OR 
		dbo.item.iccode in (:ar_iccode) OR dbo.item.NAME LIKE (:ar_itemlike)) AND
	( dbo.item.manfcode = dbo.manufacturer.manfcode ) AND
	( dbo.Item.ICatCode = dbo.itemcategory.icatcode ) AND
	( dbo.Item.ICCode = dbo.itemclass.iccode ) AND
	( dbo.Item.Active = 1 )
GROUP BY
	item.icode,
	Item.ManfCode,
	Item.Name,
	item.customicode,
	Manufacturer.Name,
	ItemCategory.name,
	ItemClass.name,
	Item.PackUnits,
	item.purprice,
	item.minqty,
	item.transitstock,
	item.saleprice,
	item.recentpurprice,
	item.avgprice

ORDER BY
	Manufacturer.Name,
	ItemCategory.name,
	ItemClass.name,
	Item.Name
"
  arguments=(("ar_manfcode", numberlist), ("ar_icatcode", numberlist), ("ar_iccode", numberlist), ("ar_itemlike", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
