header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=decimal(4) updatewhereclause=yes name=currqty dbname="currqty"  )
column=(type=long updatewhereclause=yes name=minqty dbname="minqty"  )
column=(type=long updatewhereclause=yes name=optimumqty dbname="optimumqty"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="reorderqty"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="item"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="ItemPacking"  )
column=(type=char(150) updatewhereclause=yes name=genericitem dbname="genericitem"  )
column=(type=long updatewhereclause=yes name=purquotationcode dbname="PurQuotationCode"  )
column=(type=long updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=long updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=decimal(4) updatewhereclause=yes name=poqty dbname="POQty"  )
column=(type=decimal(4) updatewhereclause=yes name=pobonus dbname="POBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=transitstock dbname="TransitStock"  )
column=(type=long updatewhereclause=yes name=minqty dbname="MinQty"  )
column=(type=long updatewhereclause=yes name=lastpurinvcode dbname="LastPurInvCode"  )
column=(type=datetime updatewhereclause=yes name=lastpurdate dbname="LastPurDate"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=packsalestax dbname="packsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=rpp dbname="rpp"  )
column=(type=decimal(5) updatewhereclause=yes name=packavgprice dbname="packavgprice"  )
 retrieve="SELECT 
	icode=dbo.item.icode , 
	aliasname=dbo.item.customicode, 
	currqty=Case When sum(GD.currqty) IS NULL Then 0 Else sum(GD.currqty) End, 
	minqty=dbo.item.minqty,  
	optimumqty=0,
	reorderqty=0, 
	rate=P.purprice,
	packunits=dbo.item.packunits,
	item=dbo.item.name,  
	Manufacturer=dbo.Manufacturer.name,
	ItemCategory=dbo.ItemCategory.name,
	ItemClass=dbo.ItemClass.name,
	ItemPacking=(SELECT IP.Name FROM ItemPacking IP WHERE IP.Packcode = dbo.item.packcode),
	genericitem=(SELECT genericitem.name FROM genericitem WHERE genericitem.genericCode = dbo.item.genericCode),
	PurQuotationCode=P.PurQuotationCode,
	Qty=P.Qty,
	BonusQty=P.BonusQty,
	POQty=ISNULL((SELECT qty=sum(D.Qty) 
									FROM PurOrderDetail D, PurOrderHeader H 
									WHERE H.PurQuotationCode=:ai_PurQuotationCode AND 
												H.POCode = D.POcode AND 
												D.Icode = dbo.item.icode), 0),
	POBonus=ISNULL((SELECT BonusQty=sum(D.BonusQty) 
									FROM PurOrderDetail D, PurOrderHeader H 
									WHERE H.PurQuotationCode=:ai_PurQuotationCode AND 
												H.POCode = D.POcode AND 
												D.Icode = dbo.item.icode), 0),
	TransitStock = ISNULL(dbo.item.transitstock, 0),
	MinQty = ISNULL(dbo.item.MinQty, 0),
	LastPurInvCode = (SELECT MAX(P.PurInvCode) FROM PurDetail D, PurLedger P WHERE D.ICode = Item.ICode AND P.PurInvCode = D.PurInvCode AND P.Posted='Y'),
	LastPurDate = (SELECT MAX(P.Date) FROM PurDetail D, PurLedger P WHERE D.ICode = Item.ICode AND P.PurInvCode = D.PurInvCode AND P.Posted='Y'),
	gstperc=dbo.item.gstperc1,
	packsalestax=dbo.item.packsalestax,
	purprice=P.purprice,
	discperc=P.DiscPerc,
	saleprice=dbo.item.saleprice,
	rpp=dbo.item.recentpurprice,
	packavgprice=ROUND(dbo.item.avgprice * dbo.item.packunits, 2)

FROM 
	dbo.item
	LEFT OUTER JOIN (SELECT GDD.* FROM dbo.godowndetail GDD WHERE GDD.GCode IN (SELECT G.GCode FROM Godown G WHERE G.ConsiderStockINPO='Y')) AS GD ON (dbo.item.icode = GD.icode),
	dbo.Manufacturer,
	dbo.itemcategory,
	dbo.itemclass,
	(SELECT PurQuotationCode, ICode, Qty, Bonusqty, PurPrice, DiscPerc
	FROM PurQuotationDetail 
	WHERE PurQuotationCode = :ai_PurQuotationCode) P

WHERE
	dbo.Fn_GetPreference('fetchlastpurinfoinpo')='Y' AND 
	( 
		dbo.item.manfcode in (:ar_manfcode) OR 
		dbo.item.icatcode in (:ar_icatcode) OR 
	 	dbo.item.iccode in (:ar_iccode) OR 
		dbo.item.Packcode in (:ar_Packcode) OR
		dbo.item.NAME LIKE (:ar_itemlike)
	) AND 
	( dbo.item.icode = P.ICode ) AND 
	( dbo.item.manfcode = dbo.manufacturer.manfcode ) AND
	( dbo.Item.ICatCode = dbo.itemcategory.icatcode ) AND
	( dbo.Item.ICCode = dbo.itemclass.iccode ) AND
	( dbo.Item.Active = 1 ) 
GROUP BY 
	P.PurQuotationCode,
	dbo.item.icode , 
	dbo.item.manfcode, 
	P.purprice,
	P.DiscPerc,
	dbo.item.saleprice,
	dbo.item.recentpurprice,
	dbo.item.avgprice,
 	dbo.item.packunits,
	dbo.item.name,
	dbo.Manufacturer.Name,
	dbo.ItemCategory.name,
	dbo.ItemClass.name,
	dbo.Item.PackCode,
	dbo.item.genericcode,
	dbo.item.customicode,
	dbo.item.transitstock,
	dbo.item.MinQty,
	P.Qty,
	P.BonusQty,
	dbo.item.gstperc1,
	dbo.item.packsalestax
UNION ALL
SELECT 
	icode=dbo.item.icode , 
	aliasname=dbo.item.customicode, 
	currqty=Case When sum(GD.currqty) IS NULL Then 0 Else sum(GD.currqty) End, 
	minqty=dbo.item.minqty,  
	optimumqty=0,
	reorderqty=0, 
	rate=P.purprice,
	packunits=dbo.item.packunits,
	item=dbo.item.name,  
	Manufacturer=dbo.Manufacturer.name,
	ItemCategory=dbo.ItemCategory.name,
	ItemClass=dbo.ItemClass.name,
	ItemPacking=(SELECT IP.Name FROM ItemPacking IP WHERE IP.Packcode = dbo.item.packcode),
	genericitem=(SELECT genericitem.name FROM genericitem WHERE genericitem.genericCode = dbo.item.genericCode),
	PurQuotationCode=P.PurQuotationCode,
	Qty=P.Qty,
	BonusQty=P.BonusQty,
	POQty=ISNULL((SELECT qty=sum(D.Qty) 
									FROM PurOrderDetail D, PurOrderHeader H 
									WHERE H.PurQuotationCode=:ai_PurQuotationCode AND 
												H.POCode = D.POcode AND 
												D.Icode = dbo.item.icode), 0),
	POBonus=ISNULL((SELECT BonusQty=sum(D.BonusQty) 
									FROM PurOrderDetail D, PurOrderHeader H 
									WHERE H.PurQuotationCode=:ai_PurQuotationCode AND 
												H.POCode = D.POcode AND 
												D.Icode = dbo.item.icode), 0),
	TransitStock = ISNULL(dbo.item.transitstock, 0),
	MinQty = ISNULL(dbo.item.MinQty, 0),
	LastPurInvCode = NULL,
	LastPurDate = NULL,
	gstperc=dbo.item.gstperc1,
	packsalestax=dbo.item.packsalestax,
	purprice=P.purprice,
	discperc=P.DiscPerc,
	saleprice=dbo.item.saleprice,
	rpp=dbo.item.recentpurprice,
	packavgprice=ROUND(dbo.item.avgprice * dbo.item.packunits, 2)

FROM 
	dbo.item
	LEFT OUTER JOIN (SELECT GDD.* FROM dbo.godowndetail GDD WHERE GDD.GCode IN (SELECT G.GCode FROM Godown G WHERE G.ConsiderStockINPO='Y')) AS GD ON (dbo.item.icode = GD.icode),
	dbo.Manufacturer,
	dbo.itemcategory,
	dbo.itemclass,
	(SELECT PurQuotationCode, ICode, Qty, Bonusqty, PurPrice, DiscPerc
	FROM PurQuotationDetail 
	WHERE PurQuotationCode = :ai_PurQuotationCode) P

WHERE
	dbo.Fn_GetPreference('fetchlastpurinfoinpo')='N' AND 
	( 
		dbo.item.manfcode in (:ar_manfcode) OR 
		dbo.item.icatcode in (:ar_icatcode) OR 
	 	dbo.item.iccode in (:ar_iccode) OR 
		dbo.item.Packcode in (:ar_Packcode) OR
		dbo.item.NAME LIKE (:ar_itemlike)
	) AND 
	( dbo.item.icode = P.ICode ) AND 
	( dbo.item.manfcode = dbo.manufacturer.manfcode ) AND
	( dbo.Item.ICatCode = dbo.itemcategory.icatcode ) AND
	( dbo.Item.ICCode = dbo.itemclass.iccode ) AND
	( dbo.Item.Active = 1 ) 
GROUP BY 
	P.PurQuotationCode,
	dbo.item.icode , 
	dbo.item.manfcode, 
	P.purprice,
	P.DiscPerc,
	dbo.item.saleprice,
	dbo.item.recentpurprice,
	dbo.item.avgprice,
 	dbo.item.packunits,
	dbo.item.name,
	dbo.Manufacturer.Name,
	dbo.ItemCategory.name,
	dbo.ItemClass.name,
	dbo.Item.PackCode,
	dbo.item.genericcode,
	dbo.item.customicode,
	dbo.item.transitstock,
	dbo.item.MinQty,
	P.Qty,
	P.BonusQty,
	dbo.item.gstperc1,
	dbo.item.packsalestax
ORDER BY manufacturer, item
"
  arguments=(("ai_purquotationcode", number), ("ar_manfcode", numberlist), ("ar_icatcode", numberlist), ("ar_iccode", numberlist), ("ar_packcode", numberlist), ("ar_itemlike", string))
)
