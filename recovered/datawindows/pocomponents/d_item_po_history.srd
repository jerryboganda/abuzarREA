table(column=(type=char(60) updatewhereclause=yes name=item_name dbname="item_name"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="itemaliasname"  )
column=(type=char(20) updatewhereclause=yes name=itempacking_name dbname="ItemPacking.Name"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=long updatewhereclause=yes name=code dbname="PurOrderHeader.POcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.Date"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="Bonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=long updatewhereclause=yes name=purledger_suppcode dbname="suppcode"  )
column=(type=char(10) updatewhereclause=yes name=currency dbname="currency"  )
column=(type=decimal(5) updatewhereclause=yes name=conversionfactor dbname="conversionfactor"  )
column=(type=char(12) updatewhereclause=yes name=supplieraliasname dbname="supplieraliasname"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="supplier"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=char(100) updatewhereclause=yes name=purtype dbname="purtype"  )
column=(type=char(50) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=decimal(5) updatewhereclause=yes name=foreignprice dbname="foreignprice"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="SalesTax"  )
column=(type=decimal(6) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT
	item_name=item.Name,
	itemaliasname=item.Customicode,
	ItemPacking.Name, 
	PackUnits=Item.PackUnits,
	purorderheader.POcode, 
	remarks=purorderheader.remarks,
	purorderheader.Date,
	Qty = PurOrderDetail.Qty,
	Bonusqty=PurOrderDetail.Bonusqty,
	Rate=PurOrderDetail.PurPrice,
	suppcode=dbo.purorderheader.suppcode,
	currency = (SELECT Currency.shortname FROM Currency WHERE Currency.CurrencyCode = dbo.purorderheader.conversionfactor),
	conversionfactor=dbo.purorderheader.conversionfactor,
	supplieraliasname=dbo.accounts.aliasname,		
	supplier=dbo.accounts.name,		
	discperc=PurOrderDetail.discperc,
	invdiscperc=purorderheader.discperc,
	purtype=(select purchasetype.name from purchasetype where purtypecode=purorderheader.purtypecode),
	Category=(select POC.name from purordercategory POC where POC.purordercatcode = purorderheader.purordercatcode),
	Batch=PurOrderDetail.batch,
	Expiry=PurOrderDetail.expiry,
	foreignprice=dbo.PurOrderDetail.foreignprice,
	SalesTax= (PurOrderDetail.Packsalestax * ( PurOrderDetail.Qty + PurOrderDetail.bonusqty)) + 
		Round( PurOrderDetail.PurPrice * PurOrderDetail.Qty * (1 - PurOrderDetail.DiscPerc * .01) * 0.01 * PurOrderDetail.gstperc, 2) +
		( Round((Round( Round(PurOrderDetail.PurPrice * PurOrderDetail.Qty * (1 - PurOrderDetail.DiscPerc * .01), 2) * (1 -  purorderheader.discperc * 0.01), 2) - purorderheader.flatdisc) * 0.01 *  purorderheader.invgstperc1, 2)) / CASE WHEN (PurOrderDetail.Qty + PurOrderDetail.bonusqty) = 0 THEN 1 ELSE (PurOrderDetail.Qty + PurOrderDetail.bonusqty) END,
	NetRate=(PurOrderDetail.PurPrice * PurOrderDetail.Qty  * (1 - PurOrderDetail.DiscPerc * .01) * ( 1 - purorderheader.discperc * .01 ) + 
		((PurOrderDetail.Packsalestax * ( PurOrderDetail.Qty + PurOrderDetail.bonusqty )) +  
					Round( PurOrderDetail.PurPrice * (PurOrderDetail.Qty ) * (1 - PurOrderDetail.DiscPerc * .01) * 0.01 * PurOrderDetail.gstperc, 2) +
						( Round((
							Round( 
								Round(PurOrderDetail.PurPrice * (PurOrderDetail.Qty ) * 
									(1 - PurOrderDetail.DiscPerc * .01),2) * 
									(1 -  purorderheader.discperc * 0.01),2) - purorderheader.flatdisc) * 0.01 *  
									purorderheader.invgstperc1 ,2)) ) /
								CASE WHEN (PurOrderDetail.Qty + PurOrderDetail.bonusqty) = 0 THEN 1 ELSE (PurOrderDetail.Qty + PurOrderDetail.bonusqty) END),
	Posted=purorderheader.Posted
FROM
	Item
	LEFT OUTER JOIN ItemPacking ON (Item.Packcode = ItemPacking.Packcode),
	purorderheader,
	accounts,
	PurOrderDetail

WHERE 
	Item.icode = :ar_icode  and
	dbo.PurOrderDetail.icode = :ar_icode and 
	dbo.PurOrderDetail.POCode=dbo.purorderheader.POCode and 
	dbo.purorderheader.Suppcode=dbo.accounts.acccode
"
  arguments=(("ar_icode", number))
 sort="date D, code A, supplier A"
)
