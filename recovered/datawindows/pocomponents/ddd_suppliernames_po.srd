header(height=68 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=char(30) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(16) updatewhereclause=yes name=fax dbname="Fax"  )
 retrieve="SELECT 
	AccCode = A.AccCode, 
	AliasName = A.AliasName, 
	Name = A.Name, 
	Address1 = S.Address1,
	Address2 = S.Address2, 
	City = S.City,
	Phone = S.Phone,
	Fax = S.Fax
FROM
	Accounts A, Supplier S
WHERE
	A.AccCode = S.SuppCode
UNION 
SELECT 
	AccCode = NULL, 
	AliasName = NULL, 
	Name = '<ALL>', 
	Address1 = NULL, 
	Address2 = NULL, 
	City = NULL, 
	Phone = NULL, 
	Fax = NULL
ORDER BY Name
"
 )
