header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=pocode dbname="PurOrderHeader.pocode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.date"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.name"  )
column=(type=char(100) updatewhereclause=yes name=supplierreference dbname="supplierreference"  )
column=(type=long updatewhereclause=yes name=purcount dbname="PurCount"  )
column=(type=decimal(2) updatewhereclause=yes name=totalofpurchases dbname="Totalofpurchases"  )
column=(type=char(500) updatewhereclause=yes name=listofpurinvoices dbname="listofpurinvoices"  )
 retrieve="SELECT 
	purorderheader.pocode, 
	purorderheader.date,   
	accounts.name,
	supplierreference=purorderheader.supplierreference,
	PurCount = (SELECT COUNT(P.POCode) FROM PurLedger P WHERE P.POCode=PurOrderHeader.POCode),
	Totalofpurchases= purorderheader.Totalofpurchases,
	listofpurinvoices = purorderheader.listofpurinvoices
FROM 
	accounts,   
	purorderheader  
WHERE 
	( purorderheader.suppcode = accounts.acccode and purorderheader.Posted = 'Y' )    
UNION
SELECT pocode=NULL,   
	date=NULL,   
	name='[None]' ,
	supplierreference=SPACE(100),
	PurCount = NULL,
	Totalofpurchases= NULL,
	listofpurinvoices = NULL

"
  sort="pocode D"
)
