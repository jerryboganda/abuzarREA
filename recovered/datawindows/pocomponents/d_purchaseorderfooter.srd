table(column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0  AND Real(GetText()) <=100" initial="0" name=discperc dbname="PurOrderHeader.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscvalue dbname="invdiscvalue"  )
column=(type=long updatewhereclause=yes validation="Real(GetText()) >= 0  " initial="0" name=total dbname="total"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0  " initial="0" name=flatdisc dbname="PurOrderHeader.FlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0  " initial="0" name=misccharges dbname="PurOrderHeader.MiscCharges"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0  AND Real(GetText()) <=100" initial="0" name=invgstperc1 dbname="PurOrderHeader.invgstperc1"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=invgstvalue dbname="invgstvalue"  )
 retrieve="  SELECT dbo.purorderheader.discperc,
			invdiscvalue=0.00,
			total=0,
			dbo.purorderheader.FlatDisc,
			dbo.purorderheader.MiscCharges,
			dbo.purorderheader.invgstperc1,
			invgstvalue=0.00

  FROM   dbo.purorderheader
  WHERE 	dbo.purorderheader.PoCode = :al_PurOrderCode
"
  arguments=(("al_PurOrderCode", number))
)
