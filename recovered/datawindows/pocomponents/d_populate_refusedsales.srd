table(column=(type=long updatewhereclause=yes name=refusedsaleinvcode dbname="RefusedSaleInvCode"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=reason dbname="Reason"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="Price"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="TotalStock"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowId"  )
column=(type=decimal(6) updatewhereclause=yes name=value dbname="Value"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
 retrieve="SELECT 
	RefusedSaleInvCode=S.RefusedSaleInvCode, 
	SaleInvCode=S.SaleInvCode, 
	Date=S.Date, 
	ICode=D.ICode,  
	ItemName = ISNULL((SELECT Item.Name FROM ITEM WHERE ITEM.ICode = D.ICode), D.UnKnownItemName), 
	Reason=SRR.Name, 
	Qty=D.Qty, 
	Price=D.SalePrice, 
	Remarks=D.Remarks, 
	TotalStock=D.TotalStock, 
	RowId=D.RowID, 
	Value = D.Qty * D.SalePrice, 
	UserName= (SELECT Users.UserName FROM Users WHERE S.UserCode = Users.UserCode)
FROM 
	RefusedSaleHeader S, RefusedSaleDetail D, SaleRefusalReason SRR
WHERE 
	S.Date BETWEEN :ad_startdate AND :ad_enddate AND
	S.RefusedSaleInvCode = D.RefusedSaleInvCode AND
	D.ReasonCode = SRR.ReasonCode
ORDER BY
	S.Date,
	S.SaleInvCode,
	S.RefusedSaleInvCode,
	ItemName,
	D.RowID
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="date A, refusedsaleinvcode A, saleinvcode A, itemname A, rowid A"
)
