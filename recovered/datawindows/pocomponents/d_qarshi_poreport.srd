table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=purorderheader_pocode dbname="PurOrderHeader.POCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.Date"  )
column=(type=long updatewhereclause=yes name=purorderdetail_icode dbname="PurOrderDetail.ICode"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="PurOrderDetail.Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="PurOrderDetail.Rate"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="PACKINGDESC"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Supplier.Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Supplier.Address2"  )
column=(type=long identity=yes updatewhereclause=yes name=purorderdetail_porowid dbname="PurOrderDetail.PORowID"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=decimal(6) updatewhereclause=yes name=total dbname="Total"  )
column=(type=char(100) updatewhereclause=yes name=itemremarks dbname="PurOrderDetail.remarks"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="PurOrderHeader.remarks"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms1 dbname="PurOrderHeader.PurOrderTerms1"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms2 dbname="PurOrderHeader.PurOrderTerms2"  )
column=(type=char(50) updatewhereclause=yes name=supplierreference dbname="PurOrderHeader.SupplierReference"  )
column=(type=char(50) updatewhereclause=yes name=deliverylocation dbname="PurOrderHeader.DeliveryLocation"  )
column=(type=long updatewhereclause=yes name=saleordercode dbname="PurOrderHeader.SaleOrderCode"  )
column=(type=char(50) updatewhereclause=yes name=usagelocation dbname="PurOrderHeader.UsageLocation"  )
column=(type=datetime updatewhereclause=yes name=requireddate dbname="PurOrderHeader.RequiredDate"  )
 retrieve="SELECT 
	itemname= item.name, 
	PurOrderHeader.POCode,   
	PurOrderHeader.Date,   
	PurOrderDetail.ICode,   
	PurOrderDetail.Qty,  
	PurOrderDetail.Rate,  
	PACKINGDESC=ITEM.packingdesc, 
	Accounts.Name,
	Supplier.Address1, 
	Supplier.Address2,
	PurOrderDetail.PORowID,
	Manufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),
	Total = PurOrderDetail.Qty * PurOrderDetail.Rate,
	PurOrderDetail.remarks,
	PurOrderHeader.remarks,
	PurOrderHeader.PurOrderTerms1,
	PurOrderHeader.PurOrderTerms2,
	PurOrderHeader.SupplierReference,
	PurOrderHeader.DeliveryLocation,
	PurOrderHeader.SaleOrderCode,
	PurOrderHeader.UsageLocation,
	PurOrderHeader.RequiredDate
FROM 
	PurOrderDetail,   
   PurOrderHeader,   
	Accounts, 
	Item,
	Supplier
WHERE 
	( PurOrderHeader.POCode = PurOrderDetail.POCode ) and  
	( PurOrderDetail.icode = item.icode ) and  
	( PurOrderHeader.SuppCode = Supplier.SuppCode ) and  
	( PurOrderHeader.SuppCode = Accounts.AccCode ) and  
	( ( PurOrderHeader.POCode = :ra_POCode ) )
ORDER BY 
	PurOrderDetail.PORowID"
  arguments=(("ra_POCode", number))
)
