summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(6) updatewhereclause=yes name=currqty dbname="compute_0002"  )
column=(type=long updatewhereclause=yes name=lastpurinvcode dbname="LastPurInvCode"  )
column=(type=datetime updatewhereclause=yes name=lastpurdate dbname="LastPurDate"  )
column=(type=long updatewhereclause=yes name=optimumqty dbname="optimumqty"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=rpp dbname="rpp"  )
column=(type=decimal(5) updatewhereclause=yes name=packavgprice dbname="packavgprice"  )
 retrieve="SELECT 
	dbo.item.icode ,  
	Case When (sum(GD.currqty) / dbo.item.packunits) IS NULL Then 0 Else (sum(GD.currqty) / dbo.item.packunits) End, 
	LastPurInvCode = CASE WHEN dbo.Fn_GetPreference('fetchlastpurinfoinpo')='Y' THEN (SELECT MAX(P.PurInvCode) FROM PurDetail D, PurLedger P WHERE D.ICode = Item.ICode AND P.PurInvCode = D.PurInvCode AND P.Posted='Y') ELSE NULL END,
	LastPurDate = CASE WHEN dbo.Fn_GetPreference('fetchlastpurinfoinpo')='Y' THEN (SELECT MAX(P.Date) FROM PurDetail D, PurLedger P WHERE D.ICode = Item.ICode AND P.PurInvCode = D.PurInvCode AND P.Posted='Y') ELSE NULL END,
	dbo.item.optimumqty, 
	dbo.item.purprice,
	purprice=dbo.item.purprice,
	saleprice=dbo.item.saleprice,
	rpp=dbo.item.recentpurprice,
	packavgprice=ROUND(dbo.item.avgprice * dbo.item.packunits, 2)
FROM 
	dbo.item
	LEFT OUTER JOIN (SELECT GDD.* FROM dbo.godowndetail GDD WHERE GDD.GCode IN (SELECT G.GCode FROM Godown G WHERE G.ConsiderStockINPO='Y')) AS GD ON (dbo.item.icode = GD.icode)
WHERE  
	( dbo.item.manfcode IN 
	  (Select suppliermanufacturers.manfcode
		From   suppliermanufacturers
		Where  suppliermanufacturers.suppcode = :ai_SuppCode) ) AND
	( dbo.item.optimumqty > 0 )
GROUP BY 
	dbo.item.icode , 
	GD.batch, 
	GD.expiry, 
	dbo.item.manfcode, 
	dbo.item.optimumqty, 
	dbo.item.reorderqty, 
	dbo.item.purprice,
	dbo.item.saleprice,
	dbo.item.recentpurprice,
	dbo.item.avgprice,
	dbo.item.packunits 
HAVING   
	( dbo.item.reorderqty >= Case When (sum(GD.currqty) / dbo.item.packunits) IS NULL Then 0 Else (sum(GD.currqty) / dbo.item.packunits)End )   
ORDER BY 
	item.manfcode"
  arguments=(("ai_SuppCode", number))
)
