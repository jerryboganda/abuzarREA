footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.name"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=long updatewhereclause=yes name=pocode dbname="PurOrderHeader.POCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.Date"  )
column=(type=char(12) updatewhereclause=yes name=accounts_aliasname dbname="Accounts.Aliasname"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Supplier.address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Supplier.address2"  )
column=(type=char(30) updatewhereclause=yes name=city dbname="Supplier.city"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Supplier.phone"  )
column=(type=char(16) updatewhereclause=yes name=fax dbname="Supplier.fax"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="PurOrderHeader.remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=purorderheader_discperc dbname="PurOrderHeader.Discperc"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="Item.packingdesc"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="PurOrderDetail.rate"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="PurOrderDetail.qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="PurOrderDetail.bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="PurOrderDetail.discperc"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="PurOrderDetail.reorderqty"  )
column=(type=long updatewhereclause=yes name=optimumqty dbname="PurOrderDetail.OptimumQty"  )
column=(type=long updatewhereclause=yes name=minqty dbname="PurOrderDetail.minQty"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="PurOrderDetail.Stock"  )
column=(type=decimal(4) updatewhereclause=yes name=transitstock dbname="PurOrderDetail.TransitStock"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="PurOrderDetail.SoldQty"  )
column=(type=decimal(4) updatewhereclause=yes name=returnqty dbname="PurOrderDetail.ReturnQty"  )
column=(type=decimal(10) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=long updatewhereclause=yes name=purordercatcode dbname="PurOrderHeader.PurOrderCatCode"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(150) updatewhereclause=yes name=genericitem dbname="GenericItem"  )
column=(type=char(100) updatewhereclause=yes name=itemdescription dbname="ItemDescription"  )
 retrieve="SELECT 
	I.name,
	itemalias=I.customicode,
	OH.POCode,
	OH.Date,
	Acc.Aliasname,
	Acc.name,
	S.address1,
	S.address2,
	S.city,
	S.phone,
	S.fax,
	OH.remarks,
	OH.Discperc,
	I.packingdesc,
	OD.rate,
	OD.qty,
	OD.bonusqty,
	OD.discperc,
	OD.reorderqty,
	OD.OptimumQty,
	OD.minQty,
	OD.Stock,
	OD.TransitStock,
	OD.SoldQty,
	OD.ReturnQty,
	amount= (OD.qty * OD.rate) * ( 1 - (OD.discperc * 0.01) ) ,
	OH.PurOrderCatCode,
	Manufacturer=(SELECT Manufacturer.Name FROM Manufacturer WHERE Manufacturer.ManfCode=I.ManfCode),
	Category=(SELECT ItemCategory.Name FROM ItemCategory WHERE ItemCategory.ICatCode=I.ICatCode),
	Packing=(SELECT ItemPacking.Name FROM ItemPacking WHERE ItemPacking.PackCode=I.PackCode),
	GenericItem=(SELECT GenericItem.Name FROM GenericItem WHERE GenericItem.GenericCode=I.GenericCode),
	ItemDescription=I.Remarks

FROM item I, accounts Acc, purorderheader OH, purorderdetail OD , Supplier S

WHERE OH.pocode = :ai_sPOCode AND
      OH.pocode=OD.pocode AND
		OH.suppCode = S.SuppCode AND
      OH.suppcode=Acc.acccode AND
      OD.icode=I.icode

order by oh.pocode, category, i.name, i.customicode, packing, manufacturer"
  arguments=(("ai_sPOCode", number))
 sort="pocode A, category A, genericitem A, manufacturer A, packingdesc A, item_name A, packing A"
)
