detail(height=92 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="ManfCode"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=char(60) updatewhereclause=yes name=itemclass dbname="ItemClass"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="ItemPacking"  )
column=(type=char(150) updatewhereclause=yes name=genericitem dbname="genericitem"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purPrice"  )
column=(type=long updatewhereclause=yes name=minqty dbname="minqty"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="SoldQty"  )
column=(type=decimal(4) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=decimal(4) updatewhereclause=yes name=transitstock dbname="TransitStock"  )
column=(type=long updatewhereclause=yes name=lastpurinvcode dbname="LastPurInvCode"  )
column=(type=datetime updatewhereclause=yes name=lastpurdate dbname="LastPurDate"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=packsalestax dbname="packsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=rpp dbname="rpp"  )
column=(type=decimal(5) updatewhereclause=yes name=packavgprice dbname="packavgprice"  )
 retrieve="SELECT
	aliasname=IT.customicode,
	IT.icode,
	IT.ManfCode, 
	Item=IT.name,
	Manufacturer=(SELECT MANF.name FROM Manufacturer MANF WHERE MANF.ManfCode = IT.ManfCode),
	ItemCategory=(SELECT CAT.name FROM ItemCategory CAT WHERE CAT.ICatCode = IT.ICatCode),
	ItemClass=(SELECT CLS.name FROM ItemClass CLS WHERE CLS.ICCode = IT.ICCode),
	ItemPacking=(SELECT IP.name FROM ItemPacking IP WHERE IP.PackCode = IT.PackCode),
	genericitem=(SELECT genericitem.name FROM genericitem WHERE genericitem.genericCode = IT.genericCode),
	IT.packunits,
	IT.purPrice,  
	IT.minqty,
	SoldQty = ISNULL(SUM(SL.SoldQty), 0),
	ReturnQty = ISNULL(SUM(SL.ReturnQty), 0),
	Stock = ISNULL((SELECT Stock=ISNULL(SUM(GD.CurrQty),0) 
		FROM Godowndetail GD WHERE IT.ICode = GD.ICode AND GD.GCode IN (SELECT G.Gcode FROM Godown G WHERE G.ConsiderStockInPO='Y')), 0),
	TransitStock = ISNULL(IT.transitstock, 0),
	LastPurInvCode = (SELECT MAX(P.PurInvCode) FROM PurDetail D, PurLedger P WHERE D.ICode = IT.ICode AND P.PurInvCode = D.PurInvCode AND P.Posted='Y'),
	LastPurDate = (SELECT MAX(P.Date) FROM PurDetail D, PurLedger P WHERE D.ICode = IT.ICode AND P.PurInvCode = D.PurInvCode AND P.Posted='Y'),
	gstperc=IT.gstperc1,
	packsalestax=IT.packsalestax,
	saleprice=IT.saleprice,
	rpp=IT.recentpurprice,
	packavgprice=ROUND(IT.avgprice * IT.packunits, 2)
FROM 
	(SELECT Icode, CustomICode, Name, MinQty, PackUnits, PurPrice, 
		TransitStock, ManfCode, ICatCode, ICCode, PackCode, Active,
		gstperc1, packsalestax, SalePrice, RecentPurPrice, AvgPrice, GenericCode
	FROM Item 
	WHERE 
		(Item.ManfCode IN (:ar_manfcode) OR 
			Item.icatcode in (:ar_icatcode) OR 
			Item.iccode in (:ar_iccode) OR 
			Item.PackCode in (:ar_packcode) OR 
			Item.NAME LIKE (:ar_itemlike)) AND 
		Item.Active=1 AND
		Item.GeneratePO = 'Y') IT
	LEFT OUTER JOIN
	(SELECT I.Icode, SoldQty = SUM(SD.LooseQty), ReturnQty = 0
	FROM 
		(SELECT Icode 
		FROM Item WHERE 
			(Item.ManfCode IN (:ar_manfcode) OR 
				Item.icatcode in (:ar_icatcode) OR 
				Item.iccode in (:ar_iccode) OR 
				Item.PackCode in (:ar_packcode) OR 
				Item.NAME LIKE (:ar_itemlike)) AND 
			Item.Active=1 AND
			Item.GeneratePO = 'Y') I,
		Saledetail SD, SaleLedger SL
	WHERE
		SL.ConsiderInPO = 'Y' AND
	   	I.ICode = SD.ICode AND 
		SL.Date >= :ar_StartDate AND 
		SL.Date <= :ar_EndDate AND
		SD.SaleInvCode = SL.SaleInvcode
	GROUP BY I.ICode
	UNION ALL
	SELECT I.Icode,	SoldQty = 0, ReturnQty = SUM(SD.LooseQty)
	FROM SRDetail SD, SRLedger SL, 
		(SELECT Icode 
		FROM Item WHERE 
			(Item.ManfCode IN (:ar_manfcode) OR 
			dbo.item.icatcode in (:ar_icatcode) OR 
			dbo.item.iccode in (:ar_iccode) OR 
			dbo.Item.PackCode in (:ar_packcode) OR 
			dbo.item.NAME LIKE (:ar_itemlike)) AND 
			dbo.Item.Active=1 AND
			dbo.Item.GeneratePO = 'Y') I
	WHERE
		SL.ConsiderInPO = 'Y' AND
	   	SD.ICode = I.ICode AND
		SL.Date >= :ar_StartDate AND 
		SL.Date <= :ar_EndDate AND
		SL.SRInvCode = SD.SRInvcode
	GROUP BY I.ICode
	UNION ALL
	SELECT I.Icode, SoldQty = SUM(SD.SaleQty), ReturnQty = SUM(ReturnQty)
	FROM 
		(SELECT Icode 
		FROM Item WHERE 
			(Item.ManfCode IN (:ar_manfcode) OR 
				Item.icatcode in (:ar_icatcode) OR 
				Item.iccode in (:ar_iccode) OR 
				Item.PackCode in (:ar_packcode) OR 
				Item.NAME LIKE (:ar_itemlike)) AND 
			Item.Active=1 AND
			Item.GeneratePO = 'Y') I,
		PreviousSaleHistory SD
	WHERE
 	  	I.ICode = SD.ICode AND 
		SD.Date >= :ar_StartDate AND 
		SD.Date <= :ar_EndDate
	GROUP BY I.ICode) AS SL ON (IT.ICode = SL.ICode)
	LEFT OUTER JOIN
	(SELECT Item.Icode, PurInvCode=MAX(P.PurInvCode), Date=MAX(P.Date)
	FROM Item, PurLedger P, PurDetail D
	WHERE 
		dbo.Fn_GetPreference('fetchlastpurinfoinpo')='Y' AND
		(Item.ManfCode IN (:ar_manfcode) OR 
			Item.icatcode in (:ar_icatcode) OR 
			Item.iccode in (:ar_iccode) OR 
			Item.PackCode in (:ar_packcode) OR 
			Item.NAME LIKE (:ar_itemlike)) AND 
		Item.Active=1 AND
		Item.GeneratePO = 'Y' AND 
		P.Posted='Y' AND
		Item.ICode = D.ICode AND
		P.PurInvCode = D.PurInvCode
	GROUP BY Item.ICode) AS Pur ON (IT.ICode = Pur.ICode)
GROUP BY
	IT.icode,
	IT.ManfCode,
	IT.Name,
	IT.customicode,
	IT.ManfCode,
	IT.ICatCode,
	IT.ICCode,
	IT.PackCode,
	IT.genericCode,
	IT.PackUnits,
	IT.purprice,
	IT.saleprice,
	IT.recentpurprice,
	IT.avgprice,
	IT.minqty,
	IT.transitstock,
	IT.gstperc1,
	IT.packsalestax
ORDER BY
	Manufacturer,
	ItemCategory,
	ItemClass,
	ItemPacking,
	IT.Name
"
  arguments=(("ar_manfcode", numberlist), ("ar_icatcode", numberlist), ("ar_iccode", numberlist), ("ar_packcode", numberlist), ("ar_itemlike", string), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
