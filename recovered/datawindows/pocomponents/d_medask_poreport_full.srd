detail(height=187 color="536870912" )
table(column=(type=char(30) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=purorderheader_pocode dbname="PurOrderHeader.POCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.Date"  )
column=(type=long updatewhereclause=yes name=purorderdetail_icode dbname="PurOrderDetail.ICode"  )
column=(type=decimal(4) updatewhereclause=yes name=purorderdetail_qty dbname="PurOrderDetail.Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="STOCK"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=long identity=yes updatewhereclause=yes name=purorderdetail_porowid dbname="PurOrderDetail.PORowID"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=datetime updatewhereclause=yes name=startdate dbname="startdate"  )
column=(type=datetime updatewhereclause=yes name=enddate dbname="enddate"  )
column=(type=long updatewhereclause=yes name=projectiondays dbname="projectiondays"  )
column=(type=long updatewhereclause=yes name=purordercatcode dbname="purordercatcode"  )
column=(type=char(150) updatewhereclause=yes name=terms1 dbname="terms1"  )
column=(type=char(150) updatewhereclause=yes name=terms2 dbname="terms2"  )
column=(type=char(150) updatewhereclause=yes name=terms3 dbname="terms3"  )
column=(type=char(150) updatewhereclause=yes name=terms4 dbname="terms4"  )
column=(type=char(150) updatewhereclause=yes name=terms5 dbname="terms5"  )
column=(type=char(150) updatewhereclause=yes name=terms6 dbname="terms6"  )
column=(type=char(150) updatewhereclause=yes name=terms7 dbname="terms7"  )
column=(type=char(150) updatewhereclause=yes name=terms8 dbname="terms8"  )
 retrieve="  SELECT customername='abcdefghijklmnopqrstuvwxyzabcd'  ,   
			itemname= item.name, 
         PurOrderHeader.POCode,   
         PurOrderHeader.Date,   
         PurOrderDetail.ICode,   
         PurOrderDetail.Qty,   
		 STOCK = ISNULL((SELECT SUM(GD.CurrQty) FROM GodownDetail GD WHERE GD.ICode = PurOrderDetail.ICode), 0),
         Accounts.Name,
			PurOrderDetail.PORowID,
			Manufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),
			startdate=PurOrderHeader.startdate,
			enddate=PurOrderHeader.enddate,
			projectiondays=PurOrderheader.Projectionperiod,
			purordercatcode=PurOrderHeader.purordercatcode,
			terms1 =purorderheader.purorderterms1,
			terms2 =purorderheader.purorderterms2,
			terms3 =purorderheader.purorderterms3,
			terms4 =purorderheader.purorderterms4,
			terms5 =purorderheader.purorderterms5,
			terms6 =purorderheader.purorderterms6,
			terms7 =purorderheader.purorderterms7,
			terms8 =purorderheader.purorderterms8
    FROM PurOrderDetail,    
         PurOrderHeader,   
         Accounts, 
         item 
   WHERE ( PurOrderHeader.POCode = PurOrderDetail.POCode ) and  
			( PurOrderDetail.icode = item.icode ) and  
         ( PurOrderHeader.SuppCode = Accounts.AccCode ) and  
         ( ( PurOrderHeader.POCode = :ra_POCode ) )    
ORDER BY
			manufacturer,
			itemname
 /*PurOrderDetail.PORowID
item.icatcode,
			item.packcode, 
			item.iccode

I.manfcode, I.PackCode, I.IcatCode, I.Iccode*/"
  arguments=(("ra_POCode", number))
)
