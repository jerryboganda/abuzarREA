footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=pocode dbname="PurOrderHeader.pocode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.date"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.name"  )
 retrieve="   SELECT purorderheader.pocode,   
         purorderheader.date,   
         accounts.name  
    FROM accounts,   
         purorderheader  
   WHERE ( purorderheader.suppcode = accounts.acccode )    

UNION

  SELECT pocode=NULL,   
         date=NULL,   
         name='[None]'  
"
 )
