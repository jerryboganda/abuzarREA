release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=2500 print.margin.bottom=1000 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2135 color="536870912" )
summary(height=697 color="536870912" )
footer(height=218 color="536870912" )
detail(height=250 color="536870912" )
table(column=(type=char(30) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=purorderheader_pocode dbname="PurOrderHeader.POCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.Date"  )
column=(type=long updatewhereclause=yes name=purorderdetail_icode dbname="PurOrderDetail.ICode"  )
column=(type=decimal(4) updatewhereclause=yes name=purorderdetail_qty dbname="PurOrderDetail.Qty"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=char(60) updatewhereclause=yes name=supplieradd1 dbname="supplieradd1"  )
column=(type=char(60) updatewhereclause=yes name=supplieradd2 dbname="supplieradd2"  )
column=(type=char(30) updatewhereclause=yes name=suppliercity dbname="suppliercity"  )
column=(type=long identity=yes updatewhereclause=yes name=purorderdetail_porowid dbname="PurOrderDetail.PORowID"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="PurOrderDetail.Rate"  )
 retrieve="  SELECT customername='abcdefghijklmnopqrstuvwxyzabcd'  ,   
			itemname= item.name, 
         PurOrderHeader.POCode,   
         PurOrderHeader.Date,   
         PurOrderDetail.ICode,   
         PurOrderDetail.Qty,   
         Accounts.Name,
			supplieradd1=(select address1 from supplier where suppcode=accounts.acccode),
			supplieradd2=(select address2 from supplier where suppcode=accounts.acccode),
			suppliercity=(select city from supplier where suppcode=accounts.acccode),
			PurOrderDetail.PORowID,
			PurOrderDetail.Rate
			
    FROM PurOrderDetail,    
         PurOrderHeader,   
         Accounts, 
         item 
   WHERE ( PurOrderHeader.POCode = PurOrderDetail.POCode ) and  
			( PurOrderDetail.icode = item.icode ) and  
         ( PurOrderHeader.SuppCode = Accounts.AccCode ) and  
         ( ( PurOrderHeader.POCode = :ra_POCode ) )    
ORDER BY PurOrderDetail.PORowID
"
  arguments=(("ra_POCode", number))
)
