header(height=2250 color="536870912" )
summary(height=2233 color="536870912" )
footer(height=0 color="536870912" )
detail(height=183 color="536870912" )
table(column=(type=char(50) updatewhereclause=yes name=demanddraftno dbname="demanddraftno"  )
column=(type=char(60) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="customicode"  )
column=(type=char(50) updatewhereclause=yes name=supplierreference dbname="supplierreference"  )
column=(type=datetime updatewhereclause=yes name=dated dbname="Dated"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(100) updatewhereclause=yes name=location dbname="location"  )
column=(type=long updatewhereclause=yes name=pocode dbname="PurOrderHeader.POCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.Date"  )
column=(type=long updatewhereclause=yes name=purorderdetail_icode dbname="PurOrderDetail.ICode"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="PurOrderDetail.Qty"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="soldqty"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc2 dbname="DiscPerc2"  )
column=(type=long identity=yes updatewhereclause=yes name=purorderdetail_porowid dbname="PurOrderDetail.PORowID"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=datetime updatewhereclause=yes name=startdate dbname="startdate"  )
column=(type=datetime updatewhereclause=yes name=enddate dbname="enddate"  )
column=(type=long updatewhereclause=yes name=projectiondays dbname="projectiondays"  )
column=(type=long updatewhereclause=yes name=purordercatcode dbname="purordercatcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(100) updatewhereclause=yes name=remarks2 dbname="Remarks2"  )
column=(type=char(100) updatewhereclause=yes name=remarks3 dbname="Remarks3"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms1 dbname="PurOrderTerms1"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms2 dbname="PurOrderTerms2"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms3 dbname="PurOrderTerms3"  )
column=(type=char(150) updatewhereclause=yes name=purorderterms4 dbname="PurOrderTerms4"  )
 retrieve="SELECT 
	demanddraftno = PurOrderHeader.demanddraftno,
	customername=(SELECT A.Name FROM Accounts A WHERE A.AccCode = PurOrderHeader.CustCode),
	amount=PurOrderHeader.Amount,
	customicode=item.customicode,
	supplierreference=PurOrderHeader.supplierreference,
	Dated = PurOrderHeader.Dated,
	itemname= item.name, 
	Packing = (SELECT IP.Name FROM ItemPacking IP WHERE IP.PackCode = Item.PackCode),
	location = item.location,
	PurOrderHeader.POCode,   
	PurOrderHeader.Date,   
	PurOrderDetail.ICode,   
	PurOrderDetail.Qty,   
	Accounts.Name,
	Address1 = S.Address1,
	Address2 = S.Address2,
	soldqty=PurOrderDetail.Soldqty,
	stock=PurOrderDetail.stock,
	rate=PurOrderDetail.rate,
	DiscPerc = PurOrderDetail.DiscPerc,
	DiscPerc2 = PurOrderDetail.DiscPerc2,
	PurOrderDetail.PORowID,
	Manufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),
	startdate=PurOrderHeader.startdate,
	enddate=PurOrderHeader.enddate,
	projectiondays=PurOrderheader.Projectionperiod,
	purordercatcode=PurOrderHeader.purordercatcode,
	Remarks = PurOrderHeader.Remarks,
	Remarks2 = PurOrderHeader.Remarks2,
	Remarks3 = PurOrderHeader.Remarks3,
	PurOrderTerms1 = PurOrderHeader.PurOrderTerms1,
	PurOrderTerms2 = PurOrderHeader.PurOrderTerms2,
	PurOrderTerms3 = PurOrderHeader.PurOrderTerms3,
	PurOrderTerms4 = PurOrderHeader.PurOrderTerms4
FROM 
	PurOrderDetail,    
	PurOrderHeader,   
	Accounts, 
	Supplier S,
	item 
WHERE 
	( PurOrderHeader.POCode = PurOrderDetail.POCode ) and  
	( PurOrderDetail.icode = item.icode ) and  
	( PurOrderHeader.SuppCode = Accounts.AccCode ) and  
	( Accounts.AccCode = S.SuppCode ) AND
	( ( PurOrderHeader.POCode = :ra_POCode ) )    
ORDER BY
	manufacturer,
	itemname
/*
	PurOrderDetail.PORowID
	item.icatcode,
	item.packcode, 
	item.iccode
	I.manfcode, I.PackCode, I.IcatCode, I.Iccode
*/"
  arguments=(("ra_POCode", number))
)
