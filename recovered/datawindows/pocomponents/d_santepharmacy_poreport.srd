table(column=(type=char(30) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=char(100) updatewhereclause=yes name=purtypename dbname="purtypename"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=itemcatname dbname="itemcatname"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=decimal(4) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=long updatewhereclause=yes name=stockpack dbname="stockpack"  )
column=(type=long updatewhereclause=yes name=stockloose dbname="stockloose"  )
column=(type=long updatewhereclause=yes name=netsaleqtypack dbname="netsaleqtypack"  )
column=(type=long updatewhereclause=yes name=netsaleqtyloose dbname="netsaleqtyloose"  )
column=(type=decimal(0) updatewhereclause=yes name=projectedsaleqty dbname="projectedsaleqty"  )
column=(type=long updatewhereclause=yes name=purorderheader_pocode dbname="PurOrderHeader.POCode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.Date"  )
column=(type=long updatewhereclause=yes name=purorderdetail_icode dbname="PurOrderDetail.ICode"  )
column=(type=decimal(4) updatewhereclause=yes name=orderqty dbname="orderqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=packrate dbname="packrate"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="reorderqty"  )
column=(type=long updatewhereclause=yes name=reorderqtypack dbname="reorderqtypack"  )
column=(type=char(1) updatewhereclause=yes name=reorderqtylooseorpack dbname="reorderqtylooseorpack"  )
column=(type=decimal(15) updatewhereclause=yes name=netqty dbname="netqty"  )
column=(type=decimal(2) updatewhereclause=yes name=poinvtotal dbname="poinvtotal"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=long identity=yes updatewhereclause=yes name=purorderdetail_porowid dbname="PurOrderDetail.PORowID"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=datetime updatewhereclause=yes name=startdate dbname="startdate"  )
column=(type=datetime updatewhereclause=yes name=enddate dbname="enddate"  )
column=(type=long updatewhereclause=yes name=projectiondays dbname="projectiondays"  )
column=(type=long updatewhereclause=yes name=purordercatcode dbname="purordercatcode"  )
 retrieve="  SELECT customername='abcdefghijklmnopqrstuvwxyzabcd'  ,   
			purtypename=(select name from purchasetype where purchasetype.purtypecode=POH.purtypecode),
			itemname= item.name,  
		itemcatname=(select name from itemcategory where itemcategory.icatcode=POH.icatcode),
		itemalias=item.customicode,
		saleprice=POD.saleprice ,
		packunits=POD.packunits,
		stock=POD.stock,
         stockpack=CAST (POD.stock AS INT)/ (CASE POD.packunits WHEN 0 THEN 1 ELSE POD.packunits END),
		 stockloose=CAST (POD.stock AS INT) % (CASE POD.packunits WHEN 0 THEN 1 ELSE POD.packunits END),
		netsaleqtypack=CAST ((POD.soldqty - POD.returnqty)  AS INT)/ (CASE POD.packunits WHEN 0 THEN 1 ELSE POD.packunits END),
		 netsaleqtyloose=CAST ((POD.soldqty - POD.returnqty) AS INT) % (CASE POD.packunits WHEN 0 THEN 1 ELSE POD.packunits END),
		projectedsaleqty=Ceiling(((POD.soldqty - POD.returnqty)/(case datediff(dd,POH.startdate,POH.enddate) when 0 then 1 else datediff(dd,POH.startdate,POH.enddate) end)) * POH.projectionperiod),
		 POH.POCode,   
		remarks=POH.remarks,
         POH.Date,   
         POD.ICode,   
         orderqty=POD.Qty,  
		bonusqty=POD.bonusqty,
		rate=POD.rate,
		packrate=POD.rate,
		reorderqty=POD.reorderqty,
		reorderqtypack=CASE CAST(POD.reorderqty AS INT) %  POD.packunits WHEN 0 THEN CAST(POD.reorderqty AS INT)% POD.packunits ELSE POD.reorderqty END,
		reorderqtylooseorpack=CASE CAST(POD.reorderqty AS INT) %  POD.packunits WHEN 0 THEN '' ELSE 'L' END,
		netqty=(case (POD.bonusqty + POD.Qty) when 0 
					then ((POD.optimumqty - POD.stock)/(case POD.packunits when 0 then 1 else POD.packunits end))
					 else (POD.bonusqty + POD.Qty) end),
         poinvtotal=dbo.fn_getPoinvtotal(:ra_SPOCode),
			Accounts.Name,
			POD.PORowID,
			Manufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),
			startdate=POH.startdate,
			enddate=POH.enddate,
			projectiondays=POH.Projectionperiod,
			purordercatcode=POH.purordercatcode
    FROM Purorderdetail POD,    
         purorderheader POH,   
         Accounts, 
         item 
   WHERE ( POH.POCode = :ra_SPOCode )   AND
			( POH.POCode = POD.POCode ) and  
			( POD.icode = item.icode ) and  
         ( POH.SuppCode = Accounts.AccCode ) 
      	
ORDER BY

 POH.POCode,
 POD.PORowID
"
  arguments=(("ra_SPOCode", number))
)
