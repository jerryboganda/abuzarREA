release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=620 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
 retrieve="SELECT 
	SuppCode= A.AccCode, 
	AliasName = A.AliasName,
	SupplierName = A.Name
FROM
	Accounts A,
	(SELECT 
		DISTINCT IPS.SuppCode
	FROM
		Item I,
		Manufacturer M,
		ItemSuppliers IPS, 
		(SELECT ManfCode 
		FROM Manufacturer
		WHERE
			POPolicyCode IN 
				(SELECT DISTINCT CP.POPolicyCode 
				FROM POPolicy CP, POPolicyDetail CPD
				WHERE 
					CP.POPolicyCode = CPD.POPolicyCode AND
					CPD.WeekDayCode = DatePart(weekday, :ad_orderdate) AND
					CPD.WeekOfMonth IN 
						(SELECT WeekOfMonth=DBO.Fn_WeekDayCountInMonth(:ad_orderdate)))) TM
	WHERE
		TM.ManfCode = M.ManfCode AND M.ManfCode = I.ManfCode AND I.ICode = IPS.ICode) T
WHERE A.AccCode=T.SuppCode
ORDER BY 
	SupplierName "
  arguments=(("ad_orderdate", datetime))
)
