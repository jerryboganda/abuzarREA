release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2291 color="536870912" )
summary(height=895 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912"  height.autosize=yes)
table(column=(type=char(30) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(20) updatewhereclause=yes name=itempacking dbname="itempacking"  )
column=(type=long updatewhereclause=yes name=purorderheader_pocode dbname="PurOrderHeader.POCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.Date"  )
column=(type=long updatewhereclause=yes name=purorderdetail_icode dbname="PurOrderDetail.ICode"  )
column=(type=decimal(4) updatewhereclause=yes name=purorderdetail_qty dbname="PurOrderDetail.Qty"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(4) updatewhereclause=yes name=stockinhand dbname="stockinhand"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="category"  )
column=(type=char(100) updatewhereclause=yes name=itemremarks dbname="itemremarks"  )
column=(type=decimal(4) updatewhereclause=yes name=monthlyconsumption dbname="monthlyconsumption"  )
column=(type=datetime updatewhereclause=yes name=lastreceiptdate dbname="lastreceiptdate"  )
column=(type=char(100) updatewhereclause=yes name=lastreceiptremarks dbname="lastreceiptremarks"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=long identity=yes updatewhereclause=yes name=purorderdetail_porowid dbname="PurOrderDetail.PORowID"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=datetime updatewhereclause=yes name=startdate dbname="startdate"  )
column=(type=datetime updatewhereclause=yes name=enddate dbname="enddate"  )
column=(type=long updatewhereclause=yes name=projectiondays dbname="projectiondays"  )
column=(type=long updatewhereclause=yes name=purordercatcode dbname="purordercatcode"  )
 retrieve="  SELECT customername='abcdefghijklmnopqrstuvwxyzabcd'  ,   
			itemname= item.name, 
		itempacking=(select name from itempacking where itempacking.packcode=item.packcode),
         PurOrderHeader.POCode,   
         PurOrderHeader.Date,   
         PurOrderDetail.ICode,   
         PurOrderDetail.Qty,
		Remarks=PurOrderheader.Remarks,
		stockinhand=stock,
		category=(select name from itemcategory where itemcategory.icatcode=item.icatcode), 
		 itemremarks=purorderdetail.remarks,
		monthlyconsumption=(select isnull(sum(ID.qty),0) 
									from issueheader IH, Issuedetail ID 
									where  /*IH.date> DATEADD(mm, - 1 , PurOrderHeader.Date) AND*/
												IH.date>rtrim(ltrim(str(MONTH( PurOrderHeader.Date))))+'/01/' +rtrim(ltrim(str(year( PurOrderHeader.Date)))) AND
												IH.date< PurOrderHeader.Date AND 
												IH.issueinvcode=ID.issueinvcode and
											ID.icode=PurOrderDetail.Icode),
		lastreceiptdate=(select max(RH.postdate) 
								from purledger RH, purdetail RD
								where RH.posted='Y' AND
										RH.purinvcode=RD.purinvcode AND
										 RD.icode=PurOrderDetail.Icode),
		lastreceiptremarks=(select max(RH.remarks) 
								from purledger RH, purdetail RD
								where RH.posted='Y' AND
										RH.purinvcode=RD.purinvcode AND
										 RD.icode=PurOrderDetail.Icode),
         Accounts.Name,
			PurOrderDetail.PORowID,
			Manufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),
			startdate=PurOrderHeader.startdate,
			enddate=PurOrderHeader.enddate,
			projectiondays=PurOrderheader.Projectionperiod,
			purordercatcode=PurOrderHeader.purordercatcode
    FROM PurOrderDetail,    
         PurOrderHeader,   
         Accounts, 
         item 
   WHERE ( PurOrderHeader.POCode = PurOrderDetail.POCode ) and  
			( PurOrderDetail.icode = item.icode ) and  
         ( PurOrderHeader.SuppCode = Accounts.AccCode ) and  
         ( ( PurOrderHeader.POCode = :ra_POCode ) )    
ORDER BY
			category,
			itemname
"
  arguments=(("ra_POCode", number))
)
