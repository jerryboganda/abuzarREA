release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=136 color="536870912" )
summary(height=0 color="536870912" )
footer(height=64 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(60) updatewhereclause=yes name=manufname dbname="manufname"  )
column=(type=long updatewhereclause=yes name=code dbname="PurOrderDetail.pocode"  )
column=(type=long updatewhereclause=yes name=icode dbname="PurOrderDetail.icode"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(GetText()) >=0" initial="0" name=rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=discperc dbname="discperc"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="PurOrderDetail.bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=long identity=yes updatewhereclause=yes name=purorderdetail_porowid dbname="PurOrderDetail.PORowID"  )
column=(type=decimal(4) updatewhereclause=yes validation=" Real(GetText()) > 0" initial="1" name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=decimal(2) updatewhereclause=yes name=invleveldiscperc dbname="invleveldiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="FlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="MiscCharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="InvGSTPerc1"  )
column=(type=decimal(2) updatewhereclause=yes name=packsalestax dbname="packsalestax"  )
column=(type=decimal(4) updatewhereclause=yes name=recentpurprice dbname="recentpurprice"  )
column=(type=decimal(4) updatewhereclause=yes name=saleprice dbname="saleprice"  )
 retrieve="SELECT 
	item.customicode,
	item.name, 
	manufname=manufacturer.name,
	purorderdetail.pocode,
	purorderdetail.icode,   
	packingdesc=item.packingdesc,
	rate = item.purprice,
	discperc = purorderdetail.discperc,
	purorderdetail.bonusqty,
	packunits = item.packunits,
	purorderdetail.PORowID,
	Qty=purorderdetail.qty,
	avgprice = purorderdetail.packavgprice,
	gstperc = purorderdetail.gstperc,
	gcode = item.gcode,
	invleveldiscperc=(select discperc from purorderheader where purorderheader.pocode=purorderdetail.pocode),
	FlatDisc=(select FlatDisc from purorderheader where purorderheader.pocode=purorderdetail.pocode),
	MiscCharges=(select MiscCharges from purorderheader where purorderheader.pocode=purorderdetail.pocode),
	InvGSTPerc1=(select InvGSTPerc1 from purorderheader where purorderheader.pocode=purorderdetail.pocode),
	packsalestax = purorderdetail.packsalestax,
	recentpurprice = purorderdetail.rpp,
	saleprice = purorderdetail.saleprice
FROM 
	purorderdetail,   
	item,
	manufacturer
WHERE 
	dbo.purorderdetail.pocode = :ra_POCode  and
	purorderdetail.icode = item.icode
ORDER BY 
	purorderdetail.PORowID"
  arguments=(("ra_POCode", number))
)
