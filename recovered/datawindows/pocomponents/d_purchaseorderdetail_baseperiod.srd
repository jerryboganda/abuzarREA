release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=132 color="536870912" )
summary(height=8 color="536870912" )
footer(height=64 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="PurOrderDetail.pocode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=manufname dbname="manufname"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="PurOrderDetail.icode"  )
column=(type=long update=yes updatewhereclause=yes validation="Integer(GetText() ) >= 0" initial="0" name=bonusqty dbname="PurOrderDetail.bonusqty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(GetText()) >=0" initial="0" name=rate dbname="PurOrderDetail.rate"  )
column=(type=long updatewhereclause=yes name=soldqty dbname="soldqty"  )
column=(type=long updatewhereclause=yes name=returnqty dbname="returnqty"  )
column=(type=long updatewhereclause=yes name=netsaleqty dbname="netsaleqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(5) updatewhereclause=yes name=avgsaleqty dbname="avgsaleqty"  )
column=(type=long updatewhereclause=yes name=forecastqty dbname="forecastqty"  )
column=(type=long updatewhereclause=yes name=stock dbname="stock"  )
column=(type=long identity=yes updatewhereclause=yes name=purorderdetail_porowid dbname="PurOrderDetail.PORowID"  )
column=(type=long updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long update=yes updatewhereclause=yes validation=" Real(GetText()) > 0" initial="1" name=qty dbname="PurOrderDetail.qty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(GetText()) >=0" initial="0" name=discperc dbname="PurOrderDetail.discperc"  )
 retrieve="  SELECT item.customicode,
			currlistrow = 0,
         purorderdetail.pocode,   
			itemname = item.name,
			manufname = manufacturer.name,
         purorderdetail.icode,   
         purorderdetail.bonusqty,   
         purorderdetail.rate,
		   soldqty = 0,
		   returnqty = 0,
		   netsaleqty=0,
		   packunits=item.packunits,
		   avgsaleqty = 0.00000,
		   forecastqty = 0,
		   stock = 0,
         purorderdetail.PORowID,   
		   looseqty = 0,
	 	   purorderdetail.qty,
	  	   purorderdetail.discperc 
			
			
    FROM purorderdetail,   
         item,
			manufacturer
  
   WHERE ( purorderdetail.icode = item.icode ) and  
         ( dbo.purorderdetail.pocode = :ra_POCode ) and
			( item.manfcode = manufacturer.manfcode )  
ORDER BY	purorderdetail.PORowID
"
  update="purorderdetail" updatewhere=2 updatekeyinplace=yes
  arguments=(("ra_POCode", number))
)
