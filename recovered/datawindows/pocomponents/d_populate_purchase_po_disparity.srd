release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=572 color="536870912" )
summary(height=76 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="ItemAliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=decimal(4) updatewhereclause=yes name=poqty dbname="POQty"  )
column=(type=decimal(4) updatewhereclause=yes name=pobonus dbname="POBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(4) updatewhereclause=yes name=purbonus dbname="PurBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=netqty dbname="NetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=netbonus dbname="NetBonus"  )
 retrieve="SELECT 
	ICode = I.ICode,
	ItemAliasName=I.CustomICode,
	ItemName=I.Name,
	Manufacturer=M.Name,
	POQty = ISNULL(SUM(Q.POQty), 0),
	POBonus = ISNULL(SUM(Q.POBonus), 0),
	PurQty = ISNULL(SUM(Q.PurQty), 0),
	PurBonus = ISNULL(SUM(Q.PurBonus), 0),
	NetQty = ISNULL(SUM(Q.POQty - Q.PurQty), 0),
	NetBonus = ISNULL(SUM(Q.POBonus - Q.PurBonus), 0)
FROM
	Item I,
	Manufacturer M,
	Accounts A,
	(SELECT 
		PurInvCode = PL.PurInvCode,
		POCode = PL.POCode,
		Date = PL.Date,
		Remarks = PL.Remarks,
		SuppCode = PL.SuppCode,
		ICode = POD.ICode,
		POQty = ISNULL(SUM(POD.Qty), 0),
		POBonus = ISNULL(SUM(POD.BonusQty), 0),
		PurQty = 0.0000,
		PurBonus = 0.0000
	FROM
		PurOrderDetail POD,
		PurOrderHeader POH,
		PurLedger PL
	WHERE
		PL.PurInvCode IN (:ai_purinvcode) AND
		PL.PurCatCode IN (1,2) AND
		PL.POCode IS NOT NULL AND
		PL.POCode = POH.POCode AND
		POH.POCode = POD.POCode AND
		POD.ICode NOT IN (SELECT ICode FROM PurDetail PD WHERE PD.PurInvCode = PL.PurInvCode)
	GROUP BY
		PL.PurInvCode,
		PL.Date,
		PL.Remarks,
		PL.SuppCode,
		PL.POCode,
		POD.ICode
	UNION ALL
	SELECT 
		PurInvCode = PL.PurInvCode,
		POCode=PL.POCode,
		Date = PL.Date,
		Remarks = PL.Remarks,
		SuppCode = PL.SuppCode,
		ICode = PD.ICode,
		POQty = ISNULL((SELECT SUM(POD.Qty) 
			FROM PurOrderDetail POD
			WHERE POD.POCode = PL.POCode AND
				PD.ICode = POD.ICode), 0),
		POBonus = ISNULL((SELECT SUM(POD.BonusQty) 
			FROM PurOrderDetail POD
			WHERE POD.POCode = PL.POCode AND
				PD.ICode = POD.ICode), 0),
		PurQty = ISNULL(SUM(PD.PackQty), 0),
		PurBonus = ISNULL(SUM(PD.BonusQty), 0)
	FROM
		PurDetail PD,
		PurLedger PL
	WHERE
		PL.PurInvCode IN (:ai_purinvcode) AND
		PL.POCode IS NOT NULL AND
		PL.PurCatCode IN (1,2) AND
		PL.PurInvCode = PD.PurInvCode
	GROUP BY
		PL.PurInvCode,
		PL.Date,
		PL.Remarks,
		PL.SuppCode,
		PL.POCode,
		PD.ICode) Q
WHERE
	( (Q.PurQty - Q.POQty) <> 0 OR (Q.PurBonus - Q.POBonus) <> 0) AND
	Q.ICode = I.ICode AND
	Q.SuppCode = A.AccCode AND
	I.ManfCode = M.ManfCode
GROUP BY
	Q.ICode,
	I.ICode,
	I.CustomICode, 
	I.Name,
	M.Name
ORDER BY
	I.Name
"
  arguments=(("ai_purinvcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="itemname A"
 filter=" netqty > 0 OR netbonus > 0"
 )
