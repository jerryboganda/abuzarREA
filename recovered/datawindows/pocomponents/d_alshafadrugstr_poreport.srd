release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=1000 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=937 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(15) updatewhereclause=yes name=type dbname="Type"  )
column=(type=char(60) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.Date"  )
column=(type=long updatewhereclause=yes name=purorderdetail_icode dbname="PurOrderDetail.ICode"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="Discperc"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(6) updatewhereclause=yes name=total dbname="Total"  )
 retrieve="SELECT 
	Type = '   ',
	customername=SPACE(60),   
	itemname= item.name, 
	Code=PurOrderHeader.POCode,   
	PurOrderHeader.Date,   
	PurOrderDetail.ICode,   
	Qty = PurOrderDetail.Qty,   
	Price = PurOrderDetail.PurPrice,   
	Discperc = PurOrderDetail.Discperc,   
	Accounts.Name,
	RowID=PurOrderDetail.PORowID,
	Manufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),
	Remarks = PurOrderHeader.Remarks,
	Total = ISNULL((SELECT ROUND(SUM(POD.QTY * POD.PurPrice * (1 - POD.DiscPerc * 0.01)), 0) FROM PurOrderDetail POD WHERE POD.POCode = PurOrderHeader.POCode), 0)
FROM PurOrderDetail,    
	PurOrderHeader,   
	Accounts, 
	item 
WHERE 
	PurOrderHeader.POCode = PurOrderDetail.POCode and  
	PurOrderDetail.icode = item.icode and  
	PurOrderHeader.SuppCode = Accounts.AccCode and  
	PurOrderHeader.POCode = :ra_POCode
UNION ALL
SELECT 
	Type = 'Expiry Reminder',
	customername=SPACE(60),   
	itemname= item.name, 
	Code=PRLedger.PRInvCode,   
	Date=PRLedger.Date,   
	ICode=PRDetail.ICode,   
	Qty = PRDetail.LooseQty,   
	Price = PRDetail.PRPrice,   
	Discperc = PRDetail.Discperc,   
	Accounts.Name,
	RowID = 999999999,
	Manufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),
	Remarks = PRLedger.Remarks,
	Total = ISNULL(
		(SELECT ROUND( ROUND(
					SUM(PD.LooseQty * PD.PRPrice * 
						(1 - PD.discperc * 0.01) * 
						(1 - PL.discperc * 0.01)) + PL.MiscCharges - PL.FlatDisc, 0) + 
				Round (
				/*invoice level salestax*/Round ( ( Round ( Sum ( Round ( ( PD.looseqty + PD.packqty ) * PD.prprice * (1 - PD.discperc * 0.01 ) , 2 ) )
				* ( 1 - PL.discperc * 0.01 ) , 2 ) - PL.flatdisc ) * PL.invgstperc1 * 0.01  , 2 )
				/*items salestax*/		 + Sum (Round ( (PD.looseqty + PD.packqty + PD.bonusqty)* PD.unitsalestax + Round ( Round ( (PD.looseqty + PD.packqty) * PD.prprice * (1 - PD.discperc * 0.01 ), 2 ) * PD.gstperc * 0.01 , 2 ) , 2 ) )						 
				, 0 ), 0)
		FROM PRLedger PL, PRDetail PD 
		WHERE PL.PRInvCode = PD.PRInvCode AND
			PL.PRInvCode = PRLedger.PRInvCode
		GROUP BY PL.MiscCharges, PL.FlatDisc, PL.DiscPerc, PL.InvGSTPErc1), 0)
FROM PRDetail,    
	PRLedger,   
	Accounts, 
	item 
WHERE 
	PRLedger.Posted='N' AND
	PRLedger.SuppCode IN 
		(SELECT DISTINCT PO.SuppCode
		FROM PurOrderHeader PO
		WHERE PO.POCode = :ra_POCode ) AND
	PRLedger.PRInvCode = PRDetail.PRInvCode and  
	PRDetail.ICode = item.icode and  
	PRLedger.SuppCode = Accounts.AccCode
ORDER BY 
	Type,
	Code,
	ItemName"
  arguments=(("ra_POCode", number))
 sort="type A, code A, itemname A"
)
