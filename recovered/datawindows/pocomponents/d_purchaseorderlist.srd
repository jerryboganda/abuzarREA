table(column=(type=long updatewhereclause=yes name=code dbname="PurOrderHeader.pocode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.date"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="PurOrderHeader.posted"  )
column=(type=char(50) updatewhereclause=yes name=category dbname="category"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="PurOrderHeader.remarks"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="postedby"  )
column=(type=char(1) updatewhereclause=yes name=marked dbname="Marked"  )
column=(type=long updatewhereclause=yes name=purcount dbname="PurCount"  )
column=(type=char(500) updatewhereclause=yes name=listofpurinvoices dbname="ListOfPurInvoices"  )
column=(type=decimal(2) updatewhereclause=yes name=totalofpurchases dbname="TotalOfPurchases"  )
column=(type=char(1) updatewhereclause=yes name=pushed dbname="Pushed" 
 values="Yes	Y/No	N/"  )
column=(type=datetime updatewhereclause=yes name=pushedon dbname="PushedOn"  )
column=(type=char(60) updatewhereclause=no name=pushedby dbname="PushedBy"  )
column=(type=char(203) updatewhereclause=no name=pushedfor dbname="PushedFor"  )
 retrieve="SELECT 
	purorderheader.pocode ,
	purorderheader.date ,
	accounts.name, 
	users.username,
	purorderheader.posted,
	category=purordercategory.name,
	purorderheader.remarks,
	postedby = (SELECT u.username FROM users u WHERE u.usercode = purorderheader.postedby ),
	Marked = PurOrderHeader.Marked,
	PurCount = (SELECT COUNT(P.POCode) FROM PurLedger P WHERE P.POCode=PurOrderHeader.POCode),
	ListOfPurInvoices = PurOrderHeader.ListOfPurInvoices,
	TotalOfPurchases = PurOrderHeader.TotalOfPurchases,
	Pushed=PurOrderHeader.Pushed,
	PushedOn=PurOrderHeader.PushedOn,
	PushedBy = (SELECT U.UserName FROM Users U WHERE U.UserCode=PurOrderHeader.PushedBy),
	PushedFor = IsNull((SELECT S.Name + ' (' + S.InstanceID + ')' FROM Site S WHERE S.SiteCode=PurOrderHeader.TargetSiteCode),'')
FROM 
	purorderheader , 
	accounts , 
	users,
	purordercategory     
	
WHERE 
	( purorderheader.suppcode = accounts.acccode )   AND
	( purorderheader.salesmancode = users.usercode) AND
	( purorderheader.purordercatcode = purordercategory.purordercatcode )"
 )
