detail(height=67 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(75) updatewhereclause=yes name=alternatecustomicode dbname="PurOrderDetail.alternatecustomicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(60) updatewhereclause=yes name=manufname dbname="manufname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long updatewhereclause=yes name=code dbname="PurOrderDetail.pocode"  )
column=(type=long updatewhereclause=yes name=icode dbname="PurOrderDetail.icode"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="reorderqty"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes name=optimumqty dbname="optimumqty"  )
column=(type=decimal(5) updatewhereclause=yes name=foreignprice dbname="foreignprice"  )
column=(type=long updatewhereclause=yes name=currencycode dbname="currencycode"  )
column=(type=decimal(5) updatewhereclause=yes name=conversionfactor dbname="conversionfactor"  )
column=(type=decimal(4) updatewhereclause=yes name=purprice dbname="PurPrice"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(GetText()) >=0" initial="0" name=rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc2 dbname="discperc2"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="PurOrderDetail.bonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=long identity=yes updatewhereclause=yes name=purorderdetail_porowid dbname="PurOrderDetail.PORowID"  )
column=(type=decimal(4) updatewhereclause=yes validation=" Real(GetText()) > 0" initial="1" name=qty dbname="PurOrderDetail.qty"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=decimal(2) updatewhereclause=yes name=invleveldiscperc dbname="invleveldiscperc"  )
column=(type=decimal(4) updatewhereclause=yes name=reqqty dbname="reqqty"  )
column=(type=decimal(4) updatewhereclause=yes name=reqbonusqty dbname="reqbonusqty"  )
column=(type=decimal(4) updatewhereclause=yes name=qtysatisfied dbname="qtysatisfied"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqtysatisfied dbname="bonusqtysatisfied"  )
column=(type=decimal(2) updatewhereclause=yes name=packsalestax dbname="packsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=recentpurprice dbname="recentpurprice"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="invgstperc1"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
 retrieve="SELECT 
	item.customicode,
	purorderdetail.alternatecustomicode,
	item.name, 
	manufname=manufacturer.name,
	currlistrow = 0,
	purorderdetail.pocode,
	purorderdetail.icode,   
	reorderqty = 0,
	stock = 0.0000,
	packingdesc=item.packingdesc,
	optimumqty = 0,
	foreignprice = purorderdetail.foreignprice,
	currencycode = (select h.currencycode from purorderheader h where h.pocode = purorderdetail.pocode),
	conversionfactor = (select h.conversionfactor from purorderheader h where h.pocode = purorderdetail.pocode),
	/*rate = item.purprice,*/
	PurPrice=purorderdetail.PurPrice,
	rate=purorderdetail.rate,
	discperc = purorderdetail.discperc,
	discperc2 =purorderdetail.discperc2,
	purorderdetail.bonusqty,
	looseqty = 0.0000,
	packunits = purorderdetail.packunits,
	purorderdetail.PORowID,
	purorderdetail.qty,
	avgprice = item.avgprice,
	gstperc = item.gstperc1,
	gcode = item.gcode,
	invleveldiscperc=(select discperc from purorderheader where purorderheader.pocode=purorderdetail.pocode),
	reqqty = Case When (purorderdetail.qtysatisfied >= purorderdetail.qty) THEN 0 Else (purorderdetail.qty - purorderdetail.qtysatisfied) END,
	reqbonusqty = Case When (purorderdetail.bonusqtysatisfied >= purorderdetail.bonusqty) THEN 0 Else (purorderdetail.bonusqty - purorderdetail.bonusqtysatisfied) END,
	qtysatisfied=purorderdetail.qtysatisfied,
	bonusqtysatisfied=purorderdetail.bonusqtysatisfied,
	packsalestax = item.packsalestax,
	recentpurprice = item.recentpurprice,
	invgstperc1=(select invgstperc1 from purorderheader where purorderheader.pocode=purorderdetail.pocode),
	saleprice = item.saleprice
FROM 
	purorderdetail,   
	item,
	manufacturer
WHERE 
	( dbo.purorderdetail.pocode = :ra_POCode )   and
	( purorderdetail.icode = item.icode ) and  
	( item.manfcode = manufacturer.manfcode ) and
	( purorderdetail.qty > purorderdetail.qtysatisfied or purorderdetail.bonusqty > purorderdetail.bonusqtysatisfied )
ORDER BY 
	purorderdetail.PORowID"
  arguments=(("ra_POCode", number))
)
