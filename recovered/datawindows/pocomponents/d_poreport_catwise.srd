release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=1000 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1406 color="536870912" )
summary(height=218 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=char(30) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=purorderheader_pocode dbname="PurOrderHeader.POCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.Date"  )
column=(type=long updatewhereclause=yes name=purorderdetail_icode dbname="PurOrderDetail.ICode"  )
column=(type=decimal(4) updatewhereclause=yes name=purorderdetail_qty dbname="PurOrderDetail.Qty"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.Name"  )
column=(type=long identity=yes updatewhereclause=yes name=purorderdetail_porowid dbname="PurOrderDetail.PORowID"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
 retrieve="  SELECT customername='abcdefghijklmnopqrstuvwxyzabcd',
			itemname= item.name,
         PurOrderHeader.POCode,   
         PurOrderHeader.Date,   
         PurOrderDetail.ICode,   
         PurOrderDetail.Qty,   
         Accounts.Name, 
			PurOrderDetail.PORowID,
			Manufacturer=(select Manufacturer.name from Manufacturer where Manufacturer.manfcode=item.manfcode),
			Category=(select ItemCategory.name from ItemCategory where ItemCategory.icatcode=item.icatcode)

    FROM PurOrderDetail,   
         PurOrderHeader,   
         Accounts, 
         item 
  
   WHERE ( PurOrderHeader.POCode = PurOrderDetail.POCode ) and  
			( PurOrderDetail.icode = item.icode ) and  
         ( PurOrderHeader.SuppCode = Accounts.AccCode ) and  
         ( ( PurOrderHeader.POCode = :ra_POCode ) )    


ORDER BY Category, itemname

/*item.icatcode,
			item.packcode, 
			item.iccode

I.manfcode, I.PackCode, I.IcatCode, I.Iccode*/"
  arguments=(("ra_POCode", number))
 sort="category A, itemname A"
)
group(level=1 header.height=187 trailer.height=0 by=("category"  ) header.color="536870912" trailer.color="536870912" )
