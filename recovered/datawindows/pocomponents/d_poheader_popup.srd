 values="Yes	1/No	0/"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=startdate dbname="PurOrderHeader.startdate"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=enddate dbname="PurOrderHeader.EndDate"  )
column=(type=char(50) updatewhereclause=yes name=demanddraftno dbname="PurOrderHeader.demanddraftno"  )
column=(type=datetime updatewhereclause=yes name=dated dbname="PurOrderHeader.dated"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="PurOrderHeader.amount"  )
column=(type=long updatewhereclause=yes name=custcode dbname="PurOrderHeader.custcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes initial="2" name=purordercatcode dbname="PurOrderHeader.PurOrderCatCode"  )
 retrieve="SELECT 
	purorderheader.ManfCode,   
	purorderheader.SuppCode,   
	purorderheader.Date,   
	purorderheader.POCode,
	dbo.purorderheader.salesmancode,
	dbo.purorderheader.remarks,  
	dbo.purorderheader.purorderterms1,  
	dbo.purorderheader.purorderterms2,
	dbo.purorderheader.purorderterms3,  
	dbo.purorderheader.purorderterms4,  
	dbo.purorderheader.purorderterms5,  
	dbo.purorderheader.purorderterms6,  
	dbo.purorderheader.purorderterms7,  
	dbo.purorderheader.purorderterms8,  
	dbo.users.username,     
	dbo.purorderheader.projectionperiod,
	dbo.purorderheader.ZeroQty,
	dbo.purorderheader.startdate,
	dbo.purorderheader.EndDate,
	dbo.purorderheader.demanddraftno,
	dbo.purorderheader.dated,
	dbo.purorderheader.amount,
	dbo.purorderheader.custcode,
	dbo.purorderheader.PurOrderCatCode

FROM 
	purorderheader,   
	users  
WHERE 
	dbo.purorderheader.salesmancode = dbo.users.usercode AND  
	( dbo.purorderheader.pocode = :ra_pocode )
"
  arguments=(("ra_pocode", number))
)
