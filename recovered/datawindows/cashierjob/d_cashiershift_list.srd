table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="CashierShift.CashierShiftCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=openedon dbname="CashierShift.OpenedOn"  )
column=(type=datetime updatewhereclause=yes name=closedon dbname="CashierShift.ClosedOn"  )
column=(type=char(60) update=yes updatewhereclause=yes name=openedby dbname="OpenedBy"  )
column=(type=char(60) updatewhereclause=yes name=closedby dbname="ClosedBy"  )
column=(type=long update=yes updatewhereclause=yes name=shiftowner dbname="CashierShift.ShiftOwner" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes name=shiftstatus dbname="CashierShift.ShiftStatus" 
 values="Open	O/Closed	C/"  )
column=(type=long update=yes updatewhereclause=yes name=cashacccode dbname="CashierShift.CashAccCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=openingbalance dbname="CashierShift.OpeningBalance"  )
 retrieve="SELECT 
	CashierShiftCode,
	OpenedOn,
	ClosedOn,
	OpenedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=CashierShift.OpenedBy),
	ClosedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=CashierShift.ClosedBy),
	ShiftOwner,
	ShiftStatus,
	CashAccCode,
	OpeningBalance
FROM 
	CashierShift
WHERE 
	ShiftOwner IN 
		(SELECT :ai_usercode FROM Users WHERE Users.UserCode=:ai_usercode)
UNION
SELECT 
	CashierShiftCode,
	OpenedOn,
	ClosedOn,
	OpenedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=CashierShift.OpenedBy),
	ClosedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=CashierShift.ClosedBy),
	ShiftOwner,
	ShiftStatus,
	CashAccCode,
	OpeningBalance
FROM 
	CashierShift
WHERE 
	dbo.fn_GetGroupCode(:ai_usercode) = 2
UNION
SELECT 
	CashierShiftCode,
	OpenedOn,
	ClosedOn,
	OpenedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=CashierShift.OpenedBy),
	ClosedBy=(SELECT U.UserName FROM Users U WHERE U.UserCode=CashierShift.ClosedBy),
	ShiftOwner,
	ShiftStatus,
	CashAccCode,
	OpeningBalance
FROM 
	CashierShift
WHERE 
	ShiftOwner IN (SELECT UserCode FROM UserGroups WHERE GroupCode IN
	(select allowedgroupcode 
	from groupallowedgroups
	where module=1 and groupcode = dbo.fn_GetGroupCode(:ai_usercode)))
"
  update="CashierShift" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_usercode", number))
 sort="code D"
)
