 values=""  )
column=(type=long update=yes updatewhereclause=yes name=jobowner dbname="CashierJob.JobOwner" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=active dbname="CashierJob.Active" 
 values="Yes	Y/No	N/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="CashierJob.Remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=showsuperviseddocuments dbname="CashierJob.ShowSupervisedDocuments" 
 values="Yes	Y/No	N/"  )
column=(type=char(500) update=yes updatewhereclause=yes name=defaultfiltercriteria dbname="CashierJob.DefaultFilterCriteria"  )
 retrieve="SELECT 
	CashierJob.CashierJobCode,
	CashierJob.Date,
	CashierJob.UserCode,
	CashierJob.JobOwner,
	CashierJob.Active,
	CashierJob.Remarks,
	CashierJob.ShowSupervisedDocuments,
	CashierJob.DefaultFilterCriteria
FROM 
	CashierJob
WHERE
	CashierJob.CashierJobCode = :ai_code
"
  update="CashierJob" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
