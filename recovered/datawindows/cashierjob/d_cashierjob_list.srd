table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="CashierJob.CashierJobCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="CashierJob.Date"  )
column=(type=char(60) update=yes updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(60) update=yes updatewhereclause=yes name=jobowner dbname="JobOwner"  )
column=(type=char(1) update=yes updatewhereclause=yes name=active dbname="CashierJob.Active" 
 values="Yes	Y/No	N/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="CashierJob.Remarks"  )
 retrieve="SELECT 
	CashierJob.CashierJobCode,
	CashierJob.Date,
	UserName = (SELECT Users.UserName FROM Users WHERE Users.UserCode=CashierJob.UserCode),
	JobOwner = (SELECT Users.UserName FROM Users WHERE Users.UserCode=CashierJob.JobOwner),
	CashierJob.Active,
	CashierJob.Remarks
FROM 
	CashierJob
"
  update="CashierJob" updatewhere=1 updatekeyinplace=no
 )
