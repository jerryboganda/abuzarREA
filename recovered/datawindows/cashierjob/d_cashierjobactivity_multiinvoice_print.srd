table(column=(type=long key=yes identity=yes update=yes updatewhereclause=yes name=rowid dbname="CashierActivity.RowID"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="CashierActivity.Date"  )
column=(type=long update=yes updatewhereclause=yes name=moduleid dbname="CashierActivity.ModuleID"  )
column=(type=long update=yes updatewhereclause=yes name=module dbname="Module" 
 values="Sale	1/S//R	2/"  )
column=(type=long update=yes updatewhereclause=yes name=catcode dbname="CashierActivity.CatCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=category dbname="CashierActivity.Category"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="CashierActivity.AccCode"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="CashierActivity.UserCode" 
 values=""  )
column=(type=char(20) update=yes updatewhereclause=yes name=machinename dbname="CashierActivity.MachineName"  )
column=(type=long update=yes updatewhereclause=yes name=headerno dbname="CashierActivity.HeaderNo"  )
column=(type=long update=yes updatewhereclause=yes name=headerinvno dbname="CashierActivity.HeaderInvNo"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=amount dbname="CashierActivity.Amount"  )
column=(type=long update=yes updatewhereclause=yes name=cashacccode dbname="CashierActivity.CashAccCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=cashtendered dbname="CashierActivity.CashTendered"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=cashcharged dbname="CashierActivity.CashCharged"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=cashback dbname="CashierActivity.CashBack"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="CashierActivity.Remarks"  )
column=(type=long update=yes updatewhereclause=yes name=cashierjobcode dbname="CashierActivity.CashierJobCode"  )
column=(type=char(1) update=yes updatewhereclause=yes name=printed dbname="CashierActivity.Printed"  )
column=(type=char(1) update=yes updatewhereclause=yes name=supervised dbname="CashierActivity.Supervised"  )
column=(type=datetime update=yes updatewhereclause=yes name=supervisedon dbname="CashierActivity.SupervisedOn"  )
column=(type=long update=yes updatewhereclause=yes name=glvochcode dbname="CashierActivity.GLVochCode"  )
column=(type=long update=yes updatewhereclause=yes name=doccode dbname="CashierActivity.DocCode"  )
 retrieve="SELECT 
	CashierActivity.RowID,   
	Date,
	CashierActivity.ModuleID, 
	Module=CASE WHEN CashierActivity.ModuleID <= 11 THEN 1 WHEN CashierActivity.ModuleID <= 34 THEN 2 ELSE CashierActivity.ModuleID END,
	CatCode,
	Category,
	AccCode,
	UserCode,
	MachineName,
	HeaderNo,
	HeaderInvNo,
	CashierActivity.Amount,
	CashAccCode,
	CashTendered,
	CashCharged,
	CashBack,
	Remarks,
	CashierJobCode,
	Printed,
	Supervised,
	SupervisedOn,
	GLVochCode,
	CashierActivity.DocCode
FROM 
	CashierActivity
WHERE 
	CashierActivity.RowID IN (:ai_rowid)
"
  update="CashierActivity" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_rowid", numberlist), ("ad_cashtend", number))
 sort="module A, doccode A"
)
