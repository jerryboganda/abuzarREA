table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="CashierShiftCashCount.CashierShiftCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes initial="1" name=currencycode dbname="CashierShiftCashCount.CurrencyCode"  )
column=(type=char(1) key=yes update=yes updatewhereclause=yes initial="C" name=type dbname="CashierShiftCashCount.Type" 
 values="Coin	C/Note	N/"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="CashierShiftCashCount.Name"  )
column=(type=decimal(2) key=yes update=yes updatewhereclause=yes initial="1" name=denomination dbname="CashierShiftCashCount.Denomination"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid value'" initial="0" name=qty dbname="CashierShiftCashCount.Qty"  )
 retrieve="  SELECT CashierShiftCashCount.CashierShiftCode,   
         CashierShiftCashCount.CurrencyCode,   
         CashierShiftCashCount.Type,   
         CashierShiftCashCount.Name,   
         CashierShiftCashCount.Denomination,   
         CashierShiftCashCount.Qty  
    FROM CashierShiftCashCount  
   WHERE CashierShiftCashCount.CashierShiftCode = :ai_code    
"
  update="CashierShiftCashCount" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
