release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=10 color="536870912" )
footer(height=0 color="536870912" )
detail(height=1666 color="536870912" )
table(column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=long updatewhereclause=yes name=doccode dbname="DocCode"  )
column=(type=long updatewhereclause=yes name=moduleid dbname="ModuleID"  )
column=(type=long updatewhereclause=yes name=catcode dbname="CatCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=category dbname="Category"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="UserCode"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes name=printed dbname="Printed"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(20) update=yes updatewhereclause=yes name=machinename dbname="MachineName"  )
column=(type=decimal(4) updatewhereclause=yes name=totalqty dbname="TotalQty"  )
 retrieve="SELECT
	RowID = RowId,
	DocCode = DocCode,
	ModuleID = ModuleID,
	CatCode = CatCode,
	Category = Category,
	AccCode = AccCode,
	AccountName = (SELECT A.Name FROM Accounts A WHERE A.AccCode = CashierActivity.AccCode),
	UserCode=UserCode,   
	UserName = (SELECT U.UserName FROM Users U WHERE U.UserCode = CashierActivity.UserCode),
	Amount=Amount, 
	Remarks=Remarks,   
	Printed=Printed,   
	Date=Date,
	MachineName=MachineName,
	TotalQty = ISNULL((
		CASE 
		WHEN ModuleID IN (1) THEN (SELECT SUM(LooseQty + BonusQty) FROM SaleDetail WHERE SaleInvCode=CashierActivity.DocCode)
		WHEN ModuleID IN (1) THEN (SELECT SUM(LooseQty + BonusQty) FROM SRDetail WHERE SRInvCode=CashierActivity.DocCode)
		ELSE 0 END), 0)
FROM CashierActivity
WHERE RowID IN (:ai_docrowid)
ORDER BY DocCode, RowID
"
  arguments=(("ai_docrowid", number))
)
group(level=1 header.height=0 trailer.height=0 by=(""  ) header.color="536870912" trailer.color="536870912" )
text(name=t_3 visible="1" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="0" border="0" x="20" y="250" height="166" width="3447" text="............................................" html.valueishtml="0" )
text(name=t_1 visible="1" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="0" border="0" x="31" y="656" height="166" width="3447" text="	'Doc. No.: ' + Left(trim(string(doccode, '###,###,##0')), 9) + '     ' + 'Machine: ' + LEFT(machinename, 15)" html.valueishtml="0" )
text(name=t_username visible="1" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="0" border="0" x="31" y="1052" height="166" width="3447" text="	'User: ' + LEFT(username, 15)" html.valueishtml="0" )
text(name=t_totalqty visible="1	if(totalqty=0, 0, 1)" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="0" border="0" x="31" y="854" height="166" width="3447" text="	'Total Qty: ' + LEFT(string(totalqty, '##,###,##0'), 10) + '     Amount: ' + LEFT(string( amount , '###,###,##0.00'), 15)" html.valueishtml="0" )
text(name=t_date visible="1" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="0" border="0" x="31" y="458" height="166" width="3447" text="	Category + SPACE(5) + 'Date: ' + LEFT(string(date, 'dd/mm/yyyy hh:mm'), 20)" html.valueishtml="0" )
text(name=t_2 visible="1" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="0" border="0" x="20" y="1250" height="166" width="3447" text="............................................" html.valueishtml="0" )
