table(column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=long updatewhereclause=yes name=refreshtime dbname="RefreshTime"  )
column=(type=char(100) updatewhereclause=yes name=refreshtimeleft dbname="RefreshTimeLeft"  )
column=(type=datetime updatewhereclause=yes name=startdate dbname="StartDate"  )
column=(type=datetime updatewhereclause=yes name=enddate dbname="EndDate"  )
column=(type=long updatewhereclause=yes name=activityperiod dbname="ActivityPeriod"  )
column=(type=char(100) updatewhereclause=yes name=selectiontotal dbname="SelectionTotal"  )
 retrieve="SELECT 
	InvoiceCode=NULL,
	RefreshTime=(SELECT A=DBO.Fn_Get_Int_Preference('defaultrefreshtimeincashieract')), 
	RefreshTimeLeft=SPACE(100),
	StartDate=DATEADD(mi, -1 * (SELECT A=DBO.Fn_Get_Int_Preference('ActMonPeriod')), GETDATE()),
	EndDate=GETDATE(),
	ActivityPeriod=(SELECT A=DBO.Fn_Get_Int_Preference('ActMonPeriod')),
	SelectionTotal=SPACE(100)
"
 )
