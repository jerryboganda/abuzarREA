column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=creditservice dbname="CashierShift.CreditService"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=cashservicereturn dbname="CashierShift.CashServiceReturn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=creditservicereturn dbname="CashierShift.CreditServiceReturn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=totalreceipts dbname="CashierShift.TotalReceipts"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=totalpayments dbname="CashierShift.TotalPayments"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=netamt dbname="CashierShift.NetAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=diffamt dbname="CashierShift.DiffAmt"  )
column=(type=long update=yes updatewhereclause=yes name=difftransferedto dbname="CashierShift.DiffTransferedTo"  )
 retrieve="SELECT 
	CashierShiftCode,
	OpenedOn,
	ClosedOn,
	OpenedBy,
	ClosedBy,
	ShiftOwner,
	ShiftStatus,
	CashAccCode,
	OpeningBalance,
	TotalAmount,
	AmtTransfered,
	AmtTransferedTo,
	AmtTransferedOn,
	Remarks,
	RefNo,
	CashSales,
	CreditSales,
	CashSR,
	CreditSR,
	CashService,
	CreditService,
	CashServiceReturn,
	CreditServiceReturn,
	TotalReceipts,
	TotalPayments,
	NetAmt,
	DiffAmt,
	DiffTransferedTo
FROM 
	CashierShift
WHERE 
	CashierShiftCode=:ai_code"
  update="CashierShift" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
