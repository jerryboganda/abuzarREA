release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1677 color="536870912" )
summary(height=229 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=long updatewhereclause=yes name=moduleid dbname="ModuleID"  )
column=(type=char(30) updatewhereclause=yes name=module dbname="Module"  )
column=(type=char(100) updatewhereclause=yes name=category dbname="Category"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=decimal(2) updatewhereclause=yes name=cashtendered dbname="CashTendered"  )
column=(type=decimal(2) updatewhereclause=yes name=cashcharged dbname="CashCharged"  )
column=(type=decimal(2) updatewhereclause=yes name=cashback dbname="CashBack"  )
column=(type=long updatewhereclause=yes name=cashierjobcode dbname="CashierJobCode"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
column=(type=datetime updatewhereclause=yes name=inactivedate dbname="InActiveDate"  )
column=(type=char(60) updatewhereclause=yes name=cashiername dbname="CashierName"  )
 retrieve="SELECT
	GroupName = T.GroupName,
	ModuleID = T.Module,
	Module = (SELECT M.Name FROM Module M WHERE M.Module = T.Module),
	Category=T.Category,
	Amount=SUM(T.Amount),
	CashTendered=SUM(T.CashTendered),
	CashCharged=SUM(T.CashCharged),
	CashBack=SUM(T.CashBack),
	CashierJobCode=T.CashierJobCode,
	Active=T.Active,
	InActiveDate=T.InActiveDate,
	CashierName=T.CashierName
FROM
	(SELECT 
		GroupName = CASE WHEN CashierActivity.ModuleID <= 11 THEN 'SALES' WHEN CashierActivity.ModuleID <= 32 THEN 'SALES RETURN' ELSE 'TRANSACTION VOUCHERS' END,
		Module = CASE WHEN CashierActivity.ModuleID <= 11 THEN 1 WHEN CashierActivity.ModuleID <= 32 THEN 2 ELSE CashierActivity.ModuleID END,
		ModuleID=CashierActivity.ModuleID,
		Category=CashierActivity.Category,
		Amount=SUM(CashierActivity.Amount),
		CashTendered=SUM(CashierActivity.CashTendered),
		CashCharged=SUM(CashierActivity.CashCharged),
		CashBack=SUM(CashierActivity.CashBack),
		CashierJobCode=CashierActivity.CashierJobCode,
		Active=CashierJob.Active,
		InActiveDate=CashierJob.InActiveDate,
		CashierName=Users.UserName
	FROM 
		CashierActivity, CashierJob, Users
	WHERE 
		CashierJob.CashierJobCode = :ai_code AND
		CashierJob.CashierJobCode = CashierActivity.CashierJobCode AND
		CashierJob.JobOwner = Users.UserCode
	GROUP BY
		CashierActivity.Category,
		CashierActivity.ModuleID,
		CashierActivity.CashierJobCode,
		CashierJob.Active,
		CashierJob.InActiveDate,
		Users.UserName) T
GROUP BY
		T.GroupName,
		T.Module,
		T.Category,
		T.CashierJobCode,
		T.Active,
		T.InActiveDate,
		T.CashierName
ORDER BY
	GroupName,
	Category"
  arguments=(("ai_code", number))
 sort="groupname A"
)
