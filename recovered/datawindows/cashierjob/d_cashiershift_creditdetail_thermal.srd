table(column=(type=long updatewhereclause=yes name=code dbname="CashierShiftCode"  )
column=(type=datetime updatewhereclause=yes name=openedon dbname="OpenedOn"  )
column=(type=datetime updatewhereclause=yes name=closedon dbname="ClosedOn"  )
column=(type=long updatewhereclause=yes name=openedby dbname="OpenedBy" 
 values=""  )
column=(type=long updatewhereclause=yes name=closedby dbname="ClosedBy" 
 values=""  )
column=(type=long updatewhereclause=yes name=shiftowner dbname="ShiftOwner" 
 values=""  )
column=(type=char(1) updatewhereclause=no name=shiftstatus dbname="ShiftStatus"  )
column=(type=long updatewhereclause=yes name=cashacccode dbname="CashAccCode" 
 values=""  )
column=(type=char(13) updatewhereclause=yes name=type dbname="Type"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SaleLedger.Date"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="SaleLedger.InvTotal"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
 retrieve="SELECT 
	CashierShiftCode = (SELECT CashierShiftCode FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	OpenedOn = (SELECT OpenedOn FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode), 
	ClosedOn = (SELECT ClosedOn FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	OpenedBy = (SELECT OpenedBy FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	ClosedBy = (SELECT ClosedBy FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	ShiftOwner = (SELECT ShiftOwner FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	ShiftStatus = (SELECT ShiftStatus FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	CashAccCode = (SELECT CashAccCode FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	Type = 'Sales', 
	InvoiceCode=SaleInvCode, 
	Date,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = S.CustCode),
	InvTotal,
	Balance = S.InvTotal - S.Amt - S.CashCharged
FROM SaleLedger S 
WHERE S.Posted='Y' AND S.SaleCatCode <> 3 AND S.CashierShiftCode=:ai_shiftcode
UNION ALL
SELECT 
	CashierShiftCode = (SELECT CashierShiftCode FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	OpenedOn = (SELECT OpenedOn FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode), 
	ClosedOn = (SELECT ClosedOn FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	OpenedBy = (SELECT OpenedBy FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	ClosedBy = (SELECT ClosedBy FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	ShiftOwner = (SELECT ShiftOwner FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	ShiftStatus = (SELECT ShiftStatus FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	CashAccCode = (SELECT CashAccCode FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	Type = 'Sales Return', 
	InvoiceCode=SRInvCode, 
	Date,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = S.CustCode),
	InvTotal,
	Balance = S.InvTotal - S.Amt - S.CashCharged
FROM SRLedger S 
WHERE S.Posted='Y' AND S.SRCatCode <> 8 AND S.CashierShiftCode=:ai_shiftcode
UNION ALL
SELECT 
	CashierShiftCode = (SELECT CashierShiftCode FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	OpenedOn = (SELECT OpenedOn FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode), 
	ClosedOn = (SELECT ClosedOn FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	OpenedBy = (SELECT OpenedBy FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	ClosedBy = (SELECT ClosedBy FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	ShiftOwner = (SELECT ShiftOwner FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	ShiftStatus = (SELECT ShiftStatus FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	CashAccCode = (SELECT CashAccCode FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	Type = 'Service Sales', 
	InvoiceCode=ServiceInvCode, 
	Date,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = S.CustCode),
	InvTotal,
	Balance = S.InvTotal - S.CashCharged
FROM ServiceHeader S 
WHERE S.Posted='Y' AND S.ServiceCatCode <> 10 AND S.CashierShiftCode=:ai_shiftcode
UNION ALL
SELECT 
	CashierShiftCode = (SELECT CashierShiftCode FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	OpenedOn = (SELECT OpenedOn FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode), 
	ClosedOn = (SELECT ClosedOn FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	OpenedBy = (SELECT OpenedBy FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	ClosedBy = (SELECT ClosedBy FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	ShiftOwner = (SELECT ShiftOwner FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	ShiftStatus = (SELECT ShiftStatus FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	CashAccCode = (SELECT CashAccCode FROM CashierShift WHERE CashierShiftCode=:ai_shiftcode),
	Type = 'Service S/R', 
	InvoiceCode=ServiceRInvCode, 
	Date,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = S.CustCode),
	InvTotal,
	Balance = S.InvTotal - S.CashCharged
FROM ServiceRHeader S 
WHERE S.Posted='Y' AND S.ServiceRCatCode <> 13 AND S.CashierShiftCode=:ai_shiftcode
"
  arguments=(("ai_shiftcode", number))
 sort="type A, customer A, invoicecode A"
)
