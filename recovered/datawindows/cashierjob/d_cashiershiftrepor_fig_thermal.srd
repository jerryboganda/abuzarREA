table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="CashierShift.CashierShiftCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=openedon dbname="CashierShift.OpenedOn"  )
column=(type=datetime update=yes updatewhereclause=yes name=closedon dbname="CashierShift.ClosedOn"  )
column=(type=long update=yes updatewhereclause=yes name=openedby dbname="CashierShift.OpenedBy"  )
column=(type=long update=yes updatewhereclause=yes name=shiftowner dbname="CashierShift.ShiftOwner"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="O" name=shiftstatus dbname="CashierShift.ShiftStatus"  )
column=(type=long update=yes updatewhereclause=yes name=cashacccode dbname="CashierShift.CashAccCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=openingbalance dbname="CashierShift.OpeningBalance"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=totalamount dbname="TotalAmount"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Amount Transferred must be a valid amount~"" initial="0.00" name=amttransfered dbname="CashierShift.AmtTransfered"  )
column=(type=long update=yes updatewhereclause=yes name=amttransferedto dbname="CashierShift.AmtTransferedTo" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=amttransferedon dbname="CashierShift.AmtTransferedOn"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="CashierShift.Remarks"  )
column=(type=char(20) update=yes updatewhereclause=yes name=refno dbname="CashierShift.RefNo"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter a valid amount~"" initial="0.00" name=cashsales dbname="CashSales"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter a valid amount~"" initial="0.00" name=creditsales dbname="CreditSales"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter a valid amount~"" initial="0.00" name=cashsr dbname="CashSR"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter a valid amount~"" initial="0.00" name=creditsr dbname="CreditSR"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter a valid amount~"" initial="0.00" name=cashservice dbname="CashService"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter a valid amount~"" initial="0.00" name=creditservice dbname="CreditService"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter a valid amount~"" initial="0.00" name=cashservicereturn dbname="CashServiceReturn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter a valid amount~"" initial="0.00" name=creditservicereturn dbname="CreditServiceReturn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter a valid amount~"" initial="0.00" name=totalreceipts dbname="TotalReceipts"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter a valid amount~"" initial="0.00" name=totalpayments dbname="TotalPayments"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter a valid amount~"" initial="0.00" name=netamt dbname="NetAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=diffamt dbname="DiffAmt"  )
column=(type=long update=yes updatewhereclause=yes initial="42" name=difftransferedto dbname="CashierShift.DiffTransferedTo"  )
 retrieve="SELECT 
	CashierShiftCode,
	OpenedOn,
	ClosedOn,
	OpenedBy,
	ShiftOwner,
	ShiftStatus,
	CashAccCode,
	OpeningBalance,
	TotalAmount=	ISNULL((SELECT SUM(CSC.Qty * CSC.Denomination) FROM  CashierShiftCashCount CSC WHERE CSC.CashierShiftCode=CashierShift.CashierShiftCode), 0),
	AmtTransfered,
	AmtTransferedTo,
	AmtTransferedOn,
	Remarks,
	RefNo,
	CashSales=ISNULL((SELECT SUM(S.InvTotal) FROM SaleLedger S WHERE S.Posted='Y' AND S.SaleCatCode = 3 AND S.CashierShiftCode=CashierShift.CashierShiftCode), 0),
	CreditSales=ISNULL((SELECT SUM(S.InvTotal - S.Amt - S.CashCharged) FROM SaleLedger S WHERE S.Posted='Y' AND S.SaleCatCode <> 3 AND S.CashierShiftCode=CashierShift.CashierShiftCode), 0),
	CashSR=ISNULL((SELECT a=SUM(a)
		FROM
			(SELECT a=SUM(S.InvTotal) FROM SRLedger S WHERE S.Posted='Y' AND S.SRCatCode = 8 AND S.CashierShiftCode=CashierShift.CashierShiftCode 
			UNION ALL
			SELECT a=SUM(S.InvTotal) FROM SRBufferLedger S WHERE S.Posted='Y' AND S.SRCatCode = 8 AND S.CashierShiftCode=CashierShift.CashierShiftCode) T
		), 0),
	CreditSR=ISNULL((SELECT SUM(S.InvTotal - S.CashCharged) FROM SRLedger S WHERE S.Posted='Y' AND S.SRCatCode <> 8 AND S.CashierShiftCode=CashierShift.CashierShiftCode), 0),
	CashService=ISNULL((SELECT SUM(S.InvTotal) FROM ServiceHeader S WHERE S.Posted='Y' AND S.ServiceCatCode = 10 AND S.CashierShiftCode=CashierShift.CashierShiftCode), 0),
	CreditService=ISNULL((SELECT SUM(S.InvTotal - S.CashCharged) FROM ServiceHeader S WHERE S.Posted='Y' AND S.ServiceCatCode <> 10 AND S.CashierShiftCode=CashierShift.CashierShiftCode), 0),
	CashServiceReturn=ISNULL((SELECT SUM(S.InvTotal) FROM ServiceRHeader S WHERE S.Posted='Y' AND S.ServiceRCatCode = 13 AND S.CashierShiftCode=CashierShift.CashierShiftCode), 0),
	CreditServiceReturn=ISNULL((SELECT SUM(S.InvTotal - S.CashCharged) FROM ServiceRHeader S WHERE S.Posted='Y' AND S.Posted='Y' AND S.ServiceRCatCode <> 13 AND S.CashierShiftCode=CashierShift.CashierShiftCode), 0),
	TotalReceipts=CASE ShiftStatus WHEN 'O' THEN ISNULL((SELECT SUM(GD.Debit) FROM GLDetail GD, GLHeader GL WHERE GL.Posted='Y' AND  GL.Date BETWEEN CashierShift.OpenedOn AND ISNULL(CashierShift.ClosedOn, GETDATE()) AND GL.GLVochCode = GD.GLVochCode AND GD.AccCode = CashierShift.CashAccCode), 0) ELSE ISNULL(TotalReceipts,0) END,
	TotalPayments=CASE ShiftStatus WHEN 'O' THEN ISNULL((SELECT SUM(GD.Credit) FROM GLDetail GD, GLHeader GL WHERE GL.Posted='Y' AND  GL.Date BETWEEN CashierShift.OpenedOn AND ISNULL(CashierShift.ClosedOn, GETDATE()) AND GL.GLVochCode = GD.GLVochCode AND GD.AccCode = CashierShift.CashAccCode), 0) ELSE ISNULL(TotalPayments,0) END,
	NetAmt= NetAmt,
	DiffAmt = DiffAmt,
	DiffTransferedTo
FROM 
	CashierShift
WHERE 
	CashierShiftCode=:ai_code"
  update="CashierShift" updatewhere=0 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
