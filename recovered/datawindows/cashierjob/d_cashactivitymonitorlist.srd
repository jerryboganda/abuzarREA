table(column=(type=char(1) updatewhereclause=yes initial="N" name=selected dbname="Selected" 
 values="	Y/	N"  )
column=(type=long key=yes identity=yes updatewhereclause=yes name=rowid dbname="CashierActivity.RowId"  )
column=(type=datetime updatewhereclause=yes initial="today" name=date dbname="CashierActivity.Date"  )
column=(type=long updatewhereclause=yes name=moduleid dbname="CashierActivity.ModuleID" 
 values=""  )
column=(type=long updatewhereclause=yes name=doccode dbname="CashierActivity.DocCode"  )
column=(type=long updatewhereclause=yes initial="1" name=catcode dbname="CashierActivity.CatCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes initial="Cash" name=category dbname="CashierActivity.Category"  )
column=(type=long updatewhereclause=yes name=acccode dbname="CashierActivity.AccCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=usercode dbname="CashierActivity.UserCode" 
 values=""  )
column=(type=char(20) updatewhereclause=yes name=machinename dbname="CashierActivity.MachineName"  )
column=(type=long updatewhereclause=yes initial="1" name=headerno dbname="CashierActivity.HeaderNo"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="CashierActivity.HeaderInvNo"  )
column=(type=decimal(2) updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid amount~"" initial="0" name=amount dbname="CashierActivity.Amount"  )
column=(type=long updatewhereclause=yes initial="2" name=cashacccode dbname="CashierActivity.CashAccCode" 
 values=""  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=cashtendered dbname="CashierActivity.CashTendered"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=cashcharged dbname="CashierActivity.CashCharged"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=cashback dbname="CashierActivity.CashBack"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="CashierActivity.Remarks"  )
column=(type=long updatewhereclause=yes name=cashierjobcode dbname="CashierActivity.CashierJobCode"  )
column=(type=long updatewhereclause=yes name=glvochcode dbname="CashierActivity.GLVochCode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=printed dbname="CashierActivity.Printed"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=posted dbname="Posted" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=supervised dbname="CashierActivity.Supervised" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT
	Selected='N',
	RowId,
	Date,
	ModuleID,   
	DocCode,   
	CatCode,
	Category,
	AccCode,
	UserCode,   
	MachineName,
	HeaderNo,
	HeaderInvNo,
	Amount, 
	CashAccCode,
	CashTendered,
	CashCharged,
	CashBack,
	Remarks,   
	CashierJobCode,
	GLVochCode,
	Printed,  
	Posted = 
		CASE ModuleID
		WHEN 1 THEN (SELECT S.Posted FROM SaleLedger S WHERE S.SaleInvCode=CashierActivity.DocCode)
		WHEN 2 THEN (SELECT S.Posted FROM SRLedger S WHERE S.SRInvCode=CashierActivity.DocCode)
		WHEN 22 THEN (SELECT S.Posted FROM ServiceHeader S WHERE S.ServiceInvCode=CashierActivity.DocCode)
		ELSE 'Y' END,
	Supervised
FROM 
	CashierActivity
WHERE 
	(CashierJobCode IS NULL OR CashierJobCode=:ai_jobcode) AND
	(ModuleID IN (SELECT ModuleID FROM CashierJobModule WHERE CashierJobCode=:ai_jobcode)) AND
	(Supervised = CASE WHEN (SELECT CJ.ShowSupervisedDocuments FROM CashierJob CJ WHERE CJ.CashierJobCode=:ai_jobcode)='Y' THEN Supervised ELSE 'N' END)
ORDER BY 
	Date DESC"
  update="CashierActivity" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_jobcode", number))
 sort="date D"
)
