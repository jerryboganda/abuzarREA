table(column=(type=char(20) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=long updatewhereclause=yes name=moduleid dbname="ModuleID" 
 values=""  )
column=(type=char(30) updatewhereclause=yes name=module dbname="Module"  )
column=(type=long updatewhereclause=yes name=doccode dbname="DocCode"  )
column=(type=long updatewhereclause=yes name=catcode dbname="CatCode"  )
column=(type=char(100) updatewhereclause=yes name=category dbname="Category"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(20) updatewhereclause=yes name=machinename dbname="MachineName"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=char(21) updatewhereclause=yes name=headerinvno dbname="HeaderInvNo"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=long updatewhereclause=yes name=cashacccode dbname="CashAccCode"  )
column=(type=decimal(2) updatewhereclause=yes name=cashtendered dbname="CashTendered"  )
column=(type=decimal(2) updatewhereclause=yes name=cashcharged dbname="CashCharged"  )
column=(type=decimal(2) updatewhereclause=yes name=cashback dbname="CashBack"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
column=(type=datetime updatewhereclause=yes name=inactivedate dbname="InActiveDate"  )
column=(type=long updatewhereclause=yes name=cashierjobcode dbname="CashierJobCode"  )
column=(type=char(60) updatewhereclause=yes name=cashiername dbname="CashierName"  )
column=(type=long updatewhereclause=yes name=glvochcode dbname="GLVochCode"  )
 retrieve="SELECT
	GroupName = CASE WHEN CashierActivity.ModuleID <= 11 THEN 'SALES' WHEN CashierActivity.ModuleID <= 32 THEN 'SALES RETURN' ELSE 'TRANSACTION VOUCHERS' END,
	Date=CashierActivity.Date,   
	PostDate = CASE WHEN CashierActivity.ModuleID <= 11 THEN  (SELECT MAX(S.PostDate) FROM SaleLedger S WHERE S.SaleInvCode=CashierActivity.DocCode) WHEN CashierActivity.ModuleID <= 32 THEN (SELECT MAX(S.PostDate) FROM SRLedger S WHERE S.SRInvCode=CashierActivity.DocCode) ELSE NULL END,
	ModuleID=CashierActivity.ModuleID,   
	Module = (SELECT M.Name FROM Module M WHERE M.Module = CashierActivity.ModuleID),
	DocCode=CashierActivity.DocCode,   
	CatCode=CashierActivity.CatCode,   
	Category=CashierActivity.Category,   
	AccCode=CashierActivity.AccCode,   
	AccountName = Accounts.Name,
	MachineName=CashierActivity.MachineName,   
	HeaderNo=CashierActivity.HeaderNo,   
	HeaderInvNo=LTRIM(RTRIM(CAST(CashierActivity.HeaderNo AS VARCHAR(10)))) + '-' + LTRIM(RTRIM(CAST(CashierActivity.HeaderInvNo AS VARCHAR(10)))),
	Amount=CashierActivity.Amount,   
	CashAccCode=CashierActivity.CashAccCode,   
	CashTendered=CashierActivity.CashTendered,   
	CashCharged=CashierActivity.CashCharged,   
	CashBack=CashierActivity.CashBack,   
	Remarks=CashierActivity.Remarks,   
	Active = CashierJob.Active,
	InActiveDate = CashierJob.InActiveDate,
	CashierJobCode=CashierActivity.CashierJobCode,   
	CashierName=Users.UserName,
	GLVochCode=CashierActivity.GLVochCode
FROM 
	CashierActivity, CashierJob, Users, Accounts
WHERE 
	CashierJob.CashierJobCode = :ai_code AND
	CashierJob.CashierJobCode = CashierActivity.CashierJobCode AND
	CashierActivity.AccCode = Accounts.AccCode AND
	CashierJob.JobOwner = Users.UserCode
ORDER BY Date"
  arguments=(("ai_code", number))
 sort="groupname A, category A, date A"
)
