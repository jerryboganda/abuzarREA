table(column=(type=long key=yes updatewhereclause=yes name=receiptinvcode dbname="ReceiptHeader.receiptinvcode"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=decimal(9) updatewhereclause=yes initial="0" name=total dbname="total"  )
 retrieve="  SELECT dbo.receiptheader.receiptinvcode,   
			icode=0,
			stock=0.0000,
			totalstock=0.0000,
			total=(SELECT SUM(D.Qty * D.Price) FROM ReceiptDetail D WHERE D.ReceiptInvCode = :al_ReceiptInvCode)
  FROM   dbo.receiptheader   
  WHERE 	dbo.receiptheader.ReceiptInvCode = :al_ReceiptInvCode
"
  update="receiptheader" updatewhere=0 updatekeyinplace=no
  arguments=(("al_ReceiptInvCode", number))
)
