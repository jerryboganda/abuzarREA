table(column=(type=long key=yes updatewhereclause=yes name=receiptinvcode dbname="ReceiptHeader.ReceiptInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ReceiptHeader.Date"  )
column=(type=long updatewhereclause=yes name=recipienttypecode dbname="RecipientTypeCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=recipientcode dbname="RecipientCode"  )
column=(type=char(60) updatewhereclause=yes name=recipientname dbname="RecipientName"  )
column=(type=long updatewhereclause=yes name=headerno dbname="ReceiptHeader.HeaderNo"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="ReceiptHeader.HeaderInvNo"  )
column=(type=char(60) update=yes updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ReceiptHeader.Remarks"  )
column=(type=char(1) updatewhereclause=yes name=selected dbname="SELECTED" 
 values="	Y/	N"  )
column=(type=char(9) update=yes updatewhereclause=yes name=status dbname="Status" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted" 
 values="No	N/Yes	Y/"  )
 retrieve="SELECT 
	RH.ReceiptInvCode,
	RH.Date, 
	RecipientTypeCode = RH.RecipientCode,
	RecipientCode = 
		CASE RH.RecipientCode 
			WHEN 1 THEN RH.DeptCode 
			WHEN 4 THEN RH.RecipientSalesMan 
			ELSE RH.AccCode 
		END,
	RecipientName = 
		CASE RH.RecipientCode 
		WHEN 1 THEN 
			(SELECT D.Name FROM Department D WHERE D.DeptCode = RH.DeptCode) 
			WHEN 4 THEN (SELECT S.Name FROM SalesMan S WHERE S.SalesManCode = RH.RecipientSalesMan)  
			ELSE (SELECT A.Name FROM Accounts A WHERE A.AccCode = RH.AccCode)  END,
	RH.HeaderNo, 
	RH.HeaderInvNo, 
	UserName=(SELECT users.username FROM users where users.usercode = RH.SalesManCode),
	RH.Remarks,
	SELECTED='N',
	Status=CASE WHEN (SELECT SUM(rd.qty - CASE WHEN d.packqty = 0 THEN (d.looseqty + d.bonusqty) ELSE ((d.packqty + d.bonusqty) * d.packunits) END) FROM proformapurdetail d, Receiptdetail rd WHERE rd.Receiptinvcode = RH.ReceiptInvcode AND rd.receiptutn = d.Receiptrowid) <= 0 THEN 'Populated' ELSE 'Pending' END,
	Posted=RH.Posted
FROM
	ReceiptHeader RH
WHERE 
	RH.Posted = 'Y' AND 
	RH.RecipientCode = :ai_recipienttypecode AND
	RH.AccCode = :ai_recipientcode
ORDER BY
	RH.ReceiptInvCode"
  update="ReceiptHeader" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_recipienttypecode", number), ("ai_recipientcode", number))
 sort="date A"
)
