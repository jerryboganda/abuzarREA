table(column=(type=long updatewhereclause=yes name=code dbname="ReceiptHeader.Receiptinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="ReceiptHeader.date"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="ReceiptHeader.remarks"  )
column=(type=char(100) updatewhereclause=yes name=referenceno dbname="ReceiptHeader.Referenceno"  )
column=(type=datetime updatewhereclause=yes name=referencedate dbname="ReceiptHeader.Referencedate"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=issueinvcode dbname="IssueInvCode"  )
column=(type=char(60) updatewhereclause=yes name=recipientname dbname="recipientName"  )
column=(type=char(60) updatewhereclause=no name=recipientaccountname dbname="RecipientAccountName"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=long updatewhereclause=yes name=prodcode dbname="ProdCode"  )
column=(type=long updatewhereclause=yes name=prodnotecode dbname="ProdNoteCode"  )
column=(type=long updatewhereclause=yes name=receiptcode dbname="ReceiptCode"  )
 retrieve="SELECT 
	ReceiptHeader.Receiptinvcode , 
	ReceiptHeader.date , 
	ReceiptHeader.remarks , 
	ReceiptHeader.Referenceno, 
	ReceiptHeader.Referencedate, 
	username=dbo.users.username,
	posted = ReceiptHeader.posted,
	IssueInvCode=ReceiptHeader.IssueInvCode,
	recipientName=(case receiptheader.recipientcode 
							when 2 then
							 	(select name from accounts where accounts.acccode=receiptheader.acccode)
							 when 3 then
								 (select name from accounts where accounts.acccode=receiptheader.acccode)
							 when 4 then
								 (select name from salesman where salesman.salesmancode=receiptheader.recipientsalesman)
							  when 1 then
								 (select  name from department where department.deptcode=receiptheader.deptcode)
							end),
	RecipientAccountName = 	(select name from accounts where accounts.acccode=receiptheader.cracccode),
	PostedBy = IsNull((Select username from users 
		where dbo.ReceiptHeader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
		where dbo.ReceiptHeader.modifiedby = dbo.users.usercode), ''),
	ProdCode = (SELECT MAX(ProdHeader.ProdCode) FROM ProdHeader WHERE ProdHeader.Receiptinvcode = ReceiptHeader.Receiptinvcode),
	ProdNoteCode = (SELECT MAX(ProdNote.ProdNoteCode) FROM ProdNote WHERE ProdNote.Receiptinvcode = ReceiptHeader.Receiptinvcode),
	ReceiptCode = dbo.ReceiptHeader.ReceiptCode
FROM
	users,
	ReceiptHeader

WHERE
	( dbo.ReceiptHeader.ReceiptCategoryCode = :ai_receiptcategorycode ) AND
	( dbo.ReceiptHeader.Posted In (:as_Posted)) AND
	( dbo.ReceiptHeader.salesmancode = dbo.users.usercode ) AND
	(dbo.ReceiptHeader.HeaderNo IS NULL OR 
	(dbo.ReceiptHeader.HeaderNo IN 
		(SELECT HeaderCode FROM GroupAllowedHeader 
			WHERE GroupCode = :ai_GroupCode AND Module=:ai_Module)))"
  arguments=(("as_Posted", stringlist), ("ai_GroupCode", number), ("ai_Module", number), ("ai_receiptcategorycode", number))
)
