table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ReceiptCategory.ReceiptCategoryCode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="ReceiptCategory.Name"  )
column=(type=char(10) update=yes updatewhereclause=yes name=shortname dbname="ReceiptCategory.ShortName"  )
column=(type=char(255) update=yes updatewhereclause=yes name=description dbname="ReceiptCategory.Description"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=accountfor dbname="ReceiptCategory.AccountFor" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=posted dbname="ReceiptCategory.Posted" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=counter dbname="ReceiptCategory.Counter"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=enabled dbname="ReceiptCategory.Enabled" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT
	ReceiptCategoryCode,
	Name,
	ShortName,
	Description,
	AccountFor,
	Posted,
	Counter,
	Enabled
FROM
	ReceiptCategory
WHERE 
	ReceiptCategoryCode=:ai_code
"
  update="ReceiptCategory" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
