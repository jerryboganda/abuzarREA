table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="customicode"  )
column=(type=char(75) updatewhereclause=yes name=alternatecustomicode dbname="alternatecustomicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="name"  )
column=(type=char(140) updatewhereclause=yes name=compute_0002 dbname="compute_0002"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(5) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(4) updatewhereclause=yes name=issueqty dbname="IssueQty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(4) updatewhereclause=yes name=receivedqty dbname="ReceivedQty"  )
column=(type=long updatewhereclause=yes name=totalpieces dbname="TotalPieces"  )
column=(type=long updatewhereclause=yes name=receivedtotalpieces dbname="ReceivedTotalPieces"  )
column=(type=long updatewhereclause=yes name=issuerowid dbname="IssueRowID"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=char(100) updatewhereclause=yes name=itemdesc dbname="itemdesc"  )
 retrieve=" SELECT 
	customicode,
	alternatecustomicode,
	name, 
	compute_0002, 
	icode, 
	gcode, 
	batch, 
	expiry,
	saleprice, 
	discperc=0.00,
	IssueQty=SUM(qty),
	BonusQty=0.0000,	 
	packunits, 
	ReceivedQty, 
	TotalPieces = SUM(TotalPieces),
	ReceivedTotalPieces = SUM(ReceivedTotalPieces),
	IssueRowID=IssRowID,
	avgprice,
	itemdesc=max(itemdesc)
FROM 
	(SELECT 
		dbo.item.name, 
		dbo.item.name + space(70) + str(Issuedetail.IssRowID) as compute_0002, 
		dbo.item.icode,
		dbo.item.customicode,
		dbo.issuedetail.alternatecustomicode,
		dbo.issuedetail.gcode,
		dbo.issuedetail.batch,
		dbo.issuedetail.expiry,
		saleprice=dbo.issuedetail.price,
		dbo.issuedetail.qty,
		dbo.issuedetail.packunits,
		dbo.issuedetail.TotalPieces,
		dbo.issuedetail.PiecesInHand,
		ReceivedTotalPieces = (SELECT IsNull(Sum(receiptdetail.TotalPieces), 0.0000)
				FROM   	receiptheader, receiptdetail
				WHERE  	receiptheader.issueinvcode = issuedetail.IssueInvCode    and
					receiptheader.receiptinvcode   = receiptdetail.receiptInvCode and
					receiptdetail.IssueRowID = dbo.Issuedetail.IssRowID),
		ReceivedQty = (SELECT IsNull(Sum(receiptdetail.Qty), 0.0000)
				FROM   	receiptheader, receiptdetail
				WHERE  	receiptheader.issueinvcode = issuedetail.IssueInvCode    and
					receiptheader.receiptinvcode   = receiptdetail.receiptInvCode and
					receiptdetail.IssueRowID = dbo.Issuedetail.IssRowID),
		 issuedetail.IssRowID,
		 itemdesc=dbo.issuedetail.itemdescription,
		 AvgPrice=issuedetail.AvgPrice
	FROM 
		dbo.item, dbo.issuedetail
	WHERE 
		( issuedetail.issueinvcode = :ar_issueInvCode ) and
		( item.icode = issuedetail.icode )) AS TMP
GROUP BY 
	icode, 
	name, 
	compute_0002, 
	customicode, 
	alternatecustomicode,
	gcode, 
	batch, 
	expiry, 
	saleprice, 
	packunits, 
	ReceivedQty,
	avgprice,
	IssRowID
ORDER BY 
	name, 
	batch,
	expiry"
  arguments=(("ar_IssueInvCode", number))
)
