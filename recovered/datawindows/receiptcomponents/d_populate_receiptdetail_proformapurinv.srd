release 12.5;
datawindow ( units=0 timer_interval=60000 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=68 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=totalstock dbname="totalstock"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="ReceiptDetail.receiptinvcode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=gcode dbname="ReceiptDetail.gcode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="ReceiptDetail.icode"  )
column=(type=char(100) update=yes updatewhereclause=yes validation="gettext()<>''" validationmsg="'Please type batch number'" initial="." name=batch dbname="ReceiptDetail.batch"  )
column=(type=datetime update=yes updatewhereclause=yes name=expiry dbname="ReceiptDetail.expiry"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Price should be greater than zero'" initial="0" name=price dbname="ReceiptDetail.price"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) > 0" name=packunits dbname="ReceiptDetail.packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) > 0" name=purchaseprice dbname="ReceiptDetail.purchaseprice"  )
column=(type=long update=yes updatewhereclause=yes initial="10" name=priority dbname="ReceiptDetail.priority"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0.0" name=avgprice dbname="ReceiptDetail.avgprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.0" name=mrpp dbname="ReceiptDetail.mrpp"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleprice dbname="ReceiptDetail.saleprice"  )
column=(type=long update=yes updatewhereclause=yes name=sectcode dbname="ReceiptDetail.Sectcode" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes name=updateavgprice dbname="ReceiptDetail.UpdateAvgPrice" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=newavgprice dbname="ReceiptDetail.NewAvgPrice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes name=currstock dbname="ReceiptDetail.CurrStock"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=receiptutn dbname="receiptutn"  )
column=(type=decimal(4) updatewhereclause=yes name=populatedqty dbname="populatedqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="real(gettext()) > 0" validationmsg="~"Quantity should be greater than zero~"" initial="1" name=qty dbname="ReceiptDetail.qty"  )
 retrieve="SELECT 	
	item.customicode,
	item.name, 
	currlistrow = 0,
	stock=0.0000, 
	totalstock=0.0000,
	dbo.ReceiptDetail.receiptinvcode,
	dbo.ReceiptDetail.gcode,
	dbo.ReceiptDetail.icode,
	dbo.ReceiptDetail.batch,
	dbo.ReceiptDetail.expiry,
	dbo.ReceiptDetail.price,
	dbo.ReceiptDetail.packunits,      
	dbo.ReceiptDetail.purchaseprice,   
	dbo.ReceiptDetail.priority,
	dbo.ReceiptDetail.avgprice,
	dbo.ReceiptDetail.mrpp,
	dbo.ReceiptDetail.saleprice,
	dbo.ReceiptDetail.Sectcode,
	dbo.ReceiptDetail.UpdateAvgPrice,
	dbo.ReceiptDetail.NewAvgPrice,
	dbo.ReceiptDetail.CurrStock,
	receiptutn=dbo.ReceiptDetail.receiptutn,
	populatedqty = 
		(SELECT 
			SUM(
				CASE WHEN PPD.PackQty = 0 THEN (PPD.LooseQty + PPD.BonusQty) 
				ELSE ((PPD.PackQty + PPD.BonusQty) * PPD.PackUnits) END
				) 
		FROM ProformaPurDetail PPD WHERE PPD.ReceiptRowID = ReceiptDetail.ReceiptUTN),
	dbo.ReceiptDetail.qty
	
FROM 
	dbo.ReceiptDetail, 
	dbo.item

WHERE 
	( dbo.ReceiptDetail.receiptinvcode IN (:r_InvCode) )   and
	( dbo.ReceiptDetail.icode = dbo.item.icode )
"
  arguments=(("r_InvCode", numberlist))
 sort="code A, itemname A, gcode A, batch A, expiry A"
)
