release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=500 print.margin.right=0 print.margin.top=500 print.margin.bottom=0 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no rows_per_detail=3)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=1343 color="536870912" )
table(column=(type=long updatewhereclause=yes name=receiptinvcode dbname="Receiptinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(5) updatewhereclause=yes name=price dbname="price"  )
column=(type=char(102) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=char(77) updatewhereclause=yes name=customicode_1 dbname="CUSTOMICODE"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
 retrieve="SELECT 
	Receiptinvcode = dbo.Receiptheader.Receiptinvcode, 
	date = dbo.Receiptheader.date,   
	price = Case (Select A=DBO.Fn_Get_Int_Preference('ReceiptPriceInPrint') ) When 1 THEN receiptdetail.saleprice When 2 THEN receiptdetail.purchaseprice When 3 THEN receiptdetail.avgprice When 4 THEN receiptdetail.MRPP When 5 THEN receiptdetail.price END,
	batch = '*' + LTRIM(RTRIM(Receiptdetail.batch)) + '*',
	CUSTOMICODE='*' + LTRIM(RTRIM(ITEM.customicode)) + '*' ,
	itemname=item.name
FROM 
	Receiptheader, 
	Receiptdetail, 
	item 
	
WHERE 
	( dbo.Receiptheader.Receiptinvcode = :ar_Code ) AND
	( dbo.Receiptheader.Receiptinvcode = dbo.Receiptdetail.Receiptinvcode) AND
	( dbo.Receiptdetail.icode = dbo.item.icode) 
	
ORDER BY 
	item.name"
  arguments=(("ar_Code", number))
)
