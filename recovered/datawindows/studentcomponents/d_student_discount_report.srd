table(column=(type=long key=yes update=yes updatewhereclause=yes name=studentcode dbname="Student.StudentCode"  )
column=(type=long update=yes updatewhereclause=yes name=custcode dbname="Student.CustCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=regno dbname="Student.RegNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="Student.Name"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fname dbname="Student.FName"  )
column=(type=char(1) update=yes updatewhereclause=yes name=gender dbname="Student.Gender"  )
column=(type=datetime update=yes updatewhereclause=yes name=birthdate dbname="Student.BirthDate"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=currentaddress dbname="Student.CurrentAddress"  )
column=(type=char(60) update=yes updatewhereclause=yes name=phone dbname="Student.Phone"  )
column=(type=char(60) update=yes updatewhereclause=yes name=mobile dbname="Student.Mobile"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=discperc dbname="Student.DiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=flatdisc dbname="Student.FlatDisc"  )
column=(type=char(1) updatewhereclause=yes name=omitspecialcharges dbname="Student.OmitSpecialCharges" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=status dbname="Student.Status"  )
column=(type=long update=yes updatewhereclause=yes name=registeredby dbname="Student.RegisteredBy"  )
column=(type=datetime update=yes updatewhereclause=yes name=registeredon dbname="Student.RegisteredOn"  )
column=(type=long update=yes updatewhereclause=yes name=admittedto dbname="Student.AdmittedTo"  )
column=(type=long update=yes updatewhereclause=yes name=admittedby dbname="Student.AdmittedBy"  )
column=(type=char(100) updatewhereclause=yes name=currentclass dbname="CurrentClass"  )
column=(type=decimal(2) updatewhereclause=yes name=classfee dbname="ClassFee"  )
column=(type=char(40) update=yes updatewhereclause=yes name=rollno dbname="RollNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Student.Remarks"  )
column=(type=decimal(6) updatewhereclause=yes name=discountamt dbname="DiscountAmt"  )
 retrieve="SELECT 
	StudentCode,
	CustCode,
	RegNo, 
	Name,
	FName,
	Gender,
	BirthDate,
	CurrentAddress,
	Phone,
	Mobile,
	DiscPerc,
	FlatDisc,
	OmitSpecialCharges,
	Status,
	RegisteredBy,
	RegisteredOn,
	AdmittedTo,
	AdmittedBy,
	CurrentClass = (SELECT C.Name FROM Class C WHERE C.ClassCode = Student.CurrentClass),
	ClassFee = (SELECT C.Fee FROM Class C WHERE C.ClassCode = Student.CurrentClass),
	RollNo = (SELECT RollNo FROM StudentClass SC WHERE SC.StudentCode=Student.StudentCode AND ClassCode=Student.CurrentClass),
	Remarks,
	DiscountAmt = ISNULL(flatdisc, 0) + Round((ISNULL(discperc,0) * ISNULL((SELECT C.Fee FROM Class C WHERE C.ClassCode = Student.CurrentClass),0) * 0.01), 2)
FROM
	Student
WHERE 
	Status <> 'L' AND
	CurrentClass IN (:ai_classcode) AND
	(flatdisc > 0 OR discperc > 0 OR OmitSpecialCharges = 'Y')
ORDER BY
	RegisteredOn"
  update="Student" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_classcode", numberlist))
 sort="name A, regno A"
 filter="DiscountAmt <> 0"
 )
