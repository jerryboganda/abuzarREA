table(column=(type=long identity=yes updatewhereclause=yes name=code dbname="Code"  )
column=(type=datetime updatewhereclause=yes name=date dbname="StudentClassTransfer.Date"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentClassTransfer.StudentCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=sourceclass dbname="StudentClassTransfer.SourceClass" 
 values=""  )
column=(type=char(40) updatewhereclause=yes name=sourceclassrollno dbname="StudentClassTransfer.SourceClassRollNo"  )
column=(type=datetime updatewhereclause=yes name=sourceclassadmissiondate dbname="StudentClassTransfer.SourceClassAdmissionDate"  )
column=(type=long updatewhereclause=yes name=sourceclasslastserviceinvcode dbname="StudentClassTransfer.SourceClassLastServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=sourceclasslastserviceinvdate dbname="StudentClassTransfer.SourceClassLastServiceInvDate"  )
column=(type=long updatewhereclause=yes name=targetclass dbname="StudentClassTransfer.TargetClass" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=reason dbname="StudentClassTransfer.Reason"  )
 retrieve="SELECT 
	Code=StudentClassTransfer.TransferCode,   
	StudentClassTransfer.Date,   
	RegNo = Student.RegNo, 
	StudentClassTransfer.StudentCode,   
	StudentClassTransfer.SourceClass,   
	StudentClassTransfer.SourceClassRollNo,   
	StudentClassTransfer.SourceClassAdmissionDate,   
	StudentClassTransfer.SourceClassLastServiceInvCode,   
	StudentClassTransfer.SourceClassLastServiceInvDate,   
	StudentClassTransfer.TargetClass,   
	StudentClassTransfer.Reason  
FROM 
	StudentClassTransfer, Student 
WHERE 
	StudentClassTransfer.StudentCode = Student.StudentCode
"
 )
