table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="CustomerStudentServiceTemplateDetail.CustomerStudentServiceTemplateCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="CustomerStudentServiceTemplateDetail.StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=fullcode dbname="Aliasname"  )
column=(type=char(163) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=long update=yes updatewhereclause=yes name=classcode dbname="ClassCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="A" name=status dbname="Status" 
 values="Amitted	A/Registered	R/School Leave	L/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=charges dbname="Charges"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discperc dbname="DiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=serviceflatdisc dbname="ServiceFlatDisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="1" name=qty dbname="Qty"  )
 retrieve="SELECT
	CustomerStudentServiceTemplateDetail.CustomerStudentServiceTemplateCode,
	CustomerStudentServiceTemplateDetail.StudentCode,
	Aliasname = Student.RegNo,
	itemname = Student.Name + ' (' + Student.RegNo + ')' ,
	FatherName = Student.FName,
	CurrListRow = 0,
	ClassCode=CustomerStudentServiceTemplateDetail.ClassCode,
	RowID=CustomerStudentServiceTemplateDetail.RowID,
	Remarks=CustomerStudentServiceTemplateDetail.Remarks,
	Status=CustomerStudentServiceTemplateDetail.Status,
	Charges=CustomerStudentServiceTemplateDetail.Charges,
	DiscPerc=CustomerStudentServiceTemplateDetail.DiscPerc,
	ServiceFlatDisc=CustomerStudentServiceTemplateDetail.ServiceFlatDisc,
	Qty=CustomerStudentServiceTemplateDetail.Qty
FROM 
	CustomerStudentServiceTemplateDetail, Student
WHERE 
	CustomerStudentServiceTemplateDetail.CustomerStudentServiceTemplateCode = :ai_code AND
	CustomerStudentServiceTemplateDetail.StudentCode = Student.StudentCode
ORDER BY 
	StudentServiceTemplateDetail.RowID"
  update="CustomerStudentServiceTemplateDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
