table(column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(30) updatewhereclause=yes name=customercategory dbname="CustomerCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=char(100) updatewhereclause=yes name=class dbname="Class"  )
 retrieve="SELECT 
	A.RegNo,
	A.Name, 
	A.StudentCode,
	A.Customer, 
	CustomerCategory = (SELECT CustomerCategory.Name FROM CustomerCategory WHERE CustomerCategory.CustCatCode = A.CustCatCode),
	Debit= CASE WHEN Balance > 0 THEN Balance ELSE 0 END,
	Credit= CASE WHEN Balance < 0 THEN ABS(Balance) ELSE 0 END,
	Class = (SELECT CL.Name FROM Class CL WHERE CL.ClassCode = A.CurrentClass)
FROM
	(SELECT 
		P.Name, P.RegNo, P.StudentCode, C.CustCode, Customer=A.Name, C.CustCatCode, Balance=SUM(V.Debit - V.Credit), P.CurrentClass
	FROM
		VirtualGL V,
		Accounts A,
		Customer C,
		SubAccounts S,
		Student P
	WHERE 
		V.StudentCode = P.StudentCode AND
		P.StudentCode IN (:ai_Studentcode) AND
		V.Date <= :ad_Date AND 
		V.AccCode = A.AccCode AND
		A.AccCode = C.CustCode AND
		V.AccCode = C.CustCode AND
		A.SubCode = S.SubAccCode 
	GROUP BY 
		P.StudentCode, 
		P.Name, 
		P.RegNo,
		P.CurrentClass, 
		A.Name, 
		C.CustCode,
		C.CustCatCode) A
ORDER BY A.RegNo, A.Name, A.StudentCode, A.Customer
   "
  arguments=(("ad_date", datetime), ("ai_Studentcode", numberlist))
 sort="regno A, name A"
 filter="debit <> 0 OR credit <> 0"
 )
