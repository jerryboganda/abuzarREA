table(column=(type=long key=yes updatewhereclause=yes name=code dbname="StudentImage.StudentCode"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="StudentImage.ROWID"  )
column=(type=char(100) updatewhereclause=yes name=imagetype dbname="StudentImage.ImageType"  )
column=(type=char(100) updatewhereclause=yes name=imagedescription dbname="StudentImage.ImageDescription"  )
 retrieve="SELECT 
	StudentCode,
	ROWID,
	ImageType,
	ImageDescription
FROM
	StudentImage
WHERE
	StudentCode = :ai_code
ORDER BY
	ROWID"
  update="StudentImage" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
