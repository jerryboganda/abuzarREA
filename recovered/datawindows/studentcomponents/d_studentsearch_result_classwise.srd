header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=studentregno dbname="StudentRegNo"  )
column=(type=char(113) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=char(100) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=char(100) updatewhereclause=yes name=studentclass dbname="StudentClass"  )
column=(type=char(1000) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(60) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(1) update=yes updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(50) updatewhereclause=yes name=fathercnic dbname="FatherCNIC"  )
column=(type=char(60) updatewhereclause=yes name=fathercellno dbname="FatherCellNo"  )
 retrieve="SELECT 
	StudentCode = S.StudentCode,
	StudentRegNo=S.Regno,
	StudentName= LTRIM(RTRIM(S.Name)) + ' (' + LTRIM(RTRIM(STR(S.StudentCode))) + ')',
	FatherName = S.FName,
	StudentClass = C.Name,
	Address = S.CurrentAddress,
	Phone = S.Phone,
	Gender = S.Gender,
	FatherCNIC=S.FNIC,
	FatherCellNo=S.FMobile
FROM
	Student S, StudentClass SC, Class C
WHERE
		C.ClassCode IN (:ai_classcode) AND
		C.ClassCode = SC.ClassCode AND
		SC.StudentCode = S.StudentCode
ORDER BY
	StudentName,
	StudentRegNo"
  arguments=(("ai_classcode", numberlist))
)
