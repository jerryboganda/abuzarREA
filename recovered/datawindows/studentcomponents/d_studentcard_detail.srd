table(column=(type=long updatewhereclause=yes name=code dbname="StudentClass.ClassCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=icode dbname="StudentClass.StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=fullcode dbname="Aliasname"  )
column=(type=char(100) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=datetime updatewhereclause=yes name=admissiondate dbname="StudentClass.AdmissionDate"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="StudentClass.ServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=lastserviceinvdate dbname="StudentClass.LastServiceInvDate"  )
column=(type=long updatewhereclause=yes name=promotionrowid dbname="StudentClass.PromotionRowID"  )
column=(type=long updatewhereclause=yes name=graduationrowid dbname="StudentClass.GraduationRowID"  )
column=(type=char(40) updatewhereclause=yes name=rollno dbname="StudentClass.RollNo"  )
column=(type=char(163) updatewhereclause=yes name=itemname dbname="itemname"  )
 retrieve="SELECT
	StudentClass.ClassCode,
	StudentClass.StudentCode,
	Aliasname = Student.RegNo,
	FatherName = Student.FName,
	CurrListRow = 0,
	StudentClass.AdmissionDate,
	StudentClass.ServiceInvCode,
	StudentClass.LastServiceInvDate,
	StudentClass.PromotionRowID,
	StudentClass.GraduationRowID,
	StudentClass.RollNo,
	itemname = Student.Name + ' (' + Student.RegNo + ')' 
FROM 
	StudentClass, Student
WHERE 
	StudentClass.ClassCode = :ai_classcode AND
	StudentClass.StudentCode = Student.StudentCode AND
	PromotionRowID IS NULL AND
	GraduationRowID IS NULL"
  arguments=(("ai_classcode", number))
)
