release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=228 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(50) updatewhereclause=yes name=fnic dbname="FNIC"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fname dbname="Fname"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mname dbname="MName"  )
column=(type=long updatewhereclause=yes name=noofsiblings dbname="NoofSiblings"  )
column=(type=long key=yes updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=char(100) updatewhereclause=yes name=currentclass dbname="CurrentClass"  )
column=(type=char(40) updatewhereclause=yes name=rollno dbname="RollNo"  )
column=(type=char(1) updatewhereclause=yes initial="M" name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0 AND real(gettext()) <= 100" validationmsg="~"Please enter valid discount percentage.~"" initial="0" name=discperc dbname="DiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="~"Please enter valid flat discount.~"" initial="0" name=flatdisc dbname="FlatDisc"  )
column=(type=char(255) update=yes updatewhereclause=yes name=feecomment dbname="FeeComment"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(60) update=yes updatewhereclause=yes name=mobile dbname="Mobile"  )
column=(type=char(60) update=yes updatewhereclause=yes name=fmobile dbname="FMobile"  )
column=(type=char(60) update=yes updatewhereclause=yes name=mmobile dbname="MMobile"  )
 retrieve="SELECT 
	FNIC=S.FNIC,
	Fname=S.FName,
	MName = S.MName,
	NoofSiblings = N.FNicCount,
	StudentCode = S.StudentCode,
	RegNo = S.RegNo,
	StudentName = S.Name,
	CurrentClass = (SELECT C.Name FROM Class C WHERE C.ClassCode = S.CurrentClass),
	RollNo = (SELECT SC.RollNo FROM StudentClass SC WHERE SC.ClassCode = S.CurrentClass AND SC.StudentCode=S.StudentCode),
	Gender = S.Gender,
	DiscPerc=S.DiscPerc,
	FlatDisc = S.FlatDisc,
	FeeComment = S.FeeComment,
	Remarks = S.Remarks,
	Mobile = S.Mobile,
	FMobile = S.FMobile,
	MMobile = S.MMobile
FROM
	Student S,
	(SELECT FNIC, FNicCount=COUNT(FNIC)
	FROM Student
	WHERE Status='A' AND CurrentClass > 0
	GROUP BY FNIC
	HAVING COUNT(FNIC) >= :ai_noofsiblings) N
WHERE
	S.FNIC = N.FNIC AND S.Status='A' AND S.CurrentClass > 0
ORDER BY
	NoofSiblings DESC, FNIC, StudentCode, Fname"
  update="Student" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_noofsiblings", number))
 sort="noofsiblings D, fnic A, studentcode A, fname A"
)
