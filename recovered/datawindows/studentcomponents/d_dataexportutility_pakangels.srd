table(column=(type=long updatewhereclause=yes name=billno dbname="BILLNo"  )
column=(type=long updatewhereclause=yes name=blankcolumn dbname="BlankColumn"  )
column=(type=decimal(2) updatewhereclause=yes name=invoiceamount dbname="InvoiceAmount"  )
column=(type=decimal(2) updatewhereclause=yes name=afterduedate_amount dbname="AFTERDUEDATE_AMOUNT"  )
column=(type=datetime updatewhereclause=yes name=invoicedate dbname="InvoiceDate"  )
column=(type=datetime updatewhereclause=yes name=validity_date dbname="VALIDITY_DATE"  )
column=(type=datetime updatewhereclause=yes name=due_date dbname="DUE_DATE"  )
column=(type=char(100) updatewhereclause=no name=studentname dbname="STUDENTNAME"  )
column=(type=long updatewhereclause=yes name=regno dbname="REGNo"  )
column=(type=char(100) updatewhereclause=no name=class dbname="CLASS"  )
column=(type=char(100) updatewhereclause=yes name=feemonth dbname="FEEMONTH"  )
column=(type=char(100) updatewhereclause=yes name=reference5 dbname="Reference5"  )
column=(type=char(100) updatewhereclause=no name=reference6 dbname="Reference6"  )
column=(type=char(100) updatewhereclause=no name=reference7 dbname="Reference7"  )
 retrieve="SELECT 
	BILLNo=H.ServiceInvCode,
	BlankColumn=NULL,
	InvoiceAmount=H.InvTotal,
	AFTERDUEDATE_AMOUNT = 10.00,
	InvoiceDate=H.Date,
	VALIDITY_DATE=CAST(LTRIM(RTRIM(STR(MONTH(H.Date), 4))) + '-' + LTRIM(RTRIM(STR(DAY(H.Date),4))) + '-' + LTRIM(RTRIM(STR(YEAR(H.Date) +1, 4))) AS DATETIME),
	DUE_DATE=CAST(CASE WHEN MONTH(H.Date) < 12 THEN LTRIM(RTRIM(STR(MONTH(H.Date) + 1, 4))) ELSE '01' END + '-10-' + CASE WHEN MONTH(H.Date) < 12 THEN LTRIM(RTRIM(STR(YEAR(H.Date), 4))) ELSE LTRIM(RTRIM(STR(YEAR(H.Date) + 1, 4))) END AS DATETIME),
	STUDENTNAME=(SELECT S.Name FROM Student S WHERE S.StudentCode=H.StudentCode),
	REGNo=H.StudentCode,
	CLASS=(SELECT G.Name FROM Student S, Class C, Grade G WHERE S.StudentCode=H.StudentCode AND S.CurrentClass = C.ClassCode AND C.GradeCode=G.GradeCode),
	FEEMONTH=H.Remarks,
	Reference5=(SELECT C.Name FROM Student S, Class C WHERE S.StudentCode=H.StudentCode AND S.CurrentClass = C.ClassCode ),
	Reference6=(SELECT B.Name FROM Student S, Class C, SchoolBranch B WHERE S.StudentCode=H.StudentCode AND S.CurrentClass = C.ClassCode AND C.SchoolBranchCode=B.SchoolBranchCode),
	Reference7=(SELECT S.FName FROM Student S WHERE S.StudentCode=H.StudentCode)
FROM 
	ServiceHeader H
WHERE 
	H.ServiceInvCode BETWEEN :ai_startcode AND :ai_endcode


"
  arguments=(("ai_startcode", number), ("ai_endcode", number))
 sort="billno A"
)
