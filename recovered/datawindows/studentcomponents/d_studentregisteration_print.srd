 values=""  )
column=(type=long update=yes updatewhereclause=yes name=admittedto dbname="Student.AdmittedTo" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=admittedby dbname="Student.AdmittedBy" 
 values=""  )
column=(type=char(40) updatewhereclause=yes name=rollno dbname="RollNo"  )
 retrieve="SELECT  
	StudentCode,
	CustCode,
	RegNo,
	Name,
	FName,
	Gender,
	BirthDate,
	CurrentAddress,
	PermanentAddress,
	Nationality,
	Religion,
	Phone,
	Mobile,
	Email,
	PrevSchool,
	PrevClass,
	PrevClassResult,
	AdmissionReqIn,
	FNIC,
	FOccupation,
	FDesignation,
	FMonthlyIncome,
	FMobile,
	MName,
	MNIC,
	MOccupation,
	MDesignation,
	MMonthlyIncome,
	MMobile,
	DiscPerc,
	Status,
	RegisteredBy,
	RegisteredOn,
	LastUpdate,
	LastUpdateBy,
	AdmittedTo,
	AdmittedBy,
	RollNo = (SELECT RollNo FROM StudentClass SC WHERE SC.StudentCode=:ai_code AND ClassCode=Student.AdmittedTo)
FROM
	Student
WHERE 
	StudentCode = :ai_code"
  update="Student" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
