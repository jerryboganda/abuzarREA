table(column=(type=char(163) updatewhereclause=yes name=name dbname="name"  )
column=(type=char(60) updatewhereclause=yes name=aliasname dbname="Student.regno"  )
column=(type=long key=yes updatewhereclause=yes name=code dbname="Student.Studentcode"  )
column=(type=char(163) updatewhereclause=yes name=student dbname="Student"  )
 retrieve="SELECT  name = LTRIM(RTRIM(Student.Name)) + ' (' + LTRIM(RTRIM(Student.RegNo)) + ')' ,
		  regno,
        Studentcode,
		  Student = LTRIM(RTRIM(Student.Name)) + ' (' + LTRIM(RTRIM(Student.RegNo)) + ')'
		 
             
FROM Student
/*
UNION
  SELECT   
         Description=~"<None>~"  ,
			regno=~"<None>~",
			Studentcode=null,
			Studentcity='None',
			customer='None'
*/
Order by name   "
  update="Student" updatewhere=1 updatekeyinplace=no
 )
