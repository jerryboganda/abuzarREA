 values="Yes	Y/No	N/"  )
column=(type=char(255) update=yes updatewhereclause=yes name=feecomment dbname="Student.FeeComment"  )
 retrieve="SELECT 
	StudentCode,
	CustCode,
	RegNo,
	Name,
	FName,
	Gender,
	BirthDate,
	CurrentAddress,
	PermanentAddress,
	Nationality,
	Religion,
	Phone,
	Mobile,
	Email,
	PrevSchool,
	PrevClass,
	PrevClassResult,
	AdmissionReqIn,
	FNIC,
	FOccupation,
	FDesignation,
	FMonthlyIncome,
	FMobile,
	MName,
	MNIC,
	MOccupation,
	MDesignation,
	MMonthlyIncome,
	MMobile,
	DiscPerc,
	Status,
	RegisteredBy,
	RegisteredOn,
	LastUpdate,
	LastUpdateBy,
	AdmissionReqIn,
	AdmittedTo,
	AdmittedBy,
	RollNo = (SELECT RollNo FROM StudentClass SC WHERE SC.StudentCode=:ai_code AND ClassCode=Student.CurrentClass),
	FlatDisc,
	Remarks,
	FeePaidUptill,
	Student.CurrentClass,
	DefaulterListInstruction,
	DefaulterListInstructionExpiresOn,
	OmitSpecialCharges,
	FeeComment
FROM
	Student
WHERE 
	StudentCode = :ai_code"
  update="Student" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
