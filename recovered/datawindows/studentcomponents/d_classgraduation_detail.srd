header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ClassGraduationDetail.GraduationCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=studentcode dbname="ClassGraduationDetail.StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=fullcode dbname="Aliasname"  )
column=(type=char(163) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=long update=yes updatewhereclause=yes name=rowid dbname="ClassGraduationDetail.RowID"  )
column=(type=char(40) update=yes updatewhereclause=yes name=rollno dbname="ClassGraduationDetail.RollNo"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="Y" name=graduate dbname="ClassGraduationDetail.Graduate" 
 values="	Y/	N"  )
 retrieve="SELECT
	ClassGraduationDetail.GraduationCode, 
	ClassGraduationDetail.StudentCode, 
	Aliasname = Student.RegNo,
	itemname = Student.Name + ' (' + Student.RegNo + ')' ,
	FatherName = Student.FName,
	CurrListRow = 0, 
	ClassGraduationDetail.RowID,
	ClassGraduationDetail.RollNo,
	ClassGraduationDetail.Graduate
FROM 
	ClassGraduationDetail, Student
WHERE 
	ClassGraduationDetail.GraduationCode = :ai_code AND
	ClassGraduationDetail.StudentCode = Student.StudentCode
ORDER BY
	ClassGraduationDetail.RowID"
  update="ClassGraduationDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
