release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1687 color="536870912" )
summary(height=270 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=long updatewhereclause=yes name=classcode dbname="ClassCode"  )
column=(type=char(100) updatewhereclause=yes name=classname dbname="ClassName"  )
column=(type=long updatewhereclause=yes name=classyear dbname="ClassYear"  )
column=(type=char(100) updatewhereclause=yes name=classtype dbname="ClassType"  )
column=(type=char(100) updatewhereclause=yes name=classmedium dbname="ClassMedium"  )
column=(type=char(100) updatewhereclause=yes name=schoolbranch dbname="SchoolBranch"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=char(100) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=datetime updatewhereclause=yes name=admissiondate dbname="AdmissionDate"  )
column=(type=char(40) updatewhereclause=yes name=rollno dbname="RollNo"  )
 retrieve="SELECT 
	ClassCode=StudentClass.ClassCode, 
	ClassName = Class.Name,
	ClassYear = Class.ClassYear,
	ClassType = (SELECT CT.Name FROM ClassType CT WHERE Class.ClassTypeCode = CT.ClassTypeCode),
	ClassMedium = (SELECT CT.Name FROM ClassMedium CT WHERE Class.ClassMediumCode = CT.ClassMediumCode),
	SchoolBranch = (SELECT CT.Name FROM SchoolBranch CT WHERE Class.SchoolBranchCode = CT.SchoolBranchCode),
	StudentCode=StudentClass.StudentCode,
	RegNo = Student.RegNo,
	StudentName = Student.Name,
	FatherName = Student.FName,
	AdmissionDate=StudentClass.AdmissionDate,
	RollNo=StudentClass.RollNo
FROM 
	StudentClass, Student, Class
WHERE 
	StudentClass.ClassCode = :ai_classcode AND
	StudentClass.ClassCode = Class.ClassCode AND
	StudentClass.StudentCode = Student.StudentCode AND
	StudentClass.PromotionRowID IS NULL AND
	StudentClass.GraduationRowID IS NULL
ORDER BY
	RollNO
"
  arguments=(("ai_classcode", number))
 sort="rollno A"
)
