column=(type=char(1) update=yes updatewhereclause=yes name=posted dbname="StudentServiceTemplate.Posted" 
 values="Yes	Y/No	N/"  )
column=(type=datetime update=yes updatewhereclause=yes name=postdate dbname="StudentServiceTemplate.PostDate"  )
column=(type=long update=yes updatewhereclause=yes name=postedby dbname="StudentServiceTemplate.PostedBy" 
 values=""  )
column=(type=char(1) updatewhereclause=yes name=svcinvgenerated dbname="StudentServiceTemplate.SvcInvGenerated"  )
 retrieve="SELECT 
	Name,
	StudentServiceTemplateCode,
	Date,
	UserCode,
	ServiceCode,
	Posted,
	PostDate,
	PostedBy,
	SvcInvGenerated
FROM
	StudentServiceTemplate
WHERE 
	Posted='Y' AND SvcInvGenerated='N'"
  update="StudentServiceTemplate" updatewhere=1 updatekeyinplace=no
  sort="code D"
)
