table(column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="Class.Name"  )
column=(type=long key=yes identity=yes update=yes updatewhereclause=yes name=code dbname="Class.ClassCode"  )
column=(type=long update=yes updatewhereclause=yes name=classyear dbname="Class.ClassYear"  )
column=(type=long update=yes updatewhereclause=yes name=gradecode dbname="Class.GradeCode"  )
column=(type=long updatewhereclause=yes name=schoolbranchcode dbname="Class.SchoolBranchCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=classmediumcode dbname="Class.ClassMediumCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=classtypecode dbname="Class.ClassTypeCode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes name=grade dbname="Grade"  )
column=(type=datetime update=yes updatewhereclause=yes name=creationdate dbname="Class.CreationDate"  )
column=(type=long update=yes updatewhereclause=yes name=feedueon dbname="Class.FeeDueOn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=fee dbname="Class.Fee"  )
column=(type=char(1) update=yes updatewhereclause=yes name=active dbname="Class.Active" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT 
	Name,
	ClassCode,
	ClassYear,
	GradeCode,
	SchoolBranchCode,
	ClassMediumCode,
	ClassTypeCode,
	Grade=(SELECT G.Name FROM Grade G WHERE G.GradeCode=Class.GradeCode),
	CreationDate,
	FeeDueOn, 
	Fee,
	Active
FROM 
	Class"
  update="Class" updatewhere=1 updatekeyinplace=no
 )
