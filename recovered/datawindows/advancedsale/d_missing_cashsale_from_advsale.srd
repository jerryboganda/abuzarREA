release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=300 print.margin.top=300 print.margin.bottom=300 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1625 color="536870912" )
summary(height=270 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=machinename dbname="SaleLedger.MachineName"  )
column=(type=long key=yes updatewhereclause=yes name=saleinvcode dbname="SaleLedger.SaleInvCode"  )
column=(type=decimal(2) updatewhereclause=yes name=saleamount dbname="SaleAmount"  )
 retrieve="SELECT   
	SL.MachineName,
	SL.SaleInvCode,
	SaleAmount = SL.InvTotal
FROM  
	SaleLedger SL
WHERE 
	SL.SaleCatCode IN (1, 3) and	 
	SL.date between :ar_startdate and :ar_enddate and
	SL.SaleInvCode NOT IN 
		(SELECT ASIL.SaleInvCode
		FROM AdvSaleLedger ASL, AssocAdvSaleInvList ASIL
		WHERE ASL.date between :ar_startdate and :ar_enddate and
			ASL.Advsaleinvcode=ASIL.Advsaleinvcode)
ORDER BY
	SL.SaleInvCode"
  update="SaleLedger" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
