summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
column=(type=char(30) updatewhereclause=yes name=custrefno dbname="custrefno"  )
column=(type=char(100) updatewhereclause=yes name=custrefno2 dbname="custrefno2"  )
column=(type=char(100) updatewhereclause=yes name=custrefno3 dbname="custrefno3"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Accounts.name"  )
column=(type=char(60) updatewhereclause=yes name=user dbname="Users.username"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=long updatewhereclause=yes name=reprintingcounter dbname="ReprintingCounter"  )
column=(type=datetime updatewhereclause=yes name=originaldate dbname="OriginalDate"  )
column=(type=long updatewhereclause=yes name=modifycounter dbname="ModifyCounter"  )
column=(type=char(1) updatewhereclause=yes name=deleted dbname="Deleted"  )
 retrieve="SELECT
	Code=AdvSaleLedger.AdvSaleInvCode , 
	Date=AdvSaleLedger.date , 
	headerno= AdvSaleLedger.headerno,
	headerinvno = AdvSaleLedger.headerinvno,
	custrefno = AdvSaleLedger.custrefno, 
	custrefno2 = AdvSaleLedger.custrefno2, 
	custrefno3 = AdvSaleLedger.custrefno3, 
	remarks  = AdvSaleLedger.remarks, 
	accounts.name, 
	users.username, 
	posted = AdvSaleLedger.posted,
	PostedBy = IsNull((Select username from users 
								where dbo.AdvSaleLedger.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
								where dbo.AdvSaleLedger.modifiedby = dbo.users.usercode), ''),
	NetAmount = AdvSaleLedger.invtotal,
	ReprintingCounter = dbo.AdvSaleLedger.ReprintingCounter,
	OriginalDate = dbo.AdvSaleLedger.OriginalDate,
	ModifyCounter = dbo.AdvSaleLedger.ModifyCounter,
	Deleted = dbo.AdvSaleLedger.Deleted
FROM  
	accounts, AdvSaleLedger, users
WHERE		 
	 AdvSaleLedger.custcode = accounts.acccode AND
	 dbo.AdvSaleLedger.salecatcode IN (:ai_salecatcode) AND
	 dbo.AdvSaleLedger.salesmancode = dbo.users.usercode AND
	 dbo.AdvSaleLedger.date > :ad_invdate AND
	 Posted IN (:as_Posted) AND
	:as_showrows='Y'  AND 
	(dbo.AdvSaleLedger.headerno IS NULL OR
	dbo.AdvSaleLedger.headerno IN
		(SELECT headercode FROM GroupAllowedHeader 
		WHERE GroupCode = :ai_groupcode AND
		module = :ai_module)) AND
	Exists (Select DBO.Fn_GetPreference('AllowedGroupsInSalesList') Where DBO.Fn_GetPreference('AllowedGroupsInSalesList') = 'N' )
Union All
SELECT	
	Code=AdvSaleLedger.AdvSaleInvCode , 
	date=AdvSaleLedger.date , 
	headerno=AdvSaleLedger.headerno,
	headerinvno = AdvSaleLedger.headerinvno,
	custrefno = AdvSaleLedger.custrefno, 
	custrefno2 = AdvSaleLedger.custrefno2, 
	custrefno3 = AdvSaleLedger.custrefno3, 
	remarks = AdvSaleLedger.remarks , 
	accounts.name,
	users.username, 
	posted = AdvSaleLedger.posted,
	PostedBy = IsNull((Select username from users 
								where dbo.AdvSaleLedger.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
								where dbo.AdvSaleLedger.modifiedby = dbo.users.usercode), ''),
	NetAmount = AdvSaleLedger.invtotal,
	ReprintingCounter = dbo.AdvSaleLedger.ReprintingCounter,
	OriginalDate = dbo.AdvSaleLedger.OriginalDate,
	ModifyCounter = dbo.AdvSaleLedger.ModifyCounter,
	Deleted = dbo.AdvSaleLedger.Deleted
FROM
	accounts, AdvSaleLedger, users
WHERE
	AdvSaleLedger.custcode = accounts.acccode AND
	dbo.AdvSaleLedger.salecatcode IN (:ai_salecatcode) AND
	dbo.AdvSaleLedger.salesmancode = dbo.users.usercode AND
	dbo.AdvSaleLedger.date > :ad_invdate AND
	Posted IN (:as_Posted) AND
	:as_showrows='Y'  AND 
	(dbo.AdvSaleLedger.headerno IS NULL OR
	dbo.AdvSaleLedger.headerno IN
		(SELECT headercode FROM GroupAllowedHeader 
		WHERE GroupCode = :ai_groupcode AND module = :ai_module)) AND
	AdvSaleLedger.salesmancode IN (
		Select 	Distinct U.usercode
		From   	Users U, UserGroups UG, GroupAllowedGroups GAG
		Where  	U.UserCode = UG.UserCode And UG.GroupCode = GAG.AllowedGroupCode And 
					GAG.GroupCode = :ai_groupcode And GAG.Module = :ai_module
		Union 
		Select   U.Usercode
		From     Users U, UserGroups UG
		Where    U.usercode = UG.usercode And UG.GroupCode = :ai_groupcode
		
	  ) And
	Exists (Select DBO.Fn_GetPreference('AllowedGroupsInSalesList') Where DBO.Fn_GetPreference('AllowedGroupsInSalesList') = 'Y' )

ORDER BY 
	AdvSaleLedger.AdvSaleInvCode"
  arguments=(("ai_SaleCatCode", numberlist), ("as_Posted", stringlist), ("ad_invdate", datetime), ("as_showrows", string), ("ai_groupcode", number), ("ai_module", number))
 sort="code A"
)
