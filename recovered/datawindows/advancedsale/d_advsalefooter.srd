table(column=(type=long key=yes updatewhereclause=yes name=code dbname="AdvSaleLedger.Advsaleinvcode"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Flat Discount should be greater equal zero'" initial="0" name=flatdisc dbname="FlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Miscellaneous Charges should be greater equal zero'" initial="0" name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0 AND Real(GetText()) <= 100" validationmsg="'Discount % should be between 0 and 100'" initial="0" name=invdiscperc dbname="discperc"  )
column=(type=long updatewhereclause=yes initial="99999" name=icode dbname="Icode"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=purdisc dbname="Stock"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="TotalStock"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Invoice total can not be negative'" initial="0" name=total dbname="Total"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=purdiscperc dbname="purdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=invgstperc1 dbname="InvGSTPerc1"  )
column=(type=decimal(3) updatewhereclause=yes initial="0" name=avgprice dbname="avgprice"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=rpp dbname="rpp"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Refund amount can not be negative'" initial="0" name=refundamt dbname="refundamt"  )
column=(type=char(20) updatewhereclause=yes name=bonusratio dbname="BonusRatio"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=retailprice dbname="retailprice"  )
 retrieve="  SELECT AdvSaleLedger.Advsaleinvcode,    
         FlatDisc=AdvSaleLedger.flatdisc,   
         misccharges = AdvSaleLedger.misccharges,   
         discperc=AdvSaleLedger.discperc,
			Icode = 0, 
			itemtotalval=space(30),
			Stock = 0.0000,
			TotalStock = 0.0000,
			Total = 0.00,
			purdiscperc = 0.00,
			InvGSTPerc1= AdvSaleLedger.Invgstperc1,
			avgprice=0.000,
			rpp=0.00,
			purprice=0.00,
			refundamt=AdvSaleLedger.refundamt,
			BonusRatio=SPACE(20),
			retailprice=0.00
    FROM AdvSaleLedger  
   WHERE AdvSaleLedger.Advsaleinvcode = :ar_invcode    
"
  update="AdvSaleLedger" updatewhere=0 updatekeyinplace=no
  arguments=(("ar_invcode", number))
)
