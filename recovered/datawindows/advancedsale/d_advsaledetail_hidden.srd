table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="AdvSaleDetail.AdvSaleInvCode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=gcode dbname="gcode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=char(100) update=yes updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime update=yes updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=datetime update=yes updatewhereclause=yes name=manfdate dbname="manfdate"  )
column=(type=long update=yes updatewhereclause=yes name=rowgroup dbname="rowgroup"  )
column=(type=long key=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=looseqty dbname="looseqty"  )
column=(type=long update=yes updatewhereclause=yes initial="0" name=packqty dbname="packqty"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) > 0" initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Sale Price should be greater than zero'" initial="0" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=0 and Real(GetText()) < 100" validationmsg="'Dsicount % value should be between 0 and 100'" initial="0" name=discperc dbname="discperc"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=rate dbname="rate"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=avgprice dbname="avgprice"  )
column=(type=char(1) update=yes updatewhereclause=yes name=due dbname="Due"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Item flat disc should be equal or greater than zero~"" initial="0" name=itemflatdisc dbname="itemflatdisc"  )
column=(type=datetime update=yes updatewhereclause=yes name=satisfieddate dbname="SatisfiedDate"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=packqtyforsale dbname="packqtyforsale"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=bonuspackqtyforsale dbname="bonuspackqtyforsale"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=decimal(5) update=yes updatewhereclause=yes initial="0" name=packprice dbname="packprice"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=purunitrate dbname="purunitrate"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=rppunitrate dbname="rppunitrate"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=saleutn dbname="saleutn"  )
column=(type=char(100) update=yes updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=long update=yes updatewhereclause=yes name=descicode dbname="DescICode"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=claimable dbname="claimable"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=0 and Real(GetText()) < 100" validationmsg="'Claimable Discount % value should be between 0 and 100'" initial="0" name=claimablediscperc dbname="claimablediscperc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=balancestock dbname="balancestock"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=gstperc dbname="gstperc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes initial="0" name=bonusqty dbname="bonusqty"  )
 retrieve="SELECT 
	AdvSaleDetail.AdvSaleInvCode,   
	gcode=AdvSaleDetail.gcode,   
	icode=AdvSaleDetail.icode,   
	batch=AdvSaleDetail.batch,   
	expiry=AdvSaleDetail.expiry,   
	manfdate=AdvSaleDetail.manfdate,
	rowgroup=AdvSaleDetail.rowgroup,
	Id = AdvSaleDetail.IDENTITYCOL,   
	looseqty = AdvSaleDetail.looseqty,
	packqty  = AdvSaleDetail.packqty,
	packunits= AdvSaleDetail.packunits,
	saleprice= AdvSaleDetail.saleprice,
	discperc = AdvSaleDetail.discperc,  
	rate     = AdvSaleDetail.rate,  
	avgprice = AdvSaleDetail.avgprice,  
	Due      = AdvSaleDetail.Due,
	itemflatdisc = AdvSaleDetail.itemflatdisc,
	SatisfiedDate = AdvSaleDetail.SatisfiedDate,
	packqtyforsale = AdvSaleDetail.packqtyforsale,
	bonuspackqtyforsale = AdvSaleDetail.bonuspackqtyforsale,
	stock = 0.0000, 
	packingdesc=space(50),
	totalstock = 0.0000,
	packprice = AdvSaleDetail.packprice,
	purunitrate = AdvSaleDetail.purunitrate,
	rppunitrate = AdvSaleDetail.rppunitrate,
	saleutn = AdvSaleDetail.SaleUtn,
	SaleItemDescription =  AdvSaleDetail.SaleItemDescription,
	DescICode =  AdvSaleDetail.DescICode,
	claimable=AdvSaleDetail.claimable,
	claimablediscperc=AdvSaleDetail.claimablediscperc,
	balancestock=AdvSaleDetail.balancestock,
	unitsalestax=AdvSaleDetail.unitsalestax,
	gstperc=AdvSaleDetail.gstperc,
	bonusqty=AdvSaleDetail.bonusqty
FROM 
	AdvSaleDetail
WHERE 
	( dbo.AdvSaleDetail.AdvSaleInvCode = :ar_AdvSaleInvCode )
ORDER BY 
	AdvSaleDetail.IDENTITYCOL
"
  update="AdvSaleDetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_AdvSaleInvCode", number))
)
