detail(height=156 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="username"  )
column=(type=long updatewhereclause=yes name=salecat dbname="salecat"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=long updatewhereclause=yes name=advsaleinvcode dbname="AdvSaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=refundamt dbname="refundamt"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=decimal(0) updatewhereclause=yes name=id dbname="Id"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(5) updatewhereclause=yes name=saledetail_saleprice dbname="saleprice"  )
column=(type=decimal(5) updatewhereclause=yes name=saledetail_rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_discperc dbname="discperc"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(21) updatewhereclause=yes name=machinename dbname="machinename"  )
column=(type=decimal(2) updatewhereclause=yes name=cashtendered dbname="cashtendered"  )
column=(type=decimal(2) updatewhereclause=yes name=cashreceived dbname="cashreceived"  )
column=(type=decimal(2) updatewhereclause=yes name=creditamt1 dbname="AdvSaleLedger.creditamt1"  )
column=(type=char(60) updatewhereclause=yes name=credit1account dbname="credit1account"  )
column=(type=decimal(2) updatewhereclause=yes name=creditamt2 dbname="AdvSaleLedger.creditamt2"  )
column=(type=char(60) updatewhereclause=yes name=credit2account dbname="credit2account"  )
column=(type=decimal(2) updatewhereclause=yes name=creditamt3 dbname="AdvSaleLedger.creditamt3"  )
column=(type=char(60) updatewhereclause=yes name=credit3account dbname="credit3account"  )
column=(type=decimal(2) updatewhereclause=yes name=associatedamt dbname="associatedamt"  )
column=(type=decimal(5) updatewhereclause=yes name=balance dbname="balance"  )
 retrieve="SELECT 
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale' else item.name end,
	username=users.username, 
	salecat=max(AdvSaleLedger.salecatcode),
	custcode=AdvSaleLedger.custcode,
	headerno = dbo.AdvSaleLedger.headerno,
	posted=dbo.AdvSaleLedger.posted,
	customer=(select name from accounts where acccode=AdvSaleLedger.custcode),
	AdvSaleInvCode= dbo.AdvSaleLedger.AdvSaleInvCode,   
	date=dbo.AdvSaleLedger.date,   
	discperc = dbo.AdvSaleLedger.discperc,   
	misccharges = dbo.AdvSaleLedger.misccharges,   
	flatdisc = dbo.AdvSaleLedger.flatdisc,   
	refundamt = dbo.AdvSaleLedger.refundamt,   
	remarks = dbo.AdvSaleLedger.remarks,   
	icode = dbo.AdvSaleDetail.icode,   
	gcode = dbo.AdvSaleDetail.gcode, 
	Id        = MAX(dbo.AdvSaleDetail.IDENTITYCOL),  
	looseqty  = sum(AdvSaleDetail.looseqty), 
	packqty   = sum(AdvSaleDetail.packqty), 
	packunits = max(AdvSaleDetail.packunits), 
	saleprice = AdvSaleDetail.saleprice,
	rate      = max(AdvSaleDetail.rate),
	discperc  = max(AdvSaleDetail.discperc), 
	customername='                                  '  ,
	itemflatdisc  = max(AdvSaleDetail.itemflatdisc),
	aliasname=item.customicode,
	machinename=',' +  max(AdvSaleLedger.machinename),
	cashtendered = advsaleledger.cashtendered,
	cashreceived = advsaleledger.cashamt,
	advsaleledger.creditamt1,
	credit1account = (SELECT A.Name FROM Accounts A WHERE A.Acccode = advsaleledger.credit1acccode),
	advsaleledger.creditamt2,
	credit2account = (SELECT A.Name FROM Accounts A WHERE A.Acccode = advsaleledger.credit2acccode),
	advsaleledger.creditamt3,
	credit3account = (SELECT A.Name FROM Accounts A WHERE A.Acccode = advsaleledger.credit3acccode),
	associatedamt=0.00,
	balance = advsaleledger.balance
FROM 
	dbo.AdvSaleLedger,   
	dbo.AdvSaleDetail,  
	item,
	Users 
WHERE 
	( dbo.AdvSaleLedger.AdvSaleInvCode = :ra_InvCode ) AND
	( dbo.AdvSaleLedger.AdvSaleInvCode = dbo.AdvSaleDetail.AdvSaleInvCode ) AND 
	( AdvSaleLedger.SalesManCode = users.userCode ) and
	( AdvSaleDetail.icode = item.icode )
GROUP BY 
	AdvSaleLedger.AdvSaleInvCode, 
	AdvSaleLedger.date, 
	AdvSaleLedger.custcode, 
	AdvSaleLedger.discperc, 
	AdvSaleLedger.flatdisc,
	AdvSaleLedger.refundamt,   
	AdvSaleLedger.misccharges, 
	AdvSaleLedger.headerno,
	AdvSaleLedger.remarks, 
	AdvSaleDetail.icode, 
/*	AdvSaleDetail.rowgroup,*/
	AdvSaleDetail.saleprice,
	AdvSaleDetail.gcode, 
	advsaleledger.cashtendered,
	advsaleledger.cashamt,
	advsaleledger.creditamt1,
	advsaleledger.creditamt2,
	advsaleledger.creditamt3,
	advsaleledger.credit1acccode,
	advsaleledger.credit2acccode,
	advsaleledger.credit3acccode,
	advsaleledger.balance,
	dbo.AdvSaleLedger.posted,
	item.name,
	item.icode,
	item.printable,
	item.customicode,
	users.username
UNION ALL
SELECT	 
	itemname = ISNULL((SELECT '*' + MachineName FROM SaleLedger WHERE SaleInvCode = L.SaleInvCode) + ' (' + LTRIM(RTRIM(STR(L.SaleInvCode))) + ')', ''),
	username=users.username, 
	salecat=AdvSaleLedger.salecatcode,
	custcode=AdvSaleLedger.custcode,
	headerno = dbo.AdvSaleLedger.headerno,
	posted=dbo.AdvSaleLedger.posted,
	customer=(select name from accounts where acccode=AdvSaleLedger.custcode),
	AdvSaleInvCode = dbo.AdvSaleLedger.AdvSaleInvCode,   
	date=dbo.AdvSaleLedger.date,   
	discperc=dbo.AdvSaleLedger.discperc,   
	misccharges = dbo.AdvSaleLedger.misccharges,   
	flatdisc = dbo.AdvSaleLedger.flatdisc,   
	refundamt = dbo.AdvSaleLedger.refundamt,   
	remarks = dbo.AdvSaleLedger.remarks,   
	icode=NULL,   
	gcode=NULL, 
	Id        = 999999999999,  
	looseqty  = 0, 
	packqty   = 0, 
	packunits = 0, 
	saleprice = 0, 
	rate      = 0,
	discperc  = 0, 
	customername='                                  '  ,
	itemflatdisc  = 0,
	aliasname=NULL,
	machinename=',' + AdvSaleLedger.machinename,
	cashtendered = advsaleledger.cashtendered,
	cashreceived = advsaleledger.cashamt,
	advsaleledger.creditamt1,
	credit1account = (SELECT A.Name FROM Accounts A WHERE A.Acccode = advsaleledger.credit1acccode),
	advsaleledger.creditamt2,
	credit2account = (SELECT A.Name FROM Accounts A WHERE A.Acccode = advsaleledger.credit2acccode),
	advsaleledger.creditamt3,
	credit3account = (SELECT A.Name FROM Accounts A WHERE A.Acccode = advsaleledger.credit3acccode),
	associatedamt= DBO.fn_GetSaleInvTotal(L.SaleInvCode),
	balance=advsaleledger.balance
FROM 
	dbo.AdvSaleLedger,   
	AssocAdvSaleInvList L, 
	Users

WHERE 
	( dbo.AdvSaleLedger.AdvSaleInvCode = :ra_InvCode ) AND
	( dbo.AdvSaleLedger.AdvSaleInvCode = L.AdvSaleInvCode ) AND 
	( AdvSaleLedger.SalesManCode = users.userCode )
ORDER BY 
	ID
"
  arguments=(("ra_InvCode", number))
 sort="id A"
)
