text(name=t_3 visible="1" band=header font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" alignment="2" border="0" x="72" y="229" height="156" width="2625" text="Machine Wise Category Sale Summary" html.valueishtml="0" )
