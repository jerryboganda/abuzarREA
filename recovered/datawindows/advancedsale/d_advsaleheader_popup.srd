 retrieve="SELECT 
	code=AdvSaleLedger.advsaleinvcode , 
	salecatcode=AdvSaleLedger.salecatcode , 
	date=AdvSaleLedger.date , 
	billingdate = AdvSaleLedger.billingdate,
	custrefno = AdvSaleLedger.custrefno , 
	remarks = AdvSaleLedger.remarks,
	custcode = AdvSaleLedger.custcode , 
	salesmancode = AdvSaleLedger.salesmancode ,
	headerno = AdvSaleLedger.headerno,  
	username = users.username , 
	discperc = AdvSaleLedger.discperc , 
	flatdisc = AdvSaleLedger.flatdisc , 
	misccharges = AdvSaleLedger.misccharges , 
	posted=AdvSaleLedger.posted , 
	postdate = AdvSaleLedger.postdate , 
	address1 = customer.address1 , 
	city = customer.city , 
	phone = customer.phone ,
	customerbalance = 0,
	debitorcredit = ' ',
	aliasname='            ',
	headerinvno = AdvSaleLedger.headerinvno,
	originaldate = AdvSaleLedger.originaldate,
	modifiedby = AdvSaleLedger.modifiedby,
	sprice = AdvSaleLedger.sprice,
	quotationno = AdvSaleLedger.quotationno,
	postedby = AdvSaleLedger.postedby,
	doctcode = AdvSaleLedger.doctcode,
	patientRegNo='          ',
	patientcode = AdvSaleLedger.patientcode,
	invGSTPerc1=AdvSaleLedger.InvGstPerc1,
	dd_gstperc=0,
	gcode=0,
	gstno = AdvSaleLedger.gstno,
	PrintWaranty = AdvSaleLedger.PrintWaranty,
	PrintBatch = AdvSaleLedger.PrintBatch,
	MessageCode = AdvSaleLedger.MessageCode,
	Description=Message.Description,
	SmanCode = AdvSaleLedger.SmanCode,
	SalesMan=Salesman.Name,
	custrefno2 = AdvSaleLedger.custrefno2,
	custrefno3=AdvSaleLedger.custrefno3,
	custrefno4=AdvSaleLedger.custrefno4,
	InvoiceSize = AdvSaleLedger.InvoiceSize,
	invtotal = AdvSaleLedger.invtotal,
	machinename=AdvSaleLedger.machinename,
	ModifyCounter = AdvSaleLedger.ModifyCounter,
	relationcode=AdvSaleLedger.relationcode,
	diseasecode=AdvSaleLedger.diseasecode,
	wardcode=AdvSaleLedger.wardcode,
	itemdiscpercno=AdvSaleLedger.itemdiscpercno,
	printbalance=AdvSaleLedger.printbalance,
	saletypecode=AdvSaleLedger.saletypecode
	
FROM  
	AdvSaleLedger
	LEFT OUTER JOIN SalesMan ON (AdvSaleLedger.smancode = salesman.salesmancode)
	LEFT OUTER JOIN message ON (AdvSaleLedger.messagecode = message.messagecode),
	customer , 
	users , 
	accounts  
	
WHERE 
	( dbo.AdvSaleLedger.advsaleinvcode = :ar_SaleInvCode ) AND
	( AdvSaleLedger.custcode = customer.custcode ) and 
	( AdvSaleLedger.custcode = accounts.acccode ) and 
	( users.usercode = AdvSaleLedger.salesmancode )
"
  arguments=(("ar_SaleInvCode", number))
)
