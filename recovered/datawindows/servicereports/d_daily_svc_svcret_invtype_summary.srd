table(column=(type=char(10) updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=long updatewhereclause=yes name=reporttype dbname="ReportType"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=char(6) updatewhereclause=yes name=invtype dbname="InvType"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="SalesMan"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="FlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="Misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="InvDiscPerc"  )
column=(type=decimal(4) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=decimal(8) updatewhereclause=yes name=itemdiscpercvalue dbname="ItemDiscPercValue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="InvDiscPercValue"  )
column=(type=decimal(4) updatewhereclause=yes name=totaldiscount dbname="TotalDiscount"  )
column=(type=decimal(4) updatewhereclause=yes name=totaltax dbname="TotalTax"  )
 retrieve="SELECT 
	documentcode = 'RS-' + RTRIM(LTRIM(CONVERT(CHAR(7), H.ServiceInvCode))),
	ReportType = 1,
	InvCode     = H.ServiceInvCode,
	InvType		= Case H.ServiceCatCode When 10 Then 'Cash' Else 'Credit' End, 
	Date        = H.Date,    
	AliasName   = A.AliasName, 
	CustomerName= A.Name, 
	PatientRegNo= 
		CASE WHEN H.AdmissionCode IS NULL THEN 
			CASE WHEN H.PatientCode IS NULL THEN NULL 
			ELSE (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = H.PatientCode) END
		ELSE 
			(SELECT P.RegNo FROM Patient P 
			WHERE P.PatientCode IN 
				(SELECT PA.PatientCode 
				FROM PatientAdmission PA 
				WHERE PA.Admissioncode = H.AdmissionCode))
		END,
	PatientName = 
		CASE WHEN H.AdmissionCode IS NULL THEN 
			CASE WHEN H.PatientCode IS NULL THEN NULL 
			ELSE (SELECT P.Name FROM Patient P WHERE P.PatientCode = H.PatientCode) END
		ELSE 
			(SELECT P.Name FROM Patient P 
			WHERE P.PatientCode IN 
				(SELECT PA.PatientCode 
				FROM PatientAdmission PA 
				WHERE PA.Admissioncode = H.AdmissionCode))
		END,
	Remarks= H.Remarks ,
	SalesMan = U.UserName,
	FlatDisc    = H.Flatdisc, 
	Misccharges = H.Misccharges, 
	InvDiscPerc = H.DiscPerc, 
	Amount =  ROUND(SUM(D.Qty * D.Price), 2),    
	ItemDiscPercValue = Round(Sum (D.Qty * (D.Price - D.ServiceFlatDisc) * D.DiscPerc * .01), 2),    
	InvDiscPercValue = Sum (Round( D.Qty * (D.Price - D.ServiceFlatDisc) * (1 - D.DiscPerc * .01), 2)) * (H.DiscPerc * 0.01),
	TotalDiscount=
		H.FlatDisc + 
		Round(Sum ( (D.Qty * D.ServiceFlatDisc)), 2)  + 
		Round(Sum ( (D.Qty * (D.Price - D.ServiceFlatDisc) * D.Discperc * .01)), 2)  + 
		Round(Sum ( D.Qty * (D.Price - D.ServiceFlatDisc) * (1 - D.DiscPerc * .01) ) * (H.DiscPerc * 0.01), 2),
	TotalTax =
			Round(
			Sum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc ) +
			Sum(D.qty * D.serviceflattax) +
			Round((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01* H.serviceinvgstperc,2), 0)
FROM
	dbo.ServiceHeader H, 
	dbo.ServiceDetail D,   
	dbo.Accounts A,
	dbo.Users U
WHERE
	( H.ServiceInvCode between :ar_StartInv and :ar_EndInv ) and
	( H.ServiceCatCode IN (:ar_retailtype, :ar_cashtype, :ar_credittype ) ) and
	( H.ServiceInvCode = D.ServiceInvCode ) and  
	( H.CustCode = A.acccode )and  
	( H.SalesManCode = U.UserCode )  
GROUP BY
	H.ServiceInvCode,    
	H.Date,   
	A.AliasName,
	A.Name,
	H.PatientCode,
	H.AdmissionCode,
	H.Misccharges,   
	H.FlatDisc,   
	H.DiscPerc,  
	H.serviceinvgstperc,
	H.ServiceCatCode, 
	U.UserName ,
	H.Remarks
UNION ALL
SELECT 
	documentcode = 'RR-' + RTRIM(LTRIM(CONVERT(CHAR(7), H.ServiceRInvCode))),
	ReportType = 2,
	InvCode     = H.ServiceRInvCode,
	InvType		= Case H.ServiceRCatCode When 13 Then 'Cash' Else 'Credit' End, 
	Date        = H.Date,    
	AliasName   = A.AliasName, 
	CustomerName= A.Name, 
	PatientRegNo= 
		CASE WHEN H.AdmissionCode IS NULL THEN 
			CASE WHEN H.PatientCode IS NULL THEN NULL 
			ELSE (SELECT P.RegNo FROM Patient P WHERE P.PatientCode = H.PatientCode) END
		ELSE 
			(SELECT P.RegNo FROM Patient P 
			WHERE P.PatientCode IN 
				(SELECT PA.PatientCode 
				FROM PatientAdmission PA 
				WHERE PA.Admissioncode = H.AdmissionCode))
		END,
	PatientName = 
		CASE WHEN H.AdmissionCode IS NULL THEN 
			CASE WHEN H.PatientCode IS NULL THEN NULL 
			ELSE (SELECT P.Name FROM Patient P WHERE P.PatientCode = H.PatientCode) END
		ELSE 
			(SELECT P.Name FROM Patient P 
			WHERE P.PatientCode IN 
				(SELECT PA.PatientCode 
				FROM PatientAdmission PA 
				WHERE PA.Admissioncode = H.AdmissionCode))
		END,
	Remarks= H.Remarks ,
	SalesMan = U.UserName,
	FlatDisc    = H.Flatdisc, 
	Misccharges = H.Misccharges, 
	InvDiscPerc = H.DiscPerc, 
	Amount = ROUND(SUM(D.Qty * D.ServicePrice), 2),    
	ItemDiscPercValue = Round(Sum (D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * D.DiscPerc * .01), 2),    
	InvDiscPercValue = Sum (Round( D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.DiscPerc * .01), 2)) * (H.DiscPerc * 0.01),
	TotalDiscount=
		H.FlatDisc + 
		Round(Sum ( (D.Qty * D.ServiceFlatDisc)), 2)  + 
		Round(Sum ( (D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * D.Discperc * .01)), 2)  + 
		Round(Sum ( D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.DiscPerc * .01) ) * (H.DiscPerc * 0.01), 2),
	TotalTax =
			Round(
			Sum((D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc ) +
			Sum(D.qty * D.serviceflattax) +
			Round((Sum(D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01* H.serviceinvgstperc,2), 0)
FROM
	dbo.ServiceRHeader H, 
	dbo.ServiceRDetail D,   
	dbo.Accounts A,
	dbo.Users U
WHERE
	( H.ServiceRInvCode between :ar_StartRInv and :ar_EndRInv ) and
	( H.ServiceRCatCode IN (:ar_retailrtype, :ar_cashrtype, :ar_creditrtype ) ) and
	( H.ServiceRInvCode = D.ServiceRInvCode ) and  
	( H.CustCode = A.acccode )and  
	( H.SalesManCode = U.UserCode )  
GROUP BY
	H.ServiceRInvCode,   
	H.Date,   
	A.AliasName,
	A.Name,
	H.PatientCode,
	H.AdmissionCode,
	H.Misccharges,   
	H.FlatDisc,   
	H.DiscPerc,  
	H.serviceinvgstperc,
	H.ServiceRCatCode, 
	U.UserName ,
	H.Remarks
ORDER BY
	ReportType,
	InvCode ASC,
	Date ASC
"
  arguments=(("ar_StartInv", number), ("ar_EndInv", number), ("ar_RetailType", number), ("ar_CashType", number), ("ar_CreditType", number), ("ar_StartRInv", number), ("ar_EndRInv", number), ("ar_RetailRType", number), ("ar_CashRType", number), ("ar_CreditRType", number))
 sort="reporttype A, invcode A, invtype A"
)
