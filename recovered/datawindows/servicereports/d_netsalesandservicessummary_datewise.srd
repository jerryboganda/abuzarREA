release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=492 color="536870912" )
summary(height=112 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(2) updatewhereclause=yes name=saleamt dbname="SaleAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=salereturnamt dbname="SaleReturnAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=netsale dbname="NetSale"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceamt dbname="ServiceAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=servicereturnamt dbname="ServiceReturnAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=netservice dbname="NetService"  )
column=(type=decimal(2) updatewhereclause=yes name=totalnetsales dbname="TotalNetSales"  )
 retrieve="SELECT  
	Date = CONVERT(DATETIME, CONVERT(varchar(10), T.Date, 101)),
	SaleAmt = SUM(CASE Type WHEN 'SALE' THEN T.SaleAmt ELSE 0.00 END),
	SaleReturnAmt = SUM(CASE Type WHEN 'SALE' THEN T.ReturnAmt ELSE 0.00 END),
	NetSale = SUM(CASE Type WHEN 'SALE' THEN T.SaleAmt - T.ReturnAmt ELSE 0.00 END),
	ServiceAmt = SUM(CASE Type WHEN 'SERVICE' THEN T.SaleAmt ELSE 0.00 END),
	ServiceReturnAmt = SUM(CASE Type WHEN 'SERVICE' THEN T.ReturnAmt ELSE 0.00 END),
	NetService = SUM(CASE Type WHEN 'SERVICE' THEN T.SaleAmt - T.ReturnAmt ELSE 0.00 END),
	TotalNetSales = SUM(T.SaleAmt - T.ReturnAmt)
FROM
	(SELECT 
		Type = 'SALE',
		InvCode = H.SaleInvCode,
		Date = H.Date,
		SaleAmt = DBO.fn_GetSaleInvTotal(H.SaleInvCode),
		ReturnAmt = 0.00
	FROM 
		SaleLedger H
	WHERE 
		H.Date BETWEEN :ad_startdate AND :ad_enddate
	GROUP BY
		H.SaleInvCode,
		H.Date
	UNION ALL
	SELECT 
		Type = 'SALE',
		InvCode = H.SRInvCode,
		Date = H.Date,
		SaleAmt = 0.00,
		ReturnAmt = DBO.fn_GetSRInvTotal(H.SRInvCode)
	FROM 
		SRLedger H
	WHERE 
		H.Date BETWEEN :ad_startdate AND :ad_enddate
	GROUP BY
		H.SRInvCode,
		H.Date
	UNION ALL
	SELECT 
		Type = 'SERVICE',
		InvCode = H.ServiceInvCode,
		Date = H.Date,
		SaleAmt = DBO.fn_GetServiceInvTotal(H.ServiceInvCode),
		ReturnAmt = 0.00
	FROM 
		ServiceHeader H
	WHERE 
		H.Date BETWEEN :ad_startdate AND :ad_enddate
	GROUP BY
		H.ServiceInvCode,
		H.Date
	UNION ALL
	SELECT 
		Type = 'SERVICE',
		InvCode = H.ServiceRInvCode,
		Date = H.Date,
		SaleAmt = 0.00,
		ReturnAmt = DBO.fn_GetServiceReturnInvTotal(H.ServiceRInvCode)
	FROM 
		ServiceRHeader H, ServiceRDetail D
	WHERE 
		H.Date BETWEEN :ad_startdate AND :ad_enddate
	GROUP BY
		H.ServiceRInvCode,
		H.Date) T
GROUP BY
	CONVERT(DATETIME, CONVERT(varchar(10), T.Date, 101))
ORDER BY
	Date

"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
)
