table(column=(type=long updatewhereclause=yes name=servicerinvcode dbname="servicerinvcode"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="serviceinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=servicediscperc dbname="servicediscperc"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="serviceflatdisc"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="servicename"  )
column=(type=char(32) updatewhereclause=yes name=datestring dbname="datestring"  )
column=(type=char(60) updatewhereclause=yes name=person dbname="Person"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceinvgstperc dbname="serviceinvgstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflattax dbname="ServiceFlatTax"  )
column=(type=decimal(2) updatewhereclause=yes name=servicegstperc dbname="ServiceGstperc"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="rowid"  )
 retrieve="SELECT
	servicerinvcode = dbo.servicerheader.servicerinvcode,
	serviceinvcode = dbo.servicerheader.serviceinvcode, 
	date = dbo.servicerheader.date, 
	invdiscperc = dbo.servicerheader.discperc, 
	flatdisc = dbo.servicerheader.flatdisc, 
	misccharges = dbo.servicerheader.misccharges, 
	servicediscperc = dbo.servicerdetail.discperc, 
	doctype = Case dbo.servicerheader.servicercatcode When 15 Then 'Cash' When 14 Then 'Credit' Else 'Cash' End, 
	qty = dbo.servicerdetail.qty, 
	price = dbo.servicerdetail.serviceprice, 
	serviceflatdisc= dbo.servicerdetail.serviceflatdisc, 
	salesperson = dbo.salesman.name, 
	servicename = service.name, 
	datestring = Rtrim(LTrim(Str(DatePart(dd, servicerheader.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, servicerheader.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, servicerheader.date)))), 
	Person = dbo.accounts.name,
	serviceinvgstperc = dbo.servicerheader.serviceinvgstperc,
	ServiceFlatTax=dbo.servicerdetail.ServiceFlatTax,
	ServiceGstperc=dbo.servicerdetail.ServiceGstperc,
	rowid=dbo.servicerdetail.srvrrowid
FROM 	 
	dbo.servicerheader, 
	dbo.servicerdetail
	LEFT OUTER JOIN dbo.salesman ON (dbo.servicerdetail.smancode = dbo.salesman.salesmancode),
	dbo.service, 
	dbo.accounts
	
WHERE  
	dbo.servicerheader.date >= :ad_StartDate and
	dbo.servicerheader.date <= :ad_EndDate  and
	dbo.servicerheader.servicerinvcode = dbo.servicerdetail.servicerinvcode and  
	dbo.servicerdetail.servicecode = service.servicecode and 
	dbo.servicerheader.custcode = dbo.accounts.acccode
"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime))
 sort="servicerinvcode A, rowid A"
)
