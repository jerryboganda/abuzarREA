table(column=(type=char(100) updatewhereclause=yes name=classname dbname="ClassName"  )
column=(type=char(40) updatewhereclause=yes name=rollno dbname="RollNo"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=char(100) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=char(60) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=decimal(2) updatewhereclause=yes name=servicecharged dbname="ServiceCharged"  )
column=(type=decimal(2) updatewhereclause=yes name=collected dbname="Collected"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
 retrieve="SELECT 
	ClassName=C.Name, 
	RollNo=SC.RollNo,
	RegNo=S.RegNo,
	StudentName=S.Name,
	FatherName=S.FName,
	Phone = S.Phone,
	ServiceCharged=(SELECT InvTotal=SUM(SH.InvTotal) FROM ServiceHeader SH WHERE SH.StudentCode = SC.StudentCode AND SH.Date BETWEEN :adt_startdate AND :adt_enddate),
	Collected=(SELECT Collected=SUM(SH.InvTotal - SH.OutstandingAmt) FROM ServiceHeader SH WHERE SH.StudentCode = SC.StudentCode AND SH.Date BETWEEN :adt_startdate AND :adt_enddate),
	Balance=(SELECT Balance=SUM(SH.OutstandingAmt) FROM ServiceHeader SH WHERE SH.StudentCode = SC.StudentCode AND SH.Date BETWEEN :adt_startdate AND :adt_enddate)
FROM
	Class C, Student S, StudentClass SC
WHERE
	C.Active = 'Y' AND
	C.ClassCode IN (:ai_classcode) AND
	C.ClassCode = SC.ClassCode AND
	SC.StudentCode = S.StudentCode AND
	SC.ClassCode = S.CurrentClass 
ORDER BY 
	ClassName,
	StudentName"
  arguments=(("ai_classcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="classname A, rollno A, studentname A"
)
