release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=544 color="536870912" )
summary(height=83 color="536870912" )
footer(height=0 color="536870912" )
detail(height=74 color="536870912" )
table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=long update=yes updatewhereclause=yes name=servicecode dbname="ServiceCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(8) update=yes updatewhereclause=yes name=purvalue dbname="PurValue"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=decimal(8) update=yes updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(8) updatewhereclause=yes name=profit dbname="Profit"  )
column=(type=decimal(6) updatewhereclause=yes name=profitperc dbname="ProfitPerc"  )
 retrieve="SELECT
	AliasName = (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = T.Suppcode),
	SupplierName = (SELECT A.Name FROM Accounts A WHERE A.AccCode = T.Suppcode),
	ServiceCode=S.ServiceCode,
	ServiceName=S.Name,
	PurQty = SUM(T.PurQty),
	PurValue = SUM(PurValue),
	SaleQty= SUM(T.SaleQty),
	SaleValue = SUM(T.SaleValue),
	Profit = SUM(T.SaleValue) - SUM(PurValue),
	ProfitPerc = ((SUM(T.SaleValue) - SUM(PurValue)) / CASE WHEN SUM(T.SaleValue) > 0 THEN SUM(T.SaleValue) ELSE 1 END) * 100
FROM
	Service S,
	(SELECT 
		SuppCode = SP.SuppCode,
		ServiceCode=S.ServiceCode,
		PurQty = SUM(SPD.Qty),
		PurValue = ROUND(SUM(SPD.Qty * (SPD.Price - SPD.ServiceFlatDisc) * (1 - SPD.DiscPerc * 0.01)), 2),
		SaleQty = 0.0000,
		SaleValue = 0.00
	FROM
		Supplier SUP, Accounts A, ServicePurHeader SP, ServicePurDetail SPD, Service S
	WHERE
		S.ServiceCatCode IN (:ai_servicecode) AND
		S.ServiceCode = SPD.ServiceCode AND
		SPD.ServicePurInvCode = SP.ServicePurInvCode AND 
		SP.Date BETWEEN :adt_StartDate AND :adt_EndDate AND
		SP.SuppCode = SUP.SuppCode AND
		SUP.SuppCode IN (:ai_suppcode) AND
		SUP.SuppCode = A.AccCode
	GROUP BY
		SP.SuppCode,
		S.ServiceCode
	UNION ALL
	SELECT 
		SuppCode = M.SuppCode,
		ServiceCode=S.ServiceCode,
		PurQty = 0.0000,
		PurValue = 0.00,
		SaleQty = SUM(SPD.Qty),
		SaleValue = ROUND(SUM(SPD.Qty * (SPD.Price - SPD.ServiceFlatDisc) * (1 - SPD.DiscPerc * 0.01)), 2)
	FROM
		ServiceHeader SP, ServiceDetail SPD, Service S,
		(SELECT P.ServicePurInvCode, P.ServiceInvCode, P.SuppCode
		FROM ServicePurHeader P
		WHERE P.Date BETWEEN :adt_StartDate AND :adt_EndDate AND
		P.SuppCode IN (:ai_suppcode)) M
	WHERE
		S.ServiceCatCode IN (:ai_servicecode) AND
		S.ServiceCode = SPD.ServiceCode AND
		SPD.ServiceInvCode = SP.ServiceInvCode AND
		SP.ServiceInvCode = M.ServiceInvCode AND
		SP.Date BETWEEN :adt_StartDate AND :adt_EndDate
	GROUP BY
		M.SuppCode,
		S.ServiceCode) T
WHERE
	S.ServiceCode = T.ServiceCode
GROUP BY
	T.Suppcode,
	S.ServiceCode,
	S.Name
"
  arguments=(("ai_servicecode", numberlist), ("ai_suppcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="aliasname A, suppliername A, servicename A"
)
