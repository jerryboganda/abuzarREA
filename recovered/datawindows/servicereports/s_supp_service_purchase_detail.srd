table(column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=servicepurinvcode dbname="ServicePurInvCode"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=decimal(2) updatewhereclause=yes name=outstandingamt dbname="OutstandingAmt"  )
column=(type=char(60) updatewhereclause=yes name=service dbname="Service"  )
column=(type=decimal(4) updatewhereclause=yes name=share dbname="Share"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=decimal(8) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=decimal(2) updatewhereclause=yes name=returnamt dbname="ReturnAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=paidamt dbname="PaidAmt"  )
 retrieve="SELECT 
	Date=H.Date, 
	ServicePurInvCode=H.ServicePurInvCode, 
	SuppCode=H.SuppCode, 
	Supplier = A.Name, 
	RegNo = (SELECT P.RegNo FROM ServiceHeader SH, Patient P 
			WHERE SH.ServiceInvCode=H.ServiceInvCode AND 
			P.PatientCode IN (CASE WHEN SH.PatientCode > 0 THEN SH.PatientCode
			ELSE (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)
			END)),
	Patient = (SELECT P.Name FROM ServiceHeader SH, Patient P 
			WHERE SH.ServiceInvCode=H.ServiceInvCode AND 
			P.PatientCode IN (CASE WHEN SH.PatientCode > 0 THEN SH.PatientCode
			ELSE (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = SH.AdmissionCode)
			END)),
	Posted=H.Posted, 
	InvTotal=H.InvTotal, 
	OutstandingAmt=H.OutstandingAmt,
	Service=SV.Name,
	Share = D.Qty * D.Price,
	RowID=D.RowID,
	NetAmount = D.Qty * (D.Price - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01),
	ReturnAmt = ISNULL((SELECT SR.InvTotal
			FROM ServicePRHeader SR
			WHERE SR.ServicePurInvCode = H.ServicePurInvCode), 0),
	PaidAmt = ISNULL((SELECT SUM(GD.Debit)
			FROM VocherCategory VC, GLHeader GL, GLDetail GD
			WHERE VC.InvoiceType=4 AND 
				VC.VochCatCode = GL.VochCatCode AND 
				GL.GLVochCode = GD.GLVochCode AND GD.InvoiceCode = H.ServicePurInvCode), 0)
FROM ServicePurHeader H, ServicePurDetail D, Supplier S, Accounts A, Service SV
WHERE 
	H.Date BETWEEN :adt_startdate AND :adt_enddate AND
	H.SuppCode IN (:ai_suppcode) AND
	H.ServicePurInvCode = D.ServicePurInvCode AND
	H.SuppCode = S.SuppCode AND
	S.SuppCode = A.AccCode AND
	D.ServiceCode = SV.ServiceCode
"
  arguments=(("ai_suppcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="supplier A, servicepurinvcode A, rowid A"
)
