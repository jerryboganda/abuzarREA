release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1291 color="536870912" )
summary(height=437 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=servicecategory dbname="ServiceCategory"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
column=(type=decimal(6) updatewhereclause=yes name=servicevalue dbname="ServiceValue"  )
column=(type=decimal(6) updatewhereclause=yes name=unitcost dbname="UnitCost"  )
column=(type=decimal(7) updatewhereclause=yes name=servicecost dbname="ServiceCost"  )
column=(type=decimal(6) updatewhereclause=yes name=profitrate dbname="ProfitRate"  )
column=(type=decimal(6) updatewhereclause=yes name=profitloss dbname="ProfitLoss"  )
column=(type=decimal(6) updatewhereclause=yes name=profitmargin dbname="ProfitMargin"  )
 retrieve="SELECT
	ServiceCategory=S.ServiceCategory,
	ServiceName=S.ServiceName,
	Qty = SUM(S.Qty),
	UnitPrice = SUM(S.ServiceValue) / CASE WHEN SUM(S.Qty) > 0 THEN SUM(S.Qty) ELSE 1 END,
	ServiceValue = SUM(S.ServiceValue),
	UnitCost = SUM(S.ServiceCost) / CASE WHEN SUM(S.Qty) > 0 THEN SUM(S.Qty) ELSE 1 END,
	ServiceCost = SUM(S.ServiceCost),
	ProfitRate = (SUM(S.ServiceValue) - SUM(S.ServiceCost)) / CASE WHEN SUM(S.Qty) > 0 THEN SUM(S.Qty) ELSE 1 END,
	ProfitLoss = SUM(S.ServiceValue) - SUM(S.ServiceCost),
	ProfitMargin = ((SUM(S.ServiceValue) - SUM(S.ServiceCost)) / CASE WHEN SUM(S.ServiceCost) > 0 THEN SUM(S.ServiceCost) ELSE 1 END) * 100
FROM
	(SELECT 
		ServiceCategory=SC.Name, 
		ServiceName=S.Name, 
		Qty = SUM(SD.Qty), 
		ServiceValue = SUM(SD.Qty * (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SH.DiscPerc * 0.01)),
		ServiceCost = SUM(SD.Qty * SD.CostPrice)
		
	FROM
		ServiceHeader SH, 
		ServiceDetail SD, 
		Service S, 
		ServiceCategory SC
	WHERE 
		SH.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SH.ServiceInvCode = SD.ServiceInvCode AND
		SD.ServiceCode = S.ServiceCode AND
		S.ServiceCatCode = SC.ServiceCatCode AND
		SC.ServiceCatCode IN (:ai_servicecatcode)
	GROUP BY
		SC.Name,
		S.Name
	UNION ALL
	SELECT 
		ServiceCategory=SC.Name, 
		ServiceName=S.Name, 
		Qty = - SUM(SD.Qty), 
		ServiceValue = - SUM(SD.Qty * (SD.ServicePrice - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SH.DiscPerc * 0.01)),
		ServiceCost = - SUM(SD.Qty * SD.CostPrice)
		
	FROM
		ServiceRHeader SH, 
		ServiceRDetail SD, 
		Service S, 
		ServiceCategory SC
	WHERE 
		SH.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SH.ServiceRInvCode = SD.ServiceRInvCode AND
		SD.ServiceCode = S.ServiceCode AND
		S.ServiceCatCode = SC.ServiceCatCode AND
		SC.ServiceCatCode IN (:ai_servicecatcode)
	GROUP BY
		SC.Name,
		S.Name) S
GROUP BY
	S.ServiceCategory, 
	S.ServiceName
ORDER BY
	S.ServiceCategory, 
	S.ServiceName
"
  arguments=(("ai_servicecatcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="servicecategory A, servicename A"
 filter=" qty <> 0"
 )
