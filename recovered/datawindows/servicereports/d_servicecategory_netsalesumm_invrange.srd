release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=412 color="536870912" )
summary(height=424 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=summary dbname="Summary"  )
column=(type=long updatewhereclause=yes name=catcode dbname="CatCode"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=decimal(6) updatewhereclause=yes name=servicevalue dbname="ServiceValue"  )
column=(type=decimal(6) updatewhereclause=yes name=rounddiff dbname="RoundDiff"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="FlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="MiscCharges"  )
column=(type=decimal(4) updatewhereclause=yes name=tax dbname="Tax"  )
 retrieve="SELECT
	Summary=0,
	CatCode=SC.ServiceCatCode, 
	Category=SC.Name,
	ServiceValue=ROUND(SUM(P.ServiceValue), 2),
	RoundDiff=0,
	FlatDisc=0,
	MiscCharges=0,
	Tax = 0.00
FROM 
	(SELECT
		S.ServiceCatCode,
		D.ServiceCode,
		H.ServiceInvCode,
		ServiceValue=ROUND(SUM(D.qty * (D.price - D.ServiceFlatDisc) * (1 - (.01 * D.discperc)) * (1 - H.discperc * .01)), 2)
	FROM
		ServiceHeader H,	 
		ServiceDetail D,
		Service S
	WHERE
		( H.ServiceInvCode between :ar_StartInv and :ar_EndInv ) and
		( H.ServiceCatCode IN (:ar_retailtype, :ar_cashtype, :ar_credittype ) ) and
		( H.ServiceInvCode = D.ServiceInvCode ) and  
		( D.ServiceCode = S.ServiceCode )
	GROUP BY 
		S.ServiceCatCode,
		H.ServiceInvCode,
		D.ServiceCode
	UNION ALL
	SELECT
		S.ServiceCatCode,
		D.ServiceCode,
		H.ServiceRInvCode,
		ServiceValue= - ROUND(SUM(D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - (.01 * D.discperc)) * (1 - H.discperc * .01)), 2)
	FROM
		ServiceRHeader H,	 
		ServiceRDetail D,
		Service S
	WHERE
		( H.ServiceRInvCode between :ar_StartRInv and :ar_EndRInv ) and
		( H.ServiceRCatCode IN (:ar_retailrtype, :ar_cashrtype, :ar_creditrtype ) ) and
		( H.ServiceRInvCode = D.ServiceRInvCode ) and  
		( D.ServiceCode = S.ServiceCode )
	GROUP BY 
		S.ServiceCatCode,
		H.ServiceRInvCode,
		D.ServiceCode) P, 
	Service S, 
	ServiceCategory SC
WHERE
	P.ServiceCode = S.ServiceCode AND 
	S.ServiceCatCode = SC.ServiceCatCode
GROUP BY 
	SC.ServiceCatCode,
	SC.Name
UNION ALL
SELECT
	Summary=1,
	ServiceCatCode=NULL, 
	Category=NULL,
	ServiceValue=0,
	RoundDiff=SUM(Value),
	FlatDisc=SUM(FlatDisc),
	MiscCharges=SUM(MiscCharges),
	Tax = SUM(Tax)
FROM
	(SELECT
		H.ServiceInvCode,
		Value=ROUND(SUM(D.qty * (D.price - D.ServiceFlatDisc) * (1 - (.01 * D.discperc)) * (1 - H.discperc * .01)) - H.FlatDisc + H.MiscCharges, 0) -
		(ROUND(SUM(D.qty * (D.price - D.ServiceFlatDisc) * (1 - (.01 * D.discperc)) * (1 - H.discperc * .01)) - H.FlatDisc + H.MiscCharges, 2)),
		FlatDisc = - H.FlatDisc,
		MiscCharges = H.MiscCharges,
		Tax = Round(Sum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc ) +
			Sum(D.qty * D.serviceflattax) +
			Round((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01 * H.serviceinvgstperc,2), 0)
	FROM
		ServiceHeader H,	 
		ServiceDetail D,
		Service S
	WHERE
		( H.ServiceInvCode between :ar_StartInv and :ar_EndInv ) and
		( H.ServiceCatCode IN (:ar_retailtype, :ar_cashtype, :ar_credittype ) ) and
		( H.ServiceInvCode = D.ServiceInvCode ) and  
		( D.ServiceCode = S.ServiceCode )
	GROUP BY 
		S.ServiceCatCode,
		H.ServiceInvCode,
		H.FlatDisc,
		H.MiscCharges,
		H.serviceinvgstperc
	UNION ALL
	SELECT
		H.ServiceRInvCode,
		Value= - (ROUND(SUM(D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - (.01 * D.discperc)) * (1 - H.discperc * .01)) - H.FlatDisc + H.MiscCharges, 0) -
		(ROUND(SUM(D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - (.01 * D.discperc)) * (1 - H.discperc * .01)) - H.FlatDisc + H.MiscCharges, 2))),
		FlatDisc = H.FlatDisc,
		MiscCharges = - H.MiscCharges,
		Tax = Round(Sum((D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc ) +
			Sum(D.qty * D.serviceflattax) +
			Round((Sum(D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01 * H.serviceinvgstperc,2), 0)
	FROM
		ServiceRHeader H,	 
		ServiceRDetail D,
		Service S
	WHERE
		( H.ServiceRInvCode between :ar_StartRInv and :ar_EndRInv ) and
		( H.ServiceRCatCode IN (:ar_retailrtype, :ar_cashrtype, :ar_creditrtype ) ) and
		( H.ServiceRInvCode = D.ServiceRInvCode ) and  
		( D.ServiceCode = S.ServiceCode )
	GROUP BY 
		S.ServiceCatCode,
		H.ServiceRInvCode,
		H.FlatDisc,
		H.MiscCharges,
		H.serviceinvgstperc) T
ORDER BY 
	Summary,
	Category, 
	CatCode
"
  arguments=(("ar_StartInv", number), ("ar_EndInv", number), ("ar_RetailType", number), ("ar_CashType", number), ("ar_CreditType", number), ("ar_StartRInv", number), ("ar_EndRInv", number), ("ar_RetailRType", number), ("ar_CashRType", number), ("ar_CreditRType", number))
 sort="summary A, category A, catcode A"
)
