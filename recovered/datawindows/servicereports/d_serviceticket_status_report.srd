release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1666 color="536870912" )
summary(height=260 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=long updatewhereclause=yes name=serviceticketcode dbname="ServiceTicketCode"  )
column=(type=char(1) updatewhereclause=yes name=ticketused dbname="TicketUsed"  )
column=(type=datetime updatewhereclause=yes name=ticketusedon dbname="TicketUsedOn"  )
column=(type=long updatewhereclause=yes name=scanned dbname="Scanned"  )
column=(type=long updatewhereclause=yes name=unscanned dbname="UnScanned"  )
column=(type=datetime updatewhereclause=yes name=expireson dbname="ExpiresOn"  )
 retrieve="SELECT 
	Date = ST.Date,
	ServiceName = S.Name,
	ServiceTicketCode = ST.ServiceTicketCode,
	TicketUsed = ST.TicketUsed,
	TicketUsedOn = ST.TicketUsedOn, 
	Scanned = CASE WHEN TicketUsed = 'Y' THEN ST.ServiceTicketCode ELSE NULL END,
	UnScanned = CASE WHEN TicketUsed = 'Y' THEN NULL ELSE ST.ServiceTicketCode END,
	ExpiresOn = ST.ExpiresOn
FROM 
	ServiceTicket ST, Service S
WHERE
	ST.Date BETWEEN :adt_startdate AND :adt_enddate AND
	ST.ServiceCode = S.ServiceCode
ORDER BY
	ST.ServiceTicketCode
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
)
