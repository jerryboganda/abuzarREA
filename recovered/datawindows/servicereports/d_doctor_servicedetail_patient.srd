table(column=(type=char(13) updatewhereclause=yes name=invoiceno dbname="InvoiceNo"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=doctcode dbname="DoctCode"  )
column=(type=long updatewhereclause=yes name=servicecode dbname="ServiceCode"  )
column=(type=long updatewhereclause=yes name=servicecatcode dbname="ServiceCatCode"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=char(60) updatewhereclause=yes name=service dbname="Service"  )
column=(type=char(60) updatewhereclause=yes name=servicecategory dbname="ServiceCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=svcqty dbname="SvcQty"  )
column=(type=decimal(6) updatewhereclause=yes name=svcvalue dbname="SvcValue"  )
column=(type=decimal(2) updatewhereclause=yes name=svcretqty dbname="SvcRetQty"  )
column=(type=decimal(6) updatewhereclause=yes name=svcretvalue dbname="SvcRetValue"  )
column=(type=decimal(2) updatewhereclause=yes name=netqty dbname="NetQTY"  )
column=(type=decimal(6) updatewhereclause=yes name=netvalue dbname="NetValue"  )
column=(type=decimal(6) updatewhereclause=yes name=netshare dbname="NetShare"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegno"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
 retrieve="SELECT
	InvoiceNo=S.InvoiceNo,
	Date = S.Date,
	DoctCode=S.DoctCode, 
	ServiceCode=S.ServiceCode, 
	ServiceCatCode=S.ServiceCatCode, 
	Doctor=D.Name,
	Service=Sv.Name,
	ServiceCategory=SC.Name, 
	SvcQty = SUM(S.SvcQty),
	SvcValue = SUM(S.SvcValue),
	SvcRetQty = SUM(S.SvcRetQty),
	SvcRetValue = SUM(S.SvcRetValue),
	NetQTY = SUM(S.QTY), 
	NetValue = SUM(S.Value),
	NetShare=SUM(S.commission),
	PatientRegno=P.RegNo,
	PatientName=P.Name
FROM
	(SELECT 
		InvoiceNo='RS-' + LTRIM(RTRIM(STR(H.ServiceInvCode,10))),
		H.Date,
		H.DoctCode, 
		S.ServiceCode, 
		SC.ServiceCatCode, 
		SvcQty = SUM(D.QTY), 
		SvcValue = SUM(D.QTY * (D.Price - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01) * (1 - H.Discperc * 0.01)),
		SvcRetQty = 0, 
		SvcRetValue = 0.00,
		QTY = SUM(D.QTY), 
		Value = SUM(D.QTY * (D.Price - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01) * (1 - H.Discperc * 0.01)),
		commission= SUM(D.QTY * (D.Commission - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01) * (1 - H.Discperc * 0.01)) + 
			SUM(D.Qty * (D.Price - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01)  * (1 - H.Discperc * 0.01) * D.SharePerc * 0.01),
		PatientCode = CASE WHEN H.PatientCode IS NOT NULL THEN H.PatientCode
						ELSE (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = H.AdmissionCode)
						END
	FROM ServiceHeader H, ServiceDetail D, ServiceCategory SC, Service S
	WHERE 
		H.DoctCode IN (:ai_doctcode) AND 
		H.CustCode IN (:ai_custcode) AND 
		H.Date BETWEEN :ad_startdate AND :ad_enddate AND
		H.ServiceInvCode = D.ServiceInvCode AND 
		D.ServiceCode = S.ServiceCode AND
		S.ServiceCatCode = SC.ServiceCatCode AND
		SC.ServiceCatCode IN (:ai_servicecatcode)
	GROUP BY
		SC.ServiceCatCode, 
		S.ServiceCode, 
		H.ServiceInvCode,
		H.Date,
		H.DoctCode,
		H.PatientCode,
		H.AdmissionCode
	UNION ALL
	SELECT 
		InvoiceNo='RR-' + LTRIM(RTRIM(STR(H.ServiceRInvCode,10))),
		H.Date,
		H.DoctCode, 
		S.ServiceCode, 
		SC.ServiceCatCode, 
		SvcQty = 0, 
		SvcValue = 0.00,
		SvcRetQty = SUM(D.QTY), 
		SvcRetValue = SUM(D.QTY * (D.ServicePrice- D.ServiceFlatDisc) * (1 - D.Discperc * 0.01) * (1 - H.Discperc * 0.01)),
		QTY = -SUM(D.QTY), 
		Value = -SUM(D.QTY * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01) * (1 - H.Discperc * 0.01)),
		commission= - (SUM(D.QTY * (D.Commission - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01) * (1 - H.Discperc * 0.01)) + 
			SUM(D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.Discperc * 0.01)  * (1 - H.Discperc * 0.01) * D.SharePerc * 0.01)),
		PatientCode = CASE WHEN H.PatientCode IS NOT NULL THEN H.PatientCode
						ELSE (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode = H.AdmissionCode)
						END
	FROM ServiceRHeader H, ServiceRDetail D, ServiceCategory SC, Service S
	WHERE 
		H.DoctCode IN (:ai_doctcode) AND 
		H.CustCode IN (:ai_custcode) AND 
		H.Date BETWEEN :ad_startdate AND :ad_enddate AND
		H.ServiceRInvCode = D.ServiceRInvCode AND 
		D.ServiceCode = S.ServiceCode AND
		S.ServiceCatCode = SC.ServiceCatCode AND
		SC.ServiceCatCode IN (:ai_servicecatcode)
	GROUP BY
		SC.ServiceCatCode, 
		H.ServiceRInvCode,
		S.ServiceCode, 
		H.Date,
		H.DoctCode,
		H.PatientCode,
		H.AdmissionCode) AS S LEFT OUTER JOIN 	Patient AS P ON (S.PatientCode = P.PatientCode),
	Doctors D,
	Service Sv,
	ServiceCategory SC
WHERE
	S.ServiceCode = SV.ServiceCode AND
	S.ServiceCatCode = SC.ServiceCatCode AND
	S.DoctCode = D.DoctCode
GROUP BY
	P.Regno,
	P.Name,
	S.InvoiceNo,
	S.Date,
	S.DoctCode,
	D.Name,
	S.ServiceCode,
	Sv.Name,
	S.ServiceCatCode,
	SC.Name
ORDER BY
	ServiceCategory,
	Doctor,
	Service,
	PatientName,
	PatientRegno
"
  arguments=(("ai_doctcode", numberlist), ("ai_servicecatcode", numberlist), ("ai_custcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="servicecategory A, doctor A, service A, patientname A, patientregno A"
)
