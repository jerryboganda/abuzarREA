release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1416 color="536870912" )
summary(height=291 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(4) updatewhereclause=yes name=gross dbname="Gross"  )
column=(type=decimal(4) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(4) updatewhereclause=yes name=tax dbname="TAX"  )
column=(type=decimal(4) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=servicereturn dbname="ServiceReturn"  )
column=(type=decimal(2) updatewhereclause=yes name=servicepurchased dbname="ServicePurchased"  )
column=(type=decimal(2) updatewhereclause=yes name=finalamt dbname="FinalAmt"  )
 retrieve="SELECT  
	Date = CONVERT(DATETIME, CONVERT(varchar(10), T.Date, 101)),
	Gross = SUM(T.Gross),
	Discount = SUM(T.Discount),
	TAX = SUM(T.Tax),
	NetAmt = SUM(T.NetAmt),
	ServiceReturn = SUM(T.ServiceReturn),
	ServicePurchased = SUM(T.ServicePurchased),
	FinalAmt = SUM(T.NetAmt - T.ServicePurchased)
FROM
	(SELECT 
		InvCode = H.ServiceInvCode,
		Date = H.Date,
		Type = CASE H.ServiceCatCode WHEN 10 THEN 1 ELSE 2 END,
		Gross = ISNULL(SUM(D.Qty * D.price), 0),
		Discount = ISNULL(SUM(D.Qty * D.ServiceFlatDisc) + 
			SUM(D.Qty * (D.price - D.ServiceFlatDisc) * (D.DiscPerc * 0.01)) +
			SUM(D.Qty * (D.price - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (H.DiscPerc * 0.01)) + H.FlatDisc, 0),
		Tax = Round(Sum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc) +
			Sum(D.qty * D.serviceflattax ) +
			Round((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01 * H.serviceinvgstperc,2), 0),
		NetAmt = ISNULL(SUM(D.Qty * (D.price - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01)) + MiscCharges - FlatDisc, 0) +
			Round(Sum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc) +
			Sum(D.qty * D.serviceflattax ) +
			Round((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01 * H.serviceinvgstperc,2), 0),
		ServiceReturn = ISNULL((SELECT SUM(SRH.InvTotal) FROM ServiceRHeader SRH WHERE SRH.ServiceInvCode = H.ServiceInvCode), 0),
		ServicePurchased = ISNULL((SELECT SUM(SPH.InvTotal) FROM ServicePurHeader SPH WHERE SPH.ServiceInvCode = H.ServiceInvCode), 0)
	FROM 
		ServiceHeader H, ServiceDetail D
	WHERE 
		H.Date BETWEEN :ad_startdate AND :ad_enddate AND
		H.ServiceInvCode = D.ServiceInvCode 
	GROUP BY
		H.ServiceInvCode,
		H.Date,
		H.ServiceCatCode,
		H.MiscCharges,
		H.serviceinvgstperc,
		H.FlatDisc) T
GROUP BY
	CONVERT(DATETIME, CONVERT(varchar(10), T.Date, 101))
ORDER BY
	Date"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
)
