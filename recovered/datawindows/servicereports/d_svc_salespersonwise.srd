release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=576 color="536870912" )
summary(height=364 color="536870912" )
footer(height=4 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=char(60) updatewhereclause=yes name=service dbname="Service"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=decimal(6) updatewhereclause=yes name=netshare dbname="NetShare"  )
column=(type=decimal(2) updatewhereclause=yes name=invflatdisc dbname="invflatdisc"  )
 retrieve="Select A.SalesPerson,
       A.Service,
       A.Qty,
       A.ReturnQty, 
       A.Amount ,
	 NetShare= A.commission,
	 invflatdisc=(select isnull(sum(flatdisc),0)
					from serviceheader 
					where dbo.ServiceHeader.Date >= :ad_startdate AND
                     			dbo.ServiceHeader.Date <= :ad_enddate AND
							serviceinvcode in (select distinct(serviceinvcode) from servicedetail where servicedetail.smancode=A.smancode)
					)
					-
					(select isnull(sum(flatdisc),0)
					from servicerheader 
					where dbo.servicerheader.Date >= :ad_startdate AND
                     			dbo.servicerheader.Date <= :ad_enddate AND
							 servicerinvcode in (select distinct(servicerinvcode) from servicerdetail where servicerdetail.smancode=A.smancode)
					)

From (

Select SalesPerson = S.name,
		smancode=S.salesmancode,
       Service = dbo.Service.Name,
       Qty = ( Select IsNull( SUM (dbo.ServiceDetail.Qty), 0 )
               From dbo.ServiceHeader, 
                    dbo.ServiceDetail
               Where dbo.ServiceHeader.Date >= :ad_startdate AND
                     dbo.ServiceHeader.Date <= :ad_enddate AND
                     dbo.ServiceHeader.ServiceInvCode = dbo.ServiceDetail.ServiceInvCode AND
                     dbo.ServiceDetail.ServiceCode = dbo.Service.ServiceCode AND
                     dbo.ServiceDetail.SmanCode = S.SalesManCode

             ), 
      ReturnQty = ( Select IsNull( SUM (dbo.ServiceRDetail.QTY), 0 )
              	     From dbo.ServiceRHeader, 
                         dbo.ServiceRDetail
              	     Where dbo.ServiceRHeader.Date >= :ad_startdate AND
                          dbo.ServiceRHeader.Date <= :ad_enddate AND
                          dbo.ServiceRHeader.ServiceRInvCode = dbo.ServiceRDetail.ServiceRInvCode AND
                          dbo.ServiceRDetail.ServiceCode = dbo.Service.ServiceCode AND
		                    dbo.ServiceRDetail.SmanCode = S.SalesManCode

	           ), 
       Amount = ( Select IsNull( Sum ( Round ( Round ( dbo.ServiceDetail.Qty * (dbo.ServiceDetail.price - dbo.ServiceDetail.serviceflatdisc) * ( 1 - (dbo.ServiceDetail.discperc * 0.01) ) , 2 ) * ( 1 - ( dbo.ServiceHeader.DiscPerc * 0.01) ), 2 ) ), 0 )
                  From dbo.ServiceHeader,
                       dbo.ServiceDetail
		            Where dbo.ServiceHeader.Date >= :ad_startdate AND
                        dbo.ServiceHeader.Date <= :ad_enddate AND
                        dbo.ServiceHeader.ServiceInvCode = dbo.ServiceDetail.ServiceInvCode AND
                        dbo.ServiceDetail.ServiceCode = dbo.Service.ServiceCode AND
	               		dbo.ServiceDetail.SmanCode = S.SalesManCode
					)
					-
					( Select IsNull( Sum ( Round ( Round ( dbo.ServiceRDetail.Qty * (dbo.ServiceRDetail.ServicePrice - dbo.ServiceRDetail.serviceflatdisc)  * ( 1 - (dbo.ServiceRDetail.discperc * 0.01) ) , 2 ) * ( 1 - ( dbo.ServiceRHeader.DiscPerc * 0.01) ), 2 ) ), 0 )
                 From dbo.ServiceRHeader,
                      dbo.ServiceRDetail
	      		  Where dbo.ServiceRHeader.Date >= :ad_startdate AND
                       dbo.ServiceRHeader.Date <= :ad_enddate AND
                       dbo.ServiceRHeader.ServiceRInvCode = dbo.ServiceRDetail.ServiceRInvCode AND
                       dbo.ServiceRDetail.ServiceCode = dbo.Service.ServiceCode AND
	            		  dbo.ServiceRDetail.SmanCode = S.SalesManCode
					),

	commission= ( Select isnull(sum(d.qty * (d.commission - d.serviceflatdisc) * (1 - d.discperc * 0.01) * (1 * h.discperc * 0.01)),0)
                  From dbo.ServiceHeader h,
                       dbo.ServiceDetail d
		            Where h.Date >= :ad_startdate AND
                        h.Date <= :ad_enddate AND
                        h.ServiceInvCode = d.ServiceInvCode AND
                        d.ServiceCode = dbo.Service.ServiceCode AND
	               		d.SmanCode = S.SalesManCode
					)
					-
					( Select isnull(sum(d.qty * (d.commission - d.serviceflatdisc) * (1 - d.discperc * 0.01) * (1 - h.discperc * 0.01) ),0)
                 From dbo.ServiceRHeader h,
                      dbo.ServiceRDetail d
	      		  Where h.Date >= :ad_startdate AND
                       h.Date <= :ad_enddate AND
                       h.ServiceRInvCode = d.ServiceRInvCode AND
                       d.ServiceCode = dbo.Service.ServiceCode AND
	            		  d.SmanCode = S.SalesManCode
					)

	

	From  (Select salesmancode, name  FROM SalesMan Where salesmancode In ( :ai_salesmancode )) S ,
   	    Service	

) A

Where A.qty > 0 OR A.ReturnQty > 0

Order By SalesPerson, Service"
  arguments=(("ai_salesmancode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
