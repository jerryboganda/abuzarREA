release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=552 color="536870912" )
summary(height=100 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=decimal(4) updatewhereclause=yes name=grossservices dbname="GrossServices"  )
column=(type=decimal(4) updatewhereclause=yes name=discountonsercices dbname="DiscountOnSercices"  )
column=(type=decimal(4) updatewhereclause=yes name=taxonservices dbname="TaxOnServices"  )
column=(type=decimal(4) updatewhereclause=yes name=servicetotal dbname="ServiceTotal"  )
column=(type=decimal(2) updatewhereclause=yes name=servicereturn dbname="ServiceReturn"  )
column=(type=decimal(2) updatewhereclause=yes name=servicepurchased dbname="ServicePurchased"  )
 retrieve="SELECT 
	Date=CONVERT(VARCHAR(100), T.Date, 103),
	T.CustomerName,
	GrossServices = SUM(T.GrossServices),
	DiscountOnSercices = Sum(T.DiscountOnSercices),
	TaxOnServices = SUM(T.TaxOnServices),
	ServiceTotal = SUM(T.ServiceTotal),
	ServiceReturn = SUM(T.ServiceReturn),
	ServicePurchased = SUM(T.ServicePurchased)
FROM
	(SELECT 
		H.Date,
		H.ServiceInvCode,
		H.CustCode,
		CustomerName = A.Name,
		GrossServices = SUM(D.qty * D.price),
		DiscountOnSercices = Sum(D.qty * D.ServiceFlatDisc) +
			Sum(D.qty * (D.price - D.ServiceFlatDisc) * D.discperc * 0.01),
		TaxOnServices = Round(
			Sum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01* D.servicegstPerc) 
			+
			Sum(D.qty * D.serviceflattax) 
			+
			Round((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01 * H.serviceinvgstperc,2), 0),
		ServiceTotal = 
		Round(Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc + H.misccharges, 0)
			+
		Round(
			Sum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01* D.servicegstPerc) 
			+
			Sum(D.qty * D.serviceflattax) 
			+
			Round((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01 * H.serviceinvgstperc,2), 0),
		ServiceReturn = SUM(DBO.fn_GetServiceReturnInvTotal(H.ServiceInvCode)),
		ServicePurchased = ISNULL((SELECT SUM(SP.InvTotal) FROM ServicePurHeader SP WHERE SP.ServiceInvCode = H.ServiceInvCode), 0)
	FROM
		Accounts A,
		ServiceHeader H,
		ServiceDetail D
	WHERE
		H.Date BETWEEN :adt_startdate AND :adt_enddate AND
		H.CustCode IN (:ai_custcode) AND
		H.CustCode = A.AccCode AND
		H.ServiceInvCode = D.ServiceInvCode
	GROUP BY
		H.Date,
		H.ServiceInvCode,
		H.CustCode,
		A.Name,
		H.flatdisc,
		H.serviceinvgstperc,
		H.misccharges,
		H.discperc) T
GROUP BY
	CONVERT(VARCHAR(100), T.Date, 103),
	T.CustomerName
ORDER BY 
	Date,
	CustomerName
"
  arguments=(("ai_custcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
