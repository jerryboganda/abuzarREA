table(column=(type=long updatewhereclause=yes name=summary dbname="Summary"  )
column=(type=long updatewhereclause=yes name=catcode dbname="CatCode"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceqty dbname="ServiceQty"  )
column=(type=decimal(6) updatewhereclause=yes name=servicevalue dbname="ServiceValue"  )
column=(type=decimal(2) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
column=(type=decimal(6) updatewhereclause=yes name=returnvalue dbname="ReturnValue"  )
column=(type=decimal(2) updatewhereclause=yes name=netqty dbname="NetQty"  )
column=(type=decimal(6) updatewhereclause=yes name=netvalue dbname="NetValue"  )
column=(type=decimal(6) updatewhereclause=yes name=rounddiff dbname="RoundDiff"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="FlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="MiscCharges"  )
column=(type=decimal(4) updatewhereclause=yes name=tax dbname="Tax"  )
 retrieve="SELECT
	Summary=0,
	CatCode=SC.ServiceCatCode, 
	Category=SC.Name,
	ServiceQty=SUM(P.ServiceQty),
	ServiceValue=ROUND(SUM(P.ServiceValue), 2),
	ReturnQty=SUM(P.ReturnQty),
	ReturnValue =ROUND(SUM(P.ReturnValue), 2),
	NetQty = SUM(P.ServiceQty) - SUM(P.ReturnQty),
	NetValue = ROUND(SUM(P.ServiceValue), 2) - ROUND(SUM(P.ReturnValue), 2),
	RoundDiff=0,
	FlatDisc=0,
	MiscCharges=0,
	Tax=0.00
FROM 
	(SELECT
		S.ServiceCatCode,
		D.ServiceCode,
		H.ServiceInvCode,
		ServiceQty=SUM(D.qty),
		ServiceValue=ROUND(SUM(D.qty * (D.price - D.ServiceFlatDisc) * (1 - (.01 * D.discperc)) * (1 - H.discperc * .01)), 2),
		ReturnQty=0,
		ReturnValue = 0.00
	FROM
		ServiceHeader H,	 
		ServiceDetail D,
		Service S
	WHERE
		H.ServiceCatCode = CASE :ai_cashcreditboth WHEN 1 THEN 10 WHEN 2 THEN 11 ELSE H.ServiceCatCode END AND
		H.ServiceInvCode = D.ServiceInvCode AND
		H.Date >= :ad_startdate AND H.Date <= :ad_enddate AND
		D.ServiceCode = S.ServiceCode
	GROUP BY 
		S.ServiceCatCode,
		H.ServiceInvCode,
		D.ServiceCode
	UNION ALL
	SELECT
		S.ServiceCatCode,
		D.ServiceCode,
		H.ServiceRInvCode,
		ServiceQty=0,
		ServiceValue=0.00,
		ReturnQty=SUM(D.qty),
		ReturnValue = ROUND(SUM(D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - (.01 * D.discperc)) * (1 - H.discperc * .01)), 2)
	FROM
		ServiceRHeader H,	 
		ServiceRDetail D,
		Service S
	WHERE
		H.ServiceRCatCode = CASE :ai_cashcreditboth WHEN 1 THEN 13 WHEN 2 THEN 14 ELSE H.ServiceRCatCode END AND
		H.ServiceRInvCode = D.ServiceRInvCode AND 
		H.Date >= :ad_startdate AND H.Date <= :ad_enddate AND
		D.ServiceCode = S.ServiceCode
	GROUP BY 
		S.ServiceCatCode,
		H.ServiceRInvCode,
		D.ServiceCode) P, 
	Service S, 
	ServiceCategory SC
WHERE
	P.ServiceCode = S.ServiceCode AND 
	S.ServiceCatCode = SC.ServiceCatCode
GROUP BY 
	SC.ServiceCatCode,
	SC.Name
UNION ALL
SELECT
	Summary=1,
	ServiceCatCode=NULL, 
	Category=NULL,
	ServiceQty=0,
	ServiceValue=0.00,
	ReturnQty=0,
	ReturnValue =0.00,
	NetQty = 0,
	NetValue = 0.00,
	RoundDiff=SUM(Value),
	FlatDisc=SUM(FlatDisc),
	MiscCharges=SUM(MiscCharges),
	Tax = SUM(Tax)
FROM
	(SELECT
		H.ServiceInvCode,
		Value=ROUND(SUM(D.qty * (D.price - D.ServiceFlatDisc) * (1 - (.01 * D.discperc)) * (1 - H.discperc * .01)) - H.FlatDisc + H.MiscCharges, 0) -
		(ROUND(SUM(D.qty * (D.price - D.ServiceFlatDisc) * (1 - (.01 * D.discperc)) * (1 - H.discperc * .01)) - H.FlatDisc + H.MiscCharges, 2)),
		FlatDisc = - H.FlatDisc,
		MiscCharges = H.MiscCharges,
		Tax = Round(Sum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc ) +
			Sum(D.qty * D.serviceflattax ) +
			Round((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc) *  0.01* H.serviceinvgstperc, 2), 0)
	FROM
		ServiceHeader H,	 
		ServiceDetail D,
		Service S
	WHERE
		H.ServiceCatCode = CASE :ai_cashcreditboth WHEN 1 THEN 10 WHEN 2 THEN 11 ELSE H.ServiceCatCode END AND
		H.ServiceInvCode = D.ServiceInvCode AND 
		H.Date >= :ad_startdate AND H.Date <= :ad_enddate AND
		D.ServiceCode = S.ServiceCode
	GROUP BY 
		S.ServiceCatCode,
		H.ServiceInvCode,
		H.FlatDisc,
		H.serviceinvgstperc,
		H.MiscCharges
	UNION ALL
	SELECT
		H.ServiceRInvCode,
		Value= - (ROUND(SUM(D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - (.01 * D.discperc)) * (1 - H.discperc * .01)) - H.FlatDisc + H.MiscCharges, 0) -
		(ROUND(SUM(D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - (.01 * D.discperc)) * (1 - H.discperc * .01)) - H.FlatDisc + H.MiscCharges, 2))),
		FlatDisc = H.FlatDisc,
		MiscCharges = - H.MiscCharges,
		Tax = Round(Sum((D.qty * (D.Serviceprice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc ) +
			Sum(D.qty * D.serviceflattax ) +
			Round((Sum(D.qty * (D.Serviceprice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc) *  0.01* H.serviceinvgstperc, 2), 0)
	FROM
		ServiceRHeader H,	 
		ServiceRDetail D,
		Service S
	WHERE
		H.ServiceRCatCode = CASE :ai_cashcreditboth WHEN 1 THEN 13 WHEN 2 THEN 14 ELSE H.ServiceRCatCode END AND
		H.ServiceRInvCode = D.ServiceRInvCode AND 
		H.Date >= :ad_startdate AND H.Date <= :ad_enddate AND
		D.ServiceCode = S.ServiceCode
	GROUP BY 
		S.ServiceCatCode,
		H.ServiceRInvCode,
		H.FlatDisc,
		H.serviceinvgstperc,
		H.MiscCharges) T
ORDER BY 
	Summary,
	Category, 
	CatCode
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_cashcreditboth", number))
 sort="summary A, category A, catcode A"
)
