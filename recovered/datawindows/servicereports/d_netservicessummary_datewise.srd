datawindow ( units=0 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=492 color="536870912" )
summary(height=112 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(4) updatewhereclause=yes name=cashservice dbname="CashService"  )
column=(type=decimal(4) updatewhereclause=yes name=creditservice dbname="CreditService"  )
column=(type=decimal(4) updatewhereclause=yes name=totalservice dbname="TotalService"  )
column=(type=decimal(4) updatewhereclause=yes name=cashservicereturn dbname="CashServiceReturn"  )
column=(type=decimal(4) updatewhereclause=yes name=creditservicereturn dbname="CreditServiceReturn"  )
column=(type=decimal(4) updatewhereclause=yes name=totalservicereturn dbname="TotalServiceReturn"  )
column=(type=decimal(4) updatewhereclause=yes name=netservice dbname="NetService"  )
column=(type=decimal(6) updatewhereclause=yes name=netshare dbname="NetShare"  )
 retrieve="SELECT  
	Date = CONVERT(DATETIME, CONVERT(varchar(10), T.Date, 101)),
	CashService = SUM(CASE Type WHEN 1 THEN T.SvcAmt ELSE 0.00 END),
	CreditService = SUM(CASE Type WHEN 2 THEN T.SvcAmt ELSE 0.00 END),
	TotalService = SUM(CASE WHEN Type <= 2 THEN T.SvcAmt ELSE 0.00 END),
	CashServiceReturn = SUM(CASE Type WHEN 3 THEN T.SvcRetAmt ELSE 0.00 END),
	CreditServiceReturn = SUM(CASE Type WHEN 4 THEN T.SvcRetAmt ELSE 0.00 END),
	TotalServiceReturn = SUM(CASE WHEN Type > 2 THEN T.SvcRetAmt ELSE 0.00 END),
	NetService = SUM(T.SvcAmt - T.SvcRetAmt) - SUM(T.SvcShare - T.SvcRetShare),
	NetShare = SUM(T.SvcShare - T.SvcRetShare)
FROM
	(SELECT 
		InvCode = H.ServiceInvCode,
		Date = H.Date,
		Type = CASE H.ServiceCatCode WHEN 10 THEN 1 ELSE 2 END,
		SvcAmt = ISNULL(SUM(D.Qty * (D.price - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01)) + MiscCharges - FlatDisc, 0) +
			Round(Sum((D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc) +
			Sum(D.qty * D.serviceflattax ) +
			Round((Sum(D.qty * (D.price - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01 * H.serviceinvgstperc,2), 0),
		SvcShare = ISNULL(SUM(D.Qty * (D.Commission - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01)), 0),
		SvcRetAmt = 0.00,
		SvcRetShare = 0.00
	FROM 
		ServiceHeader H, ServiceDetail D
	WHERE 
		H.Date BETWEEN :ad_startdate AND :ad_enddate AND
		H.ServiceInvCode = D.ServiceInvCode 
	GROUP BY
		H.ServiceInvCode,
		H.Date,
		H.ServiceCatCode,
		H.MiscCharges,
		H.serviceinvgstperc,
		H.FlatDisc
	UNION ALL
	SELECT 
		InvCode = H.ServiceRInvCode,
		Date = H.Date,
		Type = CASE H.ServiceRCatCode WHEN 13 THEN 3 ELSE 4 END,
		SvcAmt = 0.00,
		SvcShare = 0.00,
		SvcRetAmt = ISNULL(SUM(D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01)) + MiscCharges - FlatDisc, 0) + 
			Round(Sum((D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01)) * 0.01 * D.servicegstPerc) +
			Sum(D.qty * D.serviceflattax) + 
			Round((Sum(D.qty * (D.serviceprice - D.ServiceFlatDisc) * (1 - D.discperc * 0.01) * (1 - H.discperc * 0.01)) - H.flatdisc ) * 0.01 * H.serviceinvgstperc, 2), 0),
		SvcRetShare = ISNULL(SUM(D.Qty * (D.Commission - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01)), 0)
	FROM 
		ServiceRHeader H, ServiceRDetail D
	WHERE 
		H.Date BETWEEN :ad_startdate AND :ad_enddate AND
		H.ServiceRInvCode = D.ServiceRInvCode 
	GROUP BY
		H.ServiceRInvCode,
		H.Date,
		H.ServiceRCatCode,
		H.MiscCharges,
		H.serviceinvgstperc,
		H.FlatDisc) T
GROUP BY
	CONVERT(DATETIME, CONVERT(varchar(10), T.Date, 101))
ORDER BY
	Date"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
)
