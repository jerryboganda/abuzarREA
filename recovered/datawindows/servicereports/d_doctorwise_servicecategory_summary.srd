table(column=(type=char(20) updatewhereclause=yes name=doctorname dbname="doctorname"  )
column=(type=number updatewhereclause=yes name=netqty dbname="netqty"  )
column=(type=number updatewhereclause=yes name=netvalue dbname="netvalue"  )
 retrieve="SELECT 
	DoctorName = D.Name,
	ServiceCategory = SC.Name,
	NetQty = SUM(T.Qty),
	NetValue = SUM(T.Value)
FROM
	(SELECT 
		H.DoctCode, 
		SD.ServiceCode, 
		S.ServiceCatCode, 
		Qty = SUM(SD.Qty), 
		Value = SUM(SD.Qty * (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01))
	FROM 
		ServiceHeader H, ServiceDetail SD, Service S
	WHERE
		H.Date BETWEEN :ad_startdate AND :ad_enddate AND
		H.ServiceInvCode = SD.ServiceInvCode AND
		SD.ServiceCode = S.ServiceCode AND
		S.ServiceCatCode IN (:ai_servicecatcode)
	GROUP BY
		H.DoctCode, 
		S.ServiceCatCode, 
		SD.ServiceCode
	UNION ALL
	SELECT 
		H.DoctCode, 
		SD.ServiceCode, 
		S.ServiceCatCode, 
		Qty = - SUM(SD.Qty), 
		Value = - SUM(SD.Qty * (SD.ServicePrice - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01))
	FROM 
		ServiceRHeader H, ServiceRDetail SD, Service S
	WHERE
		H.Date BETWEEN :ad_startdate AND :ad_enddate AND
		H.ServiceRInvCode = SD.ServiceRInvCode AND
		SD.ServiceCode = S.ServiceCode AND
		S.ServiceCatCode IN (:ai_servicecatcode)
	GROUP BY
		H.DoctCode, 
		S.ServiceCatCode, 
		SD.ServiceCode) T, 
	ServiceCategory SC, 
	Doctors D
WHERE 
	T.ServiceCatCode=SC.ServiceCatCode AND
	T.DoctCode = D.DoctCode
GROUP BY
	D.Name,
	SC.Name
ORDER BY
	D.Name,
	SC.Name
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_servicecatcode", numberlist))
 sort="doctorname A"
)
