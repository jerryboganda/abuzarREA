header(height=576 color="536870912" )
summary(height=364 color="536870912" )
footer(height=4 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=char(60) updatewhereclause=yes name=service dbname="Service"  )
column=(type=decimal(10) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=salesamt dbname="SalesAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=returnqty dbname="ReturnQty"  )
column=(type=decimal(6) updatewhereclause=yes name=returnamt dbname="ReturnAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=invflatdisc dbname="InvFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=netshare dbname="NetShare"  )
 retrieve="SELECT
	SalesPerson=SM.Name,
	Service=S.Name, 
	Price=A.NetPrice,
	Qty = SUM(A.Sales),
	SalesAmt = SUM(A.SalesAmt),
	ReturnQty = SUM(A.Returns),
	ReturnAmt = SUM(A.ReturnAmt),
	InvFlatDisc =
		(select isnull(sum(H.flatdisc),0)
		from serviceheader H
		where 
			H.Date BETWEEN :ad_startdate AND :ad_enddate AND
			H.serviceinvcode in (select distinct(d.serviceinvcode) from servicedetail d where d.smancode=A.smancode))
		-
		(select isnull(sum(H.flatdisc),0)
		from serviceRheader H
		where 
			H.Date BETWEEN :ad_startdate AND :ad_enddate AND
			H.serviceRinvcode in (select distinct(d.serviceRinvcode) from serviceRdetail d where d.smancode=A.smancode)),
	NetShare =0.00
FROM
	(SELECT 
		T.SmanCode,
		T.ServiceCode,
		T.NetPrice,
		Sales = SUM(T.Sales),
		SalesAmt = SUM(T.SalesAmt),
		Returns = SUM(T.Returns),
		ReturnAmt = SUM(T.ReturnAmt)
	FROM 
		(Select 
			D.SmanCode,
			D.ServiceCode,
			NetPrice = (D.Price - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01) ,
			Sales = SUM(D.Qty),
			SalesAmt = SUM(D.Qty * (D.Price - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01)),
			Returns = 0,
			ReturnAmt = 0.00
		From 
			dbo.ServiceHeader H, dbo.ServiceDetail D
		Where 
			H.Date BETWEEN :ad_startdate AND :ad_enddate AND
			H.ServiceInvCode = D.ServiceInvCode AND
			D.SmanCode IN (:ai_salesmancode)
		GROUP BY
			D.SmanCode,
			D.ServiceCode,
			D.Price,
			D.ServiceFlatDisc,
			D.DiscPerc,
			H.DiscPerc
		UNION ALL
		Select 
			D.SmanCode,
			D.ServiceCode,
			NetPrice = (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01) ,
			Sales = 0,
			SalesAmt = 0.00,
			Returns = SUM(D.Qty),
			ReturnAmt = SUM(D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01))
		From
			dbo.ServiceRHeader H, dbo.ServiceRDetail D
		Where 
			H.Date BETWEEN :ad_startdate AND :ad_enddate AND
			H.ServiceRInvCode = D.ServiceRInvCode AND
			D.SmanCode IN (:ai_salesmancode)
		GROUP BY
			D.SmanCode,
			D.ServiceCode,
			D.ServicePrice,
			D.ServiceFlatDisc,
			D.DiscPerc,
			H.DiscPerc) T
	GROUP BY
		T.SmanCode,
		T.ServiceCode,
		T.NetPrice) A, Service S, SalesMan SM
WHERE 
	A.SManCode = SM.SalesManCode AND
	A.ServiceCode = S.ServiceCode
GROUP BY
	A.SManCode,
	SM.Name,
	S.Name,
	A.NetPrice"
  arguments=(("ai_salesmancode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
