table(column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=char(60) updatewhereclause=yes name=servicecategory dbname="ServiceCategory"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceqty dbname="ServiceQty"  )
column=(type=decimal(5) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(7) updatewhereclause=yes name=total dbname="Total"  )
 retrieve="SELECT  
	SalesPerson=(SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode=SD.SManCode),
	ServiceCategory=(SELECT SC.Name FROM ServiceCategory SC WHERE SC.ServiceCatCode = S.ServiceCatCode),
	ServiceInvCode=SH.ServiceInvCode, 
	Date=SH.Date, 
	PatientName=P.Name,
	ServiceName=S.Name,
	ServiceQty=SD.Qty,
	Price=SD.CostPrice,
	Total = SD.Qty * SD.CostPrice
FROM 
	ServiceHeader SH, ServiceDetail SD, Service S, Patient P 
WHERE
	SH.Date BETWEEN :adt_startdate AND :adt_enddate AND 
	SH.ServiceInvCode = SD.ServiceInvCode AND
	SD.SManCode IN (:ai_smancode) AND
	SD.ServiceCode = S.ServiceCode AND
	S.ServiceCatCode IN (:ai_servicecatcode) AND
	SH.PatientCode = P.PatientCode
UNION ALL
SELECT 
	SalesPerson=(SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode=SD.SManCode),
	ServiceCategory=(SELECT SC.Name FROM ServiceCategory SC WHERE SC.ServiceCatCode = S.ServiceCatCode),
	ServiceInvCode=SH.ServiceInvCode, 
	Date=SH.Date, 
	PatientName=P.Name,
	ServiceName=S.Name,
	ServiceQty=SD.Qty,
	Price=SD.CostPrice,
	Total = SD.Qty * SD.CostPrice
FROM 
	ServiceHeader SH, ServiceDetail SD, Service S, PatientAdmission PA, Patient P 
WHERE
	SH.Date BETWEEN :adt_startdate AND :adt_enddate AND 
	SH.ServiceInvCode = SD.ServiceInvCode AND
	SD.SManCode IN (:ai_smancode) AND
	SD.ServiceCode = S.ServiceCode AND
	S.ServiceCatCode IN (:ai_servicecatcode) AND
	SH.AdmissionCode = PA.AdmissionCode AND
	PA.PatientCode = P.PatientCode
"
  arguments=(("ai_servicecatcode", numberlist), ("ai_smancode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="salesperson A, servicecategory A, date A, serviceinvcode A, patientname A, servicename A"
)
