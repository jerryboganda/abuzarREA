release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=652 color="536870912" )
summary(height=96 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912"  height.autosize=yes)
table(column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Customer.Phone"  )
column=(type=datetime updatewhereclause=yes name=serviceorderdate dbname="ServiceOHeader.Date"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.UserName"  )
column=(type=char(60) updatewhereclause=yes name=service dbname="Service"  )
column=(type=char(60) updatewhereclause=yes name=shift dbname="Shift"  )
column=(type=char(60) updatewhereclause=yes name=timeslot dbname="TimeSlot"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="ServiceODetail.DiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="ServiceODetail.price"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="ServiceODetail.ServiceFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=cashreceived dbname="ServiceODetail.CashReceived"  )
 retrieve="Select Customer = Accounts.Name,  
		 Customer.Phone,  
		 ServiceOHeader.Date,
		 Users.UserName,
		 Service = Service.Name,
		 Shift = Shift.Name,
		 TimeSlot = TimeSlot.Name,
		 Qty = ServiceODetail.Qty,	
       ServiceODetail.DiscPerc,
		 ServiceODetail.price,
		 ServiceODetail.ServiceFlatDisc,
		 ServiceODetail.CashReceived

From   Accounts, Customer, Service, ServiceOHeader, ServiceODetail, TimeSlot, Shift, Users

Where  ServiceOHeader.ServiceOCode = ServiceODetail.ServiceOCode AND
       ServiceOHeader.custcode = Accounts.AccCode AND
       ServiceOHeader.custcode = Customer.custcode AND
		 ServiceOHeader.Salesmancode = Users.UserCode AND
       ServiceODetail.Date >= :ad_startdate AND
       ServiceODetail.Date <= :ad_enddate AND
       ServiceODetail.ServiceCode = Service.ServiceCode AND
       ServiceODetail.ServiceCode IN (:ai_servicecode) AND
       ServiceODetail.TSCode = TimeSlot.TSCode AND 
       ServiceODetail.ShiftCode = Shift.ShiftCode AND
		 ServiceODetail.CancelStatus Not In ('Y')

"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_ServiceCode", numberlist))
 sort="shift A, service A, timeslot A"
)
