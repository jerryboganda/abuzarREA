release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=648 color="536870912" )
summary(height=92 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=usercode dbname="Users.UserCode"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.UserName"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type"  )
column=(type=char(69) updatewhereclause=yes name=service dbname="Service"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="SalesPerson"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Accounts.Name"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Customer.Phone"  )
column=(type=decimal(10) updatewhereclause=yes name=advance dbname="Advance"  )
column=(type=datetime updatewhereclause=yes name=servicedate dbname="ServiceDate"  )
 retrieve="Select Users.UserCode,
       Users.UserName, 
       Type = 'A', 
       Service = Service.Name + ' BOOKING ',
		 SalesPerson = Salesman.Name,
	    Accounts.Name,
       Customer.Phone,
       Advance = ServiceOHeader.CashReceived / (Select count(*) From ServiceODetail Where ServiceOCode = ServiceOHeader.ServiceOcode ) +  ServiceODetail.CashReceived,
       ServiceDate = ServiceODetail.Date

From   
	ServiceOHeader, 
	ServiceODetail
	LEFT OUTER JOIN dbo.salesman ON (dbo.ServiceODetail.smancode = dbo.salesman.salesmancode),    
	Service, 
	Accounts, 
	Customer, 
	Users

Where  ServiceOHeader.Date Between :ad_startdate AND :ad_enddate AND
       ServiceOHeader.Posted = 'Y' AND
       ServiceOHeader.ServiceOCode = ServiceODetail.ServiceOCode AND
       ServiceOHeader.CustCode = Accounts.AccCode AND
       Accounts.AccCode = Customer.CustCode AND
       ServiceOHeader.SalesManCode = Users.UserCode AND
       Users.UserCode In (:al_users)	AND
       ServiceODetail.ServiceCode = Service.ServiceCode
Union All
Select Users.UserCode,
       Users.UserName,
       Type = CASE WHEN ServiceHeader.Servicecatcode = 10 THEN 'C' ELSE 'B' END ,
       Service = Service.Name,
		 SalesPerson = Salesman.Name,
       Accounts.Name,
       Customer.Phone,
       Advance = Round ( (ServiceDetail.Price - ServiceDetail.ServiceFlatDisc) * ServiceDetail.Qty * (1 - ServiceDetail.DiscPerc * 0.01) , 2) , 
       ServiceDate = ServiceHeader.Date

From   
	ServiceHeader, 
	ServiceDetail
	LEFT OUTER JOIN dbo.salesman ON (dbo.ServiceDetail.smancode = dbo.salesman.salesmancode), 
	Service, 
	Accounts, 
	Customer, 
	Users

Where  ServiceHeader.Date Between :ad_startdate AND :ad_enddate AND
       ServiceHeader.Posted = 'Y' AND
       ServiceHeader.ServiceInvCode = ServiceDetail.ServiceInvCode AND
       ServiceHeader.CustCode = Accounts.AccCode AND
       Accounts.AccCode = Customer.CustCode AND
       ServiceHeader.SalesManCode = Users.UserCode AND
       Users.UserCode In (:al_users)	AND
       ServiceDetail.ServiceCode = Service.ServiceCode
Union All
Select Users.UserCode,
       Users.UserName,
       Type = CASE WHEN ServiceRcatcode = 13 THEN 'D' ELSE 'E' END ,
       Service = Service.Name + ' RETURN',
       SalesPerson = Salesman.Name,
       Accounts.Name,
       Customer.Phone,
       Advance = (-1) * Round ( (ServiceRDetail.ServicePrice - ServiceRDetail.ServiceFlatDisc) * ServiceRDetail.Qty * (1 - ServiceRDetail.DiscPerc * 0.01) , 2) , 
       ServiceDate = ServiceRHeader.Date

From   
	ServiceRHeader, 
	ServiceRDetail
	LEFT OUTER JOIN dbo.salesman ON (dbo.ServiceRDetail.smancode = dbo.salesman.salesmancode), 
	Service, 
	Accounts, 
	Customer, 
	Users

Where  ServiceRHeader.Date Between :ad_startdate AND :ad_enddate AND
       ServiceRHeader.Posted = 'Y' AND
       ServiceRHeader.ServiceRInvCode = ServiceRDetail.ServiceRInvCode AND
       ServiceRHeader.CustCode = Accounts.AccCode AND
       Accounts.AccCode = Customer.CustCode AND
       ServiceRHeader.SalesManCode = Users.UserCode AND
       Users.UserCode In (:al_users)	AND
       ServiceRDetail.ServiceCode = Service.ServiceCode"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("al_users", numberlist))
 sort="type A, service A, servicedate A"
)
