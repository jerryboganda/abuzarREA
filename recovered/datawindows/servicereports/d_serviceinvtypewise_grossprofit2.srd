table(column=(type=char(100) updatewhereclause=yes name=serviceinvtype dbname="ServiceInvType"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(122) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=decimal(6) updatewhereclause=yes name=sales dbname="Sales"  )
column=(type=decimal(8) updatewhereclause=yes name=cost dbname="Cost"  )
column=(type=char(60) updatewhereclause=yes name=service dbname="Service"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceqty dbname="ServiceQty"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="ROWID"  )
 retrieve="SELECT 
	ServiceInvType=ST.Name, 
	ServiceInvCode=S.ServiceInvCode,
	Date = S.Date,
	Posted = S.Posted,
	Customer = A.Name,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode=S.PatientCode),
	PatientName = (SELECT P.Name + '(' + P.Name + ')' FROM Patient P WHERE P.PatientCode=S.PatientCode),
	Sales=ROUND(SUM(SD.Qty * (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)), 2), 
	Cost=ISNULL(
		(SELECT ROUND(SUM(PD.Qty * (PD.Price - PD.ServiceFlatDisc) * (1 - PD.DiscPerc * 0.01)), 2) 
		FROM ServicePurDetail PD 
		WHERE 	PD.SrvRowID = SD.SrvRowID), 0),
	Service = SV.Name,
	ServiceQty = SUM(SD.Qty),
	ROWID=SD.SrvRowID
FROM
	ServiceInvType ST, ServiceHeader S, ServiceDetail SD, Service SV, Accounts A
WHERE
	ST.ServiceInvTypeCode IN (:ai_ServiceInvTypecode) AND
	ST.ServiceInvTypeCode = S.ServiceInvTypeCode AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND 
	S.CustCode = A.AccCode AND
	S.ServiceInvCode = SD.ServiceInvCode AND
	SD.ServiceCode = SV.ServiceCode
GROUP BY 
	ST.Name,
	S.ServiceInvCode,
	S.Date,
	S.Posted,
	A.Name,
	S.PatientCode,
	SV.ServiceCode,
	SV.Name,
	SD.SrvRowID
"
  arguments=(("ai_ServiceInvTypecode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="serviceinvtype A, serviceinvcode A, rowid A"
)
