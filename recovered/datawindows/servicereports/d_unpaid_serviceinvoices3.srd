release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=625 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=today dbname="Today"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Date"  )
column=(type=long update=yes updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=studentregno dbname="StudentRegNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=class dbname="Class"  )
column=(type=char(100) updatewhereclause=yes name=grade dbname="Grade"  )
column=(type=decimal(2) updatewhereclause=yes name=numericalfactor dbname="NumericalFactor"  )
column=(type=char(40) updatewhereclause=yes name=rollno dbname="RollNo"  )
column=(type=char(100) updatewhereclause=yes name=schoolname dbname="SchoolName"  )
column=(type=long updatewhereclause=yes name=schoolbranchcode dbname="SchoolBranchCode"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=unpaidamount dbname="UnpaidAmount"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long update=yes updatewhereclause=yes name=age dbname="Age"  )
column=(type=char(255) updatewhereclause=yes name=defaulterlistinstruction dbname="DefaulterlistInstruction"  )
column=(type=datetime updatewhereclause=yes name=defaulterlistinstructionexpiry dbname="DefaulterlistInstructionExpiry"  )
column=(type=char(1) updatewhereclause=yes name=studentstatus dbname="StudentStatus"  )
 retrieve="SELECT 
	ServiceInvCode, 
	Today=GetDate(),
	Date, 
	StudentCode, 
	StudentRegNo,
	StudentName,
	Class,
	Grade, 
	NumericalFactor,
	RollNo,
	SchoolName,
	SchoolBranchCode, 
	UnpaidAmount,
	Remarks,
	Age,
	DefaulterlistInstruction,
	DefaulterlistInstructionExpiry,
	StudentStatus
FROM
	(SELECT 
		SH.ServiceInvCode, 
		SH.Date, 
		SH.StudentCode, 
		StudentRegNo = (SELECT ST.RegNo FROM Student ST WHERE ST.StudentCode = SH.StudentCode),
		StudentName = (SELECT ST.Name FROM Student ST WHERE ST.StudentCode = SH.StudentCode),
		StudentStatus = (SELECT ST.Status FROM Student ST WHERE ST.StudentCode = SH.StudentCode),
		Class = (SELECT C.Name FROM Class C, Student S WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass=C.ClassCode),
		RollNo = (SELECT SC.RollNo FROM StudentClass SC, Student S WHERE S.StudentCode = SH.StudentCode AND S.StudentCode = SC.StudentCode AND S.CurrentClass=SC.ClassCode),
		Grade = (SELECT G.Name FROM Grade G, Class C, Student S WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass=C.ClassCode AND C.GradeCode = G.GradeCode),
		NumericalFactor = (SELECT G.NumericalFactor FROM Grade G, Class C, Student S WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass=C.ClassCode AND C.GradeCode = G.GradeCode),
		SchoolName= (SELECT SB.Name FROM Class C, Student S, SchoolBranch SB WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass=C.ClassCode AND C.SchoolBranchCode = SB.SchoolBranchCode),
		SchoolBranchCode= (SELECT SB.SchoolBranchCode FROM Class C, Student S, SchoolBranch SB WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass=C.ClassCode AND C.SchoolBranchCode = SB.SchoolBranchCode), 
		UnpaidAmount = SH.OutstandingAmt,
		Remarks = SH.Remarks,
		Age = DATEDIFF(d, SH.Date, GetDate()),
		DefaulterlistInstruction = (SELECT ST.DefaulterlistInstruction FROM Student ST WHERE ST.StudentCode = SH.StudentCode),
		DefaulterlistInstructionExpiry = (SELECT ST.DefaulterlistInstructionExpiresOn FROM Student ST WHERE ST.StudentCode = SH.StudentCode)
	FROM ServiceHeader SH
	WHERE SH.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SH.OutstandingAmt > 0 AND 
		DATEDIFF(d, SH.Date, GetDate()) >= :ai_daysold) T
WHERE
	SchoolBranchCode IN (:ai_schoolbranch)"
  arguments=(("ai_schoolbranch", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_daysold", number), ("ac_printtotal", string))
 sort="numericalfactor A, class A, studentname A"
 filter="StudentStatus <> 'L'"
 )
