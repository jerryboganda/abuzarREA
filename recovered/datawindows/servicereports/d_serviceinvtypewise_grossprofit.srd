table(column=(type=char(100) updatewhereclause=yes name=serviceinvtype dbname="ServiceInvType"  )
column=(type=decimal(2) updatewhereclause=yes name=sales dbname="Sales"  )
column=(type=decimal(2) updatewhereclause=yes name=cost dbname="Cost"  )
column=(type=decimal(2) updatewhereclause=yes name=gp dbname="GP"  )
column=(type=decimal(6) updatewhereclause=yes name=gprate dbname="GPRate"  )
 retrieve="SELECT 
	ServiceInvType=S.ServiceInvType, 
	Sales=SUM(S.Sales), 
	Cost=SUM(S.Cost),
	GP = SUM(S.Sales) - SUM(S.Cost),
	GPRate = ((SUM(S.Sales) - SUM(S.Cost)) / CASE WHEN SUM(S.Sales) > 0 THEN SUM(S.Sales) ELSE 1 END) * 100
FROM
	(SELECT 
		ServiceInvType=ST.Name, Sales=0.00, Cost=0.00
	FROM ServiceInvType ST
	UNION ALL
	SELECT 
		ServiceInvType=ST.Name, Sales=SUM(S.InvTotal), Cost=ISNULL((SELECT SUM(P.InvTotal) FROM ServicePurHeader P WHERE P.ServiceInvCode=S.ServiceInvCode), 0)
	FROM 
		ServiceInvType ST, ServiceHeader S
	WHERE
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.ServiceInvTypeCode = ST.ServiceInvTypeCode AND
		ST.ServiceInvTypeCode IN (:ai_ServiceInvTypecode)
		
	GROUP BY 
		ST.Name,
		S.ServiceInvCode) S
GROUP BY 
	ServiceInvType"
  arguments=(("ai_ServiceInvTypecode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
