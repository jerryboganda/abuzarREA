table(column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="DueDate"  )
column=(type=long updatewhereclause=yes name=doctcode dbname="DoctCode"  )
column=(type=char(60) updatewhereclause=yes name=doctorname dbname="DoctorName"  )
column=(type=char(50) updatewhereclause=no name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=no name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=no name=fathername dbname="FatherName"  )
column=(type=long updatewhereclause=yes name=patientage dbname="PatientAge"  )
column=(type=char(1) updatewhereclause=no name=gender dbname="Gender"  )
column=(type=char(100) updatewhereclause=yes name=mobile dbname="Mobile"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="ServiceName"  )
column=(type=char(100) updatewhereclause=no name=surgeryprocedure dbname="SurgeryProcedure"  )
column=(type=char(100) updatewhereclause=no name=iolpower dbname="IOLPower"  )
column=(type=char(100) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(100) updatewhereclause=no name=surgery dbname="Surgery"  )
column=(type=char(100) updatewhereclause=no name=eyevision dbname="EyeVision"  )
column=(type=char(60) updatewhereclause=no name=lab dbname="LAB"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=no name=username dbname="UserName"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(7) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve="SELECT 
	ServiceInvCode=SH.ServiceInvCode,
	DueDate=CAST(CONVERT(VARCHAR(100), SH.DueDate, 101) AS DATETIME),
	DoctCode=SH.DoctCode,
	DoctorName=D.Name,
	RegNo = (SELECT P.RegNo FROM Patient P WHERE P.PatientCode=SH.PatientCode),
	PatientName = (SELECT P.Name FROM Patient P WHERE P.PatientCode=SH.PatientCode),
	FatherName = (SELECT P.FName FROM Patient P WHERE P.PatientCode=SH.PatientCode),
	PatientAge = (SELECT P.AgeYears FROM Patient P WHERE P.PatientCode=SH.PatientCode),
	Gender = (SELECT P.Gender FROM Patient P WHERE P.PatientCode=SH.PatientCode),
	Mobile = SH.Mobile,
	ServiceName = S.Name,
	SurgeryProcedure=(SELECT P.Name FROM SurgeryProcedure P WHERE P.SurgeryProcedureCode=SH.SurgeryProcedureCode),
	IOLPower=(SELECT P.Name FROM IOLPower P WHERE P.IOLPowerCode=SH.IOLPowerCode),
	Item = SH.Item,
	Surgery=(SELECT P.Name FROM Surgery P WHERE P.SurgeryCode=SH.SurgeryCode),
	EyeVision=(SELECT P.Name FROM EyeVision P WHERE P.EyeVisionCode=SH.EyeVisionCode),
	LAB = (SELECT P.Name FROM Disease P WHERE P.DiseaseCode=SH.DiseaseCode),
	Date=SH.Date,
	UserName=(SELECT U.UserName FROM Users U WHERE U.UserCode=SH.SalesmanCode),
	Remarks = SH.Remarks,
	InvTotal = (SH.InvTotal - SH.CashCharged) /1000
FROM
	ServiceHeader SH, Doctors D, ServiceDetail SD, Service S
WHERE SH.DueDate BETWEEN :adt_startdate AND :adt_enddate AND
	SH.DoctCode IN (:ai_doctorcode) AND
	SH.DoctCode = D.DoctCode AND
	SH.ServiceInvCode = SD.ServiceInvCode AND
	S.ServiceCode=SD.ServiceCode
"
  arguments=(("ai_doctorcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="doctorname A, duedate A, serviceinvcode A, servicename A"
)
