table(column=(type=long updatewhereclause=yes name=serviceinvcode dbname="serviceinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=servicediscperc dbname="servicediscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="ServiceFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceadvance dbname="serviceadvance"  )
column=(type=decimal(2) updatewhereclause=yes name=invadvance dbname="invadvance"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="salesperson"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="servicename"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=datetime updatewhereclause=yes name=servicedate dbname="servicedate"  )
column=(type=char(1) updatewhereclause=yes name=cancelstatus dbname="cancelstatus"  )
 retrieve="SELECT
	 serviceinvcode = dbo.serviceOheader.serviceOcode,    
	 date = dbo.serviceOheader.date,   
	 invdiscperc = dbo.serviceOheader.discperc,    
	 flatdisc = dbo.serviceOheader.flatdisc,    
	 misccharges = dbo.serviceoheader.misccharges, 
	 price = dbo.serviceOdetail.price,    
	 servicediscperc = dbo.serviceOdetail.discperc,    
	 ServiceFlatDisc = ServiceODetail.ServiceFlatDisc,
	 qty = dbo.serviceOdetail.qty,
	 serviceadvance = dbo.serviceodetail.cashreceived,
	 invadvance = dbo.serviceoheader.cashreceived,
	 salesperson = dbo.salesman.name,	
	 UserName = dbo.users.username,
	 servicename = service.name,
	 Customer = dbo.accounts.name,
	 posted = dbo.serviceoheader.posted,
	 servicedate = dbo.serviceOdetail.date,
	 cancelstatus = dbo.serviceodetail.cancelstatus
FROM
	dbo.serviceOheader, 
	dbo.serviceOdetail LEFT OUTER JOIN dbo.salesman ON (dbo.serviceOdetail.smancode = dbo.salesman.salesmancode), 
	dbo.service, 
	dbo.accounts,
	dbo.users
WHERE  
	dbo.serviceOheader.date >= :ad_StartDate and
	dbo.serviceOheader.date <= :ad_EndDate  and
	dbo.serviceOheader.serviceOcode = dbo.serviceOdetail.serviceOcode and  
	dbo.serviceOdetail.servicecode = service.servicecode and 
	dbo.serviceOheader.custcode = dbo.accounts.acccode and 
	dbo.serviceoheader.salesmancode = dbo.users.usercode"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime))
)
