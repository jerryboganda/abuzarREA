table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=datetime updatewhereclause=yes name=purledger_date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.name"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=decimal(8) updatewhereclause=yes name=itemdiscpercvalue dbname="itemdiscpercvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=invdiscpercvalue dbname="invdiscpercvalue"  )
column=(type=decimal(4) updatewhereclause=yes name=tax dbname="tax"  )
 retrieve="SELECT 
	invcode     = dbo.servicerheader.servicerinvcode,    
	date        = dbo.servicerheader.date,    
	flatdisc    = dbo.servicerheader.flatdisc, 
	/*salestax    = dbo.servicerheader.salestax,       */
	misccharges = dbo.servicerheader.misccharges, 
	invdiscperc = dbo.servicerheader.discperc, 
	doctype = Case dbo.servicerheader.servicercatcode When 15 Then 'Cash' When 14 Then 'Credit' Else 'Retail' End, 
	dbo.accounts.name, 
	amount =  Round(Sum ( dbo.servicerdetail.serviceprice), 2),    
	itemdiscpercvalue = Round(Sum ( dbo.servicerdetail.qty * (dbo.servicerdetail.serviceprice - dbo.servicerdetail.serviceflatdisc) * (dbo.servicerdetail.discperc * .01)), 2),    
	invdiscpercvalue = Round(Sum (  dbo.servicerdetail.qty * (dbo.servicerdetail.serviceprice - dbo.servicerdetail.serviceflatdisc) * (1 - (dbo.servicerdetail.discperc * .01))) * (dbo.servicerheader.discperc /100), 2),
	tax = Round(Sum((dbo.servicerdetail.qty * (dbo.servicerdetail.serviceprice - dbo.servicerdetail.ServiceFlatDisc) * (1 - dbo.servicerdetail.discperc * 0.01)) * 0.01 * dbo.servicerdetail.servicegstPerc) +
		Sum(dbo.servicerdetail.qty * dbo.servicerdetail.serviceflattax) +
		Round((Sum(dbo.servicerdetail.qty * (dbo.servicerdetail.serviceprice - dbo.servicerdetail.ServiceFlatDisc) * (1 - dbo.servicerdetail.discperc * 0.01) * (1 - dbo.servicerheader.discperc * 0.01)) - dbo.servicerheader.flatdisc ) * 0.01 * dbo.servicerheader.serviceinvgstperc, 2)
		,0)

FROM 
	dbo.servicerheader,  
	dbo.servicerdetail,   
	dbo.accounts  
	
WHERE 
	( dbo.servicerheader.servicerinvcode = dbo.servicerdetail.servicerinvcode ) and  
	( dbo.servicerheader.custcode = dbo.accounts.acccode )and  
	( dbo.servicerheader.date between :ar_StartDate and :ar_EndDate)            
	
GROUP BY 
	dbo.servicerheader.misccharges,   
	dbo.servicerheader.flatdisc,   
	dbo.servicerheader.date,   
	dbo.servicerheader.servicerinvcode,   
	dbo.servicerheader.discperc,  
	dbo.servicerheader.serviceinvgstperc,
	/*dbo.servicerheader.salestax, */
	dbo.servicerheader.servicercatcode, 
	dbo.accounts.name     
	
ORDER BY 
	dbo.servicerheader.servicerinvcode ASC,   
	dbo.servicerheader.date ASC   
	
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
