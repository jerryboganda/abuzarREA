table(column=(type=long updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(160) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(60) updatewhereclause=yes name=service dbname="Service"  )
column=(type=char(60) updatewhereclause=no name=doctor dbname="Doctor"  )
column=(type=long identity=yes updatewhereclause=yes name=servicerowid dbname="ServiceRowID"  )
column=(type=decimal(4) updatewhereclause=yes name=charges dbname="Charges"  )
column=(type=decimal(7) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="FlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="MiscCharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=decimal(2) updatewhereclause=yes name=received dbname="Received"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(100) updatewhereclause=yes name=ref1 dbname="Ref1"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
 retrieve="SELECT  
	ServiceInvCode=H.ServiceInvCode,
	Customer=A.Name, 
	Type = 'S',
	Date=H.Date,
	Patient = 
		(SELECT P.Name + ' (' + ISNULL(P.RegNo,'') + ') ' FROM Patient P WHERE P.PatientCode=H.PatientCode),
	Service = S.Name,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode=H.Doctcode),
	ServiceRowID = D.SrvRowID,
	Charges = SUM(D.Qty * D.Price),
	Discount = Sum( (D.Qty * D.ServiceFlatDisc) + (D.Qty * (D.Price - D.ServiceFlatDisc) * D.DiscPerc * 0.01) + (D.Qty * (D.Price - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (H.DiscPerc * 0.01))),
	FlatDisc = ISNULL(H.FlatDisc,0),
	MiscCharges = ISNULL(H.MiscCharges,0),
	InvTotal = H.InvTotal,
	Received = H.CashCharged + ISNULL((SELECT Amt=SUM(CW.Amount) FROM MasterCashWin CW WHERE CW.DocumentCode=H.ServiceInvCode AND CW.DocumentType='RS'), 0),
	UserName = U.UserName,
	Ref1 = H.Ref1,
	Remarks=H.Remarks
FROM ServiceHeader H, ServiceDetail D, Service S, Users U, Accounts A
WHERE
	H.Date BETWEEN :adt_startdate AND :adt_enddate AND
	H.SalesmanCode IN (:ai_usercode) AND
	H.CustCode = A.AccCode AND
	H.ServiceInvCode = D.ServiceInvCode AND
	H.SalesManCode = U.UserCode AND
	D.ServiceCode = S.ServiceCode
GROUP BY
	H.ServiceInvCode,
	A.Name,
	H.Date,
	H.PatientCode,
	H.FlatDisc,
	H.MiscCharges,
	H.InvTotal,
	H.CashCharged,
	S.Name,
	D.SrvRowID,
	U.UserName,
	H.Ref1,
	H.Doctcode,
	H.Remarks
UNION ALL
SELECT 
	ServiceInvCode=H.ServiceRInvCode,
	Customer=A.Name,
	Type = 'R',
	Date=H.Date,
	Patient = 
		(SELECT P.Name + ' (' + ISNULL(P.RegNo,'') + '), ' + 
			CASE WHEN P.Gender='F' THEN 'Female' ELSE 'Male' END + ' ' +
			CASE WHEN P.AgeYears IS NULL OR P.AgeYears=0 THEN '' ELSE LTRIM(RTRIM(STR(P.AgeYears,5))) + ' Years ' END + ' ' +
			CASE WHEN P.AgeMonths IS NULL OR P.AgeMonths=0 THEN '' ELSE LTRIM(RTRIM(STR(P.AgeMonths,5))) + ' Months ' END + ' ' +
			CASE WHEN P.AgeDays IS NULL OR P.AgeDays=0 THEN '' ELSE LTRIM(RTRIM(STR(P.AgeDays,5))) + ' Days ' END
		FROM Patient P 
		WHERE P.PatientCode=H.PatientCode),
	Service = S.Name,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode=H.Doctcode),
	ServiceRowID = D.SrvRRowID,
	Charges = SUM((D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - H.DiscPerc * 0.01))),
	Discount = SUM((D.Qty * D.ServiceFlatDisc) + (D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * D.DiscPerc * 0.01) + (D.Qty * D.ServicePrice * (1 - D.DiscPerc * 0.01) * (H.DiscPerc * 0.01))),
	FlatDisc = ISNULL(H.FlatDisc,0),
	MiscCharges = ISNULL(H.MiscCharges,0),
	InvTotal = H.InvTotal,
	Received = (H.CashCharged + ISNULL((SELECT Amt=SUM(CW.Amount) FROM MasterCashWin CW WHERE CW.DocumentCode=H.ServiceRInvCode AND CW.DocumentType='RR'), 0)),
	UserName = U.UserName,
	Ref1 = space(100),
	Remarks=H.Remarks
FROM ServiceRHeader H, ServiceRDetail D, Service S, Users U, Accounts A
WHERE
	H.Date BETWEEN :adt_startdate AND :adt_enddate AND
	H.SalesmanCode IN (:ai_usercode) AND
	H.CustCode = A.AccCode AND
	H.ServiceRInvCode = D.ServiceRInvCode AND
	H.SalesManCode = U.UserCode AND
	D.ServiceCode = S.ServiceCode
GROUP BY
	H.ServiceRInvCode,
	A.Name,
	H.Date,
	H.PatientCode,
	H.FlatDisc,
	H.MiscCharges,
	H.InvTotal,
	H.CashCharged,
	S.Name,
	D.SrvRRowID,
	U.UserName,
	H.Doctcode,
	H.Remarks
"
  arguments=(("ai_usercode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="username A, date A, serviceinvcode A, type A, servicerowid A"
)
