release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=144 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long updatewhereclause=yes name=clientinstanceid dbname="ClientInstanceID"  )
column=(type=long updatewhereclause=yes name=icode dbname="Icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="LooseQty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="ItemFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="UnitSalesTax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="GstPerc"  )
column=(type=char(100) updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="CustRefNo"  )
column=(type=char(100) updatewhereclause=yes name=custrefno2 dbname="CustRefNo2"  )
column=(type=char(100) updatewhereclause=yes name=custrefno3 dbname="CustRefNo3"  )
column=(type=char(100) updatewhereclause=yes name=custrefno4 dbname="CustRefNo4"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="InvDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="MiscCharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="FlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc1 dbname="InvGSTPerc1"  )
 retrieve="SELECT 
	ClientInstanceID=MAX(T.ClientInstanceID),
	Icode=I.ICode,
	AliasName=I.CustomICode,
	ItemName=I.Name,
	LooseQty=T.LooseQty,
	BonusQty=T.BonusQty,
	PackUnits=T.PackUnits,
	SalePrice=T.SalePrice,
	DiscPerc=T.DiscPerc,
	ItemFlatDisc=T.ItemFlatDisc,
	UnitSalesTax=T.UnitSalesTax,
	GstPerc=T.GstPerc,
	SaleItemDescription = T.SaleItemDescription,
	CustRefNo = MAX(SL.CustRefNo),
	CustRefNo2 = MAX(SL.CustRefNo2),
	CustRefNo3= MAX(SL.CustRefNo3),
	CustRefNo4 = MAX(SL.CustRefNo4),
	Remarks = MAX(SL.Remarks),
	InvDiscPerc = MAX(SL.DiscPerc),
	MiscCharges = MAX(SL.MiscCharges),
	FlatDisc = MAX(SL.FlatDisc),
	InvGSTPerc1 = MAX(SL.InvGSTPerc1)
FROM
	CRS_SaleLedger SL,
	Item I,
	(SELECT 
		SD.ClientInstanceID,
		SD.SaleInvCode, 
		SD.Icode,
		LooseQty=SUM(SD.LooseQty),
		BonusQty=SUM(SD.BonusQty),
		PackUnits=MAX(SD.PackUnits),
		SalePrice=MAX(SD.SalePrice),
		DiscPerc=MAX(SD.DiscPerc),
		ItemFlatDisc=MAX(SD.ItemFlatDisc),
		UnitSalesTax=MAX(SD.UnitSalesTax),
		GstPerc=MAX(SD.GstPerc),
		SaleItemDescription=MAX(SD.SaleItemDescription)
	FROM
		CRS_SaleDetail SD, (SELECT ID=CAST(Code1 AS INT), Inv=CAST(Code2 AS INT) FROM ReportData) R
	WHERE 
		SD.ClientInstanceID = R.ID AND
		SD.SaleInvCode = R.Inv
	GROUP BY
		SD.ClientInstanceID,
		SD.SaleInvCode, 
		SD.Icode) T
WHERE
	SL.ClientInstanceID IN (SELECT DISTINCT CAST(Code1 AS INT) FROM ReportData) AND
	SL.ClientInstanceID = T.ClientInstanceID AND
	SL.SaleInvCode = T.SaleInvCode AND
	T.ICode = I.ICode
GROUP BY
	I.ICode,
	I.CustomICode,
	I.Name,
	T.LooseQty,
	T.BonusQty,
	T.PackUnits,
	T.SalePrice,
	T.DiscPerc,
	T.ItemFlatDisc,
	T.UnitSalesTax,
	T.GstPerc,
	T.SaleItemDescription
ORDER BY
	ItemName"
 )
