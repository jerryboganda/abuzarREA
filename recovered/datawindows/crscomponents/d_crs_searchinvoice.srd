header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912"  height.autosize=yes)
table(column=(type=char(1) updatewhereclause=yes initial="N" name=selected dbname="SELECTED" 
 values="	Y/	N"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type" 
 values="Sales	S/Return	R/"  )
column=(type=char(202) updatewhereclause=yes name=crs_clientname dbname="CRS_ClientName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=long updatewhereclause=yes name=clientinstanceid dbname="ClientInstanceID"  )
column=(type=char(100) updatewhereclause=yes name=custrefno dbname="CustRefNo"  )
column=(type=char(100) updatewhereclause=yes name=custrefno2 dbname="CustRefNo2"  )
column=(type=char(100) updatewhereclause=yes name=custrefno3 dbname="CustRefNo3"  )
column=(type=char(100) updatewhereclause=yes name=custrefno4 dbname="CustRefNo4"  )
column=(type=char(100) updatewhereclause=yes name=custrefno5 dbname="CustRefNo5"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve="SELECT 
	SELECTED='N',
	Type=S.Type,
	CRS_ClientName=CL.Name + '(' + CI.Name + ')',
	Date=S.Date,
	InvCode=S.InvCode,
	ClientInstanceID=S.ClientInstanceID,
	CustRefNo=S.CustRefNo,
	CustRefNo2=S.CustRefNo2,
	CustRefNo3=S.CustRefNo3,
	CustRefNo4=S.CustRefNo4,
	CustRefNo5=S.CustRefNo5,
	Remarks=S.Remarks,
	InvTotal=S.InvTotal
FROM 
	CRS_ClientInstance CI, 
	CRS_ClientList CL,
	(SELECT 
		Type= 'S',
		S.ClientInstanceID,
		S.Date,
		InvCode=S.SaleInvCode,
		S.CustRefNo,
		S.CustRefNo2,
		S.CustRefNo3,
		S.CustRefNo4,
		S.CustRefNo5,
		S.Remarks,
		S.InvTotal
	FROM CRS_SaleLedger S
	WHERE S.CustRefNo LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo2 LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo3 LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo4 LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo5 LIKE ('%' + :as_searchtext + '%') OR S.Remarks LIKE ('%' + :as_searchtext + '%')
	UNION ALL
	SELECT 
		Type= 'R',
		S.ClientInstanceID,
		S.Date,
		InvCode=S.SRInvCode,
		S.CustRefNo,
		S.CustRefNo2,
		S.CustRefNo3,
		S.CustRefNo4,
		CustRefNo5='',
		S.Remarks,
		S.InvTotal
	FROM CRS_SRLedger S
	WHERE S.CustRefNo LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo2 LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo3 LIKE ('%' + :as_searchtext + '%') OR S.CustRefNo4 LIKE ('%' + :as_searchtext + '%') OR S.Remarks LIKE ('%' + :as_searchtext + '%') ) AS S
WHERE 
	CL.ClientID = CI.ClientID AND
	CI.ClientInstanceID = S.ClientInstanceID
ORDER BY
		Date		"
  arguments=(("as_searchtext", string))
)
