table(column=(type=long update=yes updatewhereclause=yes name=code dbname="glvochcode"  )
column=(type=long update=yes updatewhereclause=yes name=vouchercode dbname="vouchercode"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="acccode"  )
column=(type=long updatewhereclause=yes name=jv dbname="JV"  )
