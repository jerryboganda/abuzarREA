column=(type=decimal(5) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid value for currency conversion rate'" initial="0" name=conversionrate dbname="conversionrate"  )
 retrieve="SELECT
	glvochcode=glheader.glvochcode ,
	vouchercode=glheader.vouchercode,
	acccode=glheader.acccode,
	JV = (SELECT VC.JournalVoucher FROM VocherCategory VC WHERE VC.VochCatCode = glheader.vochcatcode),
	account = (SELECT A.Name FROM Accounts A WHERE A.AccCode = glheader.acccode),
	remarks='                                                                               ',
	vochcatcode =glheader.vochcatcode ,
	salesmancode =glheader.salesmancode ,
	date=glheader.date ,
	posted =glheader.posted ,
	postdate=glheader.postdate ,
	username=users.username,
	originaldate=glheader.originaldate,
	modifiedby=glheader.modifiedby,
	postedby=glheader.postedby,
	chkno=glheader.chkno,
	smancode=glheader.smancode,
	currencycode=glheader.currencycode,
	conversionrate=glheader.conversionrate
FROM 
	crs_glheader glheader ,
	users     
WHERE 
	( glheader.clientinstanceid = :ar_clientinstanceid ) and 
	( glheader.salesmancode = users.usercode ) and  
	( glheader.glvochcode = :ar_VoucherCode )    "
  arguments=(("ar_clientinstanceid", number), ("ar_VoucherCode", number))
)
