 retrieve="  SELECT CRS_ClientList.ClientID,   
         CRS_ClientList.Name,   
         CRS_ClientList.Address1,   
         CRS_ClientList.Address2,   
         CRS_ClientList.Phone,   
         CRS_ClientList.Phone2,   
         CRS_ClientList.Fax,   
         CRS_ClientList.Email,   
         CRS_ClientList.Web,   
         CRS_ClientList.CP,   
         CRS_ClientList.CPPhone,   
         CRS_ClientList.CPMobile  
    FROM CRS_ClientList  
   WHERE CRS_ClientList.ClientID = :ai_Code   
            
"
  update="CRS_ClientList" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
