 retrieve="SELECT  
	code=crs_saleledger.saleinvcode , 
	salecatcode=crs_saleledger.salecatcode , 
	date=crs_saleledger.date , 
	custrefno=crs_saleledger.custrefno , 
	remarks = crs_saleledger.remarks , 
	custcode =crs_saleledger.custcode , 
	salesmancode =crs_saleledger.salesmancode ,
	headerno=crs_saleledger.headerno,  
	discperc = crs_saleledger.discperc , 
	flatdisc = crs_saleledger.flatdisc , 
	misccharges = crs_saleledger.misccharges , 
	salestax=crs_saleledger.salestax , 
	posted=crs_saleledger.posted , 
	postdate=crs_saleledger.postdate , 
	patientRegNo='          ',
	crs_saleledger.patientcode,
	cashreceived,
	invGSTPerc1=crs_saleledger.InvGstPerc1,
	dd_gstperc=0,
	gcode=0,
	crs_saleledger.gstno,
	crs_saleledger.PrintWaranty,
	crs_saleledger.PrintBatch,
	crs_saleledger.MessageCode,
	crs_saleledger.SmanCode,
	crs_saleledger.custrefno2,
	crs_saleledger.custrefno3,
	crs_saleledger.custrefno4,
	crs_saleledger.custrefno5,
	crs_saleledger.InvoiceSize,
	crs_saleledger.invtotal,
	crs_saleledger.machinename,
	crs_saleledger.ModifyCounter,
	crs_saleledger.diseasecode,
	crs_saleledger.itemdiscpercno,
	crs_saleledger.unreceivedbalance,
	crs_saleledger.printbalance,
	crs_saleledger.AccountFor,
	crs_saleledger.PaymentMode,
	crs_saleledger.PaymentAccCode,
	crs_saleledger.Amt,
	crs_saleledger.AmtBy,
	crs_saleledger.AmtDate,
	crs_saleledger.AmtReference,
	crs_saleledger.Outstandingamt,
	crs_saleledger.marked
FROM  
	crs_saleledger 
WHERE 
	dbo.crs_saleledger.clientinstanceid = :ai_clientinstanceid  AND
	dbo.crs_saleledger.saleinvcode = :ar_SaleInvCode"
  arguments=(("ai_clientinstanceid", number), ("ar_SaleInvCode", number))
)
