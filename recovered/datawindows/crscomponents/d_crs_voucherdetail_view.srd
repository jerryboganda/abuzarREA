table(column=(type=long updatewhereclause=yes name=invoicecode dbname="invoicecode"  )
column=(type=datetime updatewhereclause=yes name=invdate dbname="invdate"  )
column=(type=decimal(2) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=outstandingamt dbname="OutStandingAmt"  )
column=(type=char(12) updatewhereclause=yes name=fullcode dbname="fullcode"  )
column=(type=long update=yes updatewhereclause=yes name=acccode dbname="acccode" 
 values=""  )
column=(type=char(20) update=yes updatewhereclause=yes name=chkno dbname="chkno"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long update=yes updatewhereclause=yes name=code dbname="glvochcode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="patientcode"  )
column=(type=char(60) updatewhereclause=no name=patient dbname="patient"  )
column=(type=char(50) updatewhereclause=yes name=guestregno dbname="guestregno"  )
column=(type=long update=yes updatewhereclause=yes name=guestcode dbname="guestcode"  )
column=(type=char(100) updatewhereclause=no name=guest dbname="guest"  )
column=(type=char(60) updatewhereclause=yes name=studentregno dbname="Studentregno"  )
column=(type=long update=yes updatewhereclause=yes name=studentcode dbname="studentcode"  )
column=(type=char(100) updatewhereclause=no name=student dbname="Student"  )
column=(type=long update=yes updatewhereclause=yes name=glrowid dbname="GLROWID"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=glutn dbname="GLUTN"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=balance dbname="balance"  )
column=(type=decimal(5) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Please enter valid Foreign Amount'" initial="0" name=foreignamt dbname="foreignamt"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" initial="0" name=debit dbname="debit"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(GetText()) >= 0" initial="0" name=credit dbname="credit"  )
 retrieve="SELECT  
	invoicecode=gldetail.invoicecode,
	invdate=GetDate(),
	NetAmt=0.00,
	OutStandingAmt=gldetail.OutStandingAmt,
	fullcode=accounts.aliasname,
	acccode=gldetail.acccode,
	chkno=gldetail.chkno,
	remarks=gldetail.remarks,
	glvochcode=gldetail.glvochcode ,
	regno = (SELECT regno FROM Patient WHERE Patient.PatientCode = gldetail.patientcode),
	patientcode=gldetail.patientcode,
	patient = (SELECT Name FROM Patient WHERE Patient.PatientCode = gldetail.patientcode),
	guestregno = (SELECT regno FROM Guest WHERE Guest.GuestCode = gldetail.Guestcode),
	guestcode=gldetail.guestcode,
	guest = (SELECT name FROM Guest WHERE Guest.GuestCode = gldetail.Guestcode),
	Studentregno = (SELECT regno FROM Student WHERE Student.StudentCode = gldetail.Studentcode),
	studentcode=gldetail.studentcode,
	Student = (SELECT name FROM Student WHERE Student.StudentCode = gldetail.Studentcode),
	GLROWID=gldetail.GLROWID,
	GLUTN=gldetail.GLUTN,
	balance=gldetail.balance,
	foreignamt=gldetail.foreignamt,
	debit=gldetail.debit,
	credit=gldetail.credit
	
FROM
	crs_gldetail  gldetail ,
	crs_glheader glheader, 
	accounts
	
WHERE
	( glheader.clientinstanceid = :ar_clientinstanceid) and
   ( glheader.glvochcode = :ar_VochCode ) and
	( glheader.glvochcode = gldetail.glvochcode ) and
	( gldetail.acccode = accounts.acccode )
ORDER BY
	gldetail.glrowid
"
  arguments=(("ar_clientinstanceid", number), ("ar_VochCode", number))
)
