 retrieve="SELECT  
	code=crs_srledger.srinvcode , 
	saleinvcode=crs_srledger.saleinvcode , 
	salecatcode=crs_srledger.srcatcode , 
	date=crs_srledger.date , 
	custrefno=crs_srledger.custrefno , 
	remarks = crs_srledger.remarks , 
	custcode =crs_srledger.custcode , 
	salesmancode =crs_srledger.salesmancode ,
	headerno=crs_srledger.headerno,  
	discperc = crs_srledger.discperc , 
	flatdisc = crs_srledger.flatdisc , 
	misccharges = crs_srledger.misccharges , 
	salestax=crs_srledger.salestax , 
	posted=crs_srledger.posted , 
	postdate=crs_srledger.postdate , 
	patientRegNo='          ',
	crs_srledger.patientcode,
	invGSTPerc1=crs_srledger.InvGstPerc1,
	dd_gstperc=0,
	gcode=0,
	crs_srledger.SmanCode,
	crs_srledger.custrefno2,
	crs_srledger.custrefno3,
	crs_srledger.custrefno4,
	crs_srledger.invtotal,
	crs_srledger.machinename,
	crs_srledger.AccountFor,
	crs_srledger.PaymentMode,
	crs_srledger.PaymentAccCode,
	crs_srledger.Amt,
	crs_srledger.AmtBy,
	crs_srledger.AmtDate,
	crs_srledger.AmtReference,
	crs_srledger.Outstandingamt,
	crs_srledger.marked
FROM  
	crs_srledger 
WHERE 
	dbo.crs_srledger.clientinstanceid = :ai_clientinstanceid  AND
	dbo.crs_srledger.srinvcode = :ar_SRInvCode"
  arguments=(("ai_clientinstanceid", number), ("ar_SRInvCode", number))
)
