release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="ItemFlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(9) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=long updatewhereclause=yes name=id dbname="ID"  )
 retrieve="SELECT 
	ItemName = I.Name,
	Qty = SUM(D.LooseQty),
	BonusQty= SUM(D.BonusQty),
	SalePrice = D.SalePrice,
	ItemFlatDisc=D.ItemFlatDisc,
	DiscPerc = D.DiscPerc,
	Amount = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.Discperc * 0.01)),
	ID = MAX(D.SaleRowID)
FROM CRS_SaleDetail D, Item I
WHERE 
	:as_type = 'S' AND
	D.ClientInstanceID = :ai_clientinstance AND
	D.SaleInvCode = :ai_invcode AND
	D.ICode=I.ICode
GROUP BY
	I.Name,
	D.SalePrice,
	D.ItemFlatDisc,
	D.DiscPerc
UNION ALL
SELECT 
	ItemName = I.Name,
	Qty = SUM(D.LooseQty),
	BonusQty= SUM(D.BonusQty),
	SalePrice = D.SRPrice,
	ItemFlatDisc=0.00,
	DiscPerc = D.DiscPerc,
	Amount = SUM(D.LooseQty * D.SRPrice * (1 - D.Discperc * 0.01)),
	ID = MAX(D.RowID)
FROM CRS_SRDetail D, Item I
WHERE 
	:as_type = 'R' AND
	D.ClientInstanceID = :ai_clientinstance AND
	D.SRInvCode = :ai_invcode AND
	D.ICode=I.ICode
GROUP BY
	I.Name,
	D.SRPrice,
	D.DiscPerc
ORDER BY 
	ID"
  arguments=(("ai_clientinstance", number), ("as_type", string), ("ai_invcode", number))
)
