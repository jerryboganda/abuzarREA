table(column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.Name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=long updatewhereclause=yes name=accounts_acccode dbname="Accounts.AccCode"  )
column=(type=long updatewhereclause=yes name=subcode dbname="SubCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=custcatcode dbname="Customer.CustCatCode"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Customer.Address1"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="Customer.City"  )
column=(type=char(115) updatewhereclause=yes name=summaryaccount dbname="SummaryAccount"  )
column=(type=long updatewhereclause=yes name=alertcode dbname="AlertCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=alerttypecode dbname="AlertTypeCode"  )
 retrieve="SELECT 
	Accounts.Name,   
	Accounts.AliasName,
	Accounts.AccCode,   
	SubCode=Accounts.SubCode,
	Customer.CustCatCode,
	Customer.Address1,   
	Customer.City,
	SummaryAccount = 
		CASE 
		WHEN (SELECT Count(SD.AccCode) 
				FROM SummaryAccountDetail SD 
				WHERE SD.AccCode = dbo.Accounts.AccCode) = 0 THEN NULL 
		ELSE
			(SELECT MAX(SA.Name) + ' (' + MAX(SA.AliasName) + ')' 
			FROM SummaryAccount SA, SummaryAccountDetail SD 
			WHERE SD.AccCode = dbo.Accounts.AccCode AND 
				SD.SummaryAccCode = SA.SummaryAccCode)
		END,
	AlertCode=Accounts.AlertCode,
	AlertTypeCode=(SELECT Alert.AlertTypeCode FROM Alert WHERE Alert.AlertCode = Accounts.AlertCode)
FROM 
	Accounts,   
	Customer  
WHERE 
	( Customer.CustCode = Accounts.AccCode ) AND Accounts.Active ='Y'
UNION ALL
SELECT 
	Accounts.Name,   
	Accounts.AliasName,
	Accounts.AccCode,   
	SubCode=Accounts.SubCode,
	CustCatCode=Supplier.SuppCatCode,
	Address1=Supplier.Address1,   
	City=Supplier.City,
	SummaryAccount = 
		CASE 
		WHEN (SELECT Count(SD.AccCode) 
				FROM SummaryAccountDetail SD 
				WHERE SD.AccCode = dbo.Accounts.AccCode) = 0 THEN NULL 
		ELSE
			(SELECT MAX(SA.Name) + ' (' + MAX(SA.AliasName) + ')' 
			FROM SummaryAccount SA, SummaryAccountDetail SD 
			WHERE SD.AccCode = dbo.Accounts.AccCode AND 
				SD.SummaryAccCode = SA.SummaryAccCode)
		END,
	AlertCode=Accounts.AlertCode,
	AlertTypeCode=(SELECT Alert.AlertTypeCode FROM Alert WHERE Alert.AlertCode = Accounts.AlertCode)
FROM 
	Accounts,   
	Supplier
WHERE 
	( Supplier.SuppCode = Accounts.AccCode ) AND Accounts.Active ='Y'
UNION ALL
SELECT 
	NULL,   
	NULL,
	NULL,   
	NULL,
	NULL,
	NULL,   
	NULL,
	SummaryAccount = NULL,
	AlertCode=NULL,
	AlertTypeCode=NULL
ORDER BY 
	Accounts.Name ASC   
"
 )
