table(column=(type=long updatewhereclause=yes name=purinvcode dbname="Purledger.purinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Purledger.date"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.name"  )
column=(type=long updatewhereclause=yes name=purcatcode dbname="Purledger.purcatcode" 
 values=""  )
 retrieve="Select purinvcode,
		 date,
  		 accounts.name,
		 purcatcode

From  purledger, accounts

Where purledger.suppcode = accounts.acccode AND
		Purledger.PurInvCode Between :ai_sinvcode AND :ai_linvcode

Order By PurInvCode Desc
"
  arguments=(("ai_sinvcode", number), ("ai_linvcode", number))
)
