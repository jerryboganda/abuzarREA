detail(height=64 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=prescode dbname="PrescriptionHeader.prescode"  )
column=(type=datetime updatewhereclause=yes name=modifieddate dbname="PrescriptionHeader.modifieddate"  )
column=(type=long updatewhereclause=yes name=issued dbname="Issued"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
 retrieve="Select prescode,
		 modifieddate,
		 Issued = (Select count(*) From Saleledger where saleledger.prescode = prescriptionheader.prescode ),
		 regno = ( Select RegNo From Patient Where Patientcode = PrescriptionHeader.patientcode ),
		 patient = ( Select Name From Patient Where Patientcode = PrescriptionHeader.patientcode )

From   PrescriptionHeader
Order By PresCode Desc"
  update="PrescriptionHeader" updatewhere=0 updatekeyinplace=no
 )
