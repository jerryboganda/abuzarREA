summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="Icode"  )
column=(type=char(75) updatewhereclause=yes name=fullcode dbname="FullCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="PurPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
 retrieve="SELECT
	Icode=I.ICode,
	FullCode=I.CustomICode,
	Name=I.Name,
	PackUnits = I.PackUnits,
	PurPrice=I.PurPrice,
	SalePrice=I.SalePrice
FROM
	Item I,
	(SELECT DISTINCT ResultedItem FROM Recipe) R
WHERE
	I.ICode = R.ResultedItem"
 )
