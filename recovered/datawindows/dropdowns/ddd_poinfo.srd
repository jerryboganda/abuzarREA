table(column=(type=long updatewhereclause=yes name=purorderheader_pocode dbname="PurOrderHeader.pocode"  )
column=(type=datetime updatewhereclause=yes name=purorderheader_date dbname="PurOrderHeader.date"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="Manufacturer.name"  )
column=(type=char(60) updatewhereclause=yes name=accounts_name dbname="Accounts.name"  )
 retrieve="SELECT  
	dbo.purorderheader.pocode ,
	dbo.purorderheader.date ,
	dbo.manufacturer.name ,
	dbo.accounts.name     
FROM 
	dbo.purorderheader ,
	dbo.manufacturer ,
	dbo.accounts     
WHERE ( dbo.purorderheader.manfcode = dbo.manufacturer.manfcode ) and          ( dbo.purorderheader.suppcode = dbo.accounts.acccode )   "
 )
