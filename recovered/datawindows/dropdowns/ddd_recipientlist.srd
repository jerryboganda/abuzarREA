release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=recipientpartycode dbname="RecipientPartyCode"  )
column=(type=char(100) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(200) updatewhereclause=yes name=address dbname="Address"  )
 retrieve="SELECT 
	RecipientPartyCode = D.DeptCode,
	AliasName = SPACE(100),
	Name = d.Name,
	Address = SPACE(200)
FROM
	Department D
WHERE 
	:ai_recipienttypecode IN (1)
UNION ALL
SELECT 
	RecipientPartyCode = A.AccCode,
	AliasName = A.AliasName,
	Name = A.Name,
	Address = 
		CASE SubCode 
		WHEN 3 THEN (SELECT ISNULL(C.Address1, '') + ' ' + ISNULL(C.Address2, '') FROM Customer C WHERE C.CustCode = A.AccCode)
		ELSE SPACE(200) END 
FROM
	Accounts A
WHERE 
	:ai_recipienttypecode IN (2) AND SubCode=3 AND Active = 'Y'
UNION ALL
SELECT 
	RecipientPartyCode = A.AccCode,
	AliasName = A.AliasName,
	Name = A.Name,
	Address = 
		CASE SubCode 
		WHEN 7 THEN (SELECT ISNULL(S.Address1, '') + ' ' + ISNULL(S.Address2, '') FROM Supplier S WHERE S.SuppCode = A.AccCode)
		ELSE SPACE(200) END 
FROM
	Accounts A
WHERE 
	:ai_recipienttypecode IN (3) AND SubCode=7 AND Active = 'Y'
UNION ALL
SELECT 
	RecipientPartyCode = S.SalesManCode,
	AliasName = SPACE(100),
	Name = S.Name,
	Address = SPACE(200)
FROM
	SalesMan S
WHERE 
	:ai_recipienttypecode IN (4)
ORDER BY
	Name"
  arguments=(("ai_recipienttypecode", number))
)
