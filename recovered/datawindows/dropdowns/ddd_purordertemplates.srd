table(column=(type=long updatewhereclause=yes name=pocode dbname="PurOrderHeader.pocode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PurOrderHeader.date"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
 retrieve="Select pocode,
		 date,
		 Manufacturer = Manufacturer.Name,
		 Supplier = Accounts.Name

From 	 PurOrderHeader,
       Manufacturer,
       Accounts

Where  PurOrderHeader.ManfCode = Manufacturer.ManfCode AND
       PurOrderHeader.SuppCode = Accounts.acccode
"
 )
