table(column=(type=long updatewhereclause=yes name=code dbname="PRLedger.prinvcode"  )
column=(type=long updatewhereclause=yes name=suppcode dbname="SuppCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="PRLedger.date"  )
column=(type=char(60) updatewhereclause=yes name=supplier_name dbname="Accounts.name"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Accounts.posted"  )
column=(type=decimal(2) updatewhereclause=yes name=total dbname="PRLedger.invtotal"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
column=(type=char(60) updatewhereclause=yes name=users dbname="users"  )
 retrieve="SELECT  
	PRLedger.prinvcode ,
	SuppCode=PRLedger.SuppCode,
	PRLedger.date ,
	accounts.name ,
	posted,
	PRLedger.invtotal,
	PostedBy = IsNull((Select username from users 
				where dbo.PRLedger.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
				where dbo.PRLedger.modifiedby = dbo.users.usercode), ''),
	users=(select username from users where usercode=PRLedger.salesmancode)
FROM
	Accounts ,
	PRLedger     
WHERE   
	PRLedger.suppcode = accounts.acccode
"
  sort="code D"
)
