table(column=(type=char(12) updatewhereclause=yes name=accounts_aliasname dbname="Accounts.AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer_name dbname="Accounts.Name"  )
column=(type=long updatewhereclause=yes name=accounts_acccode dbname="Accounts.AccCode"  )
column=(type=char(60) updatewhereclause=yes name=customer_address1 dbname="Customer.Address1"  )
column=(type=long updatewhereclause=yes name=customer_custcatcode dbname="Customer.CustCatCode" 
 values=""  )
column=(type=char(60) updatewhereclause=yes name=customer_city dbname="Customer.City"  )
 retrieve="SELECT 
	Accounts.AliasName,
	Accounts.Name,
	Accounts.AccCode,   
	Customer.Address1,   
	Customer.CustCatCode,
	Customer.City  
FROM 
	Accounts,   
	Customer  
WHERE 
	( Customer.CustCode = Accounts.AccCode ) AND
	/*		( Customer.CustCode <> 19) AND*/
	(Accounts.Active='Y')
ORDER BY 
	Accounts.Name ASC   
"
 )
