table(column=(type=char(60) updatewhereclause=yes name=name dbname="Patient.name"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Patient.regno"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Patient.phone"  )
column=(type=char(100) updatewhereclause=yes name=phone2 dbname="Patient.phone2"  )
column=(type=char(100) updatewhereclause=yes name=mobileno1 dbname="Patient.mobileno1"  )
column=(type=char(100) updatewhereclause=yes name=mobileno2 dbname="Patient.mobileno2"  )
column=(type=char(100) updatewhereclause=yes name=mobileno3 dbname="Patient.mobileno3"  )
column=(type=long key=yes updatewhereclause=yes name=patientcode dbname="Patient.patientcode"  )
column=(type=char(25) updatewhereclause=yes name=city dbname="Patient.city"  )
column=(type=long updatewhereclause=yes name=relationcode dbname="Patient.relationcode"  )
column=(type=long updatewhereclause=yes name=doctcode dbname="Patient.doctcode"  )
column=(type=long updatewhereclause=yes name=wardcode dbname="Patient.wardcode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="Patient.custcode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(113) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=long updatewhereclause=yes name=recurringperiod dbname="Patient.RecurringPeriod"  )
 retrieve="SELECT  
	patient.name,
	regno,
	phone,
	phone2,
	mobileno1,
	mobileno2,
	mobileno3,
	patientcode,
	Patient.city,
	relationcode,
	doctcode,
	wardcode,
	patient.custcode,
	customer=(select accounts.name from accounts where acccode=patient.custcode),
	patient = LTRIM(RTRIM(Patient.Name)) + ' (' + LTRIM(RTRIM(Patient.RegNo)) + ')',
	RecurringPeriod
FROM Patient
WHERE Active='Y' AND 
	(Phone LIKE ('%' + :as_phonehint + '%') OR
	Phone2 LIKE ('%' + :as_phonehint + '%') OR
	mobileno1 LIKE ('%' + :as_phonehint + '%') OR
	mobileno2 LIKE ('%' + :as_phonehint + '%') OR
	mobileno3 LIKE ('%' + :as_phonehint + '%'))
Order by name"
  update="Patient" updatewhere=1 updatekeyinplace=no
  arguments=(("as_phonehint", string))
)
