detail(height=80 color="536870912" )
table(column=(type=long updatewhereclause=yes name=srinvcode dbname="SRLedger.SRInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="SRLedger.Date"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Accounts.Name"  )
 retrieve="Select dbo.SRLedger.SRInvCode,
		 dbo.SRLedger.Date,
		 dbo.Accounts.Name

From   dbo.SRLedger, dbo.Accounts

Where  dbo.SRLedger.CustCode = dbo.Accounts.AccCode AND
		 dbo.SrLedger.SrInvCode Between :ai_sinvcode AND :ai_linvcode

Order By dbo.SRLedger.SrInvCode Desc
"
  arguments=(("ai_sinvcode", number), ("ai_linvcode", number))
)
