table(column=(type=long updatewhereclause=yes name=code dbname="PurQuotationHeader.purquotationcode"  )
column=(type=datetime updatewhereclause=yes name=originaldate dbname="PurQuotationHeader.originaldate"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="Users.username"  )
column=(type=char(150) updatewhereclause=yes name=remarks dbname="PurQuotationHeader.remarks"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="PurQuotationHeader.Active"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="supplier"  )
 retrieve="SELECT 
	dbo.purquotationheader.purquotationcode , 
	dbo.purquotationheader.originaldate,
	dbo.users.username,
	dbo.purquotationheader.remarks,
	dbo.purquotationheader.Active,
	supplier=accounts.name			
FROM 
	dbo.purquotationheader, 
	users,
	accounts
WHERE 
	dbo.purquotationheader.posted = 'Y' AND
	dbo.purquotationheader.usercode = dbo.users.usercode and
	dbo.purquotationheader.suppcode=accounts.acccode
UNION ALL
SELECT 
	code=NULL, 
	originaldate=null,
	username=null,
	remarks=NULL,
	Active='Y',
	supplier=' <NULL>'
ORDER BY 
	PurQuotationCode"
 )
