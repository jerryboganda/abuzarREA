detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=receiptinvcode dbname="Receiptinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(10) updatewhereclause=yes name=referenceno dbname="ReferenceNo"  )
column=(type=datetime updatewhereclause=yes name=referencedate dbname="ReferenceDate"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=long updatewhereclause=yes name=sourcecode dbname="SourceCode"  )
column=(type=char(60) updatewhereclause=yes name=sourcename dbname="SourceName"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=char(60) updatewhereclause=yes name=postedby dbname="PostedBy"  )
column=(type=char(60) updatewhereclause=yes name=modifiedby dbname="ModifiedBy"  )
 retrieve="SELECT
	Receiptinvcode = ReceiptHeader.Receiptinvcode , 
	Date=ReceiptHeader.date , 
	ReferenceNo=ReceiptHeader.ReferenceNo, 
	ReferenceDate=ReceiptHeader.ReferenceDate, 
	Remarks=ReceiptHeader.remarks , 
	SourceCode=dbo.ReceiptHeader.RecipientCode,
	SourceName=
		CASE RecipientCode 
			WHEN 1 THEN (SELECT D.Name FROM Department D WHERE D.DeptCode = ReceiptHeader.DeptCode)
			WHEN 4 THEN (SELECT S.Name FROM Salesman S WHERE S.SalesMancode = ReceiptHeader.RecipientSalesman)
			ELSE (SELECT Name FROM Accounts A WHERE A.Acccode = ReceiptHeader.AccCode)
		END,
	UserName=dbo.users.username,
	posted = ReceiptHeader.posted,
	PostedBy = IsNull((Select username from users 
				where dbo.ReceiptHeader.postedby = dbo.users.usercode), ''),
	ModifiedBy = IsNull((Select username from users 
				where dbo.ReceiptHeader.modifiedby = dbo.users.usercode), '') 
FROM
	users,
	ReceiptHeader
WHERE
	( dbo.ReceiptHeader.salesmancode = dbo.users.usercode )
ORDER BY 
	Receiptinvcode"
 )
