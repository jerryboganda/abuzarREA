 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="PatientAdmission.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="PatientAdmission.UserCode"  )
column=(type=long update=yes updatewhereclause=yes name=doctorcode dbname="PatientAdmission.DoctorCode"  )
column=(type=char(1) update=yes updatewhereclause=yes name=discharged dbname="PatientAdmission.Discharged"  )
column=(type=datetime update=yes updatewhereclause=yes name=dischargedon dbname="PatientAdmission.DischargedOn"  )
column=(type=long update=yes updatewhereclause=yes name=dischargedby dbname="PatientAdmission.DischargedBy"  )
column=(type=char(100) update=yes updatewhereclause=yes name=diagnosis dbname="PatientAdmission.Diagnosis"  )
 retrieve="  SELECT PatientAdmission.AdmissionCode,   
         PatientAdmission.PatientCode,   
         PatientAdmission.Date,   
         PatientAdmission.UserCode,   
         PatientAdmission.DoctorCode,   
         PatientAdmission.Discharged,   
         PatientAdmission.DischargedOn,   
         PatientAdmission.DischargedBy,   
         PatientAdmission.Diagnosis  
    FROM PatientAdmission   
WHERE		PatientAdmission.PatientCode = :ar_PatientCode
ORDER BY PatientAdmission.Date DESC, PatientAdmission.AdmissionCode DESC, PatientAdmission.DischargedOn"
  update="PatientAdmission" updatewhere=1 updatekeyinplace=no
  arguments=(("ar_patientcode", number))
)
