release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=80263581 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=long updatewhereclause=yes name=icode dbname="Item.icode"  )
column=(type=decimal(4) updatewhereclause=yes name=dueqty dbname="Saledetail.LooseQTY"  )
column=(type=long updatewhereclause=yes name=gcode dbname="Saledetail.gcode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Saledetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Saledetail.expiry"  )
column=(type=char(1) updatewhereclause=yes name=due dbname="Saledetail.Due"  )
column=(type=long identity=yes updatewhereclause=yes name=salerowid dbname="Saledetail.RowId"  )
column=(type=decimal(4) updatewhereclause=yes name=satisfiedqty dbname="SatisfiedQty"  )
 retrieve="   SELECT dbo.item.name,
			dbo.item.icode,
			dbo.SaleDetail.LooseQTY,
			dbo.SaleDetail.gcode,
			dbo.SaleDetail.batch,
			dbo.SaleDetail.expiry, 
			dbo.SaleDetail.Due,
			dbo.SaleDetail.RowId,
			SatisfiedQty =  ISNull((Select sum(DueSatisfyDetail.duesatisfyqty) 
									from DueSatisfyDetail,   DueSatisfyHeader
									Where ( DueSatisfyHeader.saleinvcode = :ar_SaleInvCode ) and
											( DueSatisfyHeader.DueSatisfyCode = DueSatisfyDetail.DueSatisfyCode) and 
											(SaleDetail.icode = DueSatisfyDetail.ICode and 
											 SaleDetail.RowId = DueSatisfyDetail.SaleRowId)), 0)			



    FROM dbo.item, 
	 		dbo.Saledetail	

   WHERE ( dbo.SaleDetail.Saleinvcode = :ar_SaleInvCode )and
			( dbo.SaleDetail.Due IN ('D', 'S', 'X')) and 
	 		( dbo.item.icode = dbo.Saledetail.icode ) 
"
  arguments=(("ar_SaleInvCode", number))
)
