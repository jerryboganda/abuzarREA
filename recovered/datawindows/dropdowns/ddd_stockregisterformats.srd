table(column=(type=long updatewhereclause=yes name=reportformat dbname="ReportFormat"  )
column=(type=char(40) updatewhereclause=yes name=name dbname="Name"  )
 retrieve="SELECT ReportFormat=1, Name='Standard Landscape'
UNION ALL
SELECT ReportFormat=2, Name='Standard Portrait'
UNION ALL
SELECT ReportFormat=3, Name='Patient'
UNION ALL
