datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Recipe.RecipeCode"  )
column=(type=long updatewhereclause=yes name=priority dbname="Recipe.Priority"  )
column=(type=char(12) update=yes updatewhereclause=yes name=aliasname dbname="Recipe.AliasName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="Recipe.Name"  )
column=(type=char(400) update=yes updatewhereclause=yes name=description dbname="Recipe.Description"  )
column=(type=char(60) updatewhereclause=yes name=resulteditemname dbname="ResultedItemName"  )
column=(type=long update=yes updatewhereclause=yes name=resulteditem dbname="Recipe.ResultedItem"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Recipe.Date"  )
 retrieve="SELECT
	Recipe.RecipeCode, 
	Recipe.Priority,
	Recipe.AliasName,   
	Recipe.Name,   
	Recipe.Description,   
	ResultedItemName=(SELECT Item.Name FROM Item WHERE Item.ICode = Recipe.ResultedItem),
	Recipe.ResultedItem,
	Recipe.Date
FROM
	Recipe
WHERE
	Recipe.ResultedItem = :ai_code
ORDER BY 
	 Recipe.Priority"
  update="Recipe" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
