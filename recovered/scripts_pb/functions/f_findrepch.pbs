// function f_findrepch (functions)  ancestor: function_object

// f_findrepch.f_findrepch(char as_ch) returns integer
	char[10] lc_value
	char lc_char
	long ll_counter
	lc_value[1] = "R"
	lc_value[2] = "P"
	lc_value[3] = "G"
	lc_value[4] = "W"
	lc_value[5] = "L"
	lc_value[6] = "B"
	lc_value[7] = "V"
	lc_value[8] = "F"
	lc_value[9] = "K"
	lc_value[10] = "S"
	if upper(as_ch) = "S" then
		return 0
	end if
	for ll_counter = 1 to 9
		if lc_value[ll_counter] = upper(as_ch) then
			return ll_counter
		end if
	next
	return -1
