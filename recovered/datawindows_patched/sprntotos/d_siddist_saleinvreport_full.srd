compute(name=c_invsalestaxval visible="1	if( ROUND(Round((Round(sum((round(c_amount,2) ) for all)  *  (1 - invdiscperc * 0.01),2) -  flatdisc  )  *  invgstperc  * 0.01,2) + SUM(round( c_amount  *  gstperc * 0.01, 2) +  Round((looseqty+bonusqty) * unitsalestax ,2) For ALL), 2) >0,1,0)" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="553648127" color="0" x="6406" y="261" height="156" width="1010" format="#####0.00" expression="ROUND(Round((Round(sum((round(c_amount,2) ) for all)  *  (1 - invdiscperc * 0.01),2) -  flatdisc  )  *  invgstperc  * 0.01,2) + SUM(round( c_amount  *  gstperc * 0.01, 2) +  Round((looseqty+bonusqty) * unitsalestax ,2) For ALL), 2)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_nettotal visible="1	if(getrow() = rowcount(), 1, 0)" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-12" font.pitch="2" font.weight="700" background.mode="1" background.color="553648127" color="0" x="6406" y="500" height="197" width="1010" format="###,##,##,##0.00" expression="/*Round ( Sum((  looseqty   *  saleprice  )  *  ( 1 -  (    discperc * .01 )  )  -  (  salestax   *  looseqty ) ) *  ( 1 -  invdiscperc  * .01 )  -  flatdisc  +  misccharges  +  invsalestax , 0)*/Round(Sum (  c_netamount for all ) -  flatdisc  + misccharges  + salestax , 0)  + Round(sum(c_salestaxval for all ) + Round((Round(sum((round(c_amount,2) ) for all)  *  (1 - invdiscperc * 0.01) , 2) -  flatdisc  )  *  invgstperc  * 0.01,2),0)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
