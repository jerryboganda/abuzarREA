column=(type=long updatewhereclause=yes name=previousreading dbname="PreviousReading"  )
column=(type=long updatewhereclause=yes name=currentreading dbname="CurrentReading"  )
column=(type=long updatewhereclause=yes name=kilometer dbname="KiloMeter"  )
column=(type=long updatewhereclause=yes name=nextchange dbname="NextChange"  )
column=(type=decimal(2) updatewhereclause=yes name=cashtendered dbname="CashTendered"  )
column=(type=decimal(2) updatewhereclause=yes name=cashcharged dbname="CashCharged"  )
column=(type=decimal(2) updatewhereclause=yes name=cashback dbname="CashBack"  )
 retrieve="SELECT 
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end,
	packingdesc=max(item.packingdesc),
	manf=(select name from manufacturer where manufacturer.manfcode=max(item.manfcode)),
	messagedesc=(select description from message where message.messagecode=max(saleledger.messagecode)),
	saleperson=(select name from salesman where salesman.salesmancode=max(saleledger.smancode)),
	reprintdate=getdate(), 
	users.username, 
	accounts.name, 
	headerno =max(saleledger.headerno),
	headerinvno=max(saleledger.headerinvno),
	posted=max(saleledger.posted),
	printbalance=max(saleledger.printbalance),
	dbo.saleledger.saleinvcode,   
	dbo.saleledger.date,   
	dbo.saleledger.discperc,   
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.salestax, 
	dbo.saleledger.custcode,   
	dbo.saleledger.remarks,
	dbo.saleledger.custrefno,	
	dbo.saledetail.icode,   
	dbo.saledetail.gcode,
	salecatcode=max(saleledger.salecatcode),
	Id        = MAX(dbo.saledetail.IDENTITYCOL),     
	looseqty  = sum(saledetail.looseqty), 
	bonusqty  = sum(saledetail.bonusqty),
	packqty   = sum(saledetail.packqty), 
	packunits = max(saledetail.packunits), 
	saleprice = max(saledetail.saleprice), 
	rate      = max(saledetail.rate),
	salestax  = max(saledetail.salestax),   
	discperc  = max(saledetail.discperc), 
	customername=(select  max(remarks) from cashierwindow where cashierwindow.saleinvcode=saleledger.saleinvcode) ,
	itemflatdisc  = max(saledetail.itemflatdisc),
	unitsalestax  = max(saledetail.unitsalestax),
	gstperc       = max(saledetail.gstperc),
	invgstperc    = max(saleledger.invgstperc1),
	reprintcounter=max(saleledger.reprintingcounter),
	serverdate=getdate(),
	amt=max(saleledger.amt),
	balance=ISNULL(max(saleledger.Balance), 0),
	PreviousReading = max(saleledger.PreviousReading),
	CurrentReading = max(saleledger.CurrentReading),
	KiloMeter = max(ISNULL(saleledger.CurrentReading, 0) - ISNULL(saleledger.PreviousReading, 0)),
	NextChange = max(saleledger.NextChange),
	CashTendered = MAX(SaleLedger.CashTendered),
	CashCharged = MAX(SaleLedger.CashCharged),
	CashBack = MAX(SaleLedger.CashBack)
FROM 
	dbo.saleledger,   
	dbo.saledetail,  
	item, 
	customer, 
	accounts,
	users 
WHERE 
	( dbo.saleledger.saleinvcode = :ra_InvCode ) AND
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND 
	( dbo.saleledger.custcode = dbo.customer.custcode ) AND 
	( dbo.customer.custcode = dbo.accounts.acccode ) AND 
	( dbo.saleledger.salesmancode = dbo.users.usercode ) AND
	( saledetail.icode = item.icode )  
GROUP BY 
	saleledger.saleinvcode, 
	saleledger.date, 
	/*saleledger.headerno,*/
	saleledger.custcode, 
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	saleledger.salestax, 
	saleledger.remarks,
	saleledger.custrefno, 
	saledetail.icode,
	saledetail.rowgroup, 
	saledetail.gcode, 
	item.name,
	item.icode,
	item.printable, 
	accounts.name,
	dbo.users.username
ORDER BY 
	MAX(dbo.saledetail.IDENTITYCOL)
"
  arguments=(("ra_InvCode", number))
 sort="id A"
)
