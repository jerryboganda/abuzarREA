table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(60) updatewhereclause=yes name=custcity dbname="custcity"  )
column=(type=char(100) updatewhereclause=yes name=custphone dbname="custphone"  )
