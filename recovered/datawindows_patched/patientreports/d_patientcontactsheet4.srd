table(column=(type=char(25) updatewhereclause=yes name=city dbname="City"  )
column=(type=long updatewhereclause=yes name=patientcount dbname="PatientCount"  )
column=(type=long updatewhereclause=yes name=visitcount dbname="VisitCount"  )
 retrieve="SELECT 
	City = Patient.City,
	PatientCount=COUNT(T.PatientCode),
	VisitCount=SUM(T.VisitCount)
FROM 
	Patient,
	(SELECT S.PatientCode, VisitCount=COUNT(S.SaleInvCode)
	FROM SaleLedger S
	WHERE S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY S.PatientCode
	UNION ALL
	SELECT S.PatientCode, VisitCount=COUNT(S.ServiceInvCode)
	FROM ServiceHeader S
	WHERE S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY S.PatientCode) T
WHERE	
	Patient.PatientCode = T.PatientCode
GROUP BY 
	City


"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="city A"
)
