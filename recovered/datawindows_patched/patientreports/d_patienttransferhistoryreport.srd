release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1468 color="536870912" )
summary(height=52 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Name"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=long updatewhereclause=yes name=transfercode dbname="TransferCode"  )
column=(type=datetime updatewhereclause=yes name=transferdate dbname="TransferDate"  )
column=(type=char(122) updatewhereclause=yes name=transferfrom dbname="TransferFrom"  )
column=(type=char(122) updatewhereclause=yes name=transferto dbname="TransferTo"  )
column=(type=char(60) updatewhereclause=yes name=transferby dbname="TransferBy"  )
 retrieve="SELECT
	PatientCode=P.PatientCode,
	RegNo=P.RegNo,
	Name = P.Name,
	AdmissionCode=PA.AdmissionCode,
	TransferCode=T.TransferCode,
	TransferDate=T.Date,
	TransferFrom=(SELECT LTRIM(RTRIM(PL.NAME)) + ', ' + LTRIM(RTRIM(W.Name))
			FROM PatientLocation PL, Ward W
			WHERE PL.LocationCode=T.SourceLocation AND
				PL.WardCode=W.WardCode),
	TransferTo=(SELECT LTRIM(RTRIM(PL.NAME)) + ', ' + LTRIM(RTRIM(W.Name))
			FROM PatientLocation PL, Ward W
			WHERE PL.LocationCode=T.TargetLocation AND
				PL.WardCode=W.WardCode),
	TransferBy=U.UserName
FROM
	PatientTransfer T, 
	PatientAdmission PA,
	Patient P,
	Users U
WHERE
	T.Date BETWEEN :adt_startdate AND :adt_enddate AND
	T.AdmissionCode=PA.AdmissionCode AND
	PA.PatientCode = P.PatientCode AND
	T.Usercode = U.UserCode
ORDER BY
	Name,
	RegNo,
	PA.AdmissionCode,
	T.Date,
	T.TransferCode,
	TransferFrom,
	TransferTo,
	TransferBy
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
)
