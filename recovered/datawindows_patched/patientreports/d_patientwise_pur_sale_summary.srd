table(column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=decimal(8) updatewhereclause=yes name=purchases dbname="purchases"  )
column=(type=decimal(6) updatewhereclause=yes name=sales dbname="Sales"  )
 retrieve="SELECT
	patient = patient.name,
	regno = patient.regno,
	customer  = dbo.accounts.name,	
	purchases = SUM(purchases),
	Sales = SUM(Sales)
FROM
	dbo.customer,
	dbo.accounts,
	dbo.patient,
	(SELECT 
		dbo.saleledger.patientcode, 
		dbo.saleledger.custcode, 
		purchases = SUM(SaleDetail.purunitrate * (saledetail.looseqty + saledetail.bonusqty)),
		Sales = SUM(saledetail.looseqty * (SaleDetail.saleprice - SaleDetail.itemflatdisc) * (1 - saledetail.discperc * 0.01) * (1 - saleledger.discperc * 0.01))
	FROM 
		dbo.saleledger, 
		dbo.saledetail
	WHERE  
		dbo.saleledger.date Between :ad_startdate AND :ad_enddate  AND
		dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		saleledger.patientcode IS NOT NULL
	GROUP BY 	
		dbo.saleledger.patientcode,
		dbo.saleledger.custcode
	UNION ALL
	SELECT 
		pa.patientcode, 
		dbo.saleledger.custcode,
		purchases = SUM(SaleDetail.purunitrate * (saledetail.looseqty + saledetail.bonusqty)),
		Sales = SUM(saledetail.looseqty * (SaleDetail.saleprice - SaleDetail.itemflatdisc) * (1 - saledetail.discperc * 0.01) * (1 - saleledger.discperc * 0.01))
	FROM 
		dbo.saleledger, 
		dbo.saledetail,    
		dbo.patientadmission pa
	WHERE  
		dbo.saleledger.date Between :ad_startdate AND :ad_enddate  AND
		dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		pa.admissioncode = saleledger.admissioncode
	GROUP BY 	
		pa.patientcode,
		dbo.saleledger.custcode) S
WHERE
	S.PatientCode = Patient.PatientCode AND
	S.CustCode = Customer.CustCode AND
	Customer.CustCode = Accounts.AccCode
GROUP BY
	patient.name,
	patient.regno,
	dbo.accounts.name"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime))
 sort="patient A, regno A"
)
