table(column=(type=char(13) updatewhereclause=yes name=doctype dbname="Doctype"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(100) updatewhereclause=yes name=refno1 dbname="Refno1"  )
column=(type=char(100) updatewhereclause=yes name=refno2 dbname="Refno2"  )
column=(type=char(100) updatewhereclause=yes name=refno3 dbname="Refno3"  )
column=(type=char(100) updatewhereclause=yes name=refno4 dbname="Refno4"  )
column=(type=char(100) updatewhereclause=yes name=refno5 dbname="Refno5"  )
column=(type=char(100) updatewhereclause=yes name=refno6 dbname="Refno6"  )
column=(type=char(100) updatewhereclause=yes name=refno7 dbname="Refno7"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(1) updatewhereclause=yes name=type dbname="Type"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=saletypecode dbname="SaleTypeCode"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="ItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(6) updatewhereclause=yes name=value dbname="Value"  )
 retrieve="SELECT
	Doctype = 'SV-' + LTRIM(RTRIM(STR(SL.SALEINVCODE, 10))), 
	PatientCode=SL.PatientCode,
	RegNo = P.RegNo,
	PatientName = P.Name,
	Refno1 = P.RefNo1,
	Refno2 = P.RefNo2,
	Refno3 = P.RefNo3,
	Refno4 = P.RefNo4,
	Refno5 = P.RefNo5,
	Refno6 = P.RefNo6,
	Refno7 = P.RefNo7,
	CustCode = SL.CustCode,
	AliasName = A.AliasName,
	Customer = A.Name,
	Type = 'S',
	InvCode = SL.SaleInvCode,
	Date = SL.Date,
	SaleTypeCode = SL.SaleTypeCode,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	Qty = SUM(SD.LooseQty),
	SalePrice = SD.SalePrice, 
	Discount = SUM( (SD.LooseQty * SD.ItemFlatDisc) + 
		(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01) + 
		((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SL.DiscPerc * 0.01)))),
	Value = SUM((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)))
FROM
	Patient P,
	SaleLedger SL,
	SaleDetail SD,
	Accounts A,
	Item I
WHERE
	P.PatientCode IN (:ai_patientcode) AND
	P.PatientCode = SL.PatientCode AND
	SL.Date BETWEEN :adt_StartDate AND :adt_EndDate AND
	SL.SaleTypeCode IN (:ai_saletypecode) AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.CustCode = A.AccCode AND
	SD.ICode = I.ICode
GROUP BY
	SL.PatientCode,
	P.RegNo,
	P.Name,
	P.RefNo1,
	P.RefNo2,
	P.RefNo3,
	P.RefNo4,
	P.RefNo5,
	P.RefNo6,
	P.RefNo7,
	SL.CustCode,
	A.AliasName,
	A.Name,
	SL.SaleInvCode,
	SL.Date,
	SL.SaleTypeCode,
	I.CustomICode,
	I.Name,
	SD.SalePrice
UNION ALL
SELECT
	Doctype = 'SV-' + LTRIM(RTRIM(STR(SL.SALEINVCODE, 10))), 
	PatientCode=SL.PatientCode,
	RegNo = P.RegNo,
	PatientName = P.Name,
	Refno1 = P.RefNo1,
	Refno2 = P.RefNo2,
	Refno3 = P.RefNo3,
	Refno4 = P.RefNo4,
	Refno5 = P.RefNo5,
	Refno6 = P.RefNo6,
	Refno7 = P.RefNo7,
	CustCode = SL.CustCode,
	AliasName = A.AliasName,
	Customer = A.Name,
	Type = 'S',
	InvCode = SL.SaleInvCode,
	Date = SL.Date,
	SaleTypeCode = SL.SaleTypeCode,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	Qty = SUM(SD.LooseQty),
	SalePrice = SD.SalePrice,
	Discount = SUM( (SD.LooseQty * SD.ItemFlatDisc) + 
		(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (SD.DiscPerc * 0.01) + 
		((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SL.DiscPerc * 0.01)))),
	Value = SUM((SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)))
FROM
	Patient P,
	SaleLedger SL,
	SaleInvDetail SD,
	Accounts A,
	Item I
WHERE
	P.PatientCode IN (:ai_patientcode) AND
	P.PatientCode = SL.PatientCode AND
	SL.Date BETWEEN :adt_StartDate AND :adt_EndDate AND
	SL.SaleTypeCode IN (:ai_saletypecode) AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SL.CustCode = A.AccCode AND
	SD.ICode = I.ICode
GROUP BY
	SL.PatientCode,
	P.RegNo,
	P.Name,
	P.RefNo1,
	P.RefNo2,
	P.RefNo3,
	P.RefNo4,
	P.RefNo5,
	P.RefNo6,
	P.RefNo7,
	SL.CustCode,
	A.AliasName,
	A.Name,
	SL.SaleInvCode,
	SL.Date,
	SL.SaleTypeCode,
	I.CustomICode,
	I.Name,
	SD.SalePrice
UNION ALL
SELECT
	Doctype = 'SR-' + LTRIM(RTRIM(STR(SL.SRINVCODE, 10))), 
	PatientCode=SL.PatientCode,
	RegNo = P.RegNo,
	PatientName = P.Name,
	Refno1 = P.RefNo1,
	Refno2 = P.RefNo2,
	Refno3 = P.RefNo3,
	Refno4 = P.RefNo4,
	Refno5 = P.RefNo5,
	Refno6 = P.RefNo6,
	Refno7 = P.RefNo7,
	CustCode = SL.CustCode,
	AliasName = A.AliasName,
	Customer = A.Name,
	Type = 'R',
	InvCode = SL.SRInvCode,
	Date = SL.Date,
	SaleTypeCode = NULL,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	Qty = - SUM(SD.LooseQty),
	SalePrice = SD.SRPrice,
	Discount = - SUM( (SD.LooseQty * SD.SRPrice * (SD.DiscPerc * 0.01) + 
		((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SL.DiscPerc * 0.01)))),
	Value = - SUM((SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)))
FROM
	Patient P,
	SRLedger SL,
	SRDetail SD,
	Accounts A,
	Item I
WHERE
	P.PatientCode IN (:ai_patientcode) AND
	P.PatientCode = SL.PatientCode AND
	SL.Date BETWEEN :adt_StartDate AND :adt_EndDate AND
	SL.SRInvCode = SD.SRInvCode AND
	SL.CustCode = A.AccCode AND
	SD.ICode = I.ICode
GROUP BY
	SL.PatientCode,
	P.RegNo,
	P.Name,
	P.RefNo1,
	P.RefNo2,
	P.RefNo3,
	P.RefNo4,
	P.RefNo5,
	P.RefNo6,
	P.RefNo7,
	SL.CustCode,
	A.AliasName,
	A.Name,
	SL.SRInvCode,
	SL.Date,
	I.CustomICode,
	I.Name,
	SD.SRPrice
ORDER BY
	PatientName,
	Date,
	InvCode,
	ItemName"
  arguments=(("ai_patientcode", numberlist), ("ai_saletypecode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
)
