table(column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(60) updatewhereclause=yes name=fname dbname="FName"  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=datetime updatewhereclause=yes name=regdon dbname="RegdOn"  )
column=(type=char(25) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(201) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(302) updatewhereclause=yes name=mobileno1 dbname="MobileNo1"  )
column=(type=char(25) updatewhereclause=yes name=nationalidcard dbname="NationalIDCard"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender"  )
column=(type=long updatewhereclause=yes name=age dbname="Age"  )
column=(type=char(60) updatewhereclause=yes name=relation dbname="Relation"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(9) updatewhereclause=yes name=value dbname="Value"  )
column=(type=decimal(9) updatewhereclause=yes name=cost dbname="Cost"  )
 retrieve="SELECT 
	PatientCode = P.PatientCode,
	Patient = P.Name,
	FName = P.FName,
	RegNo = P.RegNo,
	RegdOn = P.Date,
	City = P.City,
	Address = LTRIM(RTRIM(ISNULL(Address1, '') + ' ' + ISNULL(Address2, ''))) ,
	Phone = P.Phone,
	MobileNo1 = LTRIM(RTRIM(ISNULL(MobileNo1, '') + ' ' + ISNULL(MobileNo2, '') + ' ' + ISNULL(MobileNo3, ''))),
	NationalIDCard = P.NationalIDCard,
	Gender = P.Gender,
	Age = P.AgeYears,
	Relation = R.Name,
/*	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = P.DoctCode),*/
	ICode=D.ICode, 
	ItemCode=I.CustomICode,
	ItemName=I.Name, 
/*	SaleInvCode=S.SaleInvCode,*/
	Date = MAX(S.Date),
	Qty = SUM(D.LooseQty),
	Rate = SUM((D.SalePrice - D.ItemFlatDisc) * (1 - S.DiscPerc * 0.01)),
	Value = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - S.DiscPerc * 0.01)),
	Cost = SUM(D.LooseQty * D.AvgPrice)
/*	RowID=MAX(D.RowID),*/
/*	InvTotal = S.InvTotal*/
FROM
	Patient P,
	Relation R,
	SaleLedger S, 
	SaleDetail D, 
	Item I
WHERE
	S.Date BETWEEN :ad_startdate AND:ad_enddate AND
	S.PatientCode=P.PatientCode AND
	P.RelationCode = R.RelationCode AND
	S.SaleInvCode=D.SaleInvCode AND
	D.ICode=I.ICode
GROUP BY 
	P.PatientCode,
	P.Name,
	P.FName,
	P.RegNo,
	P.Date,
	P.City,
	P.Address1,
	P.Address2,
	P.Phone,
	P.MobileNo1,
	P.MobileNo2,
	P.MobileNo3,
	P.NationalIDCard,
	P.Gender,
	P.AgeYears,
	R.Name,
	P.DoctCode,
	D.ICode, 
	I.CustomICode,
	I.Name
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="regno A, patient A, itemname A, qty A"
)
