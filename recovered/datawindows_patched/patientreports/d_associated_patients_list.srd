release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=480 color="536870912" )
summary(height=84 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=patientcode dbname="Patient.PatientCode"  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="Patient.RegNo"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="Patient.Name"  )
column=(type=char(60) update=yes updatewhereclause=yes name=fname dbname="Patient.FName"  )
column=(type=char(100) update=yes updatewhereclause=yes name=mothername dbname="Patient.MotherName"  )
column=(type=char(1) update=yes updatewhereclause=yes name=gender dbname="Patient.Gender"  )
column=(type=datetime update=yes updatewhereclause=yes name=dob dbname="Patient.DOB"  )
column=(type=long update=yes updatewhereclause=yes name=custcode dbname="Patient.CustCode"  )
column=(type=long update=yes updatewhereclause=yes name=relationcode dbname="Patient.RelationCode" 
 values=""  )
column=(type=char(60) update=yes updatewhereclause=yes name=principalpatient dbname="PrincipalPatient"  )
column=(type=long update=yes updatewhereclause=yes name=principal dbname="Principal"  )
 retrieve="SELECT 
	PatientCode, 
	RegNo,
	Name,
	FName,
	MotherName,
	Gender,
	DOB,
	CustCode,
	RelationCode,
	PrincipalPatient = Name,
	Principal = 0
FROM Patient 
WHERE PatientCode IN (SELECT ISNULL(P.PrincipalPatient,P.PatientCode) FROM Patient P WHERE PatientCode = :ai_code)
UNION ALL
SELECT 
	PatientCode, 
	RegNo,
	Name,
	FName,
	MotherName,
	Gender,
	DOB,
	CustCode,
	RelationCode,
	PrincipalPatient = (SELECT P.Name FROM Patient P WHERE P.PatientCode = Patient.PrincipalPatient),
	Principal = 1
FROM Patient 
WHERE PrincipalPatient IS NOT NULL AND PrincipalPatient IN (SELECT ISNULL(P.PrincipalPatient,P.PatientCode) FROM Patient P WHERE PatientCode = :ai_code)
ORDER BY Principal, Name, FName"
  update="Patient" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
