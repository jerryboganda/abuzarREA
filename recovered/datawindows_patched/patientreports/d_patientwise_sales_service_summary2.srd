table(column=(type=datetime updatewhereclause=yes name=admissiondate dbname="admissiondate"  )
column=(type=char(20) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(20) updatewhereclause=yes name=patientname dbname="patientname"  )
column=(type=char(20) updatewhereclause=yes name=surgeon dbname="surgeon"  )
column=(type=char(20) updatewhereclause=yes name=treatment dbname="treatment"  )
column=(type=char(20) updatewhereclause=yes name=claimrefno dbname="claimrefno"  )
column=(type=decimal(0) updatewhereclause=yes name=treatmentfee dbname="treatmentfee"  )
column=(type=decimal(0) updatewhereclause=yes name=transportcharges dbname="transportcharges"  )
column=(type=decimal(0) updatewhereclause=yes name=taxableamount dbname="taxableamount"  )
column=(type=decimal(0) updatewhereclause=yes name=taxamount dbname="taxamount"  )
column=(type=decimal(0) updatewhereclause=yes name=grossamount dbname="grossamount"  )
column=(type=decimal(0) updatewhereclause=yes name=amount dbname="amount"  )
 retrieve="SELECT
	PatientCode=P.PatientCode,
	AdmissionDate = AP.Date,
	RegNo = P.RegNo,
	PatientName = P.Name,
	Surgeon = (SELECT D.Name FROM Doctors D WHERE D.DoctCode=AP.DoctorCode),
	Treatment = (SELECT S.Name FROM Service S WHERE S.ServiceCode=AP.ProcedureRequired),
	ClaimRefNo = MAX(AP.Ref1),
	TreatmentFee = MAX(AP.ProcedureCharges),
	TransportCharges = MAX(AP.TransportCharges),
	TaxableAmount = MAX(AP.ProcedureCharges - AP.TransportCharges),
	TaxAmount = MAX((AP.ProcedureCharges - AP.TransportCharges) * AP.ProcedureGSTPerc * 0.01),
	GrossAmount = MAX((AP.ProcedureCharges - AP.TransportCharges) * (1 - AP.ProcedureGSTPerc * 0.01)),
	ItemType = T.ItemType,
	Amount = SUM(T.ItemValue + T.Others)
FROM	
	Patient P,
	PatientAdmission AP, 
	PatientCategory PC,
	(SELECT  
		SummaryGroup=0,  
		RowGroup=1, 
		ItemType=' MEDICINE',
		S.AdmissionCode,
		PatientCode = ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)),
		ItemValue=SUM(S.InvTotal),
		Others= 0.00
	FROM 
		SaleLedger S
	WHERE
		( ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)) > 0 ) AND 
		(S.Date BETWEEN :adt_startdate AND :adt_enddate)
	GROUP  BY
		S.PatientCode,
		S.AdmissionCode,
		S.SaleCatCode,
		S.CustCode
	UNION ALL
	SELECT  
		SummaryGroup=0,  
		RowGroup=3,
		ItemType=' MEDICINE',
		S.AdmissionCode,
		PatientCode = ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)),
		ItemValue= - SUM(S.InvTotal),
		Others= 0.00
	FROM
		SRLedger S
	WHERE   
		( ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)) > 0 ) AND 
		S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP BY 
		S.PatientCode,
		S.AdmissionCode,
		S.SRInvCode,
		S.SRCatCode,
		S.CustCode
	UNION ALL
	SELECT 
		SummaryGroup=0,  
		RowGroup=5,
		ItemType=(SELECT SC.Name FROM ServiceCategory SC WHERE SC.ServiceCatCode=SV.ServiceCatCode),
		S.AdmissionCode,
		PatientCode = ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)),
		ItemValue=SUM(D.Qty * (D.Price - D.ServiceFlatDisc) * (1 - (0.01 * D.discperc)) * (1-(0.01 * S.discperc))),
		Others= 0.00
	FROM 
		ServiceHeader S,
		Servicedetail D,
		Service SV
	WHERE
		( ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)) > 0 ) and  
		( S.ServiceInvCode = D.ServiceInvCode ) and
		( D.ServiceCode = SV.Servicecode ) AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP  BY
		S.PatientCode,
		S.AdmissionCode,
		S.ServiceInvCode,
		SV.ServiceCatCode,
		S.ServiceCatCode,
		S.CustCode
	UNION ALL
	SELECT 
		SummaryGroup=0,  
		RowGroup=6.1,
		ItemType=(SELECT SC.Name FROM ServiceCategory SC WHERE SC.ServiceCatCode=SV.ServiceCatCode),
		S.AdmissionCode,
		PatientCode = ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)),
		ItemValue=-1 * SUM(D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1 - (0.01 * D.discperc)) * (1 - (0.01 * S.discperc))),
		Others= 0.00
	FROM 
		ServiceRHeader S,
		ServiceRdetail D,
		Service SV
	WHERE
		( ISNULL(S.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=S.AdmissionCode)) > 0 ) AND
		( S.ServiceRInvCode = D.ServiceRInvCode ) and
		( D.ServiceCode = SV.Servicecode ) AND
		S.Date BETWEEN :adt_startdate AND :adt_enddate
	GROUP  BY
		S.PatientCode,
		S.AdmissionCode,
		S.ServiceRInvCode,
		SV.ServiceCatCode,
		S.ServiceRCatCode,
		S.CustCode
	UNION ALL
	SELECT 
		SummaryGroup=0,  
		RowGroup=7,
		ItemType=(SELECT SC.Name FROM ServiceCategory SC WHERE SC.ServiceCatCode=SV.ServiceCatCode),
		OS.AdmissionCode,
		PatientCode = ISNULL(OS.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=OS.AdmissionCode)),
		ItemValue=SUM(D.Qty * (D.Price - D.ServiceFlatDisc) * (1 - (0.01 * D.discperc)) * (1-(0.01 * S.discperc))),
		Others= 0.00
	FROM 
		ServicePurHeader S,
		ServicePurDetail D,
		Service SV,
		ServiceHeader OS,
		ServiceCategory SC
	WHERE
		( S.Date BETWEEN :adt_startdate AND :adt_enddate ) AND
		( S.ServicePurInvCode = D.ServicePurInvCode ) and
		( D.ServiceCode = SV.Servicecode ) AND
		( SV.ServiceCatCode = SC.ServiceCatCode) AND
		( S.ServiceInvCode = OS.ServiceInvCode ) AND
		( ISNULL(OS.PatientCode, (SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.Admissioncode=OS.AdmissionCode)) > 0 ) AND
		( LEFT(Upper(sc.description),5)='SHARE')
	GROUP  BY
		OS.PatientCode,
		OS.AdmissionCode,
		S.SuppCode,
		S.ServiceInvCode,
		SV.ServiceCatCode,
		OS.CustCode		
		) T
WHERE
	P.PatientCode=T.PatientCode AND
	P.PatientCatCode = PC.PatientCatCode AND
	P.PatientCode = AP.PatientCode AND
	AP.PatientCode = T.PatientCode AND
	AP.AdmissionCode = T.AdmissionCode
GROUP BY
	P.PatientCode,
	AP.Date,
	P.RegNo,
	P.Name,
	AP.DoctorCode,
	AP.ProcedureRequired,
	T.ItemType"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="admissiondate A, regno A, patientname A, surgeon A, treatment A, claimrefno A, treatmentfee A, transportcharges A, taxableamount A, taxamount A, grossamount A"
)
