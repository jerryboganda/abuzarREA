table(column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="name"  )
column=(type=char(60) updatewhereclause=no name=patientcategory dbname="PatientCategory"  )
column=(type=char(60) updatewhereclause=no name=customer dbname="Customer"  )
column=(type=char(30) updatewhereclause=no name=customercategory dbname="CustomerCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=openingbalance dbname="OpeningBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=netsales dbname="NetSales"  )
column=(type=decimal(2) updatewhereclause=yes name=salereceipts dbname="SaleReceipts"  )
column=(type=decimal(2) updatewhereclause=yes name=otherdebits dbname="OtherDebits"  )
column=(type=decimal(2) updatewhereclause=yes name=othercredit dbname="OtherCredit"  )
column=(type=decimal(2) updatewhereclause=yes name=closingbalance dbname="ClosingBalance"  )
 retrieve="SELECT
	PatientCode=P.PatientCode,
	RegNo=P.RegNo,
	name=P.name,
	PatientCategory = (SELECT PC.Name FROM PatientCategory PC WHERE PC.PatientCatCode=P.PatientCatCode),
	Customer = (SELECT Accounts.Name FROM Accounts WHERE C.CustCode = Accounts.AccCode),
	CustomerCategory = (SELECT CustomerCategory.Name FROM CustomerCategory WHERE CustomerCategory.CustCatCode = C.CustCatCode),
	OpeningBalance = (SELECT Balance=ISNULL(SUM(VV.Debit - VV.Credit),0)
		FROM	VirtualGL VV
		WHERE 	VV.PatientCode = P.PatientCode AND
			VV.AccCode > 100 AND VV.Date < :ad_startdate),
	NetSales = ISNULL(SUM(CASE WHEN V.DocumentType IN ('SV','RS') THEN V.Debit WHEN V.DocumentType IN ('SR','RR') THEN - (Credit)  ELSE 0 END), 0),
	SaleReceipts = ISNULL(SUM(CASE WHEN V.DocumentType IN ('SV','RS') THEN V.Credit WHEN V.DocumentType IN ('SR','RR') THEN - (Debit) ELSE 0 END), 0),
	OtherDebits = ISNULL(SUM(CASE WHEN V.DocumentType NOT IN ('SV','RS','SR','RR') THEN V.Debit ELSE 0 END), 0),
	OtherCredit = ISNULL(SUM(CASE WHEN V.DocumentType NOT IN ('SV','RS','SR','RR') THEN V.Credit ELSE 0 END), 0),
	ClosingBalance = (SELECT Balance=ISNULL(SUM(VV.Debit - VV.Credit),0)
		FROM	VirtualGL VV
		WHERE 	VV.AccCode > 100 AND VV.PatientCode = P.PatientCode AND
			VV.Date <= :ad_enddate)
FROM
	VirtualGL V, 
	Patient P, 
	Customer C
WHERE
	V.PatientCode = P.PatientCode AND 
	V.AccCode = C.CustCode AND
	V.date BETWEEN :ad_startdate AND :ad_enddate
GROUP BY
	P.RegNo, P.Name, P.PatientCode, P.PatientCatCode, C.CustCode, C.CustCatCode
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="customercategory A, customer A, regno A, name A, patientcategory A"
)
