release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=792 color="536870912" )
summary(height=112 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="regno"  )
column=(type=char(25) updatewhereclause=yes name=patientcnic dbname="patientcnic"  )
column=(type=char(100) updatewhereclause=yes name=patientadd1 dbname="patientadd1"  )
column=(type=char(100) updatewhereclause=yes name=patientadd2 dbname="patientadd2"  )
column=(type=char(60) updatewhereclause=yes name=doctnamee dbname="doctnamee"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=char(60) updatewhereclause=yes name=saletype dbname="saletype"  )
 retrieve=" SELECT patient = (SELECT name FROM patient WHERE patientcode = :ai_patientcode ),
		 regno = (SELECT regno FROM patient WHERE patientcode = :ai_patientcode ),
		 patientcnic = (SELECT nationalidcard FROM patient WHERE patientcode = :ai_patientcode ),
		 patientadd1= (SELECT address1 FROM patient WHERE patientcode = :ai_patientcode ),
		patientadd2= (SELECT address2 FROM patient WHERE patientcode = :ai_patientcode ),
	    doctnamee=(select doctors.name from doctors,patient where patient.patientcode=:ai_patientcode and doctors.doctcode=patient.doctcode),
		 a.itemname,
		 qty =  ISNULL(SUM (CASE type When 'S' THEN ISNULL(Looseqty,0) END) , 0 ) ,
		 amount = ISNULL(SUM (CASE type When 'S' THEN ISNULL(Amount,0)  END),  0 ) ,
		saletype=(select name from saletype where saletype.saletypecode=:al_saletypecode)
		
FROM
(
SELECT 
		 type = 'S' ,
       looseqty=saledetail.looseqty,
       amount=( ( saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc)) * (1 - (.01 * saledetail.discperc))) * (1- (.01 * saleledger.discperc)),
       itemname=item.name

FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item 

WHERE  dbo.saleledger.date >= :ad_startdate AND
		 dbo.saleledger.date <= :ad_enddate  AND
		 dbo.saleledger.saletypecode=:al_saletypecode AND
		 dbo.saleledger.patientcode = :ai_patientcode AND
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND  
		 dbo.saledetail.icode = item.icode 



) AS A

GROUP BY itemname"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ai_patientcode", number), ("al_saletypecode", number))
)
