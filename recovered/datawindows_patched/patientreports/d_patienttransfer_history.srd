release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=204 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=transfercode dbname="TransferCode"  )
column=(type=datetime updatewhereclause=yes name=transferdate dbname="TransferDate"  )
column=(type=char(122) updatewhereclause=yes name=transferfrom dbname="TransferFrom"  )
column=(type=char(122) updatewhereclause=yes name=transferto dbname="TransferTo"  )
column=(type=char(60) updatewhereclause=yes name=transferby dbname="TransferBy"  )
 retrieve="SELECT
	TransferCode=T.TransferCode,
	TransferDate=T.Date,
	TransferFrom=(SELECT LTRIM(RTRIM(PL.NAME)) + ', ' + LTRIM(RTRIM(W.Name))
			FROM PatientLocation PL, Ward W
			WHERE PL.LocationCode=T.SourceLocation AND
				PL.WardCode=W.WardCode),
	TransferTo=(SELECT LTRIM(RTRIM(PL.NAME)) + ', ' + LTRIM(RTRIM(W.Name))
			FROM PatientLocation PL, Ward W
			WHERE PL.LocationCode=T.TargetLocation AND
				PL.WardCode=W.WardCode),
	TransferBy=U.UserName
FROM
	PatientTransfer T, 
	Users U
WHERE
	T.AdmissionCode = :Code And
	T.Usercode = U.UserCode
ORDER BY
	T.TransferCode DESC,
	T.Date,
	TransferFrom,
	TransferTo,
	TransferBy"
  arguments=(("code", number))
)
