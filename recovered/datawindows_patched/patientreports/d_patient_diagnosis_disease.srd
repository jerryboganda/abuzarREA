release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1666 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(60) updatewhereclause=yes name=disease dbname="Disease"  )
column=(type=char(100) updatewhereclause=yes name=diagnosis dbname="Diagnosis"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
 retrieve="SELECT DISTINCT
	PatientCode=P.PatientCode, 
	RegNo=P.Regno, 
	PatientName=P.Name, 
	Disease = D.Name,
	Diagnosis=P.Diagnosis,
	Doctor = (SELECT DC.Name FROM Doctors DC WHERE DC.DoctCode = P.DoctCode),
	Date = S.Date
FROM 
	Patient P
	LEFT OUTER JOIN Disease AS D ON (P.DiseaseCode = D.DiseaseCode),
	SaleLedger S
WHERE
	S.Date >= :ad_startdate AND S.Date <= :ad_enddate AND
	P.PatientCode = S.PatientCode AND
	(P.DiseaseCode IS NOT NULL OR P.DiagNosis IS NOT NULL)
ORDER BY
	Date,
	PatientName
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="date A, patientname A"
)
