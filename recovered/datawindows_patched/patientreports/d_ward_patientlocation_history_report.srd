header(height=1354 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=wardname dbname="WardName"  )
column=(type=long updatewhereclause=yes name=patientlocation_locationcode dbname="LocationCode"  )
column=(type=char(122) updatewhereclause=yes name=locationname dbname="LocationName"  )
column=(type=long updatewhereclause=yes name=transfercode dbname="TransferCode"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(3) updatewhereclause=yes name=type dbname="Type"  )
column=(type=long updatewhereclause=yes name=sourcelocation dbname="SourceLocation"  )
column=(type=long updatewhereclause=yes name=targetlocation dbname="TargetLocation"  )
column=(type=char(10) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(60) updatewhereclause=yes name=diseasename dbname="DiseaseName"  )
column=(type=char(60) updatewhereclause=yes name=doctorname dbname="DoctorName"  )
 retrieve="SELECT
	WardName = W.Name,
	LocationCode=PL.LocationCode,
	LocationName=PL.Name + ', ' + W.Name,
	TransferCode=NULL, 
	AdmissionCode=PA.AdmissionCode,
	RegNo=P.RegNo,
	PatientName=P.Name,
	Date=PA.Date,
	Type = 'IN',
	SourceLocation=NULL,
	TargetLocation=PA.LocationCode,
	Remarks='Admission',
	DiseaseName = (SELECT D.Name FROM Disease D WHERE D.DiseaseCode = PA.DiseaseCode),
	DoctorName = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = PA.DoctorCode)
FROM 
	PatientAdmission PA, Patient P, Patientlocation PL, Ward W
WHERE 
	PA.Date BETWEEN :adt_startdate AND :adt_enddate AND
	W.WardCode IN (:ai_wardcode) AND
	PL.WardCode=W.WardCode AND
	PA.LocationCode = PL.LocationCode AND
	PA.PatientCode=P.PatientCode
UNION ALL
SELECT 
	WardName = W.Name,
	LocationCode=PL.LocationCode,
	LocationName=PL.Name + ', ' + W.Name,
	TransferCode=PT.TransferCode,
	AdmissionCode=PT.AdmissionCode,
	RegNo=P.RegNo,
	PatientName=P.Name,
	PT.Date,
	Type = 'IN',
	SourceLocation=PT.SourceLocation,
	TargetLocation=PT.TargetLocation,
	Remarks='Transfer',
	DiseaseName = (SELECT D.Name FROM Disease D WHERE D.DiseaseCode = PA.DiseaseCode),
	DoctorName = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = PA.DoctorCode)
FROM 
	PatientTransfer PT, PatientAdmission PA, Patient P, Patientlocation PL, Ward W
WHERE 
	PT.Date BETWEEN :adt_startdate AND :adt_enddate AND
	W.WardCode IN (:ai_wardcode) AND
	PL.WardCode=W.WardCode AND
	PT.TargetLocation = PL.LocationCode AND
	PA.AdmissionCode=PT.AdmissionCode AND
	PA.PatientCode=P.PatientCode
UNION ALL
SELECT 
	WardName = W.Name,
	LocationCode=PL.LocationCode,
	LocationName=PL.Name + ', ' + W.Name,
	TransferCode=PT.TransferCode,
	AdmissionCode=PT.AdmissionCode,
	RegNo=P.RegNo,
	PatientName=P.Name,
	PT.Date,
	Type = 'OUT',
	SourceLocation=PT.SourceLocation,
	TargetLocation=PT.TargetLocation,
	Remarks='Transfer',
	DiseaseName = (SELECT D.Name FROM Disease D WHERE D.DiseaseCode = PA.DiseaseCode),
	DoctorName = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = PA.DoctorCode)
FROM 
	PatientTransfer PT, PatientAdmission PA, Patient P, Patientlocation PL, Ward W
WHERE 
	PT.Date BETWEEN :adt_startdate AND :adt_enddate AND
	W.WardCode IN (:ai_wardcode) AND
	PL.WardCode=W.WardCode AND
	PT.SourceLocation = PL.LocationCode AND
	PA.AdmissionCode=PT.AdmissionCode AND
	PA.PatientCode=P.PatientCode
UNION ALL
SELECT 
	WardName = W.Name,
	LocationCode=PL.LocationCode,
	LocationName=PL.Name + ', ' + W.Name,
	TransferCode=NULL,
	AdmissionCode=PA.AdmissionCode,
	RegNo=P.RegNo,
	PatientName=P.Name,
	Date=PA.DischargedOn,
	Type = 'OUT',
	SourceLocation=PA.LocationCode,
	TargetLocation=NULL,
	Remarks='Discharged',
	DiseaseName = (SELECT D.Name FROM Disease D WHERE D.DiseaseCode = PA.DiseaseCode),
	DoctorName = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = PA.DoctorCode)
FROM 
	PatientAdmission PA, Patient P, Patientlocation PL, Ward W
WHERE 
	PA.DischargedOn BETWEEN :adt_startdate AND :adt_enddate AND
	W.WardCode IN (:ai_wardcode) AND
	PL.WardCode=W.WardCode AND
	PA.LocationCode = PL.LocationCode AND
	PA.PatientCode=P.PatientCode
"
  arguments=(("ai_wardcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="wardname A, locationname A, date A, admissioncode A, sourcelocation A, targetlocation A"
)
