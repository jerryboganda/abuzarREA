release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=906 color="536870912" )
summary(height=697 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(12) updatewhereclause=yes name=customeraliasname dbname="CustomerAliasName"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(75) updatewhereclause=yes name=itemaliasname dbname="ItemAliasName"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="Amount"  )
 retrieve="SELECT
	Date = S.Date,
	SaleInvCode = S.SaleInvCode,
	CustCode = S.CustCode,
	CustomerName = A.Name,
	CustomerAliasName = A.AliasName,
	PatientCode = S.PatientCode,
	PatientName = P.Name,
	PatientRegNo = P.RegNo,
	ItemCode = D.ICode,
	ItemName = I.Name,
	ItemAliasName = I.CustomICode,
	SalePrice = MAX(D.SalePrice),
	Qty = SUM(D.LooseQty),
	Amount = SUM(D.LooseQty * D.SalePrice)
FROM 
	Patient P,
	Customer C,	
	Accounts A,
	SaleLedger S,
	SaleDetail D,
	Item I
WHERE
	S.Date BETWEEN :ad_startdate AND :ad_enddate AND
	S.PatientCode IN (:ai_patientcode) AND
	S.PatientCode = P.PatientCode AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	S.SaleInvCode = D.SaleInvCode AND
	D.ICode = I.ICode 
GROUP BY
	S.Date,
	S.SaleInvCode,
	S.CustCode,
	A.Name,
	A.AliasName,
	S.PatientCode,
	P.Name,
	P.RegNo,
	D.ICode,
	I.Name,
	I.CustomICode
ORDER BY
	CustomerName,
	PatientName,
	Date,
	ItemName"
  arguments=(("ai_patientcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime), ("ad_discperc", number))
 sort="customername A, patientname A, date A, itemname A"
)
