table(column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(12) updatewhereclause=yes name=customeraliasname dbname="CustomerAliasName"  )
column=(type=char(60) updatewhereclause=yes name=saletype dbname="SaleType"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="Regno"  )
column=(type=char(60) updatewhereclause=yes name=employeename dbname="EmployeeName"  )
column=(type=char(60) updatewhereclause=yes name=designation dbname="Designation"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="DAte"  )
column=(type=long updatewhereclause=yes name=saletypecode dbname="SaleTypeCode"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(9) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=decimal(6) updatewhereclause=yes name=tax dbname="Tax"  )
column=(type=decimal(2) updatewhereclause=yes name=fbrposfee dbname="FBRPosFee"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="FlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="MiscCharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve="SELECT 
	CustomerName = A.Name,
	CustomerAliasName = A.AliasName,
	SaleType = (SELECT ST.Name FROM SaleType ST WHERE ST.SaleTypeCode = :ai_SaleTypeCode),
	PatientCode=P.PatientCode,
	Regno=P.RegNo,
	EmployeeName = P.Name,
	Designation = (SELECT R.Name FROM Rank R WHERE P.RankCode = R.RankCode),
	CustCode=S.CustCode,
	DAte=S.Date,
	SaleTypeCode=S.SaleTypeCode,
	SaleInvCode=S.SaleInvCode,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	Qty = SUM(D.LooseQty),
	Amount = SUM(D.LooseQty * (D.SalePrice - S.FlatDisc) * (1 - D.Discperc * 0.01)),
	Tax = SUM(Round((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.Discperc * 0.01) * D.GSTPerc * 0.01), 2) + 
		((D.LooseQty + D.BonusQty) * D.UnitSalesTax)),
	FBRPosFee = S.FBRPosFee,
	FlatDisc = S.FlatDisc,
	MiscCharges = S.MiscCharges - CASE WHEN S.FBRPosFee > 0 THEN S.FBRPosFee ELSE 0 END,
	InvTotal = S.InvTotal
FROM
	Customer C,
	Accounts A,
	Patient P,
	SaleLedger S,
	SaleDetail D,
	Item I
WHERE		
	S.PatientCode = CASE WHEN :ai_allpatients = 0 THEN :ai_patientcode ELSE P.PatientCode END AND
	S.SaleTypeCode = :ai_SaleTypeCode AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.SaleInvCode = D.SaleInvCode AND
	D.ICode = I.ICode AND
	S.PatientCode = P.PatientCode AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode
GROUP BY
	S.CustCode,
	A.Name,
	A.AliasName,
	P.PatientCode,
	P.RegNo,
	P.Name,
	P.RankCode,
	S.Date,
	S.SaleTypeCode,
	S.SaleInvCode,
	S.FBRPosFee,
	S.FlatDisc,
	S.MiscCharges,
	S.InvTotal,
	I.CustomICode,
	I.Name
UNION ALL
SELECT 
	CustomerName = A.Name,
	CustomerAliasName = A.AliasName,
	SaleType = NULL,
	PatientCode=P.PatientCode,
	Regno=P.RegNo,
	EmployeeName = P.Name,
	Designation = (SELECT R.Name FROM Rank R WHERE P.RankCode = R.RankCode),
	CustCode=C.CustCode,
	DAte=Date,
	SaleTypeCode=NULL,
	SaleInvCode=NULL,
	AliasName = NULL,
	ItemName = NULL,
	Qty = NULL,
	Amount = NULL,
	Tax = NULL,
	FBRPosFee = 0.00,
	FlatDisc = 0.00,
	MiscCharges = 0.00,
	InvTotal = 0.00
FROM
	Customer C,
	Accounts A,
	Patient P
WHERE		
	P.PatientCode = CASE WHEN :ai_allpatients = 0 THEN :ai_patientcode ELSE P.PatientCode END AND
	P.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	P.PatientCode NOT IN 
		(SELECT DISTINCT S.PatientCode 
		FROM SaleLedger S
		WHERE	
			S.PatientCode = CASE WHEN :ai_allpatients = 0 THEN :ai_patientcode ELSE P.PatientCode END AND
			S.SaleTypeCode = :ai_SaleTypeCode AND
			S.Date BETWEEN :adt_startdate AND :adt_enddate)
"
  arguments=(("ai_patientcode", number), ("ai_allpatients", number), ("ai_saletypecode", number), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="customername A, saleinvcode A, saletype A, employeename A, itemname A, qty A"
)
