release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2033 color="536870912" )
summary(height=416 color="536870912" )
footer(height=0 color="536870912" )
detail(height=200 color="536870912" )
table(column=(type=long updatewhereclause=yes name=rowgroup dbname="RowGroup"  )
column=(type=char(8) updatewhereclause=yes name=itemtype dbname="ItemType"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=long updatewhereclause=yes name=admissioncode dbname="AdmissionCode"  )
column=(type=datetime updatewhereclause=yes name=admittedon dbname="AdmittedOn"  )
column=(type=char(60) updatewhereclause=yes name=admittedby dbname="AdmittedBy"  )
column=(type=datetime updatewhereclause=yes name=dischargedon dbname="DischargedOn"  )
column=(type=char(60) updatewhereclause=yes name=dischargedby dbname="DischargedBy"  )
column=(type=char(1) updatewhereclause=yes name=discharged dbname="PatientAdmission.Discharged"  )
column=(type=long updatewhereclause=yes name=invcode dbname="InvCode"  )
column=(type=datetime updatewhereclause=yes name=invdate dbname="InvDate"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(100) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(20) updatewhereclause=yes name=type dbname="Type"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(10) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(2) updatewhereclause=yes name=value dbname="Value"  )
 retrieve="SELECT 
	RowGroup=1,
	ItemType='MEDICINE',
	RegNo = P.RegNo,
	Patient=P.Name,  
	AdmissionCode=SL.AdmissionCode,
	AdmittedOn=PA.Date,
	AdmittedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.UserCode),
	DischargedOn=PA.DischargedOn,
	DischargedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.DischargedBy),
	PA.Discharged,
	InvCode=SL.SaleInvCode,
	InvDate=SL.Date,
	AliasName= I.CustomICode,
	Item=I.Name,
	Type='SL',
	Qty  = SUM(SD.looseQty),
	Rate = (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01),
	Value= Round(SUM(SD.looseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)), 2)
FROM 
	Patient P,
	PatientAdmission PA,
	Saledetail SD,
	SaleLedger SL,
	Item I
WHERE
	( PA.AdmissionCode = :ar_admissioncode ) AND
	( PA.PatientCode = P.PatientCode ) and  
	( SL.AdmissionCode = PA.AdmissionCode ) and  
	( SL.SaleInvCode = SD.SaleInvCode ) and
	( SD.ICode = I.Icode )
GROUP  BY
	P.RegNo,
	P.Name,
	SL.AdmissionCode,
	PA.Date,
	PA.UserCode,
	PA.DischargedOn,
	PA.DischargedBy,
	PA.Discharged,
	SL.SaleInvCode,
	SL.Date,
	I.CustomICode,
	I.Name,
	SD.SalePrice,
	SD.ItemFlatDisc,
	SD.DiscPerc,
	SL.DiscPerc
UNION ALL
SELECT 
	RowGroup=2,
	ItemType='MEDICINE',
	RegNo = P.RegNo,
	Patient=P.Name,
	AdmissionCode=SL.AdmissionCode,
	AdmittedOn=PA.Date,
	AdmittedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.UserCode),
	DischargedOn=PA.DischargedOn,
	DischargedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.DischargedBy),
	PA.Discharged,
	InvCode=SL.SRInvCode,
	InvDate=SL.Date,
	AliasName= I.CustomICode,
	Item=I.Name,
	Type='SR',
	Qty  = - SUM(SD.looseQty),
	Rate = SD.SRPrice * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01),
	Value= - Round(SUM(SD.looseQty * (SD.SRPrice) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)), 2)
FROM 
	Patient P,
	PatientAdmission PA,
	SRDetail SD,
	SRLedger SL,
	Item I
WHERE
	( PA.AdmissionCode = :ar_admissioncode ) AND
	( PA.PatientCode = P.PatientCode ) and  
	( SL.AdmissionCode = PA.AdmissionCode ) and  
	( SL.SRInvCode = SD.SRInvCode ) and
	( SD.ICode = I.Icode )
GROUP  BY
	P.RegNo,
	P.Name,
	SL.AdmissionCode,
	PA.Date,
	PA.UserCode,
	PA.DischargedOn,
	PA.DischargedBy,
	PA.Discharged,
	SL.SRInvCode,
	SL.Date,
	I.CustomICode,
	I.Name,
	SD.SRPrice,
	SD.DiscPerc,
	SL.DiscPerc
UNION ALL
SELECT 
	RowGroup=3,
	ItemType='SERVICES',
	RegNo = P.RegNo,
	Patient=P.Name,
	AdmissionCode=SL.AdmissionCode,
	AdmittedOn=PA.Date,
	AdmittedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.UserCode),
	DischargedOn=PA.DischargedOn,
	DischargedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.DischargedBy),
	PA.Discharged,
	InvCode=SL.ServiceInvCode,
	InvDate=SL.Date,
	AliasName= '',
	Item=S.Name,
	Type='SV',
	Qty  = SUM(SD.Qty),
	Rate = (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01),
	Value= Round(SUM(SD.Qty * (SD.Price - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)), 2)
FROM 
	Patient P,
	PatientAdmission PA,
	Servicedetail SD,
	ServiceHeader SL,
	Service S
WHERE
	( PA.AdmissionCode = :ar_admissioncode ) AND
	( PA.PatientCode = P.PatientCode ) and  
	( SL.AdmissionCode = PA.AdmissionCode ) and  
	( SL.ServiceInvCode = SD.ServiceInvCode ) and
	( SD.ServiceCode = S.Servicecode )
GROUP  BY
	P.RegNo,
	P.Name,
	SL.AdmissionCode,
	PA.Date,
	PA.UserCode,
	PA.DischargedOn,
	PA.DischargedBy,
	PA.Discharged,
	SL.ServiceInvCode,
	SL.Date,
	S.Name,
	SD.Price,
	SD.ServiceFlatDisc, 
	SD.DiscPerc,
	SL.DiscPerc
UNION ALL
SELECT 
	RowGroup=4,
	ItemType='SERVICES',
	RegNo = P.RegNo,
	Patient=P.Name,
	AdmissionCode=SL.AdmissionCode,
	AdmittedOn=PA.Date,
	AdmittedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.UserCode),
	DischargedOn=PA.DischargedOn,
	DischargedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.DischargedBy),
	PA.Discharged,
	InvCode=SL.ServiceRInvCode,
	InvDate=SL.Date,
	AliasName= '',
	Item=S.Name,
	Type='RS',
	Qty  = - SUM(SD.Qty),
	Rate = (SD.ServicePrice - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01),
	Value= - Round(SUM(SD.Qty * (SD.ServicePrice - SD.ServiceFlatDisc) * (1 - SD.DiscPerc * .01) * (1 - SL.DiscPerc * .01)), 2)
FROM 
	Patient P,
	PatientAdmission PA,
	ServiceRDetail SD,
	ServiceRHeader SL,
	Service S
WHERE
	( PA.AdmissionCode = :ar_admissioncode ) AND
	( PA.PatientCode = P.PatientCode ) and  
	( SL.AdmissionCode = PA.AdmissionCode ) and  
	( SL.ServiceRInvCode = SD.ServiceRInvCode ) and
	( SD.ServiceCode = S.Servicecode )
GROUP  BY
	P.RegNo,
	P.Name,
	SL.AdmissionCode,
	PA.Date,
	PA.UserCode,
	PA.DischargedOn,
	PA.DischargedBy,
	PA.Discharged,
	SL.ServiceRInvCode,
	SL.Date,
	S.Name,
	SD.ServicePrice,
	SD.ServiceFlatDisc, 
	SD.DiscPerc,
	SL.DiscPerc
UNION ALL
SELECT 
	RowGroup=5,
	ItemType='OTHERS',
	RegNo = P.RegNo,
	Patient=P.Name,
	AdmissionCode=PA.AdmissionCode,
	AdmittedOn=PA.Date,
	AdmittedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.UserCode),
	DischargedOn=PA.DischargedOn,
	DischargedBy=(SELECT USERS.UserName FROM USERS WHERE USERCODE = PA.DischargedBy),
	PA.Discharged,
	InvCode=GL.GLVochCode,
	InvDate=GL.Date,
	AliasName= GD.CHKNO,
	Item=GD.Remarks,
	Type=VC.ShortName,
	Qty  = NULL,
	Rate = NULL,
	Value= SUM(GD.Debit - Credit)
FROM 
	Patient P,
	PatientAdmission PA,
	GLDetail GD,
	GLHeader GL,
	VocherCategory VC
WHERE
	( PA.AdmissionCode = :ar_admissioncode ) AND
	( PA.PatientCode = P.PatientCode ) AND
	( GL.Posted = 'Y' ) AND
	( GD.PatientCode = P.PatientCode ) AND
	( GL.GLVochCode = GD.GLVochCode ) AND
	( GL.VochCatCode = VC.VochCatCode ) AND
	( GL.Date >= PA.Date ) AND
	( GL.Date <= PA.DischargedOn )
GROUP  BY
	P.RegNo,
	P.Name,
	PA.AdmissionCode,
	PA.Date,
	PA.UserCode,
	PA.DischargedOn,
	PA.DischargedBy,
	PA.Discharged,
	GL.GLVochCode,
	GL.Date,
	VC.ShortName,
	GD.CHKNO,
	GD.Remarks
ORDER BY
	RowGroup,
	ItemType,
	RegNo,
	Patient,
	InvDate,
	Type,
	InvCode,
	Item,
	AliasName,
	Qty,
	Rate,
	Value
"
  arguments=(("ar_admissioncode", number))
 sort="rowgroup A, itemtype A, regno A, patient A, invdate A, type A, invcode A"
)
