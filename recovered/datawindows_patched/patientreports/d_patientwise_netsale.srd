table(column=(type=long update=yes updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(50) update=yes updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=datetime updatewhereclause=yes name=regdon dbname="RegdOn"  )
column=(type=char(25) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(201) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(100) updatewhereclause=yes name=mobileno1 dbname="MobileNo1"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(9) updatewhereclause=yes name=value dbname="Value"  )
column=(type=long updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
 retrieve="SELECT 
	PatientCode = P.PatientCode,
	Patient = P.Name,
	RegNo = P.RegNo,
	RegdOn = P.Date,
	City = P.City,
	Address = LTRIM(RTRIM(ISNULL(Address1, '') + ' ' + ISNULL(Address2, ''))) ,
	Phone = P.Phone,
	MobileNo1 = P.MobileNo1,
	ICode=D.ICode, 
	ItemName=I.Name, 
	SaleInvCode=S.SaleInvCode,
	Date = S.Date,
	Qty = SUM(D.LooseQty),
	Rate = SUM((D.SalePrice - D.ItemFlatDisc) * (1 - S.DiscPerc * 0.01)),
	Value = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - S.DiscPerc * 0.01)),
	RowID=MAX(D.RowID),
	InvTotal = S.InvTotal
FROM
	Patient P,
	SaleLedger S, 
	SaleDetail D, 
	Item I
WHERE
	S.Date BETWEEN :ad_startdate AND:ad_enddate AND
	S.PatientCode=P.PatientCode AND
	S.SaleInvCode=D.SaleInvCode AND
	D.ICode=I.ICode
GROUP BY 
	P.PatientCode,
	P.Name,
	P.RegNo,
	P.Date,
	P.City,
	P.Address1,
	P.Address2,
	P.Phone,
	P.MobileNo1,
	S.SaleInvCode,
	S.Date,
	S.InvTotal,
	D.ICode, 
	I.Name
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="regno A, patient A, saleinvcode A, itemname A, qty A"
)
