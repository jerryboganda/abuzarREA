table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=patientcode dbname="PatientCode"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="PatientName"  )
column=(type=char(30) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(100) updatewhereclause=yes name=address dbname="Address"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=long updatewhereclause=yes name=days dbname="RecurringPeriod"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="DueDate"  )
column=(type=datetime updatewhereclause=yes name=reportdate dbname="ReportDate"  )
column=(type=long updatewhereclause=yes name=lastinvcode dbname="LastInvCode"  )
 retrieve="SELECT 
	SaleInvCode = S.SaleInvCode,
	Date = 	S.Date,
	PatientCode = S.PatientCode,
	PatientRegNo = P.RegNo,
	PatientName = P.Name,
	Phone = P.Phone,
	Address = P.Address1, 
	InvTotal = S.InvTotal,
	RecurringPeriod = S.RecurringPeriod,
	DueDate=S.Date+S.RecurringPeriod,
	ReportDate = GETDATE() + :ai_days,
	LastInvCode = S.LastRecurringInvCode
FROM 
	SaleLedger S, Patient P
WHERE 
	S.RecurringInvoice='Y' AND 
	S.PatientCode = P.PatientCode AND
	(S.Date + S.RecurringPeriod) <= (GETDATE() + :ai_days)
"
  arguments=(("ai_days", number))
)
