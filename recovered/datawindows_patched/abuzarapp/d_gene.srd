			  Preferences.Issueposting	,
           Preferences.ItemDefaultClass	,
           Preferences.ItemDefaultCategory	,
           Preferences.ItemDefaultManfcode	,
           Preferences.ItemDefaultpackcode	,
           Preferences.ItemDefaultassociatedgcode	,
			  Preferences.PromptBeforePrinting ,
			  preferences.SalePromptForReorder,
