release 12.5;
datawindow ( units=0 timer_interval=0 processing=1 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=148 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=errorid dbname="DBCC_History.ErrorID"  )
column=(type=long updatewhereclause=yes name=levelid dbname="DBCC_History.LevelID"  )
column=(type=long updatewhereclause=yes name=stateid dbname="DBCC_History.StateID"  )
column=(type=char(7000) updatewhereclause=yes name=messagetext dbname="DBCC_History.MessageText"  )
column=(type=char(100) updatewhereclause=yes name=repairlevel dbname="DBCC_History.RepairLevel"  )
column=(type=long updatewhereclause=yes name=statusid dbname="DBCC_History.StatusID"  )
column=(type=long updatewhereclause=yes name=dbid dbname="DBCC_History.DbId"  )
column=(type=long updatewhereclause=yes name=objectid dbname="DBCC_History.ObjectId"  )
column=(type=long updatewhereclause=yes name=indid dbname="DBCC_History.IndId"  )
column=(type=long updatewhereclause=yes name=fileid dbname="DBCC_History.FileID"  )
column=(type=long updatewhereclause=yes name=pageid dbname="DBCC_History.PageID"  )
column=(type=long updatewhereclause=yes name=slotid dbname="DBCC_History.SlotID"  )
column=(type=long updatewhereclause=yes name=reffileid dbname="DBCC_History.RefFileID"  )
column=(type=long updatewhereclause=yes name=refpageid dbname="DBCC_History.RefPageID"  )
column=(type=long updatewhereclause=yes name=refslotid dbname="DBCC_History.RefSlotID"  )
column=(type=long updatewhereclause=yes name=allocationid dbname="DBCC_History.AllocationID"  )
column=(type=char(255) updatewhereclause=yes name=db dbname="DBCC_History.DB"  )
column=(type=char(255) updatewhereclause=yes name=object dbname="DBCC_History.Object"  )
column=(type=datetime updatewhereclause=yes name=date dbname="DBCC_History.Date"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="DBCC_History.RowId"  )
 retrieve="SELECT
	DBCC_History.ErrorID,   
	DBCC_History.LevelID,   
	DBCC_History.StateID,   
	DBCC_History.MessageText,   
	DBCC_History.RepairLevel,   
	DBCC_History.StatusID,   
	DBCC_History.DbId,   
	DBCC_History.ObjectId,   
	DBCC_History.IndId,   
	DBCC_History.FileID,   
	DBCC_History.PageID,   
	DBCC_History.SlotID,   
	DBCC_History.RefFileID,   
	DBCC_History.RefPageID,   
	DBCC_History.RefSlotID,   
	DBCC_History.AllocationID,   
	DBCC_History.DB,   
	DBCC_History.Object,   
	DBCC_History.Date,
	DBCC_History.RowId
FROM 
	DBCC_History  
WHERE 
	DBCC_History.DB = :as_db AND  
	DBCC_History.Date IN
		(SELECT MAX(H.Date) 
		FROM DBCC_History H 
		WHERE DB=:as_Db)
		
"
  arguments=(("as_db", string))
 sort="rowid A"
)
