table(column=(type=long updatewhereclause=yes name=catcode dbname="CatCode"  )
column=(type=char(100) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(100) updatewhereclause=yes name=subcategory dbname="SubCategory"  )
column=(type=long updatewhereclause=yes name=subcatorder dbname="SubCatOrder"  )
column=(type=long updatewhereclause=yes name=prefid dbname="PrefID"  )
column=(type=char(100) key=yes updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(100) updatewhereclause=yes name=caption dbname="Caption"  )
column=(type=char(20) updatewhereclause=yes name=prefdatatype dbname="PrefDataType"  )
column=(type=char(200) update=yes updatewhereclause=yes name=prefvalue dbname="PrefValue"  )
column=(type=char(200) update=yes updatewhereclause=yes name=prefvalue2 dbname="PrefValue2"  )
column=(type=long updatewhereclause=yes name=subcatcode dbname="SubCatCode"  )
column=(type=long updatewhereclause=yes name=formorder dbname="FormOrder"  )
column=(type=long updatewhereclause=yes name=colwidth dbname="ColWidth"  )
column=(type=long updatewhereclause=yes name=decimals dbname="Decimals"  )
column=(type=char(200) updatewhereclause=yes name=usedobject dbname="UsedObject"  )
column=(type=char(1) updatewhereclause=yes name=visible dbname="Visible"  )
column=(type=char(100) updatewhereclause=yes name=assocprefname dbname="AssocPrefName"  )
column=(type=long updatewhereclause=yes name=assocrightcode dbname="AssocRightCode"  )
 retrieve="SELECT 
	CatCode=PC.CatCode,
	Category=PC.Name,
	SubCategory=PSC.Name,
	SubCatOrder=PSC.FormOrder,
	PrefID=SP.PrefId, 
	Name=SP.Name, 
	Caption=SP.Caption, 
	PrefDataType=SP.PrefDataType, 
	PrefValue=SP.PrefValue, 
	PrefValue2=SP.PrefValue2,
	SubCatCode=SP.SubCatCode,
	FormOrder=SP.FormOrder,
	ColWidth=SP.ColWidth,
	Decimals=SP.Decimals,
	UsedObject=SP.UsedObject,
	Visible=SP.Visible,
	AssocPrefName=SP.AssocPrefName,
	AssocRightCode=SP.AssocRightCode
FROM 
	SoftwarePreferences SP,
	PreferencesCategory PC,
	PreferencesSubCategory PSC
WHERE 
	PSC.SubCatCode = SP.SubCatCode AND
	PSC.CatCode = PC.CatCode
ORDER BY
	CatCode, 
	SubCatOrder,
	FormOrder
"
  update="SoftwarePreferences" updatewhere=1 updatekeyinplace=yes
  sort="catcode A, subcatorder A, formorder A"
)
