table(column=(type=long key=yes updatewhereclause=yes name=userid dbname="Preferences.UserId"  )
column=(type=char(1) update=yes updatewhereclause=yes name=headerontransferinv dbname="Preferences.HeaderOnTransferInv" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=showpackqtyintransfer dbname="Preferences.ShowPackQtyInTransfer" 
 values="Yes	Y/No	N/"  )
column=(type=long update=yes updatewhereclause=yes name=priceintransferprint dbname="Preferences.PriceInTransferPrint" 
 values="Avg. Price	1/PurPrice	2/SalePrice	3/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=transferautoposting dbname="Preferences.TransferAutoPosting" 
 values="Yes	Y/No	N/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=allowdupitemsintransfer dbname="Preferences.AllowDupItemsInTransfer" 
 values="Yes	Y/No	N/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=transferdefaultfocussetting dbname="Preferences.TransferDefaultFocusSetting" 
 values="Transfer Type	ttcode/Source Godown	sgcode/Target Godown	dgcode/Remarks	remarks/Header	headerno/Start Date	startdate/End Date	enddate/Transfer Item Detail	itemdetailwindow/"  )
column=(type=char(1) update=yes updatewhereclause=yes name=inctransferinactmonitor dbname="Preferences.IncTransferInActMonitor" 
 values="Yes	Y/No	N/"  )
 retrieve="SELECT
	Preferences.UserId,
	HeaderOnTransferInv,
	ShowPackQtyInTransfer,	
	PriceInTransferPrint,
	TransferAutoPosting,
	AllowDupItemsInTransfer,
	TransferDefaultFocusSetting,
	IncTransferInActMonitor

 FROM Preferences"
  update="Preferences" updatewhere=1 updatekeyinplace=yes
 )
