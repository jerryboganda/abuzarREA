table(column=(type=long updatewhereclause=yes name=licenceno dbname="Setup.LicenceNo"  )
column=(type=datetime updatewhereclause=yes name=creationdatetime dbname="Setup.CreationDateTime"  )
column=(type=datetime updatewhereclause=yes name=lastupdation dbname="Setup.LastUpdation"  )
column=(type=char(30) updatewhereclause=yes name=software dbname="Setup.Software"  )
column=(type=char(10) updatewhereclause=yes name=version dbname="Setup.Version"  )
column=(type=long updatewhereclause=yes name=totalheaders dbname="Setup.TotalHeaders"  )
column=(type=char(1) updatewhereclause=yes name=invoiceheaders dbname="Setup.InvoiceHeaders"  )
column=(type=char(1) updatewhereclause=yes name=drive dbname="Setup.Drive"  )
column=(type=char(9) updatewhereclause=yes name=serialno dbname="Setup.SerialNo"  )
column=(type=char(60) updatewhereclause=yes name=remarks dbname="Setup.Remarks"  )
column=(type=long updatewhereclause=yes name=clientsetup_licenceno dbname="ClientSetup.LicenceNo"  )
column=(type=long updatewhereclause=yes name=headerno dbname="ClientSetup.HeaderNo"  )
column=(type=char(100) updatewhereclause=yes name=clientname dbname="ClientSetup.ClientName"  )
column=(type=char(100) updatewhereclause=yes name=address1 dbname="ClientSetup.Address1"  )
column=(type=char(100) updatewhereclause=yes name=address2 dbname="ClientSetup.Address2"  )
column=(type=char(24) updatewhereclause=yes name=phone dbname="ClientSetup.Phone"  )
column=(type=char(24) updatewhereclause=yes name=fax dbname="ClientSetup.Fax"  )
column=(type=char(20) updatewhereclause=yes name=druglicenceno dbname="ClientSetup.DrugLicenceNo"  )
column=(type=char(30) updatewhereclause=yes name=ownername dbname="ClientSetup.OwnerName"  )
column=(type=char(60) updatewhereclause=yes name=email dbname="ClientSetup.Email"  )
column=(type=char(15) updatewhereclause=yes name=company dbname="Company"  )
 retrieve="   SELECT  Setup.LicenceNo , 
          Setup.CreationDateTime , 
          Setup.LastUpdation , 
          Setup.Software , 
          Setup.Version , 
          Setup.TotalHeaders , 
          Setup.InvoiceHeaders , 
          Setup.Drive , 
          Setup.SerialNo , 
          Setup.Remarks , 
          ClientSetup.LicenceNo , 
          ClientSetup.HeaderNo , 
          ClientSetup.ClientName , 
          ClientSetup.Address1 , 
          ClientSetup.Address2 , 
          ClientSetup.Phone , 
          ClientSetup.Fax , 
          ClientSetup.DrugLicenceNo , 
          ClientSetup.OwnerName , 
          ClientSetup.Email,
 		Company = SPACE(15)
   FROM   ClientSetup , 
          Setup 
    
  WHERE ( Setup.LicenceNo = ClientSetup.LicenceNo )   "
 )
