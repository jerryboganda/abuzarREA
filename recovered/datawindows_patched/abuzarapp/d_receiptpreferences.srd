 values="Yes	Y/No	N/"  )
 retrieve="SELECT
	Preferences.UserId,
	HeaderOnReceiptInv,
	SalesPersonInReceipt,
	SectionInReceipt,
	AreaInReceipt,
	ReceiptPriceInPrint,
	ReceiptPriceTypeCode,
	ShowReceiptPriceTypeCode,
	ShowPriceInReceipt,
	UpdAvgPriceInReceipt,
	ShowUpdAvgPriceInReceipt,
	ReceiptAutoPosting,
	IncRecInActMonitor
FROM Preferences
"
  update="Preferences" updatewhere=1 updatekeyinplace=yes
 )
