 retrieve="SELECT 
	Preferences.UserId ,
	Preferences.HeaderNo ,
	Preferences.RefreshTime,
   ReportTerm1,
   ReportTerm2,
	ReportTerm3,
	ReportTerm4,
	ReportTerm5,
	ReportTerm6,
	DefaultArgSDate,
	ApplyArgSDate

FROM Preferences    "
  update="Preferences" updatewhere=1 updatekeyinplace=yes
 )
