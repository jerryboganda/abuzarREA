release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=10 color="536870912" )
footer(height=1072 color="536870912" )
detail(height=208 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=char(30) updatewhereclause=yes name=licenceno dbname="licenceno"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(5) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=balance dbname="balance"  )
column=(type=char(50) updatewhereclause=yes name=custtaxregno dbname="custTaxRegno"  )
column=(type=char(50) updatewhereclause=yes name=saleledger_custrefno dbname="saleledger_custrefno"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CUSTALIAS"  )
 retrieve="SELECT 
	itemname= case  WHEN (saledetail.itemdescription) is null THEN item.name ELSE saledetail.itemdescription END,   
	aliasname=item.customicode,   
	packingdesc=item.packingdesc,   
	accname = customer.cp,   
	address =  customer.address1,   
	address2=  customer.address2,   
	city=  customer.city,
	licenceno=  customer.licenceno,   
	username=  users.username,   
	saleinvcode =  saleledger.issueinvcode,   
	headerno =  saleledger.headerno, 
	headerinvno= saleledger.headerinvno,  
	date =  saleledger.date,   
	gcode = saledetail.gcode,   
	icode = saledetail.icode,   
	batch = saledetail.batch,   
	expiry = saledetail.expiry,   
	looseqty = saledetail.qty,   
	packunits= saledetail.packunits,   
	saleprice= saledetail.price,   
	Id =  saledetail.IDENTITYCOL,   
	posted=saleledger.posted,   
	balance=0,   
	custTaxRegno=customer.salestaxregno  ,
	saleledger_custrefno= saleledger.referenceno,	
	remarks= saleledger.remarks,
	salesman=ltrim(rtrim( salesman.name)),
	manufacturer=(select name from manufacturer where manfcode=item.manfcode),
	CUSTALIAS=ACCOUNTS.ALIASNAME
FROM 
	issueheader saleledger
	LEFT OUTER JOIN DBO.SalesMan ON (saleledger.smancode = dbo.salesman.salesmancode),
	issuedetail  saledetail,   
	accounts,   
	customer,   
	users,   
	item 
WHERE 
	(  saleledger.issueinvcode>=:ar_SInvCode) AND
	(  saleledger.issueinvcode<=:ar_LInvCode) AND
	(  saleledger.issueinvcode =  saledetail.issueinvcode) AND 
	(  saleledger.acccode =  accounts.acccode ) AND  
	(  customer.custcode =  accounts.acccode ) AND  
	(  saleledger.salesmancode =  users.usercode ) AND  
	(  saledetail.icode =  item.icode)    
ORDER BY  
	saledetail.issueinvcode,
	saledetail.IDENTITYCOL
"
  arguments=(("ar_SInvCode", number), ("ar_linvcode", number), ("as_printdate", string))
)
