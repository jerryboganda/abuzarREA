table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(1) updatewhereclause=yes name=locksaleprice dbname="locksaleprice"  )
column=(type=char(1) updatewhereclause=yes name=lockdiscperc dbname="lockdiscperc"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=long updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=long updatewhereclause=yes name=qtysale dbname="qtysale"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=recentpurprice dbname="recentpurprice"  )
column=(type=decimal(3) update=yes updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=long updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=updatesaleprice dbname="updatesaleprice"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="SaleInvDetail.saleinvcode"  )
column=(type=long update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=gcode dbname="gcode" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes initial="." name=batch dbname="batch"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=expiry dbname="expiry"  )
column=(type=decimal(0) update=yes updatewhereclause=yes name=saleutn dbname="saleutn"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Item flat Disc should be greater than zero~"" initial="0" name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long key=yes updatewhereclause=yes name=rowid dbname="rowid"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Sale Price should be greater than zero'" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=rate dbname="rate"  )
column=(type=char(100) update=yes updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=long update=yes updatewhereclause=yes name=descicode dbname="SaleInvDetail.DescICode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="retailprice"  )
column=(type=long update=yes updatewhereclause=yes name=rowgroup dbname="SaleInvDetail.rowgroup"  )
column=(type=long update=yes updatewhereclause=yes name=sourcesaleinvcode dbname="SaleInvDetail.sourcesaleinvcode"  )
column=(type=long update=yes updatewhereclause=yes name=salerowid dbname="SaleInvDetail.salerowid"  )
column=(type=long update=yes updatewhereclause=yes name=issuerowid dbname="SaleInvDetail.issuerowid"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=packprice dbname="packprice"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Pack Qty should be greater than or equal to zero'" initial="0" name=packqtyforsale dbname="packqtyforsale"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Pack Bonus should be greater than or equal to zero'" initial="0" name=bonuspackqtyforsale dbname="bonuspackqtyforsale"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Bonus Qty should be greater or Equal to zero'" initial="0" name=bonusqty dbname="Bonusqty"  )
column=(type=long update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Qty should be greater or Equal to zero'" initial="1" name=looseqty dbname="looseqty"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=0 and Real(GetText()) < 100" validationmsg="'Discount % value should be between 0 and 100'" name=discperc dbname="discperc"  )
 retrieve="SELECT 
	item.customicode, 
	itemname= item.name, 
	locksaleprice = dbo.item.locksaleprice,
	lockdiscperc = dbo.item.lockdiscperc,
	currlistrow = 0,
	stock     = 0, 
	packingdesc=item.packingdesc,
	totalstock= 0, 
	qtysale=item.saleqty,
	purprice=0.00,
	recentpurprice=0.00,
	avgprice=0.000,
	itemtotalval=space(30),
	Bonus=item.bonusqty,
	assgcode  = 1, 
	updatesaleprice = 'N',
	saleinvdetail.saleinvcode,   
	icode=saleinvdetail.icode,   
	gcode=saleinvdetail.gcode,
	batch=saleinvdetail.batch,
	expiry=saleinvdetail.expiry,
	saleutn=saleinvdetail.saleutn,
	itemflatdisc = saleinvdetail.itemflatdisc,
	rowid       = saleinvdetail.IDENTITYCOL, 
	packunits = saleinvdetail.packunits,
	saleprice = saleinvdetail.saleprice,
	rate      = saleinvdetail.rate,
	SaleItemDescription = saleinvdetail.SaleItemDescription,
	saleinvdetail.DescICode,
	itemcode = 0,
	retailprice=item.retailprice,
	saleinvdetail.rowgroup,
	saleinvdetail.sourcesaleinvcode,
	saleinvdetail.salerowid,
	saleinvdetail.issuerowid,
	packprice = saleinvdetail.packprice,
	packqtyforsale = saleinvdetail.packqtyforsale,
	bonuspackqtyforsale = saleinvdetail.bonuspackqtyforsale,
	Bonusqty  = saleinvdetail.Bonusqty,
	looseqty  = saleinvdetail.looseqty,
	unitsalestax=saleinvdetail.unitsalestax,
	gstperc=saleinvdetail.gstperc,
	discperc  = saleinvdetail.discperc 

FROM saleinvdetail,   
	item 

WHERE ( dbo.saleinvdetail.saleinvcode = :ar_SaleInvCode )    AND
	( saleinvdetail.icode = item.icode )
	
ORDER BY saleinvdetail.IDENTITYCOL

"
  update="saleinvdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_SaleInvCode", number))
)
