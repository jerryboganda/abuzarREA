release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1260 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=229 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes name=summaryacccode dbname="SummaryAccCode"  )
column=(type=char(100) updatewhereclause=yes name=summaryaccount dbname="SummaryAccount"  )
column=(type=char(12) updatewhereclause=yes name=summaryaccountalias dbname="SummaryAccountAlias"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=char(10) updatewhereclause=yes name=suppinvcode dbname="SuppInvCode"  )
column=(type=datetime updatewhereclause=yes name=suppinvdate dbname="SuppInvDate"  )
column=(type=char(15) updatewhereclause=yes name=grn dbname="GRN"  )
column=(type=char(28) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=description dbname="Remark"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="Name"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="Cash"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Purledger.AliasName"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="Purledger.OpenBalance"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=decimal(0) updatewhereclause=yes name=vrow dbname="VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VoucherCode"  )
column=(type=long updatewhereclause=yes name=header dbname="Header"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(6) updatewhereclause=yes name=grossvalue dbname="GrossValue"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(6) updatewhereclause=yes name=itemsaletax dbname="ItemSaleTax"  )
column=(type=decimal(6) updatewhereclause=yes name=itemvalue dbname="ItemValue"  )
column=(type=decimal(6) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(6) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=decimal(6) updatewhereclause=yes name=others dbname="Others"  )
 retrieve="SELECT
	SummaryAccCode=S.SummaryAccCode,
	SummaryAccount=S.SummaryAccount,
	SummaryAccountAlias=S.SummaryAccountAlias,
	DocumentCode=P.PurInvCode,
	SuppInvCode=P.SuppInvCode,
	SuppInvDate=P.SuppInvDate,
	GRN=P.GRN,
	Type='PV-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Date = P.Date, 
	Remark = ISNULL(MAX(D.ItemDescription), (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode)),
	Name=S.Name,
	Cash = CASE P.PurCatCode WHEN 1 THEN 'Y' WHEN 7 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	S.OpenBalance,
	CheckNo=NULL,
	VRow=MAX(D.PurRowID),
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=SUM(D.LooseQty+PackQty),
	Bonus=SUM(D.BonusQty),
	Rate=MAX(D.PurPrice),
	GrossValue=SUM((D.LooseQty + D.PackQty) * D.PurPrice),
	Discount=
		SUM((D.looseqty+D.PackQty) * D.Purprice * (.01 * D.discperc)) + 
		SUM((D.looseqty+D.PackQty) * D.Purprice * (1-(.01*D.discperc)) * (.01 * P.discperc)),
	ItemSaleTax=SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Purprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01),
	ItemValue=SUM((D.PackQty + D.LooseQty) * D.PurPrice) - 
		SUM((D.looseqty + D.PackQty) * D.Purprice * (.01 * D.discperc) +
				((D.looseqty + D.PackQty) * D.Purprice * (1-(.01*D.discperc)) * (.01 * P.discperc))) +  
		SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM( (D.PackQty + D.looseqty) * D.Purprice * (1 - (.01 * D.discperc)) * D.gstperc * .01),
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.PurRowID) WHEN (SELECT MAX(PD.PurROWID) 
		FROM PurDetail PD 
		WHERE PD.PurInvCode=P.PurInvCode) THEN CASE P.PurCatCode WHEN 1 THEN T.NetAmt WHEN 7 THEN T.NetAmt ELSE 0 END ELSE 0 END,
	Credit= CASE MAX(D.PurRowID) WHEN (SELECT MAX(PD.PurROWID) 
		FROM PurDetail PD 
		WHERE PD.PurInvCode=P.PurInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.PurRowID) WHEN (SELECT MAX(PD.PurROWID) 
		FROM PurDetail PD 
		WHERE PD.PurInvCode=P.PurInvCode) THEN ISNULL(P.MiscCharges, 0) - ISNULL(P.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, 
			SummaryAccount=SA.Name, SummaryAccountAlias=SA.AliasName, SA.SummaryAccCode,
			OpenBalance=ISNULL(
				(SELECT ISNULL(SUM(VG.Debit - VG.Credit), 0) 
				FROM 
					(SELECT SDD.AccCode FROM SummaryAccountDetail SDD 
					WHERE SDD.SummaryAccCode = SA.SummaryAccCode) A, VirtualGL VG
				WHERE VG.AccCode=A.AccCode AND VG.date < :ar_startdate), 0)
	FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
	WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
			SA.SummaryAccCode = SAD.SummaryAccCode AND
			SAD.AccCode = A.AccCode) S, PurLedger P, PurDetail D,
	(SELECT 
		P.PurInvCode, 
		RoundingDiff=
		ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.purprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.purprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0) -
		(SUM((D.looseqty + D.packqty + D.bonusqty) * D.unitsalestax) +
		SUM((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc)) * D.gstperc * .01) +
			ROUND( (SUM(((D.looseqty + D.packqty) * D.Purprice) *
				(1 - (.01 * D.discperc))) * (1- (.01 * P.Discperc)) -
				P.flatdisc) * (P.invgstperc1 * .01), 2) + 
		SUM( ((D.looseqty + D.packqty) * D.Purprice) * 
				 (1 - (.01 * D.discperc))) * (1- (.01 * P.discperc)) + 
			P.misccharges + P.salestax - P.flatdisc),
		InvSaleTax=ROUND(SUM((D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Purprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01), 2),
		NetAmt=ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.purprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.purprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0)
	FROM 
		(SELECT	A.AccCode
		FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
		WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
				SA.SummaryAccCode = SAD.SummaryAccCode AND
				SAD.AccCode = A.AccCode) S, PurLedger P, PurDetail D
	WHERE 
		P.Posted = 'Y' AND P.AccountFor = 'Y' AND
		P.PurInvCode = D.PurInvCode AND
		P.SuppCode = S.AccCode AND
		P.date     >= :ar_startdate AND
		P.date     <= :ar_enddate
	GROUP BY
		P.PurInvCode,
		P.DiscPerc,
		P.FlatDisc,
		P.InvGSTPerc1,
		P.DiscPerc,
		P.MiscCharges,
		P.SalesTax) T
WHERE   
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.PurInvCode = D.PurInvCode AND P.PurInvCode = T.PurInvCode AND
	P.SuppCode = S.AccCode AND
	P.date     >= :ar_startdate AND
	P.date     <= :ar_enddate
GROUP BY 
	S.SummaryAccCode,
	S.SummaryAccount,
	S.SummaryAccountAlias,
	S.OpenBalance,
	P.PurInvCode,
	P.PurCatCode,
	P.HeaderInvNo,
	P.HeaderNo,
	D.ICode,
	P.SuppCode, 
	P.Date,
	P.DiscPerc,
	P.MiscCharges,
	P.SalesTax,
	P.FlatDisc,
	P.InvGstPerc1,
	P.SuppInvCode,
	P.SuppInvDate,
	P.GRN,
	S.AccCode,
	S.AliasName,
	S.Name,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	S.SummaryAccCode,
	S.SummaryAccount,
	S.SummaryAccountAlias,
	DocumentCode=P.PurInvCode,
	SuppInvCode=P.SuppInvCode,
	SuppInvDate=P.SuppInvDate,
	GRN=P.GRN,
	Type='PV-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Date = P.AmtDate, 
	Remark = 'Cash Paid During Pur #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Name=S.Name,
	Cash = CASE P.PurCatCode WHEN 1 THEN 'Y' WHEN 7 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	S.OpenBalance,
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = P.Amt,
	Credit= 0,
	Others= 0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, 
			SummaryAccount=SA.Name, SummaryAccountAlias=SA.AliasName, SA.SummaryAccCode,
			OpenBalance=ISNULL(
				(SELECT ISNULL(SUM(VG.Debit - VG.Credit), 0) 
				FROM 
					(SELECT SDD.AccCode FROM SummaryAccountDetail SDD 
					WHERE SDD.SummaryAccCode = SA.SummaryAccCode) A, VirtualGL VG
				WHERE VG.AccCode=A.AccCode AND VG.date < :ar_startdate), 0)
	FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
	WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
			SA.SummaryAccCode = SAD.SummaryAccCode AND
			SAD.AccCode = A.AccCode) S,	PurLedger P
WHERE   
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.SuppCode = S.AccCode AND
	P.Amtdate     >= :ar_startdate AND
	P.Amtdate     <= :ar_enddate AND
	P.Amt <> 0 AND P.PurCatcode NOT IN (1,7)
UNION ALL
SELECT  
	SummaryAccCode=S.SummaryAccCode,
	SummaryAccount=S.SummaryAccount,
	SummaryAccountAlias=S.SummaryAccountAlias,
	DocumentCode=P.PrInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='PR-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Date = P.Date, 
	Remark = ISNULL(MAX(D.ItemDescription), (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode)),
	Name=S.Name,
	Cash = CASE P.PrCatCode WHEN 4 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	S.OpenBalance,
	CheckNo=NULL,
	VRow=MAX(D.PRUTN),
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=-SUM(D.LooseQty+PackQty),
	Bonus=-SUM(D.BonusQty),
	Rate=MAX(D.PrPrice),
	GrossValue=-SUM((D.LooseQty + D.PackQty) * D.PRPrice),
	Discount= -1 *
		(SUM((D.looseqty+D.PackQty) * D.Prprice * (.01 * D.discperc)) + 
		SUM((D.looseqty+D.PackQty) * D.Prprice * (1-(.01*D.discperc)) * (.01 * P.discperc))),
	ItemSaleTax= -1 * (SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Prprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01)),
	ItemValue= -1 * (SUM((D.PackQty + D.LooseQty) * D.PrPrice) - 
		SUM((D.looseqty + D.PackQty) * D.Prprice * (.01 * D.discperc) +
				((D.looseqty + D.PackQty) * D.Prprice * (1-(.01*D.discperc)) * (.01 * P.discperc))) +  
		SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM( (D.PackQty + D.looseqty) * D.Prprice * (1 - (.01 * D.discperc)) * D.gstperc * .01)),
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.PRUTN) WHEN (SELECT MAX(PD.PRUTN) 
		FROM PrDetail PD 
		WHERE PD.PrInvCode=P.PrInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.PRUTN) WHEN (SELECT MAX(PD.PRUTN) 
		FROM PrDetail PD 
		WHERE PD.PrInvCode=P.PrInvCode) THEN CASE P.PrCatCode WHEN 4 THEN T.NetAmt ELSE 0 END ELSE 0 END,
	Others= CASE MAX(D.PRUTN) WHEN (SELECT MAX(PD.PRUTN) 
		FROM PrDetail PD 
		WHERE PD.PrInvCode=P.PrInvCode) THEN ISNULL(P.MiscCharges, 0) - ISNULL(P.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, 
			SummaryAccount=SA.Name, SummaryAccountAlias=SA.AliasName, SA.SummaryAccCode,
			OpenBalance=ISNULL(
				(SELECT ISNULL(SUM(VG.Debit - VG.Credit), 0) 
				FROM 
					(SELECT SDD.AccCode FROM SummaryAccountDetail SDD 
					WHERE SDD.SummaryAccCode = SA.SummaryAccCode) A, VirtualGL VG
				WHERE VG.AccCode=A.AccCode AND VG.date < :ar_startdate), 0)
	FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
	WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
			SA.SummaryAccCode = SAD.SummaryAccCode AND
			SAD.AccCode = A.AccCode) S, PrLedger P, PrDetail D,
	(SELECT 
		P.PrInvCode, 
		RoundingDiff=
		ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.prprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.prprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0) -
		(SUM((D.looseqty + D.packqty + D.bonusqty) * D.unitsalestax) +
		SUM((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc)) * D.gstperc * .01) +
			ROUND( (SUM(((D.looseqty + D.packqty) * D.Prprice) *
				(1 - (.01 * D.discperc))) * (1- (.01 * P.Discperc)) -
				P.flatdisc) * (P.invgstperc1 * .01), 2) + 
		SUM( ((D.looseqty + D.packqty) * D.Prprice) * 
				 (1 - (.01 * D.discperc))) * (1- (.01 * P.discperc)) + 
			P.misccharges + P.salestax - P.flatdisc),
		InvSaleTax=ROUND(SUM((D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Prprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01), 2),
		NetAmt=ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.prprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.prprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0)
	FROM 
		(SELECT	A.AccCode
		FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
		WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
				SA.SummaryAccCode = SAD.SummaryAccCode AND
				SAD.AccCode = A.AccCode) S, PrLedger P, PrDetail D
	WHERE 
		P.Posted = 'Y' AND P.AccountFor = 'Y' AND
		P.PrInvCode = D.PrInvCode AND
		P.SuppCode = S.AccCode AND
		P.date     >= :ar_startdate AND
		P.date     <= :ar_enddate
	GROUP BY
		P.PrInvCode,
		P.DiscPerc,
		P.FlatDisc,
		P.InvGSTPerc1,
		P.DiscPerc,
		P.MiscCharges,
		P.SalesTax) T
WHERE   
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.PrInvCode = D.PrInvCode AND P.PrInvCode = T.PrInvCode AND
	P.SuppCode = S.AccCode AND
	P.date     >= :ar_startdate AND
	P.date     <= :ar_enddate
GROUP BY 
	S.SummaryAccCode,
	S.SummaryAccount,
	S.SummaryAccountAlias,
	S.OpenBalance,
	P.PrInvCode,
	P.PrCatCode,
	P.HeaderInvNo,
	P.HeaderNo,
	D.ICode,
	P.SuppCode, 
	P.Date,
	P.DiscPerc,
	P.MiscCharges,
	P.SalesTax,
	P.FlatDisc,
	P.InvGstPerc1,
	S.AccCode,
	S.AliasName,
	S.Name,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	SummaryAccCode=S.SummaryAccCode,
	SummaryAccount=S.SummaryAccount,
	SummaryAccountAlias=S.SummaryAccountAlias,
	DocumentCode=P.PrInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='PR-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Date = P.AmtDate, 
	Remark = 'Cash Recvd. During P/Ret #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Name=S.Name,
	Cash = CASE P.PrCatCode WHEN 4 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	S.OpenBalance,
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = 0,
	Credit= P.Amt,
	Others= 0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, 
			SummaryAccount=SA.Name, SummaryAccountAlias=SA.AliasName, SA.SummaryAccCode,
			OpenBalance=ISNULL(
				(SELECT ISNULL(SUM(VG.Debit - VG.Credit), 0) 
				FROM 
					(SELECT SDD.AccCode FROM SummaryAccountDetail SDD 
					WHERE SDD.SummaryAccCode = SA.SummaryAccCode) A, VirtualGL VG
				WHERE VG.AccCode=A.AccCode AND VG.date < :ar_startdate), 0)
	FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
	WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
			SA.SummaryAccCode = SAD.SummaryAccCode AND
			SAD.AccCode = A.AccCode) S, PrLedger P
WHERE   
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.SuppCode = S.AccCode AND
	P.Amtdate     >= :ar_startdate AND
	P.Amtdate     <= :ar_enddate AND
	P.Amt <> 0 AND P.PrCatcode NOT IN (4)
UNION ALL
SELECT  
	SummaryAccCode=C.SummaryAccCode,
	SummaryAccount=C.SummaryAccount,
	SummaryAccountAlias=C.SummaryAccountAlias,
	DocumentCode=S.SaleInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.Date, 
	Remark = ISNULL(MAX(D.SaleItemDescription) ,(SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode)),
	Name=c.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	C.OpenBalance,
	CheckNo=NULL,
	VRow=MAX(D.RowID),
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=SUM(D.LooseQty),
	Bonus=SUM(D.BonusQty),
	Rate=MAX(D.SalePrice),
	GrossValue=SUM(D.LooseQty * D.SalePrice),
	Discount=
		SUM(D.looseqty*D.itemflatdisc) +
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) + 
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * 
			(1-(.01*D.discperc)) * (.01 * S.discperc)),
	ItemSaleTax=SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
	ItemValue=SUM(D.LooseQty * D.SalePrice) - 
		SUM((D.looseqty*D.itemflatdisc) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (1-(.01*D.discperc)) * 
				(.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleInvDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleInvDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN CASE S.SaleCatCode WHEN 2 THEN 0 ELSE T.NetAmt END ELSE 0 END,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleInvDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, 
			SummaryAccount=SA.Name, SummaryAccountAlias=SA.AliasName, SA.SummaryAccCode,
			OpenBalance=ISNULL(
				(SELECT ISNULL(SUM(VG.Debit - VG.Credit), 0) 
				FROM 
					(SELECT SDD.AccCode FROM SummaryAccountDetail SDD 
					WHERE SDD.SummaryAccCode = SA.SummaryAccCode) A, VirtualGL VG
				WHERE VG.AccCode=A.AccCode AND VG.date < :ar_startdate), 0)
	FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
	WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
			SA.SummaryAccCode = SAD.SummaryAccCode AND
			SAD.AccCode = A.AccCode) C, SaleLedger S, SaleInvDetail D,
	(SELECT 
		SS.SaleInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc),
		InvSaleTax=	ROUND((SUM((DD.looseqty * 
			(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM 
		(SELECT	A.AccCode
		FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
		WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
				SA.SummaryAccCode = SAD.SummaryAccCode AND
				SAD.AccCode = A.AccCode) S, SaleLedger SS, SaleInvDetail DD 
	WHERE 
		SS.Posted = 'Y' AND SS.AccountFor = 'Y' AND
		SS.ImpactInventory='N' AND
		SS.SaleInvCode = DD.SaleInvCode AND
		SS.CustCode = S.AccCode AND
		SS.date     >= :ar_startdate AND
		SS.date     <= :ar_enddate
	GROUP BY
		SS.SaleInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.ImpactInventory='N' AND
	S.SaleInvCode = D.SaleInvCode AND S.SaleInvCode = T.SaleInvCode AND
	S.CustCode = C.AccCode AND
	S.date     >= :ar_startdate AND
	S.date     <= :ar_enddate
GROUP BY 
	C.SummaryAccCode,
	C.SummaryAccount,
	C.SummaryAccountAlias,
	C.OpenBalance,
	S.SaleInvCode,
	S.SaleCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	D.ICode,
	D.RowGroup,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	C.AccCode,
	C.AliasName,
	C.Name,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	SummaryAccCode=C.SummaryAccCode,
	SummaryAccount=C.SummaryAccount,
	SummaryAccountAlias=C.SummaryAccountAlias,
	DocumentCode=S.SaleInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.Date, 
	Remark = ISNULL(MAX(D.SaleItemDescription) ,(SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode)),
	Name=c.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	C.OpenBalance,
	CheckNo=NULL,
	VRow=MAX(D.RowID),
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=SUM(D.LooseQty),
	Bonus=SUM(D.BonusQty),
	Rate=MAX(D.SalePrice),
	GrossValue=SUM(D.LooseQty * D.SalePrice),
	Discount=
		SUM(D.looseqty*D.itemflatdisc) +
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) + 
		SUM(D.looseqty * (D.saleprice - D.itemflatdisc) * 
			(1-(.01*D.discperc)) * (.01 * S.discperc)),
	ItemSaleTax=SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
	ItemValue=SUM(D.LooseQty * D.SalePrice) - 
		SUM((D.looseqty*D.itemflatdisc) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (1-(.01*D.discperc)) * 
				(.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN CASE S.SaleCatCode WHEN 2 THEN 0 ELSE T.NetAmt END ELSE 0 END,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, 
			SummaryAccount=SA.Name, SummaryAccountAlias=SA.AliasName, SA.SummaryAccCode,
			OpenBalance=ISNULL(
				(SELECT ISNULL(SUM(VG.Debit - VG.Credit), 0) 
				FROM 
					(SELECT SDD.AccCode FROM SummaryAccountDetail SDD 
					WHERE SDD.SummaryAccCode = SA.SummaryAccCode) A, VirtualGL VG
				WHERE VG.AccCode=A.AccCode AND VG.date < :ar_startdate), 0)
	FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
	WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
			SA.SummaryAccCode = SAD.SummaryAccCode AND
			SAD.AccCode = A.AccCode) C, SaleLedger S, SaleDetail D,
	(SELECT 
		SS.SaleInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc),
		InvSaleTax=	ROUND((SUM((DD.looseqty * 
			(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM 
		(SELECT	A.AccCode
		FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
		WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
				SA.SummaryAccCode = SAD.SummaryAccCode AND
				SAD.AccCode = A.AccCode) S, SaleLedger SS, SaleDetail DD 
	WHERE 
		SS.Posted = 'Y' AND SS.AccountFor = 'Y' AND
		SS.SaleInvCode = DD.SaleInvCode AND
		SS.CustCode = S.AccCode AND
		SS.date     >= :ar_startdate AND
		SS.date     <= :ar_enddate
	GROUP BY
		SS.SaleInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.SaleInvCode = D.SaleInvCode AND S.SaleInvCode = T.SaleInvCode AND
	S.CustCode = C.AccCode AND
	S.date     >= :ar_startdate AND
	S.date     <= :ar_enddate
GROUP BY 
	C.SummaryAccCode,
	C.SummaryAccount,
	C.SummaryAccountAlias,
	C.OpenBalance,
	S.SaleInvCode,
	S.SaleCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	D.ICode,
	D.RowGroup,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	C.AccCode,
	C.AliasName,
	C.Name,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	SummaryAccCode=C.SummaryAccCode,
	SummaryAccount=C.SummaryAccount,
	SummaryAccountAlias=C.SummaryAccountAlias,
	DocumentCode=S.SaleInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.AmtDate, 
	Remark = 'Cash Recvd. During Sale #:' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Name=c.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	C.OpenBalance,
	CheckNo=S.AmtReference,
	VRow=9999999,
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = 0,
	Credit= S.Amt,
	Others= 0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, 
			SummaryAccount=SA.Name, SummaryAccountAlias=SA.AliasName, SA.SummaryAccCode,
			OpenBalance=ISNULL(
				(SELECT ISNULL(SUM(VG.Debit - VG.Credit), 0) 
				FROM 
					(SELECT SDD.AccCode FROM SummaryAccountDetail SDD 
					WHERE SDD.SummaryAccCode = SA.SummaryAccCode) A, VirtualGL VG
				WHERE VG.AccCode=A.AccCode AND VG.date < :ar_startdate), 0)
	FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
	WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
			SA.SummaryAccCode = SAD.SummaryAccCode AND
			SAD.AccCode = A.AccCode) C,	SaleLedger S
WHERE   
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.CustCode = C.AccCode AND
	S.Amtdate     >= :ar_startdate AND
	S.Amtdate     <= :ar_enddate AND
	S.Amt <> 0 AND S.SaleCatcode = 2
UNION ALL
SELECT  
	SummaryAccCode=C.SummaryAccCode,
	SummaryAccount=C.SummaryAccount,
	SummaryAccountAlias=C.SummaryAccountAlias,
	DocumentCode=S.SRInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Date = S.Date, 
	Remark = ISNULL(MAX(D.ReturnItemDescription), (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode)),
	Name=c.Name,
	Cash = CASE S.SRCatCode WHEN 7 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	C.OpenBalance,
	CheckNo=NULL,
	VRow=MAX(D.SRUTN),
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=-SUM(D.LooseQty),
	Bonus=-SUM(D.BonusQty),
	Rate=MAX(D.SRPrice),
	GrossValue=-SUM(D.LooseQty * D.SRPrice),
	Discount= -1 *
		(SUM(D.looseqty * D.SRPrice * (.01 * D.discperc)) + 
		SUM(D.looseqty * D.SRPrice * 
			(1-(.01*D.discperc)) * (.01 * S.discperc))),
	ItemSaleTax= -1 * (SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * D.SRPrice) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01)),
	ItemValue= -1 * (SUM(D.LooseQty * D.SRPrice) - 
		SUM((D.looseqty * D.SRPrice * .01 * D.discperc) +
				(D.looseqty * D.SRPrice * (1-(.01*D.discperc)) * (.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * D.SRPrice * (1 - (.01 * D.discperc)) * D.gstperc * .01))),
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) FROM SRDetail SD 
		WHERE SD.SRInvCode=S.SRInvCode) THEN CASE S.SRCatCode WHEN 7 THEN 0 ELSE T.NetAmt END ELSE 0 END,
	Credit= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) FROM SRDetail SD WHERE SD.SRInvCode=S.SRInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) 
		FROM SRDetail SD 
		WHERE SD.SRInvCode=S.SRInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, 
			SummaryAccount=SA.Name, SummaryAccountAlias=SA.AliasName, SA.SummaryAccCode,
			OpenBalance=ISNULL(
				(SELECT ISNULL(SUM(VG.Debit - VG.Credit), 0) 
				FROM 
					(SELECT SDD.AccCode FROM SummaryAccountDetail SDD 
					WHERE SDD.SummaryAccCode = SA.SummaryAccCode) A, VirtualGL VG
				WHERE VG.AccCode=A.AccCode AND VG.date < :ar_startdate), 0)
	FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
	WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
			SA.SummaryAccCode = SAD.SummaryAccCode AND
			SAD.AccCode = A.AccCode) C, SRLedger S, SRDetail D,
	(SELECT 
		SS.SRInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * DD.SRPrice) *

				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty * DD.SRPrice *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc)),
		InvSaleTax=	ROUND((SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM 
		(SELECT	A.AccCode
		FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
		WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
				SA.SummaryAccCode = SAD.SummaryAccCode AND
				SAD.AccCode = A.AccCode) S, SRLedger SS, SRDetail DD 
	WHERE 
		SS.Posted = 'Y' AND SS.AccountFor = 'Y' AND
		SS.CustCode = S.AccCode AND
		SS.SRInvCode = DD.SRInvCode AND
		SS.date     >= :ar_startdate AND
		SS.date     <= :ar_enddate
	GROUP BY
		SS.SRInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.SRInvCode = D.SRInvCode AND S.SRInvCode = T.SRInvCode AND
	S.CustCode = C.AccCode AND
	S.date     >= :ar_startdate AND
	S.date     <= :ar_enddate
GROUP BY 
	C.SummaryAccCode,
	C.SummaryAccount,
	C.SummaryAccountAlias,
	C.OpenBalance,
	S.SRInvCode,
	S.SRCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	D.ICode,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	C.AccCode,
	C.AliasName,
	C.Name,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	SummaryAccCode=C.SummaryAccCode,
	SummaryAccount=C.SummaryAccount,
	SummaryAccountAlias=C.SummaryAccountAlias,
	DocumentCode=S.SRInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Date = S.AmtDate, 
	Remark = 'Cash Paid During S/Return #:' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Name=c.Name,
	Cash = CASE S.SRCatCode WHEN 7 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	C.OpenBalance,
	CheckNo=S.AmtReference,
	VRow=9999999,
	VoucherCode=S.HeaderInvNo,
	Header=S.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=S.MiscCharges,
	FlatDisc=S.FlatDisc,
	InvSaleTax=T.InvSaleTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = S.Amt,
	Credit= 0,
	Others= 0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, 
			SummaryAccount=SA.Name, SummaryAccountAlias=SA.AliasName, SA.SummaryAccCode,
			OpenBalance=ISNULL(
				(SELECT ISNULL(SUM(VG.Debit - VG.Credit), 0) 
				FROM 
					(SELECT SDD.AccCode FROM SummaryAccountDetail SDD 
					WHERE SDD.SummaryAccCode = SA.SummaryAccCode) A, VirtualGL VG
				WHERE VG.AccCode=A.AccCode AND VG.date < :ar_startdate), 0)
	FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
	WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
			SA.SummaryAccCode = SAD.SummaryAccCode AND
			SAD.AccCode = A.AccCode) C, SRLedger S
WHERE   
	S.Posted = 'Y' AND S.AccountFor = 'Y' AND
	S.CustCode = C.AccCode AND
	S.Amtdate     >= :ar_startdate AND
	S.Amtdate     <= :ar_enddate AND
	S.Amt <> 0 AND S.SRCatCode = 7
UNION ALL
SELECT
	SummaryAccCode=C.SummaryAccCode,
	SummaryAccount=C.SummaryAccount,
	SummaryAccountAlias=C.SummaryAccountAlias,
	V.documentcode, 
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type = V.documenttype + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), V.documentcode))), 
	Date = V.Date, 
	Remark = V.Remarks,
	Name=C.Name,
	Cash = CASE ISNULL(V.AlternateAccCode, -1) WHEN -1 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	C.OpenBalance,
	V.CheckNo,
	V.VRow,
	V.VoucherCode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvSaleTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit=V.Debit,
	Credit=V.Credit,
	Others= 0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, 
			SummaryAccount=SA.Name, SummaryAccountAlias=SA.AliasName, SA.SummaryAccCode,
			OpenBalance=ISNULL(
				(SELECT ISNULL(SUM(VG.Debit - VG.Credit), 0) 
				FROM 
					(SELECT SDD.AccCode FROM SummaryAccountDetail SDD 
					WHERE SDD.SummaryAccCode = SA.SummaryAccCode) A, VirtualGL VG
				WHERE VG.AccCode=A.AccCode AND VG.date < :ar_startdate), 0)
	FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
	WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
			SA.SummaryAccCode = SAD.SummaryAccCode AND
			SAD.AccCode = A.AccCode) C, VirtualGL V
WHERE   
	V.DocumentType NOT IN ('SV', 'SR','PV','PR') AND
	(V.AccCode = C.AccCode OR V.AlternateAccCode = C.AccCode ) and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
UNION ALL
SELECT
	SummaryAccCode=C.SummaryAccCode,
	SummaryAccount=C.SummaryAccount,
	SummaryAccountAlias=C.SummaryAccountAlias,
	V.DocumentCode, 
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type = V.DocumentType + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), V.DocumentCode))), 
	Date = V.Date, 
/*	Remark = CASE debit 
			WHEN 0 THEN 'Cash Received Against Pur Ret. # '
			ELSE 'Cash Paid Against Pur. Inv. # '
			END + RTRIM(LTRIM(CONVERT(CHAR(7), V.DocumentCode))),*/
	Remark = CASE debit 
			WHEN 0 THEN 'Cash Paid Against Sale Ret. # '
			ELSE 'Cash Received Against Sales Inv. # '
			END + RTRIM(LTRIM(CONVERT(CHAR(6), V.DocumentCode))),
	c.Name,
	Cash = CASE ISNULL(v.AlternateAccCode, -1) WHEN -1 THEN 'N' ELSE 'Y' END,
	C.AliasName,
	C.OpenBalance,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemSaleTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvSaleTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit = V.Credit,
	Credit= V.Debit,
	Others=0
FROM 
	VirtualGL V,
	(SELECT	A.AliasName, A.AccCode, A.Name, 
			SummaryAccount=SA.Name, SummaryAccountAlias=SA.AliasName, SA.SummaryAccCode,
			OpenBalance=ISNULL(
				(SELECT ISNULL(SUM(VG.Debit - VG.Credit), 0) 
				FROM 
					(SELECT SDD.AccCode FROM SummaryAccountDetail SDD 
					WHERE SDD.SummaryAccCode = SA.SummaryAccCode) A, VirtualGL VG
				WHERE VG.AccCode=A.AccCode AND VG.date < :ar_startdate), 0)
	FROM	Accounts A, SummaryAccount SA, SummaryAccountDetail SAD
	WHERE	SA.SummaryAccCode IN (:ar_summacccode) AND
			SA.SummaryAccCode = SAD.SummaryAccCode AND
			SAD.AccCode = A.AccCode) C
WHERE   
	V.DocumentType NOT IN ('SV', 'SR', 'PV', 'PR') AND
	(V.AlternateAccCode = C.AccCode ) and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
ORDER BY
	SummaryAccount,
	SummaryAccountAlias,
	Date, 
	Type, 
	VRow
"
  arguments=(("ar_summacccode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
