table(column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(60) updatewhereclause=yes name=groupaccount dbname="GroupAccount"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=decimal(2) updatewhereclause=yes name=pendingcheques dbname="PendingCheques"  )
column=(type=decimal(2) updatewhereclause=yes name=effectivebalance dbname="EffectiveBalance"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
 retrieve="SELECT 
	AccountName=name1, 
	GroupAccount=Name2,
	Debit= CASE WHEN value1 > 0 THEN Value1 ELSE 0 END,
	Credit= CASE WHEN value1 < 0 THEN ABS(Value1) ELSE 0 END,
	PendingCheques = ISNULL(DBO.fn_GetAmountOfInProcessCheques(A.AccCode), 0),
	EffectiveBalance = value1 + ISNULL(DBO.fn_GetAmountOfInProcessCheques(A.AccCode), 0),
	AliasName
FROM
	(SELECT A.AccCode, A.Name AS name1, S.Name AS Name2, Sum(Debit - Credit) AS value1, A.AliasName
	FROM VirtualGL V,
		  Accounts A,
		  SubAccounts S
	WHERE V.Date <= :ar_Date AND 
			(A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'Y' END OR
			A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'N' END) AND
			V.AccCode = A.AccCode AND 
			A.SubCode = S.SubAccCode
	GROUP BY A.AccCode, A.Name, S.Name, A.AliasName) A
ORDER BY GroupAccount, AccountName, AliasName
   
"
  arguments=(("ar_date", datetime), ("ar_restricted", number))
)
