release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=500 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=4041 color="536870912" )
table(column=(type=char(30) updatewhereclause=yes name=type dbname="Type"  )
column=(type=long updatewhereclause=yes name=glcode dbname="GLCODE"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="Glheader.VoucherCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=title dbname="Title"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(20) updatewhereclause=yes name=chequeno dbname="ChequeNo"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=long updatewhereclause=yes name=invoicebased dbname="InvoiceBased"  )
 retrieve="SELECT
	Type = (SELECT VocherCategory.Name FROM VocherCategory WHERE VocherCategory.VochCatCode = H.VochCatCode),
	GLCODE = H.GLVochCode,
	H.VoucherCode,
	Date = H.Date,
	AccCode=D.AccCode,
	AliasName = A.AliasName,
	Title = A.Name,
	Amount = D.Debit - D.Credit,
	Remarks = D.Remarks,
	ChequeNo= D.ChkNo,
	Posted=H.Posted,
	Balance = ISNULL(CASE WHEN A.SummaryAccCode IS NULL THEN D.Balance ELSE A.SummaryBalance END, 0),
	InvoiceCode=D.InvoiceCode,
	InvoiceBased=(SELECT VocherCategory.InvoiceBased FROM VocherCategory WHERE VocherCategory.VochCatCode = H.VochCatCode)
FROM
	GLHeader H,
	GLDetail D,
	(SELECT Ac.AccCode, Ac.Name, Ac.AliasName, Ac.SubCode, SummaryAccCode=NULL, SummaryBalance=0.0000
	FROM Accounts Ac
	WHERE Ac.AccCode NOT IN (SELECT SAD.AccCode FROM SummaryAccountDetail SAD)
	UNION 
	SELECT Ac.AccCode, Ac.Name, Ac.AliasName, Ac.SubCode, SummaryAccCode=SA.SummaryAccCode, 
	SummaryBalance=(SELECT Balance=SUM(V.Debit-V.Credit)
				FROM SummaryAccountDetail SAD, VirtualGl V
				WHERE SAD.SummaryAccCode=SA.SummaryAccCode AND SAD.AccCode = V.AccCode)
	FROM Accounts Ac, SummaryAccountDetail SA
	WHERE Ac.AccCode = SA.AccCode) A
WHERE
	H.VochCatCode= :ai_VoucherCatCode AND
	H.GLVochCode = D.GLVochCode AND
	D.GLRowID IN (:ai_SelectedRowID) AND
	D.AccCode = A.AccCode
ORDER BY
	H.GLVochCode,
	D.GLRowID"
  arguments=(("ai_SelectedRowID", numberlist), ("ai_VoucherCatCode", number))
)
group(level=1 header.height=0 trailer.height=0 by=("glcode"  ) header.color="536870912" trailer.color="536870912" )
