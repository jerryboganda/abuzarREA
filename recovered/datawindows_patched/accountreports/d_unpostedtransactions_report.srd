table(column=(type=long updatewhereclause=yes name=status dbname="Status"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="documentcode"  )
column=(type=char(28) updatewhereclause=yes name=type dbname="type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remark"  )
column=(type=char(0) updatewhereclause=yes name=refno1 dbname="refno1"  )
column=(type=char(0) updatewhereclause=yes name=refno2 dbname="refno2"  )
column=(type=char(0) updatewhereclause=yes name=refno3 dbname="refno3"  )
column=(type=char(0) updatewhereclause=yes name=refno4 dbname="refno4"  )
column=(type=char(1) updatewhereclause=yes name=cashreceived dbname="cashreceived"  )
column=(type=char(60) updatewhereclause=yes name=account dbname="name"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="cash"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="phone"  )
column=(type=char(100) updatewhereclause=yes name=fax dbname="fax"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=long updatewhereclause=yes name=areacode dbname="areacode"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="area"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="vouchercode"  )
column=(type=long updatewhereclause=yes name=pendingcheque dbname="PendingCheque"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
 retrieve="select	
	Status=1,
	V.documentcode, 
	type = '*' + V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Debit, 
	credit= V.Credit,
	remark = V.Remarks,
	refno1 = '',
	refno2 =  '',
	refno3 =  '',
	refno4 = '',
	cashreceived='N',
	c.name,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	c.aliasname,
	address=c.address1,
	address2=c.address2,
	phone=c.phone,
	fax=c.fax,
	city=c.city,
	c.areacode,
	c.area,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	PendingCheque=0,
	UserName = (SELECT U.UserName FROM Users U WHERE U.UserCode = V.UserCode)
FROM
	(SELECT * FROM DBO.Fn_GetUnposted_AccTrans()) AS V,
	(SELECT	a.aliasname, a.acccode, a.name, ct.address1,ct.address2,ct.city,ct.phone,ct.fax, ct.areacode, area=ar.name
	FROM	accounts a, customer ct, area ar
	WHERE	
			a.acccode = ct.custcode and 
			ar.areacode=ct.areacode) C
WHERE
	(V.AccCode = C.AccCode OR V.AlternateAccCode = C.AccCode ) AND
	V.date BETWEEN :ar_startdate and :ar_enddate

"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime))
)
