release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1656 color="536870912" )
summary(height=0 color="536870912" )
footer(height=3270 color="536870912" )
detail(height=1875 color="536870912" )
table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
column=(type=char(8000) updatewhereclause=yes name=detail dbname="Detail"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="salesperson"  )
 retrieve=" SELECT 
	AliasName, 
	customername = name1, 
	Address1,
	Address2, 
	City,
	Balance=Value1, 
	Detail = :as_detail + SPACE(LEN(:as_detail)),
	salesperson=(select name from salesman S where S.salesmancode=A.SalesManCode)
FROM
	(SELECT 
		A.Name AS name1, 
		Address1 = C.Address1,
		Address2 = C.Address2,
		City = C.City,
		Sum(Debit - Credit) AS value1, 
		A.AliasName, 
		salesmancode=max(C.SalesManCode)
	FROM VirtualGL V,
		  Accounts A,
		  SubAccounts S,
		  Customer C
	WHERE V.Date <= :adt_Date AND 
			V.AccCode IN (:ai_custcode) AND
			V.AccCode = A.AccCode AND 
			A.SubCode = S.SubAccCode AND 
			S.SubAccCode = 3 AND 
			A.AccCode = C.CustCode
	GROUP BY 
		A.AccCode, A.Name, A.AliasName, C.Address1, C.Address2, C.City) A
ORDER BY 
	customername, 
	AliasName"
  arguments=(("ai_custcode", numberlist), ("adt_date", datetime), ("as_detail", string))
)
group(level=1 header.height=2656 trailer.height=0 by=("customername"  ) header.color="536870912" trailer.color="536870912" newpage=yes resetpagecount=yes )
