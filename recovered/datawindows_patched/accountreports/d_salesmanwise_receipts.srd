table(column=(type=long updatewhereclause=yes name=glvochcode dbname="Glheader.glvochcode"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="Glheader.vouchercode"  )
column=(type=char(60) updatewhereclause=yes name=saleperson dbname="SalePerson"  )
column=(type=decimal(2) updatewhereclause=yes name=gldetail_debit dbname="GLDetail.debit"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=credit dbname="GLDetail.credit"  )
column=(type=datetime updatewhereclause=yes initial="today" name=date dbname="date"  )
column=(type=char(27) updatewhereclause=yes name=type dbname="type"  )
column=(type=char(60) updatewhereclause=yes name=accounthead dbname="accounthead"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="accountname"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="area"  )
column=(type=char(60) updatewhereclause=yes name=subarea dbname="Subarea"  )
 retrieve="select   glheader.glvochcode,
			glheader.vouchercode,
			SalePerson=(SELECT salesman.name FROM SalesMan WHERE SalesmanCode=glheader.smancode),
	 		gldetail.debit,
	 		gldetail.credit,
	      date = glheader.date,
	 		type = 	RTRIM(LTRIM((SELECT V.SHORTNAME 
						FROM vochercategory v 
						WHERE v.vochcatcode = glheader.vochcatcode))) + '-' +	
				RTrim(LTrim(convert(char(6), glheader.glvochcode))),  
	   	accounthead=(Select name from accounts where accounts.acccode = glheader.acccode),
	   	accountname=(Select name from accounts where accounts.acccode = gldetail.acccode),
			area=(SELECT Area.Name FROM Area, Customer 
					WHERE Customer.CustCode = GlDetail.AccCode AND Area.AreaCode = Customer.Areacode),
			Subarea=(SELECT SubArea.Name FROM Area, SubArea, Customer 
					WHERE Customer.CustCode = GlDetail.AccCode AND 
					Customer.SubAreaCode = SubArea.SubAreaCode AND SubArea.AreaCode = Area.Areacode)
from     glheader,
	 		gldetail

where    glheader.glvochcode = gldetail.glvochcode and
			glheader.smancode in (:ai_smancode) AND
	 		gldetail.credit > 0 AND
	 		glheader.vochcatcode IN (2, 4, 12, 13) and glheader.acccode <> gldetail.acccode and 
	 		(glheader.date >= :ad_StartDate) and
	 		(glheader.date <= :ad_endDate) 
ORDER BY
			saleperson,
			glheader.date,
			type,
			accountname,
			accounthead
"
  arguments=(("ai_smancode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime))
 sort="saleperson A, date A, type A, accountname A, accounthead A"
)
