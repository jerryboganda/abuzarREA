table(column=(type=long key=yes updatewhereclause=yes name=areacode dbname="Area.AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Area.Name"  )
column=(type=decimal(2) updatewhereclause=yes name=opening dbname="Opening"  )
column=(type=decimal(2) updatewhereclause=yes name=sale dbname="Sale"  )
column=(type=decimal(2) updatewhereclause=yes name=ret dbname="Ret"  )
column=(type=decimal(2) updatewhereclause=yes name=netsale dbname="NetSale"  )
column=(type=decimal(2) updatewhereclause=yes name=receipts dbname="Receipts"  )
column=(type=decimal(2) updatewhereclause=yes name=debits dbname="Debits"  )
column=(type=decimal(2) updatewhereclause=yes name=credits dbname="Credits"  )
column=(type=decimal(2) updatewhereclause=yes name=outstanding dbname="Outstanding"  )
 retrieve="SELECT 
	A.AreaCode, 
	A.Name,
	Opening=ISNULL(SUM(CASE TYPE WHEN 'OP' THEN T.AMT ELSE 0.00 END), 0.00),
	Sale=ISNULL(SUM(CASE TYPE WHEN 'S' THEN T.AMT ELSE 0.00 END), 0.00),
	Ret=ISNULL(SUM(CASE TYPE WHEN 'R' THEN T.AMT ELSE 0.00 END), 0.00),
	NetSale=ISNULL(SUM(CASE TYPE WHEN 'S' THEN T.AMT WHEN 'R' THEN -(T.AMT) ELSE 0.00 END), 0.00),
	Receipts=ISNULL(SUM(CASE TYPE WHEN 'BC' THEN T.AMT ELSE 0.00 END), 0.00),
	Debits=ISNULL(SUM(CASE TYPE WHEN 'DR' THEN T.AMT ELSE 0.00 END), 0.00),
	Credits=ISNULL(SUM(CASE TYPE WHEN 'CR' THEN T.AMT ELSE 0.00 END), 0.00),
	Outstanding=ISNULL(SUM(CASE TYPE 
		WHEN 'OP'  THEN T.AMT 
		WHEN 'S'  THEN T.AMT 
		WHEN 'R'  THEN -(T.AMT) 
		WHEN 'BC' THEN -(T.AMT) 
		WHEN 'DR' THEN T.AMT
		WHEN 'CR' THEN - (T.AMT)
		ELSE 0.00 END), 0.00)
FROM
	AREA A,
	(SELECT
		Type='S',
		InvCode=H.SaleInvCode,
		AccCode=H.CustCode,
		C.AreaCode,
		Amt=Round(SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) +
		SUM(ROUND( (D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
		ROUND( (SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc))) * (1- (.01 * H.discperc)) -
			H.flatdisc) * (H.invgstperc1 * .01), 2), 0) +
		Round(SUM((D.looseqty*(D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc))) * (1- (.01 * H.discperc)) + 
			H.misccharges + H.salestax - H.flatdisc, 0)
	FROM
		saleledger h, saledetail d, Customer C
	WHERE
		h.posted='Y' AND h.AccountFor = 'Y' AND
		h.salecatcode IN (2) AND
		h.saleinvcode = d.saleinvcode AND
		h.date >= :ad_startdate AND h.date <= :ad_enddate AND
		H.custcode = C.CustCode
	GROUP BY 
		h.saleinvcode,
		h.custcode, 
		c.areacode,
		h.discperc,
		h.misccharges,
		h.salestax,
		h.flatdisc,
		h.invgstperc1
	UNION ALL
	SELECT
		Type='R',
		InvCode=H.SRInvCode,
		AccCode=H.CustCode,
		C.AreaCode,
		Amt=ROUND(
			SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
			SUM(ROUND( (D.looseqty * D.srprice) * 
				 (1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND( (sum( (D.looseqty * D.srprice) *
				 (1 - (.01 * D.discperc))) * 
				 (1- (.01 * H.discperc)) - H.flatdisc) * 
				 (H.invgstperc1 * .01), 2), 0) +
		Round( sum( (D.looseqty * D.srprice) *
				 (1 - (.01 * D.discperc))) * 
				 (1- (.01 * H.discperc)) + H.misccharges + 
				 H.salestax - H.flatdisc, 0)
	FROM
		srledger h, srdetail d, Customer C
	WHERE
		h.posted='Y' AND h.AccountFor = 'Y' AND
		h.SRCatCode IN (7) AND 
		h.srinvcode = d.srinvcode AND
		h.date >= :ad_startdate AND h.date <= :ad_enddate AND
		h.custcode = C.custcode
	GROUP BY 
		h.srinvcode,
		h.custcode, 
		c.areacode,
		h.discperc,
		h.misccharges,
		h.salestax,
		h.flatdisc,
		h.invgstperc1
	UNION ALL
	SELECT 
		TYPE='BC',
		InvCode=0,
		AccCode=D.AccCode, 
		C.AreaCode,
		Amt=SUM(D.Credit)
	FROM 
		Customer C, GlDetail D, GlHeader H
	WHERE
		H.VochCatCode IN (2, 4) AND
		H.Posted = 'Y' AND
		H.GlVochCode = D.GlVochCode AND
		D.AccCode = C.CustCode AND
		h.date >= :ad_startdate AND h.date <= :ad_enddate
	GROUP BY
		D.AccCode, C.AreaCode
	UNION ALL
	SELECT 
		TYPE='DR',
		InvCode=0,
		AccCode=D.AccCode,  
		C.AreaCode,
		Amt=SUM(D.Debit)
	FROM 
		Customer C, GlDetail D, GlHeader H
	WHERE
		H.VochCatCode NOT IN (2, 4) AND
		H.Posted = 'Y' AND
		H.GlVochCode = D.GlVochCode AND
		D.AccCode = C.CustCode AND
		h.date >= :ad_startdate AND h.date <= :ad_enddate
	GROUP BY
		D.AccCode, C.AreaCode
	UNION ALL
	SELECT 
		TYPE='CR',
		InvCode=0,
		AccCode=D.AccCode, 
		C.AreaCode,
		Amt=SUM(D.Credit)
	FROM 
		Customer C, GlDetail D, GlHeader H
	WHERE
		H.VochCatCode NOT IN (2, 4) AND
		H.Posted = 'Y' AND
		H.GlVochCode = D.GlVochCode AND
		D.AccCode = C.CustCode AND
		h.date >= :ad_startdate AND h.date <= :ad_enddate
	GROUP BY
		D.AccCode, C.AreaCode
	UNION ALL
	SELECT 
		TYPE='BC',
		InvCode=0,
		AccCode=N.AccCode, 
		C.AreaCode,
		Amt=SUM(N.Amount)
	FROM 
		Customer C, Notes N
	WHERE
		N.Posted = 'Y' AND
		N.AccCode = C.CustCode AND
		N.Postdate >= :ad_startdate AND N.Postdate <= :ad_enddate
	GROUP BY
		N.AccCode, C.AreaCode
	UNION ALL
	SELECT 
		TYPE='OP',
		InvCode=0,
		AccCode=D.AccCode, 
		C.AreaCode,
		Amt=SUM(D.Debit - D.Credit)
	FROM 
		Customer C, VirtualGl D
	WHERE
		D.AccCode = C.CustCode AND
		D.date < :ad_startdate
	GROUP BY	D.AccCode, C.AreaCode
	UNION ALL
	SELECT 
		TYPE='OP',
		InvCode=0,
		AccCode=C.CustCode, 
		C.AreaCode,
		Amt=0.00
	FROM 
		Customer C) T
WHERE 
	T.AreaCode = A.AreaCode
GROUP BY
	A.AreaCode,
	A.Name	
ORDER BY
	A.Name,
	A.AreaCode
"
  update="AREA" updatewhere=0 updatekeyinplace=no
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
)
