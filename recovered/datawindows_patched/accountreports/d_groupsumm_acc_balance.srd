table(column=(type=long updatewhereclause=yes name=type dbname="Type"  )
column=(type=char(100) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(60) updatewhereclause=yes name=groupaccount dbname="GroupAccount"  )
column=(type=char(60) updatewhereclause=yes name=groupsummaryaccount dbname="GroupSummaryAccount"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
 retrieve="SELECT 
	Type,
	AccountName, 
	GroupAccount,
	GroupSummaryAccount,
	Debit= CASE WHEN Balance > 0 THEN Balance ELSE 0 END,
	Credit= CASE WHEN Balance < 0 THEN ABS(Balance) ELSE 0 END,
	AliasName
FROM
	(SELECT 
		Type=1,
		AccountName=A.Name, 
		GroupAccount=S.Name, 
		GroupSummaryAccount=NULL,
		Balance=Sum(V.Debit - V.Credit), 
		AliasName=A.AliasName
	FROM VirtualGL V,
		  Accounts A,
		  SubAccounts S
	WHERE 
		A.AccCode NOT IN (SELECT AccCode FROM SummaryAccountDetail) AND
		A.AccCode = V.AccCode AND 
		A.SubCode = S.SubAccCode AND
		(A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'Y' END OR
			A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'N' END) AND
		V.Date <= :ar_Date
	GROUP BY A.AccCode, A.Name, S.Name, A.AliasName
	UNION ALL
	SELECT 
		Type=0,
		AccountName=SA.Name, 
		GroupAccount=NULL, 
		GroupSummaryAccount=(SELECT GSA.Name FROM GroupSummaryAccount GSA WHERE SA.GroupSummaryAccCode = GSA.GroupSummaryAccCode),
		Balance=Sum(V.Debit - V.Credit), 
		AliasName=SA.AliasName
	FROM VirtualGL V,
		  Accounts A, SummaryAccountDetail SAD, SummaryAccount SA
	WHERE 
		A.AccCode = SAD.AccCode AND
		SA.SummaryAccCode = SAD.SummaryAccCode AND
		SA.GroupSummaryAccCode IN (:ai_GroupSummaryAccCode) AND
		A.AccCode = V.AccCode AND 
		(A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'Y' END OR
			A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'N' END) AND
		V.Date <= :ar_Date
	GROUP BY 
		SA.GroupSummaryAccCode,
		SA.SummaryAccCode, 
		SA.Name, 
		SA.AliasName) A
ORDER BY 
	GroupSummaryAccount,
	Type,
	GroupAccount, 
	AccountName, 
	AliasName
   
"
  arguments=(("ar_date", datetime), ("ar_restricted", number), ("ai_groupsummaryacccode", numberlist))
 sort="groupsummaryaccount A, type A, groupaccount A, accountname A, aliasname A"
)
