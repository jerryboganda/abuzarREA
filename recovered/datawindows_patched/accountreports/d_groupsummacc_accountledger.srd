table(column=(type=char(60) updatewhereclause=yes name=groupsummaryaccount dbname="GroupSummaryAccount"  )
column=(type=char(100) updatewhereclause=yes name=name dbname="SummaryAccount.Name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="SummaryAccount.AliasName"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="VirtualGl.DocumentCode"  )
column=(type=char(27) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=number updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=number updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remark"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="OpenBalance"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="VirtualGl.CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VirtualGl.VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VirtualGl.VoucherCode"  )
column=(type=long updatewhereclause=yes name=pendingcheque dbname="PendingCheque"  )
 retrieve="SELECT 
	GroupSummaryAccount=GSA.Name,
	A.Name,
	A.AliasName,
	V.DocumentCode, 
	Type = V.DocumentType + '-' + RTRIM(LTRIM(CONVERT(CHAR(6), V.DocumentCode))), 
	date = V.Date, 
	Debit = V.Debit,
	Credit= V.Credit,
	Remark = V.Remarks,
	OpenBalance=
		(SELECT ISNULL(SUM(Debit-Credit), 0) 
		FROM VirtualGL 
		WHERE	
			VirtualGL.AccCode IN 
				(SELECT T.AccCode FROM SummaryAccountDetail T 
				WHERE T.SummaryAccCode = A.SummaryAccCode) AND
			VirtualGL.Date < :ar_startdate),
	V.CheckNo,
	V.VRow,
	V.VoucherCode,
	PendingCheque=0
FROM VirtualGL V, SummaryAccount A, SummaryAccountDetail D, Accounts AC,
	GroupSummaryAccount GSA
WHERE 
	GSA.GroupSummaryAccCode IN (:ar_groupsummaryacccode) AND 
	GSA.GroupSummaryAccCode = A.GroupSummaryAccCode AND
	A.SummaryAccCode = D.SummaryAccCode AND
	D.AccCode = AC.AccCode AND
	(V.AccCode = AC.AccCode OR V.AlternateAccCode = AC.AccCode ) and
	V.Date >= :ar_startdate and
	V.Date <= :ar_enddate
UNION ALL
SELECT 
	GroupSummaryAccount=GSA.Name,
	A.Name,
	A.AliasName,
	V.DocumentCode, 
	Type = V.DocumentType + '-' + RTRIM(LTRIM(CONVERT(CHAR(6), V.DocumentCode))), 
	Date = V.Date, 
	Debit = V.Credit,
	Credit= V.Debit,
	Remark = CASE debit 
			WHEN 0 THEN 'Cash Paid Against Sale Ret. # '
			ELSE 'Cash Received Against Sales Inv. # '
			END + RTRIM(LTRIM(CONVERT(CHAR(6), V.DocumentCode))),
	OpenBalance=
		(SELECT ISNULL(SUM(Debit-Credit), 0) 
		FROM VirtualGL 
		WHERE	
			VirtualGL.AccCode IN 
				(SELECT T.AccCode FROM SummaryAccountDetail T 
				WHERE T.SummaryAccCode = A.SummaryAccCode) AND
			VirtualGL.Date < :ar_startdate),
	V.CheckNo,
	V.VRow,
	V.VoucherCode,
	PendingCheque=0
FROM VirtualGL V, SummaryAccount A, SummaryAccountDetail D, Accounts AC,
	GroupSummaryAccount GSA
WHERE   
	GSA.GroupSummaryAccCode IN (:ar_groupsummaryacccode) AND 
	GSA.GroupSummaryAccCode = A.GroupSummaryAccCode AND
	A.SummaryAccCode = D.SummaryAccCode AND
	D.AccCode = AC.AccCode AND
	V.AlternateAccCode = AC.AccCode AND
	V.Date >= :ar_startdate AND
	V.Date <= :ar_enddate
UNION ALL
SELECT
	GroupSummaryAccount=GSA.Name,
	A.Name,
	A.AliasName,
	documentcode = N.NoteCode, 
	Type = Case N.NoteCatCode When 1 Then '*NR' Else '*NP' End + '-' + RTrim(LTrim(convert(char(6), N.NoteCode))),  
	date = N.duedate, 
	debit = Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = AC.AccCode THEN 0 ELSE N.Amount END ELSE CASE WHEN N.AccCode = AC.AccCode THEN N.Amount ELSE 0 END END,
	credit= Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = AC.AccCode THEN N.Amount ELSE 0 END ELSE CASE WHEN N.AccCode = AC.AccCode THEN 0 ELSE N.Amount END END,
	remark = N.Remarks,
	OpenBalance=
		(SELECT ISNULL(SUM(Debit-Credit), 0) 
		FROM VirtualGL 
		WHERE	
			VirtualGL.AccCode IN 
				(SELECT T.AccCode FROM SummaryAccountDetail T 
				WHERE T.SummaryAccCode = A.SummaryAccCode) AND
			VirtualGL.Date < :ar_startdate),
	CheckNo = LEFT(N.DocumentNumber, 20),
	VRow=999999,
	N.vouchercode,
	PendingCheque=1
FROM
	Notes N, SummaryAccount A, SummaryAccountDetail D, Accounts AC, GroupSummaryAccount GSA
WHERE
	GSA.GroupSummaryAccCode IN (:ar_groupsummaryacccode) AND 
	GSA.GroupSummaryAccCode = A.GroupSummaryAccCode AND
	A.SummaryAccCode = D.SummaryAccCode AND
	D.AccCode = AC.AccCode AND
	(N.AccCode = AC.AccCode OR N.BankAccCode = AC.AccCode ) and
	N.Posted = 'N' AND N.Finalized = 'Y'
UNION ALL
SELECT 
	GroupSummaryAccount=GSA.Name,
	A.Name,
	A.AliasName,
	DocumentCode=0, 
	Type = '', 
	Date = :ar_enddate,
	Debit = 0,
	Credit= 0,
	Remark = '',
	OpenBalance=
		(SELECT ISNULL(SUM(Debit-Credit), 0) 
		FROM VirtualGL 
		WHERE	
			VirtualGL.AccCode IN 
				(SELECT T.AccCode FROM SummaryAccountDetail T 
				WHERE T.SummaryAccCode = A.SummaryAccCode) AND
			VirtualGL.Date < :ar_startdate),
	CheckNo='',
	VRow=0,
	VoucherCode=NULL,
	PendingCheque=0
FROM SummaryAccount A, 	GroupSummaryAccount GSA
WHERE   
	GSA.GroupSummaryAccCode IN (:ar_groupsummaryacccode) AND 
	GSA.GroupSummaryAccCode = A.GroupSummaryAccCode AND
	(SELECT SUM(X.AccCode)
	FROM 
		(SELECT T.AccCode FROM SummaryAccountDetail T 
		WHERE T.SummaryAccCode = A.SummaryAccCode) X,
		VirtualGL V
	WHERE V.AccCode = X.AccCode AND 
			V.Date >= :ar_startdate AND
			V.Date <= :ar_enddate) IS NULL
ORDER BY 
	GroupSummaryAccount,
	A.Name, 
	A.AliasName, 
	Date, 
	type, 
	VRow
"
  arguments=(("ar_groupsummaryacccode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
