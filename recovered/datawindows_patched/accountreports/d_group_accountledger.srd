table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="Accounts.name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.aliasname"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="VirtualGl.documentcode"  )
column=(type=char(27) updatewhereclause=yes name=type dbname="type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=number updatewhereclause=yes name=debit dbname="debit"  )
column=(type=number updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remark"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="openbalance"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="VirtualGl.CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VirtualGl.VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VirtualGl.vouchercode"  )
column=(type=long updatewhereclause=yes name=pendingcheque dbname="Pendingcheque"  )
 retrieve="select
	GroupCode = S.SubAccCode,
	GroupName = S.Name,
	A.name,
	A.aliasname,
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Debit,
	credit= V.Credit,
	remark = V.Remarks,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=A.acccode and 
				virtualgl.date < :ar_startdate),
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	Pendingcheque=0

from     VirtualGL V, Accounts A, SubAccounts S
where   
	S.SubAccCode IN (:ar_subacccode) AND
	S.SubAccCode = A.SubCode AND
	(V.AccCode = A.AccCode OR V.AlternateAccCode = A.AccCode ) and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
union all
select	
	GroupCode = S.SubAccCode,
	GroupName = S.Name,
	A.name,
	A.aliasname,
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Credit,
	credit= V.Debit,
	remark = Case debit 
			When 0 then 'Cash Paid Against Sale Ret. # '
			Else 'Cash Received Against Sales Inv. # '
			End + RTrim(LTrim(convert(char(6), V.documentcode))),
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=A.acccode and 
				virtualgl.date < :ar_startdate),
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	Pendingcheque=0
from     VirtualGL V, Accounts A, SubAccounts S
where   
	S.SubAccCode IN (:ar_subacccode) AND
	S.SubAccCode = A.SubCode AND
   V.AlternateAccCode = A.AccCode and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
union all
select
	GroupCode = S.SubAccCode,
	GroupName = S.Name,
	A.name,
	A.aliasname,
	Documentcode = N.NoteCode, 
	Type = Case N.NoteCatCode When 1 Then '*NR' Else '*NP' End + '-' + RTrim(LTrim(convert(char(6), N.NoteCode))),  
	date = N.duedate, 
	debit = Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = A.AccCode THEN 0 ELSE N.Amount END ELSE CASE WHEN N.AccCode = A.AccCode THEN N.Amount ELSE 0 END END,
	credit= Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = A.AccCode THEN N.Amount ELSE 0 END ELSE CASE WHEN N.AccCode = A.AccCode THEN 0 ELSE N.Amount END END,
	remark = N.Remarks,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=A.acccode and 
				virtualgl.date < :ar_startdate),
	CheckNo = LEFT(N.DocumentNumber, 20),
	VRow=999999,
	N.vouchercode,
	PendingCheque=1
from 
	Notes N, Accounts A, SubAccounts S
where   
	(N.AccCode = A.AccCode OR N.BankAccCode = A.AccCode ) and
	N.Posted = 'N' AND N.Finalized = 'Y' AND
	S.SubAccCode IN (:ar_subacccode) AND
	A.SubCode = S.SubAccCode
UNION ALL
select
	GroupCode = S.SubAccCode,
	GroupName = S.Name,
	A.name,
	A.aliasname,
	documentcode=0, 
	type = '', 
	date = :ar_enddate, 
	debit = 0,
	credit= 0,
	remark = '',
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=A.acccode and 
				virtualgl.date < :ar_startdate),
	CheckNo='',
	VRow=0,
	vouchercode=Null,
	Pendingcheque=0
from    
	Accounts A, SubAccounts S
WHERE 
	S.SubAccCode IN (:ar_subacccode) AND
	S.SubAccCode = A.SubCode AND
	A.acccode NOT IN 
			(SELECT DISTINCT VGL.AccCode 
			FROM VirtualGL VGL
			WHERE VGL.Date BETWEEN :ar_startdate AND :ar_enddate AND 
				VGL.AccCode IN 
					(SELECT AC.AccCode FROM Accounts AC, SubAccounts SA 
					WHERE AC.SubCode = SA.SubAcccode AND SA.SubAccCode IN (:ar_subacccode))
			UNION ALL
			SELECT DISTINCT N.AccCode 
			FROM Notes N
			WHERE N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN 
					(SELECT AC.AccCode FROM Accounts AC, SubAccounts SA 
					WHERE AC.SubCode = SA.SubAcccode AND SA.SubAccCode IN (:ar_subacccode))
			UNION ALL
			SELECT DISTINCT N.BankAccCode 
			FROM Notes N
			WHERE N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN 
					(SELECT AC.AccCode FROM Accounts AC, SubAccounts SA 
					WHERE AC.SubCode = SA.SubAcccode AND SA.SubAccCode IN (:ar_subacccode))) and
	A.acccode IN 
			(select acccode 
			from virtualgl 
			where virtualgl.date < :ar_startdate
			group by acccode
			having isnull(sum(debit-credit), 0) <> 0)
order by groupname, A.name, A.aliasname, date, type, VRow
"
  arguments=(("ar_subacccode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
