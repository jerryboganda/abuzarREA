SELECT  
	DocumentCode=P.ServicePRInvCode,
	SuppInvCode=P.ref1,
	SuppInvDate=NULL, 
	GRN=P.Ref2, 
	Type='RP-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.ServicePRInvCode))),
	Date = P.Date, 
	Remark = (SELECT I.NAME FROM Service I WHERE I.ServiceCode = D.ServiceCode),
	Name=S.Name,
	Cash = 'N',
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=S.AccCode AND 
				VirtualGL.date < :ar_startdate),
	CheckNo=ref3,
	VRow=MAX(D.RowID),
	VoucherCode=P.ServicePRInvCode,
	Header=P.HeaderNo,
	Qty=SUM(D.Qty),
	Bonus=0,
	Rate=MAX(D.Price),
	GrossValue=SUM(D.Qty * D.Price),
	Discount=
		SUM(D.Qty * (D.Price - D.serviceflatdisc) * 0.01 * D.discperc) + 
		SUM(D.qty * (D.Price - D.serviceflatdisc) * (1- (0.01 * D.discperc)) * (0.01 * P.discperc)),
	ItemPurTax=0.00,
	ItemValue=SUM(D.qty * (D.Price - D.serviceflatdisc) * (1- (0.01 * D.discperc)) * (1- (0.01 * P.discperc))),
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.RowID) WHEN (SELECT MAX(PD.ROWID) 
		FROM ServicePRDetail PD 
		WHERE PD.ServicePRInvCode=P.ServicePRInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= 0.00,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(PD.RowID) 
		FROM ServicePRDetail PD 
		WHERE PD.ServicePRInvCode=P.ServicePRInvCode) THEN ISNULL(P.MiscCharges, 0) - ISNULL(P.FlatDisc, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	ServicePRHeader p,	 
	ServicePRDetail D,
	(SELECT 
		P.ServicePRInvCode, 
		RoundingDiff=
		ROUND(
			SUM((D.price - D.serviceflatdisc) * D.qty * (1- D.discperc * .01) * (1- (.01 * P.discperc)) + P.misccharges - P.flatdisc), 0) -
		(SUM((D.price - D.serviceflatdisc) * D.qty * (1- D.discperc * .01) * (1- (.01 * P.discperc)) + P.misccharges - P.flatdisc)),
		NetAmt=	ROUND(SUM((D.price - D.serviceflatdisc) * D.qty * (1- D.discperc * .01) * (1- (.01 * P.discperc)) + P.misccharges - P.flatdisc), 0)
	FROM ServicePRHeader P, ServicePRDetail D
	WHERE 
		P.Posted = 'Y' AND 
		P.ServicePRInvCode = D.ServicePRInvCode AND
		P.SuppCode IN (:ai_Suppcode) AND
		P.date BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		P.ServicePRInvCode,
		P.DiscPerc,
		P.FlatDisc,
		P.DiscPerc,
		P.MiscCharges) T
WHERE   
	P.Posted = 'Y' AND 
	P.ServicePRInvCode = D.ServicePRInvCode AND P.ServicePRInvCode = T.ServicePRInvCode AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	P.date BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	P.ServicePRInvCode,
	P.HeaderNo,
	D.ServiceCode,
	P.SuppCode, 
	P.Date,
	P.DiscPerc,
	P.MiscCharges,
	P.FlatDisc,
	P.Ref1,
	P.Ref2,
	P.Ref3,
	S.AccCode,
	S.AliasName,
	S.Name,
	S.Address1,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
