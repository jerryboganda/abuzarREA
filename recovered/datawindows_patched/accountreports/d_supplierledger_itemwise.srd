SELECT
	V.documentcode, 
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type = V.documenttype + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), V.documentcode))), 
	Date = V.Date, 
	Remark = V.Remarks,
	Name=S.Name,
	Cash = CASE ISNULL(V.AlternateAccCode, -1) WHEN -1 THEN 'N' ELSE 'Y' END,
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=S.AccCode AND 
				VirtualGL.date < :ar_startdate),
	V.CheckNo,
	V.VRow,
	V.VoucherCode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvPurTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit=V.Debit,
	Credit=V.Credit,
	Others= 0,
	PendingCheque=0
FROM
  VirtualGL V,
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S

	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S
WHERE   
	V.DocumentType NOT IN ('PV', 'PR','SP', 'RP') AND
	(V.AccCode = S.AccCode OR V.AlternateAccCode = S.AccCode ) and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
UNION ALL
SELECT
	V.DocumentCode, 
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type = V.DocumentType + '-' + RTRIM(LTRIM(CONVERT(CHAR(7), V.DocumentCode))), 
	Date = V.Date, 
	Remark = CASE debit 
			WHEN 0 THEN 'Cash Received Against Pur Ret. # '
			ELSE 'Cash Paid Against Pur. Inv. # '
			END + RTRIM(LTRIM(CONVERT(CHAR(7), V.DocumentCode))),
	S.Name,
	Cash = CASE ISNULL(v.AlternateAccCode, -1) WHEN -1 THEN 'N' ELSE 'Y' END,
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	Virtualgl.AccCode=S.AccCode and 
				VirtualGL.Date < :ar_startdate),
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvPurTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit = V.Credit,
	Credit= V.Debit,
	Others=0,
	PendingCheque=0
FROM 
	VirtualGL V,
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S
WHERE   
	V.DocumentType NOT IN ('PV', 'PR','SP','RP') AND
	(V.AlternateAccCode = S.AccCode ) AND
	V.date     >= :ar_startdate AND
	V.date     <= :ar_enddate
UNION ALL
SELECT
	documentcode = N.NoteCode, 
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type = Case N.NoteCatCode When 1 Then '*NR' Else '*NP' End + '-' + RTrim(LTrim(convert(char(6), N.NoteCode))),  
	date = N.duedate, 
	remark = N.Remarks,
	S.name,
	cash = 'N',
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=S.AccCode AND 
				VirtualGL.date < :ar_startdate),
	CheckNo = LEFT(N.DocumentNumber, 20),
	VRow=999999,
	VoucherCode=N.vouchercode,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvPurTax=0
	RoundingDiff=0*/
	NetAmt=0,
	debit = Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = S.AccCode THEN 0 ELSE N.Amount END ELSE CASE WHEN N.AccCode = S.AccCode THEN N.Amount ELSE 0 END END,
	credit= Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = S.AccCode THEN N.Amount ELSE 0 END ELSE CASE WHEN N.AccCode = S.AccCode THEN 0 ELSE N.Amount END END,
	Others= 0,
	PendingCheque=1
FROM
	Notes N,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1,sp.address2,sp.city
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ai_Suppcode) and 
			a.acccode = sp.suppcode) S
WHERE   
	(N.AccCode = S.AccCode OR N.BankAccCode = S.AccCode ) and
	N.Posted = 'N' AND N.Finalized = 'Y'
UNION ALL
SELECT
	DocumentCode=NULL,
	SuppInvCode=NULL, 
	SuppInvDate=NULL, 
	GRN=NULL,
	Type = NULL,
	Date = :ar_enddate, 
	remark = 'OPENING BALANCE',
	S.Name,
	Cash = 'N',
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	Virtualgl.AccCode=S.AccCode and 
				VirtualGL.Date < :ar_startdate),
	CheckNo=NULL,
	VRow=NULL,
	VoucherCode=NULL,
	Header=NULL,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=0
	FlatDisc=0
	InvPurTax=0
	RoundingDiff=0*/
	NetAmt=0,
	Debit = 0,
	Credit= 0,
	Others=0,
	PendingCheque=0
from
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ai_Suppcode) and 
			a.acccode = sp.suppcode AND 
			a.acccode NOT IN 
			(SELECT DISTINCT VGL.AccCode 
			FROM VirtualGL VGL 
			WHERE VGL.Date BETWEEN :ar_startdate AND :ar_enddate AND 
				VGL.AccCode IN (:ai_Suppcode)
			UNION ALL
			SELECT DISTINCT N.AccCode 
			FROM Notes N
			WHERE N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN (:ai_Suppcode)
			UNION ALL
			SELECT DISTINCT N.BankAccCode 
			FROM Notes N
			WHERE N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN (:ai_Suppcode)) ) S
ORDER BY
	Name, 
	AliasName, 
	Date, 
	Type, 
	VRow"
  arguments=(("ai_Suppcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
