release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1260 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=218 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=char(100) updatewhereclause=yes name=suppinvcode dbname="SuppInvCode"  )
column=(type=datetime updatewhereclause=yes name=suppinvdate dbname="SuppInvDate"  )
column=(type=char(100) updatewhereclause=yes name=grn dbname="GRN"  )
column=(type=char(28) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(100) updatewhereclause=yes name=description dbname="Remark"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Name"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="Cash"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Purledger.AliasName"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="Address"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="OpenBalance"  )
column=(type=char(60) updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=decimal(0) updatewhereclause=yes name=vrow dbname="VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VoucherCode"  )
column=(type=long updatewhereclause=yes name=header dbname="Header"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(4) updatewhereclause=yes name=grossvalue dbname="GrossValue"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(6) updatewhereclause=yes name=itempurtax dbname="ItemPurTax"  )
column=(type=decimal(6) updatewhereclause=yes name=itemvalue dbname="ItemValue"  )
column=(type=decimal(6) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(6) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=decimal(6) updatewhereclause=yes name=others dbname="Others"  )
column=(type=long updatewhereclause=yes name=pendingcheque dbname="PendingCheque"  )
 retrieve="SELECT  
	DocumentCode=P.PurInvCode,
	SuppInvCode=P.SuppInvCode,
	SuppInvDate=P.SuppInvDate, 
	GRN=P.GRN, 
	Type='PV-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Date = P.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Name=S.Name,
	Cash = CASE P.PurCatCode WHEN 1 THEN 'Y' WHEN 7 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=S.AccCode AND 
				VirtualGL.date < :ar_startdate),
	CheckNo=NULL,
	VRow=MAX(D.PurRowID),
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=SUM(D.LooseQty+PackQty),
	Bonus=SUM(D.BonusQty),
	Rate=MAX(D.PurPrice),
	GrossValue=SUM((D.LooseQty + D.PackQty) * D.PurPrice),
	Discount=
		SUM((D.looseqty+D.PackQty) * D.Purprice * (.01 * D.discperc)) + 
		SUM((D.looseqty+D.PackQty) * D.Purprice * (1-(.01*D.discperc)) * (.01 * P.discperc)),
	ItemPurTax=SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Purprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01),
	ItemValue=SUM((D.PackQty + D.LooseQty) * D.PurPrice) - 
		SUM((D.looseqty + D.PackQty) * D.Purprice * (.01 * D.discperc) +
				((D.looseqty + D.PackQty) * D.Purprice * (1-(.01*D.discperc)) * (.01 * P.discperc))) +  
		SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM( (D.PackQty + D.looseqty) * D.Purprice * (1 - (.01 * D.discperc)) * D.gstperc * .01),
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.PurRowID) WHEN (SELECT MAX(PD.PurROWID) 
		FROM PurDetail PD 
		WHERE PD.PurInvCode=P.PurInvCode) THEN CASE P.PurCatCode WHEN 1 THEN T.NetAmt WHEN 7 THEN T.NetAmt ELSE 0 END ELSE 0 END,
	Credit= CASE MAX(D.PurRowID) WHEN (SELECT MAX(PD.PurROWID) 
		FROM PurDetail PD 
		WHERE PD.PurInvCode=P.PurInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.PurRowID) WHEN (SELECT MAX(PD.PurROWID) 
		FROM PurDetail PD 
		WHERE PD.PurInvCode=P.PurInvCode) THEN ISNULL(P.MiscCharges, 0) - ISNULL(P.FlatDisc, 0) + ISNULL(T.InvPurTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	PurLedger p,	 
	PurDetail D,
	(SELECT 
		P.PurInvCode, 
		RoundingDiff=
		ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.purprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.purprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0) -
		(SUM((D.looseqty + D.packqty + D.bonusqty) * D.unitsalestax) +
		SUM((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc)) * D.gstperc * .01) +
			ROUND( (SUM(((D.looseqty + D.packqty) * D.Purprice) *
				(1 - (.01 * D.discperc))) * (1- (.01 * P.Discperc)) -
				P.flatdisc) * (P.invgstperc1 * .01), 2) + 
		SUM( ((D.looseqty + D.packqty) * D.Purprice) * 
				 (1 - (.01 * D.discperc))) * (1- (.01 * P.discperc)) + 
			P.misccharges + P.salestax - P.flatdisc),
		InvPurTax=ROUND(SUM((D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Purprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01), 2),
		NetAmt=ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.purprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.purprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.purprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0)
	FROM PurLedger P, PurDetail D
	WHERE 
		P.Posted = 'Y' AND P.AccountFor = 'Y' AND
		P.PurInvCode = D.PurInvCode AND
		P.SuppCode IN (:ai_Suppcode) AND
		P.date     >= :ar_startdate AND
		P.date     <= :ar_enddate
	GROUP BY
		P.PurInvCode,
		P.DiscPerc,
		P.FlatDisc,
		P.InvGSTPerc1,
		P.DiscPerc,
		P.MiscCharges,
		P.SalesTax) T
WHERE   
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.PurInvCode = D.PurInvCode AND P.PurInvCode = T.PurInvCode AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	P.date     >= :ar_startdate AND
	P.date     <= :ar_enddate
GROUP BY 
	P.PurInvCode,
	P.PurCatCode,
	P.HeaderInvNo,
	P.HeaderNo,
	D.ICode,
	P.SuppCode, 
	P.Date,
	P.DiscPerc,
	P.MiscCharges,
	P.SalesTax,
	P.FlatDisc,
	P.InvGstPerc1,
	P.SuppInvCode,
	P.SuppInvDate,
	P.GRN,
	S.AccCode,
	S.AliasName,
	S.Name,
	S.Address1,
	T.InvPurTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	DocumentCode=P.PurInvCode,
	SuppInvCode=P.SuppInvCode,
	SuppInvDate=P.SuppInvDate,
	GRN=P.GRN,
	Type='PV-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Date = P.AmtDate, 
	Remark = 'Cash Paid During Pur #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Name=S.Name,
	Cash = CASE P.PurCatCode WHEN 1 THEN 'Y' WHEN 7 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=S.AccCode AND 
				VirtualGL.date < :ar_startdate),
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = P.Amt,
	Credit= 0,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	PurLedger P
WHERE   
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	P.Amtdate     >= :ar_startdate AND
	P.Amtdate     <= :ar_enddate AND
	P.Amt <> 0 AND P.PurCatcode NOT IN (1,7)
UNION ALL
SELECT  
	DocumentCode=P.PurInvCode,
	SuppInvCode=P.SuppInvCode,
	SuppInvDate=P.SuppInvDate,
	GRN=P.GRN,
	Type='PV-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode))),
	Date = P.AmtDate, 
	Remark = ISNULL(M.Remarks, 'Amount Paid on Pur #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PurInvCode)))),
	Name=S.Name,
	Cash = CASE P.PurCatCode WHEN 1 THEN 'Y' WHEN 7 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=S.AccCode AND 
				VirtualGL.date < :ar_startdate),
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = M.Amount,
	Credit= 0,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	PurLedger P, MasterCashWin M
WHERE   
	M.DocumentType = 'PV' AND
	M.DocumentCode = P.PurInvCode AND
	M.Amount > 0 AND
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	M.Date BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT  
	DocumentCode=P.PrInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='PR-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Date = P.Date, 
	Remark = (SELECT I.NAME FROM Item I WHERE I.ICODE = D.ICode),
	Name=S.Name,
	Cash = CASE P.PrCatCode WHEN 4 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=S.AccCode AND 
				VirtualGL.date < :ar_startdate),
	CheckNo=NULL,
	VRow=MAX(D.PRUTN),
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=-SUM(D.LooseQty+PackQty),
	Bonus=-SUM(D.BonusQty),
	Rate=MAX(D.PrPrice),
	GrossValue=-SUM((D.LooseQty + D.PackQty) * D.PRPrice),
	Discount= -1 *
		(SUM((D.looseqty+D.PackQty) * D.Prprice * (.01 * D.discperc)) + 
		SUM((D.looseqty+D.PackQty) * D.Prprice * (1-(.01*D.discperc)) * (.01 * P.discperc))),
	ItemPurTax= -1 * (SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Prprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01)),
	ItemValue= -1 * (SUM((D.PackQty + D.LooseQty) * D.PrPrice) - 
		SUM((D.looseqty + D.PackQty) * D.Prprice * (.01 * D.discperc) +
				((D.looseqty + D.PackQty) * D.Prprice * (1-(.01*D.discperc)) * (.01 * P.discperc))) +  
		SUM( (D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM( (D.PackQty + D.looseqty) * D.Prprice * (1 - (.01 * D.discperc)) * D.gstperc * .01)),
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.PRUTN) WHEN (SELECT MAX(PD.PRUTN) 
		FROM PrDetail PD 
		WHERE PD.PrInvCode=P.PrInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= CASE MAX(D.PRUTN) WHEN (SELECT MAX(PD.PRUTN) 
		FROM PrDetail PD 
		WHERE PD.PrInvCode=P.PrInvCode) THEN CASE P.PrCatCode WHEN 4 THEN T.NetAmt ELSE 0 END ELSE 0 END,
	Others= CASE MAX(D.PRUTN) WHEN (SELECT MAX(PD.PRUTN) 
		FROM PrDetail PD 
		WHERE PD.PrInvCode=P.PrInvCode) THEN ISNULL(P.MiscCharges, 0) - ISNULL(P.FlatDisc, 0) + ISNULL(T.InvPurTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	PrLedger p,	 
	PrDetail D,
	(SELECT 
		P.PrInvCode, 
		RoundingDiff=
		ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.prprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.prprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0) -
		(SUM((D.looseqty + D.packqty + D.bonusqty) * D.unitsalestax) +
		SUM((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc)) * D.gstperc * .01) +
			ROUND( (SUM(((D.looseqty + D.packqty) * D.Prprice) *
				(1 - (.01 * D.discperc))) * (1- (.01 * P.Discperc)) -
				P.flatdisc) * (P.invgstperc1 * .01), 2) + 
		SUM( ((D.looseqty + D.packqty) * D.Prprice) * 
				 (1 - (.01 * D.discperc))) * (1- (.01 * P.discperc)) + 
			P.misccharges + P.salestax - P.flatdisc),
		InvPurTax=ROUND(SUM((D.PackQty + D.looseqty + D.bonusqty) * D.UnitSalesTax) + 
		SUM(((D.PackQty + D.looseqty) * D.Prprice) * (1 - (.01 * D.discperc)) * D.gstperc * .01), 2),
		NetAmt=ROUND(
			SUM((D.looseqty + D.packqty + D.bonusqty) *
				D.unitsalestax) +
			SUM(ROUND((D.looseqty + D.packqty) * D.prprice * 
				(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND((SUM(((D.looseqty + D.packqty) * D.prprice) * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) - P.flatdisc) * (P.invgstperc1 * .01), 2), 0) +
			ROUND(SUM((D.looseqty + D.packqty) * D.prprice * (1 - (.01 * D.discperc))) * 
				(1- (.01 * P.discperc)) + P.misccharges + P.salestax - P.flatdisc, 0)
	FROM PrLedger P, PrDetail D
	WHERE 
		P.Posted = 'Y' AND P.AccountFor = 'Y' AND
		P.PrInvCode = D.PrInvCode AND
		P.SuppCode IN (:ai_Suppcode) AND
		P.date     >= :ar_startdate AND
		P.date     <= :ar_enddate
	GROUP BY
		P.PrInvCode,
		P.DiscPerc,
		P.FlatDisc,
		P.InvGSTPerc1,
		P.DiscPerc,
		P.MiscCharges,
		P.SalesTax) T
WHERE   
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.PrInvCode = D.PrInvCode AND P.PrInvCode = T.PrInvCode AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	P.date     >= :ar_startdate AND
	P.date     <= :ar_enddate
GROUP BY 
	P.PrInvCode,
	P.PrCatCode,
	P.HeaderInvNo,
	P.HeaderNo,
	D.ICode,
	P.SuppCode, 
	P.Date,
	P.DiscPerc,
	P.MiscCharges,
	P.SalesTax,
	P.FlatDisc,
	P.InvGstPerc1,
	S.AccCode,
	S.AliasName,
	S.Name,
	S.Address1,
	T.InvPurTax,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	DocumentCode=P.PrInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='PR-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Date = P.AmtDate, 
	Remark = 'Cash Recvd. During P/Ret #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Name=S.Name,
	Cash = CASE P.PrCatCode WHEN 4 THEN 'Y' ELSE 'N' END,
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=S.AccCode AND 
				VirtualGL.date < :ar_startdate),
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = 0,
	Credit= P.Amt,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	PrLedger P
WHERE   
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	P.Amtdate     >= :ar_startdate AND
	P.Amtdate     <= :ar_enddate AND
	P.Amt <> 0 AND P.PrCatcode NOT IN (4)
UNION ALL
SELECT  
	DocumentCode=P.PrInvCode,
	SuppInvCode=NULL,
	SuppInvDate=NULL,
	GRN=NULL,
	Type='PR-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode))),
	Date = P.AmtDate, 
	Remark = ISNULL(M.Remarks, 'Amt Received on P/R #:' + RTRIM(LTRIM(CONVERT(CHAR(7), P.PrInvCode)))),
	Name=S.Name,
	Cash = 'N',
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=S.AccCode AND 
				VirtualGL.date < :ar_startdate),
	CheckNo=P.AmtReference,
	VRow=9999999,
	VoucherCode=P.HeaderInvNo,
	Header=P.HeaderNo,
	Qty=0,
	Bonus=0,
	Rate=0,
	GrossValue=0,
	Discount=0,
	ItemPurTax=0,
	ItemValue=0,
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=0,
	Debit = 0,
	Credit= M.Amount,
	Others= 0,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	PrLedger P, MasterCashWin M
WHERE   
	M.DocumentType = 'PR' AND
	M.DocumentCode = P.PrInvCode AND
	M.Amount > 0 AND
	P.Posted = 'Y' AND P.AccountFor = 'Y' AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	M.Date BETWEEN :ar_startdate AND :ar_enddate
UNION ALL
SELECT  
	DocumentCode=P.ServicePurInvCode,
	SuppInvCode=P.ref1,
	SuppInvDate=NULL, 
	GRN=P.Ref2, 
	Type='SP-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.ServicePurInvCode))),
	Date = P.Date, 
	Remark = (SELECT I.NAME FROM Service I WHERE I.ServiceCode = D.ServiceCode),
	Name=S.Name,
	Cash = 'N',
	S.AliasName,
	Address=S.Address1,
	OpenBalance=(SELECT ISNULL(SUM(Debit-Credit), 0) FROM VirtualGL 
			WHERE	VirtualGL.AccCode=S.AccCode AND 
				VirtualGL.date < :ar_startdate),
	CheckNo=ref3,
	VRow=MAX(D.RowID),
	VoucherCode=P.ServicePurInvCode,
	Header=P.HeaderNo,
	Qty=SUM(D.Qty),
	Bonus=0,
	Rate=MAX(D.Price),
	GrossValue=SUM(D.Qty * D.Price),
	Discount=
		SUM(D.Qty * (D.Price - D.serviceflatdisc) * 0.01 * D.discperc) + 
		SUM(D.qty * (D.Price - D.serviceflatdisc) * (1- (0.01 * D.discperc)) * (0.01 * P.discperc)),
	ItemPurTax=0.00,
	ItemValue=SUM(D.qty * (D.Price - D.serviceflatdisc) * (1- (0.01 * D.discperc)) * (1- (0.01 * P.discperc))),
/*	MiscCharges=P.MiscCharges,
	FlatDisc=P.FlatDisc,
	InvPurTax=T.InvPurTax,
	RoundingDiff=T.RoundingDiff,*/
	NetAmt=T.NetAmt,
	Debit = 0.00,
	Credit= CASE MAX(D.RowID) WHEN (SELECT MAX(PD.RowID) 
		FROM ServicePurDetail PD 
		WHERE PD.ServicePurInvCode=P.ServicePurInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(PD.RowID) 
		FROM ServicePurDetail PD 
		WHERE PD.ServicePurInvCode=P.ServicePurInvCode) THEN ISNULL(P.MiscCharges, 0) - ISNULL(P.FlatDisc, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	PendingCheque=0
FROM
	(SELECT	A.AliasName, A.AccCode, A.Name, S.Address1
	FROM	Accounts A, Supplier S
	WHERE	A.AccCode IN (:ai_Suppcode) AND 
			A.AccCode = S.SuppCode) S,
	ServicePurHeader p,	 
	ServicePurDetail D,
	(SELECT 
		P.ServicePurInvCode, 
		RoundingDiff=	ROUND(
			SUM((D.price - D.serviceflatdisc) * D.qty * (1- D.discperc * .01) * (1- (.01 * P.discperc)) + P.misccharges - P.flatdisc), 0) -
			(SUM((D.price - D.serviceflatdisc) * D.qty * (1- D.discperc * .01) * (1- (.01 * P.discperc)) + P.misccharges - P.flatdisc)),
		NetAmt=ROUND(SUM((D.price - D.serviceflatdisc) * D.qty * (1- D.discperc * .01) * (1- (.01 * P.discperc)) + P.misccharges - P.flatdisc), 0)
	FROM ServicePurHeader P, ServicePurDetail D
	WHERE 
		P.Posted = 'Y' AND 
		P.ServicePurInvCode = D.ServicePurInvCode AND
		P.SuppCode IN (:ai_Suppcode) AND
		P.date BETWEEN :ar_startdate AND :ar_enddate
	GROUP BY
		P.ServicePurInvCode,
		P.DiscPerc,
		P.FlatDisc,
		P.DiscPerc,
		P.MiscCharges) T
WHERE   
	P.Posted = 'Y' AND 
	P.ServicePurInvCode = D.ServicePurInvCode AND P.ServicePurInvCode = T.ServicePurInvCode AND
	P.SuppCode = S.AccCode AND
	P.SuppCode IN (:ai_Suppcode) AND
	P.date BETWEEN :ar_startdate AND :ar_enddate
GROUP BY 
	P.ServicePurInvCode,
	P.HeaderNo,
	D.ServiceCode,
	P.SuppCode, 
	P.Date,
	P.DiscPerc,
	P.MiscCharges,
	P.FlatDisc,
	P.Ref1,
	P.Ref2,
	P.Ref3,
	S.AccCode,
	S.AliasName,
	S.Name,
	S.Address1,
	T.NetAmt,
	T.RoundingDiff
UNION ALL
SELECT  
	DocumentCode=P.ServicePurInvCode,
	SuppInvCode=P.ref1,
	SuppInvDate=NULL, 
	GRN=P.Ref2, 
	Type='SP-' + RTRIM(LTRIM(CONVERT(CHAR(7), P.ServicePurInvCode))),
