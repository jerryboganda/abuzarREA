release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1645 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=177 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=customer dbname="name1"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="value1"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="value2"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(30) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="salesperson"  )
 retrieve="SELECT 
	name1, 
	value1=CASE WHEN Value1 > 0 THEN Value1 ELSE 0 END, 
	value2=CASE WHEN Value1 < 0 THEN ABS(Value1) ELSE 0 END, 
	AliasName,  
	Category, 
	Area, 
	AreaCode,
	salesperson=(select name from salesman S where S.salesmancode=A.SalesManCode)
FROM
	(SELECT 
		A.Name AS name1, 
		Sum(V.Balance) AS value1, 
		A.AliasName, 
		Category=CC.Name, 
		Area=Area.Name, 
		AreaCode=Area.AreaCode,
		salesmancode=max(C.SalesManCode)
	FROM
		Accounts A
		LEFT OUTER JOIN 
		(SELECT T.AccCode, Sum(T.Debit - T.Credit) AS Balance 
		FROM VirtualGL T 
		WHERE T.Date <= :ar_Date
		GROUP BY T.AccCode) AS V ON (A.AccCode = V.AccCode),
		SubAccounts S,
		Customer C,
		CustomerCategory CC,
		Area
	WHERE 
		A.SubCode = S.SubAccCode AND 
		S.SubAccCode = 3 AND 
		(A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'Y' END OR
		A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'N' END) AND
		A.AccCode = C.CustCode AND 
		C.CustCatCode = CC.CustCatCode AND
		C.CustCode IN (:ar_custcode) AND 
		C.AreaCode = Area.AreaCode
	GROUP BY 
		A.AccCode, A.Name, A.AliasName, Area.Name, Area.AreaCode, CC.Name) A
"
  arguments=(("ar_custcode", numberlist), ("ar_date", datetime), ("ar_restricted", number))
 sort="customer A"
)
