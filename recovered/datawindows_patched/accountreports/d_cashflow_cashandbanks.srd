release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1658 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=225 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=183 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes name=glvochcode dbname="glvochcode"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes initial="0" name=credit dbname="credit"  )
column=(type=datetime updatewhereclause=yes initial="today" name=date dbname="date"  )
column=(type=char(100) updatewhereclause=yes name=type dbname="type"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(100) updatewhereclause=yes name=acc dbname="acc"  )
column=(type=char(100) updatewhereclause=yes name=accounthead dbname="accounthead"  )
column=(type=long updatewhereclause=yes name=priority dbname="priority"  )
 retrieve="SELECT /*opening cash/bank in hand balance*/
	glvochcode=Null,
	debit=CASE WHEN b.bal >= 0 THEN b.bal ELSE 0 END,
	credit=CASE WHEN b.bal >= 0 THEN 0 ELSE ABS(b.bal) END,
	date = :ad_startDate, 
	type = SPACE(100),
	remarks='Opening Balance',
	acc=SPACE(100),
	accounthead=SPACE(100),
	priority=-1
FROM
	(SELECT bal=sum(Debit-Credit) 
	FROM VirtualGl
	WHERE
		acccode in 
			(select acccode from accounts where subcode IN 
					(SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')))) and
		date < :ad_startDate) B
UNION ALL
SELECT /*CashierShift  entry for excess / short cash in respective account for which the shift is made*/
	glvochcode=CS.CashierShiftCode,
	debit=CASE WHEN CS.DiffAmt > 0 THEN ABS(CS.DiffAmt) ELSE 0 END,
	credit=CASE WHEN CS.DiffAmt > 0 THEN 0.00 ELSE ABS(CS.DiffAmt) END,
	date = CS.ClosedOn,
	type = 'CSHIFT-' + RTRIM(LTRIM(CONVERT(VARCHAR(7), CS.CashierShiftCode))),
	remarks=CS.Remarks,
	acc=(SELECT name FROM accounts WHERE accounts.acccode = CASE WHEN CS.DiffAmt > 0 THEN CS.CashAccCode ELSE CS.DiffTransferedTo END),
	accounthead=(SELECT name FROM accounts WHERE accounts.acccode = CASE WHEN CS.DiffAmt > 0 THEN CS.DiffTransferedTo ELSE CS.CashAccCode END),
	priority=0
FROM
	CashierShift CS
WHERE
	CS.DiffAmt <> 0 AND
	CS.ShiftStatus = 'C' AND
	CS.CashAccCode in 
			(select acccode from accounts where subcode IN 
					(SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')))) and
	CS.ClosedOn >= :ad_StartDate and
	CS.ClosedOn <= :ad_endDate
UNION ALL
SELECT /*CashierShift entry for amount transferred account if respective account is used for amount transfer*/
	glvochcode=CS.CashierShiftCode,
	debit=CS.AmtTransfered,
	credit=0.00,
	date = CS.ClosedOn,
	type = 'CSHIFT-' + RTRIM(LTRIM(CONVERT(VARCHAR(7), CS.CashierShiftCode))),
	remarks=CS.Remarks,
	acc=(SELECT name FROM accounts WHERE accounts.acccode = CS.AmtTransferedTo),
	accounthead=(SELECT name FROM accounts WHERE accounts.acccode = CS.CashAccCode),
	priority=0
FROM
	CashierShift CS
WHERE
	CS.AmtTransfered > 0 AND
	CS.ShiftStatus = 'C' AND
	CS.AmtTransferedTo in 
			(select acccode from accounts where subcode IN 
					(SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')))) and
	CS.ClosedOn >= :ad_StartDate and
	CS.ClosedOn <= :ad_endDate
UNION ALL
SELECT /*CashierShift entry for amount transferred account if respective account is used for amount transfer*/
	glvochcode=CS.CashierShiftCode,
	debit=0.00,
	credit=CS.AmtTransfered,
	date = CS.ClosedOn,
	type = 'CSHIFT-' + RTRIM(LTRIM(CONVERT(VARCHAR(7), CS.CashierShiftCode))),
	remarks=CS.Remarks,
	acc=(SELECT name FROM accounts WHERE accounts.acccode = CS.CashAccCode),
	accounthead=(SELECT name FROM accounts WHERE accounts.acccode = CS.AmtTransferedTo),
	priority=0
FROM
	CashierShift CS
WHERE
	CS.AmtTransfered > 0 AND
	CS.ShiftStatus = 'C' AND
	CS.AmtTransferedTo in 
			(select acccode from accounts where subcode IN 
					(SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')))) and
	CS.ClosedOn >= :ad_StartDate and
	CS.ClosedOn <= :ad_endDate
UNION ALL
SELECT /*Cash/Bank Transaction Details debit=credit and credit=debit*/
	glvochcode=h.glvochcode,
	debit=d.credit,
	credit=d.debit,
	date = h.date,
	type = RTRIM(LTRIM(VC.SHORTNAME)) + '-' + RTRIM(LTRIM(CONVERT(VARCHAR(7), h.glvochcode))),
	remarks=d.remarks,
	acc=(SELECT name FROM accounts WHERE accounts.acccode = h.acccode),
	accounthead=(SELECT name FROM accounts WHERE accounts.acccode = d.acccode),
	priority=0
FROM
	glheader h,
	gldetail d,
	vochercategory vc,
	accounts a
WHERE
	h.posted = 'Y' and
	h.glvochcode = d.glvochcode and
	h.vochcatcode = vc.vochcatcode and
	vc.journalvoucher = 0 and
	h.acccode in (select acccode from accounts where subcode IN 
							(SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')))) and
	h.acccode <> d.acccode and 
	d.acccode = a.acccode and
	h.date >= :ad_StartDate and
	h.date <= :ad_endDate
UNION ALL
SELECT /*cash/bank transaction involving cash/bank in detail (contra impact)*/
	glvochcode=h.glvochcode,
	debit=d.debit,
	credit=d.credit,
	date = h.date,
	type = RTRIM(LTRIM(VC.SHORTNAME)) + '-' + RTRIM(LTRIM(CONVERT(VARCHAR(7), h.glvochcode))),
	remarks=d.remarks,
	acc=(SELECT name FROM accounts WHERE accounts.acccode = d.acccode),
	accounthead=(SELECT name FROM accounts WHERE accounts.acccode = h.acccode),
	priority=0
FROM
	glheader h,
	gldetail d,
	vochercategory vc,
	accounts a
WHERE
	h.posted = 'Y' and
	h.glvochcode = d.glvochcode and
	h.vochcatcode = vc.vochcatcode and
	vc.journalvoucher = 0 and
	h.acccode in (select acccode from accounts where subcode IN 
							(SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')))) and
	h.acccode <> d.acccode and 
	a.subcode in (SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub'), LOWER('GT_BankSub'))) and
	d.acccode = a.acccode and
	h.date >= :ad_StartDate and
	h.date <= :ad_endDate
UNION ALL
SELECT /*cash/bank transaction involving cash/bank in detail (contra impact)*/
	glvochcode=h.glvochcode,
	debit=d.debit,
	credit=d.credit,
	date = h.date,
	type = RTRIM(LTRIM(VC.SHORTNAME)) + '-' + RTRIM(LTRIM(CONVERT(VARCHAR(7), h.glvochcode))),
	remarks=d.remarks,
	acc=(SELECT name FROM accounts WHERE accounts.acccode = d.acccode),
	accounthead=(SELECT name FROM accounts WHERE accounts.acccode = h.acccode),
	priority=0
FROM
	glheader h,
	gldetail d,
	vochercategory vc,
	accounts a
WHERE
	h.posted = 'Y' and
	h.glvochcode = d.glvochcode and
	h.vochcatcode = vc.vochcatcode and
	vc.journalvoucher = 0 and
	h.acccode not in (select acccode from accounts where subcode IN 
							(SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')))) and
	a.subcode in (SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub'), LOWER('GT_BankSub'))) and
	d.acccode = a.acccode and
	h.date >= :ad_StartDate and
	h.date <= :ad_endDate
UNION ALL
SELECT /*debit/credit adjustment for cash/bank accounts using JVs*/
	glvochcode=h.glvochcode,
	debit=d.debit,
	credit=d.credit,
	date = h.date,
	type = RTRIM(LTRIM(VC.SHORTNAME)) + '-' + RTRIM(LTRIM(CONVERT(VARCHAR(7), h.glvochcode))),
	remarks=d.remarks,
	acc='',
	accounthead=(SELECT name FROM accounts WHERE accounts.acccode = d.acccode),
	priority=0
FROM
	glheader h,
	gldetail d,
	vochercategory vc
WHERE
	h.posted = 'Y' and
	h.glvochcode = d.glvochcode and
	h.vochcatcode = vc.vochcatcode and
	vc.journalvoucher = 1 and
 	d.acccode IN (Select a.acccode from accounts a where a.subcode IN 
						(select code from global where lower(name) in (lower('GT_CashSub'), lower('GT_BankSub')))) and 
	h.date >= :ad_StartDate and
	h.date <= :ad_endDate
UNION ALL
SELECT 
	glvochcode=NULL,
	debit = ISNULL(SUM(S.Amt), 0),
	credit = 0,
	date = :ad_EndDate,
	type = 'CSH-SALE',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(SaleInvCode) FROM saleledger WHERE saleledger.cashacccode = s.cashacccode and  salecatcode = 3 and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(SaleInvCode) FROM saleledger WHERE saleledger.cashacccode = s.cashacccode and  salecatcode = 3 and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(SaleInvCode) FROM saleledger WHERE saleledger.cashacccode = s.cashacccode and  salecatcode = 3 and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=(SELECT name FROM accounts WHERE S.cashacccode=accounts.acccode),
	accounthead='Cash Sale for the Period',
	priority=1
FROM
	(SELECT 
		h.cashacccode,
		amt=ISNULL(Round(SUM(d.looseqty * d.unitsalestax) + 
			SUM(ROUND( (d.looseqty * 
				(d.saleprice - d.itemflatdisc)) *
				(1 - (.01 * d.discperc)) * 
				d.gstperc * .01, 2)) +
			ROUND( (SUM((d.looseqty * 
				(d.saleprice - d.itemflatdisc)) *
				(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) -
				h.flatdisc) * (h.invgstperc1 * .01), 2), 0) +
			Round( SUM((d.looseqty * (d.saleprice - d.itemflatdisc)) *
				(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + 
				h.misccharges + h.salestax - h.flatdisc, 0), 0)
	FROM
		saleledger h,
		saledetail d
	WHERE
		h.saleinvcode = d.saleinvcode and
		h.salecatcode = 3 and
		h.posted = 'Y' and 
		h.accountfor='Y' and
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate
	GROUP BY h.saleinvcode,
		 h.salecatcode, 
		 h.cashacccode,
		 h.date,
		 h.discperc,
		 h.misccharges,
		 h.salestax,
		 h.InvGSTPerc1,
		 h.flatdisc) S 
GROUP BY S.cashacccode
HAVING SUM(S.Amt) <> 0
UNION ALL
SELECT 
	glvochcode=NULL,
	debit = ISNULL(SUM(S.Amt), 0),
	credit = 0,
	date = :ad_EndDate,
	type = 'CR-SALE',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(SaleInvCode) FROM saleledger WHERE saleledger.cashacccode = s.cashacccode and  salecatcode = 1 and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(SaleInvCode) FROM saleledger WHERE saleledger.cashacccode = s.cashacccode and  salecatcode = 1 and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(SaleInvCode) FROM saleledger WHERE saleledger.cashacccode = s.cashacccode and  salecatcode = 1 and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=(SELECT name FROM accounts WHERE S.CashAccCode = accounts.acccode),
	accounthead='Credit Sale (Immediate Cash) for the Period',
	priority=2
FROM
	(SELECT 
			h.cashacccode,
			amt=ISNULL(Round(SUM(d.looseqty * d.unitsalestax) + 
			SUM(ROUND( (d.looseqty * 
				(d.saleprice - d.itemflatdisc)) *
				(1 - (.01 * d.discperc)) * 
				d.gstperc * .01, 2)) +
			ROUND( (SUM((d.looseqty * 
				(d.saleprice - d.itemflatdisc)) *
				(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) -
				h.flatdisc) * (h.invgstperc1 * .01), 2), 0) +
			Round( SUM((d.looseqty * (d.saleprice - d.itemflatdisc)) *
				(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + 
				h.misccharges + h.salestax - h.flatdisc, 0), 0)
	FROM
		saleledger h,
		saledetail d
	WHERE
		h.saleinvcode = d.saleinvcode and
		h.salecatcode = 1 and
		h.posted = 'Y' and 
		h.accountfor='Y' and
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate
	GROUP BY h.saleinvcode,
		 h.salecatcode, 
		 h.cashacccode,
		 h.date,
		 h.discperc,
		 h.misccharges,
		 h.salestax,
		 h.InvGSTPerc1,
		 h.flatdisc) S 
GROUP BY 
	S.cashacccode
HAVING SUM(S.Amt) > 0
UNION ALL
SELECT 
	glvochcode=NULL,
	debit = ISNULL(SUM(S.Amt), 0),
	credit = 0,
	date = :ad_EndDate,
	type = 'CSH-SALE',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(SaleInvCode) FROM saleledger WHERE saleledger.cashacccode = s.cashacccode and  salecatcode in (1,2) and posted = 'Y' and accountfor='Y' and amt <> 0 and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(SaleInvCode) FROM saleledger WHERE saleledger.cashacccode = s.cashacccode and  salecatcode IN (1, 2) and posted = 'Y' and accountfor='Y' and amt <> 0 and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(SaleInvCode) FROM saleledger WHERE saleledger.cashacccode = s.cashacccode and  salecatcode IN (1, 2) and posted = 'Y' and accountfor='Y' and amt <> 0 and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=(SELECT name FROM accounts WHERE S.CashAccCode = accounts.acccode),
	accounthead='Received during credit sale for the Period',
	priority=3
FROM
	(SELECT h.cashacccode, amt=ISNULL(sum(amt), 0) + ISNULL(SUM(h.cashcharged), 0)
	FROM
		saleledger h
	WHERE
		h.salecatcode IN (1, 2) and
		h.posted = 'Y' and 
		h.accountfor='Y' and
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate and 
		(h.paymentacccode in (select acccode from accounts where subcode IN 
							(SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub')))) OR
		h.cashacccode in (select acccode from accounts where subcode IN 
							(SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub')))))
	GROUP BY h.cashacccode) S
GROUP BY
	S.cashacccode
HAVING SUM(S.Amt) > 0
UNION ALL
SELECT 
	glvochcode=NULL,
	Debit  = 0,
	Credit = ISNULL(SUM(S.Amt), 0),
	date = :ad_EndDate,
	type = 'CSH-SR',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(SRInvCode) FROM srledger WHERE srledger.cashacccode = s.cashacccode and   srcatcode = 8 and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(SrInvCode) FROM srledger WHERE srledger.cashacccode = s.cashacccode and  srcatcode = 8 and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(SrInvCode) FROM srledger WHERE srledger.cashacccode = s.cashacccode and  srcatcode = 8 and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=(SELECT name FROM accounts WHERE S.CashAccCode = accounts.acccode),
	accounthead='Cash Sale Return for the Period',
	priority=4
FROM
	(SELECT h.cashacccode, amt=ISNULL(Round(SUM(d.looseqty * d.unitsalestax) + 
			SUM(ROUND( (d.looseqty * d.srprice) * (1 - (.01 * d.discperc)) * d.gstperc * .01, 2)) +
			ROUND( (SUM((d.looseqty * d.srprice) * 	(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) - h.flatdisc) * (h.invgstperc1 * .01), 2), 0) +
			Round( SUM((d.looseqty * d.srprice) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges + h.salestax - h.flatdisc, 0), 0)
	FROM
		srledger h,
		srdetail d
	WHERE
		h.srinvcode = d.srinvcode and
		h.srcatcode = 8 and
		h.posted = 'Y' and
		h.accountfor = 'Y' and
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate
	GROUP BY h.srinvcode,
		 h.cashacccode,
		 h.srcatcode, 
		 h.date,
		 h.discperc,
		 h.misccharges,
		 h.salestax,
		 h.InvGSTPerc1,
		 h.flatdisc) S 
Group BY S.CashAccCode
HAVING SUM(S.Amt) > 0
UNION ALL
SELECT 
	glvochcode=NULL,
	Debit  = 0,
	Credit = ISNULL(SUM(S.Amt), 0),
	date = :ad_EndDate,
	type = 'CR-SR',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(SRInvCode) FROM srledger WHERE srledger.cashacccode = s.cashacccode and   srcatcode = 6 and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(SrInvCode) FROM srledger WHERE srledger.cashacccode = s.cashacccode and  srcatcode = 6 and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(SrInvCode) FROM srledger WHERE srledger.cashacccode = s.cashacccode and  srcatcode = 6 and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=(SELECT name FROM accounts WHERE S.CashAccCode = accounts.acccode),
	accounthead='Credit S/Return (Immediate Cash) for the Period',
	priority=5
FROM
	(SELECT h.cashacccode, amt=ISNULL(Round(SUM(d.looseqty * d.unitsalestax) + 
			SUM(ROUND( (d.looseqty * d.srprice) * (1 - (.01 * d.discperc)) * d.gstperc * .01, 2)) +
			ROUND( (SUM((d.looseqty * d.srprice) * 	(1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) - h.flatdisc) * (h.invgstperc1 * .01), 2), 0) +
			Round( SUM((d.looseqty * d.srprice) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges + h.salestax - h.flatdisc, 0), 0)
	FROM
		srledger h,
		srdetail d
	WHERE
		h.srinvcode = d.srinvcode and
		h.srcatcode = 6 and
		h.posted = 'Y' and 
		h.accountfor='Y' and
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate
	GROUP BY h.srinvcode,
		 h.cashacccode,
		 h.srcatcode, 
		 h.date,
		 h.discperc,
		 h.misccharges,
		 h.salestax,
		 h.InvGSTPerc1,
		 h.flatdisc) S 
GROUP BY S.CashAccCode
HAVING SUM(S.Amt) > 0
UNION ALL
SELECT 
	glvochcode=NULL,
	Debit  = 0,
	Credit = ISNULL(SUM(S.Amt), 0),
	date = :ad_EndDate,
	type = 'CSH-SR',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(SRInvCode) FROM srledger WHERE srledger.cashacccode = s.cashacccode and  srcatcode IN (6, 7) and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(SrInvCode) FROM srledger WHERE srledger.cashacccode = s.cashacccode and  srcatcode IN (6, 7) and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(SrInvCode) FROM srledger WHERE srledger.cashacccode = s.cashacccode and  srcatcode IN (6,7) and posted = 'Y' and accountfor='Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=(SELECT name FROM accounts WHERE s.cashacccode = accounts.acccode),
	accounthead='Paid during Credit S/Return for the Period',
	priority=6
FROM
	(SELECT h.cashacccode, amt=ISNULL(SUM(h.amt), 0)
	FROM
		srledger h
	WHERE
		h.srcatcode IN (6,7) and
		h.posted = 'Y' and 
		h.accountfor='Y' and
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate AND
		h.paymentacccode in (select acccode from accounts where subcode IN 
							(SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub'))))
	GROUP By h.cashacccode) S
GROUP BY
	s.cashacccode
HAVING SUM(S.Amt) > 0
UNION ALL
SELECT 
	glvochcode=NULL,
	Debit  = ISNULL(SUM(S.Amt), 0),
	Credit = 0,
	date = :ad_EndDate,
	type = 'CSH-SVC',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(ServiceInvCode) FROM serviceheader WHERE serviceheader.cashacccode = s.cashacccode and  servicecatcode = 10 and posted = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(ServiceInvCode) FROM serviceheader WHERE serviceheader.cashacccode = s.cashacccode and  servicecatcode = 10 and posted = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(ServiceInvCode) FROM serviceheader WHERE serviceheader.cashacccode = s.cashacccode and  servicecatcode = 10 and posted = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=(SELECT name FROM accounts WHERE s.cashacccode = accounts.acccode),
	accounthead='Cash Service Sales for the Period',
	priority=7
FROM
	(SELECT h.cashacccode, amt=ISNULL(Case 
	  	   When Round(sum((d.qty * d.price) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges - h.flatdisc, 0) IS NULL THEN 0.0
		   Else Round(sum((d.qty * d.price) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges - h.flatdisc, 0)
	 	   End, 0)
	FROM
		serviceheader h, 
		servicedetail d
	WHERE
		h.serviceinvcode = d.serviceinvcode and
		h.servicecatcode = 10 and
		h.posted = 'Y' and
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate
	GROUP BY h.serviceinvcode, h.cashacccode,
		 h.servicecatcode, 
		 h.date,
		 h.discperc,
		 h.misccharges,
		 h.flatdisc) S 
GROUP BY S.cashacccode
HAVING SUM(S.Amt) > 0
UNION ALL
SELECT 
	glvochcode=NULL,
	Debit  = ISNULL(SUM(S.Amt), 0),
	Credit = 0,
	date = :ad_EndDate,
	type = 'CR-SVC',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(ServiceInvCode) FROM serviceheader WHERE serviceheader.cashacccode = s.cashacccode and  servicecatcode = 12 and posted = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(ServiceInvCode) FROM serviceheader WHERE serviceheader.cashacccode = s.cashacccode and  servicecatcode = 12 and posted = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(ServiceInvCode) FROM serviceheader WHERE serviceheader.cashacccode = s.cashacccode and  servicecatcode = 12 and posted = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=(SELECT name FROM accounts WHERE s.cashacccode = accounts.acccode),
	accounthead='Credit Svc. Sale (Immediate Cash) for the Period',
	priority=8
FROM
	(SELECT h.cashacccode,  amt=ISNULL(Case 
	  	   When Round(sum((d.qty * d.price) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges - h.flatdisc, 0) IS NULL THEN 0.0
		   Else Round(sum((d.qty * d.price) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges - h.flatdisc, 0)
	 	   End, 0)
	FROM
		serviceheader h, 
		servicedetail d
	WHERE
		h.serviceinvcode = d.serviceinvcode and
		h.servicecatcode = 12 and
		h.posted = 'Y' and
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate
	GROUP BY h.serviceinvcode, h.cashacccode,
		 h.servicecatcode, 
		 h.date,
		 h.discperc,
		 h.misccharges,
		 h.flatdisc) S 
GROUP BY s.cashacccode
HAVING SUM(S.Amt) > 0
UNION ALL
SELECT 
	glvochcode=NULL,
	Debit  = 0,
	Credit = ISNULL(SUM(S.Amt), 0),
	date = :ad_EndDate,
	type = 'CSH-SVCR',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(ServiceRInvCode) FROM servicerheader WHERE servicerheader.cashacccode = s.cashacccode and  servicercatcode = 13 and posted = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(ServiceRInvCode) FROM servicerheader WHERE servicerheader.cashacccode = s.cashacccode and   servicercatcode = 13 and posted = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(ServiceRInvCode) FROM servicerheader WHERE servicerheader.cashacccode = s.cashacccode and   servicercatcode = 13 and posted = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=(SELECT name FROM accounts WHERE s.cashacccode = accounts.acccode ),
	accounthead='Cash Svc. S/Return for the Period',
	priority=9
FROM
	(SELECT h.cashacccode, amt=ISNULL(Case 
	  	   When Round(sum((d.qty * d.serviceprice) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges - h.flatdisc, 0) IS NULL THEN 0.0
		   Else Round(sum((d.qty * d.serviceprice) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges - h.flatdisc, 0)
	 	   End, 0)
	FROM
		servicerheader h, 
		servicerdetail d
	WHERE
		h.servicerinvcode = d.servicerinvcode and
		h.servicercatcode = 13 and
		h.posted = 'Y' and
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate
	GROUP BY h.servicerinvcode, h.cashacccode,
		 h.servicercatcode, 
		 h.date,
		 h.discperc,
		 h.misccharges,
		 h.flatdisc) S 
GROUP BY 
	s.cashacccode
HAVING SUM(S.Amt) > 0
UNION ALL
SELECT 
	glvochcode=NULL,
	Debit  = 0,
	Credit = ISNULL(SUM(S.Amt), 0),
	date = :ad_EndDate,
	type = 'CR-SVCR',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(ServiceRInvCode) FROM servicerheader WHERE servicerheader.cashacccode = s.cashacccode and   servicercatcode = 15 and posted = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(ServiceRInvCode) FROM servicerheader WHERE servicerheader.cashacccode = s.cashacccode and   servicercatcode = 15 and posted = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(ServiceRInvCode) FROM servicerheader WHERE servicerheader.cashacccode = s.cashacccode and   servicercatcode = 15 and posted = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=(SELECT name FROM accounts WHERE s.cashacccode = accounts.acccode),
	accounthead='Credit Svc. S/Return (immediate cash) for the Period',
	priority=10
FROM
	(SELECT h.cashacccode, amt=ISNULL(Case 
	  	   When Round(sum((d.qty * d.serviceprice) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges - h.flatdisc, 0) IS NULL THEN 0.0
		   Else Round(sum((d.qty * d.serviceprice) * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges - h.flatdisc, 0)
	 	   End, 0)
	FROM
		servicerheader h, 
		servicerdetail d
	WHERE
		h.servicerinvcode = d.servicerinvcode and
		h.servicercatcode = 15 and
		h.posted = 'Y' and
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate
	GROUP BY h.servicerinvcode, h.cashacccode, 
		 h.servicercatcode, 
		 h.date,
		 h.discperc,
		 h.misccharges,
		 h.flatdisc) S 
GROUP BY
	s.cashacccode 
HAVING SUM(S.Amt) > 0
UNION ALL
SELECT 
	glvochcode=NULL,
	Debit  = 0,  
	Credit = ISNULL(SUM(P.Amt), 0),
	date = :ad_EndDate,
	type = 'CSH-PUR',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(PurInvCode) FROM Purledger WHERE posted = 'Y' and accountfor='Y' and amt <> 0 and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(PurInvCode) FROM Purledger WHERE posted = 'Y' and accountfor='Y' and amt <> 0 and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(PurInvCode) FROM Purledger WHERE posted = 'Y' and accountfor='Y' and amt <> 0 and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=NULL,
	accounthead='Paid During Purchase for the Period',
	priority=13
FROM
	(SELECT amt=ISNULL(SUM(h.amt), 0)
	FROM
		purledger h
	WHERE
		h.posted = 'Y' and 
		h.accountfor='Y' and
		h.amt <> 0 and 
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate) P
HAVING SUM(P.Amt) > 0
UNION ALL
SELECT 
	glvochcode=NULL,
	Debit  = ISNULL(SUM(P.Amt), 0),
	Credit = 0,
	date = :ad_EndDate,
	type = 'CSH-PR',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(PrInvCode) FROM Prledger WHERE prcatcode = 4 and posted = 'Y' and accountfor = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(PrInvCode) FROM Prledger WHERE prcatcode = 4 and posted = 'Y' and accountfor = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(PrInvCode) FROM Prledger WHERE prcatcode = 4 and posted = 'Y' and accountfor = 'Y' and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=(SELECT MAX(name) FROM accounts WHERE accounts.acccode IN (SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashAcc')))),
	accounthead='Cash P/Return for the Period',
	priority=14
FROM
	(SELECT amt=ISNULL(ROUND(SUM((d.looseqty + d.bonusqty) * d.unitsalestax) +
			SUM(ROUND(d.looseqty * d.prprice * (1 - (.01 * d.discperc)) * d.gstperc * .01, 2)) +
			ROUND((SUM((d.looseqty * d.prprice) * (1 - (.01 * d.discperc))) * 
				(1- (.01 * h.discperc)) - h.flatdisc) * (h.invgstperc1 * .01), 2), 0) +
			ROUND(SUM(d.looseqty * d.prprice * (1 - (.01 * d.discperc))) * (1- (.01 * h.discperc)) + h.misccharges + h.salestax - h.flatdisc, 0), 0)
	FROM
		prledger h, 
		prdetail d
	WHERE
		h.prinvcode = d.prinvcode and
		h.prcatcode = 4 and
		h.posted = 'Y' and h.accountfor = 'Y' and
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate
	GROUP BY h.prinvcode,
		 h.prcatcode, 
		 h.date,
		 h.discperc,
		 h.misccharges,
		 h.salestax,
		 h.InvGSTPerc1,
		 h.flatdisc) P 
HAVING SUM(P.Amt) > 0
UNION ALL
SELECT 
	glvochcode=NULL,
	Debit  = ISNULL(SUM(P.Amt), 0),
	Credit = 0,
	date = :ad_EndDate,
	type = 'CSH-PR',
	remarks='Total Invoices: ' + LTRIM(RTRIM(STR((SELECT COUNT(PrInvCode) FROM Prledger WHERE posted = 'Y' and accountfor = 'Y' and amt <> 0 and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + 
			' (' + LTRIM(RTRIM(STR((SELECT MIN(PrInvCode) FROM Prledger WHERE posted = 'Y' and accountfor = 'Y' and amt <> 0 and date >= :ad_StartDate and date <= :ad_EndDate), 7))) +
			'-' + LTRIM(RTRIM(STR((SELECT MAX(PrInvCode) FROM Prledger WHERE posted = 'Y' and accountfor = 'Y' and amt <> 0 and date >= :ad_StartDate and date <= :ad_EndDate), 7))) + ')',
	acc=(SELECT MAX(name) FROM accounts WHERE accounts.acccode IN (SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashAcc')))),
	accounthead='Received during Cash P/Return for the Period',
	priority=15
FROM
	(SELECT amt=ISNULL(SUM(h.amt), 0)
	FROM
		prledger h
	WHERE
		h.posted = 'Y' and 
		h.amt <> 0 
		and h.accountfor = 'Y' and
		h.date >= :ad_StartDate and
		h.date <= :ad_EndDate) P 
HAVING SUM(P.Amt) > 0
UNION ALL
SELECT /*Notes Receivable/Payable Cash/Bank Transaction Details debit=credit and credit=debit*/
	glvochcode=h.documentcode,
	debit=h.debit,
	credit=h.credit,
	date = h.date,
	type = RTRIM(LTRIM(H.DocumentType)) + '-' + RTRIM(LTRIM(CONVERT(VARCHAR(7), h.documentcode))),
	remarks=h.remarks,
	acc=(SELECT name FROM accounts WHERE accounts.acccode = h.acccode),
	accounthead=h.remarks,
	priority=0
FROM
	virtualgl h,
	accounts a
WHERE
	h.documenttype in ('NR', 'NP') AND
	h.acccode in (select acccode from accounts where subcode IN 
							(SELECT code FROM global WHERE LOWER(name) IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')))) AND
	h.acccode = a.acccode and
	h.date >= :ad_StartDate and
	h.date <= :ad_endDate
UNION ALL
SELECT /*Sales Receivable Adjustments*/
	glvochcode=NULL,
	debit=SUM(d.debit),
	credit=SUM(d.credit),
	date = :ad_endDate,
	type = 'SRADJ',
	remarks='Sales Receivable Amount Adjustment',
	acc=(SELECT name FROM accounts WHERE accounts.acccode = d.acccode),
	accounthead=(SELECT name FROM accounts WHERE accounts.acccode = d.acccode),
	priority=16
FROM
	saleledger sl, salereceivableadj d, accounts a
WHERE
	sl.posted = 'Y' and
	sl.date >= :ad_StartDate and
	sl.date <= :ad_endDate and
	sl.saleinvcode = d.saleinvcode and
	d.acccode in 
		(select acccode from 
		accounts where subcode IN 
			(SELECT code FROM global 
			WHERE LOWER(name) IN 
				(LOWER('GT_CashSub'), LOWER('GT_BankSub')))) and
	d.acccode = a.acccode
GROUP BY
	d.acccode
ORDER BY 
	date, 
	priority, 
	type
"
  arguments=(("ad_StartDate", datetime), ("ad_EndDate", datetime))
)
