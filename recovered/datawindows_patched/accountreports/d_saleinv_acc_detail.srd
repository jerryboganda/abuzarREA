table(column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="DocumentCode"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VoucherCode"  )
column=(type=char(20) updatewhereclause=yes name=type dbname="Type"  )
column=(type=char(30) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(40) updatewhereclause=yes name=refno dbname="RefNo"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
 retrieve="SELECT
	InvoiceCode = S.InvoiceCode, 
	AliasName=A.AliasName,
	Customer=A.Name,
	Date = S.Date,
	DocumentCode= S.DocumentCode, 
	VoucherCode= S.VoucherCode, 
	Type = S.Type,
	Remarks = S.Remarks,
	RefNo = S.RefNo,
	Debit = S.Debit, 
	Credit = S.Credit,
	Posted = S.Posted
FROM
	(SELECT  
		InvoiceCode = S.SaleInvCode, 
		Date = S.Date,
		DocumentCode= S.SaleInvCode, 
		VoucherCode= S.HeaderInvNo, 
		Type = 'CR',
		Remarks = 'Credit Sale Invoice',
		RefNo = S.CustRefNo,
		Debit = S.InvTotal, 
		Credit = 0,
		Posted = S.Posted
	FROM
		SaleLedger S
	Where    
		S.SaleInvCode = :ai_invcode AND   
		S.SaleCatCode = 2
	UNION ALL
	SELECT  
		InvoiceCode = S.SaleInvCode, 
		Date = S.Date,
		DocumentCode= S.SaleInvCode, 
		VoucherCode= S.HeaderInvNo, 
		Type = 'CRS',
		Remarks = 'Received During Sale',
		RefNo = S.CustRefNo,
		Debit = 0, 
		Credit = IsNull(S.Amt,0) + isnull(S.CashCharged, 0) + ISNULL((SELECT SUM(CW.Amount) FROM CashierWindow CW WHERE CW.SaleInvCode=:ai_invcode ), 0),
		Posted = S.Posted
	FROM
		SaleLedger S
	Where    
		S.SaleInvCode = :ai_invcode AND   
		S.Amt + isnull(S.CashCharged, 0) + ISNULL((SELECT SUM(CW.Amount) FROM CashierWindow CW WHERE CW.SaleInvCode=:ai_invcode ), 0) <> 0 AND
		S.SaleCatCode = 2 AND   
		S.AccountFor = 'Y'
	UNION ALL
	SELECT
		InvoiceCode = D.InvoiceCode,
		Date = H.Date,
		DocumentCode= H.GLVochcode, 
		VoucherCode= H.VoucherCode, 
		Type = VC.ShortName,
		Remarks = VC.Name,
		RefNo = H.ChkNo,
		Debit = D.Debit, 
		Credit = D.Credit,
		Posted = H.Posted
	FROM
		GLDetail D,
		GLHeader H,
		VocherCategory VC
	WHERE
		H.GLVochCode = D.GLVochCode AND   
		D.InvoiceCode = :ai_invcode AND   
		VC.InvoiceType = 1 AND   
		VC.VochCatCode = H.VochCatCode
	UNION ALL
	SELECT  
		InvoiceCode = D.InvoiceCode,
		Date = N.IssueDate,
		DocumentCode= N.NoteCode, 
		VoucherCode= N.VoucherCode, 
		Type = 'BR',
		Remarks = 'Bills Receivable',
		RefNo = N.DocumentNumber,
		Debit = 0, 
		Credit = D.Amt,
		Posted = N.Posted
	FROM NotesDetail D, Notes N
	Where
		N.NoteCatCode = 1 AND   
		N.NoteCode = D.NoteCode AND   
		D.InvoiceCode = :ai_invcode
	UNION ALL
	SELECT  
		InvoiceCode = D.SaleInvCode, 
		Date = H.Date,
		DocumentCode= H.SRAllocationCode, 
		VoucherCode= H.SRInvCode, 
		Type = 'SRA',
		Remarks = 'S/Return Allocated',
		RefNo = '',
		Debit = 0, 
		Credit = D.Amt,
		Posted = H.Posted
	FROM
		SRALLocationDetail D, SRALLocationHeader H
	Where
		H.SRALLocationCode = D.SRALLocationCode AND   
		D.SaleInvCode = :ai_invcode) S,
	Accounts A,
	SaleLedger SL
WHERE 
	SL.SaleInvCode = :ai_invcode AND
	SL.CustCode = A.AccCode AND
	SL.SaleInvCode = S.InvoiceCode
ORDER BY 
	InvoiceCode,
	Date
"
  arguments=(("ai_invcode", number))
)
