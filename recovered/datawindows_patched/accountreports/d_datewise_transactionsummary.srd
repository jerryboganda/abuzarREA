table(column=(type=datetime updatewhereclause=yes name=date dbname="DATE"  )
column=(type=decimal(2) updatewhereclause=yes name=opening dbname="OPENING"  )
column=(type=number updatewhereclause=yes name=sale dbname="SALE"  )
column=(type=number updatewhereclause=yes name=ret dbname="Ret"  )
column=(type=number updatewhereclause=yes name=netsale dbname="NetSale"  )
column=(type=number updatewhereclause=yes name=receipts dbname="Receipts"  )
column=(type=number updatewhereclause=yes name=debits dbname="Debits"  )
column=(type=number updatewhereclause=yes name=credits dbname="Credits"  )
 retrieve="SELECT 
	DATE=M.DATE,
	OPENING=(SELECT SUM(V.DEBIT-V.CREDIT) FROM VIRTUALGL V, CUSTOMER C WHERE V.ACCCODE = C.CUSTCODE AND V.DATE < M.DATE),
	SALE=SUM(SALE),
	Ret=SUM(RET),
	NetSale=SUM(NETSALE),
	Receipts=SUM(Receipts),
	Debits=SUM(Debits),
	Credits=SUM(Credits)
FROM
(SELECT 
	Date=CONVERT(DATETIME, CONVERT(varchar(10), T.Date, 101)),
	Sale=ISNULL(SUM(CASE T.TYPE WHEN 'S' THEN T.AMT ELSE 0 END), 0),
	Ret=ISNULL(SUM(CASE TYPE WHEN 'R' THEN T.AMT ELSE 0 END), 0),
	NetSale=ISNULL(SUM(CASE TYPE WHEN 'S' THEN T.AMT WHEN 'R' THEN -(T.AMT) ELSE 0 END), 0),
	Receipts=ISNULL(SUM(CASE TYPE WHEN 'BC' THEN T.AMT ELSE 0 END), 0),
	Debits=ISNULL(SUM(CASE TYPE WHEN 'DR' THEN T.AMT ELSE 0 END), 0),
	Credits=ISNULL(SUM(CASE TYPE WHEN 'CR' THEN T.AMT ELSE 0 END), 0)
FROM
	(SELECT
		Type='S',
		InvCode=H.SaleInvCode,
		Date=h.Date,
		Amt=Round(SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) +
		SUM(ROUND( (D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
		ROUND( (SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc))) * (1- (.01 * H.discperc)) -
			H.flatdisc) * (H.invgstperc1 * .01), 2), 0) +
		Round(SUM((D.looseqty*(D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc))) * (1- (.01 * H.discperc)) + 
			H.misccharges + H.salestax - H.flatdisc, 0)
	FROM
		saleledger h, saledetail d
	WHERE
		h.posted='Y' AND h.AccountFor = 'Y' AND
		h.salecatcode IN (2) AND
		h.saleinvcode = d.saleinvcode AND
		h.date >= :ad_startdate AND h.date <= :ad_enddate
	GROUP BY 
		h.saleinvcode,
		h.Date, 
		h.discperc,
		h.misccharges,
		h.salestax,
		h.flatdisc,
		h.invgstperc1
	UNION ALL
	SELECT
		Type='R',
		InvCode=H.SRInvCode,
		Date=h.Date,
		Amt=ROUND(
			SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
			SUM(ROUND( (D.looseqty * D.srprice) * 
				 (1 - (.01 * D.discperc)) * D.gstperc * .01, 2)) +
			ROUND( (sum( (D.looseqty * D.srprice) *
				 (1 - (.01 * D.discperc))) * 
				 (1- (.01 * H.discperc)) - H.flatdisc) * 
				 (H.invgstperc1 * .01), 2), 0) +
		Round( sum( (D.looseqty * D.srprice) *
				 (1 - (.01 * D.discperc))) * 
				 (1- (.01 * H.discperc)) + H.misccharges + 
				 H.salestax - H.flatdisc, 0)
	FROM
		srledger h, srdetail d
	WHERE
		h.posted='Y' AND h.AccountFor = 'Y' AND
		h.SRCatCode IN (7) AND 
		h.srinvcode = d.srinvcode AND
		h.date >= :ad_startdate AND h.date <= :ad_enddate
	GROUP BY 
		h.srinvcode,
		h.Date,
		h.discperc,
		h.misccharges,
		h.salestax,
		h.flatdisc,
		h.invgstperc1
	UNION ALL
	SELECT 
		TYPE='BC',
		InvCode=0,
		Date=h.Date,
		Amt=SUM(D.Credit)
	FROM 
		Customer C, GlDetail D, GlHeader H
	WHERE
		H.VochCatCode IN (2, 4) AND
		H.Posted = 'Y' AND
		H.GlVochCode = D.GlVochCode AND
		D.AccCode = C.CustCode AND
		h.date >= :ad_startdate AND h.date <= :ad_enddate
	GROUP BY
		D.AccCode, h.Date
	UNION ALL
	SELECT 
		TYPE='DR',
		InvCode=0,
		Date=h.Date,
		Amt=SUM(D.Debit)
	FROM 
		Customer C, GlDetail D, GlHeader H
	WHERE
		H.VochCatCode NOT IN (2, 4) AND
		H.Posted = 'Y' AND
		H.GlVochCode = D.GlVochCode AND
		D.AccCode = C.CustCode AND
		h.date >= :ad_startdate AND h.date <= :ad_enddate
	GROUP BY
		D.AccCode, h.Date
	UNION ALL
	SELECT 
		TYPE='CR',
		InvCode=0,
		Date=h.Date,
		Amt=SUM(D.Credit)
	FROM 
		Customer C, GlDetail D, GlHeader H
	WHERE
		H.VochCatCode NOT IN (2, 4) AND
		H.Posted = 'Y' AND
		H.GlVochCode = D.GlVochCode AND
		D.AccCode = C.CustCode AND
		h.date >= :ad_startdate AND h.date <= :ad_enddate
	GROUP BY
		D.AccCode, h.Date
	UNION ALL
	SELECT 
		TYPE='BC',
		InvCode=0,
		Date=N.PostDate,
		Amt=SUM(N.Amount)
	FROM 
		Customer C, Notes N
	WHERE
		N.Posted = 'Y' AND
		N.AccCode = C.CustCode AND
		N.Postdate >= :ad_startdate AND N.Postdate <= :ad_enddate
	GROUP BY
		N.AccCode, N.PostDate) T
GROUP BY
	CONVERT(DATETIME, CONVERT(varchar(10), T.Date, 101))) M
GROUP BY
	M.DATE
ORDER BY
	M.DATE
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
)
