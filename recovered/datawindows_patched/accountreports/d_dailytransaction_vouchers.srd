table(column=(type=long updatewhereclause=yes name=glvochcode dbname="Glheader.GLVochCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Glheader.Date"  )
column=(type=datetime updatewhereclause=yes name=glheader_postdate dbname="Glheader.PostDate"  )
column=(type=long updatewhereclause=yes name=gldetail_acccode dbname="GLDetail.AccCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="Accounts.AliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="Accounts.Name"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="GLDetail.Remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(20) updatewhereclause=yes name=chkno dbname="GLDetail.ChkNo"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="Glheader.VoucherCode"  )
column=(type=char(30) updatewhereclause=yes name=vouchercategory dbname="VoucherCategory"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=long updatewhereclause=yes name=invoicebased dbname="InvoiceBased"  )
 retrieve="SELECT
	H.GLVochCode,
	H.Date,
	H.PostDate,
	D.AccCode,
	A.AliasName,
	A.Name,
	D.Remarks,
	Amount = CASE 
			WHEN D.Debit > 0 THEN D.Debit
			WHEN D.Credit > 0 THEN D.Credit
			ELSE 0 END,
	/*detail_accountname=(select name from accounts where accounts.acccode=D.acccode),*/
	U.UserName,
	D.ChkNo,
	H.VoucherCode,
	VoucherCategory = (SELECT V.Name FROM vochercategory V WHERE V.VochCatCode = H.Vochcatcode),
	InvoiceCode=D.InvoiceCode,
	InvoiceBased=(SELECT V.InvoiceBased FROM vochercategory V WHERE V.VochCatCode = H.Vochcatcode)
FROM
	GLHeader H, GLDetail D, Accounts A, Users U
WHERE
	H.VochCatCode = :ai_VochCatCode AND
	H.Date >= :ar_StartDate AND
	H.Date <= :ar_EndDate AND
	H.GLVochCode = D.GLVochCode AND
	H.AccCode <> D.AccCode AND
	H.AccCode = A.AccCode AND
	H.SalesManCode = U.UserCode
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ai_VochCatCode", number))
)
