release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1875 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=4427 color="536870912" )
table(column=(type=long updatewhereclause=yes name=openingcash dbname="OpeningCash"  )
column=(type=decimal(2) updatewhereclause=yes name=cashsale dbname="CashSale"  )
column=(type=long updatewhereclause=yes name=cashsale_invcount dbname="CashSale_InvCount"  )
column=(type=decimal(2) updatewhereclause=yes name=creditsale dbname="CreditSale"  )
column=(type=long updatewhereclause=yes name=creditsale_invcount dbname="CreditSale_InvCount"  )
column=(type=decimal(2) updatewhereclause=yes name=cashsaleret dbname="CashSaleRet"  )
column=(type=long updatewhereclause=yes name=cashsaleret_invcount dbname="CashSaleRet_InvCount"  )
column=(type=decimal(2) updatewhereclause=yes name=creditsaleret dbname="CreditSaleRet"  )
column=(type=long updatewhereclause=yes name=creditsaleret_invcount dbname="CreditSaleRet_InvCount"  )
column=(type=long updatewhereclause=yes name=exepenses dbname="Exepenses"  )
column=(type=long updatewhereclause=yes name=cashdeclared dbname="CashDeclared"  )
 retrieve="SELECT
	OpeningCash = ISNULL( :ai_opencash , 0),
	CashSale = ISNULL( 
		(SELECT NetAmt = SUM(dbo.fn_GetSaleInvTotal(SL.SaleInvCode))
		FROM SaleLedger SL
		WHERE SL.Date BETWEEN :adt_startdate AND :adt_enddate AND SL.SaleCatCode = 3), 0),
	CashSale_InvCount= ISNULL(
		(SELECT InvCount = COUNT(*)
		FROM SaleLedger SL
		WHERE SL.Date BETWEEN :adt_startdate AND :adt_enddate AND SL.SaleCatCode = 3), 0),
	CreditSale = ISNULL(
		(SELECT NetAmt = SUM(dbo.fn_GetSaleInvTotal(SL.SaleInvCode))
		FROM SaleLedger SL
		WHERE SL.Date BETWEEN :adt_startdate AND :adt_enddate AND SL.SaleCatCode <> 3), 0),
	CreditSale_InvCount=ISNULL(
		(SELECT InvCount = COUNT(*)
		FROM SaleLedger SL
		WHERE SL.Date BETWEEN :adt_startdate AND :adt_enddate AND SL.SaleCatCode <> 3), 0),
	CashSaleRet = ISNULL(
		(SELECT NetAmt = SUM(dbo.fn_GetSRInvTotal(SL.SRInvCode))
		FROM SRLedger SL
		WHERE SL.Date BETWEEN :adt_startdate AND :adt_enddate AND SL.SRCatCode = 8), 0),
	CashSaleRet_InvCount=ISNULL(
		(SELECT InvCount = COUNT(*)
		FROM SRLedger SL
		WHERE SL.Date BETWEEN :adt_startdate AND :adt_enddate AND SL.SRCatCode = 8), 0),
	CreditSaleRet = ISNULL(
		(SELECT NetAmt = SUM(dbo.fn_GetSRInvTotal(SL.SRInvCode))
		FROM SRLedger SL
		WHERE SL.Date BETWEEN :adt_startdate AND :adt_enddate AND SL.SRCatCode <> 8), 0),
	CreditSaleRet_InvCount=ISNULL(
		(SELECT InvCount = COUNT(*)
		FROM SRLedger SL
		WHERE SL.Date BETWEEN :adt_startdate AND :adt_enddate AND SL.SRCatCode <> 8), 0),
	Exepenses = ISNULL( :ai_expenses, 0),
	CashDeclared = ISNULL(:ai_CashDeclared, 0)

"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("as_username", string), ("as_machine", string), ("as_shift", string), ("ai_opencash", number), ("ai_expenses", number), ("ai_cashdeclared", number))
)
