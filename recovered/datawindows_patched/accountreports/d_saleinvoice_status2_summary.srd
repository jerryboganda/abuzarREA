table(column=(type=char(60) updatewhereclause=yes name=amtreceivedby dbname="AmtReceivedBy"  )
column=(type=decimal(2) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=long updatewhereclause=yes name=salescount dbname="SalesCount"  )
column=(type=decimal(2) updatewhereclause=yes name=receivedoninv dbname="ReceivedOnInv"  )
column=(type=long updatewhereclause=yes name=cashcount dbname="CashCount"  )
column=(type=decimal(2) updatewhereclause=yes name=cashoninvbalance dbname="CashOnInvBalance"  )
column=(type=long updatewhereclause=yes name=balancecount dbname="BalanceCount"  )
 retrieve="SELECT 
	AmtReceivedBy = (SELECT U.UserName FROM Users U WHERE U.UserCode = S.AmtBy),
	NetAmt=SUM(S.InvTotal),
	SalesCount = ISNULL(Count(S.SaleInvCode), 0),
	ReceivedOnInv=
		isnull(SUM(S.Amt), 0) + 
		isnull(SUM(S.CashCharged), 0) + 
		ISNULL(
			(SELECT SUM(CW.Amount) 
			FROM CashierWindow CW 
			WHERE CW.SaleInvCode IN 
				(SELECT SS.SaleInvCode 
				FROM SaleLedger SS 
				WHERE /*SS.Posted='Y' AND */
					SS.AccountFor = 'Y' AND
					SS.Marked = 'N' AND
					SS.Date >= :ad_startdate AND SS.DATE <= :ad_enddate AND
					SS.SaleCatCode IN (2))), 0),
	CashCount = ISNULL(
		(SELECT COUNT(SS.SaleInvCode) 
		FROM SaleLedger SS 
		WHERE SS.Date >= :ad_startdate AND 
			SS.DATE <= :ad_enddate AND 
			SS.AmtBy = S.AmtBy), 0),
	CashOnInvBalance=SUM(S.InvTotal) - 
		(isnull(SUM(S.Amt), 0) + 
		isnull(SUM(S.CashCharged), 0) + 
		ISNULL(
			(SELECT SUM(CW.Amount) 
			FROM CashierWindow CW 
			WHERE CW.SaleInvCode IN 
				(SELECT SS.SaleInvCode 
				FROM SaleLedger SS 
				WHERE /*SS.Posted='Y' AND */
					SS.AccountFor = 'Y' AND
					SS.Marked = 'N' AND
					SS.Date >= :ad_startdate AND SS.DATE <= :ad_enddate AND
					SS.SaleCatCode IN (2))), 0)),
	BalanceCount = ISNULL(Count(S.SaleInvCode),0) - 
		ISNULL(
			(SELECT Count(SS.SaleInvCode) FROM SaleLedger SS 
			WHERE SS.Date >= :ad_startdate AND SS.DATE <= :ad_enddate AND 
			SS.AmtBy = S.AmtBy), 0)
FROM 
	SaleLedger S, Accounts A, Customer C
WHERE
/*	S.Posted = 'Y' AND */
	S.AccountFor = 'Y' AND
	S.Marked = 'N' AND
	S.Date >= :ad_startdate AND S.DATE <= :ad_enddate AND
	S.SaleCatCode IN (2) AND
	S.CustCode = A.AccCode AND
	A.AccCode = C.CustCode
GROUP BY
	S.AmtBy
ORDER BY
	AmtReceivedBy"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
)
