table(column=(type=char(100) updatewhereclause=yes name=name dbname="SummaryAccount.Name"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="SummaryAccount.AliasName"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="VirtualGl.DocumentCode"  )
column=(type=char(27) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remark"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="OpenBalance"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="VirtualGl.CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VirtualGl.VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VirtualGl.VoucherCode"  )
column=(type=char(100) updatewhereclause=yes name=grn dbname="GRN"  )
column=(type=char(100) updatewhereclause=yes name=vehicle dbname="Vehicle"  )
column=(type=char(60) updatewhereclause=yes name=agency dbname="Agency"  )
column=(type=char(100) updatewhereclause=yes name=shipto dbname="ShipTo"  )
column=(type=decimal(2) updatewhereclause=yes name=freight dbname="Freight"  )
 retrieve="SELECT 
	A.Name,
	A.AliasName,
	V.DocumentCode, 
	Type = V.DocumentType + '-' + RTRIM(LTRIM(CONVERT(CHAR(6), V.DocumentCode))), 
	date = V.Date, 
	Debit = V.Debit,
	Credit= V.Credit,
	Remark = V.Remarks,
	OpenBalance=
		(SELECT ISNULL(SUM(Debit-Credit), 0) 
		FROM VirtualGL 
		WHERE	
			VirtualGL.AccCode IN 
				(SELECT T.AccCode FROM SummaryAccountDetail T 
				WHERE T.SummaryAccCode = A.SummaryAccCode) AND
			VirtualGL.Date < :ar_startdate),
	V.CheckNo,
	V.VRow,
	V.VoucherCode,
	GRN = V.GRN,
	Vehicle = V.Vehicle,
	Agency = (SELECT GC.Name FROM GoodsCompany GC WHERE GC.GCCode = V.GCCode),
	ShipTo = V.ShipTo,
	Freight = CASE 
			WHEN V.documenttype = 'PV' AND V.Credit > 0 THEN (SELECT - P.FlatDisc FROM PurLedger P WHERE P.PurInvCode = V.DocumentCode) 
			WHEN V.documenttype = 'SV' AND V.Debit > 0 THEN (SELECT S.FlatDisc FROM SaleLedger S WHERE S.SaleInvCode = V.DocumentCode) 
			ELSE 0 END
FROM VirtualGL V, SummaryAccount A, SummaryAccountDetail D, Accounts AC
WHERE 
	A.SummaryAccCode IN (:ar_sumacccode) AND
	A.SummaryAccCode = D.SummaryAccCode AND
	D.AccCode = AC.AccCode AND
	(V.AccCode = AC.AccCode OR V.AlternateAccCode = AC.AccCode ) and
	V.Date >= :ar_startdate and
	V.Date <= :ar_enddate
UNION ALL
SELECT 
	A.Name,
	A.AliasName,
	V.DocumentCode, 
	Type = V.DocumentType + '-' + RTRIM(LTRIM(CONVERT(CHAR(6), V.DocumentCode))), 
	Date = V.Date, 
	Debit = V.Credit,
	Credit= V.Debit,
	Remark = CASE debit 
			WHEN 0 THEN 'Cash Paid Against Sale Ret. # '
			ELSE 'Cash Received Against Sales Inv. # '
			END + RTRIM(LTRIM(CONVERT(CHAR(6), V.DocumentCode))),
	OpenBalance=
		(SELECT ISNULL(SUM(Debit-Credit), 0) 
		FROM VirtualGL 
		WHERE	
			VirtualGL.AccCode IN 
				(SELECT T.AccCode FROM SummaryAccountDetail T 
				WHERE T.SummaryAccCode = A.SummaryAccCode) AND
			VirtualGL.Date < :ar_startdate),
	V.CheckNo,
	V.VRow,
	V.VoucherCode,
	GRN = V.GRN,
	Vehicle = V.Vehicle,
	Agency = (SELECT GC.Name FROM GoodsCompany GC WHERE GC.GCCode = V.GCCode),
	ShipTo = V.ShipTo,
	Freight = 0
FROM VirtualGL V, SummaryAccount A, SummaryAccountDetail D, Accounts AC
WHERE   
	A.SummaryAccCode IN (:ar_sumacccode) AND
	A.SummaryAccCode = D.SummaryAccCode AND
	D.AccCode = AC.AccCode AND
	V.AlternateAccCode = AC.AccCode AND
	V.Date >= :ar_startdate AND
	V.Date <= :ar_enddate
UNION ALL
SELECT 
	A.Name,
	A.AliasName,
	DocumentCode=0, 
	Type = '', 
	Date = :ar_enddate,
	Debit = 0,
	Credit= 0,
	Remark = '',
	OpenBalance=
		(SELECT ISNULL(SUM(Debit-Credit), 0) 
		FROM VirtualGL 
		WHERE	
			VirtualGL.AccCode IN 
				(SELECT T.AccCode FROM SummaryAccountDetail T 
				WHERE T.SummaryAccCode = A.SummaryAccCode) AND
			VirtualGL.Date < :ar_startdate),
	CheckNo='',
	VRow=0,
	VoucherCode=NULL,
	GRN = NULL,
	Vehicle = NULL,
	Agency = NULL,
	ShipTo = NULL,
	Freight = 0
FROM SummaryAccount A
WHERE   
	A.SummaryAccCode IN (:ar_sumacccode) AND
	(SELECT SUM(X.AccCode)
	FROM 
		(SELECT T.AccCode FROM SummaryAccountDetail T 
		WHERE T.SummaryAccCode = A.SummaryAccCode) X,
		VirtualGL V
	WHERE V.AccCode = X.AccCode AND 
			V.Date >= :ar_startdate AND
			V.Date <= :ar_enddate) IS NULL
ORDER BY 
	A.Name, 
	A.AliasName, 
	Date, 
	type, 
	VRow
"
  arguments=(("ar_sumacccode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
