table(column=(type=long updatewhereclause=yes name=documentcode dbname="VirtualGl.documentcode"  )
column=(type=char(27) updatewhereclause=yes name=type dbname="type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remark"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="name"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="VirtualGl.name"  )
column=(type=char(60) updatewhereclause=yes name=email dbname="VirtualGl.email"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="cash"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="VirtualGl.aliasname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="openbalance"  )
column=(type=decimal(6) updatewhereclause=yes name=openbalancefc dbname="openbalanceFC"  )
column=(type=long updatewhereclause=yes name=areacode dbname="VirtualGl.areacode"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="VirtualGl.area"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="VirtualGl.CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VirtualGl.VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VirtualGl.vouchercode"  )
column=(type=long updatewhereclause=yes name=pendingcheque dbname="PendingCheque"  )
column=(type=char(100) updatewhereclause=yes name=grn dbname="GRN"  )
column=(type=char(100) updatewhereclause=yes name=vehicle dbname="Vehicle"  )
column=(type=char(60) updatewhereclause=yes name=agency dbname="Agency"  )
column=(type=char(100) updatewhereclause=yes name=shipto dbname="ShipTo"  )
column=(type=decimal(2) updatewhereclause=yes name=freight dbname="Freight"  )
column=(type=long updatewhereclause=yes name=currencycode dbname="CurrencyCode"  )
column=(type=decimal(5) updatewhereclause=yes name=conversionrate dbname="ConversionRate"  )
 retrieve="select 
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Debit,
	credit= V.Credit,
	remark = V.Remarks,
	name=c.name,
	c.name,
	c.email,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	c.aliasname,
	address=c.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=C.acccode and 
				virtualgl.date < :ar_startdate),
	openbalanceFC=ISNULL((select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=C.acccode and 
				virtualgl.date < :ar_startdate), 0) / CASE WHEN (SELECT MAX(VV.ConversionRate) FROM VirtualGL VV WHERE VV.Date <= :ar_startdate) > 0 THEN (SELECT MAX(VV.ConversionRate) FROM VirtualGL VV WHERE VV.Date <= :ar_startdate) ELSE 1 END,
	c.areacode,
	c.area,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	PendingCheque=0,
	GRN = V.GRN,
	Vehicle = V.Vehicle,
	Agency = (SELECT GC.Name FROM GoodsCompany GC WHERE GC.GCCode = V.GCCode),
	ShipTo = V.ShipTo,
	Freight = CASE WHEN V.documenttype = 'SV' AND V.Debit > 0 THEN (SELECT S.FlatDisc FROM SaleLedger S WHERE S.SaleInvCode = V.DocumentCode) ELSE 0 END,
	CurrencyCode=V.CurrencyCode,
	ConversionRate=ISNULL(V.ConversionRate, (SELECT MAX(VV.ConversionRate) FROM VirtualGL VV WHERE VV.Date <= V.Date))
from     
	VirtualGL V,
	(SELECT	a.aliasname, a.acccode, a.name, ct.address1, ct.areacode, area=ar.name, ct.email
	FROM	accounts a, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ar_custcode)) CT, 
		area ar
	WHERE a.acccode = ct.custcode and ar.areacode=ct.areacode) C
where   (V.AccCode = C.AccCode OR V.AlternateAccCode = C.AccCode ) and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
union all
select	
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Credit,
	credit= V.Debit,
	remark = Case debit 
			When 0 then 'Cash Paid Against Sale Ret. # '
			Else 'Cash Received Against Sales Inv. # '
			End + RTrim(LTrim(convert(char(6), V.documentcode))),
	name=c.name,
	c.name,
	c.email,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	c.aliasname,
	address=c.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=C.acccode and 
				virtualgl.date < :ar_startdate),
	openbalanceFC=ISNULL((select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=C.acccode and 
				virtualgl.date < :ar_startdate), 0) / CASE WHEN (SELECT MAX(VV.ConversionRate) FROM VirtualGL VV WHERE VV.Date <= :ar_startdate) > 0 THEN (SELECT MAX(VV.ConversionRate) FROM VirtualGL VV WHERE VV.Date <= :ar_startdate) ELSE 1 END,
	c.areacode,
	c.area,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	PendingCheque=0,
	GRN = V.GRN,
	Vehicle = V.Vehicle,
	Agency = (SELECT GC.Name FROM GoodsCompany GC WHERE GC.GCCode = V.GCCode),
	ShipTo = V.ShipTo,
	Freight = 0,
	CurrencyCode=V.CurrencyCode,
	ConversionRate=ISNULL(V.ConversionRate, (SELECT MAX(VV.ConversionRate) FROM VirtualGL VV WHERE VV.Date <= V.Date))
from     VirtualGL V,
	(SELECT	a.aliasname, a.acccode, a.name, ct.address1, ct.areacode, area=ar.name, ct.email
	FROM	accounts a, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ar_custcode)) CT, 
		area ar
	WHERE a.acccode = ct.custcode and ar.areacode=ct.areacode) C
where   (V.AlternateAccCode = C.AccCode ) and
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
UNION ALL
select
	documentcode = N.NoteCode, 
	Type = Case N.NoteCatCode When 1 Then '*NR' Else '*NP' End + '-' + RTrim(LTrim(convert(char(6), N.NoteCode))),  
	date = N.duedate, 
	debit = Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = C.AccCode THEN 0 ELSE N.Amount END ELSE CASE WHEN N.AccCode = C.AccCode THEN N.Amount ELSE 0 END END,
	credit= Case N.NoteCatCode When 1 Then CASE WHEN N.AccCode = C.AccCode THEN N.Amount ELSE 0 END ELSE CASE WHEN N.AccCode = C.AccCode THEN 0 ELSE N.Amount END END,
	remark = N.Remarks,
	name=c.name,
	c.name,
	c.email,
	cash = 'N',
	c.aliasname,
	address=c.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=C.acccode and 
				virtualgl.date < :ar_startdate),
	openbalanceFC=ISNULL((select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=C.acccode and 
				virtualgl.date < :ar_startdate), 0) / CASE WHEN (SELECT MAX(VV.ConversionRate) FROM VirtualGL VV WHERE VV.Date <= :ar_startdate) > 0 THEN (SELECT MAX(VV.ConversionRate) FROM VirtualGL VV WHERE VV.Date <= :ar_startdate) ELSE 1 END,
	c.areacode,
	c.area,
	CheckNo = LEFT(N.DocumentNumber, 20),
	VRow=999999,
	N.vouchercode,
	PendingCheque=1,
	GRN = NULL,
	Vehicle = NULL,
	Agency = NULL,
	ShipTo = NULL,
	Freight = 0,
	CurrencyCode=NULL,
	ConversionRate=(SELECT MAX(VV.ConversionRate) FROM VirtualGL VV WHERE VV.Date <= N.DueDate)
from 
	Notes N,
	(SELECT	a.aliasname, a.acccode, a.name, ct.address1, ct.areacode, area=ar.name, ct.email
	FROM	accounts a, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ar_custcode)) CT, 
		area ar
	WHERE a.acccode = ct.custcode and ar.areacode=ct.areacode) C
where   
	(N.AccCode = C.AccCode OR N.BankAccCode = C.AccCode ) and
	N.Posted = 'N' AND N.Finalized = 'Y'
UNION ALL
select
	documentcode=NULL, 
	type = NULL, 
	date = :ar_enddate, 
	debit = 0,
	credit= 0,
	remark = 'OPENING BALANCE',
	name=c.name,
	c.name,
	c.email,
	cash = 'N',
	c.aliasname,
	address=c.address1,
	openbalance=ISNULL((select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=C.acccode and 
				virtualgl.date < :ar_startdate), 0),
	openbalanceFC=ISNULL((select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=C.acccode and 
				virtualgl.date < :ar_startdate), 0) / CASE WHEN (SELECT MAX(VV.ConversionRate) FROM VirtualGL VV WHERE VV.ConversionRate <> 1 AND VV.Date <= :ar_startdate) > 0 THEN (SELECT MAX(VV.ConversionRate) FROM VirtualGL VV WHERE VV.ConversionRate <> 1 AND VV.Date <= :ar_startdate) ELSE 1 END,
	c.areacode,
	c.area,
	CheckNo=NULL,
	VRow=0,
	vouchercode=NULL,
	PendingCheque=0,
	GRN = NULL,
	Vehicle = NULL,
	Agency = NULL,
	ShipTo = NULL,
	Freight = 0,
	CurrencyCode=NULL,
	ConversionRate=(SELECT MAX(VV.ConversionRate) FROM VirtualGL VV WHERE VV.Date <= :ar_startdate)
from
   (SELECT a.aliasname, a.acccode, a.name, ct.address1, ct.areacode, area=ar.name, ct.email
	FROM	accounts a, 
		(SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 1
		UNION ALL
		SELECT CT.* 	FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ar_custcode)) CT, 
		area ar
	WHERE a.acccode = ct.custcode and 
			ar.areacode=ct.areacode AND 
			a.acccode NOT IN 
			(SELECT DISTINCT VGL.AccCode 
			FROM VirtualGL VGL 
			WHERE VGL.Date BETWEEN :ar_startdate AND :ar_enddate AND 
				VGL.AccCode IN 
					(SELECT CT.CustCode FROM Customer CT WHERE :ai_allcustomers = 1
					UNION ALL
					SELECT CT.CustCode FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ar_custcode))
			UNION ALL
			SELECT DISTINCT N.AccCode 
			FROM Notes N
			WHERE N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN
					(SELECT CT.CustCode FROM Customer CT WHERE :ai_allcustomers = 1
					UNION ALL
					SELECT CT.CustCode FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ar_custcode))
			UNION ALL
			SELECT DISTINCT N.BankAccCode 
			FROM Notes N
			WHERE N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN
					(SELECT CT.CustCode FROM Customer CT WHERE :ai_allcustomers = 1
					UNION ALL
					SELECT CT.CustCode FROM Customer CT WHERE :ai_allcustomers = 0 AND CT.CustCode IN (:ar_custcode)))) C
order by 7   , aliasname, date, type, VRow
"
  arguments=(("ar_custcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime), ("ai_allcustomers", number))
)
