table(column=(type=char(60) updatewhereclause=yes name=customer dbname="name1"  )
column=(type=char(255) updatewhereclause=yes name=localaccountname dbname="LocalAccountName"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="value1"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="value2"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="balance"  )
column=(type=char(2) updatewhereclause=yes name=debitcredit dbname="DebitCredit"  )
column=(type=decimal(2) updatewhereclause=yes name=lastrecovery dbname="LastRecovery"  )
column=(type=datetime updatewhereclause=yes name=lastrecoverydate dbname="LastRecoveryDate"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(30) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(121) updatewhereclause=yes name=address dbname="address"  )
 retrieve="SELECT  
	name1, 
	LocalAccountName,
	value1=CASE WHEN Value1 > 0 THEN Value1 ELSE 0 END, 
	value2=CASE WHEN Value1 < 0 THEN ABS(Value1) ELSE 0 END, 
	balance=value1,
	DebitCredit=CASE WHEN Value1 < 0 THEN 'Cr' ELSE 'Dr' END, 
	LastRecovery=
		(SELECT MAX(GLD.Credit)
		FROM GLDetail GLD
		WHERE GLD.AccCode = A.AccCode AND GLD.GLRowID IN
			(SELECT MAX(GD.GLRowID) 
			FROM GlDetail GD, GlHeader G
			WHERE GD.AccCode = A.AccCode AND 
				G.Posted='Y' AND 
				GD.Credit > 0 AND
				G.GlVochCode = GD.GLVochCode)),
	LastRecoveryDate=
		(SELECT MAX(GLH.Date)
		FROM GLDetail GLD, GLHEader GLH
		WHERE GLD.AccCode = A.AccCode AND GLH.GLVochCode=GLD.GLVochCode AND 
			GLD.GLRowID IN
			(SELECT MAX(GD.GLRowID) 
			FROM GlDetail GD, GlHeader G
			WHERE GD.AccCode = A.AccCode AND 
				G.Posted='Y' AND 
				GD.Credit > 0 AND
				G.GlVochCode = GD.GLVochCode)),
	AliasName, 
	Category, 
	Area, 
	AreaCode,
	address
FROM

	(SELECT 
		A.AccCode,
		A.LocalAccountName,
		A.Name AS name1, 
		Sum(V.Balance) AS value1, 
		A.AliasName, 
		Category=CC.Name, 
		Area=Area.Name, 
		AreaCode=Area.AreaCode,
		Address=RTRIM(LTRIM(C.Address1)) + ' ' + RTRIM(LTRIM(C.Address2))
	FROM 
		Accounts A
		LEFT OUTER JOIN 
		(SELECT T.AccCode, Sum(T.Debit - T.Credit) AS Balance
		FROM VirtualGL T 
		WHERE T.Date <= :ar_Date
		GROUP BY T.AccCode) AS V ON (A.AccCode = V.AccCode),
		SubAccounts S,
		Customer C,
		CustomerCategory CC,
		Area
	WHERE 
			A.SubCode = S.SubAccCode AND 
			S.SubAccCode = 3 AND 
			(A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'Y' END OR
			A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'N' END) AND
			A.AccCode = C.CustCode AND 
			C.CustCatCode = CC.CustCatCode AND
			C.AreaCode IN (:ar_Areas) AND 
			CC.CustCatCode IN (:ar_CustCat) AND 
			C.AreaCode = Area.AreaCode
	GROUP BY 
		A.AccCode, A.Name, A.AliasName, A.LocalAccountName, C.Address1, C.Address2, Area.Name, Area.AreaCode, CC.Name) A
ORDER BY 
	Area, Category, NAME1, AliasName"
  arguments=(("ar_areas", numberlist), ("ar_custcat", numberlist), ("ar_date", datetime), ("ar_restricted", number))
)
