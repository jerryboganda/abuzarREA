release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=456 color="536870912" )
summary(height=8 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=maintype dbname="MainType"  )
column=(type=char(8) updatewhereclause=yes name=type dbname="Type"  )
column=(type=long updatewhereclause=yes name=id dbname="ID"  )
column=(type=char(60) updatewhereclause=yes name=source dbname="Source"  )
column=(type=decimal(2) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=decimal(2) updatewhereclause=yes name=opening dbname="Opening"  )
column=(type=decimal(2) updatewhereclause=yes name=receipts dbname="Receipts"  )
column=(type=decimal(2) updatewhereclause=yes name=payments dbname="Payments"  )
column=(type=decimal(2) updatewhereclause=yes name=closing dbname="Closing"  )
 retrieve="SELECT
	MainType=1,
	BC.Type,
	BC.ID,
	Source=CASE BC.Code 
		WHEN -100 THEN 'Opening Balance' 
		WHEN -101 THEN 'Cash From Sales' 
		WHEN -102 THEN 'Cash From Service Sales' 
		WHEN -103 THEN 'Cash Paid for Sales Returns' 
		WHEN -104 THEN 'Cash Paid for Servives Sales Returns' 
		WHEN -105 THEN 'Cash Paid for Purchase ' 
		WHEN -106 THEN 'Cash From Purchase Returns' 
		ELSE (SELECT Accounts.Name FROM Accounts WHERE Accounts.AccCode = BC.Code) END,
	Amount=SUM(BC.Amount),
	Opening = 0.00,
	Receipts = 0.00,
	Payments = 0.00,
	Closing = 0.00
FROM
	(/*SELECT V.AccCode, 
		Code=-100,
		Amount = ISNULL(SUM(V.Debit-V.Credit), 0), 
		Type='Opening Balance...............', 
		id=0
	FROM VirtualGL V
	WHERE
		V.Date < :ar_startdate AND
		V.AccCode IN
			(SELECT AccCode 
			FROM Accounts 
			WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	GROUP BY V.AccCode
	UNION ALL
	*/
	SELECT 	V.AccCode,
		Code=-101, 
		Amount = ISNULL(Sum(V.Debit), 0), 
		Type='Receipts', 
		Id=1
	FROM VirtualGl V
	WHERE
		V.DocumentType = 'SV' AND
		V.Debit > 0 AND
		V.Date >= :ar_startdate AND V.Date <= :ar_enddate AND
		V.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	GROUP BY V.AccCode
	UNION ALL
	SELECT 	V.AccCode,
		Code=-102, 
		Amount = ISNULL(Sum(V.Debit), 0), 
		Type='Receipts', 
		Id=2
	FROM VirtualGl V
	WHERE
		V.DocumentType = 'RS' AND
		V.Debit > 0 AND
		V.Date >= :ar_startdate AND V.Date <= :ar_enddate AND
		V.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	GROUP BY V.AccCode
	UNION ALL
	SELECT 	V.AccCode,
		Code=-103, 
		Amount = - ISNULL(Sum(V.Credit), 0), 
		Type='Payments', 
		Id=50
	FROM VirtualGl V
	WHERE
		V.DocumentType = 'SR' AND
		V.Credit > 0 AND
		V.Date >= :ar_startdate AND V.Date <= :ar_enddate AND
		V.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	GROUP BY V.AccCode
	UNION ALL
	SELECT 	V.AccCode,
		Code=-104, 
		Amount = - ISNULL(Sum(V.Credit), 0), 
		Type='Payments', 
		Id=50
	FROM VirtualGl V
	WHERE
		V.DocumentType = 'RR' AND
		V.Credit > 0 AND
		V.Date >= :ar_startdate AND V.Date <= :ar_enddate AND
		V.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	GROUP BY V.AccCode
	UNION ALL
	SELECT 	V.AccCode,
		Code=-105, 
		Amount = - ISNULL(Sum(V.Credit), 0), 
		Type='Payments', 
		Id=50
	FROM VirtualGl V
	WHERE
		V.DocumentType = 'PV' AND
		V.Credit > 0 AND
		V.Date >= :ar_startdate AND V.Date <= :ar_enddate AND
		V.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	GROUP BY V.AccCode
	UNION ALL
	SELECT 	V.AccCode,
		Code=-106, 
		Amount = ISNULL(Sum(V.Debit), 0), 
		Type='Receipts', 
		Id=3
	FROM VirtualGl V
	WHERE
		V.DocumentType = 'PR' AND
		V.Debit > 0 AND
		V.Date >= :ar_startdate AND V.Date <= :ar_enddate AND
		V.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	GROUP BY V.AccCode
	UNION ALL
	SELECT 	GL.AccCode,	/*Cash/Bank Receipts & Payments Customized For CASH/BANK (Other than JV)*/
		Code=GD.AccCode, 
		Amount = ISNULL(GD.Credit - GD.Debit, 0), 
		Type=CASE WHEN GD.Credit - GD.Debit > 0 THEN 'Receipts' ELSE 'Payments' END, 
		Id=CASE WHEN GD.Credit - GD.Debit > 0  THEN 11 ELSE 51 END
	FROM GlDetail GD, GlHeader GL, VocherCategory VC
	WHERE
		GL.Posted='Y' AND
		GL.Date >= :ar_startdate AND GL.Date <= :ar_enddate AND
		GL.GlVochCode = GD.GlVochCode AND
		GL.VochCatCode = VC.VochCatCode AND
		VC.JournalVoucher=0 AND
		GL.AccCode <> GD.AccCode AND	
		GL.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	UNION ALL
	SELECT GD.AccCode,	/*Cash/Bank Receipts & Payments Customized For CASH/BANK (Other than JV) CONTRA AFFECT*/
		Code=GL.AccCode, 
		Amount = ISNULL(GD.Debit - GD.Credit, 0), 
		Type=CASE WHEN GD.Debit - GD.Credit > 0 THEN 'Receipts' ELSE 'Payments' END, 
		Id=CASE WHEN GD.Debit - GD.Credit > 0 THEN 12 ELSE 52 END
	FROM GlDetail GD, GlHeader GL, VocherCategory VC
	WHERE
		GL.POsted='Y' AND
		GL.Date >= :ar_startdate AND GL.Date <= :ar_enddate AND
		GL.GlVochCode = GD.GlVochCode AND
		GL.VochCatCode = VC.VochCatCode AND
		VC.JournalVoucher=0 AND
		GL.AccCode <> GD.AccCode AND
		GD.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3)) AND
		GL.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	UNION ALL
	SELECT GD.AccCode,	/*Cash/Bank Receipts & Payments (Other than JV) NOT Customized For CASH/BANK*/
		Code=GL.AccCode, 
		Amount = ISNULL(GD.Debit - GD.Credit, 0), 
		Type=CASE WHEN GD.Debit > 0 THEN 'Receipts' ELSE 'Payments' END, 
		Id=CASE WHEN GD.Debit > 0 THEN 13 ELSE 53 END
	FROM GlDetail GD, GlHeader GL, VocherCategory VC
	WHERE
		GL.POsted='Y' AND
		GL.Date >= :ar_startdate AND GL.Date <= :ar_enddate AND
		GL.VochCatCode = VC.VochCatCode AND
		VC.JournalVoucher=0 AND
		GL.GlVochCode = GD.GlVochCode AND
		GD.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3)) AND
		GL.AccCode NOT IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	UNION ALL
	SELECT GD.AccCode,	/*Journal Vocher Cash/Bank Receipts OR Payments*/
		Code=GD.AccCode, 
		Amount = ISNULL(Debit - GD.Credit, 0), 
		Type= CASE WHEN Debit > 0 THEN 'Receipts' ELSE 'Payments' END,
		Id= CASE WHEN Debit > 0 THEN 14 ELSE 54 END
	FROM GlDetail GD, GlHeader GL, VocherCategory VC
	WHERE
		GL.POsted='Y' AND
		GL.Date >= :ar_startdate AND GL.Date <= :ar_enddate AND
		GL.VochCatCode = VC.VochCatCode AND
		VC.JournalVoucher=1 AND
		GL.GlVochCode = GD.GlVochCode AND
		GD.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	UNION ALL
	SELECT 	V.AccCode,
		Code=V.AccCode, 
		Amount = ISNULL(V.Debit - V.Credit, 0), 
		Type=CASE WHEN V.Debit > 0 THEN 'Receipts' ELSE 'Payments' END, 
		Id=CASE WHEN V.Debit > 0 THEN 15 ELSE 55 END
	FROM VirtualGl V
	WHERE
		V.DocumentType IN ('NR', 'NP') AND
		V.Date >= :ar_startdate AND V.Date <= :ar_enddate AND
		V.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))) BC
GROUP BY
	BC.Type,
	BC.ID,
	BC.Code
UNION ALL
SELECT
	MainType=2,
	Type=' ',
	ID=0,
	Source=	(SELECT Accounts.Name FROM Accounts WHERE Accounts.AccCode = BC.AccCode),
	Amount=0.00,
	Opening = SUM(BC.Opening),
	Receipts = SUM(BC.Receipts),
	Payments = SUM(Payments),
	Closing = SUM(BC.Closing)
FROM
	(SELECT V.AccCode, 
		Opening = ISNULL(SUM(V.Debit-V.Credit), 0),
		Receipts = 0.00,
		Payments = 0.00,
		Closing = 0.00
	FROM VirtualGL V
	WHERE
		V.Date < :ar_startdate AND
		V.AccCode IN
			(SELECT AccCode 
			FROM Accounts 
			WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	GROUP BY V.AccCode
	UNION ALL
	SELECT V.AccCode, 
		Opening = 0.00,
		Receipts = 0.00,
		Payments = 0.00,
		Closing = ISNULL(SUM(V.Debit-V.Credit), 0)
	FROM VirtualGL V
	WHERE
		V.Date <= :ar_enddate AND
		V.AccCode IN
			(SELECT AccCode 
			FROM Accounts 
			WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	GROUP BY V.AccCode
	UNION ALL
	SELECT 	V.AccCode,
		Opening = 0.00,
		Receipts = ISNULL(Sum(V.Debit), 0), 
		Payments = ISNULL(Sum(V.Credit), 0), 
		Closing = 0.00
	FROM VirtualGl V
	WHERE
		V.Date BETWEEN :ar_startdate AND :ar_enddate AND
		V.AccCode IN
			(SELECT AccCode FROM Accounts WHERE SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
	GROUP BY V.AccCode) BC
WHERE BC.AccCode IN 
	(SELECT DISTINCT AccCode FROM VirtualGL WHERE Date BETWEEN :ar_startdate AND :ar_enddate AND :ar_transacconly=1
	UNION
	SELECT AccCode FROM Accounts WHERE :ar_transacconly=0 AND SUBCODE IN 
				(SELECT Code FROM Global WHERE Name = LOWER('GT_CashSub') AND (:ar_cashbank=1 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name = LOWER('GT_BankSub') AND (:ar_cashbank=2 OR :ar_cashbank=3)
				UNION
				SELECT Code FROM Global WHERE Name IN (LOWER('GT_CashSub'), LOWER('GT_BankSub')) AND :ar_cashbank=3))
GROUP BY
	BC.AccCode
ORDER BY
	MainType,
	id,
	TYPE Desc,
	source
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_cashbank", number), ("ar_transacconly", number))
)
group(level=1 header.height=180 trailer.height=76 by=("maintype"  ) header.color="536870912" trailer.color="536870912" )
group(level=2 header.height=76 trailer.height=76 by=("type"  ) header.color="536870912" trailer.color="536870912" )
