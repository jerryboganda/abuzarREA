table(column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=decimal(2) updatewhereclause=yes name=openingbal dbname="openingbal"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=long updatewhereclause=yes name=docoumentno dbname="docoumentno"  )
column=(type=datetime updatewhereclause=yes name=tdate dbname="tdate"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(100) updatewhereclause=yes name=documenttype dbname="documenttype"  )
column=(type=decimal(0) updatewhereclause=yes name=currbalance dbname="CurrBalance"  )
 retrieve="SELECT  AccountName= (select name from accounts where AccCode=reportdata.code1),
		  openingbal=reportdata.value3,
		  debit=value1,
		  credit=value2,
		  docoumentno=code2,
        tdate=reportdata.date1,
		  remarks=name2,
		  documenttype=name3,
		  CurrBalance=9999999999
from reportdata
order by date1"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime))
)
