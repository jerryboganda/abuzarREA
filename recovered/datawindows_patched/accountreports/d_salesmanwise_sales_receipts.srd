release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=644 color="536870912" )
summary(height=88 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=smancode dbname="SManCode"  )
column=(type=char(72) updatewhereclause=yes name=month dbname="Month"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="SalesMan"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=receipts dbname="receipts"  )
column=(type=decimal(2) updatewhereclause=yes name=saleamount dbname="saleamount"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
 retrieve="Select 	SManCode = IsNull(A.smancode, :al_salesmancode ),
			Month = DateName(Month, Cast( :al_month As VarChar(2)) + '/01/' + Cast( :al_year As VarChar(4)) ) + '  ' + Cast( :al_year As VarChar(4) ) ,
			SalesMan = ( Select Name From SalesMan Where SalesManCode = IsNull(A.smancode, :al_salesmancode ) ),
			D.date,
       	receipts = IsNull( Sum(A.credit) , 0 ),
       	saleamount = IsNull( Sum(A.saleamount) , 0 ) ,
       	rate = IsNull( Sum(A.amount) , 0 )
From 
(
Select  	smancode = glheader.smancode,
			credit = gldetail.credit,
			amount = 0 ,
			saleamount = 0,
      	date = Convert(VarChar(12),glheader.date,103)
From    glheader , gldetail
Where   	glheader.glvochcode = gldetail.glvochcode And
			glheader.Posted = 'Y' And
			glheader.smancode IN (:al_salesmancode) AND
			gldetail.credit > 0 AND
			glheader.vochcatcode IN (2, 4, 12, 13) and glheader.acccode <> gldetail.acccode and 
			Month(glheader.date) = :al_month  And
			Year(glheader.date) = :al_year  
Union All
Select  	smancode = sl.smancode,
			credit = 0,
			amount=Round(
							SUM((SD.looseqty*(SD.Rate - SD.itemflatdisc)) *
							(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
							SL.misccharges + SL.salestax - SL.flatdisc, 0)+
							Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
							SUM(ROUND( (SD.looseqty * (SD.Rate - SD.itemflatdisc)) *
								(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
							ROUND( (SUM((SD.looseqty * 
								(SD.Rate - SD.itemflatdisc)) *
								(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
								SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0),
			saleamount=Round(
							SUM((SD.looseqty*(SD.saleprice - SD.itemflatdisc)) *
							(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) + 
							SL.misccharges + SL.salestax - SL.flatdisc, 0)+
							Round(SUM( (SD.looseqty + SD.bonusqty) * SD.unitsalestax) + 
							SUM(ROUND( (SD.looseqty * (SD.saleprice - SD.itemflatdisc)) *
								(1 - (.01 * SD.discperc)) * SD.gstperc * .01, 2)) +
							ROUND( (SUM((SD.looseqty * 
								(SD.saleprice - SD.itemflatdisc)) *
								(1 - (.01 * SD.discperc))) * (1- (.01 * SL.discperc)) -
								SL.flatdisc) * (SL.invgstperc1 * .01), 2), 0),
      	date = Convert( VarChar(12), sl.date , 103 )
From    SaleLedger sl , SaleDetail sd
Where   	sl.saleinvcode = sd.saleinvcode And
			sl.Posted = 'Y' And
			sl.smancode IN (:al_salesmancode) And
			Month(sl.date) = :al_month And
			Year(sl.date) = :al_year  
Group By SL.SaleInvCode,
	 		SL.smancode,
	 		SL.date,
	 		SL.discperc,
	 		SL.flatdisc,
	 		SL.invgstperc1,
	 		SL.MiscCharges,
	 		SL.SalesTax

) A Right Outer Join udf_DaysOfMonthList( :al_month , :al_year ) D On A.Date = Convert( VarChar(12), D.Date , 103) 

Group By 	A.smancode,
			 	D.date"
  arguments=(("al_salesmancode", number), ("al_month", number), ("al_year", number))
)
