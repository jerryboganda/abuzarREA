table(column=(type=long updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=long updatewhereclause=yes name=accopenbal dbname="AccOpenBal"  )
column=(type=decimal(2) updatewhereclause=yes name=accopenbalval dbname="AccOpenBalVal"  )
column=(type=long updatewhereclause=yes name=loyaltycardcode dbname="LoyaltyCardCode"  )
column=(type=char(100) updatewhereclause=yes name=loyaltycardid dbname="LoyaltyCardID"  )
column=(type=long updatewhereclause=yes name=loyaltycardopenbal dbname="LoyaltyCardOpenBal"  )
column=(type=decimal(2) updatewhereclause=yes name=loyaltycardopenbalval dbname="LoyaltyCardOpenBalVal"  )
column=(type=char(2) updatewhereclause=yes name=invoicetype dbname="InvoiceType"  )
column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=decimal(2) updatewhereclause=yes name=invoiceamt dbname="InvoiceAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=loyaltyamt dbname="LoyaltyAmt"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=pointsdebit dbname="PointsDebit"  )
column=(type=long updatewhereclause=yes name=pointscredit dbname="PointsCredit"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=char(1000) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(100) updatewhereclause=no name=mobileno dbname="MobileNo"  )
column=(type=datetime updatewhereclause=yes name=carddate dbname="CardDate"  )
column=(type=datetime updatewhereclause=yes name=cardexpiry dbname="CardExpiry"  )
 retrieve="SELECT 
	RowID=1,
	AccCode=A.AccCode, 
	AliasName=A.AliasName,
	AccountName = A.Name,
	AccOpenBal = ISNULL((SELECT SUM(L.PointsDebit - L.PointsCredit) FROM loyaltycardledger L WHERE L.AccCode = LCL.AccCode AND L.Date < :ad_startdate), 0),
	AccOpenBalVal = ISNULL((SELECT SUM(L.Debit - L.Credit) FROM loyaltycardledger L WHERE L.AccCode = LCL.AccCode AND L.Date < :ad_startdate), 0),
	LoyaltyCardCode= LCL.LoyaltyCardCode, 
	LoyaltyCardID = (SELECT L.LoyaltyCardID FROM LoyaltyCard L WHERE L.LoyaltyCardCode = LCL.LoyaltyCardCode), 
	LoyaltyCardOpenBal = ISNULL((SELECT SUM(L.PointsDebit - L.PointsCredit) FROM loyaltycardledger L WHERE L.LoyaltyCardCode = LCL.LoyaltyCardCode AND L.Date < :ad_startdate), 0),
	LoyaltyCardOpenBalVal = ISNULL((SELECT SUM(L.Debit - L.Credit) FROM loyaltycardledger L WHERE L.LoyaltyCardCode = LCL.LoyaltyCardCode AND L.Date < :ad_startdate), 0),
	InvoiceType=LCL.InvoiceType, 
	InvoiceCode=LCL.InvoiceCode, 
	InvoiceAmt = CASE LCL.InvoiceType WHEN 'SV' THEN ISNULL((SELECT SL.InvTotal FROM SaleLedger SL WHERE SL.SaleInvCode = LCL.InvoiceCode),0) WHEN 'SR' THEN ISNULL((SELECT SL.InvTotal FROM SRLedger SL WHERE SL.SRInvCode = LCL.InvoiceCode),0) ELSE NULL END,
	LoyaltyAmt = CASE LCL.InvoiceType WHEN 'SV' THEN ISNULL(dbo.fn_GetSaleInvLoyaltyTotal(LCL.InvoiceCode),0) WHEN 'SR' THEN ISNULL(dbo.fn_GetSRInvLoyaltyTotal(LCL.InvoiceCode),0) ELSE NULL END,
	Date=LCL.Date, 
	PointsDebit=LCL.PointsDebit, 
	PointsCredit=LCL.PointsCredit, 
	Debit=LCL.Debit, 
	Credit=LCL.Credit, 
	Remarks=LCL.Remarks,
	MobileNo = (SELECT C.CellNo FROM Customer C WHERE C.CustCode=A.AccCode),
	CardDate=(SELECT L.Date FROM LoyaltyCard L WHERE L.LoyaltyCardCode = LCL.LoyaltyCardCode),
	CardExpiry=(SELECT L.ExpiryDate FROM LoyaltyCard L WHERE L.LoyaltyCardCode = LCL.LoyaltyCardCode)
FROM loyaltycardledger LCL, Accounts A
WHERE 
	:ai_one_or_all = 0 AND
	A.AccCode IN (:ai_acccode) AND
	A.AccCode = LCL.AccCode AND
	LCL.Date BETWEEN :ad_startdate AND :ad_enddate
UNION ALL
SELECT 
	RowID=0,
	AccCode=A.AccCode, 
	AliasName=A.AliasName,
	AccountName = A.Name,
	AccOpenBal = ISNULL((SELECT SUM(L.PointsDebit - L.PointsCredit) FROM loyaltycardledger L WHERE L.AccCode = A.AccCode AND L.Date < :ad_startdate), 0),
	AccOpenBalVal = ISNULL((SELECT SUM(L.Debit - L.Credit) FROM loyaltycardledger L WHERE L.AccCode = A.AccCode AND L.Date < :ad_startdate), 0),
	LoyaltyCardCode=L.LoyaltyCardCode, 
	LoyaltyCardID = L.LoyaltyCardID, 
	LoyaltyCardOpenBal = ISNULL((SELECT SUM(LL.PointsDebit - LL.PointsCredit) FROM loyaltycardledger LL WHERE LL.LoyaltyCardCode = L.LoyaltyCardCode AND LL.Date < :ad_startdate), 0),
	LoyaltyCardOpenBalVal = ISNULL((SELECT SUM(LL.Debit - LL.Credit) FROM loyaltycardledger LL WHERE LL.LoyaltyCardCode = L.LoyaltyCardCode AND LL.Date < :ad_startdate), 0),
	InvoiceType='OP', 
	InvoiceCode=NULL, 
	InvoiceAmt = NULL,
	LoyaltyAmt = NULL,
	Date=:ad_startdate, 
	PointsDebit=0, 
	PointsCredit=0, 
	Debit=0.00, 
	Credit=0.00, 
	Remarks,
	MobileNo = (SELECT C.CellNo FROM Customer C WHERE C.CustCode=A.AccCode),
	CardDate=L.Date,
	CardExpiry=L.ExpiryDate
FROM Accounts A, LoyaltyCard L
WHERE 
	:ai_one_or_all = 0 AND
	A.AccCode IN (:ai_acccode) AND
	A.AccCode = L.AccCode AND
	A.AccCode NOT IN (SELECT DISTINCT K.AccCode FROM loyaltycardledger K WHERE K.Date BETWEEN :ad_startdate AND :ad_enddate)
UNION ALL
SELECT 
	RowID=1,
	AccCode=A.AccCode, 
	AliasName=A.AliasName,
	AccountName = A.Name,
	AccOpenBal = ISNULL((SELECT SUM(L.PointsDebit - L.PointsCredit) FROM loyaltycardledger L WHERE L.AccCode = LCL.AccCode AND L.Date < :ad_startdate), 0),
	AccOpenBalVal = ISNULL((SELECT SUM(L.Debit - L.Credit) FROM loyaltycardledger L WHERE L.AccCode = LCL.AccCode AND L.Date < :ad_startdate), 0),
	LoyaltyCardCode= LCL.LoyaltyCardCode, 
	LoyaltyCardID = (SELECT L.LoyaltyCardID FROM LoyaltyCard L WHERE L.LoyaltyCardCode = LCL.LoyaltyCardCode), 
	LoyaltyCardOpenBal = ISNULL((SELECT SUM(L.PointsDebit - L.PointsCredit) FROM loyaltycardledger L WHERE L.LoyaltyCardCode = LCL.LoyaltyCardCode AND L.Date < :ad_startdate), 0),
	LoyaltyCardOpenBalVal = ISNULL((SELECT SUM(L.Debit - L.Credit) FROM loyaltycardledger L WHERE L.LoyaltyCardCode = LCL.LoyaltyCardCode AND L.Date < :ad_startdate), 0),
	InvoiceType=LCL.InvoiceType, 
	InvoiceCode=LCL.InvoiceCode, 
	InvoiceAmt = CASE LCL.InvoiceType WHEN 'SV' THEN ISNULL((SELECT SL.InvTotal FROM SaleLedger SL WHERE SL.SaleInvCode = LCL.InvoiceCode),0) WHEN 'SR' THEN ISNULL((SELECT SL.InvTotal FROM SRLedger SL WHERE SL.SRInvCode = LCL.InvoiceCode),0) ELSE NULL END,
	LoyaltyAmt = CASE LCL.InvoiceType WHEN 'SV' THEN ISNULL(dbo.fn_GetSaleInvLoyaltyTotal(LCL.InvoiceCode),0) WHEN 'SR' THEN ISNULL(dbo.fn_GetSRInvLoyaltyTotal(LCL.InvoiceCode),0) ELSE NULL END,
	Date=LCL.Date, 
	PointsDebit=LCL.PointsDebit, 
	PointsCredit=LCL.PointsCredit, 
	Debit=LCL.Debit, 
	Credit=LCL.Credit, 
	Remarks=LCL.Remarks,
	MobileNo = (SELECT C.CellNo FROM Customer C WHERE C.CustCode=A.AccCode),
	CardDate=(SELECT L.Date FROM LoyaltyCard L WHERE L.LoyaltyCardCode = LCL.LoyaltyCardCode),
	CardExpiry=(SELECT L.ExpiryDate FROM LoyaltyCard L WHERE L.LoyaltyCardCode = LCL.LoyaltyCardCode)
FROM loyaltycardledger LCL, Accounts A
WHERE 
	:ai_one_or_all = 1 AND
	A.AccCode = LCL.AccCode AND
	LCL.Date BETWEEN :ad_startdate AND :ad_enddate
UNION ALL
SELECT 
	RowID=0,
	AccCode=A.AccCode, 
	AliasName=A.AliasName,
	AccountName = A.Name,
	AccOpenBal = ISNULL((SELECT SUM(L.PointsDebit - L.PointsCredit) FROM loyaltycardledger L WHERE L.AccCode = A.AccCode AND L.Date < :ad_startdate), 0),
	AccOpenBalVal = ISNULL((SELECT SUM(L.Debit - L.Credit) FROM loyaltycardledger L WHERE L.AccCode = A.AccCode AND L.Date < :ad_startdate), 0),
	LoyaltyCardCode=L.LoyaltyCardCode, 
	LoyaltyCardID = L.LoyaltyCardID, 
	LoyaltyCardOpenBal = ISNULL((SELECT SUM(LL.PointsDebit - LL.PointsCredit) FROM loyaltycardledger LL WHERE LL.LoyaltyCardCode = L.LoyaltyCardCode AND LL.Date < :ad_startdate), 0),
	LoyaltyCardOpenBalVal = ISNULL((SELECT SUM(LL.Debit - LL.Credit) FROM loyaltycardledger LL WHERE LL.LoyaltyCardCode = L.LoyaltyCardCode AND LL.Date < :ad_startdate), 0),
	InvoiceType='OP', 
	InvoiceCode=NULL, 
	InvoiceAmt = NULL,
	LoyaltyAmt = NULL,
	Date=:ad_startdate, 
	PointsDebit=0, 
	PointsCredit=0, 
	Debit=0.00, 
	Credit=0.00, 
	Remarks,
	MobileNo = (SELECT C.CellNo FROM Customer C WHERE C.CustCode=A.AccCode),
	CardDate=L.Date,
	CardExpiry=L.ExpiryDate
FROM Accounts A, LoyaltyCard L
WHERE 
	:ai_one_or_all = 1 AND
	A.AccCode = L.AccCode AND
	A.AccCode NOT IN (SELECT DISTINCT K.AccCode FROM loyaltycardledger K WHERE K.Date BETWEEN :ad_startdate AND :ad_enddate)"
  arguments=(("ai_acccode", numberlist), ("ai_one_or_all", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="accountname A, loyaltycardid A, rowid A, date A, invoicetype A, invoicecode A"
)
