table(column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(60) updatewhereclause=yes name=groupaccount dbname="GroupAccount"  )
column=(type=decimal(2) updatewhereclause=yes name=openingbalance dbname="OpeningBalance"  )
column=(type=decimal(2) updatewhereclause=yes name=totaldebits dbname="TotalDebits"  )
column=(type=decimal(2) updatewhereclause=yes name=totalcredits dbname="TotalCredits"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=decimal(2) updatewhereclause=yes name=balancelimit dbname="BalanceLimit"  )
column=(type=decimal(2) updatewhereclause=yes name=availablebalance dbname="AvailableBalance"  )
 retrieve="SELECT 
	AccountName=name1, 
	GroupAccount=Name2,
	OpeningBalance=ISNULL(OpeningBalance, 0),
	TotalDebits=ISNULL(TotalDebits, 0),
	TotalCredits=ISNULL(TotalCredits, 0),
	Balance = ISNULL(Value1, 0),
	AliasName,
	BalanceLimit=ISNULL(BalanceLimit, 0),
	AvailableBalance = 
		CASE 
		WHEN ISNULL(Value1, 0) > 0 AND ISNULL(BalanceLimit, 0) < 0 THEN 
			ISNULL(ABS(value1),0) + ISNULL(ABS(balancelimit),0)
		WHEN ISNULL(Value1, 0) < 0 AND ISNULL(BalanceLimit, 0) > 0 THEN 
			ISNULL(ABS(value1),0) + ISNULL(ABS(balancelimit),0)
		WHEN ISNULL(Value1, 0) < 0 AND ISNULL(BalanceLimit, 0) < 0 THEN 
			CASE WHEN Value1 > BalanceLimit THEN ISNULL(ABS(BalanceLimit), 0) - ISNULL(ABS(Value1), 0)
			ELSE 0 END
		WHEN ISNULL(Value1, 0) > 0 AND ISNULL(BalanceLimit, 0) > 0 THEN 
			CASE WHEN ISNULL(BalanceLimit,0) > ISNULL(Value1,0) THEN ISNULL(ABS(BalanceLimit), 0) - ISNULL(ABS(Value1), 0)
			WHEN ISNULL(BalanceLimit,0) < ISNULL(Value1,0) THEN 0.00
			ELSE ISNULL(ABS(Value1), 0) - ISNULL(ABS(BalanceLimit), 0) END
		ELSE
			ISNULL(ABS(Value1), 0) - ISNULL(ABS(BalanceLimit), 0)
		END
FROM
	(SELECT 
		A.AccCode, 
		A.Name AS name1, 
		S.Name AS Name2, 
		OpeningBalance = (SELECT Sum(Debit - Credit) AS value1 FROM VirtualGL V WHERE V.AccCode = A.AccCode AND V.Date < :adt_startdate), 
		TotalDebits = (SELECT Sum(Debit) AS value1 FROM VirtualGL V WHERE V.AccCode = A.AccCode AND V.Date BETWEEN :adt_startdate AND :adt_enddate), 
		TotalCredits = (SELECT Sum(Credit) AS value1 FROM VirtualGL V WHERE V.AccCode = A.AccCode AND V.Date BETWEEN :adt_startdate AND :adt_enddate), 
		Value1 = (SELECT Sum(Debit - Credit) AS value1 FROM VirtualGL V WHERE V.AccCode = A.AccCode AND V.Date <= :adt_enddate), 
		A.AliasName, 
		A.BalanceLimit
	FROM
		  Accounts A,
		  SubAccounts S
	WHERE 
			(A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'Y' END OR
			A.Restricted = CASE WHEN :ar_restricted = 0 THEN 'N' ELSE 'N' END) AND
			A.SubCode = S.SubAccCode AND
			A.SubCode IN (SELECT Code FROM Global WHERE NAME ='GT_BankSub')
	GROUP BY A.AccCode, A.Name, S.Name, A.AliasName, A.BalanceLimit) A
ORDER BY GroupAccount, AccountName, AliasName
   
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ar_restricted", number))
)
