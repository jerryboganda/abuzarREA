table(column=(type=long updatewhereclause=yes name=status dbname="Status"  )
column=(type=long updatewhereclause=yes name=documentcode dbname="VirtualGl.documentcode"  )
column=(type=char(28) updatewhereclause=yes name=type dbname="type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remark"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="cash"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="VirtualGl.aliasname"  )
column=(type=char(152) updatewhereclause=yes name=address dbname="address"  )
column=(type=decimal(2) updatewhereclause=yes name=openbalance dbname="openbalance"  )
column=(type=datetime updatewhereclause=yes name=suppinvdate dbname="SuppInvDate"  )
column=(type=char(100) updatewhereclause=no name=suppinvcode dbname="SuppInvCode"  )
column=(type=char(100) updatewhereclause=no name=grn dbname="GRN"  )
column=(type=char(100) updatewhereclause=no name=vehicle dbname="Vehicle"  )
column=(type=decimal(2) updatewhereclause=yes name=suppinvamount dbname="SuppInvAmount"  )
column=(type=decimal(4) updatewhereclause=yes name=totalqty dbname="TotalQty"  )
column=(type=decimal(2) updatewhereclause=yes name=freight dbname="Freight"  )
column=(type=decimal(2) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="VirtualGl.CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VirtualGl.VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VirtualGl.vouchercode"  )
column=(type=long updatewhereclause=yes name=pendingcheque dbname="PendingCheque"  )
 retrieve="select 
	Status=0,
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Debit,
	credit= V.Credit,
	remark = V.Remarks,
	Supplier=S.name,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	S.aliasname,
	address=S.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=S.acccode and 
				virtualgl.date < :ar_startdate),
	SuppInvDate=(SELECT MAX(P.SuppInvDate) FROM PurLedger P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	SuppInvCode=(SELECT MAX(P.SuppInvCode) FROM PurLedger P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	GRN = (SELECT MAX(P.GRN) FROM PurLedger P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	Vehicle =(SELECT MAX(P.Vehicle) FROM PurLedger P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	SuppInvAmount=(SELECT MAX(P.SuppInvAmount) FROM PurLedger P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	TotalQty=(SELECT SUM(P.Packqty + P.LooseQty + P.BonusQty) FROM PurDetail P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	Freight=(SELECT SUM(P.Amount) FROM PurExp P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	Discount=(SELECT SUM((P.Packqty + P.LooseQty) * P.ItemFlatDisc) + SUM((P.Packqty + P.LooseQty) * P.PurPrice * (P.DiscPerc * 0.01)) + SUM((P.Packqty + P.LooseQty) * P.PurPrice * (1 - P.DiscPerc * 0.01) * (L.DiscPerc * 0.01)) + SUM(L.FlatDisc) FROM PurLedger L, PurDetail P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode AND L.PurInvCode=V.DocumentCode AND P.PurInvCode=L.PurInvCode),
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	PendingCheque=0
from     
	VirtualGL V,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode) S

where   (V.AccCode = S.AccCode OR V.AlternateAccCode = S.AccCode ) and
	V.documenttype IN ('PV') AND
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
union all
select	
	Status=0,
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Credit,
	credit= V.Debit,
	remark = V.Remarks,
	S.name,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	S.aliasname,
	address=S.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=S.acccode and 
				virtualgl.date < :ar_startdate),
	SuppInvDate=(SELECT MAX(P.SuppInvDate) FROM PurLedger P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	SuppInvCode=(SELECT MAX(P.SuppInvCode) FROM PurLedger P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	GRN = (SELECT MAX(P.GRN) FROM PurLedger P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	Vehicle =(SELECT MAX(P.Vehicle) FROM PurLedger P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	SuppInvAmount=(SELECT MAX(P.SuppInvAmount) FROM PurLedger P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	TotalQty=(SELECT SUM(P.Packqty + P.LooseQty + P.BonusQty) FROM PurDetail P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	Freight=(SELECT SUM(P.Amount) FROM PurExp P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode),
	Discount=(SELECT SUM((P.Packqty + P.LooseQty) * P.ItemFlatDisc) + SUM((P.Packqty + P.LooseQty) * P.PurPrice * (P.DiscPerc * 0.01)) + SUM((P.Packqty + P.LooseQty) * P.PurPrice * (1 - P.DiscPerc * 0.01) * (L.DiscPerc * 0.01)) + SUM(L.FlatDisc) FROM PurLedger L, PurDetail P WHERE V.DocumentType='PV' AND P.PurInvCode=V.DocumentCode AND L.PurInvCode=V.DocumentCode AND P.PurInvCode=L.PurInvCode),
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	PendingCheque=0
from
	VirtualGL V,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode) S

where   
	(V.AlternateAccCode = S.AccCode ) and
	V.documenttype IN ('PV') AND
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
union all
select 
	Status=0,
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Debit,
	credit= V.Credit,
	remark = V.Remarks,
	Supplier=S.name,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	S.aliasname,
	address=S.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=S.acccode and 
				virtualgl.date < :ar_startdate),
	SuppInvDate=NULL,
	SuppInvCode=NULL,
	GRN = NULL,
	Vehicle =NULL,
	SuppInvAmount=0.00,
	TotalQty=(SELECT - SUM(P.LooseQty + P.BonusQty) FROM PrDetail P WHERE V.DocumentType='PR' AND P.PrInvCode=V.DocumentCode),
	Freight=0.00,
	Discount=(SELECT - (SUM((P.Packqty + P.LooseQty) * P.PrPrice * (P.DiscPerc * 0.01)) + SUM((P.Packqty + P.LooseQty) * P.PrPrice * (1 - P.DiscPerc * 0.01) * (L.DiscPerc * 0.01)) + SUM(L.FlatDisc)) FROM PrLedger L, PrDetail P WHERE V.DocumentType='PR' AND P.PrInvCode=V.DocumentCode AND L.PrInvCode=V.DocumentCode AND P.PrInvCode=L.PrInvCode),
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	PendingCheque=0
from     
	VirtualGL V,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode) S

where   (V.AccCode = S.AccCode OR V.AlternateAccCode = S.AccCode ) and
	V.documenttype IN ('PR') AND
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
union all
select	
	Status=0,
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Credit,
	credit= V.Debit,
	remark = V.Remarks,
	S.name,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	S.aliasname,
	address=S.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=S.acccode and 
				virtualgl.date < :ar_startdate),
	SuppInvDate=NULL,
	SuppInvCode=NULL,
	GRN = NULL,
	Vehicle =NULL,
	SuppInvAmount=0.00,
	TotalQty=(SELECT - SUM(P.Packqty + P.LooseQty + P.BonusQty) FROM PrDetail P WHERE V.DocumentType='PR' AND P.PrInvCode=V.DocumentCode),
	Freight=0.00,
	Discount=(SELECT - (SUM((P.Packqty + P.LooseQty) * P.PrPrice * (P.DiscPerc * 0.01)) + SUM((P.Packqty + P.LooseQty) * P.PrPrice * (1 - P.DiscPerc * 0.01) * (L.DiscPerc * 0.01)) + SUM(L.FlatDisc)) FROM PrLedger L, PrDetail P WHERE V.DocumentType='PR' AND P.PrInvCode=V.DocumentCode AND L.PrInvCode=V.DocumentCode AND P.PrInvCode=L.PrInvCode),
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	PendingCheque=0
from
	VirtualGL V,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode) S
where   
	(V.AlternateAccCode = S.AccCode ) and
	V.documenttype IN ('PR') AND
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
union all
select 
	Status=0,
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Debit,
	credit= V.Credit,
	remark = V.Remarks,
	Supplier=S.name,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	S.aliasname,
	address=S.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=S.acccode and 
				virtualgl.date < :ar_startdate),
	SuppInvDate=NULL,
	SuppInvCode=NULL,
	GRN = NULL,
	Vehicle = NULL,
	SuppInvAmount=0.00,
	TotalQty=0.00,
	Freight=0.00,
	Discount=0.00,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	PendingCheque=0
from     
	VirtualGL V,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode) S

where   (V.AccCode = S.AccCode OR V.AlternateAccCode = S.AccCode ) and
	V.documenttype NOT IN ('PV','PR') AND
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
union all
select	
	Status=0,
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Credit,
	credit= V.Debit,
	remark = V.Remarks,
	S.name,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	S.aliasname,
	address=S.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=S.acccode and 
				virtualgl.date < :ar_startdate),
	SuppInvDate=NULL,
	SuppInvCode=NULL,
	GRN = NULL,
	Vehicle = NULL,
	SuppInvAmount=0.00,
	TotalQty=0.00,
	Freight=0.00,
	Discount=0.00,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	PendingCheque=0
from
	VirtualGL V,
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode) S

where   
	(V.AlternateAccCode = S.AccCode ) and
	V.documenttype NOT IN ('PV','PR') AND
	V.date     >= :ar_startdate and
	V.date     <= :ar_enddate
UNION ALL
SELECT 
	Status=1,
	V.documentcode, 
	type = '*' + V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	debit = V.Debit, 
	credit= V.Credit,
	remark = V.Remarks,
	S.name,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	S.aliasname,
	address=S.address1+' '+S.address2+' '+S.city,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=S.acccode and 
				virtualgl.date < :ar_startdate),
	SuppInvDate=NULL,
	SuppInvCode=NULL,
	GRN = NULL,
	Vehicle = NULL,
	SuppInvAmount=0.00,
	TotalQty=0.00,
	Freight=0.00,
	Discount=0.00,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	PendingCheque=0
FROM
	(SELECT * FROM DBO.Fn_GetUnposted_AccTrans()) AS V,
	(SELECT	a.aliasname, a.acccode, a.name, s.address1, s.address2, s.city
	FROM	accounts a, supplier s
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = s.suppcode) s
WHERE
	(V.AccCode = S.AccCode OR V.AlternateAccCode = S.AccCode )
UNION ALL
select	
	status = 0,
	documentcode=NULL, 
	type = NULL, 
	date = :ar_enddate, 
	debit = 0,
	credit= 0,
	remark = 'OPENING BALANCE',
	S.name,
	cash = 'N',
	S.aliasname,
	address=S.address1,
	openbalance=(select isnull(sum(debit-credit), 0) from virtualgl 
			where	virtualgl.acccode=S.acccode and 
				virtualgl.date < :ar_startdate),
	SuppInvDate=NULL,
	SuppInvCode=NULL,
	GRN = NULL,
	Vehicle = NULL,
	SuppInvAmount=0.00,
	TotalQty=0.00,
	Freight=0.00,
	Discount=0.00,
	CheckNo=NULL,
	VRow=0,
	vouchercode=NULL,
	PendingCheque=0
from
	(SELECT	a.aliasname, a.acccode, a.name, sp.address1
	FROM	accounts a, supplier sp
	WHERE	a.acccode IN (:ar_suppcode) and 
			a.acccode = sp.suppcode AND 
			a.acccode NOT IN 
			(SELECT DISTINCT VGL.AccCode 
			FROM VirtualGL VGL 
			WHERE VGL.Date BETWEEN :ar_startdate AND :ar_enddate AND 
				VGL.AccCode IN (:ar_suppcode)
			UNION ALL
			SELECT DISTINCT N.AccCode 
			FROM Notes N
			WHERE N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN (:ar_suppcode)
			UNION ALL
			SELECT DISTINCT N.BankAccCode 
			FROM Notes N
			WHERE N.Posted = 'N' AND N.Finalized='Y' AND
				N.AccCode IN (:ar_suppcode)) ) S
order by name, aliasname, Status, date, type, VRow
"
  arguments=(("ar_suppcode", numberlist), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
