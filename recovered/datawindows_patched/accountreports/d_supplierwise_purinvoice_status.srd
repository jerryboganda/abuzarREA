table(column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=datetime updatewhereclause=yes name=duedate dbname="duedate"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(121) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(30) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(30) updatewhereclause=yes name=country dbname="Country"  )
column=(type=decimal(2) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=paidoninv dbname="PaidOnInv"  )
column=(type=decimal(2) updatewhereclause=yes name=otherpayments dbname="OtherPayments"  )
column=(type=decimal(2) updatewhereclause=yes name=credits dbname="Credits"  )
column=(type=decimal(2) updatewhereclause=yes name=chequespaid dbname="ChequesPaid"  )
column=(type=decimal(2) updatewhereclause=yes name=allocatedreturns dbname="AllocatedReturns"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=char(100) updatewhereclause=yes name=suppinvno dbname="SuppInvNo"  )
column=(type=datetime updatewhereclause=yes name=suppinvdate dbname="SuppInvDate"  )
column=(type=long updatewhereclause=yes name=headerinvcode dbname="HeaderInvCode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
 retrieve="SELECT  
	InvoiceCode=P.PurInvCode,
	Date=P.Date,
	duedate=dateadd(dd,p.creditdays,p.date),
	Supplier=A.Name,
	AliasName=A.AliasName,
	Address = RTRIM(LTRIM(S.Address1)) + ' ' + RTRIM(LTRIM(S.Address2)),
	City = S.City,
	Country = S.Country,
	NetAmt=P.InvTotal,
	PaidOnInv=CASE WHEN P.AmtDate <= :ad_statusuptill THEN P.Amt ELSE 0 END,
	OtherPayments=ISNULL((SELECT debit=SUM(debit) FROM GLdetail D, GLHeader H 
			WHERE  H.Date <= :ad_statusuptill AND
					 H.GLVochCode = D.GLVochCode AND 
					 D.InvoiceCode = P.PurInvCode AND 
					 H.VochCatCode IN 
					(SELECT V.VochCatCode FROM VocherCategory V
					WHERE V.InvoiceBased=1 AND V.InvoiceType=2)),0),
	Credits=ISNULL((SELECT credit=SUM(credit) FROM GLdetail D, GLHeader H 
			WHERE  H.Date <= :ad_statusuptill AND 
					 H.GLVochCode = D.GLVochCode AND 
					 D.InvoiceCode = P.PurInvCode AND 
					 H.VochCatCode IN 
					(SELECT V.VochCatCode FROM VocherCategory V
					WHERE V.InvoiceBased=1 AND V.InvoiceType=2)),0),
	ChequesPaid=ISNULL((SELECT Amt=SUM(D.Amt) FROM Notesdetail D, Notes H 
			WHERE H.Posted = 'Y' AND H.PostDate <= :ad_statusuptill AND D.InvoiceCode = P.PurInvCode AND H.NoteCatCode=2 AND H.NoteCode = D.NoteCode), 0),
	AllocatedReturns=ISNULL((SELECT Amt=SUM(D.Amt) FROM PRAllocationdetail D, PRAllocationHeader H 
			WHERE  H.Date <= :ad_statusuptill AND D.PurInvCode = P.PurInvCode AND H.PRAllocationCode = D.PRAllocationCode), 0),
/*	Balance=OutstandingAmt,*/
	Posted=P.Posted,
	SuppInvNo = P.SuppInvCode,
	SuppInvDate = P.SuppInvDate,
	HeaderInvCode=P.HeaderInvNo,
	HeaderNo=P.HeaderNo

FROM PurLedger P, Accounts A, Supplier S
WHERE
	P.AccountFor = 'Y' AND
	P.Marked = 'N' AND
	P.Date >= :ad_startdate AND P.DATE <= :ad_enddate AND
	P.SuppCode = A.AccCode AND
	A.AccCode = S.SuppCode AND
	S.SuppCode IN (:al_suppcode)
ORDER BY
	Supplier,
	PurInvCode,
	Date

"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ad_statusuptill", datetime), ("al_suppcode", numberlist))
 sort="supplier A, invoicecode A, date A"
)
