detail(height=76 color="536870912" )
table(column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="Student.Name"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="Student.StudentCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=regno dbname="Student.RegNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fname dbname="Student.FName"  )
column=(type=long updatewhereclause=yes name=currentclass dbname="Student.CurrentClass" 
 values=""  )
column=(type=char(1) update=yes updatewhereclause=yes name=gender dbname="Student.Gender"  )
column=(type=datetime update=yes updatewhereclause=yes name=birthdate dbname="Student.BirthDate"  )
column=(type=char(60) update=yes updatewhereclause=yes name=phone dbname="Student.Phone"  )
column=(type=char(60) update=yes updatewhereclause=yes name=mobile dbname="Student.Mobile"  )
column=(type=char(1) update=yes updatewhereclause=yes name=status dbname="Student.Status" 
 values="Registered	R/Admitted	A/School Leaving	L/"  )
column=(type=char(40) updatewhereclause=yes name=rollno dbname="RollNo"  )
 retrieve="SELECT 
	Student.Name,   
	Student.StudentCode,   
	Student.RegNo,   
	Student.FName,   
	Student.CurrentClass,
	Student.Gender,   
	Student.BirthDate,   
	Student.Phone,   
	Student.Mobile,   
	Student.Status,
	RollNo =  
		(SELECT C=MAX(SC.RollNo) 
		FROM StudentClass SC, Class C 
		WHERE SC.StudentCode=Student.StudentCode AND 
			Student.CurrentClass= SC.ClassCode AND
			SC.ClassCode = C.ClassCode AND C.Active='Y')
FROM 
	Student  
ORDER BY 
	Student.Name ASC,   
	Student.RegNo ASC   
"
  update="Student" updatewhere=1 updatekeyinplace=no
 )
