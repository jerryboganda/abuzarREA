table(column=(type=long identity=yes updatewhereclause=yes name=code dbname="Code"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=long updatewhereclause=yes name=classcode dbname="ClassCode" 
 values=""  )
column=(type=char(40) updatewhereclause=yes name=rollno dbname="RollNo"  )
column=(type=datetime updatewhereclause=yes name=admissiondate dbname="AdmissionDate"  )
column=(type=long updatewhereclause=yes name=lastserviceinvcode dbname="LastServiceInvCode"  )
column=(type=datetime updatewhereclause=yes name=lastserviceinvdate dbname="LastServiceInvDate"  )
column=(type=char(255) updatewhereclause=yes name=reason dbname="Reason"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
 retrieve="SELECT 
	Code=SchoolLeaving.SchoolLeavingCode,
	Date=SchoolLeaving.Date, 
	RegNo = Student.RegNo,
	StudentName = Student.Name,
	StudentCode=SchoolLeaving.StudentCode,
	ClassCode=SchoolLeaving.ClassCode,
	RollNo=SchoolLeaving.RollNo,
	AdmissionDate=SchoolLeaving.AdmissionDate,
	LastServiceInvCode=SchoolLeaving.LastServiceInvCode,
	LastServiceInvDate=SchoolLeaving.LastServiceInvDate,
	Reason=SchoolLeaving.Reason,
	UserCode=SchoolLeaving.UserCode
FROM 
	SchoolLeaving, Student 
WHERE 
	SchoolLeaving.StudentCode = Student.StudentCode
"
 )
