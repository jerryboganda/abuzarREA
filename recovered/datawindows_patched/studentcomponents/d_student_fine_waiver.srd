summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=836 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=serviceinvcode dbname="ServiceHeader.ServiceInvCode"  )
column=(type=long update=yes updatewhereclause=yes name=serviceinvtypecode dbname="ServiceHeader.ServiceInvTypeCode" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=misccharges dbname="ServiceHeader.MiscCharges"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) <= misccharges" validationmsg="~"Fine Waiver Amount should not exceed fined amount~"" initial="0" name=flatdisc dbname="ServiceHeader.FlatDisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=invtotal dbname="ServiceHeader.InvTotal"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=outstandingamt dbname="ServiceHeader.OutStandingAmt"  )
 retrieve="SELECT 
	ServiceHeader.ServiceInvCode,   
	ServiceHeader.ServiceInvTypeCode,
	ServiceHeader.MiscCharges,   
	ServiceHeader.FlatDisc,   
	ServiceHeader.InvTotal,   
	ServiceHeader.OutStandingAmt  
FROM 
	ServiceHeader  
WHERE 
	ServiceHeader.ServiceInvCode = :ai_code
"
  update="ServiceHeader" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
