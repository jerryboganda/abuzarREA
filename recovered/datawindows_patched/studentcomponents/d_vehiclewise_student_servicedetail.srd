release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1489 color="536870912" )
summary(height=218 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=vehicle dbname="vehicle"  )
column=(type=char(100) updatewhereclause=yes name=vehicletype dbname="vehicleType"  )
column=(type=long updatewhereclause=yes name=serviceinvcode dbname="serviceinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=cashreceived dbname="cashreceived"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=servicediscperc dbname="servicediscperc"  )
column=(type=char(60) updatewhereclause=yes name=servicename dbname="servicename"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflatdisc dbname="ServiceFlatDisc"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Person"  )
column=(type=char(60) updatewhereclause=yes name=studentregno dbname="studentregno"  )
column=(type=char(163) updatewhereclause=yes name=studentname dbname="studentname"  )
column=(type=char(100) updatewhereclause=yes name=currentclass dbname="CurrentClass"  )
column=(type=char(6) updatewhereclause=yes name=doctype dbname="doctype"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long identity=yes updatewhereclause=yes name=servicerowid dbname="ServiceRowID"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceflattax dbname="serviceflattax"  )
column=(type=decimal(2) updatewhereclause=yes name=servicegstperc dbname="servicegstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=serviceinvgstperc dbname="serviceinvgstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=receivedoninv dbname="ReceivedOnInv"  )
column=(type=decimal(2) updatewhereclause=yes name=otherreceipts dbname="OtherReceipts"  )
column=(type=decimal(2) updatewhereclause=yes name=otheradj dbname="OtherAdj"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="Balance"  )
 retrieve="SELECT
	vehicle = (SELECT V.Name FROM Vehicle V WHERE V.VehicleCode=dbo.servicedetail.Vehiclecode),
	vehicleType = (SELECT VT.Name FROM Vehicle V,VehicleType VT WHERE V.VehicleCode=dbo.servicedetail.Vehiclecode AND V.VehicleTypeCode=VT.VehicleTypeCode),
	serviceinvcode = dbo.serviceheader.serviceinvcode,    
	date = dbo.serviceheader.date,   
	invdiscperc = dbo.serviceheader.discperc,    
	flatdisc = dbo.serviceheader.flatdisc,    
	misccharges = dbo.serviceheader.misccharges, 
	cashreceived = dbo.serviceheader.cashreceived,
	price = dbo.servicedetail.price,    
	servicediscperc = dbo.servicedetail.discperc,    
	servicename = service.name,
	qty = dbo.servicedetail.qty,
	ServiceFlatDisc = ServiceDetail.ServiceFlatDisc,
	Person = dbo.accounts.name,
	studentregno = (SELECT S.RegNo FROM Student S WHERE S.StudentCode=dbo.serviceheader.studentcode),
	studentname = (SELECT S.Name + ' (' + S.RegNo + ')' FROM Student S WHERE S.StudentCode=dbo.serviceheader.studentcode),
	CurrentClass = (SELECT C.Name FROM Class C, Student S WHERE S.StudentCode=dbo.serviceheader.studentcode AND C.ClassCode = S.CurrentClass),
	doctype=Case dbo.serviceheader.servicecatcode When 12 Then 'Cash' When 11 Then 'Credit' Else 'Cash' End,
	headerno=dbo.serviceheader.headerno,
	ServiceRowID=servicedetail.srvrowid,
	serviceflattax=dbo.servicedetail.serviceflattax,
	servicegstperc=dbo.servicedetail.servicegstperc,
	serviceinvgstperc=dbo.serviceheader.serviceinvgstperc,
	ReceivedOnInv=dbo.serviceheader.cashcharged + ISNULL((SELECT SUM(MCW.Amount) FROM MasterCashWin MCW WHERE MCW.DocumentCode=dbo.serviceheader.serviceinvcode and MCW.documenttype='RS'), 0),
	OtherReceipts=ISNULL((SELECT credit=SUM(D.credit) FROM GLdetail D, GLHeader H 
			WHERE  H.GLVochCode = D.GLVochCode AND D.InvoiceCode = dbo.serviceheader.serviceinvcode AND 
					H.VochCatCode IN (SELECT V.VochCatCode FROM VocherCategory V WHERE V.InvoiceBased=1 AND V.InvoiceType=3)),0),
	OtherAdj=ISNULL((SELECT credit=SUM(D.debit) FROM GLdetail D, GLHeader H 
			WHERE  H.GLVochCode = D.GLVochCode AND D.InvoiceCode = dbo.serviceheader.serviceinvcode AND 
					H.VochCatCode IN (SELECT V.VochCatCode FROM VocherCategory V WHERE V.InvoiceBased=1 AND V.InvoiceType=3)),0),
	Balance = ISNULL(dbo.serviceheader.OutstandingAmt, 0)
FROM
	dbo.serviceheader,
	dbo.servicedetail,
	dbo.service, 
	dbo.accounts

WHERE  
	dbo.serviceheader.date BETWEEN :ad_StartDate and :ad_EndDate  and
	dbo.serviceheader.servicecatcode IN (10,11,12) and
	dbo.serviceheader.serviceinvcode = dbo.servicedetail.serviceinvcode and  
	dbo.servicedetail.servicecode = service.servicecode and 
	dbo.serviceheader.custcode = dbo.accounts.acccode and
	dbo.servicedetail.vehiclecode IN (:ai_vehiclecode)
"
  arguments=(("ai_vehiclecode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime))
 sort="vehicle A, serviceinvcode A, servicerowid A"
)
