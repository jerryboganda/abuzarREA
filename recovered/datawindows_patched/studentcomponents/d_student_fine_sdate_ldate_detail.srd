table(column=(type=long update=yes updatewhereclause=yes name=serviceinvcode dbname="ServiceInvCode"  )
column=(type=datetime update=yes updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=serviceinvtypecode dbname="ServiceInvTypeCode"  )
column=(type=long update=yes updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=studentregno dbname="StudentRegNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=char(100) updatewhereclause=yes name=studentclass dbname="StudentClass"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=oldfine dbname="OldFine"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=oldfeeamt dbname="OldFeeAmt"  )
column=(type=long update=yes updatewhereclause=yes name=newfine dbname="NewFine"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=newfeeamt dbname="NewFeeAmt"  )
 retrieve="SELECT 
	ServiceInvCode=SH.ServiceInvCode, 
	Date=SH.Date,
	ServiceInvTypeCode=SH.ServiceInvTypeCode,
	StudentCode=SH.StudentCode,
	StudentRegNo=(SELECT S.RegNo FROM Student S WHERE S.StudentCode = SH.StudentCode),
	StudentName=(SELECT S.Name FROM Student S WHERE S.StudentCode = SH.StudentCode),
	StudentClass = (SELECT CL.Name FROM Class CL, Student S WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass = CL.ClassCode),
	OldFine=SH.MiscCharges,
	OldFeeAmt = SH.InvTotal,
	NewFine = :ai_fineamt,
	NewFeeAmt = ROUND(SH.InvTotal - SH.MiscCharges + :ai_fineamt, 0)
FROM 
	ServiceHeader SH
WHERE 
	:ac_excludepartialpaidinvoices = 'N' AND 
	SH.InvTotal > 0 AND
	SH.OutStandingAmt > 0 AND 
	SH.Date BETWEEN :adt_startdate AND :adt_enddate AND
	SH.ServiceInvTypeCode = :ai_serviceinvtypecode
UNION
SELECT 
	ServiceInvCode=SH.ServiceInvCode, 
	Date=SH.Date,
	ServiceInvTypeCode=SH.ServiceInvTypeCode,
	StudentCode=SH.StudentCode,
	StudentRegNo=(SELECT S.RegNo FROM Student S WHERE S.StudentCode = SH.StudentCode),
	StudentName=(SELECT S.Name FROM Student S WHERE S.StudentCode = SH.StudentCode),
	StudentClass = (SELECT CL.Name FROM Class CL, Student S WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass = CL.ClassCode),
	OldFine=SH.MiscCharges,
	OldFeeAmt = SH.InvTotal,
	NewFine = :ai_fineamt,
	NewFeeAmt = ROUND(SH.InvTotal - SH.MiscCharges + :ai_fineamt, 0)
FROM 
	ServiceHeader SH
WHERE 
	:ac_excludepartialpaidinvoices = 'Y' AND 
	SH.InvTotal > 0 AND
	SH.OutStandingAmt = SH.InvTotal  AND 
	SH.Date BETWEEN :adt_startdate AND :adt_enddate AND
	SH.ServiceInvTypeCode = :ai_serviceinvtypecode
ORDER BY SH.ServiceInvCode
"
  arguments=(("ai_fineamt", number), ("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_serviceinvtypecode", number), ("ac_excludepartialpaidinvoices", string))
)
