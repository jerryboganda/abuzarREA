table(column=(type=char(20) updatewhereclause=yes name=grade dbname="grade"  )
column=(type=number updatewhereclause=yes name=studentcount dbname="studentcount"  )
 retrieve="SELECT 
	AsON = CAST(CONVERT(VARCHAR(100), :adt_date, 101) AS DATETIME),
	Grade=G.Name, 
	SchoolBranch=SB.Name, 
	StudentCount = COUNT(SC.StudentCode)
FROM 
	Class C, 
	Grade G, 
	SchoolBranch SB, 
	StudentClass SC
WHERE 	
	G.GradeCode=C.GradeCode AND 
	C.SchoolBranchCode = SB.SchoolBranchCode AND 
	C.ClassCode=SC.ClassCode AND
	SC.AdmissionDate BETWEEN :adt_date - 365 AND :adt_date
GROUP BY SB.Name, G.Name, G.NumericalFactor
UNION ALL
SELECT 
	AsON = CAST(CONVERT(VARCHAR(100), :adt_date - 365, 101) AS DATETIME),
	Grade=G.Name, 
	SchoolBranch=SB.Name, 
	StudentCount = COUNT(SC.StudentCode)
FROM 
	Class C, 
	Grade G, 
	SchoolBranch SB, 
	StudentClass SC
WHERE 	
	G.GradeCode=C.GradeCode AND 
	C.SchoolBranchCode = SB.SchoolBranchCode AND 
	C.ClassCode=SC.ClassCode AND
	SC.AdmissionDate BETWEEN :adt_date - (365 * 2) AND :adt_date-365
GROUP BY SB.Name, G.Name, G.NumericalFactor
UNION ALL
SELECT 
	AsON = CAST(CONVERT(VARCHAR(100), :adt_date - (365 * 2), 101) AS DATETIME),
	Grade=G.Name, 
	SchoolBranch=SB.Name, 
	StudentCount = COUNT(SC.StudentCode)
FROM 
	Class C, 
	Grade G, 
	SchoolBranch SB, 
	StudentClass SC
WHERE 	
	G.GradeCode=C.GradeCode AND 
	C.SchoolBranchCode = SB.SchoolBranchCode AND 
	C.ClassCode=SC.ClassCode AND
	SC.AdmissionDate BETWEEN :adt_date - (365 * 3) AND :adt_date - (365 * 2)
GROUP BY SB.Name, G.Name, G.NumericalFactor
UNION ALL
SELECT 
	AsON = CAST(CONVERT(VARCHAR(100), :adt_date - (365 * 3), 101) AS DATETIME),
	Grade=G.Name, 
	SchoolBranch=SB.Name, 
	StudentCount = COUNT(SC.StudentCode)
FROM 
	Class C, 
	Grade G, 
	SchoolBranch SB, 
	StudentClass SC
WHERE 	
	G.GradeCode=C.GradeCode AND 
	C.SchoolBranchCode = SB.SchoolBranchCode AND 
	C.ClassCode=SC.ClassCode AND
	SC.AdmissionDate BETWEEN :adt_date - (365 * 4) AND :adt_date - (365 * 3)
GROUP BY SB.Name, G.Name, G.NumericalFactor
UNION ALL
SELECT 
	AsON = CAST(CONVERT(VARCHAR(100), :adt_date - (365 * 4), 101) AS DATETIME),
	Grade=G.Name, 
	SchoolBranch=SB.Name, 
	StudentCount = COUNT(SC.StudentCode)
FROM 
	Class C, 
	Grade G, 
	SchoolBranch SB, 
	StudentClass SC
WHERE 	
	G.GradeCode=C.GradeCode AND 
	C.SchoolBranchCode = SB.SchoolBranchCode AND 
	C.ClassCode=SC.ClassCode AND
	SC.AdmissionDate BETWEEN :adt_date - (365 * 5) AND :adt_date - (365 * 4)
GROUP BY SB.Name, G.Name
ORDER BY SB.Name, G.Name
"
  arguments=(("adt_date", datetime))
 sort="grade A"
)
