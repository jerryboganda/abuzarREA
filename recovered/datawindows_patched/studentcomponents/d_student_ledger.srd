table(column=(type=long updatewhereclause=yes name=documentcode dbname="VirtualGl.documentcode"  )
column=(type=char(27) updatewhereclause=yes name=type dbname="type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=decimal(2) updatewhereclause=yes name=debit dbname="debit"  )
column=(type=decimal(2) updatewhereclause=yes name=credit dbname="credit"  )
column=(type=char(100) updatewhereclause=yes name=remark dbname="remark"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="cash"  )
column=(type=char(20) updatewhereclause=yes name=checkno dbname="VirtualGl.CheckNo"  )
column=(type=long updatewhereclause=yes name=vrow dbname="VirtualGl.VRow"  )
column=(type=long updatewhereclause=yes name=vouchercode dbname="VirtualGl.vouchercode"  )
column=(type=char(100) updatewhereclause=yes name=classname dbname="ClassName"  )
 retrieve="SELECT 
	V.documentcode, 
	type = V.documenttype + '-' + RTrim(LTrim(convert(char(6), V.documentcode))), 
	date = V.date, 
	StudentCode=S.StudentCode,
	RegNo=S.RegNo, 
	StudentName=S.name,
	Customer = (SELECT Accounts.Name FROM Accounts WHERE V.AccCode = Accounts.AccCode),
	debit = V.Debit,
	credit= V.Credit,
	remark = V.Remarks,
	cash = case ISNULL(v.AlternateAccCode, -1) when -1 then 'N' else 'Y' end,
	V.CheckNo,
	V.VRow,
	V.vouchercode,
	ClassName = (SELECT CL.Name FROM Class CL WHERE S.CurrentClass = CL.ClassCode)
FROM
	VirtualGL V, Student S
WHERE
	V.date <= :ad_enddate AND
	S.StudentCode IN (:ai_Studentcode) AND
	V.StudentCode = S.StudentCode AND
	(V.AccCode IN (SELECT A.AccCode FROM Accounts A WHERE A.SubCode = 3) OR
	ISNULL(V.AlternateAccCode,-1) IN (SELECT A.AccCode FROM Accounts A WHERE A.SubCode = 3))
ORDER BY
	S.RegNo, S.Name, S.StudentCode, date, type, VRow

"
  arguments=(("ad_enddate", datetime), ("ai_Studentcode", numberlist))
 sort="regno A, studentname A, studentcode A, date A, type A, vrow A"
)
