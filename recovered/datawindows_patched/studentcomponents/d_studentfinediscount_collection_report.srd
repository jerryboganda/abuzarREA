table(column=(type=long updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=datetime updatewhereclause=yes name=invdate dbname="InvDate"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(163) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=decimal(2) updatewhereclause=yes name=invamt dbname="InvAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=fine dbname="Fine"  )
column=(type=decimal(2) updatewhereclause=yes name=discount dbname="Discount"  )
column=(type=decimal(2) updatewhereclause=yes name=netreceived dbname="NetReceived"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=datetime updatewhereclause=yes name=receipton dbname="ReceiptOn"  )
column=(type=decimal(2) updatewhereclause=yes name=receiptamt dbname="ReceiptAmt"  )
 retrieve="SELECT  
	InvoiceCode=S.ServiceInvCode, 
	InvDate=S.Date, 
	StudentCode=S.StudentCode, 
	RegNo=ST.RegNo, 
	StudentName = ST.Name + ' (' + ST.RegNo + ')', 
	InvAmt=S.InvTotal, 
	Fine=S.MiscCharges, 
	Discount=S.FlatDisc, 
	NetReceived=S.MiscCharges - S.FlatDisc, 
	UserName=(SELECT U.UserName FROM Users U WHERE U.UserCode = H.SalesmanCode), 
	ReceiptOn=H.Date, 
	ReceiptAmt=D.Credit - D.Debit
FROM 
	GLHeader H, 
	GLDetail D,
	(SELECT SS.ServiceInvCode, SS.Date, SS.StudentCode, SS.InvTotal, SS.MiscCharges, SS.FlatDisc 
	FROM ServiceHeader SS
	WHERE (SS.MiscCharges > 0 OR SS.FlatDisc > 0) AND SS.OutstandingAmt = 0) S,
	Student ST
WHERE 
	H.Date BETWEEN :adt_startdate AND :adt_enddate AND 
	H.GLVochCode = D.GLVochCode AND 
	D.InvoiceCode = S.ServiceInvCode AND 
	S.StudentCode=ST.StudentCode
ORDER BY 
	InvoiceCode"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
)
