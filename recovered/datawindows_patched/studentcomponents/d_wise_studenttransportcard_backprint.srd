release 12.5;
datawindow ( units=3 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 pointer="Arrow!"  print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=502 print.margin.right=502 print.margin.top=502 print.margin.bottom=502 print.paper.size=10 print.paper.source=0 print.canusedefaultprinter=yes print.columns=2 print.columns.width=9200 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=6138 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=long update=yes updatewhereclause=yes initial="22" name=custcode dbname="CustCode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fname dbname="FName"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="M" name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=birthdate dbname="BirthDate"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0.00" name=discperc dbname="DiscPerc"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="R" name=status dbname="Status" 
 values="Registered	R/Admitted	A/Rejected	J/"  )
column=(type=char(40) updatewhereclause=yes name=rollno dbname="RollNo"  )
column=(type=char(100) updatewhereclause=yes name=grade dbname="Grade"  )
column=(type=char(100) updatewhereclause=yes name=class dbname="Class"  )
column=(type=char(100) updatewhereclause=yes name=school dbname="School"  )
column=(type=char(255) updatewhereclause=yes name=schooladdress dbname="SchoolAddress"  )
column=(type=long updatewhereclause=yes name=transportroutecode dbname="TransportRouteCode"  )
column=(type=long updatewhereclause=yes name=vehiclecode dbname="VehicleCode"  )
column=(type=datetime updatewhereclause=yes name=issuedate dbname="IssueDate"  )
column=(type=datetime updatewhereclause=yes name=expirydate dbname="ExpiryDate"  )
column=(type=char(127) updatewhereclause=yes name=filename dbname="FileName"  )
column=(type=char(27) updatewhereclause=yes name=signaturefile dbname="SignatureFile"  )
 retrieve="SELECT  
	StudentCode=Student.StudentCode,
	CustCode=Student.CustCode,
	RegNo=Student.RegNo,
	Name=Student.Name,
	FName=Student.FName,
	Gender=Student.Gender,
	BirthDate=Student.BirthDate,
	DiscPerc=Student.DiscPerc,
	Status=Student.Status,
	RollNo = StudentClass.RollNo,
	Grade = Grade.Name,
	Class=Class.Name,
	School = (SELECT School.Name FROM School WHERE School.SchoolCode = Class.SchoolCode),
	SchoolAddress = (SELECT School.Description FROM School WHERE School.SchoolCode = Class.SchoolCode),
	TransportRouteCode=
		(SELECT Max(SD.TransportRouteCode) 
		FROM StudentServiceTemplateDetail SD 
		WHERE SD.StudentCode = Student.StudentCode AND 
			SD.StudentServiceTemplateCode IN 
				(SELECT Max(STD.StudentServiceTemplateCode) 
				FROM StudentServiceTemplateDetail STD 
				WHERE STD.StudentCode = Student.StudentCode)),
	VehicleCode=
		(SELECT Max(SD.VehicleCode) 
		FROM StudentServiceTemplateDetail SD 
		WHERE SD.StudentCode = Student.StudentCode AND 
			SD.StudentServiceTemplateCode IN 
				(SELECT Max(STD.StudentServiceTemplateCode) 
				FROM StudentServiceTemplateDetail STD 
				WHERE STD.StudentCode = Student.StudentCode)),
	IssueDate = GETDATE(),
	ExpiryDate = ISNULL((SELECT CAST(DBO.FN_GetPreference('DefaultExpiry') AS DATETIME)), GETDATE()+365),
	FileName = 'c:~\waseela_temp~\'+LTRIM(RTRIM(STR(Student.StudentCode)))+'.' + ISNULL((SELECT MIN(Imagetype) FROM StudentImage SI WHERE SI.StudentCode = Student.StudentCode), 'bmp'),
	SignatureFile = 'c:~\waseela_temp~\sigfile.jpg'
FROM
	Student, StudentClass, Class, Grade
WHERE 
	Student.StudentCode IN (:ai_code) AND
	Student.StudentCode = StudentClass.StudentCode AND
	StudentClass.ClassCode = Class.ClassCode AND
	Class.Active = 'Y' AND
	Class.GradeCode = Grade.GradeCode
ORDER BY
	Name"
  arguments=(("ai_code", numberlist))
)
