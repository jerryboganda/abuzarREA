table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="StudentServiceTemplateDetail.StudentServiceTemplateCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="StudentServiceTemplateDetail.StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=fullcode dbname="Aliasname"  )
column=(type=char(163) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="CurrListRow"  )
column=(type=long update=yes updatewhereclause=yes name=transportroutecode dbname="StudentServiceTemplateDetail.TransportRouteCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=vehiclecode dbname="StudentServiceTemplateDetail.VehicleCode"  )
column=(type=char(100) updatewhereclause=yes name=vehiclename dbname="VehicleName" 
 values=""  )
column=(type=long updatewhereclause=yes name=classcode dbname="ClassCode" 
 values=""  )
column=(type=long updatewhereclause=yes name=rowid dbname="StudentServiceTemplateDetail.RowID"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="StudentServiceTemplateDetail.Remarks"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="A" name=status dbname="StudentServiceTemplateDetail.Status" 
 values="Amitted	A/Registered	R/School Leave	L/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=charges dbname="StudentServiceTemplateDetail.Charges"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=discperc dbname="StudentServiceTemplateDetail.DiscPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=serviceflatdisc dbname="StudentServiceTemplateDetail.ServiceFlatDisc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="1" name=qty dbname="StudentServiceTemplateDetail.Qty"  )
 retrieve="SELECT
	StudentServiceTemplateDetail.StudentServiceTemplateCode,
	StudentServiceTemplateDetail.StudentCode,
	Aliasname = Student.RegNo,
	itemname = Student.Name + ' (' + Student.RegNo + ')' ,
	FatherName = Student.FName,
	CurrListRow = 0,
	StudentServiceTemplateDetail.TransportRouteCode,
	StudentServiceTemplateDetail.VehicleCode,
	VehicleName = (SELECT V.Name FROM Vehicle V WHERE V.VehicleCode = StudentServiceTemplateDetail.VehicleCode),
	ClassCode = Student.CurrentClass,
	StudentServiceTemplateDetail.RowID,
	StudentServiceTemplateDetail.Remarks,
	StudentServiceTemplateDetail.Status,
	StudentServiceTemplateDetail.Charges,
	StudentServiceTemplateDetail.DiscPerc,
	StudentServiceTemplateDetail.ServiceFlatDisc,
	StudentServiceTemplateDetail.Qty
FROM 
	StudentServiceTemplateDetail, Student
WHERE 
	StudentServiceTemplateDetail.StudentServiceTemplateCode = :ai_code AND
	StudentServiceTemplateDetail.StudentCode = Student.StudentCode
ORDER BY 
	StudentServiceTemplateDetail.RowID"
  update="StudentServiceTemplateDetail" updatewhere=0 updatekeyinplace=no
  arguments=(("ai_code", number))
)
