table(column=(type=char(100) updatewhereclause=yes name=grade dbname="grade"  )
column=(type=char(100) updatewhereclause=yes name=branch dbname="branch"  )
column=(type=char(40) update=yes updatewhereclause=yes name=rollno dbname="rollno"  )
column=(type=char(60) update=yes updatewhereclause=yes name=regno dbname="Student.regno"  )
column=(type=long update=yes updatewhereclause=yes name=studentcode dbname="studentcode"  )
column=(type=char(100) updatewhereclause=yes name=studentname dbname="studentname"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fname dbname="Student.FName"  )
column=(type=char(100) updatewhereclause=yes name=oldclass dbname="oldclass"  )
column=(type=char(0) updatewhereclause=yes name=newclass dbname="newclass"  )
column=(type=char(0) updatewhereclause=yes name=comments dbname="comments"  )
 retrieve="SELECT
	grade=(select name from grade where grade.gradecode=:ar_gradecode),
	branch=(select name from schoolbranch where schoolbranch.schoolbranchcode=:ar_branchcode),
	rollno=studentclass.rollno,
	regno,
	studentcode=student.studentcode,
	studentname=student.name,
	FName,
	oldclass=(select name from class where class.classcode=student.currentclass),
	newclass='',
	comments=''
FROM 
	student, studentclass, class
WHERE 	
	class.gradecode=:ar_gradecode AND
	class.schoolbranchcode=:ar_branchcode AND
	class.classcode = student.currentclass AND
	student.status='A' AND
	class.classcode = studentclass.classcode AND
	student.currentclass = studentclass.classcode AND
	student.studentcode= studentclass.studentcode
order by studentcode
	"
  arguments=(("ar_gradecode", number), ("ar_branchcode", number))
 sort="studentname A"
)
