table(column=(type=char(100) updatewhereclause=yes name=schoolbranch dbname="SchoolBranch"  )
column=(type=char(100) updatewhereclause=yes name=schoolfaculty dbname="SchoolFaculty"  )
column=(type=char(100) updatewhereclause=yes name=class dbname="Class"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(163) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=char(1) updatewhereclause=yes name=mobileselected dbname="MobileSelected" 
 values="	Y/	N"  )
column=(type=char(60) update=yes updatewhereclause=yes name=mobile dbname="Student.Mobile"  )
column=(type=char(100) updatewhereclause=yes name=fathername dbname="FatherName"  )
column=(type=char(1) updatewhereclause=yes name=fmobileselected dbname="FMobileSelected" 
 values="	Y/	N"  )
column=(type=char(60) updatewhereclause=yes name=fmobile dbname="FMobile"  )
column=(type=char(100) updatewhereclause=yes name=mothername dbname="MotherName"  )
column=(type=char(1) updatewhereclause=yes name=mmobileselected dbname="MMobileSelected" 
 values="	Y/	N"  )
column=(type=char(60) updatewhereclause=yes name=mmobile dbname="MMobile"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(1) update=yes updatewhereclause=yes name=gender dbname="Student.Gender"  )
column=(type=datetime update=yes updatewhereclause=yes name=birthdate dbname="Student.BirthDate"  )
column=(type=char(60) update=yes updatewhereclause=yes name=phone dbname="Student.Phone"  )
column=(type=char(1) update=yes updatewhereclause=yes name=status dbname="Student.Status" 
 values="Registered	R/Admitted	A/School Leaving	L/"  )
 retrieve="SELECT
	SchoolBranch = (SELECT SC.Name FROM SchoolBranch SC WHERE SC.SchoolBranchCode = Class.SchoolBranchCode),
	SchoolFaculty = (SELECT SC.Name FROM School SC WHERE SC.SchoolCode = Class.SchoolCode),
	Class = Class.Name,
	StudentCode=Student.StudentCode,   
	RegNo=Student.RegNo,   
	Name=Student.Name,   
	StudentName = Student.Name + ' (' + Student.RegNo + ')',
	MobileSelected='N',
	Student.Mobile,   
	FatherName=Student.FName,   
	FMobileSelected='N',
	FMobile = Student.FMobile,
	MotherName=Student.MName,   
	MMobileSelected='N',
	MMobile = Student.MMobile,
	customer=(select accounts.name from accounts where acccode=Student.custcode),
	Student.Gender,   
	Student.BirthDate,   
	Student.Phone,   
	Student.Status  
FROM 
	Student, StudentClass, Class
WHERE
	:ai_type = 1 AND
	Student.StudentCode = StudentClass.StudentCode AND 
	StudentClass.ClassCode = Class.ClassCode AND
	Class.ClassCode in (:ai_code)
UNION ALL
SELECT
	SchoolBranch = (SELECT SC.Name FROM SchoolBranch SC WHERE SC.SchoolBranchCode = Class.SchoolBranchCode),
	SchoolFaculty = (SELECT SC.Name FROM School SC WHERE SC.SchoolCode = Class.SchoolCode),
	Class = Class.Name,
	StudentCode=Student.StudentCode,   
	RegNo=Student.RegNo,   
	Name=Student.Name,   
	StudentName = Student.Name + ' (' + Student.RegNo + ')',
	MobileSelected='N',
	Student.Mobile,   
	FatherName=Student.FName,   
	FMobileSelected='N',
	FMobile = Student.FMobile,
	MotherName=Student.MName,   
	MMobileSelected='N',
	MMobile = Student.MMobile,
	customer=(select accounts.name from accounts where acccode=Student.custcode),
	Student.Gender,   
	Student.BirthDate,   
	Student.Phone,   
	Student.Status  
FROM 
	Student, StudentClass, Class, School
WHERE
	:ai_type = 2 AND
	Student.StudentCode = StudentClass.StudentCode AND 
	StudentClass.ClassCode = Class.ClassCode AND
	Class.SchoolCode = School.SchoolCode AND 
	School.SchoolCode in (:ai_code)
UNION ALL
SELECT
	SchoolBranch = (SELECT SC.Name FROM SchoolBranch SC WHERE SC.SchoolBranchCode = Class.SchoolBranchCode),
	SchoolFaculty = (SELECT SC.Name FROM School SC WHERE SC.SchoolCode = Class.SchoolCode),
	Class = Class.Name,
	StudentCode=Student.StudentCode,   
	RegNo=Student.RegNo,   
	Name=Student.Name,   
	StudentName = Student.Name + ' (' + Student.RegNo + ')',
	MobileSelected='N',
	Student.Mobile,   
	FatherName=Student.FName,   
	FMobileSelected='N',
	FMobile = Student.FMobile,
	MotherName=Student.MName,   
	MMobileSelected='N',
	MMobile = Student.MMobile,
	customer=(select accounts.name from accounts where acccode=Student.custcode),
	Student.Gender,   
	Student.BirthDate,   
	Student.Phone,   
	Student.Status  
FROM 
	Student, StudentClass, Class, SchoolBranch
WHERE
	:ai_type = 3 AND
	Student.StudentCode = StudentClass.StudentCode AND 
	StudentClass.ClassCode = Class.ClassCode AND
	Class.SchoolBranchCode = SchoolBranch.SchoolBranchCode AND 
	SchoolBranch.SchoolBranchCode in (:ai_code)
UNION ALL
SELECT
	SchoolBranch = (SELECT SC.Name FROM SchoolBranch SC WHERE SC.SchoolBranchCode = Class.SchoolBranchCode),
	SchoolFaculty = (SELECT SC.Name FROM School SC WHERE SC.SchoolCode = Class.SchoolCode),
	Class = Class.Name,
	StudentCode=Student.StudentCode,   
	RegNo=Student.RegNo,   
	Name=Student.Name,   
	StudentName = Student.Name + ' (' + Student.RegNo + ')',
	MobileSelected='N',
	Student.Mobile,   
	FatherName=Student.FName,   
	FMobileSelected='N',
	FMobile = Student.FMobile,
	MotherName=Student.MName,   
	MMobileSelected='N',
	MMobile = Student.MMobile,
	customer=(select accounts.name from accounts where acccode=Student.custcode),
	Student.Gender,   
	Student.BirthDate,   
	Student.Phone,   
	Student.Status  
FROM 
	Student, StudentClass, Class, SchoolBranch,
	(SELECT 
		SH.ServiceInvCode, 
		SH.Date, 
		SH.StudentCode, 
		StudentStatus = (SELECT ST.Status FROM Student ST WHERE ST.StudentCode = SH.StudentCode),
		Class = (SELECT C.Name FROM Class C, Student S WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass=C.ClassCode),
		RollNo = (SELECT SC.RollNo FROM StudentClass SC, Student S WHERE S.StudentCode = SH.StudentCode AND S.StudentCode = SC.StudentCode AND S.CurrentClass=SC.ClassCode),
		Grade = (SELECT G.Name FROM Grade G, Class C, Student S WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass=C.ClassCode AND C.GradeCode = G.GradeCode),
		SchoolName= (SELECT SB.Name FROM Class C, Student S, SchoolBranch SB WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass=C.ClassCode AND C.SchoolBranchCode = SB.SchoolBranchCode),
		SchoolBranchCode= (SELECT SB.SchoolBranchCode FROM Class C, Student S, SchoolBranch SB WHERE S.StudentCode = SH.StudentCode AND S.CurrentClass=C.ClassCode AND C.SchoolBranchCode = SB.SchoolBranchCode), 
		UnpaidAmount = SH.OutstandingAmt,
		Remarks = SH.Remarks,
		Age = DATEDIFF(d, SH.Date, GetDate()),
		DefaulterlistInstruction = (SELECT ST.DefaulterlistInstruction FROM Student ST WHERE ST.StudentCode = SH.StudentCode),
		DefaulterlistInstructionExpiry = (SELECT ST.DefaulterlistInstructionExpiresOn FROM Student ST WHERE ST.StudentCode = SH.StudentCode)
	FROM ServiceHeader SH
	WHERE SH.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SH.OutstandingAmt > 0 AND 
		DATEDIFF(d, SH.Date, GetDate()) >= :ai_daysold) T
WHERE
	:ai_type = 4 AND
	Student.StudentCode = StudentClass.StudentCode AND 
	StudentClass.ClassCode = Class.ClassCode AND
	Class.SchoolBranchCode = SchoolBranch.SchoolBranchCode AND 
	SchoolBranch.SchoolBranchCode in (:ai_code) AND
	Student.StudentCode = T.StudentCode AND
	T.StudentStatus <> 'L'
ORDER BY 
	SchoolBranch,
	SchoolFaculty,
	Class,
	StudentName
"
  arguments=(("ai_type", number), ("ai_code", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_daysold", number))
)
