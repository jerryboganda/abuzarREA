release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=176 color="536870912" )
summary(height=12 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(50) updatewhereclause=yes name=fnic dbname="FNIC"  )
column=(type=char(100) updatewhereclause=yes name=fname dbname="Fname"  )
column=(type=char(100) updatewhereclause=yes name=mname dbname="MName"  )
column=(type=long updatewhereclause=yes name=noofsiblings dbname="NoofSiblings"  )
column=(type=long updatewhereclause=yes name=studentcode dbname="StudentCode"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(100) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=char(100) updatewhereclause=yes name=currentclass dbname="CurrentClass"  )
column=(type=char(100) updatewhereclause=yes name=grade dbname="Grade"  )
column=(type=decimal(2) updatewhereclause=yes name=numericalfactor dbname="NumericalFactor"  )
column=(type=char(40) updatewhereclause=yes name=rollno dbname="RollNo"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="DiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="FlatDisc"  )
column=(type=char(255) updatewhereclause=yes name=feecomment dbname="FeeComment"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(60) updatewhereclause=yes name=mobile dbname="Mobile"  )
column=(type=char(60) updatewhereclause=yes name=fmobile dbname="FMobile"  )
column=(type=char(60) updatewhereclause=yes name=mmobile dbname="MMobile"  )
column=(type=char(113) updatewhereclause=yes name=top1 dbname="Top1"  )
column=(type=char(113) updatewhereclause=yes name=top2 dbname="Top2"  )
 retrieve="SELECT 
	FNIC=S.FNIC,
	Fname=S.FName,
	MName = S.MName,
	NoofSiblings = N.FNicCount,
	StudentCode = S.StudentCode,
	RegNo = S.RegNo,
	StudentName = S.Name,
	CurrentClass = (SELECT C.Name FROM Class C WHERE C.ClassCode = S.CurrentClass),
	Grade = G.Name,
	NumericalFactor = G.NumericalFactor,
	RollNo = (SELECT SC.RollNo FROM StudentClass SC WHERE SC.ClassCode = S.CurrentClass AND SC.StudentCode=S.StudentCode),
	Gender = S.Gender,
	DiscPerc=S.DiscPerc,
	FlatDisc = S.FlatDisc,
	FeeComment = S.FeeComment,
	Remarks = S.Remarks,
	Mobile = S.Mobile,
	FMobile = S.FMobile,
	MMobile = S.MMobile,
	Top1 = (SELECT TOP 1 ST.Name + ' (' + LTRIM(RTRIM(STR(GG.NumericalFactor))) + ')'
		FROM Student ST, Grade GG, Class CC
		WHERE ST.FNIC = S.FNIC AND ST.Status='A' AND ST.CurrentClass > 0 AND ST.CurrentClass = CC.ClassCode AND CC.GradeCode = GG.GradeCode AND GG.NumericalFactor <= 10
		ORDER BY GG.NumericalFactor DESC),
	Top2 = (SELECT TOP 1 ST.Name + ' (' + LTRIM(RTRIM(STR(GG.NumericalFactor))) + ')'
		FROM Student ST, Grade GG, Class CC
		WHERE ST.FNIC = S.FNIC AND ST.Status='A' AND ST.CurrentClass > 0 AND ST.CurrentClass = CC.ClassCode AND CC.GradeCode = GG.GradeCode AND GG.NumericalFactor <= 10 AND
			ST.StudentCode NOT IN 
				(SELECT TOP 1 ST.StudentCode
				FROM Student ST, Grade GG, Class CC
				WHERE ST.FNIC = S.FNIC AND ST.Status='A' AND ST.CurrentClass > 0 AND ST.CurrentClass = CC.ClassCode AND CC.GradeCode = GG.GradeCode AND GG.NumericalFactor <= 10
				ORDER BY GG.NumericalFactor DESC)
		ORDER BY GG.NumericalFactor DESC, ST.StudentCode)
FROM
	Student S, Grade G, Class C,
	(SELECT ST.FNIC, FNicCount=COUNT(ST.FNIC)
	FROM Student ST, Grade G, Class C
	WHERE ST.Status='A' AND ST.CurrentClass > 0 AND ST.CurrentClass = C.ClassCode AND C.GradeCode = G.GradeCode AND G.NumericalFactor <= 10
	GROUP BY ST.FNIC
	HAVING COUNT(ST.FNIC) > 2) N
WHERE
	S.FNIC = N.FNIC AND S.Status='A' AND S.CurrentClass > 0 AND S.CurrentClass = C.ClassCode AND C.GradeCode = G.GradeCode AND G.NumericalFactor <= 10 AND
	S.StudentCode NOT IN 
		(SELECT TOP 2 ST.StudentCode
		FROM Student ST, Grade GG, Class CC
		WHERE ST.FNIC = S.FNIC AND ST.Status='A' AND ST.CurrentClass > 0 AND ST.CurrentClass = CC.ClassCode AND CC.GradeCode = GG.GradeCode AND GG.NumericalFactor <= 10
		ORDER BY GG.NumericalFactor DESC, StudentCode)
ORDER BY
	NoofSiblings DESC, FNIC, StudentCode, Fname
"
 )
