datawindow ( units=0 timer_interval=0 processing=1 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 selected.mouse=yes hidegrayline=no showbackcoloronxp=no)
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=studentcode dbname="Student.StudentCode"  )
column=(type=long update=yes updatewhereclause=yes name=rollno dbname="RollNo"  )
column=(type=char(60) update=yes updatewhereclause=yes name=regno dbname="Student.RegNo"  )
column=(type=char(100) update=yes updatewhereclause=yes name=name dbname="Student.Name"  )
column=(type=char(100) update=yes updatewhereclause=yes name=class dbname="Class"  )
column=(type=char(100) update=yes updatewhereclause=yes name=grade dbname="Grade"  )
column=(type=char(100) update=yes updatewhereclause=yes name=medium dbname="Medium"  )
column=(type=char(100) update=yes updatewhereclause=yes name=school dbname="School"  )
column=(type=char(100) update=yes updatewhereclause=yes name=classtype dbname="ClassType"  )
column=(type=long update=yes updatewhereclause=yes name=classyear dbname="ClassYear"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=tuitionfee dbname="TuitionFee"  )
column=(type=char(1) update=yes updatewhereclause=yes name=active dbname="Active"  )
column=(type=char(1) update=yes updatewhereclause=yes name=status dbname="Student.Status" 
 values="Admitted	A/School Leaving	L/Registered	R/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=fname dbname="Student.FName"  )
column=(type=char(1000) update=yes updatewhereclause=yes name=currentaddress dbname="Student.CurrentAddress"  )
column=(type=char(60) update=yes updatewhereclause=yes name=phone dbname="Student.Phone"  )
column=(type=char(60) update=yes updatewhereclause=yes name=mobile dbname="Student.Mobile"  )
column=(type=datetime update=yes updatewhereclause=yes name=birthdate dbname="Student.BirthDate"  )
column=(type=char(1) update=yes updatewhereclause=yes name=gender dbname="Student.Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(100) update=yes updatewhereclause=yes name=foccupation dbname="Student.FOccupation"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="Student.Remarks"  )
 retrieve="SELECT
	StudentCode,
	RollNo = CAST((SELECT SC.RollNo FROM StudentClass SC WHERE SC.StudentCode=Student.StudentCode AND ClassCode=Student.CurrentClass) AS INT),
	RegNo,
	Name,
	Class = (SELECT C.Name FROM Class C WHERE C.ClassCode = Student.CurrentClass),
	Grade = (SELECT G.Name FROM Class C, Grade G WHERE C.ClassCode = Student.CurrentClass AND C.GradeCode = G.GradeCode),
	Medium = (SELECT M.Name FROM Class C, ClassMedium M WHERE C.ClassCode = Student.CurrentClass AND C.ClassMediumCode = M.ClassMediumCode),
	School = (SELECT S.Name FROM Class C, School S WHERE C.ClassCode = Student.CurrentClass AND C.SchoolCode = S.SchoolCode),
	ClassType = (SELECT T.Name FROM Class C, ClassType T WHERE C.ClassCode = Student.CurrentClass AND C.ClassTypeCode = T.ClassTypeCode),
	ClassYear=(SELECT C.ClassYear FROM Class C WHERE C.ClassCode = Student.CurrentClass),
	TuitionFee = (SELECT C.Fee FROM Class C WHERE C.ClassCode = Student.CurrentClass),
	Active=(SELECT C.Active FROM Class C WHERE C.ClassCode = Student.CurrentClass),
	Status,
	FName,
	CurrentAddress,
	Phone,
	Mobile,
	BirthDate,
	Gender,
	FOccupation,
	Remarks
FROM
	Student
WHERE 
	Status <> 'L' AND
	CurrentClass IN (:ai_classcode)
ORDER BY
	Class, Name
"
  update="Student" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_classcode", numberlist))
)
