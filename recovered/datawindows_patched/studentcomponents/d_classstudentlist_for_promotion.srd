header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long key=yes update=yes updatewhereclause=yes name=classcode dbname="StudentClass.ClassCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=studentcode dbname="StudentClass.StudentCode"  )
column=(type=char(40) update=yes updatewhereclause=yes name=rollno dbname="StudentClass.RollNo"  )
column=(type=char(60) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(163) updatewhereclause=yes name=studentname dbname="StudentName"  )
column=(type=char(100) updatewhereclause=yes name=fname dbname="FName"  )
 retrieve="SELECT 
	ClassCode, 
	StudentCode, 
	RollNo, 
	RegNo=(SELECT S.RegNo FROM Student S WHERE S.StudentCode = StudentClass.StudentCode),
	StudentName=(SELECT S.Name + ' (' + S.RegNo + ')' FROM Student S WHERE S.StudentCode = StudentClass.StudentCode),
	FName=(SELECT S.FName FROM Student S WHERE S.StudentCode = StudentClass.StudentCode)
FROM
	StudentClass
WHERE
	ClassCode= :ai_code AND ClassCode IN (SELECT ClassCode FROM Class WHERE Promoted='N') AND PromotionRowID IS NULL
ORDER BY
	RollNo"
  update="StudentClass" updatewhere=1 updatekeyinplace=no
  arguments=(("ai_code", number))
)
