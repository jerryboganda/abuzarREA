table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="ClassPromotion.PromotionCode"  )
column=(type=datetime update=yes updatewhereclause=yes initial="today" name=date dbname="ClassPromotion.Date"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="ClassPromotion.UserCode" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=promoteclassfrom dbname="ClassPromotion.PromoteClassFrom" 
 values=""  )
column=(type=long update=yes updatewhereclause=yes name=promoteclassto dbname="ClassPromotion.PromoteClassTo" 
 values=""  )
column=(type=char(100) update=yes updatewhereclause=yes initial="YEARLY ACADEMIC PROMOTION" name=remarks dbname="ClassPromotion.Remarks"  )
 retrieve="  SELECT ClassPromotion.PromotionCode,   
         ClassPromotion.Date,   
         ClassPromotion.UserCode,   
         ClassPromotion.PromoteClassFrom,   
         ClassPromotion.PromoteClassTo,   
         ClassPromotion.Remarks  
    FROM ClassPromotion  
   WHERE ClassPromotion.PromotionCode = :ai_code    
"
  update="ClassPromotion" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
