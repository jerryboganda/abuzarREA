release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=635 color="536870912" )
summary(height=208 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=name dbname="Class.name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
column=(type=long updatewhereclause=yes name=classyear dbname="ClassYear"  )
column=(type=char(100) updatewhereclause=yes name=grade dbname="grade"  )
column=(type=char(100) updatewhereclause=yes name=school dbname="school"  )
column=(type=char(100) updatewhereclause=yes name=classtype dbname="classtype"  )
column=(type=char(100) updatewhereclause=yes name=branch dbname="branch"  )
column=(type=char(100) updatewhereclause=yes name=medium dbname="Medium"  )
column=(type=long updatewhereclause=yes name=noofstudent dbname="noofstudent"  )
column=(type=long updatewhereclause=yes name=promoted dbname="Promoted"  )
column=(type=char(1) updatewhereclause=yes name=classstatus dbname="ClassStatus"  )
 retrieve="select 
	name, 
	Active=class.active,
	ClassYear = Class.ClassYear,
	grade=(select name from grade where grade.gradecode=class.gradecode),
	school= (select name from school where school.schoolcode=class.schoolcode),
	classtype=(select name from classtype where classtype.classtypecode=class.classtypecode),
	branch=(select name from schoolbranch where schoolbranch.schoolbranchcode=class.schoolbranchcode),
	Medium=(select name from classmedium where classmedium.classmediumcode=class.classmediumcode),
	noofstudent=(select count(*) from studentclass where studentclass.classcode=class.classcode),
	Promoted=(select count(*) from studentclass where studentclass.classcode=class.classcode AND (studentclass.promotionrowid > 0 OR studentclass.graduationrowid > 0)),
	ClassStatus=CASE WHEN class.promoted = 'Y' THEN 'P' WHEN class.graduated = 'Y' THEN 'G' ELSE 'N' END
from class
order by name

"
  sort="name A"
 filter=" active ='Y'"
 )
