table(column=(type=char(20) updatewhereclause=yes name=grade dbname="grade"  )
column=(type=decimal(0) updatewhereclause=yes name=numericalfactor dbname="numericalfactor"  )
column=(type=number updatewhereclause=yes name=studentcount dbname="studentcount"  )
 retrieve="SELECT 
	AsON = CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(SC.AdmissionDate)))) AS DATETIME),
	Grade=G.Name, 
	NumericalFactor=G.NumericalFactor,
	SchoolBranch=SB.Name, 
	StudentCount = COUNT(SC.StudentCode)
FROM 
	Class C, 
	Grade G, 
	SchoolBranch SB, 
	StudentClass SC
WHERE 	
	G.GradeCode=C.GradeCode AND 
	C.SchoolBranchCode = SB.SchoolBranchCode AND 
	C.ClassCode=SC.ClassCode
GROUP BY SC.AdmissionDate, SB.Name, G.Name, G.NumericalFactor
/*UNION ALL
SELECT 
	AsON = CAST(LTRIM(RTRIM(STR(MONTH(:adt_date)))) + '-' + LTRIM(RTRIM(STR(Day(:adt_date)))) + '-' + LTRIM(RTRIM(STR(YEAR(ST.Date)))) AS DATETIME),
	Grade=G.Name, 
	NumericalFactor=G.NumericalFactor,
	SchoolBranch=SB.Name, 
	StudentCount = COUNT(ST.StudentCode)
FROM 
	Class C, 
	Grade G, 
	SchoolBranch SB, 
	StudentClassTransfer ST
WHERE 	
	G.GradeCode=C.GradeCode AND 
	C.SchoolBranchCode = SB.SchoolBranchCode AND 
	C.ClassCode=ST.TargetClass
GROUP BY ST.Date, SB.Name, G.Name, G.NumericalFactor*/
ORDER BY SB.Name, G.NumericalFactor, G.Name

"
  arguments=(("adt_date", datetime))
 sort="numericalfactor A, grade A"
)
