column=(type=char(12) updatewhereclause=yes name=accounts_aliasname dbname="aliasname"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=char(100) updatewhereclause=yes name=purledger_remarks dbname="Purledger.remarks"  )
column=(type=decimal(6) updatewhereclause=yes name=currqty dbname="currqty"  )
column=(type=char(100) updatewhereclause=yes name=purtype dbname="purtype"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(100) updatewhereclause=yes name=suppinvcode dbname="Purledger.suppinvcode"  )
column=(type=datetime updatewhereclause=yes name=suppinvdate dbname="Purledger.suppinvdate"  )
column=(type=char(100) updatewhereclause=yes name=grn dbname="Purledger.GRN"  )
column=(type=long updatewhereclause=yes name=remainingdays dbname="remainingdays"  )
column=(type=char(9) updatewhereclause=yes name=purcategory dbname="purcategory"  )
 retrieve="SELECT 
	itemname= dbo.item.name,  
	dbo.itempacking.name, 
	printcount=purledger.printcounter, 
	aliasname=dbo.item.customicode,
	username=(select username from users where users.usercode=purledger.salesmancode), 
	saleprice=(Case  When ((dbo.purledger.purcatcode=7) OR (dbo.purledger.purcatcode=8) OR (dbo.purledger.purcatcode=3)) 
							then  
								case when (dbo.purledger.posted='Y') then
									 purdetail.saleprice/purdetail.packunits
								else
									item.saleprice/item.packunits
								end
									 
								
					ELSE
							case when (dbo.purledger.posted='Y') then
									 purdetail.saleprice
								else
									item.saleprice
								end
				

					END) ,
	dbo.purledger.purinvcode,   
	dbo.purledger.date ,
	dbo.purledger.posted,  
	dbo.purledger.discperc,  
	dbo.purledger.misccharges,  
	dbo.purledger.flatdisc,  
	dbo.purledger.salestax,  
	dbo.purledger.suppcode,  
	custcode=dbo.purledger.custcode,  
	creditdays=dbo.purledger.creditdays,
	duedate=dbo.purledger.date + dbo.purledger.creditdays,
	dbo.purdetail.icode,  
	dbo.purdetail.batch,  
	dbo.purdetail.expiry,
	qty = dbo.purdetail.packqty + dbo.purdetail.looseqty,  			
	dbo.purdetail.bonusqty, 
	dbo.purdetail.packunits, 
	dbo.purdetail.purprice,   
	dbo.purdetail.avgprice,    
	NetRate=ROUND(dbo.purdetail.NetRate, 2),
	dbo.purdetail.discperc,
	dbo.purdetail.gstperc,
	dbo.purdetail.unitsalestax,
	dbo.purledger.invgstperc1,
	dbo.purdetail.IDENTITYCOL,
	aliasname=CASE WHEN PurLedger.CustCode > 0 THEN (SELECT A.AliasName FROM Accounts A WHERE A.AccCode = PurLedger.CustCode) ELSE dbo.accounts.aliasname END,
	SupplierName=CASE WHEN PurLedger.CustCode > 0 THEN (SELECT A.Name FROM Accounts A WHERE A.AccCode = PurLedger.CustCode) ELSE LTRIM(RTRIM(dbo.accounts.name)) END,
	dbo.purledger.remarks,
	currqty = (case when posted='N' Then  (select isnull(sum(currqty),0) from godowndetail where godowndetail.icode = item.icode)
				  else
						purdetail.currstock
				  end) / purdetail.packunits, 
	/*saleqty = Round(IsNull((Select Sum(dbo.saledetail.looseqty)/3
							FROM  dbo.saleledger,	 
									dbo.saledetail
							
							WHERE dbo.saleledger.date >= DateAdd(dd,-90,dbo.purledger.date) and 	
									dbo.saleledger.date <= dbo.purledger.date and 	
									dbo.saleledger.salecatcode IN (1, 2, 3) and	 
									dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and	   
									dbo.saledetail.icode = dbo.item.icode  ), 0 ) / CONVERT(float,(dbo.purdetail.packunits)),2)
,*/
	purtype=purchasetype.name	,
	salestax=purdetail.unitsalestax	,
	headerno=purledger.headerno	,
	dbo.purledger.suppinvcode,
	dbo.purledger.suppinvdate,
	dbo.purledger.GRN		,
	/*margin=((Case  When ((dbo.purledger.purcatcode=7) OR (dbo.purledger.purcatcode=8)) then (purdetail.saleprice/purdetail.packunits) 
			  ELSE     purdetail.saleprice 
			  END) - ((((purdetail.packqty + purdetail.looseqty) * purdetail.purprice  )  *  ( 1 -  (   purdetail.discperc * .01 )  ) )  * (1 - (.01 * purledger.discperc)) ) / ( purdetail.packqty + purdetail.looseqty + purdetail.bonusqty)) * 100 / (Case  When ((dbo.purledger.purcatcode=7) OR (dbo.purledger.purcatcode=8)) then item.saleprice/item.packunits
			  ELSE     item.saleprice 
			  END),*/
	/*19/11/02 margin=((Case  When ((dbo.purledger.purcatcode=7) OR (dbo.purledger.purcatcode=8)) then (case when purledger.posted='N' then  (Round(item.saleprice/item.packunits,2))  else (Round(purdetail.saleprice/purdetail.packunits,2))end )
			  ELSE    (case when purledger.posted='Y' then purdetail.saleprice  else item.saleprice end)
			  END) - ((((purdetail.packqty + purdetail.looseqty) * purdetail.purprice  )  *  ( 1 -  (   purdetail.discperc * .01 )  ) )  * (1 - (.01 * purledger.discperc)) + ((purdetail.looseqty + purdetail.packqty + purdetail.bonusqty)*unitsalestax )   ) / ( purdetail.packqty + purdetail.looseqty + purdetail.bonusqty)) * 100 / (Case  When ((dbo.purledger.purcatcode=7) OR (dbo.purledger.purcatcode=8)) then (case when purledger.posted='Y' then Round(purdetail.saleprice/purdetail.packunits,2) else Round(item.saleprice/item.packunits,2) end)
			  ELSE   (case when purledger.posted='Y' then   purdetail.saleprice  else item.saleprice end)
			  END),*/
	/*19/11/02 margin=((Case  When ((dbo.purledger.purcatcode=7) OR (dbo.purledger.purcatcode=8)) then (case when purledger.posted='N' then  (Round(item.saleprice/item.packunits,2))  else (Round(purdetail.saleprice/purdetail.packunits,2))end )
			  ELSE    (case when purledger.posted='Y' then purdetail.saleprice  else item.saleprice end)
			  END) - ((((purdetail.packqty + purdetail.looseqty) * purdetail.purprice  )  *  ( 1 -  (   purdetail.discperc * .01 )  ) )  * (1 - (.01 * purledger.discperc)) + ((purdetail.looseqty + purdetail.packqty + purdetail.bonusqty)*unitsalestax ) + Round((purdetail.purprice * (purdetail.looseqty + purdetail.packqty))*(1 - purdetail.discperc*0.01) , 2)  ) / ( purdetail.packqty + purdetail.looseqty + purdetail.bonusqty)) * 100 / (Case  When ((dbo.purledger.purcatcode=7) OR (dbo.purledger.purcatcode=8)) then (case when purledger.posted='Y' then Round(purdetail.saleprice/purdetail.packunits,2) else Round(item.saleprice/item.packunits,2) end)
			  ELSE   (case when purledger.posted='Y' then   purdetail.saleprice  else item.saleprice end)
			  END),*/

	
/*last	margin=((Case  When ((dbo.purledger.purcatcode=7) OR (dbo.purledger.purcatcode=8)) then (case when purledger.posted='N' then  (Round(item.saleprice/item.packunits,2))  else (Round(purdetail.saleprice/purdetail.packunits,2))end )
			  ELSE    (case when purledger.posted='Y' then purdetail.saleprice  else item.saleprice end)
			  END) - (((((purdetail.packqty + purdetail.looseqty) * purdetail.purprice  )  *  ( 1 -  (   purdetail.discperc * .01 )  ) )  * (1 - (.01 * purledger.discperc)) + ((purdetail.looseqty + purdetail.packqty + purdetail.bonusqty)*unitsalestax )  ) / ( purdetail.packqty + purdetail.looseqty + purdetail.bonusqty)) + Round( Round(purdetail.purprice * (1 - purdetail.discperc*0.01),2) * purdetail.gstperc * 0.01 , 2) +  Round( (Round(purdetail.purprice * (1 - purdetail.discperc*0.01),2) * (1 - purledger.discperc * 0.01)) * purledger.invgstperc1 * 0.01 , 2)) * 100 / (Case  When ((dbo.purledger.purcatcode=7) OR (dbo.purledger.purcatcode=8)) then (case when purledger.posted='Y' then Round(purdetail.saleprice/purdetail.packunits,2) else Round(item.saleprice/item.packunits,2) end)
			  ELSE   (case when purledger.posted='Y' then   purdetail.saleprice  else item.saleprice end)
			  END),*/


remainingdays=datediff(day,getdate(),purdetail.expiry),

purcategory= case when purcatcode IN (1,2)   THEN   '(Pack)'
							when purcatcode=3   THEn   '(Opening)'
							when purcatcode IN (7,8)   THEn   '(Loose)' 
						  
					END                                 
				  
										  

FROM	
	dbo.purledger LEFT OUTER JOIN purchasetype ON (purledger.purtypecode = purchasetype.purtypecode), 
	dbo.item LEFT OUTER JOIN ItemPacking ON (dbo.item.packcode = dbo.itempacking.packcode),
	dbo.purdetail,
	dbo.accounts
WHERE	
	( ( dbo.purledger.purinvcode = :ra_InvCode ) ) and 
	( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and 
	(dbo.purledger.suppcode = dbo.accounts.acccode) and 
	( purdetail.icode = item.icode )
ORDER BY 
	dbo.item.name      
	
"
  arguments=(("ra_InvCode", number))
 sort="id A"
)
