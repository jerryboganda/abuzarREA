release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=1000 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1875 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(20) updatewhereclause=yes name=packingname dbname="ItemPacking.name"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="Item.saleprice"  )
column=(type=long updatewhereclause=yes name=purledger_purinvcode dbname="Purledger.purinvcode"  )
column=(type=datetime updatewhereclause=yes name=purledger_date dbname="Purledger.date"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Purledger.posted"  )
column=(type=decimal(2) updatewhereclause=yes name=purledger_discperc dbname="Purledger.discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=purledger_misccharges dbname="Purledger.misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=purledger_flatdisc dbname="Purledger.flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=purledger_salestax dbname="Purledger.salestax"  )
column=(type=long updatewhereclause=yes name=purledger_suppcode dbname="Purledger.suppcode"  )
column=(type=long updatewhereclause=yes name=purdetail_icode dbname="Purdetail.icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Purdetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Purdetail.expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="Purdetail.bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Purdetail.packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="Purdetail.purprice"  )
column=(type=decimal(5) updatewhereclause=yes name=purdetail_avgprice dbname="Purdetail.avgprice"  )
column=(type=decimal(2) updatewhereclause=yes name=purdetail_discperc dbname="Purdetail.discperc"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Purdetail.PurRowId"  )
column=(type=char(69) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=char(100) updatewhereclause=yes name=purledger_remarks dbname="Purledger.remarks"  )
column=(type=number updatewhereclause=yes name=currqty dbname="currqty"  )
column=(type=number updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(6) updatewhereclause=yes name=invtotal dbname="invtotal"  )
column=(type=char(100) updatewhereclause=yes name=purledger_suppinvcode dbname="Purledger.suppinvcode"  )
column=(type=datetime updatewhereclause=yes name=purledger_suppinvdate dbname="Purledger.suppinvdate"  )
column=(type=char(100) updatewhereclause=yes name=purledger_grn dbname="Purledger.GRN"  )
 retrieve="SELECT   itemname= dbo.item.name,
			dbo.itempacking.name, 
			dbo.item.saleprice, 
			dbo.purledger.purinvcode, 
			dbo.purledger.date ,
			dbo.purledger.posted,  
			dbo.purledger.discperc,  
			dbo.purledger.misccharges,  
			dbo.purledger.flatdisc,  
			dbo.purledger.salestax,  
			dbo.purledger.suppcode,  
			dbo.purdetail.icode,  
			dbo.purdetail.batch,  
			dbo.purdetail.expiry,
			qty = dbo.purdetail.packqty + dbo.purdetail.looseqty,  			
			dbo.purdetail.bonusqty, 
			dbo.purdetail.packunits, 
			dbo.purdetail.purprice,   
			dbo.purdetail.avgprice,    
			dbo.purdetail.discperc,
   			dbo.purdetail.IDENTITYCOL,
			SupplierName=CASE WHEN PurLedger.CustCode > 0 THEN (SELECT A.Name FROM Accounts A WHERE A.AccCode = PurLedger.CustCode) ELSE LTRIM(RTRIM(dbo.accounts.name)) + ' (' + LTRIM(RTRIM(dbo.accounts.acccode)) + ')' END,
	         dbo.purledger.remarks,
			currqty = Round(IsNull((Select  sum(currqty) 	
									from godowndetail 	
									where dbo.item.icode = godowndetail.icode),0)/ CONVERT(float,(dbo.purdetail.packunits)),2), 
			saleqty = Round(IsNull((Select Sum(dbo.saledetail.looseqty)/3
									FROM  dbo.saleledger,	 
											dbo.saledetail
									
									WHERE dbo.saleledger.date >= DateAdd(dd,-90,dbo.purledger.date) and 	
											dbo.saleledger.date <= dbo.purledger.date and 	
											dbo.saleledger.salecatcode IN (1, 2, 3) and	 
											dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and	   
											dbo.saledetail.icode = dbo.item.icode  ), 0 ) / CONVERT(float,(dbo.purdetail.packunits)),2),
				invtotal=(  SELECT    
        
         							amount = Round(Sum (( PD.looseqty + PD.packqty ) * PD.purprice)
						           							- Sum (Round(((( PD.looseqty + PD.packqty ) * PD.purprice ) * (PD.discperc * .01)) ,2))
							   								- Sum ( Round( PD.purprice * (PD.looseqty + PD.packqty )    * (1 - (PD.discperc * .01)),2)) * (PL.discperc /100) 
					 		   								+ PL.misccharges - PL.flatdisc,0)  
   						 FROM dbo.purledger PL,  
									dbo.purdetail PD

   						 WHERE (PL.purinvcode=dbo.purledger.purinvcode) and 
                           ( PL.purinvcode = PD.purinvcode )  
         						   
     	  							             

							 GROUP BY    
        								 PL.misccharges,   
         							 PL.flatdisc,   
         							    
         							 PL.purinvcode,   
										 PL.discperc,  
			 							 PL.salestax
										 
         				),
			dbo.purledger.suppinvcode,
			dbo.purledger.suppinvdate,
			dbo.purledger.GRN

	FROM
		dbo.purledger LEFT OUTER JOIN purchasetype ON (purledger.purtypecode = purchasetype.purtypecode), 
		dbo.item LEFT OUTER JOIN ItemPacking ON (dbo.item.packcode = dbo.itempacking.packcode),
		dbo.purdetail,
		dbo.accounts

   WHERE	( ( dbo.purledger.purinvcode between :ra_sInvCode and :ra_lInvCode) ) and 
			( dbo.purledger.purinvcode = dbo.purdetail.purinvcode ) and 
			(dbo.purledger.suppcode = dbo.accounts.acccode) and 
			( purdetail.icode = item.icode )
         
"
  arguments=(("ra_sInvCode", number), ("ra_linvcode", number))
 sort="id A"
)
