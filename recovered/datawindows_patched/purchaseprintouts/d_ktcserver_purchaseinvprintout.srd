compute(name=c_nettotal visible="1	0" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-11" font.pitch="2" font.weight="700" background.mode="1" background.color="553648127" color="0" x="6125" y="52" height="177" width="1427" format="#,##,##,##0" expression="Round(Sum (  c_netamount for all ) -   purledger_flatdisc +   purledger_misccharges +  purledger_salestax, f_NumberPreferences('roundpurinvon')) + Round(Round((Round(sum( round(c_amount,2)  for all ) * (1 -  purledger_discperc * 0.01),2)  -  purledger_flatdisc ) * 0.01 *  invgstperc1 ,2)  + sum (c_salestaxval for all), f_NumberPreferences('roundpurinvon'))" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
