line(name=l_16 visible="1" band=header background.mode="1" background.color="536870912" pen.style="0" pen.width="10" pen.color="0" x1="4479" y1="1791" x2="4479" y2="2062" )
text(name=t_11 visible="1	if(printbalance='Y' and posted='N',1,0)" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="553648127" color="0" alignment="0" border="0" x="4906" y="1604" height="145" width="187" text="	if(  ( -1*(c_nettotal) +  balance) +amt    >=0, 'Dr','Cr' )" html.valueishtml="0" )
