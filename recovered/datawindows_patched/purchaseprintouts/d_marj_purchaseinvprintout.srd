text(name=t_4 visible="1	1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="1" border="0" x="4531" y="1843" height="166" width="625" text="Amount" html.valueishtml="0" )
