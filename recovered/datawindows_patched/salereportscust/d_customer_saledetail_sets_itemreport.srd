table(column=(type=datetime updatewhereclause=yes name=saledate dbname="SaleDate"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="Address2"  )
column=(type=char(100) updatewhereclause=yes name=phone dbname="Phone"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="Area"  )
column=(type=char(60) updatewhereclause=yes name=subarea dbname="SubArea"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=decimal(10) updatewhereclause=yes name=itemdiscount dbname="ItemDiscount"  )
column=(type=decimal(6) updatewhereclause=yes name=invoicediscount dbname="InvoiceDiscount"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=invnetamt dbname="InvNetAmt"  )
 retrieve="SELECT 
	SaleDate=S.Date,
	SaleInvCode=S.SaleInvCode,
	AliasName = A.AliasName,
	Customer = A.Name,
	Address1 = C.Address1,
	Address2 = C.Address2,
	Phone = C.Phone, 
	Area = (SELECT AR.Name FROM Area AR WHERE C.AreaCode = AR.AreaCode),
	SubArea = (SELECT AR.Name FROM SubArea AR WHERE C.SubAreaCode = AR.AreaCode),
	ItemName = I.Name,
	Qty = SUM(SSH.Qty),
	SalePrice = SSH.SalePrice,
	Amount = SUM(SSH.Qty * SSH.SalePrice * (1 - S.DiscPerc * 0.01)),
	ItemDiscount = 0.00,
	InvoiceDiscount = SUM(SSH.Qty * SSH.SalePrice * (S.DiscPerc * 0.01)),
	Remarks= SPACE(100),
	InvNetAmt = dbo.fn_GetSaleInvTotal(S.SaleInvCode)
FROM
	SaleLedger S,
	Customer C,
	Accounts A,
	SaleSetsHeader SSH,
	Item I
WHERE
	S.CustCode = :ai_custcode AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	S.SaleInvCode = SSH.SaleInvCode AND
	SSH.SetICode=I.ICode
GROUP BY
	S.Date,
	S.SaleInvCode,
	A.AliasName,
	A.Name,
	C.Address1,
	C.Address2,
	C.Phone,
	C.AreaCode,
	C.SubAreaCode,
	I.Name,
	SSH.SalePrice
UNION ALL
SELECT 
	SaleDate=S.Date,
	SaleInvCode=S.SaleInvCode,
	AliasName = A.AliasName,
	Customer = A.Name,
	Address1 = C.Address1,
	Address2 = C.Address2,
	Phone = C.Phone,
	Area = (SELECT AR.Name FROM Area AR WHERE C.AreaCode = AR.AreaCode),
	SubArea = (SELECT AR.Name FROM SubArea AR WHERE C.SubAreaCode = AR.AreaCode),
	ItemName = I.Name,
	Qty = SUM(D.LooseQty),
	SalePrice = D.SalePrice,
	Amount = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),
	ItemDiscount = SUM((D.LooseQty * D.ItemFlatDisc) + (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (D.DiscPerc * 0.01))),
	InvoiceDiscount = SUM(D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (S.DiscPerc * 0.01)),
	Remarks= MAX(D.SaleItemDescription),
	InvNetAmt = dbo.fn_GetSaleInvTotal(S.SaleInvCode)
FROM
	SaleLedger S,
	SaleDetail D,
	Customer C,
	Accounts A,
	Item I
WHERE
	S.CustCode = :ai_custcode AND
	S.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	S.SaleInvCode = D.SaleInvCode AND
	D.ICode=I.ICode AND
	D.RowGroup NOT IN 
		(SELECT RowGroup 
		FROM salesetsheader ssh, salesetsdetail ssd
		Where ssh.saleinvcode = D.SaleInvCode AND
			ssh.setcode = ssd.setcode AND
			ssd.RowGroup = D.RowGroup)
GROUP BY
	S.Date,
	S.SaleInvCode,
	A.AliasName,
	A.Name,
	C.Address1,
	C.Address2,
	C.Phone,
	C.AreaCode,
	C.SubAreaCode,
	I.Name,
	D.SalePrice
"
  arguments=(("ai_CustCode", number))
 sort="saledate D, saleinvcode D, itemname A"
)
