	sd.saleprice,
	dbo.manufacturer.name
"
  arguments=(("as_CustCode", string), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_city", string), ("as_doctype", string), ("as_custrefno", string), ("as_customercp", string), ("as_line1", string), ("as_line2", string))
 sort="datestring A, customer A, long( chitno ) A, itemname A"
)
