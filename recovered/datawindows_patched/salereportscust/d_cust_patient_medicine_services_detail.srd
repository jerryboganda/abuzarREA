detail(height=183 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(3) updatewhereclause=yes name=type dbname="Type"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="customername"  )
column=(type=long updatewhereclause=yes name=rowgroup dbname="RowGroup"  )
column=(type=char(8) updatewhereclause=yes name=itemtype dbname="ItemType"  )
column=(type=datetime updatewhereclause=yes name=regdate dbname="RegDate"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=long updatewhereclause=yes name=transcode dbname="TransCode"  )
column=(type=char(10) updatewhereclause=yes name=transtype dbname="TransType"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=details dbname="Details"  )
column=(type=char(1) updatewhereclause=yes name=cash dbname="Cash"  )
column=(type=long updatewhereclause=yes name=checkno dbname="CheckNo"  )
column=(type=decimal(0) updatewhereclause=yes name=vrow dbname="VRow"  )
column=(type=decimal(2) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=grossvalue dbname="ItemValue"  )
column=(type=decimal(6) updatewhereclause=yes name=netamt dbname="NetAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=debit dbname="Debit"  )
column=(type=decimal(6) updatewhereclause=yes name=credit dbname="Credit"  )
column=(type=decimal(6) updatewhereclause=yes name=others dbname="Others"  )
column=(type=datetime updatewhereclause=yes name=inactivedate dbname="InActiveDate"  )
column=(type=long updatewhereclause=yes name=counter dbname="Counter"  )
 retrieve="SELECT  
	Type = 'OPD',
	customername=(select name from accounts where accounts.acccode=:ai_custcode),
	RowGroup=1,
	ItemType='MEDICINE',   
	RegDate=P.Date,
	RegNo = P.RegNo,
	Patient=P.Name,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = S.DoctCode),
	TransCode=S.SaleInvCode,
	TransType='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.Date, 
	Details = I.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=MAX(D.RowID),
	Qty=SUM(D.LooseQty),
	ItemValue=SUM(D.LooseQty * D.SalePrice) - 
		SUM((D.looseqty*D.itemflatdisc) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (1-(.01*D.discperc)) * 
				(.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= 0,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	InActiveDate=P.InActiveDate,
	Counter=P.InActiveCount
FROM 
	Patient P,
	Item I,
	SaleLedger S,	 
	SaleDetail D,
	(SELECT 
		SS.SaleInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc),
		InvSaleTax=	ROUND((SUM((DD.looseqty * 
			(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM SaleLedger SS, SaleDetail DD 
	WHERE 
		SS.CustCode IN (:ai_custcode) AND
		SS.patientcode IN (select patientcode from patient where custcode=:ai_custcode) AND
		SS.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SS.SaleInvCode = DD.SaleInvCode
	GROUP BY
		SS.SaleInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE
	( S.CustCode = :ai_custcode AND P.PatientCode = S.PatientCode ) and  
	( S.Date BETWEEN :ad_startdate AND :ad_enddate ) and
	( S.SaleInvCode = D.SaleInvCode ) and
	( S.SaleInvCode = T.SaleInvCode ) and
	( D.ICode = I.Icode )
GROUP  BY
	P.RegNo,
	P.Name,
	P.Date,
	S.SaleInvCode,
	S.Date,
	I.CustomICode,
	I.Name,
	S.SaleCatCode,
	S.DoctCode,
	S.HeaderInvNo,
	S.HeaderNo,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff,
	P.InActiveDate,
	P.InActiveCount
UNION ALL
SELECT  
	Type = 'OPD',
	customername=(select name from accounts where accounts.acccode=:ai_custcode),
	RowGroup=3,
	ItemType='MEDICINE',
	RegDate=P.Date,
	RegNo = P.RegNo,
	Patient=P.Name,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = S.DoctCode),
	TransCode=S.SRInvCode,
	TransType='SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Date = S.Date, 
	Details = I.Name,
	Cash = CASE S.SRCatCode WHEN 7 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=MAX(D.SRUTN),
	Qty=-SUM(D.LooseQty),
	ItemValue= -1 * (SUM(D.LooseQty * D.SRPrice) - 
		SUM((D.looseqty * D.SRPrice * .01 * D.discperc) +
				(D.looseqty * D.SRPrice * (1-(.01*D.discperc)) * (.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * D.SRPrice * (1 - (.01 * D.discperc)) * D.gstperc * .01))),
	NetAmt=T.NetAmt,
	Debit = 0.00,
	Credit= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) FROM SRDetail SD WHERE SD.SRInvCode=S.SRInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) 
		FROM SRDetail SD 
		WHERE SD.SRInvCode=S.SRInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	InActiveDate=P.InActiveDate,
	Counter=P.InActiveCount
FROM
	Patient P,
	Item I,
	SRLedger S,
	SRDetail D,
	(SELECT 
		SS.SRInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * DD.SRPrice) *

				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty * DD.SRPrice *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc)),
		InvSaleTax=	ROUND((SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM SRLedger SS, SRDetail DD 
	WHERE 
		SS.CustCode IN (:ai_custcode) AND
		SS.Patientcode IN (select patientcode from patient where patient.custcode=:ai_custcode) AND
		SS.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SS.SRInvCode = DD.SRInvCode
	GROUP BY
		SS.SRInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	( S.CustCode = :ai_custcode ) AND
	( P.PatientCode = S.PatientCode ) and  
	( S.Date BETWEEN :ad_startdate AND :ad_enddate ) and
	( S.SRInvCode = D.SRInvCode ) and
	( S.SRInvCode = T.SRInvCode ) and
	( D.ICode = I.Icode )
GROUP BY 
	P.RegNo,
	P.Name,
	P.Date,
	S.SRInvCode,
	S.Date,
	I.CustomICode,
	I.Name,
	S.SRCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	S.CustCode, 
	S.Date,
	S.DoctCode,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff,
	P.InActiveDate,
	P.InActiveCount
UNION ALL
SELECT 
	Type = 'OPD',
	customername=(select name from accounts where accounts.acccode=:ai_custcode),
	RowGroup=5,
	ItemType='SERVICES',
	RegDate=P.Date,
	RegNo = P.RegNo,
	Patient=P.Name,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = S.DoctCode),
	TransCode=S.ServiceInvCode,
	TransType='RS-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceInvCode))),
	Date=S.Date,
	Details=SV.Name,
	Cash = CASE S.ServiceCatCode WHEN 11 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=MAX(D.SrvRowID),
	Qty=SUM(D.Qty),
	ItemValue=SUM(D.Qty * (D.Price - D.ServiceFlatDisc) * (1-(.01*D.discperc)) * (1-(.01*S.discperc))),
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.SrvROWID) WHEN (SELECT MAX(SD.SrvROWID) 
		FROM ServiceDetail SD 
		WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= 0.00,
	Others= CASE MAX(D.SrvRowID) WHEN (SELECT MAX(SD.SrvROWID) 
		FROM ServiceDetail SD 
		WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	InActiveDate=P.InActiveDate,
	Counter=P.InActiveCount
FROM 
	Patient P,
	Servicedetail D,
	ServiceHeader S,
	Service SV,
	(SELECT 
		SS.ServiceInvCode, 
		RoundingDiff=
		ROUND(SUM(DD.qty * (DD.Price - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + SS.misccharges - SS.flatdisc, 0) -
			(SUM((DD.qty * (DD.Price - DD.ServiceFlatDisc) ) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + SS.misccharges - SS.flatdisc),
		InvSaleTax=	0,
		NetAmt=ROUND(SUM(DD.qty * (DD.Price - DD.ServiceFlatDisc)  * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			ISNULL(SS.misccharges,0) - ISNULL(SS.flatdisc, 0), 0)
	FROM ServiceHeader SS, ServiceDetail DD 
	WHERE 
		SS.CustCode IN (:ai_custcode) AND
		SS.patientcode IN (select patientcode from patient where patient.custcode=:ai_custcode) AND
		SS.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SS.ServiceInvCode = DD.ServiceInvCode
	GROUP BY
		SS.ServiceInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.DiscPerc,
		SS.MiscCharges) T
WHERE
	( S.CustCode = :ai_custcode ) AND
	( P.PatientCode = S.PatientCode ) and  
	( S.Date BETWEEN :ad_startdate AND :ad_enddate ) AND
	( S.ServiceInvCode = D.ServiceInvCode ) and
	( S.ServiceInvCode = T.ServiceInvCode ) AND
	( D.ServiceCode = SV.Servicecode )
GROUP  BY
	P.RegNo,
	P.Name,
	P.Date,
	S.ServiceInvCode,
	S.Date,
	S.DoctCode,
	SV.Name,
	S.ServiceCatCode,
	S.HeaderNo,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.FlatDisc,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff,
	P.InActiveDate,
	P.InActiveCount
UNION ALL
SELECT 
	Type = 'OPD',
	customername=(select name from accounts where accounts.acccode=:ai_custcode),
	RowGroup=6,
	ItemType='SERVICES',
	RegDate=P.Date,
	RegNo = P.RegNo,
	Patient=P.Name,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = S.DoctCode),
	TransCode=S.ServiceRInvCode,
	TransType='RR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceRInvCode))),
	Date=S.Date,
	Details=SV.Name,
	Cash = CASE S.ServiceRCatCode WHEN 14 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=MAX(D.SrvRRowID),
	Qty= - SUM(D.Qty),
	ItemValue=-1 * SUM(D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1-(.01*D.discperc)) * (1-(.01*S.discperc))),
	NetAmt= T.NetAmt,
	Debit = 0.00,
	Credit= CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SrvRRowID) 
		FROM ServiceRDetail SD 
		WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SrvRROWID) 
		FROM ServiceRDetail SD 
		WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	InActiveDate=P.InActiveDate,
	Counter=P.InActiveCount
FROM 
	Patient P,
	ServiceRdetail D,
	ServiceRHeader S,
	Service SV,
	(SELECT 
		SS.ServiceRInvCode, 
		RoundingDiff=
		ROUND(SUM(DD.qty * (DD.serviceprice - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges - SS.flatdisc, 0) -
		(SUM((DD.qty * (DD.serviceprice - DD.ServiceFlatDisc) ) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges - SS.flatdisc),
		InvSaleTax=	0,
		NetAmt=ROUND(SUM(DD.qty * (DD.serviceprice - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges - SS.flatdisc, 0)
	FROM ServiceRHeader SS, ServiceRDetail DD 
	WHERE 
		SS.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SS.ServiceRInvCode = DD.ServiceRInvCode AND
		SS.CustCode IN (:ai_custcode) AND
		SS.patientcode IN (select patientcode from patient where patient.custcode=:ai_custcode)
	GROUP BY
		SS.ServiceRInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.DiscPerc,
		SS.MiscCharges) T

WHERE
	( S.CustCode = :ai_custcode ) AND
	( P.PatientCode = S.PatientCode ) and  
	( S.Date BETWEEN :ad_startdate AND :ad_enddate ) AND
	( S.ServiceRInvCode = D.ServiceRInvCode ) and
	( S.ServiceRInvCode = T.ServiceRInvCode ) AND
	( D.ServiceCode = SV.Servicecode )
GROUP  BY
	P.RegNo,
	P.Name,
	P.Date,
	S.ServiceRInvCode,
	S.Date,
	S.DoctCode,
	SV.Name,
	S.ServiceRCatCode,
	S.HeaderNo,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.FlatDisc,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff,
	P.InActiveDate,
	P.InActiveCount
////////////////////////////IPD Sales Return and Services
UNION ALL
SELECT  
	Type = 'IPD',
	customername=(select name from accounts where accounts.acccode=:ai_custcode),
	RowGroup=1,
	ItemType='MEDICINE',   
	RegDate=P.Date,
	RegNo = P.RegNo,
	Patient=P.Name,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = S.DoctCode),
	TransCode=S.SaleInvCode,
	TransType='SV-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SaleInvCode))),
	Date = S.Date, 
	Details = I.Name,
	Cash = CASE S.SaleCatCode WHEN 2 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=MAX(D.RowID),
	Qty=SUM(D.LooseQty),
	ItemValue=SUM(D.LooseQty * D.SalePrice) - 
		SUM((D.looseqty*D.itemflatdisc) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (.01 * D.discperc)) +
				(D.looseqty * (D.saleprice - D.itemflatdisc) * (1-(.01*D.discperc)) * 
				(.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * (D.saleprice - D.itemflatdisc)) *
			(1 - (.01 * D.discperc)) * D.gstperc * .01),
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= 0,
	Others= CASE MAX(D.RowID) WHEN (SELECT MAX(SD.ROWID) 
		FROM SaleDetail SD 
		WHERE SD.SaleInvCode=S.SaleInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	InActiveDate=P.InActiveDate,
	Counter=P.InActiveCount
FROM 
	Patient P,
	PatientAdmission PA,
	Item I,
	SaleLedger S,	 
	SaleDetail D,
	(SELECT 
		SS.SaleInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc),
		InvSaleTax=	ROUND((SUM((DD.looseqty * 
			(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * 
				(DD.saleprice - DD.itemflatdisc)) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty*(DD.saleprice - DD.itemflatdisc)) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM SaleLedger SS, SaleDetail DD, PatientAdmission PPA
	WHERE 
		SS.CustCode IN (:ai_custcode) AND
		SS.AdmissionCode IS NOT NULL AND
		SS.AdmissionCode = PPA.AdmissionCode AND
		PPA.PatientCode IN (select patientcode from patient where custcode=:ai_custcode) AND
		SS.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SS.SaleInvCode = DD.SaleInvCode
	GROUP BY
		SS.SaleInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE
	( S.CustCode = :ai_custcode) AND  
	( S.AdmissionCode IS NOT NULL) AND 
	( S.AdmissionCode = PA.AdmissionCode )  AND
	( PA.PatientCode = P.PatientCode ) AND
	( S.Date BETWEEN :ad_startdate AND :ad_enddate ) and
	( S.SaleInvCode = D.SaleInvCode ) and
	( S.SaleInvCode = T.SaleInvCode ) and
	( D.ICode = I.Icode )
GROUP  BY
	P.RegNo,
	P.Name,
	P.Date,
	S.SaleInvCode,
	S.Date,	
	S.DoctCode,
	I.CustomICode,
	I.Name,
	S.SaleCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff,
	P.InActiveDate,
	P.InActiveCount
UNION ALL
SELECT  
	Type = 'IPD',
	customername=(select name from accounts where accounts.acccode=:ai_custcode),
	RowGroup=3,
	ItemType='MEDICINE',
	RegDate=P.Date,
	RegNo = P.RegNo,
	Patient=P.Name,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = S.DoctCode),
	TransCode=S.SRInvCode,
	TransType='SR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.SRInvCode))),
	Date = S.Date, 
	Details = I.Name,
	Cash = CASE S.SRCatCode WHEN 7 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=MAX(D.SRUTN),
	Qty=-SUM(D.LooseQty),
	ItemValue= -1 * (SUM(D.LooseQty * D.SRPrice) - 
		SUM((D.looseqty * D.SRPrice * .01 * D.discperc) +
				(D.looseqty * D.SRPrice * (1-(.01*D.discperc)) * (.01 * S.discperc))) + 
		SUM( (D.looseqty + D.bonusqty) * D.unitsalestax) + 
		SUM((D.looseqty * D.SRPrice * (1 - (.01 * D.discperc)) * D.gstperc * .01))),
	NetAmt=T.NetAmt,
	Debit = 0.00,
	Credit= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) FROM SRDetail SD WHERE SD.SRInvCode=S.SRInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.SRUTN) WHEN (SELECT MAX(SD.SRUTN) 
		FROM SRDetail SD 
		WHERE SD.SRInvCode=S.SRInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	InActiveDate=P.InActiveDate,
	Counter=P.InActiveCount
FROM
	Patient P,
	PatientAdmission PA,
	Item I,
	SRLedger S,
	SRDetail D,
	(SELECT 
		SS.SRInvCode, 
		RoundingDiff=
		ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0) -
		(SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM((DD.looseqty * DD.SRPrice) *

				(1 - (.01 * DD.discperc)) * DD.gstperc * .01) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2) + 
		SUM((DD.looseqty * DD.SRPrice *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc)),
		InvSaleTax=	ROUND((SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
			SS.flatdisc) * (SS.invgstperc1 * .01), 2),
		NetAmt=ROUND(
		SUM( (DD.looseqty + DD.bonusqty) * DD.unitsalestax) + 
			SUM(ROUND( (DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc)) * DD.gstperc * .01, 2)) +
			ROUND( (SUM((DD.looseqty * DD.SRPrice) *
				(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) -
				SS.flatdisc) * (SS.invgstperc1 * .01), 2), 0) + 
		Round(SUM((DD.looseqty * DD.SRPrice) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges + SS.salestax - SS.flatdisc, 0)
	FROM SRLedger SS, SRDetail DD, PatientAdmission PPA
	WHERE 
		SS.CustCode IN (:ai_custcode) AND
		SS.AdmissionCode IS NOT NULL AND
		SS.AdmissionCode = PPA.AdmissionCode AND
		PPA.PatientCode IN (select patientcode from patient where custcode=:ai_custcode) AND
		SS.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SS.SRInvCode = DD.SRInvCode
	GROUP BY
		SS.SRInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.InvGSTPerc1,
		SS.DiscPerc,
		SS.MiscCharges,
		SS.SalesTax) T
WHERE   
	( S.CustCode = :ai_custcode) AND  
	( S.AdmissionCode IS NOT NULL) AND 
	( S.AdmissionCode = PA.AdmissionCode )  AND
	( PA.PatientCode = P.PatientCode ) AND
	( S.Date BETWEEN :ad_startdate AND :ad_enddate ) and
	( S.SRInvCode = D.SRInvCode ) and
	( S.SRInvCode = T.SRInvCode ) and
	( D.ICode = I.Icode )
GROUP BY 
	P.RegNo,
	P.Name,
	P.Date,
	S.SRInvCode,
	S.Date,
	S.DoctCode,
	I.CustomICode,
	I.Name,
	S.SRCatCode,
	S.HeaderInvNo,
	S.HeaderNo,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.SalesTax,
	S.FlatDisc,
	S.InvGstPerc1,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff,
	P.InActiveDate,
	P.InActiveCount
UNION ALL
SELECT 
	Type = 'IPD',
	customername=(select name from accounts where accounts.acccode=:ai_custcode),
	RowGroup=5,
	ItemType='SERVICES',
	RegDate=P.Date,
	RegNo = P.RegNo,
	Patient=P.Name,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = S.DoctCode),
	TransCode=S.ServiceInvCode,
	TransType='RS-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceInvCode))),
	Date=S.Date,
	Details=SV.Name,
	Cash = CASE S.ServiceCatCode WHEN 11 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=MAX(D.SrvRowID),
	Qty=SUM(D.Qty),
	ItemValue=SUM(D.Qty * (D.Price - D.ServiceFlatDisc) * (1-(.01*D.discperc)) * (1-(.01*S.discperc))),
	NetAmt=T.NetAmt,
	Debit = CASE MAX(D.SrvROWID) WHEN (SELECT MAX(SD.SrvROWID) 
		FROM ServiceDetail SD 
		WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN T.NetAmt ELSE 0 END,
	Credit= 0.00,
	Others= CASE MAX(D.SrvRowID) WHEN (SELECT MAX(SD.SrvROWID) 
		FROM ServiceDetail SD 
		WHERE SD.ServiceInvCode=S.ServiceInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	InActiveDate=P.InActiveDate,
	Counter=P.InActiveCount
FROM 
	Patient P,
	PatientAdmission PA,
	Servicedetail D,
	ServiceHeader S,
	Service SV,
	(SELECT 
		SS.ServiceInvCode, 
		RoundingDiff=
		ROUND(SUM(DD.qty * (DD.Price - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + SS.misccharges - SS.flatdisc, 0) -
			(SUM((DD.qty * (DD.Price - DD.ServiceFlatDisc) ) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + SS.misccharges - SS.flatdisc),
		InvSaleTax=	0,
		NetAmt=ROUND(SUM(DD.qty * (DD.Price - DD.ServiceFlatDisc)  * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			ISNULL(SS.misccharges,0) - ISNULL(SS.flatdisc, 0), 0)
	FROM ServiceHeader SS, ServiceDetail DD, PatientAdmission PPA
	WHERE 
		SS.CustCode IN (:ai_custcode) AND
		SS.AdmissionCode IS NOT NULL AND
		SS.AdmissionCode = PPA.AdmissionCode AND
		PPA.PatientCode IN (select patientcode from patient where custcode=:ai_custcode) AND
		SS.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SS.ServiceInvCode = DD.ServiceInvCode
	GROUP BY
		SS.ServiceInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.DiscPerc,
		SS.MiscCharges) T
WHERE
	( S.CustCode = :ai_custcode) AND  
	( S.AdmissionCode IS NOT NULL) AND 
	( S.AdmissionCode = PA.AdmissionCode )  AND
	( PA.PatientCode = P.PatientCode ) AND
	( S.Date BETWEEN :ad_startdate AND :ad_enddate ) AND
	( S.ServiceInvCode = D.ServiceInvCode ) and
	( S.ServiceInvCode = T.ServiceInvCode ) AND
	( D.ServiceCode = SV.Servicecode )
GROUP  BY
	P.RegNo,
	P.Name,
	P.Date,
	S.ServiceInvCode,
	S.Date,
	S.DoctCode,
	SV.Name,
	S.ServiceCatCode,
	S.HeaderNo,
	S.CustCode, 
	S.Date,
	S.DiscPerc,
	S.MiscCharges,
	S.FlatDisc,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff,
	P.InActiveDate,
	P.InActiveCount
UNION ALL
SELECT 
	Type = 'IPD',
	customername=(select name from accounts where accounts.acccode=:ai_custcode),
	RowGroup=6,
	ItemType='SERVICES',
	RegDate=P.Date,
	RegNo = P.RegNo,
	Patient=P.Name,
	Doctor = (SELECT D.Name FROM Doctors D WHERE D.DoctCode = S.DoctCode),
	TransCode=S.ServiceRInvCode,
	TransType='RR-' + RTRIM(LTRIM(CONVERT(CHAR(7), S.ServiceRInvCode))),
	Date=S.Date,
	Details=SV.Name,
	Cash = CASE S.ServiceRCatCode WHEN 14 THEN 'N' ELSE 'Y' END,
	CheckNo=NULL,
	VRow=MAX(D.SrvRRowID),
	Qty= - SUM(D.Qty),
	ItemValue=-1 * SUM(D.Qty * (D.ServicePrice - D.ServiceFlatDisc) * (1-(.01*D.discperc)) * (1-(.01*S.discperc))),
	NetAmt= T.NetAmt,
	Debit = 0.00,
	Credit= CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SrvRRowID) 
		FROM ServiceRDetail SD 
		WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN T.NetAmt ELSE 0 END,
	Others= CASE MAX(D.SrvRRowID) WHEN (SELECT MAX(SD.SrvRROWID) 
		FROM ServiceRDetail SD 
		WHERE SD.ServiceRInvCode=S.ServiceRInvCode) THEN ISNULL(S.MiscCharges, 0) - ISNULL(S.FlatDisc, 0) + ISNULL(T.InvSaleTax, 0) + ISNULL(T.RoundingDiff, 0) ELSE 0 END,
	InActiveDate=P.InActiveDate,
	Counter=P.InActiveCount
FROM 
	Patient P,
	PatientAdmission PA,
	ServiceRdetail D,
	ServiceRHeader S,
	Service SV,
	(SELECT 
		SS.ServiceRInvCode, 
		RoundingDiff=
		ROUND(SUM(DD.qty * (DD.serviceprice - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges - SS.flatdisc, 0) -
		(SUM((DD.qty * (DD.serviceprice - DD.ServiceFlatDisc) ) *
			(1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges - SS.flatdisc),
		InvSaleTax=	0,
		NetAmt=ROUND(SUM(DD.qty * (DD.serviceprice - DD.ServiceFlatDisc) * (1 - (.01 * DD.discperc))) * (1- (.01 * SS.discperc)) + 
			SS.misccharges - SS.flatdisc, 0)
	FROM ServiceRHeader SS, ServiceRDetail DD, PatientAdmission PPA
	WHERE 
		SS.CustCode IN (:ai_custcode) AND
		SS.AdmissionCode IS NOT NULL AND
		SS.AdmissionCode = PPA.AdmissionCode AND
		PPA.PatientCode IN (select patientcode from patient where custcode=:ai_custcode) AND
		SS.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SS.ServiceRInvCode = DD.ServiceRInvCode
	GROUP BY
		SS.ServiceRInvCode,
		SS.DiscPerc,
		SS.FlatDisc,
		SS.DiscPerc,
		SS.MiscCharges) T
WHERE
	( S.CustCode = :ai_custcode) AND  
	( S.AdmissionCode IS NOT NULL) AND 
	( S.AdmissionCode = PA.AdmissionCode )  AND
	( PA.PatientCode = P.PatientCode ) AND
	( S.Date BETWEEN :ad_startdate AND :ad_enddate ) AND
	( S.ServiceRInvCode = D.ServiceRInvCode ) and
	( S.ServiceRInvCode = T.ServiceRInvCode ) AND
	( D.ServiceCode = SV.Servicecode )
GROUP  BY
	P.RegNo,
	P.Name,
	P.Date,
	S.ServiceRInvCode,
	S.Date,
	SV.Name,
	S.ServiceRCatCode,
	S.HeaderNo,
	S.CustCode, 
	S.Date,
	S.DoctCode,
	S.DiscPerc,
	S.MiscCharges,
	S.FlatDisc,
	T.InvSaleTax,
	T.NetAmt,
	T.RoundingDiff,
	P.InActiveDate,
	P.InActiveCount
ORDER BY
	customername,
	RegNo,
	Patient,
	Date,
	TransType,
	TransCode,
	VRow

"
  arguments=(("ai_custcode", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="regno A, patient A, transtype A, date A, vrow A"
)
