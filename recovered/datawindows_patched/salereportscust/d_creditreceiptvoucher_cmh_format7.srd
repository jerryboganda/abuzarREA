header(height=1322 color="536870912" )
summary(height=958 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(60) updatewhereclause=yes name=manufacurer dbname="manufacurer"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=long updatewhereclause=yes name=id dbname="id"  )
column=(type=decimal(2) updatewhereclause=yes name=cumulativesum dbname="cumulativesum"  )
column=(type=decimal(2) updatewhereclause=yes name=cumulativesumfoot dbname="cumulativesumfoot"  )
column=(type=long updatewhereclause=yes name=rowid dbname="rowid"  )
 retrieve="SELECT 
	itemname, 
	packing,
	manufacurer,
	looseqty = Sum (looseqty),
	price = max(price), 
	id = max(id), 
	cumulativesum = round(0.00,2),
	cumulativesumfoot = round(0.00,2),
	rowid=max(rowid)
FROM
	(SELECT itemname = item.name, 
			 packing = dbo.item.packingdesc,
			 manufacurer = (dbo.manufacturer.name),
			 looseqty = Sum (dbo.saledetail.looseqty),
			 price = max(dbo.saledetail.saleprice), 
			 id = max(dbo.saledetail.rowid), 
			 cumulativesum = round(0.00,2),
			 cumulativesumfoot = round(0.00,2),
			rowid=max(saledetail.rowid)
	FROM 	 dbo.saleledger, 
			 dbo.saledetail,    
			 dbo.item, 
			 dbo.Customer,
			 dbo.Accounts,
			 dbo.Manufacturer 
	WHERE  
			:as_doctype = 'originaldate' AND
			dbo.saleledger.originaldate >= :ad_StartDate AND
			 dbo.saleledger.originaldate <= :ad_EndDate  AND 
			 dbo.saleledger.custcode IN ( :al_custcode ) AND
			 dbo.saleledger.salecatcode IN (1, 2, 3) AND
			 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
			 dbo.saledetail.icode = item.icode AND
			 dbo.saleledger.custcode = dbo.customer.custcode AND
			 dbo.customer.custcode = dbo.accounts.acccode AND
			 dbo.Item.manfcode = dbo.manufacturer.manfcode
			
	Group by 
			dbo.saledetail.icode,
			dbo.saledetail.rowgroup,
			dbo.item.name,
			dbo.item.packingdesc,
			dbo.manufacturer.name
	UNION ALL
	SELECT itemname = item.name,
			 packing = dbo.item.packingdesc,
			 manufacurer = (dbo.manufacturer.name),
			 looseqty = Sum (sd.looseqty),
			 price = max(sd.saleprice),    
			 id = max(sd.rowid), 
			 cumulativesum = round(0.00,2),
			 cumulativesumfoot = round(0.00,2),
			rowid=max(sd.rowid)
	FROM 	 dbo.saleledger, 
			 dbo.saleinvdetail sd,    
			 dbo.item, 
			 dbo.Customer,
			 dbo.Accounts,
			 dbo.Manufacturer 
	WHERE  
			:as_doctype = 'originaldate' AND
			dbo.saleledger.impactinventory = 'N' AND
			 dbo.saleledger.originaldate >= :ad_StartDate AND
			 dbo.saleledger.originaldate <= :ad_EndDate  AND 
			 dbo.saleledger.custcode IN ( :al_custcode ) AND
			 dbo.saleledger.salecatcode IN (1, 2, 3) AND
			 dbo.saleledger.saleinvcode = sd.saleinvcode AND
			 sd.icode = item.icode AND
			 dbo.saleledger.custcode = dbo.customer.custcode AND
			 dbo.customer.custcode = dbo.accounts.acccode AND
			 dbo.Item.manfcode = dbo.manufacturer.manfcode
	Group by 
			sd.icode,
			sd.rowgroup,
			dbo.item.name,
			dbo.item.packingdesc,
			dbo.manufacturer.name
	UNION 
	SELECT itemname = item.name,
			 packing = dbo.item.packingdesc,
			 manufacurer = (dbo.manufacturer.name),
			 looseqty = Sum (dbo.saledetail.looseqty),
			 price = max(dbo.saledetail.saleprice),    
			 id = max(dbo.saledetail.rowid), 
			 cumulativesum = round(0.00,2),
			 cumulativesumfoot = round(0.00,2),
			rowid=max(saledetail.rowid)
	FROM 	 dbo.saleledger, 
			 dbo.saledetail,    
			 dbo.item, 
			 dbo.Customer,
			 dbo.Accounts,
			 dbo.Manufacturer 
	WHERE  
			:as_doctype = 'billingdate' AND
			dbo.saleledger.billingdate >= :ad_StartDate AND
			 dbo.saleledger.billingdate <= :ad_EndDate  AND 
			 dbo.saleledger.custcode IN ( :al_custcode ) AND
			 dbo.saleledger.salecatcode IN (1, 2, 3) AND
			 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
			 dbo.saledetail.icode = item.icode AND
			 dbo.saleledger.custcode = dbo.customer.custcode AND
			 dbo.customer.custcode = dbo.accounts.acccode AND
			 dbo.Item.manfcode = dbo.manufacturer.manfcode
	Group by 
			dbo.saledetail.icode,
			dbo.saledetail.rowgroup,
			dbo.item.name,
			dbo.item.packingdesc,
			dbo.manufacturer.name
	UNION ALL
	SELECT itemname = item.name,
			 packing = dbo.item.packingdesc,
			 manufacurer = (dbo.manufacturer.name),
			 looseqty = Sum (sd.looseqty),
			 price = max(sd.saleprice),    
			 id = max(sd.rowid), 
			 cumulativesum = round(0.00,2),
			 cumulativesumfoot = round(0.00,2),
			rowid=max(sd.rowid)
	FROM 	 dbo.saleledger, 
			 dbo.saleinvdetail sd,    
			 dbo.item, 
			 dbo.Customer,
			 dbo.Accounts,
			 dbo.Manufacturer 
	WHERE  
			:as_doctype = 'billingdate' AND
			dbo.saleledger.impactinventory = 'N' AND
			 dbo.saleledger.billingdate >= :ad_StartDate AND
			 dbo.saleledger.billingdate <= :ad_EndDate  AND 
			 dbo.saleledger.custcode IN ( :al_custcode ) AND
			 dbo.saleledger.salecatcode IN (1, 2, 3) AND
			 dbo.saleledger.saleinvcode = sd.saleinvcode AND
			 sd.icode = item.icode AND
			 dbo.saleledger.custcode = dbo.customer.custcode AND
			 dbo.customer.custcode = dbo.accounts.acccode AND
			 dbo.Item.manfcode = dbo.manufacturer.manfcode
	Group by 
			sd.icode,
			sd.rowgroup,
			dbo.item.name,
			dbo.item.packingdesc,
			dbo.manufacturer.name
	UNION 
	SELECT itemname = item.name,
			 packing = dbo.item.packingdesc,
			 manufacurer = (dbo.manufacturer.name),
			 looseqty = Sum (dbo.saledetail.looseqty),
			 price = max(dbo.saledetail.saleprice),    
			 id = max(dbo.saledetail.rowid), 
			 cumulativesum = round(0.00,2),
			 cumulativesumfoot = round(0.00,2),
			rowid=max(saledetail.rowid)
	FROM 	 dbo.saleledger, 
			 dbo.saledetail,    
			 dbo.item, 
			 dbo.Customer,
			 dbo.Accounts,
			 dbo.Manufacturer 
	WHERE  
			:as_doctype = 'lastsavingdate' AND
			dbo.saleledger.date >= :ad_StartDate AND
			 dbo.saleledger.date <= :ad_EndDate  AND 
			 dbo.saleledger.custcode IN ( :al_custcode ) AND
			 dbo.saleledger.salecatcode IN (1, 2, 3) AND
			 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
			 dbo.saledetail.icode = item.icode AND
			 dbo.saleledger.custcode = dbo.customer.custcode AND
			 dbo.customer.custcode = dbo.accounts.acccode AND
			 dbo.Item.manfcode = dbo.manufacturer.manfcode
	Group by 
			dbo.saledetail.icode,
			dbo.saledetail.rowgroup,
			dbo.item.name,
			dbo.item.packingdesc,
			dbo.manufacturer.name
	UNION ALL
	SELECT itemname = item.name,
			 packing = dbo.item.packingdesc,
			 manufacurer = (dbo.manufacturer.name),
			 looseqty = Sum (sd.looseqty),
			 price = max(sd.saleprice),    
			 id = max(sd.rowid), 
			 cumulativesum = round(0.00,2),
			 cumulativesumfoot = round(0.00,2),
			rowid=max(sd.rowid)
	FROM 	 dbo.saleledger, 
			 dbo.saleinvdetail sd,    
			 dbo.item, 
			 dbo.Customer,
			 dbo.Accounts,
			 dbo.Manufacturer 
	WHERE  
			:as_doctype = 'lastsavingdate' AND
			dbo.saleledger.impactinventory = 'N' AND
			 dbo.saleledger.date >= :ad_StartDate AND
			 dbo.saleledger.date <= :ad_EndDate  AND 
			 dbo.saleledger.custcode IN ( :al_custcode ) AND
			 dbo.saleledger.salecatcode IN (1, 2, 3) AND
			 dbo.saleledger.saleinvcode = sd.saleinvcode AND
			 sd.icode = item.icode AND
			 dbo.saleledger.custcode = dbo.customer.custcode AND
			 dbo.customer.custcode = dbo.accounts.acccode AND
			 dbo.Item.manfcode = dbo.manufacturer.manfcode
	Group by 
			sd.icode,
			sd.rowgroup,
			dbo.item.name,
			dbo.item.packingdesc,
			dbo.manufacturer.name) T
GROUP BY
	manufacurer,
	itemname, 
	packing
order by rowid"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_city", string), ("as_doctype", string), ("as_caption1", string), ("as_caption2", string))
)
