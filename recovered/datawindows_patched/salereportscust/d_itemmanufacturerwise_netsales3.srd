release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=564 color="536870912" )
summary(height=92 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=manfcode dbname="Item.ManfCode"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=long updatewhereclause=yes name=icode dbname="Item.ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=currentsaleprice dbname="CurrentSalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=currentpurprice dbname="CurrentPurPrice"  )
column=(type=decimal(15) updatewhereclause=yes name=expectmargin dbname="ExpectMargin"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=actualvalue dbname="ActualValue"  )
column=(type=decimal(6) updatewhereclause=yes name=saleamount dbname="SaleAmount"  )
column=(type=decimal(12) updatewhereclause=yes name=itemcost dbname="ItemCost"  )
column=(type=decimal(6) updatewhereclause=yes name=margin dbname="Margin"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
 retrieve="SELECT
	I.ManfCode, 
	Manufacturer=M.Name,
	I.ICode,
	ItemName=I.Name,
	Packunits=I.Packunits,
	CurrentSalePrice = CASE When Sum(D.SaleQty) > 0 Then Max(I.SalePrice) Else 0 End,
	CurrentPurPrice = CASE When Sum(D.SaleQty) > 0 Then Max(I.PurPrice) Else 0 End,
	ExpectMargin = ( ( Max(I.SalePrice) - Max(I.PurPrice) ) / Max(CASE I.SalePrice When 0 Then 1 Else I.SalePrice End)  ) * 100 ,
	Qty=ISNULL(sum(D.saleqty),0),
	ActualValue = ISNULL(Sum(D.ActualValue), 0 ) ,
	SaleAmount=ISNULL(sum(D.salevalue), 0),
	ItemCost=ISNULL(sum(D.itemcost), 0),
	Margin=ISNULL((sum(D.salevalue) - sum(D.itemcost) ) * 100 / 
			Case sum(D.salevalue) WHEN 0 THEN 1 ELSE sum(D.salevalue) END, 0),
	Bonus=ISNULL(sum(D.bonus),0)
FROM
	Manufacturer M,
	Item I LEFT OUTER JOIN
	(SELECT saleqty=ISNULL(sum(SD.looseqty),0) ,
				bonus=ISNULL(sum(SD.bonusqty),0) ,
				salevalue=ISNULL(round(sum((SD.looseqty * (SD.saleprice - itemflatdisc)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01),2),0),
	        	I.ICode,
	        	itemcost=ISNULL(Round(sum( (I.purprice/I.packunits) * (SD.looseqty + SD.BonusQty)),2),0),
				ActualValue = IsNull( Sum ( SD.Rate * SD.looseqty) , 0 )
	FROM		saleledger SL,
				saledetail SD,
				item I
	WHERE		SD.icode=I.icode AND
				I.manfcode IN (:ala_manfcode) AND
				SD.saleinvcode=SL.saleinvcode AND
				SL.salecatcode IN (:aa_salecatcode) and
				SL.date BETWEEN :adt_sdate AND :adt_ldate
	GROUP BY 
	         SD.icode,
		 		I.ICode,
	         SL.saleinvcode,
	         SL.discperc
	UNION ALL
	SELECT saleqty=ISNULL(sum(SD.looseqty),0) ,
				bonus=ISNULL(sum(SD.bonusqty),0) ,
				salevalue=ISNULL(round(sum((SD.looseqty * (SD.saleprice - itemflatdisc)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01),2),0),
	        	I.ICode,
	        	itemcost=ISNULL(Round(sum( (I.purprice/I.packunits) * (SD.looseqty + SD.BonusQty)),2),0),
				ActualValue = IsNull( Sum ( SD.Rate * SD.looseqty) , 0 )
	FROM		saleledger SL,
				saleinvdetail SD,
				item I
	WHERE		SL.ImpactInventory='N' AND
				SD.icode=I.icode AND
				I.manfcode IN (:ala_manfcode) AND
				SD.saleinvcode=SL.saleinvcode AND
				SL.salecatcode IN (:aa_salecatcode) and
				SL.date BETWEEN :adt_sdate AND :adt_ldate
	GROUP BY 
	         SD.icode,
		 		I.ICode,
	         SL.saleinvcode,
	         SL.discperc
	UNION ALL
	SELECT	saleqty=-ISNULL(sum(SD.looseqty),0) ,
				bonus=-ISNULL(sum(SD.bonusqty),0) ,
				salevalue=-ISNULL(round(sum((SD.looseqty * (SD.srprice)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01),2),0),
				I.ICode,
				itemcost=-ISNULL(Round(sum( (I.purprice/I.packunits) * (SD.looseqty + SD.BonusQty)),2),0),
				ActualValue = -1 * ( IsNull ( Sum ( SD.SalePrice * SD.LooseQty) , 0 )  )
	FROM		srledger SL,
				srdetail SD,
				item I
	WHERE		SD.icode=I.icode AND
				I.manfcode IN (:ala_manfcode) AND
				SD.srinvcode=SL.srinvcode AND
				SL.srcatcode IN (:aa_srcatcode) AND
				SL.date BETWEEN :adt_sdate AND :adt_ldate
	GROUP BY
				SD.icode,
				I.ICode,
				SL.srinvcode,
				SL.discperc) AS D ON (I.ICode = D.ICode)
	WHERE 
			I.manfcode IN (:ala_manfcode) AND
			I.ManfCode = M.ManfCode
	GROUP BY
		I.ManfCode,
		M.Name,
		I.ICode,
		I.name,
		I.Packunits
ORDER BY
	M.Name,
	I.name
"
  arguments=(("ala_manfcode", numberlist), ("adt_SDate", datetime), ("adt_LDate", datetime), ("aa_salecatcode", numberlist), ("aa_srcatcode", numberlist))
)
