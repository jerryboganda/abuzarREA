release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(20) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=long updatewhereclause=yes name=areacode dbname="AreaCode"  )
column=(type=char(60) updatewhereclause=yes name=area dbname="AREA"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(121) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="Amount"  )
column=(type=char(1) updatewhereclause=yes name=show dbname="Show"  )
 retrieve="SELECT 
	A.GroupCode,  
	GroupName= 
		CASE :as_reportgrouping
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = A.GroupCode)
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = A.GroupCode)
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = A.GroupCode)
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = A.GroupCode) END,   
	A.AreaCode,
	AREA=(Select Ar.Name FROM Area Ar Where Ar.AreaCode = A.AreaCode),
	AliasName=(Select Ac.AliasName FROM accounts Ac Where Ac.Acccode = A.CustCode),
	customer=(Select Ac.Name FROM accounts Ac Where Ac.Acccode = A.CustCode),
	Address=(Select RTRIM(LTRIM(C.Address1)) + ' ' + RTRIM(LTRIM(C.Address2)) FROM Customer C Where C.CustCode = A.CustCode),
	City=(Select C.CITY FROM Customer C Where C.CustCode = A.CustCode),
	Amount=Sum(A.amount),
	Show='N'
FROM
	(SELECT	
		SaleType='S',
		AreaCode=C.AreaCode,
		CustCode=S.CustCode,
		ICode=D.ICode,
		GroupCode=
		CASE :as_reportgrouping
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END,   
		Amount = Round(Sum ( D.LooseQty * (D.SalePrice - D.ItemFlatDisc)  * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)), 2)
	FROM 
		dbo.SaleLedger S, 
		dbo.Customer C, 
	 	dbo.SaleDetail D, 
	 	dbo.Item I
	WHERE
		S.Date >= :ad_StartDate and
	 	S.Date <= :ad_EndDate  and
		S.CustCode = C.CustCode and
		C.AreaCode IN (:ai_AreaCode) and
	 	S.SaleInvCode = D.SaleInvCode and  
		CASE :as_reportgrouping
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END IN (:ai_groupcode) and
	 	D.icode = I.icode 
	GROUP BY
		S.CustCode,
		C.AreaCode,
		D.ICode,
		I.ManfCode,
		I.ICatCode,
		I.ICCode,
		I.PackCode
	UNION ALL
	SELECT	
		SaleType='S',
		AreaCode=C.AreaCode,
		CustCode=S.CustCode,
		ICode=D.ICode,
		GroupCode=
		CASE :as_reportgrouping
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END,   
		Amount = Round(Sum ( D.LooseQty * (D.SalePrice - D.ItemFlatDisc)  * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)), 2)
	FROM 
		dbo.SaleLedger S, 
		dbo.Customer C, 
	 	dbo.SaleInvDetail D, 
	 	dbo.Item I
	WHERE
		S.impactinventory = 'N' AND
		S.Date >= :ad_StartDate and
	 	S.Date <= :ad_EndDate  and
		S.CustCode = C.CustCode and
		C.AreaCode IN (:ai_AreaCode) and
	 	S.SaleInvCode = D.SaleInvCode and  
		CASE :as_reportgrouping
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END IN (:ai_groupcode) and
	 	D.icode = I.icode 
	GROUP BY
		S.CustCode,
		C.AreaCode,
		D.ICode,
		I.ManfCode,
		I.ICatCode,
		I.ICCode,
		I.PackCode
	UNION ALL
	SELECT	
		SaleType='R',
		AreaCode=C.AreaCode,
		CustCode=S.CustCode,
		ICode=D.ICode,
		GroupCode=
		CASE :as_reportgrouping
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END,   
		Amount = - Round(Sum ( D.LooseQty * D.SRPrice  * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)), 2)
	FROM 
		dbo.SRLedger S, 
		dbo.Customer C, 
	 	dbo.SRDetail D, 
	 	dbo.Item I
	WHERE
		S.Date >= :ad_StartDate and
	 	S.Date <= :ad_EndDate  and
		S.CustCode = C.CustCode and
		C.AreaCode IN (:ai_AreaCode) and
	 	S.SRInvCode = D.SRInvCode and  
		CASE :as_reportgrouping
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END IN (:ai_groupcode) and
	 	D.icode = I.icode 
	GROUP BY
		S.CustCode,
		C.AreaCode,
		D.ICode,
		I.ManfCode,
		I.ICatCode,
		I.ICCode,
		I.PackCode) AS A
GROUP BY 
	A.CustCode,
	A.AreaCode,
	A.GroupCode
ORDER BY
	GroupName,
	Amount Desc,
	Customer"
  arguments=(("as_ReportGrouping", string), ("ai_areacode", numberlist), ("ai_groupcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime), ("ad_toprows", number))
 sort="groupname A, amount D"
 filter=" show = 'Y'"
 )
