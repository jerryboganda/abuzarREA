 retrieve="SELECT 
	orderby=code2, 
	groupcode=code5, 
	groupname=name5,
	Custcode=code1, 
	aliasname=name2, 
	Customername=name1, 
	CustGroupcode=code3,
	CustomerGroup=name4,
	itemname1=c_name1,
	itemname2=c_name2,
	itemname3=c_name3,
	itemname4=c_name4,
	itemname5=c_name5,
	itemname6=c_name6,
	itemname7=c_name7,
	itemname8=c_name8,
	itemname9=c_name9,
	itemname10=c_name10,
	itemname11=c_name11,
	itemname12=c_name12,
	itemname13=c_name13,
	qty1,
	qty2,
	qty3,
	qty4,
	qty5,
	qty6,
	qty7,
	qty8,
	qty9,
	qty10,
	qty11,
	qty12,
	qty13,
	val1,
	val2,
	val3,
	val4,
	val5,
	val6,
	val7,
	val8,
	val9,
	val10,
	val11,
	val12,
	val13,
	totqty,
	totval

from 
	crosstab_reportdata 
order by 
	CustomerGroup, 
	groupname, 
	orderby, 
	CustomerName,
	aliasname"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="groupname A, orderby A, customername A"
)
