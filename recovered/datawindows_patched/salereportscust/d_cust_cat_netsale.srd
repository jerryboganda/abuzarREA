table(column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CustAlias"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="Class"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="ItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=value dbname="Value"  )
column=(type=decimal(6) updatewhereclause=yes name=salediscval dbname="SaleDiscVal"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="SalesTax"  )
column=(type=decimal(4) updatewhereclause=yes name=retqty dbname="RetQty"  )
column=(type=decimal(6) updatewhereclause=yes name=retvalue dbname="RetValue"  )
 retrieve="SELECT
	Customer = A.Name,
	CustAlias=A.AliasName,
	Category=IC.Name,
	Class=IL.Name,
	ICode = S.ICode,
	ItemAlias=I.CustomICode,
	ItemName=I.Name,
	Qty = SUM(S.Qty),
	Value=SUM(S.Value),
	SaleDiscVal=SUM(S.salediscval),
	SalesTax = SUM(S.SalesTax),
	RetQty=SUM(S.RetQty),
	RetValue=SUM(S.RetValue) 
FROM 
	(SELECT 
		SL.CustCode,
		SD.ICode, 
		Qty=SUM(SD.LooseQty + SD.BonusQty),
		Value=SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) *
			(1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ),
		salediscval=Round(Sum (Round( (SD.looseqty * ( SD.saleprice - SD.itemflatdisc)) * (SD.discperc * .01 )+ ((SD.looseqty * ( SD.saleprice - SD.itemflatdisc)) * (1 - SD.discperc * .01 ))*SL.discperc*0.01 + (SD.looseqty * SD.itemflatdisc),2) ), 2),
		SalesTax = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc* 0.01) + SUM((SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax),
		RetQty=0,
		RetValue=0
	FROM
		SaleLedger SL, 
		SaleDetail SD,
		Item I
	WHERE
		SL.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SL.CustCode IN (:ai_custcode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ICatCode IN (:ai_icatcode)
	GROUP BY SL.CustCode, SD.ICode
	UNION ALL
	SELECT 
		SL.CustCode,
		SD.ICode, 
		Qty=SUM(SD.LooseQty + SD.BonusQty),
		Value=SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) *
			(1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ),
		salediscval=Round(Sum (Round( (SD.looseqty * ( SD.saleprice - SD.itemflatdisc)) * (SD.discperc * .01 )+ ((SD.looseqty * ( SD.saleprice - SD.itemflatdisc)) * (1 - SD.discperc * .01 ))*SL.discperc*0.01 + (SD.looseqty * SD.itemflatdisc),2) ), 2),
		SalesTax = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc* 0.01) + SUM((SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax),
		RetQty=0,
		RetValue=0
	FROM
		SaleLedger SL, 
		SaleInvDetail SD,
		Item I
	WHERE
		SL.ImpactInventory = 'N' AND
		SL.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SL.CustCode IN (:ai_custcode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ICatCode IN (:ai_icatcode)
	GROUP BY SL.CustCode, SD.ICode
	UNION ALL
	SELECT 
		SL.CustCode,
		SD.ICode, 
		Qty=- SUM(SD.LooseQty + SD.BonusQty),
		Value=- SUM(SD.LooseQty * SD.SrPrice *
			(1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ),
		salediscval=0,
		SalesTax = - (SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc* 0.01) + SUM((SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax)),
		RetQty=SUM(SD.LooseQty + SD.BonusQty),
		RetValue=SUM(SD.LooseQty * SD.SrPrice *
			(1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) )
	FROM
		SrLedger SL, 
		SRDetail SD,
		Item I
	WHERE
		SL.Date BETWEEN :ad_startdate AND :ad_enddate AND
		SL.CustCode IN (:ai_custcode) AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = I.ICode AND
		I.ICatCode IN (:ai_icatcode)
	GROUP BY SL.CustCode, SD.ICode) S,
	Area Ar, 
	Customer C, 
	Accounts A,
	Item I,
	ItemCategory IC,
	ItemClass IL
WHERE
	C.CustCode IN (:ai_custcode) AND
	C.CUSTCODE = S.CUSTCODE AND
	C.AreaCode = Ar.AreaCode AND
	S.CustCode = A.AccCode AND
	S.ICode = I.ICode AND
	I.ICatCode IN (:ai_icatcode) AND
	I.ICatCode = IC.ICatCode AND
	I.ICCode = IL.ICCode
GROUP BY
	A.Name,
	A.AliasName,
	IC.Name,
	IL.Name,
	S.ICode,
	I.CustomICode,
	I.Name
ORDER BY
	Customer,
	CustAlias,
	Category,
	ItemName,
	ItemAlias,
	Class
"
  arguments=(("ai_icatcode", numberlist), ("ai_custcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
