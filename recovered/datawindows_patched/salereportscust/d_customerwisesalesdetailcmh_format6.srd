table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="saleinvcode"  )
column=(type=long updatewhereclause=yes name=customerref dbname="CustomerRef"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="invsalestax"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=unittax dbname="unittax"  )
column=(type=decimal(6) updatewhereclause=yes name=taxamount dbname="taxamount"  )
column=(type=decimal(2) updatewhereclause=yes name=itemdiscperc dbname="itemdiscperc"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=long updatewhereclause=yes name=rowid dbname="rowid"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(60) updatewhereclause=yes name=contactperson dbname="contactperson"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacurer"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
 retrieve="SELECT saleinvcode = (dbo.saleledger.saleinvcode),     
		 CustomerRef = max(convert(int ,rtrim(ltrim(IsNull(dbo.saleledger.CustRefNo, '0'))))), 
       date = max(dbo.saleledger.date), 
		 invdiscperc = max(dbo.saleledger.discperc),    
       flatdisc = max(dbo.saleledger.flatdisc), 
       misccharges = max(dbo.saleledger.misccharges), 
       invsalestax = max(dbo.saleledger.salestax),
       remarks = (dbo.saleledger.remarks), 
       custcode = max(dbo.saleledger.custcode),
		 looseqty = sum(dbo.saledetail.looseqty), 
		 packqty  = max(saledetail.packqty),  
		 price = max(dbo.saledetail.saleprice),    
       unittax=max(saledetail.unitsalestax),
		 taxamount= max(saledetail.unitsalestax) * sum(dbo.saledetail.looseqty),
		 itemdiscperc = max(dbo.saledetail.discperc),    
		 packunits = max(dbo.saledetail.packunits),    
		 batch = max(dbo.saledetail.batch),    
		 expiry = max(dbo.saledetail.expiry),    
		 salestax  = max(saledetail.salestax),
		 rowid     = max(saledetail.rowid),
	 	 itemname = item.name,
		
		 customer = (dbo.accounts.name),
		 contactperson=(dbo.customer.cp),
		 manufacurer = (dbo.manufacturer.name),
		 address = (dbo.customer.address1),
		 city = (dbo.customer.city)

FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item, 
		 dbo.accounts,
		 dbo.Customer,
		 dbo.Manufacturer 

WHERE 
		 :ai_datetype = 1 AND
		 dbo.saleledger.originaldate >= :ad_StartDate and
		 dbo.saleledger.originaldate <= :ad_EndDate  and 
		 (dbo.saleledger.custcode >= ( Case :al_CustCode When 0 Then 10 Else :al_CustCode End) and 
		 dbo.saleledger.custcode  <= ( Case :al_CustCode When 0 THEN (Select max(custcode) From Customer) Else :al_CustCode End )) and
		 dbo.saleledger.salecatcode IN (1, 2, 3) and
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
		 dbo.saledetail.icode = item.icode and 
		 dbo.saleledger.custcode = dbo.accounts.acccode and
		 dbo.saleledger.custcode = dbo.customer.custcode and
		 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by saleledger.saleinvcode,
		saledetail.icode,
		item.name,
		saledetail.saleprice,
		(dbo.accounts.name),
		(dbo.manufacturer.name),
		(dbo.customer.cp),
		(dbo.customer.address1),
		(dbo.customer.city),
		(dbo.saleledger.remarks)
UNION ALL
SELECT saleinvcode = (dbo.saleledger.saleinvcode),    
		 CustomerRef = max(convert(int ,rtrim(ltrim(IsNull(dbo.saleledger.CustRefNo, '0'))))), 
       date = max(dbo.saleledger.date), 
		 invdiscperc = max(dbo.saleledger.discperc),    
       flatdisc = max(dbo.saleledger.flatdisc), 
       misccharges = max(dbo.saleledger.misccharges), 
       invsalestax = max(dbo.saleledger.salestax),
       remarks = (dbo.saleledger.remarks), 
       custcode = max(dbo.saleledger.custcode),
		 looseqty = sum(sd.looseqty), 
		 packqty  = 0,  
	
       price = max(sd.saleprice),    
       unittax=max(sd.unitsalestax),
		 taxamount= max(sd.unitsalestax) * sum(sd.looseqty),
		 itemdiscperc = max(sd.discperc),    
		 packunits = max(sd.packunits),    
		 batch = max(sd.batch),    
		 expiry = max(sd.expiry),    
		 salestax  = 0,
		 rowid     = max(sd.rowid),
	 	 itemname = item.name,
		 /*datestring = max((Rtrim(LTrim(Str(DatePart(dd, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(mm, saleledger.date)))) + '/' + Rtrim(LTrim(Str(DatePart(yy, saleledger.date)))))), */
		customer = (dbo.accounts.name),
		 contactperson=(dbo.customer.cp),
		 manufacurer = (dbo.manufacturer.name),
		 address = (dbo.customer.address1),
		 city = (dbo.customer.city)

FROM 	 dbo.saleledger, 
		 dbo.saleinvdetail sd, 
		 dbo.item, 
		 dbo.accounts,
		 dbo.Customer,
		 dbo.Manufacturer 

WHERE :ai_datetype = 1 AND
		 DBO.SaleLedger.impactinventory = 'N' AND 
		 dbo.saleledger.originaldate >= :ad_StartDate and
		 dbo.saleledger.originaldate <= :ad_EndDate  and 
		 (dbo.saleledger.custcode >= ( Case :al_CustCode When 0 Then 10 Else :al_CustCode End) and 
		 dbo.saleledger.custcode  <= ( Case :al_CustCode When 0 THEN (Select max(custcode) From Customer) Else :al_CustCode End )) and
		 dbo.saleledger.salecatcode IN (1, 2, 3) and
		 /*dbo.saleledger.saleinvcode NOT IN (select distinct srledger.saleinvcode from srledger where srledger.originaldate between :ad_StartDate and :ad_EndDate and srledger.saleinvcode IS NOT NULL) and*/
		 dbo.saleledger.saleinvcode = sd.saleinvcode and  
		 sd.icode = item.icode and 
		 dbo.saleledger.custcode = dbo.accounts.acccode and
		 dbo.saleledger.custcode = dbo.customer.custcode and
		 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by saleledger.saleinvcode,
		sd.icode,
		item.name,
		sd.saleprice,
		(dbo.accounts.name),
		(dbo.manufacturer.name),
		(dbo.customer.cp),
		(dbo.customer.address1),
		(dbo.customer.city),
		(dbo.saleledger.remarks)
UNION ALL
