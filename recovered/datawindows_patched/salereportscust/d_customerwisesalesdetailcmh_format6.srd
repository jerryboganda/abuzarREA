		(dbo.customer.cp),
		(dbo.customer.address1),
		(dbo.customer.city),
		(dbo.saleledger.remarks)
"
  arguments=(("al_CustCode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_InvNo", string), ("as_bildate", string), ("ai_datetype", number))
 sort="customerref A, rowid A"
)
