table(column=(type=long updatewhereclause=yes name=grouping dbname="grouping"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(60) updatewhereclause=yes name=manufacurer dbname="manufacurer"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(0) updatewhereclause=yes name=utn dbname="utn"  )
 retrieve="SELECT  
		 grouping=1,
		 itemname = item.name,
		 packing = dbo.item.packingdesc,
		 manufacurer = (dbo.manufacturer.name),
		 looseqty = Sum (dbo.saledetail.looseqty),
		 price = max(dbo.saledetail.saleprice),
		 utn = max(dbo.saledetail.saleutn)
FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item, 
		 dbo.Customer,
		 dbo.Accounts,
		 dbo.Manufacturer 
WHERE  
		 :as_doctype = 'originaldate' AND
		 dbo.saleledger.originaldate >= :ad_StartDate AND
		 dbo.saleledger.originaldate <= :ad_EndDate  AND 
		 dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		 dbo.saledetail.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode AND
		 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
		dbo.saledetail.icode,
		dbo.item.name,
		dbo.item.packingdesc,
		dbo.manufacturer.name
UNION ALL
SELECT 
		 grouping=1,
		 itemname = item.name,
		 packing = dbo.item.packingdesc,
		 manufacurer = (dbo.manufacturer.name),
		 looseqty = Sum (sd.looseqty),
		 price = max(sd.saleprice),
		 utn = max(sd.saleutn)
FROM 	 dbo.saleledger, 
		 dbo.saleinvdetail sd,    
		 dbo.item, 
		 dbo.Customer,
		 dbo.Accounts,
		 dbo.Manufacturer 
WHERE  DBO.SaleLedger.impactinventory = 'N' AND
		 :as_doctype = 'originaldate' AND
		 dbo.saleledger.originaldate >= :ad_StartDate AND
		 dbo.saleledger.originaldate <= :ad_EndDate  AND 
		 dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = sd.saleinvcode AND
		 sd.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode AND
		 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
		sd.icode,
		dbo.item.name,
		dbo.item.packingdesc,
		dbo.manufacturer.name
UNION
SELECT 
		 grouping=1,
		 itemname = item.name,
		 packing = dbo.item.packingdesc,
		 manufacurer = (dbo.manufacturer.name),
		 looseqty = Sum (dbo.saledetail.looseqty),
		 price = max(dbo.saledetail.saleprice),
		 utn = max(dbo.saledetail.saleutn)
FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item, 
		 dbo.Customer,
		 dbo.Accounts,
		 dbo.Manufacturer 
WHERE  
		 :as_doctype = 'billingdate' AND
		 dbo.saleledger.billingdate >= :ad_StartDate AND
		 dbo.saleledger.billingdate <= :ad_EndDate  AND 
		 dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		 dbo.saledetail.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode AND
		 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
		dbo.saledetail.icode,
		dbo.item.name,
		dbo.item.packingdesc,
		dbo.manufacturer.name
UNION ALL
SELECT 
		 grouping=1,
		 itemname = item.name,
		 packing = dbo.item.packingdesc,
		 manufacurer = (dbo.manufacturer.name),
		 looseqty = Sum (sd.looseqty),
		 price = max(sd.saleprice),
		 utn = max(sd.saleutn)
FROM 	 dbo.saleledger, 
		 dbo.saleinvdetail sd,    
		 dbo.item, 
		 dbo.Customer,
		 dbo.Accounts,
		 dbo.Manufacturer 
WHERE  DBO.SaleLedger.impactinventory = 'N' AND
		 :as_doctype = 'billingdate' AND
		 dbo.saleledger.billingdate >= :ad_StartDate AND
		 dbo.saleledger.billingdate <= :ad_EndDate  AND 
		 dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = sd.saleinvcode AND
		 sd.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode AND
		 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
		sd.icode,
		dbo.item.name,
		dbo.item.packingdesc,
		dbo.manufacturer.name
UNION
SELECT 
		 grouping=1,
		 itemname = item.name,
		 packing = dbo.item.packingdesc,
		 manufacurer = (dbo.manufacturer.name),
		 looseqty = Sum (dbo.saledetail.looseqty),
		 price = max(dbo.saledetail.saleprice),
		 utn = max(dbo.saledetail.saleutn)
FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item, 
		 dbo.Customer,
		 dbo.Accounts,
		 dbo.Manufacturer 
WHERE  
		 :as_doctype = 'lastsavingdate' AND
		 dbo.saleledger.date >= :ad_StartDate AND
		 dbo.saleledger.date <= :ad_EndDate  AND 
		 dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		 dbo.saledetail.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode AND
		 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
		dbo.saledetail.icode,
		dbo.item.name,
		dbo.item.packingdesc,
		dbo.manufacturer.name
UNION ALL
SELECT 
		 grouping=1,
		 itemname = item.name,
		 packing = dbo.item.packingdesc,
		 manufacurer = (dbo.manufacturer.name),
		 looseqty = Sum (sd.looseqty),
		 price = max(sd.saleprice),
		 utn = max(sd.saleutn)
FROM 	 dbo.saleledger, 
		 dbo.saleinvdetail sd,    
		 dbo.item, 
		 dbo.Customer,
		 dbo.Accounts,
		 dbo.Manufacturer 
WHERE  DBO.SaleLedger.impactinventory = 'N' AND
		 :as_doctype = 'lastsavingdate' AND
		 dbo.saleledger.date >= :ad_StartDate AND
		 dbo.saleledger.date <= :ad_EndDate  AND 
		 dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = sd.saleinvcode AND
		 sd.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode AND
		 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
		sd.icode,
		dbo.item.name,
		dbo.item.packingdesc,
		dbo.manufacturer.name
ORDER BY 
		dbo.item.name"
  arguments=(("as_CustCode", string), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_city", string), ("as_doctype", string), ("as_custrefno", string), ("as_customercp", string), ("as_line1", string), ("as_line2", string), ("ad_lestamt", number))
 sort="grouping A, itemname A"
)
