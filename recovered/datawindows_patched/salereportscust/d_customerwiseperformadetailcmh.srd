compute(name=c_amount visible="1" band=detail font.charset="0" font.face="Times New Roman" font.family="1" font.height="-11" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="6041" y="21" height="145" width="947" format="###,###,###,##0.00" expression="Round(((  looseqty   *  price  ) - (looseqty  *  itemflatdisc)) *  ( 1 -  (    itemdiscperc * .01 ) )  -  (  salestax   *  looseqty )  , 2)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
