release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=724 color="536870912" )
summary(height=152 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=icode dbname="Item.icode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Item.name"  )
column=(type=decimal(3) updatewhereclause=yes name=packingfactor dbname="packingfactor"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="salaeqty"  )
column=(type=decimal(4) updatewhereclause=yes name=salebonus dbname="salebonus"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="salevalue"  )
column=(type=decimal(4) updatewhereclause=yes name=saleretqty dbname="saleretqty"  )
column=(type=decimal(4) updatewhereclause=yes name=retbonus dbname="retbonus"  )
column=(type=decimal(6) updatewhereclause=yes name=saleretvalue dbname="saleretvalue"  )
column=(type=decimal(4) updatewhereclause=yes name=netqty dbname="netqty"  )
column=(type=decimal(6) updatewhereclause=yes name=netvalue dbname="netvalue"  )
 retrieve="SELECT item.icode,  
		 item.name,
		packingfactor=item.packingfactor,
		 customer=(select accounts.name from accounts where acccode=:ai_custcode),
		 salaeqty=ISNULL((select sum(saledetail.looseqty) 
                 from saledetail,saleledger
					  where saleledger.custcode=:ai_custcode and
							 saleledger.date between :ad_sdate and :ad_ldate and
							 saleledger.saleinvcode=saledetail.saleinvcode and
							 saledetail.icode=item.icode
						),0) +
					ISNULL((select sum(saledetail.looseqty) 
                 from saleinvdetail saledetail, saleledger
					  where saleledger.custcode=:ai_custcode and
							 SaleLedger.impactinventory = 'N' AND 
							 saleledger.date between :ad_sdate and :ad_ldate and
							 saleledger.saleinvcode=saledetail.saleinvcode and
							 saledetail.icode=item.icode),0),
		salebonus=ISNULL((select sum(saledetail.bonusqty) 
                 from saledetail,saleledger
					  where saleledger.custcode=:ai_custcode and
							 saleledger.date between :ad_sdate and :ad_ldate and
							 saleledger.saleinvcode=saledetail.saleinvcode and
							 saledetail.icode=item.icode
						),0) +
					ISNULL((select sum(saledetail.bonusqty) 
                 from saleinvdetail saledetail, saleledger
					  where saleledger.custcode=:ai_custcode and
							 SaleLedger.impactinventory = 'N' AND 
							 saleledger.date between :ad_sdate and :ad_ldate and
							 saleledger.saleinvcode=saledetail.saleinvcode and
							 saledetail.icode=item.icode),0),
		salevalue=ISNUll((select IsNull( sum(Round(((saledetail.looseqty + saledetail.packqty * saledetail.packunits) * (saledetail.saleprice - saledetail.itemflatdisc)),2) * (1 - (.01 * saledetail.discperc)) * (1- (.01 * saleledger.discperc))) ,0) 
						from saledetail,saleledger
					  where saleledger.custcode=:ai_custcode and
							 saleledger.date between :ad_sdate and :ad_ldate and
							 saleledger.saleinvcode=saledetail.saleinvcode and
							 saledetail.icode=item.icode),0) + 
					ISNUll((select IsNull( sum(Round(((saledetail.looseqty) * (saledetail.saleprice - saledetail.itemflatdisc)),2) * (1 - (.01 * saledetail.discperc)) * (1- (.01 * saleledger.discperc))) ,0)
                 from saleinvdetail saledetail, saleledger
					  where saleledger.custcode=:ai_custcode and
							 SaleLedger.impactinventory = 'N' AND 
							 saleledger.date between :ad_sdate and :ad_ldate and
							 saleledger.saleinvcode=saledetail.saleinvcode and
							 saledetail.icode=item.icode
						),0),

		saleretqty=ISNULL((select sum(srdetail.looseqty) 
                 from srdetail,srledger
					  where srledger.custcode=:ai_custcode and
							 srledger.date between :ad_sdate and :ad_ldate and
							 srledger.srinvcode=srdetail.srinvcode and
							 srdetail.icode=item.icode
						),0),
		retbonus=ISNULL((select sum(srdetail.bonusqty) 
                 from srdetail,srledger
					  where srledger.custcode=:ai_custcode and
							 srledger.date between :ad_sdate and :ad_ldate and
							 srledger.srinvcode=srdetail.srinvcode and
							 srdetail.icode=item.icode
						),0),

	  saleretvalue=ISNULL((select IsNull( sum(Round(((srdetail.looseqty + srdetail.packqty * srdetail.packunits) * srdetail.srprice) * (1 - (.01 * srdetail.discperc)),2) * (1- (.01 * srledger.discperc))) ,0) from srdetail,srledger
					  where srledger.custcode=:ai_custcode and
							 srledger.date between :ad_sdate and :ad_ldate and
							 srledger.srinvcode=srdetail.srinvcode and
							 srdetail.icode=item.icode),0),

			 netqty=ISNULL((select sum(saledetail.looseqty) 
                 from saledetail,saleledger
					  where saleledger.custcode=:ai_custcode and
							 saleledger.date between :ad_sdate and :ad_ldate and
							 saleledger.saleinvcode=saledetail.saleinvcode and
							 saledetail.icode=item.icode
						) ,0) +

					ISNULL((select sum(saledetail.looseqty) 
                 from saleinvdetail saledetail, saleledger
					  where saleledger.custcode=:ai_custcode and
							 SaleLedger.impactinventory = 'N' AND 
							 saleledger.date between :ad_sdate and :ad_ldate and
							 saleledger.saleinvcode=saledetail.saleinvcode and
							 saledetail.icode=item.icode
						),0)
						-
		
						ISNULL((select sum(srdetail.looseqty) 
                 	 from srdetail,srledger
					  	 where srledger.custcode=:ai_custcode and
							 srledger.date between :ad_sdate and :ad_ldate and
							 srledger.srinvcode=srdetail.srinvcode and
							 srdetail.icode=item.icode
						),0),
		netvalue=ISNUll((select IsNull( sum(Round(((saledetail.looseqty + saledetail.packqty * saledetail.packunits) * (saledetail.saleprice - saledetail.itemflatdisc)),2) * (1 - (.01 * saledetail.discperc)) * (1- (.01 * saleledger.discperc))) ,0) 
						from saledetail,saleledger
					  where saleledger.custcode=:ai_custcode and
							 saleledger.date between :ad_sdate and :ad_ldate and
							 saleledger.saleinvcode=saledetail.saleinvcode and
							 saledetail.icode=item.icode),0) + 
					ISNUll((select IsNull( sum(Round(((saledetail.looseqty) * (saledetail.saleprice - saledetail.itemflatdisc)),2) * (1 - (.01 * saledetail.discperc)) * (1- (.01 * saleledger.discperc))) ,0)
                 from saleinvdetail saledetail, saleledger
					  where saleledger.custcode=:ai_custcode and
							 SaleLedger.impactinventory = 'N' AND 
							 saleledger.date between :ad_sdate and :ad_ldate and
							 saleledger.saleinvcode=saledetail.saleinvcode and
							 saledetail.icode=item.icode
						),0) -
					
					ISNULL((select IsNull( sum(Round(((srdetail.looseqty + srdetail.packqty * srdetail.packunits) * srdetail.srprice) * (1 - (.01 * srdetail.discperc)),2) * (1- (.01 * srledger.discperc))) ,0) 
						from srdetail,srledger
						where srledger.custcode=:ai_custcode and
							 srledger.date between :ad_sdate and :ad_ldate and
							 srledger.srinvcode=srdetail.srinvcode and
							 srdetail.icode=item.icode),0)
FROM item
ORDER BY item.name"
  update="item" updatewhere=0 updatekeyinplace=no
  arguments=(("ad_SDate", datetime), ("ad_lDate", datetime), ("ai_custcode", number))
)
