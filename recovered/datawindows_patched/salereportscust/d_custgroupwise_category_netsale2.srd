table(column=(type=char(100) updatewhereclause=yes name=customergroup dbname="CustomerGroup"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=custname dbname="Accounts.Name"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="ItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=icatcode dbname="ItemCategory.Icatcode"  )
column=(type=char(60) updatewhereclause=yes name=categoryname dbname="ItemCategory.Name"  )
column=(type=long updatewhereclause=yes name=iccode dbname="Iccode"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="Class"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(60) updatewhereclause=yes name=saleman dbname="SaleMan"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(4) updatewhereclause=yes name=returnqty dbname="returnqty"  )
column=(type=decimal(6) updatewhereclause=yes name=grossvalue dbname="grossvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=discvalue dbname="discvalue"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="salevalue"  )
column=(type=decimal(6) updatewhereclause=yes name=returnval dbname="returnval"  )
 retrieve="SELECT  
	CustomerGroup = (SELECT CG.Name FROM CustomerGroup CG WHERE CG.CustomerGroupCode=:ar_custgroupcode),
	AliasName=Acc.AliasName,
	Acc.Name, 
	ICode = I.ICode,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	IC.Icatcode, 
	Ic.Name,
	Iccode=ICL.Iccode, 
	Class=ICL.Name,
	Packing = IP.Name,
	SaleMan = CASE :ar_smancode WHEN -1 THEN 'ALL SALES PERSON' ELSE (SELECT SM.Name FROM SalesMan SM WHERE SM.SalesManCode = :ar_smancode) END,

	saleqty=sum( (CASE P.TYPE WHEN 'S' then qty ELSE 0 END)),
	returnqty=sum( (CASE P.TYPE WHEN 'R' then qty ELSE 0 END)),

	grossvalue = ROUND(SUM(
		CASE P.TYPE WHEN 'S' THEN
			P.grossvalue
		ELSE 0 END), 0),
	discvalue = ROUND ( SUM ( 
		CASE P.TYPE WHEN 'S' THEN
			ISNULL(P.itemdiscvalue,0) + ISNULL(P.invitemdiscvalue,0) +
									ISNULL(P.flatdisc,0) * ( ISNULL(P.itemvalue,0) /
									CASE ISNULL(P.grossamt,0) WHEN 0 THEN 1 
									ELSE ISNULL(P.grossamt,0) END)
		ELSE 0 END), 0),
	salevalue=ROUND(SUM(
		CASE P.TYPE WHEN 'S' THEN
			ISNULL(P.itemvalue,0) - (ISNULL(P.flatdisc,0) *(ISNULL(P.itemvalue,0) /
			CASE ISNULL(P.grossamt,0) WHEN 0 THEN 1 
			ELSE ISNULL(P.grossamt,0) END))
		ELSE 0 END), 0),
	returnval=ROUND(SUM(
		CASE P.TYPE WHEN 'R' THEN
			ISNULL(P.itemvalue,0) - (ISNULL(P.flatdisc,0) * (ISNULL(P.itemvalue,0) /
				CASE ISNULL(P.grossamt,0) WHEN 0 THEN 1 
				ELSE ISNULL(P.grossamt,0) END)) 
		ELSE 0 END), 0)
FROM 
(
SELECT
	saleledger.saleinvcode,
	saledetail.icode,
	qty=SUM(saledetail.looseqty),
	GrossValue = SUM(saledetail.looseqty * saledetail.saleprice ) ,
	ItemDiscValue = SUM((saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc))*
						 (.01 * saledetail.discperc) + saledetail.itemflatdisc ),
	InvItemDiscValue = SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*
							(1 - (.01 * saledetail.discperc) ) *  (.01 * saleledger.discperc) ),
	ItemValue=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*
		(1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),
	GrossAmt=
		(SELECT SUM((sd.looseqty*(sd.saleprice - sd.itemflatdisc)) *
			(1 - (.01 * sd.discperc)) * (1- (.01 * sl.discperc)))
		FROM	saledetail sd, saleledger sl
		WHERE sl.saleinvcode=saleledger.saleinvcode and sl.saleinvcode=sd.saleinvcode
		GROUP BY sl.saleinvcode),
	saleledger.flatdisc,
	catcode=saleledger.salecatcode,
	type='S',
	custcode = saleledger.custcode

FROM
	saleledger,	 
	saledetail

WHERE
	saleledger.saleinvcode = saledetail.saleinvcode AND 
	saleledger.date >= :ar_startdate AND saleledger.date <= :ar_enddate AND 
	saleledger.custcode IN (SELECT CustCode FROM CustomerGroupDetail WHERE CustomerGroupCode=:ar_custgroupcode) AND
	ISNULL(saleledger.smancode, -1) = ISNULL(CASE :ar_smancode WHEN -1 THEN saleledger.smancode ELSE :ar_smancode END, -1) 

GROUP BY 
	 saleledger.saleinvcode,
	 saledetail.icode,
	 saleledger.custcode,
	 saleledger.salecatcode,
	 saleledger.discperc,
	 saleledger.flatdisc,
	 saleledger.invgstperc1,
	 saleledger.salecatcode
UNION ALL
SELECT
	saleledger.saleinvcode,
	saledetail.icode,
	qty=sum(saledetail.looseqty),
	GrossValue = SUM(saledetail.looseqty * saledetail.saleprice ) ,
	ItemDiscValue = SUM((saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc))*
						 (.01 * saledetail.discperc) + saledetail.itemflatdisc ),
	InvItemDiscValue = SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*
							(1 - (.01 * saledetail.discperc) ) *  (.01 * saleledger.discperc) ),
	ItemValue=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*
		(1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),
	GrossAmt=
		(SELECT SUM((sd.looseqty*(sd.saleprice - sd.itemflatdisc)) *
			(1 - (.01 * sd.discperc)) * (1- (.01 * sl.discperc)))
		FROM	saledetail sd, saleledger sl
		WHERE sl.saleinvcode=saleledger.saleinvcode and sl.saleinvcode=sd.saleinvcode
		GROUP BY sl.saleinvcode),
	saleledger.flatdisc,
	catcode=saleledger.salecatcode,
	type='S',
	custcode = saleledger.custcode

FROM
	saleledger,	 
	saleinvdetail saledetail

WHERE
	SaleLedger.impactinventory = 'N' AND
	saleledger.saleinvcode = saledetail.saleinvcode AND 
	saleledger.date >= :ar_startdate AND saleledger.date <= :ar_enddate AND 
	saleledger.custcode IN (SELECT CustCode FROM CustomerGroupDetail WHERE CustomerGroupCode=:ar_custgroupcode) AND
	ISNULL(saleledger.smancode, -1) = ISNULL(CASE :ar_smancode WHEN -1 THEN saleledger.smancode ELSE :ar_smancode END, -1)

GROUP BY 
	 saleledger.saleinvcode,
	 saledetail.icode,
	 saleledger.custcode,
	 saleledger.salecatcode,
	 saleledger.discperc,
	 saleledger.flatdisc,
	 saleledger.invgstperc1,
	 saleledger.salecatcode
UNION ALL
SELECT
	srledger.srinvcode,
	srdetail.icode,
	qty=sum(srdetail.looseqty),
	GrossValue = SUM( srdetail.looseqty * srdetail.srprice ) ,
	ItemDiscValue = SUM((srdetail.looseqty * srdetail.srprice ) * (.01 * srdetail.discperc) ),
	InvItemDiscValue = SUM( ( (srdetail.looseqty * srdetail.srprice) *
								(1 - (.01 * srdetail.discperc) ) ) * (.01 * srledger.discperc) ),
	ItemValue=SUM((srdetail.looseqty * srdetail.srprice *
		(1 - (.01 * srdetail.discperc))) * (1 - (.01 * srledger.discperc))),
	GrossAmt=(SELECT SUM((sd.looseqty * sd.srprice *
			(1 - (.01 * sd.discperc))) * (1- (.01 * sl.discperc)))
		FROM	srdetail sd, srledger sl
		WHERE sl.srinvcode=srledger.srinvcode and sl.srinvcode=sd.srinvcode
		GROUP BY sl.srinvcode),
	srledger.flatdisc,
	catcode=srledger.srcatcode,
	type='R',
	custcode = srledger.custcode

FROM
	srledger,	 
	srdetail

WHERE
   srledger.srinvcode = srdetail.srinvcode  AND 
	srledger.date >= :ar_startdate AND srledger.date <= :ar_enddate AND 
	srledger.custcode IN (SELECT CustCode FROM CustomerGroupDetail WHERE CustomerGroupCode=:ar_custgroupcode) AND
	ISNULL(srledger.smancode, -1) = ISNULL(CASE :ar_smancode WHEN -1 THEN srledger.smancode ELSE :ar_smancode END, -1)

GROUP BY
	 srledger.srinvcode,
	 srdetail.icode,
	 srledger.custcode,
	 srledger.srcatcode,
	 srledger.discperc,
	 srledger.flatdisc,
	 srledger.invgstperc1,
	 srledger.srcatcode
UNION ALL
SELECT
	saleledger.saleinvcode,
	saledetail.icode,
	qty=SUM(saledetail.looseqty),
	GrossValue = SUM(saledetail.looseqty * saledetail.saleprice ) ,
	ItemDiscValue = SUM((saledetail.looseqty * (saledetail.saleprice - saledetail.itemflatdisc))*
						 (.01 * saledetail.discperc) + saledetail.itemflatdisc ),
	InvItemDiscValue = SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*
							(1 - (.01 * saledetail.discperc) ) *  (.01 * saleledger.discperc) ),
	ItemValue=SUM((saledetail.looseqty*(saledetail.saleprice - saledetail.itemflatdisc))*
		(1 - (.01 * saledetail.discperc))) * (1 - (.01 * saleledger.discperc)),
	GrossAmt=
		(SELECT SUM((sd.looseqty*(sd.saleprice - sd.itemflatdisc)) *
			(1 - (.01 * sd.discperc)) * (1- (.01 * sl.discperc)))
		FROM	saledetail sd, saleledger sl
		WHERE sl.saleinvcode=saleledger.saleinvcode and sl.saleinvcode=sd.saleinvcode
		GROUP BY sl.saleinvcode),
	saleledger.flatdisc,
	catcode=saleledger.salecatcode,
	type='S',
	custcode = saleledger.custcode
FROM
	crs_saleledger saleledger,	 
	crs_saledetail saledetail

WHERE
	saleledger.clientinstanceid = saledetail.clientinstanceid AND
	saleledger.saleinvcode = saledetail.saleinvcode AND 
	saleledger.date >= :ar_startdate AND saleledger.date <= :ar_enddate AND 
	saleledger.custcode IN (SELECT CustCode FROM CustomerGroupDetail WHERE CustomerGroupCode=:ar_custgroupcode) AND
	ISNULL(saleledger.smancode, -1) = ISNULL(CASE :ar_smancode WHEN -1 THEN saleledger.smancode ELSE :ar_smancode END, -1) 

GROUP BY 
	 saleledger.clientinstanceid,
	 saleledger.saleinvcode,
	 saledetail.icode,
	 saleledger.custcode,
	 saleledger.salecatcode,
	 saleledger.discperc,
	 saleledger.flatdisc,
	 saleledger.invgstperc1,
	 saleledger.salecatcode
UNION ALL
SELECT
	srledger.srinvcode,
	srdetail.icode,
	qty=sum(srdetail.looseqty),
	GrossValue = SUM( srdetail.looseqty * srdetail.srprice ) ,
	ItemDiscValue = SUM((srdetail.looseqty * srdetail.srprice ) * (.01 * srdetail.discperc) ),
	InvItemDiscValue = SUM( ( (srdetail.looseqty * srdetail.srprice) *
								(1 - (.01 * srdetail.discperc) ) ) * (.01 * srledger.discperc) ),
	ItemValue=SUM((srdetail.looseqty * srdetail.srprice *
		(1 - (.01 * srdetail.discperc))) * (1 - (.01 * srledger.discperc))),
	GrossAmt=(SELECT SUM((sd.looseqty * sd.srprice *
			(1 - (.01 * sd.discperc))) * (1- (.01 * sl.discperc)))
		FROM	srdetail sd, srledger sl
		WHERE sl.srinvcode=srledger.srinvcode and sl.srinvcode=sd.srinvcode
		GROUP BY sl.srinvcode),
	srledger.flatdisc,
	catcode=srledger.srcatcode,
	type='R',
	custcode = srledger.custcode

FROM
	crs_srledger srledger,	 
	crs_srdetail srdetail

WHERE
	srledger.clientinstanceid = srdetail.clientinstanceid AND
	srledger.srinvcode = srdetail.srinvcode  AND 
	srledger.date >= :ar_startdate AND srledger.date <= :ar_enddate AND 
	srledger.custcode IN (SELECT CustCode FROM CustomerGroupDetail WHERE CustomerGroupCode=:ar_custgroupcode) AND
	ISNULL(srledger.smancode, -1) = ISNULL(CASE :ar_smancode WHEN -1 THEN srledger.smancode ELSE :ar_smancode END, -1)

GROUP BY
	 srledger.clientinstanceid,
	 srledger.srinvcode,
	 srdetail.icode,
	 srledger.custcode,
	 srledger.srcatcode,
	 srledger.discperc,
	 srledger.flatdisc,
	 srledger.invgstperc1,
	 srledger.srcatcode) P,
	ItemCategory IC, Item I, Accounts Acc, ItemClass ICL, ItemPacking IP
WHERE
	P.custcode = Acc.Acccode AND
	P.Icode = I.Icode AND 
	I.ICatCode = IC.ICatCode AND
	I.ICCode = ICL.ICCode AND
	I.PackCode = IP.PackCode
GROUP BY 
	Acc.AccCode,
	Acc.AliasName,
	Acc.Name,
	IC.Icatcode, 
	Ic.Name,
	ICL.Iccode,
	ICL.Name,
	IP.Name,
	I.ICode,
	I.CustomICode,
	I.Name
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("ar_custgroupcode", number), ("ar_smancode", number))
 sort="custname A, categoryname A"
)
group(level=1 header.height=183 trailer.height=200 by=("custname"  ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.length="100" header.gradient.repetition.count="0" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.length="100" trailer.gradient.repetition.count="0" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" )
