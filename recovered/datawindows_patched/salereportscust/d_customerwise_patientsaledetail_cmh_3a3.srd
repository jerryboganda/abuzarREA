header(height=1833 color="536870912" )
summary(height=0 color="536870912" )
footer(height=270 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(60) updatewhereclause=yes name=contactperson dbname="contactperson"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=char(30) updatewhereclause=yes name=formno dbname="formno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(100) updatewhereclause=yes name=patient dbname="patient"  )
column=(type=char(30) updatewhereclause=yes name=disease dbname="disease"  )
column=(type=char(100) updatewhereclause=yes name=ward dbname="ward"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="doctor"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=issue dbname="issue"  )
column=(type=decimal(6) updatewhereclause=yes name=cost dbname="cost"  )
column=(type=decimal(2) updatewhereclause=yes name=cumulativesum dbname="cumulativesum"  )
column=(type=decimal(2) updatewhereclause=yes name=cumulativesumfoot dbname="cumulativesumfoot"  )
 retrieve="SELECT invcode = dbo.saleledger.saleinvcode,
		 customer = dbo.accounts.name,
		 contactperson=(dbo.customer.cp), 
		 address = (dbo.customer.address1),
		 city = (dbo.customer.city), 
		 formno = dbo.saleledger.custrefno,
		 date = dbo.saleledger.originaldate,
		 /*regno = dbo.patient.regno,*/
		 patient = saleledger.remarks, 
		 disease = saleledger.custrefno ,
       ward = saleledger.custrefno2,
		 doctor = dbo.doctors.name,
		 itemname = item.name,
		 looseqty = dbo.saledetail.looseqty,
		 issue=saledetail.looseqty,
		 cost=saledetail.looseqty*saledetail.saleprice,
 		 cumulativesum = round(0.00,2),
 		 cumulativesumfoot = round(0.00,2)
FROM 	
	dbo.saleledger
	LEFT OUTER JOIN dbo.doctors ON (dbo.saleledger.doctcode = dbo.doctors.doctcode),
	dbo.saledetail,    
	dbo.item, 
	dbo.Customer,
	/*dbo.Patient,*/
	dbo.Accounts

WHERE  dbo.saleledger.originaldate >= :ad_startdate AND
		 dbo.saleledger.originaldate <= :ad_enddate  AND 
		 dbo.saleledger.custcode  IN ( :al_custcode ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		 dbo.saledetail.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode/* AND
		 dbo.saleledger.patientcode = dbo.patient.patientcode*/

UNION ALL

SELECT invcode = dbo.saleledger.saleinvcode,
		 customer = dbo.accounts.name,
		 contactperson=(dbo.customer.cp), 
		 address = (dbo.customer.address1),
		 city = (dbo.customer.city), 
		 formno = dbo.saleledger.custrefno,
		 date = dbo.saleledger.originaldate,
		/* regno = dbo.patient.regno,*/
		 patient = saleledger.remarks,
		 disease = saleledger.custrefno ,
       ward = saleledger.custrefno2,
		 doctor = dbo.doctors.name,
		 itemname = item.name,
		 looseqty = sd.looseqty,
		issue=sd.looseqty,
		 cost=sd.looseqty*sd.saleprice,
 		 cumulativesum = round(0.00,2),
 		 cumulativesumfoot = round(0.00,2)
FROM 	 
	dbo.saleledger
	LEFT OUTER JOIN dbo.doctors ON (dbo.saleledger.doctcode = dbo.doctors.doctcode),
	dbo.saleinvdetail sd, 
	dbo.item, 
	dbo.Customer,
	/*dbo.Patient,*/
	dbo.Accounts

WHERE  DBO.SaleLedger.impactinventory = 'N' AND
		 dbo.saleledger.originaldate >= :ad_startdate AND
		 dbo.saleledger.originaldate <= :ad_enddate  AND 
		 dbo.saleledger.custcode  IN ( :al_custcode ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = sd.saleinvcode AND
		 sd.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode /*AND
		 dbo.saleledger.patientcode = dbo.patient.patientcode*/
"
  arguments=(("al_CustCode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime))
 sort="invcode A"
)
