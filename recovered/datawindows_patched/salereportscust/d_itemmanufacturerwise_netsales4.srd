release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=200 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1479 color="536870912" )
summary(height=437 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=manfcode dbname="Item.ManfCode"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=long updatewhereclause=yes name=icode dbname="Item.ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=decimal(2) updatewhereclause=yes name=currentsaleprice dbname="CurrentSalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=currentpurprice dbname="CurrentPurPrice"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=grosssales dbname="GrossSales"  )
column=(type=decimal(6) updatewhereclause=yes name=saleamount dbname="SaleAmount"  )
column=(type=decimal(9) updatewhereclause=yes name=itemcost dbname="ItemCost"  )
column=(type=decimal(6) updatewhereclause=yes name=margin dbname="Margin"  )
column=(type=decimal(6) updatewhereclause=yes name=marginoncost dbname="MarginonCost"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
 retrieve="SELECT
	I.ManfCode,
	Manufacturer=M.Name,
	I.ICode,
	ItemName=I.Name,
	PackUnits=I.PackUnits,
	CurrentSalePrice = CASE When Sum(D.SaleQty) > 0 Then Max(I.SalePrice) Else 0 End,
	CurrentPurPrice = CASE When Sum(D.SaleQty) > 0 Then Max(I.PurPrice) Else 0 End,
	Qty=ISNULL(sum(D.saleqty),0),
	GrossSales = ISNULL(sum(D.GrossSales), 0),
	SaleAmount=ISNULL(sum(D.salevalue), 0),
	ItemCost=ISNULL(sum(D.itemcost), 0),
	Margin=ISNULL((sum(D.salevalue) - sum(D.itemcost) ) / 
			Case sum(D.salevalue) WHEN 0 THEN 1 ELSE sum(D.salevalue) END, 0) * 100,
	MarginonCost=ISNULL((sum(D.salevalue) - sum(D.itemcost) ) / 
			Case sum(D.itemcost) WHEN 0 THEN 1 ELSE sum(D.itemcost) END, 0) * 100,
	Bonus=ISNULL(sum(D.bonus),0)
FROM
	Manufacturer M,
	Item I LEFT OUTER JOIN 
	(SELECT saleqty=ISNULL(sum(SD.looseqty),0) ,
				bonus=ISNULL(sum(SD.bonusqty),0) ,
				GrossSales = IsNull( Sum ( SD.Rate * SD.looseqty) , 0 ),
				salevalue=ISNULL(round(sum((SD.looseqty * (SD.saleprice - itemflatdisc)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01),2),0),
	        	I.ICode,
	        	itemcost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)),2),0)
	FROM		saleledger SL,
				saledetail SD,
				item I
	WHERE		SD.icode=I.icode AND
				I.manfcode IN (:ala_manfcode) AND
				SD.saleinvcode=SL.saleinvcode AND
				SL.salecatcode IN (:aa_salecatcode) and
				SL.date BETWEEN :adt_sdate AND :adt_ldate
	GROUP BY 
	         SD.icode,
		 		I.ICode,
	         SL.saleinvcode,
	         SL.discperc
	UNION ALL
	SELECT saleqty=ISNULL(sum(SD.looseqty),0) ,
				bonus=ISNULL(sum(SD.bonusqty),0) ,
				GrossSales = IsNull( Sum ( SD.Rate * SD.looseqty) , 0 ),
				salevalue=ISNULL(round(sum((SD.looseqty * (SD.saleprice - itemflatdisc)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01),2),0),
	        	I.ICode,
	        	itemcost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)),2),0)
	FROM		saleledger SL,
				saleinvdetail SD,
				item I
	WHERE		SL.ImpactInventory ='N' AND 
				SD.icode=I.icode AND
				I.manfcode IN (:ala_manfcode) AND
				SD.saleinvcode=SL.saleinvcode AND
				SL.salecatcode IN (:aa_salecatcode) and
				SL.date BETWEEN :adt_sdate AND :adt_ldate
	GROUP BY 
	         SD.icode,
		 		I.ICode,
	         SL.saleinvcode,
	         SL.discperc
	UNION ALL
	SELECT	saleqty=-ISNULL(sum(SD.looseqty),0) ,
				bonus=-ISNULL(sum(SD.bonusqty),0) ,
				GrossSales = -1 * ( IsNull ( Sum ( SD.SalePrice * SD.LooseQty) , 0 )  ),
				salevalue=-ISNULL(round(sum((SD.looseqty * (SD.srprice)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01),2),0),
				I.ICode,
				itemcost=-ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)),2),0)
	FROM		srledger SL,
				srdetail SD,
				item I
	WHERE		SD.icode=I.icode AND
				I.manfcode IN (:ala_manfcode) AND
				SD.srinvcode=SL.srinvcode AND
				SL.srcatcode IN (:aa_srcatcode) AND
				SL.date BETWEEN :adt_sdate AND :adt_ldate
	GROUP BY
				SD.icode,
				I.ICode,
				SL.srinvcode,
				SL.discperc) AS D ON (I.ICode = D.ICode)
	WHERE 
			I.manfcode IN (:ala_manfcode) AND
			I.ManfCode = M.ManfCode
	GROUP BY
		I.ManfCode,
		M.Name,
		I.ICode,
		I.name,
		I.PackUnits
ORDER BY
	M.Name,
	I.name
"
  arguments=(("ala_manfcode", numberlist), ("adt_SDate", datetime), ("adt_LDate", datetime), ("aa_salecatcode", numberlist), ("aa_srcatcode", numberlist))
)
