table(column=(type=char(20) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(20) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(20) updatewhereclause=yes name=area dbname="area"  )
column=(type=number updatewhereclause=yes name=qty dbname="qty"  )
 retrieve="SELECT 
	Area = AR.Name,
	Customer = A.Name,
	ItemName = I.Name,
	Date = S.Date,
	Qty = SUM(S.Qty),
	Value = SUM(S.Value)
FROM
	Customer C,
	Area AR,
	Accounts A,
	Item I,
	(SELECT SD.ICode, 
		SL.CustCode, 
		Date = CAST(STR(DATEPART(mm, SL.Date)) +'-01-' +STR(DATEPART(yy, SL.Date)) AS DATETIME),
		Qty = SUM(SD.LooseQty + SD.BonusQty), 
		Value = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))
	FROM 
		SaleLedger SL, SaleDetail SD
	WHERE
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.CustCode IN (SELECT CustCode FROM Customer WHERE AreaCode IN (:ai_areacode)) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		(SD.ICode IN (:ai_icode) OR :ai_item_one_or_all=1)
	GROUP BY
		SD.ICode, SL.CustCode, SL.Date
	UNION ALL
	SELECT 
		SD.ICode,
		SL.CustCode, 
		Date = CAST(STR(DATEPART(mm, SL.Date)) +'-01-' +STR(DATEPART(yy, SL.Date)) AS DATETIME),
		Qty = -SUM(SD.LooseQty + SD.BonusQty), 
		Value = -SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01))
	FROM 
		SRLedger SL, SRDetail SD
	WHERE
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.CustCode IN (SELECT CustCode FROM Customer WHERE AreaCode IN (:ai_areacode)) AND
		SL.SRInvCode = SD.SRInvCode AND
		(SD.ICode IN (:ai_icode) OR :ai_item_one_or_all=1)
	GROUP BY
		SD.ICode, SL.CustCode, SL.Date) S
WHERE
	I.ICode = S.ICode AND
	A.AccCode = S.CustCode AND
	A.AccCode = C.CustCode AND
	C.AreaCode = AR.AreaCode
GROUP BY
	I.ICode,
	I.Name,
	AR.Name,
	A.AccCode,
	A.Name,
	S.Date
ORDER BY
	Area,
	Customer,
	ItemName"
  arguments=(("ai_areacode", numberlist), ("ai_icode", numberlist), ("ai_item_one_or_all", number), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="itemname A, customer A, area A"
)
