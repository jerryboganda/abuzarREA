release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=1072 color="536870912" )
header[2](height=364 color="536870912" )
summary(height=197 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=customeralias dbname="customeralias"  )
column=(type=char(20) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(20) updatewhereclause=yes name=address dbname="address"  )
column=(type=number updatewhereclause=yes name=netamount dbname="netamount"  )
 retrieve="SELECT
	CustomerAlias=(Select Ac.AliasName FROM accounts Ac Where Ac.Acccode = A.CustCode),
	customer=(Select Ac.Name FROM accounts Ac Where Ac.Acccode = A.CustCode),
	Address=(Select RTRIM(LTRIM(C.Address1)) + ' ' + RTRIM(LTRIM(C.Address2)) FROM Customer C Where C.CustCode = A.CustCode),
	City=(Select C.CITY FROM Customer C Where C.CustCode = A.CustCode),
	GroupName=
		CASE :as_reportgrouping 
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,   
	netamount=Sum(A.amount)
FROM
	Item I,
	(SELECT	
		dbo.customer.custcode,
		icode=Null,
		amount   = 0.00
	FROM dbo.customer
	WHERE dbo.customer.custcode IN (:ll_custcode) 
	UNION ALL
	SELECT	
		dbo.saleledger.custcode,
		dbo.saledetail.icode,
		amount   = Round(Sum ( saledetail.looseqty * 
										(saledetail.saleprice - saledetail.itemflatdisc) * 
										(1 - saledetail.discperc * 0.01)), 2)
	FROM dbo.saleledger, dbo.saledetail, dbo.item
	WHERE dbo.saleledger.date BETWEEN :ad_StartDate and :ad_EndDate and
	 	dbo.saleledger.custcode IN (:ll_custcode) and
	 	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and  
		CASE :as_reportgrouping
		WHEN 'M' THEN dbo.item.manfcode
		WHEN 'C' THEN dbo.item.ICatCode
		WHEN 'L' THEN dbo.item.ICCode
		ELSE dbo.item.PACKCODE END IN (:ll_groupcode) and
	 	dbo.saledetail.icode = item.icode AND
		dbo.saledetail.gcode = case :as_AllGodown WHEN 'Y' THEN dbo.saledetail.gcode ELSE :ai_gcode end
	GROUP BY
		dbo.saleledger.custcode,
		saledetail.icode
	UNION ALL
	SELECT	
		dbo.saleledger.custcode,
		sd.icode,
		amount   = Round(Sum ( (sd.looseqty) * 
										(sd.saleprice - sd.itemflatdisc) * 
										(1 - sd.discperc * 0.01)), 2)
	FROM 	dbo.saleledger, 
	 	dbo.saleinvdetail sd, 
	 	dbo.item
	WHERE	dbo.saleledger.impactinventory = 'N' AND
		dbo.saleledger.date BETWEEN :ad_StartDate and :ad_EndDate  and
	 	dbo.saleledger.custcode IN (:ll_custcode) and
	 	dbo.saleledger.saleinvcode = sd.saleinvcode and  
		CASE :as_reportgrouping
		WHEN 'M' THEN dbo.item.manfcode
		WHEN 'C' THEN dbo.item.ICatCode
		WHEN 'L' THEN dbo.item.ICCode
		ELSE dbo.item.PACKCODE END IN (:ll_groupcode) and
	 	sd.icode = item.icode AND
		sd.gcode = case :as_AllGodown WHEN 'Y' THEN sd.gcode ELSE :ai_gcode end
	GROUP BY
		dbo.saleledger.custcode,
		sd.icode
	UNION ALL
	SELECT 	
		dbo.srledger.custcode,
		dbo.srdetail.icode,
		amount   = (-1 * Round(Sum ( srdetail.looseqty * srdetail.srprice * 
										(1 - srdetail.discperc * 0.01) ), 2))
	FROM
		dbo.srledger, 
		dbo.srdetail,    
		dbo.item
	WHERE
		dbo.srledger.date BETWEEN :ad_StartDate and :ad_EndDate and
	 	dbo.srledger.custcode IN (:ll_custcode) and
		dbo.srledger.srinvcode = dbo.srdetail.srinvcode and  
		CASE :as_reportgrouping
		WHEN 'M' THEN dbo.item.manfcode
		WHEN 'C' THEN dbo.item.ICatCode
		WHEN 'L' THEN dbo.item.ICCode
		ELSE dbo.item.PACKCODE END IN (:ll_groupcode) and
		dbo.srdetail.icode = item.icode AND
		dbo.srdetail.gcode = case :as_AllGodown WHEN 'Y' THEN dbo.srdetail.gcode ELSE :ai_gcode end
	GROUP BY 
		srledger.custcode,
		srdetail.icode) AS A
WHERE
	A.icode = I.icode
GROUP BY 
	A.CustCode,
	I.ManfCode,
	I.ICatCode,
	I.ICCode,
	I.PackCode
ORDER BY
	Customer,
	GroupName"
  arguments=(("ll_groupcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime), ("ll_custcode", numberlist), ("as_allgodown", string), ("ai_gcode", number), ("as_reportgrouping", string))
 sort="customeralias A, customer A, address A"
)
group(level=1 header.height=0 trailer.height=0 by=("customeralias"  ) header.color="536870912" trailer.color="536870912" )
group(level=2 header.height=0 trailer.height=0 by=("customer"  ) header.color="536870912" trailer.color="536870912" )
