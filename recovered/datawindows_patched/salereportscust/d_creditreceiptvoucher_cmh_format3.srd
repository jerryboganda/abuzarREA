release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=300 print.margin.top=0 print.margin.bottom=1000 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2258 color="536870912" )
summary(height=1808 color="536870912" )
footer(height=250 color="536870912" )
detail(height=408 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(60) updatewhereclause=yes name=manufacurer dbname="manufacurer"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=long updatewhereclause=yes name=id dbname="id"  )
column=(type=decimal(0) updatewhereclause=yes name=utn dbname="utn"  )
column=(type=char(8000) updatewhereclause=yes name=saledetail dbname="saledetail"  )
 retrieve="SELECT  
		 itemname = item.name,
		 packing = dbo.item.packingdesc,
		 manufacurer = (dbo.manufacturer.name),
		 looseqty = Sum (dbo.saledetail.looseqty),
		 price = max(dbo.saledetail.saleprice),
		 id = max(dbo.saledetail.rowid), 
		 utn = max(dbo.saledetail.saleutn),
		 saledetail = ISNULL(DBO.fn_GetSaleQtyListForAnItem(Item.ICode, :as_custcode, :ad_StartDate, :ad_EndDate), '')
FROM 	 dbo.saleledger, 
		 dbo.saledetail,    
		 dbo.item, 
		 dbo.Customer,
		 dbo.Accounts,
		 dbo.Manufacturer 
WHERE 
		( case lower(:as_doctype)  when 'originaldate' then SaleLedger.originaldate 
								when 'billingdate' then SaleLedger.billingdate
								when 'lastsavingdate' then SaleLedger.date end)
		between :ad_StartDate  and :ad_EndDate and
		
		 dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
		 dbo.saledetail.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode AND
		 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
		dbo.saledetail.icode,
		dbo.item.icode,
		dbo.item.name,
		dbo.item.packingdesc,
		dbo.manufacturer.name
UNION ALL
SELECT 
		 itemname = item.name,
		 packing = dbo.item.packingdesc,
		 manufacurer = (dbo.manufacturer.name),
		 looseqty = Sum (sd.looseqty),
		 price = max(sd.saleprice),
		 id = max(sd.rowid), 
		 utn = max(sd.saleutn),
		 sd = ISNULL(DBO.fn_GetSaleQtyListForAnItem(Item.ICode, :as_custcode, :ad_StartDate, :ad_EndDate), '')
FROM 	 dbo.saleledger, 
		 dbo.saleinvdetail sd,    
		 dbo.item, 
		 dbo.Customer,
		 dbo.Accounts,
		 dbo.Manufacturer 
WHERE  
		 ( case lower(:as_doctype) when 'originaldate' then SaleLedger.originaldate 
								when 'billingdate' then SaleLedger.billingdate
								when 'lastsavingdate' then SaleLedger.date end)
		between :ad_StartDate  and :ad_EndDate and
		 DBO.SaleLedger.impactinventory = 'N' AND
		  dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
		 dbo.saleledger.salecatcode IN (1, 2, 3) AND
		 dbo.saleledger.saleinvcode = sd.saleinvcode AND
		 sd.icode = item.icode AND
		 dbo.saleledger.custcode = dbo.customer.custcode AND
		 dbo.customer.custcode = dbo.accounts.acccode AND
		 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
		sd.icode,
		dbo.item.icode,
		dbo.item.name,
		dbo.item.packingdesc,
		dbo.manufacturer.name
"
  arguments=(("as_CustCode", string), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_city", string), ("as_cp", string), ("as_ref", string), ("as_doctype", string))
)
