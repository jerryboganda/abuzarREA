table(column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(1000) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
column=(type=char(30) updatewhereclause=yes name=cnic dbname="CNIC"  )
column=(type=char(30) updatewhereclause=yes name=licenceno dbname="LicenceNo"  )
column=(type=char(100) updatewhereclause=yes name=taxcategory dbname="TaxCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=decimal(6) updatewhereclause=yes name=taxableamount dbname="TaxableAmount"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxperc dbname="AdvanceTaxPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxamt dbname="AdvanceTaxAmt"  )
 retrieve="SELECT 
		AliasName=T.AliasName,
		CustomerName=T.CustomerName,
		Address=T.Address,
		NTN = T.NTN,
		CNIC=T.CNIC,
		LicenceNo = T.LicenceNo,
		TaxCategory = T.TaxCategory,
		NetAmount=SUM(T.NetAmount),
		TaxableAmount = SUM(T.TaxableAmount),
		AdvanceTaxPerc = MAX(T.AdvanceTaxPerc),
		AdvanceTaxAmt = SUM(T.AdvanceTaxAmt)
FROM 
	(SELECT 
		TType='Sales',
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = SPACE(100),
		LicenceNo = S.LicenceNo,
		NetAmount=SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SaleDetail D, Item I WHERE D.SaleInvCode=P.SaleInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = SUM(P.AdvanceTaxAmt)
	FROM
		SaleLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 0 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode IN (:ai_Custcode) AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.SaleInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.LicenceNo,
		S.Address,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales Return',
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = SPACE(100),
		LicenceNo = S.LicenceNo,
		NetAmount= - SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * D.SRPrice  * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SRDetail D, Item I WHERE D.SRInvCode=P.SRInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = - SUM(P.AdvanceTaxAmt)
	FROM
		SRLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 0 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode IN (:ai_Custcode) AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.SRInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.Address,
		S.LicenceNo,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales',
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = SPACE(100),
		LicenceNo = S.LicenceNo,
		NetAmount=SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SaleDetail D, Item I WHERE D.SaleInvCode=P.SaleInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = SUM(P.AdvanceTaxAmt)
	FROM
		CRS_SaleLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 0 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode IN (:ai_Custcode) AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.ClientInstanceID,
		P.SaleInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.LicenceNo,
		S.Address,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales Return',
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = SPACE(100),
		LicenceNo = S.LicenceNo,
		NetAmount= - SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * D.SRPrice  * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SRDetail D, Item I WHERE D.SRInvCode=P.SRInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = - SUM(P.AdvanceTaxAmt)
	FROM
		CRS_SRLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 0 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode IN (:ai_Custcode) AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.ClientInstanceID,
		P.SRInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.Address,
		S.LicenceNo,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales',
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = SPACE(100),
		LicenceNo = S.LicenceNo,
		NetAmount=SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SaleDetail D, Item I WHERE D.SaleInvCode=P.SaleInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = SUM(P.AdvanceTaxAmt)
	FROM
		SaleLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 1 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.SaleInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.LicenceNo,
		S.Address,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales Return',
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = SPACE(100),
		LicenceNo = S.LicenceNo,
		NetAmount= - SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * D.SRPrice  * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SRDetail D, Item I WHERE D.SRInvCode=P.SRInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = - SUM(P.AdvanceTaxAmt)
	FROM
		SRLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 1 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.SRInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.Address,
		S.LicenceNo,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales',
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = SPACE(100),
		LicenceNo = S.LicenceNo,
		NetAmount=SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SaleDetail D, Item I WHERE D.SaleInvCode=P.SaleInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = SUM(P.AdvanceTaxAmt)
	FROM
		CRS_SaleLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 1 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.ClientInstanceID,
		P.SaleInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.LicenceNo,
		S.Address,
		TC.Name,
		TC.TaxPerc
	UNION ALL
	SELECT 
		TType='Sales Return',
		AliasName = A.AliasName,
		CustomerName=A.Name,
		NTN = S.NTNNo,
		CNIC=S.NIC,
		City=S.City,
		Address = S.Address,
		Status='INDIVIDUAL',
		Business = SPACE(100),
		LicenceNo = S.LicenceNo,
		NetAmount= - SUM(P.InvTotal),
		TaxCategory = TC.Name,
		AdvanceTaxPerc = TC.TaxPerc,
		TaxableAmount = (SELECT SUM((D.LooseQty * D.SRPrice * (1 - D.DiscPerc * 0.01)) + ((D.LooseQty + D.BonusQty) * D.UnitSalesTax) + (D.LooseQty * D.SRPrice  * (1 - D.DiscPerc * 0.01) * D.GSTPerc * 0.01) ) FROM SRDetail D, Item I WHERE D.SRInvCode=P.SRInvCode AND D.Icode=I.ICode AND I.Taxable='Y'),
		AdvanceTaxAmt = - SUM(P.AdvanceTaxAmt)
	FROM
		CRS_SRLedger P, Accounts A, Customer S, TaxCategory TC
	WHERE
		:ai_allcust = 1 AND
		P.Posted = 'Y' AND
		P.Date BETWEEN :adt_startdate AND :adt_enddate AND
		P.CustCode = S.CustCode AND
		S.CustCode = A.AccCode AND
		S.TaxCategoryCode = TC.TaxCategoryCode
	GROUP BY
		P.ClientInstanceID,
		P.SRInvCode,
		A.AliasName,
		A.Name,
		S.NTNNo,
		S.NIC,
		S.City,
		S.Address,
		S.LicenceNo,
		TC.Name,
		TC.TaxPerc) T
GROUP BY 
		T.AliasName,
		T.CustomerName,
		T.NTN,
		T.CNIC,
		T.City,
		T.LicenceNo,
		T.Address,
		T.Status,
		T.Business,
		T.TaxCategory
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_custcode", numberlist), ("ai_allcust", number))
 sort="customername A"
)
