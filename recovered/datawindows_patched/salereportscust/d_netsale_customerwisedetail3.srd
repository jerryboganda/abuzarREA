table(column=(type=char(2) updatewhereclause=yes name=saletype dbname="SaleType"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=long updatewhereclause=yes name=acccode dbname="AccCode"  )
column=(type=char(12) updatewhereclause=yes name=accountaliasname dbname="AccountAliasName"  )
column=(type=char(60) updatewhereclause=yes name=accountname dbname="AccountName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(100) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="salestax"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="GstPerc"  )
column=(type=decimal(6) updatewhereclause=yes name=gstvalue dbname="GSTValue"  )
 retrieve="SELECT 
	SaleType = 'S',
	HeaderNo = SL.HeaderNo,
	AccCode = A.AccCode,
	AccountAliasName = A.AliasName,
	AccountName = A.Name,
	AliasName = I.CustomICode,
	ItemName = CASE WHEN SD.SaleItemDescription IS NULL THEN I.Name ELSE SD.SaleItemDescription END,
	Qty = SUM(SD.LooseQty),
	Bonus = SUM(SD.BonusQty),
	salestax  = ROUND(SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2) + SUM(((SD.LooseQty + SD.Bonusqty) * SD.UnitSalesTax)),
	SaleValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
	GstPerc = SD.GSTPerc,
	GSTValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) * (SD.GSTPerc * 0.01))
FROM
	Accounts A, SaleLedger SL, SaleDetail SD, Item I
WHERE
	:ai_one_or_all = 0 AND
	SL.Date BETWEEN :ad_startdate AND :ad_enddate AND
	SL.Posted = 'Y' AND
	SL.CustCode IN (:ai_custcode) AND
	SL.CustCode = A.AccCode AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SD.GSTPerc > 0 AND
	SD.ICode = I.ICode
GROUP BY
	SL.HeaderNo,
	A.AccCode,
	A.AliasName,
	A.Name,
	I.CustomICode,
	I.Name,
	SD.SaleItemDescription ,
	SD.GstPerc
UNION ALL
SELECT 
	SaleType = 'S',
	HeaderNo = SL.HeaderNo,
	AccCode = A.AccCode,
	AliasName = A.AliasName,
	AccountName = A.Name,
	AliasName = I.CustomICode,
	ItemName = CASE WHEN SD.SaleItemDescription IS NULL THEN I.Name ELSE SD.SaleItemDescription END,
	Qty = SUM(SD.LooseQty),
	Bonus = SUM(SD.BonusQty),
	salestax  = ROUND(SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2) + SUM(((SD.LooseQty + SD.Bonusqty) * SD.UnitSalesTax)),
	SaleValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
	GstPerc = SD.GSTPerc,
	GSTValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) * (SD.GSTPerc * 0.01))
FROM
	Accounts A, SaleLedger SL, SaleInvDetail SD, Item I
WHERE
	:ai_one_or_all = 0 AND
	SL.ImpactInventory = 'N' AND
	SL.Date BETWEEN :ad_startdate AND :ad_enddate AND
	SL.Posted = 'Y' AND
	SL.CustCode IN (:ai_custcode) AND
	SL.CustCode = A.AccCode AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SD.GSTPerc > 0 AND
	SD.ICode = I.ICode
GROUP BY
	SL.HeaderNo,
	A.AccCode,
	A.AliasName,
	A.Name,
	I.CustomICode,
	I.Name,
	SD.SaleItemDescription ,
	SD.GstPerc
UNION ALL 
SELECT 
	SaleType = 'SR',
	HeaderNo = SL.HeaderNo,
	AccCode = A.AccCode,
	AliasName = A.AliasName,
	AccountName = A.Name,
	AliasName = I.CustomICode,
	ItemName = CASE WHEN SD.ReturnItemDescription IS NULL THEN I.Name ELSE SD.ReturnItemDescription END,
	Qty = SUM(SD.LooseQty),
	Bonus = SUM(SD.BonusQty),
	salestax  = ROUND(SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2) + SUM(((SD.LooseQty + SD.Bonusqty) * SD.UnitSalesTax)),
	SaleValue = SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
	GstPerc = SD.GSTPerc,
	GSTValue = SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) * (SD.GSTPerc * 0.01))
FROM
	Accounts A, SRLedger SL, SRDetail SD, Item I
WHERE
	:ai_one_or_all = 0 AND
	SL.Date BETWEEN :ad_startdate AND :ad_enddate AND
	SL.Posted = 'Y' AND
	SL.CustCode IN (:ai_custcode) AND
	SL.CustCode = A.AccCode AND
	SL.SRInvCode = SD.SRInvCode AND
	SD.GSTPerc > 0 AND
	SD.ICode = I.ICode
GROUP BY
	SL.HeaderNo,
	A.AccCode,
	A.AliasName,
	A.Name,
	I.CustomICode,
	I.Name,
	SD.ReturnItemDescription ,
	SD.GstPerc
UNION ALL
SELECT 
	SaleType = 'S',
	HeaderNo = SL.HeaderNo,
	AccCode = A.AccCode,
	AccountAliasName = A.AliasName,
	AccountName = A.Name,
	AliasName = I.CustomICode,
	ItemName = CASE WHEN SD.SaleItemDescription IS NULL THEN I.Name ELSE SD.SaleItemDescription END,
	Qty = SUM(SD.LooseQty),
	Bonus = SUM(SD.BonusQty),
	salestax  = ROUND(SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2) + SUM(((SD.LooseQty + SD.Bonusqty) * SD.UnitSalesTax)),
	SaleValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
	GstPerc = SD.GSTPerc,
	GSTValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) * (SD.GSTPerc * 0.01))
FROM
	Accounts A, SaleLedger SL, SaleDetail SD, Item I
WHERE
	:ai_one_or_all = 1 AND
	SL.Date BETWEEN :ad_startdate AND :ad_enddate AND
	SL.Posted = 'Y' AND
	SL.CustCode = A.AccCode AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SD.GSTPerc > 0 AND
	SD.ICode = I.ICode
GROUP BY
	SL.HeaderNo,
	A.AccCode,
	A.AliasName,
	A.Name,
	I.CustomICode,
	I.Name,
	SD.SaleItemDescription ,
	SD.GstPerc
UNION ALL
SELECT 
	SaleType = 'S',
	HeaderNo = SL.HeaderNo,
	AccCode = A.AccCode,
	AliasName = A.AliasName,
	AccountName = A.Name,
	AliasName = I.CustomICode,
	ItemName = CASE WHEN SD.SaleItemDescription IS NULL THEN I.Name ELSE SD.SaleItemDescription END,
	Qty = SUM(SD.LooseQty),
	Bonus = SUM(SD.BonusQty),
	salestax  = ROUND(SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2) + SUM(((SD.LooseQty + SD.Bonusqty) * SD.UnitSalesTax)),
	SaleValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
	GstPerc = SD.GSTPerc,
	GSTValue = SUM(SD.LooseQty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) * (SD.GSTPerc * 0.01))
FROM
	Accounts A, SaleLedger SL, SaleInvDetail SD, Item I
WHERE
	:ai_one_or_all = 1 AND
	SL.ImpactInventory = 'N' AND
	SL.Date BETWEEN :ad_startdate AND :ad_enddate AND
	SL.Posted = 'Y' AND
	SL.CustCode = A.AccCode AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SD.GSTPerc > 0 AND
	SD.ICode = I.ICode
GROUP BY
	SL.HeaderNo,
	A.AccCode,
	A.AliasName,
	A.Name,
	I.CustomICode,
	I.Name,
	SD.SaleItemDescription ,
	SD.GstPerc
UNION ALL 
SELECT 
	SaleType = 'SR',
	HeaderNo = SL.HeaderNo,
	AccCode = A.AccCode,
	AliasName = A.AliasName,
	AccountName = A.Name,
	AliasName = I.CustomICode,
	ItemName = CASE WHEN SD.ReturnItemDescription IS NULL THEN I.Name ELSE SD.ReturnItemDescription END,
	Qty = SUM(SD.LooseQty),
	Bonus = SUM(SD.BonusQty),
	salestax  = ROUND(SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01), 2) + SUM(((SD.LooseQty + SD.Bonusqty) * SD.UnitSalesTax)),
	SaleValue = SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
	GstPerc = SD.GSTPerc,
	GSTValue = SUM(SD.LooseQty * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) * (SD.GSTPerc * 0.01))
FROM
	Accounts A, SRLedger SL, SRDetail SD, Item I
WHERE
	:ai_one_or_all = 1 AND
	SL.Date BETWEEN :ad_startdate AND :ad_enddate AND
	SL.Posted = 'Y' AND
	SL.CustCode = A.AccCode AND
	SL.SRInvCode = SD.SRInvCode AND
	SD.GSTPerc > 0 AND
	SD.ICode = I.ICode
GROUP BY
	SL.HeaderNo,
	A.AccCode,
	A.AliasName,
	A.Name,
	I.CustomICode,
	I.Name,
	SD.ReturnItemDescription ,
	SD.GstPerc
ORDER BY
	SaleType,
	HeaderNo,
	AccountName,
	AliasName,
	ItemName"
  arguments=(("ai_custcode", numberlist), ("ai_one_or_all", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
