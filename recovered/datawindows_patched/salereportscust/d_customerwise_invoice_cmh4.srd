release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1343 color="536870912" )
summary(height=270 color="536870912" )
footer(height=0 color="536870912" )
detail(height=229 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes name=packqty dbname="Packqty"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=long updatewhereclause=yes name=id dbname="ID"  )
 retrieve="SELECT 
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),
	itemname = item.name,  
	packingdesc = dbo.item.packingdesc,
	Packqty = CAST(Sum (dbo.saledetail.looseqty) / CASE WHEN dbo.item.packunits > 0 THEN dbo.item.packunits ELSE 1 END AS INT), 
	purprice = dbo.item.purprice,
	saleprice = dbo.item.saleprice,
	PackUnits = dbo.item.PackUnits,
	ID = MAX(dbo.saledetail.rowid)
FROM 	 
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item, 
	dbo.Customer,
	dbo.Manufacturer 
WHERE  
	CASE lower(:as_datetype) 
		When 'originaldate' Then dbo.saleledger.originaldate 
		When 'lastsavingdate' Then dbo.saleledger.date
		When 'billingdate' Then dbo.saleledger.billingdate
	 End Between :ad_startdate AND :ad_enddate AND
	 dbo.saleledger.custcode IN (:al_custcode) AND
	 dbo.saleledger.salecatcode IN (1, 2, 3) AND
	 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	 dbo.saledetail.icode = item.icode AND
	 dbo.saleledger.custcode = dbo.customer.custcode AND
	 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	dbo.saledetail.icode,
	dbo.item.name,
	dbo.item.packingdesc,
	dbo.item.packunits,
	dbo.item.purprice,
	dbo.item.saleprice"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_datetype", string))
 sort="itemname A"
)
