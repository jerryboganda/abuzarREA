table(column=(type=char(12) updatewhereclause=yes name=ttype dbname="TType"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(13) updatewhereclause=yes name=invoicecode dbname="InvoiceCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(50) updatewhereclause=yes name=ntn dbname="NTN"  )
column=(type=decimal(2) updatewhereclause=yes name=netamount dbname="NetAmount"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="ItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(100) updatewhereclause=yes name=taxcategory dbname="TaxCategory"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxperc dbname="AdvanceTaxPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=advancetaxamt dbname="AdvanceTaxAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=itemadvancetaxperc dbname="ItemAdvanceTaxPerc"  )
column=(type=decimal(6) updatewhereclause=yes name=saleamt dbname="SaleAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=itemadvancetax dbname="ItemAdvanceTax"  )
 retrieve="SELECT 
	TType = 'Sales',
	Date=P.Date,
	InvoiceCode='SV-' + LTRIM(RTRIM(STR(P.SaleInvCode, 10))),
	AliasName = A.AliasName,
	CustomerName=A.Name,
	NTN = S.NTNNo,
	NetAmount=P.InvTotal,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	TaxCategory = TC.Name,
	AdvanceTaxPerc = TC.TaxPerc,
	AdvanceTaxAmt = P.AdvanceTaxAmt,
	ItemAdvanceTaxPerc = D.ItemAdvanceTaxPerc,
	SaleAmt = (SUM((D.PackQty + D.LooseQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + 
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.Gstperc * 0.01) +
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.UnitSalesTax)),
	ItemAdvanceTax = ROUND((SUM((D.PackQty + D.LooseQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + 
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.Gstperc * 0.01) +
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.UnitSalesTax)) * D.ItemAdvanceTaxPerc * 0.01, 2)
FROM
	SaleLedger P, SaleDetail D, Accounts A, Customer S, Item I, TaxCategory TC
WHERE
	:ai_allcust=0 AND
	P.Posted = 'Y' AND
	P.Date BETWEEN :adt_startdate AND :adt_enddate AND
	P.CustCode IN (:ai_Custcode) AND
	P.CustCode = S.CustCode AND
	S.CustCode = A.AccCode AND
	S.TaxCategoryCode = TC.TaxCategoryCode AND
	P.SaleInvCode = D.SaleInvCode AND
	D.ICode = I.ICode
GROUP BY
	P.Date,
	P.SaleInvCode,
	A.AliasName,
	A.Name,
	S.NTNNo,
	P.InvTotal,
	P.AdvanceTaxAmt,
	TC.Name,
	TC.TaxPerc,
	I.CustomICode,
	I.Name,
	D.ItemAdvanceTaxPerc
UNION ALL
SELECT 
	TType = 'Sales Return',
	Date=P.Date,
	InvoiceCode='SR-' + LTRIM(RTRIM(STR(P.SRInvCode, 10))),
	AliasName = A.AliasName,
	CustomerName=A.Name,
	NTN = S.NTNNo,
	NetAmount= - P.InvTotal,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	TaxCategory = TC.Name,
	AdvanceTaxPerc = TC.TaxPerc,
	AdvanceTaxAmt = P.AdvanceTaxAmt,
	ItemAdvanceTaxPerc = D.ItemAdvanceTaxPerc,
	SaleAmt = - ((SUM((D.PackQty + D.LooseQty) * D.SRPrice * (1 - D.DiscPerc * 0.01)) + 
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.SRPrice * (1 - D.DiscPerc * 0.01) * D.Gstperc * 0.01) +
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.UnitSalesTax))),
	ItemAdvanceTax = - (ROUND((SUM((D.PackQty + D.LooseQty) * D.SRPrice * (1 - D.DiscPerc * 0.01)) + 
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.SRPrice * (1 - D.DiscPerc * 0.01) * D.Gstperc * 0.01) +
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.UnitSalesTax)) * D.ItemAdvanceTaxPerc * 0.01, 2))
FROM
	SRLedger P, SRDetail D, Accounts A, Customer S, Item I, TaxCategory TC
WHERE
	:ai_allcust=0 AND
	P.Posted = 'Y' AND
	P.Date BETWEEN :adt_startdate AND :adt_enddate AND
	P.CustCode IN (:ai_Custcode) AND
	P.CustCode = S.CustCode AND
	S.CustCode = A.AccCode AND
	S.TaxCategoryCode = TC.TaxCategoryCode AND
	P.SRInvCode = D.SRInvCode AND
	D.ICode = I.ICode
GROUP BY
	P.Date,
	P.SRInvCode,
	A.AliasName,
	A.Name,
	S.NTNNo,
	P.InvTotal,
	P.AdvanceTaxAmt,
	TC.Name,
	TC.TaxPerc,
	I.CustomICode,
	I.Name,
	D.ItemAdvanceTaxPerc
UNION ALL
SELECT 
	TType = 'Sales',
	Date=P.Date,
	InvoiceCode='SV-' + LTRIM(RTRIM(STR(P.SaleInvCode, 10))),
	AliasName = A.AliasName,
	CustomerName=A.Name,
	NTN = S.NTNNo,
	NetAmount=P.InvTotal,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	TaxCategory = TC.Name,
	AdvanceTaxPerc = TC.TaxPerc,
	AdvanceTaxAmt = P.AdvanceTaxAmt,
	ItemAdvanceTaxPerc = D.ItemAdvanceTaxPerc,
	SaleAmt = (SUM((D.PackQty + D.LooseQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + 
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.Gstperc * 0.01) +
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.UnitSalesTax)),
	ItemAdvanceTax = ROUND((SUM((D.PackQty + D.LooseQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + 
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.Gstperc * 0.01) +
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.UnitSalesTax)) * D.ItemAdvanceTaxPerc * 0.01, 2)
FROM
	CRS_SaleLedger P, CRS_SaleDetail D, Accounts A, Customer S, Item I, TaxCategory TC
WHERE
	:ai_allcust=0 AND
	P.Posted = 'Y' AND
	P.Date BETWEEN :adt_startdate AND :adt_enddate AND
	P.CustCode IN (:ai_Custcode) AND
	P.CustCode = S.CustCode AND
	S.CustCode = A.AccCode AND
	S.TaxCategoryCode = TC.TaxCategoryCode AND
	P.ClientInstanceID = D.ClientInstanceID AND
	P.SaleInvCode = D.SaleInvCode AND
	D.ICode = I.ICode
GROUP BY
	P.ClientInstanceID,
	P.Date,
	P.SaleInvCode,
	A.AliasName,
	A.Name,
	S.NTNNo,
	P.InvTotal,
	P.AdvanceTaxAmt,
	TC.Name,
	TC.TaxPerc,
	I.CustomICode,
	I.Name,
	D.ItemAdvanceTaxPerc
UNION ALL
SELECT 
	TType = 'Sales Return',
	Date=P.Date,
	InvoiceCode='SR-' + LTRIM(RTRIM(STR(P.SRInvCode, 10))),
	AliasName = A.AliasName,
	CustomerName=A.Name,
	NTN = S.NTNNo,
	NetAmount= - P.InvTotal,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	TaxCategory = TC.Name,
	AdvanceTaxPerc = TC.TaxPerc,
	AdvanceTaxAmt = P.AdvanceTaxAmt,
	ItemAdvanceTaxPerc = D.ItemAdvanceTaxPerc,
	SaleAmt = - ((SUM((D.PackQty + D.LooseQty) * D.SRPrice * (1 - D.DiscPerc * 0.01)) + 
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.SRPrice * (1 - D.DiscPerc * 0.01) * D.Gstperc * 0.01) +
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.UnitSalesTax))),
	ItemAdvanceTax = - (ROUND((SUM((D.PackQty + D.LooseQty) * D.SRPrice * (1 - D.DiscPerc * 0.01)) + 
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.SRPrice * (1 - D.DiscPerc * 0.01) * D.Gstperc * 0.01) +
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.UnitSalesTax)) * D.ItemAdvanceTaxPerc * 0.01, 2))
FROM
	CRS_SRLedger P, CRS_SRDetail D, Accounts A, Customer S, Item I, TaxCategory TC
WHERE
	:ai_allcust=0 AND
	P.Posted = 'Y' AND
	P.Date BETWEEN :adt_startdate AND :adt_enddate AND
	P.CustCode IN (:ai_Custcode) AND
	P.CustCode = S.CustCode AND
	S.CustCode = A.AccCode AND
	S.TaxCategoryCode = TC.TaxCategoryCode AND
	P.ClientInstanceID = D.ClientInstanceID AND
	P.SRInvCode = D.SRInvCode AND
	D.ICode = I.ICode
GROUP BY
	P.ClientInstanceID,
	P.Date,
	P.SRInvCode,
	A.AliasName,
	A.Name,
	S.NTNNo,
	P.InvTotal,
	P.AdvanceTaxAmt,
	TC.Name,
	TC.TaxPerc,
	I.CustomICode,
	I.Name,
	D.ItemAdvanceTaxPerc
UNION ALL
SELECT 
	TType = 'Sales',
	Date=P.Date,
	InvoiceCode='SV-' + LTRIM(RTRIM(STR(P.SaleInvCode, 10))),
	AliasName = A.AliasName,
	CustomerName=A.Name,
	NTN = S.NTNNo,
	NetAmount=P.InvTotal,
	ItemAlias = I.CustomICode,
	ItemName = I.Name,
	TaxCategory = TC.Name,
	AdvanceTaxPerc = TC.TaxPerc,
	AdvanceTaxAmt = P.AdvanceTaxAmt,
	ItemAdvanceTaxPerc = D.ItemAdvanceTaxPerc,
	SaleAmt = (SUM((D.PackQty + D.LooseQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + 
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.Gstperc * 0.01) +
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.UnitSalesTax)),
	ItemAdvanceTax = ROUND((SUM((D.PackQty + D.LooseQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01)) + 
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * D.Gstperc * 0.01) +
		SUM((D.PackQty + D.LooseQty + D.BonusQty) * D.UnitSalesTax)) * D.ItemAdvanceTaxPerc * 0.01, 2)
FROM
	SaleLedger P, SaleDetail D, Accounts A, Customer S, Item I, TaxCategory TC
WHERE
	:ai_allcust=1 AND
	P.Posted = 'Y' AND
	P.Date BETWEEN :adt_startdate AND :adt_enddate AND
	P.CustCode = S.CustCode AND
	S.CustCode = A.AccCode AND
	S.TaxCategoryCode = TC.TaxCategoryCode AND
