release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1260 color="536870912" )
summary(height=1156 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(6) updatewhereclause=yes name=discount dbname="Discount"  )
 retrieve="SELECT 
	CustomerName = A.Name,
	ItemName=I.Name,
	Qty = SUM(D.LooseQty),
	Rate = AVG(D.SalePrice),
	Discount = SUM(D.Looseqty * D.ItemFlatDisc) +
		SUM(Round(D.Looseqty * (D.SalePrice - D.ItemFlatDisc) * (D.Discperc * 0.01), 2)) +
		SUM(Round(D.Looseqty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.Discperc * 0.01) * (S.DiscPerc * 0.01), 2))
FROM
	SaleLedger S,
	SaleDetail D,
	Accounts A,
	Item I
WHERE 
	S.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
	S.SaleInvCode = D.SaleInvcode AND
	S.Custcode = :ai_custcode AND
	S.Custcode = A.Acccode AND
	D.ICode = I.ICode
GROUP BY
	A.Name,
	I.Name
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ai_custcode", number), ("ai_discperc", number), ("ai_withholdingtax", number))
 sort="customername A, itemname A"
)
