table(column=(type=char(60) updatewhereclause=yes name=relation dbname="Relation"  )
column=(type=decimal(6) updatewhereclause=yes name=amount dbname="Amount"  )
 retrieve="SELECT  
	Relation = (SELECT W.Name FROM Relation W WHERE W.RelationCode=dbo.saleledger.RelationCode),
	Amount = Sum (dbo.saledetail.looseqty * dbo.saledetail.saleprice)
FROM 	 
	dbo.saleledger, 
	dbo.saledetail, 
	dbo.item, 
	dbo.Customer,
	dbo.Accounts,
	dbo.Manufacturer 
WHERE  
	:as_doctype = 'originaldate' AND
	dbo.saleledger.originaldate >= :ad_StartDate AND
	dbo.saleledger.originaldate <= :ad_EndDate  AND 
	dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) AND
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	dbo.saledetail.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	dbo.saleledger.RelationCode
UNION ALL
SELECT 
	Relation = (SELECT W.Name FROM Relation W WHERE W.RelationCode=dbo.saleledger.RelationCode),
	Amount = Sum (sd.looseqty * sd.saleprice)
FROM 	 
	dbo.saleledger, 
	dbo.saleinvdetail sd,    
	dbo.item, 
	dbo.Customer,
	dbo.Accounts,
	dbo.Manufacturer 
WHERE  
	DBO.SaleLedger.impactinventory = 'N' AND
	:as_doctype = 'originaldate' AND
	dbo.saleledger.originaldate >= :ad_StartDate AND
	dbo.saleledger.originaldate <= :ad_EndDate  AND 
	dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) AND
	dbo.saleledger.saleinvcode = sd.saleinvcode AND
	sd.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	dbo.saleledger.RelationCode
UNION
SELECT 
	Relation = (SELECT W.Name FROM Relation W WHERE W.RelationCode=dbo.saleledger.RelationCode),
	Amount = Sum (dbo.saledetail.looseqty * dbo.saledetail.saleprice)
FROM
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item, 
	dbo.Customer,
	dbo.Accounts,
	dbo.Manufacturer 
WHERE  
	:as_doctype = 'billingdate' AND
	dbo.saleledger.billingdate >= :ad_StartDate AND
	dbo.saleledger.billingdate <= :ad_EndDate  AND 
	dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) AND
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	dbo.saledetail.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	dbo.saleledger.RelationCode
UNION ALL
SELECT 
	Relation = (SELECT W.Name FROM Relation W WHERE W.RelationCode=dbo.saleledger.RelationCode),
	Amount = Sum (sd.looseqty * sd.saleprice)
FROM
	dbo.saleledger, 
	dbo.saleinvdetail sd,    
	dbo.item, 
	dbo.Customer,
	dbo.Accounts,
	dbo.Manufacturer 
WHERE  
	DBO.SaleLedger.impactinventory = 'N' AND
	:as_doctype = 'billingdate' AND
	dbo.saleledger.billingdate >= :ad_StartDate AND
	dbo.saleledger.billingdate <= :ad_EndDate  AND 
	dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) AND
	dbo.saleledger.saleinvcode = sd.saleinvcode AND
	sd.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	dbo.saleledger.RelationCode
UNION
SELECT 
	Relation = (SELECT W.Name FROM Relation W WHERE W.RelationCode=dbo.saleledger.RelationCode),
	Amount = Sum (dbo.saledetail.looseqty * dbo.saledetail.saleprice)
FROM
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item, 
	dbo.Customer,
	dbo.Accounts,
	dbo.Manufacturer 
WHERE  
	:as_doctype = 'lastsavingdate' AND
	dbo.saleledger.date >= :ad_StartDate AND
	dbo.saleledger.date <= :ad_EndDate  AND 
	dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) AND
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	dbo.saledetail.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	dbo.saleledger.RelationCode
UNION ALL
SELECT 
	Relation = (SELECT W.Name FROM Relation W WHERE W.RelationCode=dbo.saleledger.RelationCode),
	Amount = Sum (sd.looseqty * sd.saleprice)
FROM
	dbo.saleledger, 
	dbo.saleinvdetail sd,    
	dbo.item, 
	dbo.Customer,
	dbo.Accounts,
	dbo.Manufacturer 
WHERE  
	DBO.SaleLedger.impactinventory = 'N' AND
	:as_doctype = 'lastsavingdate' AND
	dbo.saleledger.date >= :ad_StartDate AND
	dbo.saleledger.date <= :ad_EndDate  AND 
	dbo.saleledger.custcode IN (SELECT CODE FROM DBO.UDF_STRINGTOTABL(:as_custcode,',') ) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) AND
	dbo.saleledger.saleinvcode = sd.saleinvcode AND
	sd.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	dbo.saleledger.RelationCode
"
  arguments=(("as_CustCode", string), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_city", string), ("as_doctype", string), ("as_custrefno", string), ("as_customercp", string), ("as_line1", string), ("as_line2", string))
)
