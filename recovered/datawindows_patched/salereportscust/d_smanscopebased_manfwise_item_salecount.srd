table(column=(type=char(20) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(20) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(20) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=number updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=number updatewhereclause=yes name=customercount dbname="customercount"  )
 retrieve="SELECT 
	Manufacturer=M.Name,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	SalesMan = S.Name,
	SaleQty = SUM(T.SaleQty),
	CustomerCount = COUNT(DISTINCT T.CustCode)
FROM
	Manufacturer M,
	Item I,
	Salesman S,
	(SELECT 
		I.ManfCode,
		S.SalesManCode,
		I.ICode,
		SS.SubAreaCode,
		SL.CustCode,
		SaleQty = SUM(SD.LooseQty + SD.BonusQty)
	FROM
		SaleLedger SL,
		SaleDetail SD,
		Item I,
		SalesMan S,
		Customer C,
		(SELECT DISTINCT ManfCode, SalesManCode, SubAreaCode FROM SalesManScope) SS
	WHERE
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.CustCode = C.CustCode AND
		C.SubAreaCode = SS.SubAreaCode AND
		SS.SalesManCode = S.SalesManCode AND
		S.SalesManCode IN (:ai_salesmancode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (:ai_manfcode) AND
		I.ManfCode = SS.ManfCode
	GROUP BY 
		I.ManfCode,
		S.SalesManCode,
		I.ICode,
		SS.SubAreaCode,
		SL.CustCode
	UNION ALL
	SELECT 
		I.ManfCode,
		S.SalesManCode,
		I.ICode,
		SS.SubAreaCode,
		SL.CustCode,
		SaleQty = SUM(SD.LooseQty + SD.BonusQty)
	FROM
		SaleLedger SL,
		SaleInvDetail SD,
		Item I,
		SalesMan S,
		Customer C,
		(SELECT DISTINCT ManfCode, SalesManCode, SubAreaCode FROM SalesManScope) SS
	WHERE
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.CustCode = C.CustCode AND
		C.SubAreaCode = SS.SubAreaCode AND
		SS.SalesManCode = S.SalesManCode AND
		S.SalesManCode IN (:ai_salesmancode) AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (:ai_manfcode) AND
		I.ManfCode = SS.ManfCode
	GROUP BY 
		I.ManfCode,
		S.SalesManCode,
		I.ICode,
		SS.SubAreaCode,
		SL.CustCode
	UNION ALL
	SELECT 
		I.ManfCode,
		S.SalesManCode,
		I.ICode,
		SS.SubAreaCode,
		SL.CustCode,
		SaleQty = - SUM(SD.LooseQty + SD.BonusQty)
	FROM
		SRLedger SL,
		SRDetail SD,
		Item I,
		SalesMan S,
		Customer C,
		(SELECT DISTINCT ManfCode, SalesManCode, SubAreaCode FROM SalesManScope) SS
	WHERE
		SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
		SL.Posted = 'Y' AND
		SL.CustCode = C.CustCode AND
		C.SubAreaCode = SS.SubAreaCode AND
		SS.SalesManCode = S.SalesManCode AND
		S.SalesManCode IN (:ai_salesmancode) AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode = I.ICode AND
		I.ManfCode IN (:ai_manfcode) AND
		I.ManfCode = SS.ManfCode
	GROUP BY 
		I.ManfCode,
		S.SalesManCode,
		I.ICode,
		SS.SubAreaCode,
		SL.CustCode) T
WHERE
	T.ManfCode = M.ManfCode AND
	T.ICode = I.ICode AND
	T.SalesManCode = S.SalesManCode
GROUP BY
	M.Name,
	I.CustomICode,
	I.Name,
	S.Name
"
  arguments=(("ai_salesmancode", numberlist), ("ai_manfcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="manufacturer A, itemname A, aliasname A"
)
