header(height=1468 color="536870912" )
summary(height=625 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(20) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=long key=yes updatewhereclause=yes name=icode dbname="Item.ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=decimal(2) updatewhereclause=yes name=currentsaleprice dbname="CurrentSalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=currentpurprice dbname="CurrentPurPrice"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(6) updatewhereclause=yes name=grosssales dbname="GrossSales"  )
column=(type=decimal(6) updatewhereclause=yes name=saleamount dbname="SaleAmount"  )
column=(type=decimal(9) updatewhereclause=yes name=itemcost dbname="ItemCost"  )
column=(type=decimal(6) updatewhereclause=yes name=margin dbname="Margin"  )
column=(type=decimal(6) updatewhereclause=yes name=expectedmargin dbname="ExpectedMargin"  )
column=(type=decimal(6) updatewhereclause=yes name=discmargin dbname="DiscMargin"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
 retrieve=" SELECT
	GroupCode = 
		CASE :as_reportgrouping
		WHEN 'M' THEN I.ManfCode
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PackCode END,
	GroupName= 
		CASE :as_reportgrouping
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PackCode) END,   
	I.ICode,
	ItemName=I.Name,
	PackUnits=I.PackUnits,
	CurrentSalePrice = CASE When Sum(D.SaleQty) > 0 Then Max(I.SalePrice) Else 0 End,
	CurrentPurPrice = CASE When Sum(D.SaleQty) > 0 Then Max(I.PurPrice) Else 0 End,
	Qty=ISNULL(sum(D.saleqty),0),
	GrossSales = ISNULL(sum(D.GrossSales), 0),
	SaleAmount=ISNULL(sum(D.salevalue), 0),
	ItemCost=ISNULL(sum(D.itemcost), 0),
	Margin=ISNULL((sum(D.salevalue) - sum(D.itemcost) ) / 
			Case sum(D.salevalue) WHEN 0 THEN 1 ELSE sum(D.salevalue) END, 0) * 100,
	ExpectedMargin=ISNULL((sum(D.GrossSales) - sum(D.itemcost) ) / 
			Case sum(D.GrossSales) WHEN 0 THEN 1 ELSE sum(D.GrossSales) END, 0) * 100,
	DiscMargin=ISNULL((sum(D.GrossSales) - sum(D.salevalue) ) / 
			Case sum(D.GrossSales) WHEN 0 THEN 1 ELSE sum(D.GrossSales) END, 0) * 100,
	Bonus=ISNULL(sum(D.bonus),0)
FROM
	Item I,
	(SELECT 
		saleqty=ISNULL(sum(SD.looseqty),0) ,
		bonus=ISNULL(sum(SD.bonusqty),0) ,
		GrossSales = IsNull( Sum ( SD.Rate * SD.looseqty) , 0 ),
		salevalue=ISNULL(round(sum((SD.looseqty * (SD.saleprice - itemflatdisc)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01),2),0),
		I.ICode,
		itemcost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)),2),0)
	FROM
		saleledger SL,
		saledetail SD,
		item I
	WHERE	
		SL.date BETWEEN :adt_sdate AND :adt_ldate AND
		SL.salecatcode IN (:ai_salecatcode) and
		SD.saleinvcode=SL.saleinvcode AND
		SD.icode=I.icode AND
		SD.Batch = :as_batch AND
		CASE :as_reportgrouping
			WHEN 'M' THEN I.ManfCode
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PACKCODE 
		END IN (:ai_groupcode)
	GROUP BY 
		SD.icode,
		I.ICode,
		SL.saleinvcode,
		SL.discperc
	UNION ALL
	SELECT 
		saleqty=ISNULL(sum(SD.looseqty),0) ,
		bonus=ISNULL(sum(SD.bonusqty),0) ,
		GrossSales = IsNull( Sum ( SD.Rate * SD.looseqty) , 0 ),
		salevalue=ISNULL(round(sum((SD.looseqty * (SD.saleprice - itemflatdisc)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01),2),0),
		I.ICode,
		itemcost=ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)),2),0)
	FROM		
		saleledger SL,
		saleinvdetail SD,
		item I
	WHERE		
		SL.ImpactInventory ='N' AND 
		SL.date BETWEEN :adt_sdate AND :adt_ldate AND
		SL.salecatcode IN (:ai_salecatcode) and
		SD.saleinvcode=SL.saleinvcode AND
		SD.icode=I.icode AND
		SD.Batch = :as_batch AND
		CASE :as_reportgrouping
			WHEN 'M' THEN I.ManfCode
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PACKCODE 
		END IN (:ai_groupcode)
	GROUP BY 
		SD.icode,
		I.ICode,
		SL.saleinvcode,
		SL.discperc
	UNION ALL
	SELECT	
		saleqty=-ISNULL(sum(SD.looseqty),0) ,
		bonus=-ISNULL(sum(SD.bonusqty),0) ,
		GrossSales = -1 * ( IsNull ( Sum ( SD.SalePrice * SD.LooseQty) , 0 )  ),
		salevalue=-ISNULL(round(sum((SD.looseqty * (SD.srprice)) * (1 - SD.discperc * 0.01) ) * (1 - SL.discperc* 0.01),2),0),
		I.ICode,
		itemcost=-ISNULL(Round(sum(SD.avgprice * (SD.looseqty + SD.BonusQty)),2),0)
	FROM		
		srledger SL,
		srdetail SD,
		item I
	WHERE		
		SL.date BETWEEN :adt_sdate AND :adt_ldate AND
		SL.srcatcode IN (:ai_srcatcode) and
		SD.srinvcode=SL.srinvcode AND
		SD.icode=I.icode AND
		SD.Batch = :as_batch AND
		CASE :as_reportgrouping
			WHEN 'M' THEN I.ManfCode
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PACKCODE 
		END IN (:ai_groupcode)
	GROUP BY
		SD.icode,
		I.ICode,
		SL.srinvcode,
		SL.discperc
	UNION ALL
	SELECT
		saleqty=0.0000,
		bonus=0.0000,
		GrossSales = 0.0000,
		salevalue=0.0000,
		I.ICode,
		itemcost=0.0000
	FROM 
		Item I
	WHERE
		CASE :as_reportgrouping
			WHEN 'M' THEN I.ManfCode
			WHEN 'C' THEN I.ICatCode
			WHEN 'L' THEN I.ICCode
			ELSE I.PACKCODE 
		END IN (:ai_groupcode)) AS D
WHERE 
	D.ICode = I.ICode
GROUP BY
	I.ManfCode,
	I.ICatCode,
	I.ICCode,
	I.PackCode,
	I.ICode,
	I.name,
	I.PackUnits
ORDER BY
	GroupName,
	ItemName
"
  update="Item" updatewhere=0 updatekeyinplace=no
  arguments=(("as_reportgrouping", string), ("ai_groupcode", numberlist), ("adt_SDate", datetime), ("adt_LDate", datetime), ("ai_salecatcode", numberlist), ("ai_srcatcode", numberlist), ("as_batch", string))
)
