table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=saletypeinvno dbname="SaleTypeInvNo"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=yes name=address1 dbname="Address1"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(60) updatewhereclause=yes name=manufacurer dbname="manufacurer"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=long updatewhereclause=yes name=rowid dbname="rowid"  )
column=(type=decimal(2) updatewhereclause=yes name=cumulativesum dbname="cumulativesum"  )
column=(type=decimal(2) updatewhereclause=yes name=cumulativesumfoot dbname="cumulativesumfoot"  )
 retrieve="SELECT 
	SaleInvCode=dbo.saleledger.SaleInvCode,
	date  = CAST(CONVERT(VARCHAR(10), dbo.saleledger.BillingDate, 101) AS DATETIME),
	SaleTypeInvNo = dbo.saleledger.SaleTypeInvNo,
	Customer = Accounts.Name,
	Address1 = Customer.Address1,
	itemname = item.name, 
	manufacurer = (dbo.manufacturer.name), 
	looseqty = Sum (dbo.saledetail.looseqty), 
	price = max(dbo.saledetail.saleprice), 
	rowid = max(dbo.saledetail.rowid), 
	cumulativesum = round(0.00,2), 
	cumulativesumfoot = round(0.00,2)
FROM 
	dbo.saleledger, 
	dbo.saledetail, 
	dbo.item, 
	dbo.Customer,
	dbo.Accounts,
	dbo.Manufacturer 
WHERE  
	dbo.saleledger.BillingDate >= :ad_StartDate AND
	dbo.saleledger.BillingDate <= :ad_EndDate  AND 
	dbo.saleledger.custcode IN ( :al_custcode ) AND
	dbo.saleledger.salecatcode IN (1, 2, 3) AND
	dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	dbo.saledetail.icode = item.icode AND
	dbo.saleledger.custcode = dbo.customer.custcode AND
	dbo.customer.custcode = dbo.accounts.acccode AND
	dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	Accounts.Name,
	Customer.Address1,
	CAST(CONVERT(VARCHAR(10), dbo.saleledger.BillingDate, 101) AS DATETIME),
	dbo.saleledger.SaleInvCode,
	dbo.saleledger.SaleTypeInvNo,
	dbo.saledetail.icode,
	dbo.item.name,
	dbo.manufacturer.name
"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number))
 sort="customer A, date A, saleinvcode A, rowid A"
)
