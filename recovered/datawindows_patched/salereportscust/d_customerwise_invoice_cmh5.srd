release 12.5;
datawindow ( units=2 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=200 print.margin.right=200 print.margin.top=2000 print.margin.bottom=1250 print.paper.size=9 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=2020 color="536870912" )
summary(height=1916 color="536870912" )
footer(height=291 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=yes name=ward dbname="Ward"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=manufacurer dbname="manufacurer"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=price dbname="price"  )
column=(type=long updatewhereclause=yes name=id dbname="id"  )
 retrieve="Select 
	Customer=max(A.customer),
	Ward,
	itemname,
	packingdesc,
	manufacurer,
	looseqty=Sum(A.looseqty),
	price=Max(A.price),
	id=Max(A.id)
		
FROM
		
		(SELECT  
			Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),
			Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),
			itemname = item.name, 
			packingdesc = dbo.item.packingdesc,
			manufacurer = (dbo.manufacturer.name),
			looseqty = Sum (dbo.saledetail.looseqty),
			price = Max (dbo.saledetail.saleprice),
			ID = MAX(dbo.saledetail.rowid),
			icode=saledetail.icode
		FROM 	 
			dbo.saleledger, 
			dbo.saledetail,    
			dbo.item, 
			dbo.Customer,
			dbo.Manufacturer 
		WHERE  
			CASE lower(:as_datetype) 
				When 'originaldate' Then dbo.saleledger.originaldate 
				When 'lastsavingdate' Then dbo.saleledger.date
				When 'billingdate' Then dbo.saleledger.billingdate
			 End Between :ad_startdate AND :ad_enddate AND
			 dbo.saleledger.custcode IN (:al_custcode) AND
			 dbo.saleledger.salecatcode IN (1, 2, 3) AND
			 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
			 dbo.saledetail.icode = item.icode AND
			 dbo.saleledger.custcode = dbo.customer.custcode AND
			 dbo.Item.manfcode = dbo.manufacturer.manfcode
		Group by 
			SaleLedger.WardCode,
			dbo.saledetail.icode,
			dbo.item.name,
			dbo.manufacturer.name,
			dbo.item.packingdesc
		
		UNION ALL
		
		SELECT 
			Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),
			Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),
			itemname = item.name, 
			packingdesc = dbo.item.packingdesc,
			manufacurer = (dbo.manufacturer.name),
			looseqty = Sum (saledetail.looseqty),
			price = Max (saledetail.saleprice),
			ID = MAX(saledetail.rowid),
			icode=saledetail.icode
		FROM 	 
			dbo.saleledger, 
			saleinvdetail saledetail,    
			dbo.item, 
			dbo.Customer,
			dbo.Manufacturer 
		WHERE  
			CASE lower(:as_datetype) 
				When 'originaldate' Then dbo.saleledger.originaldate 
				When 'lastsavingdate' Then dbo.saleledger.date
				When 'billingdate' Then dbo.saleledger.billingdate
			 End Between :ad_startdate AND :ad_enddate AND
			dbo.saleledger.ImpactInventory='N' AND
			 dbo.saleledger.custcode IN (:al_custcode) AND
			 dbo.saleledger.salecatcode IN (1, 2, 3) AND
			 dbo.saleledger.saleinvcode = saledetail.saleinvcode AND
			 saledetail.icode = item.icode AND
			 dbo.saleledger.custcode = dbo.customer.custcode AND
			 dbo.Item.manfcode = dbo.manufacturer.manfcode
		Group by 
			SaleLedger.WardCode,
			saledetail.icode,
			dbo.item.name,
			dbo.manufacturer.name,
			dbo.item.packingdesc ) As A

GROUP BY
		A.Ward,
		A.icode,
		A.itemname,
		A.manufacurer,
		A.packingdesc


/*SELECT  
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),
	Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),
	itemname = item.name, 
	packingdesc = dbo.item.packingdesc,
	manufacurer = (dbo.manufacturer.name),
	looseqty = Sum (dbo.saledetail.looseqty),
	price = Max (dbo.saledetail.saleprice),
	ID = MAX(dbo.saledetail.rowid)
FROM 	 
	dbo.saleledger, 
	dbo.saledetail,    
	dbo.item, 
	dbo.Customer,
	dbo.Manufacturer 
WHERE  
	CASE lower(:as_datetype) 
		When 'originaldate' Then dbo.saleledger.originaldate 
		When 'lastsavingdate' Then dbo.saleledger.date
		When 'billingdate' Then dbo.saleledger.billingdate
	 End Between :ad_startdate AND :ad_enddate AND
	 dbo.saleledger.custcode IN (:al_custcode) AND
	 dbo.saleledger.salecatcode IN (1, 2, 3) AND
	 dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode AND
	 dbo.saledetail.icode = item.icode AND
	 dbo.saleledger.custcode = dbo.customer.custcode AND
	 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	SaleLedger.WardCode,
	dbo.saledetail.icode,
	dbo.item.name,
	dbo.manufacturer.name,
	dbo.item.packingdesc

UNION ALL

SELECT 
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = min(saleledger.custcode)),
	Ward = (SELECT W.Name FROM Ward W WHERE W.WardCode = SaleLedger.WardCode),
	itemname = item.name, 
	packingdesc = dbo.item.packingdesc,
	manufacurer = (dbo.manufacturer.name),
	looseqty = Sum (saledetail.looseqty),
	price = Max (saledetail.saleprice),
	ID = MAX(saledetail.rowid)
FROM 	 
	dbo.saleledger, 
	saleinvdetail saledetail,    
	dbo.item, 
	dbo.Customer,
	dbo.Manufacturer 
WHERE  
	CASE lower(:as_datetype) 
		When 'originaldate' Then dbo.saleledger.originaldate 
		When 'lastsavingdate' Then dbo.saleledger.date
		When 'billingdate' Then dbo.saleledger.billingdate
	 End Between :ad_startdate AND :ad_enddate AND
	dbo.saleledger.ImpactInventory='N' AND
	 dbo.saleledger.custcode IN (:al_custcode) AND
	 dbo.saleledger.salecatcode IN (1, 2, 3) AND
	 dbo.saleledger.saleinvcode = saledetail.saleinvcode AND
	 saledetail.icode = item.icode AND
	 dbo.saleledger.custcode = dbo.customer.custcode AND
	 dbo.Item.manfcode = dbo.manufacturer.manfcode
Group by 
	SaleLedger.WardCode,
	saledetail.icode,
	dbo.item.name,
	dbo.manufacturer.name,
	dbo.item.packingdesc

*/"
  arguments=(("al_CustCode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number), ("as_contactperson", string), ("as_address1", string), ("as_address2", string), ("as_city", string), ("as_line1", string), ("as_line2", string), ("as_displayheader", string), ("as_datetype", string), ("ai_less_amt", number))
 sort="ward A, itemname A"
)
