table(column=(type=datetime updatewhereclause=yes name=saledate dbname="SaleDate"  )
column=(type=decimal(6) updatewhereclause=yes name=grossamount dbname="GrossAmount"  )
column=(type=decimal(6) updatewhereclause=yes name=discountamt dbname="DiscountAmt"  )
column=(type=decimal(6) updatewhereclause=yes name=netamount dbname="NetAmount"  )
 retrieve="SELECT 
	SaleDate=S.SaleDate,
	GrossAmount = ISNULL(SUM(S.NetAmount), 0),
	DiscountAmt = ISNULL(SUM(S.NetAmount) * :ad_discperc * 0.01, 0),
	NetAmount = ISNULL(SUM(S.NetAmount) * (1 - :ad_discperc * 0.01), 0)
FROM
	(SELECT 
		CustCode = SL.CustCode,
		saledate= CAST(CONVERT(VARCHAR(15), CASE :as_datetype WHEN 'originaldate' THEN SL.OriginalDate WHEN 'billingdate' THEN SL.BillingDate ELSE SL.Date END, 101) AS DATETIME),
		Invcode= SL.saleinvcode , 
		NetAmount = Case when Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) - flatdisc   +   misccharges), 2) IS NULL Then 0  Else Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc   +   misccharges, 0) End 
					+
					Round(Sum (Round (  SD.looseqty *   SD.unitsalestax + Round ( Round (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc ) * (1 -   SD.discperc * 0.01 ), 2 ) *   SD.gstperc * 0.01 , 2 ) , 2 ) )
						 +  (Case when (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) - flatdisc), 2)) * SL.invgstperc1 * 0.01 IS NULL Then 0  Else (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc ,2) ) * SL.invgstperc1 * 0.01 End ), 0)
	FROM 
		saleledger SL, saledetail SD
	WHERE 
		( SL.custcode IN (:al_custcode) ) AND
		( CASE :as_datetype WHEN 'originaldate' THEN SL.OriginalDate WHEN 'billingdate' THEN SL.BillingDate ELSE SL.Date END BETWEEN :ad_StartDate AND :ad_EndDate) AND
		( SL.saleinvcode = SD.saleinvcode )
	GROUP BY 
		SL.CustCode,
		SL.date,
		SL.Originaldate,
		SL.Billingdate,
		SL.saleinvcode,
		SL.flatdisc,
		SL.misccharges,
		SL.discperc,
		SL.invgstperc1
	UNION ALL
	SELECT 
		CustCode = SL.CustCode,
		saledate= CAST(CONVERT(VARCHAR(15), CASE :as_datetype WHEN 'originaldate' THEN SL.OriginalDate WHEN 'billingdate' THEN SL.BillingDate ELSE SL.Date END, 101) AS DATETIME),
		Invcode= SL.saleinvcode , 
		NetAmount = Case when Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) - flatdisc   +   misccharges), 2) IS NULL Then 0  Else Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc   +   misccharges, 0) End 
					+
					Round(Sum (Round (  SD.looseqty *   SD.unitsalestax + Round ( Round (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc ) * (1 -   SD.discperc * 0.01 ), 2 ) *   SD.gstperc * 0.01 , 2 ) , 2 ) )
						 +  (Case when (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) - flatdisc), 2)) * SL.invgstperc1 * 0.01 IS NULL Then 0  Else (Round(Sum ( (  SD.looseqty * (  SD.saleprice -   SD.itemflatdisc)) *  (1 -   SD.discperc /100) * (1 -   SL.discperc /100) ) - flatdisc ,2) ) * SL.invgstperc1 * 0.01 End ), 0)
	FROM 
		saleledger SL, saleinvdetail SD
	WHERE 
		( SL.ImpactInventory = 'N' ) AND
		( SL.custcode IN (:al_custcode) ) AND
		( CASE :as_datetype WHEN 'originaldate' THEN SL.OriginalDate WHEN 'billingdate' THEN SL.BillingDate ELSE SL.Date END BETWEEN :ad_StartDate AND :ad_EndDate) AND
		( SL.saleinvcode = SD.saleinvcode )
	GROUP BY 
		SL.CustCode,
		SL.date,
		SL.Originaldate,
		SL.Billingdate,
		SL.saleinvcode,
		SL.flatdisc,
		SL.misccharges,
		SL.discperc,
		SL.invgstperc1) S,
	Customer C,
	Accounts A
WHERE 
	S.CustCode = C.CustCode AND C.CustCode = A.AccCode
GROUP BY
	S.SaleDate
ORDER BY
	SaleDate"
  arguments=(("as_datetype", string), ("al_custcode", numberlist), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("ad_discperc", number))
 sort="saledate A"
)
