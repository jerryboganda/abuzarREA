release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1510 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(20) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(10) updatewhereclause=yes name=type dbname="Type"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(12) updatewhereclause=yes name=titlealias dbname="TitleAlias"  )
column=(type=char(82) updatewhereclause=yes name=title dbname="Title"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=decimal(4) updatewhereclause=yes name=qtyinactual dbname="QtyInActual"  )
column=(type=decimal(4) updatewhereclause=yes name=qtyinbonus dbname="QtyInBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=qtyoutactual dbname="QtyOutActual"  )
column=(type=decimal(4) updatewhereclause=yes name=qtyoutbonus dbname="QtyOutBonus"  )
column=(type=decimal(15) updatewhereclause=yes name=netrate dbname="NetRate"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="AvgPrice"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=char(1) updatewhereclause=yes name=due dbname="Due"  )
column=(type=decimal(0) updatewhereclause=yes name=utn dbname="UTN"  )
 retrieve="	SELECT
	GroupCode=CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END, 
	GroupName=CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) 	ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	Type = 'PV-' + RTRIM(LTRIM(CONVERT(CHAR(7), pl.purinvcode))),
	Date = pl.postdate, 
	PostDate = pl.postdate,
	AliasName= i.customicode,
	ItemName= i.name,
	UserName = u.username,
	TitleAlias = a.AliasName,
	Title = CASE WHEN purcatcode = 3 THEN 'Opening Purchase' ELSE a.name END,
	Godown = (SELECT g.name FROM godown g WHERE g.gcode = pd.gcode),
	QtyInActual = CASE WHEN pl.purcatcode IN (3,7,8) THEN pd.looseqty ELSE pd.looseqty + (pd.packqty * pd.packunits) END,
	QtyInBonus = CASE When pl.purcatcode IN (3,7,8) THEN pd.bonusqty Else (pd.bonusqty * pd.packunits) END,
	QtyOutActual=0.0000,
	QtyOutBonus=0.0000,
	NetRate = (CASE WHEN purcatcode = 3 or purcatcode = 7 or purcatcode = 8 THEN pd.purprice ELSE pd.purprice / pd.packunits END) * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01),
	AvgPrice=pd.newavgprice,
	Batch = pd.batch,
	Expiry=pd.expiry,
	Due = null,
	UTN=ISNULL(pd.purutn, 0)
FROM
	purledger pl, 
	purdetail pd, 
	users u, 
	item i, 
	accounts a
WHERE 
	pl.postdate between :ad_startdate and :ad_enddate 	and
	pl.purinvcode = pd.purinvcode and	
	pl.Posted = 'Y' and 
	pl.suppcode = a.acccode and
	pd.icode = i.icode and 
	CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END in (:ai_groupcode) and 	
	pl.salesmancode = u.usercode
UNION ALL
SELECT
	GroupCode=CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END, 
	GroupName=CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) 	ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	Type = 'IS-' + RTRIM(LTRIM(CONVERT(CHAR(7), ih.issueinvcode))),
	Date = ih.date,
	Postdate = ih.postdate,
	AliasName= i.customicode,
	ItemName= i.name,
	UserName = u.username,
	TitleAlias = LTRIM(RTRIM(STR(d.deptcode))),
	Title = d.name,
	Godown = (SELECT g.name FROM godown g WHERE g.gcode = isd.gcode),
	QtyInActual = 0,
	QtyInBonus = 0,
	QtyOutActual=qty,
	QtyOutBonus=0,
	NetRate = isd.purchaseprice,
	AvgPrice= isd.avgprice,
	Batch = isd.batch,
	Expiry= isd.expiry,
	Due = null,
	UTN=ISNULL(isd.issueutn, 0)
FROM
	Issueheader ih, 
	issuedetail isd, 
	users u, 
	Department d,
	item i
WHERE 
	ih.date between :ad_startdate and :ad_enddate 	and
	ih.issueinvcode = isd.issueinvcode and
	ih.deptcode = d.deptcode and
	ih.Posted = 'Y' and
 	isd.icode = i.icode and
	CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END in (:ai_groupcode) and 	
	ih.salesmancode = u.usercode
UNION ALL
SELECT
	GroupCode=CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END, 
	GroupName=CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) 	ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	Type = 'PR-' + RTRIM(LTRIM(CONVERT(CHAR(7), pl.prinvcode))),
	Date = pl.date,
	PostDate = pl.postdate,
	AliasName= i.customicode,
	ItemName= i.name,
	UserName = u.username,
	TitleAlias = a.AliasName,
	Title = CASE WHEN prcatcode = 4 or prcatcode = 5 THEN a.name ELSE 'Opening Purchase Return' END,
	Godown = (SELECT g.name FROM godown g WHERE g.gcode = pd.gcode),
	QtyInActual = 0,
	QtyInBonus = 0,
	QtyOutActual= pd.looseqty ,
	QtyOutBonus= pd.bonusqty,
	NetRate = pd.prprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01),
	AvgPrice= pd.avgprice,
	Batch = pd.batch,
	Expiry= pd.expiry,
	Due = null,
	UTN=ISNULL(pd.prutn, 0)
FROM 	
	prledger pl, 
	prdetail pd, 
	users u, 
	item i, 
	accounts a
WHERE
	pl.date between :ad_startdate and :ad_enddate 	and
	pl.posted = 'Y' and
	pl.suppcode = a.acccode and
	pl.prinvcode = pd.prinvcode and	
	pd.icode = i.icode and 	
	CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END in (:ai_groupcode) and 	
	pl.salesmancode = u.usercode
UNION ALL
SELECT 
	GroupCode=CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END, 
	GroupName=CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) 	ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	Type = CASE sl.salecatcode WHEN 3 THEN 'CS-' ELSE 'CR-' END + RTRIM(LTRIM(CONVERT(CHAR(6), sl.saleinvcode))),
	Date = sl.date,
	PostDate = sl.postdate,
	AliasName= i.customicode,
	ItemName= i.name,
	UserName = u.username,
	TitleAlias = a.AliasName,
	Title = LTRIM(RTRIM(CASE WHEN sl.salecatcode <= 2 Then LTRIM(RTRIM(a.name)) Else 'Cash Sale' End)) + ' - ' + 
		CASE sd.Due WHEN 'D' THEN 'Due Items' WHEN 'X' THEN 'Due Items Deleted'
		WHEN 'S' THEN 'Due Items Satisfied' END,
	Godown = (SELECT g.name FROM godown g WHERE g.gcode = sd.gcode),
	QtyInActual = 0,
	QtyInBonus = 0,
	QtyOutActual= sd.looseqty,
	QtyOutBonus= sd.bonusqty,
	NetRate = (sd.saleprice - sd.itemflatdisc) * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01),
	AvgPrice= sd.avgprice,
	Batch = sd.batch,
	Expiry= sd.expiry,
	Due = sd.due,
	UTN=ISNULL(sd.saleutn, 0)
FROM
	saleledger sl, 
	saledetail sd, 
	users u,
	item i,
	accounts a
WHERE 
	sl.date Between  :ad_startdate and :ad_enddate and
	sl.saleinvcode = sd.saleinvcode and	
	sl.posted = 'Y' and
	sl.custcode = a.acccode and
	sd.icode = i.icode and 	
	CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END in (:ai_groupcode) and 	
	sl.salesmancode = u.usercode
UNION
SELECT 
	GroupCode=CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END, 
	GroupName=CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) 	ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	Type = CASE sl.srcatcode WHEN 8 THEN 'CSR-' ELSE 'CRR-' END + RTRIM(LTRIM(CONVERT(CHAR(6), sl.srinvcode))),
	Date = sl.postdate,
	PostDate = sl.postdate,
	AliasName= i.customicode,
	ItemName= i.name,
	UserName = u.username,
	TitleAlias = a.AliasName,
	Title = CASE WHEN srcatcode = 6 or srcatcode = 7 THEN a.name ELSE 'Cash Sale Return' END,
	Godown = (SELECT g.name FROM godown g WHERE g.gcode = sd.gcode),
	QtyInActual = sd.looseqty,
	QtyInBonus = sd.bonusqty,
	QtyOutActual=0,
	QtyOutBonus=0,
	NetRate = sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01),
	AvgPrice= sd.avgprice,
	Batch = sd.batch,
	Expiry= sd.expiry,
	Due = NULL,
	UTN=isnull(sd.srutn, 0)
FROM
	srledger sl,
	srdetail sd, 
	users u,
	item i,
	accounts a
WHERE
	sl.postdate between :ad_startdate and :ad_enddate and
	sl.srinvcode = sd.srinvcode and	
	sl.posted = 'Y' and
	sl.custcode = a.acccode and
	sd.icode = i.icode and 	
	CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END in (:ai_groupcode) and 	
	sl.salesmancode = u.usercode
UNION ALL
SELECT
	GroupCode=CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END, 
	GroupName=CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) 	ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	Type = 'DS-' + RTRIM(LTRIM(CONVERT(CHAR(7), dh.saleinvcode))),
	date = dh.DueSatisfyDate,
	Postdate = Null,
	AliasName= i.customicode,
	ItemName= i.name,
	UserName = u.username,
	TitleAlias = (SELECT accounts.aliasname FROM accounts, saleledger 
			WHERE Saleledger.saleinvcode = dh.saleinvcode and accounts.acccode = saleledger.custcode),
	Title = (SELECT accounts.name FROM accounts, saleledger 
			WHERE Saleledger.saleinvcode = dh.saleinvcode and accounts.acccode = saleledger.custcode),
	Godown = (SELECT g.name FROM godown g WHERE g.gcode = sd.gcode),
	QtyInActual=0,
	QtyInBonus=0,
	QtyOutActual= sd.DueSatisfyqty,
	QtyOutBonus=0,
	NetRate = (select saleprice from saledetail sdd
		where sdd.saleinvcode = dh.saleinvcode and sdd.icode = sd.icode
		group by sdd.icode, sdd.saleprice),
	AvgPrice= sd.avgprice,
	Batch = sd.batch,
	Expiry= sd.expiry,
	Due = 'A',
	UTN=isnull(sd.duesatisfyutn, 0)
FROM
	DueSatisfyHeader dh, 
	DueSatisfydetail sd, 
	users u, 
	item i
WHERE
	dh.DueSatisfydate between :ad_startdate and :ad_enddate and
	dh.DueSatisfyCode = sd.DueSatisfyCode and	
	sd.icode = i.icode and 
	CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END in (:ai_groupcode) and 	
	dh.usercode = u.usercode
UNION ALL
SELECT
	GroupCode=CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END, 
	GroupName=CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) 	ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	Type = 'DD-' + RTRIM(LTRIM(CONVERT(CHAR(7), dh.saleinvcode))),
	Date = dh.DueSatisfyDate,
	Postdate = Null,
	AliasName= i.customicode,
	ItemName= i.name,
	UserName = u.username,
	TitleAlias = (SELECT accounts.aliasname FROM accounts, saleledger 
			WHERE Saleledger.saleinvcode = dh.saleinvcode and accounts.acccode = saleledger.custcode),
	Title = (SELECT accounts.name FROM accounts, saleledger 
			WHERE Saleledger.saleinvcode = dh.saleinvcode and accounts.acccode = saleledger.custcode),
	Godown = '',
	QtyInActual=0,
	QtyInBonus=0,
	QtyOutActual=sd.deletedqty,
	QtyOutBonus=0,
	NetRate = (select saleprice from saledetail sdd
		where sdd.saleinvcode = dh.saleinvcode and sdd.icode = sd.icode
		group by sdd.icode, sdd.saleprice),
	AvgPrice= 0,
	Batch = '',
	Expiry= NULL,
	Due = 'B',
	UTN=0
FROM
	DueSatisfyHeader dh, DueDeletedetail sd, users u, item i
WHERE
	dh.DueSatisfydate between :ad_startdate and :ad_enddate and
	dh.DueSatisfyCode = sd.DueSatisfyCode and	
	sd.icode = i.icode and 	
	CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END in (:ai_groupcode) and 	
	dh.usercode = u.usercode
UNION ALL
SELECT
	GroupCode=CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END, 
	GroupName=CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) 	ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	Type = CASE ah.adjcatcode WHEN 1 THEN 'AI-' ELSE 'AD-' END + RTRIM(LTRIM(CONVERT(CHAR(7), ah.adjcode))),
	Date = ah.posteddate,
	PostDate = ah.posteddate,
	AliasName= i.customicode,
	ItemName= i.name,
	UserName = u.username,
	TitleAlias = (Select LTRIM(RTRIM(STR(adjcategory.adjcatcode))) from adjcategory where adjcategory.adjcatcode = ah.adjcatcode),
	Title = (Select adjcategory.name from adjcategory where adjcategory.adjcatcode = ah.adjcatcode),
	Godown = (select g.name from godown g where g.gcode = ad.gcode),
	QtyInActual = Case  ah.adjcatcode When 1 THEN ad.looseqty ELSE 0 END,
	QtyInBonus = 0,
	QtyOutActual = Case ah.adjcatcode When 2 THEN ad.looseqty ELSE 0 END,
	QtyOutBonus = 0,
	NetRate = ad.price,
	Avgprice = ad.avgprice,
	Batch = ad.batch,
	expiry = ad.expiry,
	Due=null,
	UTN=ad.adjutn
FROM
	adjheader ah, 
	adjdetail ad, 
	users u, 
	item i
WHERE 	
	ah.posteddate between :ad_startdate and :ad_enddate and
	ah.posted = 'Y' and
	ah.adjcode = ad.adjcode and
	ad.icode = i.icode and
	CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END in (:ai_groupcode) and 	
	ah.usercode = u.usercode
UNION ALL
SELECT 
	GroupCode=CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END, 
	GroupName=CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) 	ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	Type = 'RC' + RTRIM(LTRIM(CONVERT(CHAR(7), rh.ReceiptInvCode))),
	Date = rh.postdate,
	PostDate = rh.postdate,
	AliasName= i.customicode,
	ItemName= i.name,
	UserName = u.username,
	TitleAlias = LTRIM(RTRIM(STR(d.deptcode))),
	Title = d.name,
	Godown = (SELECT g.name FROM godown g WHERE g.gcode = rd.gcode),
	QtyInActual = rd.qty,
	QtyInBonus=0,
	QtyOutActual=0,
	QtyOutBonus=0,
	NetRate=RD.saleprice,
	Avgprice=RD.avgprice,
	batch = RD.batch,
	expiry=RD.expiry,
	Due=null,
	UTN=rd.receiptutn
FROM
	ReceiptHeader rh, 
	ReceiptDetail rd, 
	users u, 
	item i,
	department d
WHERE
	rh.postdate between :ad_startdate and :ad_enddate and
	rh.ReceiptInvCode = rd.ReceiptInvCode and
	rh.posted = 'Y' and
	rh.deptcode = d.deptcode and
	rd.icode = i.icode and 	
	CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END in (:ai_groupcode) and 	
	rh.salesmancode = u.usercode
UNION ALL
SELECT 
	GroupCode=CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END, 
	GroupName=CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) 	ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	Type = 'AV-' + RTRIM(LTRIM(CONVERT(CHAR(7), h.documentcode))),
	Date = h.postdate,
	PostDate = h.postdate,
	AliasName= i.customicode,
	ItemName= i.name,
	UserName = u.username,
	TitleAlias = NULL,
	Title = 'Item Price Adjustment',
	Godown = NULL,
	QtyInActual = 0,
	QtyInBonus = 0,
	QtyOutActual=0,
	QtyOutBonus=0,
	NetRate=d.newpurprice,
	avgprice=d.newavgprice,
	batch = '',
	expiry=NULL,
	Due = null,
	UTN=isnull(d.utn, 0)
FROM
	avgpriceadjheader h, 
	avgpriceadjdetail d, 
	users u, 
	item i
WHERE
	h.postdate between :ad_startdate and :ad_enddate and
	h.documentcode = d.documentcode and
	h.posted='Y' and
 	d.icode = i.icode and 
	CASE :as_grouptype WHEN 'M' THEN I.MANFCODE WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END in (:ai_groupcode) and 	
	h.usercode = u.usercode
ORDER BY
	GroupName, 
	GroupCode, 
	ItemName, 
	Utn, 
	Date, 
	Batch, 
	Expiry"
  arguments=(("as_grouptype", string), ("ai_groupcode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="groupname A, groupcode A, itemname A, aliasname A"
)
group(level=1 header.height=208 trailer.height=0 by=("groupname" "groupcode"  ) header.color="536870912" trailer.color="536870912" )
group(level=2 header.height=197 trailer.height=197 by=("itemname" "aliasname"  ) header.color="536870912" trailer.color="536870912" )
