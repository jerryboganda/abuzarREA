table(column=(type=decimal(6) updatewhereclause=yes name=value dbname="value"  )
column=(type=char(60) updatewhereclause=yes name=manufacturername dbname="manufacturername"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="category"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="manfcode"  )
column=(type=long updatewhereclause=yes name=catcode dbname="catcode"  )
 retrieve="select 
	value=isnull(sum(D.Stockvalue),0),
	D.manufacturername,
	D.category,
	D.manfcode,
	D.catcode
From 
	(SELECT 
		Item.Name,  
		aliasname=item.customicode, 
		Item.purprice,   
		Item.PackUnits,   
		QTY = isnull(sum(GodownDetail.CurrQty),0),   
		manufacturername=Manufacturer.name,
		manfcode=Manufacturer.manfcode,
		Category=itemcategory.name,
		catcode=itemcategory.icatcode,
		UnitPrice = Case :ai_pricetype 
				WHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
				WHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
				WHEN 3 THEN Round(max(Item.avgprice), 2)
			END ,
		PackQty =isnull( Round(sum(GodownDetail.CurrQty) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2),0),
		StockValue = isnull(Sum(GodownDetail.CurrQty),0) *
			Case :ai_pricetype 
				WHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
				WHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
				WHEN 3 THEN Round(max(Item.avgprice), 2)
			END
	FROM 
		Manufacturer,   
		Item
		LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode),
		ItemCategory
	WHERE 
		( Item.ManfCode IN (:manfcode) ) and
		( Manufacturer.manfcode = Item.ManfCode ) and
		( Item.icatcode=itemcategory.icatcode) and
		( Item.active=1) 
	GROUP BY 
		Item.name, item.customicode, Item.purprice, 
		Item.PackUnits, Manufacturer.name, Manufacturer.manfcode, 
		itemcategory.name,itemcategory.icatcode) as D
Group by 
	D.manufacturername, 
	D.manfcode,
	D.category,
	D.catcode
Having 
	isnull(sum(D.Stockvalue),0)>0
order by 
	D.manufacturername,category

"
  arguments=(("manfcode", numberlist), ("ai_pricetype", number))
)
