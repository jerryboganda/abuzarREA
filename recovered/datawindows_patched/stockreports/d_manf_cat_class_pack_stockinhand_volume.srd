detail(height=76 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=long updatewhereclause=yes name=packunits dbname="Item.PackUnits"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(3) updatewhereclause=yes name=packingfactor dbname="packingfactor"  )
column=(type=long updatewhereclause=yes name=qtypack dbname="QtyPack"  )
column=(type=long updatewhereclause=yes name=qtyloose dbname="QtyLoose"  )
column=(type=decimal(3) updatewhereclause=yes name=volinliters dbname="VolInLiters"  )
column=(type=decimal(6) updatewhereclause=yes name=totalliters dbname="totalliters"  )
column=(type=decimal(6) updatewhereclause=yes name=stockvalue dbname="stockvalue"  )
column=(type=decimal(5) updatewhereclause=yes name=packprice dbname="packprice"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="unitprice"  )
 retrieve="SELECT 	
	GroupName=CASE :as_grouptype WHEN 'M' THEN Manufacturer.name WHEN 'C' THEN itemcategory.name WHEN 'P' THEN itemPacking.name ELSE itemclass.name END,
	Item.Name,  
	aliasname=item.customicode, 
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	Item.PackUnits, 
	stock=isnull(sum(godowndetail.currqty),0),
	packingfactor=max(item.packingfactor),  
	QtyPack=CAST(isnull(sum(GodownDetail.CurrQty),0) / Item.PackUnits  AS INT),
	QtyLoose=CAST (isnull(sum(CAST(GodownDetail.CurrQty AS INT)),0) % Item.PackUnits AS INT) ,
	VolInLiters=Round(Item.packunits*max(item.packingfactor),2),
	totalliters=isnull(sum(godowndetail.currqty),0) * Round(max(item.packingfactor),2),
	stockvalue=isnull(sum(godowndetail.currqty),0) * Case :ai_pricetype 
																	WHEN 2 THEN Round(Item.purprice /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
																	WHEN 1 THEN Round(max(Item.Saleprice) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
																	/*WHEN 3 THEN Round(max(Item.avgprice), 2)*/
																	WHEN 3 THEN max(Item.avgprice)
																	END,
	packprice=Case :ai_pricetype 
					WHEN 2 THEN Item.purprice
					WHEN 1 THEN Item.Saleprice 
					WHEN 3 THEN Round(max(Item.avgprice), 2)

				END,
	unitprice=Case :ai_pricetype 
					WHEN 2 THEN Round(Item.purprice /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
					WHEN 1 THEN Round(max(Item.Saleprice) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
					/*WHEN 3 THEN Round(max(Item.avgprice), 2)*/
		WHEN 3 THEN max(Item.avgprice)
				END
FROM 	
	Manufacturer,   
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)
	LEFT OUTER JOIN ItemClass ON (Item.iccode=itemclass.iccode)
	LEFT OUTER JOIN ItemPacking ON (Item.packcode=itempacking.packcode),
	ItemCategory
WHERE 
	CASE :as_grouptype 
		WHEN 'M' THEN Item.ManfCode
		WHEN 'C' THEN Item.ICatCode 
		WHEN 'P' THEN item.PackCode 
		ELSE Item.ICCode END IN (:ai_groupcode) and
	Item.active=1 and
	Manufacturer.manfcode = Item.ManfCode and
	Item.icatcode=itemcategory.icatcode
GROUP BY 
	Manufacturer.name,
	itemcategory.name,
	Itemclass.name,
	itempacking.name,
	Item.name,
	item.customicode, 
	Item.Active, 
	Item.purprice, 
	Item.SalePrice, 
	Item.PackUnits
"
  arguments=(("as_grouptype", string), ("ai_groupcode", numberlist), ("ai_pricetype", number))
 sort="groupname A, itemname A"
)
