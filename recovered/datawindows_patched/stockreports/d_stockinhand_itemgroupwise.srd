table(column=(type=long updatewhereclause=yes name=itemgroupcode dbname="ItemGroupCode"  )
column=(type=char(60) updatewhereclause=yes name=itemgroup dbname="ItemGroup"  )
column=(type=long updatewhereclause=yes name=gcode dbname="GCode"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=decimal(13) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="QTY"  )
column=(type=decimal(16) updatewhereclause=yes name=stockvalue dbname="StockValue"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="Manufacturer.name"  )
column=(type=char(60) updatewhereclause=yes name=classname dbname="classname"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
column=(type=decimal(6) updatewhereclause=yes name=packqty dbname="PackQty"  )
 retrieve="SELECT 
	ItemGroupCode=IG.ItemGroupCode,
	ItemGroup = IG.Name,
	GCode = G.GCode,
	Godown = G.Name,
	GroupName=CASE :as_grouptype WHEN 'M' THEN Manufacturer.name WHEN 'C' THEN itemcategory.name WHEN 'P' THEN itemPacking.name ELSE itemclass.name END,
	Item.Name,  
	aliasname=item.customicode, 
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	Rate = Case :ai_pricetype 
		WHEN 2 THEN Round(Item.purprice /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
		WHEN 1 THEN Round(max(Item.Saleprice) /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
		WHEN 3 THEN Round(max(Item.avgprice), 2)
	END ,
	Item.PackUnits,   
	QTY = isnull(sum(GD.CurrQty),0),   
	StockValue = isnull(sum(GD.CurrQty * Case :ai_pricetype 
		WHEN 2 THEN Round(Item.purprice /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
		WHEN 1 THEN Round(Item.Saleprice /  CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
		WHEN 3 THEN Round(Item.avgprice, 2)
	END ),0),
	Manufacturer.name,
	classname=itemclass.name,
	Category=itemcategory.name,
	Packing=itempacking.name,
	PackingDesc=item.PackingDesc, 
	PackQty =isnull( Round(sum(GD.CurrQty) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2),0)
FROM 
	ItemGroup IG,
	ItemGroupDetail IGD,
	Godown G,
	GodownDetail GD,
	Manufacturer,   
	Item
	LEFT OUTER JOIN ItemClass ON (Item.iccode=itemclass.iccode)
	LEFT OUTER JOIN ItemPacking ON (Item.packcode=itempacking.packcode),
	ItemCategory

WHERE 
	IG.ItemGroupCode IN (:ai_itemgroup) AND
	IG.ItemGroupCode = IGD.ItemGroupCode AND
	IGD.ICode = Item.ICode AND
	Item.ICode = GD.ICode and  
	G.GCode IN (:ai_gcode) AND
	G.GCode = GD.GCode AND
	CASE :as_grouptype 
		WHEN 'M' THEN Item.ManfCode
		WHEN 'C' THEN Item.ICatCode 
		WHEN 'P' THEN item.PackCode 
		ELSE Item.ICCode END IN (:ai_groupcode) and
	Manufacturer.manfcode = Item.ManfCode and
	Item.icatcode=itemcategory.icatcode and
	Item.active=1

GROUP BY 
	IG.ItemGroupCode,
	IG.Name,
	G.GCode,
	G.Name,
	Item.name,
	item.customicode, 
	Item.Active,
	Item.purprice, 
	Item.PackUnits, 
	Manufacturer.name,
	itemcategory.name,
	Itemclass.name,
	itempacking.name,
	Item.PackingDesc
"
  arguments=(("as_grouptype", string), ("ai_groupcode", numberlist), ("ai_gcode", numberlist), ("ai_itemgroup", numberlist), ("ai_pricetype", number))
 sort="godown A, itemgroup A, groupname A, item_name A"
)
