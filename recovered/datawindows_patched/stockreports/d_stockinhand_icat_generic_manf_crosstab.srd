release 12.5;
datawindow ( units=2 timer_interval=0 processing=4 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=822 color="536870912" )
header[2](height=187 color="536870912" )
summary(height=197 color="536870912" )
footer(height=0 color="536870912" )
detail(height=218 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
column=(type=char(20) updatewhereclause=yes name=itemdesc dbname="itemdesc"  )
column=(type=char(20) updatewhereclause=yes name=genericitem dbname="genericitem"  )
column=(type=number updatewhereclause=yes name=qty dbname="qty"  )
 retrieve="SELECT 
	ItemCategory=IC.Name,
	ItemDesc = I.PackingDesc, 
	GenericItem=GI.Name,
	Manufacturer=M.Name,
	Qty = SUM(GD.CurrQty)
FROM 
	GenericItem GI, 
	Item I
	LEFT OUTER JOIN GodownDetail AS GD ON (I.ICode = GD.ICode),
	Manufacturer M, 
	ItemCategory IC
WHERE
	I.ICatCode IN (:ai_icatcode) AND
	GD.GCode IN (:ai_gcode) AND
	I.ManfCode = M.ManfCode AND
	I.GenericCode = GI.GenericCode AND
	I.ICatCode = IC.ICatCode
GROUP BY
	IC.Name,
	I.PackingDesc, 
	GI.Name,
	M.Name
ORDER BY 
	GenericItem, 
	Manufacturer"
  arguments=(("ai_icatcode", numberlist), ("ai_gcode", numberlist))
 sort="itemcategory A, genericitem A, itemdesc A"
)
group(level=1 header.height=187 trailer.height=197 by=("itemcategory"  ) header.color="536870912" trailer.color="536870912" )
group(level=2 header.height=0 trailer.height=0 by=("itemdesc"  ) header.color="536870912" trailer.color="536870912" )
