release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=612 color="536870912" )
summary(height=504 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=purinvcode dbname="purinvcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Manufacturer.ICode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Manufacturer.Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Manufacturer.Expiry"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
 retrieve=" SELECT
		purinvcode=(select count(purinvcode) 
				from purledger 
				where
					PurInvCode Between :ar_SinvCode AND :ar_LinvCode AND
					(Posted = Case :ar_postedunposted 
					 WHEN 'B' THEN 'Y'
					 WHEN 'Y' THEN 'Y'
	  				 WHEN 'N' THEN 'N'
		  			 ELSE 'Z'
					 END OR
					Posted = Case :ar_postedunposted 
					 WHEN 'B' THEN 'N'
					 WHEN 'Y' THEN 'Y'
		  			 WHEN 'N' THEN 'N'
		  			 ELSE 'Z'
					 END)), 
		PD.ICode, 
		PD.Batch, 
		PD.Expiry, 
		Item = I.Name,
		active=CASE I.active WHEN 1 THEN 'Y' ELSE 'N' END,
		Packing=MAX(I.packingdesc),
		SUM(PD.looseQty) AS Qty, 
		SUM(PD.BonusQty) AS Bonus,
		Manufacturer = M.Name

FROM
		(SELECT * FROM Purdetail WHERE PurInvCode Between :ar_SinvCode AND :ar_LinvCode) PD,
		(SELECT * FROM PurLedger WHERE PurInvCode Between :ar_SinvCode AND :ar_LinvCode) PL,
		Manufacturer M,
		Item	I
WHERE 
		PL.PurInvCode Between :ar_SinvCode AND :ar_LinvCode AND
		PL.PurInvCode = PD.PurInvcode AND
		(PL.Posted = Case :ar_postedunposted 
						 WHEN 'B' THEN 'Y'
						 WHEN 'Y' THEN 'Y'
			  			 WHEN 'N' THEN 'N'
			  			 ELSE 'Z'
						 END OR
		PL.Posted = Case :ar_postedunposted 
						 WHEN 'B' THEN 'N'
						 WHEN 'Y' THEN 'Y'
			  			 WHEN 'N' THEN 'N'
			  			 ELSE 'Z'
						 END) AND
		PD.ICode = I.ICode AND
		I.ManfCode = M.ManfCode
GROUP BY
		PD.ICode, 
		PD.Batch, 
		PD.Expiry,
		M.Name,
		I.Name,
		I.Active

ORDER BY
		M.Name,
		I.Name 

"
  arguments=(("ar_postedunposted", string), ("ar_SinvCode", number), ("ar_Linvcode", number))
)
