release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.file=""  picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=395 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(60) updatewhereclause=yes name=zonename dbname="ZoneName"  )
column=(type=long updatewhereclause=yes name=icode dbname="Icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Itemname"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=decimal(13) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=decimal(4) updatewhereclause=yes name=openqty dbname="openqty"  )
column=(type=decimal(6) updatewhereclause=yes name=openvalue dbname="openvalue"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty_week1 dbname="PurQty_Week1"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalue_week1 dbname="PurValue_Week1"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty_week2 dbname="PurQty_Week2"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalue_week2 dbname="PurValue_Week2"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty_week3 dbname="PurQty_Week3"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalue_week3 dbname="PurValue_Week3"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty_week4 dbname="PurQty_Week4"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalue_week4 dbname="PurValue_Week4"  )
column=(type=decimal(4) updatewhereclause=yes name=pretqty dbname="PRetQty"  )
column=(type=decimal(6) updatewhereclause=yes name=pretvalue dbname="PRetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty_week1 dbname="SaleQty_Week1"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue_week1 dbname="SaleValue_Week1"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty_week2 dbname="SaleQty_Week2"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue_week2 dbname="SaleValue_Week2"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty_week3 dbname="SaleQty_Week3"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue_week3 dbname="SaleValue_Week3"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty_week4 dbname="SaleQty_Week4"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue_week4 dbname="SaleValue_Week4"  )
column=(type=decimal(4) updatewhereclause=yes name=sretqty dbname="SRetQty"  )
column=(type=decimal(6) updatewhereclause=yes name=sretvalue dbname="SRetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=issueqty dbname="IssueQty"  )
column=(type=decimal(6) updatewhereclause=yes name=issuevalue dbname="IssueValue"  )
column=(type=decimal(4) updatewhereclause=yes name=duesatisfyqty dbname="DueSatisfyQty"  )
column=(type=decimal(6) updatewhereclause=yes name=duesatisfyvalue dbname="DueSatisfyValue"  )
column=(type=decimal(4) updatewhereclause=yes name=receiptqty dbname="ReceiptQty"  )
column=(type=decimal(6) updatewhereclause=yes name=receiptvalue dbname="ReceiptValue"  )
column=(type=decimal(4) updatewhereclause=yes name=adjqty dbname="AdjQty"  )
column=(type=decimal(6) updatewhereclause=yes name=adjvalue dbname="AdjValue"  )
 retrieve="SELECT
	ZoneName = (SELECT Z.Name FROM Zone Z WHERE Z.ZoneCode = :ai_zonecode),
	Icode=St.Icode,
	AliasName= i.customicode,
	Itemname = i.name,
	GroupCode=CASE :as_GroupCriteria 
		WHEN 'M' THEN I.MANFCODE
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END,
	GroupName= CASE :as_GroupCriteria 
		WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode)
		WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode)
		WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode)
		ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	Rate= CASE :ai_Pricetype WHEN 1 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2)
			WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2)
			WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2)
			ELSE ROUND(I.AVGPRICE, 2) END,
	packingdesc= max(i.packingdesc),
	openqty	  = SUM(CASE WHEN type='OP' THEN qty ELSE 0 END),
	openvalue  = ROUND(SUM(CASE WHEN type='OP' THEN 
			CASE :ai_Pricetype WHEN 1 THEN value
			WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * qty
			WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * qty
			ELSE ROUND(I.AVGPRICE, 2) * qty END ELSE 0 END), 0),
	PurQty_Week1  = SUM(CASE WHEN type='PV' THEN 
							CASE WHEN datepart(dd, st.date) <= 7 THEN (Qty+Bonus) ELSE 0 END
						ELSE 0 END),
	PurValue_Week1  = ROUND(SUM(CASE WHEN type='PV' THEN 
							CASE WHEN datepart(dd, st.date) <= 7 THEN 
								CASE :ai_Pricetype WHEN 1 THEN value
								WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (qty + bonus)
								WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (qty + bonus)
								ELSE ROUND(I.AVGPRICE, 2) * (qty + bonus) END ELSE 0 END ELSE 0 END), 0),
	PurQty_Week2  = SUM(CASE WHEN type='PV' THEN 
							CASE WHEN datepart(dd, st.date) >= 8 and datepart(dd, st.date) <= 15 THEN (Qty+bonus) ELSE 0 END
						ELSE 0 END),
	PurValue_Week2  = ROUND(SUM(CASE WHEN type='PV' THEN 
							CASE WHEN datepart(dd, st.date) >= 8 and datepart(dd, st.date) <= 15 THEN 
								CASE :ai_Pricetype WHEN 1 THEN value
								WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (qty + bonus)
								WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (qty + bonus)
								ELSE ROUND(I.AVGPRICE, 2) * (qty + bonus) END ELSE 0 END ELSE 0 END), 0),
	PurQty_Week3  = SUM(CASE WHEN type='PV' THEN 
							CASE WHEN datepart(dd, st.date) >= 16 and datepart(dd, st.date) <= 23 THEN (Qty + Bonus) ELSE 0 END
						ELSE 0 END),
	PurValue_Week3  = ROUND(SUM(CASE WHEN type='PV' THEN 
							CASE WHEN datepart(dd, st.date) >= 16 and datepart(dd, st.date) <= 23 THEN 
								CASE :ai_Pricetype WHEN 1 THEN value
								WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
								WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
								ELSE ROUND(I.AVGPRICE, 2) * (Qty + Bonus) END ELSE 0 END ELSE 0 END), 0),
	PurQty_Week4  = SUM(CASE WHEN type='PV' THEN 
							CASE WHEN datepart(dd, st.date) >= 24 and datepart(dd, st.date) <= 31 THEN (Qty + Bonus) ELSE 0 END
						ELSE 0 END),
	PurValue_Week4  = ROUND(SUM(CASE WHEN type='PV' THEN 
							CASE WHEN datepart(dd, st.date) >= 24 and datepart(dd, st.date) <= 31 THEN 
								CASE :ai_Pricetype WHEN 1 THEN value
								WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
								WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
								ELSE ROUND(I.AVGPRICE, 2) * (Qty + Bonus) END ELSE 0 END ELSE 0 END), 0),
	PRetQty	  =SUM(CASE WHEN type='PR' THEN (Qty + Bonus) ELSE 0 END),
	PRetValue =ROUND(SUM(CASE WHEN type='PR' THEN value ELSE 0 END), 0),
	SaleQty_Week1  = SUM(CASE WHEN type='SV' THEN 
							CASE WHEN datepart(dd, st.date) <= 7 THEN (Qty + Bonus) ELSE 0 END
						ELSE 0 END),
	SaleValue_Week1  = ROUND(SUM(CASE WHEN type='SV' THEN 
							CASE WHEN datepart(dd, st.date) <= 7 THEN 
								CASE :ai_Pricetype WHEN 1 THEN value
								WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
								WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
								ELSE ROUND(I.AVGPRICE, 2) * (Qty + Bonus) END ELSE 0 END ELSE 0 END), 0),
	SaleQty_Week2  = SUM(CASE WHEN type='SV' THEN 
							CASE WHEN datepart(dd, st.date) >= 8 AND datepart(dd, st.date) <= 15  THEN (Qty + Bonus) ELSE 0 END
						ELSE 0 END),
	SaleValue_Week2  = ROUND(SUM(CASE WHEN type='SV' THEN 
							CASE WHEN datepart(dd, st.date) >= 8 AND datepart(dd, st.date) <= 15  THEN 
								CASE :ai_Pricetype WHEN 1 THEN value
								WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
								WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
								ELSE ROUND(I.AVGPRICE, 2) * (Qty + Bonus) END ELSE 0 END ELSE 0 END), 0),
	SaleQty_Week3  = SUM(CASE WHEN type='SV' THEN 
							CASE WHEN datepart(dd, st.date) >= 16 AND datepart(dd, st.date) <= 23  THEN (Qty + Bonus) ELSE 0 END
						ELSE 0 END),
	SaleValue_Week3  = ROUND(SUM(CASE WHEN type='SV' THEN 
							CASE WHEN datepart(dd, st.date) >= 16 AND datepart(dd, st.date) <= 23  THEN 
								CASE :ai_Pricetype WHEN 1 THEN value
								WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
								WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
								ELSE ROUND(I.AVGPRICE, 2) * (Qty + Bonus) END ELSE 0 END ELSE 0 END), 0),
	SaleQty_Week4  = SUM(CASE WHEN type='SV' THEN 
							CASE WHEN datepart(dd, st.date) >= 24 AND datepart(dd, st.date) <= 31  THEN (Qty + Bonus) ELSE 0 END
						ELSE 0 END),
	SaleValue_Week4  = ROUND(SUM(CASE WHEN type='SV' THEN 
							CASE WHEN datepart(dd, st.date) >= 24 AND datepart(dd, st.date) <= 31  THEN 
								CASE :ai_Pricetype WHEN 1 THEN value
								WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
								WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
								ELSE ROUND(I.AVGPRICE, 2) * (Qty + Bonus) END ELSE 0 END ELSE 0 END), 0),
	SRetQty	 = SUM(CASE WHEN type='SR' THEN (Qty + Bonus) ELSE 0 END),
	SRetValue = ROUND(SUM(CASE WHEN type='SR' THEN 
						CASE :ai_Pricetype WHEN 1 THEN value
						WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
						WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
						ELSE ROUND(I.AVGPRICE, 2) * (Qty + Bonus) END ELSE 0 END), 0),
	IssueQty  =SUM(CASE WHEN type='IV' THEN (Qty + Bonus) ELSE 0 END),
	IssueValue=SUM(CASE WHEN type='IV' THEN 
						CASE :ai_Pricetype WHEN 1 THEN value
						WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
						WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
						ELSE ROUND(I.AVGPRICE, 2) * (Qty + Bonus) END ELSE 0 END),
	DueSatisfyQty  =SUM(CASE WHEN type='DS' THEN (Qty + Bonus) ELSE 0 END),
	DueSatisfyValue=SUM(CASE WHEN type='DS' THEN 
						CASE :ai_Pricetype WHEN 1 THEN value
						WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
						WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
						ELSE ROUND(I.AVGPRICE, 2) * (Qty + Bonus) END ELSE 0 END),
	ReceiptQty=SUM(CASE WHEN type='RV' THEN (Qty + Bonus) ELSE 0 END),
	ReceiptValue=SUM(CASE WHEN type='RV' THEN 
						CASE :ai_Pricetype WHEN 1 THEN value
						WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
						WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
						ELSE ROUND(I.AVGPRICE, 2) * (Qty + Bonus) END ELSE 0 END),
	AdjQty	  =SUM(CASE WHEN type='AI' THEN (Qty + Bonus) 
								WHEN type='AD' THEN -(Qty + Bonus)
								ELSE 0 END),
	AdjValue  =SUM(CASE  WHEN type='AI' THEN 
										(CASE :ai_Pricetype WHEN 1 THEN value
										WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
										WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
										ELSE ROUND(I.AVGPRICE, 2) * (Qty + Bonus) END)
								WHEN type='AD' THEN 
										-(CASE :ai_Pricetype WHEN 1 THEN value
										WHEN 2 THEN ROUND(I.SALEPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
										WHEN 3 THEN ROUND(I.PURPRICE / CASE I.PACKUNITS WHEN 0 THEN 1 ELSE I.PACKUNITS END, 2) * (Qty + Bonus)
										ELSE ROUND(I.AVGPRICE, 2) * (Qty + Bonus) END)
								ELSE 0 END)
FROM
	Item I
	LEFT OUTER JOIN 
	(SELECT type='OP', icode, date=null, qty = sum(qty), bonus = 0, value=0
	FROM	(select	pd.icode, qty = sum(isnull(case pl.purcatcode 
														when 1 THEN (packqty + bonusqty) * packunits
														when 2 THEN (packqty + bonusqty) * packunits
														else looseqty + bonusqty end, 0))
	FROM purledger pl, purdetail pd
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
	      pl.date < :ad_startdate
	Group By pd.icode
	UNION ALL
	select	pd.icode,
		qty  = - sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits)
	FROM prledger pl, prdetail pd
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
	      pl.date < :ad_startdate
	Group By pd.icode
	UNION ALL
	select	sd.icode,
		qty  = -sum(sd.looseqty + sd.bonusqty)
	FROM saleledger sl, saledetail sd
	WHERE /*sl.posted = 'Y' AND*/ sl.saleinvcode = sd.saleinvcode AND
	      sl.date < :ad_startdate AND sd.Due IS NULL
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = sum(sd.looseqty + sd.bonusqty)
	FROM srledger sl, srdetail sd
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
	      sl.date < :ad_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = -sum(sd.qty)
	FROM issueheader sl, issuedetail sd
	WHERE /*sl.posted = 'Y' AND*/ sl.issueinvcode = sd.issueinvcode AND
	      sl.date < :ad_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = sum(sd.qty)
	FROM receiptheader sl, receiptdetail sd
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	      sl.date < :ad_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty = sum(sd.looseqty)
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
	      sl.date < :ad_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty = -sum(sd.looseqty)
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
	      sl.date < :ad_startdate
	Group By sd.icode
	UNION ALL
	select	d.icode,
		qty = -sum(d.duesatisfyqty)
	FROM duesatisfyheader h, duesatisfydetail d
	WHERE h.duesatisfycode=d.duesatisfycode AND
	      h.duesatisfydate < :ad_startdate
	Group By d.icode) A
	GROUP BY icode
	UNION ALL
	select	type='PV',
		pd.icode,
		pl.date,
		qty = sum(looseqty + packqty * packunits),
		bonus = sum(isnull(case pl.purcatcode 
			when 1 THEN bonusqty * packunits
			when 2 THEN bonusqty * packunits
			else bonusqty
			end, 0)),
		value = sum(isnull(case pl.purcatcode 
			when 1 THEN (packqty + bonusqty)
			when 2 THEN (packqty + bonusqty)
			else looseqty + bonusqty 
			end, 0) * pd.purprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01))
	FROM purledger pl, purdetail pd
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pl.date >= :ad_startdate and pl.date <= :ad_enddate
	Group By pd.icode, pl.date
	UNION ALL
	select	type='PR',
		pd.icode,
		pl.date,
		qty = sum(pd.looseqty + pd.packqty * pd.packunits),
		bonus = sum(bonusqty),
		value = sum((pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits) *
			pd.prprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01))
	FROM prledger pl, prdetail pd
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
	      pl.date >= :ad_startdate and pl.date <= :ad_enddate
	Group By pd.icode, pl.date
	UNION ALL
	select	type='SV',
		sd.icode,
		sl.date,
		qty = sum(sd.looseqty),
		bonus = sum(bonusqty),
		value = sum((sd.looseqty + sd.bonusqty) *
			(sd.saleprice - sd.itemflatdisc) * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01))
	FROM saleledger sl, saledetail sd, zone z, zoneareas za, customer c
	WHERE 
		z.zonecode = :ai_zonecode AND
		z.zonecode = za.zonecode AND 
		za.areacode = c.areacode AND
		c.custcode = sl.custcode AND 
		sl.posted = 'Y' AND 
		sl.date BETWEEN :ad_startdate and :ad_enddate AND
		sl.saleinvcode = sd.saleinvcode AND 
		SD.Due IS NULL
	Group By sd.icode, sl.date
	UNION ALL
	select	type='SR',
		sd.icode,
		sl.date,
		qty = sum(sd.looseqty),
		bonus = sum(bonusqty),
		value = sum((sd.looseqty + sd.bonusqty) *
			sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01))
	FROM srledger sl, srdetail sd, zone z, zoneareas za, customer c
	WHERE 
		z.zonecode = :ai_zonecode AND
		z.zonecode = za.zonecode AND 
		za.areacode = c.areacode AND
		c.custcode = sl.custcode AND 
		sl.posted = 'Y' AND 
		sl.date BETWEEN :ad_startdate and :ad_enddate AND
		sl.srinvcode = sd.srinvcode
	Group By sd.icode, sl.date
	UNION ALL
	select	type='IV',
		sd.icode,
		sl.date,
		qty = sum(sd.qty),
		bonus = 0,
		value = sum(sd.qty * sd.saleprice)
	FROM issueheader sl, issuedetail sd
	WHERE sl.posted = 'Y' AND sl.issueinvcode = sd.issueinvcode AND
	      sl.date >= :ad_startdate and sl.date <= :ad_enddate
	Group By sd.icode, sl.date
	UNION ALL
	select	type='DS',
		d.icode,
		date=h.duesatisfydate,
		qty = sum(d.duesatisfyqty),
		bonus = 0,
		value = sum(d.duesatisfyqty * (d.packsaleprice / case d.packunits when 0 then 1 else d.packunits end))
	FROM duesatisfyheader h, duesatisfydetail d
	WHERE h.duesatisfycode = d.duesatisfycode AND
	      h.duesatisfydate >= :ad_startdate and h.duesatisfydate <= :ad_enddate
	Group By d.icode, h.duesatisfydate
	UNION ALL
	select	type='RV',
		sd.icode,
		sl.date,
		qty = sum(sd.qty),
		bonus = 0,
		value = sum(sd.qty * sd.saleprice)
	FROM receiptheader sl, receiptdetail sd
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	      sl.date >= :ad_startdate and sl.date <= :ad_enddate
	Group By sd.icode, sl.date
	UNION ALL
	select	type='AI',
		sd.icode,
		sl.date,
		qty = sum(sd.looseqty),
		bonus = 0,
		value = sum(sd.looseqty * sd.price)
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
	      sl.date >= :ad_startdate and sl.date <= :ad_enddate
	Group By sd.icode, sl.date
	UNION ALL
	select	type='AD',
		sd.icode,
		sl.date,
		qty = sum(sd.looseqty),
		bonus = 0,
		value = sum(sd.looseqty * sd.price)
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
	      sl.date >= :ad_startdate and sl.date <= :ad_enddate
	Group By sd.icode, sl.date
	UNION ALL
	SELECT type='OP', icode, date=null, qty = 0, bonus = 0, value=0 FROM ITEM) AS St ON (I.ICode = ST.ICode), 
	itemcategory ic
WHERE 
	i.active=1 and
	(CASE :as_GroupCriteria 
		WHEN 'M' THEN I.MANFCODE
		WHEN 'C' THEN I.ICatCode
		WHEN 'L' THEN I.ICCode
		ELSE I.PACKCODE END) IN (:ai_groupcode) and 
		i.icatcode = ic.icatcode
GROUP BY 
	St.icode, 
	i.name, 
	i.customicode, 
	i.icatcode, 
	i.iccode,
	i.manfcode,
	i.packcode,
	i.saleprice, 
	i.purprice, 
	i.avgprice, 
	i.packunits
ORDER BY 
	groupname, groupcode, itemname, aliasname, icode
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_groupcode", numberlist), ("ai_pricetype", number), ("as_groupcriteria", string), ("ai_zonecode", number))
 sort="groupname A, itemname A"
)
