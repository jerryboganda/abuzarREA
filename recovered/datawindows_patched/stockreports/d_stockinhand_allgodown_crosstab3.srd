release 12.5;
datawindow ( units=0 timer_interval=0 processing=4 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes grid.lines=1 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no crosstab.dynamic=yes)
header[1](height=344 color="536870912" )
header[2](height=72 color="536870912" )
summary(height=88 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=groupname dbname="groupname"  )
column=(type=char(20) updatewhereclause=yes name=godown dbname="godown"  )
column=(type=number updatewhereclause=yes name=stock dbname="stock"  )
 retrieve="SELECT 
	gcode=Code1, 
	Godown=Name1, 
	GroupCode=Code2, 
	GroupName=Name2, 
	ItemCode=Code3, 
	ItemName=left(Name3,15), 
	AliasName=Name4, 
	Stock=Value3, 
	StockinPack=Value4, 
	StockValue=Value5 
	
FROM 
	REPORTDATA
ORDER BY
	GroupName,
	Godown,
	ItemName"
  arguments=(("as_grouping", string), ("ai_pricetype", number))
 sort="groupname A, godown A"
)
group(level=1 header.height=80 trailer.height=84 by=("groupname"  ) header.color="536870912" trailer.color="536870912" )
text(name=t_5 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-12" font.pitch="2" font.weight="700" background.mode="2" background.color="16777215" color="0" alignment="0" border="0" x="27" y="16" height="68" width="1143" text="Godown Wise Stock in Hand" html.valueishtml="0" )
compute(name=c_companyname visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" x="27" y="96" height="64" width="1138" format="[GENERAL]" expression="f_ReportHeaderInfo('clientname')" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_address1 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" x="23" y="172" height="64" width="1152" format="[GENERAL]" expression="f_ReportHeaderInfo('address1')" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_address2 visible="1" moveable=1 band=background font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" x="23" y="248" height="64" width="1152" format="[GENERAL]" expression="f_ReportHeaderInfo('address2')" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
text(name=t_1 visible="1" band=header[1] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="0" border="0" x="9" y="4" height="64" width="5" text="Sum Of Stock" html.valueishtml="0" )
text(name=groupname_t visible="1" band=header[2] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="0" border="0" x="9" y="4" height="64" width="5" text="Groupname" html.valueishtml="0" )
text(name=godown_t visible="1" band=header[2] font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" alignment="0" border="0" x="23" y="4" height="64" width="421" text="Godown" html.valueishtml="0" )
text(name=stock_t visible="1" band=header[2] font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-8" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" alignment="0" border="0" x="453" y="4" height="60" width="379" text="@itemname" html.valueishtml="0" )
text(name=grand_sum_stock_t visible="1" band=header[2] font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-9" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" alignment="1" border="0" x="841" y="4" height="64" width="334" text="Grand Total " html.valueishtml="0" )
compute(name=compute_4 visible="1" band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="9" y="4" height="76" width="5" format="[general]" expression="~"Grand Total~"" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_5 visible="1" band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="453" y="4" height="76" width="379" format="[general]" expression="sum(stock for all )" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_6 visible="1" band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="841" y="4" height="76" width="334" format="[general]" expression="sum(grand_sum_stock for all )" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
column(name=groupname visible="1" band=detail id=1 x="9" y="4" height="76" width="5" color="33554432" border="0" alignment="0" format="[general]" html.valueishtml="0" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=no edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=100 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
column(name=godown visible="1" band=detail id=2 x="23" y="4" height="76" width="421" color="33554432" border="0" alignment="0" format="[general]" html.valueishtml="0" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=no edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=100 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-8" font.pitch="2" font.weight="400" tabsequence=0 )
column(name=stock visible="1" band=detail id=3 x="453" y="4" height="76" width="379" color="33554432" border="0" alignment="0" format="[general]" html.valueishtml="0" edit.focusrectangle=no edit.autohscroll=yes edit.autoselect=no edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=yes background.mode="1" background.color="536870912" font.charset="0" font.face="Times New Roman" font.family="2" font.height="-10" font.pitch="2" font.weight="400" tabsequence=0 )
compute(name=grand_sum_stock visible="1" band=detail font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="841" y="4" height="76" width="334" format="[general]" expression="crosstabsum(1)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
crosstab(columns="itemname" rows="groupname, godown" values="sum(stock for crosstab)" sourcenames = "gcode, godown, groupcode, groupname, itemcode, itemname, aliasname, stock, stockinpack, stockvalue" crosstabonly=yes  band=foreground )
compute(name=compute_7 visible="1" band=header.1 font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-8" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="23" y="4" height="64" width="421" format="[GENERAL]" expression=" groupname " alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_1 visible="1" band=trailer.1 font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="9" y="4" height="76" width="5" format="[general]" expression="groupname + ~" Total~"" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_2 visible="1" band=trailer.1 font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="453" y="4" height="76" width="379" format="[general]" expression="sum(stock for group 1)" alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=compute_3 visible="1" band=trailer.1 font.charset="0" font.face="Arial" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="33554432" x="841" y="4" height="76" width="334" format="[general]" expression="sum(grand_sum_stock for group 1)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
sparse(names="groupname")
htmltable(border="0" cellPadding="1" cellSpacing="1" )
htmlgen(clientComputedFields="1" clientEvents="1" clientFormatting="0" clientScriptable="0" clientValidation="1" encodeSelfLinkArgs="1" generateJavaScript="1" netscapeLayers="0" pagingMethod=0 )
