release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=614 color="536870912" )
detail(height=208 color="536870912"  height.autosize=yes)
table(column=(type=long updatewhereclause=yes name=saleinvcode dbname="Saleinvcode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="CustomerAlias"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="City"  )
column=(type=char(60) updatewhereclause=yes name=saleperson dbname="SalePerson"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="Saledetail.ICode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Saledetail.Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Saledetail.Expiry"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(162) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(123) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
 retrieve=" SELECT  
	Saleinvcode=sl.saleinvcode, 
	Date=sl.Date, 
	CustomerAlias=A.AliasName, 
	Customer=A.Name, 
	City=C.City, 
	SalePerson = (SELECT SM.Name FROM Salesman SM WHERE SM.SalesManCode = SL.SManCode),
	UserName = (SELECT U.UserName FROM Users U WHERE U.UserCode = SL.SalesmanCode),
	SD.ICode, 
	SD.Batch, 
	SD.Expiry, 
	AliasName = I.CustomICode,
	Item = I.Name + CASE WHEN SD.SaleItemDescription IS NULL OR SD.SaleItemDescription = '' THEN '' ELSE CHAR(13) + CHAR(10) + SD.SaleItemDescription END,
	Godown = G.Name + ' - ' + G.Location,
	Packing=MAX(I.packingdesc),
	SUM(SD.looseQty) AS Qty, 
	SUM(SD.BonusQty) AS Bonus,
	Manufacturer = M.Name
FROM
	Saledetail SD,
	SaleLedger SL,
	Customer C,
	Accounts A,
	Manufacturer M,
	Item	I,
	Godown G
WHERE 
	SL.SaleInvCode = :ai_invCode AND
	SL.CustCode = C.CustCode AND
	C.CustCode = A.AccCode AND
	SL.SaleInvCode = SD.SaleInvcode AND
	SD.ICode = I.ICode AND
	I.ManfCode = M.ManfCode AND
	SD.GCode = G.GCode AND	
	SD.GCode NOT IN 
		(SELECT TOP 1 GCode=Min(GCode)
		FROM GroupAllowedGodown
		WHERE Module = 1 AND GroupCode=:ai_groupcode
		GROUP BY Priority)
GROUP BY
	SL.SaleInvCode,
	SL.Date,
	A.AliasName, 
	A.Name, 
	C.City, 
	SL.SManCode,
	SL.SalesmanCode,
	SD.ICode, 
	SD.GCode,
	SD.Batch, 
	SD.Expiry,
	SD.SaleItemDescription,
	M.Name,
	I.Name,
	I.CustomICode,
	G.Name,
	G.Location
ORDER BY
	G.Name,
	I.Name,
	I.CustomICode,
	SD.Batch,
	SD.Expiry"
  arguments=(("ai_invcode", number), ("ai_groupcode", number))
)
