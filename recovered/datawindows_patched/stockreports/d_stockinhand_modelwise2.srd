release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1729 color="536870912" )
summary(height=427 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
column=(type=char(100) updatewhereclause=yes name=model dbname="Model"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=colour dbname="Colour"  )
column=(type=char(60) updatewhereclause=yes name=size dbname="Size"  )
column=(type=char(0) updatewhereclause=yes name=totalstock dbname="TotalStock"  )
column=(type=char(60) updatewhereclause=yes name=godown1 dbname="Godown1"  )
column=(type=char(60) updatewhereclause=yes name=godown2 dbname="Godown2"  )
column=(type=decimal(4) updatewhereclause=yes name=godown1stock dbname="Godown1Stock"  )
column=(type=decimal(4) updatewhereclause=yes name=godown2stock dbname="Godown2Stock"  )
column=(type=decimal(4) updatewhereclause=yes name=othergodownsstock dbname="OthergodownsStock"  )
 retrieve="Select 	ItemName = I.Name,
			PackingDesc = I.PackingDesc,
			Model = MO.Name,
			Manufacturer = M.Name,
			Category = ICat.Name,
			Colour = C.Name,
	       	Size = S.Name,
			TotalStock = '',
			Godown1 = IsNull( (Select Name From Godown Where Gcode = 1) , '' ) ,
			Godown2 = IsNull( (Select Name From Godown Where Gcode = 2) , '' ),
			Godown1Stock = dbo.Fn_GetItemStockInGodowns(I.icode,1,1),
			Godown2Stock = dbo.Fn_GetItemStockInGodowns(I.icode,2,2),
			OthergodownsStock = dbo.Fn_GetItemStockInGodowns(I.icode,3,(Select Max(Gcode) From Godown) )

From		Item I, Manufacturer M, ItemCategory ICat, ItemClass C, ItemSize S, ItemInModel IM, Model MO

Where 	I.manfcode = M.manfcode AND
			I.iccode = C.iccode AND
			I.icatcode = ICat.icatcode AND
			ICat.icatcode IN ( :ai_itemcategories ) AND
			I.isizecode = S.ISizeCode AND
			I.icode = IM.icode AND
			IM.modelcode IN (Select Min(modelcode) From ItemInModel Where ItemInModel.icode = I.Icode AND modelcode IN (:ai_models)) AND
			IM.modelcode = MO.modelcode
		

"
  arguments=(("ai_itemcategories", numberlist), ("ai_models", numberlist))
 sort="category A, model A, itemname A"
)
