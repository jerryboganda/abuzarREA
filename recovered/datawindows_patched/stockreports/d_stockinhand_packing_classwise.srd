header[2](height=108 color="536870912" )
header[3](height=92 color="536870912" )
summary(height=84 color="536870912" )
footer(height=0 color="536870912" )
detail(height=88 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=name dbname="name"  )
column=(type=char(20) updatewhereclause=yes name=customicode dbname="customicode"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(20) updatewhereclause=yes name=class dbname="class"  )
column=(type=number updatewhereclause=yes name=unitprice dbname="unitprice"  )
column=(type=number updatewhereclause=yes name=qty dbname="qty"  )
column=(type=number updatewhereclause=yes name=val dbname="val"  )
 retrieve="select  qty=case when sum(godowndetail.currqty) is null then 0
            else sum(godowndetail.currqty) 
            end,
        packing=(select itempacking.name from itempacking where packcode=:ai_packcode),
        item.customicode,
       item.name,
       item.packunits,
       item.purprice,
       unitprice=item.purprice/item.packunits,
       godown=(select godown.name from godown where godown.gcode=1),
       class=itemclass.name

from 
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode),
	itemclass

where item.packcode=:ai_packcode and
      item.iccode=:ai_classcode and
      itemclass.iccode=item.iccode and
      godowndetail.gcode=1

group by item.name,
         item.customicode,
         item.purprice,
         item.packunits,
         itemclass.name

union all

select qty=case when sum(godowndetail.currqty) is null then 0
           else sum(godowndetail.currqty) 
           end,
        packing=(select itempacking.name from itempacking where packcode=:ai_packcode),
        item.customicode,
       item.name,
       item.packunits,
      
       item.purprice,
       unitprice=item.purprice/item.packunits,
       godown=(select godown.name from godown where godown.gcode=2),
       class=itemclass.name

from 
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode),
	itemclass

where item.packcode=:ai_packcode and
      item.iccode=:ai_classcode and
      itemclass.iccode=item.iccode and
      godowndetail.gcode=2

group by item.name,
         item.customicode,
         item.purprice,
    
         item.packunits,
         itemclass.name



union all

select qty=case when sum(godowndetail.currqty) is null then 0
           else sum(godowndetail.currqty) 
           end,
        packing=(select itempacking.name from itempacking where packcode=:ai_packcode),
       item.customicode,
       item.name,
       
       item.packunits,
       item.purprice,
       unitprice=item.purprice/item.packunits,
       godown=(select godown.name from godown where godown.gcode=3),
       class=itemclass.name

from 
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode),
	itemclass

where item.packcode=:ai_packcode and
      item.iccode=:ai_classcode and
      itemclass.iccode=item.iccode and
      godowndetail.gcode=3

group by item.name,
         item.customicode,
         item.purprice,
         
         item.packunits,
         itemclass.name"
  arguments=(("ai_packcode", number), ("ai_classcode", number))
 sort="name A, customicode A, packing A, class A, unitprice A"
)
