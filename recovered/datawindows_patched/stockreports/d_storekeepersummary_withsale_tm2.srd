compute(name=c_amount visible="0" band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="812" y="10" height="156" width="416" format="[GENERAL]" expression="(  looseqty *  saledetail_saleprice -  looseqty *  itemflatdisc )  *  ( 1 -  (   saledetail_discperc  * .01 )  ) " alignment="0" border="0" html.valueishtml="0" crosstab.repeat=no )
