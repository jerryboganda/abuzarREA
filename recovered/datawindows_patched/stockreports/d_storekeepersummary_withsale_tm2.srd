compute(name=c_nettotal visible="1	if(getrow() = rowcount(), 1, 0)" band=summary font.charset="0" font.face="Times New Roman" font.family="1" font.height="-11" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="1645" y="20" height="156" width="1020" format="###0.00" expression=" Round(Sum (  c_netamount for all ) -  saleledger_flatdisc  +  saleledger_misccharges  + saleledger_salestax , 0) " alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
