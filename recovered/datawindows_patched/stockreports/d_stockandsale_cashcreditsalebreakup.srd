table(column=(type=long key=yes updatewhereclause=yes name=icode dbname="Item.Icode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=decimal(13) updatewhereclause=yes name=purprice dbname="PurPrice"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(13) updatewhereclause=yes name=stockrate dbname="StockRate"  )
column=(type=decimal(4) updatewhereclause=yes name=openqty dbname="openqty"  )
column=(type=decimal(6) updatewhereclause=yes name=openvalue dbname="openvalue"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(4) updatewhereclause=yes name=purbonus dbname="PurBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalue dbname="PurValue"  )
column=(type=decimal(4) updatewhereclause=yes name=pretqty dbname="PRetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=pretbonus dbname="PRetBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=pretvalue dbname="PRetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=cashsaleqty dbname="CashSaleQty"  )
column=(type=decimal(4) updatewhereclause=yes name=creditsaleqty dbname="CreditSaleQty"  )
column=(type=decimal(4) updatewhereclause=yes name=cashsalebonus dbname="CashSaleBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=creditsalebonus dbname="CreditSaleBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=cashgrosssale dbname="CashGrossSale"  )
column=(type=decimal(6) updatewhereclause=yes name=creditgrosssale dbname="CreditGrossSale"  )
column=(type=decimal(6) updatewhereclause=yes name=cashsalevalue dbname="CashSaleValue"  )
column=(type=decimal(6) updatewhereclause=yes name=creditsalevalue dbname="CreditSaleValue"  )
column=(type=decimal(4) updatewhereclause=yes name=cashsretqty dbname="CashSRetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=creditsretqty dbname="CreditSRetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=cashsretbonus dbname="CashSRetBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=creditsretbonus dbname="CreditSRetBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=cashgrosssret dbname="CashGrossSRet"  )
column=(type=decimal(6) updatewhereclause=yes name=creditgrosssret dbname="CreditGrossSRet"  )
column=(type=decimal(6) updatewhereclause=yes name=cashsretvalue dbname="CashSRetValue"  )
column=(type=decimal(6) updatewhereclause=yes name=creditsretvalue dbname="CreditSRetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=issueqty dbname="IssueQty"  )
column=(type=decimal(6) updatewhereclause=yes name=issuevalue dbname="IssueValue"  )
column=(type=decimal(4) updatewhereclause=yes name=duesatisfyqty dbname="DueSatisfyQty"  )
column=(type=decimal(6) updatewhereclause=yes name=duesatisfyvalue dbname="DueSatisfyValue"  )
column=(type=decimal(4) updatewhereclause=yes name=receiptqty dbname="ReceiptQty"  )
column=(type=decimal(6) updatewhereclause=yes name=receiptvalue dbname="ReceiptValue"  )
column=(type=decimal(4) updatewhereclause=yes name=adjqty dbname="AdjQty"  )
column=(type=decimal(6) updatewhereclause=yes name=adjvalue dbname="AdjValue"  )
 retrieve="SELECT  
	St.Icode,  
	AliasName= i.customicode, 
	Item = i.name, 
	packingdesc=max(i.packingdesc), 
	GroupCode    = CASE :as_grouptype WHEN 'M' THEN I.ManfCode WHEN 'C' THEN I.ICatCode WHEN 'L' THEN I.ICCode ELSE I.PACKCODE END,
	GroupName    = CASE :as_grouptype WHEN 'M' THEN (SELECT M.NAME FROM MANUFACTURER M WHERE M.MANFCODE  = I.ManfCode) WHEN 'C' THEN (SELECT C.NAME FROM ITEMCATEGORY C WHERE C.ICATCODE  = I.ICatCode) WHEN 'L' THEN (SELECT C.NAME FROM ITEMCLASS C WHERE C.ICCODE  = I.ICCode) 	ELSE (SELECT P.NAME FROM ITEMPACKING P WHERE P.PACKCODE  = I.PACKCODE) END,
	PurPrice = Round(i.Purprice/case when i.packunits > 0 THEN i.packunits ELSE 1 END, 2),
	SalePrice = Round(i.saleprice/case when i.packunits > 0 THEN i.packunits ELSE 1 END, 2),
	StockRate = CASE WHEN :ai_stockprice =1 THEN Round(i.saleprice/case when i.packunits > 0 THEN i.packunits ELSE 1 END, 2) ELSE i.Avgprice END,
	openqty	  =SUM(CASE WHEN type='OP' THEN qty ELSE 0 END),
	openvalue =SUM(CASE WHEN type='OP' THEN value ELSE 0 END),
	PurQty 	  =SUM(CASE WHEN type='PV' THEN qty ELSE 0 END),
	PurBonus  =SUM(CASE WHEN type='PV' THEN bonus ELSE 0 END),
	PurValue  =SUM(CASE WHEN type='PV' THEN value ELSE 0 END),
	PRetQty	  =SUM(CASE WHEN type='PR' THEN qty ELSE 0 END),
	PRetBonus =SUM(CASE WHEN type='PR' THEN bonus ELSE 0 END),
	PRetValue =SUM(CASE WHEN type='PR' THEN value ELSE 0 END),

	CashSaleQty =SUM(CASE WHEN type='SVC' THEN qty ELSE 0 END),
	CreditSaleQty =SUM(CASE WHEN type='SVR' THEN qty ELSE 0 END),

	CashSaleBonus =SUM(CASE WHEN type='SVC' THEN bonus ELSE 0 END),
	CreditSaleBonus =SUM(CASE WHEN type='SVR' THEN bonus ELSE 0 END),

	CashGrossSale =SUM(CASE WHEN type='SVC' THEN Gross ELSE 0 END),
	CreditGrossSale =SUM(CASE WHEN type='SVR' THEN Gross ELSE 0 END),

	CashSaleValue =SUM(CASE WHEN type='SVC' THEN value ELSE 0 END),
	CreditSaleValue =SUM(CASE WHEN type='SVR' THEN value ELSE 0 END),

	CashSRetQty	  =SUM(CASE WHEN type='SRC' THEN qty ELSE 0 END),
	CreditSRetQty	  =SUM(CASE WHEN type='SRR' THEN qty ELSE 0 END),

	CashSRetBonus =SUM(CASE WHEN type='SRC' THEN bonus ELSE 0 END),
	CreditSRetBonus =SUM(CASE WHEN type='SRR' THEN bonus ELSE 0 END),

	CashGrossSRet	  =SUM(CASE WHEN type='SRC' THEN Gross ELSE 0 END),
	CreditGrossSRet	  =SUM(CASE WHEN type='SRR' THEN Gross ELSE 0 END),

	CashSRetValue =SUM(CASE WHEN type='SRC' THEN value ELSE 0 END),
	CreditSRetValue =SUM(CASE WHEN type='SRR' THEN value ELSE 0 END),

	IssueQty  =SUM(CASE WHEN type='IV' THEN qty ELSE 0 END),
	IssueValue=SUM(CASE WHEN type='IV' THEN value ELSE 0 END),
	DueSatisfyQty  =SUM(CASE WHEN type='DS' THEN qty ELSE 0 END),
	DueSatisfyValue=SUM(CASE WHEN type='DS' THEN value ELSE 0 END),
	ReceiptQty=SUM(CASE WHEN type='RV' THEN qty ELSE 0 END),
	ReceiptValue=SUM(CASE WHEN type='RV' THEN value ELSE 0 END),
	AdjQty	  =SUM(CASE WHEN type='AI' THEN qty 
								WHEN type='AD' THEN -qty 
								ELSE 0 END),
	AdjValue  =SUM(CASE  WHEN type='AI' THEN value 
								WHEN type='AD' THEN -value  
								ELSE 0 END)
FROM
	(SELECT type='OP', icode, qty = sum(qty), bonus = 0, value=0, gross=0
	FROM	(select	pd.icode, qty = sum(isnull(case pl.purcatcode 
														when 1 THEN (packqty + bonusqty) * packunits
														when 2 THEN (packqty + bonusqty) * packunits
														else looseqty + bonusqty end, 0))
	FROM purledger pl, purdetail pd
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
	      pl.date < :adt_startdate
	Group By pd.icode
	UNION ALL
	select	pd.icode,
		qty  = - sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits)
	FROM prledger pl, prdetail pd
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
	      pl.date < :adt_startdate
	Group By pd.icode
	UNION ALL
	select	sd.icode,
		qty  = -sum(sd.looseqty + sd.bonusqty)
	FROM saleledger sl, saledetail sd
	WHERE /*sl.posted = 'Y' AND*/ sl.saleinvcode = sd.saleinvcode AND
	      sl.date < :adt_startdate AND sd.Due IS NULL
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = sum(sd.looseqty + sd.bonusqty)
	FROM srledger sl, srdetail sd
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
	      sl.date < :adt_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = -sum(sd.qty)
	FROM issueheader sl, issuedetail sd
	WHERE /*sl.posted = 'Y' AND*/ sl.issueinvcode = sd.issueinvcode AND
	      sl.date < :adt_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty  = sum(sd.qty)
	FROM receiptheader sl, receiptdetail sd
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	      sl.date < :adt_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty = sum(sd.looseqty)
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
	      sl.date < :adt_startdate
	Group By sd.icode
	UNION ALL
	select	sd.icode,
		qty = -sum(sd.looseqty)
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
	      sl.date < :adt_startdate
	Group By sd.icode
	UNION ALL
	select	d.icode,
		qty = -sum(d.duesatisfyqty)
	FROM duesatisfyheader h, duesatisfydetail d
	WHERE h.duesatisfycode=d.duesatisfycode AND
	      h.duesatisfydate < :adt_startdate
	Group By d.icode) A
	GROUP BY icode
	UNION ALL
	select	type='PV',
		pd.icode,
		qty = sum(looseqty + packqty * packunits),
		bonus = sum(isnull(case pl.purcatcode 
			when 1 THEN bonusqty * packunits
			when 2 THEN bonusqty * packunits
			else bonusqty
			end, 0)),
		value = sum(isnull(case pl.purcatcode 
			when 1 THEN packqty
			when 2 THEN packqty
			else looseqty
			end, 0) * pd.purprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01)), 
		gross=0
	FROM purledger pl, purdetail pd
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pl.date >= :adt_startdate and pl.date <= :adt_enddate
	Group By pd.icode
	UNION ALL
	select	type='PR',
		pd.icode,
		qty = sum(pd.looseqty + pd.packqty * pd.packunits),
		bonus = sum(bonusqty),
		value = sum(pd.looseqty * pd.prprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01)), 
		gross=0
	FROM prledger pl, prdetail pd
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
	      pl.date >= :adt_startdate and pl.date <= :adt_enddate
	Group By pd.icode
	UNION ALL
	select	type='SVC',
		sd.icode,
		qty = sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus = sum(bonusqty),
		value = sum((sd.looseqty + sd.packqty * sd.packunits) *
			(sd.saleprice - sd.itemflatdisc) * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
		gross= sum(sd.looseqty * sd.saleprice)
	FROM saleledger sl, saledetail sd
	WHERE /*sl.posted = 'Y' AND */ sl.salecatcode = 3 AND 
		sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
		sl.date >= :adt_startdate and sl.date <= :adt_enddate
	Group By sd.icode
	UNION ALL
	select	type='SVR',
		sd.icode,
		qty = sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus = sum(bonusqty),
		value = sum((sd.looseqty + sd.packqty * sd.packunits) *
			(sd.saleprice - sd.itemflatdisc) * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
		gross= sum(sd.looseqty * sd.saleprice)
	FROM saleledger sl, saledetail sd
	WHERE /*sl.posted = 'Y' AND */ sl.salecatcode <> 3 AND 
		sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
		sl.date >= :adt_startdate and sl.date <= :adt_enddate
	Group By sd.icode
	UNION ALL
	select	type='SRC',
		sd.icode,
		qty = sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus = sum(bonusqty),
		value = sum((sd.looseqty + sd.packqty * sd.packunits) *
			sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
		gross = sum(sd.looseqty * sd.srprice)
	FROM srledger sl, srdetail sd
	WHERE sl.SRCatCode = 8 AND
		sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
		sl.date >= :adt_startdate and sl.date <= :adt_enddate
	Group By sd.icode
	UNION ALL
	select	type='SRR',
		sd.icode,
		qty = sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus = sum(bonusqty),
		value = sum((sd.looseqty + sd.packqty * sd.packunits) *
			sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
		gross = sum(sd.looseqty * sd.srprice)
	FROM srledger sl, srdetail sd
	WHERE sl.SRCatCode <> 8 AND
		sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
		sl.date >= :adt_startdate and sl.date <= :adt_enddate
	Group By sd.icode
	UNION ALL
	select	type='IV',
		sd.icode,
		qty = sum(sd.qty),
		bonus = 0,
		value = sum(sd.qty * sd.saleprice),
		gross=0
	FROM issueheader sl, issuedetail sd
	WHERE /*sl.posted = 'Y' AND */ sl.issueinvcode = sd.issueinvcode AND
	      sl.date >= :adt_startdate and sl.date <= :adt_enddate
	Group By sd.icode
	UNION ALL
	select	type='DS',
		d.icode,
		qty = sum(d.duesatisfyqty),
		bonus = 0,
		value = sum(d.duesatisfyqty * (d.packsaleprice / case d.packunits when 0 then 1 else d.packunits end)),
		gross=0
	FROM duesatisfyheader h, duesatisfydetail d
	WHERE h.duesatisfycode = d.duesatisfycode AND
	      h.duesatisfydate >= :adt_startdate and h.duesatisfydate <= :adt_enddate
	Group By d.icode
	UNION ALL
	select	type='RV',
		sd.icode,
		qty = sum(sd.qty),
		bonus = 0,
		value = sum(sd.qty * sd.saleprice),
		gross=0
	FROM receiptheader sl, receiptdetail sd
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	      sl.date >= :adt_startdate and sl.date <= :adt_enddate
	Group By sd.icode
	UNION ALL
	select	type='AI',
		sd.icode,
		qty = sum(sd.looseqty),
		bonus = 0,
		value = sum(sd.looseqty * sd.price),
		gross=0
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
	      sl.date >= :adt_startdate and sl.date <= :adt_enddate
	Group By sd.icode
	UNION ALL
	select	type='AD',
		sd.icode,
		qty = sum(sd.looseqty),
		bonus = 0,
		value = sum(sd.looseqty * sd.price),
		gross=0
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
	      sl.date >= :adt_startdate and sl.date <= :adt_enddate
	Group By sd.icode
	UNION ALL
	SELECT type='OP', icode, qty = 0, bonus = 0, value=0, gross=0 FROM ITEM) St, 
	Item i
WHERE 
	st.icode = i.icode and
	CASE :as_grouptype 
		WHEN 'M' THEN I.MANFCODE 
		WHEN 'C' THEN I.ICatCode 
		WHEN 'L' THEN I.ICCode 
		ELSE I.PACKCODE 
	END IN (:ai_groupcode)
GROUP BY 
	St.icode, i.name, i.customicode, i.Manfcode, i.ICatCode, i.ICCode, i.PackCode, i.PurPrice, i.saleprice, i.packunits, i.avgprice
"
  update="Item" updatewhere=0 updatekeyinplace=no
  arguments=(("as_grouptype", string), ("ai_groupcode", numberlist), ("adt_startdate", datetime), ("adt_enddate", datetime), ("ai_stockprice", number))
 sort="groupname A, item A"
)
group(level=1 header.height=187 trailer.height=281 by=("groupname"  ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.length="100" header.gradient.repetition.count="0" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.length="100" trailer.gradient.repetition.count="0" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" )
