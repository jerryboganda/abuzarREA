table(column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="QTY"  )
column=(type=char(150) updatewhereclause=yes name=genericitem dbname="GenericItem"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="supplier"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=purdiscperc dbname="purdiscperc"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
column=(type=decimal(6) updatewhereclause=yes name=stockvalue dbname="StockValue"  )
 retrieve="SELECT 
	Item.Name,  
	aliasname=item.customicode, 
	Item.PackUnits,   
	QTY = isnull((SELECT sum(GD.CurrQty) FROM GodownDetail GD WHERE GD.ICode=Item.ICode), 0),   
	GenericItem = GenericItem.Name,
	Manufacturer=(SELECT M.Name FROM Manufacturer M WHERE Item.ManfCode=M.ManfCode),
	supplier=(SELECT A.Name
		FROM
			PurDetail D,
			PurLedger P,
			Accounts A
		WHERE
			T.UTN = D.PurUtn AND
			D.PurInvCode = P.PurInvCode AND
			P.SuppCode = A.AccCode),
	saleprice = item.saleprice,
	purprice = item.purprice,
	purdiscperc=max(item.purdiscperc),
	UnitPrice = Case :ai_pricetype
						WHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
						WHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
						WHEN 3 THEN Round(max(Item.avgprice), 2)
					END ,
	StockValue = isnull((SELECT sum(GD.CurrQty) FROM GodownDetail GD WHERE GD.ICode=Item.ICode), 0) *
					 Case :ai_pricetype
						 WHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
						 WHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
						 WHEN 3 THEN Round(max(Item.avgprice), 2)
					END
FROM
	GenericItem,
	Item
	LEFT OUTER JOIN 
	(SELECT PD.ICode, UTN=MAX(PD.PurUTN)
	FROM Purledger PL, PurDetail PD
	WHERE
		PL.Posted = 'Y' AND
		PD.PurInvCode = PL.PurInvCode AND
		PD.ICode IN (SELECT I.ICode FROM Item I WHERE I.GenericCode IN (:genericcode)) 
	GROUP BY PD.ICode) AS T ON (Item.ICode = T.ICode)
	
WHERE 
	( Item.GenericCode IN (:genericcode) ) AND
	( Item.GenericCode = GenericItem.GenericCode ) and
	( Item.active=1)
GROUP BY 
	Item.ICode,
	Item.name,
	item.customicode, 
	Item.Active,
	Item.purprice, 
	Item.PackUnits, 
	GenericItem.name,
	Item.ManfCode,
	Item.saleprice,
	T.Utn
ORDER By 
	genericitem,
	item.name
"
  arguments=(("genericcode", numberlist), ("ai_pricetype", number))
)
