release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=500 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1593 color="536870912" )
summary(height=1135 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=decimal(4) updatewhereclause=yes name=icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleval dbname="saleval"  )
column=(type=decimal(4) updatewhereclause=yes name=saltisfyqty dbname="saltisfyqty"  )
column=(type=decimal(2) updatewhereclause=yes name=satisfyval dbname="satisfyval"  )
column=(type=decimal(4) updatewhereclause=yes name=saleretqty dbname="saleretqty"  )
column=(type=decimal(2) updatewhereclause=yes name=salereturnval dbname="SaleReturnval"  )
column=(type=decimal(4) updatewhereclause=yes name=purchaseqty dbname="purchaseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=purval dbname="purval"  )
column=(type=decimal(4) updatewhereclause=yes name=purchasereturnqty dbname="purchasereturnqty"  )
column=(type=decimal(2) updatewhereclause=yes name=purretval dbname="PurRetVal"  )
column=(type=decimal(4) updatewhereclause=yes name=adjincreaseqty dbname="adjincreaseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=adjincreaseval dbname="AdjIncreaseVal"  )
column=(type=decimal(4) updatewhereclause=yes name=adjdecreaseqty dbname="adjdecreaseqty"  )
column=(type=decimal(2) updatewhereclause=yes name=adjdecreaseval dbname="AdjDecreaseVal"  )
column=(type=decimal(4) updatewhereclause=yes name=issueqty dbname="Issueqty"  )
column=(type=decimal(2) updatewhereclause=yes name=issueval dbname="Issueval"  )
column=(type=decimal(4) updatewhereclause=yes name=receiptqty dbname="receiptqty"  )
column=(type=decimal(2) updatewhereclause=yes name=receiptval dbname="receiptval"  )
column=(type=char(100) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) updatewhereclause=yes name=alisname dbname="alisname"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="category"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(4) updatewhereclause=yes name=itemopeningstock dbname="itemopeningstock"  )
 retrieve="  select icode=code10,
			saleqty = code1,
			saleval=Round(value1, 0),
			saltisfyqty=code2,
			satisfyval=Round(value2, 0),
			saleretqty=code3,
			SaleReturnval=Round(value3, 0),
			purchaseqty=code4,
			purval=Round(value4, 0),
			purchasereturnqty=code5,
			PurRetVal=Round(value5, 0),
			adjincreaseqty=code6,
			AdjIncreaseVal=Round(value6, 0),
			adjdecreaseqty=code7,
			AdjDecreaseVal=Round(value7, 0),
			Issueqty=code8,
			Issueval=Round(value8, 0),
			receiptqty=code9,
			receiptval=Round(value9, 0),
			itemname=name1,
			alisname=name2,
			active=(SELECT CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END FROM ITEM WHERE Item.ICODE = reportdata.Code10),
			/*category=itemcategory.name,*/
			category=(select name from itemcategory where icatcode=reportdata.code11),
			saleprice=(select Round(saleprice/CASE WHEN PackUnits > 0 THEN PackUnits ELSE 1 END,2) from item where item.icode=reportdata.code10),
			
			
               
			itemopeningstock= (select isnull(sum(Case When purledger.purcatcode IN (3, 7, 8)  THEN
                        							 purdetail.looseqty + purdetail.bonusqty
															 Else (purdetail.packqty  + purdetail.bonusqty) * purdetail.packunits 
                                              END),0)
									from purdetail,purledger 
									where purledger.postdate < :ar_StartDate and 
											purledger.posted='Y'and
		     							   purledger.purinvcode=purdetail.purinvcode and
		      							purdetail.icode=reportdata.code10
		  									 ) 

									-

		

	     						(select isnull(sum(saledetail.looseqty),0) from saledetail,saleledger 
		 							where saleledger.date < :ar_StartDate and 
		      							saleledger.saleinvcode=saledetail.saleinvcode and
                                 saledetail.due IS NULL and
		       							saledetail.icode=reportdata.code10)
								-
								(select isnull(sum(duesatisfydetail.duesatisfyqty),0) from duesatisfyheader,duesatisfydetail
								 where duesatisfyheader.duesatisfydate<:ar_Startdate and
										 duesatisfyheader.duesatisfycode=duesatisfydetail.duesatisfycode and
										 duesatisfydetail.icode=reportdata.code10)
											
	     						- 
								
								(select isnull(sum(issuedetail.qty),0) from issuedetail , issueheader
	        						where    issueheader.date < :ar_StartDate and 
	        									issueheader.issueinvcode=issuedetail.issueinvcode and 
												issuedetail.icode=reportdata.code10)
								 +

								(select isnull(sum(receiptdetail.qty),0) from receiptdetail , receiptheader
	        						where    receiptheader.date < :ar_StartDate and 
												receiptheader.posted='Y' and
	        									receiptheader.receiptinvcode=receiptdetail.receiptinvcode and 
												receiptdetail.icode=reportdata.code10)
								
								 +

								(select isnull(sum(Case when adjheader.adjcatcode=1 then
			    									 adjdetail.looseqty 
											ELSE 
			      								(-1) * adjdetail.looseqty
											END ),0)
	      					from adjdetail,adjheader 
	     						where adjheader.date <:ar_StartDate  and
		    							adjheader.adjcode=adjdetail.adjcode and
		   							adjdetail.icode=Reportdata.code10)
	    						 +


								(select isnull(sum(srdetail.looseqty),0) from srdetail,srledger 
								 where srledger.date < :ar_StartDate and 
										srledger.srinvcode=srdetail.srinvcode and 
										srdetail.icode=reportdata.code10)
	    						 -



								(select isnull(sum(prdetail.looseqty + prdetail.bonusqty),0)
	      						from prdetail,prledger 
	      						where prledger.date < :ar_StartDate and
		    								prledger.prinvcode=prdetail.prinvcode and
		    								prdetail.icode=reportdata.code10)
from reportdata

where reportdata.code11 IN (:ar_manfcode)
		/*reportdata.code11=itemcategory.icatcode*/
order by category,
			reportdata.name1"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("ar_manfcode", numberlist))
)
