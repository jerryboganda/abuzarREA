release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1656 color="536870912" )
summary(height=218 color="536870912" )
footer(height=0 color="536870912" )
detail(height=156 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemName"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="class"  )
column=(type=char(60) updatewhereclause=yes name=manf dbname="manf"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(13) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long updatewhereclause=yes name=code dbname="Code"  )
column=(type=long updatewhereclause=yes name=closingstock dbname="closingstock"  )
column=(type=long updatewhereclause=yes name=others1 dbname="others1"  )
column=(type=decimal(4) updatewhereclause=yes name=openingstock dbname="openingstock"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="PurQty"  )
column=(type=decimal(4) updatewhereclause=yes name=purbonus dbname="PurBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=prqty dbname="PRQty"  )
column=(type=decimal(4) updatewhereclause=yes name=prbonus dbname="PRBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="SaleQty"  )
column=(type=decimal(4) updatewhereclause=yes name=salebonus dbname="SaleBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=srqty dbname="SRQty"  )
column=(type=decimal(4) updatewhereclause=yes name=srbonus dbname="SRBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=issueqty dbname="IssueQty"  )
column=(type=decimal(4) updatewhereclause=yes name=duesatisfyqty dbname="DueSatisfyQty"  )
column=(type=decimal(4) updatewhereclause=yes name=receiptqty dbname="ReceiptQty"  )
column=(type=decimal(4) updatewhereclause=yes name=adjincqty dbname="AdjIncQty"  )
column=(type=decimal(4) updatewhereclause=yes name=adjdecqty dbname="AdjDecQty"  )
 retrieve="SELECT
	AliasName= i.customicode,
	itemName = i.name,
	active=CASE max(i.active) WHEN 1 THEN 'Y' ELSE 'N' END,
	Category = ic.Name,
	packingdesc=max(i.packingdesc),
	class=(select name from itemclass where itemclass.iccode=max(i.iccode)),
	manf=(select name from manufacturer where manufacturer.manfcode=max(i.manfcode)),
	saleprice=(i.saleprice/case i.packunits when 0 then 1 else i.packunits end),
	purprice=(i.purprice/case i.packunits when 0 then 1 else i.packunits end),
	icode=St.Icode,
	Code = i.icatcode,
	closingstock=0,
	others1=0,
	openingstock	  =SUM(CASE WHEN type='OP' THEN qty ELSE 0 END),
	PurQty 	  =SUM(CASE WHEN type='PV' THEN qty ELSE 0 END),
	PurBonus  =SUM(CASE WHEN type='PV' THEN bonus ELSE 0 END),
	PRQty	  =SUM(CASE WHEN type='PR' THEN qty ELSE 0 END),
	PRBonus =SUM(CASE WHEN type='PR' THEN bonus ELSE 0 END),
	SaleQty	  =SUM(CASE WHEN type='SV' THEN qty ELSE 0 END),
	SaleBonus =SUM(CASE WHEN type='SV' THEN bonus ELSE 0 END),
	SRQty	  =SUM(CASE WHEN type='SR' THEN qty ELSE 0 END),
	SRBonus =SUM(CASE WHEN type='SR' THEN bonus ELSE 0 END),
	IssueQty  =SUM(CASE WHEN type='IV' THEN qty ELSE 0 END),
	DueSatisfyQty  =SUM(CASE WHEN type='DS' THEN qty ELSE 0 END),
	ReceiptQty=SUM(CASE WHEN type='RV' THEN qty ELSE 0 END),
	AdjIncQty	  =SUM(CASE WHEN type='AI' THEN qty WHEN type='AD' THEN 0 ELSE 0 END),
	AdjDecQty	  =SUM(CASE WHEN type='AI' THEN 0 WHEN type='AD' THEN qty ELSE 0 END)
FROM
	(SELECT type='OP', icode, qty = sum(qty), bonus = 0, value=0,bonusval=0
	FROM	(select	pd.icode, qty = sum(isnull(case pl.purcatcode when 1 THEN (packqty + bonusqty) * packunits
								      when 2 THEN (packqty + bonusqty) * packunits
								      else looseqty + bonusqty end, 0))
		FROM purledger pl, purdetail pd
		WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
	      		pl.date < :ar_startdate
		Group By pd.icode
	
		UNION ALL
		select	pd.icode,qty  = - sum(pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits)
		FROM prledger pl, prdetail pd
		WHERE /*pl.posted = 'Y' AND*/ pl.prinvcode = pd.prinvcode AND
	      		pl.date < :ar_startdate
		Group By pd.icode
	
		UNION ALL
		select	sd.icode,qty  = -sum(sd.looseqty + sd.bonusqty)
		FROM saleledger sl, saledetail sd
		WHERE /*sl.posted = 'Y' AND*/ sl.saleinvcode = sd.saleinvcode AND
	      		sl.date < :ar_startdate AND sd.Due IS NULL
		Group By sd.icode
	
		UNION ALL
		select	sd.icode,qty  = sum(sd.looseqty + sd.bonusqty)
		FROM srledger sl, srdetail sd
		WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
	      	      sl.date < :ar_startdate
		Group By sd.icode
	
		UNION ALL
		select	sd.icode,qty  = -sum(sd.qty)
		FROM issueheader sl, issuedetail sd
		WHERE /*sl.posted = 'Y' AND*/ sl.issueinvcode = sd.issueinvcode AND
	      		sl.date < :ar_startdate
		Group By sd.icode
	
		UNION ALL
		select	sd.icode,qty  = sum(sd.qty)
		FROM receiptheader sl, receiptdetail sd
		WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	      		sl.date < :ar_startdate
		Group By sd.icode
	
		UNION ALL
		select	sd.icode,qty = sum(sd.looseqty)
		FROM Adjheader sl, Adjdetail sd
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
	      		sl.date < :ar_startdate
		Group By sd.icode
	
		UNION ALL
		select	sd.icode,qty = -sum(sd.looseqty)
		FROM Adjheader sl, Adjdetail sd
		WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
	      		sl.date < :ar_startdate
		Group By sd.icode
	
		UNION ALL
		select	d.icode,qty = -sum(d.duesatisfyqty)
		FROM duesatisfyheader h, duesatisfydetail d
		WHERE h.duesatisfycode=d.duesatisfycode AND
	      		h.duesatisfydate < :ar_startdate
		Group By d.icode) A
	GROUP BY icode

	UNION ALL
	select	type='PV',
		pd.icode,
		qty = sum(looseqty + packqty * packunits),
		bonus = sum(isnull(case pl.purcatcode 
			when 1 THEN bonusqty * packunits
			when 2 THEN bonusqty * packunits
			else bonusqty
			end, 0)),
		value = sum(isnull(case pl.purcatcode 
			when 1 THEN (packqty + bonusqty)
			when 2 THEN (packqty + bonusqty)
			else looseqty + bonusqty 
			end, 0) * pd.purprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01)),
			bonusval=0
	FROM purledger pl, purdetail pd
	WHERE pl.posted = 'Y' AND pl.purinvcode = pd.purinvcode AND
		pl.date >= :ar_startdate and pl.date <= :ar_enddate
	Group By pd.icode
	
	UNION ALL
	select	type='PR',
		pd.icode,
		qty = sum(pd.looseqty + pd.packqty * pd.packunits),
		bonus = sum(bonusqty),
		value = sum((pd.looseqty + pd.bonusqty + pd.packqty * pd.packunits) *
			pd.prprice * (1 - pd.discperc * 0.01) * (1 - pl.discperc * 0.01)),
		bonusval=0
	FROM prledger pl, prdetail pd
	WHERE pl.posted = 'Y' AND pl.prinvcode = pd.prinvcode AND
	      pl.date >= :ar_startdate and pl.date <= :ar_enddate
	Group By pd.icode
	UNION ALL
	select	type='SV',
		sd.icode,
		qty = sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus = sum(bonusqty),
		value = sum((sd.looseqty + sd.packqty * sd.packunits) *
			sd.saleprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
		bonusval=sum(sd.bonusqty*sd.saleprice)
	FROM saleledger sl, saledetail sd
	WHERE /*sl.posted = 'Y' AND */ sl.saleinvcode = sd.saleinvcode AND SD.Due IS NULL AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='SV',
		sd.icode,
		qty = (-1)*sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus =(-1)* sum(bonusqty),
		value = (-1)*sum((sd.looseqty + sd.packqty * sd.packunits) *
			sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
		bonusval=(-1)*sum(sd.bonusqty*sd.srprice)
	FROM srledger sl, srdetail sd
	WHERE /*sl.posted = 'Y' AND */ sl.srinvcode = sd.srinvcode  AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='SR',
		sd.icode,
		qty = sum(sd.looseqty + sd.packqty * sd.packunits),
		bonus = sum(bonusqty),
		value = sum((sd.looseqty + sd.packqty * sd.packunits) *
			sd.srprice * (1 - sd.discperc * 0.01) * (1 - sl.discperc * 0.01)),
		bonusval=0
	FROM srledger sl, srdetail sd
	WHERE sl.posted = 'Y' AND sl.srinvcode = sd.srinvcode AND
	      sl.postdate >= :ar_startdate and sl.postdate <= :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='IV',
		sd.icode,
		qty = sum(sd.qty),
		bonus = 0,
		value = sum(sd.qty * sd.saleprice),
		bonusval=0
	FROM issueheader sl, issuedetail sd
	WHERE /*sl.posted = 'Y' AND */ sl.issueinvcode = sd.issueinvcode AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='DS',
		d.icode,
		qty = sum(d.duesatisfyqty),
		bonus = 0,
		value = sum(d.duesatisfyqty * (d.packsaleprice / case d.packunits when 0 then 1 else d.packunits end)),
		bonusval=0
	FROM duesatisfyheader h, duesatisfydetail d
	WHERE h.duesatisfycode = d.duesatisfycode AND
	      h.duesatisfydate >= :ar_startdate and h.duesatisfydate <= :ar_enddate
	Group By d.icode
	
	UNION ALL
	select	type='RV',
		sd.icode,
		qty = sum(sd.qty),
		bonus = 0,
		value = sum(sd.qty * sd.saleprice),
		bonusval=0
	FROM receiptheader sl, receiptdetail sd
	WHERE sl.posted = 'Y' AND sl.receiptinvcode = sd.receiptinvcode AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='AI',
		sd.icode,
		qty = sum(sd.looseqty),
		bonus = 0,
		value = sum(sd.looseqty * sd.price),
		bonusval=0
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 1 AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate
	Group By sd.icode
	UNION ALL
	select	type='AD',
		sd.icode,
		qty = sum(sd.looseqty),
		bonus = 0,
		value = sum(sd.looseqty * sd.price),
		bonusval=0
	FROM Adjheader sl, Adjdetail sd
	WHERE sl.posted = 'Y' AND sl.Adjcode = sd.Adjcode and sl.Adjcatcode = 2 AND
	      sl.date >= :ar_startdate and sl.date <= :ar_enddate
	Group By sd.icode
	
	UNION ALL
	SELECT type='OP', icode, qty = 0, bonus = 0, value=0,bonusval=0 FROM ITEM) St, 
	
	Item i, 
	itemcategory ic

WHERE st.icode = i.icode and
		i.icatcode in (:aa_catcode) and 
		i.icatcode = ic.icatcode
GROUP BY St.icode, i.name, i.customicode, i.icatcode, ic.Name, i.saleprice, i.packunits,i.purprice
HAVING SUM(CASE WHEN type='OP' THEN qty ELSE 0 END)>0  
ORDER BY i.name, i.customicode,ic.name, i.icatcode,  St.icode
"
  arguments=(("ar_StartDate", datetime), ("ar_EndDate", datetime), ("aa_catcode", numberlist))
 filter="(openingstock + purqty + purbonus  - prqty - prbonus - saleqty - salebonus  - issueqty  +  receiptqty  -  duesatisfyqty  +  adjincqty - adjdecqty)=0"
 )
