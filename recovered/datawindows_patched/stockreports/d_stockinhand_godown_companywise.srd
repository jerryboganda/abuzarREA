release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=488 color="536870912" )
summary(height=84 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=godown dbname="godown"  )
column=(type=long updatewhereclause=yes name=i_icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="customicode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory_name dbname="name"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="name"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
 retrieve="SELECT 
	godown=(SELECT name FROM godown WHERE gcode=:ai_gcode),
	I.ICode,
	I.customicode,   
	I.Name,
	active=CASE I.active WHEN 1 THEN 'Y' ELSE 'N' END,
	I.PackUnits,   
	ItemCategory.name, 
	Manufacturer.name,
	I.purprice,
	stock = Case When Sum(G.CurrQty) IS NULL then 0 Else Sum(G.CurrQty) End,
	UnitPrice = Round(I.purprice / CASE WHEN I.PackUnits > 0 THEN I.PackUnits ELSE 1 END, 2)

FROM 
	(SELECT * FROM Item where item.manfcode=:al_manfcode) AS I
	LEFT OUTER JOIN 
	(SELECT * FROM GodownDetail WHERE gcode=:ai_gcode) AS G ON (I.ICode = G.ICode),
	ItemCategory,   
	Manufacturer  
WHERE 

	(  I.icatCode = ItemCategory.icatcode ) and
	(I.manfcode = manufacturer.manfcode)  
GROUP BY 
	Manufacturer.name, 
	ItemCategory.Name,
	I.ICode,
	I.customicode,
	I.Name,
	I.active,
	I.purprice,
	I.PackUnits
Order By 
	Manufacturer.name, 
	I.Name"
  arguments=(("ai_gcode", number), ("ll_icatcode", number), ("al_manfcode", number))
)
