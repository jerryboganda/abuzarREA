release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=476 color="536870912" )
summary(height=308 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.CustomICode"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.Name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=long updatewhereclause=yes name=minqty dbname="Item.MinQty"  )
column=(type=char(20) updatewhereclause=yes name=groupname dbname="Groupname"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="Class"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(4) updatewhereclause=yes name=required dbname="Required"  )
column=(type=decimal(6) updatewhereclause=yes name=requiredvalue dbname="RequiredValue"  )
 retrieve="SELECT 
	Item.CustomICode,   
	Stock = isnull(SUM(GodownDetail.CurrQty),0),   
	Item.Name,   
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
   Item.MinQty,
	Groupname = CASE :as_type WHEN 'M' THEN ISNULL((SELECT Manufacturer.name FROM Manufacturer WHERE Manufacturer.ManfCode = item.manfcode), '')
			WHEN 'C' THEN ISNULL((SELECT ItemCategory.name FROM ItemCategory WHERE ItemCategory.ICatCode = item.icatcode), '')
			WHEN 'L' THEN ISNULL((SELECT ItemClass.name FROM ItemClass WHERE ItemClass.ICCode = item.iccode), '')
			ELSE ISNULL((SELECT itempacking.name FROM itempacking WHERE itempacking.PackCode = item.packcode), '') END,
	packing=ISNULL((SELECT itempacking.name FROM itempacking WHERE itempacking.PackCode = item.packcode), ''),
	Manufacturer=ISNULL((SELECT Manufacturer.name FROM Manufacturer WHERE Manufacturer.ManfCode = item.manfcode), ''),
	Category=ISNULL((SELECT ItemCategory.name FROM ItemCategory WHERE ItemCategory.ICatCode = item.icatcode), ''),
	Class=ISNULL((SELECT ItemClass.name FROM ItemClass WHERE ItemClass.ICCode = item.iccode), ''),
	purprice=item.purprice,
	Required= (Case WHEN isnull(SUM(GodownDetail.CurrQty),0)>=Item.MinQty THEN 0
					ELSE Item.MinQty - isnull(SUM(GodownDetail.CurrQty),0) END)	,
    RequiredValue= (Case WHEN isnull(SUM(GodownDetail.CurrQty),0)>=Item.MinQty THEN 0
					ELSE Item.MinQty - isnull(SUM(GodownDetail.CurrQty),0) END)	 * (item.purprice/(case when item.packunits = 0 then 1 else item.packunits end))

FROM 
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode),
	Manufacturer

WHERE
	( Item.ManfCode = Manufacturer.ManfCode ) and  
	CASE :as_type WHEN 'M' THEN Item.ManfCode
		WHEN 'C' THEN Item.ICatCode
		WHEN 'L' THEN Item.ICCode
				 ELSE Item.PackCode END in (:aa_code) 

GROUP BY 
	manufacturer.name,
	Item.CustomICode,   
	Item.Name,   
	Item.Active,
	Item.ManfCode,
	Item.PackCode,
	Item.ICCode,
	Item.ICatCode,
    Item.MinQty,
	Item.purprice,
    item.packunits

ORDER BY
	Groupname,
	item.name

"
  arguments=(("aa_code", numberlist), ("as_type", string))
 sort="groupname A"
)
