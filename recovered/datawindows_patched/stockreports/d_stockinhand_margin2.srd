release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1468 color="536870912" )
summary(height=447 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=groupcode dbname="GroupCode"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="Stock"  )
column=(type=decimal(13) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="FlatDisc"  )
column=(type=decimal(2) updatewhereclause=yes name=salediscperc dbname="SaleDiscPerc"  )
column=(type=decimal(6) updatewhereclause=yes name=purval2 dbname="purval2"  )
column=(type=decimal(13) updatewhereclause=yes name=purprice dbname="PurPrice"  )
column=(type=decimal(6) updatewhereclause=yes name=salesvalue dbname="SalesValue"  )
column=(type=decimal(6) updatewhereclause=yes name=purvalue dbname="PurValue"  )
column=(type=decimal(6) updatewhereclause=yes name=marginamount dbname="MarginAmount"  )
column=(type=decimal(6) updatewhereclause=yes name=marginpercentage dbname="MarginPercentage"  )
 retrieve="SELECT 
	GroupCode = CASE :as_reportgrouping 
								WHEN 'M' THEN I.ManfCode 
								WHEN 'P' THEN I.PackCode 
								WHEN 'L' THEN I.ICCode 
								ELSE I.ICatCode END,
	GroupName = CASE :as_reportgrouping 
								WHEN 'M' THEN M.Name
								WHEN 'P' THEN P.Name
								WHEN 'L' THEN L.Name
								ELSE C.Name END,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	Active=CASE I.Active WHEN 1 THEN 'Y' ELSE 'N' END,
	Stock = SUM(G.CurrQty),
	SalePrice=Round(I.SalePrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),
	FlatDisc=I.FlatDisc,
	SaleDiscPerc = I.SaleDiscPerc,
	purval2=Isnull(SUM(G.CurrQty),0) *Round(I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2),
	PurPrice=Round(CASE :ai_pricetype When 1 THEN ( I.RecentPurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) When 2 THEN (I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) ELSE I.AvgPrice END, 2),
	SalesValue = SUM(G.CurrQty) * (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)),
	PurValue = SUM(G.CurrQty) * 
		Round(
			CASE :ai_pricetype When 1 THEN 
				( I.RecentPurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) 
			When 2 THEN 
				(I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) 
			ELSE I.AvgPrice END, 2),
	MarginAmount = SUM(G.CurrQty) * (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) -
						SUM(G.CurrQty) * Round(CASE :ai_pricetype When 1 THEN ( I.RecentPurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) When 2 THEN (I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) ELSE I.AvgPrice END, 2),
	MarginPercentage = 
		Round(((SUM(G.CurrQty) * (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) - SUM(G.CurrQty) * Round(CASE :ai_pricetype When 1 THEN ( I.RecentPurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) When 2 THEN (I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) ELSE I.AvgPrice END, 2)) / 
		(CASE SUM(G.CurrQty) * Round(CASE :ai_margintype When 1 THEN (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) When 2 THEN (I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) ELSE (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) END, 2)
		WHEN 0 THEN 1 
		ELSE SUM(G.CurrQty) * Round(CASE :ai_margintype When 1 THEN (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) When 2 THEN (I.PurPrice / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END ) ELSE (Round(((I.SalePrice - I.FlatDisc) * (1 - I.SaleDiscPerc * 0.01)) / CASE I.PackUnits WHEN 0 THEN 1 ELSE I.PackUnits END, 2)) END, 2) END)) * 100, 2)
FROM 
	GodownDetail G, 
	Item I, 
	Manufacturer M, 
	ItemCategory C, 
	ItemClass L,
	ItemPacking P
WHERE
	G.ICode = I.ICode AND
	I.ManfCode = M.ManfCode AND
	I.ICatCode = C.ICatCode AND
	I.ICCode = L.ICCode AND
	I.PackCode = P.PackCode AND
	CASE :as_reportgrouping 
		WHEN 'M' THEN I.ManfCode 
		WHEN 'P' THEN I.PackCode 
		WHEN 'L' THEN I.ICCode 
		ELSE I.ICatCode END IN (:ai_grouplist)

GROUP BY
	I.CustomICode,
	I.Name,
	I.Active,
	I.SalePrice,
	I.PurPrice,
	I.FlatDisc,
	I.SaleDiscPerc,
	I.RecentPurPrice,
	I.AvgPrice,
	I.PackUnits,
	I.ManfCode, 
	I.PackCode,
	I.ICCode,
	I.ICatCode,
	M.Name,
	P.Name,
	L.Name,
	C.Name
ORDER BY
	GroupName,
	I.Name,
	I.CustomICode
"
  arguments=(("as_reportgrouping", string), ("ai_grouplist", numberlist), ("ai_pricetype", number), ("ai_margintype", number))
 sort="groupname A, itemname A, aliasname A"
)
