table(column=(type=long key=yes update=yes updatewhereclause=yes name=saleinvcode dbname="SaleLedger.Saleinvcode"  )
 retrieve="SELECT 
		Saleinvcode
FROM	Saleledger 
WHERE (Posted = Case :ar_postedunposted 
					 WHEN 'B' THEN 'Y'
					 WHEN 'Y' THEN 'Y'
	  				 WHEN 'N' THEN 'N'
		  			 ELSE 'Z'
					 END OR
		Posted = Case :ar_postedunposted 
					 WHEN 'B' THEN 'N'
					 WHEN 'Y' THEN 'Y'
		  			 WHEN 'N' THEN 'N'
		  			 ELSE 'Z'
					 END) AND
		SaleInvCode Between :ar_SinvCode AND :ar_LinvCode AND
		SalesManCode IN (:ar_usercode)
ORDER BY
		Saleinvcode
"
  update="Saleledger" updatewhere=1 updatekeyinplace=no
  arguments=(("ar_UserCode", numberlist), ("ar_postedunposted", string), ("ar_SinvCode", number), ("ar_LinvCode", number))
)
