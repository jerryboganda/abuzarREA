release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=468 color="536870912" )
summary(height=88 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=item_icode dbname="Item.ICode"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=char(60) updatewhereclause=yes name=classname dbname="ItemClass.name"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory_name dbname="ItemCategory.name"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.customicode"  )
column=(type=decimal(4) updatewhereclause=yes name=purchaseqty dbname="purchaseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
column=(type=decimal(6) updatewhereclause=yes name=stockvalue dbname="stockvalue"  )
 retrieve=" SELECT Item.ICode,   
       Item.Name,
		 active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
       Itemclass.name,
		 Item.PackUnits,   
	    ItemCategory.name, 
	    manufacturer=Manufacturer.name, 
		 purprice=Item.purprice,
		 Item.customicode,
		 purchaseqty =  
			ISNULL((SELECT Qty = SUM(CASE WHEN H.PurCatCode < 3 THEN (D.PackQty + D.BonusQty) * D.PackUnits ELSE LooseQty + BonusQty END)
			FROM PurDetail D, PurLedger H
			WHERE 
				D.ICode = item.ICode AND
				H.PurInvCode = D.PurInvCode AND 
				H.Posted = UPPER('Y') AND
				H.Date >= :ad_startdate AND H.Date <= :ad_enddate ),0),
		 stock = Case When Sum(GodownDetail.CurrQty) IS NULL then 0 Else Sum(GodownDetail.CurrQty) End,
		 UnitPrice = Case :ai_pricetype
								WHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
                     	WHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END,2)
                     	WHEN 3 THEN Round(max(Item.avgprice), 2)
                     END ,
		stockvalue= ISNULL(Sum(GodownDetail.CurrQty),0) *
							Case :ai_pricetype
								WHEN 2 THEN Round(Item.purprice / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
                     	WHEN 1 THEN Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
                     	WHEN 3 THEN Round(max(Item.avgprice), 2)
                     END 
 
FROM 
	  ItemCategory,   
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)
	LEFT OUTER JOIN ItemClass ON (Item.iccode=itemclass.iccode),
	  Manufacturer

WHERE 
      ( Item.IcatCode IN (:aa_icatcode) ) and
		( Item.icatCode = ItemCategory.icatcode ) and
		( item.manfcode = manufacturer.manfcode)  and
		( item.active=1 )

GROUP BY Manufacturer.name, 
			Item.ICode,
			Item.customicode,
			Item.Name,
			item.active,
			Item.purprice,
			ItemCategory.Name,
			Item.PackUnits,
			itemclass.name
			
Order By itemcategory.name,
			Item.Name"
  arguments=(("aa_icatcode", numberlist), ("ai_pricetype", number), ("ad_startdate", datetime), ("ad_enddate", datetime))
)
