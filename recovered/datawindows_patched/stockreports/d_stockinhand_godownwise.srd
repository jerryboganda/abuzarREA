release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=556 color="536870912" )
summary(height=100 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=godown_name dbname="Godown.name"  )
column=(type=long updatewhereclause=yes name=item_icode dbname="Item.ICode"  )
column=(type=char(75) updatewhereclause=yes name=customicode dbname="Item.customicode"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Item.Name"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory_name dbname="ItemCategory.name"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="Manufacturer.name"  )
column=(type=decimal(2) updatewhereclause=yes name=item_purprice dbname="Item.purprice"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
 retrieve=" SELECT 
	godown.name,
	Item.ICode,
	Item.customicode,   
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	Item.Name,
	Item.PackUnits,   
	ItemCategory.name, 
	Manufacturer.name,
	Item.purprice,
	stock = Case When Sum(GodownDetail.CurrQty) IS NULL then 0 Else Sum(GodownDetail.CurrQty) End,
	/* UnitPrice = Round(CASE :ai_pricetype WHEN 1 THEN Item.saleprice / Item.PackUnits WHEN 2 THEN Item.purprice / Item.PackUnits ELSE Item.avgprice END, 2)*/
	UnitPrice = Round(CASE :ai_pricetype WHEN 1 THEN Item.saleprice /(case Item.PackUnits when 0 then 1 else item.packunits end) WHEN 2 THEN Item.purprice / (case Item.PackUnits when 0 then 1 else item.packunits end) ELSE Item.avgprice END, 2)
FROM 
	ItemCategory,   
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode),
	Godown,
	Manufacturer  
WHERE 
	(godown.gcode=:ai_gcode) and 
	(GodownDetail.GCode=:ai_gcode) and
	(Item.icatCode = ItemCategory.icatcode) and
	(item.manfcode = manufacturer.manfcode) 
GROUP BY 
	godown.name,
	Manufacturer.name, 
	ItemCategory.Name,
	Item.ICode,
	Item.customicode,
	Item.Name,
	item.active,
	Item.purprice,
	Item.saleprice,
	Item.avgprice,
	Item.PackUnits		
Order By 
	Manufacturer.name, 
	Item.Name"
  arguments=(("ai_gcode", number), ("ll_icatcode", number), ("ai_pricetype", number))
)
