compute(name=compute_3 visible="1" band=detail font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="2853" y="8" height="60" width="329" format="	f_SetColumnFormat('Qty')" expression="if(currqty >c_forecast  ,currqty - c_forecast ,c_forecast -  currqty)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
