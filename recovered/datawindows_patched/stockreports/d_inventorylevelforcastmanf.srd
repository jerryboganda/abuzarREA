release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=716 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=char(60) updatewhereclause=yes name=categoryname dbname="categoryname"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(4) updatewhereclause=yes name=currqty dbname="currqty"  )
column=(type=long updatewhereclause=yes name=projection dbname="Projection"  )
 retrieve="SELECT  
		itemname = dbo.item.name,		
      itemcode = dbo.item.icode,
		active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	   categoryname = (Select Name from Manufacturer Where manfcode = :al_manfcode),	 
	   saleqty = Sum(dbo.saledetail.looseqty),		 
	   currqty = (Select  sum(currqty) 	
					from godowndetail 	
					where dbo.item.icode = godowndetail.icode),
	   Projection = :al_projection 
	
FROM dbo.saleledger,	 
	 dbo.saledetail,
	 dbo.item	

WHERE  dbo.saleledger.date >= :ad_StartDate and 	
 	   dbo.saleledger.date <= :ad_EndDate and 	
	   dbo.saleledger.salecatcode IN (1, 2, 3) and	 
	   dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode and	   
	   dbo.item.manfcode = :al_manfcode and	  
	   dbo.saledetail.icode = dbo.item.icode 
	 		 
GROUP BY saledetail.icode, 	
		item.name, item.icode, item.active"
  arguments=(("al_manfcode", number), ("ad_StartDate", datetime), ("ad_EndDate", datetime), ("al_Projection", number))
 filter=" c_excessorrequired = 'Required'"
 )
