compute(name=c_dailysale visible="1" band=detail font.charset="0" font.face="Arial Narrow" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="1851" y="4" height="60" width="302" format="	f_SetColumnFormat('Qty')" expression="truncate(saleqty / daysafter( ad_StartDate , ad_EndDate ),2)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
