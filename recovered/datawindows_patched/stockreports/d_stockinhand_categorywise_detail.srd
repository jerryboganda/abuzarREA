header(height=480 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=long updatewhereclause=yes name=item_icode dbname="Item.ICode"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory_name dbname="ItemCategory.name"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="Manufacturer.name"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="GodownDetail.batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="GodownDetail.expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
 retrieve="  SELECT Item.ICode,   
       Item.Name,   
		 active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	    ItemCategory.name, 
	    Manufacturer.name,
		 GodownDetail.batch,
		 GodownDetail.expiry,
       stock = Case When Sum(GodownDetail.CurrQty) IS NULL then 0 Else Sum(GodownDetail.CurrQty) End
FROM 
	ItemCategory,   
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode),
	Manufacturer  

WHERE 
      ( ( Item.IcatCode = :ll_icatcode) ) and
		(  Item.icatCode = ItemCategory.icatcode ) and
		(item.manfcode = manufacturer.manfcode)  

GROUP BY Manufacturer.name, 
			Item.ICode,
			Item.Name,
			item.active,
			ItemCategory.Name,
			GodownDetail.batch,
			GodownDetail.expiry

Order By Manufacturer.name, 
			Item.Name"
  arguments=(("ll_icatcode", number))
)
