release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1302 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="SoldQty"  )
column=(type=decimal(9) updatewhereclause=yes name=cgs dbname="CGS"  )
column=(type=decimal(6) updatewhereclause=yes name=salesvalue dbname="SalesValue"  )
column=(type=decimal(6) updatewhereclause=yes name=gp dbname="GP"  )
column=(type=decimal(6) updatewhereclause=yes name=gprate dbname="GPRate"  )
column=(type=decimal(4) updatewhereclause=yes name=stockinhand dbname="StockInHand"  )
column=(type=decimal(4) updatewhereclause=yes name=salereturn dbname="SaleReturn"  )
 retrieve="SELECT 
	ICode=I.ICode, 
	AliasName = I.CustomICode,
	ItemName = I.Name,
	Packing = I.PackingDesc, 
	Supplier = (SELECT A.Name FROM Accounts A WHERE A.AccCode IN (SELECT MIN(SI.SuppCode) FROM ItemSuppliers SI WHERE SI.ICode = I.ICode)),
	SoldQty = SUM(T.SoldQty), 
	CGS=SUM(T.CGS), 
	SalesValue = SUM(T.SalesValue),
	GP = SUM(T.SalesValue) - SUM(T.CGS),
	GPRate = ROUND(((SUM(T.SalesValue) - SUM(T.CGS)) / CASE WHEN SUM(T.SalesValue) = 0 THEN 1 ELSE SUM(T.SalesValue) END) * 100, 2),
	StockInHand=SUM(T.StockInHand),
	SaleReturn = SUM(T.SaleReturn)
FROM
	Item I,
	(SELECT 
		D.ICode, 
		SoldQty = SUM(D.LooseQty + D.BonusQty), 
		CGS=SUM((D.LooseQty + D.BonusQty) * D.AvgPrice), 
		SalesValue = SUM( D.LooseQty * (D.SalePrice - D.ItemFlatDisc) * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),
		StockInHand=0.000,
		SaleReturn = 0.0000
	FROM 
		SaleLedger S, SaleDetail D
	WHERE 
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SaleInvCode = D.SaleInvCode
	GROUP BY
		D.Icode
	UNION ALL
	SELECT 
		D.ICode, 
		SoldQty = -SUM(D.LooseQty + D.BonusQty), 
		CGS= - SUM((D.LooseQty + D.BonusQty) * D.AvgPrice), 
		SalesValue = - SUM( D.LooseQty * D.SalePrice * (1 - D.DiscPerc * 0.01) * (1 - S.DiscPerc * 0.01)),
		StockInHand=0.000,
		SaleReturn = SUM(D.LooseQty + D.BonusQty)
	FROM 
		SRLedger S, SRDetail D
	WHERE 
		S.Date BETWEEN :adt_startdate AND :adt_enddate AND
		S.SRInvCode = D.SRInvCode
	GROUP BY
		D.Icode
	UNION ALL
	SELECT 
		I.ICode, 
		SoldQty = 0.0000, 
		CGS=0.00000, 
		SalesValue = 0.00000,
		StockInHand= ISNULL((SELECT SUM(G.CurrQty) FROM GodownDetail G WHERE G.ICode = I.ICode), 0),
		SaleReturn = 0.0000
	FROM 
		Item I
	GROUP BY
		I.Icode) T
WHERE
	T.ICode = I.ICode
GROUP BY	
	I.ICode, 
	I.CustomICode,
	I.Name,
	I.PackingDesc
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="supplier A, itemname A"
)
