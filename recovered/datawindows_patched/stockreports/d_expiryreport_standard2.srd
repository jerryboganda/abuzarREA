release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=536 color="536870912" )
summary(height=104 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=char(75) updatewhereclause=yes name=item_customicode dbname="Item.CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=char(20) updatewhereclause=yes name=itempacking_name dbname="ItemPacking.Name"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="GodownDetail.Batch"  )
column=(type=datetime updatewhereclause=yes name=godowndetail_expiry dbname="GodownDetail.Expiry"  )
column=(type=decimal(5) updatewhereclause=yes name=item_avgprice dbname="Item.AvgPrice"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="GodownDetail.CurrQty"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=long updatewhereclause=yes name=manfcode dbname="Manfcode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="godown"  )
 retrieve="   SELECT Item.CustomICode,    
         Item.Name,   
			active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
         Item.PackUnits,   
         ItemPacking.Name,   
         GodownDetail.Batch,   
         GodownDetail.Expiry,   
         Item.AvgPrice,   
         GodownDetail.CurrQty,
			manufacturer=manufacturer.name  ,
			Manfcode=item.manfcode,
			gcode=godowndetail.gcode,
			godown=(select name from godown where gcode=godowndetail.gcode)
    FROM GodownDetail,   
		Item LEFT OUTER JOIN ItemPacking ON (item.packcode = ItemPacking.packcode),
         manufacturer
			  
   WHERE case :as_group when 'P' then item.packcode
						when 'C' THEN item.icatcode
						when 'L' THEN item.iccode
						when 'M' THEN item.manfcode  end  IN (:aa_manfcode) and
			( item.manfcode=manufacturer.manfcode)and
			( Item.ICode = GodownDetail.ICode ) and  
         ( ( GodownDetail.Expiry <= DateAdd(day, :ar_date, GetDate()) ) )    
 order by manufacturer.name  ,
			 Item.name

"
  arguments=(("ar_date", number), ("aa_manfcode", numberlist), ("as_group", string))
)
