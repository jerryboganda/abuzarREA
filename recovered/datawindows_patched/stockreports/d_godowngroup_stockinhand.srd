table(column=(type=char(60) updatewhereclause=yes name=godowngroup dbname="GodownGroup"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="GroupName"  )
column=(type=char(60) updatewhereclause=yes name=item_name dbname="Item.Name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="active"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="Item.purprice"  )
column=(type=long updatewhereclause=yes name=item_packunits dbname="Item.PackUnits"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="QTY"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer_name dbname="Manufacturer.name"  )
column=(type=char(60) updatewhereclause=yes name=classname dbname="classname"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
 retrieve="SELECT 
	GodownGroup=GodownGroup.Name,
	Godown=Godown.Name,
	GroupName=CASE :as_grouptype WHEN 'M' THEN Manufacturer.name WHEN 'C' THEN itemcategory.name WHEN 'P' THEN itemPacking.name ELSE itemclass.name END,
	Item.Name,  
	aliasname=item.customicode, 
	active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	Item.purprice,   
	Item.PackUnits,   
	QTY = isnull(sum(GodownDetail.CurrQty),0),   
	Manufacturer.name,
	classname=itemclass.name,
	Category=itemcategory.name,
	Packing=itempacking.name,
	PackingDesc=item.PackingDesc, 
	UnitPrice = Round(CASE :ai_pricetype WHEN 1 THEN Item.saleprice /(case Item.PackUnits when 0 then 1 else item.packunits end) WHEN 2 THEN Item.purprice / (case Item.PackUnits when 0 then 1 else item.packunits end) ELSE Item.avgprice END, 2)
FROM 
	GodownDetail,
	Godown,
	GodownGroup,
	Manufacturer,   
	Item 
	LEFT OUTER JOIN ItemPacking ON (item.packcode = ItemPacking.packcode)
	LEFT OUTER JOIN ItemClass ON (Item.iccode = itemclass.iccode),
	ItemCategory
WHERE 
	GodownGroup.GodownGroupCode = :ai_godowngroupcode AND
	GodownGroup.GodownGroupCode = Godown.GodownGroupCode AND
	Godown.GCode = GodownDetail.GCode AND
	Item.ICode = GodownDetail.ICode and  
	CASE :as_grouptype 
		WHEN 'M' THEN Item.ManfCode
		WHEN 'C' THEN Item.ICatCode 
		WHEN 'P' THEN item.PackCode 
		ELSE Item.ICCode END IN (:ai_groupcode) and
	Manufacturer.manfcode = Item.ManfCode and
	Item.icatcode=itemcategory.icatcode and
	Item.active=1
GROUP BY 
	GodownGroup.Name,
	Godown.Name,
	Item.name,
	item.customicode, 
	Item.Active,
	Item.purprice, 
	Item.PackUnits, 
	Manufacturer.name,
	itemcategory.name,
	Itemclass.name,
	itempacking.name,
	Item.PackingDesc,
	Item.SalePrice,
	Item.PurPrice,
	Item.AvgPrice
"
  arguments=(("ai_godowngroupcode", number), ("as_grouptype", string), ("ai_groupcode", numberlist), ("ai_pricetype", number))
 sort="godowngroup A, godown A, groupname A, item_name A"
)
