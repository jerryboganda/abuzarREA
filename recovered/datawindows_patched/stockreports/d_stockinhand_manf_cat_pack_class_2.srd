release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=400 color="536870912" )
summary(height=12 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912" )
table(column=(type=long updatewhereclause=yes name=item_icode dbname="Item.ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.Name"  )
column=(type=char(1) updatewhereclause=yes name=active dbname="Active"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.customicode"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(13) updatewhereclause=yes name=unitprice dbname="UnitPrice"  )
column=(type=decimal(6) updatewhereclause=yes name=stockvalue dbname="stockvalue"  )
 retrieve="SELECT
	Item.ICode,   
	Item.Name,
	Active=CASE item.active WHEN 1 THEN 'Y' ELSE 'N' END,
	Packing=ISNULL((SELECT ItemPacking.name FROM ItemPacking WHERE ItemPacking.PackCode = item.Packcode), ''),
	purprice=Item.purprice,
	Item.customicode,
	stock = Case When Sum(GodownDetail.CurrQty) IS NULL then 0 Else Sum(GodownDetail.CurrQty) End,
	UnitPrice = Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END,2),
	stockvalue= ISNULL(Sum(GodownDetail.CurrQty),0) * Round(max(Item.Saleprice) / CASE WHEN Item.PackUnits > 0 THEN Item.PackUnits ELSE 1 END, 2)
FROM
	Item
	LEFT OUTER JOIN GodownDetail ON (Item.ICode = GodownDetail.ICode)
WHERE 
	( Item.IcatCode IN (:aa_icatcode)  ) and
	( Item.ManfCode IN (:aa_manfcode)  ) and
	( Item.IcCode   IN (:aa_iccode)    ) and
	( Item.PackCode IN (:aa_packcode)  ) and
	(item.active=1)
GROUP BY 
	Item.ICode,
	Item.customicode,
	Item.Active,
	Item.Name,
	Item.Packcode,
	Item.purprice,
	Item.PackUnits
ORDER BY 
	Item.Name"
  arguments=(("aa_manfcode", numberlist), ("aa_icatcode", numberlist), ("aa_iccode", numberlist), ("aa_packcode", numberlist))
)
