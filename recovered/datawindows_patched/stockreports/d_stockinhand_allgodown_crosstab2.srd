table(column=(type=number updatewhereclause=yes name=groupcode dbname="groupcode"  )
column=(type=char(20) updatewhereclause=yes name=groupname dbname="groupname"  )
column=(type=char(20) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(20) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(20) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=number updatewhereclause=yes name=unitprice dbname="unitprice"  )
column=(type=number updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=char(20) updatewhereclause=yes name=group2 dbname="group2"  )
column=(type=char(20) updatewhereclause=yes name=group3 dbname="group3"  )
column=(type=char(20) updatewhereclause=yes name=group4 dbname="group4"  )
column=(type=number updatewhereclause=yes name=stock dbname="stock"  )
column=(type=number updatewhereclause=yes name=stockvalue dbname="stockvalue"  )
 retrieve="SELECT 
	gcode=Code1, 
	Godown=Name1, 
	GroupCode=Code2, 
	GroupName=Name2, 
	ItemCode=Code3, 
	ItemName=Name3, 
	AliasName=Name4, 
	PackingDesc=Name5, 
	UnitPrice=Value1, 
	PackUnits=Value2, 
	Stock=Value3, 
	StockinPack=Value4, 
	StockValue=Value5, 
	Group2=Name6, 
	Group3=Name7, 
	Group4=Name8
FROM 
	REPORTDATA
ORDER BY
	GroupName,
	Godown,
	ItemName,
	PackingDesc"
  arguments=(("as_grouping", string), ("ai_pricetype", number))
 sort="groupname A, packingdesc A, itemname A, aliasname A, unitprice A, packunits A, group2 A, group3 A, group4 A"
)
