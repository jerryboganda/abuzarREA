text(name=t_closingunits visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="33554432" alignment="1" border="0" x="9437" y="1052" height="333" width="500" text="Closing
Units" html.valueishtml="0" )
