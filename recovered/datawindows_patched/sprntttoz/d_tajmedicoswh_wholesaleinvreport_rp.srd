column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=datetime updatewhereclause=yes name=orderdate dbname="orderdate"  )
column=(type=decimal(4) updatewhereclause=yes name=totalqty dbname="totalqty"  )
