table(column=(type=char(100) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(40) updatewhereclause=yes name=department dbname="department"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="itemalias"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=long updatewhereclause=yes name=issueinvcode dbname="issueinvcode"  )
column=(type=char(60) updatewhereclause=yes name=salesperson dbname="smanname"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=decimal(5) updatewhereclause=yes name=price dbname="price"  )
column=(type=long updatewhereclause=yes name=issueheader_deptcode dbname="IssueHeader.deptcode"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="IssueHeader.remarks"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=saledetail_expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="looseqty"  )
column=(type=char(251) updatewhereclause=yes name=referenceno dbname="referenceno"  )
column=(type=datetime updatewhereclause=yes name=referencedate dbname="IssueHeader.referencedate"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="packing"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="itempacking"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=char(60) updatewhereclause=yes name=customeradd1 dbname="customeradd1"  )
column=(type=char(60) updatewhereclause=yes name=customeradd2 dbname="customeradd2"  )
column=(type=char(100) updatewhereclause=yes name=customerphone dbname="customerphone"  )
column=(type=char(50) updatewhereclause=yes name=custtaxregno dbname="custtaxregno"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="class"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="category"  )
 retrieve="  SELECT itemname=  Case When issuedetail.itemdescription IS Null OR RTrim(LTrim(issuedetail.itemdescription)) = '' THEN item.name Else issuedetail.itemdescription END, 
			department=(select dbo.department.name from dbo.department where dbo.department.deptcode=dbo.issueheader.deptcode),
			itemalias=item.customicode,
			salesman = dbo.users.username,  
			issueinvcode = dbo.issueheader.issueinvcode, 
			smanname=salesman.name,
         date = dbo.issueheader.date,
			price = Case ( Select DBO.Fn_Get_Int_Preference('IssuePriceInPrint') ) When 1 THEN issuedetail.saleprice When 2 THEN issuedetail.purchaseprice WHEN 3 THEN issuedetail.avgprice WHEN 4 THEN issuedetail.MRPP WHEN 5 THEN issuedetail.price END,
			dbo.issueheader.deptcode,
 			dbo.issueheader.remarks,	
         gcode = issuedetail.gcode,   
         icode = issuedetail.icode,   
         batch = issuedetail.batch,   
         expiry = issuedetail.expiry,   
			looseqty = issuedetail.qty,
         referenceno=ISNULL((select name from issuetype where issuetypecode = issueheader.issuetypecode), '') + CASE issueheader.issuetypecode WHEN NULL THEN '' ELSE '-' END + dbo.issueheader.referenceno,
         dbo.issueheader.referencedate,
			packing=(select itempacking.name from itempacking where itempacking.packcode=item.packcode),
			Godown=(select Godown.name from Godown where Godown.gcode=issuedetail.gcode),
			itempacking = item.packingdesc,
			Id       = dbo.issuedetail.IDENTITYCOL,
			customer=(select name from accounts where accounts.acccode=issueheader.acccode),
			customeradd1=(select address1 from customer where customer.custcode=issueheader.acccode),
			customeradd2=(select address2 from customer where customer.custcode=issueheader.acccode),
			customerphone =(select phone from customer where customer.custcode=issueheader.acccode),
			custtaxregno =(select salestaxregno from customer where customer.custcode=issueheader.acccode),
			class=(select name from itemclass where itemclass.iccode=Item.iccode),
			category=(select name from itemcategory where itemcategory.icatcode=item.icatcode)

    FROM issueheader, 
			issuedetail, 
			users, 
			item ,
			salesman
 
   WHERE ( dbo.issueheader.issueinvcode = :ar_issueInvCode ) AND
			( dbo.issueheader.issueinvcode = dbo.issuedetail.issueinvcode) AND
			( dbo.issueheader.Smancode = dbo.SalesMan.Salesmancode ) AND 
			( dbo.issueheader.salesmancode = dbo.users.usercode ) AND 
			( dbo.issuedetail.icode = dbo.item.icode)

ORDER BY dbo.issuedetail.IDENTITYCOL
"
  arguments=(("ar_IssueInvCode", number))
)
