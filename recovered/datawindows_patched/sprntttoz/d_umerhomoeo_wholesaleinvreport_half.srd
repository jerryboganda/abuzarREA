 retrieve="SELECT
	itemname= itemcategory.name,
	aliasname=max(item.customicode),
	packingdesc=max(item.packingdesc),
	salecatcode=saleledger.salecatcode, 
	accname = dbo.accounts.name,
	address = dbo.customer.address1, 
	address2= dbo.customer.address2,
	salesman = dbo.users.username,
	saleinvcode = dbo.saleledger.saleinvcode,
	headerno = dbo.saleledger.headerno,
	headerinvno=dbo.saleledger.headerinvno,
	date = dbo.saleledger.date,
	invdiscperc = dbo.saleledger.discperc,
	misccharges = dbo.saleledger.misccharges,
	flatdisc = dbo.saleledger.flatdisc,
	invsalestax = dbo.saleledger.salestax,
	gcode = max(saledetail.gcode),
	icode = max(saledetail.icode),
	batch = MAX(saledetail.batch),
	expiry = max(saledetail.expiry), 
	looseqty = sum(saledetail.looseqty), 
	bonusqty = sum(saledetail.bonusqty),
	packqty = sum(saledetail.packqty),
	packunits= Max(saledetail.packunits),
	saleprice= MAX(saledetail.saleprice),
	discperc = MAx(saledetail.discperc),
	salestax = MAX(saledetail.salestax),
	itemflatdisc=MAX(saledetail.itemflatdisc),
	Id = MAX(dbo.saledetail.IDENTITYCOL),
	posted=saleledger.posted,
	balance=isnull(saleledger.balance,0),
	amt=saleledger.amt,
	unitsalestax = MAX(saledetail.unitsalestax),
	gstperc = max(saledetail.gstperc),
	invgstperc = saleledger.invgstperc1,
	custTaxRegno=customer.salestaxregno  ,
	dbo.saleledger.custrefno,	
	dbo.saleledger.remarks,
	dbo.saleledger.printwaranty,
	dbo.saleledger.printbatch,
	saleledger.printbalance,			
	manufacturer=manufacturer.name,
	class=itemclass.name,
	category=itemcategory.name,
	packing=(select itempacking.name from itempacking where itempacking.packcode=item.packcode),
	messagedesc=(select description from message where messagecode=saleledger.messagecode),
	salesperson=(select name from salesman where salesmancode=saleledger.smancode),
	custcode=saleledger.custcode,
	reprintcounter=saleledger.reprintingcounter,
	serverdate=getdate()
FROM saleledger, saledetail, accounts, customer, users, item, 
	manufacturer, itemclass, itemcategory
WHERE 
	( dbo.saleledger.saleinvcode = :ar_SaleInvCode ) AND  
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND  
	( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  
	( dbo.customer.custcode = dbo.accounts.acccode ) AND  
	( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  
	( dbo.saledetail.icode = dbo.item.icode) AND
	( dbo.manufacturer.manfcode = dbo.item.manfcode ) AND
	( dbo.item.refrigrated = 0 ) AND
	( dbo.item.iccode = dbo.itemclass.iccode ) AND
	( dbo.item.icatcode = dbo.itemcategory.icatcode )
GROUP BY
	dbo.saleledger.saleinvcode,
	dbo.saleledger.salecatcode, 
	dbo.saleledger.custcode,
	dbo.saleledger.headerno,
	dbo.saleledger.headerinvno,
	dbo.saleledger.date,
	dbo.saleledger.discperc,
	dbo.saleledger.misccharges,
	dbo.saleledger.flatdisc,
	dbo.saleledger.salestax,
	dbo.saleledger.messagecode,
	dbo.saleledger.smancode,
	dbo.saleledger.reprintingcounter,
	dbo.saleledger.custrefno,	
	dbo.saleledger.remarks,
	dbo.saleledger.printwaranty,
	dbo.saleledger.printbatch,
	dbo.saleledger.printbalance,			
	dbo.saleledger.posted,
	dbo.saleledger.balance,
	dbo.saleledger.amt,
	dbo.saleledger.invgstperc1,   
	dbo.accounts.name,
	dbo.customer.address1, 
	dbo.customer.address2,
	dbo.customer.salestaxregno  ,
	dbo.users.username,
	dbo.manufacturer.name,
	dbo.itemcategory.name,
	dbo.item.packcode,
	dbo.itemclass.name,
	dbo.saledetail.saleprice,
	dbo.saledetail.discperc,
	dbo.saledetail.itemflatdisc
having count(dbo.itemcategory.name + 
	str(dbo.item.packcode,5) + 
	dbo.itemclass.name + 
	str(dbo.saledetail.saleprice,15, 5) + 
	str(dbo.saledetail.discperc, 10, 2) +
	str(dbo.saledetail.itemflatdisc, 15,2)) > 1
UNION ALL
SELECT 
	itemname= item.name,
	aliasname=max(item.customicode),
	packingdesc=max(item.packingdesc),
	salecatcode=saleledger.salecatcode, 
	accname = dbo.accounts.name,
	address = dbo.customer.address1, 
	address2= dbo.customer.address2,
	salesman = dbo.users.username,
	saleinvcode = dbo.saleledger.saleinvcode,
	headerno = dbo.saleledger.headerno,
	headerinvno=dbo.saleledger.headerinvno,
	date = dbo.saleledger.date,
	invdiscperc = dbo.saleledger.discperc,
	misccharges = dbo.saleledger.misccharges,
	flatdisc = dbo.saleledger.flatdisc,
	invsalestax = dbo.saleledger.salestax,
	gcode = max(saledetail.gcode),
	icode = saledetail.icode,
	batch = MAX(saledetail.batch),
	expiry = max(saledetail.expiry), 
	looseqty = sum(saledetail.looseqty), 
	bonusqty = sum(saledetail.bonusqty),
	packqty = sum(saledetail.packqty),
	packunits= Max(saledetail.packunits),
	saleprice= MAX(saledetail.saleprice),
	discperc = MAx(saledetail.discperc),
	salestax = MAX(saledetail.salestax),
	itemflatdisc=MAX(saledetail.itemflatdisc),
	Id = MAX(dbo.saledetail.IDENTITYCOL),
	posted=saleledger.posted,
	balance=isnull(saleledger.balance,0),
	amt=saleledger.amt,
	unitsalestax = MAX(saledetail.unitsalestax),
	gstperc = max(saledetail.gstperc),
	invgstperc = saleledger.invgstperc1,
	custTaxRegno=customer.salestaxregno  ,
	dbo.saleledger.custrefno,	
	dbo.saleledger.remarks,
	dbo.saleledger.printwaranty,
	dbo.saleledger.printbatch,
	saleledger.printbalance,			
	manufacturer=manufacturer.name,
	class=itemclass.name,
	category=itemcategory.name,
	acking=(select itempacking.name from itempacking where itempacking.packcode=item.packcode),
	messagedesc=(select description from message where messagecode=saleledger.messagecode),
	salesperson=(select name from salesman where salesmancode=saleledger.smancode),
	custcode=saleledger.custcode,
	reprintcounter=saleledger.reprintingcounter,
	serverdate=getdate()
FROM 
	saleledger, saledetail, accounts, customer, users, item, 
	manufacturer, itemclass, itemcategory, 
	(SELECT 
		rowid=max(saledetail.rowid)
	FROM saleledger, saledetail, accounts, customer, users, item, 
		manufacturer, itemclass, itemcategory
	WHERE 
		( dbo.saleledger.saleinvcode = :ar_SaleInvCode ) AND  
		( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND  
		( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  
		( dbo.customer.custcode = dbo.accounts.acccode ) AND  
		( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  
		( dbo.saledetail.icode = dbo.item.icode) AND
		( dbo.manufacturer.manfcode = dbo.item.manfcode ) AND
		( dbo.item.iccode = dbo.itemclass.iccode ) AND
		( dbo.item.icatcode = dbo.itemcategory.icatcode )
	GROUP BY
		dbo.manufacturer.name,
		dbo.itemcategory.name,
		str(dbo.item.packcode,5),
		dbo.itemclass.name,
		dbo.saledetail.saleprice,
		dbo.saledetail.discperc,
		dbo.saledetail.itemflatdisc
	having count(dbo.manufacturer.name + 
		dbo.itemcategory.name + 
		str(dbo.item.packcode,5) + 
		dbo.itemclass.name + 
		str(dbo.saledetail.saleprice,15, 5) + 
		str(dbo.saledetail.discperc, 10, 2) +
		str(dbo.saledetail.itemflatdisc, 15,2)) = 1) t
WHERE 
	( dbo.saleledger.saleinvcode = :ar_SaleInvCode ) AND  
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND  
	( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  
	( dbo.customer.custcode = dbo.accounts.acccode ) AND  
	( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  
	( dbo.saledetail.icode = dbo.item.icode) AND
	( dbo.manufacturer.manfcode = dbo.item.manfcode ) AND
	( dbo.item.refrigrated = 0 ) AND
	( dbo.item.iccode = dbo.itemclass.iccode ) AND
	( dbo.item.icatcode = dbo.itemcategory.icatcode ) AND
	( dbo.saledetail.rowid = t.rowid )
GROUP BY
	dbo.saleledger.saleinvcode,
	dbo.saleledger.salecatcode, 
	dbo.saleledger.custcode,
	dbo.saleledger.headerno,
	dbo.saleledger.headerinvno,
	dbo.saleledger.date,
	dbo.saleledger.discperc,
	dbo.saleledger.misccharges,
	dbo.saleledger.flatdisc,
	dbo.saleledger.salestax,
	dbo.saleledger.messagecode,
	dbo.saleledger.smancode,
	dbo.saleledger.reprintingcounter,
	dbo.saleledger.custrefno,	
	dbo.saleledger.remarks,
	dbo.saleledger.printwaranty,
	dbo.saleledger.printbatch,
	dbo.saleledger.printbalance,			
	dbo.saleledger.posted,
	dbo.saleledger.balance,
	dbo.saleledger.amt,
	dbo.saleledger.invgstperc1,   
	dbo.accounts.name,
	dbo.customer.address1, 
	dbo.customer.address2,
	dbo.customer.salestaxregno  ,
	dbo.users.username,
	dbo.manufacturer.name,
	dbo.itemcategory.name,
	dbo.item.packcode,
	dbo.itemclass.name,
	dbo.saledetail.saleprice,
	dbo.saledetail.discperc,
	dbo.saledetail.itemflatdisc,
	saledetail.icode,
	dbo.item.name
UNION ALL
SELECT 
	itemname= item.name,
	aliasname=max(item.customicode),
	packingdesc=max(item.packingdesc),
	salecatcode=saleledger.salecatcode, 
	accname = dbo.accounts.name,
	address = dbo.customer.address1, 
	address2= dbo.customer.address2,
	salesman = dbo.users.username,
	saleinvcode = dbo.saleledger.saleinvcode,
	headerno = dbo.saleledger.headerno,
	headerinvno=dbo.saleledger.headerinvno,
	date = dbo.saleledger.date,
	invdiscperc = dbo.saleledger.discperc,
	misccharges = dbo.saleledger.misccharges,
	flatdisc = dbo.saleledger.flatdisc,
	invsalestax = dbo.saleledger.salestax,
	gcode = max(saledetail.gcode),
	icode = saledetail.icode,
	batch = MAX(saledetail.batch),
	expiry = max(saledetail.expiry), 
	looseqty = sum(saledetail.looseqty), 
	bonusqty = sum(saledetail.bonusqty),
	packqty = sum(saledetail.packqty),
	packunits= Max(saledetail.packunits),
	saleprice= MAX(saledetail.saleprice),
	discperc = MAx(saledetail.discperc),
	salestax = MAX(saledetail.salestax),
	itemflatdisc=MAX(saledetail.itemflatdisc),
	Id = MAX(dbo.saledetail.IDENTITYCOL),
	posted=saleledger.posted,
	balance=isnull(saleledger.balance,0),
	amt=saleledger.amt,
	unitsalestax = MAX(saledetail.unitsalestax),
	gstperc = max(saledetail.gstperc),
	invgstperc = saleledger.invgstperc1,
	custTaxRegno=customer.salestaxregno  ,
	dbo.saleledger.custrefno,	
	dbo.saleledger.remarks,
	dbo.saleledger.printwaranty,
	dbo.saleledger.printbatch,
	saleledger.printbalance,			
	manufacturer=manufacturer.name,
	class=itemclass.name,
	category=itemcategory.name,
	packing=(select itempacking.name from itempacking where itempacking.packcode=item.packcode),
	messagedesc=(select description from message where messagecode=saleledger.messagecode),
	salesperson=(select name from salesman where salesmancode=saleledger.smancode),
	custcode=saleledger.custcode,
	reprintcounter=saleledger.reprintingcounter,
	serverdate=getdate()
FROM 
	saleledger, saledetail, accounts, customer, users, item, 
	manufacturer, itemclass, itemcategory
WHERE 
	( dbo.saleledger.saleinvcode = :ar_SaleInvCode ) AND  
	( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND  
	( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  
	( dbo.customer.custcode = dbo.accounts.acccode ) AND  
	( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  
	( dbo.saledetail.icode = dbo.item.icode) AND
	( dbo.manufacturer.manfcode = dbo.item.manfcode ) AND
	( dbo.item.refrigrated <> 0 ) AND
	( dbo.item.iccode = dbo.itemclass.iccode ) AND
	( dbo.item.icatcode = dbo.itemcategory.icatcode )
GROUP BY
	dbo.saleledger.saleinvcode,
	dbo.saleledger.salecatcode, 
	dbo.saleledger.custcode,
	dbo.saleledger.headerno,
	dbo.saleledger.headerinvno,
	dbo.saleledger.date,
	dbo.saleledger.discperc,
	dbo.saleledger.misccharges,
	dbo.saleledger.flatdisc,
	dbo.saleledger.salestax,
	dbo.saleledger.messagecode,
	dbo.saleledger.smancode,
	dbo.saleledger.reprintingcounter,
	dbo.saleledger.custrefno,	
	dbo.saleledger.remarks,
	dbo.saleledger.printwaranty,
	dbo.saleledger.printbatch,
	dbo.saleledger.printbalance,			
	dbo.saleledger.posted,
	dbo.saleledger.balance,
	dbo.saleledger.amt,
	dbo.saleledger.invgstperc1,   
	dbo.accounts.name,
	dbo.customer.address1, 
	dbo.customer.address2,
	dbo.customer.salestaxregno  ,
	dbo.users.username,
	dbo.manufacturer.name,
	dbo.itemcategory.name,
	item.packcode,
	dbo.itemclass.name,
	dbo.saledetail.saleprice,
	dbo.saledetail.discperc,
	dbo.saledetail.itemflatdisc,
	saledetail.icode,
	dbo.item.name
ORDER BY 
	itemname
"
  arguments=(("ar_SaleInvCode", number))
)
