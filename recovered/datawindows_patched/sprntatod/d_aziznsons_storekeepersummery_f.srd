table(column=(type=char(255) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=users_username dbname="Users.username"  )
column=(type=long updatewhereclause=yes name=salecat dbname="salecat"  )
column=(type=long updatewhereclause=yes name=saleledger_custcode dbname="SaleLedger.custcode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="customer"  )
column=(type=decimal(2) updatewhereclause=yes name=invoicetotal dbname="invoicetotal"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleLedger.saleinvcode"  )
