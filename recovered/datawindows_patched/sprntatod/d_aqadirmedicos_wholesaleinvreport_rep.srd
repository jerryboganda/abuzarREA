column=(type=decimal(2) updatewhereclause=yes name=invsalestax dbname="salestax"  )
column=(type=long identity=yes updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=decimal(2) updatewhereclause=yes name=balance dbname="balance"  )
column=(type=decimal(2) updatewhereclause=yes name=amt dbname="amt"  )
column=(type=char(1) updatewhereclause=yes name=printbalance dbname="SaleLedger.printbalance"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(50) updatewhereclause=yes name=custtaxregno dbname="custTaxRegno"  )
column=(type=char(30) updatewhereclause=yes name=saleledger_custrefno dbname="SaleLedger.custrefno"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="SaleLedger.remarks"  )
column=(type=char(1) updatewhereclause=yes name=printwaranty dbname="SaleLedger.printwaranty"  )
column=(type=char(1) updatewhereclause=yes name=printbatch dbname="SaleLedger.printbatch"  )
column=(type=long updatewhereclause=yes name=custcode dbname="custcode"  )
column=(type=char(50) updatewhereclause=yes name=messages dbname="messages"  )
 retrieve="SELECT 
		itemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:'+LTRIM(RTRIM(item.customicode)) END, 
         aliasname=item.customicode,  
		saleperson=(select  name from salesman where salesman.salesmancode=saleledger.smancode), 
         packingdesc=item.packingdesc, 
         accname = dbo.accounts.name,   
         address = dbo.customer.address1,   
         address2= dbo.customer.address2,  
		area=(select name from area where area.areacode=customer.areacode),
		accalias=accounts.aliasname, 
         salesman = dbo.users.username,   
         saleinvcode = dbo.saleledger.saleinvcode,   
         headerno = dbo.saleledger.headerno,   
         date =  Case :ai_printdate When 1 Then dbo.saleledger.originaldate When 2 Then dbo.saleledger.date When 3 Then dbo.saleledger.Billingdate  End, 
         invdiscperc = dbo.saleledger.discperc,   
         misccharges = dbo.saleledger.misccharges,   
         flatdisc = dbo.saleledger.flatdisc,   
         invsalestax = dbo.saleledger.salestax,   
			salecatcode = dbo.saleledger.salecatcode,
         gcode = saledetail.gcode,   
         icode = saledetail.icode,   
         batch = saledetail.batch,   
         expiry = saledetail.expiry,   
         looseqty = saledetail.looseqty,   
         bonusqty = saledetail.bonusqty,   
         packqty = saledetail.packqty,   
         packunits= saledetail.packunits,   
         saleprice= saledetail.saleprice,   
         discperc = saledetail.discperc,  
			itemflatdisc=saledetail.itemflatdisc,   
         salestax = saledetail.salestax,   
         Id = dbo.saledetail.IDENTITYCOL,   
         posted=saleledger.posted,   
         balance=(select isnull(sum(v.debit - v.credit), 0) from virtualgl v
				where v.acccode=accounts.acccode group by v.acccode),   
		amt=saleledger.amt,  
		saleledger.printbalance,
         unitsalestax = saledetail.unitsalestax,   
         gstperc = saledetail.gstperc,   
         invgstperc = saleledger.invgstperc1,   
         custTaxRegno=customer.salestaxregno  ,
			dbo.saleledger.custrefno,	
			dbo.saleledger.remarks,
			dbo.saleledger.printwaranty,
			dbo.saleledger.printbatch,
			custcode=saleledger.custcode,
			
			messages=(select description from message where messagecode=saleledger.messagecode)

    FROM saleledger,   
         saledetail,   
         accounts,   
         customer,   
         users,   
         item  

   WHERE ( dbo.saleledger.saleinvcode between :ar_SInvCode and :ar_Linvcode ) AND  
		(saleledger.custcode in (:ar_custcode) )AND
         ( dbo.saleledger.saleinvcode = dbo.saledetail.saleinvcode) AND  
         ( dbo.saleledger.custcode = dbo.accounts.acccode ) AND  
         ( dbo.customer.custcode = dbo.accounts.acccode ) AND  
         ( dbo.saleledger.salesmancode = dbo.users.usercode ) AND  
         ( dbo.saledetail.icode = dbo.item.icode)    

ORDER BY
			dbo.saledetail.saleinvcode,
			dbo.saledetail.IDENTITYCOL"
  arguments=(("ar_SInvCode", number), ("ar_Linvcode", number), ("ar_custcode", numberlist), ("ai_printheader", number), ("ai_printdate", number))
)
