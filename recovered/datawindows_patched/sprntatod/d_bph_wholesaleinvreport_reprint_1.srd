compute(name=c_salestaxval visible="1	if(c_salestaxval>0,1,0)" band=detail font.charset="0" font.face="Times New Roman" font.family="1" font.height="-11" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="7322" y="10" height="156" width="416" format="###0.00" expression="round( c_amount  *  gstperc * 0.01, 2) +  Round((looseqty+ bonusqty)* unitsalestax ,2)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
