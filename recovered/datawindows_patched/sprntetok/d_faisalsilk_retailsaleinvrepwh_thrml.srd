text(name=t_36 visible="1" band=summary font.charset="0" font.face="Arial" font.family="2" font.height="-7" font.pitch="2" font.weight="400" background.mode="2" background.color="16777215" color="0" alignment="0" border="0" x="31" y="4146" height="125" width="2677" text="Do not use detergents containing bleach." html.valueishtml="0" )
