compute(name=compute_4 visible="1	if(page()=pagecount(),1,0)" band=footer font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="553648127" color="0" x="6875" y="1698" height="166" width="750" format="###,##,##,##0.00" expression="abs(Round(Sum (  c_netamount for group 1 ) -  flatdisc  + misccharges  + salestax , 2)  + Round(sum(c_salestaxval for group 1 ) + Round((Round(sum((round(c_amount,2) ) for group 1)  *  (1 - invdiscperc * 0.01) , 2) -  flatdisc  )  *  invgstperc  * 0.01,2),2) - c_nettotal)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
