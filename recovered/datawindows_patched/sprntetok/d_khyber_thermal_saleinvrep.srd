column=(type=long updatewhereclause=yes name=packqty dbname="packqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=saledetail_rate dbname="rate"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_salestax dbname="salestax"  )
column=(type=decimal(2) updatewhereclause=yes name=saleledger_discperc dbname="discperc"  )
column=(type=char(34) updatewhereclause=yes name=ccustomername dbname="customername"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(21) updatewhereclause=yes name=machinename dbname="machinename"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="invtotal"  )
column=(type=long updatewhereclause=yes name=srinvtotal dbname="srinvtotal"  )
column=(type=char(50) updatewhereclause=yes name=patientregno dbname="PatientRegNo"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(60) updatewhereclause=yes name=location dbname="location"  )
 retrieve=" SELECT
	transtype='S', 
	itemname = case printable when  0  then ltrim(str(item.icode)) + ' Counter Sale'   else item.name end, 
	users.username, 
	salecat=max(saleledger.salecatcode),
	saleledger.custcode,
	headerno = dbo.saleledger.headerno,
	customer=(select name from accounts where acccode=saleledger.custcode),
	dbo.saleledger.saleinvcode, 
	dbo.saleledger.date,   
	dbo.saleledger.discperc,   
	dbo.saleledger.misccharges,   
	dbo.saleledger.flatdisc,   
	dbo.saleledger.salestax,   
	dbo.saleledger.custcode,   
	refno=dbo.saleledger.custrefno,   
	dbo.saleledger.remarks,   
	admissioncode=dbo.saleledger.Admissioncode,   
	dbo.saledetail.icode,   
	dbo.saledetail.gcode, 
	cashreceived=max(dbo.saleledger.cashreceived),
	Id        = MAX(dbo.saledetail.IDENTITYCOL),  
	looseqty  = sum(saledetail.looseqty), 
	packqty   = sum(saledetail.packqty), 
	packunits = max(saledetail.packunits), 
	saleprice = max(saledetail.saleprice), 
	rate      = max(saledetail.rate),
	salestax  = max(saledetail.salestax),   
	discperc  = max(saledetail.discperc), 
	customername='                                  '  ,
	itemflatdisc  = max(saledetail.itemflatdisc),
	aliasname=item.customicode,
	machinename=',' +  max(saleledger.machinename),
	invtotal = saleledger.invtotal,
	srinvtotal = 0,
	PatientRegNo  = PA.RegNo,
	Patient = PA.Name,
	location=(SELECT patientlocation.name FROM PatientLocation WHERE PatientLocation.LocationCode = PA.LocationCode)
FROM 
	saleledger
	LEFT OUTER JOIN 
	(SELECT PA.AdmissionCode, PA.PatientCode, PA.LocationCode, PA.Date, PA.UserCode, PA.DoctorCode, P.RegNo, P.Name
	FROM PatientAdmission PA, Patient P
	WHERE PA.AdmissionCode IN (SELECT SL.AdmissionCode FROM SaleLedger SL WHERE SL.SaleInvCode = :ra_InvCode) AND
		PA.PatientCode = P.PatientCode
	UNION
	SELECT AdmissionCode=NULL, PatientCode=P.PatientCode, LocationCode=NULL, Date=NULL, UserCode=NULL, DoctorCode=NULL, P.RegNo, P.Name
	FROM Patient P
	WHERE P.PatientCode IN (SELECT SL.PatientCode FROM SaleLedger SL WHERE SL.SaleInvCode = :ra_InvCode) ) AS PA ON ( saleledger.AdmissionCode = PA.AdmissionCode ),
	saledetail,  
	item,
	Users
WHERE 
	( saleledger.saleinvcode = :ra_InvCode ) AND
	( saleledger.saleinvcode = dbo.saledetail.saleinvcode ) AND 
	( saleLedger.SalesManCode = users.userCode ) and
	( saledetail.icode = item.icode )
GROUP BY 
	saleledger.saleinvcode, 
	saleledger.date, 
	saleledger.custcode, 
	dbo.saleledger.Admissioncode,   
	PA.RegNo,
	PA.Name,
	PA.LocationCode,
	saleledger.discperc, 
	saleledger.flatdisc, 
	saleledger.misccharges, 
	saleledger.headerno,
	saleledger.salestax, 
	dbo.saleledger.custrefno,   
	saleledger.remarks, 
	saledetail.icode, 
	saledetail.rowgroup,
	saledetail.gcode, 
	item.name,
	item.icode,
	item.printable,
	item.customicode,
	users.username,
	saleledger.invtotal
ORDER BY 
	transtype, 
	id
"
  arguments=(("ra_InvCode", number))
 sort="id A"
)
