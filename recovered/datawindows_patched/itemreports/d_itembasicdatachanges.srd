table(column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=datetime updatewhereclause=yes name=logdate dbname="LogDate"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="CustomICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Name"  )
column=(type=char(60) updatewhereclause=yes name=class dbname="Class"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="Category"  )
column=(type=char(20) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=godown dbname="Godown"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="PurPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=salestax dbname="SalesTax"  )
column=(type=long updatewhereclause=yes name=packunits dbname="PackUnits"  )
column=(type=decimal(2) updatewhereclause=yes name=salediscperc dbname="SaleDiscPerc"  )
column=(type=decimal(2) updatewhereclause=yes name=purdiscperc dbname="PurDiscPerc"  )
column=(type=long updatewhereclause=yes name=active dbname="Active"  )
column=(type=long updatewhereclause=yes name=printable dbname="Printable"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice2 dbname="SalePrice2"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice3 dbname="SalePrice3"  )
column=(type=char(1) updatewhereclause=yes name=restricted dbname="Restricted"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc1 dbname="GSTPerc1"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc2 dbname="GSTPerc2"  )
column=(type=decimal(2) updatewhereclause=yes name=packsalestax dbname="PackSalesTax"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="UserName"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="ReOrderQty"  )
column=(type=long updatewhereclause=yes name=optimumqty dbname="OptimumQty"  )
column=(type=long updatewhereclause=yes name=reorderlevel dbname="ReOrderLevel"  )
column=(type=long updatewhereclause=yes name=optimumlevel dbname="OptimumLevel"  )
column=(type=long updatewhereclause=yes name=minqty dbname="MinQty"  )
column=(type=decimal(0) updatewhereclause=yes name=itemrowid dbname="ItemRowID"  )
column=(type=char(100) updatewhereclause=yes name=changereason dbname="ChangeReason"  )
column=(type=char(100) updatewhereclause=yes name=module dbname="Module"  )
 retrieve="SELECT 
	Date=LastUpdate, 
	LogDate=LogDate,
	Item = (SELECT ITEM.name FROM ITEM WHERE ICode = I.ICode),
	CustomICode, Name,
	Class=(SELECT C.Name FROM ItemClass C WHERE C.IcCode = I.IcCode),
	Category=(SELECT C.Name FROM ItemCategory C WHERE C.ICatCode = I.ICatCode), 
	Packing=(SELECT P.Name FROM ItemPacking P WHERE P.Packcode = I.Packcode),
	Manufacturer=(SELECT M.Name FROM Manufacturer M WHERE M.ManfCode = I.ManfCode),
	Godown=(SELECT G.Name FROM Godown G WHERE G.Gcode = I.Gcode), 
	SalePrice, 
	PurPrice,
	SalesTax, 
	PackUnits, 
	SaleDiscPerc,
	PurDiscPerc, 
	Active, 
	Printable,
	SalePrice2, SalePrice3,   
	Restricted, GSTPerc1, GSTPerc2, PackSalesTax,
	UserName=(SELECT U.username FROM Users U WHERE U.UserCode = I.UserCode),
	ICode,
	ReOrderQty,
	OptimumQty,
	ReOrderLevel,
	OptimumLevel,
	MinQty,
	ItemRowID,
	ChangeReason,
	Module
FROM
(SELECT
	ItemLog.*
FROM 
	ItemLog 
WHERE 
	logdate BETWEEN :ad_startdate AND :ad_enddate AND ICode IN (:ai_icode)
UNION ALL
SELECT 
	ItemLog.*
FROM
	ItemLog
WHERE 
	itemrowid IN (select min(itemrowid) from itemlog where logdate >= :ad_enddate AND ICode IN (:ai_icode))
/*UNION ALL
SELECT 
	999999999,	
	LogDate=lastupdate, 
	NULL,
	NULL,
	Item.*
FROM 
	Item
WHERE
	icode IN (:ai_icode) AND
	Icode not in 
		(SELECT ICode FROM Itemlog where logdate >= :ad_enddate AND ICode IN (:ai_icode))*/) I
ORDER BY
	ICode, ItemRowID"
  arguments=(("ai_icode", numberlist), ("ad_startdate", datetime), ("ad_enddate", datetime))
 sort="item A, icode A, itemrowid A"
)
