table(column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalue dbname="SaleValue"  )
column=(type=decimal(4) updatewhereclause=yes name=retqty dbname="RetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=retbonus dbname="RetBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=retvalue dbname="RetValue"  )
column=(type=decimal(4) updatewhereclause=yes name=netqty dbname="NetQty"  )
column=(type=decimal(4) updatewhereclause=yes name=netbonus dbname="NetBonus"  )
column=(type=decimal(6) updatewhereclause=yes name=netvalue dbname="NetValue"  )
column=(type=char(50) updatewhereclause=yes name=packing dbname="Packing"  )
column=(type=decimal(3) updatewhereclause=yes name=packingfactor dbname="Packingfactor"  )
 retrieve="SELECT 
	ItemCode=S.ItemCode, 
	AliasName=I.CustomICode, 
	Item=I.Name, 
	Qty=SUM(S.Qty),
	Bonus=SUM(S.Bonus),
	SaleValue = ROUND(SUM(S.SaleValue), 2),
	RetQty=SUM(S.RetQty),
	RetBonus=SUM(S.RetBonus),
	RetValue = ROUND(SUM(S.RetValue), 2), 
	NetQty = SUM(S.Qty - S.RetQty),
	NetBonus = SUM(S.Bonus - S.RetBonus),
	NetValue = ROUND(SUM(S.SaleValue), 2) - ROUND(SUM(S.RetValue), 2),
	Packing=I.PackingDesc,
	Packingfactor=I.packingfactor
FROM
	Item I,
	(SELECT
		ItemCode=SD.ICode, 
		Qty=SUM(SD.LooseQty),
		Bonus=SUM(SD.BonusQty),
		SaleValue = SUM(SD.LooseQty * (SD.saleprice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ) ,
		RetQty=0,
		RetBonus=0,
		RetValue = 0.00
	FROM
		SaleLedger SL, SaleDetail SD
	WHERE
		:ai_allitems = 0 AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode IN (:ar_ICode)
	GROUP BY
		SD.ICode
	UNION ALL
	SELECT
		ItemCode=SD.ICode, 
		Qty=SUM(SD.LooseQty),
		Bonus=SUM(SD.BonusQty),
		SaleValue = SUM(SD.LooseQty * (SD.saleprice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ) ,
		RetQty=0,
		RetBonus=0,
		RetValue = 0.00
	FROM
		SaleLedger SL, SaleInvDetail SD
	WHERE
		:ai_allitems = 0 AND
		SL.ImpactInventory = 'N' AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SaleInvCode = SD.SaleInvCode AND
		SD.ICode IN (:ar_ICode)
	GROUP BY
		SD.ICode
	UNION ALL
	SELECT
		ItemCode=SD.ICode, 
		Qty=0,
		Bonus=0,
		SaleValue = 0.00,
		RetQty=SUM(SD.LooseQty),
		RetBonus=SUM(SD.BonusQty),
		RetValue = SUM(SD.LooseQty * SD.srprice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) )
	FROM
		SRLedger SL, SRDetail SD
	WHERE
		:ai_allitems = 0 AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SRInvCode = SD.SRInvCode AND
		SD.ICode IN (:ar_ICode)
	GROUP BY
		SD.ICode
	UNION ALL
	SELECT
		ItemCode=SD.ICode, 
		Qty=SUM(SD.LooseQty),
		Bonus=SUM(SD.BonusQty),
		SaleValue = SUM(SD.LooseQty * (SD.saleprice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ) ,
		RetQty=0,
		RetBonus=0,
		RetValue = 0.00
	FROM
		SaleLedger SL, SaleDetail SD
	WHERE
		:ai_allitems = 1 AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SaleInvCode = SD.SaleInvCode
	GROUP BY
		SD.ICode
	UNION ALL
	SELECT
		ItemCode=SD.ICode, 
		Qty=SUM(SD.LooseQty),
		Bonus=SUM(SD.BonusQty),
		SaleValue = SUM(SD.LooseQty * (SD.saleprice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) ) ,
		RetQty=0,
		RetBonus=0,
		RetValue = 0.00
	FROM
		SaleLedger SL, SaleInvDetail SD
	WHERE
		:ai_allitems = 1 AND
		SL.ImpactInventory = 'N' AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SaleInvCode = SD.SaleInvCode
	GROUP BY
		SD.ICode
	UNION ALL
	SELECT
		ItemCode=SD.ICode, 
		Qty=0,
		Bonus=0,
		SaleValue = 0.00,
		RetQty=SUM(SD.LooseQty),
		RetBonus=SUM(SD.BonusQty),
		RetValue = SUM(SD.LooseQty * SD.srprice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01) )
	FROM
		SRLedger SL, SRDetail SD
	WHERE
		:ai_allitems = 1 AND
		SL.Date BETWEEN :ar_StartDate AND :ar_EndDate AND
		SL.SRInvCode = SD.SRInvCode
	GROUP BY
		SD.ICode) S
WHERE
 	I.ICode = S.ItemCode
GROUP BY
	S.ItemCode,
	I.Name, 
	I.packingfactor,
	I.CustomICode,
	I.PackingDesc
ORDER BY
	Item, 
	AliasName"
  arguments=(("ai_allitems", number), ("ar_icode", numberlist), ("ar_StartDate", datetime), ("ar_EndDate", datetime))
)
