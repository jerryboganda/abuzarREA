table(column=(type=char(100) updatewhereclause=yes name=genericitemtype dbname="GenericItemType"  )
column=(type=long updatewhereclause=yes name=invcode dbname="invcode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="remarks"  )
column=(type=char(100) updatewhereclause=yes name=ref dbname="ref"  )
column=(type=decimal(4) updatewhereclause=yes name=stockatsale dbname="stockatsale"  )
column=(type=decimal(4) updatewhereclause=yes name=saleqty dbname="saleqty"  )
column=(type=decimal(4) updatewhereclause=yes name=purqty dbname="purqty"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="ItemCategory"  )
column=(type=decimal(0) updatewhereclause=yes name=utn dbname="UTN"  )
 retrieve="select   
			GenericItemType=GIT.Name,
			invcode=SL.saleinvcode,
			itemname=I.name,
			remarks=SL.remarks,
			ref=SL.custrefno,
			stockatsale=SD.godownbalancestock,
   			saleqty=SD.looseqty + SD.bonusqty,
			purqty=0,
			date=SL.date,
			batch=SD.batch,
			expiry=SD.expiry,
			username=U.username,
			manufacturer=M.name,
			ItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = I.ICatCode),
			UTN=SD.saleutn

from saleledger SL,
		saledetail  SD,
		Users U,
		GenericItem GI,
		GenericItemType GIT,
		Item I,
		Manufacturer M

where (SL.date>=:ar_stdate)and
		(SL.date<=:ar_enddate)and
		(SL.salesmancode=U.usercode)and
		(SL.saleinvcode=SD.saleinvcode)  and
		(I.icode=SD.icode)and
		(I.manfcode=M.manfcode) AND 
		(I.GenericCode=GI.GenericCode) AND
		(GI.GenericItemTypeCode = GIT.GenericItemTypeCode) AND
		(GIT.GenericItemTypeCode IN (:ai_generictypecode))
		
union all

select  
			GenericItemType=GIT.Name,
			invcode=PL.purinvcode,
			itemname=I.name,
			remarks=PL.remarks,
			ref=' ',
			stockatpur= ISNULL(PD.currstock, 0) + 
				PD.looseqty + (PD.packqty * PD.packunits ) + 
				(case when PL.purcatcode in (1,2) then PD.bonusqty * PD.packunits else PD.bonusqty end),
			saleqty=0,
			purqty=PD.looseqty + (PD.packqty * PD.packunits )+ (case when PL.purcatcode in (1,2) then PD.bonusqty * PD.packunits
																				 else
																						PD.bonusqty
																				 end),
			
			date=PL.date,
			batch=PD.batch,
			expiry=PD.expiry,
			username=U.username,
			Manufacturer=M.name,
			ItemCategory = (SELECT IC.Name FROM ItemCategory IC WHERE IC.ICatCode = I.ICatCode),
			UTN=PD.purutn

from purledger PL,
		purdetail  PD,
		Users U,
		GenericItem GI,
		GenericItemType GIT,
		Item I,
		Manufacturer M

where (PL.date>=:ar_stdate)and
		(PL.date<=:ar_enddate)and
		(PL.posted='Y')and
		(PL.salesmancode=U.usercode)and
		(PL.purinvcode=PD.purinvcode) and
		(I.icode=PD.icode) and
		(I.manfcode=M.manfcode) AND
		(I.GenericCode=GI.GenericCode) AND
		(GI.GenericItemTypeCode = GIT.GenericItemTypeCode) AND
		(GIT.GenericItemTypeCode IN (:ai_generictypecode))

"
  arguments=(("ai_generictypecode", numberlist), ("ar_stdate", datetime), ("ar_enddate", datetime))
 sort="genericitemtype A, itemname A, utn A"
)
