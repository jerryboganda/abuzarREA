table(column=(type=char(23) updatewhereclause=yes name=invinfo dbname="invinfo"  )
column=(type=char(2) updatewhereclause=yes name=documenttype dbname="documenttype"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="bonus"  )
column=(type=decimal(6) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=decimal(4) updatewhereclause=yes name=stock dbname="stock"  )
column=(type=decimal(4) updatewhereclause=yes name=newstock dbname="newstock"  )
column=(type=decimal(5) updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(0) updatewhereclause=yes name=utn dbname="utn"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="item"  )
column=(type=char(1) updatewhereclause=yes name=stockledger_due dbname="due"  )
column=(type=char(1) updatewhereclause=yes name=opening dbname="Opening"  )
column=(type=char(60) updatewhereclause=yes name=remarks dbname="Remarks"  )
 retrieve=" SELECT invinfo='',  
		 documenttype='',
		 date=max(date),
		 icode = MAX(:ar_icode),
		 gcode = null, 
		 batch='',
		 expiry=max(expiry),
		 qty=0.0000,
		 bonus=0.0000,
		 rate=0,
		 stock=0.0000, 
		 newstock=ISNULL(MAX(newstock), 0), 
		 avgprice=ISNULL(MAX(newavgprice), 0), 
		 utn=utn, 
		 item=(select item.name from item where item.icode = :ar_icode),
		 due=MAX(isnull(due, 'N')),
		 Opening='Y',
		 Remarks=''
FROM	 stockledger 
WHERE	 stockledger.icode=:ar_icode and 
		 utn IN (select ISNULL(max(utn), 0)
					from stockledger 
					where icode = :ar_icode AND utn < (select min(utn) 
					from stockledger 
					where date >= :ar_startdate and icode=:ar_icode))
GROUP BY UTN
UNION ALL
SELECT	invinfo=LTRIM(RTRIM(CONVERT(VARCHAR(20), documentcode))) + '-' + documenttype, 
			documenttype,
			date, 
			stockledger.icode, 
			stockledger.gcode, 
			batch, 
			expiry=expiry, 
			qty, 
			bonus, 
			rate= Round( (rate * qty * (1 - discperc * 0.01) * (1 - invdiscperc * 0.01) )  / case when qty + bonus > 0 THEN (qty + bonus) ELSE 1 END , 2), 
			stock, 
			newstock, 
			avgprice=newavgprice, 
			utn, 
			item=item.name,
			due=isnull(due, 'N'),
			Opening='N',
			Remarks=	CASE documenttype 
						WHEN 'PV' THEN 
							(SELECT name 
							FROM accounts, purledger 
							WHERE purledger.purinvcode = documentcode and 
									purledger.suppcode = accounts.acccode)
						WHEN 'PR' THEN 
							(SELECT name 
							FROM accounts, prledger 
							WHERE prledger.prinvcode = documentcode and 
									prledger.suppcode = accounts.acccode)
						WHEN 'SV' THEN 
							(SELECT name 
							FROM accounts, saleledger 
							WHERE saleledger.saleinvcode = documentcode and 
									saleledger.custcode = accounts.acccode)
						WHEN 'SR' THEN 
							(SELECT name 
							FROM accounts, srledger 
							WHERE srledger.srinvcode = documentcode and 
									srledger.custcode = accounts.acccode)
						WHEN 'IV' THEN 
							(SELECT name 
							FROM department, issueheader
							WHERE issueheader.issueinvcode = documentcode and 
									issueheader.deptcode = department.deptcode)
						WHEN 'RV' THEN 
							(SELECT name 
							FROM department, receiptheader
							WHERE receiptheader.receiptinvcode = documentcode and 
									receiptheader.deptcode = department.deptcode)
						WHEN 'AI' THEN 
							'STOCK ADJUSTMENT-INCREASE'
						WHEN 'AD' THEN 
							'STOCK ADJUSTMENT-DECREASE'
						WHEN 'DS' THEN 
							'DUE SATISFIED'
						ELSE
							''
						END
FROM	 	stockledger, item
WHERE	 	date >= :ar_startdate and date <= :ar_enddate and stockledger.icode=:ar_icode and
			stockledger.icode = item.icode
ORDER BY opening Desc, utn

 "
  arguments=(("ar_icode", number), ("ar_startdate", datetime), ("ar_enddate", datetime))
)
