table(column=(type=char(77) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname2 dbname="AliasName2"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(2) updatewhereclause=yes name=marketprice dbname="marketprice"  )
column=(type=decimal(2) updatewhereclause=yes name=storeprice dbname="storeprice"  )
 retrieve="SELECT 
	AliasName = '*' + Item.CustomICode + '*',
	AliasName2 = Item.CustomICode,
	itemname=item.name,
	marketprice=item.saleprice,
	storeprice=CAST(ROUND((item.saleprice - Item.FlatDisc) * (1 - item.salediscperc * 0.01),2) AS NUMERIC(12,2))
FROM
		Item
WHERE Icode IN (:aa_icode)"
  arguments=(("aa_icode", numberlist))
)
