table(column=(type=char(60) update=yes updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(0) key=yes update=yes updatewhereclause=yes name=itemrowid dbname="ItemLog.ItemRowId"  )
column=(type=datetime update=yes updatewhereclause=yes name=logdate dbname="ItemLog.LogDate"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ItemLog.ICode"  )
column=(type=char(60) update=yes updatewhereclause=yes name=name dbname="ItemLog.Name"  )
column=(type=char(75) update=yes updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) update=yes updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(100) updatewhereclause=yes name=changereason dbname="ItemLog.ChangeReason"  )
column=(type=char(100) updatewhereclause=yes name=module dbname="ItemLog.Module"  )
 retrieve="SELECT 
	itemname = (SELECT Item.Name From Item WHERE item.icode = itemlog.icode),
	ItemRowId,
	LogDate, 
	ICode,
	Name, 
	AliasName=CustomICode,
	UserName=(SELECT Users.UserName FROM Users WHERE Users.UserCode = ItemLog.UserCode),
	ChangeReason,
	Module
FROM 
	ItemLog
WHERE 
	logdate >= :ad_startdate AND logdate <= :ad_enddate AND
	ICODE IN 
		(SELECT ICode
		FROM
			(SELECT ICode, CustomICode FROM ItemLog
				WHERE logdate >= :ad_startdate AND logdate <= :ad_enddate
			UNION ALL
			SELECT ICode, CustomICode FROM ItemLog
				WHERE ItemRowID IN (SELECT MIN(ItemRowID) FROM ItemLog WHERE logdate >= :ad_enddate)
			UNION ALL
			SELECT ICode, CustomICode FROM Item
				WHERE	Icode not in (SELECT ICode FROM Itemlog where logdate >= :ad_enddate)) T
		GROUP BY ICode
		HAVING COUNT(DISTINCT CustomICode) > 1)
UNION ALL
SELECT 	
	itemname = (SELECT Item.Name From Item WHERE item.icode = itemlog.icode),
	ItemRowId,
	LogDate, 
	ICode,
	Name,
	AliasName=CustomICode,
	UserName=(SELECT Users.UserName FROM Users WHERE Users.UserCode = ItemLog.UserCode),
	ChangeReason,
	Module
FROM 
	ItemLog
WHERE 
	ItemRowID IN (SELECT MIN(ItemRowID) FROM ItemLog WHERE logdate >= :ad_enddate) AND 
	ICODE IN 
	(SELECT ICode
	FROM
		(SELECT ICode, CustomICode FROM ItemLog
			WHERE logdate >= :ad_startdate AND logdate <= :ad_enddate
		UNION ALL
		SELECT ICode, CustomICode FROM ItemLog
			WHERE ItemRowID IN (SELECT MIN(ItemRowID) FROM ItemLog WHERE logdate >= :ad_enddate)
		UNION ALL
		SELECT ICode, CustomICode FROM Item
			WHERE	Icode not in (SELECT ICode FROM Itemlog where logdate >= :ad_enddate)) T
	GROUP BY ICode
	HAVING COUNT(DISTINCT CustomICode) > 1)
UNION ALL
SELECT 
	itemname = Item.Name,
	ItemRowId=999999999, 
	LogDate=lastupdate, 
	ICode,
	Name,
	AliasName=CustomICode,
	UserName=(SELECT Users.UserName FROM Users WHERE Users.UserCode = Item.UserCode),
	ChangeReason,
	Module
FROM 
	Item
WHERE	
	Icode not in (SELECT ICode FROM Itemlog where logdate >= :ad_enddate) AND
	ICODE IN 
		(SELECT ICode
		FROM
			(SELECT ICode, CustomICode FROM ItemLog
				WHERE logdate >= :ad_startdate AND logdate <= :ad_enddate
			UNION ALL
			SELECT ICode, CustomICode FROM ItemLog
				WHERE ItemRowID IN (SELECT MIN(ItemRowID) FROM ItemLog WHERE logdate >= :ad_enddate)
			UNION ALL
			SELECT ICode, CustomICode FROM Item
				WHERE	Icode not in (SELECT ICode FROM Itemlog where logdate >= :ad_enddate)) T
		GROUP BY ICode
		HAVING COUNT(DISTINCT CustomICode) > 1)	
ORDER BY
	itemname, 
	icode,
	itemrowid
"
  update="ItemLog" updatewhere=1 updatekeyinplace=no
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
)
