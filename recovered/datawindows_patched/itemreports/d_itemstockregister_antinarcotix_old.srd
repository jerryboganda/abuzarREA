table(column=(type=char(11) updatewhereclause=yes name=type dbname="type"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="Postdate"  )
column=(type=char(1) updatewhereclause=yes name=due dbname="Due"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(60) updatewhereclause=yes name=title dbname="title"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=decimal(4) updatewhereclause=yes name=qtyin dbname="qtyIn"  )
column=(type=decimal(4) updatewhereclause=yes name=qtyout dbname="qtyOut"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="batch"  )
column=(type=decimal(2) updatewhereclause=yes name=purdetail_purprice dbname="Purdetail.purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=purdetail_discperc dbname="Purdetail.discperc"  )
column=(type=decimal(5) updatewhereclause=yes name=purdetail_avgprice dbname="Purdetail.avgprice"  )
column=(type=long updatewhereclause=yes name=balqty dbname="balqty"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="rate"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes name=toutqty dbname="toutqty"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=char(251) updatewhereclause=yes name=reference dbname="reference"  )
column=(type=decimal(8) updatewhereclause=yes name=price dbname="price"  )
column=(type=decimal(2) updatewhereclause=yes name=discount dbname="discount"  )
column=(type=decimal(0) updatewhereclause=yes name=utn dbname="UTN"  )
 retrieve="select	type = 'PV-' + RTrim(LTrim(convert(char(6), purledger.purinvcode))),
	Postdate = purledger.postdate,
	Due = null, 
	date = purledger.postdate, 
	salesman = users.username ,
	title = Case When purcatcode = 1 or purcatcode = 2 or purcatcode = 7 or purcatcode = 8  Then 
			(Select accounts.name From accounts
			Where accounts.acccode = purledger.suppcode)	
		     Else 'Opening Purchase'	
		     End,
	gcode = 0,
	qtyIn = Case When purledger.purcatcode IN (3,7, 8)  THEN
	               purdetail.looseqty + (purdetail.packqty * purdetail.packunits) + purdetail.bonusqty
		Else  purdetail.looseqty + (purdetail.packqty * purdetail.packunits) + (purdetail.bonusqty * purdetail.packunits)
               	END,
	qtyOut= 0,
	batch = purdetail.batch,
	purdetail.purprice,
	purdetail.discperc,
	purdetail.avgprice,
	balqty=0,
	rate=0.00,
	itemname=(Select item.name from item where icode = :ar_icode) ,
	toutqty=0,
	expiry=purdetail.expiry,
	reference = '         ',
	price = Case When purcatcode = 3 or purcatcode = 7 or purcatcode = 8 Then 
			purdetail.purprice
		Else purdetail.purprice / purdetail.packunits End,
	discount = purdetail.DiscPerc,
	UTN=IsNull(purdetail.purutn, 0)
from  purledger, purdetail, users
where purledger.purinvcode = purdetail.purinvcode and	
	 	purdetail.icode = :ar_icode	and 	
	 	purledger.postdate between :ar_stdate and :ar_enddate 	and
		purledger.Posted = 'Y' and 
		purledger.salesmancode = users.usercode
UNION	
select	type = 'IssV-' + RTrim(LTrim(convert(char(6), IssueHeader.issueinvcode))),
	Postdate = IssueHeader.postdate,
	Due = null,
	date = IssueHeader.date,
	salesman = users.username ,
	title = (SELECT department.name from department where department.deptcode=issueheader.deptcode),
	gcode = 0,
	qtyIn = 0,
	qtyOut= qty,
	batch = Issuedetail.batch,
	Issuedetail.purchaseprice,
	disc=0,
	Issuedetail.avgprice,
	balqty=0,
	rate=0.00,
	itemname=(Select item.name from item where icode = :ar_icode) ,
	toutqty=0,
	expiry=Issuedetail.expiry,
	reference = ISNULL((select name from issuetype where issuetypecode = issueheader.issuetypecode), '') + CASE issueheader.issuetypecode WHEN NULL THEN '' ELSE '-' END + dbo.issueheader.referenceno,
	price = issuedetail.purchaseprice,
	discount = 0,
	UTN=IsNull(issuedetail.issueutn, 0)
from  Issueheader, issuedetail, users	  
where issueheader.issueinvcode = issuedetail.issueinvcode and	
	 	issuedetail.icode = :ar_icode	and 	
	 	issueheader.date between :ar_stdate and :ar_enddate 	and
		/*issueheader.Posted = 'Y' and */
		issueheader.salesmancode = users.usercode
UNION	
select	type = 'PR-' + RTrim(LTrim(convert(char(6), prledger.prinvcode))),
	Postdate = prledger.postdate,
	Due = null,
	date = prledger.date,
	salesman = users.username ,
	title = Case When prcatcode = 4 or prcatcode = 5 Then 
			(Select accounts.name from accounts where accounts.acccode = prledger.suppcode)	
		 Else 'Opening Purchase Return'	End,
	gcode = 0,
	QtyIn = 0,
	QtyOut= prdetail.looseqty + (prdetail.packqty * prdetail.packunits) + prdetail.bonusqty,
	batch = prdetail.batch,
	prdetail.prprice,
	prdetail.discperc,
	prdetail.avgprice,
	balqty=0,
	rate=0.00,
	itemname='                                        '				,
	toutqty=0,
	expiry=prdetail.expiry,
	reference = '          ',
	price = prdetail.prprice,
	discount = prdetail.DiscPerc,
	UTN=IsNull(prdetail.prutn, 0)
from   prledger, prdetail, users
where  prledger.prinvcode = prdetail.prinvcode and	
		 prdetail.icode = :ar_icode		and 	
		 prledger.date between :ar_stdate and :ar_enddate 	and
		 prledger.salesmancode = users.usercode
UNION
select	type = Case  saleledger.salecatcode
		   When  1 Then 'WS-'	
		   When  2 Then 'WS-'	 
		   When  3 Then 'RS-'	 
  		   When  4 Then 'CS-'		
		   Else  'UK-'		
		End + RTrim(LTrim(convert(char(6), saleledger.saleinvcode))),
	Postdate = saleledger.postdate,
	Due = saledetail.Due,
	date = saleledger.date,
	salesman = users.username ,
	title= /*Case	 
			When (salecatcode = 3) Then 'Retail Sale Cash'
			When (salecatcode = 1) Then 'Whole Sale Cash'
			Else 'Whole Sale Credit' 
			End,*/
		Case 	
		When salecatcode = 1 or salecatcode = 2 Then (Select accounts.name from accounts where accounts.acccode = saleledger.custcode)	
		Else /*'Retail Sale'*/ 'Cash Sale' End,
	saledetail.gcode,
	qtyIn = 0,
	QtyOut= saledetail.looseqty+saledetail.bonusqty,
	batch = saledetail.batch,
	saledetail.saleprice,
	saledetail.discperc,
	saledetail.rate,
	balqty=0,
	rate=0.00,
	itemname='                                        '				,
	toutqty=0,
	expiry=saledetail.expiry,
	reference = saleledger.Remarks,
	price = saledetail.saleprice,
	discount = saledetail.DiscPerc,
	UTN=IsNull(saledetail.saleutn, 0)
from	saleledger, saledetail, users	  	
where	saleledger.saleinvcode = saledetail.saleinvcode and	
	saledetail.icode = :ar_icode and 
	saleledger.date Between  :ar_stdate and :ar_enddate and
	saleledger.salesmancode = users.usercode
union 	
select	type =	Case  srledger.srcatcode	
		   When 8 Then 'RR-'	
		   Else        'WR-'		
		End + 
		RTrim(LTrim(convert(char(6), srledger.srinvcode))),
	Postdate = srledger.postdate,
	Due=null,
	date = srledger.postdate,
	salesman = users.username ,
	title= Case When srcatcode = 6 or srcatcode = 7 Then 
			(Select accounts.name from accounts where accounts.acccode = srledger.custcode)	
		Else /*'Retail Sale Return Cash'*/ 'Cash Sale Return' End,
	srdetail.gcode,
	qtyIn = srdetail.looseqty+srdetail.bonusqty,
	QtyOut= 0,
	batch = srdetail.batch,
	srdetail.srprice,
	srdetail.discperc,
	srdetail.newavgprice,
	balqty=0,
	rate=0.00,
	itemname='                                        '				,
	toutqty=0,
	expiry=srdetail.expiry,
	reference = '                ',
	price = srdetail.srprice,
	discount = srdetail.DiscPerc,
	UTN=IsNull(srdetail.srutn, 0)
from	srledger, srdetail, users
where	srledger.srinvcode = srdetail.srinvcode and	
		 srdetail.icode = :ar_icode		and 	
		 srledger.postdate between :ar_stdate and :ar_enddate and
		 srledger.posted = 'Y' and
		 srledger.salesmancode = users.usercode
union
select	type = 'SN-' + RTrim(LTrim(convert(char(6),DueSatisfyHeader.saleinvcode))),
	Postdate = Null,
	Due = 'A',
	date = DueSatisfyHeader.DueSatisfyDate,
	salesman = users.username ,
	Case 	
	When (Select saleledger.salecatcode from saleledger
		Where Saleledger.saleinvcode = DueSatisfyHeader.saleinvcode) = 1 
		or(Select saleledger.salecatcode from saleledger
		 Where Saleledger.saleinvcode = DueSatisfyHeader.saleinvcode) = 2 Then 
			(Select accounts.name from accounts, saleledger 
				where Saleledger.saleinvcode = DueSatisfyHeader.saleinvcode  and 
				accounts.acccode = saleledger.custcode)	
		 Else /*'Retail Sale Cash'*/ 'Cash Sale' End,
	DueSatisfyDetail.gcode,
	qtyIn = 0,
	QtyOut= DueSatisfyDetail.DueSatisfyqty,
	batch = DueSatisfyDetail.batch,
	0,
	0,
	0,
	balqty=0,
	rate=0.00,
	itemname='                                        '				,
	toutqty=0,
	expiry=DueSatisfyDetail.expiry,
	reference = '         ' ,
	price = (select saleprice from saledetail 
		where saledetail.saleinvcode = duesatisfyheader.saleinvcode and 
			saledetail.icode = :ar_icode
	        group by icode, saleprice),
	discount = 	(select DiscPerc from saledetail 
		    	where saledetail.saleinvcode = duesatisfyheader.saleinvcode and 
			saledetail.icode = :ar_icode
			group by icode, DiscPerc),
	UTN=IsNull(duesatisfydetail.duesatisfyutn, 0)
from	DueSatisfyHeader, DueSatisfydetail, users
where	DueSatisfyHeader.DueSatisfyCode = DueSatisfyDetail.DueSatisfyCode and	
	DueSatisfyDetail.icode = :ar_icode			and 	
	DueSatisfyHeader.DueSatisfydate between :ar_stdate and :ar_enddate and
	DueSatisfyHeader.usercode = users.usercode
union
select	type = 'DN-' + RTrim(LTrim(convert(char(6), DueSatisfyHeader.saleinvcode))),
	Postdate = Null,
	Due = 'B',
	date = DueSatisfyHeader.DueSatisfyDate,
	salesman = users.username ,
	case 	
	When (Select saleledger.salecatcode from saleledger
		Where Saleledger.saleinvcode = DueSatisfyHeader.saleinvcode) = 1 
		or(Select saleledger.salecatcode from saleledger
		 Where Saleledger.saleinvcode = DueSatisfyHeader.saleinvcode) = 2 Then 
			(Select accounts.name from accounts, saleledger 
			where Saleledger.saleinvcode = DueSatisfyHeader.saleinvcode  and 
			accounts.acccode = saleledger.custcode)	
	Else /*'Retail Sale Cash'*/ 'Cash Sale'	End,
	0,
	qtyIn = 0,
	QtyOut= DueDeleteDetail.deletedqty,
	batch = '',
	0,
	0,
	0,
	balqty=0,
	rate=0.00,
	itemname='                                        '				,
	toutqty=0,
	expiry=null,
	reference = '         ',
	price = (select saleprice from saledetail 
		where saledetail.saleinvcode = duesatisfyheader.saleinvcode and 
			saledetail.icode = :ar_icode
		group by icode, saleprice),
	discount =	(select DiscPerc from saledetail 
			where saledetail.saleinvcode = duesatisfyheader.saleinvcode and 
				saledetail.icode = :ar_icode
			group by icode, DiscPerc),
	UTN=0
from   DueSatisfyHeader, DueDeletedetail, users	  	
where  DueSatisfyHeader.DueSatisfyCode = DueDeleteDetail.DueSatisfyCode and	
	 DueDeleteDetail.icode = :ar_icode			and 	
	 DueSatisfyHeader.DueSatisfydate between :ar_stdate and :ar_enddate and
	 DueSatisfyHeader.usercode = users.usercode
UNION
select   type = Case  adjheader.adjcatcode	
		   When 1 Then 'AI-'	
		   Else        'AD-'		
		End + RTrim(LTrim(convert(char(6), adjheader.adjcode))),
	Postdate = adjheader.posteddate,
	Due=null,
	date = adjheader.posteddate,
	salesman = users.username ,
	title= (Select adjcategory.name from adjcategory where adjcategory.adjcatcode = adjheader.adjcatcode),
	adjdetail.gcode,
	qtyIn = Case  adjheader.adjcatcode When 1 THEN adjdetail.looseqty ELSE 0 END,
	QtyOut= Case  adjheader.adjcatcode When 2 THEN adjdetail.looseqty ELSE 0 END,
	batch = adjdetail.batch,
	adjdetail.price,
	discperc=0,
	adjdetail.avgprice,
	balqty=0,
	rate=0.00,
	itemname='                                        '				,
	toutqty=0,
	expiry=adjdetail.expiry,
	reference = '                ',
	price = adjdetail.price,
	discount = 0,
	UTN=IsNull(adjdetail.adjutn, 0)
from adjheader, adjdetail, users
where  adjheader.adjcode = adjdetail.adjcode and
		 adjdetail.icode = :ar_icode		and 	
		 adjheader.posteddate between :ar_stdate and :ar_enddate and
		 adjheader.posted = 'Y' and
		 adjheader.usercode = users.usercode
UNION
select   type = 'RC' + RTrim(LTrim(convert(char(6), ReceiptHeader.ReceiptInvCode))),
	Postdate = ReceiptHeader.postdate,
	Due=null,
	date = ReceiptHeader.postdate,
	salesman = users.username ,
	title= (Select department.name from department where department.deptcode = ReceiptHeader.deptcode),
	ReceiptDetail.gcode,
	qtyIn = ReceiptDetail.qty,
	QtyOut= 0,
	batch = ReceiptDetail.batch,
	ReceiptDetail.saleprice,
	discperc=0,
	ReceiptDetail.avgprice,
	balqty=0,
	rate=0.00,
	itemname='                                        ',
	toutqty=0,
	expiry=ReceiptDetail.expiry,
	reference = ReceiptHeader.ReferenceNo,
	price = ReceiptDetail.saleprice,
	discount = 0,
	UTN=IsNull(receiptdetail.receiptutn, 0)
from ReceiptHeader, ReceiptDetail, users
where  ReceiptHeader.ReceiptInvCode = ReceiptDetail.ReceiptInvCode and
		 ReceiptDetail.icode = :ar_icode		and 	
		 ReceiptHeader.postdate between :ar_stdate and :ar_enddate and
		 ReceiptHeader.posted = 'Y' and
		 ReceiptHeader.salesmancode = users.usercode
Order By utn, date,	batch,expiry
"
  arguments=(("ar_icode", number), ("ar_stdate", datetime), ("ar_enddate", datetime), ("al_OpeningBalance", number))
)
