table(column=(type=char(77) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname2 dbname="AliasName2"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="PackingDesc"  )
column=(type=char(60) updatewhereclause=yes name=itemcategory dbname="itemcategory"  )
column=(type=decimal(2) updatewhereclause=yes name=oldsaleprice dbname="OldSalePrice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=char(21) updatewhereclause=yes name=rssaleprice dbname="RsSalePrice"  )
column=(type=long updatewhereclause=yes name=qty dbname="Qty"  )
 retrieve="SELECT 
	AliasName = '*' + Item.CustomICode + '*',
	AliasName2 = Item.CustomICode,
	Name = Item.Name,
	PackingDesc=Item.PackingDesc,
	itemcategory=(select name from itemcategory where itemcategory.icatcode=itemlog.icatcode),
	OldSalePrice = ItemLog.SalePrice,
	SalePrice = ItemLog.NewSalePrice,
	RsSalePrice = 'Rs.:' +'  '+ Convert(varchar(15), CAST(ROUND(ItemLog.NewSalePrice * (1 - itemlog.salediscperc * 0.01),2) AS NUMERIC(12,2))),
	Qty = 1
FROM 
	itemlog, 
	(SELECT L.ICode, MaxID=MAX(L.ItemRowID)
	FROM itemlog L
	WHERE L.logdate >= :ar_startdate AND 
		L.logdate <= :ar_enddate AND 
		L.icatcode in (:aa_icatcode) AND 
		(L.saleprice <> L.newsaleprice)
	GROUP BY L.ICode) T,
	Item
WHERE
	ItemLog.ItemRowId = T.MaxID AND
	ItemLog.ICode = Item.ICode
ORDER BY 
	itemcategory, 
	Name
"
  arguments=(("ar_startdate", datetime), ("ar_enddate", datetime), ("aa_icatcode", numberlist))
)
