summary(height=10 color="536870912" )
footer(height=0 color="536870912" )
detail(height=1489 color="536870912" )
table(column=(type=char(100) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(2) updatewhereclause=yes name=marketprice dbname="marketprice"  )
column=(type=decimal(2) updatewhereclause=yes name=storeprice dbname="storeprice"  )
 retrieve="SELECT itemname=remarks,
			marketprice=item.saleprice,
			storeprice=saleprice - flatdisc
FROM
		Item
WHERE Icode IN (:aa_icode)
	"
  arguments=(("aa_icode", numberlist))
)
