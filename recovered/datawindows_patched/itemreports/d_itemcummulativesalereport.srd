release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=492 color="536870912" )
summary(height=96 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long updatewhereclause=yes name=invcode dbname="INVCODE"  )
column=(type=datetime updatewhereclause=yes name=date dbname="DATE"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(50) updatewhereclause=yes name=regno dbname="RegNo"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="ALIASNAME"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="ITEM"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="QTY"  )
column=(type=decimal(4) updatewhereclause=yes name=cummulativesaleqty dbname="CummulativeSaleQty"  )
 retrieve="SELECT 
	INVCODE=SL.SALEINVCODE, 
	DATE=SL.DATE, 
	Remarks=SL.Remarks,
	RegNo=P.RegNo,
	Patient=P.Name,
	Doctor=(SELECT D.Name FROM Doctors D WHERE D.DoctCode = SL.DoctCode),
	ALIASNAME=I.CUSTOMICODE, 
	ITEM=I.NAME,  
	QTY=SUM(SD.LOOSEQTY), 
	CummulativeSaleQty=SUM(PS.Qty)
FROM
	SaleLedger SL,
	SaleDetail SD,
	Item I,
	Patient P,
	(SELECT 
		D.ICode, S.PatientCode, Qty=SUM(D.LooseQTY)
	FROM 
		SaleLedger S, 
		SaleDetail D, 
		(SELECT T1.PatientCode, T2.ICode
		FROM
			(SELECT DISTINCT PatientCode FROM SaleLedger WHERE Date BETWEEN :AD_STARTDATE AND :AD_ENDDATE) T1,
			(SELECT ICode FROM Item WHERE ICode IN (:AI_ICODE)) T2) T
	WHERE 
		S.Date < :AD_ENDDATE AND 
		S.SaleInvCode = D.SaleInvCode AND
		D.ICode = T.ICode AND
		S.PatientCode = T.PatientCode
	GROUP BY 
		D.ICode, S.PatientCode) PS
WHERE
	SL.Date BETWEEN :AD_STARTDATE AND :AD_ENDDATE AND
	SL.SaleInvCode = SD.SaleInvCode AND
	SD.ICode = I.ICode AND
	I.ICode IN (:AI_ICODE) AND
	SL.PatientCode = P.PatientCode AND
	P.PatientCode = PS.PatientCode AND 
	I.ICode = PS.ICode
GROUP BY
	I.CUSTOMICODE, 
	I.NAME,  
	P.RegNo,
	P.Name,
	SL.SALEINVCODE, 
	SL.DATE, 
	SL.Remarks,
	SL.DoctCode

/*
SELECT 
	INVCODE=S.SALEINVCODE, 
	DATE=S.DATE, 
	Remarks=S.Remarks,
	RegNo=(SELECT P.RegNo FROM Patient P WHERE P.PatientCode = S.PatientCode),
	Patient=(SELECT P.Name FROM Patient P WHERE P.PatientCode = S.PatientCode),
	Doctor=(SELECT D.Name FROM Doctors D WHERE D.DoctCode = S.DoctCode),
	ALIASNAME=I.CUSTOMICODE, 
	ITEM=I.NAME,  
	QTY=SUM(SD.LOOSEQTY), 
	CummulativeSaleQty=(SELECT SUM(DD.LooseQty) 
	FROM SaleLedger SS, SaleDetail DD 
	WHERE SS.PatientCode = S.PatientCode AND DD.ICode = SD.ICode AND
		SS.SaleInvCode <= S.SaleInvCode AND SS.Date <= S.Date AND SS.SaleInvCode = DD.SaleInvCode)
FROM 
	SALELEDGER S, 
	SALEDETAIL SD,
	ITEM I
WHERE 
	S.DATE BETWEEN :AD_STARTDATE AND :AD_ENDDATE AND
	S.SALEINVCODE = SD.SALEINVCODE AND
	SD.ICODE IN (:AI_ICODE) AND
	SD.ICODE = I.ICODE
GROUP BY
	S.SALEINVCODE, 
	S.DATE,
	S.Remarks, 
	S.PatientCode, 
	S.DoctCode,
	SD.ICode,
	I.CUSTOMICODE, 
	I.NAME
ORDER BY
	ITEM,
	ALIASNAME, 
	DATE, 
	INVCODE, 
	Patient

*/"
  arguments=(("AI_ICODE", numberlist), ("AD_STARTDATE", datetime), ("AD_ENDDATE", datetime))
 sort="item A, patient A, date A, invcode A"
)
