release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=2 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no rows_per_detail=3)
header(height=0 )
summary(height=0 color="536870912" )
footer(height=4 color="536870912" )
detail(height=776 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=name dbname="Item.Name"  )
column=(type=long updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=char(60) updatewhereclause=yes name=groupname dbname="groupname"  )
 retrieve="SELECT Name,
		saleprice=convert(int,saleprice),
		/*itemclass=(select name from itemclass where itemclass.iccode=item.iccode)*/
		groupname=(CASE :as_grouptype WHEN 'M' THEN (select Manufacturer.name from manufacturer where manufacturer.manfcode= item.manfcode)
												 	WHEN 'C' THEN (select itemcategory.name from itemcategory where itemcategory.icatcode= item.icatcode)
													WHEN 'P' THEN (select itempacking.name from itempacking where itempacking.packcode= item.packcode)
													 ELSE (select itemclass.name from itemclass where itemclass.iccode= item.iccode) END)
from item
where CASE :as_grouptype 
		WHEN 'M' THEN Item.ManfCode
		WHEN 'C' THEN Item.ICatCode 
		WHEN 'P' THEN item.PackCode 
		ELSE Item.ICCode END IN (:ai_groupcode) 

order by groupname,
			name
"
  arguments=(("as_grouptype", string), ("ai_groupcode", numberlist))
)
