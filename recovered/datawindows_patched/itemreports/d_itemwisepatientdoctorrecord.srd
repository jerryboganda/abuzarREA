table(column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=long updatewhereclause=yes name=saleinvcode dbname="SaleInvCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=patient dbname="Patient"  )
column=(type=char(201) updatewhereclause=yes name=patientaddress dbname="PatientAddress"  )
column=(type=char(1) updatewhereclause=yes name=gender dbname="Gender" 
 values="Male	M/Female	F/"  )
column=(type=char(60) updatewhereclause=yes name=doctor dbname="Doctor"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonus dbname="Bonus"  )
 retrieve="SELECT 
	ICode=I.ICode,
	ItemName=I.Name, 
	AliasName=I.CustomICode, 
	SaleInvCode=S.SaleInvCode, 
	Date = S.Date, 
	Patient = P.Name,
	PatientAddress = ISNULL(P.Address1, '') + ' ' + ISNULL(P.Address2, ''),
	Gender = P.Gender,
	Doctor = D.Name,
	Qty =  SUM(SD.LooseQty),
	Bonus = SUM(SD.BonusQty)
FROM 
	SaleLedger S, SaleDetail SD, Item I, Patient P, Doctors D
WHERE 
	I.ICode IN (:al_icode) AND
	I.ICode = SD.ICode AND
	S.Date BETWEEN :adt_startdate AND :adt_enddate AND
	S.PatientCode > 0 AND S.DoctCode > 0 AND
	S.PatientCode = P.PatientCode AND 
	S.DoctCode = D.DoctCode AND
	S.SaleInvCode = SD.SaleInvCode
GROUP BY
	I.ICode, 
	I.Name, 
	I.CustomICode, 
	S.SaleInvCode, 
	S.Date,
	S.PatientCode,
	S.DoctCode,
	P.Name,
	D.Name,
	P.Address1,
	P.Address2,
	P.Gender
ORDER BY
	ItemName,
	Date,
	SaleInvCode"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime), ("al_icode", numberlist))
)
