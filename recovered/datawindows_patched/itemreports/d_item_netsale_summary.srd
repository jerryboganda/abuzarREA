datawindow ( units=2 timer_interval=60000 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=200 print.margin.right=200 print.margin.top=200 print.margin.bottom=200 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1427 color="536870912" )
summary(height=187 color="536870912" )
footer(height=0 color="536870912" )
detail(height=187 color="536870912" )
table(column=(type=long updatewhereclause=yes name=itemcode dbname="ItemCode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=suppliername dbname="SupplierName"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="Manufacturer"  )
column=(type=decimal(4) updatewhereclause=yes name=totalqty dbname="TotalQty"  )
column=(type=decimal(6) updatewhereclause=yes name=salevalueattp dbname="SaleValueAtTP"  )
column=(type=decimal(12) updatewhereclause=yes name=salevalueatsp dbname="SaleValueAtSP"  )
column=(type=decimal(7) updatewhereclause=yes name=salevalueatnp dbname="SaleValueAtNP"  )
column=(type=decimal(6) updatewhereclause=yes name=salestax dbname="SalesTax"  )
column=(type=decimal(6) updatewhereclause=yes name=avgtp dbname="AvgTP"  )
column=(type=decimal(8) updatewhereclause=yes name=avgsp dbname="AvgSP"  )
column=(type=decimal(6) updatewhereclause=yes name=avgnp dbname="AvgNP"  )
 retrieve="SELECT
	ItemCode = T.ICode,
	ItemName = I.Name,
	AliasName = I.CustomICode,
	SupplierName = 
		(SELECT A.Name 
		FROM Accounts A 
		WHERE A.AccCode IN 
			(SELECT Pur.SuppCode 
			FROM PurLedger Pur 
			WHERE Pur.PurInvCode IN
				(SELECT MAX(PL.PurInvCode) 
				FROM PurLedger PL, PurDetail PD
				WHERE PL.PurInvCode = PD.PurInvCode AND 
					PL.Date <= :adt_enddate AND
					PL.Posted='Y' AND 
					PD.ICode=I.ICode)
			)
		),
	Manufacturer = M.Name,
	TotalQty = T.Qty,
	SaleValueAtTP = T.SaleValueAtTP,
	SaleValueAtSP = T.SaleValueAtSP,
	SaleValueAtNP = T.SaleValueAtNP,
	SalesTax = T.SalesTax,
	AvgTP = T.SaleValueAtTP / CASE WHEN T.Qty IS NULL OR T.Qty = 0 THEN 1 ELSE T.Qty END,
	AvgSP = T.SaleValueAtSP / CASE WHEN T.Qty IS NULL OR T.Qty = 0 THEN 1 ELSE T.Qty END,
	AvgNP = T.SaleValueAtNP / CASE WHEN T.Qty IS NULL OR T.Qty = 0 THEN 1 ELSE T.Qty END
FROM
	(SELECT
		ICode = S.ICode,
		Qty = SUM(S.Qty),
		SaleValueAtTP = SUM(S.SaleValueAtTP),
		SaleValueAtSP = SUM(S.SaleValueAtSP),
		SaleValueAtNP = SUM(S.SaleValueAtNP),
		SalesTax = SUM(S.SalesTax)
	FROM
		(SELECT 
			ICode = SD.ICode,
			Qty = SUM(SD.LooseQty + SD.BonusQty),
			SaleValueAtTP = SUM((SD.LooseQty + SD.BonusQty) * SD.PurUnitRate),
			SaleValueAtSP = SUM((SD.LooseQty + SD.BonusQty) * Round(SD.PackPrice / CASE WHEN SD.PackUnits IS NULL OR SD.PackUnits = 0 THEN 1 ELSE SD.PackUnits END, 2)),
			SaleValueAtNP = SUM((SD.LooseQty + SD.BonusQty) * SD.SalePrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
			SalesTax = SUM((SD.LooseQty + SD.BonusQty) * SD.SalePrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01) + 
					SUM((SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax)
		FROM
			SaleLedger SL,
			SaleDetail SD
		WHERE 
			SL.Posted = 'Y' AND
			SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
			SL.SaleInvCode = SD.SaleInvCode
		GROUP BY
			SD.ICode
		UNION ALL
		SELECT 
			ICode = SD.ICode,
			Qty = SUM(SD.LooseQty + SD.BonusQty),
			SaleValueAtTP = - SUM((SD.LooseQty + SD.BonusQty) * SD.SRPrice),
			SaleValueAtSP = - SUM((SD.LooseQty + SD.BonusQty) * Round(SD.SalePrice / CASE WHEN SD.PackUnits IS NULL OR SD.PackUnits = 0 THEN 1 ELSE SD.PackUnits END, 2)),
			SaleValueAtNP = - SUM((SD.LooseQty + SD.BonusQty) * SD.SRPrice * (1 - SD.DiscPerc * 0.01) * (1 - SL.DiscPerc * 0.01)),
			SalesTax = - SUM((SD.LooseQty + SD.BonusQty) * SD.SrPrice * (1 - SD.DiscPerc * 0.01) * SD.GSTPerc * 0.01) + 
					SUM((SD.LooseQty + SD.BonusQty) * SD.UnitSalesTax)
		FROM
			SrLedger SL,
			SrDetail SD
		WHERE 
			SL.Posted = 'Y' AND
			SL.Date BETWEEN :adt_startdate AND :adt_enddate AND
			SL.SrInvCode = SD.SrInvCode
		GROUP BY
			SD.ICode) S
	GROUP BY
		S.ICode) T,
	Item I,
	Manufacturer M
WHERE 
	T.ICode = I.ICode AND
	I.ManfCode = M.ManfCode
ORDER BY
	ItemName"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
)
