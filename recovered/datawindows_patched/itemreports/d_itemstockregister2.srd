release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=812 color="536870912" )
summary(height=76 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=name dbname="name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=decimal(2) updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(4) updatewhereclause=yes name=sale dbname="sale"  )
column=(type=decimal(4) updatewhereclause=yes name=salereturn dbname="salereturn"  )
column=(type=decimal(4) updatewhereclause=yes name=packpurchase dbname="packpurchase"  )
column=(type=decimal(4) updatewhereclause=yes name=loosepurchase dbname="loosepurchase"  )
column=(type=decimal(4) updatewhereclause=yes name=issue dbname="issue"  )
column=(type=decimal(4) updatewhereclause=yes name=receipt dbname="receipt"  )
column=(type=decimal(4) updatewhereclause=yes name=adjincrease dbname="adjincrease"  )
column=(type=decimal(4) updatewhereclause=yes name=purdetail_adjdecrease dbname="Purdetail.adjdecrease"  )
column=(type=decimal(4) updatewhereclause=yes name=purdetail_purchasereturn dbname="Purdetail.purchasereturn"  )
 retrieve="/*////////////////////////  Purchase /////////////////////////////////// */	
select type = 'PV-' + RTrim(LTrim(convert(char(6),
 purledger.purinvcode))),
Postdate = purledger.postdate,












Due = null,












     date = purledger.postdate,












		salesman = users.username ,












		 title = Case	 
					When purcatcode = 1 or purcatcode = 2 or purcatcode = 7 or purcatcode = 8  Then (Select accounts.name
					  
        
        
        
        
        
        
        
        From accounts 
					
        
        
        
        
        
        
        
        Where accounts.acccode = purledger.suppcode)	
					Else 'Opening Purchase'	
					End,












		 gcode = 0,












		 qtyIn = Case When purledger.purcatcode IN (3,






 7,






 8)  THEN purdetail.looseqty + (purdetail.packqty * purdetail.packunits) + purdetail.bonusqty
							Else  purdetail.looseqty + (purdetail.packqty * purdetail.packunits) + (purdetail.bonusqty * purdetail.packunits) END,












		 qtyOut= 0,












		 batch = purdetail.batch,












		 purdetail.purprice,












		 purdetail.discperc,












		 purdetail.avgprice,












		 balqty=0,












		 rate=0.00,












		 itemname=(Select item.name from item where icode = :ar_icode) ,












		toutqty=0,












		expiry=purdetail.expiry,









		reference = '         ',






		price = Case When purcatcode = 3 or purcatcode = 7 or purcatcode = 8 
						Then purdetail.purprice
						Else purdetail.purprice / purdetail.packunits 
						End,






		discount = purdetail.DiscPerc

from  purledger,












		purdetail,












		users	  

where purledger.purinvcode = purdetail.purinvcode and	
	 	purdetail.icode = :ar_icode	and 	
	 	purledger.postdate between :ar_stdate and :ar_enddate 	and
		purledger.Posted = 'Y' and 
		purledger.salesmancode = users.usercode

UNION	

/*////////////////////////  Purchase Return//////////////////////////// */	
select type = 'PR-' + RTrim(LTrim(convert(char(6),











 prledger.prinvcode))),












Postdate = prledger.date,












		Due = null,












	    date = prledger.postdate,












		 salesman = users.username ,












	    title = Case	 
		 				When prcatcode = 4 or prcatcode = 5 Then (Select accounts.name from accounts where accounts.acccode = prledger.suppcode)	
		 				Else 'Opening Purchase Return'	
					End,












		 gcode = 0,












		 QtyIn = 0,












		 QtyOut= prdetail.looseqty + (prdetail.packqty * prdetail.packunits) + prdetail.bonusqty,












		 batch = prdetail.batch,












		 prdetail.prprice,












		 prdetail.discperc,












		 prdetail.avgprice,












		 balqty=0,












		 rate=0.00,












		 itemname='                                        '				,












		toutqty=0,












		expiry=prdetail.expiry,









		reference = '          ',






		price = prdetail.prprice,






		discount = prdetail.DiscPerc


from   prledger,












		 prdetail,












			users	  
where  prledger.prinvcode = prdetail.prinvcode and	
		 prdetail.icode = :ar_icode		and 	
		 prledger.postdate between :ar_stdate and :ar_enddate 	and
		 prledger.posted = 'Y' and
		 prledger.salesmancode = users.usercode

UNION

/*////////////////////////  Sale///////////////////////////////////////// */	
select   type = Case  saleledger.salecatcode	
		   When  1 Then 'WS-'	
		   When  2 Then 'WS-'	 
		   When  3 Then 'RS-'	 
  		   When  4 Then 'CS-'		
		   Else  'UK-'		
		End	
		 +
		 RTrim(LTrim(convert(char(6),











saleledger.saleinvcode))),












Postdate = saleledger.postdate,












Due = saledetail.Due,












date = saleledger.date,












salesman = users.username ,












title= /*Case	 
			When (salecatcode = 3) Then 'Retail Sale Cash'
			When (salecatcode = 1) Then 'Whole Sale Cash'
			Else 'Whole Sale Credit' 
			End,












*/
			Case 	
			When salecatcode = 1 or salecatcode = 2 Then (Select accounts.name from accounts where accounts.acccode = saleledger.custcode)	
			Else 'Retail Sale Cash'	
			End,












	 saledetail.gcode,












	 qtyIn = 0,












	 QtyOut= saledetail.looseqty,












	 batch = saledetail.batch,












	 saledetail.saleprice,












	 saledetail.discperc,












	 saledetail.rate,












	 balqty=0,












	 rate=0.00,












	 itemname='                                        '				,












	toutqty=0,












expiry=saledetail.expiry,









reference = saleledger.CustRefNo,






price = saledetail.saleprice,






discount = saledetail.DiscPerc

		
from   saleledger,












		 saledetail,












		 users	  	
where  saleledger.saleinvcode = saledetail.saleinvcode and	
	 saledetail.icode = :ar_icode		and 	
	 saleledger.date Between  :ar_stdate and :ar_enddate and
	 saleledger.salesmancode = users.usercode

union 	

/*////////////////////////  sale Return////////////////////////////////// */	
select   type = Case  srledger.srcatcode	
		   When 8 Then 'RR-'	
		   Else        'WR-'		
		End	
		 + 
		 RTrim(LTrim(convert(char(6),











srledger.srinvcode))),












Postdate = srledger.postdate,












		Due=null,












		 date = srledger.postdate,












		 salesman = users.username ,












		 title= Case 	
			When srcatcode = 6 or srcatcode = 7 Then (Select accounts.name from accounts where accounts.acccode = srledger.custcode)	
			Else 'Retail Sale Return Cash'	
			End,












		 srdetail.gcode,












		 qtyIn = srdetail.looseqty,












 		 QtyOut= 0,












		 batch = srdetail.batch,












		 srdetail.srprice,












		 srdetail.discperc,












		 srdetail.avgprice,












		 balqty=0,












		 rate=0.00,












		 itemname='                                        '				,












		toutqty=0,












expiry=srdetail.expiry,









reference = '                ',






price = srdetail.srprice,






discount = srdetail.DiscPerc


from   srledger,












		 srdetail,












		 users	  	

where  srledger.srinvcode = srdetail.srinvcode and	
		 srdetail.icode = :ar_icode		and 	
		 srledger.postdate between :ar_stdate and :ar_enddate and
		 srledger.posted = 'Y' and
		 srledger.salesmancode = users.usercode


union

select   type = 'SN-' + RTrim(LTrim(convert(char(6),












 DueSatisfyHeader.saleinvcode))),












Postdate = Null,












Due = 'A',












date = DueSatisfyHeader.DueSatisfyDate,












salesman = users.username ,












Case 	
When (Select saleledger.salecatcode from saleledger
	 Where Saleledger.saleinvcode = DueSatisfyHeader.saleinvcode) = 1 
	or(Select saleledger.salecatcode from saleledger
	 Where Saleledger.saleinvcode = DueSatisfyHeader.saleinvcode) = 2 
Then (Select accounts.name from accounts,












saleledger 
	where Saleledger.saleinvcode = DueSatisfyHeader.saleinvcode  and 
		accounts.acccode = saleledger.custcode)	
Else 'Retail Sale Cash'	
End,












	 DueSatisfyDetail.gcode,












	 qtyIn = 0,












	 QtyOut= DueSatisfyDetail.DueSatisfyqty,












	 batch = DueSatisfyDetail.batch,












	 0,












	 0,












	 0,












	 balqty=0,












	 rate=0.00,












	 itemname='                                        '				,












	toutqty=0,












expiry=DueSatisfyDetail.expiry,









reference = '         ' ,






price = (select saleprice 
			from saledetail 
			where saledetail.saleinvcode = duesatisfyheader.saleinvcode and 
					saledetail.icode = :ar_icode
			
        
        
        
        group by icode,



saleprice),





discount = (select DiscPerc 
				from saledetail 
				where saledetail.saleinvcode = duesatisfyheader.saleinvcode and 
						saledetail.icode = :ar_icode
				group by icode,



DiscPerc)
		
from   DueSatisfyHeader,












	 DueSatisfydetail,












	 users	  	
where  DueSatisfyHeader.DueSatisfyCode = DueSatisfyDetail.DueSatisfyCode and	
	 DueSatisfyDetail.icode = :ar_icode			and 	
	 DueSatisfyHeader.DueSatisfydate between :ar_stdate and :ar_enddate and
	 DueSatisfyHeader.usercode = users.usercode


union

select   type = 'DN-' + RTrim(LTrim(convert(char(6),












 DueSatisfyHeader.saleinvcode))),












Postdate = Null,












Due = 'B',












date = DueSatisfyHeader.DueSatisfyDate,












salesman = users.username ,












Case 	
When (Select saleledger.salecatcode from saleledger
	 Where Saleledger.saleinvcode = DueSatisfyHeader.saleinvcode) = 1 
	or(Select saleledger.salecatcode from saleledger
	 Where Saleledger.saleinvcode = DueSatisfyHeader.saleinvcode) = 2 
Then (Select accounts.name from accounts,












saleledger 
	where Saleledger.saleinvcode = DueSatisfyHeader.saleinvcode  and 
		accounts.acccode = saleledger.custcode)	
Else 'Retail Sale Cash'	
End,












	 0,












	 qtyIn = 0,












	 QtyOut= DueDeleteDetail.deletedqty,












	 batch = '',












	 0,












	 0,












	 0,












	 balqty=0,












	 rate=0.00,












	 itemname='                                        '				,












	toutqty=0,












expiry=null,









reference = '         ',






price = (select saleprice 
			from saledetail 
			where saledetail.saleinvcode = duesatisfyheader.saleinvcode and 
					saledetail.icode = :ar_icode
			group by icode,



saleprice),





discount = (select DiscPerc
				from saledetail 
				where saledetail.saleinvcode = duesatisfyheader.saleinvcode and 
						saledetail.icode = :ar_icode
				group by icode,



DiscPerc)
		
from   DueSatisfyHeader,












	 DueDeletedetail,












	 users	  	
where  DueSatisfyHeader.DueSatisfyCode = DueDeleteDetail.DueSatisfyCode and	
	 DueDeleteDetail.icode = :ar_icode			and 	
	 DueSatisfyHeader.DueSatisfydate between :ar_stdate and :ar_enddate and
	 DueSatisfyHeader.usercode = users.usercode

        
        
        
        
        
        
        
        Order By date,












			batch,












			expiry"
  arguments=(("ar_icode", number), ("ar_stdate", datetime), ("ar_enddate", datetime), ("al_OpeningBalance", number))
)
text(name=t_1 visible="1" band=header font.charset="0" font.face="Times New Roman" font.family="1" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" alignment="1" border="0" x="23" y="512" height="64" width="279" text="From Date: " html.valueishtml="0" )
