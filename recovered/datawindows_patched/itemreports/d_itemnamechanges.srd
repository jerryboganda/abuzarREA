table(column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(60) updatewhereclause=yes name=category dbname="category"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=decimal(0) identity=yes updatewhereclause=yes name=itemrowid dbname="ItemLog.ItemRowId"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=icode dbname="ICode"  )
column=(type=char(60) updatewhereclause=yes name=name dbname="Name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) update=yes updatewhereclause=yes name=username dbname="UserName"  )
column=(type=char(100) updatewhereclause=yes name=changereason dbname="ChangeReason"  )
column=(type=char(100) updatewhereclause=yes name=module dbname="Module"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="PurPrice"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
 retrieve="SELECT 
	manufacturer = (select M.Name FROM manufacturer M WHERE M.ManfCode=itemlog.ManfCode),
	category = (select IC.Name FROM ItemCategory IC WHERE IC.ICatCode=itemlog.icatcode),
	itemname = Item.Name,
	ItemRowId,
	Date=ItemLog.LogDate, 
	ICode=ItemLog.ICode,
	Name=ItemLog.Name, 
	AliasName=ItemLog.CustomICode,
	UserName=(SELECT Users.UserName FROM Users WHERE Users.UserCode = ItemLog.UserCode),
	ChangeReason=ItemLog.ChangeReason,
	Module=ItemLog.Module,
	PurPrice=ItemLog.PurPrice,
	SalePrice=ItemLog.SalePrice
FROM 
	ItemLog, Item
WHERE 
	ItemLog.ICode=Item.ICode AND
	ItemLog.Name <> Item.Name AND
	ItemLog.logdate BETWEEN :adt_startdate AND :adt_enddate AND
	ItemLog.ICODE IN 
		(SELECT ICode
		FROM
			(SELECT ICode, Name FROM ItemLog
				WHERE logdate >= :adt_startdate AND logdate <= :adt_enddate
			UNION ALL
			SELECT ICode, Name FROM ItemLog
				WHERE ItemRowID IN (SELECT MIN(ItemRowID) FROM ItemLog WHERE logdate >= :adt_enddate)
			UNION ALL
			SELECT ICode, Name FROM Item
				WHERE	Icode not in (SELECT ICode FROM Itemlog where logdate >= :adt_enddate)) T
		GROUP BY ICode
		HAVING COUNT(DISTINCT Name) > 1) AND
	ItemLog.Name <> Item.Name
UNION
SELECT 	
	manufacturer = (select M.Name FROM manufacturer M WHERE M.ManfCode=itemlog.ManfCode),
	category = (select IC.Name FROM ItemCategory IC WHERE IC.ICatCode=itemlog.icatcode),
	itemname = Item.Name,
	ItemRowId,
	Date=ItemLog.LogDate, 
	ICode=ItemLog.ICode,
	Name=ItemLog.Name,
	AliasName=ItemLog.CustomICode,
	UserName=(SELECT Users.UserName FROM Users WHERE Users.UserCode = ItemLog.UserCode),
	ChangeReason=ItemLog.ChangeReason,
	Module=ItemLog.Module,
	PurPrice=ItemLog.PurPrice,
	SalePrice=ItemLog.SalePrice
FROM 
	ItemLog, Item
WHERE 
	ItemLog.ICode=Item.ICode AND
	ItemLog.Name <> Item.Name AND
	ItemLog.ItemRowID IN (SELECT MIN(ItemRowID) FROM ItemLog WHERE logdate >= :adt_enddate) AND 
	ItemLog.ICODE IN 
	(SELECT ICode
	FROM
		(SELECT ICode, Name FROM ItemLog
			WHERE logdate >= :adt_startdate AND logdate <= :adt_enddate
		UNION ALL
		SELECT ICode, Name FROM ItemLog
			WHERE ItemRowID IN (SELECT MIN(ItemRowID) FROM ItemLog WHERE logdate >= :adt_enddate)
		UNION ALL
		SELECT ICode, Name FROM Item
			WHERE	Icode not in (SELECT ICode FROM Itemlog where logdate >= :adt_enddate)) T
	GROUP BY ICode
	HAVING COUNT(DISTINCT Name) > 1)
UNION
SELECT 
	manufacturer = (select M.Name FROM manufacturer M WHERE M.ManfCode=item.ManfCode),
	category = (select IC.Name FROM ItemCategory IC WHERE IC.ICatCode=item.icatcode),
	itemname = Item.Name,
	ItemRowId=999999999, 
	Date=lastupdate, 
	ICode,
	Name,
	AliasName=CustomICode,
	UserName=(SELECT Users.UserName FROM Users WHERE Users.UserCode = Item.UserCode),
	ChangeReason,
	Module,
	PurPrice=Item.PurPrice,
	SalePrice=Item.SalePrice
FROM 
	Item
WHERE	
	Icode not in (SELECT ICode FROM Itemlog where logdate >= :adt_enddate) AND
	ICODE IN 
		(SELECT ICode
		FROM
			(SELECT ICode, Name FROM ItemLog
				WHERE logdate >= :adt_startdate AND logdate <= :adt_enddate
			UNION ALL
			SELECT ICode, Name FROM ItemLog
				WHERE ItemRowID IN (SELECT MIN(ItemRowID) FROM ItemLog WHERE logdate >= :adt_enddate)
			UNION ALL
			SELECT ICode, Name FROM Item
				WHERE	Icode not in (SELECT ICode FROM Itemlog where logdate >= :adt_enddate)) T
		GROUP BY ICode
		HAVING COUNT(DISTINCT Name) > 1) 
ORDER BY
	icode,
	itemrowid desc
"
  arguments=(("adt_startdate", datetime), ("adt_enddate", datetime))
 sort="icode A, itemname A, date D, itemrowid D"
)
