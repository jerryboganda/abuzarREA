table(column=(type=char(75) updatewhereclause=yes name=fullcode dbname="Item.customicode"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(1) updatewhereclause=yes name=locksaleprice dbname="locksaleprice"  )
column=(type=char(1) updatewhereclause=yes name=lockdiscperc dbname="lockdiscperc"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=stock dbname="stock"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=long updatewhereclause=yes name=qtysale dbname="qtysale"  )
column=(type=long updatewhereclause=yes name=bonus dbname="bonus"  )
column=(type=decimal(4) updatewhereclause=yes initial="0" name=totalstock dbname="totalstock"  )
column=(type=decimal(2) updatewhereclause=yes name=purprice dbname="purprice"  )
column=(type=decimal(2) updatewhereclause=yes name=recentpurprice dbname="recentpurprice"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=avgprice dbname="avgprice"  )
column=(type=decimal(2) updatewhereclause=yes name=latestnetrate dbname="LatestNetRate"  )
column=(type=char(30) updatewhereclause=yes name=itemtotalval dbname="itemtotalval"  )
column=(type=long updatewhereclause=yes initial="1" name=assgcode dbname="assgcode"  )
column=(type=char(1) updatewhereclause=yes initial="N" name=updatesaleprice dbname="updatesaleprice"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="saleordercode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="icode"  )
column=(type=long update=yes updatewhereclause=yes name=gcode dbname="gcode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes initial="." name=batch dbname="batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="Expiry"  )
column=(type=datetime updatewhereclause=yes initial="today" name=manfdate dbname="ManfDate"  )
column=(type=decimal(2) updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Strength % value should be between 0 and 100'" initial="90" name=strengthperc dbname="StrengthPerc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="~"Item flat Disc should be greater than zero~"" name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=rowid dbname="SaleOrderDetail.RowID"  )
column=(type=decimal(3) updatewhereclause=yes name=unitweight dbname="UnitWeight"  )
column=(type=decimal(3) updatewhereclause=yes name=packingfactor dbname="PackingFactor"  )
column=(type=long update=yes updatewhereclause=yes initial="1" name=packunits dbname="packunits"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" name=saleprice dbname="saleprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=rate dbname="rate"  )
column=(type=char(100) update=yes updatewhereclause=yes name=saleitemdescription dbname="SaleItemDescription"  )
column=(type=char(100) updatewhereclause=yes name=sizedescription dbname="SizeDescription"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="N" name=claimable dbname="claimable" 
 values="Yes	Y/No	N/"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=0 and Real(GetText()) < 100" validationmsg="'Claimable Discount % value should be between 0 and 100'" initial="0" name=claimablediscperc dbname="claimablediscperc"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="Real(GetText()) >=0 and Real(GetText()) < 100" validationmsg="'Discount % value should be between 0 and 100'" name=discperc dbname="discperc"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=decimal(2) updatewhereclause=yes name=retailprice dbname="retailprice"  )
column=(type=long update=yes updatewhereclause=yes name=rowgroup dbname="rowgroup"  )
column=(type=decimal(5) update=yes updatewhereclause=yes name=packprice dbname="packprice"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Pack Qty should be greater than or equal to zero'" initial="0" name=packqtyforsale dbname="packqtyforsale"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Bonus Qty should be greater than or equal to zero'" initial="0" name=bonuspackqtyforsale dbname="bonuspackqtyforsale"  )
column=(type=char(100) update=yes updatewhereclause=yes name=remarks dbname="SaleOrderDetail.remarks"  )
column=(type=long updatewhereclause=yes name=saleorderitemstatuscode dbname="SaleOrderDetail.SaleOrderItemStatusCode" 
 values=""  )
column=(type=char(1) updatewhereclause=yes initial="N" name=taxable dbname="Taxable"  )
column=(type=decimal(2) update=yes updatewhereclause=yes initial="0" name=itemadvancetaxperc dbname="ItemAdvanceTaxPerc"  )
column=(type=long update=yes updatewhereclause=yes name=quotationrowid dbname="SaleOrderDetail.QuotationRowID"  )
column=(type=long updatewhereclause=yes name=prescriptionrowid dbname="SaleOrderDetail.PrescriptionRowID"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Bonus Qty should be greater than or equal to zero'" initial="0" name=bonusqty dbname="bonusqty"  )
column=(type=decimal(4) update=yes updatewhereclause=yes validation="Real(GetText()) >= 0" validationmsg="'Qty should be greater than or equal to zero'" initial="1" name=looseqty dbname="looseqty"  )
 retrieve="SELECT 
	item.customicode, 
	itemname= item.name, 
	locksaleprice = dbo.item.locksaleprice,
	lockdiscperc  = dbo.item.lockdiscperc,
	currlistrow   = 0,
	stock         = ISNULL((SELECT SUM(GD.CurrQty) FROM GodownDetail GD WHERE GD.Icode=item.icode and GD.GCode=saleOrderDetail.GCode), 0),
	packingdesc=item.packingdesc,
	qtysale=item.saleqty,
	bonus=item.bonusqty,
	totalstock= ISNULL((SELECT SUM(GD.CurrQty) FROM GodownDetail GD WHERE GD.Icode=item.icode), 0),
	purprice=0.00,
	recentpurprice=0.00,
	avgprice=saleorderdetail.avgprice,
	LatestNetRate=0.00,
	itemtotalval=space(30),
	assgcode  = 1, 
	updatesaleprice = 'N',
	saleordercode=saleorderdetail.saleordercode,   
	icode=saleorderdetail.icode,   
	gcode=saleorderdetail.gcode,
	batch = saleorderdetail.batch,
	Expiry = saleorderdetail.Expiry,
	ManfDate = saleorderdetail.ManfDate,
	StrengthPerc = saleorderdetail.StrengthPerc,
	itemflatdisc = saleorderdetail.itemflatdisc,
	saleorderdetail.IDENTITYCOL,
	UnitWeight = item.UnitWeight,
	PackingFactor = item.PackingFactor,
	packunits = saleorderdetail.packunits,
	saleprice = saleorderdetail.saleprice,
	rate      = saleorderdetail.rate,
	SaleItemDescription =  saleorderdetail.SaleItemDescription,
	SizeDescription =  Item.SizeDescription,
	claimable= saleorderdetail.claimable,
	claimablediscperc= saleorderdetail.claimablediscperc,
	discperc  = saleorderdetail.discperc,
	itemcode = 0,
	retailprice=item.retailprice,
	rowgroup=saleorderdetail.rowgroup,
	packprice = saleorderdetail.packprice,
	unitsalestax=saleorderdetail.unitsalestax,
	gstperc=saleorderdetail.gstperc,
	packqtyforsale = saleorderdetail.packqtyforsale, 
	bonuspackqtyforsale = saleorderdetail.bonuspackqtyforsale,
	saleorderdetail.remarks,
	saleorderdetail.SaleOrderItemStatusCode,
	Taxable = Item.Taxable,
	ItemAdvanceTaxPerc=saleorderdetail.itemadvancetaxperc,
	saleorderdetail.QuotationRowID,
	SaleOrderDetail.PrescriptionRowID,
	bonusqty=saleorderdetail.bonusqty,
	looseqty= saleorderdetail.looseqty 

FROM  saleorderdetail,   
		item 

WHERE ( dbo.saleorderdetail.saleordercode = :ar_SaleOrderCode ) AND
		( saleorderdetail.icode = item.icode )
	  
ORDER BY saleorderdetail.IDENTITYCOL"
  update="saleorderdetail" updatewhere=1 updatekeyinplace=yes
  arguments=(("ar_SaleOrderCode", number))
)
