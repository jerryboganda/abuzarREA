release 12.5;
datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1270 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=icatcode dbname="ICatCode"  )
column=(type=char(60) updatewhereclause=yes name=categoryname dbname="CategoryName"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="ItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=decimal(4) updatewhereclause=yes name=orderqty dbname="OrderQty"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="SoldQty"  )
column=(type=decimal(4) updatewhereclause=yes name=stockinhand dbname="StockInHand"  )
column=(type=long updatewhereclause=yes name=reorderqty dbname="ReOrderQty"  )
 retrieve="SELECT
	ICatCode=T.ICatCode,
	CategoryName=T.CategoryName,
	ItemAlias=T.ItemAlias,
	Item=T.Item,
	OrderQty=ISNULL(SUM(T.OrderQty), 0),
	SoldQty = ISNULL(SUM(T.SoldQty),0),
	StockInHand = ISNULL(MAX(T.StockInHand), 0),
	ReOrderQty = ISNULL(MAX(T.ReOrderQty), 0)
FROM
	(SELECT 
		ICatCode=IC.ICatCode,
		CategoryName=IC.Name,
		ItemAlias=I.CustomICode,
		Item=I.Name,
		OrderQty=SUM(D.LooseQty + D.BonusQty),
		SoldQty = ISNULL((SELECT SUM(SD.LooseQty + SD.BonusQty) FROM SaleDetail SD WHERE SD.ICode = I.ICode AND SD.SaleOrderRowID = D.RowID),0),
		StockInHand = ISNULL((SELECT SUM(GD.CurrQty) FROM GodownDetail GD WHERE GD.ICode = I.ICode AND GD.GCode IN (:ai_gcode)), 0),
		ReOrderQty = I.ReOrderQty
	FROM
		SaleOrderHeader H, 
		SaleOrderDetail D, 
		Item I,
		ItemCategory IC
	WHERE
		H.Posted = 'N' AND 
		H.Finalized = CASE :ai_orderstatus WHEN 1 THEN 'Y' WHEN 2 THEN 'N' ELSE H.Finalized END AND
		H.Date BETWEEN  :ad_startdate AND :ad_enddate AND 
		H.SaleOrderCode = D.SaleOrderCode AND 
		D.ICode = I.ICode AND 
		I.ICatCode = IC.ICatCode
	GROUP BY
		I.ICode,
		I.CustomICode,
		I.Name,
		I.ReOrderQty,
		IC.ICatCode,
		IC.Name,
		D.RowID) T
GROUP BY
	T.ICatCode,
	T.CategoryName,
	T.ItemAlias,
	T.Item
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime), ("ai_orderstatus", number), ("ai_gcode", numberlist))
 sort="categoryname A, item A"
 filter="(orderqty - stockinhand + reorderqty) > 0"
 )
