 retrieve="SELECT
	itemname= case item.printable WHEN 1 THEN item.name ELSE 'Counter Sale:' + LTRIM(RTRIM(item.customicode)) END, 
	aliasname=item.customicode, 
	packingdesc=item.packingdesc, 
	ordercode = dbo.saleorderheader.ordercode,
	socatcode = dbo.saleorderheader.socatcode,
	saleordercategory = saleordercategory.Name,
	amt=saleorderheader.amt,  
	accname = dbo.accounts.name,   
	address = dbo.customer.address1,   
	address2= dbo.customer.address2,   
	salesman = dbo.users.username,   
	saleordercode = dbo.saleorderheader.saleordercode,   
	headerno = dbo.saleorderheader.headerno,   
	date = dbo.saleorderheader.date,   
	invdiscperc = dbo.saleorderheader.discperc,   
	misccharges = dbo.saleorderheader.misccharges,   
	flatdisc = dbo.saleorderheader.flatdisc,   
	invsalestax = 0,   
	gcode = saleorderdetail.gcode,   
	icode = saleorderdetail.icode,   
	/*looseqty = saleorderdetail.looseqty,   
	bonusqty = saleorderdetail.bonusqty,   */
	looseqty =(Case ( CAST(saleorderdetail.looseqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end)AS INT) - (saleorderdetail.looseqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end)) ) When 0 Then (saleorderdetail.looseqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end)) Else saleorderdetail.looseqty End),
    	packorloose = (Case ( CAST(saleorderdetail.looseqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end) AS INT) - (saleorderdetail.looseqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end)) ) When 0 Then '' Else 'L' End),  
	bonusqty = (Case ( CAST(saleorderdetail.bonusqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end) AS INT) - (saleorderdetail.bonusqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end)) ) When 0 Then (saleorderdetail.bonusqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end)) Else saleorderdetail.bonusqty End), 
	bonuspackorloose = (Case ( CAST(saleorderdetail.bonusqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end) AS INT) - (saleorderdetail.bonusqty /(case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end)) ) When 0 Then '' Else 'L' End),
	packunits= saleorderdetail.packunits,   
	/*saleprice= saleorderdetail.saleprice,   */
	saleprice=(Case ( CAST(saleorderdetail.looseqty /(case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end) AS INT) - (saleorderdetail.looseqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end)) ) When 0 Then (saleorderdetail.saleprice * saleorderdetail.packunits) Else saleorderdetail.saleprice End),
	discperc = saleorderdetail.discperc,  
	/*itemflatdisc=saleorderdetail.itemflatdisc,   */
	itemflatdisc=(Case ( CAST(saleorderdetail.looseqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end)AS INT) - (saleorderdetail.looseqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end)) ) When 0 Then (saleorderdetail.packunits * saleorderdetail.itemflatdisc) Else saleorderdetail.itemflatdisc End ),
	salestax = 0,   
	Id = dbo.saleorderdetail.IDENTITYCOL,   
	posted=saleorderheader.posted,   
	balance=0,   
	/*unitsalestax = saleorderdetail.unitsalestax,   */
	unitsalestax=(Case ( CAST(saleorderdetail.looseqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end)AS INT) - (saleorderdetail.looseqty / (case saleorderdetail.packunits when 0 then 1 else saleorderdetail.packunits end)) ) When 0 Then (saleorderdetail.packunits * saleorderdetail.unitsalestax) Else saleorderdetail.unitsalestax End ),
	gstperc = saleorderdetail.gstperc,   
	invgstperc = saleorderheader.invgstperc1,   
	custTaxRegno=customer.salestaxregno  ,
	custrefno=dbo.saleorderheader.custrefno,	
	remarks=dbo.saleorderheader.remarks,
	custcode=saleorderheader.custcode,
	messages=(select description from message where messagecode=saleorderheader.messagecode)
FROM 
	saleorderheader,   
	saleordercategory,
	saleorderdetail,   
	accounts,   
	customer,   
	users,   
	item  
WHERE 
	( dbo.saleorderheader.socatcode  = dbo.saleordercategory.socatcode ) AND
	( dbo.saleorderheader.saleordercode = :ar_saleordercode ) AND  
	( dbo.saleorderheader.saleordercode = dbo.saleorderdetail.saleordercode) AND  
	( dbo.saleorderheader.custcode = dbo.accounts.acccode ) AND  
	( dbo.customer.custcode = dbo.accounts.acccode ) AND  
	( dbo.saleorderheader.usercode = dbo.users.usercode ) AND  
	( dbo.saleorderdetail.icode = dbo.item.icode)    
ORDER BY /*dbo.item.customicode,*/
	dbo.saleorderdetail.saleordercode,
	dbo.saleorderdetail.IDENTITYCOL"
  arguments=(("ar_SaleOrderCode", number))
)
