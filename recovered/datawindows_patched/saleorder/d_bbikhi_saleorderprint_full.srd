column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes name=availableqty dbname="availableqty"  )
column=(type=decimal(4) updatewhereclause=yes name=orderqty dbname="looseqty"  )
