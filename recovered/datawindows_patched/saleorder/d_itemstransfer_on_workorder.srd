release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=67108864 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=269 color="536870912" )
summary(height=90 color="536870912" )
footer(height=0 color="536870912" )
detail(height=70 color="536870912" )
table(column=(type=long updatewhereclause=yes name=code dbname="Theader.TransCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Theader.date"  )
column=(type=char(60) updatewhereclause=yes name=trasnfertype dbname="TrasnferType"  )
column=(type=char(60) updatewhereclause=yes name=sourcegodown dbname="SourceGodown"  )
column=(type=char(60) updatewhereclause=yes name=targetgodown dbname="TargetGodown"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="Item.name"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="Item.customicode"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=char(100) updatewhereclause=yes name=batch dbname="Batch"  )
column=(type=datetime updatewhereclause=yes name=expiry dbname="expiry"  )
column=(type=long identity=yes updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=decimal(5) updatewhereclause=yes name=price dbname="Price"  )
column=(type=decimal(9) updatewhereclause=yes name=amount dbname="amount"  )
column=(type=long updatewhereclause=yes name=workordercode dbname="WorkOrderCode"  )
 retrieve="SELECT 
	THeader.TransCode,
	THeader.date,
	TrasnferType = (SELECT TT.name FROM TransferType TT WHERE TT.TTCode = THeader.TTCode),
	SourceGodown = (Select Godown.name from Godown where Godown.GCode = THeader.SGCode), 
	TargetGodown = (Select Godown.name from Godown where Godown.GCode = THeader.DGCode), 
	item.name,
	item.customicode, 
	Qty=TDetail.qty,
	Batch=TDetail.batch,
	expiry=TDetail.expiry,
	RowID= TDetail.ID,
	Price=TDetail.AvgPrice,
	amount=TDetail.qty * TDetail.AvgPrice,
	WorkOrderCode = THeader.WorkOrderCode
FROM
	THeader,
	TDetail,
	item
WHERE  
	THeader.WorkOrderCode IS NOT NULL AND
	THeader.WorkOrderCode = :ai_code AND
	THeader.TransCode=TDetail.TransCode and
	TDetail.icode=item.icode 
ORDER BY 
	THeader.TransCode
"
  arguments=(("ai_code", number))
 sort="code A, rowid A"
)
