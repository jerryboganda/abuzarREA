table(column=(type=long key=yes update=yes updatewhereclause=yes name=code dbname="WorkOrderCode"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=icode dbname="ResourceCode"  )
column=(type=long updatewhereclause=yes name=itemcode dbname="itemcode"  )
column=(type=long updatewhereclause=yes name=resourcecatcode dbname="ResourceCatCode" 
 values=""  )
column=(type=char(60) updatewhereclause=yes initial=" " name=itemname dbname="itemname"  )
column=(type=long updatewhereclause=yes initial="0" name=currlistrow dbname="currlistrow"  )
column=(type=datetime update=yes updatewhereclause=yes name=esttimereq dbname="EstTimeReq"  )
column=(type=decimal(2) update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid cost'" name=cost dbname="Cost"  )
column=(type=char(255) update=yes updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=datetime update=yes updatewhereclause=yes initial="Today" name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=rowid dbname="RowID"  )
column=(type=long update=yes updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=datetime update=yes updatewhereclause=yes name=timetaken dbname="TimeTaken"  )
column=(type=long update=yes updatewhereclause=yes validation="real(gettext()) >= 0" validationmsg="'Please enter valid qty'" initial="1" name=qty dbname="Qty"  )
 retrieve="SELECT 
	WorkOrderCode=WorkOrderResource.WorkOrderCode,
	ResourceCode=WorkOrderResource.ResourceCode,
	itemcode = WorkOrderResource.ResourceCode,
	ResourceCatCode=Resource.ResourceCatCode,
	itemname= Resource.name, 
	currlistrow = 0,
	EstTimeReq=WorkOrderResource.EstTimeReq,
	Cost=WorkOrderResource.Cost,
	Remarks=WorkOrderResource.Remarks,
	Date=WorkOrderResource.Date,
	RowID=WorkOrderResource.RowID,
	UserCode=WorkOrderResource.UserCode,
	TimeTaken=WorkOrderResource.TimeTaken,
	Qty  = WorkOrderResource.Qty
FROM 
	WorkOrderResource, Resource
WHERE 
	WorkOrderResource.WorkOrderCode = :ai_code AND
	WorkOrderResource.ResourceCode = Resource.ResourceCode 
ORDER BY
	WorkOrderResource.WorkOrderCode, 
	RowID"
  update="WorkOrderResource" updatewhere=0 updatekeyinplace=yes
  arguments=(("ai_Code", number))
)
