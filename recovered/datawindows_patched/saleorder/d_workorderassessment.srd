column=(type=char(255) update=yes updatewhereclause=yes name=remarks dbname="WorkOrderAssessment.Remarks"  )
 retrieve="SELECT 
	WorkOrderCode,
	Date,
	UserCode,
	AssessedOn,
	AssessedBy,
	Assessment,
	ActionProposed,
	Remarks
FROM 
	WorkOrderAssessment
WHERE 
	WorkOrderCode = :ai_code"
  update="WorkOrderAssessment" updatewhere=1 updatekeyinplace=yes
  arguments=(("ai_code", number))
)
