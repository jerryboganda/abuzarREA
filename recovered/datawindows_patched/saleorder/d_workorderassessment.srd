column=(type=char(255) update=yes updatewhereclause=yes name=assessedby dbname="WorkOrderAssessment.AssessedBy"  )
column=(type=char(4000) update=yes updatewhereclause=yes name=assessment dbname="WorkOrderAssessment.Assessment"  )
