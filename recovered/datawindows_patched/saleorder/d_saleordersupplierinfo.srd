release 12.5;
datawindow ( units=0 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=696 color="536870912" )
summary(height=76 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=long updatewhereclause=yes name=suppliercount dbname="SupplierCount"  )
column=(type=long updatewhereclause=yes name=saleordercode dbname="SaleOrderCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=datetime updatewhereclause=yes name=postdate dbname="PostDate"  )
column=(type=long updatewhereclause=yes name=headerno dbname="HeaderNo"  )
column=(type=char(100) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="Rate"  )
column=(type=decimal(6) updatewhereclause=yes name=value dbname="Value"  )
 retrieve="SELECT 
	Supplier=(SELECT A.Name 
		FROM ItemSuppliers ISP, Accounts A 
		WHERE ISP.SuppCode=A.AccCode AND ISP.ICode = D.ICode AND ISP.Priority IN
		(SELECT Min(ISP.Priority) FROM ItemSuppliers ISP WHERE ISP.ICode = D.ICode)),
	SupplierCount=ISNULL((SELECT Count(*) FROM ItemSuppliers ISP
		WHERE ISP.ICode = D.ICode), 0),
	SaleOrderCode=H.SaleOrderCode,
	Date=H.Date,
	Customer = (SELECT A.Name FROM Accounts A WHERE A.AccCode = H.CustCode),
	Posted = H.Posted,
	PostDate=H.PostDate,
	HeaderNo=H.HeaderNo,
	Remarks=H.Remarks,
	AliasName = I.CustomICode,
	ItemName = I.Name,
	Qty=SUM(D.LooseQty),
	Rate = Max(D.SalePrice),
	Value = SUM(D.LooseQty * D.SalePrice)
FROM
	SaleOrderHeader H,
	SaleOrderDetail D,
	Item I
	
WHERE
	H.SaleOrderCode = :ai_code AND
	H.SaleOrderCode = D.SaleOrderCode AND
	D.ICode = I.ICode
GROUP BY
	H.SaleOrderCode,
	H.Date,
	H.CustCode,
	H.Posted,
	H.PostDate,
	H.HeaderNo,
	H.Remarks,
	D.ICode,
	I.CustomICode,
	I.Name
"
  arguments=(("ai_code", number))
)
