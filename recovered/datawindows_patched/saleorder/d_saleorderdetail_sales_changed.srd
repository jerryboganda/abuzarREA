compute(name=c_sumlooseqty visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="2542" y="4" height="60" width="242" format="	f_SetColumnFormat('Qty')" expression="sum(looseqty for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumbonusqty visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="3109" y="4" height="60" width="201" format="	f_SetColumnFormat('Qty')" expression="sum(bonusqty for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumitemflatdisc visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="3680" y="4" height="60" width="256" format="###0.00" expression="sum(itemflatdisc*looseqty for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumitemdiscval visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="3945" y="4" height="60" width="288" format="###0.00" expression="sum( round(((saleprice - itemflatdisc)*discperc*0.01)*looseqty,2) for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_detaildwtotal visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="7369" y="4" height="60" width="352" format="[General]" expression="sum( ( ( looseqty *  (saleprice -  itemflatdisc )) ) *  ( 1-  (  discperc  *  .01 )  )  for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumtaxval visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="8069" y="4" height="60" width="242" format="###0.00" expression="sum( round( unitsalestax  * (Bonusqty + looseqty) ,2)  for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumgstval visible="1" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="8571" y="4" height="60" width="238" format="###0.00" expression="sum( round( c_itemtotal  *  gstperc * 0.01,2)  for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
compute(name=c_sumfinalitemval visible="1	0" band=footer font.charset="0" font.face="Arial" font.family="2" font.height="-9" font.pitch="2" font.weight="400" background.mode="2" background.color="80263581" color="0" x="8818" y="4" height="60" width="416" format="#,##0.00" expression="sum( c_finalitemval  for all)" alignment="1" border="0" html.valueishtml="0" crosstab.repeat=no )
