release 12.5;
datawindow ( units=0 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.size=0 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=552 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=88 color="536870912" )
table(column=(type=long updatewhereclause=yes name=saleordercode dbname="SaleOrderCode"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=decimal(2) updatewhereclause=yes name=saleordertotal dbname="SaleOrderTotal"  )
column=(type=char(60) updatewhereclause=yes name=supplier dbname="Supplier"  )
column=(type=decimal(6) updatewhereclause=yes name=suppliertotal dbname="SupplierTotal"  )
 retrieve="SELECT 
	SaleOrderCode=SO.SaleOrderCode, 
	Date=SO.Date, 
	SaleOrderTotal=MAX(SO.InvTotal),
	Supplier = (SELECT A.Name FROM Accounts A WHERE A.AccCode = IL.Suppcode),
	SupplierTotal = SUM(SD.Looseqty * (SD.SalePrice - SD.ItemFlatDisc) * (1 - SD.DiscPerc * 0.01) * (1 - SO.DiscPerc * 0.01))
FROM 
	SaleOrderHeader SO,
	SaleOrderDetail SD,
	Item I,
	(SELECT 
	ItemSuppliers.ICode,   
	ItemSuppliers.SuppCode  
FROM 
	ItemSuppliers,
	(SELECT ITS.ICode, P=MIN(ITS.Priority)
	FROM ItemSuppliers ITS
	GROUP BY ITS.ICode) T
	WHERE
		dbo.Fn_GetPreference('POSupplierConsideration')='1' AND
		ItemSuppliers.ICode = T.ICode AND ItemSuppliers.Priority = T.P
	UNION
	SELECT 
		ItemSuppliers.ICode,   
		ItemSuppliers.SuppCode  
	FROM 
		ItemSuppliers
	WHERE
		dbo.Fn_GetPreference('POSupplierConsideration')='2') IL
WHERE
	SO.SaleOrderCode BETWEEN :ai_startsocode AND :ai_endsocode AND
	SO.SaleOrderCode = SD.SaleOrderCode AND
	SD.ICode = I.ICode AND
	I.ICode = IL.ICode
GROUP BY
	SO.SaleOrderCode, 
	SO.Date,
	IL.SuppCode
ORDER BY 
	SO.SaleOrderCode, 
	Supplier"
  arguments=(("ai_startsocode", number), ("ai_endsocode", number))
 sort="saleordercode A, supplier A"
)
group(level=1 header.height=80 trailer.height=104 by=("saleordercode"  ) header.color="536870912" trailer.color="536870912" )
