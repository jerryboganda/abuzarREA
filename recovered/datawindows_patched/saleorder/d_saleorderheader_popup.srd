 retrieve="   SELECT saleorderheader.saleordercode , 
          date=saleorderheader.date , 
			 saleorderheader.billingdate,
          saleorderheader.custrefno , 
          saleorderheader.remarks , 
          saleorderheader.custcode , 
          salesmancode=saleorderheader.usercode ,
			 saleorderheader.headerno,  
          users.username , 
          discperc=saleorderheader.discperc , 
          flatdisc=saleorderheader.flatdisc , 
          misccharges=saleorderheader.misccharges , 
          posted=saleorderheader.posted , 
          postdate=saleorderheader.postdate , 
          customer.address1 , 
          customer.city , 
          customer.phone ,
			 customerbalance = 0,
			 debitorcredit = ' ',
          aliasname='            ',
			 headerinvno=saleorderheader.headerinvno,
			 originaldate=saleorderheader.originaldate,
			 modifiedby=saleorderheader.modifiedby,
			 sprice=saleorderheader.sprice,
			 quotationcode=saleorderheader.quotationcode,
			 postedby=saleorderheader.postedby,
     		 doctcode=saleorderheader.doctcode,
          patientRegNo='          ',
          patientcode=saleorderheader.patientcode,
			 invGSTPerc1=saleorderheader.InvGstPerc1,
			 dd_gstperc=0,
			 gcode=0,
			 gstno=saleorderheader.gstno,
			 MessageCode=saleorderheader.MessageCode,
			 Message.Description,
			 SmanCode=saleorderheader.SmanCode,
			 Salesman.Name,
			 custrefno2=saleorderheader.custrefno2,
			 custrefno3=saleorderheader.custrefno3,
		 	 custrefno4=saleorderheader.custrefno4,
			 InvoiceSize=saleorderheader.InvoiceSize,
			 invtotal=saleorderheader.invtotal,
			 machinename=saleorderheader.machinename,
  			 ModifyCounter=saleorderheader.ModifyCounter,
  			 relationcode=saleorderheader.relationcode,
  			 diseasecode=saleorderheader.diseasecode,
  			 wardcode=saleorderheader.wardcode,
			 itemdiscpercno=saleorderheader.itemdiscpercno,
			 PptCustCode=saleorderheader.PptCustCode,
			 deliveredby=saleorderheader.deliveredby,
			custsitecode=saleorderheader.custsitecode

FROM  
		customer , 
		saleorderheader 
		LEFT OUTER JOIN salesman ON (saleorderheader.smancode = salesman.salesmancode)
		LEFT OUTER JOIN message ON (saleorderheader.messagecode = message.messagecode),
		users , 
		accounts  
   
   WHERE ( saleorderheader.custcode = customer.custcode ) and 
         ( users.usercode = saleorderheader.usercode ) and 
         ( saleorderheader.custcode = accounts.acccode ) and 
         ( ( dbo.saleorderheader.saleordercode = :ar_SaleOrderCode ) )   "
  arguments=(("ar_SaleOrderCode", number))
)
