table(column=(type=long updatewhereclause=yes name=code dbname="WorkOrderCode"  )
column=(type=char(12) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(60) updatewhereclause=yes name=customername dbname="CustomerName"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=long updatewhereclause=yes name=usercode dbname="UserCode" 
 values=""  )
column=(type=char(100) updatewhereclause=yes name=initiatedby dbname="InitiatedBy"  )
column=(type=char(255) updatewhereclause=yes name=address dbname="Address"  )
column=(type=char(100) updatewhereclause=yes name=contactno dbname="ContactNo"  )
column=(type=char(100) updatewhereclause=yes name=email dbname="Email"  )
column=(type=char(100) updatewhereclause=yes name=availabilitytovisit dbname="AvailabilityToVisit"  )
column=(type=char(4000) updatewhereclause=yes name=complaint dbname="Complaint"  )
column=(type=char(4000) updatewhereclause=yes name=demand dbname="Demand"  )
column=(type=char(255) updatewhereclause=yes name=remarks dbname="Remarks"  )
column=(type=char(1) updatewhereclause=yes name=approved dbname="Approved"  )
column=(type=datetime updatewhereclause=yes name=approvedon dbname="ApprovedOn"  )
