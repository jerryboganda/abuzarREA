table(column=(type=long updatewhereclause=yes name=consolidatedsaleorder dbname="ConsolidatedSaleOrder"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="AliasName"  )
column=(type=char(60) updatewhereclause=yes name=itemname dbname="ItemName"  )
column=(type=datetime updatewhereclause=yes name=quotationdate dbname="QuotationDate"  )
column=(type=long updatewhereclause=yes name=quotationcode dbname="QuotationCode"  )
column=(type=long updatewhereclause=yes name=custcode dbname="CustCode"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CustAlias"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=decimal(4) updatewhereclause=yes name=qty dbname="Qty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="BonusQty"  )
 retrieve="SELECT 
	ConsolidatedSaleOrder=H.ConsolidatedSaleOrder, 
	AliasName = I.CustomICode,
	ItemName = I.Name,
	QuotationDate=H.Date, 
	QuotationCode=H.QuotationCode, 
	CustCode=H.CustCode, 
	CustAlias = A.AliasName,
	Customer=A.Name,
	Qty = D.Qty, 
	BonusQty = D.BonusQty
FROM
	QuotationHeader H, QuotationDetail D, Item I, Accounts A
WHERE
	H.ConsolidatedSaleOrder = :ai_consolidated_saleorder AND
	H.CustCode = A.AccCode AND
	D.ICode = :ai_icode AND
	H.QuotationCode = D.QuotationCode AND
	D.ICode = I.ICode
ORDER BY
	Customer"
  arguments=(("ai_consolidated_saleorder", number), ("ai_icode", number))
)
