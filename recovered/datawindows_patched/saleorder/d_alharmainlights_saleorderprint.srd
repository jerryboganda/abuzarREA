detail(height=208 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=itemname dbname="itemname"  )
column=(type=char(100) updatewhereclause=yes name=saleitemdesc dbname="saleitemdesc"  )
column=(type=char(75) updatewhereclause=yes name=aliasname dbname="aliasname"  )
column=(type=char(50) updatewhereclause=yes name=packingdesc dbname="packingdesc"  )
column=(type=char(60) updatewhereclause=yes name=accname dbname="accname"  )
column=(type=char(60) updatewhereclause=yes name=address dbname="address"  )
column=(type=char(60) updatewhereclause=yes name=address2 dbname="address2"  )
column=(type=char(60) updatewhereclause=yes name=city dbname="city"  )
column=(type=char(30) updatewhereclause=yes name=licenceno dbname="licenceno"  )
column=(type=char(60) updatewhereclause=yes name=username dbname="username"  )
column=(type=long updatewhereclause=yes name=saleordercode dbname="Saleordercode"  )
column=(type=long updatewhereclause=yes name=headerno dbname="headerno"  )
column=(type=long updatewhereclause=yes name=headerinvno dbname="headerinvno"  )
column=(type=datetime updatewhereclause=yes name=date dbname="date"  )
column=(type=long updatewhereclause=yes name=modifycounter dbname="modifycounter"  )
column=(type=decimal(2) updatewhereclause=yes name=invdiscperc dbname="invdiscperc"  )
column=(type=decimal(2) updatewhereclause=yes name=misccharges dbname="misccharges"  )
column=(type=decimal(2) updatewhereclause=yes name=flatdisc dbname="flatdisc"  )
column=(type=long updatewhereclause=yes name=gcode dbname="gcode"  )
column=(type=long updatewhereclause=yes name=saledetail_icode dbname="icode"  )
column=(type=decimal(4) updatewhereclause=yes name=looseqty dbname="looseqty"  )
column=(type=decimal(4) updatewhereclause=yes name=bonusqty dbname="bonusqty"  )
column=(type=long updatewhereclause=yes name=packunits dbname="packunits"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="saleprice"  )
column=(type=decimal(2) updatewhereclause=yes name=discperc dbname="discperc"  )
column=(type=decimal(2) updatewhereclause=yes name=itemflatdisc dbname="itemflatdisc"  )
column=(type=long updatewhereclause=yes name=id dbname="Id"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="posted"  )
column=(type=long updatewhereclause=yes name=balance dbname="balance"  )
column=(type=decimal(2) updatewhereclause=yes name=unitsalestax dbname="unitsalestax"  )
column=(type=decimal(2) updatewhereclause=yes name=gstperc dbname="gstperc"  )
column=(type=decimal(2) updatewhereclause=yes name=invgstperc dbname="invgstperc"  )
column=(type=char(50) updatewhereclause=yes name=custtaxregno dbname="custTaxRegno"  )
column=(type=char(30) updatewhereclause=yes name=saleorderheader_custrefno dbname="SaleOrderHeader.custrefno"  )
column=(type=char(100) updatewhereclause=yes name=custref2 dbname="custref2"  )
column=(type=char(100) updatewhereclause=yes name=saleorderheader_remarks dbname="SaleOrderHeader.remarks"  )
column=(type=decimal(2) updatewhereclause=yes name=amt dbname="amt"  )
column=(type=char(60) updatewhereclause=yes name=salesman dbname="salesman"  )
column=(type=char(60) updatewhereclause=yes name=manufacturer dbname="manufacturer"  )
column=(type=char(12) updatewhereclause=yes name=custalias dbname="CUSTALIAS"  )
column=(type=char(60) updatewhereclause=yes name=patientname dbname="patientname"  )
column=(type=char(100) updatewhereclause=yes name=patientaddress dbname="patientaddress"  )
 retrieve="SELECT 
	itemname= item.name,
	saleitemdesc= max(saledetail.saleitemdescription),
	aliasname=item.customicode,
	packingdesc=item.packingdesc, 
	accname = accounts.name,   
	address =  customer.address1,
	address2=  customer.address2,   
	city=  customer.city,   
	licenceno=  customer.licenceno,   
	username=  users.username,   
	Saleordercode =  saleledger.Saleordercode,   
	headerno =  saleledger.headerno, 
	headerinvno=saleledger.headerinvno,  
	date =  saleledger.date,   
	modifycounter =  saleledger.modifycounter, 
	invdiscperc =  saleledger.discperc,   
	misccharges =  saleledger.misccharges,   
	flatdisc =  saleledger.flatdisc,   
	
	gcode = saledetail.gcode,   
	icode = saledetail.icode,   
	looseqty = sum(saledetail.looseqty),
	bonusqty = sum(saledetail.bonusqty),

	packunits= saledetail.packunits,   
	saleprice= saledetail.saleprice,   
	discperc = saledetail.discperc,   
	
	itemflatdisc=saledetail.itemflatdisc,   
	Id = max( saledetail.IDENTITYCOL),   
	posted=saleledger.posted,   
	balance=0,   
	unitsalestax = max(saledetail.unitsalestax),
	gstperc = max(saledetail.gstperc),
	invgstperc = saleledger.invgstperc1,   
	custTaxRegno=customer.salestaxregno  ,
	 saleledger.custrefno,	
	custref2=saleledger.custrefno2,
	 saleledger.remarks,
	amt=max(saleledger.amt),
	salesman=ltrim(rtrim( salesman.name)),
	manufacturer=(select name from manufacturer where manfcode=item.manfcode),
	CUSTALIAS=ACCOUNTS.ALIASNAME,
	patientname=(select name from patient where patientcode=saleledger.patientcode),
	patientaddress=(select address1 from patient where patientcode=saleledger.patientcode)
	
FROM 
	saleorderheader saleledger
	LEFT OUTER JOIN SalesMan ON (saleledger.smancode = salesman.salesmancode),
	saleorderdetail saledetail,   
	accounts,   
	customer,   
	users,   
	item 
WHERE 
	(  saleledger.Saleordercode=:ar_InvCode) AND
	(  saleledger.Saleordercode=saledetail.Saleordercode) AND
	(  saleledger.custcode =  accounts.acccode ) AND  
	(  customer.custcode =  accounts.acccode ) AND  
	(  saleledger.Usercode =  users.usercode ) AND 
	 (  saledetail.icode =  item.icode)    
GROUP BY
	item.name,
	
	item.customicode,   
	item.packingdesc, 
	 accounts.name,   
	 customer.address1,
	 customer.address2,   
	 customer.city,   
	 customer.licenceno,   
	 users.username,   
	 saleledger.Saleordercode,   
	 saleledger.headerno, 
	saleledger.headerinvno,  
	 saleledger.date,   
	 saleledger.modifycounter, 
	 saleledger.discperc,   
	 saleledger.misccharges,   
	 saleledger.flatdisc,   
	
	saledetail.gcode,   
	saledetail.icode,
	saledetail.packunits, 
	saledetail.saleprice, 
	saledetail.discperc, 
	saledetail.itemflatdisc, 
	saleledger.posted, 
	saleledger.invgstperc1, 
	customer.salestaxregno, 
	 saleledger.custrefno,
	saleledger.custrefno2,
	 saleledger.remarks,

	 salesman.name,
	item.manfcode,
	ACCOUNTS.ALIASNAME,
	saleledger.patientcode,
	saleledger.patientcode
ORDER BY 
	Saleordercode,
	ID"
  arguments=(("ar_InvCode", number))
)
