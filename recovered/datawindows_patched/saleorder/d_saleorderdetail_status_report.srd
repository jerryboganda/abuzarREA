datawindow ( units=2 timer_interval=60000 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.printername=""  print.documentname=""  print.orientation=1 print.margin.left=250 print.margin.right=250 print.margin.top=250 print.margin.bottom=250 print.paper.size=1 print.paper.source=0 print.canusedefaultprinter=yes selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=1479 color="536870912" )
summary(height=239 color="536870912" )
footer(height=0 color="536870912" )
detail(height=197 color="536870912" )
table(column=(type=long updatewhereclause=yes name=ordercode dbname="OrderCode"  )
column=(type=char(12) updatewhereclause=yes name=customeralias dbname="CustomerAlias"  )
column=(type=datetime updatewhereclause=yes name=date dbname="Date"  )
column=(type=char(60) updatewhereclause=yes name=customer dbname="Customer"  )
column=(type=char(1) updatewhereclause=yes name=posted dbname="Posted"  )
column=(type=char(1) updatewhereclause=yes name=finalized dbname="Finalized"  )
column=(type=char(75) updatewhereclause=yes name=itemalias dbname="ItemAlias"  )
column=(type=char(60) updatewhereclause=yes name=item dbname="Item"  )
column=(type=decimal(4) updatewhereclause=yes name=orderqty dbname="OrderQty"  )
column=(type=decimal(4) updatewhereclause=yes name=orderbonus dbname="OrderBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=quotqty dbname="QuotQty"  )
column=(type=decimal(4) updatewhereclause=yes name=quotbonus dbname="QuotBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=poqty dbname="POQty"  )
column=(type=decimal(4) updatewhereclause=yes name=pobonus dbname="POBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=soldqty dbname="SoldQty"  )
column=(type=decimal(4) updatewhereclause=yes name=soldbonus dbname="SoldBonus"  )
column=(type=decimal(4) updatewhereclause=yes name=issuedqty dbname="IssuedQty"  )
column=(type=decimal(2) updatewhereclause=yes name=saleprice dbname="SalePrice"  )
column=(type=long updatewhereclause=yes name=statuscode dbname="StatusCode"  )
column=(type=char(100) updatewhereclause=yes name=status dbname="Status"  )
column=(type=decimal(2) updatewhereclause=yes name=invtotal dbname="InvTotal"  )
column=(type=decimal(2) updatewhereclause=yes name=advanceamt dbname="AdvanceAmt"  )
column=(type=decimal(2) updatewhereclause=yes name=balanceamt dbname="BalanceAmt"  )
 retrieve="SELECT
	OrderCode=H.SaleOrderCode,
	CustomerAlias=A.AliasName,
	Date = H.Date,
	Customer=A.Name,
	Posted=H.Posted,
	Finalized=H.Finalized,
	ItemAlias=I.CustomICode, 
	Item=I.Name, 
	OrderQty=D.LooseQty,
	OrderBonus=D.BonusQty, 
	QuotQty = ISNULL((SELECT SUM(SD.Qty * CASE SL.LoosePack WHEN 1 THEN 1 ELSE SD.PACKUNITS END) 
						FROM QuotationDetail SD, QuotationHeader SL 
						WHERE SD.QuotationCode = SL.QuotationCode AND SD.ICode = D.ICode AND SD.RowID = D.QuotationRowID), 0),
	QuotBonus = ISNULL((SELECT SUM(SD.BonusQty * CASE SL.LoosePack WHEN 1 THEN 1 ELSE SD.PACKUNITS END)
						FROM QuotationDetail SD, QuotationHeader SL 
						WHERE SD.QuotationCode = SL.QuotationCode AND SD.ICode = D.ICode AND SD.RowID = D.QuotationRowID), 0),
	POQty = ISNULL((SELECT SUM(PD.Qty * PD.PACKUNITS) 
						FROM PurOrderDetail PD, PurOrderHeader P 
						WHERE P.SaleOrderCode = D.SaleOrderCode AND P.POCode = PD.PoCode AND PD.ICode = D.ICode), 0),
	POBonus = ISNULL((SELECT SUM(PD.BonusQty * PD.PACKUNITS) 
						FROM PurOrderDetail PD, PurOrderHeader P 
						WHERE P.SaleOrderCode = D.SaleOrderCode AND P.POCode = PD.PoCode AND PD.ICode = D.ICode), 0),
	SoldQty = ISNULL((SELECT SUM(SD.LooseQty) 
						FROM SaleDetail SD, SaleLedger SL 
						WHERE SD.SaleInvCode = SL.SaleInvCode AND SD.ICode = ICode AND SD.SaleOrderRowID = D.RowID), 0),
	SoldBonus = ISNULL((SELECT SUM(SD.BonusQty) 
						FROM SaleDetail SD, SaleLedger SL 
						WHERE SD.SaleInvCode = SL.SaleInvCode AND SD.ICode = ICode AND SD.SaleOrderRowID = D.RowID), 0),
	IssuedQty = ISNULL((SELECT SUM(SD.Qty) 
						FROM IssueDetail SD, IssueHeader SL 
						WHERE SD.IssueInvCode = SL.IssueInvCode AND SD.ICode = ICode AND SD.SaleOrderRowID = D.RowID), 0),
	SalePrice=D.SalePrice,
	StatusCode=D.SaleOrderItemStatusCode,
	Status=(SELECT S.Name FROM SaleOrderItemStatus S WHERE S.SaleOrderItemStatusCode = D.SaleOrderItemStatusCode),
	InvTotal = ISNULL(H.InvTotal, 0),
	AdvanceAmt = ISNULL(H.Amt, 0),
	BalanceAmt = ISNULL(H.InvTotal, 0) - ISNULL(H.Amt, 0)
FROM
	SaleOrderHeader H, 
	SaleOrderDetail D, 
	Accounts A,
	Item I
WHERE
	H.SaleOrderCode = D.SaleOrderCode AND
	H.CustCode = A.AccCode AND
	H.Date >= :ad_startdate AND H.Date <= :ad_enddate AND
	D.ICode = I.ICode
ORDER BY
	OrderCode,
	Item,
	Customer,
	Status
"
  arguments=(("ad_startdate", datetime), ("ad_enddate", datetime))
)
